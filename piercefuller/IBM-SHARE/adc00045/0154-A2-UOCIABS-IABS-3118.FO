*     FAP                                                                       
       LBL     IABS                                                     IABS0000
       COUNT   50                                                       IABS0001
*      U. OF CHICAGO VERSION OF COMPLEX ABSOLUTE VALUE FUNCTION         IABS0002
*  Z=X+IY, WHERE X AND Y ARE NORMAL, FLOATING POINT NUMBERS STORED IN   IABS0003
*  CELLS 32767 AND 32766 RESPECTIVELY.                                  IABS0004
*  ANSWER IS A NORMAL, FLOATING POINT NUMBER APPEARING IN CELL 32767    IABS0005
*  AND THE AC.  CELL 32766 IS CLEARED.                                  IABS0006
*      CALLING SEQUENCE                                                 IABS0007
*        TSX     $IABS,4                                                IABS0008
       ENTRY   IABS                                                     IABS0009
 IABS  DLD     -2            PICK UP ARGUMENT                           IABS0010
       XCL                   SET SIGN POSITIVE                          IABS0011
       XCA                                                              IABS0012
       TLQ     *+2                                                      IABS0013
       XCA                   BIGGER PART TO AC                          IABS0014
       STO     BUFF            AND TO BUFF                              IABS0015
       TZE     OK            IF ZERO, SO IS ANSWER                      IABS0016
       ANA     MASK          PREPARE FUDGE FACTOR                       IABS0017
       SUB     CH2HD           TO REDUCE CHAR OF                        IABS0018
       STO     T1                BIGGER PART TO O200                    IABS0019
       XCA                   MODIFY SMALLER PART                        IABS0020
       SUB     T1                                                       IABS0021
       TMI     XPRES           IF UNDERFLOW, ANS=BIGGER PART            IABS0022
       STO     BUFF+1                                                   IABS0023
       XCA                                                              IABS0024
       FMP     BUFF+1                                                   IABS0025
       FRN                                                              IABS0026
       STO     BUFF+1        SQUARE OF SMALLER PART                     IABS0027
       CLA     BUFF          MODIFY BIGGER PART                         IABS0028
       SUB     T1                                                       IABS0029
       STO     BUFF                                                     IABS0030
       XCA                                                              IABS0031
       FMP     BUFF                                                     IABS0032
       FRN                                                              IABS0033
       FAD     BUFF+1        SUM OF SQUARES                             IABS0034
       FRN                                                              IABS0035
       SXA     *+2,4                                                    IABS0036
       TSX     $SQRT,4                                                  IABS0037
       AXT     **,4                                                     IABS0038
       ADD     T1            RESTORE SCALING                            IABS0039
       PBT                                                              IABS0040
       TRA     OK                                                       IABS0041
       LDI     *+2           OVERFLOW, GO TO (EXE)                      IABS0042
       TTR*    $(EXE)                                                   IABS0043
       PZE     5,5,FIN                                                  IABS0044
 XPRES CLA     BUFF                                                     IABS0045
  OK   STO     -1            STORE ANSWER                               IABS0046
       STZ     -2            IMAGINARY PART OF ANS IS 0                 IABS0047
  FIN  TRA     1,4                                                      IABS0048
       SPACE                                                            IABS0049
 MASK  OCT     377000000000                                             IABS0050
 CH2HD OCT     200000000000                                             IABS0051
 BUFF  BSS     2                                                        IABS0052
  T1   BSS     1                                                        IABS0053
       END                                                              IABS0054
