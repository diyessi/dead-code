       ENTRY  XRTOUT                                                    FXPT0001
       ENTRY CRTOUT                                                     FXPT0002
XRTOUT CLA 1,4                                                          FXPT0003
       STA *+1                                                          FXPT0004
       CLA *                                                            FXPT0005
       STD 3,4                                                          FXPT0006
       TXI *+1,4,-1                                                     FXPT0007
CRTOUT CAL *+3                                                          FXPT0008
       SLW 1,4                                                          FXPT0009
       TRA 1,4                                                          FXPT0010
       TSX OUTCRT,4                                                     FXPT0011
       END                                                              FXPT0012
