*     FAP                                                               TANH0001
       LBL     TANH                                                     TANH0002
       COUNT   60                                                       TANH0003
*      U. OF CHICAGO VERSION OF HYPERBOLIC TANGENT                      TANH0004
*              NORMALIZED ARGUMENT RECEIVED IN AC, CALLED BY            TANH0005
*                            TSX  $TANH,4                               TANH0006
*              ANSWER IS GIVEN IN AC                                    TANH0007
       ENTRY   TANH                                                     TANH0008
       SPACE                                                            TANH0009
  TANH STO     SAVE1         SAVE ARGUMENT                              TANH0010
       SSP                                                              TANH0011
       LDQ     MAXIM         RETURN WITH 1.0                            TANH0012
       TLQ     ONE             IF BIGGER THAN 10.4                      TANH0013
       LDQ     TRESH         TEST FOR                                   TANH0014
       TLQ     OTHER           CIRCUIT                                  TANH0015
       LDQ     SAVE1                                                    TANH0016
       FMP     SAVE1         SQUARE                                     TANH0017
       STO     SAVE2                                                    TANH0018
       FAD     A0            IF /ARG/ SMALLER THAN 0.5493,              TANH0019
       STO     SAVE3                                                    TANH0020
       LDQ     B2              USE THE FRACTION FORMULA                 TANH0021
       FMP     SAVE2                                                    TANH0022
       FAD     B1                TANH(X)     B1*XSQ+B2*X**4             TANH0023
       XCA                       ------- = 1+--------------             TANH0024
       FMP     SAVE2                X           A0+XSQ                  TANH0025
       FDP     SAVE3                                                    TANH0026
       FMP     SAVE1                                                    TANH0027
       FAD     SAVE1                                                    TANH0028
       FRN                                                              TANH0029
       TRA     1,4                                                      TANH0030
       SPACE                                                            TANH0031
 OTHER FAM     SAVE1         CASE WHEN /X/ IS BET. 0.5493 AND 10.4      TANH0032
       SXA     X4,4                                                     TANH0033
       TSX     $EXP,4            TANH(X) = 1-2/(E**2X+1)                TANH0034
  X4   AXT     **,4                                                     TANH0035
       FAD     K1                                                       TANH0036
       STO     SAVE2                                                    TANH0037
       CLS     K2                                                       TANH0038
       FDP     SAVE2                                                    TANH0039
       XCA                                                              TANH0040
       FAD     K1                                                       TANH0041
       FRN                                                              TANH0042
  SIGN LDQ     SAVE1         SET                                        TANH0043
       LLS     0               SIGN                                     TANH0044
       TRA     1,4           RETURN TO MAIN PROGRAM                     TANH0045
       SPACE                                                            TANH0046
   ONE CLA     K1            PUT ONE AS                                 TANH0047
       TRA     SIGN              ANSWER                                 TANH0048
       SPACE                                                            TANH0049
 TRESH OCT     200431175237  0.5493061442                               TANH0050
    K2 OCT     202400000000  2.0                                        TANH0051
    K1 OCT     201400000000  1.0                                        TANH0052
  A0   OCT     202474246131    2.47128562                               TANH0053
  B1   OCT     -200645610120  -0.82376158                               TANH0054
  B2   OCT     -170766501005  -0.00383474                               TANH0055
 MAXIM OCT     204514631463  10.4                                       TANH0056
 SAVE1 PZE                                                              TANH0057
 SAVE2 PZE                                                              TANH0058
 SAVE3 PZE                                                              TANH0059
       END                                                              TANH0060
