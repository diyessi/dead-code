*      FAP                                                              MCSCN000
*MCSCN         FAST SINE/COSINE FOR MONTE-CARLO TYPE CALCULATIONS.      MCSCN001
       COUNT   250                                                      MCSCN002
       LBL     MCSCN,C                                                  MCSCN003
*                          SINE AND COSINE                              MCSCN004
*                                                                       MCSCN005
*              CALLING SEQUENCE  TSX  $MCSIN,4  ($MCCOS,4)              MCSCN006
       ENTRY   MCSIN                                                    MCSCN007
       ENTRY   MCCOS                                                    MCSCN008
       EVEN                                                             MCSCN009
 MCCOS FAD     =1.5707963           COS (THETA)=SIN (THETA+PI/2)        MCSCN010
 MCSIN TMI     T100                 SET ARGUMENT PLUS                   MCSCN011
 T30   CAS     =.02                 IF ARGUMENT LESS THAN .02           MCSCN012
       TRA     *+3                                                      MCSCN013
       TRA     1,4                  SET SIN(A)=A OR                     MCSCN014
       TRA     1,4                  COS (A)=SIN(A+PI/2)= A+PI/2         MCSCN015
       FDP     =1.5707963           X/(PI/2)                            MCSCN016
       ZAC                                                              MCSCN017
       LLS     8                                                        MCSCN018
       SUB     =O200                                                    MCSCN019
       TZE     M0                                                       MCSCN020
       TMI     RT                   SET X=F                             MCSCN021
       STA     LFT                                                      MCSCN022
       ZAC                                                              MCSCN023
 LFT   LLS     **                                                       MCSCN024
       ANA     =3                                                       MCSCN025
       CAS     =2                                                       MCSCN026
       TRA     M3                   SET X=F-1                           MCSCN027
       TRA     M2                   SET X=-F                            MCSCN028
       TZE     M0                   SET X=F                             MCSCN029
       XCA                          SET X=1-F                           MCSCN030
       COM                          X=1-F....B0                         MCSCN031
       XCA                                                              MCSCN032
       CLA     T100+1               SSP                                 MCSCN033
       TRA     SER                                                      MCSCN034
 M0    CLA     T100+1               SSP....X=F....B0                    MCSCN035
       TRA     SER                                                      MCSCN036
 M2    CLS     T100+1               SSM....X=-F....B0                   MCSCN037
       TRA     SER                                                      MCSCN038
 M3    XCA                                                              MCSCN039
       COM                          X=F-1....B0                         MCSCN040
       XCA                                                              MCSCN041
       CLS     T100+1               SSM                                 MCSCN042
       TRA     SER                                                      MCSCN043
 RT    STA     SHIFT                                                    MCSCN044
       ZAC                                                              MCSCN045
 SHIFT LRS     **                   X=F....B0                           MCSCN046
       CLA     T100+1               SSP                                 MCSCN047
 SER   STO     SIGN                                                     MCSCN048
       ZAC                                                              MCSCN049
       LLS     8                                                        MCSCN050
       SXA     EXT2,1                                                   MCSCN051
       SXA     EXT2-1,2                                                 MCSCN052
       PAX     0,1                  TABLE LOOK-UP SIN(X)                MCSCN053
       PAC     0,2                  TABLE LOOK-UP COS(X)                MCSCN054
       MPY     TBCOS,2              -8+10....B2                         MCSCN055
       ARS     12                   B14                                 MCSCN056
       XCA                                                              MCSCN057
       VLM     PIOV2,0,21           10+21+14-35....B10                  MCSCN058
       ADD     TBSIN,1              B10                                 MCSCN059
       ORA     =O202000000000       FLOAT RESULT                        MCSCN060
       FAD     =0                   NORMALIZE RESULT                    MCSCN061
 SIGN  PZE                          SETS SIGN                           MCSCN062
       AXT     **,2                                                     MCSCN063
 EXT2  AXT     **,1                                                     MCSCN064
       TRA     1,4                                                      MCSCN065
 T100  SXA     I4,4                 IF ARGUMENT NEGATIVE, CHANGE SIGN   MCSCN066
       SSP                                                              MCSCN067
       TSX     T30,4                ARRANGE TO SET RETURN NEGATIVE      MCSCN068
 I4    AXT     0,4                                                      MCSCN069
       CHS                                                              MCSCN070
       TRA     1,4                                                      MCSCN071
 PIOV2 DEC     1.5707963B10                                             MCSCN072
*                          TABLE OF SINES AND COSINES                   MCSCN073
