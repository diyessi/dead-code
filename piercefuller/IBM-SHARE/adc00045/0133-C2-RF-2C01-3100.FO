$IBFTC NEWR    LIST,REF,M94,XR5                                         2C010000
      SUBROUTINE NEWRA(M,C,R,MAX,EPS,ZERO,GG,KE)                        2C010010
      DIMENSION C(1),R(1),GG(2),G(4),S(2),T(2),X(2)                     2C010020
      DATA G(3),G(4)/.1,.1/                                             2C010030
      KE=0                                                              2C010040
      N=M                                                               2C010050
      S(1)=C(1)                                                         2C010060
      S(2)=C(2)                                                         2C010070
      Q=S(1)**2+S(2)**2                                                 2C010080
      IF(N.NE.1) GO TO 5                                                2C010090
      R(1)=-(S(1)*C(3)+S(2)*C(4))/Q                                     2C010100
      R(2)=(S(2)*C(3)-S(1)*C(4))/Q                                      2C010110
      GO TO 200                                                         2C010120
    5 L=0                                                               2C010130
      KR=0                                                              2C010140
      KT=0                                                              2C010150
      EN=N                                                              2C010160
      G(1)=GG(1)                                                        2C010170
      G(2)=GG(2)                                                        2C010180
      CM=(C(2*N+1)**2+C(2*N+2)**2)/Q                                    2C010190
      IF(CM.NE.0.) GO TO 10                                             2C010200
      CM=1.                                                             2C010210
      R(1)=0.                                                           2C010220
      R(2)=0.                                                           2C010230
      G(1)=.1                                                           2C010240
      L=1                                                               2C010250
   10 DO 15 I=1,N                                                       2C010260
      S(1)=S(1)+C(2*I+1)                                                2C010270
   15 S(2)=S(2)+C(2*I+2)                                                2C010280
      IF(SQRT((S(1)**2+S(2)**2)/CM)-ZERO)20,20,25                       2C010290
   20 R(2*L+1)=1.                                                       2C010300
      R(2*L+2)=0.                                                       2C010310
      G(1)=1.1                                                          2C010320
      G(2)=0.                                                           2C010330
      L=L+1                                                             2C010340
      IF(L-N)25,200,200                                                 2C010350
   25 IF(MOD(N,2))30,35,30                                              2C010360
   30 S(1)=C(3)-C(1)                                                    2C010370
      S(2)=C(4)-C(2)                                                    2C010380
      K=3                                                               2C010390
      GO TO 40                                                          2C010400
   35 S(1)=C(1)                                                         2C010410
      S(2)=C(2)                                                         2C010420
      K=2                                                               2C010430
   40 DO 45 I=K,N,2                                                     2C010440
      S(1)=S(1)-C(2*I-1)+C(2*I+1)                                       2C010450
   45 S(2)=S(2)-C(2*I)+C(2*I+2)                                         2C010460
      IF(SQRT((S(1)**2+S(2)**2)/CM)-ZERO)50,50,55                       2C010470
   50 R(2*L+1)=-1.                                                      2C010480
      R(2*L+2)=0.                                                       2C010490
      G(1)=-1.1                                                         2C010500
      G(2)=0.                                                           2C010510
      L=L+1                                                             2C010520
      IF(L-N)55,200,200                                                 2C010530
   55 Q=G(1)**2+G(2)**2                                                 2C010540
      IF(Q-1.)75,75,60                                                  2C010550
   60 G(1)=G(1)/Q                                                       2C010560
      G(2)=(-G(2))/Q                                                    2C010570
      KR=-1                                                             2C010580
   65 CM=1./CM                                                          2C010590
      K=(N+1)/2                                                         2C010600
      DO 70 I=1,K                                                       2C010610
      J=N-I                                                             2C010620
      T(1)=C(2*I-1)                                                     2C010630
      T(2)=C(2*I)                                                       2C010640
      C(2*I-1)=C(2*J+3)                                                 2C010650
      C(2*I)=C(2*J+4)                                                   2C010660
      C(2*J+3)=T(1)                                                     2C010670
   70 C(2*J+4)=T(2)                                                     2C010680
   75 IG=1                                                              2C010690
   80 X(1)=G(2*IG-1)                                                    2C010700
      X(2)=G(2*IG)                                                      2C010710
      DO 110 J=1,MAX                                                    2C010720
      P=EN                                                              2C010730
      S(1)=C(1)*X(1)-C(2)*X(2)+C(3)                                     2C010740
      S(2)=C(2)*X(1)+C(1)*X(2)+C(4)                                     2C010750
      T(1)=P*C(1)                                                       2C010760
      T(2)=P*C(2)                                                       2C010770
      DO 85 I=2,N                                                       2C010780
      Q=S(1)*X(1)-S(2)*X(2)+C(2*I+1)                                    2C010790
      S(2)=S(2)*X(1)+S(1)*X(2)+C(2*I+2)                                 2C010800
      S(1)=Q                                                            2C010810
      P=P-1.                                                            2C010820
      Q=T(1)*X(1)-T(2)*X(2)+P*C(2*I-1)                                  2C010830
      T(2)=T(2)*X(1)+T(1)*X(2)+P*C(2*I)                                 2C010840
   85 T(1)=Q                                                            2C010850
      P=S(1)**2+S(2)**2                                                 2C010860
      Q=(T(1)*S(1)+T(2)*S(2))/P                                         2C010870
      T(2)=(T(2)*S(1)-T(1)*S(2))/P                                      2C010880
      T(1)=Q                                                            2C010890
      IF(P.EQ.0.) T(1)=1.E16                                            2C010900
      IF(L)90,100,90                                                    2C010910
   90 DO 95 I=1,L                                                       2C010920
      S(1)=X(1)-R(2*I-1)                                                2C010930
      S(2)=X(2)-R(2*I)                                                  2C010940
      Q=S(1)**2+S(2)**2                                                 2C010950
      T(1)=T(1)-S(1)/Q                                                  2C010960
   95 T(2)=T(2)+S(2)/Q                                                  2C010970
  100 Q=T(1)**2+T(2)**2                                                 2C010980
      X(1)=X(1)-T(1)/Q                                                  2C010990
      X(2)=X(2)+T(2)/Q                                                  2C011000
      IF(1./SQRT(Q*(X(1)**2+X(2)**2))-EPS)105,105,110                   2C011010
  105 IF(SQRT(P/CM)-ZERO)160,160,110                                    2C011020
  110 CONTINUE                                                          2C011030
      IG=IG+1                                                           2C011040
      IF(IG-2)115,80,115                                                2C011050
  115 IF(KT)120,155,120                                                 2C011060
  120 IF(L)125,175,125                                                  2C011070
  125 KE=L                                                              2C011080
  130 IF(KR)135,200,135                                                 2C011090
  135 KT=0                                                              2C011100
  140 DO 145 I=1,L                                                      2C011110
      Q=R(2*I-1)**2+R(2*I)**2                                           2C011120
      R(2*I-1)=R(2*I-1)/Q                                               2C011130
  145 R(2*I)=(-R(2*I))/Q                                                2C011140
  150 IF(KT)65,200,65                                                   2C011150
  155 KT=1                                                              2C011160
      KR=KR+1                                                           2C011170
      Q=X(1)**2+X(2)**2                                                 2C011180
      G(1)=X(1)/Q                                                       2C011190
      G(2)=(-X(2))/Q                                                    2C011200
      IF(L)140,65,140                                                   2C011210
  160 IF(ABS(X(2)/X(1))-ZERO)165,165,170                                2C011220
  165 X(2)=0.                                                           2C011230
  170 R(2*L+1)=X(1)                                                     2C011240
      R(2*L+2)=X(2)                                                     2C011250
      G(1)=1.1*X(1)                                                     2C011260
      G(2)=1.1*X(2)                                                     2C011270
      L=L+1                                                             2C011280
      IF(L-N)75,130,130                                                 2C011290
  175 KE=-1                                                             2C011300
  200 RETURN                                                            2C011310
       END                                                              2C011320
