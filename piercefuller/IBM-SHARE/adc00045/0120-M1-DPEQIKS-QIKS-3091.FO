$IBFTC QIKS    REF                                                             -
      SUBROUTINE QIKS (MM,NN,MOVE,COMPAR,KEYLOC)                        QIKS0010
      DIMENSION MSAVE(20),NSAVE(20)                                     QIKS0020
      LEVEL  = 0                                                        QIKS0030
      M=MM                                                              QIKS0040
      N=NN                                                              QIKS0050
   35 CONTINUE                                                          QIKS0060
C     TEST FOR ONE OR TWO ITEMS                                         QIKS0070
      IF(N-M-1) 31,51,32                                                QIKS0080
C  32 CONTINUE                                                          QIKS0090
C                                                                       QIKS0100
C     PARTITION AND SPREADER GO HERE, SEE BELOW.  RETURN IS TO 8        QIKS0110
C                                                                       QIKS0120
C     PUSH DOWN                                                         QIKS0130
    8 LEVEL=LEVEL+1                                                     QIKS0140
C     WORK ON SMALLEST PORTION                                          QIKS0150
      IF (J-M.GT.N-I) GO TO 34                                          QIKS0160
      MSAVE(LEVEL)=I                                                    QIKS0170
      NSAVE(LEVEL)=N                                                    QIKS0180
      N=J                                                               QIKS0190
      GO TO 35                                                          QIKS0200
   34 MSAVE(LEVEL)=M                                                    QIKS0210
      NSAVE(LEVEL)=J                                                    QIKS0220
      M=I                                                               QIKS0230
      GO TO 35                                                          QIKS0240
   51 IF (COMPAR(M,N).LE.0.) GO TO 31                                   QIKS0250
C     SWAP IF ONLY TWO ITEMS ARE OUT OF ORDER                           QIKS0260
      CALL MOVE(M,0)                                                    QIKS0270
      CALL MOVE(N,M)                                                    QIKS0280
      CALL MOVE(0,N)                                                    QIKS0290
   31 IF (LEVEL.EQ.0) RETURN                                            QIKS0300
C     POP UP                                                            QIKS0310
      M=MSAVE(LEVEL)                                                    QIKS0320
      N=NSAVE(LEVEL)                                                    QIKS0330
      LEVEL=LEVEL-1                                                     QIKS0340
      GO TO 35                                                          QIKS0350
C     END   MAIN                                                        QIKS0360
C     PARTITION                                                         QIKS0370
   32 I=M                                                               QIKS0380
      J=N                                                               QIKS0390
      KEY = KEYLOC(M,N)                                                 QIKS0400
      CALL MOVE(KEY, 0)                                                 QIKS0410
   54 IF (N.EQ.KEY) GO TO 1                                             QIKS0420
   17 CALL MOVE(N,KEY)                                                  QIKS0430
    1 CONTINUE                                                          QIKS0440
C     HOLE AT BOTTOM                                                    QIKS0450
      IF(COMPAR(0,I).LT.0.) GO TO 3                                     QIKS0460
    2 I=I+1                                                             QIKS0470
      IF (I.EQ.J) GO TO 4                                               QIKS0480
      GO TO 1                                                           QIKS0490
    3 CALL MOVE(I,J)                                                    QIKS0500
      GO TO 5                                                           QIKS0510
    6 CONTINUE                                                          QIKS0520
C     HOLE AT TOP                                                       QIKS0530
      IF(COMPAR(0,J).GT.0.) GO TO 7                                     QIKS0540
    5 J=J-1                                                             QIKS0550
      IF(I.EQ.J) GO TO 4                                                QIKS0560
      GO TO 6                                                           QIKS0570
    7 CALL MOVE(J,I)                                                    QIKS0580
      GO TO 2                                                           QIKS0590
C   4 CONTINUE                                                          QIKS0600
C     SPREADER GOES HERE                                                QIKS0610
C     END   PARTITION                                                   QIKS0620
C                                                                       QIKS0630
C                                                                       QIKS0640
C     SPREADER                                                          QIKS0650
    4 CALL MOVE(0,I)                                                    QIKS0660
   12 IF (I.EQ.N) GO TO 10                                              QIKS0670
      I=I+1                                                             QIKS0680
      IF(COMPAR(0,I).EQ.0.) GO TO 12                                    QIKS0690
   10 IF(J.EQ.M) GO TO 8                                                QIKS0700
      J = J - 1                                                         QIKS0710
      IF (COMPAR(0,J).EQ.0.) GO TO 10                                   QIKS0720
      GO TO 8                                                           QIKS0730
C   8 CONTINUE                                                          QIKS0740
C     RETURN TO MAIN PROGRAM                                            QIKS0750
      END                                                               QIKS0760
$IBMAP KEYLOC  REF                                                             -
*      FUNCTION KEYLOC (M,N)                                            KEYL0010
*      VALUE OF FUNCTION IS RANDOM INTEGER BETWEEN M AND N              KEYL0020
KEYLOC SAVE                                                             KEYL0030
       CLA*    4,4                                                      KEYL0040
       SUB*    3,4                                                      KEYL0050
       STO     DIFF                                                     KEYL0060
       LDQ     RDM                                                      KEYL0070
       MPY     =O343277244615                                           KEYL0080
       LRS     18                                                       KEYL0090
       STQ     RDM                                                      KEYL0100
       MPY     DIFF                                                     KEYL0110
       ADD*    3,4                                                      KEYL0120
       RETURN  KEYLOC                                                   KEYL0130
RDM    OCT     343277244615                                             KEYL0140
       ENTRY   KEYLOC                                                   KEYL0150
DIFF   PZE                                                              KEYL0160
       END                                                              KEYL0170
