*                                                                       SASP1192
       ENTRY   UNWIND                                                   SASP1193
       ENTRY   LENGTH                                                   SASP1194
 MDIM  EQU     200            DIMENSION OF MANIP                        SASP1195
 PDIM  EQU     15                                                       SASP1196
*                                                                       SASP1197
*      FIND LENGTH ONLY OF WOUND STRING                                 SASP1198
*                                                                       SASP1199
LENGTH CLA     *                                                        SASP1200
       STO     LNSW                                                     SASP1201
       TRA     UNWIND+1                                                 SASP1202
*                                                                       SASP1203
*      UNWIND WOUND STRING                                              SASP1204
*                                                                       SASP1205
*                                                                       SASP1206
*      FIND NO. OF ARGUMENTS AND PICK UP THEIR ADDRESSES                SASP1207
*                                                                       SASP1208
UNWIND STZ     LNSW                                                     SASP1209
       CLA     1,4            IA                                        SASP1210
       ADD     =1                                                       SASP1211
       STA     UND                                                      SASP1212
       SXA     UNP,1                                                    SASP1213
       SXA     UNQ,2                                                    SASP1214
       SXA     UNR,4                                                    SASP1215
       NZT     LNSW                                                     SASP1216
       TRA     *+7                                                      SASP1217
       CLA     =1B17                                                    SASP1218
       STO     I                                                        SASP1219
       STO     J                                                        SASP1220
       CLA     =2                                                       SASP1221
       STZ     NCHS                                                     SASP1222
       TRA     UNB                                                      SASP1223
       CAL     4,4                                                      SASP1224
       ANA     =O777777700000                                           SASP1225
       SUB     =O007400000000                                           SASP1226
       TNZ     UNA            SKIP IF ONLY 3 ARGS.                      SASP1227
       CAL*    2,4            5 ARGS.                                   SASP1228
       STO     I                                                        SASP1229
       CAL*    3,4                                                      SASP1230
       STO     J                                                        SASP1231
       CLA     4,4                                                      SASP1232
       STA     BCDAD                                                    SASP1233
       CLA*    5,4                                                      SASP1234
       STO     NCHS                                                     SASP1235
       CLA     =6                                                       SASP1236
       TRA     UNB                                                      SASP1237
 UNA   CLA     =1B17                                                    SASP1238
       STO     I                                                        SASP1239
       STO     J                                                        SASP1240
       CLA     2,4                                                      SASP1241
       STA     BCDAD                                                    SASP1242
       CLA*    3,4                                                      SASP1243
       STO     NCHS                                                     SASP1244
       CLA     =4                                                       SASP1245
 UNB   STA     RTRN                                                     SASP1246
       CLA     I                                                        SASP1247
       STO     K                                                        SASP1248
*                                                                       SASP1249
*      UNWIND STRING(S) SINGLY                                          SASP1250
*                                                                       SASP1251
 UNC   CLA     =1B17                                                    SASP1252
       STO     LEVEL                                                    SASP1253
       LXD     K,1            GET NEXT STRING ADDRESS                   SASP1254
 UND   CLA     **,1                                                     SASP1255
       STO     V                                                        SASP1256
 UNE   LXD     V,1            START TO UNWIND NEXT STRING OR SUBSTRING  SASP1257
       CLA     V                                                        SASP1258
       ADD     =1B17                                                    SASP1259
       STO     NDX                                                      SASP1260
       ADD     MANIP+1,1                                                SASP1261
       STO     NWUP                                                     SASP1262
 UNF   LXD     NDX,1          EXAMINE NEXT ITEM IN WOUND SUBSTRING      SASP1263
       CLA     MANIP+1,1                                                SASP1264
       TZE     UNI            ZERO                                      SASP1265
       TPL     UNK            +N, BCD CHARS.                            SASP1266
       PDX     0,2            SAVE N OR IL                              SASP1267
       ANA     =O77777                                                  SASP1268
       TNZ     UNG            -(IL,IH), A REPR FUNCTION                 SASP1269
       NZT     MANIP+1,2      -N, A SUBSTRING                           SASP1270
       TRA     UNI            SKIP IF IT HAS ZERO ITEMS                 SASP1271
       CLA     LEVEL                                                    SASP1272
       SUB     LVLMX                                                    SASP1273
       SUB     =1B17                                                    SASP1274
       TMI     *+3                                                      SASP1275
       HPR     9              TOO MANY LEVELS OF SUBSTRING              SASP1276
       TRA     UNP            EXIT                                      SASP1277
       CLA     NWUP                                                     SASP1278
       ARS     18                                                       SASP1279
       ADD     NDX                                                      SASP1280
       SXD     V,2            V=N                                       SASP1281
       LXD     LEVEL,2        NDX,NWUP TO PDL(LEVEL)                    SASP1282
       STO     PDL,2                                                    SASP1283
       TXI     *+1,2,1        LEVEL=LEVEL+1                             SASP1284
       SXD     LEVEL,2                                                  SASP1285
       TRA     UNE            GO TO START THIS SUBSTRING                SASP1286
 UNG   SSP                                                              SASP1287
       ALS     18             IH                                        SASP1288
       STZ     N                                                        SASP1289
       SXD     N,2            IL                                        SASP1290
       ADD     =1B17          IH+1                                      SASP1291
       SUB     N              N=IH-IL+1                                 SASP1292
       STO     N                                                        SASP1293
       LXD     N,1                                                      SASP1294
       PXD     0,2                                                      SASP1295
       SSM                                                              SASP1296
       ADD     =2001B17                                                 SASP1297
       PDX     0,2            2001-IL                                   SASP1298
 UNH   LDQ     TEXT+1,2       STORE TEXT CHARS.                         SASP1299
       TSX     STOCH,4                                                  SASP1300
       CLA     NCHS                                                     SASP1301
       ADD     =1B17                                                    SASP1302
       STO     NCHS                                                     SASP1303
       TXI     *+1,2,-1                                                 SASP1304
       TIX     UNH,1,1                                                  SASP1305
       LXD     NDX,1                                                    SASP1306
 UNI   TXI     *+1,1,1                                                  SASP1307
       SXD     NDX,1                                                    SASP1308
 UNJ   CLA     NDX                                                      SASP1309
       SUB     NWUP                                                     SASP1310
       TZE     UNN            SKIP IF SUBSTRING FINISHED                SASP1311
       TMI     UNF            RETURN FOR NEXT ITEM IN SUBSTRING         SASP1312
       HPR     10                                                       SASP1313
       TRA     UNP            EXIT                                      SASP1314
 UNK   PDX     0,1            N (NO. OF CHARS.)                         SASP1315
       LXD     NDX,2          NDX                                       SASP1316
       TXI     *+1,2,1        NDX+1                                     SASP1317
       STZ     N                                                        SASP1318
 UNL   SXD     N,1            SAVE CHAR. COUNT                          SASP1319
       LDQ     MANIP+1,2                                                SASP1320
       LXA     N,1            PICK UP SHIFT                             SASP1321
       TXL     UNM,1,30       SKIP IF SAME WORD                         SASP1322
       TXI     *+1,2,1                                                  SASP1323
       LDQ     MANIP+1,2      GET NEXT WORD                             SASP1324
       AXT     0,1            WITH ZERO SHIFT                           SASP1325
 UNM   SXA     *+1,1          SET UP SHIFT                              SASP1326
       LGL     **             SHIFT CHAR.                               SASP1327
       TSX     STOCH,4        STORE NEXT CHAR.                          SASP1328
       CLA     NCHS                                                     SASP1329
       ADD     =1B17          INCR. CHAR. COUNT                         SASP1330
       STO     NCHS                                                     SASP1331
       TXI     *+1,1,6        INCREASE SHIFT                            SASP1332
       SXA     N,1            SAVE SHIFT FOR NEXT TIME                  SASP1333
       LXD     N,1            PICK UP CHAR. COUNT                       SASP1334
       TIX     UNL,1,1        RETURN FOR NEXT CHAR.                     SASP1335
       TXI     *+1,2,1                                                  SASP1336
       SXD     NDX,2          NDX=NDX+1                                 SASP1337
       TRA     UNJ                                                      SASP1338
 UNN   CLA     LEVEL          DECREASE LEVEL OF SUBSTRING               SASP1339
       SUB     =1B17                                                    SASP1340
       STO     LEVEL                                                    SASP1341
       TZE     UNO                                                      SASP1342
       PDX     0,2                                                      SASP1343
       CLA     PDL,2          PICK UP OLD NDX AND NWUP FROM PDL         SASP1344
       STD     NDX                                                      SASP1345
       ALS     18                                                       SASP1346
       STD     NWUP                                                     SASP1347
       LXD     NDX,1                                                    SASP1348
       TRA     UNI            GO BACK TO GET NEXT ITEM IN SUBSTRING     SASP1349
 UNO   CLA     K                                                        SASP1350
       ADD     =1B17                                                    SASP1351
       STO     K                                                        SASP1352
       SUB     J                                                        SASP1353
       TMI     UNC                                                      SASP1354
       TZE     UNC                                                      SASP1355
       CLA     RTRN                                                     SASP1356
       SUB     =1                                                       SASP1357
       STA     UNS                                                      SASP1358
 UNP   AXT     **,1                                                     SASP1359
 UNQ   AXT     **,2                                                     SASP1360
 UNR   AXT     **,4                                                     SASP1361
       CLA     NCHS                                                     SASP1362
       NZT     LNSW                                                     SASP1363
 UNS   STO*    **,4                                                     SASP1364
 RTRN  TRA     **,4                                                     SASP1365
*                                                                       SASP1366
*      STORE CHARACTER IN BCD ARRAY                                     SASP1367
*                                                                       SASP1368
 STOCH SXA     UNW,2                                                    SASP1369
       ZET     LNSW                                                     SASP1370
       TRA     UNW                                                      SASP1371
       STQ     TEMP           SAVE CHARACTER                            SASP1372
       CLA     NCHS           GET WORD NO.(=INTGR PART OF (NCHS-1)/6+1) SASP1373
       SUB     =1B17          AND CHAR. POSTN.(=MOD(NCHS-1,6)+1)        SASP1374
       ARS     18                                                       SASP1375
       LRS     35                                                       SASP1376
       DVH     =6                                                       SASP1377
       PAX     0,2            (CHAR. POSTN. -1) IN IR2                  SASP1378
       STO     TEMP+1                                                   SASP1379
       LLS     35             (WORD NO. -1) TO A.C.                     SASP1380
       ADD     BCDAD          WORD1+(WORD NO. -1)                       SASP1381
       STA     UNU                                                      SASP1382
       STA     UNV                                                      SASP1383
       CAL     =O770000000000                                           SASP1384
       TXL     UNT,2,0                                                  SASP1385
       ARS     6                                                        SASP1386
       TXI     *-2,2,-1                                                 SASP1387
 UNT   COM                                                              SASP1388
 UNU   ANS     **                                                       SASP1389
       CLS     TEMP+1                                                   SASP1390
       ADD     =6                                                       SASP1391
       PAX     0,2            (7-CHAR. POSTN.) IN IR2                   SASP1392
       LDQ     TEMP                                                     SASP1393
       PXD                                                              SASP1394
       LGL     6                                                        SASP1395
       TIX     *-1,2,1                                                  SASP1396
 UNV   ORS     **                                                       SASP1397
 UNW   AXT     **,2                                                     SASP1398
       TRA     1,4                                                      SASP1399
