*                                                                       VARP0044
*              CLEAR AND ADD                                            VARP0045
*              CALLING SEQUENCE                                         VARP0046
*              TSX $CLA,4                                               VARP0047
*              TSX A          WORD TAKEN TO AC                          VARP0048
*                                                                       VARP0049
 CLA   SXA     AXT,1                                                    VARP0050
       CLA     1,4                                                      VARP0051
       ADD     ONE                                                      VARP0052
       STA     *+2                                                      VARP0053
       LXD     NP1,1                                                    VARP0054
       CLA     0,1                                                      VARP0055
       STO     AC+1,1         PUT A IN AC                               VARP0056
       TIX     *-2,1,1                                                  VARP0057
 AXT   AXT     0,1                                                      VARP0058
       TRA     2,4                                                      VARP0059
*                                                                       VARP0060
*              CLEAR AND SUBTRACT                                       VARP0061
*              CALLING SEQUENCE                                         VARP0062
*              TSX $CLS,4                                               VARP0063
*              TSX A          NEGATIVE OF WORD TAKEN TO AC              VARP0064
*                                                                       VARP0065
 CLS   SXA     AXTA,1                                                   VARP0066
       CLA     1,4                                                      VARP0067
       STA     *+2                                                      VARP0068
       STA     *+4                                                      VARP0069
       CLA     0                                                        VARP0070
       STO     AC             EXPONENT UNCHANGED                        VARP0071
       LXD     N,1                                                      VARP0072
       CLS     0,1                                                      VARP0073
       STO     AC,1           PUT -A IN AC                              VARP0074
       TIX     *-2,1,1                                                  VARP0075
 AXTA  AXT     0,1                                                      VARP0076
       TRA     2,4                                                      VARP0077
*                                                                       VARP0078
*              LOAD MQ REGISTER                                         VARP0079
*              CALLING SEQUENCE                                         VARP0080
*              TSX $LDQ,4                                               VARP0081
