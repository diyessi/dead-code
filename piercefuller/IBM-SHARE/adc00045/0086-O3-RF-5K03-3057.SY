$IBMAP 5K03    M90                                                      5K030010
       REM     SKIP FILE SUBROUTINE                                     5K030020
       REM     J. HALLE 12/11/63                                        5K030030
       REM     CALL SKPFIL(L,N)                                         5K030040
       REM                                                              5K030050
       REM     L=LOGICAL TAPE NUMBER                                    5K030060
       REM     N-NO. OF FILES TO SKIP                                   5K030070
SKPFIL SAVE    (1,2)I                                                   5K030080
       CLA*    4,4                PICK UP NO. OF SKIP FILES             5K030090
       PAX     0,1                                                      5K030100
       CLA*    3,4                PICK UP TAPE NO.                      5K030110
       TSX     .IOU.F,4           PICK UP FILE CONTROL BLOCK            5K030120
       TZE     ERROR                                                    5K030130
       REM                        FIRST WORD OF FILE CONTROL BLOCK      5K030140
       STA     CLS1               STORE IN IOCS                         5K030150
       STA     OPN1               CALLING SEQUENCE                      5K030160
       STA     SKPR                                                     5K030170
       PAC     0,2                EXAMINE THIRD WORD                    5K030180
       LDI     2,2                IN FILE CONTROL BLOCK                 5K030190
       LFT     200000             FOR MONITOR CONTROL BITS              5K030200
       TRA     ERROR              MONITOR TAPE                          5K030210
       TSX     .CLOSE,4                                                 5K030220
 CLS1  MON     **                                                       5K030230
       LDI     1,2                GET SECOND WORD IN FCB                5K030240
       RIL     003000             SET BITS IN FCB                       5K030250
       STI     1,2                FOR,INPUT                             5K030260
       TSX     .OPEN,4            OPEN FILE                             5K030270
 OPN1  MON     **                                                       5K030280
 SKP   TSX     .READ,4            SKIP FILE                             5K030290
 SKPR  PZE     **,,SKP                                                  5K030300
       PZE     EOF,,SKP                                                 5K030310
       IORPN   **,,-1                                                   5K030320
       TCH     *-1                                                      5K030330
 EOF   TIX     SKP,1,1                                                  5K030340
       RETURN  SKPFIL                                                   5K030350
 ERROR XCA                        TAPE UNIT ERROR                       5K030360
       PAX     0,4                                                      5K030370
       SXD     CODE,4                                                   5K030380
       CALL    .FXEM.(CODE)                                             5K030390
       CALL    EXIT               NO OPTIONAL EXIT                      5K030400
 CODE  PZE     47                                                       5K030410
       END                                                              5K030420
