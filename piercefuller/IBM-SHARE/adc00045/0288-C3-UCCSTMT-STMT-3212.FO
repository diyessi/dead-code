C   THERMODYNAMIC PROPERTIES OF STEAM CASARELLA GADBOIS UCC STMT                
      SUBROUTINE STEAMT (T,PA,J,K,S,SPVOL,H)                                    
C        CODE                                                                   
C       J              K                                                        
C       1  HSS         1  H                                                     
C       2  TSL         2  S                                                     
C       3  PSL         3  V                                                     
C       4  HSL         4  H,V                                                   
C       5  SSL         5  H,S                                                   
C       6  VSL         6  V,S                                                   
C       7  HSV         7  H,S,V                                                 
      GOTO(1,2,3,4,5,6,7),J                                                     
C                                                                               
C     CALCULATE HSS                                                             
C                                                                               
 1    TC=0.55555555*(T-32.)                                                     
      P=PA/14.696                                                               
      TAU=1./(273.16+TC)                                                        
      ALFA=(2641.62)*10.**(80870.*TAU**2)                                       
      BETA=80870.*ALOG(10.)*TAU**2                                              
      GAMA=ALFA*(1.+2.*BETA)                                                    
      DELTA=82.546-(162460.*TAU)                                                
      EPS=0.21828-(126970.*TAU**2)                                              
      RHO=(.0003635)-( 0.6768E-07 )*(10.**3*TAU)**24                            
      B0=1.89-TAU*ALFA                                                          
      AMU1=(P**2)/2.                                                            
      AMU2=(TAU*P)**4/4.                                                        
       IF ( AMU2  -   1.0E-07 ) 999,999, 998                                    
 999   AMU3  =   0.0                                                            
       AMXX  =     0.0                                                          
       GO  TO   997                                                             
 998   AMU3   =   ( TAU * P ) ** 13   / 13.0                                    
       AMXX  =  ( TAU * P ) **12                                                
 997  GAM1=(B0**2)*(TAU**2)*(3.*DELTA-162460.*TAU)                              
     1  -DELTA*(TAU**3)*2.*B0*GAMA                                              
      GAM2=((B0**4)/TAU)*(4.*EPS-253940.*TAU**2)                                
     1  -EPS*4.*(B0**3)*GAMA                                                    
      GAM3=((-B0**12 *B0)/TAU)*(13.*RHO-.162432E-05 *                           
     1  (10.**3*TAU)**24 )+(RHO*13.*B0**12 *GAMA)                               
C                                                                               
       CALL  OVERFL (JJ )                                                       
       IF (JJ - 2 )901, 902, 903                                                
 901   PRINT 904                                                                
 904   FORMAT ( 20H  OVERFLOW  IN  HSS              )                           
       GO  TO  902                                                              
 903   PRINT 905                                                                
 905   FORMAT ( 20H  UNDERFLOW  IN HSS               )                          
 902  GOTO(300,100,302,300,300,100,300),K                                       
C                                                                               
 300  H=((P*(1.89-2.*TAU*ALFA*(1.+BETA))+GAM1*AMU1                              
     1  +GAM2*AMU2+GAM3*AMU3)*.101295+1.472/TAU                                 
     2  +(.00037783)/(TAU**2)-47.8365*ALOG(TAU)                                 
     3  +1803.71)*.43                                                           
C                                                                               
      GOTO(400,100,302,302,100,100,100),K                                       
C                                                                               
 100  S=(-(4.55504*ALOG(P)+((TAU**2)*GAMA*P)                                    
     1  +(-GAM1+(B0**2)*(TAU**2)*DELTA)*TAU*AMU1                                
     2  +(-GAM2+(B0**4)*EPS/TAU)*TAU*AMU2                                       
     3  -(GAM3+B0**12 *B0/TAU*RHO)*TAU*AMU3)*.101295                            
     4  -(1.472)*ALOG(TAU)+.00075566/TAU                                        
     5  -47.8365*TAU-1.48847)*.23888888                                         
C                                                                               
      GOTO(400,400,302,302,400,302,302),K                                       
C                                                                               
 302  SPVOL=(4.55504/(P*TAU)+B0+B0**2*TAU**2                                    
     1 *DELTA*P+(B0**4)*((TAU*P)**3)*EPS                                        
     2 -B0**12 *B0* AMXX       *RHO)*.0160185                                   
C                                                                               
 400  RETURN                                                                    
C                                                                               
C                                                                               
C     CALCULATE TSL                                                             
C                                                                               
 2    IF(PA-450.)20,21,21                                                       
 20   IF(PA-.2)23,24,24                                                         
 24   DUM=ALOG(10.*PA)                                                          
      T=35.15789+DUM*(24.592588+DUM*(2.1182069-DUM*                             
     1  .3414474+DUM*(.15741642*DUM+DUM*(-.031329585*                           
     2  DUM+DUM*(.0038658282*DUM+DUM*(-.00024901784*                            
     3  DUM+DUM*(DUM* 0.68401559E-05 )))))))                                    
       GO  TO    400                                                            
C                                                                               
 21   IF(PA-3206.)22,22,27                                                      
 22   DUM=ALOG(PA)                                                              
      T=11545.164+DUM*(-8386.0182+DUM*(2477.7661-                               
     1  363.44271*DUM+DUM*(26.690978*DUM+DUM*                                   
     2  (-0.78073813*DUM))))                                                    
       GO  TO    400                                                            
C                                                                               
C     CALCULATE PSL                                                             
C                                                                               
 3    IF (T-50.)28,29,29                                                        
 29   IF (T-200.)30,31,31                                                       
 30   TK=.55555555*(T-32.)+273.16                                               
      P=218.167/(10.**(((647.27-TK)/TK)*((3.2437814                             
     1  +.00586826*(647.27-TK)+( 0.11702379E-07 ) *                             
     2  (647.27-TK)**3)/(1.+.0021878462*(647.27-TK)))))                         
      PA=P*14.696                                                               
       GO  TO    400                                                            
C                                                                               
 31   IF(T-705.)32,32,33                                                        
 32   TK=.55555555*(T-32.)+273.16                                               
      P=(218.167)/(10.**(((647.27-TK)/TK)*((3.346313                            
     1  +.0414113*(647.27-TK)+  0.7515484E-08                                   
     2  *(647.27-TK)**3+ 0.65644E-10     *(647.27-TK)                           
     3  **4)/(1.+.013794481*(647.27-TK)))))                                     
      PA=P*14.696                                                               
       GO  TO    400                                                            
C                                                                               
C     CALCULATE HSL                                                             
C                                                                               
 4    IF (T-50.)70,34,34                                                        
 34   IF (T-360.)35,36,36                                                       
C                                                                               
 35   H=-32.179105+T*(1.0088084+T*(-.00011516996+                               
     1 0.48553836E-06 * T + T * ( -0.73618778E-09 * T                           
     2  +T*( 0.96350315E-12  * T ))))                                           
       GO  TO    400                                                            
C                                                                               
 36   IF (T-600.)38,38,39                                                       
 38   H=-904.11706+T*(10.673802+T*(-.042753836+                                 
     1  .0000941244*T+T*(-.10315357E-06  *T+T*(                                 
     2  0.4560246E-10 * T ))))                                                  
       GO  TO    400                                                            
C                                                                               
C     CALCULATE SSL                                                             
C                                                                               
 5    IF(T-50.)41,42,42                                                         
 42   IF(T-450.)43,44,44                                                        
 43   TBAR=(T-360.)/310.                                                        
C                                                                               
      S=.51575516+TBAR*(.39679646+TBAR*(-.045979941                             
     1  +.034251697*TBAR+TBAR*(-.006072333*TBAR+                                
     2  TBAR*(-.003670358*TBAR+TBAR*(.012035893*                                
     3  TBAR+TBAR*(.01234655*TBAR))))))                                         
       GO  TO    400                                                            
C                                                                               
 44   IF (T-670.)46,46,47                                                       
 46   TBAR=(T-560.)/110.                                                        
      S=.76209767+TBAR*(.13690825+TBAR*(.0075137702                             
     1  +.0057828937*TBAR+TBAR*(-.0016168801*TBAR+                              
     2  TBAR*(-.0021403201*TBAR+TBAR*(.0039726934*                              
     3  TBAR+TBAR*(.0034265601*TBAR))))))                                       
       GO  TO    400                                                            
C                                                                               
C      CALCULATE  VSL                                                           
C                                                                               
 6     IF ( T - 50.0 ) 189,189,188                                              
 188  IF(T-680.0)18,18,19                                                       
  18  X=705.398-T                                                               
      A=.051219154                                                              
      B=-4.1500649E-3                                                           
      C=-1.0709026E-5                                                           
      D=.87506378E-15                                                           
      E=.11036207                                                               
      F=-2.19236834E-3                                                          
      Y1=A+B*(X**(1.0/3.0))+C*X+(X**4)*D                                        
      Y2=1.+E*(X**(1.0/3.0))+F*X                                                
       SPVOL   =   Y1  /  Y2                                                    
       GO   TO  400                                                             
C                                                                               
C     CALCULATE HSV ,COMBINING TSL AND HSS                                      
C                                                                               
 7    IF(PA-450.)50,51,51                                                       
 50   IF(PA-.2)23,53,53                                                         
 53   DUM=ALOG(10.*PA)                                                          
      T=35.15789+DUM*(24.592588+DUM*(2.1182069-DUM*                             
     1  .3414474+DUM*(.15741642*DUM+DUM*(-.031329585*                           
     2  DUM+DUM*(.0038658282*DUM+DUM*(-.00024901784*                            
     3  DUM+DUM*(DUM*.68401559E-05 )))))))                                      
      GOTO1                                                                     
C                                                                               
 51   IF(PA-2200.)55,55,200                                                     
C                                                                               
 55   DUM=ALOG(PA)                                                              
      T=11545.164+DUM*(-8386.0182+DUM*(2477.7661-                               
     1  363.44271*DUM+DUM*(26.690978*DUM+DUM*                                   
     2  (-0.78073813*DUM))))                                                    
      GOTO1                                                                     
C                                                                               
 23    PRINT 150,   PA                                                          
 150  FORMAT (29H1P IS LESS THAN .2 IN TSL  P=F7.4)                             
       GO  TO    400                                                            
 27    PRINT 151,  PA                                                           
 151  FORMAT (34H1P IS GREATER THAN 3206 IN TSL  P=F8.1)                        
       GO  TO    400                                                            
 28    PRINT  152,  T                                                           
 152  FORMAT (29H1T IS LESS THAN 50 IN PSL  T=F6.3)                             
       GO  TO    400                                                            
 33    PRINT  153,     T                                                        
 153  FORMAT (32H1T IS GREATER THAN 705 IN PSL T=F8.1)                          
       GO  TO    400                                                            
 70    PRINT  154,  T                                                           
 154  FORMAT (28H1T IS LESS THAN 50 IN HSL T=F6.3)                              
       GO  TO    400                                                            
 39    PRINT 155,    T                                                          
 155  FORMAT (32H1T IS GREATER THAN 600 IN HSL T=F8.1)                          
       GO  TO    400                                                            
 41    PRINT 156,  T                                                            
 156  FORMAT (29H1T IS LESS THAN 50 IN SSL  T=F5.2)                             
       GO  TO    400                                                            
 47    PRINT  157,   T                                                          
 157  FORMAT (32H1T IS GREATER THAN 670 IN SSL T=F8.1)                          
       GO  TO    400                                                            
 200   PRINT  158,  PA                                                          
 158  FORMAT (33H1P IS GREATER THAN 2200 IN HSV P=F8.1)                         
       GO  TO    400                                                            
 19    PRINT 199 ,  T                                                           
 199  FORMAT (32H1T IS GREATER THAN 680 IN VSL T=F8.1)                          
       GO  TO  400                                                              
 189   PRINT 187, T                                                             
 187   FORMAT(29H1T IS LESS THAN 50 IN VSL  T=F5.2)                             
       GO  TO  400                                                              
       END                                                                      
