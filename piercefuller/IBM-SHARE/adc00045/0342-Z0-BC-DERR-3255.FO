*     LIST 8                                                                    
*     LABEL                                                                     
*     FORTRAN                                                                   
       FUNCTION  ERR(X)                                                 DERR 001
                                                                        DERR 002
C......ERROR FUNCTION ERR(X) AS POWER SERIES IN X WITH UP TO 60 TERMS.  DERR 003
C......  X  MUST NOT EXCEED  2.5                                        DERR 004
                                                                        DERR 005
C......DIMENSION IS (1) IN DOUBLE PRECISION FOR ALL DECIMAL VARIABLES.  DERR 006
                                                                        DERR 007
       IF (MARK) 4, 1, 4                                                DERR 008
    1  MARK = 1                                                         DERR 009
D     SQRT PI=1.7724538509055160                                        DERR 010
D      C = 2.0/SQRT PI                                                  DERR 011
D   4  Y = X**2                                                         DERR 012
D      S = 1.0                                                          DERR 013
D      T = 1.0 - Y/3.0                                                  DERR 014
                                                                        DERR 015
       DO  20  N = 2, 60, 2                                             DERR 016
D     ZN=N                                                              DERR 017
                                                                        DERR 018
D   5  S = S * ( Y**2/( (ZN - 1.0) * ZN ) )                             DERR 019
                                                                        DERR 020
D   6  DEN1 = 2.0*ZN + 1.0                                              DERR 021
D   7  DEN2 = (DEN1 + 2.0)*(ZN + 1.0)                                   DERR 022
                                                                        DERR 023
D   8  U = S * ( (1.0/DEN 1) - (Y/DEN 2) )                              DERR 024
                                                                        DERR 025
D  10  T  =  T + U                                                      DERR 026
                                                                        DERR 027
                                                                        DERR 028
   15  IF (N-20)  20, 16,  16                                           DERR 029
D  16  V = U - 0.00000 00000 00001                                      DERR 030
D  18  IF  (V)  50,  20,  20                                            DERR 031
                                                                        DERR 032
   20  CONTINUE                                                         DERR 033
                                                                        DERR 034
D  50  ERR = C*X*T                                                      DERR 035
                                                                        DERR 036
  999  RETURN                                                           DERR 037
       END                                                              DERR 038
