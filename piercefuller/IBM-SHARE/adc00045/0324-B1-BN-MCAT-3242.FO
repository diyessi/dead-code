*      FAP                                                              MCATN000
*MCATAN        FAST ARCTANGENT FOR MONTE-CARLO TYPE CALCULATIONS.       MCATN001
       COUNT   250                                                      MCATN002
       LBL     MCATAN,C                                                 MCATN003
*                          ARCTANGENT                                   MCATN004
*                                                                       MCATN005
*              CALLING SEQUENCE  TSX  $MCATAN,4                         MCATN006
*                                                                       MCATN007
*              RESULT WILL BE BETWEEN -PI/2 AND +PI/2                   MCATN008
       ENTRY   MCATAN                                                   MCATN009
       EVEN                                                             MCATN010
FLONE  DEC     1.0                                                      MCATN011
MCATAN TMI     T101                 SET ARGUMENT PLUS                   MCATN012
 T31   CAS     FLONE                                                    MCATN013
       TRA     I3                   IF ARGUMENT GREATER THAN ONE        MCATN014
       TRA     ONE                  IF ARGUMENT EQUALS ONE              MCATN015
 T50   LRS     27                   ARGUMENT LESS THAN ONE              MCATN016
       SUB     =O200                                                    MCATN017
       STA     T51                                                      MCATN018
       ZAC                                                              MCATN019
 T51   LRS     **                   X....B0                             MCATN020
       STQ     X                                                        MCATN021
       LLS     6                    A1                                  MCATN022
       SXA     EXT4,1                                                   MCATN023
       PAX     0,1                  TABLE LOOK-UP                       MCATN024
       STQ     V                    X-A1....B-6                         MCATN025
       XCA                                                              MCATN026
       VLM     X,0,8                0+29+8-35....B2                     MCATN027
       ADD     =O100000000000       1+A1*X....B2                        MCATN028
       STO     DENOM                B2                                  MCATN029
       CLA     V                    B-6                                 MCATN030
       LRS     16                   B10                                 MCATN031
       DVP     DENOM                T1....10-2....B8                    MCATN032
       XCA                                                              MCATN033
       ADD     TBTAN,1              B8                                  MCATN034
       ORA     =O200000000000       FLOAT RESULT                        MCATN035
       FAD     =0                   NORMALIZE RESULT                    MCATN036
 EXT4  AXT     **,1                                                     MCATN037
       TRA     1,4                                                      MCATN038
 ONE   CLA     =.78539815           IF ARGUMENT EQUALS ONE              MCATN039
       TRA     1,4                                                      MCATN040
 I3    SXA     I5,4                 IF ARGUMENT GREATER THAN ONE        MCATN041
       STO     X                                                        MCATN042
       CLA     FLONE                                                    MCATN043
       FDP     X                    1/X                                 MCATN044
       XCA                                                              MCATN045
       TSX     T50,4                                                    MCATN046
 I5    AXT     **,4                                                     MCATN047
       SSM                                                              MCATN048
       FAD     =1.5707963           ATAN(X)=PI/2-ATAN(1/X)              MCATN049
       TRA     1,4                                                      MCATN050
 T101  SXA     I6,4                 IF ARGUMENT NEGATIVE,               MCATN051
       SSP                          SET POSITIVE                        MCATN052
       TSX     T31,4                ARRANGE TO SET RETURN NEGATIVE      MCATN053
 I6    AXT     **,4                                                     MCATN054
       SSM                                                              MCATN055
       TRA     1,4                                                      MCATN056
*                          TABLE OF ARCTANGENTS                         MCATN057
       DEC     .77752430B8          TABLE GIVES ATAN(X)                 MCATN058
       DEC     .76952647B8          X=.00+N*DELTA                       MCATN059
       DEC     .76140275B8          DELTA=2**-6=.015625                 MCATN060
       DEC     .75315127B8          N=0,1,2,3,....,63                   MCATN061
       DEC     .74477011B8                                              MCATN062
       DEC     .73625742B8                                              MCATN063
       DEC     .72761132B8                                              MCATN064
       DEC     .71882998B8                                              MCATN065
       DEC     .70991160B8                                              MCATN066
       DEC     .70085439B8                                              MCATN067
       DEC     .69165660B8                                              MCATN068
       DEC     .68231653B8                                              MCATN069
       DEC     .67283254B8                                              MCATN070
       DEC     .66320299B8                                              MCATN071
       DEC     .65342633B8                                              MCATN072
       DEC     .64350110B8                                              MCATN073
       DEC     .63342587B8                                              MCATN074
       DEC     .62319933B8                                              MCATN075
       DEC     .61282020B8                                              MCATN076
       DEC     .60228734B8                                              MCATN077
       DEC     .59159970B8                                              MCATN078
       DEC     .58075634B8                                              MCATN079
       DEC     .56975645B8                                              MCATN080
       DEC     .55859930B8                                              MCATN081
       DEC     .54728437B8                                              MCATN082
       DEC     .53581122B8                                              MCATN083
       DEC     .52417962B8                                              MCATN084
       DEC     .51238947B8                                              MCATN085
       DEC     .50044082B8                                              MCATN086
       DEC     .48833395B8                                              MCATN087
       DEC     .47606934B8                                              MCATN088
       DEC     .46364762B8                                              MCATN089
       DEC     .45106965B8                                              MCATN090
       DEC     .43833657B8                                              MCATN091
       DEC     .42544964B8                                              MCATN092
       DEC     .41241045B8                                              MCATN093
       DEC     .39922078B8                                              MCATN094
       DEC     .38588268B8                                              MCATN095
       DEC     .37239844B8                                              MCATN096
       DEC     .35877068B8                                              MCATN097
       DEC     .34500217B8                                              MCATN098
       DEC     .33109608B8                                              MCATN099
       DEC     .31705576B8                                              MCATN100
       DEC     .30288486B8                                              MCATN101
       DEC     .28858738B8                                              MCATN102
       DEC     .27416745B8                                              MCATN103
       DEC     .25962962B8                                              MCATN104
       DEC     .24497867B8                                              MCATN105
       DEC     .23021960B8                                              MCATN106
       DEC     .21535770B8                                              MCATN107
       DEC     .20039856B8                                              MCATN108
       DEC     .18534795B8                                              MCATN109
       DEC     .17021192B8                                              MCATN110
       DEC     .15499674B8                                              MCATN111
       DEC     .13970887B8                                              MCATN112
       DEC     .12435499B8                                              MCATN113
       DEC     .10894195B8                                              MCATN114
       DEC     .09347678B8                                              MCATN115
       DEC     .07796663B8                                              MCATN116
       DEC     .06241880B8                                              MCATN117
       DEC     .04684071B8                                              MCATN118
       DEC     .03123983B8                                              MCATN119
       DEC     .01562373B8                                              MCATN120
 TBTAN DEC     .00000000B8                                              MCATN121
       COMMON  -206                                                     MCATN122
X      COMMON  1                                                        MCATN123
V      COMMON  1                                                        MCATN124
DENOM  COMMON  1                                                        MCATN125
       END                                                              MCATN126
