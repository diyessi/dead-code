*     FAP                                                                       
       LBL     DEXP                                                     DEXP0000
       COUNT   60                                                       DEXP0001
*      UNIVERSITY OF CHICAGO DOUBLE PRECISION EXPONENTIAL               DEXP0002
*      MOST SIGNIFICANT PART OF ARGUMENT IN 32767                       DEXP0003
*      LEAST SIGNIFICANT PART OF ARGUMENT IN 32766                      DEXP0004
*      ANSWER IN SAME FORM                                              DEXP0005
       ENTRY   DEXP                                                     DEXP0006
 DEXP  CLA     L+1                                                      DEXP0007
       LDQ     MAXIM                                                    DEXP0008
       TLQ     TOBIG         ERROR IF ARG TOO BIG                       DEXP0009
       LDQ     MINIM                                                    DEXP0010
       TLQ     BEGIN                                                    DEXP0011
       DLD     ZERO          ARG TOO SMALL, GIVE 0                      DEXP0012
       TRA     RETN-1                                                   DEXP0013
 BEGIN STI     IND                                                      DEXP0014
       SXA     X4,4                                                     DEXP0015
       ARS     9                                                        DEXP0016
       PDX     ,4            CHARACTERISTIC TO XR4                      DEXP0017
       LDQ     L                                                        DEXP0018
       LLS     8                                                        DEXP0019
       CLA     L+1                                                      DEXP0020
       LRS     0                                                        DEXP0021
       LLS     8                                                        DEXP0022
       STO     CHAR          Y=X*LOGE(BASE2)   E**X=2**Y                DEXP0023
       MPR     LOG2E           MULTIPLY FIXED POINT FASHION             DEXP0024
       STO     L                 TO INSURE ACCURACY                     DEXP0025
       LDQ     CHAR                                                     DEXP0026
       MPR     LOG2E+1                                                  DEXP0027
       ADD     L                                                        DEXP0028
       LRS     35                                                       DEXP0029
       DST     L                                                        DEXP0030
       LDQ     CHAR                                                     DEXP0031
       MPY     LOG2E                                                    DEXP0032
       STO     CHAR                                                     DEXP0033
       XCA                                                              DEXP0034
       ADD     L+1                                                      DEXP0035
       LRS     35                                                       DEXP0036
       ADD     L                                                        DEXP0037
       ADD     CHAR                                                     DEXP0038
       LRS     135,4         PRODUCT READY, SCALE B8                    DEXP0039
       STO     L                                                        DEXP0040
       ARS     27            DECOMPOSE Y=Y1+Y2                          DEXP0041
       ALS     27              Y1 INTEGER PART, Y2 FRACTION PART        DEXP0042
       TPL     *+2                                                      DEXP0043
       SUB     CHONE         IF Y NEGATIVE,                             DEXP0044
       STO     CHAR            Y1-1 IS CHARACTERISTIC MODIFIER,         DEXP0045
       CLA     L               Y2+1 IS MODIFIED FRACTION                DEXP0046
       ALS     10                                                       DEXP0047
       ARS     2                                                        DEXP0048
       LRS     8                                                        DEXP0049
       ORA     CH2HD                                                    DEXP0050
       TPL     *+2                                                      DEXP0051
       DFAD    K1                                                       DEXP0052
       DFAD    ZERO                                                     DEXP0053
       DST     L             Y2 READY                                   DEXP0054
       DLD     K                                                        DEXP0055
       AXT     22,4          COMPUTE E**X                               DEXP0056
  LOOP DFMP    L               VIA POWER SERIE                          DEXP0057
       DFAD    K1+2,4                                                   DEXP0058
       TIX     LOOP,4,2                                                 DEXP0059
       ADD     CHAR                                                     DEXP0060
       DFAD    ZERO                                                     DEXP0061
       XCA                                                              DEXP0062
    X4 AXT     **,4          RESET INDEX                                DEXP0063
       LDI     IND              RESTORE INDICATORS                      DEXP0064
       DST     L                                                        DEXP0065
  RETN TRA     1,4                                                      DEXP0066
 TOBIG LDI     *+2                                                      DEXP0067
       TRA*    $(EXE)                                                   DEXP0068
       PZE     1,7,RETN                                                 DEXP0069
 CHAR  PZE                                                              DEXP0070
       EVEN                                                             DEXP0071
  ZERO OCT     0,0                                                      DEXP0072
     K OCT     142532374743,107537467743  CHEBYCHEV CONSTANTS           DEXP0073
       OCT     145701221314,112343676276                                DEXP0074
       OCT     151670457337,116044431210                                DEXP0075
       OCT     155542424727,122264337060                                DEXP0076
       OCT     160777640427,125426625754                                DEXP0077
       OCT     164503021727,131237013176                                DEXP0078
       OCT     167535417775,134747136776                                DEXP0079
       OCT     172473125333,137657134507                                DEXP0080
       OCT     174706541065,141603405315                                DEXP0081
       OCT     176753767577,143701275247                                DEXP0082
       OCT     200542710277,145575071765                                DEXP0083
    K1 OCT     201400000000,146000000000                                DEXP0084
 LOG2E OCT     270524354512,340577027357                                DEXP0085
 MAXIM OCT     207540074635        88.029691                            DEXP0086
 MINIM OCT     -207545523741       -89.415986                           DEXP0087
 CHONE OCT     1000000000                                               DEXP0088
 CH2HD OCT     200000000000                                             DEXP0089
   IND PZE                                                              DEXP0090
     L EQU     -2                                                       DEXP0091
       END                                                              DEXP0092
