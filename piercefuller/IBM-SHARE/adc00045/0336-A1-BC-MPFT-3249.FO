                                                                        MPFT 001
*      LABEL                                                            MPFT 002
*      FAP                                                              MPFT 003
*MPFACTORIZATION                 12 DEC 63                              MPFT 004
       COUNT   120                                                      MPFT 005
*              MUST BE IN AXM BEFORE CALLING MPFACT                     MPFT 006
*              IND = MPFACT(COMP,NC,PTABLE,NP,BOUND,F,M,NF,RES,NR)      MPFT 007
*              IND=0               ON NORMAL RETURN                     MPFT 008
*              IND=1               IF INCOMPLETE DECOMPOSITION          MPFT 009
*              IND=2               IF COMP=0 OR 1                       MPFT 010
*              IND=-NC IF NC GREATER THAN MAXNC                         MPFT 011
       ENTRY   MPFACT                                                   MPFT 012
 MAXNC EQU     32                                                       MPFT 013
*              DEFINE PXX FOR CURRENT FORTRAN                           MPFT 014
*              IF PXD,  M ARRAY IS IN DECR...IF PXA, IN ADDRESS         MPFT 015
 PXX   OPSYN   PXD           CHANGE TO PXA FOR FORTRAN 4                MPFT 016
*                                                                       MPFT 017
MPFACT SXA     X1,1                COMP=ADDRESS OF COMPOSITE            MPFT 018
       SXA     X2,2                NC=NUMBER OF WORDS IN COMP           MPFT 019
       SXA     X3,3                COMP(1) IS LEAST SIGNIFICANT         MPFT 020
       SXA     X4,4                PTABLE=ADDRESS OF TABLE OF           MPFT 021
       SXA     X5,5                FULL WORD PRIMES (STARTING AT 2)     MPFT 022
       CLA*    2,4                 NP=LENGTH OF PTABLE                  MPFT 023
       PDX     0,5                                                      MPFT 024
       SSM                                                              MPFT 025
       TIX     X5,5,MAXNC                                               MPFT 026
       CAL     3,4                 BOUND=FULL WORD UPPER                MPFT 027
       ADM     =1                  BOUND ON PRIME                       MPFT 028
       STA     PTAB                FACTOR                               MPFT 029
       CLA*    4,4                                                      MPFT 030
       STD     NP                  F=TABLE OF PRIME FACTORS             MPFT 031
       CAL     6,4                 (FULL WORD)                          MPFT 032
       STA     FACT                                                     MPFT 033
       CAL     7,4                 M=TABLE OF MULTIPLICITIES            MPFT 034
       STA     MULT                (FORTRAN)                            MPFT 035
       CLA     =1B17                                                    MPFT 036
       STO*    7,4                                                      MPFT 037
       CLA*    5,4                                                      MPFT 038
       STO     BOUND                                                    MPFT 039
       TXI     *+1,5,-1                                                 MPFT 040
       SXA     NC,5                                                     MPFT 041
       CLA*    1,4                 NF=LENGTH OF F OR M                  MPFT 042
       SLW*    6,4                                                      MPFT 043
       SLW     COMP1               RES=RESIDUE OF COMPOSITE             MPFT 044
       STO     SIGN          AFTER DECOMPOSITION (SAME SIGN AS COMP)    MPFT 045
       TXL     TEST,5,0            TEST FOR NC=1                        MPFT 046
       CAL     1,4                                                      MPFT 047
       STA     GETCO         PICK UP HIGHER ORDER                       MPFT 048
       PXD     0,0                 WORDS OF COMP                        MPFT 049
 GETCO LDQ     *-*,5               (NC-1) OF THEM                       MPFT 050
       LRS     0                                                        MPFT 051
       STQ     COMP1,5                                                  MPFT 052
       ORA     COMP1,5                                                  MPFT 053
       TIX     GETCO,5,1                                                MPFT 054
       TNZ     DECOMP                                                   MPFT 055
 TEST  LDQ     COMP1                                                    MPFT 056
       CLA     =2                                                       MPFT 057
       TLQ     ZOR1                                                     MPFT 058
DECOMP AXT     0,1                 NF=0                                 MPFT 059
       AXT     1,2                 PTABLE INDEX                         MPFT 060
 PTAB  CLA     PTABLE+1,2                                               MPFT 061
       STO     PRIME                                                    MPFT 062
 DECO  AXT     1,3                 MULT =1                              MPFT 063
       LDQ     BOUND                                                    MPFT 064
       TLQ     UNFIN               TEST FOR BOUND EXCEEDED              MPFT 065
       PXD     0,0                                                      MPFT 066
 NC    AXT     *-*,5                                                    MPFT 067
       TXH     GP,5,0              TEST FOR MULTIPLE PRECISION          MPFT 068
 SP    LDQ     COMP1               SINGLE PRECISION                     MPFT 069
       DVH     PRIME                                                    MPFT 070
       TNZ     ADVP                                                     MPFT 071
 RED1  STQ     COMP1               SAVE REDUCED PRIME                   MPFT 072
       DVH     PRIME                                                    MPFT 073
       TNZ     FND                                                      MPFT 074
       TXI     RED1,3,1                                                 MPFT 075
*              MULTIPLE PRECISION DIVIDEND                              MPFT 076
 GP    LDQ     COMP1,5                                                  MPFT 077
       DVH     PRIME               DIVIDE NC-1 HIGH ORDER               MPFT 078
       STQ     QUOT,5              WORDS                                MPFT 079
       TIX     GP,5,1                                                   MPFT 080
       LDQ     COMP1               FINISH OFF WITH LOW                  MPFT 081
       DVH     PRIME               ORDER WORD                           MPFT 082
       TNZ     ADVP                                                     MPFT 083
 REDGP LXA     NC,5                                                     MPFT 084
       STQ     COMP1                                                    MPFT 085
 RED   LDQ     QUOT,5                                                   MPFT 086
       STQ     COMP1,5                                                  MPFT 087
       DVH     PRIME                                                    MPFT 088
       STQ     QUOT,5                                                   MPFT 089
       TIX     RED,5,1                                                  MPFT 090
       LDQ     COMP1                                                    MPFT 091
       DVH     PRIME                                                    MPFT 092
       TNZ     FND                                                      MPFT 093
       TXI     REDGP,3,1                                                MPFT 094
 FND   PXX     0,3                PXD FOR FORTRAN 2, PXA FOR FORTRAN 4  MPFT 095
 MULT  STO     (MULT),1                                                 MPFT 096
       CLA     PRIME                                                    MPFT 097
 FACT  STO     (FACT),1                                                 MPFT 098
       TXI     *+1,1,1             NF=NF+1                              MPFT 099
       CLA     COMP1               TEST FOR COMPLETE                    MPFT 100
       SUB     =1                  REDUCTION                            MPFT 101
       TNZ     ADVP                                                     MPFT 102
       LXA     NC,5                                                     MPFT 103
       TXL     FIN,5,0                                                  MPFT 104
       ZET     COMP1,5                                                  MPFT 105
 ADVP  TXI     NP,2,1              ADVANCE P TABLE INDEX                MPFT 106
       TIX     *-2,5,1                                                  MPFT 107
       TRA     FIN                                                      MPFT 108
 NP    TXL     PTAB,2,*-*                                               MPFT 109
*              PTABLE EXHAUSTED - GET NEXT PRIME                        MPFT 110
       TSX     $NEXTP,4                                                 MPFT 111
       TSX     PRIME,0                                                  MPFT 112
       TSX     PRIME,0                                                  MPFT 113
       TSX     =1B17,0                                                  MPFT 114
       TZE     UNFIN                                                    MPFT 115
       TXI     DECO,2,-1                                                MPFT 116
 FIN   AXT     0,3                 HAPPY ENDING. IND=0                  MPFT 117
       TRA     X4                                                       MPFT 118
 UNFIN AXT     2,3                 INCOMPLETE.  IND=2                   MPFT 119
       TRA     X4                                                       MPFT 120
 ZOR1  AXT     1,3                 COMP=0 OR 1.  IND=1                  MPFT 121
       AXT     1,1                 SET NF =1                            MPFT 122
 X4    AXT     *-*,4                                                    MPFT 123
       PXD     0,1                                                      MPFT 124
       STO*    8,4                                                      MPFT 125
       CLA     COMP1                                                    MPFT 126
       LDQ     SIGN                APPLY SIGN OF COMP 1                 MPFT 127
       LLS     0                   TO RESIDUE                           MPFT 128
       STO*    9,4                                                      MPFT 129
       LXA     NC,5                                                     MPFT 130
       TXL     COMNR,5,0                                                MPFT 131
       CLA     COMP1,5                                                  MPFT 132
       TNZ     GETNR                                                    MPFT 133
       TIX     *-2,5,1                                                  MPFT 134
       TRA     RETNR                                                    MPFT 135
 GETNR SXA     NR,5                                                     MPFT 136
       CAL     9,4                 PICK UP HIGHER ORDER                 MPFT 137
       STA     RES                 RESIDUE                              MPFT 138
 GETRE CLA     COMP1,5                                                  MPFT 139
       LLS     0                                                        MPFT 140
 RES   STO     *-*,5                                                    MPFT 141
       TIX     GETRE,5,1                                                MPFT 142
 NR    AXT     *-*,5                                                    MPFT 143
 COMNR TXI     *+1,5,1                                                  MPFT 144
 RETNR PXD     0,5                                                      MPFT 145
       STO*    10,4                                                     MPFT 146
       PXD     0,3           RETURN IND                                 MPFT 147
 X5    AXT     *-*,5               0 ON NORMAL RETURN                   MPFT 148
 X3    AXT     *-*,3               1 IF INCOMPLETE DECOMP.              MPFT 149
 X2    AXT     *-*,2               2 IF COMP=0 OR 1                     MPFT 150
 X1    AXT     *-*,1                                                    MPFT 151
       TRA     11,4                                                     MPFT 152
       BSS     MAXNC-1                                                  MPFT 153
 COMP1 BSS     1                                                        MPFT 154
       BSS     MAXNC-1                                                  MPFT 155
 QUOT  BSS     1                                                        MPFT 156
 SIGN  BSS     1                                                        MPFT 157
 BOUND BSS     1                                                        MPFT 158
 PRIME BSS     1                                                        MPFT 159
PTABLE EQU     0                                                        MPFT 160
(FACT) EQU     0                                                        MPFT 161
(MULT) EQU     0                                                        MPFT 162
       END                                                              MPFT 163
