$JOB                                                                            
$EXECUTE       IBJOB                                                            
$IBJOB         LOGIC,MAP,FILES                                                  
$IBCBC P555    M94,XR7                                                          
       IDENTIFICATION DIVISION.                                                 
       AUTHOR.      H.W. PARSH.                                                 
       REMARKS.     COBOL SORT TEST.                                            
       ENVIRONMENT DIVISION.                                                    
       CONFIGURATION SECTION.                                                   
       SOURCE-COMPUTER.        IBM-7094.                                        
       OBJECT-COMPUTER.        IBM-7094.                                        
       INPUT-OUTPUT SECTION.                                                    
       FILE-CONTROL. SELECT INPUT-FILE   ASSIGN TO SYSIN1.                      
                     SELECT OUTPUT-FILE  ASSIGN TO SYSOU1.                      
                     SELECT MERGE-FILE-1 ASSIGN TO A(1).                       1
                     SELECT MERGE-FILE-1-IN ASSIGN TO A(1).                    1
                     SELECT MERGE-FILE-2 ASSIGN TO SYSUT3.                     1
                     SELECT MERGE-FILE-2-IN ASSIGN TO SYSUT3.                  1
                     SELECT MERGE-FILE-3 ASSIGN TO SYSUT2.                     1
                     SELECT MERGE-FILE-3-IN ASSIGN TO SYSUT2.                  1
                     SELECT MERGE-FILE-4 ASSIGN TO SYSUT4.                     1
                     SELECT MERGE-FILE-4-IN ASSIGN TO SYSUT4.                  1
       DATA DIVISION.                                                           
       FILE SECTION.                                                            
       FD  INPUT-FILE                                                           
           LABEL RECORDS ARE OMITTED                                            
           DATA RECORDS ARE SUBNET-RECORD-FROM-INPUT,                           
           ACTIVITY-RECORD-FROM-INPUT, EVENT-RECORD-FROM-INPUT                  
           BRIDGE-RECORD-FROM-INPUT AND INPUT-RECORD.                           
       01  SUBNET-RECORD-FROM-INPUT.                                            
           02 COLUMN-1-CODE                            PICTURE       X.         
           02 SUBNET-NUMBER                            PICTURE     X(5).        
           02 WORD-SUBNET                              PICTURE     X(6).        
           02 REST-OF-THE-CARD                         PICTURE    X(68).        
           02 FILLER                                   PICTURE     X(4).        
       01  ACTIVITY-RECORD-FROM-INPUT.                                          
           02 COLUMN-1-CODE                            PICTURE       X.         
           02 SUBNET-NUMBER                            PICTURE     X(5).        
           02 PREDECESSOR-EVENT-NUMBER                 PICTURE     X(5).        
           02 SUCCESSOR-EVENT-NUMBER                   PICTURE     X(5).        
           02 REST-OF-THE-CARD                         PICTURE    X(64).        
           02 FILLER                                   PICTURE     X(4).        
       01  EVENT-RECORD-FROM-INPUT.                                             
           02 COLUMN-1-CODE                            PICTURE       X.         
           02 SUBNET-NUMBER                            PICTURE     X(5).        
           02 EVENT-NUMBER                             PICTURE     X(5).        
           02 LEVEL-CODE                               PICTURE       X.         
           02 COMPUTE-DATE.                                                     
               03 DAY                                  PICTURE     X(2).        
               03 MONTH                                PICTURE     X(3).        
               03 YEAR                                 PICTURE     X(2).        
           02 REST-OF-THE-CARD                         PICTURE    X(61).        
           02 FILLER                                   PICTURE     X(4).        
       01  BRIDGE-RECORD-FROM-INPUT.                                            
           02 COLUMN-1-CODE                            PICTURE       X.         
           02 PREDECESSOR-SUBNET                       PICTURE     X(5).        
           02 PREDECESSOR-EVENT                        PICTURE     X(5).        
           02 WORD-BRIDGE                              PICTURE     X(6).        
           02 SUCCESSOR-SUBNET                         PICTURE     X(5).        
           02 SUCCESSOR-EVENT                          PICTURE     X(5).        
           02 REST-OF-THE-CARD                         PICTURE    X(53).        
           02 FILLER                                   PICTURE     X(4).        
       01  INPUT-RECORD                                PICTURE    X(84).        
       FD  OUTPUT-FILE                                                          
           LABEL RECORDS ARE OMITTED                                            
           DATA RECORD IS PRINT-LINE.                                           
       01  PRINT-LINE.                                                          
           02 PROGRAM-CONTROL                          PICTURE       X.         
           02 BODY-OF-THE-PRINT-LINE                   PICTURE   X(130).        
           02 RECORD-MARK                              PICTURE       X.         
       FD  MERGE-FILE-1                                                        2
           LABEL RECORDS ARE OMITTED                                           2
           BLOCK CONTAINS 10  RECORDS                                          2
           DATA RECORD IS MERGE-RECORD-1.                                      2
       01  MERGE-RECORD-1                              PICTURE    X(84).       2
       FD  MERGE-FILE-1-IN                                                     2
           LABEL RECORDS ARE OMITTED                                           2
           BLOCK CONTAINS 10  RECORDS                                          2
           DATA RECORD IS MERGE-RECORD-1-IN.                                   2
       01  MERGE-RECORD-1-IN                           PICTURE    X(84).       2
       FD  MERGE-FILE-2                                                        2
           LABEL RECORDS ARE OMITTED                                           2
           BLOCK CONTAINS 10  RECORDS                                          2
           DATA RECORD IS MERGE-RECORD-2.                                      2
       01  MERGE-RECORD-2                              PICTURE    X(84).       2
       FD  MERGE-FILE-2-IN                                                     2
           LABEL RECORDS ARE OMITTED                                           2
           BLOCK CONTAINS 10  RECORDS                                          2
           DATA RECORD IS MERGE-RECORD-2-IN.                                   2
       01  MERGE-RECORD-2-IN                           PICTURE    X(84).       2
       FD  MERGE-FILE-3                                                        2
           LABEL RECORDS ARE OMITTED                                           2
           BLOCK CONTAINS 10  RECORDS                                          2
           DATA RECORD IS MERGE-RECORD-3.                                      2
       01  MERGE-RECORD-3                              PICTURE    X(84).       2
       FD  MERGE-FILE-3-IN                                                     2
           LABEL RECORDS ARE OMITTED                                           2
           BLOCK CONTAINS 10  RECORDS                                          2
           DATA RECORD IS MERGE-RECORD-3-IN.                                   2
       01  MERGE-RECORD-3-IN                           PICTURE    X(84).       2
       FD  MERGE-FILE-4                                                        2
           LABEL RECORDS ARE OMITTED                                           2
           BLOCK CONTAINS 10  RECORDS                                          2
           DATA RECORD IS MERGE-RECORD-4.                                      2
       01  MERGE-RECORD-4                              PICTURE    X(84).       2
       FD  MERGE-FILE-4-IN                                                     2
           LABEL RECORDS ARE OMITTED                                           2
           BLOCK CONTAINS 10  RECORDS                                          2
           DATA RECORD IS MERGE-RECORD-4-IN.                                   2
       01  MERGE-RECORD-4-IN                           PICTURE    X(84).       2
       WORKING-STORAGE SECTION.                                                 
       77  END-OF-RECORD-CHARACTER                     PICTURE    J.            
       77  MAXIMUM-INTERNAL-CAPACITY                   PICTURE     9(4)        3
               VALUE 0300 COMPUTATIONAL SYNCHRONIZED RIGHT.                    3
       77  RESULTANT-SUBSCRIPT                         PICTURE     9(4)        3
               COMPUTATIONAL SYNCHRONIZED RIGHT.                               3
       77  MERGE-FILE-1-FLAG                           PICTURE     X(6).       3
       77  END-OF-SUPPLY-FLAG                          PICTURE     X(3).       3
       77  TERMINAL-FLAG                               PICTURE     X(3).       3
       77  RECORD-I-FLAG                               PICTURE     X(3).       3
       77  NUMBER-OF-STRINGS-MERGE-FILE-1              PICTURE     9(4)        3
                   COMPUTATIONAL SYNCHRONIZED RIGHT.                           3
       77  NUMBER-OF-STRINGS-MERGE-FILE-2              PICTURE     9(4)        3
                   COMPUTATIONAL SYNCHRONIZED RIGHT.                           3
       77  NUMBER-OF-STRINGS-MERGE-FILE-3              PICTURE     9(4)        3
                   COMPUTATIONAL SYNCHRONIZED RIGHT.                           3
       77  NUMBER-OF-STRINGS-MERGE-FILE-4              PICTURE     9(4)        3
                   COMPUTATIONAL SYNCHRONIZED RIGHT.                           3
       77  TOTAL-NUMBER-OF-RECORDS                     PICTURE     9(4)        3
                   COMPUTATIONAL SYNCHRONIZED RIGHT.                           3
       77  TOTAL-NUMBER-UNMERGED-RECORDS               PICTURE     9(4)        3
                   COMPUTATIONAL SYNCHRONIZED RIGHT.                           3
       77  STRING-LENGTH                               PICTURE     9(4)        3
                   COMPUTATIONAL SYNCHRONIZED RIGHT.                           3
       77  I                                           PICTURE     9(4)        3
                   COMPUTATIONAL SYNCHRONIZED RIGHT.                           3
       77  PRESENT-SUBSCRIPT-I                         PICTURE     9(4)        3
                   COMPUTATIONAL SYNCHRONIZED RIGHT.                           3
       77  UNMERGED-STRING-I                           PICTURE     9(4)        3
                   COMPUTATIONAL SYNCHRONIZED RIGHT.                           3
       77  J                                           PICTURE     9(4)        3
                   COMPUTATIONAL SYNCHRONIZED RIGHT.                           3
       77  PRESENT-SUBSCRIPT-J                         PICTURE     9(4)        3
                   COMPUTATIONAL SYNCHRONIZED RIGHT.                           3
       77  UNMERGED-STRING-J                           PICTURE     9(4)        3
                   COMPUTATIONAL SYNCHRONIZED RIGHT.                           3
       01  ANCHOR-RECORD                               PICTURE    X(84)        3
               VALUE HIGH-VALUES.                                              3
       01  RECORD-J                                    PICTURE    X(84).       3
       01  DUMMY-NAME-1.                                                       3
           02 RECORD-BIN                               PICTURE    X(84)        3
               OCCURS 300  TIMES.                                              3
       01  DUMMY-NAME-2.                                                       3
           02 PRESENT-RECORD-LOCATION                  PICTURE     9(4)        3
               OCCURS 300  TIMES.                                              3
       01  DUMMY-NAME-3.                                                       3
           02 RESULTANT-RECORD-LOCATION                PICTURE     9(4)        3
               OCCURS 300  TIMES.                                              3
       01  RECORD-I                                    PICTURE    X(84).       3
       01  SUBNET-RECORD-TO-BE-SORTED REDEFINES RECORD-I.                       
           02 SUBNET-NUMBER                            PICTURE     X(5).        
           02 SORTING-PARAMETER-SUBNET                 PICTURE       X.         
           02 COLUMN-1-CODE                            PICTURE       X.         
           02 REST-OF-THE-CARD                         PICTURE    X(68).        
           02 FILLER-SUBNET                            PICTURE     X(9).        
       01  ACTIVITY-RECORD-TO-BE-SORTED REDEFINES RECORD-I.                     
           02 SUBNET-NUMBER                            PICTURE     X(5).        
           02 SORTING-PARAMETER-ACTIVITY               PICTURE       X.         
           02 SUCCESSOR-EVENT-NUMBER                   PICTURE     X(5).        
           02 PREDECESSOR-EVENT-NUMBER                 PICTURE     X(5).        
           02 COLUMN-1-CODE                            PICTURE       X.         
           02 REST-OF-THE-CARD                         PICTURE    X(64).        
           02 FILLER-ACTIVITY                          PICTURE     X(3).        
       01  EVENT-RECORD-TO-BE-SORTED REDEFINES RECORD-I.                        
           02 SUBNET-NUMBER                            PICTURE     X(5).        
           02 SORTING-PARAMETER-EVENT                  PICTURE       X.         
           02 EVENT-NUMBER                             PICTURE     X(5).        
           02 COLUMN-1-CODE                            PICTURE       X.         
           02 LEVEL-CODE                               PICTURE       X.         
           02 COMPUTE-DATE.                                                     
               03 DAY                                  PICTURE     X(2).        
               03 MONTH                                PICTURE     X(3).        
               03 YEAR                                 PICTURE     X(2).        
           02 REST-OF-THE-CARD                         PICTURE    X(61).        
           02 FILLER-EVENT                             PICTURE     X(3).        
       01  BRIDGE-RECORD-TO-BE-SORTED REDEFINES RECORD-I.                       
           02  DUMMY-SORT-FIELD                        PICTURE     X(5).        
           02 SORTING-PARAMETER-BRIDGE                 PICTURE       X.         
           02 PREDECESSOR-SUBNET                       PICTURE     X(5).        
           02 SUCCESSOR-SUBNET                         PICTURE     X(5).        
           02 PREDECESSOR-EVENT                        PICTURE     X(5).        
           02 SUCCESSOR-EVENT                          PICTURE     X(5).        
           02 COLUMN-1-CODE                            PICTURE       X.         
           02 REST-OF-THE-CARD                         PICTURE    X(53).        
           02 FILLER-BRIDGE                            PICTURE     X(4).        
       PROCEDURE DIVISION.                                                      
           OPEN INPUT INPUT-FILE.                                               
           PERFORM GENERAL-SORT-ROUTINE THRU                                    
           END-OF-GENERAL-SORT-ROUTINE.                                         
           CLOSE INPUT-FILE.                                                    
           OPEN INPUT MERGE-FILE-1-IN OUTPUT OUTPUT-FILE.                       
           MOVE ' ' TO PROGRAM-CONTROL.                                         
           MOVE END-OF-RECORD-CHARACTER TO RECORD-MARK.                         
       PRINT-SORTED-RESULT.                                                     
           READ MERGE-FILE-1-IN INTO BODY-OF-THE-PRINT-LINE AT END CLOSE        
           MERGE-FILE-1-IN, OUTPUT-FILE, AND STOP RUN.                          
           WRITE PRINT-LINE.                                                    
           GO TO PRINT-SORTED-RESULT.                                           
       USERS-RECORD-PROVIDE-ROUTINE.                                            
           READ INPUT-FILE   AT END MOVE 'SET' TO END-OF-SUPPLY-FLAG AND        
           GO TO END-OF-RECORD-PROVIDE-ROUTINE.                                 
           IF WORD-SUBNET IS EQUAL TO 'SUBNET' MOVE CORRESPONDING               
           SUBNET-RECORD-FROM-INPUT TO SUBNET-RECORD-TO-BE-SORTED AND           
           MOVE '0' TO SORTING-PARAMETER-SUBNET AND                             
           MOVE SPACES TO FILLER-SUBNET AND                                     
           GO TO END-OF-RECORD-PROVIDE-ROUTINE.                                 
           IF WORD-BRIDGE IS EQUAL TO 'BRIDGE' MOVE CORRESPONDING               
           BRIDGE-RECORD-FROM-INPUT TO BRIDGE-RECORD-TO-BE-SORTED AND           
           MOVE '3' TO SORTING-PARAMETER-BRIDGE AND                             
           MOVE HIGH-VALUES TO DUMMY-SORT-FIELD AND                             
           MOVE SPACES TO FILLER-BRIDGE AND                                     
           GO TO END-OF-RECORD-PROVIDE-ROUTINE.                                 
           IF COMPUTE-DATE IN EVENT-RECORD-FROM-INPUT                           
           IS EQUAL TO SPACES GO TO                                             
           MOVE-EVENT-RECORD-FOR-SORT.                                          
           IF MONTH IN EVENT-RECORD-FROM-INPUT IS EQUAL TO                      
           'JAN' OR 'FEB' OR 'MAR' OR 'APR' OR                                  
           'MAY' OR 'JUN' OR 'JUL' OR 'AUG' OR 'SEP' OR 'OCT' OR 'NOV'          
           OR 'DEC' GO TO MOVE-EVENT-RECORD-FOR-SORT.                           
           MOVE CORRESPONDING ACTIVITY-RECORD-FROM-INPUT TO                     
           ACTIVITY-RECORD-TO-BE-SORTED.                                        
           MOVE '1' TO SORTING-PARAMETER-ACTIVITY.                              
           MOVE SPACES TO FILLER-ACTIVITY.                                      
           GO TO END-OF-RECORD-PROVIDE-ROUTINE.                                 
       MOVE-EVENT-RECORD-FOR-SORT.                                              
           MOVE CORRESPONDING EVENT-RECORD-FROM-INPUT TO                        
           EVENT-RECORD-TO-BE-SORTED.                                           
           MOVE '2' TO SORTING-PARAMETER-EVENT.                                 
           MOVE SPACES TO FILLER-EVENT.                                         
       END-OF-RECORD-PROVIDE-ROUTINE. EXIT.                                     
       USERS-COMPARE-ROUTINE.                                                   
           IF RECORD-I IS LESS THAN RECORD-J MOVE 'LOW' TO                      
           RECORD-I-FLAG.                                                       
       END-OF-COMPARE-ROUTINE.                                                  
       GENERAL-SORT-PROGRAM-NOTES.                                             4
           NOTE. IN USING THIS GENERAL SORT, IGNORE THE NOTES FOR              4
           THE INTERNAL-SORT-ROUTINE.                                          4
           EXECUTION IS CAUSED BY THE SENTENCE                                 4
           ****                                                                4
           PERFORM GENERAL-SORT-ROUTINE THRU                                   4
           END-OF-GENERAL-SORT-ROUTINE.                                        4
           ****                                                                4
           THE USER MUST PROVIDE TWO ROUTINES. ONE WILL BE EXECUTED BY         4
           THE SENTENCE                                                        4
           ****                                                                4
           PERFORM USERS-COMPARE-ROUTINE THRU END-OF-COMPARE-ROUTINE.          4
           ****                                                                4
           WHICH COMPARES TWO SUBJECT RECORDS,  RECORD-I AND RECORD-J,         4
           AND SETS A RECORD-I-FLAG TO 'LOW' IF THE USER DESIRES RECORD-I      4
           TO BE SORTED BEFORE  RECORD-J.  THE SORT ROUTINE PRESETS            4
           RECORD-I-FLAG TO 'NOT' BEFORE ENTERING USERS-COMPARE-ROUTINE.       4
           THE USER MUST ADD HIS OWN RECORD-I AND RECORD-J SUBFIELD            4
           DEFINITIONS TO DESCRIBE HIS CONTROL FIELDS.                         4
           THE OTHER ROUTINE TO BE SUPPLIED IS EXECUTED BY THE SENTENCE        4
           ****                                                                4
           PERFORM USERS-RECORD-PROVIDE-ROUTINE THRU                           4
           END-OF-RECORD-PROVIDE-ROUTINE.                                      4
           ****                                                                4
           WHICH SUPPLIES A RECORD TO BE SORTED AND PLACES IT INTO             4
           RECORD-I. IF THE RECORD SUPPLY BECOMES EXHAUSTED THE                4
           USER MUST                                                           4
           ****                                                                4
           MOVE 'SET' TO END-OF-SUPPLY-FLAG.                                   4
           ****                                                                4
           THE SORTED RESULT WILL BE WRITTEN ONTO MERGE-FILE-1                 4
           AS ONE FILE.                                                        4
           THE EXAMPLE STRUCTURE ILLUSTRATES A RECORD LENGTH OF 84             4
           CHARACTERS AND AN INTERNAL SORTING                                  4
           CAPACITY OF 300 RECORDS. TO CHANGE                                  4
           THE RECORD LENGTH, RECORD-I, RECORD-J, RECORD-BIN, THE FOUR         4
           MERGE RECORDS AND THE ANCHOR RECORD MUST BE APPROPRIATELY           4
           CHANGED. DEPENDING UPON THE AMOUNT OF STORAGE AVAILABLE IT          4
           MAY BE DESIRABLE TO CHANGE THE INTERNAL SORTING CAPACITY.           4
           TO DO THIS THE VALUE OF 3 OCCURS CLAUSES MUST BE                    4
           APPROPRIATELY AND IDENTICALLY CHANGED WITH THE VALUE OF             4
           MAXIMUM-INTERNAL-CAPACITY.                                          4
           ABSOLUTE INTERNAL MAXIMUM CAPACITY IS  9999 RECORDS.                4
           NO RECORDS ARE ALLOWED WHOSE CONTROL FIELDS ARE ENTIRELY            4
           EQUAL TO HIGH-VALUES.                                               4
           CARE MUST ALSO BE EXERCISED NOT TO DUPLICATE ANY DATA NAMES         4
           OR PARAGRAPH NAMES USED BY THE GENERAL-SORT-ROUTINE.                4
       GENERAL-SORT-ROUTINE.                                                   4
           MOVE ZEROES TO NUMBER-OF-STRINGS-MERGE-FILE-1 AND                   4
           NUMBER-OF-STRINGS-MERGE-FILE-2.                                     4
           OPEN OUTPUT MERGE-FILE-1, AND MERGE-FILE-2.                         4
           MOVE 'ACTIVE' TO MERGE-FILE-1-FLAG.                                 4
           MOVE 'NOT' TO END-OF-SUPPLY-FLAG.                                   4
       SHOW-BIN-EMPTY.                                                         4
           MOVE ZEROES TO TOTAL-NUMBER-OF-RECORDS AND I.                       4
       FILL-THE-BIN.                                                           4
           PERFORM USERS-RECORD-PROVIDE-ROUTINE THRU                           4
           END-OF-RECORD-PROVIDE-ROUTINE.                                      4
           IF END-OF-SUPPLY-FLAG IS EQUAL TO 'SET'                             4
           GO TO DO-INTERNAL-SORT.                                             4
           ADD  1  TO I.                                                       4
           MOVE RECORD-I TO RECORD-BIN (I).                                    4
           ADD  1  TO TOTAL-NUMBER-OF-RECORDS.                                 4
           IF TOTAL-NUMBER-OF-RECORDS IS LESS THAN                             4
           MAXIMUM-INTERNAL-CAPACITY GO TO FILL-THE-BIN.                       4
       DO-INTERNAL-SORT.                                                       4
           PERFORM INTERNAL-SORT-ROUTINE THRU                                  4
           END-OF-INTERNAL-SORT-ROUTINE.                                       4
           MOVE  1  TO PRESENT-SUBSCRIPT-I.                                    4
           IF MERGE-FILE-1-FLAG IS EQUAL TO 'ACTIVE' GO TO                     4
           WRITE-SORTED-RECORDS-1.                                             4
       WRITE-SORTED-RECORDS-2.                                                 4
           IF TOTAL-NUMBER-OF-RECORDS IS EQUAL TO ZEROES                       4
           GO TO FINISH-OF-WRITE-2.                                            4
           MOVE PRESENT-RECORD-LOCATION (PRESENT-SUBSCRIPT-I) TO I.            4
           WRITE MERGE-RECORD-2 FROM RECORD-BIN (I).                           4
           IF PRESENT-SUBSCRIPT-I IS LESS THAN TOTAL-NUMBER-OF-RECORDS         4
           ADD  1  TO PRESENT-SUBSCRIPT-I AND GO TO                            4
           WRITE-SORTED-RECORDS-2.                                             4
       FINISH-OF-WRITE-2.                                                      4
           WRITE MERGE-RECORD-2 FROM ANCHOR-RECORD.                            4
           ADD  1  TO NUMBER-OF-STRINGS-MERGE-FILE-2.                          4
           MOVE 'ACTIVE' TO MERGE-FILE-1-FLAG.                                 4
       TEST-FOR-END-OF-SORT-RECORDS.                                           4
           IF END-OF-SUPPLY-FLAG IS NOT EQUAL TO 'SET'                         4
           GO TO TEST-FOR-1-CLOSE-OFF.                                         4
       PREPARE-FOR-FLIP-FLOP.                                                  4
           MOVE ZEROES TO NUMBER-OF-STRINGS-MERGE-FILE-3.                      4
       TEST-IF-COMPLETED-MERGE-ON-1.                                           4
           IF NUMBER-OF-STRINGS-MERGE-FILE-2 IS EQUAL TO ZEROES CLOSE          4
           MERGE-FILE-1, MERGE-FILE-2 AND GO TO                                4
           END-OF-GENERAL-SORT-ROUTINE.                                        4
           WRITE MERGE-RECORD-1 FROM ANCHOR-RECORD.                            4
           WRITE MERGE-RECORD-2 FROM ANCHOR-RECORD.                            4
       MERGE-1-AND-2-ONTO-3-AND-4.                                             4
           MOVE ZEROES TO NUMBER-OF-STRINGS-MERGE-FILE-4.                      4
           CLOSE MERGE-FILE-1 AND MERGE-FILE-2.                                4
           OPEN INPUT MERGE-FILE-1-IN AND MERGE-FILE-2-IN, OUTPUT              4
           MERGE-FILE-3 AND MERGE-FILE-4.                                      4
       MERGE-1-AND-2-ONTO-3.                                                   4
           READ MERGE-FILE-1-IN INTO RECORD-I AT END NEXT SENTENCE.            4
           READ MERGE-FILE-2-IN INTO RECORD-J AT END NEXT SENTENCE.            4
       COMPARE-1-AND-2-ONTO-3.                                                 4
           MOVE 'NOT' TO RECORD-I-FLAG.                                        4
           PERFORM USERS-COMPARE-ROUTINE THRU END-OF-COMPARE-ROUTINE.          4
           IF RECORD-I-FLAG IS NOT EQUAL TO 'LOW' GO TO WRITE-3-FROM-2.        4
           WRITE MERGE-RECORD-3 FROM RECORD-I.                                 4
           IF RECORD-I IS EQUAL TO ANCHOR-RECORD GO TO                         4
           INCREASE-STRING-3-COUNT.                                            4
           READ MERGE-FILE-1-IN INTO RECORD-I AT END NEXT SENTENCE.            4
           GO TO COMPARE-1-AND-2-ONTO-3.                                       4
       INCREASE-STRING-3-COUNT.                                                4
           ADD  1  TO NUMBER-OF-STRINGS-MERGE-FILE-3.                          4
           SUBTRACT  1  FROM NUMBER-OF-STRINGS-MERGE-FILE-1.                   4
           IF NUMBER-OF-STRINGS-MERGE-FILE-1 IS EQUAL TO ZEROES GO TO          4
           TEST-IF-COMPLETED-MERGE-ON-3.                                       4
           READ MERGE-FILE-1-IN INTO RECORD-I AT END NEXT SENTENCE.            4
           READ MERGE-FILE-2-IN INTO RECORD-J AT END NEXT SENTENCE.            4
       COMPARE-1-AND-2-ONTO-4.                                                 4
           MOVE 'NOT' TO RECORD-I-FLAG.                                        4
           PERFORM USERS-COMPARE-ROUTINE THRU END-OF-COMPARE-ROUTINE.          4
           IF RECORD-I-FLAG IS NOT EQUAL TO 'LOW' GO TO WRITE-4-FROM-2.        4
           WRITE MERGE-RECORD-4 FROM RECORD-I.                                 4
           IF RECORD-I IS EQUAL TO ANCHOR-RECORD GO TO                         4
           INCREASE-STRING-4-COUNT.                                            4
           READ MERGE-FILE-1-IN INTO RECORD-I AT END NEXT SENTENCE.            4
           GO TO COMPARE-1-AND-2-ONTO-4.                                       4
       INCREASE-STRING-4-COUNT.                                                4
           ADD  1  TO NUMBER-OF-STRINGS-MERGE-FILE-4.                          4
           SUBTRACT  1  FROM NUMBER-OF-STRINGS-MERGE-FILE-1.                   4
           IF NUMBER-OF-STRINGS-MERGE-FILE-1 IS NOT EQUAL TO ZEROES GO         4
           TO MERGE-1-AND-2-ONTO-3.                                            4
           CLOSE MERGE-FILE-1-IN AND MERGE-FILE-2-IN.                          4
       MERGE-3-AND-4-ONTO-1-AND-2.                                             4
           MOVE ZEROES TO NUMBER-OF-STRINGS-MERGE-FILE-2.                      4
           CLOSE MERGE-FILE-3 AND MERGE-FILE-4.                                4
           OPEN INPUT MERGE-FILE-3-IN AND MERGE-FILE-4-IN, OUTPUT              4
           MERGE-FILE-1 AND MERGE-FILE-2.                                      4
       MERGE-3-AND-4-ONTO-1.                                                   4
           READ MERGE-FILE-3-IN INTO RECORD-I AT END NEXT SENTENCE.            4
           READ MERGE-FILE-4-IN INTO RECORD-J AT END NEXT SENTENCE.            4
       COMPARE-3-AND-4-ONTO-1.                                                 4
           MOVE 'NOT' TO RECORD-I-FLAG.                                        4
           PERFORM USERS-COMPARE-ROUTINE THRU END-OF-COMPARE-ROUTINE.          4
           IF RECORD-I-FLAG IS NOT EQUAL TO 'LOW' GO TO WRITE-1-FROM-4.        4
           IF RECORD-I IS EQUAL TO ANCHOR-RECORD GO TO                         4
           INCREASE-STRING-1-COUNT.                                            4
           WRITE MERGE-RECORD-1 FROM RECORD-I.                                 4
           READ MERGE-FILE-3-IN INTO RECORD-I AT END NEXT SENTENCE.            4
           GO TO COMPARE-3-AND-4-ONTO-1.                                       4
       INCREASE-STRING-1-COUNT.                                                4
           ADD  1  TO NUMBER-OF-STRINGS-MERGE-FILE-1.                          4
           SUBTRACT  1  FROM NUMBER-OF-STRINGS-MERGE-FILE-3.                   4
           IF NUMBER-OF-STRINGS-MERGE-FILE-3 IS EQUAL TO ZEROES CLOSE          4
           MERGE-FILE-3-IN AND MERGE-FILE-4-IN AND GO TO                       4
           TEST-IF-COMPLETED-MERGE-ON-1.                                       4
           WRITE MERGE-RECORD-1 FROM ANCHOR-RECORD.                            4
           READ MERGE-FILE-3-IN INTO RECORD-I AT END NEXT SENTENCE.            4
           READ MERGE-FILE-4-IN INTO RECORD-J AT END NEXT SENTENCE.            4
       COMPARE-3-AND-4-ONTO-2.                                                 4
           MOVE 'NOT' TO RECORD-I-FLAG.                                        4
           PERFORM USERS-COMPARE-ROUTINE THRU END-OF-COMPARE-ROUTINE.          4
           IF RECORD-I-FLAG IS NOT EQUAL TO 'LOW' GO TO WRITE-2-FROM-4.        4
           WRITE MERGE-RECORD-2 FROM RECORD-I.                                 4
           IF RECORD-I IS EQUAL TO ANCHOR-RECORD GO TO                         4
           INCREASE-STRING-2-COUNT.                                            4
           READ MERGE-FILE-3-IN INTO RECORD-I AT END NEXT SENTENCE.            4
           GO TO COMPARE-3-AND-4-ONTO-2.                                       4
       INCREASE-STRING-2-COUNT.                                                4
           ADD  1  TO NUMBER-OF-STRINGS-MERGE-FILE-2.                          4
           SUBTRACT  1  FROM NUMBER-OF-STRINGS-MERGE-FILE-3.                   4
           IF NUMBER-OF-STRINGS-MERGE-FILE-3 IS NOT EQUAL TO ZEROES GO         4
           TO MERGE-3-AND-4-ONTO-1.                                            4
           CLOSE MERGE-FILE-3-IN AND MERGE-FILE-4-IN.                          4
           GO TO MERGE-1-AND-2-ONTO-3-AND-4.                                   4
       WRITE-3-FROM-2.                                                         4
           WRITE MERGE-RECORD-3 FROM RECORD-J.                                 4
           IF RECORD-J IS EQUAL TO ANCHOR-RECORD GO TO                         4
           INCREASE-STRING-3-COUNT.                                            4
           READ MERGE-FILE-2-IN INTO RECORD-J AT END NEXT SENTENCE.            4
           GO TO COMPARE-1-AND-2-ONTO-3.                                       4
       WRITE-4-FROM-2.                                                         4
           WRITE MERGE-RECORD-4 FROM RECORD-J.                                 4
           IF RECORD-J IS EQUAL TO ANCHOR-RECORD GO TO                         4
           INCREASE-STRING-4-COUNT.                                            4
           READ MERGE-FILE-2-IN INTO RECORD-J AT END NEXT SENTENCE.            4
           GO TO COMPARE-1-AND-2-ONTO-4.                                       4
       WRITE-1-FROM-4.                                                         4
           IF RECORD-J IS EQUAL TO ANCHOR-RECORD GO TO                         4
           INCREASE-STRING-1-COUNT.                                            4
           WRITE MERGE-RECORD-1 FROM RECORD-J.                                 4
           READ MERGE-FILE-4-IN INTO RECORD-J AT END NEXT SENTENCE.            4
           GO TO COMPARE-3-AND-4-ONTO-1.                                       4
       WRITE-2-FROM-4.                                                         4
           WRITE MERGE-RECORD-2 FROM RECORD-J.                                 4
           IF RECORD-J IS EQUAL TO ANCHOR-RECORD GO TO                         4
           INCREASE-STRING-2-COUNT.                                            4
           READ MERGE-FILE-4-IN INTO RECORD-J AT END NEXT SENTENCE.            4
           GO TO COMPARE-3-AND-4-ONTO-2.                                       4
       WRITE-SORTED-RECORDS-1.                                                 4
           IF TOTAL-NUMBER-OF-RECORDS IS EQUAL TO ZEROES                       4
           GO TO FINISH-OF-WRITE-1.                                            4
           MOVE PRESENT-RECORD-LOCATION (PRESENT-SUBSCRIPT-I) TO I.            4
           WRITE MERGE-RECORD-1 FROM RECORD-BIN (I).                           4
           IF PRESENT-SUBSCRIPT-I IS LESS THAN TOTAL-NUMBER-OF-RECORDS         4
           ADD  1  TO PRESENT-SUBSCRIPT-I AND GO TO                            4
           WRITE-SORTED-RECORDS-1.                                             4
       FINISH-OF-WRITE-1.                                                      4
           ADD  1  TO NUMBER-OF-STRINGS-MERGE-FILE-1.                          4
           MOVE 'NOT   ' TO MERGE-FILE-1-FLAG.                                 4
           GO TO TEST-FOR-END-OF-SORT-RECORDS.                                 4
       TEST-FOR-1-CLOSE-OFF.                                                   4
           IF MERGE-FILE-1-FLAG IS NOT EQUAL TO 'ACTIVE'                       4
           WRITE MERGE-RECORD-1 FROM ANCHOR-RECORD.                            4
           GO TO SHOW-BIN-EMPTY.                                               4
       TEST-IF-COMPLETED-MERGE-ON-3.                                           4
           CLOSE MERGE-FILE-1-IN AND MERGE-FILE-2-IN.                          4
           IF NUMBER-OF-STRINGS-MERGE-FILE-4 IS NOT EQUAL TO ZEROES            4
           WRITE MERGE-RECORD-4 FROM ANCHOR-RECORD AND GO TO                   4
           MERGE-3-AND-4-ONTO-1-AND-2.                                         4
           CLOSE MERGE-FILE-3 AND MERGE-FILE-4.                                4
           OPEN INPUT MERGE-FILE-3-IN OUTPUT MERGE-FILE-1.                     4
       COPY-FILE-3-ONTO-FILE-1.                                                4
           READ MERGE-FILE-3-IN INTO RECORD-I AT END NEXT SENTENCE.            4
           IF RECORD-I IS NOT EQUAL TO ANCHOR-RECORD WRITE                     4
           MERGE-RECORD-1                                                      4
           FROM RECORD-I AND GO TO COPY-FILE-3-ONTO-FILE-1.                    4
           CLOSE MERGE-FILE-1 AND MERGE-FILE-3-IN.                             4
       END-OF-GENERAL-SORT-ROUTINE. EXIT.                                      4
       INTERNAL-SORT-PROGRAM-NOTES.                                            4
           NOTE. INPUT REQUIRES TOTAL-NUMBER-OF-RECORDS TO BE PRESET           4
           AND THEY MUST BE INSERTED INTO THE RECORD-BIN.                      4
           EXECUTION IS CAUSED BY THE SENTENCE                                 4
           ****                                                                4
           PERFORM INTERNAL-SORT-ROUTINE THRU                                  4
           END-OF-INTERNAL-SORT-ROUTINE.                                       4
           ****                                                                4
           THE RECORDS THEMSELVES ARE NOT MOVED. THE SUBSCRIPTS OF THE         4
           SEQUENCED RESULT MAY BE FOUND IN A BLOCK IN                         4
           PRESENT-RECORD-LOCATION. FOR EXAMPLE, THE 10TH-RECORD OF THE        4
           SEQUENCED RESULT MAY BE OBTAINED BY                                 4
           ****                                                                4
           MOVE PRESENT-RECORD-LOCATION (10) TO I.                             4
           MOVE RECORD-BIN (I) TO 10TH-RECORD.                                 4
           ****                                                                4
           THE USER MUST ALSO PROVIDE A ROUTINE TO BE EXECUTED BY              4
           THE SENTENCE                                                        4
           ****                                                                4
           PERFORM USERS-COMPARE-ROUTINE THRU END-OF-COMPARE-ROUTINE.          4
           ****                                                                4
           WHICH COMPARES TWO SUBJECT RECORDS,  RECORD-I AND RECORD-J,         4
           AND SETS A RECORD-I-FLAG TO 'LOW' IF THE USER DESIRES RECORD-I      4
           TO BE SORTED BEFORE  RECORD-J.  THE SORT ROUTINE PRESETS            4
           RECORD-I-FLAG TO 'NOT' BEFORE ENTERING USERS-COMPARE-ROUTINE.       4
           THE USER MUST BE CAREFUL THAT THE VALUE OF                          4
           TOTAL-NUMBER-OF-RECORDS DOES NOT EXCEED THE VALUE OF THE            4
           OCCURS CLAUSES IN THE WORKING STORAGE SECTION.                      4
           THE USER MUST ADD HIS OWN RECORD-I AND RECORD-J SUBFIELD            4
           DEFINITIONS TO DESCRIBE HIS CONTROL FIELDS.                         4
           CARE MUST ALSO BE EXERCISED NOT TO DUPLICATE ANY DATA NAMES         4
           OR PARAGRAPH NAMES USED BY THE INTERNAL SORT.                       4
           THE EXAMPLE STRUCTURE ILLUSTRATES A RECORD LENGTH OF 84             4
           CHARACTERS AND A SORTING CAPACITY OF 300 RECORDS. TO CHANGE         4
           THE RECORD LENGTH, RECORD-I, RECORD-J, AND RECORD-BIN MUST          4
           BE APPROPRIATELY CHANGED.  TO CHANGE THE SORTING CAPACITY           4
           THE VALUE OF 3 OCCURS CLAUSES MUST BE APPROPRIATELY                 4
           AND IDENTICALLY CHANGED WITH THE VALUE OF                           4
           MAXIMUM-INTERNAL-CAPACITY.                                          4
           ABSOLUTE INTERNAL MAXIMUM CAPACITY IS  9999 RECORDS.                4
       INTERNAL-SORT-ROUTINE.                                                  4
           IF TOTAL-NUMBER-OF-RECORDS IS NOT GREATER THAN 1                    4
           MOVE 1 TO PRESENT-RECORD-LOCATION AND                               4
           GO TO END-OF-INTERNAL-SORT-ROUTINE.                                 4
           MOVE  1  TO STRING-LENGTH, I.                                       4
       INITIALIZE-PRESENT-LOCATIONS.                                           4
           MOVE I TO PRESENT-RECORD-LOCATION (I).                              4
           IF I IS LESS THAN TOTAL-NUMBER-OF-RECORDS   ADD  1  TO I AND        4
           GO TO INITIALIZE-PRESENT-LOCATIONS.                                 4
       INITIALIZE-MAJOR-MERGE-PASS.                                            4
           MOVE TOTAL-NUMBER-OF-RECORDS TO                                     4
           TOTAL-NUMBER-UNMERGED-RECORDS.                                      4
           MOVE 'SET' TO TERMINAL-FLAG.                                        4
           MOVE  1  TO PRESENT-SUBSCRIPT-J.                                    4
           MOVE ZERO TO RESULTANT-SUBSCRIPT.                                   4
       INITIALIZE-MINOR-MERGE-PASS.                                            4
           MOVE PRESENT-SUBSCRIPT-J TO PRESENT-SUBSCRIPT-I.                    4
           MOVE PRESENT-RECORD-LOCATION (PRESENT-SUBSCRIPT-I) TO I.            4
           MOVE TOTAL-NUMBER-UNMERGED-RECORDS TO UNMERGED-STRING-I.            4
           IF TOTAL-NUMBER-UNMERGED-RECORDS IS NOT GREATER THAN                4
           STRING-LENGTH GO TO DRAIN-I-STRING-ROUTINE.                         4
           MOVE STRING-LENGTH TO UNMERGED-STRING-I.                            4
           SUBTRACT STRING-LENGTH FROM TOTAL-NUMBER-UNMERGED-RECORDS.          4
           ADD STRING-LENGTH AND PRESENT-SUBSCRIPT-I GIVING                    4
           PRESENT-SUBSCRIPT-J.                                                4
           MOVE PRESENT-RECORD-LOCATION (PRESENT-SUBSCRIPT-J) TO J.            4
           MOVE TOTAL-NUMBER-UNMERGED-RECORDS TO UNMERGED-STRING-J.            4
           IF TOTAL-NUMBER-UNMERGED-RECORDS IS NOT GREATER THAN                4
           STRING-LENGTH GO TO PERFORM-USERS-COMPARE-ROUTINE.                  4
           MOVE STRING-LENGTH TO UNMERGED-STRING-J.                            4
           SUBTRACT STRING-LENGTH FROM TOTAL-NUMBER-UNMERGED-RECORDS.          4
       PERFORM-USERS-COMPARE-ROUTINE.                                          4
           MOVE 'NOT' TO RECORD-I-FLAG.                                        4
           MOVE RECORD-BIN (I) TO RECORD-I.                                    4
           MOVE RECORD-BIN (J) TO RECORD-J.                                    4
           PERFORM USERS-COMPARE-ROUTINE THRU END-OF-COMPARE-ROUTINE.          4
           IF RECORD-I-FLAG IS NOT EQUAL TO 'LOW' GO TO MERGE-J-ROUTINE.       4
       MERGE-I-ROUTINE.                                                        4
           ADD  1  TO RESULTANT-SUBSCRIPT.                                     4
           MOVE I TO RESULTANT-RECORD-LOCATION (RESULTANT-SUBSCRIPT).          4
           ADD  1  TO PRESENT-SUBSCRIPT-I.                                     4
           MOVE PRESENT-RECORD-LOCATION (PRESENT-SUBSCRIPT-I) TO I.            4
           SUBTRACT  1  FROM UNMERGED-STRING-I.                                4
       END-OF-MERGE-I-ROUTINE.                                                 4
           IF UNMERGED-STRING-I IS NOT EQUAL TO ZEROES GO TO                   4
           PERFORM-USERS-COMPARE-ROUTINE.                                      4
           PERFORM MERGE-J-ROUTINE UNTIL UNMERGED-STRING-J IS EQUAL TO         4
           ZEROES.                                                             4
       TEST-COMPLETION-MAJOR-MERGE.                                            4
           IF RESULTANT-SUBSCRIPT IS EQUAL TO TOTAL-NUMBER-OF-RECORDS          4
           GO TO MOVE-MERGED-SUBSCRIPTS.                                       4
           MOVE 'NOT' TO TERMINAL-FLAG.                                        4
           GO TO INITIALIZE-MINOR-MERGE-PASS.                                  4
       MERGE-J-ROUTINE.                                                        4
           ADD  1  TO RESULTANT-SUBSCRIPT.                                     4
           MOVE J TO RESULTANT-RECORD-LOCATION (RESULTANT-SUBSCRIPT).          4
           ADD  1  TO PRESENT-SUBSCRIPT-J.                                     4
           MOVE PRESENT-RECORD-LOCATION (PRESENT-SUBSCRIPT-J) TO J.            4
           SUBTRACT  1  FROM UNMERGED-STRING-J.                                4
       END-OF-MERGE-J-ROUTINE.                                                 4
           IF UNMERGED-STRING-J IS NOT EQUAL TO ZEROES GO TO                   4
           PERFORM-USERS-COMPARE-ROUTINE.                                      4
       DRAIN-I-STRING-ROUTINE.                                                 4
           PERFORM MERGE-I-ROUTINE UNTIL UNMERGED-STRING-I IS EQUAL TO         4
           ZEROES.                                                             4
           GO TO TEST-COMPLETION-MAJOR-MERGE.                                  4
       MOVE-MERGED-SUBSCRIPTS.                                                 4
           MOVE  1  TO I.                                                      4
       MOVE-RESULT-TO-PRESENT.                                                 4
           MOVE RESULTANT-RECORD-LOCATION (I) TO                               4
           PRESENT-RECORD-LOCATION (I).                                        4
           IF I IS LESS THAN TOTAL-NUMBER-OF-RECORDS ADD  1  TO I AND          4
           GO TO MOVE-RESULT-TO-PRESENT.                                       4
           IF TERMINAL-FLAG IS NOT EQUAL TO 'SET' ADD STRING-LENGTH TO         4
           STRING-LENGTH AND GO TO INITIALIZE-MAJOR-MERGE-PASS.                4
       END-OF-INTERNAL-SORT-ROUTINE. EXIT.                                     4
$CBEND                                                                          
