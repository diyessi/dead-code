      SUBROUTINE BESSEL(N,Z,NANS,NBSFN,BSFN)                                    
      DIMENSION NBSFN ( 1),F(200),X(200),P(200),BSFN(1)                         
      Y=Z/2.                                                                    
      IF (Y)11,271,11                                                           
 271  IF(N)273,272,273                                                          
 272  BSFN(1)=1.                                                                
      GO TO 274                                                                 
 273   BSFN(1)=0.                                                               
 274   IF(NANS-1)90,90,275                                                      
 275   DO 181 I=2,NANS                                                          
      J=NBSFN(I)                                                                
      IF(J)276,277,276                                                          
 276   BSFN(I)=0.                                                               
      GO TO 181                                                                 
 277  BSFN(I)=1.                                                                
 181   CONTINUE                                                                 
      GO TO 90                                                                  
 11   M=.75*ABSF(Z)+6.                                                          
      NABS=XABSF(N)                                                             
      NN=XMAX0F(NABS,2*M)                                                       
      DO 10 I=1,NN                                                              
 10   X(I)=Y/FLOATF(I)                                                          
      A0=0.                                                                     
      LL=NN                                                                     
      A1=Y*Y/FLOATF(LL*LL+LL)                                                   
      IF (A1-1.E-08)1,2,2                                                       
 1    F(NN)=A1                                                                  
      GO TO 30                                                                  
 2    B1=1.                                                                     
      LL=LL+1                                                                   
      C =Y*Y/FLOATF(LL*LL+LL)                                                   
      B2 = B1+C                                                                 
      FRAC=ABSF(C/B2)*A1                                                        
      IF(FRAC-1.E-08)1,3,3                                                      
 3    LL=LL+1                                                                   
 6    C=Y*Y/FLOATF(LL*LL+LL)                                                    
      A2=A1+C*A0                                                                
      AB=C*B1                                                                   
      B0=B1                                                                     
      B1=B2                                                                     
      B2=B1+C*B0                                                                
      FRAC=ABSF(AB/B2)*FRAC                                                     
      IF(FRAC-1.E-08)4,5,5                                                      
 4    F(NN)=A2/B1                                                               
      GO TO 30                                                                  
 5    LL=LL+1                                                                   
      A0=A1                                                                     
      A1=A2                                                                     
      GO TO 6                                                                   
 30   NNM=NN-1                                                                  
      DO 40 NTIMES =1,NNM                                                       
      KK=NN-NTIMES                                                              
 40   F(KK)=X(KK)*X(KK+1)/(1.-F(KK+1))                                          
      IF(NABS)34,34,35                                                          
 34   PZERO=1.                                                                  
      P(1)=PZERO*X(1)/(1.-F(1))                                                 
      NP=2                                                                      
      GO TO 59                                                                  
 35   P(NABS)=1.                                                                
      NM=NABS-1                                                                 
      DO 50 NTIMES=1, NM                                                        
      KK=NABS-NTIMES                                                            
 50   P(KK)=P(KK+1)*(1.-F(KK+1))/X(KK+1)                                        
      PZERO=P(1)*(1.-F(1))/X(1)                                                 
 51   NP=NABS+1                                                                 
 59   DO 60 KK=NP,NN                                                            
 60   P(KK)=P(KK-1)*X(KK)/(1.-F(KK))                                            
      SUM=0.                                                                    
      DO 70 I=2,NN,2                                                            
 70   SUM=P(I)+SUM                                                              
 71   BSFN(1)=1./(2.*SUM+PZERO)                                                 
 73   IF (NANS-1)90,90,75                                                       
 75   DO 81 I=2,NANS                                                            
      J=XABSF(NBSFN(I))                                                         
      IF(J) 80,76,80                                                            
 76   BSFN(I)=PZERO*BSFN(1)                                                     
      GO TO 81                                                                  
 80   BSFN(I)=P(J)*BSFN(1)                                                      
 81   CONTINUE                                                                  
      DO 100 I=1,NANS                                                           
      IF (NBSFN(I))101,100,100                                                  
 101  IF(XMODF(NBSFN(I),2))102,100,102                                          
 102  BSFN(I)=-BSFN(I)                                                          
 100  CONTINUE                                                                  
 90   RETURN                                                                    
        END                                                                     
