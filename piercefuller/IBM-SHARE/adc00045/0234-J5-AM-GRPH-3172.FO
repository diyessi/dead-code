       FOR                                                              GRPH0001
      SUBROUTINE GRAPH (X,Y,M,XLABEL,YLABEL,TITLE,CHAR)                 GRPH0002
C     AM GRPH - GENERALIZED LINEAR GRAPHING ROUTINE                     GRPH0003
      DIMENSION X(400),Y(400),TITLE(10),XHOLL(3),YHOLL(3),HOLL(12),FM(8)GRPH0004
      IF (FRST) 10,10,20                                                GRPH0005
   10 FRST = 1.                                                         GRPH0006
B     YHOLL(3) = 740010306060                                           GRPH0007
B     XHOLL(3) = 740010306060                                           GRPH0008
B     HOLL(12)  = 740602306060                                          GRPH0009
B     XHOLL(1) = 346060606060                                           GRPH0010
B     YHOLL(1) = 346060606060                                           GRPH0011
B     HOLL(1)  = 346060606060                                           GRPH0012
      CALL LGCHAR (8,6HAMGRPH)                                          GRPH0013
   20 DO 701 I = 1,10                                                   GRPH0014
      INDEX = 11-I                                                      GRPH0015
B 701 HOLL(I+1) = TITLE(INDEX)                                          GRPH0016
B     XHOLL(2) = XLABEL                                                 GRPH0017
B     YHOLL(2) = YLABEL                                                 GRPH0018
      CALL RNGE (X,M,AX,BX,NLX,NIX,1)                                   GRPH0019
      CALL TESTG(AX,BX,3)                                               GRPH0020
      CALL RNGE (Y,M,AY,BY,NLY,NIY,1)                                   GRPH0021
      CALL TESTG(AY,BY,4)                                               GRPH0022
      CALL FORMT (AX,BX,XFMT)                                           GRPH0023
      CALL FORMT (AY,BY,YFMT)                                           GRPH0024
      CALL FNPLOT (HOLL(12),XHOLL(03),YHOLL(03),AX,BX,AY,BY,NLX,NIX,NLY,GRPH0025
     1NIY,XFMT,YFMT)                                                    GRPH0026
    1 CALL CURVE (X(M),Y(M),M,CHAR)                                     GRPH0027
      RETURN                                                            GRPH0028
      END                                                               GRPH0029
       FOR                                                              GRPH0030
      SUBROUTINE FORMT (AX,BX,FMT)                                      GRPH0031
      RANGE = AX-BX                                                     GRPH0032
      XORD = MAX1F(ABSF(BX),ABSF(AX))                                   GRPH0033
      CALL ORDER (XORD,MXORDX)                                          GRPH0034
      CALL ORDER (RANGE,MORD)                                           GRPH0035
      IW = MXORDX - MORD + 5                                            GRPH0036
      ID = - MORD + 2                                                   GRPH0037
      IF (ID) 1,1,2                                                     GRPH0038
    1 IW = IW + 1 - ID                                                  GRPH0039
      ID = 1                                                            GRPH0040
    2 IF (ID - IW + 2) 4,4,3                                            GRPH0041
    3 IW = ID + 2                                                       GRPH0042
    4 IF (IW - 9) 8,8,5                                                 GRPH0043
    5 ID = ID - IW + 9                                                  GRPH0044
      IW = 9                                                            GRPH0045
      IF (ID) 6,6,8                                                     GRPH0046
    6 ID = 1                                                            GRPH0047
    8 IF (3-IW) 10,10,9                                                 GRPH0048
    9 IW = 3                                                            GRPH0049
   10 GO TO (3,3,30,40,50,60,70,80,90),IW                               GRPH0050
B  30 FMT = 742603330034                                                GRPH0051
      GO TO 95                                                          GRPH0052
B  40 FMT = 742604330034                                                GRPH0053
      GO TO 95                                                          GRPH0054
B  50 FMT = 742605330034                                                GRPH0055
      GO TO 95                                                          GRPH0056
B  60 FMT = 742606330034                                                GRPH0057
      GO TO 95                                                          GRPH0058
B  70 FMT = 742607330034                                                GRPH0059
      GO TO 95                                                          GRPH0060
B  80 FMT = 742610330034                                                GRPH0061
      GO TO 95                                                          GRPH0062
B  90 FMT = 742611330034                                                GRPH0063
   95 GO TO (100,200,300,400,500,600,700),ID                            GRPH0064
B 100 FMT = FMT + 100                                                   GRPH0065
      RETURN                                                            GRPH0066
B 200 FMT = FMT + 200                                                   GRPH0067
      RETURN                                                            GRPH0068
B 300 FMT = FMT + 300                                                   GRPH0069
      RETURN                                                            GRPH0070
B 400 FMT = FMT + 400                                                   GRPH0071
      RETURN                                                            GRPH0072
B 500 FMT = FMT + 500                                                   GRPH0073
      RETURN                                                            GRPH0074
B 600 FMT = FMT + 600                                                   GRPH0075
      RETURN                                                            GRPH0076
B 700 FMT = FMT + 700                                                   GRPH0077
      RETURN                                                            GRPH0078
      END                                                               GRPH0079
       FOR                                                              GRPH0080
      SUBROUTINE ADPLOT (X,Y,M,CHAR)                                    GRPH0081
      DIMENSION X(400),Y(400)                                           GRPH0082
    1 IGR = 1                                                           GRPH0083
    2 I = 0                                                             GRPH0084
    3 MP = 0                                                            GRPH0085
    4 IF (I-M) 6,10,5                                                   GRPH0086
    5 RETURN                                                            GRPH0087
    6 I = I+1                                                           GRPH0088
    7 CALL TESTG(X(I),Y(I),IGR)                                         GRPH0089
      GO TO (8,11),IGR                                                  GRPH0090
    8 MP = MP+1                                                         GRPH0091
    9 GO TO 4                                                           GRPH0092
   10 I = I+1                                                           GRPH0093
   11 IF (MP) 4,4,12                                                    GRPH0094
   12 CALL CURVE (X(I-1),Y(I-1),MP,CHAR)                                GRPH0095
   16 GO TO 3                                                           GRPH0096
      END                                                               GRPH0097
       FAP                                                              GRPH0098
       ENTRY   TESTG                                                    GRPH0099
 TESTG SXA     ONE,1         STORE XR 1.                                GRPH0100
       CLA*    3,4           PLACE I                                    GRPH0101
       PDX     ,1            IN AC, THEN IN XR 1.                       GRPH0102
       TRA     *+7,1         IF I IS                                    GRPH0103
       TRA     SIX           6,                                         GRPH0104
       TRA     FIVE          5,                                         GRPH0105
       TRA     FOUR          4,OR                                       GRPH0106
       TRA     THREE         3, TRANSFER ACCORDINGLY.                   GRPH0107
       TRA     *+1           IF I IS 1 OR 2, PROCEED.                   GRPH0108
       CLA     BY            IF BY IS                                   GRPH0109
       FSB*    2,4           GREATER THAN OR EQUAL TO Y                 GRPH0110
       TZE     30A           AND                                        GRPH0111
       TMI     60A           AY IS LESS THAN OR EQUAL TO Y,             GRPH0112
       CLA*    2,4           GO TO TEST ON X-COORDINATE.                GRPH0113
       FSB     AY            OTHERWISE, GO TO 60A                       GRPH0114
       TZE     30A                                                      GRPH0115
       TMI     60A                                                      GRPH0116
 30A   CLA     BX            CHECK THAT                                 GRPH0117
       FSB     AX            X LIES IN                                  GRPH0118
       XCA                                                              GRPH0119
       FMP     =.01          (AX,BX+.01(BX-AX))                         GRPH0120
       FAD     BX            IF SO,GO TO 50A                            GRPH0121
       FSB*    1,4           OTHERWISE TO 60A                           GRPH0122
       TZE     50A                                                      GRPH0123
       TMI     60A                                                      GRPH0124
       CLA*    1,4                                                      GRPH0125
       FSB     AX                                                       GRPH0126
       TZE     50A                                                      GRPH0127
       TMI     60A                                                      GRPH0128
 50A   AXT     1,1           SET I TO 1 AND                             GRPH0129
       PXD     ,1                                                       GRPH0130
       STO*    3,4                                                      GRPH0131
       TRA     ONE           RETURN                                     GRPH0132
 60A   AXT     2,1           SET I TO 2 AND                             GRPH0133
       TRA     *-4           RETURN                                     GRPH0134
 THREE CLA*    1,4           SET AX                                     GRPH0135
       STO     AX            =X                                         GRPH0136
       CLA*    2,4           AND                                        GRPH0137
       STO     BX            BX =Y,                                     GRPH0138
       TRA     ONE           RETURN                                     GRPH0139
 FOUR  CLA*    1,4           SET AY                                     GRPH0140
       STO     AY            =X                                         GRPH0141
       CLA*    2,4           AND                                        GRPH0142
       STO     BY            BY =Y,                                     GRPH0143
       TRA     ONE           RETURN                                     GRPH0144
 FIVE  CLA     AX            SET X                                      GRPH0145
       STO*    1,4           =AX                                        GRPH0146
       CLA     BX            AND                                        GRPH0147
       STO*    2,4           Y =BX                                      GRPH0148
       TRA     ONE           RETURN                                     GRPH0149
 SIX   CLA     AY            SET X                                      GRPH0150
       STO     1,4           =AY,                                       GRPH0151
       CLA     BY            AND                                        GRPH0152
       STO*    2,4           Y=BY,                                      GRPH0153
 ONE   AXT     **,1          RETURN,RESTORING XR 1.                     GRPH0154
       TRA     4,4                                                      GRPH0155
 AX    BSS     1                                                        GRPH0156
 BX    BSS     1                                                        GRPH0157
 AY    BSS     1                                                        GRPH0158
 BY    BSS     1                                                        GRPH0159
       END                                                              GRPH0160
       FOR                                                              GRPH0161
      SUBROUTINE ORDER (X,N)                                            GRPH0162
      IF (X) 10,11,10                                                   GRPH0163
   11 PRINT 12                                                          GRPH0164
   12 FORMAT (58H0ERROR.  ORDER  WAS ENTERED WITH X = 0.  N WAS SET TO  GRPH0165
     1-40)                                                              GRPH0166
      N = - 40                                                          GRPH0167
      RETURN                                                            GRPH0168
   10 N = 0                                                             GRPH0169
      XP = ABSF(X)                                                      GRPH0170
    5 IF (XP-1.) 1,2,3                                                  GRPH0171
    2 RETURN                                                            GRPH0172
    3 IF (XP-10.) 2,4,4                                                 GRPH0173
    1 XP = XP*10.                                                       GRPH0174
      N = N-1                                                           GRPH0175
      GO TO 5                                                           GRPH0176
    4 XP = XP/10.                                                       GRPH0177
      N = N+1                                                           GRPH0178
      GO TO 5                                                           GRPH0179
      END                                                               GRPH0180
