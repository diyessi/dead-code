$IBFTC SUBB                                                             BIGM0001
      SUBROUTINE BIGMAT(A,VALU,NN,NEIG,NVEC)                            BIGM0002
C PROG.AUTHORS M.ELSON AND R.E.FUNDERLIC,CENTRAL DATA PROCESSING,4,1,65 BIGM0003
      DIMENSION A(27730),VALU(1),VALL(235),UPPERD(235),DIAG(235),V(235),BIGM0004
     1SQGAMP(1),INTER(1),TMULT(1),T(235,3),SQGAMR(1),UPPER2(1)          BIGM0005
      EQUIVALENCE (TMULT,INTER,SQGAMP,VALL),(T,SQGAMR),(T(1,2),UPPER2)  BIGM0006
      NZ=0                                                              BIGM0007
      N=NN                                                              BIGM0008
      IF(N.LE.2)GO TO 39                                                BIGM0009
      NP1=N+1                                                           BIGM0010
      NM1=N-1                                                           BIGM0011
      NM2=N-2                                                           BIGM0012
      NT2P1=N*2+1                                                       BIGM0013
      IX=0                                                              BIGM0014
      DO 10 I=1,NM2                                                     BIGM0015
      SIGMA2=0.                                                         BIGM0016
      IP1=I+1                                                           BIGM0017
      DO 1 J=IP1,N                                                      BIGM0018
      IJ=IX+J                                                           BIGM0019
    1 SIGMA2=SIGMA2+A(IJ)**2                                            BIGM0020
      SIGMA=SQRT(SIGMA2)                                                BIGM0021
      II=IX+I                                                           BIGM0022
      DIAG(I)=A(II)                                                     BIGM0023
      IIP1=IX+I+1                                                       BIGM0024
      UPPERD(I)=-SIGN(SIGMA,A(IIP1))                                    BIGM0025
      UPPER2(I)=SIGMA2                                                  BIGM0026
      IF(ABS(SIGMA).GT.ABS(A(IIP1)))GO TO 2                             BIGM0027
      UPPERD(I)=A(IIP1)                                                 BIGM0028
      A(IIP1)=0.                                                        BIGM0029
      GO TO 10                                                          BIGM0030
    2 A(IIP1)=SQRT(1.+ABS(A(IIP1))/SIGMA)                               BIGM0031
      SQTGAM=-SIGN(SIGMA*A(IIP1),UPPERD(I))                             BIGM0032
      IP2=I+2                                                           BIGM0033
      DO 3 J=IP2,N                                                      BIGM0034
      IJ=IX+J                                                           BIGM0035
    3 A(IJ)=A(IJ)/SQTGAM                                                BIGM0036
      JK1=I*(2*N-I-1)/2                                                 BIGM0037
      JX=JK1                                                            BIGM0038
      IIX=JK1                                                           BIGM0039
      DO 5 J=IP1,N                                                      BIGM0040
      SQGAMP(J)=0.                                                      BIGM0041
      JK=JK1+J                                                          BIGM0042
      DO 4 K=IP1,J                                                      BIGM0043
      IK=IX+K                                                           BIGM0044
      SQGAMP(J)=SQGAMP(J)+A(JK)*A(IK)                                   BIGM0045
    4 JK=JK+N-K                                                         BIGM0046
      IF(J.EQ.N)GO TO 6                                                 BIGM0047
      CALL LOOP1(J+2,NP1,SQGAMP(J),A(JX),A(IX))                         BIGM0048
    5 JX=JX+N-J                                                         BIGM0049
    6 DELGAM=0.                                                         BIGM0050
      DO 7 J=IP1,N                                                      BIGM0051
      IJ=IX+J                                                           BIGM0052
    7 DELGAM=DELGAM+A(IJ)*SQGAMP(J)                                     BIGM0053
      DGO2=.5*DELGAM                                                    BIGM0054
      DO 8 J=IP1,N                                                      BIGM0055
      IJ=IX+J                                                           BIGM0056
    8 SQGAMR(J)=SQGAMP(J)-DGO2*A(IJ)                                    BIGM0057
      DO 9 II=IP1,N                                                     BIGM0058
      III=IX+II                                                         BIGM0059
      CALL LOOP2(A(IIX),A(IX),SQGAMR(NZ),SQGAMR(II),A(III),II+1,NP1)    BIGM0060
    9 IIX=IIX+N-II                                                      BIGM0061
   10 IX=IX+N-I                                                         BIGM0062
      M=N*(N+1)/2                                                       BIGM0063
      UPPERD(NM1)=A(M-1)                                                BIGM0064
      UPPER2(NM1)=UPPERD(NM1)**2                                        BIGM0065
      DIAG(NM1)=A(M-2)                                                  BIGM0066
      DIAG(N)=A(M)                                                      BIGM0067
      ENORM=AMAX1(ABS(DIAG)+ABS(UPPERD),ABS(DIAG(N))+ABS(UPPERD(NM1)))  BIGM0068
      DO 11 I=2,NM1                                                     BIGM0069
      ENRTMP=ABS(DIAG(I))+ABS(UPPERD(I))+ABS(UPPERD(I-1))               BIGM0070
   11 IF(ENRTMP.GT.ENORM)ENORM=ENRTMP                                   BIGM0071
      DO 12 I=1,NEIG                                                    BIGM0072
      VALU(I)=ENORM                                                     BIGM0073
   12 VALL(I)=-ENORM                                                    BIGM0074
      DO 24 I=1,NEIG                                                    BIGM0075
   13 ROOT=.5*(VALU(I)+VALL(I))                                         BIGM0076
      IF(ROOT.EQ.VALL(I).OR.ROOT.EQ.VALU(I))GO TO 24                    BIGM0077
      NAGREE=0                                                          BIGM0078
      PM2=0.                                                            BIGM0079
      PM1=1.                                                            BIGM0080
      DO 21 J=1,N                                                       BIGM0081
      IF(PM2.NE.0.)GO TO 15                                             BIGM0082
   14 PM1=SIGN(1.,PM1)                                                  BIGM0083
      GO TO 17                                                          BIGM0084
   15 IF(PM1.NE.0.)GO TO 17                                             BIGM0085
   16 P=-SIGN(1.,PM2)                                                   BIGM0086
      PM2=0.                                                            BIGM0087
      IF(UPPER2(J-1))18,14,18                                           BIGM0088
   17 P=DIAG(J)-ROOT-UPPER2(J-1)*PM2/PM1                                BIGM0089
      PM2=1.                                                            BIGM0090
   18 IF(P)21,19,20                                                     BIGM0091
   19 PM2=PM1                                                           BIGM0092
      IF(PM2)21,20,20                                                   BIGM0093
   20 NAGREE=NAGREE+1                                                   BIGM0094
   21 PM1=P                                                             BIGM0095
      DO 23 J=I,NEIG                                                    BIGM0096
      IF(J.LE.NAGREE)GO TO 22                                           BIGM0097
      IF(VALU(J).LE.ROOT)GO TO 13                                       BIGM0098
      VALU(J)=ROOT                                                      BIGM0099
      GO TO 23                                                          BIGM0100
   22 VALL(J)=ROOT                                                      BIGM0101
   23 CONTINUE                                                          BIGM0102
      GO TO 13                                                          BIGM0103
   24 CONTINUE                                                          BIGM0104
      IF(NVEC.EQ.0)GO TO 39                                             BIGM0105
      EPSLON=ENORM*1.E-8                                                BIGM0106
      COMPL1=COMPL(1)                                                   BIGM0107
      DO 38 I=1,NVEC                                                    BIGM0108
      DO 25 J=1,N                                                       BIGM0109
      V(J)=1.                                                           BIGM0110
      T(J,2)=DIAG(J)-VALU(I)                                            BIGM0111
      IF(J.EQ.N)GO TO 26                                                BIGM0112
      T(J,3)=UPPERD(J)                                                  BIGM0113
   25 T(J+1,1)=UPPERD(J)                                                BIGM0114
   26 T(N,3)=0.                                                         BIGM0115
      DO 29 J=1,N                                                       BIGM0116
      IF(ABS(T(J,2)).LT.1.E-17)T(J,2)=EPSLON                            BIGM0117
      T(J,1)=T(J,2)                                                     BIGM0118
      T(J,2)=T(J,3)                                                     BIGM0119
      T(J,3)=0.                                                         BIGM0120
      IF(J.EQ.N)GO TO 30                                                BIGM0121
      INTER(J)=0                                                        BIGM0122
      JP1=J+1                                                           BIGM0123
      IF(ABS(T(JP1,1)).LE.ABS(T(J,1)))GO TO 28                          BIGM0124
      INTER(J)=1                                                        BIGM0125
      DO 27 K=1,3                                                       BIGM0126
      TEMP=T(J,K)                                                       BIGM0127
      T(J,K)=T(JP1,K)                                                   BIGM0128
   27 T(JP1,K)=TEMP                                                     BIGM0129
   28 TMULTP=T(JP1,1)/T(J,1)                                            BIGM0130
      TMULT(J)=OR(INTER(J),AND(TMULTP,COMPL1))                          BIGM0131
      T(JP1,2)=T(JP1,2)-TMULTP*T(J,2)                                   BIGM0132
   29 T(JP1,3)=T(JP1,3)-TMULTP*T(J,3)                                   BIGM0133
   30 ITER=1                                                            BIGM0134
   31 DO 32 J=1,N                                                       BIGM0135
      L=N+1-J                                                           BIGM0136
   32 V(L)=(V(L)-T(L,2)*V(L+1)-T(L,3)*V(L+2))/T(L,1)                    BIGM0137
      VNORM=0.                                                          BIGM0138
      DO 33 L=1,N                                                       BIGM0139
   33 VNORM=VNORM+V(L)**2                                               BIGM0140
      VNORM=SQRT(VNORM)                                                 BIGM0141
      DO 34 J=1,N                                                       BIGM0142
   34 V(J)=V(J)/VNORM                                                   BIGM0143
      IF(ITER.EQ.2)GO TO 36                                             BIGM0144
      ITER=2                                                            BIGM0145
      DO 35 L=2,N                                                       BIGM0146
      LM1=L-1                                                           BIGM0147
      IF(AND(TMULT(LM1),1).EQ.0.)GO TO 35                               BIGM0148
      VTEMP=V(LM1)                                                      BIGM0149
      V(LM1)=V(L)                                                       BIGM0150
      V(L)=VTEMP                                                        BIGM0151
   35 V(L)=V(L)-TMULT(LM1)*V(LM1)                                       BIGM0152
      GO TO 31                                                          BIGM0153
   36 IF(VNORM.EQ.0.)V(I)=1.                                            BIGM0154
      IIX=(N*N-N-6)/2                                                   BIGM0155
      DO 37 KK=1,NM2                                                    BIGM0156
      IIP1=N-KK                                                         BIGM0157
      UTV=0.                                                            BIGM0158
      CALL LOOP3(UTV,A(IIX),V(NZ),IIP1+1,NP1)                           BIGM0159
      CALL LOOP4(A(IIX),V(NZ),NP1,IIP1+1,UTV)                           BIGM0160
   37 IIX=IIX+IIP1-N-2                                                  BIGM0161
   38 WRITE(6,4000)VALU(I),(V(J),J=1,N)                                 BIGM0162
 4000 FORMAT(30H0EIGENVECTOR CORRESPONDING TO 1PE15.7/(1H 1P8E15.7))    BIGM0163
   39 RETURN                                                            BIGM0164
      END                                                               BIGM0165
$IBFTC SUB1                                                             BIGM0166
      SUBROUTINE LOOP1(JP2,NP1,SGAMPJ,AJX,AIX)                          BIGM0167
      DIMENSION AJX(1), AIX(1)                                          BIGM0168
      DO 1 L=JP2,NP1                                                    BIGM0169
    1 SGAMPJ=SGAMPJ+AJX(L)*AIX(L)                                       BIGM0170
      RETURN                                                            BIGM0171
      END                                                               BIGM0172
$IBFTC SUB2                                                             BIGM0173
      SUBROUTINE LOOP2(AIIX,AIX,S,SI,AIII,IP1,NP1)                      BIGM0174
      DIMENSION AIIX(1),AIX(1),S(1)                                     BIGM0175
      DO 2 JJ=IP1,NP1                                                   BIGM0176
    2 AIIX(JJ)=AIIX(JJ)-AIII*S(JJ)-SI*AIX(JJ)                           BIGM0177
      RETURN                                                            BIGM0178
      END                                                               BIGM0179
$IBFTC SUB3                                                             BIGM0180
      SUBROUTINE LOOP3(UTV,AIIX,V,IIP2,NP1)                             BIGM0181
      DIMENSION AIIX(1), V(1)                                           BIGM0182
      DO 3 J=IIP2,NP1                                                   BIGM0183
    3 UTV=UTV+AIIX(J)*V(J)                                              BIGM0184
      RETURN                                                            BIGM0185
      END                                                               BIGM0186
$IBFTC SUB4                                                             BIGM0187
      SUBROUTINE LOOP4(AIIX,V,NP1,IIP2,UTV)                             BIGM0188
      DIMENSION AIIX(1),V(1)                                            BIGM0189
      DO 4 K=IIP2,NP1                                                   BIGM0190
    4 V(K)=V(K)-AIIX(K)*UTV                                             BIGM0191
      RETURN                                                            BIGM0192
      END                                                               BIGM0193
