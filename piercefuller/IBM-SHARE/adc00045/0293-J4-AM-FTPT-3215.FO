       ENTRY XRTOUT                                                     FTPT0001
       ENTRY CRTOUT                                                     FTPT0002
XRTOUT CLA 1,4                                                          FTPT0003
       STA *+1                                                          FTPT0004
       CLA *                                                            FTPT0005
       STD 3,4                                                          FTPT0006
       TXI *+1,4,-1                                                     FTPT0007
CRTOUT CAL *+3                                                          FTPT0008
       SLW 1,4                                                          FTPT0009
       TRA 1,4                                                          FTPT0010
       TSX OUTCRT,4                                                     FTPT0011
       END                                                              FTPT0012
