      SUBROUTINE RNGE(X,NX,A,B,NOL,NOI,IOPT)                            RNGE0001
      DIMENSION X(400)                                                  RNGE0002
   10 FORMAT (7H   A = ,E14.7,4X,4HB = ,E14.7/34H   INTERVAL BETWEEN GRIRNGE0003
     1D LINES IS ,E14.7)                                                RNGE0004
      A = X(1)                                                          RNGE0005
      DO 1 I = 1,NX                                                     RNGE0006
      IF (X(I) - A) 2,1,1                                               RNGE0007
    2 A = X(I)                                                          RNGE0008
    1 CONTINUE                                                          RNGE0009
      B = X(1)                                                          RNGE0010
      DO 3 I = 1,NX                                                     RNGE0011
      IF (X(I) - B) 3,3,4                                               RNGE0012
    4 B = X(I)                                                          RNGE0013
    3 CONTINUE                                                          RNGE0014
      S = B-A                                                           RNGE0015
      IF(S)1010,1011,1010                                               RNGE0016
 1010 N=0                                                               RNGE0017
      XP=ABSF(S)                                                        RNGE0018
 1005 IF(XP-1.)1001,1002,1003                                           RNGE0019
 1002 GO TO 100                                                         RNGE0020
 1003 IF(XP-10.)1002,1004,1004                                          RNGE0021
 1001 XP=XP*10.                                                         RNGE0022
      N=N-1                                                             RNGE0023
      GO TO 1005                                                        RNGE0024
 1004 XP=XP/10.                                                         RNGE0025
      N=N+1                                                             RNGE0026
      GO TO 1005                                                        RNGE0027
 1011 S = 1.                                                            RNGE0028
      A = A-.5                                                          RNGE0029
      B = B+.5                                                          RNGE0030
      N = 0                                                             RNGE0031
  100 F=10.**(N-1)                                                      RNGE0032
  110 IF (A) 120,130,130                                                RNGE0033
  120 IF((A/F)-INTF(A/F)) 122,130,122                                   RNGE0034
  122 IA = A/F - 1.                                                     RNGE0035
  125 GO TO 140                                                         RNGE0036
  130 IA = A/F                                                          RNGE0037
  140 IF (B) 150,160,160                                                RNGE0038
  150 IB = B/F                                                          RNGE0039
  155 GO TO 170                                                         RNGE0040
  160 IF((B/F)-INTF(B/F)) 162,150,162                                   RNGE0041
  162 IB = (B/F) + 1.                                                   RNGE0042
  170 IS = IB - IA                                                      RNGE0043
  180 A = MIN1F(A,FLOATF(IA)*F)                                         RNGE0044
  190 IF (IS-20) 200,200,230                                            RNGE0045
  200 IS = 2*((IS+1)/2)                                                 RNGE0046
  210 NOL = 2*IS                                                        RNGE0047
  220 NOI = 4                                                           RNGE0048
  225 GO TO 410                                                         RNGE0049
  230 IF (IS-25) 240,240,280                                            RNGE0050
  240 IS = 25                                                           RNGE0051
  250 NOL = IS                                                          RNGE0052
  260 NOI = 5                                                           RNGE0053
  270 GO TO 410                                                         RNGE0054
  280 IF (IS-30) 290,290,330                                            RNGE0055
  290 IS = 30                                                           RNGE0056
  300 NOL = 30                                                          RNGE0057
  310 NOI = 5                                                           RNGE0058
  320 GO TO 410                                                         RNGE0059
  330 IF (IS-40) 340,340,380                                            RNGE0060
  340 IS = 40                                                           RNGE0061
  350 NOL = 40                                                          RNGE0062
  360 NOI = 5                                                           RNGE0063
  370 GO TO 410                                                         RNGE0064
  380 IF ((FLOATF(IS)/10.)-FLOATF(IS/10)) 382,390,382                   RNGE0065
  382 IS = 10*((IS/10)+1)                                               RNGE0066
  390 NOL = 5*(IS/10)                                                   RNGE0067
  400 NOI = 5                                                           RNGE0068
  410 IB = IA + IS                                                      RNGE0069
  420 B = MAX1F(B,FLOATF(IB)*F)                                         RNGE0070
  430 IF (IOPT) 460,440,460                                             RNGE0071
  440 XINT = (B-A)/FLOATF(NOL)                                          RNGE0072
  450 PRINT 10,A,B,XINT                                                 RNGE0073
  460 RETURN                                                            RNGE0074
      END                                                               RNGE0075
