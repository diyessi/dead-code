*     FAP                                                               RANDR000
       COUNT  30                                                        RANDR001
       ENTRY  RANDR          RANDR(Z)                                   RANDR002
 RANDR CLA*   1,4            Z IS PREVIOUS RANDOM NO                    RANDR003
       CAS    ZO             IF Z=ZO THEN                               RANDR004
       TRA    NEW                                                       RANDR005
       TRA    OLD            CONTINUE SEQUENCE,                         RANDF006
 NEW   TZE    *+2            OTHERWISE START ANEW.                      RANDR007
       UFA    EXPL                                                      RANDR008
       LDQ    BIT1           ENSURE LAST TWO BITS OF K ARE 01           RANDR009
       LRS    27             TAKE FRACTIONAL PART OF Z AND ITS SIGN     RANDR010
       ZAC                                                              RANDR011
       LGR    6              PUSH 01 TO BOTTOM OF K.                    RANDR012
       STQ    K                19 CYCLES ADDED                          RANDR013
 OLD   LDQ    I                                                         RANDR014
       MPY    K                                                         RANDR015
       STQ    K              NEW K = I*K                                RANDR016
       RQL    6              DELETE 1ST 6 BITS, 7TH IS SIGN             RANDR017
       CLA    EXPR           SET UP NEW CHARACTERISTIC                  RANDR018
       LLS    27                                                        RANDR019
       FAD    EXPL           NORMALIZE Z                                RANDR020
       STO    ZO             REMEMBER LAST RANDOM NO.                   RANDR021
       STO*   1,4             STORED IN Z.                              RANDR022
       TRA    2,4              42 CYCLES                                RANDR023
 ZO    PZE    0                                                         RANDR024
 EXPL  OCT    200000000000                                              RANDR025
 BIT1  OCT    100000000000                                              RANDR026
 K     OCT    1              V. KAHAN   SEPT. 1963                      RANDR027
 I     OCT    005343277245                                              RANDR028
 EXPR  OCT    200            27 LOCATIONS                               RANDR029
       END                                                              RANDR030
