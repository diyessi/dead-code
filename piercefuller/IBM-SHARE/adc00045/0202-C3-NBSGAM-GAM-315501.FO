      FUNCTION GAMMA(X)                                                 GAM00001
   75 FORMAT(66H GAMMA FUNCTION OF A NEGATIVE INTEGER, OR OF ZERO, IS NOGAM00002
     1T DEFINED.)                                                       GAM00003
    5 IF(X) 10,80,15                                                    GAM00004
   10 N=-X                                                              GAM00005
      EN=-N-1                                                           GAM00006
      V=X-EN                                                            GAM00007
      IF(V-1.) 20,80,20                                                 GAM00008
   15 N=X                                                               GAM00009
      EN=N                                                              GAM00010
      V=X-EN                                                            GAM00011
   20 GAMMA=1.+V*(.422784337+V*(.4118402518+V*(.08157821878+V*          GAM00012
     1(.07423790761+V*(-.0002109074673+V*(.01097369584+V*(-.002466747981GAM00013
     2+V*(.001539768105-V*(.0003442342046-V*.00006771057117)))))))))    GAM00014
      IF(EN-2.) 37,25,30                                                GAM00015
   25 RETURN                                                            GAM00016
   30 N=N-1                                                             GAM00017
      DO 35 I=2,N                                                       GAM00018
      FI=I                                                              GAM00019
   35 GAMMA=GAMMA*(FI+V)                                                GAM00020
      RETURN                                                            GAM00021
   37 N=2.-EN                                                           GAM00022
      DO 40 I=1,N                                                       GAM00023
      FI=2-I                                                            GAM00024
   40 GAMMA=GAMMA/(FI+V)                                                GAM00025
      RETURN                                                            GAM00026
   80 WRITE OUTPUT TAPE 6,75                                            GAM00027
      CALL EXIT                                                         GAM00028
      END                                                               GAM00029
