C U. OF P. C.C. C/R    7040                                             CRRG   1
      DIMENSION X(25),R(25,25),S(25,25),SWTX(25),XBAR(25),SIGMA(25),    CRRG   2
     1    BETA(25),A(25,25),B(25,25),SB(25),C(25,25),V(25)              CRRG   3
      COMMON R, SWTX, BETA, SIGMA, X,V                                  CRRG   4
      EQUIVALENCE (R,A,B,C,S),(X,XBAR), (SWTX,SB)                       CRRG   5
 1155 PRINT 302                                                         CRRG   6
  302 FORMAT(66H1U.OF P. COMPUTER CENTER CORRELATION-REGRESSION PROGRAM CRRG   7
     1    4/1/64,//)                                                    CRRG   8
      READ 314, ANAM1,M,N,INDEP,IP,F1,F2,RERUN                          CRRG   9
  314 FORMAT(A5,I5,2I3,3X,I1,50X,F5.4,F4.3,I1)                          CRRG  10
      NM1=N-1                                                           CRRG  11
      DO 6 I=1,25                                                       CRRG  12
      DO 5 J=1,25                                                       CRRG  13
    5 R(I,J)=0.0                                                        CRRG  14
      BETA(I)=0.0                                                       CRRG  15
    6 SWTX(I)=0.0                                                       CRRG  16
      PRINT 303,N,M                                                     CRRG  17
  303 FORMAT(23H NUMBER OF VARIABLES IS,I8,///,26H NUMBER OF OBSERVATIONCRRG  18
     1S IS,I5,//)                                                       CRRG  19
      PRINT 331, F1, F2                                                 CRRG  20
  331 FORMAT(6H F1 IS,F6.2,9H    F2 IS,F6.2,//)                         CRRG  21
      PRINT 670,INDEP                                                   CRRG  22
  670 FORMAT(28H THE DEPENDENT VARIABLE IS X,I2,//)                     CRRG  23
      PRINT 659, ANAM1                                                  CRRG  24
  659 FORMAT(21H NAME OF OUTPUT IS   ,A5)                               CRRG  25
      PRINT 1000                                                        CRRG  26
 1000 FORMAT(1H1)                                                       CRRG  27
      PRINT 73,ANAM1                                                    CRRG  28
   73 FORMAT(62X,A5,//)                                                 CRRG  29
      PRINT 671, N, N, INDEP                                            CRRG  30
  671 FORMAT(43H THE DEPENDENT VARIABLE IS PRINTED OUT AS X,I2,//       CRRG  31
     117H INPUT VARIABLE X,I2,21H  IS PRINTED OUT AS X,I2,//)           CRRG  32
C BOX 1. INPUT DATA                                                     CRRG  33
      DO 155 L=1,M                                                      CRRG  34
      READ 301, (X(J), J=1,N)                                           CRRG  35
  301 FORMAT(7F10.0,10X)                                                CRRG  36
      TEMP=X(N)                                                         CRRG  37
      X(N)=X(INDEP)                                                     CRRG  38
      X(INDEP)=TEMP                                                     CRRG  39
      DO 155 I=1,N                                                      CRRG  40
      IF (X(I)) 13,155,13                                               CRRG  41
C        SUMS OF VARIABLES                                              CRRG  42
   13 SWTX(I)=SWTX(I)+X(I)                                              CRRG  43
C        SUMS OF SQUARES AND CROSS-PRODUCTS                             CRRG  44
      DO 15 J=I,N                                                       CRRG  45
   15 S(I,J) = S(I,J) +(X(I)*X(J))                                      CRRG  46
  155 CONTINUE                                                          CRRG  47
      SUMWT=FLOAT(M)                                                    CRRG  48
      IF(IP-1) 75,122,122                                               CRRG  49
   75 PRINT 304                                                         CRRG  50
  304 FORMAT(50X,18H SUMS OF VARIABLES,//)                              CRRG  51
      PRINT 305,                                                        CRRG  52
  305 FORMAT(6X2HX111X2HX211X2HX311X2HX411X2HX511X2HX611X2HX711X2HX811X2CRRG  53
     1HX911X3HX102X/)                                                   CRRG  54
      PRINT 26, (SWTX(I), I=1,N)                                        CRRG  55
   26 FORMAT(1H0,1P10E13.5)                                             CRRG  56
      PRINT 1000                                                        CRRG  57
   57 PRINT 307                                                         CRRG  58
  307 FORMAT(  40X,38HRAW SUMS OF SQUARES AND CROSS PRODUCTS,//)        CRRG  59
      PRINT 305                                                         CRRG  60
      DO 165 I=1,N                                                      CRRG  61
  165 PRINT 308, (S(J,I),J=1,I )                                        CRRG  62
  308 FORMAT(1H0,1P10E13.5,/,1H ,10E13.5,/,1H ,10E13.5)                 CRRG  63
  122 EMSQ=SUMWT**2                                                     CRRG  64
      DO 19 I=1,N                                                       CRRG  65
C BOX 3. VARIANCE-COVARIANCE MATRIX                                     CRRG  66
      DO 19 J=I,N                                                       CRRG  67
   19 S(I,J)= (SUMWT*S(I,J)-SWTX(I)*SWTX(J))/EMSQ                       CRRG  68
      IF(IP-1) 60,124,124                                               CRRG  69
   60 PRINT  1000                                                       CRRG  70
      PRINT 309                                                         CRRG  71
  309 FORMAT(  40X,26HVARIANCE-COVARIANCE MATRIX,//)                    CRRG  72
      PRINT 305                                                         CRRG  73
      DO 20 I=1,N                                                       CRRG  74
   20 PRINT 308, (S(J,I),J=1,I)                                         CRRG  75
      PRINT 1000                                                        CRRG  76
C        MEANS OF VARIABLES                                             CRRG  77
  124 DO 22 I=1,N                                                       CRRG  78
   22 XBAR(I)=SWTX(I)/SUMWT                                             CRRG  79
   63 PRINT 311                                                         CRRG  80
  311 FORMAT(////40X,24HMEAN VALUES OF VARIABLES,//)                    CRRG  81
      PRINT 305                                                         CRRG  82
      PRINT 26,(XBAR(I),I=1,N)                                          CRRG  83
C BOX 4.                                                                CRRG  84
      DO 25 I=1,N                                                       CRRG  85
   25 SIGMA(I)=SQRT(S(I,I))                                             CRRG  86
  692 PRINT 312                                                         CRRG  87
  312 FORMAT(////40X, 32HSTANDARD DEVIATIONS OF VARIABLES,//)           CRRG  88
      PRINT 305                                                         CRRG  89
      PRINT 26,(SIGMA(I),I=1,N)                                         CRRG  90
      DO 32 I=1,NM1                                                     CRRG  91
      JA=I+1                                                            CRRG  92
      DO 32 J=JA,N                                                      CRRG  93
      R(I,J)=S(I,J)/(SIGMA(I)*SIGMA(J))                                 CRRG  94
   32 R(J,I)=R(I,J)                                                     CRRG  95
      DO 34 I=1,N                                                       CRRG  96
   34 R(I,I)=1.0                                                        CRRG  97
      IF(IP-3)67, 126,126                                               CRRG  98
   67 PRINT 313                                                         CRRG  99
  313 FORMAT(1H1,40X,24HCORRELATION COEFFICIENTS,//)                    CRRG 100
      PRINT 305                                                         CRRG 101
      DO 35 I=1,N                                                       CRRG 102
   35 PRINT 306, (R(I,J),J=1,I)                                         CRRG 103
  306 FORMAT(1H0,10F13.5,/,1H ,10F13.5,/,1H ,10F13.5)                   CRRG 104
C     STEPWISE MULTIPLE REGRESSION                                      CRRG 105
  126 PRINT 332                                                         CRRG 106
  332 FORMAT(20H1STEPWISE REGRESSION //)                                CRRG 107
      TOL=0.001                                                         CRRG 108
      SWTCH =0.0                                                        CRRG 109
   72 SITCH=1.0                                                         CRRG 110
      PHI=SUMWT - 1.0                                                   CRRG 111
      ISTP=1                                                            CRRG 112
C BOX 5.                                                                CRRG 113
  700 SY=SIGMA(N)*SQRT(R(N,N)*SUMWT/PHI)                                CRRG 114
      IF ( SWTCH) 702,701,702                                           CRRG 115
  701 PRINT 323, SY                                                     CRRG 116
      PRINT 696                                                         CRRG 117
  696 FORMAT(//)                                                        CRRG 118
  702 I=1                                                               CRRG 119
      VMIN=10.0E20                                                      CRRG 120
      VMAX=0.0                                                          CRRG 121
      NMIN=0                                                            CRRG 122
      NMAX=0                                                            CRRG 123
C BOX 6.                                                                CRRG 124
  400 IF (A(I,I)-TOL) 7,7,407                                           CRRG 125
    7 PRINT 8, I                                                        CRRG 126
    8 FORMAT(20HOTOLERANCE CHECK.  X,I2)                                CRRG 127
      GO TO 300                                                         CRRG 128
C BOX 7.                                                                CRRG 129
  407 V(I)=(A(I,N)*A(N,I))/A(I,I)                                       CRRG 130
C BOX 8.                                                                CRRG 131
      IF (V(I))100,300,409                                              CRRG 132
C BOX 9.                                                                CRRG 133
  409 IF (V(I)-VMAX) 300,300,200                                        CRRG 134
C BOX 10.                                                               CRRG 135
  200 VMAX=V(I)                                                         CRRG 136
      NMAX=I                                                            CRRG 137
      BETA(I)=0.0                                                       CRRG 138
      GO TO 300                                                         CRRG 139
C BOX 11.                                                               CRRG 140
  100 BETA(I)=(B(I,N)*SIGMA(N))/SIGMA(I)                                CRRG 141
      SB(I)=SY*SQRT(C(I,I)/SUMWT)/SIGMA(I)                              CRRG 142
C BOX 12.                                                               CRRG 143
      IF (ABS(V(I))-ABS(VMIN)) 113,300,300                              CRRG 144
C BOX 13.                                                               CRRG 145
  113 VMIN=V(I)                                                         CRRG 146
      NMIN=I                                                            CRRG 147
C BOX 14.                                                               CRRG 148
  300 IF (I-(N-1)) 315,316,316                                          CRRG 149
C BOX 15.                                                               CRRG 150
  315 I=I+1                                                             CRRG 151
      GO TO 400                                                         CRRG 152
C BOX 16.                                                               CRRG 153
  316 BETAZ=0.0                                                         CRRG 154
      DO 3016 I=1,NM1                                                   CRRG 155
 3016 BETAZ=BETAZ+(BETA(I)*XBAR(I))                                     CRRG 156
      BETAZ=XBAR(N)-BETAZ                                               CRRG 157
C DAVES INSERTION                                                       CRRG 158
      IF(SWTCH) 3017, 3018, 3017                                        CRRG 159
 3017 PRINT 320, ISTP                                                   CRRG 160
  320 FORMAT(10H0STEP NO. ,I4)                                          CRRG 161
      GO TO (11,12), JUMP                                               CRRG 162
   12 PRINT 317, K                                                      CRRG 163
  317 FORMAT(/22H VARIABLE REMOVED IS X,I2)                             CRRG 164
      PRINT 322, F                                                      CRRG 165
      GO TO 16                                                          CRRG 166
   11 PRINT 321, K                                                      CRRG 167
  321 FORMAT(/23H VARIABLE ENTERING IS X,I2,)                           CRRG 168
      PRINT 322, FINK                                                   CRRG 169
  322 FORMAT(/11H F LEVEL   ,F17.6)                                     CRRG 170
   16 PRINT 323, SY                                                     CRRG 171
  323 FORMAT(/16H STD. ERROR OF Y,F12.6)                                CRRG 172
      RMUL=SQRT(1.0-R(N,N))                                             CRRG 173
      PRINT 310,RMUL                                                    CRRG 174
  310 FORMAT(/11H MULTIPLE R,F17.6)                                     CRRG 175
      PRINT 324, BETAZ                                                  CRRG 176
  324 FORMAT(/14H CONSTANT TERM,F14.6)                                  CRRG 177
      ISTP= ISTP+1                                                      CRRG 178
      PRINT 327,                                                        CRRG 179
  327  FORMAT(/6X45HVARIABLE    COEFFICIENT    STD. ERR. OF COEF.,//)   CRRG 180
      DO 3019 I=1,NM1                                                   CRRG 181
      IF (BETA(I))3020,3019,3020                                        CRRG 182
 3020 PRINT 326, I, BETA(I), SB(I)                                      CRRG 183
  326 FORMAT(8X,1HX,I2,2F17.6,//)                                       CRRG 184
 3019 CONTINUE                                                          CRRG 185
      PRINT 1000                                                        CRRG 186
      IF (SITCH) 3018,622,3018                                          CRRG 187
C BOX 17.                                                               CRRG 188
 3018 F=ABS(VMIN)*PHI/R(N,N)                                            CRRG 189
      IF (F-F2) 318,600,600                                             CRRG 190
C BOX 18.                                                               CRRG 191
  318 K=NMIN                                                            CRRG 192
      PHI=PHI+1.0                                                       CRRG 193
      JUMP=2                                                            CRRG 194
      GO TO 500                                                         CRRG 195
C BOX 19.                                                               CRRG 196
  600 PHI=PHI-1.0                                                       CRRG 197
      FINK=VMAX*PHI/(R(N,N)-VMAX)                                       CRRG 198
      IF(FINK-F1)2,620,620                                              CRRG 199
    2 PHI=PHI+1.0                                                       CRRG 200
      GO TO 622                                                         CRRG 201
C BOX 20.                                                               CRRG 202
  620 K=NMAX                                                            CRRG 203
      SITCH = SUMWT - PHI - FLOAT (N)                                   CRRG 204
      JUMP=1                                                            CRRG 205
C BOX 21.                                                               CRRG 206
  500 DO 507  I=1,N                                                     CRRG 207
      DO 507  J=1,N                                                     CRRG 208
      IF (I-K) 501,502,501                                              CRRG 209
  501 IF (J-K) 503,504,503                                              CRRG 210
  502 IF (J-K) 505,506,505                                              CRRG 211
  503 A(I,J)=((A(K,K)*A(I,J))-(A(I,K)*A(K,J)))/A(K,K)                   CRRG 212
      GO TO 507                                                         CRRG 213
  504 A(I,N+1)=(-1.0*A(I,K)/A(K,K))                                     CRRG 214
      GO TO 507                                                         CRRG 215
  505 A(N+1,J)=A(K,J)/A(K,K)                                            CRRG 216
      GO TO 507                                                         CRRG 217
  506 A(N+1,K)=1.0/A(K,K)                                               CRRG 218
  507 CONTINUE                                                          CRRG 219
      DO 508 I=1,N                                                      CRRG 220
  508 A(I,K)=A(I,N+1)                                                   CRRG 221
      DO 509 J=1,N                                                      CRRG 222
  509 A(K,J)=A(N+1,J)                                                   CRRG 223
C END BOX 21.                                                           CRRG 224
      SWTCH= 1.0                                                        CRRG 225
      GO TO 700                                                         CRRG 226
  622 IF(IP-2)652,656,656                                               CRRG 227
  652 PRINT 329                                                         CRRG 228
  329 FORMAT(    60X,12HFINAL MATRIX,//)                                CRRG 229
      PRINT 305                                                         CRRG 230
      DO 653  I=1,N                                                     CRRG 231
  653 PRINT 306, (A(I,J), J=1,N)                                        CRRG 232
      PRINT 1000                                                        CRRG 233
  656 PRINT 657                                                         CRRG 234
  657 FORMAT(46H FINAL VARIANCE CONTRIBUTIONS   FINAL F-LEVELS,//)      CRRG 235
      DO 24 I=1,NM1                                                     CRRG 236
      IF(V(I)-0.0) 18,21,23                                             CRRG 237
   18 FF=V(I)*PHI/R(N,N)                                                CRRG 238
      GO TO 24                                                          CRRG 239
   21 FF=0.0                                                            CRRG 240
      GO TO 24                                                          CRRG 241
   23 FF=V(I)*(PHI-1.0)/(R(N,N)-V(I))                                   CRRG 242
   24 PRINT 658, I, V(I), FF                                            CRRG 243
  658 FORMAT(2X,1HX,I2,1X,1PE16.6,1PE22.6,/)                            CRRG 244
      IPHI=PHI                                                          CRRG 245
      PRINT 4, IPHI                                                     CRRG 246
    4 FORMAT(20H0DEGREES OF FREEDOM=I5)                                 CRRG 247
      PRINT 54                                                          CRRG 248
   54 FORMAT(9H0C/R DONE)                                               CRRG 249
      IF(RERUN) 1155,3,1155                                             CRRG 250
    3 STOP                                                              CRRG 251
      END                                                               CRRG 252
$ENTRY                                                                          
