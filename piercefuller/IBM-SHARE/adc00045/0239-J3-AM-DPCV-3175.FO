      SUBROUTINE FDYERR(J,D,CU,CL)                                      DPCV 215
      PRINT 1, J,D                                                      DPCV 216
    1 FORMAT (61H    ERROR DUE TO DOUBLE PRECISION DIVISION AT OCTAL LOCDPCV 217
     1ATION O5, 22H   M.S.P. OF DIVISOR =1PE15.7)                       DPCV 218
