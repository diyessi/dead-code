C EVVRS. EIGENVALUES AND EIGENVECTORS OF A REAL SYMMETRIC MATRIX                
      DIMENSION A(50,50), VEC(50,50), EXTRA(50,5), B(50,50),DIF(50,50)          
    6 READ 9, ANAM,N,IEC                                                        
    9 FORMAT(A10,I3,I2)                                                         
C READ MATRIX AND COPY INTO B                                                   
      DO 10 J=1,N                                                               
      READ 1, (A(I,J),I=1,J)                                                    
    1 FORMAT(8F10.0)                                                            
      DO 10 I=1,J                                                               
      B(J,I)=A(I,J)                                                             
   10 B(I,J)=A(I,J)                                                             
      PRINT 110,ANAM                                                            
  110 FORMAT(3H1  A10,//)                                                       
      DO 11  J=1,N                                                              
      PRINT 2, (B(I,J),I=1,J)                                                   
    2 FORMAT(1P8E16.7)                                                          
   11 PRINT 111                                                                 
  111 FORMAT(//)                                                                
      CALL MLEW(N,A,VEC,EXTRA)                                                  
      PRINT 112                                                                 
  112 FORMAT(14H1  EIGENVALUES//)                                               
      PRINT 2, (EXTRA(I,1),I=1,N)                                               
      PRINT 113                                                                 
  113 FORMAT(15H1  EIGENVECTORS)                                                
      DO 12 J=1,N                                                               
      PRINT 2, (VEC(I,J),I=1,N)                                                 
   12 PRINT 111                                                                 
      IF(IEC) 7,6,7                                                             
C ERROR CHECK                                                                   
    7 PRINT 114                                                                 
  114 FORMAT(18H1  RELATIVE ERRORS//)                                           
      DO 5 J=1,N                                                                
      DO 5 I=1,N                                                                
      EXTRA(I,2)=0.0                                                            
      DO 3 K=1,N                                                                
    3 EXTRA(I,2)=B(I,K)*VEC(K,J)+EXTRA(I,2)                                     
    5 DIF(I,J)=(EXTRA(J,1)*VEC(I,J)-EXTRA(I,2))/EXTRA(I,2)                      
      DO 4 J=1,N                                                                
      PRINT 2, (DIF(I,J),I=1,N)                                                 
    4 PRINT 111                                                                 
      GO TO 6                                                                   
      END                                                                       
$ENTRY                                                                          
