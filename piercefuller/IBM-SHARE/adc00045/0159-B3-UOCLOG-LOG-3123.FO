*     FAP                                                                       
       LBL     LOG                                                      LOG00000
       COUNT   100                                                      LOG00001
*      U. OF CHICAGO VERSION OF SINGLE PRECISION LOGARITHM              LOG00002
*              CALLING SEQUENCE     TSX  $LOG,4    (OR $LOG10,4)        LOG00003
*              ERROR CONDITION IS HANDLED BY (EXE)                      LOG00004
       SPACE                                                            LOG00005
       ENTRY   LOG                                                      LOG00006
       ENTRY   LOG10                                                    LOG00007
       SPACE                                                            LOG00008
 LOG10 STL     FLAG                                                     LOG00009
  LOG  TZE     ERROR         IF X IS 0 OR NEGATIVE, THIS IS ERROR       LOG00010
       TMI     ERROR                                                    LOG00011
       STO     BUFF                                                     LOG00012
       FSB     FLONE         Z=X-1                                      LOG00013
       LAS     TWOM7                                                    LOG00014
       TRA     A             IF ARG IS AWAY FROM 1, SKIP                LOG00015
       AXT     0,0                                                      LOG00016
       STO     BUFF          FOR X APPROX. 1, USE POWER SERIES FOR Z    LOG00017
       XCA                                                              LOG00018
       FMP     D2              F=Z-(1/2+3*2**(-18))Z*Z+(1/3)Z*Z*Z       LOG00019
       FAD     D1                                                       LOG00020
       XCA                                                              LOG00021
       FMP     BUFF                                                     LOG00022
       FAD     FLONE                                                    LOG00023
       XCA                                                              LOG00024
       FMP     BUFF                                                     LOG00025
       TRA     TEST                                                     LOG00026
       SPACE                                                            LOG00027
  A    LDQ     K3                                                       LOG00028
       CLA     BUFF                                                     LOG00029
       LRS     27            SEND MANTISSA M TO MQ, SCALE CHARAC.       LOG00030
       ALS     19              TO B16, AND SUBTRACT 128+1/2             LOG00031
       SUB     K3                                                       LOG00032
       STO     CHAR                                                     LOG00033
       SPACE                                                            LOG00034
       XCA                   PICK UP M IN AC, AND COMPUTE               LOG00035
       LRS     1                  Z=(M-SQRT2/2)/(M+SQRT2/2)             LOG00036
       ADD     K1                                                       LOG00037
       STO     BUFF                                                     LOG00038
       SUB     K2                                                       LOG00039
       VDP     BUFF,,34                                                 LOG00040
       STQ     Z               SCALE B1                                 LOG00041
       SPACE                                                            LOG00042
       MPY     Z             COMPUTE FRACTIONAL APPROXIMATION OF        LOG00043
       STO     SQ               F=LOG((1+Z)/(1-Z)) BASE2                LOG00044
       ADD     C4                                                       LOG00045
       STO     BUFF             F=Z(C1+C2*SQ+C3/(C4+SQ))                LOG00046
       CLA     C3                                                       LOG00047
       DVP     BUFF                                                     LOG00048
       STQ     BUFF            SCALE B2                                 LOG00049
       LDQ     SQ                                                       LOG00050
       MPY     C2                                                       LOG00051
       ADD     BUFF                                                     LOG00052
       ADD     C1              SCALE B2                                 LOG00053
       XCA                                                              LOG00054
       MPY     Z               F NOW READY     SCALE B3                 LOG00055
       SPACE                                                            LOG00056
       LRS     13            LEADING PART OF F IN B16, TAIL PART IN MQ  LOG00057
       ADD     CHAR            LOG X BASE2 = CHAR.-128-1/2+F            LOG00058
       STO     CHAR                                                     LOG00059
       MPY     LOGTW         NOW LEADING PART AND TAIL PART MAY HAVE    LOG00060
       STO     Z               DIFFERENT SIGN.  MULTIPLY LOG 2 BASE E   LOG00061
       LDQ     CHAR            (IN B0) TO EACH PART, FLOAT THE PRODUCTS LOG00062
       MPY     LOGTW           AND ADD THEM UP TO OBTAIN ANSWER         LOG00063
       ORA     K4                                                       LOG00064
       STO     CHAR                                                     LOG00065
       XCA                                                              LOG00066
       ADD     Z                                                        LOG00067
       ARS     9                                                        LOG00068
       ORA     K5                                                       LOG00069
       FAD     CHAR                                                     LOG00070
       FRN                                                              LOG00071
 TEST  NZT     FLAG                                                     LOG00072
       TRA     1,4                                                      LOG00073
       XCA                   COMMON LOG REQUESTED                       LOG00074
       FMP     LOGE                                                     LOG00075
       FRN                                                              LOG00076
       STZ     FLAG                                                     LOG00077
       TRA     1,4                                                      LOG00078
 ERROR LDI     *+2                                                      LOG00079
       TRA*    $(EXE)                                                   LOG00080
       PZE     6,4,ERROR     CANT GET OUT OF THIS ERROR                 LOG00081
       SPACE                                                            LOG00082
  K1   OCT     132404746320      SQRT2/2               B1               LOG00083
  K2   OCT     265011714640      SQRT2                 B1               LOG00084
  K3   OCT     401000000         128+1/2               B16              LOG00085
  K4   OCT     210000000000                                             LOG00086
  K5   OCT     156000000000                                             LOG00087
 LOGTW OCT     261344137677      LOG 2 BASE E          B0               LOG00088
 FLONE OCT     201400000000      1                  FLOAT POINT         LOG00089
 TWOM7 OCT     172400000000      2 TO MINUS 7       FLOAT POINT         LOG00090
 LOGE  OCT     177674557305      LOG E BASE 10      FLOAT POINT         LOG00091
  D1   OCT     -200400003000     -1/2-3*2**(-18)    FLOAT POINT         LOG00092
  D2   OCT     177525252525      1/3                FLOAT POINT         LOG00093
  C1   OCT     160416433162      DEC 1.75825662752     B2               LOG00094
  C2   OCT     047602722370      DEC 0.155295647459    B0               LOG00095
  C3   OCT     -031150254334     DEC -1.57523642316    B4               LOG00096
  C4   OCT     -131343172721     DEC -1.39755981619    B2               LOG00097
       SPACE                                                            LOG00098
 FLAG  PZE                                                              LOG00099
 CHAR  BSS     1                                                        LOG00100
  Z    BSS     1                                                        LOG00101
  SQ   BSS     1                                                        LOG00102
 BUFF  BSS     1                                                        LOG00103
       END                                                              LOG00104
