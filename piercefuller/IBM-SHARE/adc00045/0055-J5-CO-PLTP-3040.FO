       DEC     -.5,-.4,-.5,.4,.1,-.1,.5,.4,.5,-.4                  510 3PT  0041
       DEC     -.5,.4,-.5,-.4,.1,.4,.5,.4,.5,-.4                   500 2PT  0042
       DEC     0.,.4,0.,-.4                      LARGE CHARACTERS  490H3PT  0043
       DEC     -.5,.4,-.5,-.4,.5,.4,.5,-.4                         486 ZPT  0044
       DEC     .5,.4,0.,0.,-.5,0.,0.,0.,.5,-.4                     478 YPT  0045
