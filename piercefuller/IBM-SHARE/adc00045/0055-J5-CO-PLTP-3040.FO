*     LIST8                                                             PLOT0010
*     LABEL                                                             PLOT0011
CPLOTIT - REVISED PLOT SUBROUTINE FOR ROUTINE PLOTS                     PLOT0012
      SUBROUTINE PLOTIT (NOGRA, IPLTSW, GRAY, NOVA, FRXO, XDEL, XMA,    PLOT0013
     1                  XMI, YMA, YMI, LOCBCD)                          PLOT0014
      DIMENSION GRAY(100), LOCBCD(17), VAR(3), LBL(6)                   PLOT0015
C     ******************************************************************PLOT0016
C     *                                                                *PLOT0017
C     *  BCD ORDINATE LABEL IS COMPOSED OF FIRST 5 WORDS OF THE 17     *PLOT0018
C     *  WORD LOCBCD ARRAY. REMAINING 12 WORDS (6 - 17) ARE UTILIZED   *PLOT0019
C     *  FOR THE ABSCISSA LABEL.                                       *PLOT0020
C     *                                                                *PLOT0021
C     ******************************************************************PLOT0022
      NOVAL = NOVA                                                      PLOT0023
      FRSTX = FRXO                                                      PLOT0024
      XINC =  XDEL                                                      PLOT0025
      GRAY1 = GRAY(1)                                                   PLOT0026
      IF(NOGRA )10,15,10                                                PLOT0027
   10 WRITE OUTPUT TAPE 10, 11, ( LOCBCD(N), N = 1, 12)                 PLOT0028
   11 FORMAT(28H PLOTIT TAPE - DMAX = 0.125 , 4X,12A6 )                 PLOT0029
      CALL PLTPT (.125,.125,14)                                         PLOT0030
      CALL PLTPT(0.,0.,4)                                               PLOT0031
      CALL PLTPT(333.,333.,2)                                           PLOT0032
      CALL PLTPT ( 0., 0., 3 )                                          PLOT0033
      SIZ = 1.0                                                         PLOT0034
      HI =  0.125                                                       PLOT0035
      IGCNT=NOGRA                                                       PLOT0036
      INDG=1                                                            PLOT0037
      GO TO 16                                                          PLOT0038
   15 IF(IPLTSW)16,600,16                                               PLOT0039
C                                         IF NOGRA AND/OR IPLTSW ARE NONPLOT0040
C                                         ZERO TRANSFER TO 16 OCCURS FORPLOT0041
C                                         INITILIZATION OF GRAPH SCALES.PLOT0042
   16 XMAX = XMA                                                        PLOT0043
      XMIN = XMI                                                        PLOT0044
      YMAX = YMA                                                        PLOT0045
      YMIN = YMI                                                        PLOT0046
      IF (XINC)        40, 20, 40                                       PLOT0047
C                                         ARRAY (GRAY) IS ASSUMED TO BE PLOT0048
C                                         Y ONLY IF -XINC- IS NON-ZERO. PLOT0049
   20 KINC = 2                                                          PLOT0050
      IF (XMAX- XMIN) 26, 22, 26                                        PLOT0051
   22 XMAX = GRAY1                                                      PLOT0052
      XMIN = XMAX                                                       PLOT0053
      DO 24  I = 3,NOVAL,2                                              PLOT0054
      XMAX = MAX1F(XMAX,GRAY(I))                                        PLOT0055
   24 XMIN = MIN1F(XMIN,GRAY(I))                                        PLOT0056
   26 IF( YMAX - YMIN) 32, 28, 32                                       PLOT0057
   28 YMAX = GRAY(KINC)                                                 PLOT0058
      YMIN = YMAX                                                       PLOT0059
   29 DO  30 I = 2,NOVAL,KINC                                           PLOT0060
      YMAX = MAX1F(YMAX, GRAY(I))                                       PLOT0061
   30 YMIN = MIN1F(YMIN, GRAY(I))                                       PLOT0062
      GO TO 32                                                          PLOT0063
   40 KINC = 1                                                          PLOT0064
      IF ( XMAX - XMIN ) 26, 42, 26                                     PLOT0065
   42 XMAX=FRSTX+XDEL*FLOATF(NOVAL-1)                                   PLOT0066
      XMIN = FRSTX                                                      PLOT0067
      GO TO 26                                                          PLOT0068
   32 DELX = XMAX - XMIN                                                PLOT0069
      DELY=YMAX-YMIN                                                    PLOT0070
      IF(IGCNT-5)330,210,210                                            PLOT0071
  330 IF(IGCNT-2)370,360,340                                            PLOT0072
  370 XDIM=28.                                                          PLOT0073
      YDIM=26.                                                          PLOT0074
      SIZ = 0.0                                                         PLOT0075
      HI = 0.25                                                         PLOT0076
  240 XORG=-14.                                                         PLOT0077
  242 YORG = - 13.                                                      PLOT0078
      GO TO 380                                                         PLOT0079
  210 XDIM=13.                                                          PLOT0080
      YDIM=5.                                                           PLOT0081
      IF(INDG-5)270,220,230                                             PLOT0082
  270 IF(INDG-2)290,280,300                                             PLOT0083
  290 XORG=-14.                                                         PLOT0084
      GO TO 282                                                         PLOT0085
  220 XORG = -14                                                        PLOT0086
  222 YORG = - 6.                                                       PLOT0087
      GO TO 380                                                         PLOT0088
  230 IF(INDG-7)260,240,250                                             PLOT0089
  260 XORG=1.                                                           PLOT0090
      GO TO 222                                                         PLOT0091
  300 IF(INDG-3)320,310,320                                             PLOT0092
  320 XORG=1.                                                           PLOT0093
      GO TO 312                                                         PLOT0094
  340 XDIM=13.                                                          PLOT0095
      YDIM=13.                                                          PLOT0096
      IF(INDG-2)310,320,350                                             PLOT0097
  310 XORG=-14.                                                         PLOT0098
  312 YORG = 1.                                                         PLOT0099
      GO TO 380                                                         PLOT0100
  350 IF(INDG-3)250,240,250                                             PLOT0101
  250 XORG=1.                                                           PLOT0102
      GO TO 242                                                         PLOT0103
  360 XDIM=28.                                                          PLOT0104
      YDIM=13.                                                          PLOT0105
      SIZ = 0.0                                                         PLOT0106
      HI = 0.25                                                         PLOT0107
      IF(INDG-2)310,240,310                                             PLOT0108
C                                         SET BOARD PARALLAX.           PLOT0109
  280 XORG=1.                                                           PLOT0110
  282 YORG = 8.                                                         PLOT0111
  380 CALL PLTPT (0,0,18)                                               PLOT0112
      CALL PLTPT( XORG, YORG, 4 )                                       PLOT0113
C                                         DRAW X AND Y AXIS.            PLOT0114
      CALL PLTPT ( 0.   , YDIM , -8  )                                  PLOT0115
      CALL PLTPT ( 0.   , 0.   ,-11  )                                  PLOT0116
      CALL PLTPT ( XDIM , 0.0  ,-11  )                                  PLOT0117
      LINE = 0                                                          PLOT0118
      INDG = INDG + 1                                                   PLOT0119
      HSC = DELX/XDIM                                                   PLOT0120
      VSC = DELY/YDIM                                                   PLOT0121
      XLOC =  XDIM + 0.5                                                PLOT0122
      NDIM = XDIM + XDIM                                                PLOT0123
C                                         CONSTRUCT TICKS ALONG AXIS    PLOT0124
      DO 390 N = 1, NDIM                                                PLOT0125
      XLOC =  XLOC - 0.5                                                PLOT0126
      CALL PLTPT( XLOC,0.0625,-17 )                                     PLOT0127
  390 CALL PLTPT( XLOC,0.0,-6 )                                         PLOT0128
      YLOC =0.0                                                         PLOT0129
      NDIM = YDIM + YDIM                                                PLOT0130
      DO 400 N = 1, NDIM                                                PLOT0131
      YLOC = YLOC + 0.5                                                 PLOT0132
      CALL PLTPT(0.0625,YLOC,-17)                                       PLOT0133
  400 CALL PLTPT(0.0,YLOC,-6 )                                          PLOT0134
      CALL WDPLT( 0, -1, 1., 1., 0.0, SIZ )                             PLOT0135
C                                         WRITE Y LABEL FROM LOCBCD(1-5)PLOT0136
      CALL WDPLT ( LOCBCD, 5, -0.6, 0.25, HI, 90.0 )                    PLOT0137
C                                         WRITE X LABEL FROM LOCBCD(6-17PLOT0138
      CALL WDPLT ( LOCBCD(6), 12, 1.0, -0.7, HI, 0.0 )                  PLOT0139
      N = 1                                                             PLOT0140
      VAR(1) = XMIN                                                     PLOT0141
      VAR(2) = HSC / 2.0                                                PLOT0142
      VAR(3) = XMAX                                                     PLOT0143
  401 CALL CITE ( VAR(1), LBL(1), 7H(G11.4))                            PLOT0144
      CALL CITE( VAR(2), LBL(3), 11H(1H(,G11.4) )                       PLOT0145
      CALL CITE( VAR(3), LBL(5),11H(1H),G11.4) )                        PLOT0146
      GO TO ( 402,403) , N                                              PLOT0147
  402 CALL WDPLT( 0, -1, 1., 1., 0.0, 1.0 )                             PLOT0148
C                                         WRITE X SCALES                PLOT0149
      CALL WDPLT ( LBL(1), 6, 3.0, -0.2, 0.09, 0.0 )                    PLOT0150
      VAR(1) = YMIN                                                     PLOT0151
      VAR(2) = VSC / 2.0                                                PLOT0152
      VAR(3) = YMAX                                                     PLOT0153
      N = 2                                                             PLOT0154
      GO TO 401                                                         PLOT0155
C                                         WRITE Y SCALES                PLOT0156
  403 CALL WDPLT  ( LBL(1) , 6, -0.2, 0.75, 0.09, 90.0 )                PLOT0157
      CALL PLTPT (HSC,VSC,13)                                           PLOT0158
  600 LINE = LINE + 1                                                   PLOT0159
      IF (  XMODF ( LINE, 3 ) - 1 )      639, 603, 628                  PLOT0160
  603 NTYPE = 11                                                        PLOT0161
      GO TO 631                                                         PLOT0162
  628 NTYPE = 19                                                        PLOT0163
      GO TO 631                                                         PLOT0164
  639 NTYPE = 20                                                        PLOT0165
  631 YPLOT = GRAY(KINC)- YMIN                                          PLOT0166
      GO TO ( 633, 635 ), KINC                                          PLOT0167
  633 XPLOT = FRSTX - XMIN                                              PLOT0168
      GO TO 637                                                         PLOT0169
  635 XPLOT = GRAY1   - XMIN                                            PLOT0170
  637 CALL PLTPT( XPLOT, YPLOT, 8 )                                     PLOT0171
      LEFT = KINC + KINC                                                PLOT0172
      DO 670  N = LEFT, NOVAL , KINC                                    PLOT0173
      YPLOT = GRAY(N) - YMIN                                            PLOT0174
      GO TO ( 700, 701), KINC                                           PLOT0175
C                                         CALCULATE X IF KINC = 1       PLOT0176
  700 XPLOT = XPLOT + XINC                                              PLOT0177
      GO TO 670                                                         PLOT0178
C                                         SEARCH FOR X IF KINC = 2      PLOT0179
  701 XPLOT = GRAY(N-1) - XMIN                                          PLOT0180
  670 CALL PLTPT( XPLOT, YPLOT, NTYPE )                                 PLOT0181
      CALL PLTPT (0., 0., 12 )                                          PLOT0182
      RETURN                                                            PLOT0183
      END                                                               PLOT0184
