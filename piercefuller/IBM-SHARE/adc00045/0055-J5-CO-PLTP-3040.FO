*     LABEL                                                             WDPL0011
*     LIST8                                                             WDPL0012
CF020D   WDPLT   PLOT LINE OF ALPHA NUMERIC CHARACTERS  HEAT   EXP RSCH WDPL0010
C                                                                       WDPL0013
      SUBROUTINE WDPLT (ARRAY,M,VAR1,VAR2,VAR3,VAR4)                    WDPL0014
C                                                                       WDPL0015
      DIMENSION  ARRAY(50),JCH(6),LCH(200),LTAB(300),PT(1000)           WDPL0016
C                                                                       WDPL0017
C                                                                       WDPL0018
C    TO  INITIALIZE WDPLT                                               WDPL0019
C                                                                       WDPL0020
C         ARRAY = 0                                                     WDPL0021
C                                                                       WDPL0022
C           M   = -1                                                    WDPL0023
C         VAR1  = 0  --- BEGIN LINE WITH START NEW CURVE COM TO FIRST CHWDPL0024
C               = 1  --- BEGIN LINE WITH PEN UP COM TO FIRST CHARACTER  WDPL0025
C                                                                       WDPL0026
C         VAR2  = 0  --- NO INTERPOLATION                               WDPL0027
C               = 1  --- INTERPOLATE AT MAX POINT D9SP SET IN PLTPT     WDPL0028
C                                                                       WDPL0029
C         VAR3  = 0  --- CORRECT SPACE FOR CHARACTERS I OR ONE          WDPL0030
C               = 1  --- NO SPACE CORRECTION FOR I OR ONE               WDPL0031
C                                                                       WDPL0032
C         VAR4  = 0  --- LARGE CHARACTERS                               WDPL0033
C               = 1  --- SMALL CHARACTERS                               WDPL0034
C                                                                       WDPL0035
C                                                                       WDPL0036
C    TO  PLOT BCD WORDS                                                 WDPL0037
C                                                                       WDPL0038
C         ARRAY = FIRST WORD OF BCD INFORMATION TO BE PLOTTED           WDPL0039
C                                                                       WDPL0040
C           M   = NUMBER OF BCD WORDS TO PLOT                           WDPL0041
C               = 0  --- PLOT ONLY FIRST CHARACTER OF BCD WORD          WDPL0042
C                                                                       WDPL0043
C         VAR1  = X COORDINATE IN INCHES FOR CENTER OF FIRST CHARACTER  WDPL0044
C                                                                       WDPL0045
C         VAR2  = Y COORDINATE IN INCHES FOR CENTER OF FIRST CHARACTER  WDPL0046
C                                                                       WDPL0047
C         VAR3  = SIZE OF CHARACTERS IN INCHES                          WDPL0048
C                                                                       WDPL0049
C         VAR4  = ANGLE OF ROTATION IN DEGREES FOR THE LINE             WDPL0050
C                                                                       WDPL0051
C                                                                       WDPL0052
C                                                                       WDPL0053
C                                                                       WDPL0054
C    BEGINNING OF PROGRAM                                               WDPL0055
C                                                                       WDPL0056
C                                                                       WDPL0057
C                         INITIALIZE OR OUTPUT PLOT CHARACTERS          WDPL0058
      IF(M)10,20,21                                                     WDPL0059
C                         INITIALIZE FOLLOWING                          WDPL0060
   10 IF(VAR1) 11,11,12                                                 WDPL0061
C                         FIRST COM IS START NEW CURVE                  WDPL0062
   11    LBR3 = 1                                                       WDPL0063
C                                                                       WDPL0064
      GO TO 13                                                          WDPL0065
C                         FIRST COM IS PEN UP AND REPEAT FIRST PT       WDPL0066
   12    LBR3 = 2                                                       WDPL0067
C                                                                       WDPL0068
   13 IF (VAR2) 14,14,15                                                WDPL0069
C                         NO INTERPOLATION BETWEEN PTS                  WDPL0070
   14    LBR2 = 4                                                       WDPL0071
         LBR4 = 3                                                       WDPL0072
C                                                                       WDPL0073
      GO TO 16                                                          WDPL0074
C                         INTERPOLATE AT MAX LENGTH DISPLACEMENT        WDPL0075
   15    LBR2 = 5                                                       WDPL0076
         LBR4 = 2                                                       WDPL0077
C                         SET SPACE CORRECTION FOR I OR ONE             WDPL0078
   16    CRIJ = VAR3                                                    WDPL0079
C                                                                       WDPL0080
      IF (VAR4) 17,17,18                                                WDPL0081
C                         PLOT LARGE CHARACTER LINE SEGMENTS            WDPL0082
   17    LSNO = 0                                                       WDPL0083
C                                                                       WDPL0084
      GO TO 19                                                          WDPL0085
C                         PLOT SMALL CHARACTER LINE SEGMENTS            WDPL0086
   18    LSNO = 100                                                     WDPL0087
C                                                                       WDPL0088
   19 RETURN                                                            WDPL0089
C                             SET MODE TO PLOT ONLY FIRST CHARACTER     WDPL0090
   20    NLIM = 1                                                       WDPL0091
         NWD  = 1                                                       WDPL0092
C                                                                       WDPL0093
      GO TO 22                                                          WDPL0094
C                             SET MODE TO PLOT ENTIRE WORD              WDPL0095
   21    NLIM = 6                                                       WDPL0096
         NWD  = M                                                       WDPL0097
C                             INTIALIZE CONSTANTS TO POSITION ORIGIN    WDPL0098
   22    ROT  = VAR4                                                    WDPL0099
         SZE  = VAR3                                                    WDPL0100
         CSR  = COSF(ROT * .0174532925)                                 WDPL0101
         SNR  = SINF(ROT * .0174532925)                                 WDPL0102
         CCC  = SZE * CSR                                               WDPL0103
         CCS  = SZE * SNR                                               WDPL0104
        CCC25 = .250 * CCC                                              WDPL0105
        CCS25 = .250 * CCS                                              WDPL0106
        CCC75 = .750 * CCC                                              WDPL0107
        CCS75 = .750 * CCS                                              WDPL0108
        CC125 =1.250 * CCC                                              WDPL0109
        CS125 =1.250 * CCS                                              WDPL0110
C                                                                       WDPL0111
      IF (SZE - .260) 23,23,24                                          WDPL0112
C                             SHIFT ORIGIN OF CHARACTER BY 1.25 OF SIZE WDPL0113
   23   DSPX1 = 0.                                                      WDPL0114
        DSPY1 = 0.                                                      WDPL0115
        DSPX2 = CCC                                                     WDPL0116
        DSPY2 = CCS                                                     WDPL0117
        DSPX3 = CC125                                                   WDPL0118
        DSPY3 = CS125                                                   WDPL0119
C                                                                       WDPL0120
      GO TO 25                                                          WDPL0121
C                             SHIFT ORIGIN BY SIZE OF THE CHARACTER     WDPL0122
   24   DSPX1 = CCC25                                                   WDPL0123
        DSPY1 = CCS25                                                   WDPL0124
        DSPX2 = CCC75                                                   WDPL0125
        DSPY2 = CCS75                                                   WDPL0126
        DSPX3 = CCC                                                     WDPL0127
        DSPY3 = CCS                                                     WDPL0128
C                                                                       WDPL0129
   25    CPX  = VAR1                                                    WDPL0130
         CPY  = VAR2                                                    WDPL0131
C                                                                       WDPL0132
C                              OUTPUT NUMBER OF BCD WORDS               WDPL0133
      DO 46 I = 1,NWD                                                   WDPL0134
C                              SPLIT BCD WD INTO 6 WITH CHARC IN DECR   WDPL0135
      CALL SPTZZ (ARRAY(I),JCH)                                         WDPL0136
C                                                                       WDPL0137
C                              OUTPUT EACH WORD                         WDPL0138
      DO 46 J = 1,NLIM                                                  WDPL0139
C                              INTIALIZE WHERE N IS LOC OF CONS FOR LNESWDPL0140
         LBR1 = LBR3                                                    WDPL0141
         N    = JCH(J) + LSNO                                           WDPL0142
         N    = LCH(N+1)                                                WDPL0143
C                              IS CHARACTER IN TABLES                   WDPL0144
      IF (N) 26, 44,26                                                  WDPL0145
C                              CHECK MODE FOR I OR ONE SPACE CORRECTION WDPL0146
   26 IF (CRIJ) 30,27,30                                                WDPL0147
C                              IS CHARACTER I OR ONE                    WDPL0148
   27 IF (JCH(J)-1) 28,29,28                                            WDPL0149
   28 IF (JCH(J)-25)30,29,30                                            WDPL0150
C                              CORRECT ORIGIN FOR I OR ONE              WDPL0151
   29    CPX  = CPX - DSPX1                                             WDPL0152
         CPY  = CPY - DSPY1                                             WDPL0153
C                              SET NO OF START NEW LINES FOR CHARACTER  WDPL0154
   30    KLIM = LTAB(N)                                                 WDPL0155
C                                                                       WDPL0156
C                              OUTPUT ONE CHARACTER                     WDPL0157
      DO 40 K = 1,KLIM                                                  WDPL0158
C                              SET START AND END POINT FOR PLT POINTS   WDPL0159
         LBR = LBR1                                                     WDPL0160
         LIND = LTAB(N+1)                                               WDPL0161
         LPT  = LTAB(N+2)                                               WDPL0162
         N    = N + 2                                                   WDPL0163
C                                                                       WDPL0164
C                              OUTPUT POINTS FOR ONE CONTINOUS LINE     WDPL0165
      DO 40 L = LIND,LPT,2                                              WDPL0166
C                              SCALE POINTS FOR SIZE OF CHARACTER       WDPL0167
         XCH  = PT(L) * SZE                                             WDPL0168
         YCH  = PT(L+1) * SZE                                           WDPL0169
C                                                                       WDPL0170
      IF (ROT) 31, 32,31                                                WDPL0171
C                                             ROTATE CHARACTER          WDPL0172
   31    X2   = CPX + XCH * CSR - YCH * SNR                             WDPL0173
         Y2   = CPY + XCH * SNR + YCH * CSR                             WDPL0174
      GO TO 33                                                          WDPL0175
C                                             SET POINT TO PLOT         WDPL0176
   32    X2   = CPX + XCH                                               WDPL0177
         Y2   = CPY + YCH                                               WDPL0178
C                               BRANCH TO SET PLOT COMMANDS             WDPL0179
C                                                                       WDPL0180
   33 GO TO (34,35,37,47,48,38,39),LBR                                  WDPL0181
C                               START NEW CURVE                         WDPL0182
   34    LC   = -8                                                      WDPL0183
         LBR1 = 3                                                       WDPL0184
         LBR3 = 2                                                       WDPL0185
      IF (LBR2-4) 49,49,50                                              WDPL0186
C                               INTERPOLATE WITH PEN UP                 WDPL0187
   35    LC   =-17                                                      WDPL0188
   36    LBR1 = LBR4                                                    WDPL0189
         LBR  = LBR2                                                    WDPL0190
C                                                                       WDPL0191
      GO TO 40                                                          WDPL0192
C                               INSERT PEN UP                           WDPL0193
   37    LC   = -7                                                      WDPL0194
C                                                                       WDPL0195
         LBR = LBR2                                                     WDPL0196
      GO TO 40                                                          WDPL0197
C                               INSERT PEN DOWN COM                     WDPL0198
   47    LC   = -6                                                      WDPL0199
   49    LBR  =  6                                                      WDPL0200
C                                                                       WDPL0201
      GO TO 40                                                          WDPL0202
C                               INTERPOLATE WITH PEN DOWN               WDPL0203
   48    LC   =-16                                                      WDPL0204
   50    LBR  =  7                                                      WDPL0205
C                                                                       WDPL0206
      GO TO 40                                                          WDPL0207
C                               OUTPUT THE POINT                        WDPL0208
   38    LC   = -1                                                      WDPL0209
C                                                                       WDPL0210
      GO TO 40                                                          WDPL0211
C                               INTERPOLATE TO THE POINT AT MAX DISPLC  WDPL0212
   39    LC   =-11                                                      WDPL0213
C                               OUTPUT POINT TO PLOT TAPE               WDPL0214
   40 CALL PLTPT (X2,Y2,LC)                                             WDPL0215
C                             CHECK MODE FOR I OR ONE SPACE CORR        WDPL0216
      IF (CRIJ) 44,41,44                                                WDPL0217
C                             CHARACTER I OR ONE                        WDPL0218
   41 IF (JCH(J)-1) 42,43,42                                            WDPL0219
C                                                                       WDPL0220
   42 IF (JCH(J)-25)44,43,44                                            WDPL0221
C                             ORGIN SHIFT FOR I OR ONE                  WDPL0222
   43   DSPX4 = DSPX2                                                   WDPL0223
        DSPY4 = DSPY2                                                   WDPL0224
      GO TO 45                                                          WDPL0225
C                             ORGIN SHIFT FOR ALL CHARACTERS            WDPL0226
   44   DSPX4 = DSPX3                                                   WDPL0227
        DSPY4 = DSPY3                                                   WDPL0228
C                             SET ORGIN FOR NEXT CHARACTER              WDPL0229
   45    CPX  = CPX + DSPX4                                             WDPL0230
         CPY  = CPY + DSPY4                                             WDPL0231
C                                                                       WDPL0232
   46 CONTINUE                                                          WDPL0233
C                                                                       WDPL0234
      RETURN                                                            WDPL0235
C                                                                       WDPL0236
C     LAST STATEMENT NUMBER USED IS 48                                  WDPL0237
C                                                                       WDPL0238
      END                                                               WDPL0239
