*      FAP                                                              PCV00010
       LBL     PCV,X                                                    PCV00020
       ENTRY   PCV                                                      PCV00030
PCV    SXA     X4,4                                                     PCV00040
       CLA     1,4                                                      PCV00050
       STA     X1            LOC OF X                                   PCV00060
       CLA     2,4                                                      PCV00070
       STA     Y1            LOC OF Y                                   PCV00080
       CLA     3,4                                                      PCV00090
       STA     COM1S         LOC OF COM1                                PCV00100
       CLA     4,4                                                      PCV00110
       STA     COM2S         LOC OF COM2                                PCV00120
       CLA     5,4                                                      PCV00130
       STA     CLX                                                      PCV00140
       STA     STOX                                                     PCV00150
       CLA     6,4                                                      PCV00160
       STA     CLY                                                      PCV00170
       STA     STOY                                                     PCV00180
       STZ     XBCD                                                     PCV00190
COM1S  CLA     **                                                       PCV00200
       ARS     18                                                       PCV00210
       ORS     XBCD                                                     PCV00220
       STZ     YBCD                                                     PCV00230
COM2S  CLA     **                                                       PCV00240
       ARS     18                                                       PCV00250
       ORS     YBCD                                                     PCV00260
X1     CLA     **                                                       PCV00270
       LRS     53                                                       PCV00280
       TPL     PLX                                                      PCV00290
       CAL     MINUS                                                    PCV00300
       ORS     XBCD                                                     PCV00310
       TRA     HERE                                                     PCV00320
PLX    CAL     PLUS                                                     PCV00330
       ORS     XBCD                                                     PCV00340
HERE   PXD     0,0                                                      PCV00350
       TSX     $COMB,4                                                  PCV00360
CLX    STZ     **                                                       PCV00370
       ORA     XBCD                                                     PCV00380
STOX   ORS     **                                                       PCV00390
Y1     CLA     **                                                       PCV00400
       LRS     53                                                       PCV00410
       TPL     PLY                                                      PCV00420
       CAL     MINUS                                                    PCV00430
       ORS     YBCD                                                     PCV00440
       TRA     THERE                                                    PCV00450
PLY    CAL     PLUS                                                     PCV00460
       ORS     YBCD                                                     PCV00470
THERE  PXD     0,0                                                      PCV00480
       TSX     $COMB,4                                                  PCV00490
CLY    STZ     **                                                       PCV00500
       ORA     YBCD                                                     PCV00510
STOY   ORS     **                                                       PCV00520
X4     AXT     **,4                                                     PCV00530
       TRA     7,4                                                      PCV00540
XBCD   PZE     0                                                        PCV00550
YBCD   PZE     0                                                        PCV00560
MINUS  OCT     400000000000                                             PCV00570
PLUS   OCT     200000000000                                             PCV00580
       END                                                              PCV00590
*      FAP                                                              CONB0010
       LBL     CONB,X                                                   CONB0020
       ENTRY   CONB                                                     CONB0030
CONB   SXA     STR4,4                                                   CONB0040
       AXT     24,4                                                     CONB0050
       STZ     BCD           ZERO TO BCD WORD                           CONB0060
PT1    PXD     0,0                                                      CONB0070
       DVP     DTEN                                                     CONB0080
       ALS     30,4                                                     CONB0090
       ORS     BCD                                                      CONB0100
PT2    TIX     PT1,4,6                                                  CONB0110
       CAL     BCD                                                      CONB0120
STR4   AXT     **,4                                                     CONB0130
       TRA     1,4                                                      CONB0140
DTEN   PZE     10                                                       CONB0150
BCD    PZE     0                                                        CONB0160
       END                                                              CONB0170
*     LIST8                                                             PLTP0010
*     LABEL                                                             PLTP0011
      SUBROUTINE PLTPT (XD,YD,L)                                        PLTP0012
C                                                                       PLTP0013
C       *******************************************************         PLTP0014
C       *  PLTPT GENERATES A HIGH DENSITY, BCD MODE, BLOCKED  *         PLTP0015
C       *  OUTPUT PLOTTER TAPE. OUTPUT IS THROUGH TWO 400     *         PLTP0016
C       *  WORD BLOCKS WITH OVERLAY FEATURES AND WRITTEN BY   *         PLTP0017
C       *  THE SUBROUTINE PLTWRO. MAXIMUM RECORD SIZE IS 400  *         PLTP0018
C       *  WORDS, MINIMUM RECORD SIZE IS 4 WORDS............  *         PLTP0019
C       *******************************************************         PLTP0020
C                                                                       PLTP0021
      DIMENSION PLTAB(800)                                              PLTP0022
      DISTF( XX,YY) = SQRTF((X2-XX)**2 + (Y2-YY)**2 )                   PLTP0023
         X2   = XD                                                      PLTP0024
         Y2   = YD                                                      PLTP0025
      ASSIGN 109 TO JBR                                                 PLTP0026
      ASSIGN 1108 TO JBR1                                               PLTP0027
      IF ( IT )               270, 270, 272                             PLTP0028
  270 IT = 400                                                          PLTP0029
      ASSIGN 280 TO  NBUFFR                                             PLTP0030
  272 IF ( L )                111, 110, 112                             PLTP0031
C            L IS EQUAL TO ZERO -- PREPARE DUMMY RECORD                 PLTP0032
  110 KXC = 0                                                           PLTP0033
      KYC = 0                                                           PLTP0034
      X1 = X2                                                           PLTP0035
      Y1 = Y2                                                           PLTP0036
      ASSIGN 170 TO JBR                                                 PLTP0037
      GO TO 113                                                         PLTP0038
C           L IS POSITIVE --- CONVERT POINT TO INCHES                   PLTP0039
  112    X2   = X2/HSC                                                  PLTP0040
         Y2   = Y2/VSC                                                  PLTP0041
C           L IS NEGATIVE ---  POINT IS INCHES                          PLTP0042
  111    LF   = XABSF (L)                                               PLTP0043
C                         PERFORM INDICATED FUNCTION                    PLTP0044
      IF ( LF - 19 )           203, 518, 516                            PLTP0045
  203 ASSIGN 202 TO LDASH                                               PLTP0046
      DSEG = 0.0                                                        PLTP0047
  518  ASSIGN 515 TO NABLE                                              PLTP0048
      GO TO 200                                                         PLTP0049
  516 LF = 19                                                           PLTP0050
      ASSIGN 509 TO NABLE                                               PLTP0051
  200 GO TO ( 1, 2, 3, 4, 109, 6, 7, 8, 109, 10, 11, 12, 13, 14, 15,    PLTP0052
     1 16, 17, 18, 19, 19, 109              ),  LF                      PLTP0053
C              L = 1     ---   PREPARE BCD PLOT WORDS FOR COORDINATES   PLTP0054
C              L = 2     ---   INITIALIZE X AND YCNTS(INCHES)--SET SCALEPLTP0055
C              L = 3     ---   SET DATA PARALLAX                        PLTP0056
C              L = 4     ---   SET BOARD PARALLAX                       PLTP0057
C              L = 5     ---                                            PLTP0058
C              L = 6     ---  INSERT PEN DOWN BEFORE PLOT RECORD        PLTP0059
C              L = 7     ---  INSERT PEN  UP  BEFORE PLOT RECORD        PLTP0060
C              L = 8     ---  INSERT START NEW CURVE BEFORE PLOT RECORD PLTP0061
C              L = 9                                                    PLTP0062
C              L =10     ---  SET L EQUAL TO NRECS                      PLTP0063
C              L =11     ---  INTERPOLATE AT DMAX AND PREPARE PLOT RECS PLTP0064
C              L =12     ---  DUMP PLTAB                                PLTP0065
C              L =13     ---  INTIALIZE HSCALE AND VSCALE               PLTP0066
C              L =14     ---  INTIALIZE DMAX                            PLTP0067
C              L =15     ---  REPEAT LAST POINT XD TIMES                PLTP0068
C              L =16     ---  INSERT PEN DOWN BEFORE INTERPOLATE AT DMAXPLTP0069
C              L =17     ---   INSERT PEN UP AND REPEAT POINT ACCORDING PLTP0070
C                                TO DISTANCE TO THIS POINT              PLTP0071
C              L =18     ---   PEN UP COMMAND ONLY                      PLTP0072
C              L =19     ---  CONSTRUCT LINE DASHED AT DMAX INTERVALS   PLTP0073
C              L =20     ---  CONSTRUCT DOT-DASH LINE AT DMAX INTERVALS PLTP0074
   11 IF(DMAX)  121,121,141                                             PLTP0075
  141 DST = DISTF( XIN, YIN )                                           PLTP0076
C                                                                       PLTP0077
      IF ( DMAX-DST)       129, 505 , 126                               PLTP0078
  129 IF (43. - DST) 130, 101, 101                                      PLTP0079
C                                ERROR --- POINT DISP GREATER THAN 30   PLTP0080
  130 WRITE OUTPUT TAPE 6, 131, XIN, YIN, X2, Y2,  HSC, VSC             PLTP0081
  131 FORMAT(36H1PLOT DATA ERROR - EXECUTION DELETED///18H0LAST VALUES OPLTP0082
     1F X=F10.2,3H Y=F10.2,/17H0NEW VALUES OF X=F10.2,3H Y=F10.2,/21H0SCPLTP0083
     2ALE FACTORS  HOR =E14.7, 6H VER =E14.7)                           PLTP0084
      CALL PDUMP ( PLTAB, PLTAB(800), 0, IT, NRECS, 2 )                 PLTP0085
      CALL EXIT                                                         PLTP0086
C                                                                       PLTP0087
  101   DMPD  = DMAX / DST                                              PLTP0088
      X = ( X2 - XIN ) * DMPD * XCNTS                                   PLTP0089
      Y = ( Y2 - YIN ) * DMPD * YCNTS                                   PLTP0090
      ASSIGN 103 TO JBR                                                 PLTP0091
  102     X1  = X1 + X                                                  PLTP0092
          Y1  = Y1 + Y                                                  PLTP0093
      IF ( LF - 19 )           104, 209, 104                            PLTP0094
  209 ASSIGN 230 TO JBR                                                 PLTP0095
      GO TO 104                                                         PLTP0096
C                                                                       PLTP0097
  103   DST   = DST - DMAX                                              PLTP0098
      IF ( DMAX - DST )        102, 505, 126                            PLTP0099
  505 IF ( LF - 19 )           121, 506, 121                            PLTP0100
  121 ASSIGN 109 TO JBR                                                 PLTP0101
      GO TO 1                                                           PLTP0102
  503 ASSIGN  109 TO JBR                                                PLTP0103
      GO TO 231                                                         PLTP0104
  506 ASSIGN 503 TO JBR                                                 PLTP0105
C                                                                       PLTP0106
    1    X1   = X2 * XCNTS                                              PLTP0107
         Y1   = Y2 * YCNTS                                              PLTP0108
C                                                                       PLTP0109
  104 GO TO NABLE, ( 509, 515 )                                         PLTP0110
C                                                                       PLTP0111
C                                                 INSTRUCTIONS STARTING PLTP0112
C                                                 AT 509 INSERT INTER-  PLTP0113
C                                                 MEDIATE DOT IN BLANK  PLTP0114
C                                                 SPACE FOR L = 20.     PLTP0115
C                                                                       PLTP0116
  509 IF ( KL - 7 )            515, 510, 515                            PLTP0117
  510 XB = X1                                                           PLTP0118
      YB = Y1                                                           PLTP0119
      X1 = ( XB + XL * XCNTS ) / 2.0                                    PLTP0120
      Y1 = ( YB + YL * YCNTS ) / 2.0                                    PLTP0121
      ASSIGN 511 TO JBR1                                                PLTP0122
      GO TO 515                                                         PLTP0123
  511 ASSIGN 512 TO JBR1                                                PLTP0124
      KYC = 6                                                           PLTP0125
      GO TO 507                                                         PLTP0126
  512 ASSIGN 513 TO JBR1                                                PLTP0127
  143 KYC = 7                                                           PLTP0128
      GO TO 507                                                         PLTP0129
   16 ASSIGN 201 TO LDASH                                               PLTP0130
  504 ASSIGN  11 TO JBR                                                 PLTP0131
C                                                                       PLTP0132
C                                                 ALTERNATE PEN-UP AND  PLTP0133
C                                                 PEN-DOWN COMMANDS FOR PLTP0134
C                                                 L = 19 OR 20          PLTP0135
C                                                                       PLTP0136
  231 GO TO LDASH,( 201, 202 )                                          PLTP0137
  201 KYC = 6                                                           PLTP0138
      ASSIGN 202 TO LDASH                                               PLTP0139
      GO TO 114                                                         PLTP0140
  202 KYC = 7                                                           PLTP0141
      ASSIGN 201 TO LDASH                                               PLTP0142
  114 XL = X1 / XCNTS                                                   PLTP0143
      YL = Y1 / YCNTS                                                   PLTP0144
  507 KXC  = 0                                                          PLTP0145
      KX   = 0                                                          PLTP0146
      KY   = 0                                                          PLTP0147
      GO TO 105                                                         PLTP0148
  513 ASSIGN1108 TO JBR1                                                PLTP0149
      X1 = XB                                                           PLTP0150
      Y1 = YB                                                           PLTP0151
  515 KXC = 1                                                           PLTP0152
          KYC = 1                                                       PLTP0153
  113 KX = SIGNF ( ABSF(X1)+ 0.1, X1 )                                  PLTP0154
      KY = SIGNF ( ABSF(Y1)+0.1, Y1 )                                   PLTP0155
C                                                                       PLTP0156
  105    NPT  = NPT + 2                                                 PLTP0157
      I  =  IT  + 2  - NPT                                              PLTP0158
C                                                                       PLTP0159
C                                          * SUBROUTINE PCV PACKS X AND PLTP0160
C                                          * Y COORDINATES AND PLOT COM-PLTP0161
C                                          * MANDS INTO TWO BCD WORDS   PLTP0162
C                                                                       PLTP0163
      CALL  PCV ( KX, KY, KXC, KYC, PLTAB(I), PLTAB(I-1) )              PLTP0164
C                                                                       PLTP0165
      KL = KYC                                                          PLTP0166
  520 IF(400-NPT)                   106, 106, 108                       PLTP0167
  150 ASSIGN 170 TO JBR                                                 PLTP0168
  106 NPT = MAX0F ( 4, NPT   )                                          PLTP0169
      NRECS = NRECS  + NPT                                              PLTP0170
C                                                                       PLTP0171
C                                          * SUBROUTINE PLTWRO OUTPUTS  PLTP0172
C                                          * BCD TABLE PLTAB ONTO B-5   PLTP0173
C                                          * IN RECORDS OF FROM 4 TO    PLTP0174
C                                          * 400 WORDS IN LENGTH .....  PLTP0175
C                                                                       PLTP0176
  290 CALL PLTWRO ( PLTAB(IT), NPT )                                    PLTP0177
      NPT = 0                                                           PLTP0178
      GO TO NBUFFR, ( 280, 282 )                                        PLTP0179
  280 IT = 800                                                          PLTP0180
      ASSIGN 282 TO NBUFFR                                              PLTP0181
      GO TO 2108                                                        PLTP0182
  282 IT = 400                                                          PLTP0183
      ASSIGN 280 TO NBUFFR                                              PLTP0184
B2108 PLTAB(IT-2) = 200000000000                                        PLTP0185
B     PLTAB(IT-3) = 200000000000                                        PLTP0186
  108 GO TO JBR1, ( 1108, 511, 512, 513 )                               PLTP0187
 1108 GO TO JBR,(11,103,109,121,132,133,134,146,155,170,230,503,504,18 )PLTP0188
C                                                                       PLTP0189
   10     L   = NRECS                                                   PLTP0190
        NRECS = 0                                                       PLTP0191
      GO TO 170                                                         PLTP0192
C                                                                       PLTP0193
    3     KXC = 3                                                       PLTP0194
          KYC = 3                                                       PLTP0195
      ASSIGN 170 TO JBR                                                 PLTP0196
      X1 = -XD                                                          PLTP0197
      Y1 = -YD                                                          PLTP0198
      IF (L) 301,302,302                                                PLTP0199
  301 X1 = X1 * XCNTS                                                   PLTP0200
      Y1 = Y1 * YCNTS                                                   PLTP0201
  302 IF (X1 - 8000.0) 144,144,145                                      PLTP0202
  144 IF (8000. - Y1) 145, 113, 113                                     PLTP0203
  145 ASSIGN 146 TO JBR                                                 PLTP0204
      GO TO 106                                                         PLTP0205
  146 END FILE 10                                                       PLTP0206
      WRITE OUTPUT TAPE 6,147                                           PLTP0207
  147 FORMAT(70H0DATA PARALLAX ERROR FOR PLOT TAPE---VALUE TO SET IS GREPLTP0208
  1471ATER THAN 8000//84H0PLOT TAPE HAS FILE MARK AT THIS POINT FOR SETTPLTP0209
  1472ING DATA PARALLAX MANUALLY AT PLOTTER)                            PLTP0210
      WRITE OUTPUT TAPE 10,117                                          PLTP0211
  117 FORMAT(120H0THIS FILE CONTINUES FROM PREVIOUS FILE--END OF FILE WAPLTP0212
  1171S INSERTED FOR MANUAL SETTING OF DATA PARALLAX AT THE PLOTTER    )PLTP0213
C                                                                       PLTP0214
  109    XIN  = X2                                                      PLTP0215
         YIN  = Y2                                                      PLTP0216
  170 RETURN                                                            PLTP0217
C                                                                       PLTP0218
    4     KXC = 4                                                       PLTP0219
          KYC = 4                                                       PLTP0220
      ASSIGN 170 TO JBR                                                 PLTP0221
         X1 = XD * 2.                                                   PLTP0222
         Y1 = YD * 2.                                                   PLTP0223
      GO TO 113                                                         PLTP0224
    6 KYC = 6                                                           PLTP0225
      GO TO 115                                                         PLTP0226
    7 KYC = 7                                                           PLTP0227
      GO TO 115                                                         PLTP0228
C                                                                       PLTP0229
   17 IF(MXBR) 8,8,142                                                  PLTP0230
    8     KYC = 8                                                       PLTP0231
  115 ASSIGN 121 TO JBR                                                 PLTP0232
      XL =  X2                                                          PLTP0233
      YL =  Y2                                                          PLTP0234
      GO TO 507                                                         PLTP0235
    2   XCNTS = XD                                                      PLTP0236
        YCNTS = YD                                                      PLTP0237
      KX = 5. * XCNTS + 0.1                                             PLTP0238
      KY = 5. * YCNTS + 0.1                                             PLTP0239
         KXC  = 2                                                       PLTP0240
         KYC = 2                                                        PLTP0241
      ASSIGN 170 TO JBR                                                 PLTP0242
      GO TO 105                                                         PLTP0243
C                                                                       PLTP0244
   12 IF ( NPT )               170, 170, 150                            PLTP0245
   13    HSC  = XD                                                      PLTP0246
         VSC  = YD                                                      PLTP0247
      GO TO 170                                                         PLTP0248
C                                                                       PLTP0249
   14    DMAX = XD                                                      PLTP0250
      IF (4. - DMAX) 119, 118, 118                                      PLTP0251
  119    MXBR = 6                                                       PLTP0252
      GO TO 170                                                         PLTP0253
C                                                                       PLTP0254
  118    DMDP = .13                                                     PLTP0255
         MXBR = 1                                                       PLTP0256
  128 IF (DMDP - DMAX) 120, 120, 170                                    PLTP0257
  120    DMDP = DMDP + DMDP                                             PLTP0258
         MXBR = MXBR + 1                                                PLTP0259
      GO TO 128                                                         PLTP0260
C                                                                       PLTP0261
  230 ASSIGN 103 TO JBR                                                 PLTP0262
      GO TO 231                                                         PLTP0263
   19 XNCHES =  X1 / XCNTS                                              PLTP0264
      YNCHES =  Y1 / YCNTS                                              PLTP0265
      SEG =  DISTF ( XNCHES, YNCHES )                                   PLTP0266
      DSEG = DSEG  +  SEG                                               PLTP0267
      IF ( DSEG - DMAX )  500, 502, 501                                 PLTP0268
  126 DSEG = DISTF ( X1 / XCNTS , Y1/YCNTS )                            PLTP0269
  500 IF ( KYC - 6 )      121, 121, 180                                 PLTP0270
  180 X1 =  X2 * XCNTS                                                  PLTP0271
      Y1 =  Y2 * YCNTS                                                  PLTP0272
      GO TO 170                                                         PLTP0273
  501 XIN  =  XNCHES + (X2 - XNCHES) * ( DMAX - DSEG + SEG)  / SEG      PLTP0274
      YIN  =  YNCHES + (Y2 - YNCHES) * ( DMAX - DSEG + SEG)  / SEG      PLTP0275
      DSEG  =  0.0                                                      PLTP0276
      ASSIGN 504 TO JBR                                                 PLTP0277
      X1 = XIN * XCNTS                                                  PLTP0278
      Y1 = YIN * YCNTS                                                  PLTP0279
      GO TO 104                                                         PLTP0280
  502 ASSIGN 18 TO JBR                                                  PLTP0281
      DSEG  =  0.0                                                      PLTP0282
      GO TO 1                                                           PLTP0283
C                                                                       PLTP0284
  142 DIT = DISTF(XIN, YIN )                                            PLTP0285
      IF ( DMAX - DIT )        148,   7,   7                            PLTP0286
  148 IF( DIT - 15. )         116,  8, 8                                PLTP0287
  116 ASSIGN 133 TO JBR                                                 PLTP0288
      GO TO 231                                                         PLTP0289
   18 ASSIGN 170 TO JBR                                                 PLTP0290
      GO TO 231                                                         PLTP0291
C                                                                       PLTP0292
   15 ASSIGN 155 TO JBR                                                 PLTP0293
      NTIMES = XD                                                       PLTP0294
  155 IF ( NTIMES )            170, 170, 156                            PLTP0295
  156 NTIMES = NTIMES - 1                                               PLTP0296
      GO TO 105                                                         PLTP0297
  133 ASSIGN 134 TO JBR                                                 PLTP0298
      GO TO 1                                                           PLTP0299
  134 ASSIGN 132 TO JBR                                                 PLTP0300
      GO TO (135,136,137,138,139,109),MXBR                              PLTP0301
  135 DSTDM = .1                                                        PLTP0302
      GO TO 140                                                         PLTP0303
  136 DSTDM = .5                                                        PLTP0304
      GO TO 140                                                         PLTP0305
  137 DSTDM = 2.5                                                       PLTP0306
      GO TO 140                                                         PLTP0307
  138 DSTDM = 5.                                                        PLTP0308
      GO TO 140                                                         PLTP0309
  139 DSTDM = 10.                                                       PLTP0310
      GO TO 140                                                         PLTP0311
  132 DSTDM = DSTDM + DSTDM                                             PLTP0312
  140 IF ( DIT - DSTDM)       109, 109,1                                PLTP0313
      END                                                               PLTP0314
*     FAP                                                               PLTW0010
*         PROGRAM TO BLOCK AND OVERLAY OUTPUT FROM PLTPT  USING SYSTEM  PLTW0011
*   CALLING SEQUENCE FROM PLTPT                                         PLTW0012
*   A1 TSX     PLTWRO,4       ENTER SUBROUTINE                          PLTW0013
*   A2 TSX     BLOCK          CORE LOCATION OF BUFFER                   PLTW0014
*   A3 TSX     COUNT          NO. OF OUTPUT WORDS                       PLTW0015
*   A4 ...     ....           RETURN ENTRY TO PLTPT                     PLTW0016
       COUNT   30                                                       PLTW0017
       ENTRY   PLTWRO                                                   PLTW0018
       LBL     PLTWRO,X                                                 PLTW0019
PLTWRO SXA     XR4,4         *SAVE RETURN INDEX                         PLTW0020
       CAL     L10D          *PICK UP LOGICAL TAPE UNIT                 PLTW0021
       TSX     $(IOS),4       AND INITIALIZE (IOS)                      PLTW0022
       LXA     XR4,4         *FORM DATA CHANNEL COMMAND                 PLTW0023
       CAL     1,4            WITH BUFFER                               PLTW0024
       STA     IORT           ADDRESS AND                               PLTW0025
       CLA*    2,4            COUNT                                     PLTW0026
       STD     IORT                                                     PLTW0027
       XEC*    $(WRS)        *SELECT CURRENT UNIT                       PLTW0028
       AXC     IORT,4         AND LOAD CHANNEL                          PLTW0029
       XEC*    $(RCH)                                                   PLTW0030
       PXA     ,4                                                       PLTW0031
       STA*    $(WTC)        *INITIALIZE FOR TAPE CHECKING              PLTW0032
       CAL     TES            AND SET (TES) FOR WRITE CHECKING          PLTW0033
       SLW*    $(TES)                                                   PLTW0034
XR4    AXT     **,4          *RETURN                                    PLTW0035
       TRA     3,4                                                      PLTW0036
L10D   PZE     ,,10           LOGICAL UNIT NUMBER                       PLTW0037
IORT   IORT    **,,**         CHANNEL COMMAND                           PLTW0038
TES    TSX     $(WER),4      *CHECK PREVIOUS WRITE                      PLTW0039
       END                                                              PLTW0040
*       FAP                                                             CITE0010
*CITE       CONVERT FLOATING POINT TO SPECIFIED BCD FORMAT              CITE0011
       ENTRY   CITE                                                     CITE0012
       LBL     CITE                                                     CITE0013
CITE   SXA RETURN,4                                                     CITE0014
       CLA     1,4                                                      CITE0015
       STA     WRD                                                      CITE0016
       CLA     2,4                                                      CITE0017
       STA     MOVE+1                                                   CITE0018
       SUB     ONE                                                      CITE0019
       STA     MOVE+3                                                   CITE0020
       SUB     ONE                                                      CITE0021
       STA     MOVE+5                                                   CITE0022
       CAL*    3,4                                                      CITE0023
       SLW     FMT+2                                                    CITE0024
       CLA     3,4                                                      CITE0025
       ADD     ONE                                                      CITE0026
       STA     *+3                                                      CITE0027
       ADD     ONE                                                      CITE0028
       STA     *+3                                                      CITE0029
       CAL     **                                                       CITE0030
       SLW     FMT+1                                                    CITE0031
       CAL     **                                                       CITE0032
       SLW     FMT                                                      CITE0033
       CAL     SIX                                                      CITE0034
       SXD     WS,4                                                     CITE0035
       TSX     CNVRT,4                                                  CITE0036
FRMT   PZE     FMT+2                                                    CITE0037
       LXD     WS,4                                                     CITE0038
WRD    LDQ     **                                                       CITE0039
       STR                                                              CITE0040
       CAL     WORD                                                     CITE0041
       SUB     ONE                                                      CITE0042
       TZE     *+7                                                      CITE0043
       CAL     WORD                                                     CITE0044
       TOV     *+1                                                      CITE0045
       LDQ     BLANKS                                                   CITE0046
       LGL     6                                                        CITE0047
       TNO     *-1                                                      CITE0048
XEC    XEC*    $PACK                                                    CITE0049
       CAL     C2                                                       CITE0050
       SLW     2                                                        CITE0051
MOVE   CAL     REC1                                                     CITE0052
       SLW     **                                                       CITE0053
       CAL     REC2                                                     CITE0054
       SLW     **                                                       CITE0055
       CAL     REC3                                                     CITE0056
       SLW     **                                                       CITE0057
RETURN AXT     **,4                                                     CITE0058
       TRA     4,4                                                      CITE0059
CNVRT  LDQ     *+2                                                      CITE0060
       TRA*    $(IOH)                                                   CITE0061
       TRA     *+1                                                      CITE0062
       TRA     2,4                                                      CITE0063
WS     OCT     0                                                        CITE0064
SIX    OCT     6000000                                                  CITE0065
C2     BOOL    77727                                                    CITE0066
REC1   BOOL    77751                                                    CITE0067
