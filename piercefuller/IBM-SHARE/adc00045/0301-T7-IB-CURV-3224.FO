C      PLOTTING A CURVE ON (X,Y) PLANE GIVEN BY AN EQUATION OF THE FORM CURV0007
C                              F(X,Y)=0                                 CURV0008
       DIMENSION   X(4),Y(4),FX(3),FY(3),TANX(2),TANY(2)                CURV0009
