       SX     = SQRTF(1.+TANX(1)**2)                                    CURV0024
      IF(1-MR)                                             17,17,16     CURV0025
   16 X(2)=X(1)+DT/SX                                                   CURV0026
      Y(2)=Y(1)+DT*TANX(1)/SX                                           CURV0027
      GO TO   18                                                        CURV0028
