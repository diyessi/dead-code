      GO TO 300                                                         CURV0176
  280 TANY(2)=-FY(2)/FX(2)                                              CURV0177
      SY=SQRTF(1.+TANY(2)**2    )                                       CURV0178
      IF  (Y(2)-Y(1))                                      290,290,285  CURV0179
  285 X(3)=X(2)+DT*TANY(2)/SY                                           CURV0180
      Y(3)=Y(2)+DT/SY                                                   CURV0181
       GO TO 200                                                        CURV0182
