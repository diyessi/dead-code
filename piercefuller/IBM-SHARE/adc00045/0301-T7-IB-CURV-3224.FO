              IF(1-MM)                                     400,400,7    CURV0134
    7         CALL FUNCT(J)                                             CURV0135
      NN=I+1                                                            CURV0136
  111 FORMAT(1I6,5F14.6)                                                CURV0137
      WRITE OUTPUT TAPE 6,111,NN,X(3),Y(3),FX(3),FY(3),EPS              CURV0138
      IF(1-MP)                                             1115,1115,115CURV0139
 1115 CONTINUE                                                          CURV0140
 1120 FORMAT(2E16,1I6)                                                  CURV0141
      J=I+2                                                             CURV0142
      WRITE OUTPUT TAPE 2,1120,X(3),Y(3),J                              CURV0143
  115 IF(ABSF(X(3))-XEND)                                  125,500,500  CURV0144
  125 IF(ABSF(Y(3))-YEND)                                  134,510,510  CURV0145
  134  IF(ABSF(X(3)-X(4))+ABSF(Y(3)-Y(4))-DT/2.0)          520,520,135  CURV0146
  135  X(1)=X(2)                                                        CURV0147
       X(2)=X(3)                                                        CURV0148
       Y(1)=Y(2)                                                        CURV0149
       Y(2)=Y(3)                                                        CURV0150
       FX(1)=FX(2)                                                      CURV0151
       FX(2)=FX(3)                                                      CURV0152
       FY(1)=FY(2)                                                      CURV0153
   61  FY(2)=FY(3)                                                      CURV0154
      WRITE OUT PUT TAPE    6,140                                       CURV0155
  140 FORMAT (10X,38HCALCULATION OF (N) POINTS IS COMPLETED)            CURV0156
      GO TO 600                                                         CURV0157
  120  XSI=-EPS/FX(3)                                                   CURV0158
      X(3)=X(3)+XSI                                                     CURV0159
      GO TO   205                                                       CURV0160
  205  IF( ABSF(X(3)-X(2))-2.0*DT)                         245,280,280  CURV0161
  210  IF( ABSF(Y(3)-Y(2))-2.0*DT)                         245,265,265  CURV0162
  245         M=8                                                       CURV0163
              J=3                                                       CURV0164
              IF(1-MM)                                     400,400,8    CURV0165
    8         CALL FUNCT(J)                                             CURV0166
      GO TO 100                                                         CURV0167
  265 TANX(2)=-FX(2)/FY(2)                                              CURV0168
      SX=SQRTF(1.+TANX(2)**2)                                           CURV0169
      IF(X(2)-X(1))                                        275,275,270  CURV0170
