02179*******************************************************************   PRAB 
02180*     CONSTANTS AND WORK AREAS                                        PRAB 
02190*******************************************************************   PRAB 
02200PAGE      DCW  '0001'                                                 PRAB 
02220SUP       DCW  'SUPP'                                                 PRAB 
02230CAPRAB    DCW  'CAPR - ABSTRACTS OF EDPM PROGRAMS'                    PRAB 
02240SINGLE    DCW  =1                                                     PRAB 
02250LCTR      DCW  =3        BODY LINE PER PAGE COUNTER.                  PRAB 
02251LINPA     DCW  '036'     NUMBER OF BODY LINES PER PAGE DESIRED.       PRAB 
02252LINCK     DCW  '027'     MAXIMUM LINE COUNTER CONTENT WHICH WILL      PRAB 
02253*                        ALLOW ALL THE INFORMATION EXCEPT THE         PRAB 
02254*                        ABSTRACT PORTION OF A PROGRAM PACKAGE        PRAB 
02255*                        TO PRINT ON THE REMAINDER OF THE PAGE.       PRAB 
03030TSW       DC   =1        TRAILER LABEL SWITCH                         PRAB 
03031HSW       DC   =1        HEADER LABEL SWITCH                          PRAB 
03040BLANKS    DA   1X65                                                   PRAB 
0305099        DCW  =3                                                     PRAB 
03060X3        EQU  99                                                     PRAB 
03070OMRC      DCW  =6        MASTER INPUT RECORD COUNT.                   PRAB 
03080OMEC      DCW  =6        MASTER INPUT ENTRY COUNT.                    PRAB 
03082PREC      DCW  =6        NUMBER OF ENTRIES PRINTED COUNTER.           PRAB 
03083NPEC      DCW  =6        NUMBER OF ENTRIES NOT PRINTED COUNTER.       PRAB 
03084ABCTR     DCW  '0'       COUNT OF ABSTRACT LINES WHICH HAVE BEEN      PRAB 
03085*                        PROCESSED FROM A PHYSICAL ABSTRACT INPUT     PRAB 
03086*                        RECORD FROM THE MASTER FILE.                 PRAB 
03090TR2CNT    DCW  =5        TAPE 2 BLOCK COUNT                           PRAB 
03100NINES     DCW  '99999999'                                             PRAB 
03110HDR       DCW  '1HDR '                                                PRAB 
03120*******************************************************************   PRAB 
03130*     HOUSEKEEPING                                                    PRAB 
03140*******************************************************************   PRAB 
03150START     RWD  2                   REWIND INPUT TAPE                  PRAB 
