03239*******************************************************************   PRAB 
03240GMC       B    RDMAC                                                  PRAB 
03250          BCE  CKDAT,MCTL-4,1                                         PRAB 
04010H601      NOP  601               INVALID INSTALLMENT CODE             PRAB 
04020          H                                                           PRAB 
04030          B    H601                                                   PRAB 
04040CKDAT     BCE  PROC,RUNTYP,B      TEST FOR BASIC RUN                  PRAB 
04050          C    MDATE,JULDAT       IF NOT, IS DATE EQUAL OR            PRAB 
04060          BH   LOP                     HIGH TO CONTROL DATE           PRAB 
04070          B    PROC               IF SO, PROCESS- OTHERWISE           PRAB 
04072LOP       A    +1,NPEC            ADD 1 TO ENTRIES NOT PRINTED CTR.   PRAB 
04080LOPM      B    RDMAC             AND SKIP TO NEXT ENTRY               PRAB 
04090          BCE  LOPM,MCTL-4,2                                          PRAB 
04100          BCE  GMC,MCTL-4,3                                           PRAB 
04110          B    H601                                                   PRAB 
04120*                                                                     PRAB 
04130PROC      C    LINCK,LCTR     TEST IF THERE IS ROOM ON PAGE           PRAB 
04140          BH   CRTITL                FOR HEADER INSTALLMENT           PRAB 
04150          B    HDINST             WRITE HEADER LINES                  PRAB 
04160          B    GAB                GET ABSTRACT RECORD                 PRAB 
04170          SW   FSW                 SET 1ST LINE SWITCH                PRAB 
04180CKCTR     C    LINPA,LCTR     HAS END OF PAGE BEEN REACHED            PRAB 
04190          BH   CONTIN                                                 PRAB 
04200          B    PAB                PRINT ABSTRACT LINE                 PRAB 
04210          A    +62,X3                                                 PRAB 
04220          C    MABCT,ABCTR    ALL ABSTRACT LINES FROM RECORD USED     PRAB 
04230          BE   GAB            YES-GET ANOTHER RECORD                  PRAB 
04240          B    CKCTR                                                  PRAB 
