*     LABEL                                                             MPRD0000
*     FAP                                                               MPRD0010
*MPRD          A * B = C, WITH C DISTINCT FROM A AND B                  MPRD0020
       ENTRY   MPPROD          MULTIPLE PRECISION FIXED POINT           MPRD0030
MPPROD SXA     XR1,1              MULTIPLICATION SUBROUTINE.            MPRD0040
       SXA     XR2,2           LINKAGE,                                 MPRD0050
       SXA     XR4,4              CALL MPMULT (A,NA,B,NB,C,NC)          MPRD0060
       CAL     1,4                   WHERE A,B,C ARE FORTRAN ARRAYS     MPRD0070
       ADD     =1                       EACH CONTAINING A FIXED POINT   MPRD0080
       STA     AD2                         INTEGER,                     MPRD0090
       CLA*    2,4             NA,NB,NC ARE THE NO. OF WORDS IN EACH    MPRD0100
       STD     LA                 ARRAY, RESP. AND A(1) IS THE LEAST    MPRD0110
       CAL     3,4                   SIGNIFICANT WORD OF A, ETC.        MPRD0120
       ADD     =1              C,NC ARE COMPUTED BY THE SUBROUTINE.     MPRD0130
       STA     AD3             ALL WORDS ARE 35-BIT SIGNED INTEGERS.    MPRD0140
       CLA*    4,4             LEADING ZEROES ARE IGNORED IN ALL CASES. MPRD0150
       STD     LB              NA,NB,NC MUST BE LESS THAN OR EQUAL TO   MPRD0160
       CAL     5,4                THE DIMENSIONS OF THEIR CORRESPONDING MPRD0170
       ADD     =1                    ARRAYS.                            MPRD0180
       STA     AD1             NC WILL NEVER BE LARGER THAN NA+NB       MPRD0190
       STA     AD4                NOR LESS THAN 1                       MPRD0200
       STA     AD5             NA,NB,NC ARE FORTRAN DECREMENT INTEGERS. MPRD0210
       STA     AD6             MIXED SIGN ARITHMETIC MAY BE USED.       MPRD0220
       STA     AD7                                                      MPRD0230
       LXD     LB,1                                                     MPRD0240
AD1    STZ     **,1            LWA C+1,1                                MPRD0250
       TIX     AD1,1,1                                                  MPRD0260
RESETC AXT     1,4                                                      MPRD0270
       PXD     ,1                                                       MPRD0280
       PDX     ,2                                                       MPRD0290
       CLM                                                              MPRD0300
LB     TXH     CHECK,4,**      CHECK,4,LB                               MPRD0310
       STO     CARRYR                                                   MPRD0320
AD2    LDQ     **,1            LWA A+1,1                                MPRD0330
AD3    MPY     **,4            LWA B+1,4                                MPRD0340
       STO     CARRYL                                                   MPRD0350
       XCA                                                              MPRD0360
       ADD     CARRYR                                                   MPRD0370
AD4    ADD     **,2            LWA C+1,2                                MPRD0380
       ADD     CARRYC                                                   MPRD0390
AD5    STO     **,2            LWA C+1,2                                MPRD0400
       ARS     35                                                       MPRD0410
       STO     CARRYC                                                   MPRD0420
       CLA     CARRYL                                                   MPRD0430
       TXI     *+1,4,1                                                  MPRD0440
       TXI     LB,2,1                                                   MPRD0450
CHECK  ADD     CARRYC                                                   MPRD0460
AD6    STO     **,2            LWA C+1,2                                MPRD0470
       STZ     CARRYC                                                   MPRD0480
       TXI     LA,1,1                                                   MPRD0490
LA     TXL     RESETC,1,**     RESETC,1,LA                              MPRD0500
AD7    CLA     **,2            LWA C+1,2                                MPRD0510
       TNZ     *+2                                                      MPRD0520
       TIX     AD7,2,1                                                  MPRD0530
       PXD     ,2                                                       MPRD0540
XR1    AXT     **,1                                                     MPRD0550
XR2    AXT     **,2                                                     MPRD0560
XR4    AXT     **,4                                                     MPRD0570
       STD*    6,4                                                      MPRD0580
       TOV     7,4                                                      MPRD0590
       TNO     7,4                                                      MPRD0600
CARRYL OCT                                                              MPRD0610
CARRYR OCT                                                              MPRD0620
CARRYC OCT                                                              MPRD0630
       END                                                              MPRD0640
