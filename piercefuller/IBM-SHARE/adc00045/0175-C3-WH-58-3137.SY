*WH58E REM 0018 02131                                                   58E 0001
*      FAP                                                              58E 0002
*      MINIMUM ERROR ROUTINE FOR STEAM TABLE DISTRIBUTION               58E 0003
       COUNT  12                                                        58E 0004
       ENTRY  ERROR                                                     58E 0005
 Z     TAPENO A3                                                        58E 0006
       BSS    -2             SUPPRESS LINKAGE DIRECTOR                  58E 0007
 ERROR SXA    ER1,4          IR4 MAY BE CHANGED BY TES                  58E 0008
       XEC*   $(TES)         CHECK LAST WRITE                           58E 0009
       WTDZ                                                             58E 0010
       RCHZ   ER2            PRINT STEAM TABLE ERROR                    58E 0011
       TCOZ   *                                                         58E 0012
 ER1   AXT    **,4                                                      58E 0013
       TRCZ   2,4            IGNORE WRITE ERROR ON THIS MESSAGE         58E 0014
       TRA    2,4                                                       58E 0015
 ER2   IOCD   *+1,,3                                                    58E 0016
       BCI    3,0STEAM TABLE ERROR                                      58E 0017
       END                                                              58E 0018
