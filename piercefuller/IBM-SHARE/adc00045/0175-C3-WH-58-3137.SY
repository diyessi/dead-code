*WHHSL REM 0052 02131                                                   HSL 0001
*      FAP                                                              HSL 0002
*      ENTHALPY OF SATURATED LIQUID (HSL) STEAM TABLE SUBROUTINE        HSL 0003
       COUNT  48                                                        HSL 0004
       ENTRY  HSL                                                       HSL 0005
 HSL   CAS    HSLD+4         T VS 50.                                   HSL 0006
       CAS    HSLD+10        T VS 705.4                                 HSL 0007
       TRA    HSLER                                                     HSL 0008
       TRA    HSLER                                                     HSL 0009
       SXA    HSL2,4                                                    HSL 0010
       LDQ    =O212453777777 T VS 600.                                  HSL 0011
       TLQ    HSL1           547 CYCLES OR 1.19246 MS                   HSL 0012
       AXT    0,4            ASSUME T GREATER OR EQUAL 360.             HSL 0013
       STO    E+1                                                       HSL 0014
       SUB    HSLD+7         CHECK ASSUMPTION                           HSL 0015
       TPL    *+2            O.K. 111 CYCLES - .24198 MS                HSL 0016
       AXC    1,4            NO - T LESS THAN 360. 112 CYCLES .24416 MS HSL 0017
       LDQ    HSLD,4         BEGIN POLYNOMIAL EXPANSION                 HSL 0018
       FMP    E+1                                                       HSL 0019
 HSL4  DUP    3,4                                                       HSL 0020
       FAD    *-HSL4+HSLD+2,4                                           HSL 0021
       XCA                                                              HSL 0022
       FMP    E+1                                                       HSL 0023
       FAD    HSLD+13,4                                                 HSL 0024
 HSL2  AXT    **,4                                                      HSL 0025
       TRA    1,4                                                       HSL 0026
 HSLD  DEC    .4560246E-10,.96350315E-12,-.10315357E-6,-.73618778E-9    HSL 0027
       OCT    206617777777                                              HSL 0028
       DEC    .941244E-4,.48553836E-6,360.,-.042753836,-.11516996E-3    HSL 0029
       OCT    212540545707                                              HSL 0030
       DEC    10.673802,1.0088084,-904.11706,-32.179105                 HSL 0031
 HSLTB DEC    670.,10.,617.,631.6,646.7,662.3,678.6,695.7,714.2,734.4   HSL 0032
       DEC    757.3,784.4,823.3                                         HSL 0033
 HSLTC DEC    702.,1.,823.3,829.,835.4,843.3,852.7,869.2                HSL 0034
 BCD   BCI    4,TEMPERATURE OUT OF RANGE                                HSL 0035
       OCT    777777777777                                              HSL 0036
 HSL1  LDQ    =700.                                                     HSL 0037
       TLQ    HSL3                                                      HSL 0038
       TSX    $LDIR),4                                                  HSL 0039
              HSLTB,,11                                                 HSL 0040
       TRA    HSL2                                                      HSL 0041
 HSL3  TSX    $LDIR),4                                                  HSL 0042
              HSLTC,,6                                                  HSL 0043
       TRA    HSL2                                                      HSL 0044
 HSLER SXD    HSL-2,4                                                   HSL 0045
       CALL   ERROR,BCD                                                 HSL 0046
       PXD    ,0             RETURN 0 FOR ERROR                         HSL 0047
       LXD    HSL-2,4                                                   HSL 0048
       TRA    1,4                                                       HSL 0049
       COMMON -168                                                      HSL 0050
 E     COMMON -1             USES E+1                                   HSL 0051
       END                                                              HSL 0052
