*     FAP                                                                       
       LBL     ERF                                                      ERF00000
       COUNT   100                                                      ERF00001
*      U. OF CHICAGO VERSION OF ERROR FUNCTION                          ERF00002
*              CALLING SEQUENCE     TSX  $ERF,4                         ERF00003
*              THIS PROGRAM REQUIRES THE SUBPROGAM $EXP.   IT COMPUTES  ERF00004
*                INTEGRAL FROM 0 TO X OF (2/SQRTPI)*E**(-X*X)           ERF00005
       SPACE                                                            ERF00006
       ENTRY   ERF                                                      ERF00007
       SPACE                                                            ERF00008
  ERF  SXA     SAVE4,4                                                  ERF00009
       STO     ARG+1         FOR SIGN CONTROL                           ERF00010
       SSP                                                              ERF00011
       STO     ARG                                                      ERF00012
       LDQ     MAX                                                      ERF00013
       TLQ     INF           IF X GREATER THAN 4.17, GIVE ONE AS ANSWER ERF00014
       XCA                                                              ERF00015
       FMP     ARG                                                      ERF00016
       STO     FLTSQ         SQUARE IN FLOAT POINT                      ERF00017
       RQL     8                                                        ERF00018
       LRS     27                                                       ERF00019
       PAC     ,4                                                       ERF00020
       ZAC                                                              ERF00021
       LLS     -98,4                                                    ERF00022
       RND                                                              ERF00023
       STO     SQ            SQUARE IN FIXED POINT SCALING B5           ERF00024
       SPACE                                                            ERF00025
       LDQ     BREAK                                                    ERF00026
       AXT     10,4                                                     ERF00027
       TLQ     *+2           IF X GREATER THAN 1.51, XR4=10             ERF00028
       TIX     *+1,4,1       IF X SMALLER THAN 1.51, XR4=9              ERF00029
       ZAC                                                              ERF00030
 LOOP  ADD     BETA+1,4      COMPUTE 5 TERM CONTINUED FRACTION WITH     ERF00031
       ADD     SQ              APPROPRIATE SET OF CONSTANTS DEPENDING   ERF00032
       STO     BUFF            ON THE RANGE                             ERF00033
       CLA     ALPHA+1,4                                                ERF00034
       DVP     BUFF                                                     ERF00035
       XCA                                                              ERF00036
       TIX     LOOP,4,2                                                 ERF00037
       SPACE                                                            ERF00038
       TXH     BIG,4,1       IF X WAS GREATER THAN 1.51, SKIP           ERF00039
       XCA                                                              ERF00040
       MPR     SQ                                                       ERF00041
       SUB     ALPHA-1       FACTOR IS READY IN SCALING B5              ERF00042
       ALS     5             FLOAT THE FACTOR                           ERF00043
       PBT                                                              ERF00044
       AXT     2,4                                                      ERF00045
       LRS     10,4                                                     ERF00046
       ORA     CHAR,4                                                   ERF00047
       RQL     28                                                       ERF00048
       FRN                   NOW FACTOR IS READY IN FLOAT POINT         ERF00049
       XCA                                                              ERF00050
       FMP     ARG                                                      ERF00051
       TRA     MERGE         COMPUTATION ENDS FOR X LESS THAN 1.51      ERF00052
       SPACE                                                            ERF00053
  BIG  ARS     7             MAGNITUDE OF RESULT IS LESS THAN 0.22      ERF00054
       ORA     CHAR            BRING THIS TO B6 AND FLOAT IT            ERF00055
       XCA                                                              ERF00056
       FMP     ARG                                                      ERF00057
       STO     BUFF                                                     ERF00058
       CLS     FLTSQ         MULTIPLY E**(-SQ) AND ADD 1                ERF00059
       TSX     $EXP,4                                                   ERF00060
       XCA                                                              ERF00061
       FMP     BUFF                                                     ERF00062
       FAD     ONE                                                      ERF00063
       SPACE                                                            ERF00064
 MERGE FRN                                                              ERF00065
       LDQ     ARG+1         ADJUST SIGN AND RETURN TO MAIN PROGRAM     ERF00066
       LLS     0                                                        ERF00067
 SAVE4 AXT     **,4                                                     ERF00068
       TRA     1,4                                                      ERF00069
       SPACE                                                            ERF00070
  INF  CLA     ONE           THE CASE WHEN X IS GREATER THAN 4.17       ERF00071
       TRA     MERGE+1                                                  ERF00072
       SPACE                                                            ERF00073
  MAX  OCT     203412702437    4.17                                     ERF00074
 BREAK OCT     022173224200    1.51**2  IN FIXED POINT B5               ERF00075
       OCT     200000000000    CHARACTERISTICS TO FLOAT NUMBERS         ERF00076
  ONE  OCT     201400000000    CHARACTERISTICS, ALSO DOUBLES AS 1.      ERF00077
 CHAR  OCT     176000000000    CHARACTERISTICS                          ERF00078
       OCT     -002546632144   A5 FOR BIG ARG   -10.803134        B10   ERF00079
       OCT     020037203556    A5 FOR SM. ARG   64.244197         B10   ERF00080
       OCT     -001700000000   A4 FOR BIG ARG   -7.5              B10   ERF00081
       OCT     007635131455    A4 FOR SM. ARG   31.227929         B10   ERF00082
       OCT     -000600000000   A3 FOR BIG ARG   -3.               B10   ERF00083
       OCT     062261376110    A3 FOR SM. ARG   201.38669         B10   ERF00084
       OCT     -000100000000   A2 FOR BIG ARG   -0.5              B10   ERF00085
       OCT     -051626106115   A2 FOR SM. ARG   -167.17295        B10   ERF00086
       OCT     -011015656501   A1 FOR BIG ARG IN B4 = 2/SQRT(PI)  B5    ERF00087
 ALPHA OCT     -011217512462   A1 FOR SM. ARG   -1.1600697        B5    ERF00088
       OCT     042115730200    B5 FOR BIG ARG   4.2690240         B5    ERF00089
       OCT     054500177563    B5 FOR SM. ARG   5.5781859         B5    ERF00090
       OCT     064000000000    B4 FOR BIG ARG   6.5               B5    ERF00091
       OCT     -016136305707   B4 FOR SM. ARG   -1.7730436        B5    ERF00092
       OCT     044000000000    B3 FOR BIG ARG   4.5               B5    ERF00093
       OCT     134436235275    B3 FOR SM. ARG   11.569899         B5    ERF00094
       OCT     024000000000    B2 FOR BIG ARG   2.5               B5    ERF00095
       OCT     116366667120    B2 FOR SM. ARG   9.8102679         B5    ERF00096
       OCT     004000000000    B1 FOR BIG ARG   0.5               B5    ERF00097
 BETA  OCT     121564517660    B1 FOR SM. ARG   10.215980         B5    ERF00098
  ARG  BSS     2                                                        ERF00099
 FLTSQ BSS     1                                                        ERF00100
  SQ   BSS     1                                                        ERF00101
 BUFF  BSS     1                                                        ERF00102
       END                                                              ERF00103
