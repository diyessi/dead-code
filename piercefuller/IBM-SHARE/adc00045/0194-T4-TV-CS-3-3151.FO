     1-XJA1**2*BLOCK(8)-ZJA1*BLOCK(6)-XJA1*BLOCK(10)+XJA1*BLOCK(15)+YJA1CS-30125
     2*BLOCK(5)+BLOCK(20)                                               CS-30126
      BROWN(21)=2.*YJA1*BLOCK(6)-2.*XJA1*BLOCK(11)-2.*XJA1*YJA1*BLOCK(2)CS-30127
     1+YJA1**2*BLOCK(1)+XJA1**2*BLOCK(7)+BLOCK(21)                      CS-30128
