 2005 IF(SENSE SWITCH 1)2003,2000                                       CS-30369
 2003 PRINT 2004                                                        CS-30370
 2004 FORMAT(75H1TAPES 5 AND 6 MUST REMAIN IN FIXED POSITION DURING INTECS-30371
     1RRUPT----PUSH START)                                              CS-30372
      PAUSE                                                             CS-30373
      CALL GETOF                                                        CS-30374
 2000 IF(MM-NSETS)2001,2002,2002                                        CS-30375
 2001 MM=MM+1                                                           CS-30376
      GO TO 1001                                                        CS-30377
 2002 CALL EXIT                                                         CS-30378
      END(1,2,2,2,2)                                                    CS-30379
C                                                                           0380
C-----------------------------------------------------------------------    0381
C                   END OF MAIN PROGRAM                                     0382
C-----------------------------------------------------------------------    0383
            *************CALC SUBROUTINE*************                       0386
C                                                                           0387
      SUBROUTINE CALC                                                   CS-30388
      DIMENSION DATA(200,13),TITLE(12),BLOCK(21),TAN(21),BROWN(21),A1(6,CS-30389
     17),A2(12,13),TEMP(12,12),ANCO1(21),ANCO2(21),BLOCJ(6,6),AJA1(6,6),CS-30390
     2AJA2(6,6),VALUE1(6),VALUE2(6),VALUE 3(12),CHECK(12),BFLEX(21),STORCS-30391
     3J(21),SHAPE(24),QUEST(12),REACT(12),DEFLEC(6),TOTAL(6),SIDE(12),EQCS-30392
     4UAT(6),TOTAM(6),XLASTO(200,6)                                     CS-30393
      COMMON XPID,DATA,RMI,RMF,XINERT,YINERT,Q,A,B,C,COORDX,COORDY,COORDCS-30394
     1Z,AMID,DISTA,BMID,DISTB,      EXPAN1,EXPAN2,EXPAN3,V3,  I,TITLE,BLCS-30395
     2OCK,TAN,BROWN,A1,A2,TEMP,ANCO1,ANCO2,BLOCJ,AJA1,AJA2,VALUE1,VALUE2CS-30396
     3,VALUE3,CHECK,BFLEX,STORJ,SHAPE,QUEST,REACT,DEFLEC,TOTAL,SIDE,EQUACS-30397
     4T,TOTAM,XLASTO,COUNTP,COUNTD,COUNTJ,COUNTS,COUNTA,NCRDS,EXPAJ1,EXPCS-30398
     5AJ2,EXPAJ3,EXPAN1,EXPAN2,EXPAN3,XJA1,YJA1,ZJA1,EI                 CS-30399
      XPID=DATA(I,4)-2.*DATA(I,5)                                       CS-30400
      RMI=(DATA(I,4)/2.-DATA(I,5)/2.)**2                                CS-30401
      RMF=RMI/144.                                                      CS-30402
      YINERT=(3.14159/64.)*(DATA(I,4)**4-XPID**4)                       CS-30403
      Q=XINERT/YINERT                                                   CS-30404
      RETURN                                                            CS-30405
      END                                                               CS-30406
C                                                                           0407
C-----------------------------------------------------------------------    0408
C                  END OF CALC SUBROUTINE                                   0409
C-----------------------------------------------------------------------    0410
            *************CALC2 SUBROUTINE***********                       0413 
C                                                                           0414
      SUBROUTINE CALC2                                                  CS-30415
      DIMENSION DATA(200,13),TITLE(12),BLOCK(21),TAN(21),BROWN(21),A1(6,CS-30416
     17),A2(12,13),TEMP(12,12),ANCO1(21),ANCO2(21),BLOCJ(6,6),AJA1(6,6),CS-30417
     2AJA2(6,6),VALUE1(6),VALUE2(6),VALUE 3(12),CHECK(12),BFLEX(21),STORCS-30418
     3J(21),SHAPE(24),QUEST(12),REACT(12),DEFLEC(6),TOTAL(6),SIDE(12),EQCS-30419
     4UAT(6),TOTAM(6),XLASTO(200,6)                                     CS-30420
      COMMON XPID,DATA,RMI,RMF,XINERT,YINERT,Q,A,B,C,COORDX,COORDY,COORDCS-30421
     1Z,AMID,DISTA,BMID,DISTB,      EXPAN1,EXPAN2,EXPAN3,V3,  I,TITLE,BLCS-30422
     2OCK,TAN,BROWN,A1,A2,TEMP,ANCO1,ANCO2,BLOCJ,AJA1,AJA2,VALUE1,VALUE2CS-30423
     3,VALUE3,CHECK,BFLEX,STORJ,SHAPE,QUEST,REACT,DEFLEC,TOTAL,SIDE,EQUACS-30424
     4T,TOTAM,XLASTO,COUNTP,COUNTD,COUNTJ,COUNTS,COUNTA,NCRDS,EXPAJ1,EXPCS-30425
     5AJ2,EXPAJ3,EXPAN1,EXPAN2,EXPAN3,XJA1,YJA1,ZJA1,EI                 CS-30426
C TEST FOR X, Y, OR Z PLANE                                             CS-30427
   12 IF(DATA(I,1)-2.)13,14,15                                          CS-30428
   13 A=COORDY                                                          CS-30429
      B=COORDZ                                                          CS-30430
      C=COORDX                                                          CS-30431
      GO TO 16                                                          CS-30432
   14 A=COORDZ                                                          CS-30433
      B=COORDX                                                          CS-30434
      C=COORDY                                                          CS-30435
      GO TO 16                                                          CS-30436
   15 A=COORDX                                                          CS-30437
      B=COORDY                                                          CS-30438
      C=COORDZ                                                          CS-30439
C DETERMINE IF MEMBER IS STRAIGHT OR CURVED,                            CS-30440
   16 IF(DATA(I,7))34,25,34                                             CS-30441
   25 AMID=(DATA(I,3)/2.)*COSF(DATA(I,2))+A                             CS-30442
      DISTA=DATA(I,3)*COSF(DATA(I,2))                                   CS-30443
      IF(DATA(I,1)-2.)26,27,28                                          CS-30444
   26 COORDY=DISTA+A                                                    CS-30445
      GO TO 29                                                          CS-30446
   27 COORDZ=DISTA+A                                                    CS-30447
      GO TO 29                                                          CS-30448
   28 COORDX=DISTA+A                                                    CS-30449
   29 BMID=(DATA(I,3)/2.)*SINF(DATA(I,2))+B                             CS-30450
      DISTB=DATA(I,3)*SINF(DATA(I,2))                                   CS-30451
      IF(DATA(I,1)-2.)30,31,32                                          CS-30452
   30 COORDZ=DISTB+B                                                    CS-30453
      GO TO 33                                                          CS-30454
   31 COORDX=DISTB+B                                                    CS-30455
      GO TO 33                                                          CS-30456
   32 COORDY=DISTB+B                                                    CS-30457
   33 IF(COUNTP)48,5,48                                                 CS-30458
    5 DATA(I,9)=COORDX                                                  CS-30459
      DATA(I,10)=COORDY                                                 CS-30460
      DATA(I,11)=COORDZ                                                 CS-30461
      GO TO 48                                                          CS-30462
C PROCESS CURVED MEMBER                                                 CS-30463
   34 IF(DATA(I,8))35,36,35                                             CS-30464
   35 AMID=A-DATA(I,3)*SINF(DATA(I,2)+DATA(I,7))                        CS-30465
      DISTA=DATA(I,3)*(SINF(DATA(I,2))-SINF(DATA(I,2)+DATA(I,7)))       CS-30466
      GO TO 37                                                          CS-30467
   36 AMID=A-DATA(I,3)*SINF(DATA(I,2))                                  CS-30468
      DISTA=DATA(I,3)*(SINF(DATA(I,2)+DATA(I,7))-SINF(DATA(I,2)))       CS-30469
   37 IF(DATA(I,1)-2.)38,39,40                                          CS-30470
   38 COORDY=DISTA+A                                                    CS-30471
      GO TO 41                                                          CS-30472
   39 COORDZ=DISTA+A                                                    CS-30473
      GO TO 41                                                          CS-30474
   40 COORDX=DISTA+A                                                    CS-30475
   41 IF(DATA(I,8))42,43,42                                             CS-30476
   42 BMID=B+DATA(I,3)*COSF(DATA(I,2)+DATA(I,7))                        CS-30477
      DISTB=DATA(I,3)*(COSF(DATA(I,2)+DATA(I,7))-COSF(DATA(I,2)))       CS-30478
      GO TO 44                                                          CS-30479
   43 BMID=B+DATA(I,3)*COSF(DATA(I,2))                                  CS-30480
      DISTB=DATA(I,3)*(COSF(DATA(I,2))-COSF(DATA(I,2)+DATA(I,7)))       CS-30481
   44 IF(DATA(I,1)-2.)45,46,47                                          CS-30482
   45 COORDZ=DISTB+B                                                    CS-30483
      GO TO 50                                                          CS-30484
   46 COORDX=DISTB+B                                                    CS-30485
      GO TO 50                                                          CS-30486
   47 COORDY=DISTB+B                                                    CS-30487
   50 IF(COUNTP)48,5,48                                                 CS-30488
   48 RETURN                                                            CS-30489
      END(1,2,2,2,2)                                                    CS-30490
C                                                                           0491
C-----------------------------------------------------------------------    0492
C                  END OF CALC2 SUBROUTINE                                  0493
C-----------------------------------------------------------------------    0494
            *************CALC3 SUBROUTINE************                       0497
C                                                                           0498
      SUBROUTINE CALC3                                                  CS-30499
      DIMENSION DATA(200,13),TITLE(12),BLOCK(21),TAN(21),BROWN(21),A1(6,CS-30500
     17),A2(12,13),TEMP(12,12),ANCO1(21),ANCO2(21),BLOCJ(6,6),AJA1(6,6),CS-30501
     2AJA2(6,6),VALUE1(6),VALUE2(6),VALUE 3(12),CHECK(12),BFLEX(21),STORCS-30502
     3J(21),SHAPE(24),QUEST(12),REACT(12),DEFLEC(6),TOTAL(6),SIDE(12),EQCS-30503
     4UAT(6),TOTAM(6),XLASTO(200,6)                                     CS-30504
      COMMON XPID,DATA,RMI,RMF,XINERT,YINERT,Q,A,B,C,COORDX,COORDY,COORDCS-30505
     1Z,AMID,DISTA,BMID,DISTB,      EXPAN1,EXPAN2,EXPAN3,V3,  I,TITLE,BLCS-30506
     2OCK,TAN,BROWN,A1,A2,TEMP,ANCO1,ANCO2,BLOCJ,AJA1,AJA2,VALUE1,VALUE2CS-30507
     3,VALUE3,CHECK,BFLEX,STORJ,SHAPE,QUEST,REACT,DEFLEC,TOTAL,SIDE,EQUACS-30508
     4T,TOTAM,XLASTO,COUNTP,COUNTD,COUNTJ,COUNTS,COUNTA,NCRDS,EXPAJ1,EXPCS-30509
     5AJ2,EXPAJ3,EXPAN1,EXPAN2,EXPAN3,XJA1,YJA1,ZJA1,EI                 CS-30510
      XPID=DATA(I,4)-2.*DATA(I,5)                                       CS-30511
      RMI=(DATA(I,4)/2.-DATA(I,5)/2.)**2                                CS-30512
      RMF=RMI/144.                                                      CS-30513
      YINERT=(3.14159/64.)*(DATA(I,4)**4-XPID**4)                       CS-30514
      Q=XINERT/YINERT                                                   CS-30515
C TEST FOR X, Y, OR Z PLANE                                             CS-30516
   12 IF(DATA(I,1)-2.)13,14,15                                          CS-30517
   13 A=COORDY                                                          CS-30518
      B=COORDZ                                                          CS-30519
      C=COORDX                                                          CS-30520
      GO TO 16                                                          CS-30521
   14 A=COORDZ                                                          CS-30522
      B=COORDX                                                          CS-30523
      C=COORDY                                                          CS-30524
      GO TO 16                                                          CS-30525
   15 A=COORDX                                                          CS-30526
      B=COORDY                                                          CS-30527
      C=COORDZ                                                          CS-30528
C DETERMINE IF MEMBER IS STRAIGHT OR CURVED,                            CS-30529
   16 IF(DATA(I,7))34,25,34                                             CS-30530
   25 AMID=(DATA(I,3)/2.)*COSF(DATA(I,2))+A                             CS-30531
      DISTA=DATA(I,3)*COSF(DATA(I,2))                                   CS-30532
      IF(DATA(I,1)-2.)26,27,28                                          CS-30533
   26 COORDY=DISTA+A                                                    CS-30534
      GO TO 29                                                          CS-30535
   27 COORDZ=DISTA+A                                                    CS-30536
      GO TO 29                                                          CS-30537
   28 COORDX=DISTA+A                                                    CS-30538
   29 BMID=(DATA(I,3)/2.)*SINF(DATA(I,2))+B                             CS-30539
      DISTB=DATA(I,3)*SINF(DATA(I,2))                                   CS-30540
      IF(DATA(I,1)-2.)30,31,32                                          CS-30541
   30 COORDZ=DISTB+B                                                    CS-30542
      GO TO 33                                                          CS-30543
   31 COORDX=DISTB+B                                                    CS-30544
      GO TO 33                                                          CS-30545
   32 COORDY=DISTB+B                                                    CS-30546
   33 IF(COUNTP)52,58,52                                                CS-30547
   58 DATA(I,9)=COORDX                                                  CS-30548
      DATA(I,10)=COORDY                                                 CS-30549
      DATA(I,11)=COORDZ                                                 CS-30550
      GO TO 52                                                          CS-30551
C PROCESS CURVED MEMBER                                                 CS-30552
   34 IF(DATA(I,8))35,36,35                                             CS-30553
   35 AMID=A-DATA(I,3)*SINF(DATA(I,2)+DATA(I,7))                        CS-30554
      DISTA=DATA(I,3)*(SINF(DATA(I,2))-SINF(DATA(I,2)+DATA(I,7)))       CS-30555
      GO TO 37                                                          CS-30556
   36 AMID=A-DATA(I,3)*SINF(DATA(I,2))                                  CS-30557
      DISTA=DATA(I,3)*(SINF(DATA(I,2)+DATA(I,7))-SINF(DATA(I,2)))       CS-30558
   37 IF(DATA(I,1)-2.)38,39,40                                          CS-30559
   38 COORDY=DISTA+A                                                    CS-30560
      GO TO 41                                                          CS-30561
   39 COORDZ=DISTA+A                                                    CS-30562
      GO TO 41                                                          CS-30563
   40 COORDX=DISTA+A                                                    CS-30564
   41 IF(DATA(I,8))42,43,42                                             CS-30565
   42 BMID=B+DATA(I,3)*COSF(DATA(I,2)+DATA(I,7))                        CS-30566
      DISTB=DATA(I,3)*(COSF(DATA(I,2)+DATA(I,7))-COSF(DATA(I,2)))       CS-30567
      GO TO 44                                                          CS-30568
   43 BMID=B+DATA(I,3)*COSF(DATA(I,2))                                  CS-30569
      DISTB=DATA(I,3)*(COSF(DATA(I,2))-COSF(DATA(I,2)+DATA(I,7)))       CS-30570
   44 IF(DATA(I,1)-2.)45,46,47                                          CS-30571
   45 COORDZ=DISTB+B                                                    CS-30572
      GO TO 48                                                          CS-30573
   46 COORDX=DISTB+B                                                    CS-30574
      GO TO 48                                                          CS-30575
   47 COORDY=DISTB+B                                                    CS-30576
C CALCULATE SHAPE COEFFICIENTS FOR CURVED MEMBER                        CS-30577
   48 IF(COUNTP)60,59,60                                                CS-30578
   59 DATA(I,9)=COORDX                                                  CS-30579
      DATA(I,10)=COORDY                                                 CS-30580
      DATA(I,11)=COORDZ                                                 CS-30581
   60 H=(12.*DATA(I,5)*DATA(I,3))/RMI                                   CS-30582
      IF(H-1.)49,49,50                                                  CS-30583
   49 XK=1.65/H                                                         CS-30584
      GO TO 51                                                          CS-30585
   50 XK=(12.*H**2+10.)/(12.*H**2+1.)                                   CS-30586
   51 CA=COSF(DATA(I,2))-COSF(DATA(I,2)+DATA(I,7))                      CS-30587
      CB=SINF(DATA(I,2))-SINF(DATA(I,2)+DATA(I,7))                      CS-30588
      CAB=0.25*(COSF(2.*(DATA(I,2)+DATA(I,7)))-COSF(2.*(DATA(I,2))))    CS-30589
      CAA=0.5*DATA(I,7)-0.25*(SINF(2.*(DATA(I,2)+DATA(I,7)))-SINF(2.*(DACS-30590
     1TA(I,2))))                                                        CS-30591
      CBB=0.5*DATA(I,7)+0.25*(SINF(2.*(DATA(I,2)+DATA(I,7)))-SINF(2.*(DACS-30592
     1TA(I,2))))                                                        CS-30593
      SPA=XK*Q*DATA(I,3)**2*CA                                          CS-30594
      SPB=XK*Q*DATA(I,3)**2*CB                                          CS-30595
      SPAB=XK*Q*DATA(I,3)**3*CAB                                        CS-30596
      SPAA=XK*Q*DATA(I,3)**3*CAA                                        CS-30597
      SPBB=XK*Q*DATA(I,3)**3*CBB                                        CS-30598
      UPO=1.3*Q*DATA(I,3)**2*CA                                         CS-30599
      VPO=1.3*Q*DATA(I,3)**2*CB                                         CS-30600
      WPO=1.3*Q*DATA(I,3)**3*DATA(I,7)                                  CS-30601
      SHAPE (1)=Q*XK*DATA(I,3)*DATA(I,7)                                CS-30602
      SHAPE (2)=AMID*SHAPE(1)+SPA                                       CS-30603
      SHAPE (3)=BMID*SHAPE(1)+SPB                                       CS-30604
      SHAPE (4)=BMID*SPA+(AMID*SPB+AMID*BMID*SHAPE(1))+SPAB             CS-30605
      SHAPE (5)=2.*AMID*SPA+(AMID**2*SHAPE(1))+SPAA                     CS-30606
      SHAPE (6)=2.*BMID*SPB+(BMID**2*SHAPE(1))+SPBB                     CS-30607
      SHAPE (7)=Q*DATA(I,3)*(XK*CBB+1.3*CAA)                            CS-30608
      SHAPE (8)=Q*DATA(I,3)*(XK*CAA+1.3*CBB)                            CS-30609
      SHAPE (9)=Q*DATA(I,3)*(XK-1.3)*CAB                                CS-30610
      SHAPE (10)=AMID*SHAPE(7)-BMID*SHAPE(9)+UPO                        CS-30611
      SHAPE (11)=BMID*SHAPE(8)-AMID*SHAPE(9)+VPO                        CS-30612
      SHAPE (12)=2.*AMID*UPO+2.*BMID*VPO+AMID**2*SHAPE (7)+BMID**2*SHAPECS-30613
     1(8)-2.*AMID*BMID*SHAPE(9)+WPO                                     CS-30614
      SHAPE (13)=2.6*Q*DATA(I,3)*DATA(I,7)*RMF                          CS-30615
      SHAPE (14)=Q*DATA(I,3)*RMF*(2.6*CBB+0.5*CAA)                      CS-30616
      SHAPE (15)=Q*DATA(I,3)*RMF*(2.6*CAA+0.5*CBB)                      CS-30617
      SHAPE (16)=Q*DATA(I,3)*(-2.1)*RMF*CAB                             CS-30618
      SHAPE (17)=C*SHAPE(7)                                             CS-30619
      SHAPE (18)=C**2*SHAPE(7)                                          CS-30620
      SHAPE (19)=C*SHAPE(8)                                             CS-30621
      SHAPE (20)=C**2*SHAPE(8)                                          CS-30622
      SHAPE (21)=C*SHAPE(9)                                             CS-30623
      SHAPE (22)=C**2*SHAPE(9)                                          CS-30624
      SHAPE(23)=C*SHAPE(10)                                             CS-30625
      SHAPE (24)=C*SHAPE(11)                                            CS-30626
      GO TO 53                                                          CS-30627
C CALCULATE SHAPE COEFFICIENTS FOR STRAIGHT MEMBER                      CS-30628
   52 C1=SINF(2.*DATA(I,2))/24.                                         CS-30629
      C2=(SINF(DATA(I,2))**2)/12.                                       CS-30630
      C3=(COSF(DATA(I,2))**2)/12.                                       CS-30631
      SHAPE(1)=Q*DATA(I,3)                                              CS-30632
      SHAPE(2)=AMID*SHAPE(1)                                            CS-30633
      SHAPE(3)=BMID*SHAPE(1)                                            CS-30634
      SHAPE(4)=(DATA(I,3)**2*C1+AMID*BMID)*SHAPE(1)                     CS-30635
      SHAPE(5)=(DATA(I,3)**2*C3+AMID**2)*SHAPE(1)                       CS-30636
      SHAPE(6)=(DATA(I,3)**2*C2+BMID**2)*SHAPE(1)                       CS-30637
      SHAPE(7)=(3.6*C2+1.)*SHAPE(1)                                     CS-30638
      SHAPE(8)=(3.6*C3+1.)*SHAPE(1)                                     CS-30639
      SHAPE(9)=3.6*C1*SHAPE(1)                                          CS-30640
      SHAPE(10)=AMID*SHAPE(7)-BMID*SHAPE(9)                             CS-30641
      SHAPE(11)=BMID*SHAPE(8)-AMID*SHAPE(9)                             CS-30642
      SHAPE(12)=AMID*SHAPE(10)+BMID*SHAPE(11)+(DATA(I,3)**2/12.)*SHAPE(1CS-30643
     1)                                                                 CS-30644
      SHAPE(13)=2.6*RMF*SHAPE(1)                                        CS-30645
      SHAPE(14)=RMF*(25.2*C3+0.5)*SHAPE(1)                              CS-30646
      SHAPE(15)=RMF*(25.2*C2+0.5)*SHAPE(1)                              CS-30647
      SHAPE(16)=RMF*25.2*C1*SHAPE(1)                                    CS-30648
      SHAPE(17)=C*SHAPE(7)                                              CS-30649
      SHAPE(18)=C**2*SHAPE(7)                                           CS-30650
      SHAPE(19)=C*SHAPE(8)                                              CS-30651
      SHAPE(20)=C**2*SHAPE(8)                                           CS-30652
      SHAPE(21)=C*SHAPE(9)                                              CS-30653
      SHAPE(22)=C**2*SHAPE(9)                                           CS-30654
      SHAPE(23)=C*SHAPE(10)                                             CS-30655
      SHAPE(24)=C*SHAPE(11)                                             CS-30656
   53 IF(DATA(I,1)-2.)54,55,56                                          CS-30657
C X-PLANE SUMMATIONS OF SHAPE COEFFICIENTS                              CS-30658
   54 BLOCK(1)=BLOCK(1)+SHAPE(1)                                        CS-30659
      BLOCK(5)=BLOCK(5)+SHAPE(3)                                        CS-30660
      BLOCK(6)=BLOCK(6)+(-SHAPE(2))                                     CS-30661
      BLOCK(7)=BLOCK(7)+SHAPE(8)                                        CS-30662
      BLOCK(8)=BLOCK(8)+SHAPE(9)                                        CS-30663
      BLOCK(9)=BLOCK(9)+(-SHAPE(11))                                    CS-30664
      BLOCK(10)=BLOCK(10)+(-SHAPE(21))                                  CS-30665
      BLOCK(11)=BLOCK(11)+SHAPE(19)                                     CS-30666
      BLOCK(12)=BLOCK(12)+SHAPE(7)                                      CS-30667
      BLOCK(13)=BLOCK(13)+SHAPE(10)                                     CS-30668
      BLOCK(14)=BLOCK(14)+(-SHAPE(17))                                  CS-30669
      BLOCK(15)=BLOCK(15)+SHAPE(21)                                     CS-30670
      BLOCK(16)=BLOCK(16)+SHAPE(12)+SHAPE(13)                           CS-30671
      BLOCK(17)=BLOCK(17)+(-SHAPE(23))                                  CS-30672
      BLOCK(18)=BLOCK(18)+(-SHAPE(24))                                  CS-30673
      BLOCK(19)=BLOCK(19)+SHAPE(6)+SHAPE(15)+SHAPE(18)                  CS-30674
      BLOCK(20)=BLOCK(20)+(-SHAPE(4))-SHAPE(16)+(-SHAPE(22))            CS-30675
      BLOCK(21)=BLOCK(21)+SHAPE(5)+SHAPE(14)+SHAPE(20)                  CS-30676
      EXPAN2=EXPAN2+12.*V3*DATA(I,6)*DISTA                              CS-30677
      EXPAN3=EXPAN3+12.*V3*DATA(I,6)*DISTB                              CS-30678
      GO TO 57                                                          CS-30679
C COMPUTE Y-PLANE SUMMATIONS OF SHAPE COEFFICIENTS                      CS-30680
   55 BLOCK(1)=BLOCK(1)+SHAPE(7)                                        CS-30681
      BLOCK(3)=BLOCK(3)+SHAPE(9)                                        CS-30682
      BLOCK(4)=BLOCK(4)+SHAPE(21)                                       CS-30683
      BLOCK(5)=BLOCK(5)+SHAPE(10)                                       CS-30684
      BLOCK(6)=BLOCK(6)+(-SHAPE(17))                                    CS-30685
      BLOCK(7)=BLOCK(7)+SHAPE(1)                                        CS-30686
      BLOCK(9)=BLOCK(9)+(-SHAPE(2))                                     CS-30687
      BLOCK(11)=BLOCK(11)+SHAPE(3)                                      CS-30688
      BLOCK(12)=BLOCK(12)+SHAPE(8)                                      CS-30689
      BLOCK(13)=BLOCK(13)+SHAPE(19)                                     CS-30690
      BLOCK(14)=BLOCK(14)+(-SHAPE(11))                                  CS-30691
      BLOCK(15)=BLOCK(15)+(-SHAPE(21))                                  CS-30692
      BLOCK(16)=BLOCK(16)+SHAPE(5)+SHAPE(14)+SHAPE(20)                  CS-30693
      BLOCK(17)=BLOCK(17)+(-SHAPE(24))                                  CS-30694
      BLOCK(18)=BLOCK(18)+(-SHAPE(4))-SHAPE(16)+(-SHAPE(22))            CS-30695
      BLOCK(19)=BLOCK(19)+SHAPE(12)+SHAPE(13)                           CS-30696
      BLOCK(20)=BLOCK(20)+(-SHAPE(23))                                  CS-30697
      BLOCK(21)=BLOCK(21)+SHAPE(6)+SHAPE(15)+SHAPE(18)                  CS-30698
      EXPAN1=EXPAN1+12.*V3*DATA(I,6)*DISTB                              CS-30699
      EXPAN3=EXPAN3+12.*V3*DATA(I,6)*DISTA                              CS-30700
      GO TO 57                                                          CS-30701
C COMPUTE Z-PLANE SUMMATIONS OF SHAPE COEFFICIENTS                      CS-30702
   56 BLOCK(1)=BLOCK(1)+SHAPE(8)                                        CS-30703
      BLOCK(2)=BLOCK(2)+SHAPE(9)                                        CS-30704
      BLOCK(4)=BLOCK(4)+(-SHAPE(21))                                    CS-30705
      BLOCK(5)=BLOCK(5)+SHAPE(19)                                       CS-30706
      BLOCK(6)=BLOCK(6)+(-SHAPE(11))                                    CS-30707
      BLOCK(7)=BLOCK(7)+SHAPE(7)                                        CS-30708
      BLOCK(9)=BLOCK(9)+(-SHAPE(17))                                    CS-30709
      BLOCK(10)=BLOCK(10)+SHAPE(21)                                     CS-30710
      BLOCK(11)=BLOCK(11)+SHAPE(10)                                     CS-30711
      BLOCK(12)=BLOCK(12)+SHAPE(1)                                      CS-30712
      BLOCK(13)=BLOCK(13)+SHAPE(3)                                      CS-30713
      BLOCK(14)=BLOCK(14)+(-SHAPE(2))                                   CS-30714
      BLOCK(16)=BLOCK(16)+SHAPE(6)+SHAPE(15)+SHAPE(18)                  CS-30715
      BLOCK(17)=BLOCK(17)+(-SHAPE(4))-SHAPE(16)+(-SHAPE(22))            CS-30716
      BLOCK(18)=BLOCK(18)+(-SHAPE(23))                                  CS-30717
      BLOCK(19)=BLOCK(19)+SHAPE(5)+SHAPE(14)+SHAPE(20)                  CS-30718
      BLOCK(20)=BLOCK(20)+(-SHAPE(24))                                  CS-30719
      BLOCK(21)=BLOCK(21)+SHAPE(12)+SHAPE(13)                           CS-30720
      EXPAN1=EXPAN1+12.*V3*DATA(I,6)*DISTA                              CS-30721
      EXPAN2=EXPAN2+12.*V3*DATA(I,6)*DISTB                              CS-30722
   57 RETURN                                                            CS-30723
      END(1,2,2,2,2)                                                    CS-30724
C                                                                           0725
