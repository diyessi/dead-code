      BFY=VALUE3(11)                                                    CS-30769
      BFZ=VALUE3(12)                                                    CS-30770
  350 REACT(1)=-(AFY*QUEST(3)-AFZ*QUEST(2)+AMX)                         CS-30771
      REACT(2)=-(AFZ*QUEST(1)-AFX*QUEST(3)+AMY)                         CS-30772
      REACT(3)=-(AFX*QUEST(2)-AFY*QUEST(1)+AMZ)                         CS-30773
      REACT(4)=-AFX                                                     CS-30774
      REACT(5)=-AFY                                                     CS-30775
      REACT(6)=-AFZ                                                     CS-30776
      IF(COUNTJ)359,351,359                                             CS-30777
  351 WRITE OUTPUT TAPE 6,9                                             CS-30778
    9 FORMAT(1H1,48X,34HPIPE FLEXIBILITY ANALYSIS   TVCS-3)             CS-30779
      WRITE OUTPUT TAPE 6,1,(TITLE(I),I=1,12)                           CS-30780
    1 FORMAT(12A6)                                                      CS-30781
      WRITE OUTPUT TAPE 6,352                                           CS-30782
  352 FORMAT(1H0,44X,41HSIMULTANEOUS EQUATION CONSTANTS AND CHECK/47X,9HCS-30783
     1CONSTANTS,23X,5HCHECK)                                            CS-30784
      DO 353 I=1,6                                                      CS-30785
  353 WRITE OUTPUT TAPE 6,354,A1(I,7),CHECK(I)                          CS-30786
  354 FORMAT(36X,F20.3,10X,F20.3)                                       CS-30787
      SUMMX1=AMX                                                        CS-30788
      SUMMX2=AMY                                                        CS-30789
      SUMMX3=AMZ                                                        CS-30790
      SUMFX1=AFX                                                        CS-30791
      SUMFX2=AFY                                                        CS-30792
      SUMFX3=AFZ                                                        CS-30793
      WRITE OUTPUT TAPE 6,9                                             CS-30794
      WRITE OUTPUT TAPE 6,1,(TITLE(I),I=1,12)                           CS-30795
      WRITE OUTPUT TAPE 6,355                                           CS-30796
  355 FORMAT(1H0,46X,37HMOMENTS AND FORCES OF PIPE ON POINT 0/13X,102HMXCS-30797
     1                  MY                  MZ                  FX      CS-30798
     2            FY                  FZ)                               CS-30799
      WRITE OUTPUT TAPE 6,356,SUMMX1,SUMMX2,SUMMX3,SUMFX1,SUMFX2,SUMFX3 CS-30800
  356 FORMAT(F18.3,5F20.3)                                              CS-30801
      WRITE OUTPUT TAPE 6,357                                           CS-30802
  357 FORMAT(1H0,44X,42HFREE ENDS---COORDINATES + EXPANSION VALUES/14X,1CS-30803
     1HX,19X,1HY,19X,1HZ,16X,4HEIDX,16X,4HEIDY,16X,4HEIDZ)              CS-30804
      WRITE OUTPUT TAPE 6,356,QUEST(1),QUEST(2),QUEST(3),(A1(J,7),J=4,6)CS-30805
      WRITE OUTPUT TAPE 6,358                                           CS-30806
  358 FORMAT(1H0,51X,28HREACTIONS OF PIPE ON ANCHORS/13X,102HMX         CS-30807
     1         MY                  MZ                  FX               CS-30808
     2   FY                  FZ)                                        CS-30809
      WRITE OUTPUT TAPE 6,356,(REACT(I),I=1,6)                          CS-30810
      GO TO 364                                                         CS-30811
  359 REACT(7)=-(BFY*QUEST(6)-BFZ*QUEST(5)+BMX)                         CS-30812
      REACT(8)=-(BFZ*QUEST(4)-BFX*QUEST(6)+BMY)                         CS-30813
      REACT(9)=-(BFX*QUEST(5)-BFY*QUEST(4)+BMZ)                         CS-30814
      REACT(10)=-BFX                                                    CS-30815
      REACT(11)=-BFY                                                    CS-30816
      REACT(12)=-BFZ                                                    CS-30817
      WRITE OUTPUT TAPE6,9                                              CS-30818
      WRITE OUTPUT TAPE 6,1,(TITLE(I),I=1,12)                           CS-30819
      WRITE OUTPUT TAPE6,352                                            CS-30820
      DO 360 I=1,12                                                     CS-30821
  360 WRITE OUTPUT TAPE 6,354,A2(I,13),CHECK(I)                         CS-30822
      SUMMX1=AMX+BMX                                                    CS-30823
      SUMMX2=AMY+BMY                                                    CS-30824
      SUMMX3=AMZ+BMZ                                                    CS-30825
      SUMFX1=AFX+BFX                                                    CS-30826
      SUMFX2=AFY+BFY                                                    CS-30827
      SUMFX3=AFZ+BFZ                                                    CS-30828
      WRITE OUTPUT TAPE 6,9                                             CS-30829
      WRITE OUTPUT TAPE 6,1,(TITLE(I),I=1,12)                           CS-30830
      WRITE OUTPUT TAPE 6,355                                           CS-30831
      WRITE OUTPUT TAPE 6,356,SUMMX1,SUMMX2,SUMMX3,SUMFX1,SUMFX2,SUMFX3 CS-30832
      WRITE OUTPUT TAPE 6,357                                           CS-30833
      WRITE OUTPUT TAPE 6,356,(QUEST(I),I=1,3),(A2(J,13),J=4,6)         CS-30834
      WRITE OUTPUT TAPE 6,356,(QUEST(I),I=4,6),(A2(J,13),J=10,12)       CS-30835
      WRITE OUTPUT TAPE 6,358                                           CS-30836
      WRITE OUTPUT TAPE 6,356,(REACT(I),I=1,6)                          CS-30837
      WRITE OUTPUT TAPE 6,356,(REACT(I),I=7,12)                         CS-30838
  364 COORDX=0.                                                         CS-30839
      COORDY=0.                                                         CS-30840
      COORDZ=0.                                                         CS-30841
      DO 365 I=1,21                                                     CS-30842
  365 BLOCK(I)=0.                                                       CS-30843
      COUNTS=0.                                                         CS-30844
      COUNTA=0.                                                         CS-30845
      DO 400 I=2,NCRDS                                                  CS-30846
      III=I                                                             CS-30847
  377 IF(DATA(I,1))366,380,366                                          CS-30848
  366 IF(DATA(I,1)-50.)368,367,368                                      CS-30849
  367 SUMMX1=AMX                                                        CS-30850
      SUMMX2=AMY                                                        CS-30851
      SUMMX3=AMZ                                                        CS-30852
      SUMFX1=AFX                                                        CS-30853
      SUMFX2=AFY                                                        CS-30854
      SUMFX3=AFZ                                                        CS-30855
      EXPAJ1=COORDX                                                     CS-30856
      EXPAJ2=COORDY                                                     CS-30857
      EXPAJ3=COORDZ                                                     CS-30858
      GO TO 400                                                         CS-30859
  368 COUNTS=COUNTS+1.                                                  CS-30860
      CALL CALC                                                         CS-30861
      IF(DATA(I,7))370,369,370                                          CS-30862
  370 BETA=0.9*(CUBERTF(RMI/(12.*DATA(I,5)*DATA(I,3)))**2)              CS-30863
      IF(BETA-1.)369,371,371                                            CS-30864
  369 BETA=1.                                                           CS-30865
  371 IF(DATA(I,1)-2.)372,373,374                                       CS-30866
  372 ONEMB=COORDZ*SUMFX2+SUMMX1-COORDY*SUMFX3                          CS-30867
      ONEM=COORDX*SUMFX3+SUMMX2-COORDZ*SUMFX1                           CS-30868
      TWOM=COORDY*SUMFX1+SUMMX3-COORDX*SUMFX2                           CS-30869
      GO TO 375                                                         CS-30870
  373 ONEMB=COORDX*SUMFX3+SUMMX2-COORDZ*SUMFX1                          CS-30871
      ONEM=COORDY*SUMFX1+SUMMX3-COORDX*SUMFX2                           CS-30872
      TWOM=COORDZ*SUMFX2+SUMMX1-COORDY*SUMFX3                           CS-30873
      GO TO 375                                                         CS-30874
  374 ONEMB=COORDY*SUMFX1+SUMMX3-COORDX*SUMFX2                          CS-30875
      ONEM=COORDZ*SUMFX2+SUMMX1-COORDY*SUMFX3                           CS-30876
      TWOM=COORDX*SUMFX3+SUMMX2-COORDZ*SUMFX1                           CS-30877
C COMPUTE STRESS                                                        CS-30878
  375 STRESS= 12.*SQRTF(4.*((DATA(I,4)/(4.*YINERT)*(ONEM*COSF(DATA(I,2))CS-30879
     1+TWOM*SINF(DATA(I,2))))**2)+(BETA*DATA(I,4)/(2.*YINERT)*(ONEM*SINFCS-30880
     2(DATA(I,2))-TWOM*COSF(DATA(I,2))))**2+((BETA*DATA(I,4)*ONEMB)/(2.*CS-30881
     3YINERT))**2)                                                      CS-30882
      IF(COUNTS-1.)378,376,378                                          CS-30883
  376 CALL CALC2                                                        CS-30884
      DATA(I,12)=STRESS                                                 CS-30885
      GO TO 377                                                         CS-30886
  378 DATA(I,13)=STRESS                                                 CS-30887
      COUNTS=0.                                                         CS-30888
      GO TO 400                                                         CS-30889
  380 COUNTA=COUNTA+1.                                                  CS-30890
      IF(COUNTJ)381,500,381                                             CS-30891
  381 IF(COUNTA-1.)500,382,500                                          CS-30892
  382 SUMMX1=BMX                                                        CS-30893
      SUMMX2=BMY                                                        CS-30894
      SUMMX3=BMZ                                                        CS-30895
      SUMFX1=BFX                                                        CS-30896
      SUMFX2=BFY                                                        CS-30897
      SUMFX3=BFZ                                                        CS-30898
      COORDX=EXPAJ1                                                     CS-30899
      COORDY=EXPAJ2                                                     CS-30900
      COORDZ=EXPAJ3                                                     CS-30901
  400 CONTINUE                                                          CS-30902
  500 COORDX=0.                                                         CS-30903
      COORDY=0.                                                         CS-30904
      COORDZ=0.                                                         CS-30905
      EXPAN1=0.                                                         CS-30906
      EXPAN2=0.                                                         CS-30907
      EXPAN3=0.                                                         CS-30908
      DO 501 I=1,21                                                     CS-30909
  501 BLOCK(I)=0.                                                       CS-30910
      COUNTA=0.                                                         CS-30911
      COUNTS=0.                                                         CS-30912
      L=0                                                               CS-30913
      I=2                                                               CS-30914
  535 IF(DATA(I,1)-50.)502,503,502                                      CS-30915
  502 IF(DATA(I,1))511,600,511                                          CS-30916
  503 XJA1=COORDX                                                       CS-30917
      YJA1=COORDY                                                       CS-30918
      ZJA1=COORDZ                                                       CS-30919
      EXPAJ1=EXPAN1                                                     CS-30920
      EXPAJ2=EXPAN2                                                     CS-30921
      EXPAJ3=EXPAN3                                                     CS-30922
C COMPUTE SIDE VALUES                                                   CS-30923
      DO 504 K=1,6                                                      CS-30924
  504 SIDE(K)=144.*(AMX*BLOCJ(K,1)+AMY*BLOCJ(K,2)+AMZ*BLOCJ(K,3)+AFX*BLOCS-30925
     1CJ(K,4)+AFY*BLOCJ(K,5)+AFZ*BLOCJ(K,6))                            CS-30926
      DO 505 K=7,12                                                     CS-30927
      KK=K-6                                                            CS-30928
  505 SIDE(K)=144.*(BMX*BLOCJ(KK,1)+BMY*BLOCJ(KK,2)+BMZ*BLOCJ(KK,3)+BFX*CS-30929
     1BLOCJ(KK,4)+BFY*BLOCJ(KK,5)+BFZ*BLOCJ(KK,6))                      CS-30930
  506 I=I+1                                                             CS-30931
      IF(DATA(I,1))510,507,510                                          CS-30932
  507 IF(DATA(I,2)-3.)508,600,508                                       CS-30933
  508 DO 509 J=1,21                                                     CS-30934
  509 BLOCK(J)=STORJ(J)                                                 CS-30935
      EXPAN3=EXPAJ3                                                     CS-30936
      EXPAN2=EXPAJ2                                                     CS-30937
      EXPAN1=EXPAJ1                                                     CS-30938
      COORDZ=ZJA1                                                       CS-30939
      COORDY=YJA1                                                       CS-30940
      COORDX=XJA1                                                       CS-30941
      COUNTA=1.                                                         CS-30942
      GO TO 506                                                         CS-30943
  510 COUNTD=3.                                                         CS-30944
      GO TO 512                                                         CS-30945
  511 COUNTD=1.                                                         CS-30946
  512 III=I                                                             CS-30947
      CALL CALC3                                                        CS-30948
      IF(COUNTA-1.)513,514,513                                          CS-30949
  513 EQUAT(1)=AMX                                                      CS-30950
      EQUAT(2)=AMY                                                      CS-30951
      EQUAT(3)=AMZ                                                      CS-30952
      EQUAT(4)=AFX                                                      CS-30953
      EQUAT(5)=AFY                                                      CS-30954
      EQUAT(6)=AFZ                                                      CS-30955
      GO TO 515                                                         CS-30956
  514 EQUAT(1)=BMX                                                      CS-30957
      EQUAT(2)=BMY                                                      CS-30958
      EQUAT(3)=BMZ                                                      CS-30959
      EQUAT(4)=BFX                                                      CS-30960
      EQUAT(5)=BFY                                                      CS-30961
      EQUAT(6)=BFZ                                                      CS-30962
C COMPUTE TOTAL VALUES                                                  CS-30963
  515 TOTAL(1)=144.*(BLOCK(1)*EQUAT(1)+BLOCK(2)*EQUAT(2)+BLOCK(3)*EQUAT(CS-30964
     13)+BLOCK(4)*EQUAT(4)+BLOCK(5)*EQUAT(5)+BLOCK(6)*EQUAT(6))         CS-30965
      TOTAL(2)=144.*(BLOCK(2)*EQUAT(1)+BLOCK(7)*EQUAT(2)+BLOCK(8)*EQUAT(CS-30966
     13)+BLOCK(9)*EQUAT(4)+BLOCK(10)*EQUAT(5)+BLOCK(11)*EQUAT(6))       CS-30967
      TOTAL(3)=144.*(BLOCK(3)*EQUAT(1)+BLOCK(8)*EQUAT(2)+BLOCK(12)*EQUATCS-30968
     1(3)+BLOCK(13)*EQUAT(4)+BLOCK(14)*EQUAT(5)+BLOCK(15)*EQUAT(6))     CS-30969
      TOTAL(4)=144.*(BLOCK(4)*EQUAT(1)+BLOCK(9)*EQUAT(2)+BLOCK(13)*EQUATCS-30970
     1(3)+BLOCK(16)*EQUAT(4)+BLOCK(17)*EQUAT(5)+BLOCK(18)*EQUAT(6))     CS-30971
      TOTAL(5)=144.*(BLOCK(5)*EQUAT(1)+BLOCK(10)*EQUAT(2)+BLOCK(14)*EQUACS-30972
     1T(3)+BLOCK(17)*EQUAT(4)+BLOCK(19)*EQUAT(5)+BLOCK(20)*EQUAT(6))    CS-30973
      TOTAL(6)=144.*(BLOCK(6)*EQUAT(1)+BLOCK(11)*EQUAT(2)+BLOCK(15)*EQUACS-30974
     1T(3)+BLOCK(18)*EQUAT(4)+BLOCK(20)*EQUAT(5)+BLOCK(21)*EQUAT(6))    CS-30975
      IF(COUNTD-1.)519,517,519                                          CS-30976
  517 DO 518 J=1,6                                                      CS-30977
  518 TOTAM(J)=TOTAL(J)                                                 CS-30978
      COUNTD=2.                                                         CS-30979
      GO TO 514                                                         CS-30980
  519 IF(COUNTD-2.)520,525,520                                          CS-30981
  520 COUNT=1.                                                          CS-30982
      IF(COUNTA)523,521,523                                             CS-30983
  521 DO 522 J=1,6                                                      CS-30984
      JJ=J+6                                                            CS-30985
  522 TOTAM(J)=SIDE(JJ)                                                 CS-30986
      GO TO 526                                                         CS-30987
  523 DO 524 J=1,6                                                      CS-30988
  524 TOTAM(J)=SIDE(J)                                                  CS-30989
      GO TO 526                                                         CS-30990
  525 COUNT=0.                                                          CS-30991
C CALCULATE DEFLEC                                                      CS-30992
  526 DEFLEC(1)=((TOTAL(1)+TOTAM(1))/EI-DATA(1,6))*(180./3.14159)       CS-30993
      DEFLEC(2)=((TOTAL(2)+TOTAM(2))/EI-DATA(1,7))*(180./3.14159)       CS-30994
      DEFLEC(3)=((TOTAL(3)+TOTAM(3))/EI-DATA(1,8))*(180./3.14159)       CS-30995
      DEFLEC(4)=(12./EI)*(TOTAL(4)+TOTAM(4))-(3.14159*DATA(I,10)*DEFLEC(CS-30996
     13)/15.-3.14159*DATA(I,11)*DEFLEC(2)/15.-EXPAN1-DATA(1,3))         CS-30997
      DEFLEC(5)=(12./EI)*(TOTAL(5)+TOTAM(5))-(3.14159*DATA(I,11)*DEFLEC(CS-30998
     11)/15.-3.1459*DATA(I,9)*DEFLEC(3)/15.-EXPAN2-DATA(1,4))           CS-30999
      DEFLEC(6)=(12./EI)*(TOTAL(6)+TOTAM(6))-(3.14159*DATA(I,9)*DEFLEC(2CS-31000
     1)/15.-3.14159*DATA(I,10)*DEFLEC(1)/15.-EXPAN3-DATA(1,5))          CS-31001
      L=L+1                                                             CS-31002
      DO 527 J=1,6                                                      CS-31003
  527 XLASTO(L,J)=DEFLEC(J)                                             CS-31004
      IF(COUNT-1.)530,506,530                                           CS-31005
  530 I=I+1                                                             CS-31006
      GO TO 535                                                         CS-31007
  600 WRITE OUTPUT TAPE 6,601                                           CS-31008
  601 FORMAT(1H0,24X,77HPOINT      STRESS     PHI X     PHI Y     PHI Z CS-31009
     1  DELTA X   DELTA Y   DELTA Z)                                    CS-31010
      DATA(1,6)=DATA(1,6)/.01745329                                     CS-31011
      DATA(1,7)=DATA(1,7)/.01745329                                     CS-31012
      DATA(1,8)=DATA(1,8)/.01745329                                     CS-31013
      WRITE OUTPUT TAPE 6,602,DATA(2,12),(DATA(1,J),J=6,8),(DATA(1,J),J=CS-31014
     13,5)                                                              CS-31015
  602 FORMAT(26X,1H0,5X,F10.2,6F10.3)                                   CS-31016
C  PRINTOUT OF STRESSES, PHI AND DELTA VALUES OF EACH MEMBER            CS-31017
      N=1                                                               CS-31018
      DO 700 I=2,NCRDS                                                  CS-31019
      L=I-N                                                             CS-31020
      IF(DATA(I,1))603,606,603                                          CS-31021
  603 IF( DATA(I,1)-50.)604,611,604                                     CS-31022
  604 WRITE OUTPUT TAPE 6,605,L,DATA(I,13),(XLASTO(L,J),J=1,6)          CS-31023
  605 FORMAT(25X,I2,5X,F10.2,6F10.3)                                    CS-31024
      GO TO 700                                                         CS-31025
  606 K=I-1                                                             CS-31026
      DATA(I,6)=DATA(I,6)/.01745329                                     CS-31027
      DATA(I,7)=DATA(I,7)/.01745329                                     CS-31028
      DATA(I,8)=DATA(I,8)/.01745329                                     CS-31029
      WRITE OUTPUT TAPE 6,607,DATA(K,13),(DATA(I,J),J=6,8),(DATA(I,J),J=CS-31030
     13,5)                                                              CS-31031
  607 FORMAT(1H0,25X,6HANCHOR,F10.2,6F10.3)                             CS-31032
      IF(DATA(I,2)-3.)609,608,609                                       CS-31033
  608 RETURN                                                            CS-31034
  609 IF(COUNTJ)610,608,610                                             CS-31035
  610 N=3                                                               CS-31036
      GO TO 700                                                         CS-31037
  611 K=I-1                                                             CS-31038
      WRITE OUTPUT TAPE 6,612,DATA(K,13)                                CS-31039
  612 FORMAT(1H0,25X,8HJUNCTION,F10.2)                                  CS-31040
      N=2                                                               CS-31041
  700 CONTINUE                                                          CS-31042
      RETURN                                                            CS-31043
      END(1,2,2,2,2)                                                    CS-31044
