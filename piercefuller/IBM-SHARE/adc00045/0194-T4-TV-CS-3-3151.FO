      VALUE2(3)=EI*((DATA(I,8)-DATA(1,8))/144.)                         CS-30237
      VALUE2(4)=EI*((-EXPAN1+DATA(I,3)-DATA(1,3))/1728.-(DATA(I,7)*COORDCS-30238
     1Z)/144.+(DATA(I,8)*COORDY)/144.)                                  CS-30239
      VALUE2(5)=EI*((-EXPAN2+DATA(I,4)-DATA(1,4))/1728.-(DATA(I,8)*COORDCS-30240
