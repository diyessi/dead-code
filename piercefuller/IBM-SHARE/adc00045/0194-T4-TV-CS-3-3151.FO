      SUBROUTINE PHASE2                                                 CS-30733
      DIMENSION DATA(200,13),TITLE(12),BLOCK(21),TAN(21),BROWN(21),A1(6,CS-30734
     17),A2(12,13),TEMP(12,12),ANCO1(21),ANCO2(21),BLOCJ(6,6),AJA1(6,6),CS-30735
