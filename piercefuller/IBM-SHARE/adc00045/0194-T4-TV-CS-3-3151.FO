      AFY=VALUE1(5)                                                     CS-30750
      AFZ=VALUE1(6)                                                     CS-30751
      BMX=0.                                                            CS-30752
      BMY=0.                                                            CS-30753
      BMZ=0.                                                            CS-30754
      BFX=0.                                                            CS-30755
      BFY=0.                                                            CS-30756
      BFZ=0.                                                            CS-30757
      GO TO 350                                                         CS-30758
  340 AMX=VALUE3(1)                                                     CS-30759
      AMY=VALUE3(2)                                                     CS-30760
      AMZ=VALUE3(3)                                                     CS-30761
      AFX=VALUE3(4)                                                     CS-30762
      AFY=VALUE3(5)                                                     CS-30763
