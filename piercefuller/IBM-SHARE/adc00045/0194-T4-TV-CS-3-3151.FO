     4UAT(6),TOTAM(6),XLASTO(200,6)                                     CS-30738
      COMMON XPID,DATA,RMI,RMF,XINERT,YINERT,Q,A,B,C,COORDX,COORDY,COORDCS-30739
     1Z,AMID,DISTA,BMID,DISTB,      EXPAN1,EXPAN2,EXPAN3,V3,III,TITLE,BLCS-30740
     2OCK,TAN,BROWN,A1,A2,TEMP,ANCO1,ANCO2,BLOCJ,AJA1,AJA2,VALUE1,VALUE2CS-30741
     3,VALUE3,CHECK,BFLEX,STORJ,SHAPE,QUEST,REACT,DEFLEC,TOTAL,SIDE,EQUACS-30742
     4T,TOTAM,XLASTO,COUNTP,COUNTD,COUNTJ,COUNTS,COUNTA,NCRDS,EXPAJ1,EXPCS-30743
     5AJ2,EXPAJ3,EXPAN1,EXPAN2,EXPAN3,XJA1,YJA1,ZJA1,EI                 CS-30744
      IF(COUNTJ)340,330,340                                             CS-30745
  330 AMX=VALUE1(1)                                                     CS-30746
