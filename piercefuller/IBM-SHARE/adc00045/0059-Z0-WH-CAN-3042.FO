      SUBROUTINE INIT(A,AA,AAA,B,BB,BBB,C,CC,CCC,D,DD,DDD,POINT,E,EE)   CAN 1030
      DIMENSION POINT(14)                                               CAN 1031
C BUILDS A FORMAT FOR SUBROUTINE PLOT                                   CAN 1032
      POINT(1)=B                                                        CAN 1033
      POINT(2)=BB                                                       CAN 1034
      POINT(3)=BBB                                                      CAN 1035
      POINT(4)=C                                                        CAN 1036
      POINT(5)=CC                                                       CAN 1037
      POINT(6)=CCC                                                      CAN 1038
      POINT(7)=D                                                        CAN 1039
      POINT(8)=A                                                        CAN 1040
      POINT(9)=AA                                                       CAN 1041
      POINT(10)=AAA                                                     CAN 1042
      POINT(11)=DD                                                      CAN 1043
      POINT(12)=DDD                                                     CAN 1044
      POINT(13)=E                                                       CAN 1045
      POINT(14)=EE                                                      CAN 1046
      RETURN                                                            CAN 1047
      END                                                               CAN 1048
      SUBROUTINE BULD (H1,H2,H3,H4,H5,H6,H7,H8,H9,H10,H11,NH,G1,G2,G3)  CAN 1049
      DIMENSION H(11)                                                   CAN 1050
C FORMAT BUILDING                                                       CAN 1051
      H(1) =H1                                                          CAN 1052
      H(2) =H2                                                          CAN 1053
      H(3) =H3                                                          CAN 1054
      H(4) =H4                                                          CAN 1055
      H(5) =H5                                                          CAN 1056
      H(6) =H6                                                          CAN 1057
      H(7) =H7                                                          CAN 1058
      H(8) =H8                                                          CAN 1059
      H(9) =H9                                                          CAN 1060
      H(10)=H10                                                         CAN 1061
      H(11)=H11                                                         CAN 1062
      IF (NH-10) 1,1,2                                                  CAN 1063
1     NXX =1                                                            CAN 1064
      NC =0                                                             CAN 1065
5     IF(NH-NXX) 4,3,3                                                  CAN 1066
3     NC=NC+1                                                           CAN 1067
      NXX=NXX+1                                                         CAN 1068
       GO TO 5                                                          CAN 1069
4     IF(NC-10)20,19,19                                                 CAN 1070
19     G1=H11                                                           CAN 1071
      G2=H(1)                                                           CAN 1072
      G3=H(10)                                                          CAN 1073
      GO TO 18                                                          CAN 1074
20    G1=H11                                                            CAN 1075
      G2=H11                                                            CAN 1076
      G3=H(NC)                                                          CAN 1077
      GO TO 18                                                          CAN 1078
2     NXX =10                                                           CAN 1079
      MC=0                                                              CAN 1080
      NC=0                                                              CAN 1081
6     IF (NH-NXX) 7,8,8                                                 CAN 1082
8     MC =MC+1                                                          CAN 1083
      NXX=NXX+10                                                        CAN 1084
      GO TO 6                                                           CAN 1085
7      NXX=10*MC                                                        CAN 1086
9      IF(NH-NXX) 10,10,11                                              CAN 1087
11    NC=NC+1                                                           CAN 1088
      NXX=NXX+1                                                         CAN 1089
      GO TO 9                                                           CAN 1090
10     IF(MC-10) 12,13,14                                               CAN 1091
13    G1=H(1)                                                           CAN 1092
      G2=H(10)                                                          CAN 1093
      GO TO 15                                                          CAN 1094
12    G1=H11                                                            CAN 1095
      G2=H(MC)                                                          CAN 1096
      GO TO 15                                                          CAN 1097
14     G1=H1                                                            CAN 1098
      G2=H1                                                             CAN 1099
15     IF(NC) 16,16,17                                                  CAN 1100
16    NC=10                                                             CAN 1101
17    G3=H(NC)                                                          CAN 1102
18    RETURN                                                            CAN 1103
      END                                                               CAN 1104
