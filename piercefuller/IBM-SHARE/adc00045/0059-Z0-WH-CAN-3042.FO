     1(EF1,E11,DEF1),(EF2,E12,DEF2),(Q1,C1,XP3),(Q2,C2,XM3),(C3,XP4),   CAN 0616
     2(C4,XP5),(B12,XM4),(PSI2,XM5),(T1,RS1),(T2,RS2),(V16,DEL),(V17,DR)CAN 0617
     3,(V18,HP1,H1),(V19,HP2,H2),(V20,HL1,AX1),(V22,HL2,AX2),(V51,AXA), CAN 0618
     4(V52,RSA),(V53,SI2),(V54,SI1),(V25,HA),(TI,SI3)                   CAN 0619
      NSTR=1                                                            CAN 0620
