633   ZLL=LL                                                            CAN 0965
634   WRITE OUTPUT TAPE JTAPE,1000,ZLL                                  CAN 0966
1000  FORMAT(1X,1PE9.2, 105H--------------------------------------------CAN 0967
     1--------------------------------------------------------       )  CAN 0968
      NL=NL-LNO                                                         CAN 0969
      GO TO 65                                                          CAN 0970
799   GO TO (800,797),MM                                                CAN 0971
800   IF(NZ2-LNA)810,820,820                                            CAN 0972
820   NZ2=NZ2-LNA                                                       CAN 0973
      NXV=NZ2                                                           CAN 0974
