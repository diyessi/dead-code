      SUBROUTINE PLOT(NCURVE,NOP,NA,NO,INS,X,Y1,Y2,Y3,Y4,IDENT,ABS,FCT) CAN 0766
      DIMENSION  X(51 ),Y1(51 ),Y2(51 ),Y3(51 ),Y4(51 ),Y(51 ,4),       CAN 0767
     2NY(51 ,4),NSF(5)                                                  CAN 0768
      DIMENSION POINT(14),FORMT(7),GORMT(12),DUM1(4),DUM2(4),D3(5),     CAN 0769
     1NX(51 ),NNN(4),IDENT(24),FCT(8),DD(4),ZNN(4), FTC(4),ABS(2)       CAN 0770
C PLOT ROUTINE                                                          CAN 0771
      JTAPE=6                                                           CAN 0772
      FTC(1)=FCT(2)                                                     CAN 0773
      FTC(2)=FCT(4)                                                     CAN 0774
      FTC(3)=FCT(6)                                                     CAN 0775
      FTC(4)=FCT(8)                                                     CAN 0776
      FCT(2)=FCT(3)                                                     CAN 0777
      FCT(3)=FCT(5)                                                     CAN 0778
      FCT(4)=FCT(7)                                                     CAN 0779
      DO 10 N=1,NCURVE                                                  CAN 0780
      GO TO (1,2,3,4),N                                                 CAN 0781
1     DO 6  I=1,NOP                                                     CAN 0782
6     Y(I,1) = Y1(I)                                                    CAN 0783
      GO TO 10                                                          CAN 0784
2     DO 7  I=1,NOP                                                     CAN 0785
7     Y(I,2)= Y2(I)                                                     CAN 0786
      GO TO 10                                                          CAN 0787
3     DO 8 I=1,NOP                                                      CAN 0788
8     Y(I,3)=Y3(I)                                                      CAN 0789
      GO TO 10                                                          CAN 0790
4     DO 9 I=1,NOP                                                      CAN 0791
9     Y(I,4)=Y4(I)                                                      CAN 0792
10    CONTINUE                                                          CAN 0793
      CALL INIT(4H(1H+,2HX,,1H),3H1H+,3H1H0,3H1H$,3H1H*,3HI5,,3HI5),1H(,CAN 0794
     15HE9.2,,5HE9.2),POINT, 4H20X,,4H16X,)                             CAN 0795
      FORMT(1)=POINT(8)                                                 CAN 0796
      FORMT(5)=POINT(9)                                                 CAN 0797
      FORMT(7)=POINT(10)                                                CAN 0798
      DO 11 J=1,NCURVE                                                  CAN 0799
      Z1=0.                                                             CAN 0800
      Z2=0.                                                             CAN 0801
      DO 12 I=1,NOP                                                     CAN 0802
      IF (Y(I,J))13,14,14                                               CAN 0803
14    IF(Y(I,J)-Z1)12,12,15                                             CAN 0804
15    Z1=Y(I,J)                                                         CAN 0805
      GO TO 12                                                          CAN 0806
13    IF(Y(I,J)-Z2)16,12,12                                             CAN 0807
16    Z2=Y(I,J)                                                         CAN 0808
12    CONTINUE                                                          CAN 0809
      DUM2(J)=Z1                                                        CAN 0810
11    DUM1(J)=Z2                                                        CAN 0811
      Z1=0.                                                             CAN 0812
      Z2=0.                                                             CAN 0813
      DO 17 I=1,NOP                                                     CAN 0814
      IF(X(I)) 18,19,19                                                 CAN 0815
19    IF(X(I)-Z1) 17,17,20                                              CAN 0816
20    Z1=X(I)                                                           CAN 0817
      GO TO 17                                                          CAN 0818
18    IF(X(I)-Z2) 160,17,17                                             CAN 0819
160   Z2=X(I)                                                           CAN 0820
17    CONTINUE                                                          CAN 0821
      D3(5)=Z1+ABSF(Z2)                                                 CAN 0822
      Z1=0.                                                             CAN 0823
      DO 53 J=1,NCURVE                                                  CAN 0824
      IF(DUM2(J)-Z1)53,53,531                                           CAN 0825
531   Z1=DUM2(J)                                                        CAN 0826
      NN=J                                                              CAN 0827
53    CONTINUE                                                          CAN 0828
      YMAX=Z1                                                           CAN 0829
      Z1=0.                                                             CAN 0830
      DO 59 J=1,NCURVE                                                  CAN 0831
      IF(DUM1(J)-Z1) 533,59,59                                          CAN 0832
533   Z1=DUM1(J)                                                        CAN 0833
59    CONTINUE                                                          CAN 0834
      YMIN=Z1                                                           CAN 0835
      SS=NO                                                             CAN 0836
       SS=SS-2.                                                         CAN 0837
      IF(YMAX)  191,191,190                                             CAN 0838
191   IF(YMIN)  190,192,192                                             CAN 0839
192   DO 5   J=1,4                                                      CAN 0840
5     D3(J)=1.                                                          CAN 0841
      NPLU=1                                                            CAN 0842
      GO TO 154                                                         CAN 0843
190   IF(YMAX+YMIN) 200,201,201                                         CAN 0844
200   WS=ABSF(YMIN)                                                     CAN 0845
      W1=YMAX/WS +1.                                                    CAN 0846
      WW=SS/W1 + .9                                                     CAN 0847
204   NNLU=WW                                                           CAN 0848
      NPLU=NO-NNLU                                                      CAN 0849
      GO TO 112                                                         CAN 0850
201   WS= YMAX                                                          CAN 0851
      W1= ABSF(YMIN)/WS+1.                                              CAN 0852
      WW=SS/W1 + .9                                                     CAN 0853
205   NPLU=WW                                                           CAN 0854
      NNLU=NO-NPLU                                                      CAN 0855
112   DO 41 K=1,5                                                       CAN 0856
      IF(K-NCURVE) 43,43,42                                             CAN 0857
42    IF(K-5) 50,44,44                                                  CAN 0858
44    SS=NA                                                             CAN 0859
       SS=SS-2.                                                         CAN 0860
      WS=D3(K)                                                          CAN 0861
      WW=SS                                                             CAN 0862
      GO TO 111                                                         CAN 0863
43    GO TO (150,151),INS                                               CAN 0864
150   NJ=WW                                                             CAN 0865
      WW=NJ                                                             CAN 0866
111   D3(K)= WS/WW                                                      CAN 0867
      GO TO 41                                                          CAN 0868
151   WS1=NPLU                                                          CAN 0869
      WS1=DUM2(K)/WS1                                                   CAN 0870
      WS2=NNLU                                                          CAN 0871
      WS2=ABSF(DUM1(K))/WS2                                             CAN 0872
      IF(WS1-WS2)206,207,207                                            CAN 0873
206   WW=NNLU                                                           CAN 0874
      WS= ABSF(DUM1(K))                                                 CAN 0875
      GO TO 111                                                         CAN 0876
207   WW=NPLU                                                           CAN 0877
      WS=DUM2(K)                                                        CAN 0878
      GO TO 111                                                         CAN 0879
50    D3(K)=1.                                                          CAN 0880
41    CONTINUE                                                          CAN 0881
      DO 170 K=1,5                                                      CAN 0882
      CC =1.                                                            CAN 0883
      IF(D3(K)) 900,901,900                                             CAN 0884
901   D3(K)=1.                                                          CAN 0885
900   IF (D3(K)-1.)171,170,172                                          CAN 0886
172   IF (D3(K)-100.)173,175,174                                        CAN 0887
173   D3(K)=D3(K)+.9                                                    CAN 0888
      NSF(K)=D3(K)                                                      CAN 0889
      D3(K)=NSF(K)                                                      CAN 0890
175   IF(CC-1.)170,170,176                                              CAN 0891
174   D3(K)=D3(K)/10.                                                   CAN 0892
      CC=CC+1.                                                          CAN 0893
      GO TO 172                                                         CAN 0894
176   D3(K)=D3(K)*10.                                                   CAN 0895
      CC=CC-1.                                                          CAN 0896
      GO TO 175                                                         CAN 0897
171   IF(D3(K)-1.)180,178,177                                           CAN 0898
177   D3(K)=D3(K)*10.+.9                                                CAN 0899
      NSF(K)=D3(K)                                                      CAN 0900
      D3(K)=NSF(K)                                                      CAN 0901
      D3(K)=D3(K)/10.                                                   CAN 0902
178   IF(CC-1.)170,170,179                                              CAN 0903
179   D3(K)=D3(K)/10.                                                   CAN 0904
      CC=CC-1.                                                          CAN 0905
      GO TO 178                                                         CAN 0906
180   D3(K)=D3(K)*10.                                                   CAN 0907
      CC=CC+1.                                                          CAN 0908
      GO TO 171                                                         CAN 0909
170   CONTINUE                                                          CAN 0910
154   DO 51 J=1,NCURVE                                                  CAN 0911
      DO 52I=1,NOP                                                      CAN 0912
      Y(I,J)=Y(I,J)/D3(J)                                               CAN 0913
      IF(Y(I,J)) 534,52,536                                             CAN 0914
534   Y(I,J)=Y(I,J)-.5                                                  CAN 0915
      GO TO 52                                                          CAN 0916
536   Y(I,J)=Y(I,J)+.5                                                  CAN 0917
52    NY(I,J)=Y(I,J)                                                    CAN 0918
51    CONTINUE                                                          CAN 0919
      LL=NPLU                                                           CAN 0920
      DO 54 I=1,NOP                                                     CAN 0921
      X(I)=X(I)/D3(5)                                                   CAN 0922
      IF(X(I)) 537,54,538                                               CAN 0923
537   X(I)=X(I)-.5                                                      CAN 0924
      GO TO 54                                                          CAN 0925
