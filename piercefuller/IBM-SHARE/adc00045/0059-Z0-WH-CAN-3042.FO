810   IF(C) 811,811,812                                                 CAN 0977
811   NXV=NZ2                                                           CAN 0978
812   NXV=NXV+ 6                                                        CAN 0979
      GORMT(1) =POINT(7)                                                CAN 0980
      GORMT(5) =POINT(9)                                                CAN 0981
      GORMT(6) =POINT(5)                                                CAN 0982
      GORMT( 7)=POINT(13)                                               CAN 0983
      GORMT( 8)=POINT( 5)                                               CAN 0984
      GORMT( 9)=POINT(13)                                               CAN 0985
      GORMT(10)=POINT(5)                                                CAN 0986
