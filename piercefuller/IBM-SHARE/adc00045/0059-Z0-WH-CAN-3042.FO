      F1(2)=H2                                                          CAN 0755
      F1(3)=H3                                                          CAN 0756
      F1(4)=H4                                                          CAN 0757
      F1(5)=H5                                                          CAN 0758
      F1(6)=H6                                                          CAN 0759
      F1(7)=H4                                                          CAN 0760
      F1(8)=H4                                                          CAN 0761
