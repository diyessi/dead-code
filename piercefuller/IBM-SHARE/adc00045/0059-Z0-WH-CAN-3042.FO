C CAN  CYLINDER ANALYSIS PROGRAM                                        CAN 0001
      COMMONV30(51),V31(51),V32(51)                                     CAN 0002
      COMMON R(50),R1(50),R2(50),R3(50),R4(50),R5(50),R6(50),R7(50),    CAN 0003
     1R8(50),R9(50),R10(50),P2A(51),P1A(51),P2E(51),P1E(51),EF2(51),    CAN 0004
     2EF1(51),Q2(51),Q1(51),PR(51),PE(51),E,XMU,K,ITITLE(24),V2(51),PI, CAN 0005
     3ITAPE,JTAPE,CIND,AAA,XMI,XPI,V1(51),V16(51),V17(51),V18(51),V19(51CAN 0006
     4),V20(51),V22(51),B12(51),S2(51),V25(51),C1(51),V51(51),V52(51),  CAN 0007
     5V53(51),V54(51),C2(51),C3(51),C4(51),PSI2(51),E7(51),E8(51),E9(51)CAN 0008
     6,E10(51),E11(51),E12(51),U2(51),DEF2(51),XM2(51),XP2(51),U1(51),  CAN 0009
     7DEF1(51),XM3(51),XP3(51),XM5(51),XP4(51),H1(51),H2(51),RS2(51),   CAN 0010
     8RS1(51),AB1(51),AB2(51),AX1(51),AX2(51),TI(51),XP5(51),XM4(51),   CAN 0011
     9 LCL, DEL(51),HP1(51),HP2(51),HL1(51),HL2(51),HA(51),R1U(51)      CAN 0012
      COMMON AXA(51),SI1(51),SI2(51),SI3(51),DR(51),RSA(51),IPAGE,LGPH, CAN 0013
     1LEXT,V21(51),R11(50),R12(50),T1(51),T2(51)                        CAN 0014
      EQUIVALENCE  (P1A,E7,XM2),(P2A,E8,XP2),(P1E,E9,U1),(P2E,E10,U2),  CAN 0015
     1(EF1,E11,DEF1),(EF2,E12,DEF2),(Q1,C1,XP3),(Q2,C2,XM3),(C3,XP4),   CAN 0016
     2(C4,XP5),(B12,XM4),(PSI2,XM5),(T1,RS1),(T2,RS2),(V16,DEL),(V17,DR)CAN 0017
     3,(V18,HP1,H1),(V19,HP2,H2),(V20,HL1,AX1),(V22,HL2,AX2),(V51,AXA), CAN 0018
     4(V52,RSA),(V53,SI2),(V54,SI1),(V25,HA),(TI,SI3)                   CAN 0019
      DIMENSION HH1(2),HH2(8)                                           CAN 0020
      PI = 3.1415927                                                    CAN 0021
      ITAPE = 5                                                         CAN 0022
      JTAPE = 6                                                         CAN 0023
 2    READ INPUT TAPE ITAPE,2001,ITITLE                                 CAN 0024
 2001 FORMAT (12A6)                                                     CAN 0025
      READ INPUT TAPE ITAPE,8000,E,XMU,AAA,CIND,AL,AG,AE                CAN 0026
      K = AAA                                                           CAN 0027
      LGPH = AG                                                         CAN 0028
      LEXT = AE                                                         CAN 0029
      LCL=AL                                                            CAN 0030
      IF (CIND   ) 1,1,3                                                CAN 0031
1     READ INPUT TAPE ITAPE,8000,(R9(I),R1(I),R10(I),R2(I),V2(I),T1(I), CAN 0032
     1R11(I),Q1(I),R4(I),P1E(I),R6(I),P1A(I),R8(I),EF1(I),PE(I),PR(I),  CAN 0033
     2EF2(I),T2(I),R12(I),Q2(I),R3(I),P2E(I),R5(I),P2A(I),R7(I),I=1,K ) CAN 0034
      GO TO 85                                                          CAN 0035
3     READ INPUT TAPE ITAPE,8000,(W1,W1,W1,W1,W1   ,T1(I),              CAN 0036
     1R11(I),Q1(I),R4(I),P1E(I),R6(I),P1A(I),R8(I),EF1(I),PE(I),PR(I),  CAN 0037
     2EF2(I),T2(I),R12(I),Q2(I),R3(I),P2E(I),R5(I),P2A(I),R7(I),I=1,K ) CAN 0038
85    XPI=1.+XMU                                                        CAN 0039
      XMI = 1.-XMU                                                      CAN 0040
      DO 107 I=1,K                                                      CAN 0041
      I=I                                                               CAN 0042
      IF(CIND) 81,81,100                                                CAN 0043
 81   IF (R9(I)) 82,82,83                                               CAN 0044
 82   R9(I)= R1(I)                                                      CAN 0045
83    IF(R1(I)) 820,820,830                                             CAN 0046
820   R1(I)=R9(I)                                                       CAN 0047
830   IF(R10(I)) 84,84,990                                              CAN 0048
 84   R10(I) =R2(I)                                                     CAN 0049
990   IF(R2(I)) 840,840,991                                             CAN 0050
840   R2(I)=R10(I)                                                      CAN 0051
991   IF(R1(I)-R2(I)) 841,842,843                                       CAN 0052
841   W2=R1(I)                                                          CAN 0053
      R1(I)=R2(I)                                                       CAN 0054
      R2(I)=W2                                                          CAN 0055
      WRITE OUTPUT TAPE JTAPE,2003,I                                    CAN 0056
843   IF(R9(I)-R10(I))844,81,99                                         CAN 0057
844   W2=R9(I)                                                          CAN 0058
      R9(I)=R10(I)                                                      CAN 0059
      R10(I)=W2                                                         CAN 0060
      WRITE OUTPUT TAPE JTAPE,2003,I                                    CAN 0061
 99   R(I)=(2./3.)*(R1(I)+R2(I)-(R1(I)*R2(I))/(R1(I)+R2(I)))            CAN 0062
 100  TI(I)=    ( R1(I)-R2(I))**3*(R1(I)**2+4.*R1(I)*R2(I)+R2(I)**2)    CAN 0063
 101  TI(I)= TI(I)/(24.*(R1(I)**2+R1(I)*R2(I)+R2(I)**2)* XMI *XPI)      CAN 0064
102   W1=(R9(I)+R10(I))*(R1(I)-R2(I))**3*(R1(I)**2+4.*R1(I)*R2(I)+R2(I)*CAN 0065
     1*2)                                                               CAN 0066
      V1(I)=18.*XPI*XMI*(R9(I)-R10(I))*(R1(I)+R2(I))/W1                 CAN 0067
104   V1(I)=SQRTF(V1(I))                                                CAN 0068
 105  V1(I)= SQRTF (V1(I))                                              CAN 0069
106   IF(R1(I)-R2(I)) 841,842,107                                       CAN 0070
 107  CONTINUE                                                          CAN 0071
      CALL OUTINP                                                       CAN 0072
992   CALL PHI                                                          CAN 0073
      CALL GEO (ADR)                                                    CAN 0074
      CALL CALCM                                                        CAN 0075
      CALL STRESS  (ADR)                                                CAN 0076
993   CALL OUTPUT                                                       CAN 0077
      IF(LGPH) 2,2,4                                                    CAN 0078
4     W=0.                                                              CAN 0079
      DO 75 I=1,K                                                       CAN 0080
      W=W+V2(I)                                                         CAN 0081
      H2(I+1)=W                                                         CAN 0082
75    H1(I+1)=W                                                         CAN 0083
      H2(1)=0.                                                          CAN 0084
      H1(1)=0.                                                          CAN 0085
      DEF1(K+1)=DEF2(K)                                                 CAN 0086
      U1(K+1)=U2(K)                                                     CAN 0087
      K=K+1                                                             CAN 0088
      NCUVE=3                                                           CAN 0089
      NAB=100                                                           CAN 0090
      NORD=39                                                           CAN 0091
      NIS=2                                                             CAN 0092
      CALL NAME(HH1,HH2,6HROTATI,6HON    ,6HRADIAL,6H      ,6HCUMULA,   CAN 0093
     16HTIVE  ,6HLENGTH)                                                CAN 0094
      CALL PLOT (NCUVE,K,NAB,NORD,NIS,H2,DEF1,U1,DEL,U2,ITITLE,HH1,HH2) CAN 0095
      CALL NAME(HH1,HH2,6HOUTSID,6HE     ,6HINSIDE,6H      ,6HMEMBRA,   CAN 0096
     16HNE    ,6HLENGTH)                                                CAN 0097
      NIS=1                                                             CAN 0098
      CALL PLOT (NCUVE,K,NAB,NORD,NIS,H1,SI1,SI2,SI3,U1,ITITLE,HH1,HH2) CAN 0099
      GO TO 2                                                           CAN 0100
842   WRITE OUTPUT TAPE JTAPE,2002                                      CAN 0101
2002  FORMAT(1H1 //////7X,    27HCHECK DATA FOR THIS PROBLEM /7X,    38HCAN 0102
     1THE OUTSIDE AND INSIDE RADII ARE EQUAL /7X, 30HTHERE HAVE BEEN NO CAN 0103
     2CALCULATION )                                                     CAN 0104
      CALL OUTINP                                                       CAN 0105
      GO TO 2                                                           CAN 0106
8000  FORMAT(5E14.0)                                                    CAN 0107
2003  FORMAT(//////// 20X,45HTHIS PROBLEM  REQUIRED CHANGING RADII ON RICAN 0108
     1NG   I3)                                                          CAN 0109
      END                                                               CAN 0110
      SUBROUTINE OUTINP                                                 CAN 0111
C PRINTS THE INPUT                                                      CAN 0112
      COMMONV30(51),V31(51),V32(51)                                     CAN 0113
      COMMON R(50),R1(50),R2(50),R3(50),R4(50),R5(50),R6(50),R7(50),    CAN 0114
     1R8(50),R9(50),R10(50),P2A(51),P1A(51),P2E(51),P1E(51),EF2(51),    CAN 0115
     2EF1(51),Q2(51),Q1(51),PR(51),PE(51),E,XMU,K,ITITLE(24),V2(51),PI, CAN 0116
     3ITAPE,JTAPE,CIND,AAA,XMI,XPI,V1(51),V16(51),V17(51),V18(51),V19(51CAN 0117
     4),V20(51),V22(51),B12(51),S2(51),V25(51),C1(51),V51(51),V52(51),  CAN 0118
     5V53(51),V54(51),C2(51),C3(51),C4(51),PSI2(51),E7(51),E8(51),E9(51)CAN 0119
     6,E10(51),E11(51),E12(51),U2(51),DEF2(51),XM2(51),XP2(51),U1(51),  CAN 0120
     7DEF1(51),XM3(51),XP3(51),XM5(51),XP4(51),H1(51),H2(51),RS2(51),   CAN 0121
     8RS1(51),AB1(51),AB2(51),AX1(51),AX2(51),TI(51),XP5(51),XM4(51),   CAN 0122
     9 LCL, DEL(51),HP1(51),HP2(51),HL1(51),HL2(51),HA(51),R1U(51)      CAN 0123
      COMMON AXA(51),SI1(51),SI2(51),SI3(51),DR(51),RSA(51),IPAGE,LGPH, CAN 0124
     1LEXT,V21(51),R11(50),R12(50),T1(51),T2(51)                        CAN 0125
      EQUIVALENCE  (P1A,E7,XM2),(P2A,E8,XP2),(P1E,E9,U1),(P2E,E10,U2),  CAN 0126
     1(EF1,E11,DEF1),(EF2,E12,DEF2),(Q1,C1,XP3),(Q2,C2,XM3),(C3,XP4),   CAN 0127
     2(C4,XP5),(B12,XM4),(PSI2,XM5),(T1,RS1),(T2,RS2),(V16,DEL),(V17,DR)CAN 0128
     3,(V18,HP1,H1),(V19,HP2,H2),(V20,HL1,AX1),(V22,HL2,AX2),(V51,AXA), CAN 0129
     4(V52,RSA),(V53,SI2),(V54,SI1),(V25,HA),(TI,SI3)                   CAN 0130
      NF=1                                                              CAN 0131
      NSET=1                                                            CAN 0132
      MC=17                                                             CAN 0133
      IPAGE =1                                                          CAN 0134
      WRITE OUTPUT TAPE JTAPE, 2000,IPAGE                               CAN 0135
 2000 FORMAT (1H1   5X81H WESTINGHOUSE CAN 62 PROGRAM FOR DIGITAL COMPUTCAN 0136
     1ER WITH FORTRAN INTERPETIVE SYSTEM10X8HPAGE NO I3,   /  6X    80H CAN 0137
     2(SHORT CYLINDER GROUP SOLUTION FOR AXISYMMETRIC BODIES WITH IRREGUCAN 0138
     3LAR OUTLINE) //)                                                  CAN 0139
      WRITE OUTPUT TAPE JTAPE,2002, ITITLE                              CAN 0140
 2002 FORMAT (35X 12A6)                                                 CAN 0141
      IF(CIND   ) 2104,2104,2105                                        CAN 0142
2104  WRITE OUTPUT TAPE JTAPE,2016                                      CAN 0143
2016  FORMAT(// 6X,35H NEW GEOMETRY USED IN THIS PROBLEM   )            CAN 0144
      GO TO 60                                                          CAN 0145
2105  WRITE OUTPUT TAPE JTAPE,2017                                      CAN 0146
2017  FORMAT(// 6X,35H OLD GEOMETRY USED IN THIS PROBLEM   )            CAN 0147
      GO TO 60                                                          CAN 0148
60    IF(LCL) 61,61,62                                                  CAN 0149
61    WRITE OUTPUT TAPE JTAPE,2050                                      CAN 0150
2050  FORMAT( 7X,42HLOCAL FLEXIBILITY NOT USED IN THIS PROBLEM  )       CAN 0151
      GO TO 63                                                          CAN 0152
62    WRITE OUTPUT TAPE JTAPE,2051                                      CAN 0153
2051  FORMAT( 7X,38HLOCAL FLEXIBILITY USED IN THIS PROBLEM  )           CAN 0154
63    WRITE OUTPUT TAPE JTAPE,2052,E,XMU                                CAN 0155
2052  FORMAT (7X,24HMODULUS OF ELASTICITY = F9.0,4X,16HPOISSON RATIO =  CAN 0156
     1F8.4 //)                                                          CAN 0157
      GO TO 17                                                          CAN 0158
1     IPAGE =IPAGE +1                                                   CAN 0159
      WRITE OUTPUT TAPE JTAPE,2036,IPAGE                                CAN 0160
 2036 FORMAT (1H198X, 8HPAGE NO.  I3 )                                  CAN 0161
17    GO TO (2,3,4,200),NSET                                            CAN 0162
2     WRITE OUTPUT TAPE JTAPE,2003                                      CAN 0163
2003  FORMAT(//  3X,13HCYL.  OUTSIDE 6X,7HOUTSIDE 9X, 6HINSIDE 7X,6HINSICAN 0164
     2DE 13X, 6HLENGTH 10X,2HT1 11X,3HRT1 /3X,3HNO. 3X,11HHOOP RADIUS   CAN 0165
     32X,14HBENDING RADIUS 2X,11HHOOP RADIUS 2X,14HBENDING RADIUS 5X,   CAN 0166
     46HINCHES 10X,3HLBS 9X, 6HINCHES /9X,6HINCHES 7X,6HINCHES 10X,     CAN 0167
     56HINCHES 7X,6HINCHES //)                                          CAN 0168
      GO TO 5                                                           CAN 0169
3     WRITE OUTPUT TAPE JTAPE,2004                                      CAN 0170
2004  FORMAT(// 3X,4HCYL. 6X,3HQ1  11X,3HRQ1 12X,3HPO1 11X,3HRO1 13X,   CAN 0171
     23HPA1 10X,3HRA1 11X,2HF1/3X,3HNO.7X,3HLBS 11X,3HIN.12X,3HPSI 11X, CAN 0172
     33HIN. 13X,3HPSI 10X,3HIN.11X 3HLBS  //)                           CAN 0173
      GO TO 5                                                           CAN 0174
4     WRITE OUTPUT TAPE JTAPE,2005                                      CAN 0175
2005  FORMAT(// 3X,4HCYL. 6X,3HPOR 11X,3HPIR 12X, 3HF2 11X, 3HT2 13X,   CAN 0176
     13HRT2 10X,3HQ2 11X,3HRQ2 /3X,3HNO.7X,3HLBS 11X,3HLBS 12X 3HLBS    CAN 0177
     211X,3HLBS 13X,3HIN.10X,3HLBS 11X,3HIN. //)                        CAN 0178
      GO TO 5                                                           CAN 0179
200   WRITE OUTPUT TAPE JTAPE,2021                                      CAN 0180
2021  FORMAT(// 3X,4HCYL. 6X,3HPO2 11X,3HRO2 12X, 3HPA211X, 3HRA2 /3X,  CAN 0181
     13HNO. 7X, 3HPSI 11X,3HIN.12X,3HPSI 11X,3HIN. //)                  CAN 0182
5     DO 6 I=NF,K                                                       CAN 0183
      I=I                                                               CAN 0184
      MC=MC+1                                                           CAN 0185
      GO TO (7,8,9,201),NSET                                            CAN 0186
7     WRITE OUTPUT TAPE JTAPE,2006,I,R9(I),R1(I),R10(I),R2(I),V2(I),    CAN 0187
     1T1(I),R11(I)                                                      CAN 0188
      GO TO 10                                                          CAN 0189
8     WRITE OUTPUT TAPE JTAPE,2206,I,Q1(I),R4(I),P1E(I),R6(I),P1A(I),   CAN 0190
     1R8(I),EF1(I)                                                      CAN 0191
      GO TO 10                                                          CAN 0192
9     WRITE OUTPUT TAPE JTAPE,2216,I,PE(I),PR(I),EF2(I),T2(I),R12(I),   CAN 0193
     1Q2(I),R3(I)                                                       CAN 0194
      GO TO 10                                                          CAN 0195
201   WRITE OUTPUT TAPE JTAPE,2022,I,P2E(I),R5(I),P2A(I),R7(I)          CAN 0196
10    IF(K-I)   6,6,20                                                  CAN 0197
20    IF (MC-44) 6,11,11                                                CAN 0198
6     CONTINUE                                                          CAN 0199
13    GO TO (14,15,202,16 ), NSET                                       CAN 0200
14    NSET = 2                                                          CAN 0201
18    NF=1                                                              CAN 0202
      MC=MC+5                                                           CAN 0203
      IF(MC-35) 17,21,21                                                CAN 0204
21    MC=6                                                              CAN 0205
      GO TO 1                                                           CAN 0206
15    NSET =3                                                           CAN 0207
      GO TO 18                                                          CAN 0208
202   NSET =4                                                           CAN 0209
      GO TO 18                                                          CAN 0210
11    NF=I +1                                                           CAN 0211
      GO TO 21                                                          CAN 0212
16    RETURN                                                            CAN 0213
2022  FORMAT(I6,F14.4,F13.6,F15.4,F15.6)                                CAN 0214
2216  FORMAT(I6,F14.4,F13.4,F15.4,F15.4,F15.6,F14.4,F13.6)              CAN 0215
2206  FORMAT(I6,F13.4,F14.6,F15.4,F15.6,F15.4,F14.6,F13.4)              CAN 0216
2006  FORMAT(I6,2F13.6,3X,2F13.6,3X,F14.6,F15.4,F12.6)                  CAN 0217
      END                                                               CAN 0218
      SUBROUTINE  PHI                                                   CAN 0219
C CALCULATION OF PHI TERMS WITH PHI = V                                 CAN 0220
      COMMONV30(51),V31(51),V32(51)                                     CAN 0221
      COMMON R(50),R1(50),R2(50),R3(50),R4(50),R5(50),R6(50),R7(50),    CAN 0222
     1R8(50),R9(50),R10(50),P2A(51),P1A(51),P2E(51),P1E(51),EF2(51),    CAN 0223
     2EF1(51),Q2(51),Q1(51),PR(51),PE(51),E,XMU,K,ITITLE(24),V2(51),PI, CAN 0224
     3ITAPE,JTAPE,CIND,AAA,XMI,XPI,V1(51),V16(51),V17(51),V18(51),V19(51CAN 0225
     4),V20(51),V22(51),B12(51),S2(51),V25(51),C1(51),V51(51),V52(51),  CAN 0226
     5V53(51),V54(51),C2(51),C3(51),C4(51),PSI2(51),E7(51),E8(51),E9(51)CAN 0227
     6,E10(51),E11(51),E12(51),U2(51),DEF2(51),XM2(51),XP2(51),U1(51),  CAN 0228
     7DEF1(51),XM3(51),XP3(51),XM5(51),XP4(51),H1(51),H2(51),RS2(51),   CAN 0229
     8RS1(51),AB1(51),AB2(51),AX1(51),AX2(51),TI(51),XP5(51),XM4(51),   CAN 0230
     9 LCL, DEL(51),HP1(51),HP2(51),HL1(51),HL2(51),HA(51),R1U(51)      CAN 0231
      COMMON AXA(51),SI1(51),SI2(51),SI3(51),DR(51),RSA(51),IPAGE,LGPH, CAN 0232
     1LEXT,V21(51),R11(50),R12(50),T1(51),T2(51)                        CAN 0233
      EQUIVALENCE  (P1A,E7,XM2),(P2A,E8,XP2),(P1E,E9,U1),(P2E,E10,U2),  CAN 0234
     1(EF1,E11,DEF1),(EF2,E12,DEF2),(Q1,C1,XP3),(Q2,C2,XM3),(C3,XP4),   CAN 0235
     2(C4,XP5),(B12,XM4),(PSI2,XM5),(T1,RS1),(T2,RS2),(V16,DEL),(V17,DR)CAN 0236
     3,(V18,HP1,H1),(V19,HP2,H2),(V20,HL1,AX1),(V22,HL2,AX2),(V51,AXA), CAN 0237
     4(V52,RSA),(V53,SI2),(V54,SI1),(V25,HA),(TI,SI3)                   CAN 0238
C  K= NO OF RINGS                                                       CAN 0239
C  V1,V2, AND V4 TO BE INPUT                                            CAN 0240
      DO 125  I= 1,K                                                    CAN 0241
      V3    = V1(I) * V2(I)                                             CAN 0242
117   IF(V3   -35.) 108 ,108 ,1201                                      CAN 0243
 108  F1  = SINF(V3   )                                                 CAN 0244
 109  F2  = COSF(V3   )                                                 CAN 0245
 110  EX1 = EXPF(V3   )                                                 CAN 0246
 111  EX2  = 1./EX1                                                     CAN 0247
 112  F3   = .5* EX1 - .5* EX2                                          CAN 0248
 113  F4   = .5* EX1 + .5* EX2                                          CAN 0249
 114  IF (V3   -.05) 115,115,1171                                       CAN 0250
 115  F5 =(F3+F1)*(V3   **3/3.+V3   **7/2520.)                          CAN 0251
 116  GO TO 118                                                         CAN 0252
1201   W2=1./(2.*(TI(I)/(XMI*XPI))*V1(I))                               CAN 0253
1202  V16(I)= W2/V1(I)                                                  CAN 0254
1203  V17(I)= -V16(I)/V1(I)                                             CAN 0255
1204  V19(I)=  0.                                                       CAN 0256
1205  V18(I)= 0.                                                        CAN 0257
1206  V20(I)=  W2*2.                                                    CAN 0258
1207  V22(I)=  0.                                                       CAN 0259
      GO TO 125                                                         CAN 0260
 1171 F5 = F3**2 - F1**2                                                CAN 0261
118   F6=2.*(TI(I)/(XMI*XPI))*V1(I)                                     CAN 0262
 119  F6  = F5 * F6                                                     CAN 0263
 120  V16(I)=(F1**2 +F3**2)/(F6*V1(I))                                  CAN 0264
 121  V17(I)=-(F3*F4 -F1*F2)/(F6*V1(I)**2)                              CAN 0265
 122  V18(I)=(-2.*F3*F1)/(F6* V1(I))                                    CAN 0266
 123  V19(I)= -(F3*F2-F4*F1)/(F6 *V1(I)**2)                             CAN 0267
 124  V20(I)= 2.*(F3*F4 +F1*F2)/F6                                      CAN 0268
 1251 V22(I) = -2. * (F3*F2+F4*F1)/F6                                   CAN 0269
      V30(I)=V20(I)                                                     CAN 0270
      V31(I)=V16(I)                                                     CAN 0271
      V32(I)=V17(I)                                                     CAN 0272
 125  CONTINUE                                                          CAN 0273
      IF(LCL) 1219,1219,1250                                            CAN 0274
1250  DO 1221 J=1,K                                                     CAN 0275
      I=J                                                               CAN 0276
      IF(K-I) 1221,1221,1209                                            CAN 0277
1209  F1= R1(I)-R2(I)                                                   CAN 0278
      F2= R1(I+1)-R2(I+1)                                               CAN 0279
      F3= F1/F2                                                         CAN 0280
      IF(F3-1.7)1210,1211,1211                                          CAN 0281
1210  IF(F3-.58  )126 ,126 ,1221                                        CAN 0282
126   ICASE=2                                                           CAN 0283
      THICK=F1                                                          CAN 0284
      RTTR=R(I)/F1                                                      CAN 0285
      I=J+1                                                             CAN 0286
      GO TO 1212                                                        CAN 0287
1211  ICASE=1                                                           CAN 0288
      THICK=F2                                                          CAN 0289
      RTTR=R(I+1)/F2                                                    CAN 0290
1212  IF(RTTR-.5) 1215,1216,1216                                        CAN 0291
1215  F1=0.                                                             CAN 0292
      GO TO 1217                                                        CAN 0293
1216  W1=  (RTTR+.5)* LOGF(RTTR+.5)-(RTTR-.5)*LOGF(RTTR-.5)+.5          CAN 0294
      W2= 1.408 * XMI * XPI  * W1                                       CAN 0295
      W1=1./(1.+(.491*XMI*XPI*W1*W1**.3333)/RTTR**2)                    CAN 0296
      W1= SQRTF(SQRTF(W1**3))                                           CAN 0297
      F1=W2*W1                                                          CAN 0298
1217  W1=SQRTF(1.+.277/RTTR**2)                                         CAN 0299
      F2=(1.238 /W1)/THICK                                              CAN 0300
      W1=SQRTF(SQRTF(1. +.347/RTTR**2))                                 CAN 0301
      F4=(5.78/W1)/THICK**2                                             CAN 0302
      GO TO (1213,1214),ICASE                                           CAN 0303
1213  V30(I)=V30(I) +F4                                                 CAN 0304
      V31(I)=V31(I)+F2                                                  CAN 0305
      V32(I)=V32(I)-F1                                                  CAN 0306
      GO TO 1221                                                        CAN 0307
1214  V20(I)= V20(I) +  F4                                              CAN 0308
      V16(I)= V16(I) + F2                                               CAN 0309
      V17(I)=V17(I)-F1                                                  CAN 0310
1221  CONTINUE                                                          CAN 0311
1219  RETURN                                                            CAN 0312
      END                                                               CAN 0313
      SUBROUTINE  GEO  (ADR)                                            CAN 0314
C LOADING TERMS DUE TO GEOMETRY                                         CAN 0315
      COMMONV30(51),V31(51),V32(51)                                     CAN 0316
      COMMON R(50),R1(50),R2(50),R3(50),R4(50),R5(50),R6(50),R7(50),    CAN 0317
     1R8(50),R9(50),R10(50),P2A(51),P1A(51),P2E(51),P1E(51),EF2(51),    CAN 0318
     2EF1(51),Q2(51),Q1(51),PR(51),PE(51),E,XMU,K,ITITLE(24),V2(51),PI, CAN 0319
     3ITAPE,JTAPE,CIND,AAA,XMI,XPI,V1(51),V16(51),V17(51),V18(51),V19(51CAN 0320
     4),V20(51),V22(51),B12(51),S2(51),V25(51),C1(51),V51(51),V52(51),  CAN 0321
     5V53(51),V54(51),C2(51),C3(51),C4(51),PSI2(51),E7(51),E8(51),E9(51)CAN 0322
     6,E10(51),E11(51),E12(51),U2(51),DEF2(51),XM2(51),XP2(51),U1(51),  CAN 0323
     7DEF1(51),XM3(51),XP3(51),XM5(51),XP4(51),H1(51),H2(51),RS2(51),   CAN 0324
     8RS1(51),AB1(51),AB2(51),AX1(51),AX2(51),TI(51),XP5(51),XM4(51),   CAN 0325
     9 LCL, DEL(51),HP1(51),HP2(51),HL1(51),HL2(51),HA(51),R1U(51)      CAN 0326
      COMMON AXA(51),SI1(51),SI2(51),SI3(51),DR(51),RSA(51),IPAGE,LGPH, CAN 0327
     1LEXT,V21(51),R11(50),R12(50),T1(51),T2(51)                        CAN 0328
      EQUIVALENCE  (P1A,E7,XM2),(P2A,E8,XP2),(P1E,E9,U1),(P2E,E10,U2),  CAN 0329
     1(EF1,E11,DEF1),(EF2,E12,DEF2),(Q1,C1,XP3),(Q2,C2,XM3),(C3,XP4),   CAN 0330
     2(C4,XP5),(B12,XM4),(PSI2,XM5),(T1,RS1),(T2,RS2),(V16,DEL),(V17,DR)CAN 0331
     3,(V18,HP1,H1),(V19,HP2,H2),(V20,HL1,AX1),(V22,HL2,AX2),(V51,AXA), CAN 0332
     4(V52,RSA),(V53,SI2),(V54,SI1),(V25,HA),(TI,SI3)                   CAN 0333
      S1=0.                                                             CAN 0334
      ADR=(T1(1)+Q1(1)-(P1A(1)*(R8(1)**2-R2(1)**2)+P1E(1)*(R1(1)**2-    CAN 0335
     1R6(1)**2))*PI)/(PI*(R1(1)**2-R2(1)**2))                           CAN 0336
      DO 147 I=1,K                                                      CAN 0337
 127  A    = .5/(R(I)*PI)                                               CAN 0338
      B16 = A * (R(I)-R12(I))                                           CAN 0339
      B15 = A * (R(I)-R11(I))                                           CAN 0340
 128  B1   = A    *(R(I) - R4(I))                                       CAN 0341
 138  B7   = A   * PI*(R8(I)**2-R2(I)**2)                               CAN 0342
 139  B8   = A   * PI*(R1(I)**2 - R6(I)**2)                             CAN 0343
 140  B9   = A   * PI *(R7(I)**2 -R2(I)**2)                             CAN 0344
 141  B10    = A   *PI *(R1(I)**2 -R5(I)**2)                            CAN 0345
130   B2   =B7   *  ( 2.*(R2(I)**2+R2(I)*R8(I)+R8(I)**2)/(3.*(R2(I)+R8(ICAN 0346
     1))) -R(I))                                                        CAN 0347
132   B3   =B8   *  ( 2.*(R1(I)**2+R1(I)*R6(I)+R6(I)**2)/(3.*(R1(I)+R6(ICAN 0348
     1))) -R(I))                                                        CAN 0349
 133  B4   = A   * (R(I) - R3(I))                                       CAN 0350
135   B5   =B9   *  ( 2.*(R2(I)**2+R2(I)*R7(I)+R7(I)**2)/(3.*(R2(I)+R7(ICAN 0351
     1))) -R(I))                                                        CAN 0352
137   B6   =B10   * ( 2.*(R1(I)**2+R1(I)*R5(I)+R5(I)**2)/(3.*(R1(I)+R5(ICAN 0353
     1))) -R(I))                                                        CAN 0354
C TRANSMITTED CONSTANTS                                                 CAN 0355
 143  V51(I)= Q1(I) * B1   + P1A(I)*B2   + P1E(I)* B3 +T1(I)*B15        CAN 0356
 144  V52(I)= Q2(I) * B4   + P2A(I)*B5   + P2E(I)* B6+T2(I)*B16         CAN 0357
 145  V53(I)= EF1(I)*A                                                  CAN 0358
 146  V54(I)= EF2(I)*A                                                  CAN 0359
      S2(I)=S1   +Q1(I)*A   -P1A(I)*B7   -P1E(I)*B8   -Q2(I)*A          CAN 0360
     1+P2A(I)*B9   +P2E(I)* B10    +T1(I)*A -T2(I)*A                    CAN 0361
      IF (I-K) 1470,1472,1472                                           CAN 0362
 1470 B12(I) = R(I)/R(I+1)                                              CAN 0363
      GO TO 1471                                                        CAN 0364
 1472 B12(I) = 0.                                                       CAN 0365
      GO TO 147                                                         CAN 0366
 1471 S1      =S2(I)*B12(I)                                             CAN 0367
 147  CONTINUE                                                          CAN 0368
C CONSTANT ADDED TO DEFLECTION GEOMETRY AND LOAD DEPENDENT              CAN 0369
 148  DO 158  I=1,K                                                     CAN 0370
 149  B11   = R9(I)**2-R10(I)**2                                        CAN 0371
 150  V25(I)=((R9(I)**2*R10(I)**2)/(  B11   ))*(XPI* 1./R(I))           CAN 0372
 151  V25(I)= V25(I)*(PR(I)-PE(I))+R(I)*XMI*(PR(I)*R10(I)**2-PE(I)*R9(I)CAN 0373
     1**2)/   B11                                                       CAN 0374
C CONSTANT IN  EQUATIONS WITH M AND P NOW STAR M AND P                  CAN 0375
 153  C1(I) = V16(I)*V51(I)+V17(I)*V53(I)+V18(I)*V52(I)+V19(I)*V54(I)   CAN 0376
     1+V25(I)                                                           CAN 0377
 155  C2(I) =V20(I)*V51(I)-V16(I)*V53(I)+V22(I)*V52(I) -V18(I)*V54(I)   CAN 0378
 156  C3(I)= V18(I)*V51(I)+V19(I)*V53(I)+V31(I)*V52(I)                  CAN 0379
     1+V32(I)*V54(I)+ V25(I)                                            CAN 0380
 158  C4(I)= -V22(I)*V51(I)+V18(I)*V53(I)-V30(I)*V52(I)+V31(I)*V54(I)   CAN 0381
      RETURN                                                            CAN 0382
      END                                                               CAN 0383
      SUBROUTINE  CALCM                                                 CAN 0384
C INITIAL RING WITH M1 AND P1 = 0                                       CAN 0385
      COMMONV30(51),V31(51),V32(51)                                     CAN 0386
      COMMON R(50),R1(50),R2(50),R3(50),R4(50),R5(50),R6(50),R7(50),    CAN 0387
     1R8(50),R9(50),R10(50),P2A(51),P1A(51),P2E(51),P1E(51),EF2(51),    CAN 0388
     2EF1(51),Q2(51),Q1(51),PR(51),PE(51),E,XMU,K,ITITLE(24),V2(51),PI, CAN 0389
     3ITAPE,JTAPE,CIND,AAA,XMI,XPI,V1(51),V16(51),V17(51),V18(51),V19(51CAN 0390
     4),V20(51),V22(51),B12(51),S2(51),V25(51),C1(51),V51(51),V52(51),  CAN 0391
     5V53(51),V54(51),C2(51),C3(51),C4(51),PSI2(51),E7(51),E8(51),E9(51)CAN 0392
     6,E10(51),E11(51),E12(51),U2(51),DEF2(51),XM2(51),XP2(51),U1(51),  CAN 0393
     7DEF1(51),XM3(51),XP3(51),XM5(51),XP4(51),H1(51),H2(51),RS2(51),   CAN 0394
     8RS1(51),AB1(51),AB2(51),AX1(51),AX2(51),TI(51),XP5(51),XM4(51),   CAN 0395
     9 LCL, DEL(51),HP1(51),HP2(51),HL1(51),HL2(51),HA(51),R1U(51)      CAN 0396
      COMMON AXA(51),SI1(51),SI2(51),SI3(51),DR(51),RSA(51),IPAGE,LGPH, CAN 0397
     1LEXT,V21(51),R11(50),R12(50),T1(51),T2(51)                        CAN 0398
      EQUIVALENCE  (P1A,E7,XM2),(P2A,E8,XP2),(P1E,E9,U1),(P2E,E10,U2),  CAN 0399
     1(EF1,E11,DEF1),(EF2,E12,DEF2),(Q1,C1,XP3),(Q2,C2,XM3),(C3,XP4),   CAN 0400
     2(C4,XP5),(B12,XM4),(PSI2,XM5),(T1,RS1),(T2,RS2),(V16,DEL),(V17,DR)CAN 0401
     3,(V18,HP1,H1),(V19,HP2,H2),(V20,HL1,AX1),(V22,HL2,AX2),(V51,AXA), CAN 0402
     4(V52,RSA),(V53,SI2),(V54,SI1),(V25,HA),(TI,SI3)                   CAN 0403
      DO 160  I=1,K                                                     CAN 0404
 160  PSI2(I)=S2(I)*(R(I+1) -R(I))* B12(I)                              CAN 0405
 161  E1   =V31(1) -V16(2)  * B12(1)                                    CAN 0406
 162  E2   =V32(1) +V17(2)  * B12(1)                                    CAN 0407
 163  E3   =-C3(1)+ C1(2)   +PSI2(1)*V16(2)                             CAN 0408
 164  E4   =-V30(1) -V20(2)  * B12(1)                                   CAN 0409
 165  E5   = V31(1) -V16(2)  * B12(1)                                   CAN 0410
 166  E6   =-C4(1) + C2(2)   + V20(2)  * PSI2(1)                        CAN 0411
 167  I=1                                                               CAN 0412
 168  EE   = E1   *E5    -E2   *E4                                      CAN 0413
 169  E7(I) =(E5   *V18(I+1) -E2   *V22(I+1))/EE                        CAN 0414
 170  E8(I) =(E5   *V19(I+1) +E2   *V18(I+1))/EE                        CAN 0415
 171  E9(I) =(E5   *E3    - E2   *E6   )/EE                             CAN 0416
 172  EE   = - EE                                                       CAN 0417
 173  E10(I)=(E4   *V18(I+1) -E1   *V22(I+1))/EE                        CAN 0418
 174  E11(I)= (E4   *V19(I+1) +E1   *V18(I+1))/EE                       CAN 0419
 175  E12(I)= (E4   *E3    -E1   * E6   )/EE                            CAN 0420
 176  E13   = V18(I+1)*B12(I)*E7(I)-V19(I+1)*B12(I)*E10(I)+V31(I+1)     CAN 0421
 177  E14   = -V19(I+1)*B12(I)*E11(I)+V18(I+1)*B12(I)*E8(I)+V32(I+1)    CAN 0422
 178  E15   = C3(I+1)+V18(I+1)*(PSI2(I)+B12(I)*E9(I))-V19(I+1)*B12(I)*  CAN 0423
     1E12(I)                                                            CAN 0424
 179  E16   = -V22(I+1)*B12(I)*E7(I)-V18(I+1)*B12(I)*E10(I)-V30(I+1)    CAN 0425
 180  E17   = -V22(I+1)*B12(I)*E8(I)-V18(I+1)*B12(I)*E11(I)+V31(I+1)    CAN 0426
 181  E18   = C4(I+1)-V22(I+1)*(PSI2(I)+B12(I)*E9(I))-V18(I+1)*B12(I)   CAN 0427
     1*E12(I)                                                           CAN 0428
 182  IF (K-1-I) 191,191,183                                            CAN 0429
 183  I = I+1                                                           CAN 0430
 184  E1   = E13      -V16(I+1)* B12(I)                                 CAN 0431
 185  E2   = E14      +V17(I+1)* B12(I)                                 CAN 0432
 186  E3   = C1(I+1) +PSI2(I)*V16(I+1) -E15                             CAN 0433
 187  E4   = E16      -V20(I+1)* B12(I)                                 CAN 0434
 188  E5   = E17      -V16(I+1)* B12(I)                                 CAN 0435
 189  E6   = C2(I+1) + V20(I+1)* PSI2(I) -E18                           CAN 0436
 190  GO TO 168                                                         CAN 0437
C LAST RING DEF. AND ANGLE                                              CAN 0438
 191  U2(I+1) = E15                                                     CAN 0439
 192  DEF2(I+1) = E18                                                   CAN 0440
 193  XM2(I+1)=0.                                                       CAN 0441
 194  XP2(I+1)=0.                                                       CAN 0442
      J = K-1                                                           CAN 0443
      DO 207 M = 1,J                                                    CAN 0444
 197  I = K-M                                                           CAN 0445
 198  XM2(I)=E7(I)* XM2(I+1) +E8(I)* XP2(I+1) +E9(I)                    CAN 0446
 199  XP2(I)=E10(I)* XM2(I+1) + E11(I)* XP2(I+1) + E12(I)               CAN 0447
 200  U1(I+1)=V16(I+1)*B12(I)*XM2(I)-V17(I+1)*B12(I)*XP2(I)+V18(I+1)*   CAN 0448
     1XM2(I+1)+V19(I+1)* XP2(I+1)+C1(I+1)+ V16(I+1)*PSI2(I)             CAN 0449
 202  DEF1(I+1)=V20(I+1)*B12(I)*XM2(I) +V16(I+1)*B12(I)*XP2(I)+V22(I+1) CAN 0450
     1*XM2(I+1) -V18(I+1)*XP2(I+1) +C2(I+1)+ V20(I+1)* PSI2(I)          CAN 0451
 204  U2(I+1)=V18(I+1)*B12(I)*XM2(I) -V19(I+1)*B12(I)*XP2(I)+V31(I+1)   CAN 0452
     1*XM2(I+1) +V32(I+1)*XP2(I+1)+C3(I+1) +V18(I+1)*PSI2(I)            CAN 0453
 207  DEF2(I+1)=-V22(I+1)*B12(I)*XM2(I)-V18(I+1)*B12(I)*XP2(I)-V30(I+1) CAN 0454
     1*XM2(I+1)+V31(I+1)*XP2(I+1)+C4(I+1)-V22(I+1)*PSI2(I)              CAN 0455
      U1(1)= V18(1)* XM2(1)+V19(1)* XP2(1) +C1(1)                       CAN 0456
      DEF1(1)=V22(1)*XM2(1)-V18(1)* XP2(1) +C2(1)                       CAN 0457
      U2(1)  =V31(1)*XM2(1)+V32(1)* XP2(1) +C3(1)                       CAN 0458
      DEF2(1)=-V30(1)*XM2(1)+V31(1)*XP2(1) +C4(1)                       CAN 0459
C CAL. M1 AND P1 TO BE TRANSMITTED                                      CAN 0460
 1940 XP3(1)= 0.                                                        CAN 0461
 1941 XM3(1)= 0.                                                        CAN 0462
      DO 2061 I=1,K                                                     CAN 0463
 2001 U1(I) = U1(I)/E                                                   CAN 0464
 2021 DEF1(I) = DEF1(I)/E                                               CAN 0465
 2041 U2(I) = U2(I)/E                                                   CAN 0466
 2061 DEF2(I) = DEF2(I)/E                                               CAN 0467
 208  DO 210 I=2,K                                                      CAN 0468
 209  XM3(I)= B12(I-1)*(XM2(I-1)+S2(I-1)*(R(I)-R(I-1)))                 CAN 0469
 210  XP3(I)= -B12(I-1)* XP2(I-1)                                       CAN 0470
 211  DO 215 I =1,K                                                     CAN 0471
 212  XP5(I) = XP3(I) +V53(I)                                           CAN 0472
 213  XP4(I) = XP2(I) +V54(I)                                           CAN 0473
 214  XM5(I) = XM3(I) +V51(I)                                           CAN 0474
 215  XM4(I) = XM2(I) +V52(I)                                           CAN 0475
      RETURN                                                            CAN 0476
      END                                                               CAN 0477
      SUBROUTINE STRESS (ADR)                                           CAN 0478
      COMMONV30(51),V31(51),V32(51)                                     CAN 0479
      COMMON R(50),R1(50),R2(50),R3(50),R4(50),R5(50),R6(50),R7(50),    CAN 0480
     1R8(50),R9(50),R10(50),P2A(51),P1A(51),P2E(51),P1E(51),EF2(51),    CAN 0481
     2EF1(51),Q2(51),Q1(51),PR(51),PE(51),E,XMU,K,ITITLE(24),V2(51),PI, CAN 0482
     3ITAPE,JTAPE,CIND,AAA,XMI,XPI,V1(51),V16(51),V17(51),V18(51),V19(51CAN 0483
     4),V20(51),V22(51),B12(51),S2(51),V25(51),C1(51),V51(51),V52(51),  CAN 0484
     5V53(51),V54(51),C2(51),C3(51),C4(51),PSI2(51),E7(51),E8(51),E9(51)CAN 0485
     6,E10(51),E11(51),E12(51),U2(51),DEF2(51),XM2(51),XP2(51),U1(51),  CAN 0486
     7DEF1(51),XM3(51),XP3(51),XM5(51),XP4(51),H1(51),H2(51),RS2(51),   CAN 0487
     8RS1(51),AB1(51),AB2(51),AX1(51),AX2(51),TI(51),XP5(51),XM4(51),   CAN 0488
     9 LCL, DEL(51),HP1(51),HP2(51),HL1(51),HL2(51),HA(51),R1U(51)      CAN 0489
      COMMON AXA(51),SI1(51),SI2(51),SI3(51),DR(51),RSA(51),IPAGE,LGPH, CAN 0490
     1LEXT,V21(51),R11(50),R12(50),T1(51),T2(51)                        CAN 0491
      EQUIVALENCE  (P1A,E7,XM2),(P2A,E8,XP2),(P1E,E9,U1),(P2E,E10,U2),  CAN 0492
     1(EF1,E11,DEF1),(EF2,E12,DEF2),(Q1,C1,XP3),(Q2,C2,XM3),(C3,XP4),   CAN 0493
     2(C4,XP5),(B12,XM4),(PSI2,XM5),(T1,RS1),(T2,RS2),(V16,DEL),(V17,DR)CAN 0494
     3,(V18,HP1,H1),(V19,HP2,H2),(V20,HL1,AX1),(V22,HL2,AX2),(V51,AXA), CAN 0495
     4(V52,RSA),(V53,SI2),(V54,SI1),(V25,HA),(TI,SI3)                   CAN 0496
      J=K+1                                                             CAN 0497
      DO 101 I=1,J                                                      CAN 0498
      IF(I-1) 4,4,43                                                    CAN 0499
43    IF(I-J) 44,2,2                                                    CAN 0500
44    W1=R1(I)-R2(I)                                                    CAN 0501
      W2=R1(I-1)-R2(I-1)                                                CAN 0502
      IF(W1-W2) 4,4,2                                                   CAN 0503
2     N1=1                                                              CAN 0504
15    L=I-1                                                             CAN 0505
3     W1=R9(L)**2 - R10(L)**2                                           CAN 0506
      W2=PR(L)*R10(L)**2 - PE(L)*R9(L)**2                               CAN 0507
      W3=R9(L)**2 * R10(L)**2 *(PR(L)-PE(L))                            CAN 0508
5     HP1(I)=(W2+W3/R1(L)**2)/W1                                        CAN 0509
      R1U(I)=N1                                                         CAN 0510
      RS1(I)=-PR(L)                                                     CAN 0511
      W4= TI(L)/(R1(L)-R(L))                                            CAN 0512
      GO TO (23,24),N1                                                  CAN 0513
23    AB1(I)=-XM2(L)/W4                                                 CAN 0514
      DR(I)=(S2(L)*2.*R(L))/(R1(L)**2-R2(L)**2)                         CAN 0515
      GO TO 7                                                           CAN 0516
24    AB1(I)=-XM3(L)/W4                                                 CAN 0517
      IF(I-1) 7,7,13                                                    CAN 0518
13    DR(I)=(S2(L-1)*R(L-1)*2.)/(R1(L)**2-R2(L)**2)                     CAN 0519
      GO TO 7                                                           CAN 0520
4     N1=2                                                              CAN 0521
      L=I                                                               CAN 0522
      GO TO 3                                                           CAN 0523
7     HP2(I)=(W2 + W3/R2(L)**2)/W1                                      CAN 0524
      W4= TI(L)/(R(L)-R2(L))                                            CAN 0525
      RS2(I)=-PE(L)                                                     CAN 0526
      GO TO (25,26),N1                                                  CAN 0527
26    AB2(I)= XM3(L)/W4                                                 CAN 0528
      GO TO 30                                                          CAN 0529
25    AB2(I)= XM2(L)/W4                                                 CAN 0530
30    GO TO (14,17),N1                                                  CAN 0531
14    W1=U2(L)*E -V25(L)                                                CAN 0532
16    W2= XPI *R9(L)**2 + XMI* R(L)**2                                  CAN 0533
      HL1(I)=( (W1*(R9(L)**2 + R1(L)**2))/ (W2*R1(L)**2)  )*R(L)        CAN 0534
      GO TO 18                                                          CAN 0535
17    W1= U1(L)*E-V25(L)                                                CAN 0536
      GO TO 16                                                          CAN 0537
18    W2= XPI* R10(L)**2 + XMI* R(L)**2                                 CAN 0538
101   HL2(I)=((W1*( R10(L)**2 + R2(L)**2))/ (W2*R2(L)**2) )*R(L)        CAN 0539
      DR(1)=ADR                                                         CAN 0540
      DR(J)= S2(K)/(PI*(R1(K)**2-R2(K)**2))                             CAN 0541
      DR(J)=DR(J)*2.*PI*R(K)                                            CAN 0542
      DO 100 I=1,J                                                      CAN 0543
68    H1(I)= HP1(I)+HL1(I)                                              CAN 0544
      H2(I)= HP2(I)+HL2(I)                                              CAN 0545
      HA(I)=(H1(I)+H2(I))/2.                                            CAN 0546
      AX1(I)= AB1(I)+ DR(I)                                             CAN 0547
      AX2(I)= AB2(I)+ DR(I)                                             CAN 0548
      AXA(I)=(AX1(I)+AX2(I))/2.                                         CAN 0549
100   RSA(I)=(RS2(I)+RS1(I))/2.                                         CAN 0550
      DO 1 I=1,J                                                        CAN 0551
      W1=ABSF(RS1(I)-H2(I))                                             CAN 0552
      W2= ABSF(H2(I)-AX2(I))                                            CAN 0553
      W3= ABSF(AX2(I)-RS1(I))                                           CAN 0554
50    IF(W1-W2) 51,51,52                                                CAN 0555
51    IF(W2-W3) 53,53,54                                                CAN 0556
52    IF(W1-W3) 53,53,55                                                CAN 0557
53    SI2(I)=W3                                                         CAN 0558
      GO TO 56                                                          CAN 0559
54    SI2(I)=W2                                                         CAN 0560
      GO TO 56                                                          CAN 0561
55    SI2(I)=W1                                                         CAN 0562
56    W1 = ABSF(RS2(I) - H1(I))                                         CAN 0563
      W2 = ABSF(H1 (I) -AX1(I))                                         CAN 0564
      W3 = ABSF(AX1(I) -RS2(I))                                         CAN 0565
      IF(W1-W2) 57,57,58                                                CAN 0566
57    IF(W2-W3) 59,59,60                                                CAN 0567
58    IF(W1-W3) 59,59,61                                                CAN 0568
59    SI1(I) =W3                                                        CAN 0569
      GO TO 62                                                          CAN 0570
60    SI1(I) =W2                                                        CAN 0571
      GO TO 62                                                          CAN 0572
61    SI1(I) =W1                                                        CAN 0573
62    W1= ABSF(RSA(I)-HA(I))                                            CAN 0574
      W2= ABSF(HA(I)-AXA(I))                                            CAN 0575
      W3= ABSF(AXA(I)-RSA(I))                                           CAN 0576
      IF(W1-W2) 63,63,64                                                CAN 0577
63    IF(W2-W3) 65,65,66                                                CAN 0578
64    IF(W1-W3) 65,65,67                                                CAN 0579
65    SI3(I)=W3                                                         CAN 0580
      GO TO 1                                                           CAN 0581
67    SI3(I)=W1                                                         CAN 0582
      GO TO 1                                                           CAN 0583
66    SI3(I)=W2                                                         CAN 0584
1     CONTINUE                                                          CAN 0585
      W2=E*PI                                                           CAN 0586
      DEL(1)=0.                                                         CAN 0587
      DO 41 I=1,K                                                       CAN 0588
      DEL(I+1)=(S2(I)*V2(I))/((R1(I)**2-R2(I)**2)*W2)                   CAN 0589
      DEL(I+1)  =DEL(I+1)*10.**6                                        CAN 0590
      DEL(I+1)=DEL(I+1)*6.2831854*R(I)                                  CAN 0591
41    DEL(I+1)= DEL(I+1)+DEL(I)                                         CAN 0592
      DO 200 I=1,K                                                      CAN 0593
      U1(I)=U1(I)*10.**6                                                CAN 0594
      U2(I)=U2(I)*10.**6                                                CAN 0595
      DEF1(I)=DEF1(I)*10.**6                                            CAN 0596
200   DEF2(I)=DEF2(I)*10.**6                                            CAN 0597
      RETURN                                                            CAN 0598
      END                                                               CAN 0599
      SUBROUTINE OUTPUT                                                 CAN 0600
C PRINTS THE OUTPUT                                                     CAN 0601
      COMMONV30(51),V31(51),V32(51)                                     CAN 0602
