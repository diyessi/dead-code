     1 7HPRIMARY 9X, 9HSECONDARY/3X,7HNUMBERS 16X,                      CAN 0680
     2 6HRADIAL 11X, 4HHOOP 10X, 8H(DIRECT) 8X, 9H(BENDING) //)         CAN 0681
      GO TO(4028,4031),NSTR                                             CAN 0682
4028  WRITE OUTPUT TAPE JTAPE,5011,RS1(1),H2(1)                         CAN 0683
5011  FORMAT(3X,5HSTART 4X,6HINSIDE 6X, F8.0,8X,F8.0 )                  CAN 0684
      WRITE OUTPUT TAPE JTAPE,5015,RS2(1),H1(1)                         CAN 0685
5015  FORMAT(12X, 7HOUTSIDE 5X,F8.0,8X,F8.0)                            CAN 0686
      WRITE OUTPUT TAPE JTAPE,5013,RSA(1),HA(1) ,DR(1)                  CAN 0687
5012  FORMAT(12X,7HOUTSIDE 5X,F8.0,8X,F8.0,24X,F8.0 )                   CAN 0688
5013  FORMAT(12X,7HAVERAGE 5X,F8.0, 2F16.0 //)                          CAN 0689
      NSTR=2                                                            CAN 0690
      NF=2                                                              CAN 0691
      MC=MC+4                                                           CAN 0692
      NK=K  +1                                                          CAN 0693
4031  DO 4033 I=NF,NK                                                   CAN 0694
      I=I                                                               CAN 0695
      IP=I-1                                                            CAN 0696
      MC=MC+4                                                           CAN 0697
4018  IF(MC-44) 4026,4026,4013                                          CAN 0698
4026   IF(I-NK) 4065,4035,4035                                          CAN 0699
4065  KI=R1U(I)                                                         CAN 0700
      GO TO (4024,4019),KI                                              CAN 0701
4019  WRITE OUTPUT TAPE JTAPE,5014,IP,I,RS1(I),H2(I),AB2(I)             CAN 0702
      GO TO 4020                                                        CAN 0703
4024  WRITE OUTPUT TAPE JTAPE,5040,IP,I,RS1(I),H2(I),AB2(I)             CAN 0704
4020  WRITE OUTPUT TAPE JTAPE,5012,RS2(I),H1(I),AB1(I)                  CAN 0705
4033  WRITE OUTPUT TAPE JTAPE,5013,RSA(I),HA(I),DR(I)                   CAN 0706
5014  FORMAT(2X,I2,2H -I2,1H* 3X, 6HINSIDE 6X,F8.0,8X,F8.0,24X,F8.0 )   CAN 0707
5040  FORMAT(2X,I2,2H*-I2,    4X, 6HINSIDE 6X,F8.0,8X,F8.0,24X,F8.0 )   CAN 0708
5017  FORMAT(3X,3HEND 6X,6HINSIDE 6X,F8.0,8X,F8.0)                      CAN 0709
4035  WRITE OUTPUT TAPE JTAPE,5017,RS1(K+1),H2(K+1)                     CAN 0710
      WRITE OUTPUT TAPE JTAPE,5015,RS2(K+1),H1(K+1)                     CAN 0711
      WRITE OUTPUT TAPE JTAPE,5013,RSA(K+1),HA(K+1)  ,DR(K+1)           CAN 0712
      KPART=4                                                           CAN 0713
      NSTR=1                                                            CAN 0714
      MC=MC+8                                                           CAN 0715
      NF=1                                                              CAN 0716
      IF(MC-37) 4037,4037,4105                                          CAN 0717
4037  WRITE OUTPUT TAPE JTAPE,5020                                      CAN 0718
5020  FORMAT(// 5X, 6HPART D  //)                                       CAN 0719
      WRITE OUTPUT TAPE JTAPE,5021                                      CAN 0720
5021  FORMAT(53X,18HSTRESS INTENSITIES /41X,6HINSIDE 10X,7HOUTSIDE 9X,  CAN 0721
     18HMEMBRANE /3X 4HCYL. 5X,10HLOCATION             6X,1H3 12X,7HCOMPCAN 0722
     2ARE 9X,7HCOMPARE 9X,7HCOMPARE /3X,7HNUMBERS 16X,                  CAN 0723
     3   5HAXIAL 10X,9HW/S SUB P 7X,9HW/S SUB P 7X,9HW/S SUB M //)      CAN 0724
      GO TO (4038,4040),NSTR                                            CAN 0725
4038  WRITE OUTPUT TAPE JTAPE,5022,       AX2(1),SI2(1)                 CAN 0726
5022  FORMAT(3X,5HSTART 4X,6HINSIDE 6X,F8.0,8X,F8.0 )                   CAN 0727
5023  FORMAT(12X,7HOUTSIDE 5X,F8.0,24X, F8.0 )                          CAN 0728
5024  FORMAT(12X,7HAVERAGE 5X,F8.0,40X, F8.0 //)                        CAN 0729
      NSTR=2                                                            CAN 0730
4040  DO 4042 I=NF,NK                                                   CAN 0731
      MC=MC+4                                                           CAN 0732
      I=I                                                               CAN 0733
      IP=I-1                                                            CAN 0734
      IF(I-1) 4039,4039, 4066                                           CAN 0735
4066  IF(MC-44) 4041,4041,4013                                          CAN 0736
4041   IF (I-NK)4029,4043,4043                                          CAN 0737
4043  WRITE OUTPUT TAPE JTAPE,5026,AX2(I),SI2(I)                        CAN 0738
       GO TO 4039                                                       CAN 0739
4029  KI =R1U(I)                                                        CAN 0740
      GO TO (4051,4050),KI                                              CAN 0741
4050  WRITE OUTPUT TAPE JTAPE,5025,IP,I,       AX2(I),SI2(I)            CAN 0742
      GO TO 4039                                                        CAN 0743
4051  WRITE OUTPUT TAPE JTAPE,5050,IP,I,       AX2(I),SI2(I)            CAN 0744
4039  WRITE OUTPUT TAPE JTAPE,5023,       AX1(I),SI1(I)                 CAN 0745
4042  WRITE OUTPUT TAPE JTAPE,5024,AXA(I),SI3(I)                        CAN 0746
5025  FORMAT(2X,I2,2H -I2,1H* 3X,6HINSIDE 6X,F8.0,8X,F8.0 )             CAN 0747
5050  FORMAT(2X,I2,2H*-I2,    4X,6HINSIDE 6X,F8.0,8X,F8.0 )             CAN 0748
5026  FORMAT(3X,3HEND 6X,6HINSIDE 6X,F8.0,8X,F8.0 )                     CAN 0749
