     1R8(50),R9(50),R10(50),P2A(51),P1A(51),P2E(51),P1E(51),EF2(51),    CAN 0604
     2EF1(51),Q2(51),Q1(51),PR(51),PE(51),E,XMU,K,ITITLE(24),V2(51),PI, CAN 0605
     3ITAPE,JTAPE,CIND,AAA,XMI,XPI,V1(51),V16(51),V17(51),V18(51),V19(51CAN 0606
     4),V20(51),V22(51),B12(51),S2(51),V25(51),C1(51),V51(51),V52(51),  CAN 0607
     5V53(51),V54(51),C2(51),C3(51),C4(51),PSI2(51),E7(51),E8(51),E9(51)CAN 0608
