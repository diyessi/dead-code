*      FAP     LOGF,LOG2F,LOG10F   KAHAN   01/05/64   (41.2)    V(1,2/1)LOGS0000
       COUNT  81                                                        LOGS0010
       ENTRY  LOG            LOGF(X)=NATURAL LOG(ABSF(X)).              LOGS0020
       ENTRY  LOG10          LOG10F(X) FOR BASE 10.                     LOGS0030
       ENTRY  LOG2           LOG2F(X) FOR BASE 2.                       LOGS0040
 LOG   LDQ    XCAE                                                      LOGS0050
       TRA    START                                                     LOGS0060
 LOG10 LDQ    XCA10                                                     LOGS0070
       TRA    START                                                     LOGS0080
 LOG2  LDQ    EXIT           X IN AC , SWITCH IN MQ.                    LOGS0090
 START STQ    SWTCH                                                     LOGS0100
       LGR    27             X = (2**E)*F, SEPARATE E AND F.            LOGS0110
       TQP    ZERO           TEST FOR UNNORMALIZED F.                   LOGS0120
       STA    O233X          STORE (128+E)                              LOGS0130
       CLA    O200                                                      LOGS0140
       LGL    27             FLOAT F IN AC.                             LOGS0150
       CAS    RTHAF          COMPARE F WITH 0.5**0.5.                   LOGS0160
       TRA    BIG                                                       LOGS0170
       TRA    BIG                                                       LOGS0180
       FSB    HALF           F IS LESS THAN 0.5**0.5.                   LOGS0190
       STO    T              = F-0.5 EXACTLY.                           LOGS0200
       FAD    ONE                                                       LOGS0210
       STO    Z              = F+0.5.                                   LOGS0220
       CLS    F201           TO REPLACE E BY E-1.                       LOGS0230
       TRA    FAD                                                       LOGS0240
 BIG   FSB    ONE            F EXCEEDS 0.5**0.5.                        LOGS0250
       STO    T              = F-1.0 EXACTLY.                           LOGS0260
       FAD    TWO                                                       LOGS0270
       STO    Z              = F+1.0.                                   LOGS0280
       CLS    F200                                                      LOGS0290
 FAD   FAD    O233X                                                     LOGS0300
       STO    E              E (OR E-1 ) FLOATED.                       LOGS0310
       CLA    T                                                         LOGS0320
       FDH    Z                                                         LOGS0330
       STQ    T              = T/Z                                      LOGS0340
       FMP    T                                                         LOGS0350
       STO    Z              = T*T                                      LOGS0360
       FSB    D                                                         LOGS0370
       STO    TEMP                                                      LOGS0380
       CLS    C                                                         LOGS0390
       FDH    TEMP                                                      LOGS0400
 XCAE  XCA    LN2                                                       LOGS0410
       ACL    B              AC = B + C/(D-Z)                           LOGS0420
 XCA10 XCA    LG2                                                       LOGS0430
       FMP    Z                                                         LOGS0440
       FAD    A                                                         LOGS0450
       FRN                                                              LOGS0460
       XCA                                                              LOGS0470
       FMP    T                                                         LOGS0480
       FRN                                                              LOGS0490
       FAD    E                                                         LOGS0500
       FRN                   LOG2F(X)=E+T*(A+Z*(B+C/(D-Z))).            LOGS0510
 SWTCH HTR    SWTCH          SWITCH WAS SET BY START.                   LOGS0520
       FMP*   SWTCH          MULTIPLY LOG2F(X) BY LN2 OR LOG2.          LOGS0530
       FRN                   AC= LOG(X) TO DESIRED BASE.                LOGS0540
 EXIT  TRA    1,4                                                       LOGS0550
 ZERO  CLS    INFY           IF X=0.0 OR IS UNNORMALIZED,               LOGS0560
       STO    OVFLO          LOG = -INFINITY WITH OVERFLOW.             LOGS0570
       TRA    1,4                                                       LOGS0580
 O233X OCT    233000000000                                              LOGS0590
 O200  OCT    200                                                       LOGS0600
 HALF  DEC    0.5                                                       LOGS0610
 RTHAF DEC    .7071067812                                               LOGS0620
 ONE   DEC    1.0                                                       LOGS0630
 TWO   DEC    2.0                                                       LOGS0640
 F201  OCT    233000000201                                              LOGS0650
 D     DEC    1.394720122                                               LOGS0660
 F200  OCT    233000000200                                              LOGS0670
 B     DEC    .1569752406B8                                             LOGS0680
 C     DEC    1.122500919                                               LOGS0690
 INFY  OCT    377777777777   = 1.7014E38                                LOGS0700
 A     OCT    202561250731   = 2.885390081615                           LOGS0710
 LN2   OCT    200542710277   =.693147180560 = LOG(2) BASE E.            LOGS0720
 LG2   OCT    177464202324   =.3010299956 = LOG(2) BASE10.              LOGS0730
       COMMON -1                                                        LOGS0740
 OVFLO COMMON 1                                                         LOGS0750
       COMMON -206           LOG2 TAKES 145 CYCLES (7090),              LOGS0760
 T     COMMON 1              LOG AND LOG10 TAKE 161.                    LOGS0770
 E     COMMON 1              69 LOCATIONS + 4 ERASABLE COMMON.          LOGS0780
 Z     COMMON 1                                                         LOGS0790
 TEMP  COMMON 1              V. KAHAN MAR. 1964                         LOGS0800
       END                                                              LOGS0810
