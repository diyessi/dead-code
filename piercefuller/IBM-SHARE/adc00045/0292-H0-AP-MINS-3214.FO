       COUNT   220                                                      MINS0001
* MINSEK - MINIMUM SEEKING SUBROUTINE                                   MINS0002
       ENTRY   MINSEK                                                   MINS0003
 ONE   PZE     1                                                        MINS0004
 TWO   DEC     2.0                                                      MINS0005
 TEN   DEC     10.0                                                     MINS0006
 LIMIT PZE     1800                                                     MINS0007
 ITER  PZE                                                              MINS0008
 JUMP  PZE                                                              MINS0009
 HOLD  PZE                                                              MINS0010
 VAL1  PZE                                                              MINS0011
 VAL2  PZE                                                              MINS0012
 TAG   PZE                                                              MINS0013
 COUNT PZE                                                              MINS0014
 SAVSI PZE                                                              MINS0015
 SAVSL PZE                                                              MINS0016
 SENSE BES     4                                                        MINS0017
MINSEK SXA     RET+9,1              SAVE INDEX REGISTERS                MINS0018
       SXA     RET+10,2                                                 MINS0019
       SXA     RET+11,4                                                 MINS0020
       STI     SAVSI                SAVE SENSE INDICATORS               MINS0021
       PXA     0,0                                                      MINS0022
       PAX     0,1                                                      MINS0023
       SLT     4,1                  TEST SENSE LIGHTS                   MINS0024
       ADD     ONE                                                      MINS0025
       ALS     1                                                        MINS0026
       TXI     *+1,1,1                                                  MINS0027
       TXL     *-4,1,3                                                  MINS0028
       ARS     1                                                        MINS0029
       STO     SAVSL                SAVE SENSE LIGHTS                   MINS0030
       CLA     1,4                  STORE ADDRESS OF NO. OF DIMENSIONS  MINS0031
       STA     LOOP1-1                                                  MINS0032
       STA     EVAL1+3                                                  MINS0033
       STA     LOOP4+7                                                  MINS0034
       STA     EVAL2+3                                                  MINS0035
       CLA     3,4                  STORE ADDRESS OF LOWER BOUNDARIES   MINS0036
       ADD     ONE                                                      MINS0037
       STA     LOOP1+1                                                  MINS0038
       STA     LOOP1+7                                                  MINS0039
       STA     LOOP4+12                                                 MINS0040
       STA     DOWN+2                                                   MINS0041
       STA     DOWN+7                                                   MINS0042
       CLS*    1,4                  STORE ADDRESS OF UPPER BOUNDARIES   MINS0043
       ARS     18                                                       MINS0044
       ADD     ONE                                                      MINS0045
       ADD     3,4                                                      MINS0046
       STA     LOOP1                                                    MINS0047
       STA     LOOP4+9                                                  MINS0048
       STA     UP+2                                                     MINS0049
       STA     UP+8                                                     MINS0050
       CLA     4,4                  STORE ADDRESS OF COORDINATE TABLE   MINS0051
       STA     EVAL1+2                                                  MINS0052
       STA     EVAL2+2                                                  MINS0053
       ADD     ONE                                                      MINS0054
       STA     LOOP1+8                                                  MINS0055
       STA     LOOP4+8                                                  MINS0056
       STA     UP+5                                                     MINS0057
       STA     DOWN+8                                                   MINS0058
       STA     EVAL2+20                                                 MINS0059
       STA     EVAL2+23                                                 MINS0060
       STA     CHECK+11                                                 MINS0061
       STA     CHECK+14                                                 MINS0062
       CLS*    1,4                  LOCATE ADDRESS OF MINIMUM VALUE     MINS0063
       ARS     18                                                       MINS0064
       ADD     4,4                                                      MINS0065
       STA     RET-1                                                    MINS0066
       CLA*    2,4                  LOAD XR2 WITH NO. OF ITERATIONS     MINS0067
       PDX     0,2                                                      MINS0068
       LXA     ONE,1                STORE ZEROS IN SI STORAGE           MINS0069
       STZ     SENSE,1                                                  MINS0070
       TXI     *+1,1,1                                                  MINS0071
       TXL     *-2,1,4                                                  MINS0072
       LXD     0,1                                                      MINS0073
 LOOP1 CLA     0,1                  DETERMINE JUMP SIZE FROM BOUNDARIES MINS0074
       FSB     0,1                                                      MINS0075
       CAS     JUMP                                                     MINS0076
       STO     JUMP                                                     MINS0077
       NOP                                                              MINS0078
       FDP     TWO                                                      MINS0079
       XCA                                                              MINS0080
       FAD     0,1                  DETERMINE INITIAL CO-ORDINATES      MINS0081
       STO     0,1                                                      MINS0082
       TIX     LOOP1,1,1                                                MINS0083
       LGL     36                                                       MINS0084
       CLA     JUMP                                                     MINS0085
       FDP     TEN                                                      MINS0086
       STQ     JUMP                                                     MINS0087
 EVAL1 TSX     $SHOOT,4             DETERMINE INITIAL VALUE             MINS0088
       TSX     VAL1                 FUNCTION VALUE                      MINS0089
       TSX                          COORDINATE TABLE                    MINS0090
       TSX                          NO. OF DIMENSIONS                   MINS0091
 LOOP4 STZ     ITER                                                     MINS0092
       CLA     ONE                                                      MINS0093
       STO     TAG                                                      MINS0094
       PAX     0,4                                                      MINS0095
       LDI     SENSE-1                                                  MINS0096
       STZ     COUNT                                                    MINS0097
       SXA     OUT+6,4                                                  MINS0098
       LXD     0,1                                                      MINS0099
       CLA     0,1                  TEST FOR BOUNDARIES                 MINS0100
       CAS     0,1                                                      MINS0101
       NOP                                                              MINS0102
       TRA     DOWN                                                     MINS0103
       CAS     0,1                                                      MINS0104
       TRA     *+3                                                      MINS0105
       NOP                                                              MINS0106
       TRA     UP                                                       MINS0107
       ONT     TAG                  DETERMINE DIRECTION OF LAST MOVE    MINS0108
       TRA     DOWN                                                     MINS0109
 UP    FAD     JUMP                 INCREASE XI                         MINS0110
       FRN                                                              MINS0111
       CAS     0,1                  TEST FOR UPPER BOUNDARY             MINS0112
       TRA     *+4                                                      MINS0113
       NOP                                                              MINS0114
       STO     0,1                                                      MINS0115
       TRA     EVAL2                                                    MINS0116
       STO     HOLD                                                     MINS0117
       CLA     0,1                                                      MINS0118
       SLN     4                                                        MINS0119
       TRA     *-5                                                      MINS0120
 DOWN  FSB     JUMP                 DECREASE XI                         MINS0121
       FRN                                                              MINS0122
       CAS     0,1                  TEST FOR LOWER BOUNDARY             MINS0123
       TRA     *+5                                                      MINS0124
       TRA     *+4                                                      MINS0125
       STO     HOLD                                                     MINS0126
       SLN     4                                                        MINS0127
       CLA     0,1                                                      MINS0128
       STO     0,1                                                      MINS0129
       SLN     1                                                        MINS0130
 EVAL2 TSX     $SHOOT,4                                                 MINS0131
       TSX     VAL2                 FUNCTION VALUE                      MINS0132
       TSX                          COORDINATE TABLE                    MINS0133
       TSX                          NO. OF DIMENSIONS                   MINS0134
       CLA     ITER                                                     MINS0135
       ADD     ONE                                                      MINS0136
       STO     ITER                                                     MINS0137
       SLT     1                                                        MINS0138
       TRA     CHECK                                                    MINS0139
       CLA     VAL2                 TEST FOR DECREASED FUNCTION VALUE   MINS0140
       CAS     VAL1                                                     MINS0141
       TRA     *+5                                                      MINS0142
       TRA     *+4                                                      MINS0143
       STO     VAL1                                                     MINS0144
       RIS     TAG                  RESET SENSE INDICATOR               MINS0145
       TRA     OUT                                                      MINS0146
       SLT     4                                                        MINS0147
       TRA     *+3                                                      MINS0148
       CLA     HOLD                                                     MINS0149
       TRA     *+2                                                      MINS0150
       CLA     0,1                                                      MINS0151
       FAD     JUMP                                                     MINS0152
       FRN                                                              MINS0153
       STO     0,1                  RESTORE ORIGINAL XI VALUE           MINS0154
       OFT     TAG                                                      MINS0155
       TRA     OUT+3                                                    MINS0156
       TRA     UP                                                       MINS0157
 CHECK CLA     VAL2                 TEST FOR DECREASED FUNCTION VALUE   MINS0158
       CAS     VAL1                                                     MINS0159
       TRA     *+5                                                      MINS0160
       TRA     *+4                                                      MINS0161
       STO     VAL1                                                     MINS0162
       OSI     TAG                  SET SENSE INDICATOR                 MINS0163
       TRA     OUT                                                      MINS0164
       SLT     4                                                        MINS0165
       TRA     *+3                                                      MINS0166
       CLA     HOLD                                                     MINS0167
       TRA     *+2                                                      MINS0168
       CLA     0,1                                                      MINS0169
       FSB     JUMP                                                     MINS0170
       FRN                                                              MINS0171
       STO     0,1                  RESTORE ORIGINAL XI VALUE           MINS0172
       ONT     TAG                                                      MINS0173
       TRA     OUT+3                                                    MINS0174
       TRA     DOWN                                                     MINS0175
 OUT   CLA     COUNT                                                    MINS0176
       ADD     ONE                                                      MINS0177
       STO     COUNT                                                    MINS0178
       CAL     TAG                                                      MINS0179
       PBT                                                              MINS0180
       TRA     *+6                                                      MINS0181
       AXT     0,4                  RESTORE XR 4                        MINS0182
       STI     SENSE,4              STORE SI WORD                       MINS0183
       LDI     SENSE-1,4            LOAD NEW SI WORD                    MINS0184
       CAL     ONE                                                      MINS0185
       TXI     *+2,4,1                                                  MINS0186
       ALS     1                                                        MINS0187
       SLW     TAG                                                      MINS0188
       SLT     4                    MAKE SURE SENSE LIGHT 4 IS OFF      MINS0189
       NOP                                                              MINS0190
       SLT     1                    DITTO FOR SENSE LIGHT 1             MINS0191
       NOP                                                              MINS0192
       TIX     LOOP4+8,1,1                                              MINS0193
       NZT     COUNT                TEST FOR NO IMPROVED COORDINATES    MINS0194
       TRA     *+5                                                      MINS0195
       CLA     LIMIT                                                    MINS0196
       CAS     ITER                                                     MINS0197
       TRA     LOOP4+1                                                  MINS0198
       NOP                                                              MINS0199
       LGL     36                                                       MINS0200
       CLA     JUMP                 REDUCE JUMP SIZE                    MINS0201
       FDP     TEN                                                      MINS0202
       STQ     JUMP                                                     MINS0203
       TIX     LOOP4,2,1                                                MINS0204
       CLA     VAL1                 STORE MINIMUM FUNCTION VALUE        MINS0205
       STO     0                                                        MINS0206
 RET   LDI     SAVSI                RESTORE SENSE INDICATORS            MINS0207
       AXT     3,1                                                      MINS0208
       CLA     SAVSL                                                    MINS0209
       LBT                                                              MINS0210
       SLN     4,1                  RESTORE SENSE LIGHTS                MINS0211
       ARS     1                                                        MINS0212
       TXH     *+2,1,0                                                  MINS0213
       TRA     *+2                                                      MINS0214
       TXI     *-5,1,-1                                                 MINS0215
       AXT     0,1                  RESTORE INDEX REGISTERS             MINS0216
       AXT     0,2                                                      MINS0217
       AXT     0,4                                                      MINS0218
       TOV     *+1                  TURN OFF OVERFLOW INDICATOR         MINS0219
       TRA     5,4                                                      MINS0220
       END                                                              MINS0221
