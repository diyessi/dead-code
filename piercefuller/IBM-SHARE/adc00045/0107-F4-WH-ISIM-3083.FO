*      FAP                                                              20700000
*SIMEQ SIMULTANEOUS LINEAR EQUATION SUBROUTINE, REVISED WH 57           SIMQ0000
       COUNT  120                                                       SIMQ0010
       LBL    SIMEQ,X                                                   SIMQ0020
       ENTRY ISIMEQ                                                     SIMQ0040
*            REVISION OF WH57 (SIMULTANEOUS EQUATION SUBROUTINE) TO     SIMQ0050
*            OPERATE IN THE 7090 FORTRAN MONITOR. USE IS MADE OF THE    SIMQ0060
*            STANDARD ERROR ROUTINE FOR SINGULARITY.                    SIMQ0070
*            CALLING SEQUENCE -- CALL ISIMEQ(A,M,N,N1)                  SIMQ0080
*                                                                       SIMQ0090
ISIMEQ SXD   *-2,4                                                      SIMQ0130
       CAL   1,4        INITIALIZE MATRIX REFERENCES                    SIMQ0140
       ADM   *-1                                                        SIMQ0150
       STA   2A                                                         SIMQ0160
       STA   4A                                                         SIMQ0170
       STA   7A                                                         SIMQ0180
       STA   9A                                                         SIMQ0190
       STA   14A                                                        SIMQ0200
       STA   16A                                                        SIMQ0210
       STA   17A                                                        SIMQ0220
       STA   61A                                                        SIMQ0230
       CLA*  2,4        FIRST DIMENSION OF MATRIX                       SIMQ0240
       STD   11A                                                        SIMQ0250
       STD   18A                                                        SIMQ0260
       CLS*  3,4        ORDER OF COEFFICIENT MATRIX                     SIMQ0270
       STO   N                                                          SIMQ0280
       STD   5A                                                         SIMQ0290
       SBM*  4,4        NUMBER OF VECTORS TO BE SOLVED                  SIMQ0300
       ADM   1B17                                                       SIMQ0310
       XCA                                                              SIMQ0320
       MPY*  2,4                                                        SIMQ0330
       ALS   17                                                         SIMQ0340
       STD   12A                                                        SIMQ0350
       STD   19A                                                        SIMQ0360
       STZ   ICP        COUNTER FOR END OF PREVIOUS COLUMN              SIMQ0370
       PXD   0,0                                                        SIMQ0380
 1A    SBM   1B17                                                       SIMQ0390
       STO   I          DIAGONAL COUNTER                                SIMQ0400
       SBM   ICP                                                        SIMQ0410
       PDX   0,4                                                        SIMQ0420
       PXA   0,4                                                        SIMQ0430
       SBM   2A                                                         SIMQ0440
       STA   3A         ADDRESS OF DIAGONAL ELEMENT                     SIMQ0450
 2A    CLA   **,4       FIND MAXIMUM ABSOLUTE VALUE ELEMENT IN COLUMN   SIMQ0460
       STO   Z                                                          SIMQ0470
       SXA   6A,4                                                       SIMQ0480
       TXI   5A,4,1                                                     SIMQ0490
 3A    PXD   0,0                                                        SIMQ0500
 4A    SBM   **,4                                                       SIMQ0510
       ADM   Z                                                          SIMQ0520
       TMI   2A                                                         SIMQ0530
       TXI   *+1,4,1                                                    SIMQ0540
 5A    TXL   3A,4,**    TEST FOR END OF COLUMN                          SIMQ0550
       NZT   Z          TEST MAXIMUM ELEMENT                            SIMQ0560
       TRA   22A        SINGULAR                                        SIMQ0570
 6A    AXT   **,4                                                       SIMQ0580
       PXA   0,4                                                        SIMQ0590
       ADM   3A                                                         SIMQ0600
       STA   8A                                                         SIMQ0610
       STA   10A                                                        SIMQ0620
*             FILLER                                                    SIMQ0630
       CLA*   8A                                                        SIMQ0640
 61A   STO   **,4                                                       SIMQ0650
 11A   TXI   *+1,4,**                                                   SIMQ0660
 7A    CLA   **,4       DIVIDE MAX ELEMENT ROW                          SIMQ0670
 8A    LDQ   **,4                              BY MAX ELEMENT           SIMQ0680
 9A    STQ   **,4                                             AND       SIMQ0690
       FDP   Z          SWITCH THIS ROW WITH                            SIMQ0700
 10A   STQ   **,4                            CURRENT DIAGONAL ROW       SIMQ0710
 12A   TXL   11A,4,**   TEST FOR END OF ROW                             SIMQ0720
       PXD   0,0                                                        SIMQ0730
 13A   SBM   1B17                                                       SIMQ0740
       CAS   I                                                          SIMQ0750
       TRA   *+2                                                        SIMQ0760
       TRA   21A        SKIP DIAGONAL ELEMENT WHICH IS NOW 1.           SIMQ0770
       STO   J          ELEMENT COUNTER                                 SIMQ0780
       SBM   ICP                                                        SIMQ0790
       PDX   0,4                                                        SIMQ0800
 14A   CLS   **,4       ELEMENT TO BE TRANSFORMED TO 0.                 SIMQ0810
       TZE   20A        ALREADY 0.                                      SIMQ0820
       STO   Z                                                          SIMQ0830
       PXA   0,4                                                        SIMQ0840
       ADM   3A                                                         SIMQ0850
       STA   15A                                                        SIMQ0860
 18A   TXI   *+1,4,**                                                   SIMQ0870
 15A   LDQ   **,4       TRANSFORM NON-DIAGONAL MEMBERS                  SIMQ0880
       FMP   Z          OF THE DIAGONAL COLUMN                          SIMQ0890
 16A   FAD   **,4       TO ZERO BY                                      SIMQ0900
 17A   STO   **,4       ELEMENTARY ROW OPERATIONS WITH DIAGONAL ROW     SIMQ0910
 19A   TXL   18A,4,**   TEST FOR END OF ROW                             SIMQ0920
 20A   CLA   J                                                          SIMQ0930
 21A   LDQ   N                                                          SIMQ0940
       TLQ   13A                                                        SIMQ0950
       CLS   ICP                                                        SIMQ0960
       SBM   11A                                                        SIMQ0970
       STD   ICP                                                        SIMQ0980
       SBM   N                                                          SIMQ0990
       STD   5A                                                         SIMQ1000
       CLA   I                                                          SIMQ1010
       TLQ   1A         TEST FOR END OF TRANSFORMATION                  SIMQ1020
       LXD   ISIMEQ-2,4                                                 SIMQ1030
       TRA   5,4                                                        SIMQ1040
 22A   CALL  ERROR,BCD                                                  SIMQ1050
       TRA    22A-2                                                     SIMQ1060
 1B17  DEC   1B17                                                       SIMQ1070
 BCD   BCI   5,COEFFICIENT MATRIX IS SINGULAR                           SIMQ1080
       OCT   777777777777                                               SIMQ1090
       COMMON -206                                                      SIMQ1100
 N     COMMON 1                                                         SIMQ1110
 I     COMMON 1                                                         SIMQ1120
 J     COMMON 1                                                         SIMQ1130
 Z     COMMON 1                                                         SIMQ1140
 ICP   COMMON 1                                                         SIMQ1150
       END                                                              SIMQ1160
