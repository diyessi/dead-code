*     FAP                                                               DATAN001
       TITLE                                                            DATAN002
       LBL     DATAN                                                    DATAN003
       COUNT   120                                                      DATAN004
*      U. OF CHICAGO DOUBLE PRECISION ARCTANGENT PROGRAM                DATAN005
*           1. DATAN ACCEPTS ONE DOUBLE PRECISION ARGUMENT AT CELLS     DATAN006
*                32767, 32766 AND GIVES THE ANSWER AT SAME CELLS.       DATAN007
*           2. DATAN2 ACCEPTS A PAIR OF DOUBLE PRECISION ARGUMENTS,     DATAN008
*                ABSCISSA X AT CELLS 32765, 32764 AND ORDINATE Y AT     DATAN009
*                CELLS 32767, 32766.   ITS ANSWER IS ARCTAN (Y/X),      DATAN010
*                RANGE -PI TO PI, AND IS GIVEN AT CELLS 32767, 32766.   DATAN011
*           3. ALL THE ARGUMENTS MUST HAVE NORMALIZED LEADING PART      DATAN012
       SPACE                                                            DATAN013
       ENTRY   DATAN2                                                   DATAN014
       ENTRY   DATAN                                                    DATAN015
       SPACE                                                            DATAN016
DATAN2 DLD     4)-3                                                     DATAN017
       XCA                                                              DATAN018
       TNZ     BB            IF X IS NOT ZERO, SKIP AND PROCEED         DATAN019
       CLA     4)                                                       DATAN020
       TZE     1,4           IF BOTH X AND Y ARE ZERO, GIVE ZERO ANSWER DATAN021
  AA   LDQ     PIOV2         IF ONLY X IS ZERO, ANSWER IS + OR -PI/2    DATAN022
       LRS     0               DEPENDING ON SIGN OF Y                   DATAN023
       CLA     PIOV2+1                                                  DATAN024
       LLS     0                                                        DATAN025
       DST     4)-1                                                     DATAN026
       TRA     1,4                                                      DATAN027
  BB   DST     BUFF          NOW X IS NOT ZERO                          DATAN028
       ACL     CH54            =O66000000000                            DATAN029
       SLW     TEST                                                     DATAN030
       DLD     4)-1                                                     DATAN031
       XCA                                                              DATAN032
       LAS     TEST            IF Y IS GREATER THAN X*2**54 IN ABSOLUTE DATAN033
       TRA     AA                VALUE, TREAT AS IF X WERE 0 TO AVOID   DATAN034
       TRA     AA                DIVIDE OVERFLOW                        DATAN035
       SPACE                                                            DATAN036
       STI     SVIND         NON-TRIVIAL CIRCUIT STARTS                 DATAN037
       SXA     SAVE4,4                                                  DATAN038
       DFDP    BUFF          COMPUTE Y/X AND GO TO DATAN CIRCUIT        DATAN039
       TSX     DATAN+3,4                                                DATAN040
       DST     BUFF          COME BACK FROM DATAN                       DATAN041
       LDQ     4)-2                                                     DATAN042
       TQP     SAVE4           IF X IS POSITIVE, ANS IS READY           DATAN043
       TPL     *+3             IF X IS NEGATIVE, SUBTRACT OR ADD PI     DATAN044
       DLD     PI                 DEPENDING ON THE SIGN OF DATAN ANSWER DATAN045
       TRA     *+3                                                      DATAN046
       DLD     PI                                                       DATAN047
       CHS                                                              DATAN048
       DFAD    BUFF                                                     DATAN049
       XCA                                                              DATAN050
       DST     4)-1                                                     DATAN051
 SAVE4 AXT     **,4                                                     DATAN052
       LDI     SVIND                                                    DATAN053
       TRA     1,4                                                      DATAN054
       SPACE   2                                                        DATAN055
 DATAN STI     SVIND          ENTRY FOR SINGLE ARGUMENT ATAN            DATAN056
       DLD     4)-1                                                     DATAN057
       XCA                                                              DATAN058
       SXA     SAVE1,1                                                  DATAN059
       STO     TEST          USED FOR SIGN CONTROL ONLY.   THEN FORCE   DATAN060
       SSP                     SIGN TO BE +                             DATAN061
       DST     ARG                                                      DATAN062
       ARS     9                                                        DATAN063
       PDX     ,1                                                       DATAN064
       TXL     *+3,1,182                                                DATAN065
       DLD     PIOV2         IF ARG IS GREATER THAN 2**54 GIVE + OR -   DATAN066
       TRA     SIGN            PI/2 AS ANS                              DATAN067
       DLD     ARG                                                      DATAN068
       TXL     SIGN,1,101    IF ARG IS SMALLER THAN 2**(-27), ANS=ARG   DATAN069
       SPACE                                                            DATAN070
       TXL     A,1,128                                                  DATAN071
       DLD     ONE           IF ARG IS GREATER THAN 1, TAKE INVERSE     DATAN072
       DFDP    ARG                                                      DATAN073
       AXT     4,1             FROM NOW ON XR1 DISTINGUISHES CASES      DATAN074
       TRA     *+2                                                      DATAN075
       SPACE                                                            DATAN076
   A   AXT     0,1                                                      DATAN077
       CAS     TAN15                                                    DATAN078
       TXI     *+3,1,2                                                  DATAN079
       TRA     B                                                        DATAN080
       TRA     B                                                        DATAN081
       DST     ARG           IF MODIFIED ARG, SAY X, IS GREATER THAN    DATAN082
       DFAD    RTTHR           TAN(PI/12), COMPUTE TAN(Z) WHERE         DATAN083
       DST     BUFF              TAN(Z+PI/6) = X                        DATAN084
       DLD     ARG                                                      DATAN085
       DFMP    RT3M1           TAN(Z) = (X*SQRT3-1)/(X+SQRT3)           DATAN086
       DFSB    HALF                                                     DATAN087
       DFSB    HALF            COMPUTE NUMERATOR WITH CARE              DATAN088
       DFAD    ARG               TO PRESERVE ACCURACY                   DATAN089
       DFDP    BUFF                                                     DATAN090
       SPACE                                                            DATAN091
   B   DST     ARG           NOW ARG IS REDUCED TO LESS THAN TAN(PI/12) DATAN092
       DFMP    ARG             IN ABSOLUTE VALUE                        DATAN093
       DST     SQ                                                       DATAN094
       DFAD    B2                                                       DATAN095
       DFMP    SQ                                                       DATAN096
       DFAD    B1              ATAN(X) = X(1+F*SQ)  WHERE               DATAN097
       DFMP    SQ                                                       DATAN098
       DFAD    B0                      A1+A2*SQ+A3*X**4                 DATAN099
       DST     BUFF              F = ---------------------              DATAN100
       DLD     A3                    B0+B1*SQ+B2*X**4+X**6              DATAN101
       DFMP    SQ                                                       DATAN102
       DFAD    A2                                                       DATAN103
       DFMP    SQ                                                       DATAN104
       DFAD    A1                                                       DATAN105
       DFDP    BUFF                                                     DATAN106
       DFMP    SQ                                                       DATAN107
       DFMP    ARG                                                      DATAN108
       DFAD    ARG                                                      DATAN109
       TXL     *+2,1,2       DEPENDING ON SECTION, ADD OR SUBTRACT      DATAN110
       CHS                     REDUCED ANS FROM PROPER BASE ANGLE       DATAN111
       DFAD    ZERO,1                                                   DATAN112
       SPACE                                                            DATAN113
 SIGN  STQ     BUFF          AFFIX PROPER SIGN AND RETURN TO EITHER     DATAN114
       LDQ     TEST            MAIN PROGRAM OR DATAN2 CIRCUIT           DATAN115
       LLS     0                                                        DATAN116
       LDQ     BUFF                                                     DATAN117
       LRS     0                                                        DATAN118
       STO     4)                                                       DATAN119
       STQ     4)-1                                                     DATAN120
 SAVE1 AXT     **,1                                                     DATAN121
       LDI     SVIND                                                    DATAN122
       TRA     1,4                                                      DATAN123
       SPACE                                                            DATAN124
 TEST  BSS     1                                                        DATAN125
 CH54  OCT     66000000000                                              DATAN126
 TAN15 OCT     177422302430                    TAN (PI/12)              DATAN127
       EVEN                                                             DATAN128
  PI   OCT     202622077325,147042055061       PI                       DATAN129
  ONE  OCT     201400000000,146000000000       1.0                      DATAN130
 HALF  OCT     200400000000,145000000000       1/2                      DATAN131
 RTTHR OCT     201673317272,146054114525       SQRT 3                   DATAN132
 RT3M1 OCT     200566636564,145130231252       SQRT 3 - 1               DATAN133
  A1   OCT     -203421330610,-150745116031    -.4272240218374929+1      DATAN134
  A2   OCT     -203421364025,-150211120715    -.4273072556727334+1      DATAN135
  A3   OCT     -200626553444,-145520472151    -.7943556655753299        DATAN136
  B0   OCT     204632105115,151327574341       .1281672065512814+2      DATAN137
  B1   OCT     205510113615,152445456710       .2050925006232764+2      DATAN138
  B2   OCT     204446206747,151475551631       .9195736839833352+1      DATAN139
       OCT     201414052216,146026563313       PI/3                     DATAN140
 PIOV2 OCT     201622077325,146042055061       PI/2                     DATAN141
       OCT     200414052216,145026563313       PI/6                     DATAN142
 ZERO  OCT     0,0                                                      DATAN143
  ARG  BSS     2                                                        DATAN144
  SQ   BSS     2                                                        DATAN145
 BUFF  BSS     2                                                        DATAN146
 SVIND BSS     1                                                        DATAN147
   4)  EQU     -1                                                       DATAN148
       END                                                              DATAN149
