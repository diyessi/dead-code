1138 CARDC     DCW  'C *'                                                  SCIP3
1139 LTC       EQU  CARDC-2                                                SCIP3
1140 CARDD     DCW  'D *'                                                  SCIP3
1141 LTD       EQU  CARDD-2                                                SCIP3
1142 CARDS     DCW  'S *'                                                  SCIP3
1143 LTS       EQU  CARDS-2                                                SCIP3
1144 CARDZ     DCW  '0 *'                                                  SCIP3
1145 LTZ       EQU  CARDZ-2                                                SCIP3
