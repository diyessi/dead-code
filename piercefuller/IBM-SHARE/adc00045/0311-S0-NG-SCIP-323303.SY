1106 *******************************************************************   SCIP3
1107 HEAD1     EQU  *+1                                                    SCIP3
1108           DCW  'SCIP   '                                              SCIP3
1109           DC   =2                                                     SCIP3
1110 HDDATE    DCW  =12       DATE MOVED FROM CONTROL CARD-HOUSEKEEPING.   SCIP3
1111           DCW  =8                                                     SCIP3
1112           DCW  '** CAPR  EXCEPTION  LISTING **'                       SCIP3
1113           DCW  =20                                                    SCIP3
