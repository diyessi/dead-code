1096 *******************************************************************   SCIP3
1097 TRAIL     DCW  1                                                      SCIP3
1098           DC   'EOR '                                                 SCIP3
1099 BCOUNT    DCW  =5                 BLOCKCOUNT                          SCIP3
1100 BLANKS    EQU  *+1                                                    SCIP3
1101           DCW  =50                                                    SCIP3
1102           DC   =20                                                    SCIP3
1103           DCW  '⯒'       THIS IS A GROUP MARK.                        SCIP3
1104 *******************************************************************   SCIP3
