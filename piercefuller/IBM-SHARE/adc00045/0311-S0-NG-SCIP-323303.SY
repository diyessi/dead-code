1040 CPLANG         149       PRINCIPAL SOURCE LANGUAGE             B 12   SCIP3
1041 CSLANG         156       SECONDARY SOURCE LANGUAGE             B 13   SCIP3
1042 CROUT          158       TYPE ROUTINE                          B 14   SCIP3
1043 CMACH          165       MACHINE                               B 15   SCIP3
1044 CMONIT         172       MONITOR OR OPERATING SYSTEM           B 16   SCIP3
1045 CREQ           173,184   SPECIAL MACHINE REQUIREMENTS          C 17   SCIP3
1046 CNONLB         200       NON-LIBRARY ROUTINES OR SUBR. REQUIREDC 18   SCIP3
1047                203       NOT USED                                     SCIP3
1048 CDOC12         204,213   DOCUMENTATION AVAILABLE               C 19   SCIP3
1049                215       NOT USED                                     SCIP3
1050 CDOC3          216,220   DOCUMENTATION AVAILABLE               C 19   SCIP3
1051 CMAT1          221,248   PRIMARY FORM,COUNT,MEDIUM             D 20   SCIP3
1052 CMAT2          276       SECONDARY FORM,COUNT,MEDIUM           D 21   SCIP3
1053 CTITLE         277,333   TITLE                                 0  8   SCIP3
1054 CSERCH         337,399   SEARCH KEY                            S 22   SCIP3
1055 CEND           424       NOT USED                                     SCIP3
