*     LABEL                                                             LAMI2180
*     LIST8                                                             LAMI2190
      SUBROUTINE PIVOT(IA,IP)                                           LAMI2200
      COMMON I,II,IVAL,IP,IX,IZ,J,K,M,N,NM,R1,R3,R4,R5,RR,RW,ZEROT      LAMI2210
      COMMON MR,NR                                                      LAMI2220
D     DIMENSION R1(200),R3(200),R4(200),R5(200),RR(200,2),RW(200,2)     LAMI2230
      DIMENSION MR(200),NR(200)                                         LAMI2240
      GO TO (10,1),IA                                                   LAMI2250
    1 AMAX=0.                                                           LAMI2260
      IF(II-1)48,46,48                                                  LAMI2270
   46 DO 47 L=1,N                                                       LAMI2280
      MR(L)=0                                                           LAMI2290
   47 NR(L)=0                                                           LAMI2300
   48 DO 4 L=1,NM                                                       LAMI2310
D     R3(L)=RW(L,K)                                                     LAMI2320
      IF(L-N)49,49,4                                                    LAMI2330
   49 IF(NR(L))4,2,4                                                    LAMI2340
    2 IF(AMAX-ABSF(RW(L,K)))3,4,4                                       LAMI2350
    3 AMAX=ABSF(RW(L,K))                                                LAMI2360
      LL=L                                                              LAMI2370
    4 CONTINUE                                                          LAMI2380
      NR(LL)=II                                                         LAMI2390
      MR(II)=LL                                                         LAMI2400
      IP=LL                                                             LAMI2410
      IF(II-1)6,5,6                                                     LAMI2420
    5 AM=1.                                                             LAMI2430
    6 IF(AMAX/AM-ZEROT)7,7,8                                            LAMI2440
    7 CALL SING                                                         LAMI2450
    8 AM=AMAX                                                           LAMI2460
      RETURN                                                            LAMI2470
   10 IF(K1)45,11,45                                                    LAMI2480
   11 NS=N/5                                                            LAMI2490
      NREST=N-5*NS                                                      LAMI2500
      IF(NREST)13,13,12                                                 LAMI2510
   12 NS=NS+1                                                           LAMI2520
   13 MM=N+1                                                            LAMI2530
      JA=1                                                              LAMI2540
      DO 44 IS=1,NS                                                     LAMI2550
      CALL WAITRD                                                       LAMI2560
      J=1                                                               LAMI2570
      CALL BINRD                                                        LAMI2580
      K=3-K                                                             LAMI2590
      DO 36 J=1,N                                                       LAMI2600
      CALL WAITRD                                                       LAMI2610
      IF(J-N)14,15,15                                                   LAMI2620
   14 J=J+1                                                             LAMI2630
      CALL BINRD                                                        LAMI2640
      J=J-1                                                             LAMI2650
   15 K=3-K                                                             LAMI2660
   25 IF(IS-NS)28,26,28                                                 LAMI2670
   26 IF(NREST)27,28,27                                                 LAMI2680
   27 KS=NREST                                                          LAMI2690
      GO TO 29                                                          LAMI2700
   28 KS=5                                                              LAMI2710
   29 DO 36 KL=1,KS                                                     LAMI2720
      JT=JA+KL-1                                                        LAMI2730
      IF(MR(J)-JT)36,30,36                                              LAMI2740
   30 DO 56 L=1,NM                                                      LAMI2750
      IF(L-N)16,16,17                                                   LAMI2760
   17 I=L                                                               LAMI2770
      GO TO 18                                                          LAMI2780
   16 I=NR(L)                                                           LAMI2790
   18 GO TO (31,32,33,34,35),KL                                         LAMI2800
   31 KKK=K                                                             LAMI2810
D     RW(I,KKK)=RR(L,K)                                                 LAMI2820
      GO TO 56                                                          LAMI2830
D  32 R1(I)=RR(L,K)                                                     LAMI2840
      GO TO 56                                                          LAMI2850
D  33 R3(I)=RR(L,K)                                                     LAMI2860
      GO TO 56                                                          LAMI2870
D  34 R4(I)=RR(L,K)                                                     LAMI2880
      GO TO 56                                                          LAMI2890
D  35 R5(I)=RR(L,K)                                                     LAMI2900
   56 CONTINUE                                                          LAMI2910
   36 CONTINUE                                                          LAMI2920
      KK=K                                                              LAMI2930
      K=KKK                                                             LAMI2940
      JJ=J                                                              LAMI2950
      DO 42 KL=1,KS                                                     LAMI2960
      DO 41 L=1,NM                                                      LAMI2970
      GO TO (41,37,38,39,40),KL                                         LAMI2980
D  37 RW(L,K)=R1(L)                                                     LAMI2990
      GO TO 41                                                          LAMI3000
D  38 RW(L,K)=R3(L)                                                     LAMI3010
      GO TO 41                                                          LAMI3020
D  39 RW(L,K)=R4(L)                                                     LAMI3030
      GO TO 41                                                          LAMI3040
D  40 RW(L,K)=R5(L)                                                     LAMI3050
   41 CONTINUE                                                          LAMI3060
      J=JA+KL-1                                                         LAMI3070
      CALL BINWR                                                        LAMI3080
   42 K=3-K                                                             LAMI3090
      K=KK                                                              LAMI3100
      J=JJ                                                              LAMI3110
   43 CALL WAITWR                                                       LAMI3120
   44 JA=JA+5                                                           LAMI3130
      IVAL=3-IVAL                                                       LAMI3140
   45 RETURN                                                            LAMI3150
      END                                                               LAMI3160
*     LABEL                                                             LAMI3170
*     LIST8                                                             LAMI3180
      SUBROUTINE MOVE                                                   LAMI3190
      COMMON I,II,IVAL,IP,IX,IZ,J,K,M,N,NM,R1,R3,R4,R5,RR,RW,ZEROT      LAMI3200
      COMMON MR,NR                                                      LAMI3210
D     DIMENSION R1(200),R3(200),R4(200),R5(200),RR(200,2),RW(200,2)     LAMI3220
      DIMENSION MR(200),NR(200)                                         LAMI3230
D     R1(IP)=1./R3(IP)                                                  LAMI3240
      DO 2 L=1,NM                                                       LAMI3250
      IF(L-IP)1,2,1                                                     LAMI3260
D   1 R1(L)=R3(L)/R3(IP)                                                LAMI3270
    2 CONTINUE                                                          LAMI3280
      RETURN                                                            LAMI3290
      END                                                               LAMI3300
*     LABEL                                                             LAMI3310
*     LIST8                                                             LAMI3320
      SUBROUTINE SCAN                                                   LAMI3330
      COMMON I,II,IVAL,IP,IX,IZ,J,K,M,N,NM,R1,R3,R4,R5,RR,RW,ZEROT      LAMI3340
      COMMON MR,NR                                                      LAMI3350
D     DIMENSION R1(200),R3(200),R4(200),R5(200),RR(200,2),RW(200,2)     LAMI3360
      DIMENSION MR(200),NR(200)                                         LAMI3370
      J=1                                                               LAMI3380
      CALL BINRD                                                        LAMI3390
      IZ=1                                                              LAMI3400
      I=1                                                               LAMI3410
      II=1                                                              LAMI3420
      KK=0                                                              LAMI3430
      CALL WAITRD                                                       LAMI3440
       DO 1 L=1,NM                                                      LAMI3450
D   1 RW(L,K)=RR(L,K)                                                   LAMI3460
      CALL TEST(KK,IZ,1)                                                LAMI3470
      REWIND 2                                                          LAMI3480
      REWIND 4                                                          LAMI3490
      IP=KK                                                             LAMI3500
      CALL MOVE                                                         LAMI3510
      RETURN                                                            LAMI3520
      END                                                               LAMI3530
*     LABEL                                                             LAMI3540
*     LIST8                                                             LAMI3550
      SUBROUTINE SING                                                   LAMI3560
D     DIMENSION R1(200),R3(200),R4(200),R5(200),RR(200,2),RW(200,2)     LAMI3570
      DIMENSION RRID(2),RWID(2),FMT(10),CORR(20)                        LAMI3580
      COMMON R1,R3,R4,R5,RR,RW,RRID,RWID,I,II,J,N,NM,M,K,IP,IX,IVAL,FMT,LAMI3590
     1KK,IZ,K1,K3,IB,R1ID,R3ID,R4ID,R5ID                                LAMI3600
      WRITE OUTPUT TAPE 6,1,I                                           LAMI3610
      PRINT 1,I                                                         LAMI3620
    1 FORMAT(///41H  MATRIX SINGULAR OR ILL CONDITIONED.  I=I3///)      LAMI3630
      CALL EXIT                                                         LAMI3640
      END                                                               LAMI3650
