       ENTRY   ARS                                                              
       ENTRY   XARS                                                             
       ENTRY   ALS                                                              
       ENTRY   XALS                                                             
       ENTRY   LLS                                                              
       ENTRY   XLLS                                                             
       ENTRY   LRS                                                              
       ENTRY   XLRS                                                             
       ENTRY   EXOR                                                             
       ENTRY   XEXOR                                                            
ARS    ARS     18                                                               
       STA     *+2                                                              
       XCL                                                                      
       ARS     **                                                               
       TRA     1,4                                                              
ALS    ARS     18                                                               
       STA     *+1                                                              
       LGL     **                                                               
       XCA                                                                      
       TRA     1,4                                                              
LRS    ARS     18                                                               
       STA     *+3                                                              
       XCL                                                                      
       LDQ     TEMP                                                             
       LRS     **                                                               
       STQ     TEMP                                                             
       TRA     1,4                                                              
LLS    ARS     18                                                               
       STA     *+3                                                              
       XCL                                                                      
       LDQ     TEMP                                                             
       LLS     **                                                               
       STQ     TEMP                                                             
       TRA     1,4                                                              
EXOR   STQ     TEMP                                                             
       ERA     TEMP                                                             
       TRA     1,4                                                              
TEMP   OCT     0                                                                
XARS   SYN     ARS                                                              
XALS   SYN     ALS                                                              
XLLS   SYN     LLS                                                              
XLRS   SYN     LRS                                                              
XEXOR  SYN     EXOR                                                             
       END                                                                      
