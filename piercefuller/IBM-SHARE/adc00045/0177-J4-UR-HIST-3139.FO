*     LABEL                                                             HIST0000
*     FORTRAN                                                           HIST0001
CHIST                                                                   HIST0002
       SUBROUTINE HIST(NXT,RCT,XZERO,XWDTH)                             HIST0003
C          SUBROUTINE FOR GRAPHS OF HISTOGRAMS                          HIST0004
C                                                                       HIST0005
C  RCT IS THE VECTOR WHICH IS TO BE GRAPHED, IT MUST BE OF LENGTH 210 OR LESS 06
C   EACH CELL IN THE VECTOR MAY BE OF ANY REASONABLE HEIGHT             HIST0007
C   WHEN THE VECTOR CONTAINS CELLS WHICH WOULD RESULT IN HISTOGRAM COLUMNS  0008
C    MORE THAN A PAGE IN LENGTH, EACH VALUE OF THE VECTOR IS DIVIDED BY TWO   09
C                                                                       HIST0010
C    FRACTIONAL VALUES ARE THEN PLOTTED DISTINGUISHABLY AS FOLLOWS      HIST0011
C                                                     STEPS  X.S.       HIST0012
C                                                                       HIST0013
C     (INTGR+.51) TO (INTGR+.99)  (E.G. .75) GIVES    +11+    H         HIST0014
C     (INTGR+.5)                  (E.G. .50)GIVES     ++++    H         HIST0015
C     (INTGR+.01) TO (INTGR+.49)  (E.G. .25) GIVES    +..+              HIST0016
C    NEGATIVE VALUES (NEGATIVE FREQUENCIES) SHOULD NOT BE USED, SINCE ALTHO   17
C     PLOTTED AS ZERO, THEY WOULD PRODUCE ERRONEOUS VALUES              HIST0018
C     FOR THE MEAN (WHICH IS INDICATED BY THE LETTER M UNDER THE GRAPH) HIST0019
C                                                                       HIST0020
C    RCT(1) IS PLOTTED AS IF IT HELD THE DATA VALUES LYING BETWEEN 0 AND 1  0021
C    RCT(2) THE VALUES GREATER THAN 1 AND LESS THAN OR EQUAL TO 2, ETC. HIST0022
C                                                                       HIST0023
C  NXT IS THE TOTAL NUMBER OF CELLS IN THE VECTOR, IF NXT IS LESS THAN NUM3S  24
C   THEN THE HISTOGRAMS WILL CONSIST OF THREE COLUMN WIDE BARS          HIST0025
C   IF NXT IS GREATER THAN NUM3S, THE HISTOGRAM BARS WILL CONSIST OF SINGLE   26
C   COLUMNS OF THE LETTER X                                             HIST0027
C                                                                       HIST0028
C      XZERO AND  XWDTH HELP DEFINE THE LABLING OF THE COLUMNS ALONG    HIST0029
C     THE BOTTOM OF THE GRAPH                                           HIST0030
C                                                                       HIST0031
C  IF NXT IS NEGATIVE, THE HISTOGRAM WILL CONSIST OF UN-FILLED COLUMNS  HIST0032
C     IF NXWDTH IS NEGATIVE, THE NUMBER OF BINS WILL BE HALVED TO ALLOW HIST0033
C     3 COLUMN WIDE BARS WHEN NXT IS GREATER THAN 35, BUT LESS THAN 71. HIST0034
C                                                                       HIST0035
      DIMENSION RCT(212),SHT(120),FMT1(8),FMT2(8),FMT3(8),NXL(24)       HIST0036
      DIMENSION BASE(120)                                               HIST0037
      EQUIVALENCE (BASE,SHT)                                            HIST0038
C                                                                       HIST0039
      IF(IRL-1111)109,120,109                                           HIST0040
  109 IF(IRL-1) 110,120,110                                             HIST0041
  110 CONTINUE                                                          HIST0042
C                                                                       HIST0043
C      CONSTANTS DETERMINING HEIGHT AND WIDTH OF PAGE FORMAT            HIST0044
      HEIGHT=58.0                                                       HIST0045
      WIDTH=119.0                                                       HIST0046
      NUM1S=WIDTH-13.0                                                  HIST0047
      NUM3S=NUM1S/3                                                     HIST0048
      NBW=WIDTH-8.0                                                     HIST0049
C                                                                       HIST0050
C     WORDS FOR GENERATING FORMATS WHICH PRINT Y-AXIS SCALE             HIST0051
      FMT1(1)=(+1H()                                                    HIST0052
      FMT1(2)=(+6H1H I3,)                                               HIST0053
      FMT1(3)=(+4H2H -)                                                 HIST0054
      FMT1(4)=(+3H1H*)                                                  HIST0055
      FMT1(5)=(+3H1X,)                                                  HIST0056
      FMT1(6)=(+6H106A1,)                                               HIST0057
C       THE FIGURE 106A1 MUST BE CHANGED  IF THE -WIDTH- OF PAGE CHANGESHIST0058
      FMT1(7)=(+4H2H *)                                                 HIST0059
      FMT1(8)=(+3HI3))                                                  HIST0060
C                                                                       HIST0061
C     SYMBOLS FOR USE IN BUILDING THE FORMAT MATRIX (SHT)               HIST0062
      FX=(+1HX)                                                         HIST0063
      FB=(+1H )                                                         HIST0064
      FM=(+1H-)                                                         HIST0065
      FI=(+1H1)                                                         HIST0066
      FD=(+1H.)                                                         HIST0067
      FP =(+1H+)                                                        HIST0068
      FH=(+1HH)                                                         HIST0069
C                                                                       HIST0070
       FA=(+1H*)                                                        HIST0071
      FMM=(+1HM)                                                        HIST0072
C                                                                       HIST0073
C     WORDS FOR GENERATING FORMATS WITHOUT Y-AXIS SCALE                 HIST0074
      FMT2(1)=(+1H()                                                    HIST0075
      FMT2(2)=(+3H6X,)                                                  HIST0076
      FMT2(3)=(+4H2H* )                                                 HIST0077
      FMT2(4)=(+6H106A1,)                                               HIST0078
C        THE FIGURE 106A1 MUST BE CHANGED  IF THE -WIDTH- OF PAGE CHANGES   0079
      FMT2(5)=(+4H2H *)                                                 HIST0080
      FMT2(6)=(+2H3X)                                                   HIST0081
      FMT2(7)=(+1H))                                                    HIST0082
C                                                                       HIST0083
C                                                                       HIST0084
C                                                                       HIST0085
      IRL=1111                                                          HIST0086
C                                                                       HIST0087
C     NX COUNTS HORIZONTALLY ALONG X AXIS. NZ COUNTS VERTICALLY  UP Y AXIS  0088
  120 NXTT=(NXT+1)/2                                                    HIST0089
      IF(NXT-NUM1S)125,125,121                                          HIST0090
  121 IF(NXTT-NUM1S)122,122,124                                         HIST0091
  122 DO 1231 NX=NXT,211                                                HIST0092
 1231 RCT(NX+1)=0.0                                                     HIST0093
      DO 123 NX=1,NXTT                                                  HIST0094
      NXX=NX*2                                                          HIST0095
  123 RCT(NX)=RCT(NXX)+RCT(NXX-1)                                       HIST0096
      NXT=NXTT                                                          HIST0097
      G2=2.0                                                            HIST0098
      FX=(+1H2)                                                         HIST0099
      GO TO 126                                                         HIST0100
  124 WRITE OUTPUT TAPE 6,921                                           HIST0101
  921 FORMAT(10X34HTOO MANY COLUMNS IN DATA VECTOR                )     HIST0102
      RETURN                                                            HIST0103
  125 NXTT=NUM1S                                                        HIST0104
      IF( XWDTH)1251,1255,1259                                          HIST0105
 1251 IF(NXT-NUM3S)1259,1259,1254                                       HIST0106
 1254 IF(NXTT-NUM3S)122,122,1259                                        HIST0107
 1255 XWDTH=1.0                                                         HIST0108
 1259 G2=1.0                                                            HIST0109
      FX=(+1HX)                                                         HIST0110
  126 WRITE OUTPUT TAPE 6,905                                           HIST0111
      IF(NXT) 127,128,128                                               HIST0112
 127  NSW=1                                                             HIST0113
      NXT=-NXT                                                          HIST0114
      GO TO 600                                                         HIST0115
 128  NSW=0                                                             HIST0116
C                                                                       HIST0117
C     FINDING THE MEAN                                                  HIST0118
  600 SUM=0                                                             HIST0119
      XSUM=0                                                            HIST0120
      DO 610 NX=1,NXT                                                   HIST0121
      IF(RCT(NX))610,610,605                                            HIST0122
  605 XN=NX                                                             HIST0123
      SUM=SUM+RCT(NX)                                                   HIST0124
      XSUM=XSUM + (XN-0.5)*RCT(NX)                                      HIST0125
  610 CONTINUE                                                          HIST0126
      NSUM=SUM                                                          HIST0127
  615 QM=XSUM/SUM                                                       HIST0128
C                                                                       HIST0129
C                                                                       HIST0130
  129 NC=1                                                              HIST0131
      TOP=0.0                                                           HIST0132
C                                                                       HIST0133
C     SCALING OF COUNTS IN DATA VECTOR                                  HIST0134
  130 DO 142 NX=1,NXT                                                   HIST0135
      IF(RCT(NX)) 132,131,132                                           HIST0136
  131 RCT(NX)=-2.0                                                      HIST0137
  132 CONTINUE                                                          HIST0138
       IF(RCT(NX) - TOP) 1302,1302,1301                                 HIST0139
 1301  TOP=RCT(NX)                                                      HIST0140
 1302 IF(TOP-HEIGHT+4.0) 142,142,138                                    HIST0141
  138 DO 140 NB=1,NXT                                                   HIST0142
 140  RCT(NB)=RCT(NB)/2.0                                               HIST0143
       TOP=TOP/2.0                                                      HIST0144
      NC=NC+1                                                           HIST0145
       GO TO 1302                                                       HIST0146
 142  CONTINUE                                                          HIST0147
       NTP=TOP/5.0                                                      HIST0148
      NTOP=NTP*5 + 5                                                    HIST0149
      IF(NXT-NUM3S) 400,400,155                                         HIST0150
C         THIS LAST STEP DECIDES WHETHER THE GRAPH IS TO BE MADE OF X.S HIST0151
C         OR OF FOUR CHARACTER BARS DEPENDING ON NXT AND WIDTH          HIST0152
C                                                                       HIST0153
C     SLICING OFF THE TOP OF EACH COLUMN TO BUILD FORMAT MATRIX (USING X.S.) 154
C                                                                       HIST0155
  155 DO 165 NX=1,NUM1S                                                 HIST0156
  165 SHT(NX)=FB                                                        HIST0157
       DO 300 NZ=1,NTOP                                                 HIST0158
      IF(NZ-NTOP)180,170,180                                            HIST0159
  170 DO 175 NX=1,NUM1S                                                 HIST0160
  175 SHT(NX)=FD                                                        HIST0161
  180 R=NTOP-NZ                                                         HIST0162
C                                                                       HIST0163
  200 DO 250 NX=1,NXT                                                   HIST0164
      IF(RCT(NX)-R) 250,210,204                                         HIST0165
  204 IF(RCT(NX)-R-1.0)220,205,205                                      HIST0166
  205 SHT(NX)=FX                                                        HIST0167
      GO TO 250                                                         HIST0168
  210 SHT(NX)=FX                                                        HIST0169
      GO TO 250                                                         HIST0170
  220 SHT(NX)=FH                                                        HIST0171
  250 CONTINUE                                                          HIST0172
C                                                                       HIST0173
C     PREPARATION OF Y-AXIS SCALE                                       HIST0174
      NYU=(NTOP -NZ)*2**(NC-1)                                          HIST0175
      QNY=NZ                                                            HIST0176
      NYD=NZ/5                                                          HIST0177
      QNYD=NYD                                                          HIST0178
      IF(QNY/5.0-QNYD)270,275,270                                       HIST0179
C                                                                       HIST0180
C     PRINTING THE HISTOGRAM (USING X-S)                                HIST0181
  275 WRITE OUTPUT TAPE 6,FMT1,NYU,(SHT(NX),NX=1,NUM1S),NYU             HIST0182
      GO TO 300                                                         HIST0183
  270 WRITE OUTPUT TAPE 6,FMT2,(SHT(NX),NX=1,NUM1S)                     HIST0184
  300 CONTINUE                                                          HIST0185
C                                                                       HIST0186
C     PRINTING X-AXIS SCALE UNDERNEATH THE HISTOGRAM (USING X-S)        HIST0187
  320 NPX=QM+1.5                                                        HIST0188
      JJTOP=NXT/5+2                                                     HIST0189
      DO 333 K=1,JJTOP                                                  HIST0190
      KP=5*(K-1)+1                                                      HIST0191
      BASE(KP)   =FM                                                    HIST0192
      BASE(KP+1) =FD                                                    HIST0193
      BASE(KP+3) =FD                                                    HIST0194
      BASE(KP+2) =FD                                                    HIST0195
  333 BASE(KP+4) =FD                                                    HIST0196
      NXT2=NXT+7                                                        HIST0197
      DO 335 K=NXT2,NBW                                                 HIST0198
 335  BASE(K)=FB                                                        HIST0199
      BASE(NPX)=FMM                                                     HIST0200
      WRITE OUTPUT TAPE 6,337 ,(BASE(K),K=1,NBW)                        HIST0201
  337 FORMAT(1H+6X112A1)                                                HIST0202
      DO 345 J=1,JJTOP                                                  HIST0203
      XJ=J                                                              HIST0204
  345 NXL(J)=(5.0*XJ-5.0)*G2*ABSF(XWDTH)+XZERO                          HIST0205
  347 WRITE OUTPUT TAPE 6,902,(NXL(J),J=1,JJTOP)                        HIST0206
  905 FORMAT(1H0)                                                       HIST0207
  902 FORMAT(3X22I5)                                                    HIST0208
      WRITE OUTPUT TAPE 6,931,NSUM                                      HIST0209
  931 FORMAT(102X10HTOTAL N  = I5)                                      HIST0210
  305 RETURN                                                            HIST0211
C                                                                       HIST0212
C     SLICING OFF THE TOP OF EACH COLUMN TO BUILD FORMAT MATRIX         HIST0213
C     FOR NXT LESS THAN NUM3S  (I.E. USING STEPS , NOT X.S )            HIST0214
  400 DO 500 NZ=1,NTOP                                                  HIST0215
      DO 405 NX=1,NUM1S                                                 HIST0216
  405 SHT(NX)=FB                                                        HIST0217
      IF(NZ-NTOP)409,406,409                                            HIST0218
  406 DO 408 NX=1,NUM3S                                                 HIST0219
      SHT(3*NX+1)=FM                                                    HIST0220
      SHT(3*NX)=FA                                                      HIST0221
  408 SHT(3*NX-1)=FA                                                    HIST0222
  409 R=NTOP-NZ                                                         HIST0223
      RCM=-2.0                                                          HIST0224
C                                                                       HIST0225
 410  DO 450 NX=1,NXT                                                   HIST0226
      IF(RCT(NX)-R)450,411,412                                          HIST0227
  411 NXBT=3*NX+1                                                       HIST0228
      SHT(NXBT)=FP                                                      HIST0229
      SHT(NXBT-1)=FM                                                    HIST0230
      SHT(NXBT-2)=FM                                                    HIST0231
      SHT(NXBT-3)=FP                                                    HIST0232
      GO TO 450                                                         HIST0233
  412 NXBT=3*NX+1                                                       HIST0234
      NXBT1=NXBT-1                                                      HIST0235
      NXBT2=NXBT-2                                                      HIST0236
      NXBT3=NXBT-3                                                      HIST0237
C                                                                       HIST0238
  440 IF(RCT(NX)-R-1.0)441,446,446                                      HIST0239
  441 SHT(NXBT)=FP                                                      HIST0240
      IF(RCT(NX)-R-0.5)442,443,444                                      HIST0241
  442 SHT(NXBT1)=FD                                                     HIST0242
      SHT(NXBT2)=FD                                                     HIST0243
      GO TO 445                                                         HIST0244
  443 SHT(NXBT1)=FP                                                     HIST0245
      SHT(NXBT2)=FP                                                     HIST0246
      GO TO 445                                                         HIST0247
  444 SHT(NXBT1)=FI                                                     HIST0248
      SHT(NXBT2)=FI                                                     HIST0249
  445 SHT(NXBT3)=FP                                                     HIST0250
      GO TO 450                                                         HIST0251
  446 SHT(NXBT)=FI                                                      HIST0252
      IF(NSW-1) 447,448,447                                             HIST0253
  447 SHT(NXBT1)=FM                                                     HIST0254
      SHT(NXBT2)=FM                                                     HIST0255
  448 IF(RCM-R)449,450,450                                              HIST0256
  449 SHT(NXBT3)=FI                                                     HIST0257
  450 RCM=RCT(NX)                                                       HIST0258
C                                                                       HIST0259
C     PREPARATION OF Y-AXIS SCALE                                       HIST0260
      NYU=(NTOP -NZ)*2**(NC-1)                                          HIST0261
      QNY=NZ                                                            HIST0262
      NYD=NZ/5                                                          HIST0263
      QNYD=NYD                                                          HIST0264
  460 IF(QNY/5.0-QNYD)470,475,470                                       HIST0265
C                                                                       HIST0266
C     PRINTING THE HISTOGRAM (USING STEPS)                              HIST0267
  470 WRITE OUTPUT TAPE 6,FMT2,(SHT(NX),NX=1,NUM1S)                     HIST0268
      GO TO 500                                                         HIST0269
  475 WRITE OUTPUT TAPE 6,FMT1,NYU,(SHT(NX),NX=1,NUM1S),NYU             HIST0270
  500 CONTINUE                                                          HIST0271
C                                                                       HIST0272
C     PRINTING X-AXIS SCALE UNDERNEATH HISTOGRAM(USING STEPS)           HIST0273
C                                                                       HIST0274
  510 NPX=3.0*QM + 0.5                                                  HIST0275
      NXT2=NXT+1                                                        HIST0276
      NXT22=NXT2/2+1                                                    HIST0277
      DO 512 K=1,NXT22                                                  HIST0278
      KT=6*(K-1)+1                                                      HIST0279
      KT1=KT+1                                                          HIST0280
      KT2=KT+2                                                          HIST0281
      BASE(KT)=FM                                                       HIST0282
      BASE(KT1)=FD                                                      HIST0283
      BASE(KT2)=FD                                                      HIST0284
      BASE(KT+3)=FD                                                     HIST0285
      BASE(KT+4)=FD                                                     HIST0286
  512 BASE(KT+5)=FD                                                     HIST0287
      NXT6=3*NXT2                                                       HIST0288
      BASE(NPX)=FMM                                                     HIST0289
      WRITE OUTPUT TAPE 6,517 ,(BASE(K),K=1,NXT6)                       HIST0290
  517 FORMAT(1H+7X110A1)                                                HIST0291
      JJTOP=NXT/2+1                                                     HIST0292
      DO 520 J=1,JJTOP                                                  HIST0293
      XJ=J                                                              HIST0294
  520 NXL(J)=(2.0*XJ-2.0)*G2*ABSF(XWDTH)+XZERO                          HIST0295
      WRITE OUTPUT TAPE 6,903,(NXL(J),J=1,JJTOP)                        HIST0296
  903 FORMAT(3X18I6)                                                    HIST0297
      WRITE OUTPUT TAPE 6,931,NSUM                                      HIST0298
      RETURN                                                            HIST0299
      END                                                               HIST0300
