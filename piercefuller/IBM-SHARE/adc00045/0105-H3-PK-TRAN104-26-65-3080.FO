      SUBROUTINE TRAN(IA,LB,LC,MM,NN,IOBJ,IU,IV,JE)                     TR000001
      EQUIVALENCE (IS,S),(MASK,ASK),(EIM,IM),(DEL,IDEL),(ADD,IADD)      TR000002
      COMMON IS                                                         TR000003
      DIMENSION LB(100),LC(101),IS(100,101),IV(101),IU(100),IA(100,101),TR000004
     1LU(100),LV(101),S(100,101)                                        TR000005
      EQUIVALENCE (FMLT,MLT)                                            TR000006
      NOTP=0                                                            TR000007
      IF(JE)301,301,302                                                 TR000008
  302 NOTP=JE                                                           TR000009
  301 JE=0                                                              TR000010
      M=MM                                                              TR000011
      N=NN                                                              TR000012
      ISM1=0                                                            TR000013
      ISM2=0                                                            TR000014
      DO 400 I=1,M                                                      TR000015
  400 ISM1=ISM1+LB(I)                                                   TR000016
      DO 401 J=1,N                                                      TR000017
  401 ISM2=ISM2+LC(J)                                                   TR000018
      IF(ISM1-ISM2)402,403,402                                          TR000019
  402 PRINT 404,ISM1,ISM2                                               TR000020
  404 FORMAT(13H0SUM OF B(I)=I6,14H, SUM OF C(J)=I6)                    TR000021
      JE=2                                                              TR000022
      RETURN                                                            TR000023
  407 JE=3                                                              TR000024
      RETURN                                                            TR000025
  403 CONTINUE                                                          TR000026
      NSTEP=0                                                           TR000027
      NP1=N+1                                                           TR000028
      L2=NP1                                                            TR000029
      LIMSTG=N                                                          TR000030
B     ASK=000000000077                                                  TR000031
B     ASKN=777777000000                                                 TR000032
      IOBJ=0                                                            TR000033
      NSTAGE=0                                                          TR000034
C                                                                       TR000035
C   DENNIS METHOD                                                       TR000036
      LG=32767                                                          TR000037
      DO 196 I=1,M                                                      TR000038
      IU(I)=LB(I)                                                       TR000039
      DO 196 J=1,N                                                      TR000040
  196 IS(I,J)=0                                                         TR000041
      DO 255 J=1,N                                                      TR000042
  255 IV(J)=LC(J)                                                       TR000043
      DO 262 J=1,N                                                      TR000044
  269 MIN=LG                                                            TR000045
      DO 263 I=1,M                                                      TR000046
      IF(MIN-IA(I,J))263,263,264                                        TR000047
  264 IF(IU(I))263,263,266                                              TR000048
  266 II=I                                                              TR000049
      MIN=IA(I,J)                                                       TR000050
  263 CONTINUE                                                          TR000051
      I=II                                                              TR000052
      IF(IV(J)-IU(I))267,267,268                                        TR000053
  267 IS(I,J)=IV(J)                                                     TR000054
B     S(I,J)=S(I,J)+ASK                                                 TR000055
      IU(I)=IU(I)-IV(J)                                                 TR000056
      IV(J)=0                                                           TR000057
      GO TO 262                                                         TR000058
  268 IS(I,J)=IU(I)                                                     TR000059
B     S(I,J)=S(I,J)+ASK                                                 TR000060
      IV(J)=IV(J)-IU(I)                                                 TR000061
      IU(I)=0                                                           TR000062
      GO TO 269                                                         TR000063
  262 CONTINUE                                                          TR000064
C  CALCULATE U(I) AND V(J)                                              TR000065
  500 DO 600 I=1,M                                                      TR000066
  600 LU(I)=-2                                                          TR000067
      DO 601 J=1,N                                                      TR000068
  601 LV(J)=-2                                                          TR000069
      I=1                                                               TR000070
      LU(I)=0                                                           TR000071
      IU(I)=0                                                           TR000072
  610 DO 602 J=1,N                                                      TR000073
      J=J                                                               TR000074
B     IF(S(I,J)*ASK)603,602,603                                         TR000075
  603 IF(LV(J))604,602,602                                              TR000076
  602 CONTINUE                                                          TR000077
      GO TO 631                                                         TR000078
  604 LV(J)=0                                                           TR000079
      IV(J)=IA(I,J)-IU(I)                                               TR000080
      DO 605 I=1,M                                                      TR000081
      I=I                                                               TR000082
B     IF(S(I,J)*ASK)607,605,607                                         TR000083
  607 IF(LU(I))608,605,605                                              TR000084
  605 CONTINUE                                                          TR000085
      GO TO 631                                                         TR000086
  608 LU(I)=0                                                           TR000087
      IU(I)=IA(I,J)-IV(J)                                               TR000088
      GO TO 610                                                         TR000089
  631 DO 638 I=1,M                                                      TR000090
      I=I                                                               TR000091
      IF(LU(I))638,633,633                                              TR000092
  633 DO 632 J=1,N                                                      TR000093
      J=J                                                               TR000094
B     IF(S(I,J)*ASK)640,632,640                                         TR000095
  640 IF(LV(J))604,632,632                                              TR000096
  632 CONTINUE                                                          TR000097
  638 CONTINUE                                                          TR000098
      DO 639 J=1,N                                                      TR000099
      J=J                                                               TR000100
      IF(LV(J))639,635,635                                              TR000101
  635 DO 634 I=1,M                                                      TR000102
      I=I                                                               TR000103
B     IF(S(I,J)*ASK)641,634,641                                         TR000104
  641 IF(LU(I))608,634,634                                              TR000105
  634 CONTINUE                                                          TR000106
  639 CONTINUE                                                          TR000107
  606 DO 611 J=1,N                                                      TR000108
      J=J                                                               TR000109
      IF (LV(J))612,611,611                                             TR000110
  611 CONTINUE                                                          TR000111
      DO 613 I=1,M                                                      TR000112
      I=I                                                               TR000113
      IF(LU(I))643,613,613                                              TR000114
  643 DO 642 J=1,N                                                      TR000115
      J=J                                                               TR000116
B     IF(S(I,J)*ASK)614,642,614                                         TR000117
  642 CONTINUE                                                          TR000118
  614 LU(I)=0                                                           TR000119
      IU(I)=IA(I,J)-IV(J)                                               TR000120
  613 CONTINUE                                                          TR000121
C   END OF INITIAL DUAL CALC.                                           TR000122
      GO TO 17                                                          TR000123
  612 ISWCH=1                                                           TR000124
      DO 615 I=1,M                                                      TR000125
      I=I                                                               TR000126
B     IF(S(I,J) *ASK)616,615,616                                        TR000127
  616 IF(LU(I))628,604,604                                              TR000128
  628 GO TO(617,615),ISWCH                                              TR000129
  617 ISWCH=2                                                           TR000130
      IK=I                                                              TR000131
  615 CONTINUE                                                          TR000132
      GO TO(618,619),ISWCH                                              TR000133
  618 PRINT                620,I,J                                      TR000134
  620 FORMAT(3H0I=I6,4H, J=I6)                                          TR000135
      GO TO 407                                                         TR000136
  619 I=IK                                                              TR000137
      IU(I)=0                                                           TR000138
      LU(I)=0                                                           TR000139
      GO TO 604                                                         TR000140
   17 CONTINUE                                                          TR000141
      IPL=1                                                             TR000142
      DO 622 J=1,N                                                      TR000143
      DO 622 I=1,M                                                      TR000144
B     IF(S(I,J)*ASK)623,622,623                                         TR000145
  623 IF(IA(I,J)-IU(I)-IV(J))624,622,624                                TR000146
  622 CONTINUE                                                          TR000147
      GO TO 629                                                         TR000148
  624 PRINT                625,IPL                                      TR000149
  625 FORMAT(12H0INFEASIBLE-I4)                                         TR000150
      GO TO 407                                                         TR000151
  629 CONTINUE                                                          TR000152
C                                                                       TR000153
C  CALCULATE OTHER X MATRIX ENTRIES                                     TR000154
      IMIN=0                                                            TR000155
      DO 19 J=1,N                                                       TR000156
      DO 19 I=1,M                                                       TR000157
      IF(IS(I,J))20,20,19                                               TR000158
   20 IS(I,J)=IA(I,J)-IU(I)-IV(J)                                       TR000159
      IF(IS(I,J))256,257,256                                            TR000160
  257 IS(I,J)=0                                                         TR000161
  256 CONTINUE                                                          TR000162
      IF(IMIN-IS(I,J))19,19,21                                          TR000163
   21 IMIN=IS(I,J)                                                      TR000164
      KK=I                                                              TR000165
      L1=J                                                              TR000166
   19 CONTINUE                                                          TR000167
C  IS MINIMUM ENTRY NEGATIVE                                            TR000168
      IF(IMIN)206,184,184                                               TR000169
C                                                                       TR000170
C   BEGINNING OF A STAGE L                                              TR000171
  206 CONTINUE                                                          TR000172
      NSTAGE=NSTAGE+1                                                   TR000173
      IF(LIMSTG-NSTAGE)245,246,246                                      TR000174
  245 PRINT 247,NSTAGE,LIMSTG                                           TR000175
  247 FORMAT(18H0NUMBER OF STAGES,I6,16H, EXCEEDS BOUND,I6)             TR000176
      GO TO 407                                                         TR000177
  246 CONTINUE                                                          TR000178
  241 NSTEP=0                                                           TR000179
      IV(L2)=IV(L1)                                                     TR000180
      IV(L1)=IA(KK,L1)-IU(KK)                                           TR000181
      DO 203 I=1,M                                                      TR000182
      IS(I,L2)=IS(I,L1)                                                 TR000183
      IA(I,L2)=IA(I,L1)                                                 TR000184
      IS(I,L1)=IA(I,L1)-IU(I)-IV(L1)                                    TR000185
      IF(IS(I,L1))203,258,203                                           TR000186
  258 IS(I,L1)=0                                                        TR000187
  203 CONTINUE                                                          TR000188
      ICL1=0                                                            TR000189
      ICL2=LC(L1)                                                       TR000190
      LIMSTP=M*ICL2                                                     TR000191
  254 DO 252 I=1,M                                                      TR000192
  252 LU(I)=0                                                           TR000193
      DO 253 J=1,NP1                                                    TR000194
  253 LV(J)=0                                                           TR000195
C                                                                       TR000196
C   BEGINNING OF A STEP                                                 TR000197
   22 LV(L2)=KK                                                         TR000198
      NSTEP=NSTEP+1                                                     TR000199
      IF(LIMSTP-NSTEP)248,249,249                                       TR000200
  248 PRINT 250,NSTEP,L1,LIMSTP                                         TR000201
  250 FORMAT(17H0NUMBER OF STEPS,I6,10H, IN STAGEI6,16H, EXCEEDS BOUND,ITR000202
     16)                                                                TR000203
      GO TO 407                                                         TR000204
  249 CONTINUE                                                          TR000205
C                                                                       TR000206
C   LABELLING                                                           TR000207
  125 IE=2                                                              TR000208
      DO 127 J=1,NP1                                                    TR000209
      IF(LV(J))127,127,128                                              TR000210
  128 DO 25 I=1,M                                                       TR000211
B     IF(S(I,J)*ASK)25,25,26                                            TR000212
   26 IF(LU(I))25,27,25                                                 TR000213
   27 LU(I)=J                                                           TR000214
      IE=1                                                              TR000215
   25 CONTINUE                                                          TR000216
  127 CONTINUE                                                          TR000217
      GO TO(129,126),IE                                                 TR000218
  129 IE=2                                                              TR000219
      DO 28 I=1,M                                                       TR000220
      IF(LU(I))28,28,30                                                 TR000221
   30 IF(I-KK)251,34,251                                                TR000222
  251 DO 31 J=1,NP1                                                     TR000223
B     IF(S(I,J)*ASK)202,202,32                                          TR000224
  202 IF(S(I,J))31,32,31                                                TR000225
   32 IF(LV(J))31,33,31                                                 TR000226
   33 LV(J)=I                                                           TR000227
      IE=1                                                              TR000228
   31 CONTINUE                                                          TR000229
   28 CONTINUE                                                          TR000230
      GO TO(125,126),IE                                                 TR000231
C                                                                       TR000232
C  IS U(K) LABELLED - CASE 2 OR 3                                       TR000233
  126 IF(LU(KK))34,35,34                                                TR000234
C                                                                       TR000235
C   CASE 3                                                              TR000236
   35 LT1=1                                                             TR000237
      DO 36 J=1,NP1                                                     TR000238
      DO 36 I=1,M                                                       TR000239
B     IF(S(I,J)*400000000077)36,38,36                                   TR000240
   38 IF(LU(I))36,36,37                                                 TR000241
   37 IF(LV(J))39,39,36                                                 TR000242
   39 GO TO(40,41),LT1                                                  TR000243
   40 IM=IS(I,J)                                                        TR000244
      LT1=2                                                             TR000245
      GO TO 36                                                          TR000246
   41 IF(IM-IS(I,J))36,36,42                                            TR000247
   42 IM=IS(I,J)                                                        TR000248
   36 CONTINUE                                                          TR000249
   44 IF(IM)209,209,207                                                 TR000250
  207 IF(IM+IS(KK,L2))208,208,209                                       TR000251
  209 IM=-IS(KK,L2)                                                     TR000252
B 208 EIM=EIM*ASKN                                                      TR000253
C                                                                       TR000254
   46 DO 47 I=1,M                                                       TR000255
      IF(LU(I))47,47,48                                                 TR000256
   48 IU(I)=IU(I)+IM                                                    TR000257
   47 CONTINUE                                                          TR000258
      DO 49 J=1,NP1                                                     TR000259
      IF(LV(J))49,49,50                                                 TR000260
   50 IV(J)=IV(J)-IM                                                    TR000261
   49 CONTINUE                                                          TR000262
C                                                                       TR000263
C  RECALCULATE MATRIX ENTRIES                                           TR000264
      DO 130 J=1,NP1                                                    TR000265
      DO 130 I=1,M                                                      TR000266
B     IF(S(I,J)*ASK)130,131,130                                         TR000267
  131 IS(I,J)=IA(I,J)-IU(I)-IV(J)                                       TR000268
      IF(IS(I,J))130,259,130                                            TR000269
  259 IS(I,J)=0                                                         TR000270
  130 CONTINUE                                                          TR000271
      MIN=0                                                             TR000272
      DO 210 I=1,M                                                      TR000273
      IF(IS(I,L2))211,210,210                                           TR000274
  211 IF(MIN-IS(I,L2))210,210,212                                       TR000275
  212 MIN=IS(I,L2)                                                      TR000276
      KK=I                                                              TR000277
  210 CONTINUE                                                          TR000278
      IF(MIN)254,214,214                                                TR000279
C                                                                       TR000280
C   START ANOTHER STEP IF MIN NEGATIVE                                  TR000281
C                                                                       TR000282
C   END OF STAGE                                                        TR000283
  214 CONTINUE                                                          TR000284
      IF(IV(L1)-IV(L2))215,216,215                                      TR000285
  215 PRINT 217,L1,NSTAGE                                               TR000286
  217 FORMAT(13H0END OF STAGEI6,23H. V(L1) IS NOT = V(L2).I6,8H STAGES.)TR000287
      GO TO 407                                                         TR000288
  216 DO 218 I=1,M                                                      TR000289
B     IF(S(I,L1)*ASK)219,219,220                                        TR000290
B 220 ADD=S(I,L2)*ASKN                                                  TR000291
      IS(I,L1)=IS(I,L1)+IADD                                            TR000292
      GO TO 218                                                         TR000293
B 219 IF(S(I,L2)*ASK)218,218,221                                        TR000294
  221 IS(I,L1)=IS(I,L1)+IS(I,L2)                                        TR000295
  218 CONTINUE                                                          TR000296
C                                                                       TR000297
C   END OF STAGE                                                        TR000298
  225 MIN=0                                                             TR000299
      DO 222 J=1,N                                                      TR000300
      DO 222 I=1,M                                                      TR000301
      IF(IS(I,J))223,222,222                                            TR000302
  223 IF(MIN-IS(I,J))222,222,224                                        TR000303
  224 MIN=IS(I,J)                                                       TR000304
      KK=I                                                              TR000305
      L1=J                                                              TR000306
  222 CONTINUE                                                          TR000307
      IF(MIN)206,184,184                                                TR000308
C   START A NEW STAGE IF MIN NEGATIVE                                   TR000309
C                                                                       TR000310
C                                                                       TR000311
C   CASE 2                                                              TR000312
   34 I=KK                                                              TR000313
      J=LU(I)                                                           TR000314
      IDEL=IS(I,J)                                                      TR000315
B     S(I,J)=S(I,J)+ASK                                                 TR000316
  147 I=LV(J)                                                           TR000317
      IF(I-KK)148,149,148                                               TR000318
  149 IF(J-L2)148,144,148                                               TR000319
B 148 S(I,J)=S(I,J)+ASK                                                 TR000320
      J=LU(I)                                                           TR000321
      IF(I-KK)142,143,142                                               TR000322
  143 IF(J-L2)142,144,142                                               TR000323
  142 IF(IDEL-IS(I,J))145,145,146                                       TR000324
  146 IDEL=IS(I,J)                                                      TR000325
B 145 S(I,J)=S(I,J)+ASK                                                 TR000326
      GO TO 147                                                         TR000327
B 144 DEL=DEL*ASKN                                                      TR000328
      I=KK                                                              TR000329
      J=L2                                                              TR000330
      GO TO 172                                                         TR000331
  170 IS(I,J)=IS(I,J)+IDEL                                              TR000332
B     CK=S(I,J)*ASKN                                                    TR000333
      IF(CK)172,173,172                                                 TR000334
  173 IS(I,J)=0                                                         TR000335
  172 J=LU(I)                                                           TR000336
      IF(XABSF(I-KK)+XABSF(J-L2))167,169,167                            TR000337
  167 IS(I,J)=IS(I,J)-IDEL                                              TR000338
B     CK=S(I,J)*ASKN                                                    TR000339
      IF(CK)168,171,168                                                 TR000340
  171 IS(I,J)=0                                                         TR000341
  168 I=LV(J)                                                           TR000342
      IF(XABSF(I-KK)+XABSF(J-L2))170,169,170                            TR000343
C                                                                       TR000344
  169 CONTINUE                                                          TR000345
      IS(KK,L1)=IS(KK,L1)+IDEL                                          TR000346
B     CK=S(KK,L1)*ASKN                                                  TR000347
      IF(CK)228,229,228                                                 TR000348
  229 IS(KK,L1)=0                                                       TR000349
      GO TO 230                                                         TR000350
B 228 S(KK,L1)=S(KK,L1)+ASK                                             TR000351
  230 CONTINUE                                                          TR000352
C                                                                       TR000353
      ICL1=ICL1+IDEL                                                    TR000354
      ICL2=ICL2-IDEL                                                    TR000355
      IF(ICL2)231,225,233                                               TR000356
  231 PRINT 234,ICL2                                                    TR000357
  234 FORMAT(7H0CL(2)=I6)                                               TR000358
      GO TO 407                                                         TR000359
C                                                                       TR000360
C   START A NEW STEP                                                    TR000361
  233 MIN=0                                                             TR000362
      DO 235 I=1,M                                                      TR000363
      IF(IS(I,L2))236,235,235                                           TR000364
  236 IF(MIN-IS(I,L2))235,235,237                                       TR000365
  237 MIN=IS(I,L2)                                                      TR000366
      KK=I                                                              TR000367
  235 CONTINUE                                                          TR000368
      IF(MIN)254,238,238                                                TR000369
  238 PRINT 239,L1,MIN,ICL2                                             TR000370
  239 FORMAT(6H0STAGEI6,6H. MIN=I6,8H, CL(2)=I6)                        TR000371
      GO TO 407                                                         TR000372
C                                                                       TR000373
C   END - ALL ENTRIES NON-NEGATIVE                                      TR000374
  184 DO 194 I=1,M                                                      TR000375
      DO 194 J=1,N                                                      TR000376
B     IF(S(I,J)*ASK)193,304,193                                         TR000377
  304 IS(I,J)=0                                                         TR000378
      GO TO 194                                                         TR000379
B 193 FMLT=S(I,J)*(-ASK)                                                TR000380
      IOBJ=IOBJ+MLT*IA(I,J)                                             TR000381
  194 CONTINUE                                                          TR000382
C                                                                       TR000383
C   BEGINNING OF OUTPUT                                                 TR000384
      IF(NOTP)406,406,405                                               TR000385
  405 WRITE OUTPUT TAPE NOTP,417,M,N,IOBJ                               TR000386
  417 FORMAT(3H1M=I4,4H, N=I4,21H, OBJECTIVE FUNCTION=I6///9H COLUMN J4XTR000387
     15HROW I5X6HX(I,J)5X6HA(I,J)//)                                    TR000388
      DO 409 J=1,N                                                      TR000389
      DO 409 I=1,M                                                      TR000390
      IF(IS(I,J))410,409,410                                            TR000391
  410 WRITE OUTPUT TAPE NOTP,411,J,I,IS(I,J),IA(I,J)                    TR000392
  411 FORMAT(I8,I10,2I11)                                               TR000393
  409 CONTINUE                                                          TR000394
      IDIF=N-M                                                          TR000395
      IF(IDIF)420,421,422                                               TR000396
  420 LIM=N                                                             TR000397
      LM2=M                                                             TR000398
      ISW=1                                                             TR000399
      GO TO 423                                                         TR000400
  421 ISW=2                                                             TR000401
      LIM=N                                                             TR000402
      GO TO 423                                                         TR000403
  422 LIM=M                                                             TR000404
      LM2=N                                                             TR000405
      ISW=3                                                             TR000406
  423 WRITE OUTPUT TAPE NOTP,424                                        TR000407
  424 FORMAT(15H1DUAL VARIABLES///3X4HV(J)6X13HCOL., ROW NO.6X4HU(I)//) TR000408
      LP=LIM+1                                                          TR000409
      DO 425 L=1,LIM                                                    TR000410
  425 WRITE OUTPUT TAPE NOTP,426,IV(L),L,IU(L)                          TR000411
  426 FORMAT(I7,2I14)                                                   TR000412
      GO TO(427,406,429),ISW                                            TR000413
  427 DO 430 I=LP,LM2                                                   TR000414
  430 WRITE OUTPUT TAPE NOTP,431,I,IU(I)                                TR000415
  431 FORMAT(15XI6,I14)                                                 TR000416
      GO TO 406                                                         TR000417
  429 DO 432 J=LP,LM2                                                   TR000418
  432 WRITE OUTPUT TAPE NOTP,426,IV(J),J                                TR000419
C                                                                       TR000420
C  END OF OUTPUT                                                        TR000421
  406 JE=1                                                              TR000422
      IPL=2                                                             TR000423
      DO 626 J=1,N                                                      TR000424
      DO 626 I=1,M                                                      TR000425
B     IF(S(I,J)*ASK) 627,626,627                                        TR000426
  627 IF(IA(I,J)-IU(I)-IV(J))624,626,624                                TR000427
  626 CONTINUE                                                          TR000428
      RETURN                                                            TR000429
      END                                                               TR000430
*     LABEL                                                             CP000001
*     LIST8                                                             CP000002
      DIMENSION TITLE(12),FNAM(100),IC(101),IB(100),IA(100,101),IS(100,1CP000003
     101),IU(100),IV(101),LSROW(100),IFNAM(100)                         CP000004
      EQUIVALENCE (ROWN,IROWN),(IFNAM,FNAM),(ICOLN,COLN)                CP000005
      COMMON IS                                                         CP000006
B     ASK=000000000077                                                  CP000007
      M=0                                                               CP000008
   32 READ INPUT TAPE 5,33,K,NO                                         CP000009
   33 FORMAT(I2,I6)                                                     CP000010
      JCT=0                                                             CP000011
      NROW=0                                                            CP000012
      GO TO(34,35),K                                                    CP000013
   34 NO=5                                                              CP000014
      GO TO 35                                                          CP000015
   35 READ INPUT TAPE NO,1,TITLE                                        CP000016
    1 FORMAT(12A6)                                                      CP000017
      WRITE OUTPUT TAPE  6,2,TITLE                                      CP000018
    2 FORMAT(1H112A6)                                                   CP000019
   10 READ INPUT TAPE NO,3,WD1,WD2,COLN,ROWN,VAL                        CP000020
    3 FORMAT(A1,A5,A6,A6,F12.0)                                         CP000021
      IF(WD1-6H      )4,5,4                                             CP000022
    4 IF(WD2-5HATRIX)6,7,6                                              CP000023
    6 IF(WD2-5HIRST )8,9,8                                              CP000024
    8 IF(WD2-2HOF)10,11,10                                              CP000025
C  S11 END OF INPUT                                                     CP000026
C                                                                       CP000027
    9 ISW=2                                                             CP000028
      GO TO 10                                                          CP000029
    7 ISW=1                                                             CP000030
      GO TO 10                                                          CP000031
    5 GO TO(12,13),ISW                                                  CP000032
   12 IF(JCT)14,14,15                                                   CP000033
   15 IF(IFNAM(JCT)-ICOLN)14,17,14                                      CP000034
   14 JCT=JCT+1                                                         CP000035
      FNAM(JCT)=COLN                                                    CP000036
      IC(JCT)=VAL                                                       CP000037
      GO TO 10                                                          CP000038
   17 IF(NROW)40,40,41                                                  CP000039
   41 DO 42 I=1,NROW                                                    CP000040
      II=I                                                              CP000041
