$IBMAP 5K01    100                                                      BKFL0000
       TTL     BAKFIL FLOW CHART                                        BKFL0010
       REM     BAKFIL                                                   BKFL0020
       REM      ********                                                BKFL0030
       REM      * GET  *                                                BKFL0040
       REM      * ARGS *                         *********              BKFL0050
       REM      ********                    ....X* .BSF  *              BKFL0060
       REM         .                        .    *-*-*-*-*              BKFL0070
       REM         .                        .    *       *              BKFL0080
       REM         X                        .    *********              BKFL0090
       REM         *                        .        .                  BKFL0100
       REM        * *                       .        .                  BKFL0110
       REM       *   *                      .        X                  BKFL0120
       REM      * TAP *  YES   ********     .    *********              BKFL0130
       REM     * 5,6,7 *......X*.FXEM.*     .    *.CLOSE *              BKFL0140
       REM      *     *        ********     .    *-*-*-*-*              BKFL0150
       REM        * *             X         .    *********              BKFL0160
       REM         *              .         .        .                  BKFL0170
       REM         .              .         .        .                  BKFL0180
       REM         .NO            .         .        X                  BKFL0190
       REM         X              .         .    *********              BKFL0200
       REM     ***********        .         .    *SET TO *              BKFL0210
       REM     * .IOU.F  *        .         .    * INPUT *              BKFL0220
       REM     *-*-*-*-*-* ERROR  .         .    *********              BKFL0230
       REM     * FIND    *.........         .        .                  BKFL0240
       REM     *  FILE   *                  .        .                  BKFL0250
       REM     ***********                  .        X                  BKFL0260
       REM         .                        .    **RETURN**             BKFL0270
       REM         .                        .                           BKFL0280
       REM         X                        .                           BKFL0290
       REM         *          ********      .                           BKFL0300
       REM       *   *    YES *.CLOSE*      .                           BKFL0310
       REM     * OPEN  *.....X*-*--*-*      .                           BKFL0320
       REM       *   *        *      *      .                           BKFL0330
       REM         *          ********      .                           BKFL0340
       REM         .            .           .                           BKFL0350
       REM         .NO          .           .                           BKFL0360
       REM         X.............           .                           BKFL0370
       REM         *                        .                           BKFL0380
       REM       *   *    YES  **********   .                           BKFL0390
       REM     * INPUT *......X* SET TO *   .                           BKFL0400
       REM       *   *         * OUTPUT *   .                           BKFL0410
       REM         *           **********   .                           BKFL0420
       REM         .            .           .                           BKFL0430
       REM         .NO          .           .                           BKFL0440
       REM         ..............           .                           BKFL0450
       REM         .                        .                           BKFL0460
       REM         X                        .                           BKFL0470
       REM       *******                    .                           BKFL0480
       REM       *.OPEN*.....................                           BKFL0490
       REM       *******                                                BKFL0500
       TTL     FORTRAN IV BACKSPACE FILE ROUTINE                        BKFL0510
*      CALL    BAKFIL(NTAPE,NFILES)                                     BKFL0520
*      WHERE   NTAPE IS A LOGICAL TAPE NUMBER                           BKFL0530
*              NFILES IS THE NUMBER OF FILES TO BACKSPACE               BKFL0540
BAKFIL SAVE    (2)I                                                     BKFL0550
       CLA*    4,4                GET NFILES,                           BKFL0560
       ALS     18                 SHIFT TO DECREMENT,                   BKFL0570
       STD     BKFOP              STO IN IOCS CALL.                     BKFL0580
       CLA*    3,4                GET NTAPE,                            BKFL0590
       PAX     ,4                 TO XR4,                               BKFL0600
       SXD     CODE,4             AND SAVE IN ERROR CODE.               BKFL0610
       TXH     GO,4,7             IF TAPE REQUEST IS FOR 5,6,OR 7       BKFL0620
       TXL     GO,4,4             OPTION 47 MUST BE SET TO ALLOW.       BKFL0630
       CALL    .FXEM.(CODE)       OTHERWISE FXEM WILL EXIT              BKFL0640
       LXD     CODE,4                                                   BKFL0650
       PXA     ,4                 RESET AC                              BKFL0660
    GO CALL    .IOU.F             AND FIND FILE                         BKFL0670
       TZE     ERROR              IF AVAILABEL                          BKFL0680
       PAC     ,4                 FILE ADDRESS TO XR4                   BKFL0690
       STA     BKFOP                                                    BKFL0700
       STA     CLS2                                                     BKFL0710
       STA     OPN2                                                     BKFL0720
       STA     CONT                                                     BKFL0730
       LDI     1,4                GET 2ND WORD IN FCB                   BKFL0740
       LFT     040000             IS FILE CLOSED                        BKFL0750
       TSX     CLS1,2             NO. CLOSE IT                          BKFL0760
       LNT     003000             IS FILE INPUT                         BKFL0770
       TSX     STOU,2             SET TO OUTPUT                         BKFL0780
       TSX     .OPEN,4            AND OPEN WITH                         BKFL0790
  OPN2 MON     **                 NO REWIND                             BKFL0800
       TSX     .BSF,4             NOW GO AHEAD AND                      BKFL0810
 BKFOP PZE     **,,**             BACKSPACE THE FILE                    BKFL0820
       AXC     CONS,2             SET RETURN                            BKFL0830
  CLS1 TSX     .CLOSE,4           CLOSE WITH NO REWIND,NO EOF,          BKFL0840
  CLS2 MON     **                 NO NOTHING                            BKFL0850
  CONS TRA     1,2                (RETURN 1ST TIME, CONTINUE NEXT)      BKFL0860
  CONT AXC     **,4               SET FILE TO INPUT                     BKFL0870
       LDI     1,4                                                      BKFL0880
       RIL     003000                                                   BKFL0890
       STI     1,4                                                      BKFL0900
       RETURN  BAKFIL                                                   BKFL0910
 ERROR CALL    .FXEM.(CODE)       BAD TAPE ALTOGETHER,                  BKFL0920
       CALL    EXIT               NO OPTION AVAILABLE                   BKFL0930
  STOU RIL     003000                                                   BKFL0940
       SIL     001000                                                   BKFL0950
       STI     1,4                                                      BKFL0960
       TRA     1,2                                                      BKFL0970
  CODE PZE     47,,**                                                   BKFL0980
       END                                                              BKFL0990
