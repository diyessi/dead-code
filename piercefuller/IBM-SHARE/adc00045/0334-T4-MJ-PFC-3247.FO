  100 L1=1                                                              PFC00990
      L2=NE2CO                                                          PFC01000
      L3=4                                                              PFC01010
      GO TO 1936                                                        PFC01020
  105 L3=5                                                              PFC01030
      IF(SENSE SWITCH 3)107,113                                         PFC01040
