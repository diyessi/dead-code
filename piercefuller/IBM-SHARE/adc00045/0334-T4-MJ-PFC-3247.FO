  155 T1=(Z1+Z2)/2.                                                     SUB32370
      CALL SUB2 (E1COS,T1,TH1R,E2,AID2,T2,KTH1R,KP2N)                   SUB32380
      IF(KTH1R-1)175,160,175                                            SUB32390
  160 T3=T2-T1                                                          SUB32400
