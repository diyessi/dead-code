  490 I=I+1                                                             SUB30430
      IF(KP1(I))495,495,480                                             SUB30440
  495 K2=I-1                                                            SUB30450
      K3=3                                                              SUB30460
      GO TO 3872                                                        SUB30470
  500 K1=1                                                              SUB30480
      K2=NP1O                                                           SUB30490
      K3=4                                                              SUB30500
 3872 IF(K1-K2)505,590,505                                              SUB30510
  505 J=K1                                                              SUB30520
  510 IF(DP1(J)*DP1(J+1))525,525,515                                    SUB30530
  515 IF(J+1-K2)520,590,590                                             SUB30540
  520 J=J+1                                                             SUB30550
      GO TO 510                                                         SUB30560
  525 Z1=P1O(J)                                                         SUB30570
      Z2=P1O(J+1)                                                       SUB30580
      Z3=DP1(J)                                                         SUB30590
      Z4=DP1(J+1)                                                       SUB30600
      M=1                                                               SUB30610
  530 TEMP=ABSF(Z1-Z2)                                                  SUB30620
      IF(TEMP-EP)730,730,535                                            SUB30630
  535 T1=(Z1+Z2)/2.                                                     SUB30640
      CALL SUB1(A1,T1,TH1S,E1,AID1,T2,KTH1S,KP1N)                       SUB30650
      IF(KTH1S-1)555,540,555                                            SUB30660
  540 T3=T2-T1                                                          SUB30670
      IF(SENSE SWITCH 2)543,553                                         SUB30680
  543 WRITE OUTPUT TAPE 6,545                                           SUB30690
  545 FORMAT(1H ,19X,5HP1OLD,9X,4HTH1S,11X,2HE1,12X,3HID1,10X,5HP1NEW,9XSUB30700
     1,5HPN-PO,5X,4HKP1N,2X,1HM,3X,1H*,9X)                              SUB30710
      WRITE OUTPUT TAPE 6,550,T1,TH1S,E1,AID1,T2,T3,KP1N,M              SUB30720
  550 FORMAT(1H ,13X,6E14.5,I5,I4//)                                    SUB30730
  553 IF(KP1N-1)555,565,555                                             SUB30740
  555 IF(SENSE SWITCH 2)556,563                                         SUB30750
  556 WRITE OUTPUT TAPE 6,560,T1                                        SUB30760
  560 FORMAT(16H0ERROR  OCCURRED,3X,3HT1=E14.5///)                      SUB30770
  563 GO TO 916                                                         SUB30780
  565 TEMP=Z3*T3                                                        SUB30790
      IF(TEMP)570,570,575                                               SUB30800
  570 Z4=T3                                                             SUB30810
      Z2=T1                                                             SUB30820
      M=M+1                                                             SUB30830
      GO TO 530                                                         SUB30840
  575 Z3=T3                                                             SUB30850
      Z1=T1                                                             SUB30860
      M=M+1                                                             SUB30870
      GO TO 530                                                         SUB30880
  580 K3=5                                                              SUB30890
      IF(SENSE SWITCH 2)583,587                                         SUB30900
  583 WRITE OUTPUT TAPE 6,585,K3                                        SUB30910
  585 FORMAT(21H0IT DOES NOT CONVERGE,3X,3HK3=I1///)                    SUB30920
  587 GO TO 916                                                         SUB30930
  590 IF(K3-3)600,600,595                                               SUB30940
  595 IF(SENSE SWITCH 2 )596,597                                        SUB30950
  596 WRITE OUTPUT TAPE 6,585,K3                                        SUB30960
  597 GO TO 916                                                         SUB30970
  600 IF(K3-2)605,610,610                                               SUB30980
  605 N1=K2                                                             SUB30990
      N2=K2+1                                                           SUB31000
      GO TO 615                                                         SUB31010
  610 N1=K1                                                             SUB31020
      N2=K1-1                                                           SUB31030
  615 IJK=0                                                             SUB31040
  616 N=1                                                               SUB31050
      S1=P1O(N1)                                                        SUB31060
      S2=P1O(N2)                                                        SUB31070
      D1=DP1(N1)                                                        SUB31080
  620 U1=(S1+S2)/2.                                                     SUB31090
      IF(N-13)635,625,625                                               SUB31100
  625 IF(SENSE SWITCH 2)626,633                                         SUB31110
  626 WRITE OUTPUT TAPE 6,630,K3,N                                      SUB31120
  630 FORMAT(17H0THERE IS NO ROOT,3X,3HK3=I1,2X,2HN=I2///)              SUB31130
  633 GO TO 3868                                                        SUB31140
  635 CALL SUB1(A1,U1,TH1S,E1,AID1,U2,KTH1S,KP1N)                       SUB31150
      IF(KTH1S-1)655,640,655                                            SUB31160
  640 U3=U2-U1                                                          SUB31170
      IF(SENSE SWITCH 2)643,653                                         SUB31180
  643 WRITE OUTPUT TAPE 6,645                                           SUB31190
  645 FORMAT(1H ,19X,5HP1OLD,9X,4HTH1S,11X,2HE1,12X,3HID1,10X,5HP1NEW,9XSUB31200
     1,5HPN-PO,5X,4HKP1N,2X,2HK3,2X,1HN)                                SUB31210
      WRITE OUTPUT TAPE 6,650,U1,TH1S,E1,AID1,U2,U3,KP1N,K3,N           SUB31220
  650 FORMAT(1H ,13X,6E14.5,2I5,I3//)                                   SUB31230
  653 IF(KP1N-1)655,660,655                                             SUB31240
  655 S2=U1                                                             SUB31250
      N=N+1                                                             SUB31260
      GO TO 620                                                         SUB31270
  660 IF(D1*U3)670,670,665                                              SUB31280
  665 S1=U1                                                             SUB31290
      D1=U3                                                             SUB31300
      N=N+1                                                             SUB31310
      GO TO 620                                                         SUB31320
  670 S2=U1                                                             SUB31330
      D2=U3                                                             SUB31340
  675 IF(N-13)685,680,680                                               SUB31350
  680 IF(SENSE SWITCH 2)681,683                                         SUB31360
  681 WRITE OUTPUT TAPE 6,630,K3,N                                      SUB31370
  683 GO TO 3868                                                        SUB31380
  685 N=N+1                                                             SUB31390
      TEMP=ABSF(S1-S2)                                                  SUB31400
      IF(TEMP-EP)740,740,690                                            SUB31410
  690 V1=(S1+S2)/2.                                                     SUB31420
      CALL SUB1(A1,V1,TH1S,E1,AID1,V2,KTH1S,KP1N)                       SUB31430
      IF(KTH1S-1)700,695,700                                            SUB31440
  695 V3=V2-V1                                                          SUB31450
      IF(SENSE SWITCH 2)697,698                                         SUB31460
  697 WRITE OUTPUT TAPE 6,645                                           SUB31470
      WRITE OUTPUT TAPE 6,650,V1,TH1S,E1,AID1,V2,V3,KP1N,K3,N           SUB31480
  698 IF(KP1N-1)700,710,700                                             SUB31490
  700 IF(SENSE SWITCH 2)701,707                                         SUB31500
  701 WRITE OUTPUT TAPE 6,705,V1,K3,N                                   SUB31510
  705 FORMAT(15H0ERROR OCCURRED,3X,3HV1=E14.5,3X,3HK3=I1,3X,2HN=I2///)  SUB31520
  707 GO TO 3868                                                        SUB31530
  710 IF(V3*D1)715,715,720                                              SUB31540
  715 S2=V1                                                             SUB31550
      D2=V3                                                             SUB31560
      GO TO 675                                                         SUB31570
  720 S1=V1                                                             SUB31580
      D1=V3                                                             SUB31590
      GO TO 675                                                         SUB31600
 3868 IF(K3-3) 916,725,725                                              SUB31610
  725 IF(IJK)916,726,916                                                SUB31620
  726 N1=K2                                                             SUB31630
      N2=K2+1                                                           SUB31640
      IJK=1                                                             SUB31650
      GO TO 616                                                         SUB31660
  730 IF(SENSE SWITCH 2)731,737                                         SUB31670
  731 WRITE OUTPUT TAPE 6,735                                           SUB31680
  735 FORMAT(1H ,19X,8H********,9HCONVERGED,8H********)                 SUB31690
  737 GO TO 745                                                         SUB31700
  740 Z1=S1                                                             SUB31710
      Z2=S2                                                             SUB31720
      GO TO 730                                                         SUB31730
  745 E1COS=E1*COSF(Z1)                                                 SUB31740
      Y1=Z1                                                             SUB31750
      Y2=TH1S                                                           SUB31760
      Y3=E1                                                             SUB31770
      Y4=AID1                                                           SUB31780
      DO 1122 I=1,NPO                                                   SUB31790
      CALL SUB2 (E1COS,PO(I),TH1R,E2,AID2,PN(I),KTH1R,KP2N)             SUB31800
      IF(KTH1R-1)20,25,20                                               SUB31810
   20 KA(I)=0                                                           SUB31820
