      DO 918 I12=1,NTH12S                                               PFC00520
      TH12S=TH12S8(I12)                                                 PFC00530
      WRITE OUTPUT TAPE 6,415                                           PFC00540
  415 FORMAT(1H1,9X,2HRL,7X,3HX1D,6X,3HX2D,6X,3HX2R,6X,3HX2S,5X,4HALFA,5PFC00550
     1X,5HGAMMA,5X,3HE1R,6X,3HE2R,6X,3HE1S,6X,3HE2S,5X,5HTH12S,7X)      PFC00560
      WRITE OUTPUT TAPE 6,420,RL,X1D,X2D,X2R,X2S,ALFA,GAMMA,E1R,E2R,E1S,PFC00570
     1E2S,TH12S                                                         PFC00580
  420 FORMAT(1H ,5X,12F9.5//)                                           PFC00590
      DO 917 I13=1,NTH12R                                               PFC00600
      TH12R=TH12R8(I13)                                                 PFC00610
      PRINT 7,NCASE                                                     PFC00620
    7 FORMAT(1H ,6HNCASE=I3)                                            PFC00630
      NCASE=NCASE+1                                                     PFC00640
C                                                                       PFC00650
      DO 15 I=1,NE2CO                                                   PFC00660
      CALL SUB3(E2CO(I),E2CN(I),DEC(I),KEC(I))                          PFC00670
   15 CONTINUE                                                          PFC00680
      IF(SENSE SWITCH 3)17,27                                           PFC00690
   17 WRITE OUTPUT TAPE 6,20                                            PFC00700
   20 FORMAT(4H1KEC)                                                    PFC00710
      WRITE OUTPUT TAPE 6,25,(KEC(I),I=1,NE2CO)                         PFC00720
   25 FORMAT(1H ,20I4)                                                  PFC00730
   27 IF(KEC(1))55,55,30                                                PFC00740
   30 I=2                                                               PFC00750
   35 IF(KEC(I))50,50,40                                                PFC00760
   40 IF(I-NE2CO)45,100,100                                             PFC00770
   45 I=I+1                                                             PFC00780
      GO TO 35                                                          PFC00790
   50 L1=1                                                              PFC00800
      L2=I-1                                                            PFC00810
      L3=1                                                              PFC00820
      GO TO 1936                                                        PFC00830
   55 I=2                                                               PFC00840
   60 IF(KEC(I))65,65,75                                                PFC00850
   65 IF(I-NE2CO)70,105,105                                             PFC00860
   70 I=I+1                                                             PFC00870
      GO TO 60                                                          PFC00880
   75 L1=I                                                              PFC00890
   80 IF(I-NE2CO)90,85,85                                               PFC00900
   85 L2=NE2CO                                                          PFC00910
      L3=2                                                              PFC00920
      GO TO 1936                                                        PFC00930
   90 I=I+1                                                             PFC00940
      IF(KEC(I))95,95,80                                                PFC00950
   95 L2=I-1                                                            PFC00960
