      GO TO 3872                                                        SUB30320
  455 I=2                                                               SUB30330
  460 IF(KP1(I))465,465,475                                             SUB30340
  465 IF(I-NP1O)470,580,580                                             SUB30350
  470 I=I+1                                                             SUB30360
      GO TO 460                                                         SUB30370
