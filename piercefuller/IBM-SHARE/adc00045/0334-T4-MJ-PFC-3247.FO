   45 KA(I)=1                                                           SUB31940
 1122 CONTINUE                                                          SUB31950
      IF(KA(1))75,75,50                                                 SUB31960
   50 I=2                                                               SUB31970
   55 IF(KA(I))70,70,60                                                 SUB31980
