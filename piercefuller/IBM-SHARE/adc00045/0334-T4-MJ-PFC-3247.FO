*  L/CCDECK 002  00311 007                                                      
C     MAIN PROGRAM                                                      PFC00000
      DIMENSION E2CO(20),E2CN(20),DEC(20),KEC(20),P1O(15),PO(15),RL8(4),PFC00010
     1X1D8(4),X2D8(4),X2R8(4),X2S8(4),ALFA8(4),GAMMA8(4),E1R8(4),E2R8(4)PFC00020
     2,E1S8(4),E2S8(4),TH12S8(5),TH12R8(7)                              PFC00030
     3,E1Y(10),E2Y(10),P1SY(10),P2SY(10),P1RY(10),P2RY(10)              PFC00040
      COMMON EK4,X1S,X2S,TH12S,E1S,E2S,ALFA,X1D,EK1,EK2,RL,EK3,X1R,X2R,TPFC00050
     1H12R,E1R,E2R,GAMMA,X2D,EP,NP1O,NPO,P1O,PO,Y1,Y2,Y3,Y4,Y5,Y6,Y7,Y8 PFC00060
      READ INPUT TAPE 5,1,EK1,EK2,EK3,EK4,X1R,X1S,EP                    PFC00070
      READ INPUT TAPE 5,5,NP1O,NPO,NE2CO,NRL,NX1D,NX2D,NX2R,NX2S,NALFA,NPFC00080
     1GAMMA,NE1R,NE2R,NE1S,NE2S,NTH12S,NTH12R                           PFC00090
    1 FORMAT(6E12.8)                                                    PFC00100
    5 FORMAT(16I2)                                                      PFC00110
      READ INPUT TAPE 5,1,(P1O(I),I=1,NP1O)                             PFC00120
      READ INPUT TAPE 5,1,(PO(I),I=1,NPO)                               PFC00130
      READ INPUT TAPE 5,1,(E2CO(I),I=1,NE2CO)                           PFC00140
