 2244 CONTINUE                                                          SUB30220
      IF(KP1(1))455,455,430                                             SUB30230
  430 I=2                                                               SUB30240
  435 IF(KP1(I))450,450,440                                             SUB30250
  440 IF(I-NP1O)445,500,500                                             SUB30260
