 1936 IF(K1-K2)125,210,125                                              SUB32240
  125 J=K1                                                              SUB32250
  130 IF(D(J)*D(J+1))145,145,135                                        SUB32260
  135 IF(J+1-K2)140,210,210                                             SUB32270
