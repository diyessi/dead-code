      READ INPUT TAPE 5,1,(X1D8(I2),I2=1,NX1D)                          PFC00160
      READ INPUT TAPE 5,1,(X2D8(I3),I3=1,NX2D)                          PFC00170
      READ INPUT TAPE 5,1,(X2R8(I4),I4=1,NX2R)                          PFC00180
      READ INPUT TAPE 5,1,(X2S8(I5),I5=1,NX2S)                          PFC00190
      READ INPUT TAPE 5,1,(ALFA8(I6),I6=1,NALFA)                        PFC00200
      READ INPUT TAPE 5,1,(GAMMA8(I7),I7=1,NGAMMA)                      PFC00210
      READ INPUT TAPE 5,1,(E1R8(I8),I8=1,NE1R)                          PFC00220
      READ INPUT TAPE 5,1,(E2R8(I9),I9=1,NE2R)                          PFC00230
      READ INPUT TAPE 5,1,(E1S8(I10),I10=1,NE1S)                        PFC00240
      READ INPUT TAPE 5,1,(E2S8(I11),I11=1,NE2S)                        PFC00250
      READ INPUT TAPE 5,1,(TH12S8(I12),I12=1,NTH12S)                    PFC00260
      READ INPUT TAPE 5,1,(TH12R8(I13),I13=1,NTH12R)                    PFC00270
      NCASE=1                                                           PFC00280
C                                                                       PFC00290
      DO 918 I1=1,NRL                                                   PFC00300
      RL=RL8(I1)                                                        PFC00310
      DO 918 I2=1,NX1D                                                  PFC00320
      X1D=X1D8(I2)                                                      PFC00330
      DO 918 I3=1,NX2D                                                  PFC00340
      X2D=X2D8(I3)                                                      PFC00350
      DO 918 I4=1,NX2R                                                  PFC00360
      X2R=X2R8(I4)                                                      PFC00370
      DO 918 I5=1,NX2S                                                  PFC00380
      X2S=X2S8(I5)                                                      PFC00390
      DO 918 I6=1,NALFA                                                 PFC00400
      ALFA=ALFA8(I6)                                                    PFC00410
