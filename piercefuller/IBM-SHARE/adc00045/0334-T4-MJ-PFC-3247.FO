   30 FORMAT(1H ,19X,5HP2OLD,9X,4HTH1R,11X,2HE2,12X,3HID2,10X,5HP2NEW,9XSUB31870
     1,5HPN-PO,5X,4HKP2N,2X,1HI,13X)                                    SUB31880
      WRITE OUTPUT TAPE 6,35,PO(I),TH1R,E2,AID2,PN(I),D(I),KP2N,I       SUB31890
