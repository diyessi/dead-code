*     FAP                                                                       
       LBL     DLOG                                                     DLOG0000
       COUNT   120                                                      DLOG0001
*      U. OF CHICAGO DOUBLE PREC. NATURAL AND COMMON LOGARITHM FUNCTION DLOG0002
*              NORMALIZED ARGUMENT IN CELL 32767 AND 32766.   ANSWER IS DLOG0003
*              GIVEN IN THE SAME CELLS                                  DLOG0004
       SPACE                                                            DLOG0005
       ENTRY   DLOG                                                     DLOG0006
       ENTRY   DLOG10                                                   DLOG0007
       SPACE                                                            DLOG0008
DLOG10 STL     TEST          CELL TEST TO DISTINGUISH DLOG10 FROM DLOG  DLOG0009
       TRA     *+2                                                      DLOG0010
 DLOG  STZ     TEST                                                     DLOG0011
       SXA     SAVE1,1                                                  DLOG0012
       STI     SVIND                                                    DLOG0013
       DLD     4)-1          PICK UP ARGUMENT.   X = M*2**N             DLOG0014
       XCA                                                              DLOG0015
   A   DST     ARG                                                      DLOG0016
       TZE     ERROR                                                    DLOG0017
       TMI     NERROR                                                   DLOG0018
       LRS     27                                                       DLOG0019
       XCA                                                              DLOG0020
       AXT     0,1                                                      DLOG0021
       CAS     LIM           COMPARE MANTISSA WITH SQRT2/2              DLOG0022
       TXI     *+2,1,2         IF GREATER THAN SQRT2/2, XR1=2           DLOG0023
       TXI     *+1,1,2         IF SMALLER THAN SQRT2/2, XR1=0           DLOG0024
       XCA                                                              DLOG0025
       SUB     K1,1          =O200 OR O201 TO GET EXPONENT IF MANT      DLOG0026
       ORA     CHAR            WAS BIG, EXPONENT-1 IF IT WAS SMALL      DLOG0027
       FAD     CHAR          FLOAT AND NORMALIZE                        DLOG0028
       DFMP    LOGTW           LOG X = (P-D)LOG2+LOG((1+Z)/(1-Z))       DLOG0029
       DST     BUFF              WHERE P IS EXPONENT, D=1 OR 0,         DLOG0030
       DLD     ARG                 AND Z = (M-F)/(M+F)                  DLOG0031
       ANA     MASK                                                     DLOG0032
       ORA     HALF          GIVE CHARACTERISTIC O200 TO MANTISSA M     DLOG0033
       STO     ARG                                                      DLOG0034
       DFAD    HALF,1        COMPUTE Z = (M-F)/(M+F)                    DLOG0035
       DST     Z               WHERE F = 1   IF M WAS BIG               DLOG0036
       DLD     ARG                     = 1/2 IF M WAS SMALL             DLOG0037
       DFSB    HALF                                                     DLOG0038
       DFSB    ZERO,1          SUBTRACT F IN 2 STEPS                    DLOG0039
       DFDP    Z                                                        DLOG0040
       DST     Z             Z NOW READY                                DLOG0041
       SPACE                                                            DLOG0042
       DFMP    Z             ZSQ IN CELL ARG                            DLOG0043
       DST     ARG             LOG((1+Z)/(1-Z))=Z(2+G(ZSQ))             DLOG0044
       AXT     14,1              WHERE F(ZSQ) IS A 7 DEGREE POLYNOM     DLOG0045
       DLD     COEF,1                                                   DLOG0046
       DFMP    ARG                                                      DLOG0047
       DFAD    COEF+2,1                                                 DLOG0048
       TIX     *-2,1,2                                                  DLOG0049
       DFMP    Z                                                        DLOG0050
       DFAD    BUFF          NATURAL LOG READY                          DLOG0051
       ZET     TEST                                                     DLOG0052
       DFMP    CLOGE         LOG E BASE 10                              DLOG0053
       STO     4)                                                       DLOG0054
       STQ     4)-1                                                     DLOG0055
 SAVE1 AXT     **,1                                                     DLOG0056
       LDI     SVIND                                                    DLOG0057
       TRA     1,4           RETURN TO MAIN PROGRAM                     DLOG0058
       SPACE                                                            DLOG0059
 ERROR LDI     *+2                                                      DLOG0060
       TRA*    $(EXE)                                                   DLOG0061
       PZE     3,7,SAVE1                                                DLOG0062
NERROR LDI     *+2                                                      DLOG0063
       TRA*    $(EXE)                                                   DLOG0064
       PZE     3,7,*+1                                                  DLOG0065
       DLD     ARG                                                      DLOG0066
       SSP                                                              DLOG0067
       TRA     A                                                        DLOG0068
       SPACE                                                            DLOG0069
       OCT     200                                                      DLOG0070
 LIM   OCT     265011714640        SQRT2/2  B0                          DLOG0071
  K1   OCT     201                                                      DLOG0072
 CHAR  OCT     233000000000                                             DLOG0073
 MASK  OCT     777777777                                                DLOG0074
 TEST  BSS     1                                                        DLOG0075
       EVEN                                                             DLOG0076
       OCT     201400000000,146000000000                                DLOG0077
 HALF  OCT     200400000000,145000000000                                DLOG0078
 ZERO  OCT     0,0                                                      DLOG0079
       OCT     176457233057,143452334563     0.1480971268990510         DLOG0080
       OCT     176471463374,143233335177     0.1531252792171731         DLOG0081
       OCT     176564315145,143220456006     0.1818363168880382         DLOG0082
       OCT     176707070500,143002037553     0.2222219705656678         DLOG0083
       OCT     177444444445,144050500411     0.2857142876064318         DLOG0084
       OCT     177631463146,144313656522     0.3999999999930233         DLOG0085
       OCT     200525252525,145252525533     0.6666666666666764         DLOG0086
 COEF  OCT     202400000000,147000000002     2. WITH COMPENSATOR        DLOG0087
 LOGTW OCT     200542710277,145575071737     LOG 2 WITH COMPENSATOR     DLOG0088
 CLOGE OCT     177674557305,144223345034       LOG E BASE 10            DLOG0089
  ARG  BSS     2                                                        DLOG0090
 BUFF  BSS     2                                                        DLOG0091
   Z   BSS     2                                                        DLOG0092
 SVIND BSS     1                                                        DLOG0093
  4)   EQU     32767                                                    DLOG0094
       END                                                              DLOG0095
