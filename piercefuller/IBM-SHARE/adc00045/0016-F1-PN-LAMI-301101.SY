*     LABEL                                                             OUTPT000
*     LIST8                                                             OUTPT010
      SUBROUTINE OUTPUT                                                 OUTPT020
      COMMON I,II,IVAL,IP,IX,IZ,J,K,M,N,NM,R1,R3,R4,R5,RR,RW,ZEROT      OUTPT030
      COMMON MR,NR                                                      OUTPT040
D     DIMENSION R1(200),R3(200),R4(200),R5(200),RR(200,2),RW(200,2)     OUTPT050
      DIMENSION MR(200),NR(200)                                         OUTPT060
      CALL TCO                                                          OUTPT070
      WRITE OUTPUT TAPE 6,1                                             OUTPT080
    1 FORMAT(1H1)                                                       OUTPT090
      DUMMY=-1.                                                         OUTPT100
   10 DO 2 J=1,N                                                        OUTPT120
      CALL BINRD                                                        OUTPT130
      CALL WAITRD                                                       OUTPT140
    2 WRITE OUTPUT TAPE 6,3,(DUMMY,J,L,RR(L,K),L=1,N)                   OUTPT150
    3 FORMAT(1H /(4(A1,4H  A(I3,1H,I3,2H)=E15.8)))                      OUTPT160
   11 IF(M)9,9,8                                                        OUTPT170
    8 WRITE OUTPUT TAPE 6,4                                             OUTPT180
    4 FORMAT(20H1   SOLUTION VECTOR ///)                                OUTPT190
      L1=N+1                                                            OUTPT200
      DO 6 J=1,N                                                        OUTPT210
      CALL BINRD                                                        OUTPT220
      CALL WAITRD                                                       OUTPT230
      L2=1                                                              OUTPT240
      DO 5 L=L1,NM                                                      OUTPT250
      L2=L-N                                                            OUTPT260
    5 RR(L2,K)=RR(L,K)                                                  OUTPT270
    6 WRITE OUTPUT TAPE 6,7,(DUMMY,J,L,RR(L,K),L=1,M)                   OUTPT280
    7 FORMAT(1H / 4(A1,4H  B(I3,1H,I3,2H)=E15.8))                       OUTPT290
    9 RETURN                                                            OUTPT300
      END                                                               OUTPT310
*      LABEL                                                            MAIN0000
*      LIST8                                                            MAIN0010
CTEST OF ACCURACY IN MATRIX INVERSION                                   MAIN0020
      COMMON I,II,IVAL,IP,IX,IZ,J,K,M,N,NM,R1,R3,R4,R5,RR,RW,ZEROT      MAIN0030
      COMMON MR,NR                                                      MAIN0040
D     DIMENSION R1(200),R3(200),R4(200),R5(200),RR(200,2),RW(200,2)     MAIN0050
      DIMENSION MR(200),NR(200)                                         MAIN0060
   20 READ INPUT TAPE 5,1,N                                             MAIN0070
    1 FORMAT(I3)                                                        MAIN0080
      M=0                                                               MAIN0090
      NM=N                                                              MAIN0100
      ZEROT=0.                                                          MAIN0110
      CALL START                                                        MAIN0120
      CALL LAMIS                                                        MAIN0130
      CALL LAMIS                                                        MAIN0140
      CALL OUTPUT                                                       MAIN0150
      CALL TCO                                                          MAIN0160
      CALL SETRND(1.1)                                                  MAIN0170
D     AMAX=0.                                                           MAIN0180
      DO 3 J=1,N                                                        MAIN0190
      J=J                                                               MAIN0200
      DO 2 L=1,N                                                        MAIN0210
D     A=0.                                                              MAIN0220
      A=RANDOM(-10.,10.)                                                MAIN0230
D   2 RW(L,K)=A+1.E-08*A                                                MAIN0240
      CALL BINRD                                                        MAIN0250
      CALL WAITRD                                                       MAIN0260
      DO 3 L=1,N                                                        MAIN0270
D     RW(L,K)=RW(L,K)-RR(L,K)                                           MAIN0280
    3 AMAX=MAX1F(AMAX,ABSF(RW(L,K)))                                    MAIN0290
      PRINT 4,AMAX,N                                                    MAIN0300
   10 WRITE OUTPUT TAPE 6,4,AMAX,N                                      MAIN0310
    4 FORMAT(20H      MAXIMUM ERROR=E8.2,7H FOR N=I3)                   MAIN0320
      GO TO 20                                                          MAIN0330
      END                                                               MAIN0340
*      LABEL                                                            START000
*      LIST8                                                            START010
      SUBROUTINE START                                                  START020
      COMMON I,II,IVAL,IP,IX,IZ,J,K,M,N,NM,R1,R3,R4,R5,RR,RW,ZEROT      START030
      COMMON MR,NR                                                      START040
D     DIMENSION R1(200),R3(200),R4(200),R5(200),RR(200,2),RW(200,2)     START050
      DIMENSION MR(200),NR(200)                                         START060
      REWIND 2                                                          START070
      REWIND 4                                                          START080
      K=1                                                               START090
      I=1                                                               START100
      IVAL=1                                                            START110
      CALL SETRND(1.1)                                                  START120
      DO 2 J=1,N                                                        START130
      J=J                                                               START140
      CALL WAITWR                                                       START150
      DO 1 L=1,N                                                        START160
D     A=0.                                                              START170
      A=RANDOM(-10.,10.)                                                START180
D   1 RW(L,K)=A+1.E-08*A                                                START190
    2 CALL BINWR                                                        START200
      K=2                                                               START210
      IVAL=2                                                            START220
      RETURN                                                            START230
      END                                                               START240
