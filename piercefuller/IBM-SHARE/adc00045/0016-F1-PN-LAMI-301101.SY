       SUB     K                                                        LAMI0320
       STO     K                                                        LAMI0330
       CLA     N                                                        LAMI0340
       STD     TXL                                                      LAMI0350
LOOP1  CALL    WAITRD                                                   LAMI0360
       CLA     J                                                        LAMI0370
       CAS     N                                                        LAMI0380
       TRA     GO                                                       LAMI0390
       TRA     GO                                                       LAMI0400
       ADD     ONE                                                      LAMI0410
       STO     J                                                        LAMI0420
       CALL    BINRD                                                    LAMI0430
       CLA     J                                                        LAMI0440
       SUB     ONE                                                      LAMI0450
       STO     J                                                        LAMI0460
GO     CLA     THREE                                                    LAMI0470
       SUB     K                                                        LAMI0480
       STO     K                                                        LAMI0490
       CLA     ONE                                                      LAMI0500
       SUB     K                                                        LAMI0510
       TZE     *+2                                                      LAMI0520
       CLA     K200                                                     LAMI0530
       ADD     IP                                                       LAMI0540
       PDX     0,1                                                      LAMI0550
       LXD     K,2                                                      LAMI0560
       CLA     J                                                        LAMI0570
       SUB     I                                                        LAMI0580
       TNZ     28A                                                      LAMI0590
       CLA     TWO                                                      LAMI0600
       SUB     K                                                        LAMI0610
       TNZ     *+2                                                      LAMI0620
       CLA     K201                                                     LAMI0630
       PDX     0,1                                                      LAMI0640
       AXT     1,4                                                      LAMI0650
       CLA     NM                                                       LAMI0660
       STD     TXLA                                                     LAMI0670
LOOP2  CLA     R1+1,4                                                   LAMI0680
       STO     RW+1,1                                                   LAMI0690
       CLA     R1-NMMAX+1,4                                             LAMI0700
       STO     RW-2*NMMAX+1,1                                           LAMI0710
       TXI     *+1,1,1                                                  LAMI0720
       TXI     *+1,4,1                                                  LAMI0730
TXLA   TXL     LOOP2,4,**                                               LAMI0740
       TRA     38A                                                      LAMI0750
28A    CLA     TWO                                                      LAMI0760
       SUB     K                                                        LAMI0770
       TNZ     *+2                                                      LAMI0780
       CLA     K201                                                     LAMI0790
       PDX     0,2                                                      LAMI0800
       AXT     1,4                                                      LAMI0810
       CLA     NM                                                       LAMI0820
       STD     TXLC                                                     LAMI0830
LOOP   PXD     I,4                                                      LAMI0840
       SUB     IP                                                       LAMI0850
       TNZ     32A                                                      LAMI0860
       LDQ     R1+1,4                                                   LAMI0870
       FMP     RR+1,1                                                   LAMI0880
       STO     E1                                                       LAMI0890
       STQ     E2                                                       LAMI0900
       LDQ     R1+1,4                                                   LAMI0910
       FMP     RR-2*NMMAX+1,1                                           LAMI0920
       UFA     E2                                                       LAMI0930
       STO     E2                                                       LAMI0940
       LDQ     RR+1,1                                                   LAMI0950
       FMP     R1-NMMAX+1,4                                             LAMI0960
       UFA     E2                                                       LAMI0970
       FAD     E1                                                       LAMI0980
       CHS                                                              LAMI0990
       STO     RW+1,2                                                   LAMI1000
       LRS     0                                                        LAMI1010
       STQ     RW-2*NMMAX+1,2                                           LAMI1020
       TRA     33A                                                      LAMI1030
32A    LDQ     R1+1,4                                                   LAMI1040
       FMP     RR+1,1                                                   LAMI1050
       STO     E1                                                       LAMI1060
       STQ     E2                                                       LAMI1070
       LDQ     R1+1,4                                                   LAMI1080
       FMP     RR-2*NMMAX+1,1                                           LAMI1090
       UFA     E2                                                       LAMI1100
       STO     E2                                                       LAMI1110
       LDQ     RR+1,1                                                   LAMI1120
       FMP     R1-NMMAX+1,4                                             LAMI1130
       UFA     E2                                                       LAMI1140
       FAD     E1                                                       LAMI1150
       CHS                                                              LAMI1160
       LRS     0                                                        LAMI1170
       STQ     E2                                                       LAMI1180
       FAD     RR+1,2                                                   LAMI1190
       STO     E1                                                       LAMI1200
       XCA                                                              LAMI1210
       UFA     E2                                                       LAMI1220
       UFA     RR-2*NMMAX+1,2                                           LAMI1230
       FAD     E1                                                       LAMI1240
       STO     RW+1,2                                                   LAMI1250
       STQ     RW-2*NMMAX+1,2                                           LAMI1260
33A    TXI     *+1,2,1                                                  LAMI1270
       TXI     *+1,4,1                                                  LAMI1280
TXLC   TXL     LOOP,4,**                                                LAMI1290
       LXD     K,4                                                      LAMI1300
35A    CLA     I                                                        LAMI1310
       SUB     N                                                        LAMI1320
       TZE     38A                                                      LAMI1330
       TPL     38A                                                      LAMI1340
       CALL    TEST,KK,IZ,II                                            LAMI1350
38A    CALL    WAITWR                                                   LAMI1360
       CALL    BINWR                                                    LAMI1370
       LXD     J,4                                                      LAMI1380
       TXI     *+1,4,1                                                  LAMI1390
       SXD     J,4                                                      LAMI1400
TXL    TXL     LOOP1,4,**                                               LAMI1410
       CLA     I                                                        LAMI1420
       SUB     N                                                        LAMI1430
       TZE     45A                                                      LAMI1440
       TPL     45A                                                      LAMI1450
43A    CLA     KK                                                       LAMI1460
       STO     IP                                                       LAMI1470
       CALL    MOVE                                                     LAMI1480
45A    CLA     THREE                                                    LAMI1490
       SUB     IVAL                                                     LAMI1500
       STO     IVAL                                                     LAMI1510
OUT    AXT     **,1                                                     LAMI1520
       AXT     **,2                                                     LAMI1530
       AXT     **,4                                                     LAMI1540
       TRA     1,4                                                      LAMI1550
ONE    PZE     ,,1                                                      LAMI1560
TWO    PZE     ,,2                                                      LAMI1570
THREE  PZE     ,,3                                                      LAMI1580
K200   PZE     ,,NMMAX                                                  LAMI1590
K201   PZE     ,,NMMAX+1                                                LAMI1600
E1     PZE                                                              LAMI1610
E2     PZE                                                              LAMI1620
KK     PZE                                                              LAMI1630
I      COMMON  1                                                        LAMI1640
II     COMMON  1                                                        LAMI1650
IVAL   COMMON  1                                                        LAMI1660
IP     COMMON  1                                                        LAMI1670
IX     COMMON  1                                                        LAMI1680
IZ     COMMON  1                                                        LAMI1690
J      COMMON  1                                                        LAMI1700
K      COMMON  1                                                        LAMI1710
M      COMMON  1                                                        LAMI1720
N      COMMON  1                                                        LAMI1730
NM     COMMON  1                                                        LAMI1740
NMMAX  EQU     200      NMMAX=DIMENSION OF R1                           LAMI1750
R1     COMMON  2*NMMAX                                                  LAMI1760
R3     COMMON  2*NMMAX                                                  LAMI1770
R4     COMMON  2*NMMAX                                                  LAMI1780
R5     COMMON  2*NMMAX                                                  LAMI1790
RR     COMMON  4*NMMAX                                                  LAMI1800
RW     COMMON  4*NMMAX                                                  LAMI1810
ZEROT  COMMON  1                                                        LAMI1820
       END                                                              LAMI1830
*      FAP                                                              LAMI1840
*      SUBROUTINES TEST AND SORT                                        LAMI1850
       LBL     TESTSRT,N                                                LAMI1860
       COUNT   25                                                       LAMI1870
       ENTRY   TEST                                                     LAMI1880
       ENTRY   SORT                                                     LAMI1890
TEST   CLA*    3,4                                                      LAMI1900
       CAS     J                                                        LAMI1910
       TRA     4,4                                                      LAMI1920
       TRA     *+2                                                      LAMI1930
       TRA     4,4                                                      LAMI1940
       CLA     TWO                                                      LAMI1950
       STO*    2,4                                                      LAMI1960
       SXA     OUT1,4                                                   LAMI1970
       CALL    PIVOT,TWO,IPP                                            LAMI1980
OUT1   AXT     **,4                                                     LAMI1990
       CLA     IPP                                                      LAMI2000
       STO*    1,4                                                      LAMI2010
       TRA     4,4                                                      LAMI2020
SORT   SXA     OUT2,4                                                   LAMI2030
       CALL    PIVOT,ONE,IPP                                            LAMI2040
OUT2   AXT     **,4                                                     LAMI2050
       TRA     1,4                                                      LAMI2060
IPP    PZE                                                              LAMI2070
ONE    PZE     ,,1                                                      LAMI2080
TWO    PZE     ,,2                                                      LAMI2090
I      COMMON  1                                                        LAMI2100
II     COMMON  1                                                        LAMI2110
IVAL   COMMON  1                                                        LAMI2120
IP     COMMON  1                                                        LAMI2130
IX     COMMON  1                                                        LAMI2140
IZ     COMMON  1                                                        LAMI2150
J      COMMON  1                                                        LAMI2160
       END                                                              LAMI2170
*     LABEL                                                             LAMI2180
*     LIST8                                                             LAMI2190
      SUBROUTINE PIVOT(IA,IP)                                           LAMI2200
      COMMON I,II,IVAL,IP,IX,IZ,J,K,M,N,NM,R1,R3,R4,R5,RR,RW,ZEROT      LAMI2210
      COMMON MR,NR                                                      LAMI2220
D     DIMENSION R1(200),R3(200),R4(200),R5(200),RR(200,2),RW(200,2)     LAMI2230
      DIMENSION MR(200),NR(200)                                         LAMI2240
      GO TO (11,1),IA                                                   LAMI2250
    1 AMAX=0.                                                           LAMI2260
      IF(II-1)48,46,48                                                  LAMI2270
   46 DO 47 L=1,N                                                       LAMI2280
      MR(L)=0                                                           LAMI2290
   47 NR(L)=0                                                           LAMI2300
   48 DO 4 L=1,NM                                                       LAMI2310
D     R3(L)=RW(L,K)                                                     LAMI2320
      IF(L-N)49,49,4                                                    LAMI2330
   49 IF(NR(L))4,2,4                                                    LAMI2340
    2 IF(AMAX-ABSF(RW(L,K)))3,4,4                                       LAMI2350
    3 AMAX=ABSF(RW(L,K))                                                LAMI2360
      LL=L                                                              LAMI2370
    4 CONTINUE                                                          LAMI2380
      NR(LL)=II                                                         LAMI2390
      MR(II)=LL                                                         LAMI2400
      IP=LL                                                             LAMI2410
      IF(II-1)6,5,6                                                     LAMI2420
    5 AM=1.                                                             LAMI2430
    6 IF(AMAX/AM-ZEROT)7,7,8                                            LAMI2440
    7 CALL SING                                                         LAMI2450
    8 AM=AMAX                                                           LAMI2460
      RETURN                                                            LAMI2470
   11 NS=N/5                                                            LAMI2490
      NREST=N-5*NS                                                      LAMI2500
      IF(NREST)13,13,12                                                 LAMI2510
   12 NS=NS+1                                                           LAMI2520
   13 MM=N+1                                                            LAMI2530
      JA=1                                                              LAMI2540
      DO 44 IS=1,NS                                                     LAMI2550
      CALL WAITRD                                                       LAMI2560
      J=1                                                               LAMI2570
      CALL BINRD                                                        LAMI2580
      K=3-K                                                             LAMI2590
      DO 36 JKL=1,N                                                     LAMI2600
      J=JKL                                                             LAMI2601
      CALL WAITRD                                                       LAMI2610
      IF(J-N)14,15,15                                                   LAMI2620
   14 J=J+1                                                             LAMI2630
      CALL BINRD                                                        LAMI2640
      J=J-1                                                             LAMI2650
   15 K=3-K                                                             LAMI2660
   25 IF(IS-NS)28,26,28                                                 LAMI2670
   26 IF(NREST)27,28,27                                                 LAMI2680
   27 KS=NREST                                                          LAMI2690
      GO TO 29                                                          LAMI2700
   28 KS=5                                                              LAMI2710
   29 DO 36 KL=1,KS                                                     LAMI2720
      JT=JA+KL-1                                                        LAMI2730
      IF(MR(J)-JT)36,30,36                                              LAMI2740
   30 DO 56 L=1,NM                                                      LAMI2750
      IF(L-N)16,16,17                                                   LAMI2760
   17 I=L                                                               LAMI2770
      GO TO 18                                                          LAMI2780
   16 I=NR(L)                                                           LAMI2790
   18 GO TO (31,32,33,34,35),KL                                         LAMI2800
   31 KKK=K                                                             LAMI2810
D     RW(I,KKK)=RR(L,K)                                                 LAMI2820
      GO TO 56                                                          LAMI2830
D  32 R1(I)=RR(L,K)                                                     LAMI2840
      GO TO 56                                                          LAMI2850
D  33 R3(I)=RR(L,K)                                                     LAMI2860
      GO TO 56                                                          LAMI2870
D  34 R4(I)=RR(L,K)                                                     LAMI2880
      GO TO 56                                                          LAMI2890
D  35 R5(I)=RR(L,K)                                                     LAMI2900
   56 CONTINUE                                                          LAMI2910
   36 CONTINUE                                                          LAMI2920
      KK=K                                                              LAMI2930
      K=KKK                                                             LAMI2940
      JJ=J                                                              LAMI2950
      DO 42 KL=1,KS                                                     LAMI2960
      DO 41 L=1,NM                                                      LAMI2970
      GO TO (41,37,38,39,40),KL                                         LAMI2980
D  37 RW(L,K)=R1(L)                                                     LAMI2990
      GO TO 41                                                          LAMI3000
D  38 RW(L,K)=R3(L)                                                     LAMI3010
      GO TO 41                                                          LAMI3020
D  39 RW(L,K)=R4(L)                                                     LAMI3030
      GO TO 41                                                          LAMI3040
D  40 RW(L,K)=R5(L)                                                     LAMI3050
   41 CONTINUE                                                          LAMI3060
      J=JA+KL-1                                                         LAMI3070
      CALL BINWR                                                        LAMI3080
   42 K=3-K                                                             LAMI3090
      K=KK                                                              LAMI3100
      J=JJ                                                              LAMI3110
   43 CALL WAITWR                                                       LAMI3120
   44 JA=JA+5                                                           LAMI3130
      IVAL=3-IVAL                                                       LAMI3140
   45 RETURN                                                            LAMI3150
      END                                                               LAMI3160
*     LABEL                                                             LAMI3170
*     LIST8                                                             LAMI3180
      SUBROUTINE MOVE                                                   LAMI3190
      COMMON I,II,IVAL,IP,IX,IZ,J,K,M,N,NM,R1,R3,R4,R5,RR,RW,ZEROT      LAMI3200
      COMMON MR,NR                                                      LAMI3210
D     DIMENSION R1(200),R3(200),R4(200),R5(200),RR(200,2),RW(200,2)     LAMI3220
      DIMENSION MR(200),NR(200)                                         LAMI3230
D     R1(IP)=1./R3(IP)                                                  LAMI3240
      DO 2 L=1,NM                                                       LAMI3250
      IF(L-IP)1,2,1                                                     LAMI3260
D   1 R1(L)=R3(L)/R3(IP)                                                LAMI3270
    2 CONTINUE                                                          LAMI3280
      RETURN                                                            LAMI3290
      END                                                               LAMI3300
*     LABEL                                                             LAMI3310
*     LIST8                                                             LAMI3320
      SUBROUTINE SCAN                                                   LAMI3330
      COMMON I,II,IVAL,IP,IX,IZ,J,K,M,N,NM,R1,R3,R4,R5,RR,RW,ZEROT      LAMI3340
      COMMON MR,NR                                                      LAMI3350
D     DIMENSION R1(200),R3(200),R4(200),R5(200),RR(200,2),RW(200,2)     LAMI3360
      DIMENSION MR(200),NR(200)                                         LAMI3370
      J=1                                                               LAMI3380
      CALL BINRD                                                        LAMI3390
      IZ=1                                                              LAMI3400
      I=1                                                               LAMI3410
      II=1                                                              LAMI3420
      KK=0                                                              LAMI3430
      CALL WAITRD                                                       LAMI3440
       DO 1 L=1,NM                                                      LAMI3450
D   1 RW(L,K)=RR(L,K)                                                   LAMI3460
      CALL TEST(KK,IZ,1)                                                LAMI3470
      REWIND 2                                                          LAMI3480
      REWIND 4                                                          LAMI3490
      IP=KK                                                             LAMI3500
      CALL MOVE                                                         LAMI3510
      RETURN                                                            LAMI3520
      END                                                               LAMI3530
*     LABEL                                                             LAMI3540
*     LIST8                                                             LAMI3550
      SUBROUTINE SING                                                   LAMI3560
      COMMON I,II,IVAL,IP,IX,IZ,J,K,M,N,NM,R1,R3,R4,R5,RR,RW,ZEROT      LAMI3570
      COMMON MR,NR                                                      LAMI3580
D     DIMENSION R1(200),R3(200),R4(200),R5(200),RR(200,2),RW(200,2)     LAMI3590
      DIMENSION MR(200),NR(200)                                         LAMI3600
      WRITE OUTPUT TAPE 6,1,I                                           LAMI3610
      PRINT 1,I                                                         LAMI3620
    1 FORMAT(///41H  MATRIX SINGULAR OR ILL CONDITIONED.  I=I3///)      LAMI3630
      CALL EXIT                                                         LAMI3640
      END                                                               LAMI3650
*      FAP                                                              LAMI3660
*BINARY                                                                 LAMI3670
       COUNT   400                                                      LAMI3680
       LBL     BINARY,N                                                 LAMI3690
       SST                                                              LAMI3700
       ENTRY   BINRD                                                    LAMI3710
       ENTRY   BINWR                                                    LAMI3720
       ENTRY   WAITRD                                                   LAMI3730
       ENTRY   WAITWR                                                   LAMI3740
       ENTRY   TCO                                                      LAMI3750
       ENTRY   RESTRT                                                   LAMI3760
       ENTRY   FIX                                                      LAMI3770
WAITRD CLA     ONE                                                      LAMI3780
       TRA     *+2                                                      LAMI3790
WAITWR CLA     TWO                                                      LAMI3800
       SXA     OUT,4                                                    LAMI3810
       SXA     OUT+1,1                                                  LAMI3820
       SXA     OUT+2,2                                                  LAMI3830
WAIT   PDX     0,2                                                      LAMI3840
       SUB     IVAL                                                     LAMI3850
       TNZ     *+3                                                      LAMI3860
       AXT     1,1                                                      LAMI3870
       TRA     *+2                                                      LAMI3880
       AXT     2,1                                                      LAMI3890
       ZET     BUSYA+1,1                                                LAMI3900
       TRA     *-1                                                      LAMI3910
       TRA     OUT                                                      LAMI3920
TCO    ZET     BUSYA                                                    LAMI3930
       TRA     *-1                                                      LAMI3940
       ZET     BUSYB                                                    LAMI3950
       TRA     *-1                                                      LAMI3960
       TRA     1,4                                                      LAMI3970
FIX    SXA     U,4                                                      LAMI3980
       SXA     U+1,1                                                    LAMI3990
       SXA     U+2,2                                                    LAMI4000
       CLA     NM                                                       LAMI4010
       AXT     8,2                                                      LAMI4020
       STD     COMRD1+8,2                                               LAMI4030
       TIX     *-1,2,1                                                  LAMI4040
       CLA     N                                                        LAMI4050
       ARS     1                                                        LAMI4060
       ADD     ONE                                                      LAMI4070
       STD     NHALF                                                    LAMI4080
       AXT     5,2                                                      LAMI4090
FJUTT  CLS     NM                                                       LAMI4100
       ARS     18                                                       LAMI4110
       ADD     BUFF+5,2                                                 LAMI4120
       STA     COMRD1+5,2                                               LAMI4130
       SUB     DIMENS                                                   LAMI4140
       STA     COMRD1+7,2                                               LAMI4150
       SUB     DIMENS                                                   LAMI4160
       STA     COMRD1+6,2                                               LAMI4170
       SUB     DIMENS                                                   LAMI4180
       STA     COMRD1+8,2                                               LAMI4190
       TIX     FJUTT,2,4                                                LAMI4200
       AXT     6,1                                    CHANGE VERSION 2  LAMI4210
UJ     CAL     UNIT+6,1                               CHANGE VERSION 2  LAMI4220
       CALL    (IOS)                                  CHANGE VERSION 2  LAMI4230
       CLA*    $(UCB)                                 CHANGE VERSION 2  LAMI4240
       PAC     0,4                                    CHANGE VERSION 2  LAMI4250
       CLA     0,4                                    CHANGE VERSION 2  LAMI4260
       PDX     0,4                                    CHANGE VERSION 2  LAMI4270
       TXI     *+1,4,16                               CHANGE VERSION 2  LAMI4280
       PXA     0,4                                    CHANGE VERSION 2  LAMI4290
       STA     SELOP+7,1                              CHANGE VERSION 2  LAMI4300
       TIX     UJ,1,1                                 CHANGE VERSION 2  LAMI4310
       LDI     ACAN-1                                 CHANGE VERSION 2  LAMI4320
