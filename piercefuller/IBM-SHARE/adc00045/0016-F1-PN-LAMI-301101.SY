*     LABEL                                                             LAMI0000
*     LIST8                                                             LAMI0010
      SUBROUTINE LAMIS                                                  LAMI0020
      COMMON I,II,IVAL,IP,IX,IZ,J,K,M,N,NM,R1,R3,R4,R5,RR,RW,ZEROT      LAMI0030
      COMMON MR,NR                                                      LAMI0040
D     DIMENSION R1(200),R3(200),R4(200),R5(200),RR(200,2),RW(200,2)     LAMI0050
      DIMENSION MR(200),NR(200)                                         LAMI0060
      CALL SCAN                                                         LAMI0070
      DO 1 I=1,N                                                        LAMI0080
      II=I+1                                                            LAMI0090
      CALL RESTRT                                                       LAMI0100
    1 CALL REDUCE                                                       LAMI0110
      CALL  TCO                                                         LAMI0120
      CALL SORT                                                         LAMI0130
      RETURN                                                            LAMI0140
      END                                                               LAMI0150
*      FAP                                                              LAMI0160
*REDUCE                                                                 LAMI0170
       COUNT   200                                                      LAMI0180
       LBL     REDUCE,N                                                 LAMI0190
       ENTRY   REDUCE                                                   LAMI0200
       BCI     1,REDUCE                                                 LAMI0210
REDUCE SXA     OUT,1                                                    LAMI0220
       SXA     OUT+1,2                                                  LAMI0230
       SXA     OUT+2,4                                                  LAMI0240
       CLA     ONE                                                      LAMI0250
       STO     J                                                        LAMI0260
       CALL    BINRD                                                    LAMI0270
       STZ     KK                                                       LAMI0280
       CLA     ONE                                                      LAMI0290
       STO     IZ                                                       LAMI0300
