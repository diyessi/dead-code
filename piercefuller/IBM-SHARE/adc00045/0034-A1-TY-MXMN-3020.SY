       COUNT   60                                                       MXMN0001
       ENTRY   MAX                               MAX(I,J,K,L,M)=I(J)    MXMN0002
       ENTRY   AMAX                    AMAX(Z,J,K,L,M)=Z(J)             MXMN0003
       ENTRY   MAXA                    MAXA(I,J,K,L,M)=XABSF(I(J))      MXMN0004
       ENTRY   AMAXA                   AMAXA(Z,J,K,L,M)=ABSF(Z(J))      MXMN0005
       ENTRY   MIN                     MIN(I,J,K,L,M)=I(J)              MXMN0006
       ENTRY   AMIN                    AMIN(Z,J,K,L,M)=Z(J)             MXMN0007
       ENTRY   MINA                    MINA(I,J,K,L,M)=XABSF(I(J))      MXMN0008
       ENTRY   AMINA                   AMINA(Z,J,K,L,M)=ABSF(Z(J))      MXMN0009
 MAX   LDQ     SUB                                                      MXMN0010
       CLA     CHS                                                      MXMN0011
 INIT  STO     CHNO                                                     MXMN0012
       CLA     1,4                                                      MXMN0013
       ACL     ONE                                                      MXMN0014
       LGR     15                                                       MXMN0015
       RQL     15                                                       MXMN0016
       STQ     LOOP+1                                                   MXMN0017
       CLA*    4,4                                                      MXMN0018
       STD     L                                                        MXMN0019
       CLA*    5,4                                                      MXMN0020
       STD     M                                                        MXMN0021
       SXA     XR4,4                                                    MXMN0022
       CLA*    3,4                                                      MXMN0023
       PDX     0,4                                                      MXMN0024
       LDQ     INF                                                      MXMN0025
 LOOP  PXD     0,0                     THE HTR WILL BE SUB I+1,4 IN MAX,MXMN0026
       HTR     *                       ADD IN MIN,ADM IN MINA,SBM INMAXAMXMN0027
       TLQ     M                                                        MXMN0028
       XCA                                                              MXMN0029
       SXD     J,4                                                      MXMN0030
 M     TXI     L,4,M                                                    MXMN0031
 L     TXL     LOOP,4,L                                                 MXMN0032
 XR4   AXT     XR4,4                                                    MXMN0033
       CLA     J                                                        MXMN0034
       STO*    2,4                                                      MXMN0035
       XCA                             THE HTR WILL BE CHS IN MAX AND   MXMN0036
 CHNO  HTR     *                       MAXA,AND TRA 6,4 IN MIN AND MINA.MXMN0037
       TRA     6,4                                                      MXMN0038
 J     OCT     0                                                        MXMN0039
 ONE   OCT     1                                                        MXMN0040
 INF   OCT     377777777777                                             MXMN0041
 MIN   LDQ     ADD                                                      MXMN0042
       CLA     CHNO+1                                                   MXMN0043
       TRA     INIT                                                     MXMN0044
 MAXA  LDQ     SBM                                                      MXMN0045
       TRA     MAX+1                                                    MXMN0046
 MINA  LDQ     ADM                                                      MXMN0047
       TRA     MIN+1                                                    MXMN0048
 ADD   ADD     0,4                                                      MXMN0049
 SUB   SUB     0,4                                                      MXMN0050
 ADM   ADM     0,4                                                      MXMN0051
 SBM   SBM     0,4                                                      MXMN0052
 CHS   CHS                                                              MXMN0053
 AMAX  EQU     MAX                                                      MXMN0054
 AMIN  EQU     MIN                                                      MXMN0055
 AMAXA EQU     MAXA                                                     MXMN0056
 AMINA EQU     MINA                                                     MXMN0057
       END                                                              MXMN0058
