$IBMAP 3K01    35                                                       .IOUF000
*      ROUTINE TO FIND LOC. OF A FCB GIVEN A LOGICAL NUMBER             .IOUF010
*      USE AS FOLLOWS.                                                  .IOUF020
*      CLA     TAPENO (TAPE AT B35)                                     .IOUF030
*      CALL    .IOU.F                                                   .IOUF040
*      TZE     ERROR                                                    .IOUF050
*       RESULT = 0 IN AC FOR NO SUCH TAPE, UNIT NO. IN MQ               .IOUF060
*              = ADDRESS OF FCB IF OK, UNIT NO. IN MQ                   .IOUF070
       SPACE   5                                                        .IOUF080
.IOU.F SAVE                                                             .IOUF090
       STO     E.3                                                      .IOUF100
       TSX     .DECVA,4                                                 .IOUF110
       XCL                        MOVE TO AC                            .IOUF120
       ANA     =O7777             AC=0000XX                             .IOUF130
       ORA     =HUNIT00           AC=UNITXX                             .IOUF140
       SLW     E.4                                                      .IOUF150
       LAC     .LFBLK,4           COMPL OF 1 ST FCB TO XR4              .IOUF160
       TXI     *+1,4,-9                                                 .IOUF170
   GET CAL     0,4                1ST FILENM TO AC                      .IOUF180
       LAS     E.4                IS THIS UNITXX                        .IOUF190
       TRA     *+2                NO                                    .IOUF200
       TXI     FLFND,4,9          YES. BUMP XR4 TO 1ST WORD FCB         .IOUF210
       LAS     =HSYSLPT           NO. IS IT SYSPLT                      .IOUF220
       TRA     *+2                NO                                    .IOUF230
       TXI     GET,4,-12          YES. GET NEXT FILE NAME               .IOUF240
       ANA     =O777777770000     NO                                    .IOUF250
       LAS     =HUNIT00           IS IT UNITYY                          .IOUF260
       TRA     NOGOOD             NO                                    .IOUF270
       REM     CONTINUE SCAN                                            .IOUF280
       TXI     GET,4,-12          YES, GET NEXT FILE NAME.              .IOUF290
NOGOOD ZAC                        NO                                    .IOUF300
       TRA     OUT                                                      .IOUF310
 FLFND PCA     ,4                 PLACE ADDRESS OF FCB IN AC            .IOUF320
   OUT LDQ     E.3                                                      .IOUF330
       RETURN  .IOU.F                                                   .IOUF340
       END                                                              .IOUF350
