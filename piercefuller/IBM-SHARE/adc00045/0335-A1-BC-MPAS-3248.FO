*     LABEL                                                             MPAS 001
*     FAP                                                               MPAS 002
*ADDSUB        *** MULTIPLE-PRECISION ADDITION, SUBTRACTION SUBROUTINE *MPAS 003
       COUNT   70                                                       MPAS 004
       ENTRY   MPADD                                                    MPAS 005
       ENTRY   MPSUB                                                    MPAS 006
MPADD  CLA     ADD             MULTI-PRECISE C=A+B                      MPAS 007
       TRA     *+2             MULTI-PRECISE C=A-B                      MPAS 008
MPSUB  CLA     SUB             LINKAGE,                                 MPAS 009
       STD     AD2             CALL MPADD (A,NA,B,NB,C,NC)   OR         MPAS 010
       SXA     EXIT,2          CALL MPSUB (A,NA,B,NB,C,NC)              MPAS 011
       CAL     1,4             WHERE                                    MPAS 012
ADD    ADD     =1              A,B,C ARE DIMENSIONED FORTRAN ARRAYS     MPAS 013
       STA     AD0                                                      MPAS 014
       STA     AD1             NA,NB,NC ARE FORTRAN DECREMENT INTEGERS  MPAS 015
       CLA*    2,4                   EQUAL TO NUMBER OF SIGNIFICANT     MPAS 016
       STD     LA                    WORDS RESP.                        MPAS 017
       CAL     3,4             C AND NC ARE COMPUTED BY THIS SUBROUTINE MPAS 018
       ADD     =1              A(1),B(1),C(1) ARE THE LEAST SIGNIFICANT MPAS 019
       STA     AD2                WORDS RESP.                           MPAS 020
       CLA*    4,4             LEADING ZERO WORDS ARE IGNORED           MPAS 021
       STD     LB              ARRAYS ARE 35 BIT SIGNED WORDS.          MPAS 022
       CAS*    2,4             C(NC) IS ONLY ZERO WHEN C=0 AND NC=1     MPAS 023
       TRA     *+3             MIXED SIGNS ARE ALLOWED BUT              MPAS 024
       TRA     *+2                C IS RECTIFIED.                       MPAS 025
       CLA*    2,4             A=A+B OR B=A+B IS ALLOWED                MPAS 026
       STD     BEGIN           A=A+0 WILL RECTIFY A                     MPAS 027
       CAL     5,4             A=0-A WILL RECTIFY A AND CHANGE ITS SIGN.MPAS 028
       ADD     =1              AC OVFLO INDICATOR TURNED OFF ON RETURN  MPAS 029
       STA     AD3                                                      MPAS 030
       STA     AD4                                                      MPAS 031
       STA     AD5                                                      MPAS 032
       STA     AD6                                                      MPAS 033
       STA     AD7                                                      MPAS 034
       STA     AD8                                                      MPAS 035
       STA     STO                                                      MPAS 036
       AXT     1,2                                                      MPAS 037
AD0    CLA     **,2            LWA A+1,2                                MPAS 038
       TRA     AD2                                                      MPAS 039
BEGIN  TXH     OUT,2,**        OUT,2,MAX(LA,LB)                         MPAS 040
LA     TXH     *+3,2,**        *+3,2,LA                                 MPAS 041
AD1    ADD     **,2            LWA A+1,2                                MPAS 042
LB     TXH     *+2,2,**        *+2,2,LB                                 MPAS 043
AD2            **,2            (ADD,SUB),LWA B+1,2                      MPAS 044
AD3    STO     **,2            LWA C+1,2                                MPAS 045
       ARS     35                                                       MPAS 046
       TXI     BEGIN,2,1                                                MPAS 047
OUT    TNZ     *-3                                                      MPAS 048
       TIX     *+1,2,1                                                  MPAS 049
AD4    CLA     **,2            LWA C+1,2                                MPAS 050
       TNZ     *+2                                                      MPAS 051
       TIX     *-2,2,1                                                  MPAS 052
AD5    CAL     **,2            LWA C+1,2                                MPAS 053
       ANA     *                                                        MPAS 054
       STP     PREFIX                                                   MPAS 055
       SXD     A+1,2                                                    MPAS 056
       AXT     1,2                                                      MPAS 057
A      CLM                                                              MPAS 058
       TXH     AD8+2,2,**      AD8+2,2,NON-ZERO WORD COUNT              MPAS 059
AD6    ADD     **,2            LWA C+1,2                                MPAS 060
PREFIX TPL     STO                                                      MPAS 061
       CHS                                                              MPAS 062
       TZE     STO                                                      MPAS 063
       COM                                                              MPAS 064
       ACL     =1                                                       MPAS 065
AD7    STO     **,2            LWA C+1,2                                MPAS 066
       CLM                                                              MPAS 067
       ACL     =1                                                       MPAS 068
       CHS                                                              MPAS 069
       TXI     A+1,2,1                                                  MPAS 070
STO    STO     **,2            LWA C+1,2                                MPAS 071
       TXI     A,2,1                                                    MPAS 072
AD8    CLA     **,2            LWA C+1,2                                MPAS 073
       TNZ     *+2                                                      MPAS 074
       TIX     AD8,2,1                                                  MPAS 075
       PXD     ,2                                                       MPAS 076
       STD*    6,4                                                      MPAS 077
EXIT   AXT     **,2                                                     MPAS 078
       TOV     7,4                                                      MPAS 079
       TNO     7,4                                                      MPAS 080
SUB    SUB     =1                                                       MPAS 081
       END                                                              MPAS 082
