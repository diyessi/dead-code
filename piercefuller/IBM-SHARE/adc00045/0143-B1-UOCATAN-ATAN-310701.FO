*      FAP                                                              ATAN0001
       LBL     ATAN                                                     ATAN0002
       COUNT   120                                                      ATAN0003
*      U. OF CHICAGO VERSION OF SINGLE PRECISION ARCTANGENT             ATAN0004
*              CALLING SEQUENCE     TSX  $ATAN,4                        ATAN0005
       SPACE                                                            ATAN0006
       ENTRY   ATAN                                                     ATAN0007
       SPACE                                                            ATAN0008
 ATAN  SXA     SAVE1,1                                                  ATAN0009
       SXA     SAVE2,2                                                  ATAN0010
       STO     ARG                                                      ATAN0011
       SSP                                                              ATAN0012
       LDQ     RET           CLEAR HIGH PART MQ                         ATAN0013
       LRS     27                                                       ATAN0014
       PAX     ,1                                                       ATAN0015
       TXL     *+3,1,155                                                ATAN0016
       CLA     PIHLF         FOR LARGE ARGUMENT RETURN WITH HALF PI     ATAN0017
   A   TXL     SIGN,0,**                                                ATAN0018
       TXH     *+3,1,114                                                ATAN0019
       CLA     ARG           FOR SMALL ARGUMENT RETURN WITH THE ARGUMENTATAN0020
       TRA     SAVE1                                                    ATAN0021
       SPACE                                                            ATAN0022
       AXT     0,2                                                      ATAN0023
       TXL     B,1,128                                                  ATAN0024
       TXI     *+1,2,2       IF ARGUMENT GREATER THAN 1, TAKE THE RECI- ATAN0025
       STQ     BUFF            PROCAL                                   ATAN0026
       CLA     ONE                                                      ATAN0027
       DVP     BUFF                                                     ATAN0028
       SXD     A,1                                                      ATAN0029
       LDC     A,1                                                      ATAN0030
       TXI     *+1,1,258                                                ATAN0031
  B    ZAC                                                              ATAN0032
       LRS     130,1         X OR 1 OVER X IN MQ, SCALING (2,33)        ATAN0033
       SPACE                                                            ATAN0034
       CLA     TAN15                                                    ATAN0035
       TLQ     C             IF ARGUMENT GREATER THAN TAN PI/12, COMPUTEATAN0036
       XCA                     TAN Z WHERE TAN (Z+PI/6)=X.              ATAN0037
       ADD     RTTHR                                                    ATAN0038
       STO     BUFF            TAN Z = SQRT3-4/(X+SQRT3)                ATAN0039
       CLS     FOUR                                                     ATAN0040
       DVP     BUFF                                                     ATAN0041
       XCA                                                              ATAN0042
       ADD     RTTHR                                                    ATAN0043
       LRS     34                                                       ATAN0044
       TXI     *+2,2,1                                                  ATAN0045
       SPACE                                                            ATAN0046
  C    LLS     1             MODIFIED ARGUMENT IN MQ , SCALE (1,34)     ATAN0047
       STQ     BUFF                                                     ATAN0048
       MPY     BUFF                                                     ATAN0049
       STO     SQ            X SQUARE, SCALE (2,33)                     ATAN0050
       ADD     B0            COMPUTE FRACTION APPROXIMATION             ATAN0051
       STO     BUFF+1          FOR  ATAN(X)/X-1                         ATAN0052
       LDQ     A2                                                       ATAN0053
       MPY     SQ                              A1*XSQ+A2*X**4           ATAN0054
       ADD     A1                ATAN(X)/X = 1+--------------           ATAN0055
       DVP     BUFF+1                             B0+XSQ                ATAN0056
       MPY     SQ              SCALE (2,33)                             ATAN0057
       SPACE                                                            ATAN0058
       TXL     D,2,0                                                    ATAN0059
       ADD     ONE           FOR ANGLE GREATER THAN PI/12, CONTINUE     ATAN0060
       XCA                     WITH FIXED POINT OPERATION.              ATAN0061
       MPY     BUFF            OBTAIN Z AND ADD TO (OR SUBTRACT FROM)   ATAN0062
       TXL     *+2,2,1         APPROPRIATE BASE ANGLE                   ATAN0063
       CHS                                                              ATAN0064
       ADD     N+1,2           ANSWER READY   SCALE (3,32)              ATAN0065
       LRS     6                                                        ATAN0066
       ORA     CH201         FLOAT AND ROUND                            ATAN0067
       STO     BUFF                                                     ATAN0068
       XCA                                                              ATAN0069
       ARS     8                                                        ATAN0070
       ORA     CH146                                                    ATAN0071
       FAD     BUFF                                                     ATAN0072
       FRN                                                              ATAN0073
       SPACE                                                            ATAN0074
 SIGN  LDQ     ARG                                                      ATAN0075
       LLS     0                                                        ATAN0076
 SAVE1 AXT     **,1                                                     ATAN0077
 SAVE2 AXT     **,2                                                     ATAN0078
  RET  TRA     1,4                                                      ATAN0079
       SPACE                                                            ATAN0080
   D   ARS     1             FOR ANGLE LESS THAN PI/12, SWITCH TO       ATAN0081
       ORA     CH173           FLOAT POINT OPERATION FOR ACCURACY       ATAN0082
       XCA                                                              ATAN0083
       FMP     ARG             PRODUCT POSSIBLY UNNORM., BUT OK         ATAN0084
       FAD     ARG                                                      ATAN0085
       FRN                                                              ATAN0086
       TRA     SAVE1                                                    ATAN0087
       SPACE                                                            ATAN0088
 PIHLF OCT     201622077325        PI/2   FLOAT POINT                   ATAN0089
  ONE  OCT     100000000000        1                     B2             ATAN0090
 FOUR  EQU     ONE                 4                     B4             ATAN0091
 TAN15 OCT     021114121365        TAN PI/12             B2             ATAN0092
 RTTHR OCT     156663656413        SQRT 3                B2             ATAN0093
       OCT     041405221603        PI/3                  B3             ATAN0094
       OCT     062207732504        PI/2                  B3             ATAN0095
  N    OCT     020602510701        PI/6                  B3             ATAN0096
 CH201 OCT     201000000000                                             ATAN0097
 CH146 OCT     146000000000                                             ATAN0098
 CH173 OCT     173000000000                                             ATAN0099
  A1   OCT     -036076552552       -0.4706637088         B2             ATAN0100
  A2   OCT     -015035015276       -0.0510027017         B0             ATAN0101
  B0   OCT     132274147361         1.4119934720         B2             ATAN0102
  ARG  BSS     1                                                        ATAN0103
  SQ   BSS     1                                                        ATAN0104
 BUFF  BSS     2                                                        ATAN0105
       END                                                              ATAN0106
