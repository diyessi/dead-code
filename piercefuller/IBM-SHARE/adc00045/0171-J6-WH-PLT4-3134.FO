$IBFTC PLOT1   XR7,M94                                                          
      SUBROUTINE PLOT1 (XMIN,XMAX1,YMIN,YMAX1,IC)                               
C     SUBROUTINE PLOT1  FOR CONTROL AND INTIALIZATION OF PLOTTING ROUTINES      
      XMAX=XMAX1                                                                
      YMAX=YMAX1                                                                
C     CHECK PLOTTING MODE                                                       
      CALL PLOT4(0,2)                                                           
      IQ=2                                                                      
      IZ=1                                                                      
C     SET PEN CONTROL IN PLOT2                                                  
      GO TO (1,40), IC                                                          
 1    Y=9.                                                                      
      GO TO 2                                                                   
 40   Y=8.                                                                      
 2    CALL PLOT2(1,IQ)                                                          
      CALL PLOT2(X,Y)                                                           
      GO TO (3,4), IZ                                                           
 3    GO TO (32,5,18,19), IQ                                                    
 4    GO TO (32,5,30,29), IQ                                                    
 5    X=0.                                                                      
C     CHECK TO SEE IF GRAPH GRIDS HAVE BEEN ENTERED INTO PLOT5                  
      CALL PLOT5 (X,Y)                                                          
      IF(X) 28,6,28                                                             
 6    IQ=3                                                                      
      IF(XMAX-XMIN) 7,9,7                                                       
 7    X=9499./(XMAX-XMIN)                                                       
      IF(YMAX-YMIN) 8,9,8                                                       
 8    Y=9499./(YMAX-YMIN)                                                       
      W=X                                                                       
      Z=Y                                                                       
C     SET SCALE FACTORS IN PLOT2                                                
      GO TO 2                                                                   
 9    WRITE(6,100)                                                              
      CALLPLOT2(1,5)                                                            
      GO TO 31                                                                  
 18   X=500.-XMIN*X                                                             
      Y=500.-YMIN*Y                                                             
      CALLLABEL(W,Z,-1,X,Y,Y,Y)                                                 
      IQ=4                                                                      
C     SET TRANSLATION INFORMATION IN PLOT2                                      
      GO TO 2                                                                   
 19   IF(Y-500.) 24,10,10                                                       
 10   IF(9999.-Y) 24,11,11                                                      
11    IND=0                                                                     
      IP=9                                                                      
      IX=500                                                                    
      IY=Y                                                                      
C     DRAW IN AXES                                                              
 20   CALL PLOT6(IP,IX,IY)                                                      
      IND =IND + 1                                                              
      GO TO (21,22,23,24,25,26,27,30), IND                                      
 21   IP=8                                                                      
      IX=3767                                                                   
      GO TO 20                                                                  
 22   IX=6933                                                                   
      GO TO 20                                                                  
 23   IX=9999                                                                   
      GO TO 20                                                                  
 24   IF(X-500.) 30,13,13                                                       
 13   IF(9999.-X) 30,14,14                                                      
 14   IND=4                                                                     
      IP=9                                                                      
      IX=X                                                                      
      IY=500                                                                    
      GO TO 20                                                                  
 25   IP=8                                                                      
      IY=3767                                                                   
      GO TO 20                                                                  
 26   IY=6933                                                                   
      GO TO 20                                                                  
 27   IY=9999                                                                   
      GO TO 20                                                                  
C                                                                               
C     XMAX,YMAX HERE REPRESENT RAW MAX. VALUES, AND WILL NOT NECESSARILY        
C     CORRESPOND TO THE EXTREMA OF THE GRAPH                                    
 28   CALL SCALE (X,Y,XMAX,YMAX)                                                
      IZ=2                                                                      
      IQ=4                                                                      
      GO TO 2                                                                   
 29   X=XMAX                                                                    
      Y=YMAX                                                                    
      IQ=3                                                                      
      GO TO 2                                                                   
C                                                                               
C     CHECK PLOTTING MODE                                                       
 30   CALL PLOT4(0,IC)                                                          
 32   CALL PLOT2 (1,1)                                                          
 31   RETURN                                                                    
 100  FORMAT(68H1PLOT2 HAS NOT BEEN INTITALIZED.  CHECK ARGUMENTS SUPPLIED TO PL
     1ED TO PLOT1./1H1)                                                         
      END                                                                       
$IBFTC PLOT2   XR7,M94                                                          
      SUBROUTINE PLOT2     (X,Y)                                                
      DATA IQ/5/                                                                
      EQUIVALENCE (Z,L)                                                         
       IQ=IQ                                                                    
      Z=X                                                                       
      IF(L-1) 1,2,1                                                             
C                                                                               
C     IQ      FUNCTION                                                          
C      1  TRANSFORM CO-ORDINATES AND CONVERT TO INTEGERS                        
C      2  SET PEN CONTROL                                                       
C      3  SET SCALE FACTORS                                                     
C      4  SET ORIGIN INFORMATION                                                
C                                                                               
 1    GOTO(3,4,5,6,10),IQ                                                       
 3    IF(N) 7,7,8                                                               
 8    IPEN=LINE                                                                 
 20   IF (X-XMAX) 21,21,11                                                      
 21   IF (X-XMIN) 11,22,22                                                      
 22   IF (Y-YMAX) 23,23,11                                                      
 23   IF (Y-YMIN) 11,9,9                                                        
 9    IX=X*XSCALE+XO                                                            
      IY=Y*YSCALE+YO                                                            
      CALL PLOT6 (IPEN,IX,IY)                                                   
 10   RETURN                                                                    
 2    IF(Y) 11,11,12                                                            
 12   Z=Y                                                                       
      IQ=L                                                                      
      GO TO 10                                                                  
 7    N=1                                                                       
C     RAISE PEN FOR NEXT POINT                                                  
      IPEN=9                                                                    
      GO TO 20                                                                  
 4    LINE=Y                                                                    
      GO TO 10                                                                  
 5    XSCALE=X                                                                  
      YSCALE=Y                                                                  
      GO TO 10                                                                  
 6    XO=X                                                                      
      YO = Y                                                                    
      XMAX=(9999.-XO)/XSCALE                                                    
      YMAX=(9999.-YO)/YSCALE                                                    
      XMIN=(500.-XO)/XSCALE                                                     
      YMIN=(500.-YO)/YSCALE                                                     
 11   N=0                                                                       
      GO TO 10                                                                  
      END                                                                       
$IBFTC PLOT3   M94                                                              
      SUBROUTINE PLOT3                                                          
C     CAUSE THE LAST CARD TO BE PUNCHED                                         
      CALL PLOT6 (-1,0,0)                                                       
      CALLENDUP                                                                 
      RETURN                                                                    
      END                                                                       
$IBFTC PLOT4   XR7,M94                                                          
      SUBROUTINE PLOT4(IX,IY)                                                   
      DATA  N/0/                                                                
      IF(N)1,5,1                                                                
1     IF(IX)6,2,6                                                               
2     IF(IY-MODE)4,3,4                                                          
3     RETURN                                                                    
4     MODE=IY                                                                   
C     CALL PLOT6(7,0,0) HERE ,IF DESIRE TO STOP PLOTTER ON MODE CHANGE .        
      GO TO 3                                                                   
5     MODE=2                                                                    
      REWIND2                                                                   
      N=1                                                                       
      CALL PLOT6(0,4HPLOT,1)                                                    
C      SET ID INFO IN PLOT6 .                                                   
      GO TO 1                                                                   
6     CALL PLOT6(0,IX,IY)                                                       
      GO TO 3                                                                   
      END                                                                       
$IBFTC PLOT5   M94                                                              
      SUBROUTINE  PLOT5 (MGX,MGY)                                               
      DATA IX/0/                                                                
C     IF PLOT5 IS GIVEN THE GRAPH GRIDS IT WILL SPEW THEM FORTH THE FIRST       
C     TIME IT IS CALLED WITH A 0 IN MGX.  IT WILL NOT DO THIS AGAIN UNLESS      
C     IT IS PRIMED WITH NEW GRAPH GRIDS.                                        
      IF(MGX) 2,1,2                                                             
 1    MGX=IX                                                                    
      MGY=IY                                                                    
      IX=0                                                                      
 3    RETURN                                                                    
 2    IX=MGX                                                                    
      IY=MGY                                                                    
      GO TO 3                                                                   
      END                                                                       
$IBFTC PLOT6   XR7,M94                                                          
      SUBROUTINE PLOT6 (IPON,IXI,IYI)                                           
      DATA I/0/                                                                 
C     SUBROUTINE PLOT 6  FOR  PUNCHING   FRANK  ENGEL III                       
      DIMENSION  IPEN(8), IX(8), IY(8)                                          
      IF(IPON) 5,4,1                                                            
 1    I = I + 1                                                                 
      IX(I)=IXI                                                                 
      IY(I)=IYI                                                                 
      IPEN(I)=IPON                                                              
      IF(I-8) 2,3,3                                                             
C     RELLACE THIS BY A PUNCH STATEMENT WHEN THE WH SYSTEM SETTLES              
 3     WRITE(2,400)(IPEN(J),IX(J),IY(J),J=1,8),NAME,NA                          
      NA = NA+1                                                                 
      I=0                                                                       
 2    RETURN                                                                    
 4    I=0                                                                       
      NAME=IXI                                                                  
      NA=IYI                                                                    
      GO TO 2                                                                   
 5    IF(I) 2,2,6                                                               
 6    KA=I+1                                                                    
      I=I                                                                       
      DO 7 J=KA,8                                                               
       IPEN(J)=9                                                                
      IX(J)=9999                                                                
 7    IY(J)=9999                                                                
      GO TO 3                                                                   
 400  FORMAT(8(I1,2I4),A5,I3)                                                   
      END                                                                       
$IBFTC LABEL   XR7,M94                                                          
      SUBROUTINE LABEL(XS,YS,IDIR,XL,YL,N,WURD)                                 
C  PRINTING  SUBROUTINE  FOR  DATA-PLOTTER  -  FRANK A. ENGEL  III      TITLE  1
      DIMENSION  WURD(1), IPEN(16), IA(12), INT(6)                              
      DIMENSION ALPHA(62,3)                                                     
      DATA XO,YO,XSCALE,YSCALE/2*0,2*1./                                        
      DATA  ALPHA(1,1)  /O020210160000/,                                 1      
     1(ALPHA(2,I),I=1,2)/O120515263645,O443323121040/,                   2      
     1(ALPHA(3,I),I=1,3)/O150515263645,O443323334241,O302011000000/,     3      
     3(ALPHA(4,I),I=1,2)/O054416124236,O300000000000/,                   4      
     4(ALPHA(5,I),I=1,2)/O110546161333,O424130201100/,                   5      
     5(ALPHA(6,I),I=1,3)/O140512233342,O413020111526,O364500000000/,     6      
     6ALPHA(7,1)/O030516462000/,                                         7      
     7(ALPHA(8,I),I=1,3)/O200523141526,O364544332312,O112030414233/,     8      
     8(ALPHA(9,I),I=1,3)/O140511203041,O453626151423,O334400000000/      9      
      DATA  ALPHA(11,1)/O043402424404/,                                  =      
     1ALPHA(12,1)/O020216150000/,                                        '      
     1ALPHA(16,1)/O043403432521/,                                        +      
     1(ALPHA(17,I),I=1,2)/O053622421036,O500000000000/,                  A      
     6(ALPHA(18,I),I=1,3)/O142510163645,O443342413010,O133300000000/,    B      
     8(ALPHA(19,I),I=1,2)/O100541302011,O152636450000/,                  C      
     9(ALPHA(20,I),I=1,2)/O070510163645,O413010000000/,                  D      
     1(ALPHA(21,I),I=1,2)/O065540101646,O133300000000/,                  E      
     2(ALPHA(22,I),I=1,2)/O054410164613,O330000000000/,                  F      
     3(ALPHA(23,I),I=1,3)/O134532424041,O302011152636,O450000000000/,    G      
     4(ALPHA(24,I),I=1,2)/O067510161343,O464000000000/,                  H      
     5(ALPHA(25,I),I=1,2)/O067410302026,O163600000000/,                  I      
     6ALPHA(27,1)/O20310100000/,                                         .      
     7ALPHA(28,1)/O030316231000/                                         )      
      DATA ALPHA(32,1)/O020403430000/,                                   -      
     1(ALPHA(33,I),I=1,2)/O050436312010,O010000000000/,                  J      
     2(ALPHA(34,I),I=1,2)/O067510164613,O244000000000/                   K      
      DATA ALPHA(35,1)/O030416104000/,                                   L      
     1(ALPHA(36,I),I=1,2)/O050610163256,O500000000000/                   M      
      DATA ALPHA(37,1)/O040510164046/,                                   N      
     4(ALPHA(38,I),I=1,2)/O110541302011,O152636454100/,                  O      
     1(ALPHA(39,I),I=1,2)/O070510163645,O443313000000/,                  P      
     2(ALPHA(40,I),I=1,3)/O131541302011,O152636454131,O400000000000/,    Q      
     2(ALPHA(41,I),I=1,2)/O113513331016,O364544334000/,                  R      
     7(ALPHA(43,I),I=1,2)/O127520263630,O114143131545/,                  $      
     8(ALPHA(44,I),I=1,2)/O067411354303,O153100000000/,                  *      
     9(ALPHA(50,I),I=1,3)/O140545362615,O142333424130,O201100000000/     S      
      DATA ALPHA(51,1)/O043406462620/,                                   T      
     6(ALPHA(52,I),I=1,2)/O060516112030,O414600000000/                   U      
      DATA ALPHA(53,1)/O030616305600/,                                   V      
     7(ALPHA(54,I),I=1,2)/O050616203340,O560000000000/                   W      
      DATA ALPHA(55,1)/O043616501056/,                                   X      
     8(ALPHA(56,I),I=1,2)/O053616335633,O300000000000/,                  Y      
     2ALPHA(57,1)/O040516461040/,                                        Z      
     3ALPHA(59,1)/O020410210000/,                                        ,      
     4ALPHA(60,1)/O030326132000/                                         (      
      IF(IDIR)60,60,61                                                          
 60   XSCALE=XS                                                                 
      YSCALE=YS                                                                 
      XO=XL                                                                     
      YO=YL                                                                     
      GOTO25                                                                    
 61   JXO=XS*XSCALE+XO                                                          
      JYO=YS*YSCALE+YO                                                          
      IXC=277.75/XL                                                             
      IYC=277.75/YL                                                             
      IXO=JXO                                                                   
      IYO=JYO                                                                   
      JACK=9999-10*IXC                                                          
      IF(JACK-IXO)26,24,24                                                      
24    IF(JACK-IYO)26,27,27                                                      
26    WRITE(6,2001)                                                             
      GOTO25                                                                    
27    CALLPLOT4(0,2)                                                            
      DO10LW=1,N                                                                
 23   CALL EXPAN(WURD(LW),INT)                                                  
      IF (INT(1) - 63)  1,25,25                                                 
C     BRING IN NEXT SIX CHARACTERS                                              
 1    DO 10  I = 1,6                                                            
      IF (INT(I) - 48)  4,3,2                                                   
 2    IF(INT(I)-50)5,4,4                                                        
 5    GOTO(42,44),IDIR                                                          
C     START  NEW  LINE                                                          
 3    ISPACE=7                                                                  
      GOTO46                                                                    
C     SPACE                                                                     
 4    KAP = INT(I)                                                              
      IF(KAP)6,6,7                                                              
 6    KAP=38                                                                    
 7    DO9MO=1,3                                                                 
      CALL UNPACK(ALPHA(KAP,MO),IA)                                             
C     BRING  IN  NEW  CHARACTER                                                 
      GO TO (19, 36, 38), MO                                                    
 19   NS=8*IA(1)+IA(2)                                                          
      IF(NS-16)20,20,21                                                         
 20   IF(NS)21,21,22                                                            
 21   WRITE(6,2000)KAP                                                          
      GOTO46                                                                    
 22   DO 11  K = 1, NS                                                          
 11   IPEN(K) = 8                                                               
      JRC = IA(3)                                                               
C     DETERMINE  PEN  RAISE POSITIONS                                           
      IF (JRC - 1) 14,13,12                                                     
 13   IPEN(10) = 9                                                              
      GO TO 14                                                                  
 12   IF (JRC - 7) 16,15,18                                                     
 15   IPEN(3) = 9                                                               
      IPEN(5) = 9                                                               
      GO TO 14                                                                  
 16   IF (JRC - 2) 14,17,18                                                     
 17   IPEN(11) = 9                                                              
      GO TO 14                                                                  
 18   IPEN(JRC)= 9                                                              
 14   IPEN(1) = 9                                                               
      ISPACE=IA(4)                                                              
      N1 = 1                                                                    
      KB=3                                                                      
      IF (NS - 4)  31,31,32                                                     
 32   N2 = 4                                                                    
      IP = 2                                                                    
      GO TO 33                                                                  
 31   N2 = NS                                                                   
      IP = 1                                                                    
C                                                                               
 33   DO 30  K = N1,N2                                                          
      IPON=IPEN(K)                                                              
      KB=KB+2                                                                   
      GO TO (34,35), IDIR                                                       
 34   IX=IA(KB)*IXC+IXO                                                         
      IY=IA(KB+1)*IYC+IYO                                                       
      GO TO 50                                                                  
  35  IY=IA(KB)*IYC+IYO                                                         
      IX=IXO-IA(KB+1)*IXC                                                       
 50   CALL PLOT6(IPON,IX,IY)                                                    
 30   CONTINUE                                                                  
      GO TO (46, 9), IP                                                         
 36   KB=-1                                                                     
      N1 = 5                                                                    
      IF (NS - 10)  31,31,37                                                    
 37   N2 = 10                                                                   
      IP = 2                                                                    
      GO TO 33                                                                  
 38   KB=-1                                                                     
      N1 = 11                                                                   
      N2 = NS                                                                   
      IP = 1                                                                    
      GO TO 33                                                                  
 9    CONTINUE                                                                  
 46   GO TO (41,43), IDIR                                                       
 41   IXO=IXO+ISPACE*IXC                                                        
      IF (JACK - IXO) 42,42,10                                                  
 42   IXO=JXO                                                                   
      IYO=IYO-IYC*12                                                            
      IF(IYO+999)25,10,10                                                       
 43   IYO=IYO+ISPACE*IYC                                                        
      IF (JACK - IYO) 44,44,10                                                  
 44   IYO=JYO                                                                   
      IXO=IXO+IXC*12                                                            
      IF(IXO-9999)10,10,25                                                      
 10   CONTINUE                                                                  
 25   RETURN                                                                    
2000  FORMAT(5H0BCD O2,15H HAS NO SYMBOL.)                                      
2001  FORMAT(29H0IMPOSSIBLE ORIGIN FOR LABEL.)                                  
      END                                                               TITLE 71
$IBFTC SCALE   M94                                                              
      SUBROUTINE SCALE (MGX,MGY,XMAX,YMAX)                                      
C     A  DUMMY  ROUTINE.                                                        
      RETURN                                                                    
      END                                                                       
$IBFTC RAISE   M94                                                              
      SUBROUTINE RAISE                                                          
C     RAISE CAUSES PLOT2 TO RAISE THE PEN FOR THE NEXT POINT PLOTTED            
      CALL PLOT2 (1,0)                                                          
      RETURN                                                                    
      END                                                                       
$IBFTC STOP    M94                                                              
      SUBROUTINE STOP                                                           
      CALL PLOT6(7,500,500)                                                     
      RETURN                                                                    
      END                                                                       
$IBMAP UNPACK  15,M94                                                           
       ENTRY   UNPACK                                                           
       EVEN                                                                     
UNPACK SXA     AXT,1                                                            
       CLA     4,4                                                              
       ADD     =12                                                              
       STA     STO                                                              
       CAL*    3,4                                                              
       LGR     33                                                               
       AXT     12,1                                                             
 STO   STO     **,1                                                             
       ZAC                                                                      
       LGL     3                                                                
       TIX     STO,1,1                                                          
AXT    AXT     ,1                                                               
       TRA     5,4                                                              
       END                                                                      
$IBMAP EXPAN   15,M94                                                           
       ENTRY   EXPAN                                                            
EXPAN  SXA     AXT,1                                                            
       EVEN                                                                     
       CLA     4,4                                                              
       ADD     =6                                                               
       STA     STO                                                              
       CAL*    3,4                                                              
       LGR     30                                                               
       AXT     6,1                                                              
 STO   STO     **,1                                                             
       ZAC                                                                      
       LGL     6                                                                
       TIX     STO,1,1                                                          
AXT    AXT     ,1                                                               
       TRA     5,4                                                              
       END                                                                      
$IBMAP ENDUP   30                                                               
ENDUP  ENB     =0                                                               
       WEFB    2                                                                
       REWA    1                                                                
       REWB    2                                                                
 B     RTBB    2                                                                
       RCHB    A                                                                
       TCOB    *                                                                
       TEFB    DONE                                                             
       WTDB    4                                                                
       RCHB    A                                                                
       TRA     B                                                                
 DONE  REWB    2                                                                
       AXT     32700,1                                                          
       STZ     *,1                                                              
       TIX     *-1,1,1                                                          
       RTBA    1                                                                
       RCHA    F                                                                
       TCOA    *                                                                
       ZAC                                                                      
       SSM                                                                      
       STO*    30519                                                            
       TRA     1                                                                
       TRA     3,4                                                              
 A     IOCD    C,,14                                                            
 C     BSS     14                                                               
F      IOCP    0,,3                                                             
       TCH     0                                                                
       END                                                                      
