CEIG4  NYU MATH UTILITY  12/01/63  EIGENVALUES OF COMPLEX MATRICES      EIG40010
      SUBROUTINE EIG4(A,N,M,RT,Z)                                       EIG40020
I     DIMENSION A(70,70),RT(70),Z(1),TRACE(1),X(1),E(1)                 EIG40030
      DIMENSION INT(70)                                                 EIG40040
I     TRACE=A(1,1)                                                      EIG40050
      DO 10 I=2,N                                                       EIG40060
I10   TRACE=TRACE+A(I,I)                                                EIG40070
      WRITE OUTPUT TAPE 6,5,TRACE,TRACE(2)                              EIG40080
      CALL CXTRI(A,1.E-8,N,INT)                                         EIG40090
I     TRACE=A(1,1)                                                      EIG40100
      DO 11 I=2,N                                                       EIG40110
I11   TRACE=TRACE+A(I,I)                                                EIG40120
      WRITE OUTPUT TAPE 6,6,TRACE,TRACE(2)                              EIG40130
      NU=0                                                              EIG40140
      NV=0                                                              EIG40150
 13   IF(NV-N)14,12,14                                                  EIG40160
 14   NV=NV+1                                                           EIG40170
      NU=NV                                                             EIG40180
 16   IF(INT(NV))15,17,15                                               EIG40190
 15   NV=NV+1                                                           EIG40200
      GO TO 16                                                          EIG40210
 17   IF(NV-NU)19,18,19                                                 EIG40220
I18   RT(NU)=A(NU,NU)                                                   EIG40230
I     X=RT(NU)                                                          EIG40240
      WRITE OUTPUT TAPE 6,7,X,X(2)                                      EIG40250
      GO TO 13                                                          EIG40260
 19   IF(NV-NU-1)20,21,20                                               EIG40270
 20   NP=XMIN0F(M,NV)                                                   EIG40280
      CALL CXLAG(A,1.E-4,NP,NU,NV,RT,Z)                                 EIG40290
      GO TO 13                                                          EIG40300
I21   R=(.5,.0)*(A(NU,NU)+A(NV,NV))                                     EIG40310
I     E=R**2-A(NU,NU)*A(NV,NV)+A(NU,NV)*A(NV,NU)                        EIG40320
I     S=SQRTF(E)                                                        EIG40330
I     RT(NU)=R+S                                                        EIG40340
I     RT(NV)=R-S                                                        EIG40350
I     X=RT(NU)                                                          EIG40360
I     E=RT(NV)                                                          EIG40370
      WRITE OUTPUT TAPE 6,7,X,X(2),E,E(2)                               EIG40380
      GO TO 13                                                          EIG40390
I12   X=(.0,.0)                                                         EIG40400
      DO 24 J=1,M                                                       EIG40410
I24   X=X+RT(J)                                                         EIG40420
      WRITE OUTPUT TAPE 6,8,X,X(2)                                      EIG40430
      RETURN                                                            EIG40440
 5    FORMAT(1H030X,23HTRACE OF GIVEN MATRIX =E16.8,1H,E16.8)           EIG40450
 6    FORMAT(1H027X,26HTRACE OF HESSENBERG FORM =E16.8,1H,E16.8)        EIG40460
 7    FORMAT((11H0EIGENVALUE 12X,2E20.8))                               EIG40470
 8    FORMAT(1H033X,20HSUM OF EIGENVALUES =E16.8,1H,E16.8)              EIG40480
      END                                                               EIG40490
      SUBROUTINE CXTRI(A,EPS,N,INT)                                     EIG40500
I     DIMENSION A(70,70),C(1)                                           EIG40510
      DIMENSION INT(70)                                                 EIG40520
      N1=N-1                                                            EIG40530
      N2=N-2                                                            EIG40540
      DO 21 J=1,N1                                                      EIG40550
      J1=J+1                                                            EIG40560
      J2=J+2                                                            EIG40570
      L=J1                                                              EIG40580
      NJ1=N-J1                                                          EIG40590
I     C=A(J,J1)                                                         EIG40600
      S=ABSF(C)+ABSF(C(2))                                              EIG40610
      IF(NJ1)15,15,6                                                    EIG40620
 6    DO 12 K=J2,N                                                      EIG40630
I     C=A(J,K)                                                          EIG40640
      T=ABSF(C)+ABSF(C(2))                                              EIG40650
      IF(T-S)12,12,11                                                   EIG40660
 11   L=K                                                               EIG40670
      S=T                                                               EIG40680
 12   CONTINUE                                                          EIG40690
      IF(L-J1)13,15,13                                                  EIG40700
 13   DO 131 K=1,N                                                      EIG40710
I     C=A(K,J+1)                                                        EIG40720
I     A(K,J+1)=A(K,L)                                                   EIG40730
I131  A(K,L)=C                                                          EIG40740
 14   DO 141 K=1,N                                                      EIG40750
I     C=A(J+1,K)                                                        EIG40760
I     A(J+1,K)=A(L,K)                                                   EIG40770
I141  A(L,K)=C                                                          EIG40780
      R=0.                                                              EIG40790
 15   DO 151 K=1,J                                                      EIG40800
I     C=A(J,K)                                                          EIG40810
      T=ABSF(C)+ABSF(C(2))                                              EIG40820
 151  R=MAX1F(R,T)                                                      EIG40830
      IF(S-EPS*R)16,16,17                                               EIG40840
 16   L=0                                                               EIG40850
      NJ1=0                                                             EIG40860
      GO TO 181                                                         EIG40870
I17   C=A(J,J+1)                                                        EIG40880
      DO 18 K=J2,N                                                      EIG40890
I18   A(J,K)=A(J,K)/C                                                   EIG40900
 181  DO 20 I=1,N                                                       EIG40910
      M=MIN0F(J,I-2)                                                    EIG40920
I     U=(0.,0.)                                                         EIG40930
      IF(NJ1)19,19,7                                                    EIG40940
 7    DO 8 K=J2,N                                                       EIG40950
I8    U=U+A(K,I)*A(J,K)                                                 EIG40960
 19   IF(M)20,20,9                                                      EIG40970
 9    DO 10 K=1,M                                                       EIG40980
I10   U=U-A(K,I)*A(J+1,K+1)                                             EIG40990
I20   A(J+1,I)=A(J+1,I)+U                                               EIG41000
 21   INT(J)=L                                                          EIG41010
 22   INT(N)=0                                                          EIG41020
      RETURN                                                            EIG41030
       END                                                              EIG41040
      SUBROUTINE CXLAG(A,EPS,N1,NU,N,RT,Z)                              EIG41050
I     DIMENSION A(70,70),P(3,71),RT(70),S1(1),S2(1),R(1),Z(1),B1(1),B2(1EIG41060
I    1),B3(1),E(1),DELZ(1),F1(1),S(1),Q1(1)                             EIG41070
      WRITE OUTPUT TAPE 6,1                                             EIG41080
      BL1=1.                                                            EIG41090
      NUQ=NU-1                                                          EIG41100
      LLY=0                                                             EIG41110
      DELOLD=1.                                                         EIG41120
      ROLD=1.                                                           EIG41130
      SUM1=0.                                                           EIG41140
      SUM2=0.                                                           EIG41150
      CALL FPTEST(X)                                                    EIG41160
I     P(1,NU)=(1.,.0)                                                   EIG41170
I     P(2,NU)=(.0,.0)                                                   EIG41180
I     P(3,NU)=(.0,.0)                                                   EIG41190
      NU1=NU+1                                                          EIG41200
      CUP=0.                                                            EIG41210
      DO 11 J=NU1,N                                                     EIG41220
I     R=A(J-1,J)                                                        EIG41230
 11   CUP=CUP+ABSF(R)+ABSF(R(2))                                        EIG41240
      CUP=CUP/FLOATF(N-NU)                                              EIG41250
      CAP=0.                                                            EIG41260
C                                                                       EIG41270
C     FIND THE TRACE OF A AND A**2                                      EIG41280
C                                                                       EIG41290
I     SPUR1=A(NU,NU)                                                    EIG41300
I     SPUR2=SPUR1**2                                                    EIG41310
      DO 13 J=NU1,N                                                     EIG41320
I     T=A(J,J)                                                          EIG41330
I     SPUR1=SPUR1+T                                                     EIG41340
I13   SPUR2=SPUR2+T**2+(2.,0.)*A(J-1,J)*A(J,J-1)                        EIG41350
I     S1=-SPUR1                                                         EIG41360
I     S2=SPUR2                                                          EIG41370
C                                                                       EIG41380
C     INITIAL ITERATE (EITHER GIVEN OR FROM INFINITY)                   EIG41390
C                                                                       EIG41400
 131  IF(Z-1.E+35)23,14,14                                              EIG41410
 14   F1=N-NUQ                                                          EIG41420
      IF(ABSF(S1)+ABSF(S1(2))+ABSF(S2)+ABSF(S2(2))-1.E-6*CAP)15,15,16   EIG41430
 15   Z=CUP                                                             EIG41440
      GO TO 23                                                          EIG41450
I16   D=(F1-(1.,0.))*(F1*S2-S1**2)                                      EIG41460
I     Z=(SQRTF(D)-S1)/F1                                                EIG41470
C                                                                       EIG41480
C     EVALUATE POLYNOMIAL AND DERIVATIVES                               EIG41490
C                                                                       EIG41500
 23   P(1,NU)=1.0                                                       EIG41510
      IF (LLY+NUQ-NU) 24,24,235                                         EIG41520
 24   P(1,NU)=1.E-20                                                    EIG41530
 235  DO 33 K=NU,N                                                      EIG41540
I     T=-A(K,K+1)                                                       EIG41550
 25   DO 33 L=1,3                                                       EIG41560
      S=FLOATF(XMODF(L-1,3))                                            EIG41570
I     R=-(Z*P(L,K)+S*P(L-1,K))                                          EIG41580
      DO 28 J=NU,K                                                      EIG41590
I28   R=R+P(L,J)*A(K,J)                                                 EIG41600
      IF(X)29,34,29                                                     EIG41610
 29   X=0                                                               EIG41620
      P(1,NU)=P(1,NU)*1.E-15                                            EIG41630
      IF(P(1,NU))30,30,235                                              EIG41640
 30   F=.9*FLOATF(K-NU)/FLOATF(N-NU+1)                                  EIG41650
      WRITE OUTPUT TAPE 6,4,Z(1),Z(2)                                   EIG41660
I     Z=F*Z                                                             EIG41670
I     P(1,NU)=(1.,0.)                                                   EIG41680
      GO TO 235                                                         EIG41690
 34   IF (N-K) 31,31,32                                                 EIG41700
I31   P(L,K+1)=R                                                        EIG41710
      GO TO 33                                                          EIG41720
I32   P(L,K+1)=R/T                                                      EIG41730
 33   CONTINUE                                                          EIG41740
C                                                                       EIG41750
C     SCALE DOWN THESE VALUES IF REQUIRED TO AVOID OVERFLOW             EIG41760
C                                                                       EIG41770
I35   B1=P(1,N+1)                                                       EIG41780
I     B2=P(2,N+1)                                                       EIG41790
I     B3=P(3,N+1)                                                       EIG41800
      G1=ABSF(B1)+ABSF(B1(2))                                           EIG41810
      G2=ABSF(B2)+ABSF(B2(2))                                           EIG41820
      G3=ABSF(B3)+ABSF(B3(2))                                           EIG41830
      S=MAX1F(G1,G2)                                                    EIG41840
      S=MAX1F(S,G3)                                                     EIG41850
      IF(S-1.E+19)43,43,36                                              EIG41860
I36   B1=B1/(1.E+19,0.)                                                 EIG41870
I     B2=B2/(1.E+19,0.)                                                 EIG41880
      WRITE OUTPUT TAPE 6,2,Z(1),Z(2),G1,G2,G3                          EIG41890
I     B3=B3/(1.E+19,0.)                                                 EIG41900
C                                                                       EIG41910
C     REMOVE EFFECT OF KNOWN ROOTS FROM S1,S2 THE LOG DERIVATIVES       EIG41920
C                                                                       EIG41930
I43   Q1=(.0,.0)                                                        EIG41940
I     Q2=(.0,.0)                                                        EIG41950
      IF(NUQ-NU)19,21,21                                                EIG41960
 21   DO 44 J=NU,NUQ                                                    EIG41970
I     D=(1.,0.)/(RT(J)-Z)                                               EIG41980
I     Q1=Q1+D                                                           EIG41990
I44   Q2=Q2+D**2                                                        EIG42000
      IF (G1) 41,41,19                                                  EIG42010
I19   S1=Q1+B2/B1                                                       EIG42020
I     S2 = (B2/B1)**2 - B3/B1 - Q2                                      EIG42030
C                                                                       EIG42040
C     FIND NEXT ITERATE                                                 EIG42050
C                                                                       EIG42060
      LLY=LLY+1                                                         EIG42070
      IF(1.E+7-ZZ*(ABSF(S1)+ABSF(S1(2))))41,41,42                       EIG42080
 41   MARK=1                                                            EIG42090
      GO TO 100                                                         EIG42100
 42   G=N-NUQ                                                           EIG42110
 50   IF(BL1)65,65,66                                                   EIG42120
 65   H=.5*(G-2.)                                                       EIG42130
      GO TO 67                                                          EIG42140
 66   H=G-1.                                                            EIG42150
I67   D=H*(G*S2-S1**2)                                                  EIG42160
I     E=SQRTF(D)                                                        EIG42170
      IF(S1*E+S1(2)*E(2))55,56,56                                       EIG42180
I55   E=-E                                                              EIG42190
I56   DELZ=-G/(S1+E)                                                    EIG42200
I     Z=Z+DELZ                                                          EIG42210
      DELNEW=ABSF(DELZ)+ABSF(DELZ(2))                                   EIG42220
      RNEW=DELNEW/DELOLD                                                EIG42230
      ZZ=ABSF(Z)+ABSF(Z(2))                                             EIG42240
C                                                                       EIG42250
C     TEST FOR CYCLING AT 57 AND FOR LINEAR CONVERGENCE AT 571          EIG42260
C                                                                       EIG42270
      IF(LLY-3)62,62,57                                                 EIG42280
 57   IF(DELNEW-MAX1F(3.*DELOLD,.5*ZZ))571,571,570                      EIG42290
 570  IF(BL1)571,571,572                                                EIG42300
 572  DELOLD=CAP+1.0                                                    EIG42310
      ROLD=3.                                                           EIG42320
      IF(LLY-15)14,14,100                                               EIG42330
 571  IF(RNEW-.7*ROLD)62,58,58                                          EIG42340
 58   MARK=3                                                            EIG42350
      IF(DELNEW-.1*EPS*MAX1F(ZZ,.01*CAP)) 70,59,59                      EIG42360
 59   IF(BL1)61,61,60                                                   EIG42370
I60   Z=Z-DELZ                                                          EIG42380
      BL1=0.                                                            EIG42390
      GO TO 50                                                          EIG42400
 61   BL1=1.                                                            EIG42410
      GO TO 63                                                          EIG42420
C                                                                       EIG42430
C     TEST FOR AN EIGENVALUE                                            EIG42440
C                                                                       EIG42450
 62   IF(DELNEW-10.*EPS*MAX1F(ZZ,.001*CAP))64,64,63                     EIG42460
 63   DELOLD=DELNEW                                                     EIG42470
      ROLD=RNEW                                                         EIG42480
      IF(LLY-15)23,23,100                                               EIG42490
 64   MARK=2                                                            EIG42500
 70   BL1=1.                                                            EIG42510
C                                                                       EIG42520
C     WE ACCEPT Z AS A ROOT                                             EIG42530
C                                                                       EIG42540
 100  NUQ=NUQ+1                                                         EIG42550
I     RT(NUQ)=Z                                                         EIG42560
      WRITE OUTPUT TAPE 6,3,Z,Z(2),LLY,MARK                             EIG42570
      LLY=0                                                             EIG42580
      CAP=MAX1F(ZZ,CAP)                                                 EIG42590
      DELOLD=1.                                                         EIG42600
      ROLD=1.                                                           EIG42610
I     SUM1=SUM1+RT(NUQ)                                                 EIG42620
I     SUM2=SUM2+RT(NUQ)**2                                              EIG42630
I     S1=SUM1-SPUR1                                                     EIG42640
I     S2=SUM2-SPUR2                                                     EIG42650
      IF(NUQ-N1)84,101,101                                              EIG42660
C                                                                       EIG42670
C     A NEWTON STEP TOWARDS NEXT ROOT                                   EIG42680
C                                                                       EIG42690
 84   IF((ABSF(Q1)+ABSF(Q1(2)))*MAX1F(ZZ,.001*CAP)-1.E+4)86,86,14       EIG42700
I86   Z=Z-B2/((.5,.0)*B3-B2*Q1)                                         EIG42710
      GO TO 23                                                          EIG42720
 101  CALL FPOLD                                                        EIG42730
      RETURN                                                            EIG42740
 1    FORMAT(1H050X,19HLAGUERRE ITERATIONS//31X,9HREAL PART10X,10H IMAG.EIG42750
     1PART22X,1HP11X,7HP PRIME6X,11HP DBL PRIME)                        EIG42760
 2    FORMAT(8H ITERATE20X,E15.8,5X,E15.8,8X,3E15.4)                    EIG42770
 3    FORMAT(11H0EIGENVALUE12X,2E20.8,12X,I3,17H ITERATIONS,TEST I1//)  EIG42780
 4    FORMAT(8H ITERATE20X,2E20.8,12X,9H OVERFLOW)                      EIG42790
      END                                                               EIG42800
*NUFPT    NU VERSION OF FPT.  VERSION 2  MAY 1962.  HAS ALTERNATE ENTRIEEIG42810
*     FAP                                                               EIG42820
       PCC                                                              EIG42830
       COUNT   60                                                       EIG42840
       LBL     NUFPT,9                                                  EIG42850
       ENTRY   FPTEST                                                   EIG42860
       ENTRY   FPOLD                                                    EIG42870
       ENTRY   (FPT)                                                    EIG42880
FPTEST CLA     8                                                        EIG42890
       STO     NEW+1                   SAVE L(8)                        EIG42900
       STZ     OVFLOW                  CLEAR 77462                      EIG42910
       CLA     1,4                                                      EIG42920
       STA     NEW+2                   L(CONTENTS OF L(0))              EIG42930
       CLA     NEW                     L(TTR,(FPT))                     EIG42940
       STO     8                       MUST USE THIS (FPT)              EIG42950
       CLA     NEW+2                   L(STI,**)                        EIG42960
       STO     ERROR+1                 MODIFY(FPT) SO EXEM              EIG42970
       CLA     NEW+3                   DOES NOT ACT                     EIG42980
       STO     ERROR+2                                                  EIG42990
       TTR     2,4                                                      EIG43000
 (FPT) STI     IND           SAVE INDICATORS.                           EIG43010
       LDI     0             EXAMINE BITS 14-17 OF LOC ZERO             EIG43020
       LFT     4             SKIP IF NON'OVERFLOW (BIT 15)              EIG43030
       TTR     ERROR         (IN FPT + 3) OVERFLOW AC OR MQ             EIG43040
       LFT     2             SKIP IF ACC NOT INVOLVED                   EIG43050
       CLM                                                              EIG43060
       LNT     6             SKIP AND COMPLEMENT                        EIG43070
       COM                   ONCE ON ACC UNDRFLOW                       EIG43080
       COM                                                              EIG43090
       XCA                   GET MQ                                     EIG43100
       LFT     1             SKIP IF N= MQ NOT INVOLVED                 EIG43110
       CLM                                                              EIG43120
       LNT     5             COMPLEMEMT ONCE ON                         EIG43130
       COM                   MQ UNDERFLOW                               EIG43140
       COM                                                              EIG43150
       XCA                   RESTORE MQ AND ACC                         EIG43160
       LDI     IND           RESTORE INDICATORS.                        EIG43170
 EXIT  TTR*    0                                                        EIG43180
 ERROR STI     OVFLOW        77462                                      EIG43190
       LDI     *+2                                                      EIG43200
       TTR     $(EXE)                                                   EIG43210
       PZE     7,4,*+1                                                  EIG43220
       LDI     OVFLOW        RETURN FROM EXE IF NOT IN MONITOR MODE     EIG43230
       TTR     (FPT)+4                                                  EIG43240
 NEW   TTR     (FPT)                   CONSTANT                         EIG43250
       TTR     (FPT)                   SAVE ORIGINAL L(8) HERE          EIG43260
       STI     **                      CONSTANT-STA OF VARIABLE HERE    EIG43270
       TTR     ERROR+4                 CONST                            EIG43280
       LDI     ERROR+3                 CONST                            EIG43290
       TTR     $(EXE)                                                   EIG43300
 FPOLD CLA     NEW+4                   RESTORE EXEM AFFECT              EIG43310
       STO     ERROR+1                                                  EIG43320
       CLA     NEW+5                                                    EIG43330
       STO     ERROR+2                                                  EIG43340
       CLA     NEW+1                   RESTORE L(8)                     EIG43350
 SET   STO     8                                                        EIG43360
       STZ     OVFLOW                  CLEAR 77462                      EIG43370
       TRA     1,4                                                      EIG43380
       COMMON  -2                                                       EIG43390
 IND   COMMON  1                       77463                            EIG43400
OVFLOW COMMON  1                                                        EIG43410
       END                                                              EIG43420
