      SUBROUTINE PLOT1 (XMIN,XMAX1,YMIN,YMAX1,IC)                       PLOT1  1
C     SUBROUTINE PLOT1  FOR CONTROL AND INTIALIZATION OF PLOTTING ROUTINPLOT1  2
      XMAX=XMAX1                                                        PLOT1  3
      YMAX=YMAX1                                                        PLOT1  4
C     CHECK PLOTTING MODE                                               PLOT1  5
      IQ=2                                                              PLOT1  7
      IZ=1                                                              PLOT1  8
C     SET PEN CONTROL IN PLOT2                                          PLOT1  9
      GO TO (1,2), IC                                                   PLOT1 10
    1 Y=9.                                                              PLOT1 11
      GO TO 3                                                           PLOT1 12
    2 Y=8.                                                              PLOT1 13
    3 CALL PLOT2(1,IQ)                                                  PLOT1 14
      CALL PLOT2(X,Y)                                                   PLOT1 15
      GO TO (4,5), IZ                                                   PLOT1 16
    4 GO TO (28,6,11,12), IQ                                            PLOT1 17
    5 GO TO (28,6,27,26), IQ                                            PLOT1 18
    6 X=0.                                                              PLOT1 19
C     CHECK TO SEE IF GRAPH GRIDS HAVE BEEN ENTERED INTO PLOT5          PLOT1 20
      CALL PLOT5 (X,Y)                                                  PLOT1 21
      IF(X) 25,7,25                                                     PLOT1 22
    7 IQ=3                                                              PLOT1 23
      IF(XMAX-XMIN) 8,10,8                                              PLOT1 24
    8 X=9499./(XMAX-XMIN)                                               PLOT1 25
      IF(YMAX-YMIN) 9,10,9                                              PLOT1 26
    9 Y=9499./(YMAX-YMIN)                                               PLOT1 27
      W=X                                                               PLOT1 28
      Z=Y                                                               PLOT1 29
C     SET SCALE FACTORS IN PLOT2                                        PLOT1 30
      GO TO 3                                                           PLOT1 31
   10 WRITEOUTPUTTAPE6,200                                              PLOT1 32
      CALLPLOT2(1,5)                                                    PLOT1 33
      GO TO 29                                                          PLOT1 34
   11 X=500.-XMIN*X                                                     PLOT1 35
      Y=500.-YMIN*Y                                                     PLOT1 36
      CALLLABEL(W,Z,-1,X,Y,Y,Y)                                         PLOT1 37
      IQ=4                                                              PLOT1 38
C     SET TRANSLATION INFORMATION IN PLOT2                              PLOT1 39
      GO TO 3                                                           PLOT1 40
   12 IF(Y-500.) 19,13,13                                               PLOT1 41
   13 IF(9999.-Y) 19,14,14                                              PLOT1 42
   14 IND=0                                                             PLOT1 43
      IP=9                                                              PLOT1 44
      IX=500                                                            PLOT1 45
      IY=Y                                                              PLOT1 46
C     DRAW IN AXES                                                      PLOT1 47
   15 CALL PLOT6(IP,IX,IY)                                              PLOT1 48
      IND =IND + 1                                                      PLOT1 49
      GO TO (16,17,18,19,22,23,24,27), IND                              PLOT1 50
   16 IP=8                                                              PLOT1 51
      IX=3767                                                           PLOT1 52
      GO TO 15                                                          PLOT1 53
   17 IX=6933                                                           PLOT1 54
      GO TO 15                                                          PLOT1 55
   18 IX=9999                                                           PLOT1 56
      GO TO 15                                                          PLOT1 57
   19 IF(X-500.) 27,20,20                                               PLOT1 58
   20 IF(9999.-X) 27,21,21                                              PLOT1 59
   21 IND=4                                                             PLOT1 60
      IP=9                                                              PLOT1 61
      IX=X                                                              PLOT1 62
      IY=500                                                            PLOT1 63
      GO TO 15                                                          PLOT1 64
   22 IP=8                                                              PLOT1 65
      IY=3767                                                           PLOT1 66
      GO TO 15                                                          PLOT1 67
   23 IY=6933                                                           PLOT1 68
      GO TO 15                                                          PLOT1 69
   24 IY=9999                                                           PLOT1 70
      GO TO 15                                                          PLOT1 71
C                                                                       PLOT1 72
C     XMAX,YMAX HERE REPRESENT RAW MAX. VALUES, AND WILL NOT NECESSARILYPLOT1 73
C     CORRESPOND TO THE EXTREMA OF THE GRAPH                            PLOT1 74
   25 CALL SCALE (X,Y,XMAX,YMAX)                                        PLOT1 75
      IZ=2                                                              PLOT1 76
      IQ=4                                                              PLOT1 77
      GO TO 3                                                           PLOT1 78
   26 X=XMAX                                                            PLOT1 79
      Y=YMAX                                                            PLOT1 80
      IQ=3                                                              PLOT1 81
      GO TO 3                                                           PLOT1 82
C                                                                       PLOT1 83
C     CHECK PLOTTING MODE                                               PLOT1 84
   27 CALL PLOT4(0,IC)                                                  PLOT1 85
   28 CALL PLOT2 (1,1)                                                  PLOT1 86
   29 RETURN                                                            PLOT1 87
  200 FORMAT(68H1PLOT2 HAS NOT BEEN INTITALIZED.  CHECK ARGUMENTS SUPPLIPLOT1 88
     1ED TO PLOT1./1H1)                                                 PLOT1 89
      END                                                               PLOT1 90
      SUBROUTINE PLOT2     (X,Y)                                        PLOT2  1
      EQUIVALENCE (Z,L)                                                 PLOT2  2
       IQ=IQ                                                            PLOT2  3
      Z=X                                                               PLOT2  4
      IF(L-1) 1,10,1                                                    PLOT2  5
C                                                                       PLOT2  6
C     IQ      FUNCTION                                                  PLOT2  7
C      1  TRANSFORM CO-ORDINATES AND CONVERT TO INTEGERS                PLOT2  8
C      2  SET PEN CONTROL                                               PLOT2  9
C      3  SET SCALE FACTORS                                             PLOT2 10
C      4  SET ORIGIN INFORMATION                                        PLOT2 11
C                                                                       PLOT2 12
    1 GOTO(2,13,14,15,9),IQ                                             PLOT2 13
    2 IF(N) 12,12,3                                                     PLOT2 14
    3 IPEN=LINE                                                         PLOT2 15
    4 IF (X-XMAX) 5,5,16                                                PLOT2 16
    5 IF (X-XMIN) 16,6,6                                                PLOT2 17
    6 IF (Y-YMAX) 7,7,16                                                PLOT2 18
    7 IF (Y-YMIN) 16,8,8                                                PLOT2 19
    8 IX=X*XSCALE+XO                                                    PLOT2 20
      IY=Y*YSCALE+YO                                                    PLOT2 21
      CALL PLOT6 (IPEN,IX,IY)                                           PLOT2 22
    9 RETURN                                                            PLOT2 23
   10 IF(Y) 16,16,11                                                    PLOT2 24
   11 Z=Y                                                               PLOT2 25
      IQ=L                                                              PLOT2 26
      GO TO 9                                                           PLOT2 27
   12 N=1                                                               PLOT2 28
C     RAISE PEN FOR NEXT POINT                                          PLOT2 29
      IPEN=9                                                            PLOT2 30
      GO TO 4                                                           PLOT2 31
   13 LINE=Y                                                            PLOT2 32
      GO TO 9                                                           PLOT2 33
   14 XSCALE=X                                                          PLOT2 34
      YSCALE=Y                                                          PLOT2 35
      GO TO 9                                                           PLOT2 36
   15 XO=X                                                              PLOT2 37
      YO = Y                                                            PLOT2 38
      XMAX=(9999.-XO)/XSCALE                                            PLOT2 39
      YMAX=(9999.-YO)/YSCALE                                            PLOT2 40
      XMIN=(500.-XO)/XSCALE                                             PLOT2 41
      YMIN=(500.-YO)/YSCALE                                             PLOT2 42
   16 N=0                                                               PLOT2 43
      GO TO 9                                                           PLOT2 44
      END                                                               PLOT2 45
      SUBROUTINE PLOT3                                                  PLOT3  1
C     CAUSE THE LAST CARD TO BE PUNCHED                                 PLOT3  2
      CALL PLOT6 (-1,0,0)                                               PLOT3  3
      RETURN                                                            PLOT3  4
      END                                                               PLOT3  5
      SUBROUTINE PLOT4(IX,IY)                                           PLOT4  1
      IF(N)1,5,1                                                        PLOT4  2
    1 IF(IX)6,2,6                                                       PLOT4  3
    2 IF(IY-MODE)4,3,4                                                  PLOT4  4
    3 RETURN                                                            PLOT4  5
    4 MODE=IY                                                           PLOT4  6
C     CALL PLOT6(7,0,0) HERE ,IF DESIRE TO STOP PLOTTER ON MODE CHANGE .PLOT4  7
      GO TO 3                                                           PLOT4  8
    5 MODE=2                                                            PLOT4  9
      N=1                                                               PLOT4 10
      CALL PLOT6(0,4HPLOT,1)                                            PLOT4 11
C      SET ID INFO IN PLOT6 .                                           PLOT4 12
      GO TO 1                                                           PLOT4 13
    6 CALL PLOT6(0,IX,IY)                                               PLOT4 14
      GO TO 3                                                           PLOT4 15
      END                                                               PLOT4 16
      SUBROUTINE  PLOT5 (MGX,MGY)                                       PLOT5  1
C     IF PLOT5 IS GIVEN THE GRAPH GRIDS IT WILL SPEW THEM FORTH THE FIRSPLOT5  2
C     TIME IT IS CALLED WITH A 0 IN MGX.  IT WILL NOT DO THIS AGAIN UNLEPLOT5  3
C     IT IS PRIMED WITH NEW GRAPH GRIDS.                                PLOT5  4
      IF(MGX) 3,1,3                                                     PLOT5  6
    1 MGX=IX                                                            PLOT5  7
      MGY=IY                                                            PLOT5  8
      IX=0                                                              PLOT5  9
    2 RETURN                                                            PLOT5 10
    3 IX=MGX                                                            PLOT5 11
      IY=MGY                                                            PLOT5 12
      GO TO 2                                                           PLOT5 13
      END                                                               PLOT5 14
      SUBROUTINE PLOT6 (IPON,IXI,IYI)                                   PLOT6  1
C     SUBROUTINE PLOT 6  FOR  PUNCHING   FRANK  ENGEL III               PLOT6  2
      DIMENSION  IPEN(8), IX(8), IY(8)                                  PLOT6  3
      IF(IPON) 5,4,1                                                    PLOT6  4
    1 I = I + 1                                                         PLOT6  5
      IX(I)=IXI                                                         PLOT6  6
      IY(I)=IYI                                                         PLOT6  7
      IPEN(I)=IPON                                                      PLOT6  8
      IF(I-8) 3,2,2                                                     PLOT6  9
    2 PUNCH8,    (IPEN(J),IX(J),IY(J),J=1,8),NAME,NA                    PLOT6 11
      NA = NA+1                                                         PLOT6 12
      I=0                                                               PLOT6 13
    3 RETURN                                                            PLOT6 14
    4 I=0                                                               PLOT6 15
      NAME=IXI                                                          PLOT6 16
      NA=IYI                                                            PLOT6 17
      GO TO 3                                                           PLOT6 18
    5 IF(I) 3,3,6                                                       PLOT6 19
    6 KA=I+1                                                            PLOT6 20
      I=I                                                               PLOT6 21
      DO 7 J=KA,8                                                       PLOT6 22
       IPEN(J)=9                                                        PLOT6 23
      IX(J)=9999                                                        PLOT6 24
    7 IY(J)=9999                                                        PLOT6 25
      GO TO 2                                                           PLOT6 26
    8 FORMAT(8(I1,2I4),A5,I3)                                           PLOT6 27
      END                                                               PLOT6 28
      SUBROUTINE RAISE                                                  RAISE  1
C     RAISE CAUSES PLOT2 TO RAISE THE PEN FOR THE NEXT POINT PLOTTED    RAISE  2
      CALL PLOT2 (1,0)                                                  RAISE  3
      RETURN                                                            RAISE  4
      END                                                               RAISE  5
      SUBROUTINE STOP                                                   STOP   1
      CALL PLOT6(7,500,500)                                             STOP   2
      RETURN                                                            STOP   3
      END                                                               STOP   4
      SUBROUTINE LABEL(XS,YS,IDIR,XL,YL,N,WURD)                         LABEL  1
C  PRINTING  SUBROUTINE  FOR  DATA-PLOTTER  -  FRANK A. ENGEL  III      LABEL  2
      DIMENSION  WURD(1), IPEN(16), IA(12), INT(6)                      LABEL  3
      IF(IDIR)1,1,2                                                     LABEL  4
    1 XSCALE=XS                                                         LABEL  5
      YSCALE=YS                                                         LABEL  6
      XO=XL                                                             LABEL  7
      YO=YL                                                             LABEL  8
      GOTO43                                                            LABEL  9
    2 JXO=XS*XSCALE+XO                                                  LABEL 10
      JYO=YS*YSCALE+YO                                                  LABEL 11
      IXC=277.75/XL                                                     LABEL 12
      IYC=277.75/YL                                                     LABEL 13
      IXO=JXO                                                           LABEL 14
      IYO=JYO                                                           LABEL 15
      JACK=9999-10*IXC                                                  LABEL 16
      IF(JACK-IXO)4,3,3                                                 LABEL 17
    3 IF(JACK-IYO)4,5,5                                                 LABEL 18
    4 WRITEOUTPUTTAPE6,201                                              LABEL 19
      GOTO43                                                            LABEL 20
    5 CALLPLOT4(0,2)                                                    LABEL 21
      DO42LW=1,N                                                        LABEL 22
    6 CALL EXPAN(WURD(LW),INT)                                          LABEL 23
      IF (INT(1) - 63)  7,43,43                                         LABEL 24
C     BRING IN NEXT SIX CHARACTERS                                      LABEL 25
    7 DO 42  I = 1,6                                                    LABEL 26
      IF (INT(I) - 48)  11,10,8                                         LABEL 27
    8 IF(INT(I)-50)9,11,11                                              LABEL 28
    9 GOTO(39,41),IDIR                                                  LABEL 29
C     START  NEW  LINE                                                  LABEL 30
   10 ISPACE=7                                                          LABEL 31
      GOTO37                                                            LABEL 32
C     SPACE                                                             LABEL 33
   11 KAP = INT(I)                                                      LABEL 34
      IF(KAP)12,12,13                                                   LABEL 35
   12 KAP=38                                                            LABEL 36
   13 DO36MO=1,3                                                        LABEL 37
      CALL UNPACK(ALPHA(KAP,MO),IA)                                     LABEL 38
C     BRING  IN  NEW  CHARACTER                                         LABEL 39
      GO TO (14, 33, 35), MO                                            LABEL 40
   14 NS=8*IA(1)+IA(2)                                                  LABEL 41
      IF(NS-16)15,15,16                                                 LABEL 42
   15 IF(NS)16,16,17                                                    LABEL 43
   16 WRITEOUTPUTTAPE6,200,KAP                                          LABEL 44
      GOTO37                                                            LABEL 45
   17 DO 18  K = 1, NS                                                  LABEL 46
   18 IPEN(K) = 8                                                       LABEL 47
      JRC = IA(3)                                                       LABEL 48
C     DETERMINE  PEN  RAISE POSITIONS                                   LABEL 49
      IF (JRC - 1) 25,19,20                                             LABEL 50
   19 IPEN(10) = 9                                                      LABEL 51
      GO TO 25                                                          LABEL 52
   20 IF (JRC - 7) 22,21,24                                             LABEL 53
   21 IPEN(3) = 9                                                       LABEL 54
      IPEN(5) = 9                                                       LABEL 55
      GO TO 25                                                          LABEL 56
   22 IF (JRC - 2) 25,23,24                                             LABEL 57
   23 IPEN(11) = 9                                                      LABEL 58
      GO TO 25                                                          LABEL 59
   24 IPEN(JRC)= 9                                                      LABEL 60
   25 IPEN(1) = 9                                                       LABEL 61
      ISPACE=IA(4)                                                      LABEL 62
      N1 = 1                                                            LABEL 63
      KB=3                                                              LABEL 64
      IF (NS - 4)  27,27,26                                             LABEL 65
   26 N2 = 4                                                            LABEL 66
      IP = 2                                                            LABEL 67
      GO TO 28                                                          LABEL 68
   27 N2 = NS                                                           LABEL 69
      IP = 1                                                            LABEL 70
C                                                                       LABEL 71
   28 DO 32  K = N1,N2                                                  LABEL 72
      IPON=IPEN(K)                                                      LABEL 73
      KB=KB+2                                                           LABEL 74
      GO TO (29,30), IDIR                                               LABEL 75
   29 IX=IA(KB)*IXC+IXO                                                 LABEL 76
      IY=IA(KB+1)*IYC+IYO                                               LABEL 77
      GO TO 31                                                          LABEL 78
   30 IY=IA(KB)*IYC+IYO                                                 LABEL 79
      IX=IXO-IA(KB+1)*IXC                                               LABEL 80
   31 CALL PLOT6(IPON,IX,IY)                                            LABEL 81
   32 CONTINUE                                                          LABEL 82
      GO TO (37, 36), IP                                                LABEL 83
   33 KB=-1                                                             LABEL 84
      N1 = 5                                                            LABEL 85
      IF (NS - 10)  27,27,34                                            LABEL 86
   34 N2 = 10                                                           LABEL 87
      IP = 2                                                            LABEL 88
      GO TO 28                                                          LABEL 89
   35 KB=-1                                                             LABEL 90
      N1 = 11                                                           LABEL 91
      N2 = NS                                                           LABEL 92
      IP = 1                                                            LABEL 93
      GO TO 28                                                          LABEL 94
   36 CONTINUE                                                          LABEL 95
   37 GO TO (38,40), IDIR                                               LABEL 96
   38 IXO=IXO+ISPACE*IXC                                                LABEL 97
      IF (JACK - IXO) 39,39,42                                          LABEL 98
   39 IXO=JXO                                                           LABEL 99
      IYO=IYO-IYC*12                                                    LABEL100
      IF(IYO+999)43,42,42                                               LABEL101
   40 IYO=IYO+ISPACE*IYC                                                LABEL102
      IF (JACK - IYO) 41,41,42                                          LABEL103
   41 IYO=JYO                                                           LABEL104
      IXO=IXO+IXC*12                                                    LABEL105
      IF(IXO-9999)42,42,43                                              LABEL106
   42 CONTINUE                                                          LABEL107
   43 RETURN                                                            LABEL108
  200 FORMAT(5H0BCD I2,15H HAS NO SYMBOL.)                              LABEL109
  201 FORMAT(29H0IMPOSSIBLE ORIGIN FOR LABEL.)                          LABEL110
      END                                                               LABEL111
      SUBROUTINE SCALE (MGX,MGY,XMAX,YMAX)                              ZCALE  1
C     A  DUMMY  ROUTINE.                                                ZCALE  2
      RETURN                                                            ZCALE  3
      END                                                               ZCALE  4
*      FAP                                                                      
*      PLOTTING PACKAGE  SUBROUTINE UNPACK FOR LABEL.  FRANK ENGEL III          
       LBL     UNPACK                                                           
       COUNT   10                                                               
       ENTRY   UNPACK                                                           
       ENTRY   EXPAN                                                            
UNPACK SXD     *-2,4                                                            
       SXA     AXT,1                                                            
       CLA     2,4                                                              
       STA     STD                                                              
       CAL*    1,4                                                              
       LGR     15                                                               
       AXT     0,1                                                              
STD    STD     **,1                                                             
       ANA     =O777777                                                         
       LGL     3                                                                
       TXI     *+1,1,1                                                          
       TXL     STD,1,11                                                         
AXT    AXT     ,1                                                               
       TRA     3,4                                                              
EXPAN  SXD     UNPACK-2,4                                                       
       SXA     AXT,1                                                            
       CLA     2,4                                                              
       STA     STO                                                              
       CAL*    1,4                                                              
       LGR     12                                                               
       AXT     0,1                                                              
STO    STD     **,1                                                             
       ANA     =O777777                                                         
       LGL     6                                                                
       TXI     *+1,1,1                                                          
       TXL     STO,1,5                                                          
       TRA     AXT                                                              
       END                                                                      
*      FAP                                                                      
*      PLOTTING PACKAGE  SUBROUTINE ALPHA FOR LABEL  FRANK ENGEL III            
       LBL     ALPHA                                                            
       COUNT   60                                                               
       ENTRY   ALPHA                                                            
ALPHA  SXD     *-2,4                                                            
       LDQ*    2,4                                                              
       MPY     =62B18                                                           
       ALS     18                                                               
       ADD*    1,4                                                              
       PDC     ,4                                                               
       CLA     A-63,4                                                           
       LXD     ALPHA-2,4                                                        
       TRA     3,4                                                              
       TITLE                                                                    
