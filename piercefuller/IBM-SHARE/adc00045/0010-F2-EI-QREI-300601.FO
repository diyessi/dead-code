$IBFTC QRCN    LIST,DECK                                                QRCN0000
C       PROGRAM TO CALL QR TRANSFORMATION, MAXIMUM ITER IS 50.          QRCN0001
      SUBROUTINE QREIG(A,M,ROOTR,ROOTI,IPRNT)                           QRCN0002
      DIMENSION  A(100,100),       ROOTR(100), ROOTI(100)               QRCN0003
      N = M                                                             QRCN0004
      IF(IPRNT)  80,81,80                                               QRCN0005
 80   WRITE (6,104)                                                     QRCN0006
 81   ZERO = 0.0                                                        QRCN0007
      JJ=1                                                              QRCN0008
  177 XNN=0.0                                                           QRCN0009
      XN2=0.0                                                           QRCN0010
      AA = 0.0                                                          QRCN0011
      B = 0.0                                                           QRCN0012
      C = 0.0                                                           QRCN0013
      DD = 0.0                                                          QRCN0014
      R=0.0                                                             QRCN0015
      SIG=0.0                                                           QRCN0016
      ITER = 0                                                          QRCN0017
 17   IF(N-2)    13,14,12                                               QRCN0018
 13   IF(IPRNT)  82,83,82                                               QRCN0019
 82   WRITE (6,105)A(1,1)                                               QRCN0020
 83   ROOTR(1) = A(1,1)                                                 QRCN0021
      ROOTI(1) = 0.0                                                    QRCN0022
  1   RETURN                                                            QRCN0023
 14   JJ=-1                                                             QRCN0024
   12 X = (A(N-1,N-1) - A(N,N))**2                                      QRCN0025
      S = 4.0*A(N,N-1)*A(N-1,N)                                         QRCN0026
      ITER = ITER + 1                                                   QRCN0027
      IF(X .EQ. 0.0 .OR. ABS(S/X) .GT. 1.0E-8) GO TO 15                 QRCN0028
   16 IF(ABS(A(N-1,N-1))-ABS(A(N,N)))  32,32,31                         QRCN0029
   31 E = A(N-1,N-1)                                                    QRCN0030
      G = A(N,N)                                                        QRCN0031
      GO TO 33                                                          QRCN0032
   32 G = A(N-1,N-1)                                                    QRCN0033
      E = A(N,N)                                                        QRCN0034
   33 F = 0.                                                            QRCN0035
      H = 0.                                                            QRCN0036
      GO TO 24                                                          QRCN0037
   15 S = X + S                                                         QRCN0038
      X = A(N-1,N-1) + A(N,N)                                           QRCN0039
      IF(S)    18,19,19                                                 QRCN0040
 19   SQ=SQRT(S)                                                        QRCN0041
      F=0.0                                                             QRCN0042
      H=0.0                                                             QRCN0043
      IF (X) 21,21,22                                                   QRCN0044
 21   E=(X-SQ)/2.0                                                      QRCN0045
      G=(X+SQ)/2.0                                                      QRCN0046
      GO TO 24                                                          QRCN0047
 22   G=(X-SQ)/2.0                                                      QRCN0048
      E=(X+SQ)/2.0                                                      QRCN0049
      GO TO 24                                                          QRCN0050
   18 F = SQRT(-S)/2.0                                                  QRCN0051
      E=X/2.0                                                           QRCN0052
      G=E                                                               QRCN0053
      H=-F                                                              QRCN0054
 24   IF(JJ)  28,70,70                                                  QRCN0055
   70 D = 1.0E-10*(ABS(G) + F)                                          QRCN0056
      IF(ABS(A(N-1,N-2)) .GT. D)  GO TO 26                              QRCN0057
 28   IF(IPRNT)  84,85,84                                               QRCN0058
 84   WRITE (6,105)E,F, ITER                                            QRCN0059
      WRITE (6,105)G,H                                                  QRCN0060
 85   ROOTR(N) = E                                                      QRCN0061
      ROOTI(N) = F                                                      QRCN0062
      ROOTR(N-1) = G                                                    QRCN0063
      ROOTI(N-1) = H                                                    QRCN0064
      N=N-2                                                             QRCN0065
      IF(JJ)  1,177,177                                                 QRCN0066
   26 IF(ABS(A(N,N-1)) .GT. 1.0E-10*ABS(A(N,N)))  GO TO 50              QRCN0067
 29   IF(IPRNT)  86,87,86                                               QRCN0068
 86   WRITE (6,105)A(N,N), ZERO, ITER                                   QRCN0069
 87   ROOTR(N) = A(N,N)                                                 QRCN0070
      ROOTI(N) = 0.0                                                    QRCN0071
      N=N-1                                                             QRCN0072
      GO TO 177                                                         QRCN0073
 50   IF(ABS(ABS(XNN/A(N,N-1))-1.0)-1.0E-6)  63,63,62                   QRCN0074
 62   IF(ABS(ABS(XN2/A(N-1,N-2))-1.0)-1.0E-6)  63,63,700                QRCN0075
   63 VQ=ABS(A(N,N-1))-ABS(A(N-1,N-2))                                  QRCN0076
      IF (ITER-15) 53,164,64                                            QRCN0077
  164 IF(VQ) 165,165,166                                                QRCN0078
  165 R = A(N-1,N-2)**2                                                 QRCN0079
      SIG = 2.0*A(N-1,N-2)                                              QRCN0080
      GO TO 60                                                          QRCN0081
  166 R = A(N,N-1)**2                                                   QRCN0082
      SIG = 2.0*A(N,N-1)                                                QRCN0083
      GO TO 60                                                          QRCN0084
 64   IF(VQ)   67,67,66                                                 QRCN0085
 66   IF(IPRNT)  88,85,88                                               QRCN0086
 88   WRITE (6,107)A(N-1,N-2)                                           QRCN0087
      GO TO 84                                                          QRCN0088
 67   IF(IPRNT)  89,87,89                                               QRCN0089
 89   WRITE (6,107)A(N,N-1)                                             QRCN0090
      GO TO 86                                                          QRCN0091
  700 IF(ITER .GT. 50) GO TO 63                                         QRCN0092
      IF(ITER .GT. 5 ) GO TO 53                                         QRCN0093
  701 Z1=         ((E-AA)**2+(F-B)**2)/(E*E+F*F)                        QRCN0094
      Z2=      ((G-C)**2+(H-DD)**2)/(G*G+H*H)                           QRCN0095
      IF(Z1-0.25)  51,51,52                                             QRCN0096
 51   IF(Z2-0.25)   53,53,54                                            QRCN0097
 53   R=E*G-F*H                                                         QRCN0098
      SIG=E+G                                                           QRCN0099
      GO TO 60                                                          QRCN0100
 54   R=E*E                                                             QRCN0101
      SIG=E+E                                                           QRCN0102
      GO TO 60                                                          QRCN0103
 52   IF(Z2-0.25) 55,55,601                                             QRCN0104
 55   R=G*G                                                             QRCN0105
      SIG=G+G                                                           QRCN0106
      GO TO 60                                                          QRCN0107
  601 R = 0.0                                                           QRCN0108
      SIG = 0.0                                                         QRCN0109
 60   XNN=A(N,N-1)                                                      QRCN0110
      XN2=A(N-1,N-2)                                                    QRCN0111
      CALL QRT(A,N,R,SIG,D)                                             QRCN0112
      AA=E                                                              QRCN0113
      B=F                                                               QRCN0114
      C=G                                                               QRCN0115
      DD=H                                                              QRCN0116
      GO TO 12                                                          QRCN0117
 104  FORMAT(////1X, 9HREAL PART  6X  14HIMAGINARY PART, 26X            QRCN0118
     1  13HTAKEN AS ZERO 6X 4HITER //)                                  QRCN0119
 105  FORMAT(1X,E15.8,3X,E15.8, 42X I3)                                 QRCN0120
 107  FORMAT(56X  E13.8)                                                QRCN0121
       END                                                              QRCN0122
$IBFTC *QRT    LIST,DECK                                                *QRT0000
      SUBROUTINE QRT(A,N,R,SIG,D)                                       *QRT0001
      DIMENSION  A(100,100),PSI(2),G(3)                                 *QRT0002
      N1 = N - 1                                                        *QRT0003
      IA = N - 2                                                        *QRT0004
      IP = IA                                                           *QRT0005
      IF(N-3) 101,10,60                                                 *QRT0006
 60   DO 12 J = 3,N1                                                    *QRT0007
      J1 = N - J                                                        *QRT0008
      IF(ABS(A(J1+1,J1))-D)    10,10,11                                 *QRT0009
   11 DEN = A(J1+1,J1+1)*(A(J1+1,J1+1)-SIG)+A(J1+1,J1+2)*A(J1+2,J1+1)+R *QRT0010
      IF(DEN) 61,12,61                                                  *QRT0011
 61   IF(ABS(A(J1+1,J1)*A(J1+2,J1+1)*(ABS(A(J1+1,J1+1)+A(J1+2,J1+2)     *QRT0012
     1-SIG)+ABS(A(J1+3,J1+2)))/DEN)-D)  10,10,12                        *QRT0013
 12   IP=J1                                                             *QRT0014
 10   DO  14  J=1,IP                                                    *QRT0015
      J1=IP-J+1                                                         *QRT0016
      IF(ABS(A(J1+1,J1))-D)    13,13,14                                 *QRT0017
 14   IQ=J1                                                             *QRT0018
 13   DO  100  I=IP,N1                                                  *QRT0019
      IF(I-IP)   16,15,16                                               *QRT0020
 15   G(1)=A(IP,IP)*(A(IP,IP)-SIG)+A(IP,IP+1)*A(IP+1,IP)+R              *QRT0021
      G(2)=A(IP+1,IP)*(A(IP,IP)+A(IP+1,IP+1)-SIG)                       *QRT0022
      G(3)=A(IP+1,IP)*A(IP+2,IP+1)                                      *QRT0023
      A(IP+2,IP)=0.0                                                    *QRT0024
      GO TO 19                                                          *QRT0025
 16   G(1)=A(I,I-1)                                                     *QRT0026
      G(2)=A(I+1,I-1)                                                   *QRT0027
      IF(I-IA)   17,17,18                                               *QRT0028
 17   G(3)=A(I+2,I-1)                                                   *QRT0029
      GO TO 19                                                          *QRT0030
 18   G(3)=0.0                                                          *QRT0031
   19 XK = SIGN(SQRT(G(1)**2 + G(2)**2 + G(3)**2), G(1))                *QRT0032
 22   IF(XK)   23,24,23                                                 *QRT0033
 23   AL=G(1)/XK+1.0                                                    *QRT0034
      PSI(1)=G(2)/(G(1)+XK)                                             *QRT0035
      PSI(2)=G(3)/(G(1)+XK)                                             *QRT0036
      GO TO 25                                                          *QRT0037
 24   AL=2.0                                                            *QRT0038
      PSI(1)=0.0                                                        *QRT0039
      PSI(2)=0.0                                                        *QRT0040
 25   IF(I-IQ)   26,27,26                                               *QRT0041
 26   IF(I-IP)    29,28,29                                              *QRT0042
 28   A(I,I-1)=-A(I,I-1)                                                *QRT0043
      GO TO 27                                                          *QRT0044
 29   A(I,I-1)=-XK                                                      *QRT0045
 27   DO 30  J=I,N                                                      *QRT0046
      IF(I-IA)  31,31,32                                                *QRT0047
 31   C=PSI(2)*A(I+2,J)                                                 *QRT0048
      GO TO 33                                                          *QRT0049
 32   C=0.0                                                             *QRT0050
 33   E=AL*(A(I,J)+PSI(1)*A(I+1,J)+C)                                   *QRT0051
      A(I,J)=A(I,J)-E                                                   *QRT0052
      A(I+1,J)=A(I+1,J)-PSI(1)*E                                        *QRT0053
      IF(I-IA)   34,34,30                                               *QRT0054
 34   A(I+2,J)=A(I+2,J)-PSI(2)*E                                        *QRT0055
 30   CONTINUE                                                          *QRT0056
      IF(I-IA)   35,35,36                                               *QRT0057
 35   L=I+2                                                             *QRT0058
      GO TO  37                                                         *QRT0059
 36   L=N                                                               *QRT0060
 37   DO  40  J=IQ,L                                                    *QRT0061
      IF(I-IA)  38,38,39                                                *QRT0062
 38   C=PSI(2)*A(J,I+2)                                                 *QRT0063
      GO TO  41                                                         *QRT0064
 39   C=0.0                                                             *QRT0065
 41   E=AL*(A(J,I)+PSI(1)*A(J,I+1)+C)                                   *QRT0066
      A(J,I)=A(J,I)-E                                                   *QRT0067
      A(J,I+1)=A(J,I+1)-PSI(1)*E                                        *QRT0068
      IF(I-IA)  42,42,40                                                *QRT0069
 42   A(J,I+2)=A(J,I+2)-PSI(2)*E                                        *QRT0070
 40   CONTINUE                                                          *QRT0071
      IF(I-N+3)   43,43,100                                             *QRT0072
 43   E=AL*PSI(2)*A(I+3,I+2)                                            *QRT0073
      A(I+3,I)=-E                                                       *QRT0074
      A(I+3,I+1)=-PSI(1)*E                                              *QRT0075
      A(I+3,I+2)=A(I+3,I+2)-PSI(2)*E                                    *QRT0076
 100  CONTINUE                                                          *QRT0077
 101  RETURN                                                            *QRT0078
       END                                                              *QRT0079
$IBFTC HESS    LIST,DECK                                                HESS0000
C     SUBROUTINE TO PUT MATRIX IN UPPER HESSENBERG FORM.                HESS0001
      SUBROUTINE HESSEN(A,M)                                            HESS0002
      DIMENSION A(100,100), B(99)                                       HESS0003
      DOUBLE PRECISION SUM                                              HESS0004
      IF (M - 2) 30,30,32                                               HESS0005
   32 DO 40 LC = 3,M                                                    HESS0006
      N = M - LC + 3                                                    HESS0007
      N1 = N - 1                                                        HESS0008
      N2 = N - 2                                                        HESS0009
      NI = N1                                                           HESS0010
      DIV = ABS(A(N,N-1))                                               HESS0011
      DO 2 J = 1,N2                                                     HESS0012
      IF(ABS(A(N,J))- DIV) 2,2,1                                        HESS0013
    1 NI = J                                                            HESS0014
      DIV = ABS(A(N,J))                                                 HESS0015
    2 CONTINUE                                                          HESS0016
      IF(DIV) 3,40,3                                                    HESS0017
    3 IF(NI - N1) 4, 7,4                                                HESS0018
    4 DO 5 J = 1,N                                                      HESS0019
      DIV = A(J,NI)                                                     HESS0020
      A(J,NI) = A(J,N1)                                                 HESS0021
    5 A(J,N1) = DIV                                                     HESS0022
      DO 6 J = 1,M                                                      HESS0023
      DIV = A(NI,J)                                                     HESS0024
      A(NI,J) = A(N1,J)                                                 HESS0025
    6 A(N1,J) = DIV                                                     HESS0026
    7 DO 26 K = 1, N1                                                   HESS0027
   26 B(K) = A(N,K)/A(N,N-1)                                            HESS0028
      DO 45 J = 1,M                                                     HESS0029
      SUM = 0.0                                                         HESS0030
      IF (J - N1) 46,43,43                                              HESS0031
   46 IF(B(J))  41,43,41                                                HESS0032
   41 A(N,J) = 0.0                                                      HESS0033
      DO 42 K = 1,N1                                                    HESS0034
      A(K,J) = A(K,J) - A(K,N1)*B(J)                                    HESS0035
   42 SUM = SUM + A(K,J)*B(K)                                           HESS0036
      GO TO 45                                                          HESS0037
   43 DO 44 K = 1,N1                                                    HESS0038
   44 SUM = SUM + A(K,J)*B(K)                                           HESS0039
   45 A(N1,J) = SUM                                                     HESS0040
   40 CONTINUE                                                          HESS0041
   30 RETURN                                                            HESS0042
       END                                                              HESS0043
