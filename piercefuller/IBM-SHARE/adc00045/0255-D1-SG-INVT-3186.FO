       STA     COEF1           COEFFICIENTS                             SGINV457
       CLA     HOLD2                                                    SGINV458
       STA     COEF2                                                    SGINV459
       TRA     ON              COMPUTE PHI2 USING -Y(J)                 SGINV460
 EXIT  AXT     1,2             INITIALIZE INDEX REGISTER 2              SGINV461
 SIGMA CLA     PHI1,2                                                   SGINV462
       FAD     PHI2,2                                                   SGINV463
       STO     PHISUM+1,2      PHI=PHI1+PHI2                            SGINV464
       TXI     *+1,2,1                                                  SGINV465
SUMPHI TXL     SIGMA,2,**      COMPUTE PHI ARRAY                        SGINV466
       CLA     POON            BEGIN RESETTING                          SGINV467
       STO     NOOP                                                     SGINV468
       CLA     ZERO                                                     SGINV469
       STO     TEST1                                                    SGINV470
       STO     TEST2                                                    SGINV471
       CLA     PHIONE                                                   SGINV472
       STO     NEWPHI                                                   SGINV473
       CLA     NUMS                                                     SGINV474
       STA     FUNC                                                     SGINV475
       STA     FUNC1                                                    SGINV476
       STA     COEF2+1                                                  SGINV477
       CLA     PLUARG                                                   SGINV478
       STO     FUNCT                                                    SGINV479
       CLA     PLUPHI                                                   SGINV480
       STO     MULTY           END RESETTING                            SGINV481
INDEX1 AXT     **,1                                                     SGINV482
INDEX2 AXT     **,2            RESTORE INDEX REGISTERS                  SGINV483
INDEX4 AXT     **,4                                                     SGINV484
       TRA     1,4                                                      SGINV485
 P(X)  PZE     **                                                       SGINV486
 Q(X)  PZE     **                                                       SGINV487
MINPHI FMP     L,2                                                      SGINV488
PLUPHI FMP     K,2                                                      SGINV489
PHIONE STQ     PHI1,2                                                   SGINV490
PHITWO STQ     PHI2,2                                                   SGINV491
MINARG STO     L,1                                                      SGINV492
PLUARG STO     K,1                                                      SGINV493
 MINAC SSM                                                              SGINV494
 POON  NOP                                                              SGINV495
 ZERO  DEC     0                                                        SGINV496
 TEST1 PZE     0                                                        SGINV497
 TEST2 PZE     0                                                        SGINV498
 NUMS  PZE     PX                                                       SGINV499
 DENS  PZE     QX                                                       SGINV500
 HALF  DEC     .5                                                       SGINV501
 HOLD1 BSS     1                                                        SGINV502
 HOLD2 BSS     1                                                        SGINV503
SMALLN BSS     1                                                        SGINV504
 PIDT  BSS     1                                                        SGINV505
 T     BSS     1                                                        SGINV506
 K     BES     40                                                       SGINV507
 L     BES     40                                                       SGINV508
 PHI1  BES     40                                                       SGINV509
 PHI2  BES     40                                                       SGINV510
 PX    BES     40                                                       SGINV511
 QX    BES     40                                                       SGINV512
PHISUM BES     40                                                       SGINV513
       BSS     1                                                        SGINV514
 FX1   SYN     FXONE                                                    SGINV515
*      THE FOLLOWING SUBROUTINE SUMS THE SERIES FN(T), N=0,...,INFINITY SGINV516
*      BY TAKING THE PARTIAL SUMS, FA(T), A=0,...,N...N=0,...,INFINITY  SGINV517
*      SOTHAT CONVERGENCE OCCURS AT SOME N. THE REAL-TIME SOLUTION IS   SGINV518
*      THEN F(T)=PI/T(FN(T))                                            SGINV519
INVERT SXA     IR1,1           SAVE INDEX REGISTERS                     SGINV520
       SXA     IR2,2                                                    SGINV521
       SXA     IR4,4                                                    SGINV522
       SXA     REG1,1                                                   SGINV523
       SXA     REG2,2                                                   SGINV524
       SXA     REG4,4                                                   SGINV525
       CLA     FIXN            SMALLN                                   SGINV526
       ANA     DECONE          TEST FOR ODD N                           SGINV527
       TZE     *+3             TRANSFER IF N EVEN                       SGINV528
       CLA     NEG                                                      SGINV529
       STO     NEGSNX          -SN(X)                                   SGINV530
STOREP CLA     **              TOL                                      SGINV531
       STO     EPSILN                                                   SGINV532
       AXT     0,1             INITIALIZE INDEX REGISTER 1, J=0         SGINV533
 GO1   CLA     ARG,1           Y(J)*PI                                  SGINV534
       TSX     $COS,4          COS(PIY(J))                              SGINV535
       STO     COSARG                                                   SGINV536
       CLA     X,1             WEIGHT(J)                                SGINV537
       FDP     COSARG          WEIGHT(J)/COS(PIY(J))                    SGINV538
       FMP     PHISUM,1        PHISUM(J)                                SGINV539
       STO     SX,1            S(X)=W(J)*PHISUM(J)/COS(PIY(J))          SGINV540
       TXI     *+1,1,1                                                  SGINV541
 TESTG TXL     GO1,1,**                                                 SGINV542
       AXT     0,1                                                      SGINV543
       ZAC                                                              SGINV544
SUMSX  FAD     SX,1            SX-1,I=1,...,N-1                         SGINV545
       TXI     *+1,1,1                                                  SGINV546
       TXL     *-2,1,**                                                 SGINV547
       XCA                                                              SGINV548
NEGSNX FMP     PLUS1           PLUS OR MINUS SN(X)                      SGINV549
       STO     SNX                                                      SGINV550
       CLA     POS             RESTORE SIGN                             SGINV551
       STO     NEGSNX                                                   SGINV552
       CLA     COTEST                                                   SGINV553
       TNZ     PATCH                                                    SGINV554
       CLA     FIXN                                                     SGINV555
       TNZ     PROCD           IS SUBN EQUAL TO ZERO                    SGINV556
 CONE  CLA     SNX             S(X) FOR SUBN=0                          SGINV557
       STO     ALPHA           S(X) FOR SUBN=0                          SGINV558
 ADDM  CLA     FIXN                                                     SGINV559
       ADD     DECONE                                                   SGINV560
       CAS     MAXITE          HAS THE MAXIMUM NUMBER OF ITERATIONS BEENSGINV561
       TRA     MOM             REACHED...IF SO,GO TO MOM                SGINV562
       TRA     MOM                                                      SGINV563
       STD     FIXN                                                     SGINV564
 REG1  AXT     **,1                                                     SGINV565
 REG2  AXT     **,2                                                     SGINV566
 REG4  AXT     **,4                                                     SGINV567
       TRA     1,4                                                      SGINV568
 PROCD CLA     ALPHA                                                    SGINV569
       FAD     SNX                                                      SGINV570
       STO     SUM             SUM=ALPHA+S(SUBN)                        SGINV571
       AXT     0,1                                                      SGINV572
 EVAL  CLA     SUM                                                      SGINV573
       FAD     ALPHA,1                                                  SGINV574
       XCA                                                              SGINV575
       FMP     PT5             AVG=1/2(SUM+ALPHA(J-1))                  SGINV576
       STO     AVG                                                      SGINV577
 TSNEJ PXD     ,1                                                       SGINV578
       CAS     FIXNM1                                                   SGINV579
       TRA     CONTIN          NO,CONTINUE                              SGINV580
       TRA     CHKTOL          YES,CHECK TO SEE IF ALPHA IS WITHIN TOL  SGINV581
CONTIN CLA     SUM                                                      SGINV582
       STO     ALPHA,1                                                  SGINV583
       CLA     AVG                                                      SGINV584
       STO     SUM                                                      SGINV585
       TXI     EVAL+1,1,1                                               SGINV586
CHKTOL CLA     ALPHA,1         IS ALPHA(J-1)-T) LESS THAN TOLERANCE     SGINV587
       FSB     AVG                                                      SGINV588
       FDP     AVG                                                      SGINV589
       XCA                                                              SGINV590
       SSP                                                              SGINV591
       STO     DIFF                                                     SGINV592
       CAS     EPSILN                                                   SGINV593
       TRA     REITER                                                   SGINV594
       TRA     REITER                                                   SGINV595
       TRA     CONVGD          CONVERGENCE OF THE SERIES HAS OCCURRED   SGINV596
REITER CLA     SUM                                                      SGINV597
       STO     ALPHA,1                                                  SGINV598
       CLA     AVG                                                      SGINV599
       STO     ALPHA-1,1                                                SGINV600
       CLA     FIXNM1                                                   SGINV601
       ADD     DECONE                                                   SGINV602
       STD     FIXNM1                                                   SGINV603
       TXI     ADDM,1,1                                                 SGINV604
CONVGD CLA     FL2             2.                                       SGINV605
       SXA     TTEST,1                                                  SGINV606
       LXA     TCNT,1                                                   SGINV607
 DIVT  FDP     **,1            2/T                                      SGINV608
       FMP     AVG             (2/T)(S(T))                              SGINV609
 F(T)  STO     **,1            F(T)=2/T(S(T))                           SGINV610
       CLA     COTEST                                                   SGINV611
       TZE     STOREA-1                                                 SGINV612
 ACE1  CLA     **,1                                                     SGINV613
       FAD     CZERO                                                    SGINV614
 ACE2  STO     **,1                                                     SGINV615
* TEST TO SEE IF RE(S) HAS BEEN TRANSLATED BECAUSE OF A SINGULARITY IN  SGINV616
* RE(S) GREATER THAN ZERO. THEN F(S+A)=INV(F(T))*EXP(-AT)               SGINV617
       LXA     IR4,4                                                    SGINV618
STOREA CLA     **              A                                        SGINV619
       TZE     TTEST           NO TRANSLATION IN RE(S)                  SGINV620
       XCA                                                              SGINV621
MULTYT FMP     **,1            AT                                       SGINV622
       SXA     SVR43,4                                                  SGINV623
       TSX     $EXP,4          EXP(AT)                                  SGINV624
       XCA                                                              SGINV625
 FTEAT FMP     **,1            F(T)*EXP(AT)                             SGINV626
       STO     **,1                                                     SGINV627
 SVR43 AXT     **,4                                                     SGINV628
 TTEST AXT     **,1                                                     SGINV629
       CLA     TCNT                                                     SGINV630
       ADD     FIX1                                                     SGINV631
       STO     TCNT            TCNT=TCNT+1                              SGINV632
       CAS     NUMTS           HAS F(T) BEEN EVALUATED FOR ALL T        SGINV633
       TRA     IR1             YES,TRANSFER BACK TO MAIN PROGRAM        SGINV634
       TRA     IR1             YES,TRANSFER BACK TO MAIN PROGRAM        SGINV635
       CLA     NAUGHT          NO,EVALUATE F(T) FOR ANOTHER VALUE OF T  SGINV636
       STO     FIXN            RESET SMALLN TO ZERO                     SGINV637
       STO     FIXNM1                                                   SGINV638
       TRA     REG1            GO BACK TO SUBROUTINE PHI FOR NEW F(T)   SGINV639
 IR1   AXT     **,1            RESTORE INDEX REGISTERS                  SGINV640
 IR2   AXT     **,2                                                     SGINV641
 IR4   AXT     **,4                                                     SGINV642
       TRA     2,4             RETURN TO MAIN PROGRAM                   SGINV643
COSARG BSS     1                                                        SGINV644
 POS   FMP     PLUS1                                                    SGINV645
 NEG   FMP     MINUS1                                                   SGINV646
 PLUS1 DEC     1.                                                       SGINV647
MINUS1 DEC     -1.                                                      SGINV648
MAXITE OCT     000100000000    MAXIMUM NUMBER OF ITERATIONS             SGINV649
 DOS   OCT     000002000000                                             SGINV650
 FL2   DEC     2.                                                       SGINV651
DECONE OCT     000001000000                                             SGINV652
 SNX   BSS     1                                                        SGINV653
 ALPHA BES     300                                                      SGINV654
       BSS     1                                                        SGINV655
 SUM   BSS     1                                                        SGINV656
 CZERO BSS     1             C(0)                                       SGINV657
 AVG   BSS     1                                                        SGINV658
ANSWER BSS     1                                                        SGINV659
EPSILN BSS     1                                                        SGINV660
 DIFF  BSS     1                                                        SGINV661
 SX    BES     40                                                       SGINV662
       BSS     1                                                        SGINV663
 NUMTS BSS     1                                                        SGINV664
FLOATN SYN     NFLOAT                                                   SGINV665
NAUGHT SYN     ZERO                                                     SGINV666
 FIX1  SYN     FX1                                                      SGINV667
 PT5   SYN     HALF                                                     SGINV668
 PATCH CLA     FIXN                                                     SGINV669
       TNZ     ROMP                                                     SGINV670
       LXA     TCNT,1                                                   SGINV671
       CLA     SNX                                                      SGINV672
 MORET FDP     **,1            SXN/T                                    SGINV673
       STQ     CZERO                                                    SGINV674
       TRA     ADDM                                                     SGINV675
 ROMP  CAS     DECONE                                                   SGINV676
       TRA     PROCD                                                    SGINV677
       TRA     CONE                                                     SGINV678
       TRA     CONE                                                     SGINV679
 MOM   CLA     DOS             THE MAXIMUM NUMBER                       SGINV680
       STD*    DAD             OF ITERATIONS HAS BEEN REACHED...        SGINV681
       TRA     RSTOR4          CONVERGENCE IS IMPOSSIBLE...SET FLAG     SGINV682
       END                                                              SGINV683
C     MATS SOLVES THE SET OF N SIMULTANEOUS EQUATIONS BY GAUSSIAN       SGMATS00
C     ELIMINATION                                                       SGMATS01
C     A IS THE AUGMENTED MATRIX OF INDEPENDENT AND DEPENDENT VARIABLES  SGMATS02
C     X IS THE COLUMN MATRIX WITH THE SOLUTION                          SGMATS03
C     N IS THE NUMBER OF SIMULTANEOUS EQUATIONS                         SGMATS04
C     M IS THE NUMBER OF COLUMNS OF DEPENDENT VARIABLES                 SGMATS05
C     THIS SUBROUTINE IS DIMENSIONED FOR A MAXIMUM OF 40 EQUATIONS      SGMATS06
      SUBROUTINE MATS(A,X,N,M)                                          SGMATS07
      DIMENSION A(40,40),X(40)                                          SGMATS08
      IF(1-N) 99,69,69                                                  SGMATS09
   69 X(1)=A(1,2)/A(1,1)                                                SGMATS10
      GO TO 999                                                         SGMATS11
   99 MM=N+M                                                            SGMATS12
      DO 15 I=2,N                                                       SGMATS13
   70 II=I-1                                                            SGMATS14
    7 DO 15 J=1,II                                                      SGMATS15
    8 IF (A(I,J))9,15,9                                                 SGMATS16
    9 IF (ABSF(A(J,J))-ABSF(A(I,J)))11,10,10                            SGMATS17
   10 R=A(I,J)/A(J,J)                                                   SGMATS18
      GO TO 130                                                         SGMATS19
   11 R=A(J,J)/A(I,J)                                                   SGMATS20
      DO 12 K=1,MM                                                      SGMATS21
      B=A(J,K)                                                          SGMATS22
      A(J,K)=A(I,K)                                                     SGMATS23
   12 A(I,K)=B                                                          SGMATS24
  130 JJ=J+1                                                            SGMATS25
   13 DO 14 K=JJ,MM                                                     SGMATS26
   14 A(I,K)=A(I,K)-R*A(J,K)                                            SGMATS27
   15 CONTINUE                                                          SGMATS28
      IF(ABSF(A(N,N))-1.0E-10) 16,16,17                                 SGMATS29
   16 PRINT 200                                                         SGMATS30
      WRITE OUTPUT TAPE 6,200                                           SGMATS31
  200 FORMAT(35H SINGULAR MATRIX IN SUBROUTINE MATS)                    SGMATS32
      CALL EXIT                                                         SGMATS33
   17 DO 28 J=1,M                                                       SGMATS34
      KK=N+J                                                            SGMATS35
      X(N)=A(N,KK)/A(N,N)                                               SGMATS36
      DO 28 I = 2,N                                                     SGMATS37
      JJ=N-I+1                                                          SGMATS38
      B=0.                                                              SGMATS39
      II=N-I+2                                                          SGMATS40
      DO 25 K=II,N                                                      SGMATS41
   25 B=B+A(JJ,K)*X(K)                                                  SGMATS42
      IF (ABSF(A(JJ,JJ))-1.0E-10) 16,16,28                              SGMATS43
   28 X(JJ)=(A(JJ,KK)-B)/A(JJ,JJ)                                       SGMATS44
  999 RETURN                                                            SGMATS45
      END                                                               SGMATS46
