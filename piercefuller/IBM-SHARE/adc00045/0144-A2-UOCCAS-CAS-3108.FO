*      FAP                                                                      
       LBL     CAS                                                      CAS00000
       COUNT   100                                                      CAS00001
*      U. OF CHICAGO COMPLEX ARITHMETIC SUBROUTINE                      CAS00002
       SPACE                                                            CAS00003
*      CALLING SEQUENCE IS                                              CAS00004
*              LOCATION 2 IS INITIALIZED BY                             CAS00005
*                      CAL     $(IFMP)  OR  $(IFDP)                     CAS00006
*                      SLW     2                                        CAS00007
*              AND REMAINS SO UNTIL A DIFFERENT OPERATION IS REQUIRED   CAS00008
       SPACE                                                            CAS00009
*              EACH USAGE IS CALLED BY                                  CAS00010
*                      STR     ADD1,T   (REAL PART)                     CAS00011
*                      PZE     ADD2,T   (IMAG. PART)                    CAS00012
*      IN USING (IFMP), THE MULTIPLICAND IS LOCATED IN CELLS -4 AND -3, CAS00013
*      (REAL PART IN -3) AND THE MULTIPLIER IS LOCATED IN CELLS ADD1,T  CAS00014
*      (REAL PART) AND ADD2,T.  IN USING (IFDP), THE DIVIDEND IS LOCATEDCAS00015
*      IN CELLS -2 AND -1 (REAL PART)  AND THE DIVISOR IS LOCATED IN    CAS00016
*      CELLS ADD1,T (REAL PART) AND ADD2,T.                             CAS00017
       SPACE                                                            CAS00018
       ENTRY   (IFMP)                                                   CAS00019
       ENTRY   (IFDP)                                                   CAS00020
       SPACE                                                            CAS00021
(IFMP) CAL     0             OBTAIN REFERENCE ADDRESSES OF MULTIPLIER   CAS00022
       STA     IARG2                                                    CAS00023
       SUB     C1              (A+IB)*(C+ID)=AC-BD+I(AD+BC)             CAS00024
       STA     RARG2                                                    CAS00025
       ADD     C2                                                       CAS00026
       STA     MEXIT                                                    CAS00027
 IARG2 LDQ*    **            D                                          CAS00028
       FMP     -4            B                                          CAS00029
       STO     BUFF                                                     CAS00030
 RARG2 LDQ*    **            C                                          CAS00031
       FMP     -3            A                                          CAS00032
       FSB     BUFF                                                     CAS00033
       STO     -1            AC-BD                                      CAS00034
       XEC     IARG2         D                                          CAS00035
       FMP     -3            A                                          CAS00036
       STO     BUFF                                                     CAS00037
       XEC     RARG2         C                                          CAS00038
       FMP     -4            B                                          CAS00039
       FAD     BUFF                                                     CAS00040
       STO     -2            AD+BC                                      CAS00041
 MEXIT TRA     **                                                       CAS00042
       SPACE                                                            CAS00043
(IFDP) CAL     0             OBTAIN REFERENCE ADDRESSES OF DIVISOR      CAS00044
       STA     IDIVR                                                    CAS00045
       SUB     C1                                                       CAS00046
       STA     RDIVR           (A+IB)/(C+ID)=(AC+BD+I(BC-AD))/(CC+DD)   CAS00047
       ADD     C2                                                       CAS00048
       STA     DEXIT                                                    CAS00049
       DLD     -2                                                       CAS00050
       DST     B             B,A                                        CAS00051
 RDIVR CLA*    **            C                                          CAS00052
 IDIVR LDQ*    **            D                                          CAS00053
       DST     C                                                        CAS00054
       STO     FACTR         IF C IS BIGGER IN MAGNITUDE THAN D, C IS   CAS00055
       SSP                     THE SCALING FACTOR                       CAS00056
       LRS     0                                                        CAS00057
       TLQ     MERGE                                                    CAS00058
       DLD     C             IF D IS BIGGER IN MAGNITUDE, SWITCH THEM   CAS00059
       XCA                                                              CAS00060
       STQ     D               (A+IB)/(C+ID)=(-B+IA)/(-D+IC)            CAS00061
       CHS                                                              CAS00062
       STO     FACTR                                                    CAS00063
       DLD     B                                                        CAS00064
       CHS                                                              CAS00065
       XCA                                                              CAS00066
       DST     B                                                        CAS00067
 MERGE CLS     A             SCALE EACH PART OF OPERANDS                CAS00068
       FDP     FACTR                                                    CAS00069
       STQ     A                                                        CAS00070
       CLA     B                                                        CAS00071
       FDP     FACTR                                                    CAS00072
       STQ     B                                                        CAS00073
       CLA     D                                                        CAS00074
       FDP     FACTR                                                    CAS00075
       STQ     D                                                        CAS00076
       FMP     B               (A+IB)/(1+ID)=(A+BD+I(B-AD))/(1+DD)      CAS00077
       FSB     A                                                        CAS00078
       STO     C                                                        CAS00079
       LDQ     A                                                        CAS00080
       FMP     D                                                        CAS00081
       FAD     B                                                        CAS00082
       STO     A                                                        CAS00083
       LDQ     D                                                        CAS00084
       FMP     D                                                        CAS00085
       FAD     ONE                                                      CAS00086
       STO     FACTR                                                    CAS00087
       CLA     C                                                        CAS00088
       FDP     FACTR                                                    CAS00089
       STQ     -3                                                       CAS00090
       CLA     A                                                        CAS00091
       FDP     FACTR                                                    CAS00092
       STQ     -4                                                       CAS00093
 DEXIT TRA     **                                                       CAS00094
       SPACE                                                            CAS00095
  C1   OCT     1                                                        CAS00096
  C2   OCT     2                                                        CAS00097
  ONE  OCT     201400000000                                             CAS00098
 FACTR BSS     1                                                        CAS00099
       EVEN                                                             CAS00100
   B   BSS     1                                                        CAS00101
   A   BSS     1                                                        CAS00102
   C   BSS     1                                                        CAS00103
   D   BSS     1                                                        CAS00104
 BUFF  BSS     1                                                        CAS00105
       END                                                              CAS00106
