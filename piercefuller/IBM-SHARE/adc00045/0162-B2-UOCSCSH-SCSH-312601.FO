*     FAP                                                               SCOSH001
       LBL     SCOSH                                                    SCOSH002
       COUNT   40                                                       SCOSH003
*      U. OF CHICAGO VERSION OF HYPERBOLIC SINE AND COSINE              SCOSH004
*              NORMALIZED ARGUMENT RECEIVED IN AC, CALLED BY            SCOSH005
*                            TSX  $SINH,4   OR   TSX  $COSH,4           SCOSH006
*              ANSWER IS GIVEN IN AC                                    SCOSH007
       ENTRY   SINH                                                     SCOSH008
       ENTRY   COSH                                                     SCOSH009
       SPACE                                                            SCOSH010
  SINH STL     FLAG          SET FLAG FOR SINH                          SCOSH011
  COSH STO     SAVE1         SAVE ARGUMENT                              SCOSH012
       SSP                                                              SCOSH013
       LDQ     MAXIM         TEST IF ARGUMENT IS TOO LARGE              SCOSH014
       TLQ     GOOF                                                     SCOSH015
       SXA     X4,4                                                     SCOSH016
       NZT     FLAG          IF COSH                                    SCOSH017
       TRA     EXPN            COMPUTE                                  SCOSH018
       LDQ     TRESH         TEST FOR                                   SCOSH019
       TLQ     EXPN            SINH CIRCUIT                             SCOSH020
       XCA                                                              SCOSH021
       FMP     SAVE1                                                    SCOSH022
       SLW     SAVE2         SQUARE                                     SCOSH023
       AXT     3,4                                                      SCOSH024
       ZAC                   COMPUTE                                    SCOSH025
  LOOP FAD     COEF+3,4        BY AN                                    SCOSH026
       XCA                       ECONOMIZED                             SCOSH027
       FMP     SAVE2               POLYNOMIAL                           SCOSH028
       TIX     LOOP,4,1                                                 SCOSH029
       XCA                                                              SCOSH030
       FMP     SAVE1                                                    SCOSH031
       FAD     SAVE1                                                    SCOSH032
       FRN                                                              SCOSH033
       TRA     X4                                                       SCOSH034
  EXPN TSX     $EXP,4        COMPUTE VIA                                SCOSH035
       STO     SAVE2             EXPONENTIAL                            SCOSH036
       CLA     K                   FUNCTION                             SCOSH037
       FDP     SAVE2                                                    SCOSH038
       XCA                                                              SCOSH039
       ZET     FLAG          CHECK IF                                   SCOSH040
       CHS                     SINH OR                                  SCOSH041
       FAD     SAVE2             COSH                                   SCOSH042
       FRN                                                              SCOSH043
       SUB     K2                                                       SCOSH044
       LDQ     SAVE1                                                    SCOSH045
       ZET     FLAG                                                     SCOSH046
       LLS     0                                                        SCOSH047
  X4   AXT     **,4                                                     SCOSH048
       STZ     FLAG          RESET FLAG                                 SCOSH049
       TRA     1,4                                                      SCOSH050
 GOOF  CLA     SAVE1                                                    SCOSH051
       LDI     *+2                                                      SCOSH052
       TRA*    $(EXE)                                                   SCOSH053
       PZE     2,6,X4+1                                                 SCOSH054
 MAXIM OCT     207540074636  88.02969                                   SCOSH055
 TRESH OCT     200552023632  1/SQRT(2)                                  SCOSH056
    K2 OCT     1000000000                                               SCOSH057
     K OCT     201400000000  1.0                                        SCOSH058
  COEF OCT     164645521616  0.000201063                                SCOSH059
       OCT     172421025235  0.008332569                                SCOSH060
       OCT     176525252567  0.166666729                                SCOSH061
  FLAG PZE                                                              SCOSH062
 SAVE1 PZE                                                              SCOSH063
 SAVE2 PZE                                                              SCOSH064
       END                                                              SCOSH065
