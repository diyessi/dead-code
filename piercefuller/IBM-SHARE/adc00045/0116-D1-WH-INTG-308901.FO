*     XEQ                                                                       
C     REVISION 1 OF SUBROUTINE INTGL- BARRIOS, CAULEY  4/28/65                  
C     NINT- NUMBER OF INTEGRATIONS                                              
C     NPT- NUMBER OF EQUALLY SPACED POINTS                                      
C     H- INTERVAL                                                               
C     Y- ARRAY OF INTEGRALS WHERE Y(I,J) IS THE J-1 INTEGRAL OF THE             
C        FUNCTION Y(I,1) AT THE ITH POINT                                       
      SUBROUTINE INTGL(NINT,NPT,H,Y)                                            
      DIMENSION Y(100,21),F(20)                                                 
      F(1)=1.                                                                   
      N1=NINT+1                                                                 
      N2=N1+1                                                                   
      DO 50 I=2,N2                                                              
 50   F(I)=F(I-1)*FLOATF(I)                                                     
      NPT1=NPT/4*4                                                              
      DO 11 I=1,NPT1,4                                                          
      AO=(Y(I,1)+Y(I+1,1)+Y(I+2,1)+Y(I+3,1)+Y(I+4,1))/5.                        
      A1=2.*(Y(I,1)+.5*(Y(I+1,1)-Y(I+3,1))-Y(I+4,1))/5.                         
      A2=2.*(Y(I,1)-.5*(Y(I+1,1)+Y(I+3,1))-Y(I+2,1)+Y(I+4,1))/7.                
      A3=(Y(I,1)+2.*(Y(I+3,1)-Y(I+1,1))-Y(I+4,1))/10.                           
      BO=AO+A1+A2+A3                                                            
      B1=-(3.*A1+12.*A2+43.*A3)/6./H                                            
      B2=(A2+10.*A3)/2./H**2                                                    
      B3=-5.*A3/6./H**3                                                         
      DO 11 K=2,5                                                               
      L=I+K-1                                                                   
      T2=FLOATF(K-1)*H                                                          
      DO 11 J=2,N1                                                              
      M=J-1                                                                     
      N=J+1                                                                     
      TEMP = BO*(T2**M)/F(M)                                                    
      TEMP=TEMP+B1*(T2**J)/F(J)                                                 
      TEMP =TEMP + 2.*B2*T2**N/F(N)                                             
      TEMP= TEMP + 6.*B3*T2**(N+1)/F(N+1)                                       
      Y(L,J)=Y(I,J)+TEMP                                                        
      IF(M-1)11,11,14                                                           
 14   DO 13 IJ=2,M                                                              
 13   Y(L,J)=Y(L,J)+Y(I,IJ)*T2**(IJ-1)/F(IJ-1)                                  
 11   CONTINUE                                                                  
      RETURN                                                                    
      END                                                                       
