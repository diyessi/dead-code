$IBMAP URPLT4  100           FORTRAN IV VERSION OF URPLOT.              URPLT400
PLOT   SAVE    1,2                                                      URPLT401
       AXT     20,2          CLEAR                                      URPLT402
       CAL     =H             OUT                                       URPLT403
       SLW     BUF+20,2       THE                                       URPLT404
       TIX     *-1,2,1       BUFFER                                     URPLT405
ARGU   CLA     3,4           FIND THE ARRAY                             URPLT406
       STA     MOVE          REMEMBER IT                                URPLT407
       CLA     4,4           GET THE CHARACTERS                         URPLT408
       STA     OUTT          LOCATION AND SAVE IT,                      URPLT409
       CLA*    4,4           THEN GET THE CHARACTERS THEMSELVES         URPLT410
       STO     TEMP          AND SET THEM ASIDE                         URPLT411
       CLA     =7            INITIALIZE                                 URPLT412
       STA     NCOUN         THE CHARACTER NUMBER                       URPLT413
ERR2   TIX     NCOUN,4,1     AND MOVE TO THE FIRST ARGUMENT             URPLT414
NBEGIN AXT     1,2           THESE ARGUMENTS ARE STORED FORWARDS        URPLT415
       SXA     LIST,2        SO TELL THE ARGUMENT EXAMINER              URPLT416
BEGIN  CAL     3,4           GET THAT ARGUMENT                          URPLT417
       ANA     MASK          THROW AWAY THE ADDRESS                     URPLT418
       TNZ     ENDSEQ        IS HE THE LAST ONE                         URPLT419
       CLA     3,4           NO, WHAT WAS HE AGAIN                      URPLT420
       STA     BRING         WELL, WE KNOW WHERE HE IS ANYWAY           URPLT421
LIST   AXT     **,2          GET THE NEXT LIST ELEMENT                  URPLT422
       TXI     *+1,2,-1      AND STEP DOWN THE ARRAY                    URPLT423
       SXA     *-2,2         SAVE LOCATION IN ARRAY                     URPLT424
BRING  CAL     **,2          EVALUATE THIS ONE                          URPLT425
       LAS     =1000         IS IT THE LAST ONE                         URPLT426
       TRA     NCOUN         YES( PROBABLY )                            URPLT427
       TRA     NCOUN         YES ( CERTAINLY )                          URPLT428
       TMI     LIST          OFF SCALE, IGNORE IT                       URPLT429
       ADD     =1            INCREMENT IT                               URPLT430
       CAS     =118          TEST FOR OFF SCALE                         URPLT431
       TRA     LIST          THE OTHER WAY                              URPLT432
       TRA     *+1           WAY OUT, MAN                               URPLT433
       XCA                   PUT IT OVER THERE, PLEASE.                 URPLT434
       ZAC                   CLEAR THE ACCUMULATOR                      URPLT435
       DVP     =6            WHERE DOES THIS ONE GO                     URPLT436
       TNZ     MOD           IS IT EXACT                                URPLT437
       XCA                   YES, MOVE                                  URPLT438
       SUB     =1            BACK ONE                                   URPLT439
       XCA                   AND SET CHARACTER                          URPLT440
       CLA     =6            NUMBER ONE                                 URPLT441
MOD    SUB     =7            COMPLEMENT THE NUMBER                      URPLT442
 STORE STA     SETUP1        AND SAVE                                   URPLT443
       STA     SETUP2        IT WHEREVER                                URPLT444
       STA     SETUP3        IT MAY BE NEEDED                           URPLT445
EXCHAN XCA                   WHICH WORD WILL IT BE                      URPLT446
       PAC     0,1           ONLY XR1 KNOWS FOR SURE.                   URPLT447
SETUP3 AXT     **,2          WHERE DOES THE MASK COME IN                URPLT448
       LDQ     =O170000000000 PICK IT UP                                URPLT449
ROTAT2 RQL     6             AND SHIFT IT AROUND INTO POSITION          URPLT450
       TIX     ROTAT2,2,1    ONE CHARACTER POSITION AT A TIME           URPLT451
       XCL                   GET IT OVER HERE WHERE I CAN SEE IT        URPLT452
       ANA     BUF,1         PICK UP THE CHARACTER IN QUESTION          URPLT453
       SLW     FLAG          SAVE THE NUMERIC BITS                      URPLT454
SETUP1 AXT     **,2          WHICH CHARACTER POSITION WAS THAT          URPLT455
       LDQ     CLEAR         007777777777 IS IN CLEAR                   URPLT456
 ROTAT RQL     6             MOVE IT AROUND TO THE PROPER POSITION      URPLT457
       TIX     ROTAT,2,1     ONE CHARACTER AT A TIME                    URPLT458
       XCL                   SET IT UP,                                 URPLT459
       ANS     BUF,1         AND KNOCK IT DOWN                          URPLT460
SETUP2 AXT     **,2          WHICH CHARACTER ARE WE REFERRING TO        URPLT461
       LDQ     =0            GET  ALL THAT GARBAGE OUT OF THERE         URPLT462
       CAL     COUNT         GET HIS CHARACTER                          URPLT463
       ZET     FLAG          IS THIS AN INTERSECTION                    URPLT464
       CAL     =O000000000053 YES, MAKE THAT A $                        URPLT465
       LRS     6             TAKE A RUNNING START                       URPLT466
       LLS     6             AND MOVE OVER TO WHERE YOU BELONG          URPLT467
       TIX     *-1,2,1       ONE CHARACTER AT A TIME                    URPLT468
       ORS     BUF,1         AND SET THE PRINT LINE                     URPLT469
       TRA     LIST          GO BACK FOR THE NEXT ONE                   URPLT470
NCOUN  AXT     7,2           HOW MANY SO FAR                            URPLT471
       TNX     OUTT,2,1      ONE MORE                                   URPLT472
       SXA     NCOUN,2       AND MORE TO GO                             URPLT473
       ZAC                   WIPE THE AC CLEAN                          URPLT474
CHAR   LDQ     TEMP          GET WHATS LEFT                             URPLT475
       LGL     6             CHOP OFF ANOTHER ONE                       URPLT476
       STQ     TEMP          AND SAVE THE REMNANTS                      URPLT477
       STO     COUNT         AND THE NEW CHARACTER                      URPLT478
TIX    TIX     NBEGIN,4,1    AND LOOK FOR A NEW ELEMENT                 URPLT479
       CLA     OUTT          ALL OUT IN THIS WORD                       URPLT480
       ADD     =1            STEP DOWN THE LIST                         URPLT481
       STA     OUTT          REMEMBER WHERE YOU STAND                   URPLT482
OUTT   CLA     **            GO GET 'EM                                 URPLT483
       STO     TEMP          PUT THIS NEW BUNCH OF CHARACTERS           URPLT484
       TXI     CHAR-2,2,5    IN TEMPORARY AND REPORT BACK TO HQ.        URPLT485
ENDSEQ AXT     20,4          WE DID IT                                  URPLT486
       AXT     0,1           GET READY TO MOVE THE BUFFER               URPLT487
       CAL     BUF+20,4      OVER INTO THE                              URPLT488
MOVE   SLW     **,1          CALLERS ARRAY                              URPLT489
       TXI     *+1,1,-1      THIS IS FORTRAN IV, DAD                    URPLT490
       TIX     *-3,4,1       LOOP THROUGH THE BUFFER                    URPLT491
       RETURN  PLOT          AND RETURN TO WHENCE YOU CAME              URPLT492
 BUF   BSS     20            ASSEMBLY REGISTER                          URPLT493
MASK   SEVEN   ,7,-1         ALL BUT THE ADDRESS                        URPLT494
 CLEAR OCT     007777777777  ALL BUT ONE CHARACTER                      URPLT495
COUNT                        CHARACTER PRESENTLY UNDER CONSIDERATION    URPLT496
FLAG                         INTERSECTION MAKES THIS NON ZERO           URPLT497
TEMP                         REMAINDER OF THIS BUNCH OF CHARACTERS      URPLT498
       END      ........................................................URPLT499
