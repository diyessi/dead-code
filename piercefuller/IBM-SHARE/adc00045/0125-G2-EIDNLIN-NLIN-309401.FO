C     NONLINEAR LEAST SQUARES                                               0020
C     BY     D. W. MARQUARDT                                                0030
C     PROGRAMMED BY     T. BAUMEISTER III,                                  0040
C                       J. ANN SHELDON AND RUBY M. STANLEY                  0050
C                  IBKT=1 MEANS USE UPPER A MATRIX                          0060
C                  IBKT=2 MEANS USE TAPE 3                                  0070
C                                                                           0080
      DIMENSION FMT(12),PRNT(5),SPRNT(5)                                    0090
      DIMENSION BS(50),DB(50),BA(50),G(50),W(51),IB(49),SA(50),P(50),A(5    0100
     10,51),B(50)                                                           0110
      DIMENSION X(500,10),Y(500)                                            0120
      DIMENSION CONS(25)                                                    0121
C                                                                           0130
C     ------------------------------------------------------------------    0140
C     MAX NO OF PARAMETERS IS K=50                                          0150
C     MAX NO OF IND VARS IS M=10                                            0160
C     MAX NO OF OBSERVATIONS IS N=500                                       0170
C                  IWHER =-1 MEANS DO ANY SPECIAL INITIALIZING FOR CASE     0180
C                  IWHER = 0 MEANS START NEW CASE OR END RUN                0190
C                  IWHER = 1 MEANS GET P S AND F                            0200
C                  IWHER GREATER THAN 1 MEANS GET F ONLY                    0210
      NPRNT=0                                                               0220
  650 IWHER = 0                                                             0230
  652 GO TO 4                                                               0240
  653 IWHER = IWHER                                                         0250
      IF (IWHER.GT.0)GO TO 654                                              0260
      IF (IWHER.EQ.0)GO TO 660                                              0270
  651 CONTINUE                                                              0280
C                  CODING FOR CASE INITIALIZING GOES HERE                   0290
C     ..................................................................    0300
      CALL SUBZ(Y,X,B,PRNT,NPRNT,N)                                         0310
C     ..................................................................    0320
      IF (IBOUT.EQ.0) GO TO 652                                             0330
      GO TO 650                                                             0340
  654 CONTINUE                                                              0350
C                  CODING TO MAKE F GOES HERE                               0360
C                  F IS Y HAT (I)                                           0370
C                  NPRNT IS THE NO OF OTHER WORDS TO BE PRINTED             0380
C                  THE WORDS TO BE PRINTED ARE IN PRNT(1)...PRNT(5)         0390
C     ..................................................................    0400
      CALL      FCODE(Y,X,B,PRNT,F,I,RES)                                   0410
C     ..................................................................    0420
      IF (IWHER.NE.1)GO TO 652                                              0430
  656 IF (IFSS2.NE.0) GO TO 652                                             0440
  658 CONTINUE                                                              0450
C                  CODING TO MAKE DF/DB GOES HERE                           0460
C                  MAKE K OF THEM. CALL THEM P(J)                           0470
C                  THEY ARE MADE FROM X(I,L) AND B(J)                       0480
C     ..................................................................    0490
      CALL PCODE(P,X,B,PRNT,F,I)                                            0500
C     ..................................................................    0510
      GO TO 652                                                             0520
  660 CALL EXIT                                                             0530
C                  THIS IS THE END OF THE MAIN ROUTINE                      0540
C     ------------------------------------------------------------------    0550
    4 IWHER = IWHER                                                         0560
C               -  0 +                                                      0570
      IF (IWHER.LT.0)GO TO 59                                               0580
      IF (IWHER.EQ.0)GO TO 10                                               0590
C             1  2   3   4                                                  0600
    8 GO TO (75,304,606,620), IWHER                                         0610
C                  READ FIRST CARD OF NEXT CASE                             0620
   10 ITCT=0                                                                0630
      IBOUT=0                                                               0640
      READ (5,900) N,K,IP,M,IFP,NCONS                                       0650
      NTILDA=N+NCONS                                                        0651
      XNT=NTILDA                                                            0652
      IF (N.LE.0)GO TO 20                                                   0660
      READ (5,900)IWS1,IWS2,IWS3,IWS4,IWS5,IWS6                             0670
      IFSS1=2                                                               0680
      IF (IWS5.EQ.0)GO TO 210                                               0690
      PAUSE 5                                                               0700
      CALL SSWTCH(1,IFSS1)                                                  0710
 210  CONTINUE                                                              0720
      WRITE (6,932)                                                         0730
      IF(IFSS1.NE.1)GO TO 211                                               0740
      WRITE (12,932)                                                        0750
  211 GO TO 21                                                              0760
C                  END OF LAST PROBLEM                                      0770
   20 GO TO (  19,  17),IBKT                                                0780
   17 REWIND 3                                                              0790
   19 IWHER=0                                                               0800
      GO TO 653                                                             0810
 21   IF (IFP.LE.0)GO TO 22                                                 0820
   23 CONTINUE                                                              0830
      CALL ATHRUZ(IBCH,1H )                                                 0840
      CALL ATHRUZ(IOCH,1HO)                                                 0850
      CALL ATHRUZ(IPCH,1HP)                                                 0860
      CALL ATHRUZ(IYCH,1HY)                                                 0870
      CALL ATHRUZ(IXCH,1HX)                                                 0880
      READ (5,930)YMN,SPRD                                                  0890
   22 IF(IP.LE.0) GOTO 30                                                   0900
   24 READ(5,900)(IB(I), I = 1,IP)                                          0910
      DO 26 I=1,IP                                                          0920
      IF (IB(I).GT.0)GO TO 26                                               0930
 25   WRITE (6,926)                                                         0940
      IF(IFSS1.NE.1)GO TO 212                                               0950
      WRITE (12,926)                                                        0960
 212  CONTINUE                                                              0970
      IBOUT=1                                                               0980
   26 CONTINUE                                                              0990
   30 READ (5,931) FF,T,E,TAU,XL,GAMCR,DEL,ZETA                             1000
C                  DUB IN INPUT CONSTANTS IF NOT SUPPLIED                   1010
C                  ( XL IS CHECKED IN FIRST ITERATION )                     1020
      IF(FF.GT.0.) GOTO 34                                                  1030
   32 FF=4.                                                                 1040
   34 IF(E.GT.0.) GOTO 37                                                   1050
   36 E=.00005                                                              1060
   37 IF(TAU.GT.0.) GOTO 39                                                 1070
   38 TAU=.001                                                              1080
   39 IF(T.GT.0.) GOTO 42                                                   1090
   40 T=2.                                                                  1100
 42   IF (K .GT.25)GO TO 46                                                 1110
   44 IBKT=1                                                                1120
      GO TO 50                                                              1130
   46 IBKT=2                                                                1140
      REWIND 3                                                              1150
   50 IF(GAMCR.GT. 0.) GOTO 52                                              1160
   51 GAMCR = 45.                                                           1170
   52 IF (DEL.GT. 0.) GO TO 55                                              1180
      DEL=.00001                                                            1190
   55 IF (ZETA.GT. 0.) GO TO 53                                             1200
      ZETA=.1E-30                                                           1210
   53 XKDB = 1.                                                             1220
   54 CONTINUE                                                              1230
C                  READ IN INITIAL B GUESSES 7 TO THE CARD                  1240
      READ (5,901)(B(I),I=1,K)                                              1250
      READ (5,902)(FMT(I),I=1,12)                                           1260
      DO 56 I=1,N                                                           1270
 56   READ (5,FMT)Y(I),(X(I,L),L=1,M)                                       1280
      IWHER=-1                                                              1290
      GO TO 653                                                             1300
   59 IBKA=1                                                                1310
C                                                                           1320
C     ..................................................................    1330
C                  START THE CALCULATION OF THE PTP MATRIX                  1340
 58   WRITE (6,907)N,K,IP,M,IFP,GAMCR,DEL,FF,T,E,TAU,XL,ZETA                1350
      IF(IFSS1.NE.1)GO TO 213                                               1360
      WRITE (12,907)N,K,IP,M,IFP,GAMCR,DEL,FF,T,E,TAU,XL,ZETA               1370
 213  GO TO 61                                                              1380
   60 CONTINUE                                                              1390
      IF (IWS5.NE.0) GO TO 61                                               1391
      IWS3=IWS3-1                                                           1392
      IWS3=MAX0(IWS3,0)                                                     1393
 61   DO 62 I=1,K                                                           1400
      G (I) =0.                                                             1410
      DO 62 J=1,K                                                           1420
   62 A (I,J)=0.                                                            1430
      GO TO (63,69,69),IBKA                                                 1440
 63   IF (IWS5.EQ.0)GO TO 630                                               1450
      CALL SSWTCH (3,IFSS3)                                                 1460
      CALL SSWTCH(2,IFSS2)                                                  1470
      CALL SSWTCH (1,IFSS1)                                                 1480
      GO TO (66,64),IFSS3                                                   1490
 630  IFSS3=IWS3                                                            1500
      IFSS2=IWS2                                                            1510
      GO TO 70                                                              1520
   64 IFSS3=0                                                               1530
   66 GO TO (70,65), IFSS2                                                  1540
   65 IFSS2=0                                                               1550
      GO TO 70                                                              1560
 69   CONTINUE                                                              1570
 70   WRITE (6,908) ITCT,(B(J),J=1,K)                                       1580
      IF(IFSS1.NE.1)GO TO 214                                               1590
      WRITE (12,908) ITCT,(B(J),J=1,K)                                      1600
 214  CONTINUE                                                              1610
      IF (IFSS3.EQ.0)GO TO 73                                               1620
 71   IF (IFP.LE.0)GO TO 68                                                 1630
   67 WS = YMN+SPRD                                                         1640
      WRITE( 6,906)YMN,WS                                                   1650
      IF(IFSS1.NE.1) GOTO 258                                               1660
      WRITE(12,906)YMN,WS                                                   1670
  258 CONTINUE                                                              1680
      GO TO 73                                                              1690
   68 WRITE( 6,910)                                                         1700
      IF(IFSS1.NE.1) GOTO 259                                               1710
      WRITE(12,910)                                                         1720
  259 CONTINUE                                                              1730
   73 I=1                                                                   1740
      PHI=0.                                                                1750
      PHIN=0.                                                               1751
      ICONS=1                                                               1752
      IF (IFSS2.EQ.0) GO TO 57                                              1760
      GO TO 600                                                             1770
 72   IF (IFSS2.EQ.1)GO TO 602                                              1780
C                  THIS IS THE ANALYTICAL P S ROUTINE                       1790
   57 IWHER=1                                                               1800
C                  GET P S AND F                                            1810
      GO TO 653                                                             1820
 75   IF (IP.LE.0)GO TO 80                                                  1830
   76 DO 77 II=1,IP                                                         1840
      IWS=IB(II)                                                            1850
   77 P(IWS)=0.                                                             1860
      GO TO 80                                                              1870
C     ..................................................................    1880
C                  THIS IS THE ESTIMATED P S ROUTINE                        1890
  600 CONTINUE                                                              1900
  602 IWHER=3                                                               1910
      GO TO 653                                                             1920
 606  RWS=RES                                                               1930
      FSAVE=F                                                               1931
      DO 607 II=1,NPRNT                                                     1940
  607 SPRNT(II)=PRNT(II)                                                    1950
      J=1                                                                   1960
 608  IF (IP.LE.0)GO TO 618                                                 1970
  610 DO 612 II=1,IP                                                        1980
      IF ((J-IB(II)).EQ.0)GO TO 621                                         1990
  612 CONTINUE                                                              2000
  618 DBW=B(J)*DEL                                                          2010
      TWS=B(J)                                                              2020
      B(J)=B(J)+DBW                                                         2030
      IWHER=4                                                               2040
      GO TO 653                                                             2050
  620 B(J)=TWS                                                              2060
      P(J)=-(RES-RWS)/DBW                                                   2070
      GO TO 622                                                             2080
  621 P(J)=0.                                                               2090
  622 J=J+1                                                                 2100
      IF ((J-K).LE.0)GO TO 608                                              2110
 624  RES=RWS                                                               2120
      F=FSAVE                                                               2121
      DO 625 II=1,NPRNT                                                     2130
  625 PRNT(II)=SPRNT(II)                                                    2140
C                  END OF ESTIMATED P S ROUTINE                             2150
C     ..................................................................    2160
C                  NOW, USE THE P S TO MAKE PARTIALS MATRIX                 2170
   80 DO 82 JJ=1,K                                                          2180
      G(JJ)=G(JJ)+RES*P(JJ)                                                 2190
      DO 82 II=JJ,K                                                         2200
      A(II,JJ)=A(II,JJ)+P(II)*P(JJ)                                         2210
   82 A(JJ,II)=A(II,JJ)                                                     2220
      IF (IFP.LE.0)GO TO 318                                                2230
 800  IF (IFSS3.EQ.0.OR.I.GT.N) GO TO 314                                   2240
C                  PLOTTING Y(I),F                                          2250
  802 IO = (Y(I)-YMN)*100./SPRD                                             2260
      IPP = (F-YMN)*100./SPRD                                               2270
      IF (IO.EQ.IPP)GO TO 808                                               2280
      IF (IO.GT. IPP)GO TO 812                                              2290
C                  Y(I) OUT FIRST                                           2300
  804 IP1=IOCH                                                              2310
      IP2=IPCH                                                              2320
      I1=IO                                                                 2330
      I2=IPP                                                                2340
      GO TO 816                                                             2350
C                  ONLY ONE CHARACTER                                       2360
  808 IP1=IYCH                                                              2370
      IP2=IBCH                                                              2380
      I1=IO                                                                 2390
      I2=IPP                                                                2400
      GO TO 816                                                             2410
C                  F OUT FIRST                                              2420
  812 IP1=IPCH                                                              2430
      IP2=IOCH                                                              2440
      I1=IPP                                                                2450
      I2=IO                                                                 2460
C                  ZERO PLOTS IN THE LEFT HAND COLUMN, SO I1 IS ITS         2470
C                  OWN BLANK COUNTER                                        2480
C                  OVERFLOWS PLOT X IN COLUMN 102                           2490
C                  UNDERFLOWS ALSO PLOT X IN COLUMN ZERO                    2500
 816  IF (I2.LE.101)GO TO 819                                               2510
  817 I2=101                                                                2520
      IP2=IXCH                                                              2530
      IF (I1.LT.101)GO TO 819                                               2540
  818 I1=101                                                                2550
      IP1=IXCH                                                              2560
      IP2=IBCH                                                              2570
      GO TO 825                                                             2580
 819  IF (I1.GE.0)GO TO 825                                                 2590
  822 I1=0                                                                  2600
      IP1=IXCH                                                              2610
      IF (I2.GT.0)GO TO 825                                                 2620
  823 I2=1                                                                  2630
      IP2=IBCH                                                              2640
  825 I1M1=I1                                                               2650
      I1M2=I2-I1-1                                                          2660
      IF (I1M1.GT.0)GO TO 832                                               2670
 820  IF (I1M2.GT.0)GO TO 828                                               2680
 824  WRITE (6,928)IP1,IP2                                                  2690
      IF(IFSS1.NE.1)GO TO 215                                               2700
      WRITE (12,928)IP1,IP2                                                 2710
 215  CONTINUE                                                              2720
      GO TO 844                                                             2730
 828  WRITE (6,928)IP1,(IBCH,II=1,I1M2),IP2                                 2740
      IF(IFSS1.NE.1)GO TO 216                                               2750
      WRITE (12,928)IP1,(IBCH,II=1,I1M2),IP2                                2760
 216  CONTINUE                                                              2770
      GO TO 844                                                             2780
 832  IF (I1M2.GT.0)GO TO 840                                               2790
 836  WRITE (6,928)(IBCH,II=1,I1M1),IP1,IP2                                 2800
      IF(IFSS1.NE.1)GO TO 217                                               2810
      WRITE (12,928)(IBCH,II=1,I1M1),IP1,IP2                                2820
 217  CONTINUE                                                              2830
      GO TO 844                                                             2840
  840 WRITE (6,928)(IBCH,II=1,I1M1),IP1,(IBCH,II=1,I1M2),IP2                2850
      IF(IFSS1.NE.1)GO TO 218                                               2860
      WRITE (12,928)(IBCH,II=1,I1M1),IP1,(IBCH,II=1,I1M2),IP2               2870
 218  CONTINUE                                                              2880
  844 GO TO 314                                                             2890
 318  WS=RES                                                                2900
      IF (IFSS3.EQ.0.OR.I.GT.N) GO TO 314                                   2910
  308 IF (NPRNT.GT.0)GO TO 312                                              2920
 310  WRITE (6,925)Y(I),F,WS                                                2930
      IF(IFSS1.NE.1)GO TO 219                                               2940
      WRITE (12,925)Y(I),F,WS                                               2950
 219  CONTINUE                                                              2960
      GO TO 314                                                             2970
 312  WRITE (6,925)Y(I),F,WS,(PRNT(JJ),JJ=1,NPRNT)                          2980
      IF(IFSS1.NE.1)GO TO 220                                               2990
      WRITE (12,925)Y(I),F,WS,(PRNT(JJ),JJ=1,NPRNT)                         3000
 220  CONTINUE                                                              3010
 314  WS=RES                                                                3020
      PHI=PHI+WS*WS                                                         3030
      IF (I.GT.N) GO TO 313                                                 3031
      PHIN=PHIN+WS*WS                                                       3032
      GO TO 315                                                             3033
 313  CONS(ICONS)=RES                                                       3034
      ICONS=ICONS+1                                                         3035
 315  I=I+1                                                                 3040
      IF (I.LE.NTILDA) GO TO 72                                             3050
 84   IF (IP.LE.0)GO TO 88                                                  3060
   85 DO 87 JJ=1,IP                                                         3070
      IWS=IB(JJ)                                                            3080
      DO 86 II=1,K                                                          3090
      A(IWS,II)=0.                                                          3100
   86 A(II,IWS)=0.                                                          3110
   87 A(IWS,IWS)=1.                                                         3120
 88   GO TO (90,704,703),IBKA                                               3130
C                  SAVE SQUARE ROOTS OF DIAGONAL ELEMENTS                   3140
   90 DO 92 I=1,K                                                           3150
 92   SA(I)=SQRT (A(I,I))                                                   3160
      DO 106 I=1,K                                                          3170
      DO 100 J=1,K                                                          3180
      WS = SA(I)*SA(J)                                                      3190
      IF(WS.GT.0.) GOTO 98                                                  3200
   96 A(I,J) =0.                                                            3210
      GO TO 100                                                             3220
   98 A(I,J)=A(I,J)/WS                                                      3230
  100 CONTINUE                                                              3240
      IF(SA(I).GT.0.) GOTO 104                                              3250
  102 G(I)=0.                                                               3260
      GO TO 106                                                             3270
  104 G(I)=G(I)/SA(I)                                                       3280
  106 CONTINUE                                                              3290
      DO 110 I=1,K                                                          3300
  110 A(I,I)=1.                                                             3310
 120  PHIZ=PHI                                                              3320
C                  WE NOW HAVE PHI ZERO                                     3330
      GO TO (1132,1130),IBKT                                                3340
 1130 WRITE (3)A                                                            3350
      REWIND 3                                                              3360
      GO TO 1134                                                            3370
 1132 DO 1133 II=1,K                                                        3380
      III=II+25                                                             3390
      DO 1133 JJ=1,K                                                        3400
 1133 A(III,JJ)=A(II,JJ)                                                    3410
C     ..................................................................    3420
 1134 CONTINUE                                                              3430
      IF (ITCT.NE.0) GO TO 163                                              3440
C                  FIRST ITERATION                                          3450
  150 IF(XL.GT.0.) GOTO 154                                                 3460
  152 XL=0.01                                                               3470
 154  DO 161 J=1,K                                                          3490
  161 BS(J)=B(J)                                                            3500
C                  BS(J) CORRESPONDS TO PHIZ                                3510
  163 IBK1=1                                                                3520
      WS=N-K+IP                                                             3530
      ITCT=ITCT+1                                                           3531
      SE=SQRT(PHIN/WS)                                                      3540
      IF (IFSS3.GT.0)GO TO 165                                              3550
  162 IF (IFSS2.EQ.0) GO TO 168                                             3560
 167  WRITE (6,911)PHIZ,SE,XLL,GAMMA,XL                                     3570
      IF(IFSS1.NE.1)GO TO 221                                               3580
      ITCT=ITCT+1                                                           3531
      WRITE (12,911)PHIZ,SE,XLL,GAMMA,XL                                    3590
 221  CONTINUE                                                              3600
      GO TO 169                                                             3610
 168  WRITE (6,912)PHIZ,SE,XLL,GAMMA,XL                                     3620
      IF(IFSS1.NE.1)GO TO 222                                               3630
      WRITE (12,912)PHIZ,SE,XLL,GAMMA,XL                                    3640
 222  CONTINUE                                                              3650
      GO TO 169                                                             3660
 165  IF (NCONS.EQ.0) GO TO 166                                             3670
      WRITE (6,938) (JJ,CONS(JJ),JJ=1,NCONS)                                3671
      IF (IFSS1.NE.1) GO TO 166                                             3672
      WRITE (12,938) (JJ,CONS(JJ),JJ=1,NCONS)                               3673
 166  WRITE (6,939)                                                         3680
      IF (IFSS1.NE.1) GO TO 111                                             3681
      WRITE (12,939)                                                        3682
 111  DO 114 I=1,K                                                          3683
      WRITE (6,937) I, (A(I,J),J=1,K)                                       3684
      IF (IFSS1.NE.1) GO TO 114                                             3685
      WRITE (12,937) I, (A(I,J),J=1,K)                                      3686
 114  CONTINUE                                                              3687
      IF (IFSS2.EQ.0) GO TO 1661                                            3688
      WRITE (6,903) PHIZ,SE,XL                                              3689
      IF(IFSS1.NE.1)GO TO 223                                               3690
      WRITE (12,903)PHIZ,SE,XL                                              3700
 223  CONTINUE                                                              3710
      GO TO 169                                                             3720
 1661 WRITE (6,909)PHIZ,SE,XL                                               3730
      IF(IFSS1.NE.1)GO TO 224                                               3740
      WRITE (12,909)PHIZ,SE,XL                                              3750
 224  CONTINUE                                                              3760
  169 GO TO 200                                                             3770
  164 PHIL=PHI                                                              3780
C                  WE NOW HAVE PHI LAMBDA                                   3790
      DO 170 J=1,K                                                          3800
      IF (ABS(DB(J)/(ABS(B(J)) + TAU)).GE.E) GOTO 172                       3810
  170 CONTINUE                                                              3820
      WRITE (6,923)                                                         3830
      IF(IFSS1.NE.1)GO TO 225                                               3840
      WRITE (12,923)                                                        3850
 225  CONTINUE                                                              3860
      GO TO 700                                                             3870
 172  IF (IWS5.EQ.0)GO TO 1720                                              3880
      CALL SSWTCH(4,IFSS4)                                                  3890
      GO TO (171,173),IFSS4                                                 3900
 1720 IF (IWS4.EQ.0)GO TO 173                                               3910
      IF (IWS4.EQ.1)GO TO 171                                               3920
      IWS4=IWS4-1                                                           3930
      GO TO 173                                                             3940
 171  WRITE (6,924)                                                         3950
      IF(IFSS1.NE.1)GO TO 226                                               3960
      WRITE (12,924)                                                        3970
 226  CONTINUE                                                              3980
      GO TO 700                                                             3990
  173 XKDB = 1.                                                             4000
      IF (PHIL.GT.PHIZ)GO TO 190                                            4010
  174 XLS=XL                                                                4020
      DO 176 J=1,K                                                          4030
      BA(J)=B(J)                                                            4040
  176 B(J)=BS(J)                                                            4050
      IF (XL.GT..00000001)GO TO 175                                         4060
 1175 DO 1176 J=1,K                                                         4070
      B(J)=BA(J)                                                            4080
 1176 BS(J)=B(J)                                                            4081
      GO TO 60                                                              4090
  175 XL=XL/10.                                                             4100
      IBK1=2                                                                4110
      GO TO 200                                                             4120
  177 PHL4=PHI                                                              4130
C                  WE NOW HAVE PHI(LAMBDA/10)                               4140
      IF(PHL4.GT.PHIZ) GOTO 184                                             4150
  182 DO 183 J=1,K                                                          4160
  183 BS(J)=B(J)                                                            4170
      GO TO 60                                                              4180
  184 XL=XLS                                                                4190
      DO 186 J=1,K                                                          4200
      BS(J)=BA(J)                                                           4210
  186 B(J)=BA(J)                                                            4220
      GO TO 60                                                              4230
  190 IBK1=4                                                                4240
      XLS=XL                                                                4250
      XL=XL/10.                                                             4260
      DO 185 J=1,K                                                          4270
  185 B(J)=BS(J)                                                            4280
