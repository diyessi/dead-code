  192 XL=XL*10.                                                             4330
  195 DO 193 J=1,K                                                          4340
  193 B(J)=BS(J)                                                            4350
      GO TO 200                                                             4360
  194 PHIT4=PHI                                                             4370
C                  WE NOW HAVE PHI(10*LAMBDA)                               4380
 180  IF (PHIT4.GT.PHIZ)GO TO 198                                           4390
  196 DO 197 J=1,K                                                          4400
  197 BS(J)=B(J)                                                            4410
      GO TO 60                                                              4420
 198  IF (GAMMA.GE.GAMCR)GO TO 192                                          4430
  199 XKDB = XKDB/2.                                                        4440
      DO 1199 J=1,K                                                         4450
      IF (ABS(DB(J)/(ABS(B(J))+TAU)).GE.E)GO TO 195                         4460
