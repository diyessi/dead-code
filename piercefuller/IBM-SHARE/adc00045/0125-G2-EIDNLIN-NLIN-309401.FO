      DO 1200 J=1,K                                                         4480
 1200 B(J)=BS(J)                                                            4490
      WRITE (6,934)                                                         4500
      IF(IFSS1.NE.1)GO TO 227                                               4510
      WRITE (12,934)                                                        4520
 227  CONTINUE                                                              4530
      GO TO 700                                                             4540
C                                                                           4550
C     ..................................................................    4560
C                  SET UP FOR MATRIX INVERSION                              4570
  200 GO TO (1102,1100),IBKT                                                4580
 1100 READ (3)A                                                             4590
      REWIND 3                                                              4600
      GO TO 1104                                                            4610
 1102 DO 1103 II=1,K                                                        4620
      III=II+25                                                             4630
      DO 1103 JJ=1,K                                                        4640
 1103 A(II,JJ)=A(III,JJ)                                                    4650
 1104 DO 202 I=1,K                                                          4660
  202 A(I,I)=A(I,I)+XL                                                      4670
C                  GET INVERSE OF A AND SOLVE FOR DB (J)S                   4680
      IBKM=1                                                                4690
C     ..................................................................    4700
C                  THIS IS THE MATRIX INVERSION ROUTINE                     4710
C                  K IS THE SIZE OF THE MATRIX                              4720
  404 CALL GJR(A,K,ZETA,MSING)                                              4730
      GO TO (415,650), MSING                                                4740
  415 GO TO (416,710), IBKM                                                 4750
C                  END OF MATRIX INVERSION, SOLVE FOR DB(J)                 4760
  416 DO 420 I=1,K                                                          4770
      DB(I)=0.                                                              4780
      DO 421 J=1,K                                                          4790
  421 DB(I)=A(I,J)*G(J)+DB(I)                                               4800
  420 DB(I)=XKDB*DB(I)                                                      4810
      XLL=0.                                                                4820
      DTG = 0.                                                              4830
      GTG = 0.                                                              4840
      DO 250 J=1,K                                                          4850
      XLL=XLL+DB(J)*DB(J)                                                   4860
      DTG = DTG + DB(J)*G(J)                                                4870
      GTG = GTG + G(J)**2                                                   4880
      DB(J)=DB(J)/SA(J)                                                     4890
 250  B(J)=B(J)+DB(J)                                                       4900
      KIP=K-IP                                                              4910
      IF (KIP.EQ.1) GO TO 1257                                              4920
      CGAM=DTG/SQRT(XLL*GTG)                                                4930
      JGAM = 1                                                              4940
      IF(CGAM.GT..0) GOTO 253                                               4950
  251 CGAM = ABS(CGAM)                                                      4960
      JGAM = 2                                                              4970
  253 GAMMA = 57.2957795*(1.5707288+CGAM*(-0.2121144+CGAM*(0.074261         4980
     1-CGAM*.0187293)))*SQRT(1.-CGAM)                                       4990
      GO TO (257,255), JGAM                                                 5000
  255 GAMMA = 180.-GAMMA                                                    5010
      IF (XL.LT.1.0)GO TO 257                                               5020
 1255 WRITE(6,922)XL,GAMMA                                                  5030
      IF(IFSS1.NE.1)GO TO 228                                               5040
      WRITE(12,922)XL,GAMMA                                                 5050
 228  CONTINUE                                                              5060
      GO TO 700                                                             5070
 1257 GAMMA=0.                                                              5080
 257  XLL=SQRT(XLL)                                                         5090
      IBK2=1                                                                5100
      GO TO 300                                                             5110
 252  IF (IFSS3.EQ.0)GO TO 256                                              5120
 254  WRITE (6,904)(DB(J),J=1,K)                                            5130
      IF(IFSS1.NE.1)GO TO 229                                               5140
      WRITE (12,904)(DB(J),J=1,K)                                           5150
 229  CONTINUE                                                              5160
      WRITE (6,905)PHI,XL,GAMMA,XLL                                         5170
      IF(IFSS1.NE.1)GO TO 230                                               5180
      WRITE (12,905)PHI,XL,GAMMA,XLL                                        5190
 230  CONTINUE                                                              5200
  256 GO TO (164,177,194,187),IBK1                                          5210
C                                                                           5220
C     ..................................................................    5230
C                  CALCULATE PHI                                            5240
  300 I=1                                                                   5250
      PHI=0.                                                                5260
      PHIN=0.                                                               5261
      IWHER=2                                                               5270
      IF (IWS5.EQ.0) GO TO 653                                              5280
      CALL SSWTCH(5,NONSK)                                                  5290
      IF(NONSK.EQ.1) GOTO 650                                               5300
  302 GO TO 653                                                             5310
 304  PHI=PHI+(RES**2)                                                      5320
      IF (I.GT.N) GO TO 305                                                 5321
      PHIN=PHIN+RES*RES                                                     5322
 305  I=I+1                                                                 5330
      IF (I.LE.NTILDA) GO TO 302                                            5340
  316 GO TO (252,780,704,762,766,772),IBK2                                  5350
C                                                                           5360
C                                                                           5370
C     ..................................................................    5380
C                  THIS IS THE CONFIDENCE LIMIT CALCULATION                 5390
  700 DO 702 J=1,K                                                          5400
  702 B(J)=BS(J)                                                            5410
      WRITE (6,933)N,K,IP,M,FF,T,E,TAU                                      5420
      IF(IFSS1.NE.1)GO TO 231                                               5430
      WRITE (12,933)N,K,IP,M,FF,T,E,TAU                                     5440
 231  CONTINUE                                                              5450
      IBKA=2                                                                5460
      NTILDA=N                                                              5461
C                  THIS WILL PRINT THE Y,YHAT,DELTA Y                       5470
      ITCT=ITCT-1                                                           5480
      IFSS3=1                                                               5481
      GO TO 61                                                              5482
 704  IF (IFP.LE.0) GO TO 703                                               5490
  705 IBKA=3                                                                5500
      IFP=0                                                                 5510
      GO TO 61                                                              5520
 703  IF (NCONS.EQ.0) GO TO 706                                             5521
      WRITE (6,938) (JJ,CONS(JJ),JJ=1,NCONS)                                5522
      IF (IFSS1.NE.1) GO TO 706                                             5523
      WRITE (12,938) (JJ,CONS(JJ),JJ=1,NCONS)                               5524
  706 WS=N-K+IP                                                             5530
      SE=SQRT(PHI/WS)                                                       5540
      PHIZ=PHI                                                              5550
      IF (IFSS2.EQ.0)GO TO 709                                              5560
 707  WRITE (6,903)PHIZ,SE,XL                                               5570
      IF(IFSS1.NE.1)GO TO 232                                               5580
      WRITE (12,903)PHIZ,SE,XL                                              5590
 232  CONTINUE                                                              5600
      GO TO 708                                                             5610
  709 WRITE(6,909) PHIZ,SE,XL                                               5620
      IF(IFSS1.NE.1)GO TO 233                                               5630
      WRITE (12,909)PHIZ,SE,XL                                              5640
 233  CONTINUE                                                              5650
C                  NOW WE HAVE MATRIX A                                     5660
  708 GO TO (1122,1120),IBKT                                                5670
 1120 WRITE (3)A                                                            5680
      REWIND 3                                                              5690
      GO TO 1124                                                            5700
 1122 DO 1123 II=1,K                                                        5710
      III=II+25                                                             5720
      DO 1123 JJ=1,K                                                        5730
 1123 A(III,JJ)=A(II,JJ)                                                    5740
 1124 IBKM=2                                                                5750
      GO TO 404                                                             5760
C                                                                           5770
C                  NOW WE HAVE C = A INVERSE                                5780
  710 DO 711 J=1,K                                                          5790
      IF(A(J,J).LT..0) GO TO 713                                            5800
 711  SA(J)=SQRT(A(J,J))                                                    5810
      GO TO 715                                                             5820
  713 IBOUT=1                                                               5830
  715 KST=-4                                                                5840
      WRITE (6,916)                                                         5850
      IF(IFSS1.NE.1)GO TO 234                                               5860
      WRITE (12,916)                                                        5870
  234 KST=KST+5                                                             5880
      KEND=KST+4                                                            5890
      IF (KEND.LT.K) GO TO 719                                              5900
      KEND=K                                                                5910
  719 DO 712 I=1,K                                                          5920
      IF(IFSS1.NE.1)GO TO 235                                               5930
      WRITE (12,918)I,(A(I,J),J=KST,KEND)                                   5940
 235  CONTINUE                                                              5950
 712  WRITE (6,918)I,(A(I,J),J=KST,KEND)                                    5960
      IF (KEND.LT.K) GO TO 234                                              5970
      IF (IBOUT.EQ.0) GO TO 717                                             5980
      WRITE (6,936)                                                         5990
      IF (IFSS1.NE.1) GO TO 650                                             6000
      WRITE (12,936)                                                        6010
      GO TO 650                                                             6020
  717 DO 718 I=1,K                                                          6030
      DO 718 J=1,K                                                          6040
      WS=SA(I)*SA(J)                                                        6050
      IF(WS.GT. 0.) GOTO 716                                                6060
  714 A(I,J)=0.                                                             6070
      GO TO 718                                                             6080
  716 A(I,J)=A(I,J)/WS                                                      6090
  718 CONTINUE                                                              6100
      DO 720 J=1,K                                                          6110
  720 A(J,J)=1.                                                             6120
      WRITE (6,917)                                                         6130
      IF(IFSS1.NE.1)GO TO 236                                               6140
      WRITE (12,917)                                                        6150
 236  CONTINUE                                                              6160
      KST=-9                                                                6170
  721 KST=KST+10                                                            6180
      KEND=KST+9                                                            6190
      IF (KEND.LT.K) GO TO 722                                              6200
      KEND=K                                                                6210
  722 DO 724 I=1,K                                                          6220
      IF(IFSS1.NE.1)GO TO 237                                               6230
      WRITE (12,935)I,(A(I,J),J=KST,KEND)                                   6240
 237  CONTINUE                                                              6250
 724  WRITE (6,935)I,(A(I,J),J=KST,KEND)                                    6260
      IF (KEND.LT.K) GO TO 721                                              6270
C                  GET T*SE*SQRT(C(I,I))                                    6280
      DO 726 J=1,K                                                          6290
  726 SA(J)=  SE*SA(J)                                                      6300
      GO TO (1112,1110),IBKT                                                6310
 1110 READ (3)A                                                             6320
      REWIND 3                                                              6330
      GO TO 1114                                                            6340
 1112 DO 1113 II=1,K                                                        6350
      III=II+25                                                             6360
      DO 1113 JJ=1,K                                                        6370
 1113 A(II,JJ)=A(III,JJ)                                                    6380
 1114 CONTINUE                                                              6390
 740  WRITE (6,919)                                                         6400
      IF(IFSS1.NE.1)GO TO 238                                               6410
      WRITE (12,919)                                                        6420
 238  CONTINUE                                                              6430
      WS=K-IP                                                               6440
      DO 750 J=1,K                                                          6450
      IF (IP.LE.0)GO TO 743                                                 6460
  741 DO 742 I=1,IP                                                         6470
      IF (J.EQ.IB(I))GO TO 746                                              6480
  742 CONTINUE                                                              6490
 743  HJTD=SQRT(WS*FF)*SA(J)                                                6500
      STE=SA(J)                                                             6510
      OPL=BS(J)-SA(J)*T                                                     6520
      OPU=BS(J)+SA(J)*T                                                     6530
      SPL=BS(J)-HJTD                                                        6540
      SPU=BS(J)+HJTD                                                        6550
      WRITE ( 6,927)J,STE,OPL,OPU,SPL,SPU                                   6560
      IF(IFSS1.NE.1)GO TO 239                                               6570
      WRITE (12,927)J,STE,OPL,OPU,SPL,SPU                                   6580
 239  CONTINUE                                                              6590
      GO TO 750                                                             6600
 746  WRITE (6,913)J                                                        6610
      IF(IFSS1.NE.1)GO TO 240                                               6620
      WRITE (12,913)J                                                       6630
 240  CONTINUE                                                              6640
  750 CONTINUE                                                              6650
C                  NONLINEAR CONFIDENCE LIMIT                               6660
      IF (IWS6.EQ.1) GO TO 650                                              6670
      WS=K-IP                                                               6680
      WS1=N-K+IP                                                            6690
      PKN=WS/WS1                                                            6700
      PC=PHIZ*(1.+FF*PKN)                                                   6710
      WRITE (6,920)PC                                                       6720
      IF(IFSS1.NE.1)GO TO 241                                               6730
      WRITE (12,920)PC                                                      6740
 241  CONTINUE                                                              6750
      WRITE (6,921)                                                         6760
      IF(IFSS1.NE.1)GO TO 242                                               6770
      WRITE (12,921)                                                        6780
 242  CONTINUE                                                              6790
      IFSS3=1                                                               6800
      DO 790 J=1,K                                                          6810
      IBKP=1                                                                6820
      DO 752 JJ=1,K                                                         6830
  752 B(JJ)=BS(JJ)                                                          6840
      IF (IP.LE.0)GO TO 758                                                 6850
  754 DO 756 JJ=1,IP                                                        6860
      IF (J.EQ.IB(JJ))GO TO 787                                             6870
  756 CONTINUE                                                              6880
  758 DD=-1.                                                                6890
      IBKN=1                                                                6900
  760 D=DD                                                                  6910
      B(J)=BS(J)+D*SA(J)                                                    6920
      IBK2=4                                                                6930
      GO TO 300                                                             6940
  762 PHI1=PHI                                                              6950
      IF (PHI1.GE.PC)GO TO 770                                              6960
  764 D=D+DD                                                                6970
      IF (D/DD.GE.5.)GO TO 788                                              6980
  765 B(J)=BS(J)+D*SA(J)                                                    6990
      IBK2=5                                                                7000
      GO TO 300                                                             7010
  766 PHID=PHI                                                              7020
      IF (PHID.LT.PC)GO TO 764                                              7030
      IF (PHID.GE.PC) GO TO 778                                             7040
  770 D=D/2.                                                                7050
      IF (D/DD.LE..001)GO TO 788                                            7060
  771 B(J)=BS(J)+D*SA(J)                                                    7070
      IBK2=6                                                                7080
      GO TO 300                                                             7090
  772 PHID=PHI                                                              7100
      IF (PHID.GT.PC)GO TO 770                                              7110
  778 XK1=PHIZ/D+PHI1/(1.-D)+PHID/(D*(D-1.))                                7120
      XK2=-(PHIZ*(1.+D)/D+D/(1.-D)*PHI1+PHID/(D*(D-1.)))                    7130
      XK3=PHIZ-PC                                                           7140
      BC = (SQRT(XK2*XK2-4.*XK1*XK3)-XK2)/(2.*XK1)                          7150
      GO TO (779,784),IBKN                                                  7160
  779 B(J)=BS(J)-SA(J)*BC                                                   7170
      GO TO 781                                                             7180
  784 B(J)=BS(J)+SA(J)*BC                                                   7190
  781 IBK2=2                                                                7200
      GO TO 300                                                             7210
  780 GO TO (782,786),IBKN                                                  7220
  782 IBKN=2                                                                7230
      DD=1.                                                                 7240
      BL=B(J)                                                               7250
      PL=PHI                                                                7260
      GO TO 760                                                             7270
  786 BU=B(J)                                                               7280
      PU=PHI                                                                7290
      GO TO (783,795,785,789),IBKP                                          7300
 783  WRITE (6,918) J, BL, PL, BU, PU                                       7310
      IF(IFSS1.NE.1)GO TO 243                                               7320
      WRITE (12,918)J,BL,PL,BU,PU                                           7330
 243  CONTINUE                                                              7340
      GO TO 790                                                             7350
 795  WRITE (6,915) J, BU, PU                                               7360
      IF(IFSS1.NE.1)GO TO 244                                               7370
      WRITE (12,915)J,BU,PU                                                 7380
 244  CONTINUE                                                              7390
      GO TO 790                                                             7400
 785  WRITE (6,918)J,BL, PL                                                 7410
      IF(IFSS1.NE.1)GO TO 245                                               7420
      WRITE (12,918)J,BL,PL                                                 7430
 245  CONTINUE                                                              7440
      GO TO 790                                                             7450
 787  WRITE (6,913)J                                                        7460
      IF(IFSS1.NE.1)GO TO 246                                               7470
      WRITE (12,913)J                                                       7480
 246  CONTINUE                                                              7490
      GO TO 790                                                             7500
 789  WRITE (6,914)J                                                        7510
      IF(IFSS1.NE.1)GO TO 247                                               7520
      WRITE (12,914)J                                                       7530
 247  CONTINUE                                                              7540
      GO TO 790                                                             7550
  788 GO TO (791,792),IBKN                                                  7560
C                  DELETE LOWER PRINT                                       7570
  791 IBKP=2                                                                7580
      GO TO 780                                                             7590
  792 GO TO (793,794),IBKP                                                  7600
C                  DELETE UPPER PRINT                                       7610
  793 IBKP=3                                                                7620
      GO TO 780                                                             7630
C                  LOWER IS ALREADY DELETED, SO DELETE BOTH                 7640
  794 IBKP=4                                                                7650
      GO TO 780                                                             7660
  790 CONTINUE                                                              7670
      GO TO 10                                                              7680
C     ..................................................................    7690
  900 FORMAT (25I3)                                                         7700
  901 FORMAT (7F10.0)                                                       7710
  902 FORMAT(12A6 )                                                         7720
  903 FORMAT (/13X,4H PHI 14X,4H S E             9X,7H LAMBDA   6X,         7730
  9031 25H ESTIMATED PARTIALS USED  / 5X,2E18.8,  E13.3 )                   7740
  904 FORMAT(/12H INCREMENTS 5E18.8/(12X,5E18.8) )                          7750
  905 FORMAT (13X,4H PHI 10X,7H LAMBDA 6X,7H GAMMA  6X, 7H LENGTH  /        7760
