  906 FORMAT(1X,1E9.2,86X,1E9.2 /1X,1H+ 99X,1H+ )                           7780
  907 FORMAT( 5H1N = I3,5X,5H K = I3,5X,5H P = I3,5X,5H M = I3,5X,          7790
  9071 7H IFP = I3,5X,13HGAMMA CRIT = E10.3,5X,6HDEL = E10.3/6H FF =        7800
  9072E10.3,5X,5H T = E10.3,5X,5H E = E10.3,5X,7H TAU = E10.3,5X,6H XL =    7810
  9073  E10.3 , 4X, 7HZETA = E10.3 /)                                       7820
