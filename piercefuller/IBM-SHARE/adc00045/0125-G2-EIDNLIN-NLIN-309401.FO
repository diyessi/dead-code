      SUBROUTINE GJR(A,N,EPS,MSING)                                         0020
C     GAUSS-JORDAN-RUTISHAUSER MATRIX INVERSION WITH DOUBLE PIVOTING.       0030
      DIMENSION A(50,50),B(50),C(50),P(50),Q(50)                            0040
      INTEGER P,Q                                                           0050
      MSING=1                                                               0060
      DO 10 K=1,N                                                           0070
C     DETERMINATION OF THE PIVOT ELEMENT                                    0080
      PIVOT=0.                                                              0090
      DO 20 I=K,N                                                           0100
      DO 20 J=K,N                                                           0110
      IF(ABS(A(I,J))-ABS(PIVOT))20,20,30                                    0120
   30 PIVOT=A(I,J)                                                          0130
      P(K)=I                                                                0140
      Q(K)=J                                                                0150
   20 CONTINUE                                                              0160
      IF(ABS(PIVOT)-EPS)40,40,50                                            0170
C     EXCHANGE OF THE PIVOTAL ROW WITH THE KTH ROW                          0180
   50 IF(P(K)-K)60,80,60                                                    0190
   60 DO 70 J=1,N                                                           0200
      L=P(K)                                                                0210
      Z=A(L,J)                                                              0220
      A(L,J)=A(K,J)                                                         0230
   70 A(K,J)=Z                                                              0240
C     EXCHANGE OF THE PIVOTAL COLUMN WITH THE KTH COLUMN                    0250
   80 IF(Q(K)-K)85,90,85                                                    0260
   85 DO 100 I=1,N                                                          0270
      L=Q(K)                                                                0280
      Z=A(I,L)                                                              0290
      A(I,L)=A(I,K)                                                         0300
  100 A(I,K)=Z                                                              0310
  90  CONTINUE                                                              0320
C     JORDAN STEP                                                           0330
      DO 110 J=1,N                                                          0340
      IF(J-K)130,120,130                                                    0350
  120 B(J)=1./PIVOT                                                         0360
      C(J)=1.                                                               0370
      GO TO 140                                                             0380
  130 B(J)=-A(K,J)/PIVOT                                                    0390
      C(J)=A(J,K)                                                           0400
  140 A(K,J)=0.                                                             0410
  110 A(J,K)=0.                                                             0420
      DO 10 I=1,N                                                           0430
      DO 10 J=1,N                                                           0440
   10 A(I,J)=A(I,J)+C(I)*B(J)                                               0450
C     REORDERING THE MATRIX                                                 0460
      DO 155 M=1,N                                                          0470
      K=N-M+1                                                               0480
      IF(P(K)-K)160,170,160                                                 0490
  160 DO 180 I=1,N                                                          0500
      L=P(K)                                                                0510
      Z=A(I,L)                                                              0520
      A(I,L)=A(I,K)                                                         0530
  180 A(I,K)=Z                                                              0540
  170 IF(Q(K)-K)190,155,190                                                 0550
  190 DO 150 J=1,N                                                          0560
      L=Q(K)                                                                0570
      Z=A(L,J)                                                              0580
      A(L,J)=A(K,J)                                                         0590
  150 A(K,J)=Z                                                              0600
 155  CONTINUE                                                              0610
  151 RETURN                                                                0620
   40 PRINT 45,P(K),Q(K),PIVOT                                              0630
   45 FORMAT(16H0SINGULAR MATRIX3H I=I3,3H J=I3,7H PIVOT=E16.8/)            0640
      MSING=2                                                               0650
      GO TO 151                                                             0660
      END                                                                   0670
