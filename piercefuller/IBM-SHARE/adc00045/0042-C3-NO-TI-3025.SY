NOTI        762 04043                                                   TI   001
*     FAP                                                               TI   002
       COUNT   231                                                      TI   003
       LBL     TI0AK,AK                                                 TI   004
       ENTRY   TI                                                       TI   005
*                  INTEGRAL TRANSFORMATION PROGRAM OF NESBET.         AKTI   006
*             FUNCTION,  CALL BY ANS  =  TI(LFLAG, FIJKL1)              TI   007
*                       WHERE  LFLAG  =  LESS THAN ZERO,  ALARM.        TI   008
*                                        =  -2, ALARM AT ITE3 + 5,      TI   009
*                                                           JFLAG = +1. TI   010
*                                           -3, AT ITG + 4, IFLAG = -1. TI   011
*                                           -4, AT ITG + 4,       = -2. TI   012
*                                           -5, AT ITKB + 7,      = -1. TI   013
*                                           -6, AT ITKB + 7,      = -2. TI   014
*                                     = 0, NORMAL RETURN.               TI   015
*                                     = GREATER THAN ZERO, ALARM.       TI   016
*                                           +1, AT ITKA + 4.            TI   017
*                            A, B, G, D TO BE SPECIFIED.                TI   018
*                                                                       TI   019
 TI    SXD     ITG01,1                                                  TI   020
       SXD     ITG02,2                                                  TI   021
       SXD     ITG1,4                                                   TI   022
       CLA     2,4                                                      TI   023
       STA     ITFA                                                     TI   024
       CLA     IN1A-3        NUMBER OF COLUMNS                          TI   025
       ARS     18                                                       TI   026
       ADD     AABKL         + ADDR ABKL                                TI   027
       STA     ITJA1                                                    TI   028
       STA     ITJF                                                     TI   029
       STA     ITKB                                                     TI   030
       REM              SET UP ABIJ = JP AND RESET IJKL.                TI   031
       AXT     2,1                                                      TI   032
       CLA     ABGD-1,1                                                 TI   033
       STO     JP-1,1                                                   TI   034
       TIX     *-2,1,1                                                  TI   035
       AXT     12,1                                                     TI   036
       CLA     LL+12,1                                                  TI   037
       STO     LD+12,1                                                  TI   038
       TIX     *-2,1,3                                                  TI   039
       AXT     0,1                                                      TI   040
 ITE   SXD     INBLK,1                                                  TI   041
*                                                                       TI   042
*        CONSTRUCT (XAK XBL (+) XAL XBK) * (IJ/KL) = XAKBL, AND         TI   043
*                  (XAI XBJ (+) XAJ XBI) * (IJ/KL) = XAIBJ.             TI   044
*                                                                       TI   045
       LXD     SABGD,2       IF 1, SUPPRESS SECOND SUM OF AB/KL.        TI   046
       TXH     ITE2,2,1      SYMMS AB, GD SAME                          TI   047
       STZ     XAKBL,1                                                  TI   048
 ITE1  CLA     ID            I                                          TI   049
       LDQ     JD            J                                          TI   050
       TRA     ITE3                                                     TI   051
 ITE2  CLA     KD            K                                          TI   052
       LDQ     LD            L                                          TI   053
 ITE3  STO     JP-1                                                     TI   054
       STQ     JP                                                       TI   055
       TSX     $TI2,4                                                   TI   056
       TSX     JFLAG                                                    TI   057
       STO     COM                                                      TI   058
       CLA     JFLAG                                                    TI   059
       TZE     ITE4                                                     TI   060
       CLS     =O2000000     ALARM, INDEX BEYOND GREATEST VALUE IN      TI   061
*                                                          X MATRICES.  TI   062
       TRA     ITL                                                      TI   063
 ITE4  LDQ     COM                                                      TI   064
 ITFA  FMP     0,1          FIJKL1                                      TI   065
       TRA     *+3,2                                                    TI   066
 ITFA1 STO     XAKBL,1                                                  TI   067
 ITFA2 STO     XAIBJ,1                                                  TI   068
       TIX     ITE1,2,1                                                 TI   069
*                                                                       TI   070
*                       STEP UP IJKL                                    TI   071
*                                                                       TI   072
 ITG   TSX     $IT1,4                                                   TI   073
       TSX     IFLAG                                                    TI   074
       CLM                                                              TI   075
       CAS     IFLAG                                                    TI   076
 ITG01 TXI     ITG2,0,0      ALARM.     DECR STORES ORIGINAL IR1,       TI   077
 ITG02 TXI     ITG3,0,0                 DECR STORES ORIGINAL IR2,       TI   078
*                                           BEFORE ENTERING SUBROUTINE. TI   079
 ITG1  TXI     ITGA,0,0      NO MORE CHANGES IN IJ/KL.  DECR ORIG IND 4 TI   080
 ITG2  CLA     IFLAG                                                    TI   081
       SUB     =O2000000                                                TI   082
       TRA     ITL                                                      TI   083
 ITG3  LXD     INBLK,1                                                  TI   084
       TXI     ITE,1,-1      CHANGES ADDRESS FOR IJ/KL TERM             TI   085
 ITGA  AXT     0,1                                                      TI   086
       SXD     ITJB,1                                                   TI   087
       LXD     SABGD,4       IF 1, SYMMS AB, GD DIFF-- SUPPRESS SECOND  TI   088
*                                                          SUM AB/KL.   TI   089
       TXH ITJC,4,1          SYMS AB, GD SAME                           TI   090
       REM                                                              TI   091
       REM              SYMS DIFFERENT, UNSYMMETRICAL RECTANGULAR MATRIXTI   092
       REM                                                              TI   093
       CLA IN1A-3                                                       TI   094
       COM                                                              TI   095
       ADD     =O1000000                                                TI   096
       STD     ITJA          - NUMBER COLUMNS.                          TI   097
       LXD IN1A-3,4          NUMBER COLUMNS                             TI   098
 ITJ   LXD IN1A-6,2          NUMBER ROWS                                TI   099
       CLM                                                              TI   100
       FAD XAIBJ,1                                                      TI   101
 ITJA  TXI *+1,1,0           DECR SET AT ITJ - 2 TO EQUAL - NO. COLUMNS.TI   102
       TIX ITJA-1,2,1                                                   TI   103
 ITJA1 STO 0,4               ADDR, ABKL1 + NUMBER COLUMNS.              TI   104
       TNX ITK,4,1                                                      TI   105
       LXD ITJB,1                                                       TI   106
       TXI *+1,1,-1                                                     TI   107
       SXD ITJB,1                                                       TI   108
 ITJB  TXI ITJ,0,0           = TRA.  DECR, CURRENT STARTING VALUE IND 1 TI   109
       REM                                                              TI   110
       REM              SYMS AB, GD SAME.   SYMMETRICAL HALF MATRIX     TI   111
       REM                                                              TI   112
 ITJC  LXD IN1A-3,2          NUMBER COLUMNS = NUMBER ROWS               TI   113
       SXD ITJD0,2                                                      TI   114
       LXD ITJB,4                                                       TI   115
 ITJD  SXD ITJG,4                                                       TI   116
       CLA ITJF1             - 1 IN DECREMENT                           TI   117
       STD ITJE                                                         TI   118
       LXD IN1A-3,2          NUMBER COLUMNS = NUMBER ROWS               TI   119
       CLM                                                              TI   120
       LXD ITJG,4                                                       TI   121
 ITJD0 TXH ITJE,2,0          DECR STORES TEMP STARTING IND 2            TI   122
       TXL ITJD4,4,0                                                    TI   123
       TXI *+1,4,1                                                      TI   124
       SXD ITJG,4                                                       TI   125
 ITJD3 FAD     XAKBL,1                                                  TI   126
       TXI ITJD0,1,-1                                                   TI   127
 ITJD4 FAD XAIBJ,1                                                      TI   128
 ITJE  TXI *+1,1,0           DECR SET BY ITJD + 2                       TI   129
       TNX ITJE1,2,1                                                    TI   130
       LXD ITJE,4                                                       TI   131
       TXI *+1,4,-1                                                     TI   132
       SXD ITJE,4                                                       TI   133
 ITJE0 TXI     ITJD0-1,0,0   DECR CONTAINS FORTRAN ZERO.                TI   134
 ITJE1 LXD ITJD0,4                                                      TI   135
 ITJF  STO 0,4               ADDR, ABKL1 + NUMBER COLUMNS.              TI   136
       TNX ITK,4,1                                                      TI   137
       SXD ITJD0,4                                                      TI   138
       LXD ITJB,4                                                       TI   139
 ITJF1 TXI *+1,4,-1                                                     TI   140
       SXD ITJB,4                                                       TI   141
       AXT     0,1                                                      TI   142
 ITJG  TXI ITJD,0,0          = TRA.  DECR STORES IND 4                  TI   143
       REM                                                              TI   144
       REM                   FINAL COMPUTATION OF AB/GD                 TI   145
       REM                                                              TI   146
 ITK   STZ     ANS                                                      TI   147
       LXD IN1A-3,4          NUMBER COLUMNS KL                          TI   148
       CLA     IU                                                       TI   149
       STO     ID                                                       TI   150
       CLA     JU                                                       TI   151
       STO     JD                                                       TI   152
       CLA     KL                                                       TI   153
       STO     KD                                                       TI   154
       CLA     LL                                                       TI   155
       STO     LD                                                       TI   156
       CLA     ABGD-1        GAMMA                                      TI   157
       STO     JP-3                                                     TI   158
       CLA     ABGD          DELTA                                      TI   159
       STO     JP-2                                                     TI   160
 ITK1  SXD ITJG,4                                                       TI   161
       CLA     KD                                                       TI   162
       STO     JP-1                                                     TI   163
       CLA     LD                                                       TI   164
       STO     JP                                                       TI   165
 ITKA  TSX     TI2,4         TO GET (XGK XDL (+) XGL XDK)               TI   166
       TSX     JFLAG                                                    TI   167
       STO     COM                                                      TI   168
       CLA     JFLAG                                                    TI   169
       TNZ     ITL           ALARM, INDEX BEYOND GREATEST VALUE IN      TI   170
*                                                          X MATRICES.  TI   171
       LXD ITJG,4                                                       TI   172
       LDQ     COM                                                      TI   173
 ITKB  FMP 0,4               ADDR, ABKL1 + NUMBER COLUMNS.  GIVES       TI   174
*                                 (XGK XDL (+) XGL XDK) * (AB/KL).      TI   175
       FAD     ANS                                                      TI   176
       STO     ANS                                                      TI   177
       REM                                                              TI   178
       REM                   STEP UP ABKL                               TI   179
       REM                                                              TI   180
       TSX IT1,4                                                        TI   181
       TSX     IFLAG                                                    TI   182
       CLM                                                              TI   183
       CAS     IFLAG                                                    TI   184
       TRA     ITKB1         ALARM                                      TI   185
       TRA     ITKB2                                                    TI   186
       TRA ITL               NO MORE CHANGES                            TI   187
 ITKB1 CLA     IFLAG                                                    TI   188
       SUB     =O2000000                                                TI   189
       SUB     =O2000000                                                TI   190
       TRA     ITL                                                      TI   191
 ITKB2 LXD ITJG,4                                                       TI   192
       TIX ITK1,4,1                                                     TI   193
 ITL   LXD     ITG01,1                                                  TI   194
       LXD     ITG02,2                                                  TI   195
       LXD     ITG1,4                                                   TI   196
       STO*    1,4                                                      TI   197
       CLA     ANS                                                      TI   198
       TRA     3,4           FINISHED AND OUT                           TI   199
 AN1   PZE     N10-9                                                    TI   200
 ANS   PZE                   COMPUTED VALUE OF (AB/GD)                  TI   201
 COM   PZE                                                              TI   202
 ONEF  OCT     1000000       FORTRAN 1.                                 TI   203
 IFLAG PZE                                                              TI   204
 JFLAG PZE                                                              TI   205
 INBLK PZE                   DECR, INDEX 1 DEFINING ADDRESS IJ/KL TERM. TI   206
 AABKL PZE     ABKL1                                                    TI   207
 ABKL1 BSS     50                                                       TI   208
 XAIBJ BSS     100      TO STORE (XAI XBJ (+) XAJ XBI)(IJ/KL)           TI   209
 XAKBL BSS     100           TO STORE (XAK XBL (+) XAL XBK)(IJ/KL)      TI   210
 IU    COMMON  1                                                        TI   211
 IL    COMMON  1                                                        TI   212
 ID    COMMON  1                                                        TI   213
 JU    COMMON  1                                                        TI   214
 JL    COMMON  1                                                        TI   215
 JD    COMMON  1                                                        TI   216
 KU    COMMON  1                                                        TI   217
 KL    COMMON  1                                                        TI   218
 KD    COMMON  1                                                        TI   219
 LU    COMMON  1                                                        TI   220
 LL    COMMON  1                                                        TI   221
 LD    COMMON  1                                                        TI   222
 JP    COMMON  4             ABIJ                                       TI   223
 N0    COMMON  1                                                        TI   224
 N10   COMMON  10                                                       TI   225
 X     COMMON  100                                                      TI   226
 ABGD  COMMON  4                                                        TI   227
 IN1A  COMMON  12  -1, -4, -7, -10 DECR, IND 1 DENOTING SYMS OF AI, BJ, TI   228
*                                                               GK, DL  TI   229
*                  -2, -5, -8, -11 NUMBER CASES I, ETC SYM.             TI   230
*                  -3 NUMBER COLUMNS IJKL MATRIX, -6 NUMBER ROWS,       TI   231
*                                      -9 NUMBER TERMS IN MATRIX.       TI   232
 SABGD COMMON  3             DECR, INDEX 2 DENOTING REL SYMMS OF AB, GD.TI   233
*                  1 DIFF-- SUPPRESS SECOND SUM OF AB/KL.  WHOLE MATRIX TI   234
*                                                          RECTANGULAR. TI   235
*                  2 SAME-- INCLUDE SECOND SUM.  WHOLE MATRIX TRIANGULARTI   236
*                       SABGD - 1, COLUMN SUB-MATRIX TYPE (SEE ABOVE).  TI   237
*                       SABGD - 2, ROW    SUB-MATRIX TYPE (SEE ABOVE).  TI   238
       END                                                              TI   239
*     FAP                                                               TI   240
       COUNT   158                                                      TI   241
       LBL     DIM0AK,AK                                                TI   242
       ENTRY   DIM                                                      TI   243
*        SUBROUTINE,  CALL  DIM(KFLAG).     COMPUTES TYPE OF IJ/KL      TI   244
       REM                                                 ASSEMBLY AK  TI   245
*             MATRIX (TRIANGULAR OR RECTANGULAR) FOR AB/GD, NUMBER ROWS,TI   246
*             NUMBER COLUMNS, AND NUMBER ELEMENTS.                      TI   247
*                  BEFORE ENTRY, SET ABGD, N0, NT IN COMMON.            TI   248
*                  NUMBER COLUMNS = DECR IN1A - 3,                      TI   249
*                  NUMBER ROWS    = DECR IN1A - 6,                      TI   250
*                  NUMBER ELEMENTS, DECR IN1A - 9.                      TI   251
*                  DECR SABGD DENOTES WHOLE MATRIX RECTANGULAR IF 1,    TI   252
*                                                  TRIANGULAR IF 2.     TI   253
*                       SABGD - 1, COLUMN SUB-MATRIX TYPE (SEE ABOVE).  TI   254
*                       SABGD - 2, ROW    SUB-MATRIX TYPE (SEE ABOVE).  TI   255
*                                                                       TI   256
*                  IF KFLAG  =  0, NORMAL RETURN.                       TI   257
*                            =  -1 ALARM AT ITCA, PARAMETER BEYOND SYMM TI   258
*                                                               LIMITS. TI   259
*                                                                       TI   260
 DIM   SXD     ITC1,1                                                   TI   261
       SXD     ITD1,2                                                   TI   262
 ITA   CLA     ABGD-3        ALPHA                                      TI   263
       STO     ID                                                       TI   264
 ITAA  CLA     ABGD-2        BETA                                       TI   265
       STO     JD                                                       TI   266
 ITAB  CLA     ABGD-1        GAMMA                                      TI   267
       STO     KD                                                       TI   268
 ITAC  CLA     ABGD          DELTA                                      TI   269
       STO     LD                                                       TI   270
       LXD     N0,1                                                     TI   271
       PXA     0,1                                                      TI   272
       ADD     AN1                                                      TI   273
       STA     ITC                                                      TI   274
*                                                                       TI   275
*        SET UP LOWER AND UPPER LIMITS OF INDICES AND  COMPARE SYMMETRY.TI   276
*                                                                       TI   277
       AXT     0,2                                                      TI   278
 ITB   CLM                                                              TI   279
 ITB1  STO     LD+10,2       IL = 0, JL = 0, ETC.                       TI   280
 ITC   ADD     0,1           ADDR, N1 + N0                              TI   281
       CAS     LD+9,2        ID, JD, ETC.                               TI   282
 ITC1  TXI     ITD,0,0       = TRA.  DECR STORES ORIGINAL IND 1         TI   283
       NOP                                                              TI   284
       TIX     ITB1,1,1                                                 TI   285
       CLS     =O1000000     ALARM                                      TI   286
 ITCA  TRA     ITL           OUT                                        TI   287
 ITD   SUB     =O1000000                                                TI   288
       STO     LD+11,2       IU, JU, ETC.                               TI   289
       CLA     LD+10,2       IL, ETC.                                   TI   290
       STO     LD+9,2        ID, ETC.                                   TI   291
       PXD     0,1                                                      TI   292
       STD     IN1A-1,2                                                 TI   293
       TXI     *+1,2,3                                                  TI   294
       LXD     N0,1                                                     TI   295
       TXL     ITB,2,9                                                  TI   296
       CLA     IN1A-1        SYM INDEX FOR A                            TI   297
       SUB     IN1A-7        - SYM INDEX FOR G                          TI   298
       TZE     *+3                                                      TI   299
 ITD0  CLA     =O1000000     SYMMS AB, GD DIFFERENT                     TI   300
 ITD1  TXI     ITDA,0,0      DECR STORES ORIGINAL INDEX 2               TI   301
       CLA     IN1A-4        SYM INDEX FOR B                            TI   302
       SUB IN1A-10           - SYM INDEX FOR D                          TI   303
       TNZ     ITD0          SYMMS B, D DIFF.                           TI   304
       CLA     =O2000000     SYMMS AB, GD SAME                          TI   305
 ITDA  STO SABGD                                                        TI   306
*                                                                       TI   307
*        FIND NUMBER ROWS, COLUMNS, ELEMENTS OF IJ/KL FOR SYMMETRY      TI   308
*                                                CLASS OF AB/GD.        TI   309
*                                                                       TI   310
       AXT     12,1                                                     TI   311
 ITHC  CLA     LD+14,1       LU, ETC.                                   TI   312
       SUB     LD+13,1       - LL, ETC.                                 TI   313
       ADD     =O1000000     NUMBER CASES L, ETC. SYM.                  TI   314
       STO     IN1A+1,1                                                 TI   315
       TIX     ITHC,1,3                                                 TI   316
       CLA     IN1A-1        SYM IND FOR A OR I                         TI   317
       SUB     IN1A-4        - SYM IND FOR B OR J                       TI   318
       TNZ     ITHF          RECTANGULAR ROW SUB-MATRIX.                TI   319
       CLA     =O2000000     TRIANGULAR ROW SUB-MATRIX.                 TI   320
       STO     SABGD-2                                                  TI   321
       CLA     IN1A-2        NUMBER CASES, NA, FOR A SYMMETRY.          TI   322
       ADD     =O1000000     NA + 1                                     TI   323
       STO     COM                                                      TI   324
       LDQ     COM                                                      TI   325
 ITHD  MPY     IN1A-2        * NUMBER CASES FOR A SYM, (NA + 1)*NA, Q34 TI   326
       LRS     19            Q53.   (NA + 1)*NA/2, Q17.                 TI   327
 ITHD1 STQ     IN1A-6        NUMBER ROWS OF MATRIX.                     TI   328
       LXD     SABGD,2                                                  TI   329
       TXH     ITI,2,1       SYMMS AB, GD SAME.   INCLUDE SECOND SUM    TI   330
*                            OF AB/KL.  MAIN MATRIX WILL BE TRIANGULAR. TI   331
       CLA     IN1A-7        SYM IND FOR K                              TI   332
       SUB     IN1A-10       - SYM INDEX FOR L                          TI   333
       TNZ     ITHG          RECTANGULAR COLUMN SUB-MATRIX.             TI   334
       CLA     =O2000000     TRIANGULAR COLUMN SUB-MATRIX.              TI   335
       STO     SABGD-1                                                  TI   336
       CLA     IN1A-8        NUMBER CASES FOR K SYM                     TI   337
       ADD     =O1000000                                                TI   338
       STO     COM                                                      TI   339
       LDQ     COM                                                      TI   340
 ITHE  MPY     IN1A-8        * NUMBER CASES FOR L SYM                   TI   341
       LRS     19                                                       TI   342
 ITHE1 STQ     IN1A-3        NUMBER COLUMNS OF MATRIX.                  TI   343
       LLS     1                                                        TI   344
       TRA     ITIA                                                     TI   345
 ITHF  CLA     =O1000000     RECTANGULAR ROW SUB-MATRIX.                TI   346
       STO     SABGD-2                                                  TI   347
       LDQ     IN1A-2                                                   TI   348
       MPY     IN1A-5                                                   TI   349
       LRS     18                                                       TI   350
       TRA     ITHD1                                                    TI   351
 ITHG  CLA     =O1000000     RECTANGULAR COLUMN SUB-MATRIX.             TI   352
       STO     SABGD-1                                                  TI   353
       LDQ     IN1A-8                                                   TI   354
       MPY     IN1A-11                                                  TI   355
       LRS     18                                                       TI   356
       TRA     ITHE1                                                    TI   357
 ITI   STQ     IN1A-3        NUMBER COLUMNS OF MAIN MATRIX, WHICH IS    TI   358
*                                                          TRIANGULAR.  TI   359
       CLA     SABGD-2                                                  TI   360
       STO     SABGD-1                                                  TI   361
       CLA     IN1A-3                                                   TI   362
       ADD     =O1000000                                                TI   363
       STO     COM                                                      TI   364
       LDQ     COM           Q17                                        TI   365
 ITIA  MPY     IN1A-6        * NUMBER OF ROWS.   Q34.                   TI   366
       LRS     19            DIVIDED BY 2,  Q52.                        TI   367
       STQ     IN1A-9        NUMBER ELEMENTS OF MATRIX, Q17.            TI   368
 ITE1  CLM                                                              TI   369
 ITL   STO*    1,4                                                      TI   370
       LXD     ITC1,1                                                   TI   371
       LXD     ITD1,2                                                   TI   372
       TRA     2,4           RETURN                                     TI   373
 AN1   PZE     N10-9                                                    TI   374
 COM   PZE                                                              TI   375
 IU    COMMON  1                                                        TI   376
 IL    COMMON  1                                                        TI   377
 ID    COMMON  1                                                        TI   378
 JU    COMMON  1                                                        TI   379
 JL    COMMON  1                                                        TI   380
 JD    COMMON  1                                                        TI   381
 KU    COMMON  1                                                        TI   382
 KL    COMMON  1                                                        TI   383
 KD    COMMON  1                                                        TI   384
 LU    COMMON  1                                                        TI   385
 LL    COMMON  1                                                        TI   386
 LD    COMMON  1                                                        TI   387
 JP    COMMON  4             ABIJ                                       TI   388
 N0    COMMON  1                                                        TI   389
 N10   COMMON  10                                                       TI   390
 X     COMMON  100                                                      TI   391
 ABGD  COMMON  4                                                        TI   392
 IN1A  COMMON  12  -1, -4, -7, -10 DECR, IND 1 DENOTING SYMS OF AI, BJ, TI   393
*                                                               GK, DL  TI   394
*                  -2, -5, -8, -11 NUMBER CASES I, ETC SYM.             TI   395
*                  -3 NUMBER COLUMNS IJKL MATRIX, -6 NUMBER ROWS,       TI   396
*                                      -9 NUMBER TERMS IN MATRIX.       TI   397
 SABGD COMMON  3             DECR, INDEX 2 DENOTING REL SYMMS OF AB, GD.TI   398
*                  1 DIFF-- SUPPRESS SECOND SUM OF AB/KL.  WHOLE MATRIX TI   399
*                                                          RECTANGULAR. TI   400
*                  2 SAME-- INCLUDE SECOND SUM.  WHOLE MATRIX TRIANGULARTI   401
*                       SABGD - 1, COLUMN SUB-MATRIX TYPE (SEE ABOVE).  TI   402
*                       SABGD - 2, ROW    SUB-MATRIX TYPE (SEE ABOVE).  TI   403
       END                                                              TI   404
*     FAP                                                               TI   405
       COUNT   85                                                       TI   406
       LBL     IT10AK,AK                                                TI   407
       ENTRY   IT1                                                      TI   408
*                                                                       TI   409
*             COUNTING SUBROUTINE, EXTENDED TO COVER RECTANGULAR        TI   410
*                                                          MATRICES, AK.TI   411
*                                                                       TI   412
*                  CALL  IT1(IFLAG)   WHERE                             TI   413
*                      IFLAG = 0, FOR NORMAL EXIT                       TI   414
*                            = LESS THAN ZERO, FOR ALARM                TI   415
*                                 -1, C ILLEGALLY GREATER THAN A        TI   416
*                                 -2, B, C, OR D ILLEGALLY GREATER THAN TI   417
*                                           ADJUSTED UPPER LIMIT.       TI   418
*                            = GREATER THAN ZERO, FOR NO MORE CHANGES.  TI   419
*                  COMMON STORED IN ORDER, -11 D, -10 DL, -9 DU,        TI   420
*                       -8 C, -7 CL, -6 CU, -5 B, -4 BL, -3 BU,         TI   421
*                       -2 A, -1 AL, AU                                 TI   422
*                  PRESET SABGD, -1, -2 TO DEFINE WHETHER MATRICES      TI   423
*                                      ARE TRIANGULAR OR RECTANGULAR.   TI   424
*                                                                       TI   425
 IT1   SXD IT1G1,1           SAVE INDEX 1                               TI   426
       SXD IT1G2,2           SAVE INDEX 2                               TI   427
       SXD     IT1G4,4       SAVE INDEX 4                               TI   428
 IT1A  AXT     12,1                                                     TI   429
       CLA     AU+3,1                  DU, ETC                          TI   430
       STO COMMON+12,1                 DU, ETC                          TI   431
       TIX IT1A+1,1,3                                                   TI   432
 IT1A1 CLA     AU-2                    A                                TI   433
       CAS COMMON+6                    BU                               TI   434
       TRA IT1B                                                         TI   435
       TRA IT1B                                                         TI   436
       LXD     SABGD-2,2                                                TI   437
       TXL     IT1B,2,1      RECTANGULAR ROW SUB-MATRIX.                TI   438
       STO COMMON+6          CHANGE BU TO A IF A LESS THAN BU           TI   439
 IT1B  LXD     SABGD,2                                                  TI   440
       CAS COMMON+3          CU                                         TI   441
       TRA IT1C                                                         TI   442
       TRA IT1C                                                         TI   443
       TXL     IT1D,2,1      RECTANGULAR WHOLE MATRIX.                  TI   444
       STO COMMON+3          CHANGE CU TO A IF A LESS THAN CU           TI   445
 IT1C  CAS     AU-8                    C                                TI   446
       TRA IT1D              OK                                         TI   447
       TXH     IT1G,2,1      COMPARE B AND DU IF WHOLE MATRIX TRIANGULARTI   448
       TXL     IT1D,2,1                                                 TI   449
       CLS     =O1000000     ALARM, C ILLEGALLY GREATER THAN A          TI   450
       STO*    1,4                                                      TI   451
       TRA     IT1E5                                                    TI   452
 IT1D  CLA     AU-8                    C                                TI   453
       CAS COMMON            DU                                         TI   454
       TRA IT1E                                                         TI   455
       TRA IT1E                                                         TI   456
       LXD     SABGD-1,2                                                TI   457
       TXL     IT1E,2,1      RECTANGULAR COLUMN SUB-MATRIX.             TI   458
       STO COMMON            CHANGE DU TO C IF C LESS THAN DU           TI   459
 IT1E  AXT     12,1                                                     TI   460
       PXD 0,1                                                          TI   461
       PDX 0,2                                                          TI   462
       CLA COMMON+12,1                 DU, ETC.                         TI   463
 IT1E1 SUB     AU+1,1                  - D, ETC.                        TI   464
       TZE IT1F                                                         TI   465
       TPL     *+4                                                      TI   466
       CLS     =O2000000     ALARM, D ILLEGALLY GREATER THAN DU         TI   467
       STO*    1,4                                                      TI   468
       TRA     IT1E5                                                    TI   469
       CLA     =O1000000                                                TI   470
 IT1E2 ADD     AU+1,1                  + D, ETC.                        TI   471
       STO     AU+1,1                  D INCREASED BY 1                 TI   472
       TXH IT1E4,2,11                                                   TI   473
 IT1E3 CLA     AU-1,2                  DL, ETC., SPECIAL                TI   474
       STO     AU-2,2                  = D, ETC., SPECIAL               TI   475
       TXI *+1,2,3                                                      TI   476
       TXL IT1E3,2,11                                                   TI   477
 IT1E4 STZ*    1,4                                                      TI   478
 IT1E5 LXD IT1G1,1                                                      TI   479
       LXD IT1G2,2                                                      TI   480
       TRA     2,4                     OUT                              TI   481
 IT1F  TIX IT1E+1,1,3                                                   TI   482
       CLA     =O1000000               NO MORE CHANGES                  TI   483
       STO*    1,4                                                      TI   484
       TRA     IT1E5                                                    TI   485
 IT1G  CLA     AU-5                    B                                TI   486
       CAS COMMON            DU                                         TI   487
 IT1G1 TXI IT1D,0,0          = TRA.  DECREMENT SAVES INDEX 1            TI   488
 IT1G2 TXI IT1D,0,0          = TRA.  DECREMENT SAVES INDEX 2            TI   489
       STO COMMON                                                       TI   490
 IT1G4 TXI IT1D,0,0          = TRA.  DECREMENT SAVES INDEX 4            TI   491
COMMON BSS     12                                                       TI   492
 AU    COMMON  12                                                       TI   493
 JP    COMMON  4             ABIJ                                       TI   494
 N0    COMMON  1                                                        TI   495
 N10   COMMON  10                                                       TI   496
 X     COMMON  100                                                      TI   497
 ABGD  COMMON  4                                                        TI   498
 IN1A  COMMON  12  -1, -4, -7, -10 DECR, IND 1 DENOTING SYMS OF AI, BJ, TI   499
*                                                               GK, DL  TI   500
*                  -2, -5, -8, -11 NUMBER CASES I, ETC SYM.             TI   501
*                  -3 NUMBER COLUMNS IJKL MATRIX, -6 NUMBER ROWS,       TI   502
*                                      -9 NUMBER TERMS IN MATRIX.       TI   503
 SABGD COMMON  3             DECR, INDEX 2 DENOTING REL SYMMS OF AB, GD.TI   504
*                  1 DIFF-- SUPPRESS SECOND SUM OF AB/KL.  WHOLE MATRIX TI   505
*                                                          RECTANGULAR. TI   506
*                  2 SAME-- INCLUDE SECOND SUM.  WHOLE MATRIX TRIANGULARTI   507
*                       SABGD - 1, COLUMN SUB-MATRIX TYPE (SEE ABOVE).  TI   508
*                       SABGD - 2, ROW    SUB-MATRIX TYPE (SEE ABOVE).  TI   509
       END                                                              TI   510
*     FAP                                                               TI   511
       COUNT   118                                                      TI   512
       LBL     IT20AK,AK                                                TI   513
       ENTRY   TI2                                                      TI   514
*                                                                       TI   515
*                  COMPUTATION OF XAI XBJ (+) XAJ XBI.            TI2,AKTI   516
*                                                                       TI   517
*             FUNCTION,  ANS  =  TI2(JFLAG)   WHERE                     TI   518
*                                JFLAG =  0 FOR NORMAL RETURN,          TI   519
*                                      =  1 FOR ALARM.  INDEX BEYOND    TI   520
*                                           GREATEST VALUE IN X MATRICESTI   521
*             REQUIRES INDEX NUMBERS TO START WITH ZERO.                TI   522
*             REQUIRES JP TO BE SET BEFORE ENTERING SUBROUTINE.         TI   523
*             DOES NOT USE AU, ETC.                                     TI   524
*                                                                       TI   525
 TI2   SXD     2A11,1                  SAVES INDEX 1                    TI   526
       SXD     IT2E+1,2                SAVES INDEX 2                    TI   527
       STZ     C                                                        TI   528
       AXT     4,1                                                      TI   529
 IT2Z  CLA     JP+1,1                  A, ETC.                          TI   530
       STO     ADIFF+4,1                                                TI   531
       TIX     IT2Z,1,1                                                 TI   532
       STZ     NTSSI                                                    TI   533
       STZ     NTSSJ                                                    TI   534
       AXT     4,2                                                      TI   535
       CLA     N0                      NUMBER ITEMS                     TI   536
       ARS 18                                                           TI   537
       ADD     AN1                     N0 + LOC N1                      TI   538
       STA IT2A+1                                                       TI   539
       STA IT2A+2                                                       TI   540
       STA     2A07                                                     TI   541
       STA     2B17                                                     TI   542
       STA     2B37                                                     TI   543
       LXD     N0,1                                                     TI   544
 IT2A  TXH     2A06,2,2                                                 TI   545
       LDQ     0,1      N0 + LOC N1 = NT, ETC    Q 17                   TI   546
       MPY     0,1      DITTO GIVES NT SQ, ETC.    Q 34                 TI   547
       LLS     17                                                       TI   548
       ADD NTSSI+2,2                   SUM SQ NT FOR I, J               TI   549
       STO NTSSI+2,2                                                    TI   550
 2A06  CLA ADIFF+4,2                                                    TI   551
 2A07  SUB 0,1          N0 + LOC N1  = - NT                             TI   552
       STO ADIFF+4,2                   ADIFF, BDIFF, IDIFF, JDIFF       TI   553
       TMI     2A12                                                     TI   554
       TIX IT2A,1,1                                                     TI   555
 2A11  TXI IT2D,0,0     ERROR.  INDEX BEYOND GREATEST VALUE IN X        TI   556
*                            MATRICES.    DECR CONTAINS OLD INDEX 1.    TI   557
 2A12  PXD 0,1                                                          TI   558
       STD AIND+4,2                    AIND, BIND, IIND, JIND           TI   559
       TIX IT2A-1,2,1                                                   TI   560
       CLA IDIFF                                                        TI   561
       STO IDIFF+2                                                      TI   562
       CLA NTSSI                                                        TI   563
       STO NTSSI+2                                                      TI   564
       CLA IIND                                                         TI   565
       STO IIND+2                      IIND REPEATED                    TI   566
       AXT     2,2                                                      TI   567
       CLA AIND                                                         TI   568
       SUB BIND                                                         TI   569
       TNZ IT2C                        A, B BELONG TO DIFF SYMMETRY     TI   570
 IT2A2 CLA     JP-1                    I                                TI   571
       SUB     JP                      - J                              TI   572
       TZE IT2C                        I = J                            TI   573
 IT2B1 CLA AIND                                                         TI   574
       PDX 0,1                                                          TI   575
       SUB JIND+2,2                                                     TI   576
       TNZ IT2E                        XAJ = 0                          TI   577
       CLA     =O1000000               Q 17                             TI   578
       ADD ADIFF                       + A DIFF                         TI   579
       XCA                                                              TI   580
 2B17  MPY     0,1      N0 + LOC N1  =  * NT.     Q 34                  TI   581
       LLS     17                      Q 17                             TI   582
       ADD NTSSJ+2,2                                                    TI   583
       ADD JDIFF+2,2                                                    TI   584
       ARS     18                                                       TI   585
       ADD     AX1                     + ADDR X1                        TI   586
       STA IT2B4                       ADDRESS FOR X AJ OR X AI         TI   587
 IT2B3 CLA BIND                                                         TI   588
       PDX 0,1                                                          TI   589
       SUB IIND+2,2                                                     TI   590
       TNZ IT2E                        XBI = 0                          TI   591
       CLA     =O1000000                                                TI   592
       ADD BDIFF                       + B DIFF                         TI   593
       XCA                                                              TI   594
 2B37  MPY     0,1      N0 + LOC N1  =  * NT                            TI   595
       LLS     17                                                       TI   596
       ADD NTSSI+2,2                                                    TI   597
       ADD IDIFF+2,2                                                    TI   598
       ARS     18                                                       TI   599
       ADD     AX1                     + ADDR X1                        TI   600
       STA IT2B4+1                     ADDRESS FOR X BI OR X BJ         TI   601
 IT2B4 LDQ 0                           X AJ                             TI   602
       FMP 0                           * X BI                           TI   603
       FAD     C                                                        TI   604
       STO     C                                                        TI   605
 IT2C  TIX IT2B1,2,1                                                    TI   606
 IT2C1 STZ*    1,4                                                      TI   607
 IT2C2 LXD     2A11,1                                                   TI   608
       LXD IT2E+1,2                                                     TI   609
       TRA     2,4                     FINISHED                         TI   610
 IT2D  CLA     =O1000000     ALARM, ERROR AT 2A11                       TI   611
       STO*    1,4                                                      TI   612
       TRA     IT2C2                                                    TI   613
 IT2E  CLM                                                              TI   614
       TXI IT2B4+2,0,0                 = TRA, DECR OLD INDEX 2          TI   615
 C     PZE                                                              TI   616
 ADIFF PZE                             A DIFF                           TI   617
 BDIFF PZE                             B DIFF                           TI   618
 IDIFF PZE                             I DIFF                           TI   619
 JDIFF PZE                             J DIFF                           TI   620
       PZE                             I DIFF REPEATED                  TI   621
 NTSSI PZE                             SUM SQ NT FOR I                  TI   622
 NTSSJ PZE                             SUM SQ NT FOR J                  TI   623
       PZE                             S SQ NT FOR I REPEATED           TI   624
 AIND  PZE                             A INDEX                          TI   625
 BIND  PZE                             B INDEX                          TI   626
 IIND  PZE                             I INDEX                          TI   627
 JIND  PZE                             J INDEX                          TI   628
       PZE                             I INDEX REPEATED                 TI   629
 AN1   PZE     N10-9                   ADDRESS N1                       TI   630
 AX1   PZE     X-99                    ADDRESS X1                       TI   631
 AU    COMMON  12            D, DL, DU, C, CL, CU, B, BL, BU, A, AL, AU TI   632
 JP    COMMON  4                  A, B, I, J                            TI   633
 N0    COMMON  1                                                        TI   634
 N10   COMMON  10                                                       TI   635
 X     COMMON  100                                                      TI   636
       END                                                              TI   637
*     LIST  8                                                           TI   638
*     LABEL                                                             TI   639
C136082                                                                 TI   640
C                                                                       TI   641
C        TO INVERT STORAGE OF 1 DIMENSIONAL ARRAY TO ACCORD WITH SOS.   TI   642
C                  NA IS ACTUAL DIMENSION OF A, N0 IS NUMBER USED.      TI   643
C                                                                       TI   644
      SUBROUTINE  INVERT(A, NA, N0)                                     TI   645
      DIMENSION  A(100)                                                 TI   646
      NC  =  NA/2                                                       TI   647
      L  =  XMIN0F(NC, N0)                                              TI   648
      DO 10                  I  =  1, L                                 TI   649
      K  =  NA + 1 - I                                                  TI   650
      T  =  A(I)                                                        TI   651
      A(I)  =  A(K)                                                     TI   652
10    A(K)  =  T                                                        TI   653
      RETURN                                                            TI   654
      END                                                               TI   655
*     LIST  8                                                           TI   656
*     LABEL                                                             TI   657
C13608K                                                                 TI   658
C                                                                       TI   659
C                            CHECK OUT OF IT1/TI, AK                    TI   660
C                                                                       TI   661
C                  SET INDR  =  1, TO CHECK OUT IT1-- SAME SYMM LIST.   TI   662
C                            =  2, TO CHECK OUT IT1-- NEW  PROBLEM.     TI   663
C                            =  3, TO CHECK OUT TI -- SAME SYMM LIST.   TI   664
C                            =  4, TO CHECK OUT TI -- NEW PROBLEM.      TI   665
C                                                                       TI   666
      COMMON  IU,                                                       TI   667
C             IU, IL, ID, JU, JL, JD, KU, KL, KD, LU, LL, LD,           TI   668
     1   JP, N0,  N10,  X,     IABGD,         IN1A, SABGD               TI   669
      DIMENSION         N10(10),  X(100), FIJKL(100), IABGD(4),         TI   670
     1   IU(12), JP(4),           IN1A(12), SABGD(3)                    TI   671
3     WRITE OUTPUT TAPE 6, 5                                            TI   672
5     FORMAT  (////)                                                    TI   673
7     READ INPUT TAPE 5, 10, N0 ,  (N10 (I),   I  =  1, N0 )            TI   674
10    FORMAT  (14I5)                                                    TI   675
      WRITE OUTPUT TAPE 6, 20, (N10 (I),  I  =  1, N0 )                 TI   676
20    FORMAT  (1X, 15HDIMENSION LIST, 23I5//)                           TI   677
      ISSNT  =  0                                                       TI   678
      DO  25                 I  =  1, N0                                TI   679
25    ISSNT  = (N10 (I))**2  +  ISSNT                                   TI   680
      CALL INVERT(N10, 10, N0)                                          TI   681
30    READ INPUT TAPE 5, 32, (X(I),  I  =  1, ISSNT)                    TI   682
32    FORMAT  (7E10.8)                                                  TI   683
      WRITE OUTPUT TAPE 6, 5                                            TI   684
      WRITE OUTPUT TAPE 6, 34, (X(I),    I  =  1, ISSNT)                TI   685
34    FORMAT  (3X, 9HX MATRIX,  8E15.8)                                 TI   686
      CALL INVERT(X, 100, ISSNT)                                        TI   687
37    READ INPUT TAPE 5, 40,IABGD(4),IABGD(3),IABGD(2),IABGD(1), INDR   TI   688
40    FORMAT  (5I5)                                                     TI   689
      CALL  DIM(KFLAG)                                                  TI   690
      IF  (KFLAG)            150, 43, 43                                TI   691
43    WRITE OUTPUT TAPE 6, 47,IABGD(4),IABGD(3),IABGD(2),IABGD(1),      TI   692
     1 (IU(I+1), IU(I),   I  =  1, 12, 3), INDR                         TI   693
47    FORMAT  (1H0   5X, I5, 2H A I5, 2H B I5, 2H G I5, 2H D I10, 3H AL TI   694
     1 I5, 3H AU I10, 3H BL I5, 3H BU I10, 3H GL I5, 3H GU I10, 3H DL   TI   695
     2  I5, 3H DU  I5, 5H INDR)                                         TI   696
      GO TO (70, 70, 50, 50),     INDR                                  TI   697
50    ISSNM  =  IN1A(10)                                                TI   698
      READ INPUT TAPE 5, 32, (FIJKL(I),   I  =  1, ISSNM)               TI   699
      WRITE OUTPUT TAPE 6, 5                                            TI   700
      WRITE OUTPUT TAPE 6, 55, (FIJKL(I),   I  =  1, ISSNM)             TI   701
55    FORMAT  (12H IJKL MATRIX  8E15.8)                                 TI   702
      CALL INVERT(FIJKL, 100, ISSNM)                                    TI   703
      GO TO (70, 70, 90, 90),     INDR                                  TI   704
70    WRITE OUTPUT TAPE 6, 75,  (IU(I),   I = 3, 12, 3), (IU(I+1),      TI   705
     1   IU(I),   I = 1, 12, 3), INDR                                   TI   706
75    FORMAT  (1H0   5X, I5, 2H I I5, 2H J I5, 2H K I5, 2H L I10, 3H IL TI   707
     1 I5, 3H IU I10, 3H JL I5, 3H JU I10, 3H KL I5, 3H KU I10, 3H LL   TI   708
     2  I5, 3H LU  I5, 5H INDR)                                         TI   709
      CALL  IT1(IFLAG)                                                  TI   710
      IF  (IFLAG)            85, 70, 80                                 TI   711
80    GO TO (37, 3),         INDR                                       TI   712
85    IF  (IFLAG + 1)        125, 140, 140                              TI   713
90    ANS  =  TI(LFLAG, FIJKL(100))                                     TI   714
      IF  (LFLAG)           160, 95, 160                                TI   715
95    WRITE OUTPUT TAPE 6,100, ANS,IABGD(4),IABGD(3),IABGD(2),IABGD(1)  TI   716
100   FORMAT (//20X, E15.8, 33H TRANSFORMED INTEGRAL FOR ALPHA = I5,    TI   717
     1   8H, BETA = I5,   11H, GAMMA =  I5,   9H, DELTA =    I5)        TI   718
      IU(3)  = IABGD(4)                                                 TI   719
      IU(6)  = IABGD(3)                                                 TI   720
      IU(9)  = IABGD(2)                                                 TI   721
      IU(12) = IABGD(1)                                                 TI   722
      CALL  IT1(IFLAG)                                                  TI   723
      IF  (IFLAG)            120, 110, 105                              TI   724
105   GO TO  (37, 37, 37, 3),     INDR                                  TI   725
110   IABGD(4)  =  IU(3)                                                TI   726
      IABGD(3)  =  IU(6)                                                TI   727
      IABGD(2)  =  IU(9)                                                TI   728
      IABGD(1)  =  IU(12)                                               TI   729
      GO TO 90                                                          TI   730
120   IF  (IFLAG + 1)        125, 140, 140                              TI   731
125   WRITE OUTPUT TAPE 6, 130                                          TI   732
130   FORMAT  ( 58H0    B, C OR D ILLEGALLY GREATER THAN ADJUSTED UPPER TI   733
     1LIMIT)                                                            TI   734
      CALL  EXIT                                                        TI   735
140   WRITE OUTPUT TAPE 6, 145                                          TI   736
145   FORMAT  ( 37H0          C ILLEGALLY GREATER THAN A)               TI   737
      CALL  EXIT                                                        TI   738
150   WRITE OUTPUT TAPE 6, 155, KFLAG                                   TI   739
155   FORMAT  ( 35H0   ALARM RETURN FROM DIM.  KFLAG =   I5///)         TI   740
      CALL  EXIT                                                        TI   741
160   WRITE OUTPUT TAPE 6, 165, LFLAG                                   TI   742
165   FORMAT  ( 35H0   ALARM RETURN FROM TI.   LFLAG =   I5///)         TI   743
      CALL  EXIT                                                        TI   744
      END                                                               TI   745
