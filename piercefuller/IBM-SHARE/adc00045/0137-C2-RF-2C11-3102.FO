$IBFTC DNEWR   LIST,REF,XR5                                             2C110000
      SUBROUTINE DNEWRA(M,C,R,MAX,EPS,ZERO,GG,KE)                       2C110010
      DIMENSION C(1),R(1),GG(2),G(4),S(2),T(2),X(2)                     2C110020
      DOUBLE PRECISION C,R,S,T,X,P,Q,G                                  2C110030
      DATA G(3),G(4)/.1D0,.1D0/                                         2C110040
      KE=0                                                              2C110050
      N=M                                                               2C110060
      S(1)=C(1)                                                         2C110070
      S(2)=C(2)                                                         2C110080
      Q=S(1)**2+S(2)**2                                                 2C110090
      IF(N.NE.1) GO TO 5                                                2C110100
      R(1)=-(S(1)*C(3)+S(2)*C(4))/Q                                     2C110110
      R(2)=(S(2)*C(3)-S(1)*C(4))/Q                                      2C110120
      GO TO 200                                                         2C110130
    5 L=0                                                               2C110140
      KR=0                                                              2C110150
      KT=0                                                              2C110160
      EN=N                                                              2C110170
      G(1)=GG(1)                                                        2C110180
      G(2)=GG(2)                                                        2C110190
      CM=(C(2*N+1)**2+C(2*N+2)**2)/Q                                    2C110200
      IF(CM.NE.0.) GO TO 10                                             2C110210
      CM=1.                                                             2C110220
      R(1)=0.D0                                                         2C110230
      R(2)=0.D0                                                         2C110240
      G(1)=.1D0                                                         2C110250
      L=1                                                               2C110260
   10 DO 15 I=1,N                                                       2C110270
      S(1)=S(1)+C(2*I+1)                                                2C110280
   15 S(2)=S(2)+C(2*I+2)                                                2C110290
      IF(SQRT((S(1)**2+S(2)**2)/CM)-ZERO)20,20,25                       2C110300
   20 R(2*L+1)=1.D0                                                     2C110310
      R(2*L+2)=0.D0                                                     2C110320
      G(1)=1.1D0                                                        2C110330
      G(2)=0.D0                                                         2C110340
      L=L+1                                                             2C110350
      IF(L-N)25,200,200                                                 2C110360
   25 IF(MOD(N,2))30,35,30                                              2C110370
   30 S(1)=C(3)-C(1)                                                    2C110380
      S(2)=C(4)-C(2)                                                    2C110390
      K=3                                                               2C110400
      GO TO 40                                                          2C110410
   35 S(1)=C(1)                                                         2C110420
      S(2)=C(2)                                                         2C110430
      K=2                                                               2C110440
   40 DO 45 I=K,N,2                                                     2C110450
      S(1)=S(1)-C(2*I-1)+C(2*I+1)                                       2C110460
   45 S(2)=S(2)-C(2*I)+C(2*I+2)                                         2C110470
      IF(SQRT((S(1)**2+S(2)**2)/CM)-ZERO)50,50,55                       2C110480
   50 R(2*L+1)=-1.D0                                                    2C110490
      R(2*L+2)=0.D0                                                     2C110500
      G(1)=-1.1D0                                                       2C110510
      G(2)=0.D0                                                         2C110520
      L=L+1                                                             2C110530
      IF(L-N)55,200,200                                                 2C110540
   55 Q=G(1)**2+G(2)**2                                                 2C110550
      IF(Q-1.)75,75,60                                                  2C110560
   60 G(1)=G(1)/Q                                                       2C110570
      G(2)=(-G(2))/Q                                                    2C110580
      KR=-1                                                             2C110590
   65 CM=1./CM                                                          2C110600
      K=(N+1)/2                                                         2C110610
      DO 70 I=1,K                                                       2C110620
      J=N-I                                                             2C110630
      T(1)=C(2*I-1)                                                     2C110640
      T(2)=C(2*I)                                                       2C110650
      C(2*I-1)=C(2*J+3)                                                 2C110660
      C(2*I)=C(2*J+4)                                                   2C110670
      C(2*J+3)=T(1)                                                     2C110680
   70 C(2*J+4)=T(2)                                                     2C110690
   75 IG=1                                                              2C110700
   80 X(1)=G(2*IG-1)                                                    2C110710
      X(2)=G(2*IG)                                                      2C110720
      DO 110 J=1,MAX                                                    2C110730
      P=EN                                                              2C110740
      S(1)=C(1)*X(1)-C(2)*X(2)+C(3)                                     2C110750
      S(2)=C(2)*X(1)+C(1)*X(2)+C(4)                                     2C110760
      T(1)=P*C(1)                                                       2C110770
      T(2)=P*C(2)                                                       2C110780
      DO 85 I=2,N                                                       2C110790
      Q=S(1)*X(1)-S(2)*X(2)+C(2*I+1)                                    2C110800
      S(2)=S(2)*X(1)+S(1)*X(2)+C(2*I+2)                                 2C110810
      S(1)=Q                                                            2C110820
      P=P-1.D0                                                          2C110830
      Q=T(1)*X(1)-T(2)*X(2)+P*C(2*I-1)                                  2C110840
      T(2)=T(2)*X(1)+T(1)*X(2)+P*C(2*I)                                 2C110850
   85 T(1)=Q                                                            2C110860
      P=S(1)**2+S(2)**2                                                 2C110870
      Q=(T(1)*S(1)+T(2)*S(2))/P                                         2C110880
      T(2)=(T(2)*S(1)-T(1)*S(2))/P                                      2C110890
      T(1)=Q                                                            2C110900
      IF(P.EQ.0.) T(1)=1.D16                                            2C110910
      IF(L)90,100,90                                                    2C110920
   90 DO 95 I=1,L                                                       2C110930
      S(1)=X(1)-R(2*I-1)                                                2C110940
      S(2)=X(2)-R(2*I)                                                  2C110950
      Q=S(1)**2+S(2)**2                                                 2C110960
      T(1)=T(1)-S(1)/Q                                                  2C110970
   95 T(2)=T(2)+S(2)/Q                                                  2C110980
  100 Q=T(1)**2+T(2)**2                                                 2C110990
      X(1)=X(1)-T(1)/Q                                                  2C111000
      X(2)=X(2)+T(2)/Q                                                  2C111010
      IF(1./SQRT(Q*(X(1)**2+X(2)**2))-EPS)105,105,110                   2C111020
  105 IF(SQRT(P/CM)-ZERO)160,160,110                                    2C111030
  110 CONTINUE                                                          2C111040
      IG=IG+1                                                           2C111050
      IF(IG-2)115,80,115                                                2C111060
  115 IF(KT)120,155,120                                                 2C111070
  120 IF(L)125,175,125                                                  2C111080
  125 KE=L                                                              2C111090
  130 IF(KR)135,200,135                                                 2C111100
  135 KT=0                                                              2C111110
  140 DO 145 I=1,L                                                      2C111120
      Q=R(2*I-1)**2+R(2*I)**2                                           2C111130
      R(2*I-1)=R(2*I-1)/Q                                               2C111140
  145 R(2*I)=(-R(2*I))/Q                                                2C111150
  150 IF(KT)65,200,65                                                   2C111160
  155 KT=1                                                              2C111170
      KR=KR+1                                                           2C111180
      Q=X(1)**2+X(2)**2                                                 2C111190
      G(1)=X(1)/Q                                                       2C111200
      G(2)=(-X(2))/Q                                                    2C111210
      IF(L)140,65,140                                                   2C111220
  160 IF(ABS(X(2)/X(1))-ZERO)165,165,170                                2C111230
  165 X(2)=0.                                                           2C111240
  170 R(2*L+1)=X(1)                                                     2C111250
      R(2*L+2)=X(2)                                                     2C111260
      G(1)=1.1D0*X(1)                                                   2C111270
      G(2)=1.1D0*X(2)                                                   2C111280
      L=L+1                                                             2C111290
      IF(L-N)75,130,130                                                 2C111300
  175 KE=-1                                                             2C111310
  200 RETURN                                                            2C111320
       END                                                              2C111330
