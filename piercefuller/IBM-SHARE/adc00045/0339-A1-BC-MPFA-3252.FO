*     LIST                                                                      
*     LABEL                                                                     
*     FORTRAN                                                                   
       SUBROUTINE  MP MULT (A, NA, B, NB, C, NC)                        MPFA 001
C......CALCULATE PRODUCT WITH ADDRESS IDENTICAL TO MULTIPLICAND.        MPFA 002
       DIMENSION  A(32), B(32), C(32), D(32)                            MPFA 003
       CALL  MP PROD (A, NA, B, NB, D, ND)                              MPFA 004
       NC = ND                                                          MPFA 005
       DO  10  I = 1, ND                                                MPFA 006
   10  C(I) = D(I)                                                      MPFA 007
       RETURN                                                           MPFA 008
       END                                                              MPFA 009
*      LABEL                                                            MPFA 010
*      FORTRAN                                                          MPFA 011
      SUBROUTINE MP MLT3(A,NA,B,NB,C,NC)                                MPFA 012
C.... TO CALCULATE C=A*B*C.                                             MPFA 013
      DIMENSION A(32),B(32),C(32),D(32),E(32)                           MPFA 014
      CALL MP PROD (A,NA,B,NB,D,ND)                                     MPFA 015
      CALL MP PROD (D,ND,C,NC,E,NE)                                     MPFA 016
      DO 5 I=1,NE                                                       MPFA 017
    5 C(I)=E(I)                                                         MPFA 018
      NC=NE                                                             MPFA 019
      RETURN                                                            MPFA 020
      END                                                               MPFA 021
*     LIST                                                              MPFA 022
*     LABEL                                                             MPFA 023
*     FORTRAN                                                           MPFA 024
       SUBROUTINE LCM (X,NX, Y,NY, A,NA, B,NB, XX,NXX, YY,NYY)          MPFA 025
       DIMENSION X(32),Y(32),A(32),B(32),XX(32),YY(32),BX(32),AY(32)    MPFA 026
     1 , DENOM(32)                                                      MPFA 027
                                                                        MPFA 028
       CALL MP PROD (Y,NY,  B,NB,  DENOM, NDENOM)                       MPFA 029
       CALL MP PROD (X,NX, B,NB, BX,NBX)                                MPFA 030
       CALL MP PROD (A,NA, Y,NY, AY,NAY)                                MPFA 031
       CALL MP ADD (BX,NBX, AY,NAY, XX,NXX)                             MPFA 032
       DO 4  I = 1, NDENOM                                              MPFA 033
B   4  YY(I) = DENOM(I)                                                 MPFA 034
       NYY = NDENOM                                                     MPFA 035
       CALL REL PRM (XX,NXX, YY,NYY)                                    MPFA 036
  999  RETURN                                                           MPFA 037
       END                                                              MPFA 038
*     LIST                                                              MPFA 039
*     LABEL                                                             MPFA 040
*     FORTRAN                                                           MPFA 041
       SUBROUTINE  REL PRM (X, NX, Y, NY)                               MPFA 042
COMPUTE GREATEST COMMON DIVISOR OF X AND Y. REDUCE X AND Y.             MPFA 043
C......FROM  FUNCTION EUCLID.                                           MPFA 044
       DIMENSION Q(32), R1(32), R2(32), R3(32), X(32), Y(32), GCD(32)   MPFA 045
      NTEST=1                                                           MPFA 046
B     GCD=1                                                             MPFA 047
      NG=1                                                              MPFA 048
      N1=NX                                                             MPFA 049
      NR1=NY                                                            MPFA 050
      NL=1                                                              MPFA 051
      IND=MPDIV(X,N1,Y,NR1,Q,LQ,R2,NR2,SUM)                             MPFA 052
    8 IF  (IND)    130,10,130                                           MPFA 053
B  10 IF (SUM)  20,125,20                                               MPFA 054
   20 CALL MPDIV (Y,NR1,R2,NR2,Q,LQ,R3,NR3,SUM)                         MPFA 055
      NTEST=NTEST+1                                                     MPFA 056
B     IF(SUM) 40, 90,40                                                 MPFA 057
   40 CALL MPDIV(R2,NR2,R3,NR3,Q,LQ,R1,NR1,SUM)                         MPFA 058
      NTEST=NTEST+1                                                     MPFA 059
B     IF  (SUM)   50,110,50                                             MPFA 060
   50 CALL MPDIV(R3,NR3,R1,NR1,Q,LQ,R2,NR2,SUM)                         MPFA 061
      NTEST=NTEST+1                                                     MPFA 062
B     IF (SUM)  60,70,60                                                MPFA 063
   60 CALL MPDIV(R1,NR1,R2,NR2,Q,LQ,R3,NR3,SUM)                         MPFA 064
      NTEST=NTEST+1                                                     MPFA 065
B  68 IF (SUM)   40,90,40                                               MPFA 066
   70 DO 80 N=1,NR1                                                     MPFA 067
   80 GCD(N)=ABSF(R1(N))                                                MPFA 068
      GO TO 128                                                         MPFA 069
   90 DO 100 N=1,NR2                                                    MPFA 070
  100 GCD(N)=ABSF(R2(N))                                                MPFA 071
      N=NR2                                                             MPFA 072
      GO TO 150                                                         MPFA 073
  110 DO 120 N=1,NR3                                                    MPFA 074
  120 GCD(N)=ABSF(R3(N))                                                MPFA 075
      N=NR3                                                             MPFA 076
      GO TO 150                                                         MPFA 077
  125 DO  127   N=1,NR1                                                 MPFA 078
  127 GCD(N) = ABSF(Y(N) )                                              MPFA 079
  128 N=NR1                                                             MPFA 080
      GO TO 150                                                         MPFA 081
  130 DO 140 N=1,N1                                                     MPFA 082
  140 GCD(N)=ABSF(X(N))                                                 MPFA 083
      N=N1                                                              MPFA 084
  150 IF(GCD(N)) 170,160,170                                            MPFA 085
  160 N=N-1                                                             MPFA 086
       IF (N)  150, 999, 150                                            MPFA 087
 170   CALL MPDIV(X,NX,GCD,N,R1,NR1,Q,LQ,SUM)                           MPFA 088
       CALL MPDIV(Y,NY,GCD,N,R2,NR2,Q,LQ,SUM)                           MPFA 089
       DO 171 I=1,NR1                                                   MPFA 090
 171   X(I) = R1(I)                                                     MPFA 091
       NX = NR1                                                         MPFA 092
       DO 175 I=1,NR2                                                   MPFA 093
 175   Y(I) = R2(I)                                                     MPFA 094
       NY = NR2                                                         MPFA 095
       IF (SENSE LIGHT 1)  302, 999                                     MPFA 096
  302  SENSE LIGHT  1                                                   MPFA 097
       CALL PRINTR (8,8,8,8,8,8, X,NX,Y,NY,GCD,N)                       MPFA 098
  999 RETURN                                                            MPFA 099
       END                                                              MPFA 100
*     LIST                                                              MPFA 101
*     LABEL                                                             MPFA 102
*     FORTRAN                                                           MPFA 103
       SUBROUTINE  IRRED (SQRT, NSQRT, XTRA, NXTRA)                     MPFA 104
                                                                        MPFA 105
CANCEL THE EVEN POWERS OF PRIMES FROM UNDER THE SQUARE ROOT SIGN....... MPFA 106
       DIMENSION  SQRT(32),PRIME(54), XTRA(32), RESID(32),NEXP(54)      MPFA 107
       COMMON  PRIMES                                                   MPFA 108
                                                                        MPFA 109
B      XTRA = 1                                                         MPFA 110
       NXTRA = 1                                                        MPFA 111
       CALL ARS (256, BOUND P, 18)                                      MPFA 112
                                                                        MPFA 113
C......THE  54TH PRIME IS  251.                                         MPFA 114
       IND   = MP FACT (SQRT,NSQRT, PRIMES, 54, BOUND P,                MPFA 115
     1      PRIME, N EXP, NUMBER, RESID, NRESID)                        MPFA 116
                                                                        MPFA 117
       DO 2  I=1,NRESID                                                 MPFA 118
    2  SQRT(I) = RESID(I)                                               MPFA 119
       NSQRT = NRESID                                                   MPFA 120
                                                                        MPFA 121
       DO 50  I=1,NUMBER                                                MPFA 122
       NEX = NEXP(I)                                                    MPFA 123
       IF (NEX - 1)  50, 30, 20                                         MPFA 124
   20  CONTINUE                                                         MPFA 125
                                                                        MPFA 126
       NOTE = NEX/2                                                     MPFA 127
       DO 25  J=1,NOTE                                                  MPFA 128
   25  CALL MP MULT (XTRA,NXTRA, PRIME(I),1,  XTRA,NXTRA)               MPFA 129
       IF (XMODF (NEX, 2)) 30, 50, 30                                   MPFA 130
   30  CONTINUE                                                         MPFA 131
                                                                        MPFA 132
       CALL MP MULT (SQRT,NSQRT,  PRIME(I),1,  SQRT,NSQRT)              MPFA 133
   50  CONTINUE                                                         MPFA 134
                                                                        MPFA 135
       RETURN                                                           MPFA 136
       END                                                              MPFA 137
*     LIST                                                              MPFA 138
*     LABEL                                                             MPFA 139
*     FORTRAN                                                           MPFA 140
       SUBROUTINE IRRED 2(NEXP,NUMBER,SQRT,NSQRT,XTRA,NXTRA)            MPFA 141
       DIMENSION NEXP(256),SQRT(32),XTRA(32)                            MPFA 142
C......TO REDUCE  OUTPUT  SQRT*B6J  FROM KOMBIN IN  SIX J.              MPFA 143
                                                                        MPFA 144
B      SQRT = 1                                                         MPFA 145
       NSQRT = 1                                                        MPFA 146
B      XTRA = 1                                                         MPFA 147
       NXTRA = 1                                                        MPFA 148
      IF (NUMBER)    10,100,10                                          MPFA 149
   10 DO   65    K=1,NUMBER,2                                           MPFA 150
       J = K + 1                                                        MPFA 151
       NEX = XABSF(NEXP(J) )                                            MPFA 152
       IF (NEX - 1)  65, 64, 62                                         MPFA 153
   62  NOTE = NEX/2                                                     MPFA 154
       DO  63  JX = 1, NOTE                                             MPFA 155
   63  CALL MP MULT(NEXP(K), 1, XTRA,NXTRA,  XTRA,NXTRA)                MPFA 156
       IF (XMODF(NEX, 2) )  64, 65, 64                                  MPFA 157
   64  CALL MP MULT(NEXP(K), 1, SQRT,NSQRT, SQRT,NSQRT)                 MPFA 158
   65  CONTINUE                                                         MPFA 159
  100 RETURN                                                            MPFA 160
       END                                                              MPFA 161
*      LIST                                                                     
*      LABEL                                                                    
*      FORTRAN                                                                  
      SUBROUTINE IRD RP(SQRT,NSQRT,NUM,NNUM,DEN,NDEN)                   MPFA 162
      DIMENSION SQRT(32),NUM(32),DEN(32),XTRA(32)                       MPFA 163
      CALL IRRED(SQRT,NSQRT,XTRA,NXTRA)                                 MPFA 164
      CALL MP MULT(XTRA,NXTRA,NUM,NNUM,NUM,NNUM)                        MPFA 165
      CALL REL PRM(NUM,NNUM,DEN,NDEN)                                   MPFA 166
      RETURN                                                            MPFA 167
      END                                                               MPFA 168
*     LIST                                                              MPFA 169
*     LABEL                                                             MPFA 170
*     FORTRAN                                                           MPFA 171
       SUBROUTINE   MPCVT3(SQRT,NSQRT,NUM,NNUM,DEN,NDEN,RESULT)         MPFA 172
       DIMENSION SQRT(32), NUM(32), DEN(32)                             MPFA 173
       IND = MPCONV(SQRT,NSQRT,XSQRT)                                   MPFA 174
       IF (IND)  999, 3, 999                                            MPFA 175
    3  IND = MPCONV(NUM,NNUM,DNUM)                                      MPFA 176
       IF (IND)  999, 5, 999                                            MPFA 177
    5  IND = MPCONV(DEN,NDEN,DDEN)                                      MPFA 178
       IF (IND)  999, 7, 999                                            MPFA 179
D   7  RESULT = SQRTF(XSQRT)*DNUM/DDEN                                  MPFA 180
       GO TO 9999                                                       MPFA 181
  999  PRINT 1000                                                       MPFA 182
 1000  FORMAT (11H MPCVT3 ERR)                                          MPFA 183
 9999  RETURN                                                           MPFA 184
       END                                                              MPFA 185
*     LIST                                                              MPFA 186
*     LABEL                                                             MPFA 187
*     FORTRAN                                                           MPFA 188
       SUBROUTINE   DUMPER (X, NX)                                      MPFA 189
       DIMENSION  X(32), BCDX(32), ERASE(32)                            MPFA 190
       INDICA = MP OUT(X, NX, BCDX, NBX, 32, ERASE)                     MPFA 191
       PRINT  10, (BCDX(I), I=NBX, 32)                                  MPFA 192
   10  FORMAT (1H 20A6)                                                 MPFA 193
       RETURN                                                           MPFA 194
       END                                                              MPFA 195
*     LIST                                                              MPFA 196
*     LABEL                                                             MPFA 197
*     FORTRAN                                                           MPFA 198
       SUBROUTINE DUMP3 (X,NX, Y,NY, Z,NZ)                              MPFA 199
       DIMENSION X(32),Y(32),Z(32),BCDX(32),BCDY(32),BCDZ(32),ERASE(32) MPFA 200
       BLANK = 7H      X                                                MPFA 201
       INDICA = MP OUT (X,NX, BCDX,NBX, 32, ERASE)                      MPFA 202
       INDICA = MP OUT (Y,NY, BCDY,NBY, 32, ERASE)                      MPFA 203
       INDICA = MP OUT (Z,NZ, BCDZ,NBZ, 32, ERASE)                      MPFA 204
       PRINT 10, (BCDX(I), I=NBX,32), BLANK,                            MPFA 205
     1           (BCDY(J), J=NBY,32), BLANK,                            MPFA 206
     2           (BCDZ(K), K=NBZ,32)                                    MPFA 207
   10  FORMAT (1H 20A6)                                                 MPFA 208
       RETURN                                                           MPFA 209
       END                                                              MPFA 210
*     LIST                                                              MPFA 211
*     LABEL                                                             MPFA 212
*     FORTRAN                                                           MPFA 213
       SUBROUTINE  PRINTR(I,J,K,L,M,N, X,NX,Y,NY,Z,NZ)                  MPFA 214
       DIMENSION  X(32),Y(32),Z(32),WORD(20),ERASE(32),BCD(32)          MPFA 215
       BLANK = 7H      X                                                MPFA 216
       DO  2  NB = 1, 20                                                MPFA 217
    2  WORD(NB) = BLANK                                                 MPFA 218
       IND = MP OUT (X,NX, BCD,NBCD, 32, ERASE)                         MPFA 219
       NW = NBCD - 28                                                   MPFA 220
       DO  10  NB = NBCD, 32                                            MPFA 221
       NW = NW + 1                                                      MPFA 222
       WORD(NW) = BCD(NB)                                               MPFA 223
   10  CONTINUE                                                         MPFA 224
       IND = MP OUT (Y,NY, BCD,NBCD, 32, ERASE)                         MPFA 225
       NW = NBCD - 22                                                   MPFA 226
       DO  20  NB = NBCD, 32                                            MPFA 227
       NW = NW + 1                                                      MPFA 228
       WORD(NW) = BCD(NB)                                               MPFA 229
   20  CONTINUE                                                         MPFA 230
       IND = MP OUT (Z,NZ, BCD,NBCD, 32, ERASE)                         MPFA 231
       NW = NBCD - 16                                                   MPFA 232
       DO  30 NB = NBCD, 32                                             MPFA 233
       NW = NW + 1                                                      MPFA 234
       WORD(NW) = BCD(NB)                                               MPFA 235
   30  CONTINUE                                                         MPFA 236
       PRINT 39, I,J,K,L,M,N, (WORD(NW), NW=1,17)                       MPFA 237
   39  FORMAT (1H 6I3, 2X, 17A6)                                        MPFA 238
       RETURN                                                           MPFA 239
       END                                                              MPFA 240
*     LIST                                                              MPFA 241
*     LABEL                                                             MPFA 242
*     FORTRAN                                                           MPFA 243
       SUBROUTINE PRINT9   (JJ1,JJ2,JJ12,JJ3,JJ4,JJ34,JJ13,JJ24,JJ,     MPFA 244
     X    X,NX, Y,NY, Z,NZ)                                             MPFA 245
       DIMENSION  X(32),Y(32),Z(32),WORD(20),ERASE(32),BCD(32)          MPFA 246
       BLANK = 7H      X                                                MPFA 247
       DO  2  NB = 1, 20                                                MPFA 248
    2  WORD(NB) = BLANK                                                 MPFA 249
       IND = MP OUT (X,NX, BCD,NBCD, 32, ERASE)                         MPFA 250
       NW = NBCD - 28                                                   MPFA 251
       DO  10  NB = NBCD, 32                                            MPFA 252
       NW = NW + 1                                                      MPFA 253
       WORD(NW) = BCD(NB)                                               MPFA 254
   10  CONTINUE                                                         MPFA 255
       IND = MP OUT (Y,NY, BCD,NBCD, 32, ERASE)                         MPFA 256
       NW = NBCD - 22                                                   MPFA 257
       DO  20  NB = NBCD, 32                                            MPFA 258
       NW = NW + 1                                                      MPFA 259
       WORD(NW) = BCD(NB)                                               MPFA 260
   20  CONTINUE                                                         MPFA 261
       IND = MP OUT (Z,NZ, BCD,NBCD, 32, ERASE)                         MPFA 262
       NW = NBCD - 16                                                   MPFA 263
       DO  30 NB = NBCD, 32                                             MPFA 264
       NW = NW + 1                                                      MPFA 265
       WORD(NW) = BCD(NB)                                               MPFA 266
   30  CONTINUE                                                         MPFA 267
       PRINT 39,            JJ1,JJ2,JJ12,JJ3,JJ4,JJ34,JJ13,JJ24,JJ,     MPFA 268
     X     (WORD(NW), NW=1,17)                                          MPFA 269
   39  FORMAT (1H 9I3, 2X, 17A6)                                        MPFA 270
       RETURN                                                           MPFA 271
       END                                                              MPFA 272
*      LABEL                                                            MPFA 273
*      FAP                                                              MPFA 274
*EAXM                                                                   MPFA 275
       COUNT   6                                                        MPFA 276
*      ROUTINE TO CONTROL ADDITIONAL INDEX REGISTER MODE .              MPFA 277
       ENTRY   EAXM          GIVE ME SEVEN INDEX REGISTERS              MPFA 278
       ENTRY   LAXM          RETURN TO THREE INDEX ORED MODE            MPFA 279
EAXM   EAXM                                                             MPFA 280
       TRA     1,4                                                      MPFA 281
LAXM   LAXM                                                             MPFA 282
       TRA     1,4                                                      MPFA 283
       END                                                              MPFA 284
*     LIST                                                              MPFA 285
*     LABEL                                                             MPFA 286
*     FORTRAN                                                           MPFA 287
CCONV  -  CONVERTS A DOUBLE PRECISION FLOATING POINT NUMBER INTO        MPFA 288
C   FORMAT E23.16.  HIGH ORDER PART IS IN A(1) AND LOW ORDER PART IS IN MPFA 289
C    A(2).  WORD IMAGE WILL BE RETURNED IN FIRST FOUR WORDS OF ARRAY B  MPFA 290
D     SUBROUTINE CONV(AA,B)                                             MPFA 291
      DIMENSION NEXP(2)                                                 MPFA 292
      EQUIVALENCE(AE,NAE),(T,NT)                                        MPFA 293
D     A=AA                                                              MPFA 294
B     E = 377000000000                                                  MPFA 295
B     T = 200000000000                                                  MPFA 296
      NEXP(1) = 0                                                       MPFA 297
      IF(A) 10,12,10                                                    MPFA 298
D  10 A = A*10.                                                         MPFA 299
      NEXP(1) = NEXP(1)-1                                               MPFA 300
B     AE = A*E                                                          MPFA 301
      IF(NT-NAE) 11,12,10                                               MPFA 302
D  11 A = A/10.                                                         MPFA 303
      NEXP(1) = NEXP(1) + 1                                             MPFA 304
B     AE = A*E                                                          MPFA 305
      IF (NT-NAE) 11,12,12                                              MPFA 306
   12 NA = XABSF(NEXP(1)/10)                                            MPFA 307
      NEXP(2) = XABSF(NEXP(1))-10*NA                                    MPFA 308
      IF(NEXP(1)) 13,14,14                                              MPFA 309
   13 NEXP(1) = -NA                                                     MPFA 310
      GO TO 15                                                          MPFA 311
   14 NEXP(1) = NA                                                      MPFA 312
   15 CALL CVRT (A,B,NEXP)                                              MPFA 313
      RETURN                                                            MPFA 314
      END                                                               MPFA 315
*     LABEL                                                             MPFA 316
*     FAP                                                               MPFA 317
*CVRT   -   USED IN CONV PACKAGE                                        MPFA 318
       ENTRY   CVRT                                                     MPFA 319
CVRT   SXA     RTN,1         INITIALIZE                                 MPFA 320
       SXA     RTN+1,2                                                  MPFA 321
       CLA     1,4                                                      MPFA 322
       STA     A                                                        MPFA 323
       SUB     =1                                                       MPFA 324
       STA     A1                                                       MPFA 325
       CLA     2,4                                                      MPFA 326
       STA     BD                                                       MPFA 328
       SUB     =1                                                       MPFA 329
       STA     BE                                                       MPFA 330
       SUB     =1                                                       MPFA 331
       STA     BF                                                       MPFA 332
       SUB     =1                                                       MPFA 333
       STA     BG                                                       MPFA 334
       CLA     2,4                                                      MPFA 335
       ADD     =1                                                       MPFA 336
       STA     BB                                                       MPFA 337
       STA     B                                                        MPFA 338
       CLA     3,4                                                      MPFA 339
       STA     NX                                                       MPFA 340
       SUB     =1                                                       MPFA 341
       STA     NX1                                                      MPFA 342
       SPACE                                                            MPFA 343
       STZ     LAST          PREPARE FOR CONVERSION                     MPFA 344
       AXT     3,2                                                      MPFA 345
       AXT     1,1                                                      MPFA 346
A      CLA     **                                                       MPFA 347
       TZE     ZERO                                                     MPFA 348
       STO     AC                                                       MPFA 349
       TMI     MIN                                                      MPFA 350
       CLA     DT                                                       MPFA 351
       TRA     *+2                                                      MPFA 352
MIN    CLA     DT+1                                                     MPFA 353
    BD STO     **                                                       MPFA 354
    BE STZ     **                                                       MPFA 355
    BF STZ     **                                                       MPFA 356
       CLA*    NX                                                       MPFA 357
       TMI     MINX                                                     MPFA 358
       CLA     DT+2                                                     MPFA 359
       TRA     *+2                                                      MPFA 360
MINX   CLA     DT+3                                                     MPFA 361
    BG STO     **                                                       MPFA 362
       CAL     AC            SHIFT                                      MPFA 363
       ANA     DOCT+2                                                   MPFA 364
       SUB     =2B2                                                     MPFA 365
       ANA     =7B8                                                     MPFA 366
       ARS     27                                                       MPFA 367
       STA     SHIFT                                                    MPFA 368
A1     CAL     **                                                       MPFA 369
       ANA     DOCT                                                     MPFA 370
       ALS     9                                                        MPFA 371
       XCL                                                              MPFA 372
       CAL     AC                                                       MPFA 373
       ANA     DOCT                                                     MPFA 374
SHIFT  LGR     **                                                       MPFA 375
       SLW     AC            HIGH ORDER PART                            MPFA 376
       PXD     0,0                                                      MPFA 377
       LGR     3                                                        MPFA 378
       STQ     MQ            LOW ORDER PART / 8                         MPFA 379
       SPACE                                                            MPFA 380
NEXT   CLA     MQ            MULTIPLY BY 10 TO OBTAIN NEXT DIGIT        MPFA 381
       ADD     MQ                                                       MPFA 382
       STO     MQ2                                                      MPFA 383
       CAL     AC                                                       MPFA 384
       LDQ     MQ                                                       MPFA 385
       RQL     3                                                        MPFA 386
       LGL     3             MULTIPLY BY 8                              MPFA 387
       SLW     AC8                                                      MPFA 388
       XCL                                                              MPFA 389
       ARS     3                                                        MPFA 390
       ADD     MQ2                                                      MPFA 391
       XCL                                                              MPFA 392
       PXD     0,0                                                      MPFA 393
       LGL     3                                                        MPFA 394
       ADD     AC8                                                      MPFA 395
       ADD     AC                                                       MPFA 396
       ADD     AC            10 * NUMBER                                MPFA 397
       STO     AC                                                       MPFA 398
       ANA     DOCT+1                                                   MPFA 399
       LGR     3                                                        MPFA 400
       STQ     MQ            LOW ORDER PART / 8                         MPFA 401
       LGR     30                                                       MPFA 402
B      CAL     **,1                                                     MPFA 403
       LGL     6                                                        MPFA 404
BB     SLW     **,1          NEXT DIGIT IN B                            MPFA 405
       TIX     Q,2,1         TEST OFR COMPLETE B WORD                   MPFA 406
       SPACE                                                            MPFA 407
       TXI     *+1,1,1                                                  MPFA 408
       TXH     AA,1,3                                                   MPFA 409
       AXT     6,2                                                      MPFA 410
Q      CAL     DOCT                                                     MPFA 411
       ANS     AC                                                       MPFA 412
       TRA     NEXT                                                     MPFA 413
AA     ZET     LAST          TEST FOR LAST B WORD                       MPFA 414
       TRA     BQ                                                       MPFA 415
       STL     LAST                                                     MPFA 416
       AXT     1,2                                                      MPFA 417
       TRA     Q                                                        MPFA 418
       SPACE                                                            MPFA 419
BQ     LDQ*    BG            PLACE IN EXPONENT                          MPFA 420
       RQL     30                                                       MPFA 421
       PXD     0,0                                                      MPFA 422
       LGL     18                                                       MPFA 423
NX     LDQ     **                                                       MPFA 424
       RQL     12                                                       MPFA 425
       LGL     6                                                        MPFA 426
NX1    LDQ     **                                                       MPFA 427
       RQL     12                                                       MPFA 428
       LGL     6                                                        MPFA 429
       LDQ     DT+5                                                     MPFA 430
       LGL     6                                                        MPFA 431
BC     SLW*    BG                                                       MPFA 432
       SPACE                                                            MPFA 433
RTN    AXT     **,1                                                     MPFA 434
       AXT     **,2                                                     MPFA 435
       TRA     4,4                                                      MPFA 436
ZERO   CLA     DT+4                                                     MPFA 437
       STO*    BD                                                       MPFA 438
       CLA     DT+5                                                     MPFA 439
       STO*    BE                                                       MPFA 440
       STO*    BF                                                       MPFA 441
       STO*    BG                                                       MPFA 442
       TRA     RTN                                                      MPFA 443
LAST   PZE                                                              MPFA 444
AC8    PZE                                                              MPFA 445
AC     PZE                                                              MPFA 446
MQ     PZE                                                              MPFA 447
MQ2    PZE                                                              MPFA 448
DT     BCI     4,000 0.000-0.0E 00 0E-00                                MPFA 449
       BCI     2, 0.                                                    MPFA 450
DOCT   OCT     777777777,77000000000,377000000000                       MPFA 451
       END                                                              MPFA 452
