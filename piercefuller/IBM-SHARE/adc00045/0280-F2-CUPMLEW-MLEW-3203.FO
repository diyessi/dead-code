      SUBROUTINE MLEW (M,A,VEC,EXTRA)                                   MLEW0020
      DIMENSION A(50,50),VEC(50,50),EXTRA(50,5)                         MLEW0030
C     DIMENSION A(50,50),VEC(50,50),EXTRA(50,5)                         MLEW0040
C     THE 50)S IN THE ABOVE DIMENSION STATEMENT MUST BE CHANGED IF THE  MLEW0050
C     M X M INPUT MATRIX, OR AT LEAST THAT PART OF THE INPUT MATRIX     MLEW0060
C     ABOVE AND ON THE DIAGONAL, IS NOT STORED IN AN ARRAY A OF         MLEW0070
C     DIMENSIONS 50 X 50 IN THE USUAL FORTRAN MANNER WITH M LESS OR     MLEW0080
C     EQUAL 50.  MLEW WILL IGNORE THE ELEMENTS BELOW THE DIAGONAL AND   MLEW0090
C     COMPUTE ALL EIGENVALUES AND VECTORS FOR A REAL SYMMETRIC INPUT    MLEW0100
C     MATRIX DEFINED BY THE ELEMENTS OF THE M X M LEADING PRINCIPAL     MLEW0110
C     MINOR OF A WHICH ARE ON AND ABOVE THE DIAGONAL.  DUPLICATE        MLEW0120
C     EIGENVALUES WILL HAVE IDENTICAL EIGENVECTORS COMPUTED FOR THEM.   MLEW0130
C     THE EIGENVALUES ARE STORED IN THE FIRST COLUMN OF EXTRA IN        MLEW0140
C     DESCENDING ALGEBRAIC ORDER.  THE EIGENVECTORS WILL HAVE UNIT      MLEW0150
C     LENGTH AND ARE STORED IN THE M X M LEADING PRINCIPAL MINOR OF VEC MLEW0160
C     FROM LEFT TO RIGHT BY COLUMNS IN THE ORDER OF THEIR CORRESPONDING MLEW0170
C     EIGENVALUES.                                                      MLEW0180
      EQUIVALENCE (TE,ITE),(TF,ITF),(TG,ITG)                            MLEW0190
      N=M                                                               MLEW0200
      NM1=N-1                                                           MLEW0210
      IF (N-2)1,2,3                                                     MLEW0220
 3    NM2=N-2                                                           MLEW0230
      DO 33 L=1,NM2                                                     MLEW0240
      S=0.0                                                             MLEW0250
      LP1=L+1                                                           MLEW0260
      DO 10 K=LP1,N                                                     MLEW0270
 10   S=S+A(L,K)**2                                                     MLEW0280
      STOH=SQRT(S)                                                      MLEW0290
      DUM=A(L,LP1)                                                      MLEW0300
      EXTRA(L,4)=-SIGN(STOH,DUM)                                        MLEW0310
 14   IF (S) 14,33,15                                                   MLEW0320
 15   C=1.0/(2.0*(S+ABS(DUM)*STOH))                                     MLEW0330
      A(L,LP1)=DUM-EXTRA(L,4)                                           MLEW0340
      DO 23 I=LP1,N                                                     MLEW0350
      DUM=0.0                                                           MLEW0360
      DO 23 MM=LP1,N                                                    MLEW0370
      IF (I-MM) 20,20,22                                                MLEW0380
 20   DUM=DUM+A(I,MM)*A(L,MM)                                           MLEW0390
      GO TO 23                                                          MLEW0400
 22   DUM=DUM+A(MM,I)*A(L,MM)                                           MLEW0410
 23   EXTRA(I,4)=DUM                                                    MLEW0420
      FK=0.0                                                            MLEW0430
      DO 26 J2=LP1,N                                                    MLEW0440
 26   FK=FK+A(L,J2)*EXTRA(J2,4)                                         MLEW0450
      FK=C*FK                                                           MLEW0460
      DO 29 I2=LP1,N                                                    MLEW0470
 29   EXTRA(I2,4)=EXTRA(I2,4)-FK*A(L,I2)                                MLEW0480
      DO 32 I3=LP1,N                                                    MLEW0490
      DO 32 J3=I3,N                                                     MLEW0500
 32   A(I3,J3)=A(I3,J3)-(A(L,I3)*EXTRA(J3,4)+A(L,J3)*EXTRA(I3,4))*2.0*C MLEW0510
      C=SQRT(C)                                                         MLEW0520
      DO 16 LLL=LP1,N                                                   MLEW0530
 16   A(L,LLL)=C*A(L,LLL)                                               MLEW0540
 33   CONTINUE                                                          MLEW0550
 2    EXTRA(N-1,4)=A(N-1,N)                                             MLEW0560
      EXTRA(N,4)=0.0                                                    MLEW0570
      BOUND=ABS(A(1,1))+ABS(EXTRA(1,4))                                 MLEW0580
      DO 100 I4=2,N                                                     MLEW0590
      ABOUND=ABS(A(I4,I4))+ABS(EXTRA(I4,4))+ABS(EXTRA(I4-1,4))          MLEW0600
 100  BOUND=AMAX1(BOUND,ABOUND)                                         MLEW0610
      DO 150 J4=1,N                                                     MLEW0620
      EXTRA(J4,1)=-BOUND                                                MLEW0630
 150  EXTRA(J4,2)=BOUND                                                 MLEW0640
      ILFA=0                                                            MLEW0650
 280  ILFA=ILFA+1                                                       MLEW0660
      DO 190 K2=1,N                                                     MLEW0670
      GMU=(EXTRA(K2,2)+EXTRA(K2,1))/2.0                                 MLEW0680
 191  IF(EXTRA(K2,2)-GMU) 191,190,192                                   MLEW0690
 192  IF (GMU-EXTRA(K2,1)) 192,190,210                                  MLEW0700
 190  CONTINUE                                                          MLEW0710
      GO TO 4                                                           MLEW0720
 210  ONE=1.0                                                           MLEW0730
      IOFGMU=0                                                          MLEW0740
      FOFIM1=1.0                                                        MLEW0750
      DO 2400 IR2=1,N                                                   MLEW0760
      DUM=EXTRA(IR2-1,4)                                                MLEW0770
      DUMDUM=A(IR2,IR2)                                                 MLEW0780
 6    IF (IR2-1)6,1300,1200                                             MLEW0790
 1200 IF (DUM) 1500,1300,1500                                           MLEW0800
 1300 FOFI=(DUMDUM-GMU)*SIGN(ONE,FOFIM1)                                MLEW0810
      GO TO 2000                                                        MLEW0820
 1500 IF(IR2-2)1500,1700,1600                                           MLEW0830
 1600 IF(EXTRA(IR2-2,4)) 1900,1700,1900                                 MLEW0840
 1700 FOFI=(DUMDUM-GMU)*FOFIM1-SIGN(DUM**2,FOFIM2)                      MLEW0850
      GO TO 2000                                                        MLEW0860
 1900 FOFI=(DUMDUM-GMU)*FOFIM1-DUM**2*FOFIM2                            MLEW0870
C     SET VARIABLE Q000CT TO 200000000000                               MLEW0880
      CALL HOLOCT (Q000CT,12H200000000000)                              MLEW0890
      TE=Q000CT                                                         MLEW0900
C     SET VARIABLE Q001CT TO 377000000000                               MLEW0910
      CALL HOLOCT (Q001CT,12H377000000000)                              MLEW0920
      TF=AND(FOFI,Q001CT)                                               MLEW0930
C     SET VARIABLE Q002CT TO 377000000000                               MLEW0940
      CALL HOLOCT (Q002CT,12H377000000000)                              MLEW0950
      TG=AND(FOFIM1,Q002CT)                                             MLEW0960
      IF(IABS(ITF-ITG)-ITE) 2101,2000,2000                              MLEW0970
 2101 ITG=ITG+ITE-ITF                                                   MLEW0980
C     SET VARIABLE Q003CT TO 400777777777                               MLEW0990
      CALL HOLOCT (Q003CT,12H400777777777)                              MLEW1000
      FOFI=OR(AND(FOFI,Q003CT),TE)                                      MLEW1010
C     SET VARIABLE Q004CT TO 400777777777                               MLEW1020
      CALL HOLOCT (Q004CT,12H400777777777)                              MLEW1030
      FOFIM1=OR(AND(FOFIM1,Q004CT),TG)                                  MLEW1040
      FOFI=FOFI+0.0                                                     MLEW1050
 2000 IF (FOFI) 2100,2500,2100                                          MLEW1060
 2100 IF (SIGN(FOFI,FOFIM1)-FOFI) 2300,2200,2300                        MLEW1070
 2500 FOFI=SIGN(FOFI,FOFIM1)                                            MLEW1080
 2200 IOFGMU=IOFGMU+1                                                   MLEW1090
 2300 FOFIM2=FOFIM1                                                     MLEW1100
 2400 FOFIM1=FOFI                                                       MLEW1110
 290  IF(IOFGMU)290,250,230                                             MLEW1120
 230  DO 240 IR=1,IOFGMU                                                MLEW1130
 240  EXTRA(IR,1)=AMAX1(EXTRA(IR,1),GMU)                                MLEW1140
 250  I5=IOFGMU+1                                                       MLEW1150
 300  IF(IOFGMU-N)260,280,300                                           MLEW1160
 260  DO 270 IR1=I5,N                                                   MLEW1170
 270  EXTRA(IR1,2)=AMIN1(EXTRA(IR1,2),GMU)                              MLEW1180
      GO TO 280                                                         MLEW1190
 4    DO 4101 J=1,N                                                     MLEW1200
 4101 EXTRA(J,5)=EXTRA(J,4)                                             MLEW1210
      DO 4026 J=1,N                                                     MLEW1220
      DO 4021 J1=1,N                                                    MLEW1230
 4021 EXTRA(J1,3)=A(J1,J1)-EXTRA(J,1)                                   MLEW1240
      DO 4022 J1=2,N                                                    MLEW1250
      EXTRA(J1,2)=EXTRA(J1-1,5)                                         MLEW1260
 4022 EXTRA(J1-1,4)=EXTRA(J1-1,5)                                       MLEW1270
      EXTRA(1,2)=0.0                                                    MLEW1280
      DO 500 I=1,NM1                                                    MLEW1290
      DUM=EXTRA(I,3)                                                    MLEW1300
      DUMDUM=EXTRA(I+1,2)                                               MLEW1310
      IF(ABS(DUM)-ABS(DUMDUM))501,502,502                               MLEW1320
 501  PIVOT=DUM/DUMDUM                                                  MLEW1330
      EXTRA(I,3)=DUMDUM                                                 MLEW1340
      DUM=EXTRA(I,4)                                                    MLEW1350
      EXTRA(I,4)=EXTRA(I+1,3)                                           MLEW1360
      EXTRA(I+1,3)=DUM                                                  MLEW1370
      EXTRA(I,2)=EXTRA(I+1,4)                                           MLEW1380
      EXTRA(I+1,4)=0.0                                                  MLEW1390
      GO TO 4017                                                        MLEW1400
 502  IF (DUM) 407,500,407                                              MLEW1410
 407  PIVOT=DUMDUM/DUM                                                  MLEW1420
 4017 EXTRA(I+1,2)=0.0                                                  MLEW1430
      EXTRA(I+1,3)=EXTRA(I+1,3)-PIVOT*EXTRA(I,4)                        MLEW1440
      EXTRA(I+1,4)=EXTRA(I+1,4)-PIVOT*EXTRA(I,2)                        MLEW1450
 500  CONTINUE                                                          MLEW1460
      DO 600 I=1,N                                                      MLEW1470
      IF(EXTRA(I,3)) 600,601,600                                        MLEW1480
 600  CONTINUE                                                          MLEW1490
      N1=N                                                              MLEW1500
      GO TO 4010                                                        MLEW1510
 601  N1=I                                                              MLEW1520
      IF (N1-N) 602,4010,602                                            MLEW1530
 602  N1P1=N1+1                                                         MLEW1540
      DO 603 I=N1P1,N                                                   MLEW1550
 603  EXTRA(I,2)=0.0                                                    MLEW1560
 4010 EXTRA(N1,2)=1.0                                                   MLEW1570
 4100 N1M1=N1-1                                                         MLEW1580
 12   IF (N1M1) 12,7,4014                                               MLEW1590
 4014 EXTRA(N1M1,2)=(EXTRA(N1,3)-EXTRA(N1M1,4))/EXTRA(N1M1,3)           MLEW1600
 11   IF (N1-2) 11,7,13                                                 MLEW1610
 13   DO 4015 I=2,N1M1                                                  MLEW1620
      I1=N1-I                                                           MLEW1630
 4015 EXTRA(I1,2)=(EXTRA(N1,3)-EXTRA(I1+1,2)*EXTRA(I1,4)-EXTRA(I1+2,2)*EMLEW1640
     1XTRA(I1,2))/EXTRA(I1,3)                                           MLEW1650
 7    IF(N-2)7,8,4029                                                   MLEW1660
 4029 DO 4027 K=2,NM1                                                   MLEW1670
      K1=N+1-K                                                          MLEW1680
      TEMP=0.0                                                          MLEW1690
      DO 4023 K2=K1,N                                                   MLEW1700
 4023 TEMP=TEMP+EXTRA(K2,2)*A(K1-1,K2)                                  MLEW1710
      TEMP=2.0*TEMP                                                     MLEW1720
      DO 4027 K2=K1,N                                                   MLEW1730
 4027 EXTRA(K2,2)=EXTRA(K2,2)-TEMP*A(K1-1,K2)                           MLEW1740
 8    TEMP=0.0                                                          MLEW1750
 4031 DO 4032 L=1,N                                                     MLEW1760
 4032 TEMP=TEMP+EXTRA(L,2)**2                                           MLEW1770
      TEMP=SQRT(TEMP)                                                   MLEW1780
      DO 737 J1=1,N                                                     MLEW1790
 737  EXTRA(J1,2)=EXTRA(J1,2)/TEMP                                      MLEW1800
 7028 DO 4026 J1=1,N                                                    MLEW1810
 4026 VEC(J1,J)=EXTRA(J1,2)                                             MLEW1820
 1    RETURN                                                            MLEW1830
      END                                                               MLEW1840
