*     FORTRAN                                                                   
C                                                                               
C     BINOMIAL COEFFICIENT TABLE SUBROUTINE-JEAN FISHER,GE-TEMPO,JAN.64.        
C                                                                               
C     BCT COMPUTES A TABLE OF BINOMIAL COEFFICIENTS IN THE FLOATING             
C     POINT MODE FOR ALL NON-NEGATIVE INTEGER POWERS THROUGH 130 AND            
C     STORES THE RESULTING TWO DIMENSIONAL TRIANGULAR ARRAY AS A                
C     ONE-DIMENSIONAL ARRAY.                                                    
      SUBROUTINE BCT (NMAX,B)                                                   
      DIMENSION B(2)                                                            
C     THE CALLING PROGRAM SHOULD DIMENSION B(NMAX*(NMAX+1))/2+NMAX+2)           
      IF(NMAX-130)5,5,30                                                        
    5 N = NMAX + 1                                                              
      K2 = 0                                                                    
C     THIS DO LOOP STORES UNITY IN THE ARRAY B ONLY WHERE NECESSARY.            
      DO 10 L = 1,N                                                             
      K2 = K2 + L                                                               
      B(K2+1) = 1.0                                                             
      B(K2) = 1.0                                                               
   10 CONTINUE                                                                  
      B(5) = 2.0                                                                
      K2 = 5                                                                    
      DO 20 L = 4,N                                                             
      K1 = K2 + 3                                                               
      K2 = K2 + L                                                               
      DO 20 K = K1,K2                                                           
      KK = K - L                                                                
      B(K) = B(KK+1) + B(KK)                                                    
   20 CONTINUE                                                                  
      GO TO 40                                                                  
   30 WRITE OUTPUT TAPE 6,31                                                    
   31 FORMAT(46H1SUBROUTINE BCT CALLED WITH EXCESSIVE ARGUMENT//)               
   40 RETURN                                                                    
      END(1,1,0,0,0)                                                            
