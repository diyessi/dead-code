*      NBS     HNKL                                                     HNKL0000
      SUBROUTINE HANKEL(KIND,ORDR,ORDI,ZR,ZI,HR,HI,MAG)                 HNKL0001
      DIMENSION ASNU(3,4),SUMR(3),SUMI(3)                               HNKL0002
      IF(ZR) 950,1,1                                                    HNKL0003
    1 MAG=0                                                             HNKL0004
      ASNU(1,1)=.125                                                    HNKL0005
      ASNU(1,2)=-.2083333333                                            HNKL0006
      ASNU(2,1)=.0234375                                                HNKL0007
      ASNU(2,2)=-.13368056                                              HNKL0008
      ASNU(2,3)=.11140046                                               HNKL0009
      ASNU(3,1)=.48828125E-2                                            HNKL0010
      ASNU(3,2)=-.059414063                                             HNKL0011
      ASNU(3,3)=.12309751                                               HNKL0012
      ASNU(3,4)=-.068387506                                             HNKL0013
      SIG=1.                                                            HNKL0014
      METHOD=1                                                          HNKL0015
      MAP=1                                                             HNKL0016
      OR=ORDR                                                           HNKL0017
      OI=ORDI                                                           HNKL0018
    2 SK=3-2*KIND                                                       HNKL0019
      CALLZDIV(ORDR,ORDI,ZR,ZI,CX,CY)                                   HNKL0020
      CALL ZMPY(CX,CY,CX,CY,QR,QI)                                      HNKL0021
      IF(CY) 5,10,25                                                    HNKL0022
    5 SIG=-1.                                                           HNKL0023
      GO TO 25                                                          HNKL0024
   10 IF(ABSF(CX)-1.) 12,15,15                                          HNKL0025
   12 ALPHA=0.                                                          HNKL0026
      BETA=ACOSF(CX)                                                    HNKL0027
      TR=0.                                                             HNKL0028
      TI=TANF(BETA)                                                     HNKL0029
      GO TO 45                                                          HNKL0030
   15 BETA=0.                                                           HNKL0031
      ALPHA=LOGF(ABSF(CX)+SQRTF(CX*CX-1.))                              HNKL0032
      TR=TANHF(ALPHA)                                                   HNKL0033
      TI=0.                                                             HNKL0034
      MAP=6                                                             HNKL0035
      IF(CX) 20,45,45                                                   HNKL0036
   20 METHOD=2                                                          HNKL0037
      OR=-OR                                                            HNKL0038
      OI=-OI                                                            HNKL0039
      CX=-CX                                                            HNKL0040
      GO TO 45                                                          HNKL0041
   25 CALLZSQRT(QR-1.,QI,SR,SI)                                         HNKL0042
      TX=CX-SIG*SR                                                      HNKL0043
      TY=CY-SIG*SI                                                      HNKL0044
      ALPHA=-.5*LOGF(TX*TX+TY*TY)                                       HNKL0045
      IF(ALPHA*CY) 30,30,35                                             HNKL0046
   30 TX=CX+SIG*SR                                                      HNKL0047
      TY=CY+SIG*SI                                                      HNKL0048
      ALPHA=-.5*LOGF(TX*TX+TY*TY)                                       HNKL0049
   35 E=EXPF(ALPHA)                                                     HNKL0050
      CAL =(E+1./E)*.5                                                  HNKL0051
      SAL=(E-1./E)*.5                                                   HNKL0052
      CBTA=CX/CAL                                                       HNKL0053
      BETA=ACOSF(CBTA)                                                  HNKL0054
      SBTA=SINF(BETA)                                                   HNKL0055
   40 CALLZDIV(CBTA*SAL,SBTA*CAL,CX,CY,TR,TI)                           HNKL0056
   45 CALLZMPY(OR,OI,TR-ALPHA,TI-BETA,ZETR,ZETI)                        HNKL0057
      CALLZDIV(1.,0.,TR,TI,CTR,CTI)                                     HNKL0058
      CALLZMPY(CTR,CTI,CTR,CTI,SQR,SQI)                                 HNKL0059
  125 TEST=1.                                                           HNKL0060
      CALLZDIV(CTR,CTI,OR,OI,FACR,FACI)                                 HNKL0061
      DO 150 I=1,3                                                      HNKL0062
      TCX=SQR                                                           HNKL0063
      TCY=SQI                                                           HNKL0064
      SUMR(I)=ASNU(I,1)                                                 HNKL0065
      SUMI(I)=0.                                                        HNKL0066
      FI=2*I+1                                                          HNKL0067
      DO 130 K=1,I                                                      HNKL0068
      SUMR(I)=SUMR(I)+ASNU(I,K+1)*TCX                                   HNKL0069
      SUMI(I)=SUMI(I)+ASNU(I,K+1)*TCY                                   HNKL0070
  130 CALLZMPY(SQR,SQI,TCX,TCY,TCX,TCY)                                 HNKL0071
      CALLZMPY(SUMR(I),SUMI(I),FACR,FACI,SUMR(I),SUMI(I))               HNKL0072
      TESS=SUMR(I)*SUMR(I)+SUMI(I)*SUMI(I)                              HNKL0073
      IF(TEST-TESS) 135,135,145                                         HNKL0074
  135 DO 140 K=I,3                                                      HNKL0075
      SUMR(K)=0.                                                        HNKL0076
  140 SUMI(K)=0.                                                        HNKL0077
      GO TO 152                                                         HNKL0078
  145 TEST=TESS                                                         HNKL0079
      CALLZDIV(FI*CTR,FI*CTI,OR,OI,TX,TY)                               HNKL0080
  150 CALLZMPY(TX,TY,FACR,FACI,FACR,FACI)                               HNKL0081
  152 DO 46 K=1,3                                                       HNKL0082
      KT=4-K                                                            HNKL0083
      TESS=SUMR(KT)*SUMR(KT)+SUMI(KT)*SUMI(KT)                          HNKL0084
      IF(TESS) 46,46,47                                                 HNKL0085
   46 TESS=1.                                                           HNKL0086
   47 TEST=1.E-4/(ZR*ZR+ZI*ZI)                                          HNKL0087
      IF(TEST-TESS) 250,60,60                                           HNKL0088
   60 GO TO(61,61,61,61,61,155) ,MAP                                    HNKL0089
   61 TEST=1.-BETA*CBTA/SBTA-ALPHA*SAL/CAL                              HNKL0090
      IF(TEST) 85,65,65                                                 HNKL0091
   65 IF(CX) 70,155,155                                                 HNKL0092
   70 IF(TEST+3.1415927  *CBTA/SBTA) 75,155,155                         HNKL0093
   75 IF(SK*CY) 80,155,155                                              HNKL0094
   80 MAP=3                                                             HNKL0095
      GO TO 155                                                         HNKL0096
   85 IF(CX) 90,95,95                                                   HNKL0097
   90 METHOD=2                                                          HNKL0098
      OR=-ORDR                                                          HNKL0099
      OI=-ORDI                                                          HNKL0100
      CX=-CX                                                            HNKL0101
      CY=-CY                                                            HNKL0102
      SIG=-SIG                                                          HNKL0103
      ALPHA=-ALPHA                                                      HNKL0104
      BETA=3.1415927  -BETA                                             HNKL0105
      SAL=-SAL                                                          HNKL0106
      CBTA=-CBTA                                                        HNKL0107
      GO TO 100                                                         HNKL0108
   95 IF(TEST+3.1415927  *CBTA/SBTA) 100,115,115                        HNKL0109
  100 IF(SK*CY) 105,110,110                                             HNKL0110
  105 MAP=5                                                             HNKL0111
      GO TO 155                                                         HNKL0112
  110 MAP=4                                                             HNKL0113
      GO TO 155                                                         HNKL0114
  115 IF(SK*CY) 155,120,120                                             HNKL0115
  120 MAP=2                                                             HNKL0116
  155 CALLZEXP(SK*ZETR,SK*(ZETI-.78539816),C,S,MAG)                     HNKL0117
      CALLZMPY(1.57079633  *OR,1.57079633  *OI,TI,-TR,BX,BY)            HNKL0118
      CALLZSQRT(BX,BY,BX,BY)                                            HNKL0119
      CALLZDIV(C,S,BX,BY,DX,DY)                                         HNKL0120
      CALLZMPY(DX,DY,1.+SK*SUMR(1)+SUMR(2)+SK*SUMR(3),                  HNKL0121
     1SK*SUMI(1)+SUMI(2)+SK*SUMI(3),HR,HI)                              HNKL0122
      GO TO (200,300,300,300,300,300),MAP                               HNKL0123
  200 GO TO (910,900),METHOD                                            HNKL0124
  250 U=0.                                                              HNKL0125
      CALLZMPY(0.,-1.,ZETR,ZETI,ARGR,ARGI)                              HNKL0126
      IF(MAP-6) 254,251,251                                             HNKL0127
  251 U=1.                                                              HNKL0128
      ARGR=-ARGR                                                        HNKL0129
      ARGI=-ARGI                                                        HNKL0130
      GO TO 260                                                         HNKL0131
  254 IF(ARGR)255,260,260                                               HNKL0132
  255 IF(CY*ARGI) 260,260,256                                           HNKL0133
  256 U=-ABSF(CY)/CY                                                    HNKL0134
  260 CALLZDIV(ALPHA,BETA,TR,TI,TR,TI)                                  HNKL0135
      CALLZSQRT(1.-TR,-TI,TR,TI)                                        HNKL0136
      CALLZMPY(TR,TI,.86602540,SK*.5,SR,SI)                             HNKL0137
      CALLHANK(KIND,.33333333,U,ARGR,ARGI,HR,HI,MAG)                    HNKL0138
      CALLZMPY(SR,SI,HR,HI,HR,HI)                                       HNKL0139
      IF(MAP -6) 200,262,262                                            HNKL0140
  262 HR=-HR                                                            HNKL0141
      HI=-HI                                                            HNKL0142
      GO TO 200                                                         HNKL0143
  300 CALLZMPY(C,S,BX,BY,DX,DY)                                         HNKL0144
      CALLZDIV(1.-SK*SUMR(1)+SUMR(2)-SK*SUMR(3),                        HNKL0145
     1-SK*SUMI(1)+SUMI(2)-SK*SUMI(3),DX,DY,A,B)                         HNKL0146
      GO TO (200,305,400,500,500,700),MAP                               HNKL0147
  305 EA=1.                                                             HNKL0148
      EB=1.                                                             HNKL0149
      IF(MAG) 306,310,308                                               HNKL0150
  306 EA=2*MAG                                                          HNKL0151
      EA=EXPF(EA)                                                       HNKL0152
      MAG=-MAG                                                          HNKL0153
      GO TO 310                                                         HNKL0154
  308 EB=-2*MAG                                                         HNKL0155
      EB=EXPF(EB)                                                       HNKL0156
  310 HR=EA*HR-EB*A                                                     HNKL0157
      HI=EA*HI-EB*B                                                     HNKL0158
      GO TO 200                                                         HNKL0159
  400 CALLZEXP( SK*OI*6.2831853,-SK*OR*6.2831853,EXR,EXI,MTG)           HNKL0160
      CALLZMPY(EXR,EXI,A,B,A,B)                                         HNKL0161
      MTG=MTG-MAG                                                       HNKL0162
  403 EA=1.                                                             HNKL0163
      EB=1.                                                             HNKL0164
      IF(MAG-MTG)405,405,410                                            HNKL0165
  405 EA=MAG-MTG                                                        HNKL0166
      EA=EXPF(EA)                                                       HNKL0167
      MAG=MTG                                                           HNKL0168
      GO TO 310                                                         HNKL0169
  410 EB=MTG-MAG                                                        HNKL0170
      EB=EXPF(EB)                                                       HNKL0171
      GO TO 310                                                         HNKL0172
  500 M=((1.-ALPHA*SAL/CAL)*SBTA/CBTA+BETA)/3.1415927                   HNKL0173
      SMK=SIGNF(1.,CY)                                                  HNKL0174
      EM=M                                                              HNKL0175
      CALLZEXP(-SMK*3.1415927*OI*(EM+1.),SMK*3.1415927*OR*(EM+1.),EXR,EXHNKL0176
     1I,MEX)                                                            HNKL0177
      IF(OI) 515,501,515                                                HNKL0178
  501 MOR=OR                                                            HNKL0179
      TOR=MOR                                                           HNKL0180
      IF(ABSF(TOR-OR)-.5E-8) 502,502,515                                HNKL0181
  502 IF(XMODF(MOR,2)) 504,503,504                                      HNKL0182
  503 SOR=1.                                                            HNKL0183
      GO TO 505                                                         HNKL0184
  504 SOR=-1.                                                           HNKL0185
  505 ROA=1.                                                            HNKL0186
      ROB=2.*SOR                                                        HNKL0187
      MEX=0                                                             HNKL0188
      IF(MOR-2) 506,507,508                                             HNKL0189
  506 ROC=ROA                                                           HNKL0190
      GO TO 510                                                         HNKL0191
  507 ROC=ROB                                                           HNKL0192
      GO TO 510                                                         HNKL0193
  508 DO 509 I=3,M                                                      HNKL0194
      ROC=2.*SOR*ROB-ROA                                                HNKL0195
      ROA=ROB                                                           HNKL0196
  509 ROB=ROC                                                           HNKL0197
  510 ROI=0.                                                            HNKL0198
      GO TO 520                                                         HNKL0199
  515 CALLZSIN(EM*OR*3.1415927,EM*OI*3.1415927,SOR,SOI,MSO)             HNKL0200
      CALLZSIN(OR*3.1415927,OI*3.1415927,DOR,DOI,MDO)                   HNKL0201
      CALLZDIV(SOR,SOI,DOR,DOI,SOR,SOI)                                 HNKL0202
      CALLZMPY(SOR,SOI,EXR,EXI,ROC,ROI)                                 HNKL0203
      MEX=MEX+MSO-MDO                                                   HNKL0204
  520 GO TO (200,305,400,550,600,700),MAP                               HNKL0205
  550 IF(XABSF(MEX)-18) 560,560,552                                     HNKL0206
  552 IF(MEX) 553,560,565                                               HNKL0207
  553 ROC=1.                                                            HNKL0208
      ROI=0.                                                            HNKL0209
      MEX=0                                                             HNKL0210
      GO TO 565                                                         HNKL0211
  560 EMA=2.7182818**MEX                                                HNKL0212
      ROC=1.+EMA*ROC                                                    HNKL0213
      ROI=EMA*ROI                                                       HNKL0214
      MEX=0                                                             HNKL0215
  565 CALLZMPY(HR,HI,ROC,ROI,HR,HI)                                     HNKL0216
      EA=1.                                                             HNKL0217
      EB=1.                                                             HNKL0218
      IF(MAG+MEX) 570,570,575                                           HNKL0219
  570 EA=2.7182818**(2*MAG+MEX )                                        HNKL0220
      MAG=-MAG                                                          HNKL0221
      GO TO 310                                                         HNKL0222
  575 EB=2.7182818**(-2*MAG-MEX)                                        HNKL0223
      MAG=MAG+MEX                                                       HNKL0224
      GO TO 310                                                         HNKL0225
  600 CALLZMPY(ROC,ROI,-SK*A,-SK*B,A,B)                                 HNKL0226
      MEX=MEX-MAG                                                       HNKL0227
      EA=1.                                                             HNKL0228
      EB=1.                                                             HNKL0229
      IF(MAG-MEX) 610,310,620                                           HNKL0230
  610 EA=2.7182818**(MAG-MEX)                                           HNKL0231
      MAG=MEX                                                           HNKL0232
      GO TO 310                                                         HNKL0233
  620 EB=2.7182818**(MEX-MAG)                                           HNKL0234
      GO TO 310                                                         HNKL0235
  700 GO TO (705,710),KIND                                              HNKL0236
  705 HR=.5*HR                                                          HNKL0237
      HI=.5*HI                                                          HNKL0238
      GO TO 305                                                         HNKL0239
  710 A=-.5*A                                                           HNKL0240
      B=-.5*B                                                           HNKL0241
      GO TO 305                                                         HNKL0242
  900 CALLZEXP(3.1415927*ORDI,-3.1415927*ORDR,A,B,MA)                   HNKL0243
      CALLZMPY(HR,HI,A,B,HR,HI)                                         HNKL0244
      MAG=MAG+MA                                                        HNKL0245
  910 RETURN                                                            HNKL0246
  950 WRITE OUTPUT TAPE 6,951                                           HNKL0247
  951 FORMAT(46H HANKEL DOES NOT ACCEPT NEGATIVE RE(ARGUMENT).)         HNKL0248
      CALL EXIT                                                         HNKL0249
      END                                                               HNKL0250
