*     FAP                                                                       
       LBL     ISCOS                                                    ISCOS000
       COUNT   50                                                       ISCOS001
*     UNIVERSITY OF CHICAGO COMPLEX SINE AND COSINE SUBROUTINE          ISCOS002
*     CALLING SEQUENCE                                                  ISCOS003
*              TSX   $ISIN,4 AND TSX   $ICOS,4 RESPECTIVELY             ISCOS004
*     REAL ARGUMENT SHOULD BE BETWEEN PLUS AND MINUS 2**25              ISCOS005
*     IMAGINARY ARGUMENT MUST BE BETWEEN PLUS AND MINUS 88.028          ISCOS006
*     REAL ARGUMENT GOES IN CELL 32767, IMAGINARY ARGUMENT IN 32766     ISCOS007
*     ANSWER WILL APPEAR IN SAME CELLS                                  ISCOS008
       ENTRY   ISIN                                                     ISCOS009
       ENTRY   ICOS                                                     ISCOS010
  ISIN STL     FL            SET SINE FLAG                              ISCOS011
  ICOS SXA     X4,4          SAVE INDEX 4                               ISCOS012
       CLA     L                                                        ISCOS013
       SSP                                                              ISCOS014
       LDQ     MAXIM         TEST FOR                                   ISCOS015
       TLQ     GOOF            PROPER RANGE                             ISCOS016
       CLA     M                 OF ARGUMENTS                           ISCOS017
       SSP                                                              ISCOS018
       LDQ     MAXRL                                                    ISCOS019
       TLQ     GOOF                                                     ISCOS020
       TSX     $COS,4                                                   ISCOS021
       STO     B1                                                       ISCOS022
       CLA     M                                                        ISCOS023
       TSX     $SIN,4                                                   ISCOS024
       STO     B2                                                       ISCOS025
       CLA     L                                                        ISCOS026
       TSX     $SINH,4                                                  ISCOS027
       STO     B3                                                       ISCOS028
       CLA     L                                                        ISCOS029
       TSX     $COSH,4                                                  ISCOS030
       XCA                                                              ISCOS031
       ZET     FL                                                       ISCOS032
       TRA     SINE                                                     ISCOS033
       FMP     B1            ICOS = (COS X)(COSH Y)                     ISCOS034
       FRN                                                              ISCOS035
       STO     M               -I(SIN X)(SINH Y)                        ISCOS036
       CLS     B2                                                       ISCOS037
       XCA                                                              ISCOS038
       TRA     CON                                                      ISCOS039
  SINE FMP     B2            ISIN = (SIN X)(COSH Y)                     ISCOS040
       FRN                                                              ISCOS041
       STO     M               +I(COS X)(SINH Y)                        ISCOS042
       LDQ     B1                                                       ISCOS043
   CON FMP     B3                                                       ISCOS044
       FRN                                                              ISCOS045
       STO     L                                                        ISCOS046
    X4 AXT     **,4          RESET INDEX                                ISCOS047
       STZ     FL              AND FLAG                                 ISCOS048
       TRA     1,4           RETURN                                     ISCOS049
  GOOF LDI     *+2                                                      ISCOS050
       TRA*    $(EXE)                                                   ISCOS051
       PZE     4,7,X4                                                   ISCOS052
 MAXRL OCT     231777777777                                             ISCOS053
 MAXIM OCT     207540071260  88.028                                     ISCOS054
    B1 PZE                                                              ISCOS055
    B2 PZE                                                              ISCOS056
    B3 PZE                                                              ISCOS057
    FL PZE                                                              ISCOS058
     M EQU     -1                                                       ISCOS059
     L EQU     -2                                                       ISCOS060
       END                                                              ISCOS061
