*     FAP                                                                       
       LBL     EXP                                                      EXP00000
       COUNT   60                                                       EXP00001
*      U. OF CHICAGO VERSION OF SINGLE PRECISION EXPONENTIAL ROUTINE    EXP00002
*              CALLING SEQUENCE    TSX   $EXP,4   OR   TSX   $NEXP,4    EXP00003
*              (EXEM) ERROR IS GIVEN IF ARG IS GREATER THAN 88.029692   EXP00004
       SPACE                                                            EXP00005
       ENTRY   EXP                                                      EXP00006
       ENTRY   NEXP                                                     EXP00007
 NEXP  CHS                                                              EXP00008
 EXP   LDQ     MAXIM                                                    EXP00009
       TLQ     GOOF          IF ARG TOO LARGE, GIVE ERROR               EXP00010
       LDQ     MINIM                                                    EXP00011
       TLQ     *+3                                                      EXP00012
       ZAC                   IF ARG TOO SMALL, GIVE ZERO ANS            EXP00013
       TRA     1,4                                                      EXP00014
       LDQ     CNVRT         CLEAR MQ                                   EXP00015
       LRS     27                                                       EXP00016
       SSM                                                              EXP00017
       ADD     CNVRT         CONVERT TO FIXED POINT                     EXP00018
       STA     SHIFT                                                    EXP00019
       MPY     LOGE2         MULTIPLY BY LOG E BASE 2                   EXP00020
 SHIFT LRS     **                                                       EXP00021
       ALS     27            SEPARATE INTEGER AND FRACTION              EXP00022
       STO     SAVE1                                                    EXP00023
       LRS     4                                                        EXP00024
       STQ     SAVE2                                                    EXP00025
       MPY     SAVE2         COMPUTE E**X*LN2                           EXP00026
       STO     SAVE3           USING CONTINUED FRACTION                 EXP00027
       ADD     A                                                        EXP00028
       STO     SAVE4                                                    EXP00029
       CLA     B                                                        EXP00030
       DVP     SAVE4                                                    EXP00031
       STQ     SAVE4                                                    EXP00032
       LDQ     SAVE3                                                    EXP00033
       MPY     C                                                        EXP00034
       LLS     4                                                        EXP00035
       SUB     SAVE4                                                    EXP00036
       ADD     D                                                        EXP00037
       SUB     SAVE2                                                    EXP00038
       STO     SAVE4                                                    EXP00039
       CLA     SAVE2                                                    EXP00040
       LDQ     FPNT1                                                    EXP00041
       VDP     SAVE4,0,28                                               EXP00042
       XCA                                                              EXP00043
       ORA     FPFRM                                                    EXP00044
       FAD     FPNT1                                                    EXP00045
       FRN                                                              EXP00046
       ADD     SAVE1                                                    EXP00047
       TRA     1,4           RETURN TO MAIN PROGRAM                     EXP00048
       SPACE                                                            EXP00049
 GOOF  LDI     *+2                                                      EXP00050
       TTR*    $(EXE)                                                   EXP00051
       PZE     5,6,*+1                                                  EXP00052
       CLA     ONES                                                     EXP00053
       TRA     1,4                                                      EXP00054
       SPACE                                                            EXP00055
 MAXIM OCT     207540074636        88.029692                            EXP00056
 MINIM OCT     -207545523742       -89.415987                           EXP00057
 ONES  OCT     777777777777                                             EXP00058
 LOGE2 OCT     270524354513  1.442695049B1                              EXP00059
 CNVRT OCT     242                                                      EXP00060
 FPNT1 OCT     201400000000                                             EXP00061
 FPFRM OCT     200000000000                                             EXP00062
 A     OCT     127325604305  87.417497202B8                             EXP00063
 B     OCT     046477071524  617.9722695B12                             EXP00064
 C     OCT     010676467775  0.03465735903B0                            EXP00065
 D     OCT     237214030721  9.9545957821B4                             EXP00066
 SAVE1 BSS     1                                                        EXP00067
 SAVE2 BSS     1                                                        EXP00068
 SAVE3 BSS     1                                                        EXP00069
 SAVE4 BSS     1                                                        EXP00070
       END                                                              EXP00071
