CBES6I NYU MATH UTILITY BESSEL I FUNCTION  3/15/64     F. RAGUSA        BE6I0010
      FUNCTION BES6I(X,FNUP,IVAR)                                       BE6I0020
C                      IVAR IS A DUMMY VARIABLE WHICH IS SET TO         BE6I0030
C                        131070 WHEN BESI IC CALLED BY BESK.            BE6I0040
C                                                                       BE6I0050
      DIMENSION BI(150)                                                 BE6I0060
C      IDIM AGREES WITH THE DIMENSION FO R BI. TO CHANGE DIMENSION      BE6I0070
C             CHANGE DIMENSION STATEMENT AND IDIM.                      BE6I0080
C                                                                       BE6I0090
      IDIM=150                                                          BE6I0100
       IY=1                                                             BE6I0110
       IF(IVAR-131070) 2,1,2                                            BE6I0120
    1  IY=2                                                             BE6I0130
    2 IVAR=XLOCF(BI)                                                    BE6I0140
      R=FNUP                                                            BE6I0150
       N=0                                                              BE6I0160
      FNU=0.0                                                           BE6I0170
       IF(R) 22,29,25                                                   BE6I0180
 22    N=-1                                                             BE6I0190
 23    R=R+1.0                                                          BE6I0200
       FNU=R                                                            BE6I0210
       IF(R) 24,27,27                                                   BE6I0220
 24    N=N-1                                                            BE6I0230
       FNU=R                                                            BE6I0240
        GO TO 23                                                        BE6I0250
 25    FNU=R                                                            BE6I0260
       R=R-1.0                                                          BE6I0270
       IF(R) 27,26,26                                                   BE6I0280
 26    N=N+1                                                            BE6I0290
       GO TO 25                                                         BE6I0300
 27   IF(FNU) 28,28,29                                                  BE6I0310
 28   N=XABSF(N)                                                        BE6I0320
      FNU=ABSF(FNU)                                                     BE6I0330
 29   NN=XABSF(N)                                                       BE6I0340
       CONST=2.0/X                                                      BE6I0350
        IF(X-50.) 30,17,17                                              BE6I0360
 30    X10=X+25.0                                                       BE6I0370
       K10=X10                                                          BE6I0380
       N10=NN+10                                                        BE6I0390
       M=XMAX0F(K10,N10)                                                BE6I0400
C                                                                       BE6I0410
       IF(X-1.0) 3,40,40                                                BE6I0420
    3  KP=172.69388/(3.6888795-LOGF(X))                                 BE6I0430
       M=XMIN0F(M,KP)                                                   BE6I0440
       GO TO 4                                                          BE6I0450
C                                                                       BE6I0460
 40    KP=39.*X**.3333333                                               BE6I0470
       M=XMIN0F(M,KP)                                                   BE6I0480
    4  M=M/2                                                            BE6I0490
       K=2*M+1                                                          BE6I0500
       IF(K+2-IDIM) 42,42,305                                           BE6I0510
 42    K2=K+1                                                           BE6I0520
       K3=K+2                                                           BE6I0530
       BI(K2)=1.0E-37                                                   BE6I0540
       BI(K3)=0.0                                                       BE6I0550
       DO 5  L=1,K                                                      BE6I0560
       I=K+1-L                                                          BE6I0570
       FLI=I                                                            BE6I0580
    5  BI(I)=CONST*(FLI+FNU)*BI(I+1)+BI(I+2)                            BE6I0590
C                                                                       BE6I0600
       IF(X-10.0) 6,17,17                                               BE6I0610
    6  PSI=2.0*(FNU+1.0)                                                BE6I0620
       ALF=PSI*BI(2)+BI(1)                                              BE6I0630
       K1=K-1                                                           BE6I0640
        DO 7  I=2,K1                                                    BE6I0650
       J=I+1                                                            BE6I0660
       FLI=I                                                            BE6I0670
       FIM=I-1                                                          BE6I0680
       TEMP=((FNU+FLI)*(2.0*FNU+FIM))/(FLI*(FNU+FIM))*PSI               BE6I0690
       PSI=TEMP                                                         BE6I0700
    7  ALF=PSI*BI(J)+ALF                                                BE6I0710
C                                                                       BE6I0720
      ALF=CONST**FNU*GAMMAF(FNU+1.0,0)*ALF                              BE6I0730
C                                                                       BE6I0740
       I1=1                                                             BE6I0750
    8  DO 9  I=I1,K                                                     BE6I0760
    9   BI(I)=BI(I)/ALF                                                 BE6I0770
       BESSL=BI(NN+1)                                                   BE6I0780
C                                                                       BE6I0790
       IF(N) 10,14,14                                                   BE6I0800
 10    IF(IY-2) 13,15,13                                                BE6I0810
C                                                                       BE6I0820
 13    BI(2)=CONST*FNU*BI(1)+BI(2)                                      BE6I0830
       BESSL=BI(2)                                                      BE6I0840
C                                                                       BE6I0850
       IF(NN-1) 14,14,11                                                BE6I0860
C                                                                       BE6I0870
 11    FRAC=FNU                                                         BE6I0880
       N1=NN-1                                                          BE6I0890
         DO 12  I=1,N1                                                  BE6I0900
        FRAC=FRAC-1.0                                                   BE6I0910
        BI(I+2)=CONST*FRAC*BI(I+1)+BI(I)                                BE6I0920
 12    BESSL=BI(I+2)                                                    BE6I0930
C                                                                       BE6I0940
 14    GO TO (16,15),IY                                                 BE6I0950
 15    X=FK1                                                            BE6I0960
       FNUP=FK2                                                         BE6I0970
 16    BES6I= BESSL                                                     BE6I0980
       RETURN                                                           BE6I0990
 17     IF(NN+1-IDIM) 43,43,305                                         BE6I1000
   43  KOUNT=1                                                          BE6I1010
       GNU=FNU                                                          BE6I1020
      C0=.25                                                            BE6I1030
       C1 =.15625                                                       BE6I1040
       C2 =-.375                                                        BE6I1050
       C3 =.1171875                                                     BE6I1060
       C4 =-1.15625                                                     BE6I1070
       C5 =1.875                                                        BE6I1080
       C6 =.09521484375                                                 BE6I1090
       C7 =-2.38671875                                                  BE6I1100
       C8 =14.2265625                                                   BE6I1110
       C9 =-19.68750                                                    BE6I1120
       C10=8.093261719E-2                                               BE6I1130
       C11=-4.100585937                                                 BE6I1140
       C12=58.224609375                                                 BE6I1150
       C13=-277.87500                                                   BE6I1160
       C14=354.3750                                                     BE6I1170
       C15=.0416666666                                                  BE6I1180
       C16=-.25                                                         BE6I1190
       C17=.125E-1                                                      BE6I1200
       C18=-.350                                                        BE6I1210
       C19=.000558035718                                                BE6I1220
       C20=- .4241071428                                                BE6I1230
       C21=3.60267857                                                   BE6I1240
       C22=-5.625                                                       BE6I1250
       C23=.0030381944                                                  BE6I1260
       C24=-.486111                                                     BE6I1270
       C25=10.28645833                                                  BE6I1280
       C26=-58.0                                                        BE6I1290
       C27=78.75                                                        BE6I1300
C                                                                       BE6I1310
   18 AL1=GNU**2-.25                                                    BE6I1320
       A2 =C0*AL1                                                       BE6I1330
       A4 =C1*AL1                                                       BE6I1340
       A4=(A4+C2)*AL1                                                   BE6I1350
       A6=C3*AL1                                                        BE6I1360
       A6=(A6+C4)*AL1                                                   BE6I1370
       A6=(A6+C5)*AL1                                                   BE6I1380
       A8=C6*AL1                                                        BE6I1390
       A8=(A8+C7 )*AL1                                                  BE6I1400
       A8=(A8+C8 )*AL1                                                  BE6I1410
       A8=(A8+C9 )*AL1                                                  BE6I1420
       A10=C10*AL1                                                      BE6I1430
       A10=(A10+C11)*AL1                                                BE6I1440
       A10=(A10+C12)*AL1                                                BE6I1450
       A10=(A10+C13)*AL1                                                BE6I1460
       A10=(A10+C14)*AL1                                                BE6I1470
C                                                                       BE6I1480
   19 PI=3.1415926535879                                                BE6I1490
       TS=1.0/X                                                         BE6I1500
       T2=TS**2                                                         BE6I1510
C                                                                       BE6I1520
      B=-A10*T2+A8                                                      BE6I1530
      B=B*T2-A6                                                         BE6I1540
      B=B*T2+A4                                                         BE6I1550
      B=B*T2-A2                                                         BE6I1560
      DOVT=B*T2+1.0                                                     BE6I1570
C                                                                       BE6I1580
       A2=.5*AL1                                                        BE6I1590
       A4=C15*AL1                                                       BE6I1600
       A4=(A4+C16)*AL1                                                  BE6I1610
       A6=C17*AL1                                                       BE6I1620
       A6=(A6+C18)*AL1                                                  BE6I1630
       A6=(A6+.75)*AL1                                                  BE6I1640
       A8=C19*AL1                                                       BE6I1650
       A8=(A8+C20)*AL1                                                  BE6I1660
       A8=(A8+C21)*AL1                                                  BE6I1670
       A8=(A8+C22)*AL1                                                  BE6I1680
       A10=C23*AL1                                                      BE6I1690
       A10=(A10+C24)*AL1                                                BE6I1700
       A10=(A10+C25)*AL1                                                BE6I1710
       A10=(A10+C26)*AL1                                                BE6I1720
       A10=(A10+C27)*AL1                                                BE6I1730
C                                                                       BE6I1740
      B=-A10*T2+A8                                                      BE6I1750
      B=B*T2-A6                                                         BE6I1760
      B=B*T2+A4                                                         BE6I1770
      B=B*T2-A2                                                         BE6I1780
      BNU=B*T2                                                          BE6I1790
C                                                                       BE6I1800
   20 F1=DOVT*SQRTF(TS/(PI*2.))*EXPF(BNU*X)*(1.-EXPF(-2.*X*(1.+BNU)))   BE6I1810
      FK1=DOVT*SQRTF((PI*TS)/2.)*EXPF(-X*BNU)                           BE6I1820
C                                                                       BE6I1830
       IF (KOUNT-1) 121,121,122                                         BE6I1840
 121   FSAVE=F1                                                         BE6I1850
       FKSVE=FK1                                                        BE6I1860
       GNU=FNU+1.0                                                      BE6I1870
       KOUNT=2                                                          BE6I1880
       GO TO 18                                                         BE6I1890
C                                                                       BE6I1900
 122   F2=F1                                                            BE6I1910
       FK2=FK1                                                          BE6I1920
       F1=FSAVE                                                         BE6I1930
       FK1=FKSVE                                                        BE6I1940
       IF(X-50.) 123,127,127                                            BE6I1950
C                                                                       BE6I1960
 123   IF(ABSF(F1)-ABSF(F2)) 124,124,125                                BE6I1970
 124   ALF=BI(2)/F2                                                     BE6I1980
       GO TO 126                                                        BE6I1990
C                                                                       BE6I2000
 125  ALF=BI(1)/F1                                                      BE6I2010
 126  BI(1)=F1                                                          BE6I2020
       BI(2)=F2                                                         BE6I2030
      I1=3                                                              BE6I2040
      GO TO 8                                                           BE6I2050
C                                                                       BE6I2060
 127   BI(1)=F1                                                         BE6I2070
       BI(2)=F2                                                         BE6I2080
       IF(N) 10,130,128                                                 BE6I2090
 128  IF(N-1) 130,131,129                                               BE6I2100
C                                                                       BE6I2110
 129  N1=NN+1                                                           BE6I2120
       FLI=0.0                                                          BE6I2130
       DO 132  I=3,N1                                                   BE6I2140
       FLI=FLI+1.0                                                      BE6I2150
 132   BI(I)=-(CONST*(FNU+FLI)*BI(I-1)-BI(I-2))                         BE6I2160
       BESSL=BI(N1)                                                     BE6I2170
       GO TO 14                                                         BE6I2180
C                                                                       BE6I2190
 130   BESSL=BI(1)                                                      BE6I2200
       GO TO 14                                                         BE6I2210
C                                                                       BE6I2220
 131   BESSL=BI(2)                                                      BE6I2230
       GO TO 14                                                         BE6I2240
C                                                                       BE6I2250
 305  IVAR=0                                                            BE6I2260
      DO 306 I=1,IDIM                                                   BE6I2270
 306  BI(I)=0.0                                                         BE6I2280
       BESSL=0.0                                                        BE6I2290
       GO TO 14                                                         BE6I2300
      END                                                               BE6I2310
CBES6J NYU MATH UTILITY BESSEL J FUNCTION  3/15/64     F. RAGUSA        BE6J0010
      FUNCTION BES6J(X,FNUP,IVAR)                                       BE6J0020
C                                                                       BE6J0030
C                IVAR IS A DUMMY VAR.WHICH=131070 WHEN J CALLED BY Y.   BE6J0040
C                                                                       BE6J0050
      DIMENSION BJ(150)                                                 BE6J0060
C                                                                       BE6J0070
C     IDIM SPECIFIES ARRAY SIZE OF BJ. IF ARRAY SIXE TO BE CHANGED THEN BE6J0080
C      CHANGE DIMENSION STATEMENT AND IDIM.                             BE6J0090
      IDIM=150                                                          BE6J0100
      IY=1                                                              BE6J0110
       IF(IVAR-131070) 2,1,2                                            BE6J0120
    1 IY=2                                                              BE6J0130
    2 IVAR=XLOCF(BJ)                                                    BE6J0140
       R=FNUP                                                           BE6J0150
      N=0                                                               BE6J0160
      FNU=0.0                                                           BE6J0170
      IF(R)3,10,6                                                       BE6J0180
    3 N=-1                                                              BE6J0190
    4 R=R+1.0                                                           BE6J0200
      FNU=R                                                             BE6J0210
      IF(R)5,8,8                                                        BE6J0220
    5 N=N-1                                                             BE6J0230
      FNU=R                                                             BE6J0240
      GO TO 4                                                           BE6J0250
    6 FNU=R                                                             BE6J0260
      R=R-1.0                                                           BE6J0270
      IF(R)8,7,7                                                        BE6J0280
    7 N=N+1                                                             BE6J0290
      GO TO 6                                                           BE6J0300
    8 IF(FNU)9,9,10                                                     BE6J0310
    9 N=XABSF(N)                                                        BE6J0320
      FNU=ABSF(FNU)                                                     BE6J0330
   10 NN=XABSF(N)                                                       BE6J0340
      CONST=2.0/X                                                       BE6J0350
       IF(X-50.) 11,28,28                                               BE6J0360
   11  X10=X+25.0                                                       BE6J0370
      K10=X10                                                           BE6J0380
      N10=NN+10                                                         BE6J0390
      M=XMAX0F(K10,N10)                                                 BE6J0400
C                                                                       BE6J0410
        IF(X-1.0) 12,13,13                                              BE6J0420
C                                                                       BE6J0430
   12 KP=172.69388/(3.6888795-LOGF(X))                                  BE6J0440
      M=XMIN0F(M,KP)                                                    BE6J0450
       GO TO 14                                                         BE6J0460
C                                                                       BE6J0470
   13  KP=39.*X**.3333333                                               BE6J0480
       M=XMIN0F(M,KP)                                                   BE6J0490
   14 M=M/2                                                             BE6J0500
      K=2*M+1                                                           BE6J0510
C      TEST K+2 TOO LARGE FOR DIMENSION OF BJ.                          BE6J0520
       IF(K+2-IDIM) 15,15,43                                            BE6J0530
   15 BJ(K+1)=1.0E-37                                                   BE6J0540
      BJ(K+2)=0.0                                                       BE6J0550
      DO 16 L=1,K                                                       BE6J0560
      I=K+1-L                                                           BE6J0570
      FLI=I                                                             BE6J0580
      BJ(I)=CONST*(FLI+FNU)*BJ(I+1)-BJ(I+2)                             BE6J0590
   16 CONTINUE                                                          BE6J0600
C                                                                       BE6J0610
C     FIND ALPHA.EQU.12,PG.4 WHEN X LESS THAN 10.                       BE6J0620
C     OR FROM BESSEL FUNCT. FOR LARGE ARG. BY GOLDSTEIN.                BE6J0630
C                                                                       BE6J0640
      IF(X-10.0)17,28,28                                                BE6J0650
C                                                                       BE6J0660
   17 PHI=FNU+2.0                                                       BE6J0670
      ALF=PHI*BJ(3)+BJ(1)                                               BE6J0680
      MO=3                                                              BE6J0690
      DO 18 I=2,M                                                       BE6J0700
      MO=MO+2                                                           BE6J0710
      FM2=2*I                                                           BE6J0720
      FM1=I-1                                                           BE6J0730
      FI=I                                                              BE6J0740
      TEMP=((FNU+FM2)*(FNU+FM1))/(FI*(FNU+FM2-2.0))*PHI                 BE6J0750
      PHI=TEMP                                                          BE6J0760
      ALF=PHI*BJ(MO)+ALF                                                BE6J0770
   18 CONTINUE                                                          BE6J0780
C                                                                       BE6J0790
      ALF=CONST**FNU *GAMMAF(FNU+1.0,0)*ALF                             BE6J0800
C                                                                       BE6J0810
      I1=1                                                              BE6J0820
C                                                                       BE6J0830
   19 DO 20 I=I1,K                                                      BE6J0840
      BJ(I)=BJ(I)/ALF                                                   BE6J0850
   20 CONTINUE                                                          BE6J0860
      BESSL=BJ(NN+1)                                                    BE6J0870
      IF(N)21,25,25                                                     BE6J0880
   21 IF(IY-2)22,26,22                                                  BE6J0890
   22 BJ(2)=CONST*FNU*BJ(1)-BJ(2)                                       BE6J0900
      BESSL=BJ(2)                                                       BE6J0910
C                                                                       BE6J0920
      IF(NN-1)25,25,23                                                  BE6J0930
   23 FRAC=FNU                                                          BE6J0940
      N1=NN+1                                                           BE6J0950
      DO 24 L=3,N1                                                      BE6J0960
      FRAC=FRAC-1.0                                                     BE6J0970
      BJ(L)=CONST*FRAC*BJ(L-1)-BJ(L-2)                                  BE6J0980
   24 CONTINUE                                                          BE6J0990
      BESSL=BJ(NN+1)                                                    BE6J1000
C                                                                       BE6J1010
   25 GO TO (27,26),IY                                                  BE6J1020
   26 X=Y1                                                              BE6J1030
      FNUP=Y2                                                           BE6J1040
   27 BES6J=BESSL                                                       BE6J1050
        RETURN                                                          BE6J1060
C                                                                       BE6J1070
C                                                                       BE6J1080
C     COMPUTE J(1) FROM M.GOLDSTEIN PAPER BESSEL                        BE6J1090
C     FUNCTIONS FOR LARGE ARGUMENTS.                                    BE6J1100
C                                                                       BE6J1110
   28 IF(NN+1-IDIM) 29,29,43                                            BE6J1120
   29 KOUNT=1                                                           BE6J1130
       GNU=FNU                                                          BE6J1140
       C0 =.25                                                          BE6J1150
       C1 =.15625                                                       BE6J1160
       C2 =-.375                                                        BE6J1170
       C3 =.1171875                                                     BE6J1180
       C4 =-1.15625                                                     BE6J1190
       C5 =1.875                                                        BE6J1200
       C6 =.09521484375                                                 BE6J1210
       C7 =-2.38671875                                                  BE6J1220
       C8 =14.2265625                                                   BE6J1230
       C9 =-19.68750                                                    BE6J1240
       C10=8.093261719E-2                                               BE6J1250
       C11=-4.100585937                                                 BE6J1260
       C12=58.224609375                                                 BE6J1270
       C13=-277.87500                                                   BE6J1280
       C14=354.3750                                                     BE6J1290
       C15=.0416666666                                                  BE6J1300
       C16=-.25                                                         BE6J1310
       C17=.125E-1                                                      BE6J1320
       C18=-.350                                                        BE6J1330
       C19=.000558035718                                                BE6J1340
       C20=- .4241071428                                                BE6J1350
       C21=3.60267857                                                   BE6J1360
       C22=-5.625                                                       BE6J1370
       C23=.0030381944                                                  BE6J1380
       C24=-.486111                                                     BE6J1390
       C25=10.28645833                                                  BE6J1400
       C26=-58.0                                                        BE6J1410
       C27=78.75                                                        BE6J1420
C                                                                       BE6J1430
   30 AL1=GNU**2-.25                                                    BE6J1440
       A2 =C0*AL1                                                       BE6J1450
       A4 =C1*AL1                                                       BE6J1460
       A4=(A4+C2)*AL1                                                   BE6J1470
       A6=C3*AL1                                                        BE6J1480
       A6=(A6+C4)*AL1                                                   BE6J1490
       A6=(A6+C5)*AL1                                                   BE6J1500
       A8=C6*AL1                                                        BE6J1510
       A8=(A8+C7 )*AL1                                                  BE6J1520
       A8=(A8+C8 )*AL1                                                  BE6J1530
       A8=(A8+C9 )*AL1                                                  BE6J1540
       A10=C10*AL1                                                      BE6J1550
       A10=(A10+C11)*AL1                                                BE6J1560
       A10=(A10+C12)*AL1                                                BE6J1570
       A10=(A10+C13)*AL1                                                BE6J1580
       A10=(A10+C14)*AL1                                                BE6J1590
C                                                                       BE6J1600
       PI=3.141592654                                                   BE6J1610
       TS=1.0/X                                                         BE6J1620
       T2=TS**2                                                         BE6J1630
C                                                                       BE6J1640
       B=A10*T2+A8                                                      BE6J1650
       B=B*T2+A6                                                        BE6J1660
       B=B*T2+A4                                                        BE6J1670
       B=B*T2+A2                                                        BE6J1680
       BNU=B*T2+1.0                                                     BE6J1690
C                                                                       BE6J1700
       ANU=BNU/SQRTF(.5*PI*X)                                           BE6J1710
C                                                                       BE6J1720
C       PAGE 20, EQUATION 12 TO GET PHI ZERO                            BE6J1730
C                                                                       BE6J1740
       A2=.5*AL1                                                        BE6J1750
       A4=C15*AL1                                                       BE6J1760
       A4=(A4+C16)*AL1                                                  BE6J1770
       A6=C17*AL1                                                       BE6J1780
       A6=(A6+C18)*AL1                                                  BE6J1790
       A6=(A6+.75)*AL1                                                  BE6J1800
       A8=C19*AL1                                                       BE6J1810
       A8=(A8+C20)*AL1                                                  BE6J1820
       A8=(A8+C21)*AL1                                                  BE6J1830
       A8=(A8+C22)*AL1                                                  BE6J1840
       A10=C23*AL1                                                      BE6J1850
       A10=(A10+C24)*AL1                                                BE6J1860
       A10=(A10+C25)*AL1                                                BE6J1870
       A10=(A10+C26)*AL1                                                BE6J1880
       A10=(A10+C27)*AL1                                                BE6J1890
C                                                                       BE6J1900
       B=A10*T2+A8                                                      BE6J1910
       B=B*T2+A6                                                        BE6J1920
       B=B*T2+A4                                                        BE6J1930
       B=B*T2+A2                                                        BE6J1940
       TPHI=B*T2+1.0                                                    BE6J1950
       PHI=TPHI*X -(GNU+.5)*(PI/2.0)                                    BE6J1960
       COP=COSF(PHI)                                                    BE6J1970
       SIP=SINF(PHI)                                                    BE6J1980
C                                                                       BE6J1990
       F1=ANU*COP                                                       BE6J2000
       Y1=ANU*SIP                                                       BE6J2010
C                                                                       BE6J2020
C                                                                       BE6J2030
      IF(KOUNT-1)31,31,32                                               BE6J2040
C                                                                       BE6J2050
   31 FSAVE=F1                                                          BE6J2060
       YSAVE=Y1                                                         BE6J2070
       GNU=FNU+1.0                                                      BE6J2080
       KOUNT=2                                                          BE6J2090
      GO TO 30                                                          BE6J2100
C                                                                       BE6J2110
   32 F2=F1                                                             BE6J2120
       Y2=Y1                                                            BE6J2130
       F1=FSAVE                                                         BE6J2140
       Y1=YSAVE                                                         BE6J2150
C                                                                       BE6J2160
       IF(X-50.) 33,37,37                                               BE6J2170
C                                                                       BE6J2180
   33 IF(ABSF(F1)-ABSF(F2))34,34,35                                     BE6J2190
C                                                                       BE6J2200
   34 ALF=BJ(2)/F2                                                      BE6J2210
      GO TO 36                                                          BE6J2220
C                                                                       BE6J2230
   35 ALF=BJ(1)/F1                                                      BE6J2240
   36 BJ(1)=F1                                                          BE6J2250
      BJ(2)=F2                                                          BE6J2260
      I1=3                                                              BE6J2270
      GO TO 19                                                          BE6J2280
C                                                                       BE6J2290
   37 BJ(1)=F1                                                          BE6J2300
       BJ(2)=F2                                                         BE6J2310
       IF( N) 21,38,39                                                  BE6J2320
   38  BESSL=BJ(1)                                                      BE6J2330
       GO TO 25                                                         BE6J2340
C                                                                       BE6J2350
   39 IF(N-1) 38,40,41                                                  BE6J2360
   40 BESSL=BJ(2)                                                       BE6J2370
      GO TO 25                                                          BE6J2380
C                                                                       BE6J2390
 41   N1=NN+1                                                           BE6J2400
       FLI=0.0                                                          BE6J2410
       DO 42  I=3,N1                                                    BE6J2420
       FLI=FLI+1.0                                                      BE6J2430
   42  BJ(I)=CONST*(FNU+FLI)*BJ(I-1)-BJ(I-2)                            BE6J2440
       BESSL=BJ(N1)                                                     BE6J2450
       GO TO 25                                                         BE6J2460
   43 IVAR=0                                                            BE6J2470
       BESSL=0.0                                                        BE6J2480
      DO 44 I=1,IDIM                                                    BE6J2490
   44 BJ(I)=0.0                                                         BE6J2500
      GO TO 25                                                          BE6J2510
      END                                                               BE6J2520
CBES6Y NYU MATH UTILITY BESSEL Y FUNCTION    3/15/64   F. RAGUSA        BE6Y0010
      FUNCTION BES6Y(X,FNUP,IVAR)                                       BE6Y0020
      DIMENSION BY(150),BJ(1)                                           BE6Y0030
C      IVAR IS A DUMMY VARIAVLE USED BY BESY WHEN CALLING BESJ.         BE6Y0040
C      BESY SETS IVAR TO 131070 GOING INTO BESJ.  UPON RETURN FROM      BE6Y0050
C       BESJ IVAR=XLOCF(BJ).  WHERE BJ IS THE NAME OF THE ARRAY         BE6Y0060
C        WITHIN BESJ CONTAINING THE J VALUES.  IF IVAR =0 UPON RETURN   BE6Y0070
C      THIS IS AN ERROR INDICATOR FROM BESJ.                            BE6Y0080
C         IF NO ERROR THEN BESJ ALSO RETURNS A VALUE FOR BK(1), BK(2)   BE6Y0090
C          WHEN X IS GREATER THAN OR EQUAL TO 10.0.  THESE VALUES       BE6Y0100
C         ARE COMMUNICATED TO BESY THROUGH X AND FNUP.                  BE6Y0110
      IDIM=150                                                          BE6Y0120
       IVAR=131070                                                      BE6Y0130
      SAVENU=FNUP                                                       BE6Y0140
      SAVEX=X                                                           BE6Y0150
      GETJ= BES6J(X,FNUP,IVAR)                                          BE6Y0160
      BY(1)=X                                                           BE6Y0170
       YNU=BY(1)                                                        BE6Y0180
      BY(2)=FNUP                                                        BE6Y0190
      X=SAVEX                                                           BE6Y0200
      FNUP=SAVENU                                                       BE6Y0210
        IF(IVAR) 1,36,1                                                 BE6Y0220
 1    LOCJ=IVAR                                                         BE6Y0230
      LOCY=XLOCF(BJ)                                                    BE6Y0240
      KL=LOCY-LOCJ+32768                                                BE6Y0250
      R=FNUP                                                            BE6Y0260
      N=0                                                               BE6Y0270
      FNU=0.0                                                           BE6Y0280
       IF(R) 4,35,7                                                     BE6Y0290
    4 N=-1                                                              BE6Y0300
    5 R=R+1.0                                                           BE6Y0310
      FNU=R                                                             BE6Y0320
      IF(R)6,9,9                                                        BE6Y0330
    6 N=N-1                                                             BE6Y0340
      FNU=R                                                             BE6Y0350
      GO TO 5                                                           BE6Y0360
    7 FNU=R                                                             BE6Y0370
      R=R-1.0                                                           BE6Y0380
      IF(R)9,8,8                                                        BE6Y0390
    8 N=N+1                                                             BE6Y0400
      GO TO 7                                                           BE6Y0410
    9  IF(FNU) 34,34,35                                                 BE6Y0420
 34    N=XABSF(N)                                                       BE6Y0430
       FNU=ABSF(FNU)                                                    BE6Y0440
 35   NN=XABSF(N)                                                       BE6Y0450
      N1=NN-1                                                           BE6Y0460
      CONST=2.0/X                                                       BE6Y0470
      PI=3.141592654                                                    BE6Y0480
      IF(X-10.0)10,23,23                                                BE6Y0490
   10 X10=X+25.                                                         BE6Y0500
      K10=X10                                                           BE6Y0510
      N10=NN+10                                                         BE6Y0520
      M=XMAX0F(K10,N10)                                                 BE6Y0530
       IF(X-1.0) 11,2,2                                                 BE6Y0540
   11 KP=172.69388/(3.6888795-LOGF(X))                                  BE6Y0550
      M=XMIN0F(M,KP)                                                    BE6Y0560
       GO TO 12                                                         BE6Y0570
C                                                                       BE6Y0580
    2  KP=39.*X**.3333333                                               BE6Y0590
       M=XMIN0F(M,KP)                                                   BE6Y0600
   12 M=M/2                                                             BE6Y0610
      K=2*M+1                                                           BE6Y0620
      ARG=FNU*PI                                                        BE6Y0630
      GARG=GAMMAF(1.0+FNU,0)**2                                         BE6Y0640
C                                                                       BE6Y0650
C     COMPUTE GAMMA ZERO.EQUA.15,PG.5.IF NU=0USE EQU.16.                BE6Y0660
C                                                                       BE6Y0670
   14 IF(FNU)15,16,15                                                   BE6Y0680
   15 TERM=(1.0/PI)*CONST**(2.0*FNU)                                    BE6Y0690
      GAM1=COSF(ARG)/SINF(ARG)-TERM*(GARG/FNU)                          BE6Y0700
      GAM2=2.0*TERM*GARG*(FNU+2.0)/(1.0-FNU)                            BE6Y0710
      GO TO 17                                                          BE6Y0720
C                                                                       BE6Y0730
C     COMPUTE GAMMA FOR NU=0.                                           BE6Y0740
   16 TLOG=LOGF(X/2.0)                                                  BE6Y0750
      A=57.72156649E-2                                                  BE6Y0760
      PIH=2.0/PI                                                        BE6Y0770
      GAM1=PIH*(A+TLOG)                                                 BE6Y0780
      GAM2=4.0/PI                                                       BE6Y0790
C                                                                       BE6Y0800
C     EQUATIONS 15,17,18. GAMMA,YNU,BY(1),BY(2)                         BE6Y0810
C                                                                       BE6Y0820
   17 BY(2)=0.0                                                         BE6Y0830
      BY(1)=0.0                                                         BE6Y0840
      GAM 3=0.0                                                         BE6Y0850
      E1=-(1.0/PI)*CONST**(1.0+2.0*FNU)*GARG                            BE6Y0860
      BY(2)=E1*BJ(KL+1)+BY(2)                                           BE6Y0870
      E1=GAM1-GAM2/2.0                                                  BE6Y0880
      BY(2)=E1*BJ(KL+2)+BY(2)                                           BE6Y0890
      YNU=GAM1*BJ(KL+1)                                                 BE6Y0900
      TXNU=3.0*FNU/X                                                    BE6Y0910
      AB=ABSF(BJ(KL+1))-.000005                                         BE6Y0920
       MP1=M+1                                                          BE6Y0930
      KSTOP=1                                                           BE6Y0940
       I2=KL+1                                                          BE6Y0950
      DO 21 I=2,MP1                                                     BE6Y0960
      I2=I2+2                                                           BE6Y0970
      KSTOP=KSTOP+2                                                     BE6Y0980
      FI=I                                                              BE6Y0990
      FIM=I-1                                                           BE6Y1000
      FI2=2*I                                                           BE6Y1010
      DENOM=FI*(FI-FNU)*(FNU+FI2-2.0)                                   BE6Y1020
      GAM3=(FNU+FI2)*(2.0*FNU+FIM)*(FNU+FIM)/DENOM                      BE6Y1030
      GAM3=-GAM3*GAM2                                                   BE6Y1040
      YNU=GAM2*BJ(I2)+YNU                                               BE6Y1050
      IF(AB)18,18,20                                                    BE6Y1060
C                                                                       BE6Y1070
C     WHEN J(NU)IS NEAR ZERO COMPUTE BY(2)FROM EQ.18,ELSE EQ17.         BE6Y1080
C                                                                       BE6Y1090
   18 E1=TXNU*GAM2                                                      BE6Y1100
      BY(2)=E1*BJ(I2)+BY(2)                                             BE6Y1110
      IF(KSTOP-K)19,38,38                                               BE6Y1120
   19 E1=(GAM2-GAM3)/2.0                                                BE6Y1130
      BY(2)=E1*BJ(I2+1)+BY(2)                                           BE6Y1140
   20 GAM1=GAM2                                                         BE6Y1150
   21 GAM2=GAM3                                                         BE6Y1160
C                                                                       BE6Y1170
 38   BY(1)=YNU                                                         BE6Y1180
      IF(AB)23,23,22                                                    BE6Y1190
   22 BY(2)=(YNU*BJ(KL+2)-2.0/(PI*X))/BJ(KL+1)                          BE6Y1200
C                                                                       BE6Y1210
   23 IF(N)31,24,25                                                     BE6Y1220
   24 BESSL=BY(1)                                                       BE6Y1230
      GO TO 29                                                          BE6Y1240
   25 IF(N-1)24,26,27                                                   BE6Y1250
   26 BESSL=BY(2)                                                       BE6Y1260
      GO TO 29                                                          BE6Y1270
   27 DO 28 I=1,N1                                                      BE6Y1280
      FI1=I                                                             BE6Y1290
 28   BY(I+2)=CONST*(FI1+FNU)*BY(I+1)-BY(I)                             BE6Y1300
       BESSL=BY(NN+1)                                                   BE6Y1310
C                                                                       BE6Y1320
   29  BES6Y=BESSL                                                      BE6Y1330
   30 RETURN                                                            BE6Y1340
C                                                                       BE6Y1350
   31 IF(FNU-.50000) 43,39,43                                           BE6Y1360
   43 BY(2)=CONST*FNU*BY(1)-BY(2)                                       BE6Y1370
      BESSL=BY(2)                                                       BE6Y1380
      IF(NN-1)29,29,32                                                  BE6Y1390
C                                                                       BE6Y1400
   32 FRAC=FNU                                                          BE6Y1410
      DO 33 I=1,N1                                                      BE6Y1420
      FRAC=FRAC-1.0                                                     BE6Y1430
   33 BY(I+2)=CONST*FRAC*BY(I+1)-BY(I)                                  BE6Y1440
C                                                                       BE6Y1450
      BESSL=BY(NN+1)                                                    BE6Y1460
      GO TO 29                                                          BE6Y1470
   39 BY(2)=BJ(KL+1)                                                    BE6Y1480
      BESSL=BY(2)                                                       BE6Y1490
      IF (NN-1) 29,29,40                                                BE6Y1500
   40 ARG=-1.0                                                          BE6Y1510
      I2=KL+1                                                           BE6Y1520
      DO 41  I=1,N1                                                     BE6Y1530
      I2=I2+1                                                           BE6Y1540
      BY(I+2)=ARG*BJ(I2)                                                BE6Y1550
   41 ARG=-ARG                                                          BE6Y1560
      BESSL=BY(NN+1)                                                    BE6Y1570
      GO TO 29                                                          BE6Y1580
C       ERROR RETURN                                                    BE6Y1590
 36    BESSL=0.0                                                        BE6Y1600
      DO 37  I=1,IDIM                                                   BE6Y1610
   37 BY(I)=0.0                                                         BE6Y1620
       GO TO 29                                                         BE6Y1630
      END                                                               BE6Y1640
CBES6K NYU MATH UTILITY BESSEL K FUNCTION  3/15/64     F. RAGUSA        BE6K0010
      FUNCTION BES6K(X,FNUP,IVAR)                                       BE6K0020
C            IVARIS A DUMMY VARIABLE USED BY BESK WHEN CALLING BESI.    BE6K0030
C            BESK SETSIVAR=131070 GOING INTO BESI AND BESI SETS         BE6K0040
C          IVAR=XLOCF(BI). ,BI IS THE NAME OF THE ARRAY WHERE BESI HAS  BE6K0050
C              STORED THE I VALUES.  BESI ALSO SETS X=BK(1) VALUE       BE6K0060
C             AND FNUP=BK(2)                                            BE6K0070
C             WHICH IT COMPUTES IF X IS GREATER THAN 10.0.              BE6K0080
C                                                                       BE6K0090
       DIMENSION BK(150),BI(1)                                          BE6K0100
C                                                                       BE6K0110
       COSHF(Z)=.5*(EXPF(Z)+(1.0/EXPF(Z)))                              BE6K0120
      IDIM=150                                                          BE6K0130
       IVAR=131070                                                      BE6K0140
       SAVEX=X                                                          BE6K0150
       SAVENU=FNUP                                                      BE6K0160
       GETI= BES6I(X,FNUP,IVAR)                                         BE6K0170
C            UPON RETURN BK(1) IS IN X IF X WAS GR. TH. OR = TO 10.0    BE6K0180
C             AND BK(2) IS IN FMUP                                      BE6K0190
C             AND THE XLOCF OF THE ARRAY IN BESI IS IN IVAR.            BE6K0200
       BK(1)=X                                                          BE6K0210
       BK(2)=FNUP                                                       BE6K0220
       X=SAVEX                                                          BE6K0230
       FNUP=SAVENU                                                      BE6K0240
C            IF IVAR IS ZERO UPON RETURN FROM BESI THIS IS ERROR SIGN.  BE6K0250
       IF(IVAR) 2,1,2                                                   BE6K0260
C      IF IVAR IS ZERO FROM BESI THEN X OR N IS TOO BIG FOR DIMENSION.  BE6K0270
    1 DO 37 I=1,IDIM                                                    BE6K0280
   37 BK(I)=0.0                                                         BE6K0290
       BESSL=0.0                                                        BE6K0300
       GO TO 31                                                         BE6K0310
C                                                                       BE6K0320
    2  LOCI=IVAR                                                        BE6K0330
       LOCP=XLOCF(BI)                                                   BE6K0340
C             TO GET PROPER INDEX VALUE FOR SUBSCRIPTING BI OF BESI.    BE6K0350
       KL=LOCP-LOCI+32768                                               BE6K0360
C             FOLLOWING TO BREAK UP FNUP INTO FNU AND N.                BE6K0370
 3    R=FNUP                                                            BE6K0380
        N=0                                                             BE6K0390
       FNU=0.0                                                          BE6K0400
       IF(R) 4,11,7                                                     BE6K0410
 4     N=-1                                                             BE6K0420
 5     R=R+1.0                                                          BE6K0430
       FNU=R                                                            BE6K0440
       IF(R) 6,9,9                                                      BE6K0450
 6     N=N-1                                                            BE6K0460
       FNU=R                                                            BE6K0470
       GO TO 5                                                          BE6K0480
 7      FNU=R                                                           BE6K0490
        R=R-1.0                                                         BE6K0500
       IF(R) 9,8,8                                                      BE6K0510
 8     N=N+1                                                            BE6K0520
       GO TO 7                                                          BE6K0530
C                                                                       BE6K0540
 9     IF(FNU) 10,10,11                                                 BE6K0550
 10   N=XABSF(N)                                                        BE6K0560
        FNU=ABSF(FNU)                                                   BE6K0570
 11   NN=XABSF(N)                                                       BE6K0580
       N1=NN-1                                                          BE6K0590
       CONST=2.0/X                                                      BE6K0600
       IF(X-10.0) 12,25,25                                              BE6K0610
 12     X10=X+25.                                                       BE6K0620
       K10=X10                                                          BE6K0630
       N10=NN+10                                                        BE6K0640
       M=XMAX0F(K10,N10)                                                BE6K0650
       IF(X-1.0) 13,20,20                                               BE6K0660
 13    KP=172.69388/(3.6888795-LOGF(X))                                 BE6K0670
       M=XMIN0F(M,KP)                                                   BE6K0680
 14    M=M/2                                                            BE6K0690
       K=2*M+1                                                          BE6K0700
       CONS2=CONST  **(2.0*FNU)                                         BE6K0710
       PI=3.1415926535879                                               BE6K0720
       ARG=PI*FNU                                                       BE6K0730
       GARG=GAMMAF(FNU+1.0,0)**2                                        BE6K0740
       TERM=CONS2*GARG                                                  BE6K0750
 15   IF(FNU) 16,17,16                                                  BE6K0760
 16    DELTA1=-1.0/(2.0*FNU)*(ARG/SINF(ARG)-TERM)                       BE6K0770
       DELTA2=TERM*(FNU+2.0)/(1.0-FNU)                                  BE6K0780
       GO TO 18                                                         BE6K0790
C                                                                       BE6K0800
 17    DELTA1=-(57.72156649E-2+LOGF(X/2.0))                             BE6K0810
       DELTA2=2.0                                                       BE6K0820
C                                                                       BE6K0830
 18    BK(1)=DELTA1*BI(KL+1)                                            BE6K0840
       I2=KL+1                                                          BE6K0850
       ML1=M-1                                                          BE6K0860
        DO 19  I=1,ML1                                                  BE6K0870
       IP1=I+1                                                          BE6K0880
        I2=I2+2                                                         BE6K0890
      FI2=2*IP1                                                         BE6K0900
       FIM=I                                                            BE6K0910
       FI=IP1                                                           BE6K0920
         DENOM=FI*(FNU+FI2-2.0)*(FI-FNU)                                BE6K0930
       DELTA3=(FNU+FI2)*(2.0*FNU+FIM)*(FNU+FIM)/DENOM                   BE6K0940
      DELTA3=DELTA3*DELTA2                                              BE6K0950
       BK(1)=DELTA2*BI(I2)+BK(1)                                        BE6K0960
       DELTA2=DELTA3                                                    BE6K0970
 19   CONTINUE                                                          BE6K0980
C                                                                       BE6K0990
       I2=I2+2                                                          BE6K1000
       BK(1)=DELTA2*BI(I2)+BK(1)                                        BE6K1010
       BK(1)=BK(1)*EXPF(2.0*X)                                          BE6K1020
       GO TO 24                                                         BE6K1030
C                                                                       BE6K1040
 20    H=.2                                                             BE6K1050
       I=34                                                             BE6K1060
       Y=0.0                                                            BE6K1070
       SUM=1.0                                                          BE6K1080
        J=2                                                             BE6K1090
 21    FACT=4.0                                                         BE6K1100
        Y=Y+H                                                           BE6K1110
       FY=EXPF(X*(1.0-COSHF(Y)))*COSHF(FNU*Y)                           BE6K1120
        SUM=SUM+FACT*FY                                                 BE6K1130
         IF(J-I) 22,23,23                                               BE6K1140
 22    J=J+1                                                            BE6K1150
       FACT=2.0                                                         BE6K1160
       Y=Y+H                                                            BE6K1170
       FY=EXPF(X*(1.0-COSHF(Y)))*COSHF(FNU*Y)                           BE6K1180
       SUM=SUM+FACT*FY                                                  BE6K1190
       J=J+1                                                            BE6K1200
        GO TO 21                                                        BE6K1210
C                                                                       BE6K1220
 23   Y=Y+H                                                             BE6K1230
       FY=EXPF(X*(1.0-COSHF(Y)))*COSHF(FNU*Y)                           BE6K1240
       SUM=SUM+FY                                                       BE6K1250
       SUM=SUM*(H/3.0)                                                  BE6K1260
       BK(1)=SUM                                                        BE6K1270
C                                                                       BE6K1280
 24    BK(2)=((1.0/X)-BK(1)*BI(KL+2))/BI(KL+1)                          BE6K1290
C                                                                       BE6K1300
 25   IF(N) 32,26,27                                                    BE6K1310
 26   BESSL=BK(1)                                                       BE6K1320
       GO TO 31                                                         BE6K1330
C                                                                       BE6K1340
 27    IF(N-2) 28,29,29                                                 BE6K1350
 28   BESSL=BK(2)                                                       BE6K1360
       GO TO 31                                                         BE6K1370
C                                                                       BE6K1380
 29    DO 30  I=1,N1                                                    BE6K1390
       FLI=I                                                            BE6K1400
       BK(I+2)=CONST*(FLI+FNU)*BK(I+1)+BK(I)                            BE6K1410
       BESSL=BK(I+2)                                                    BE6K1420
 30   CONTINUE                                                          BE6K1430
C                                                                       BE6K1440
 31    BES6K=BESSL                                                      BE6K1450
       RETURN                                                           BE6K1460
C                                                                       BE6K1470
 32    BK(2)=-CONST*FNU*BK(1)+BK(2)                                     BE6K1480
       IF(NN-1)  34,33,35                                               BE6K1490
 33    BESSL=BK(2)                                                      BE6K1500
       GO TO 31                                                         BE6K1510
C                                                                       BE6K1520
 34    BESSL=BK(1)                                                      BE6K1530
       GO TO 31                                                         BE6K1540
C                                                                       BE6K1550
 35    FRAC=FNU                                                         BE6K1560
       DO 36  I=1,N1                                                    BE6K1570
       FRAC=FRAC-1.0                                                    BE6K1580
       BK(I+2)=-CONST*FRAC*BK(I+1)+BK(I)                                BE6K1590
 36    BESSL=BK(I+2)                                                    BE6K1600
C                                                                       BE6K1610
        GO TO 31                                                        BE6K1620
       END                                                              BE6K1630
C3 NYUBESS 10-14-64 3178         FO 0646                   FO SOURCE CDS        
CBESSI NYU MATH UTILITY BESSEL I SUBROUTINE  3/15/64   F. RAGUSA        BESS0001
       SUBROUTINE BESSI(X,FNU,N,BI)                                     BESS0002
      DIMENSION BI(1)                                                   BESS0003
      EQUIVALENCE(FM,MF)                                                BESS0004
C                                                                       BESS0005
      FM=BI(1)                                                          BESS0006
      IY=1                                                              BESS0007
      NN=XABSF(N)                                                       BESS0008
      CONST=2.0/X                                                       BESS0009
C     WHEN BI(1) CONTAINS THE INTEGER 131070 ENTRY WAS FROM BESY.       BESS0010
C                                                                       BESS0011
      IF(MF-131070)2,1,2                                                BESS0012
    1 IY=2                                                              BESS0013
C                                                                       BESS0014
 2    IF(X-50.)  42,17,17                                               BESS0015
 42      X10=X+25.                                                      BESS0016
      K10=X10                                                           BESS0017
      N10=NN+10                                                         BESS0018
      M=XMAX0F(K10,N10)                                                 BESS0019
C                                                                       BESS0020
       IF(X-1.0) 3,3,41                                                 BESS0021
C                                                                       BESS0022
    3 KP=172. 69388/(3.6888795-LOGF(X))                                 BESS0023
      M=XMIN0F(M,KP)                                                    BESS0024
       GO TO 4                                                          BESS0025
C                                                                       BESS0026
 41    KP=39.*X**.3333333                                               BESS0027
       M=XMIN0F(M,KP)                                                   BESS0028
    4 M=M/2                                                             BESS0029
      K=2*M+1                                                           BESS0030
      K2=K+1                                                            BESS0031
      K3=K+2                                                            BESS0032
      BI(K2)=1.0E-37                                                    BESS0033
      BI(K3)=0.0                                                        BESS0034
C                                                                       BESS0035
      DO 5 L=1,K                                                        BESS0036
      I=K+1-L                                                           BESS0037
      FLI=I                                                             BESS0038
    5 BI(I)=CONST*(FLI+FNU)*BI(I+1)+BI(I+2)                             BESS0039
C     FOR ALPHA. EQ.27, PAGE 8 IF X LESS THAN 10.0                      BESS0040
C                                                                       BESS0041
       IF(X-10.0) 6,17,17                                               BESS0042
C                                                                       BESS0043
    6 PSI=2.0*(FNU+1.0)                                                 BESS0044
      ALF=PSI*BI(2)+BI(1)                                               BESS0045
        K1=K-1                                                          BESS0046
C                                                                       BESS0047
       DO 7 I=2,K1                                                      BESS0048
      J=I+1                                                             BESS0049
      FLI=I                                                             BESS0050
      FIM=I-1                                                           BESS0051
      TEMP=((FNU+FLI)*(2.0*FNU+FIM))/(FLI*(FNU+FIM))*PSI                BESS0052
      PSI=TEMP                                                          BESS0053
    7 ALF=PSI*BI(J)+ALF                                                 BESS0054
C                                                                       BESS0055
      ALF=CONST**FNU*GAMMAF(FNU+1.0,0)*ALF                              BESS0056
C                                                                       BESS0057
      I1=1                                                              BESS0058
C                 EQUATION 24, PAGE 8.                                  BESS0059
    8 DO 9 I=I1,K                                                       BESS0060
    9 BI(I)=BI(I)/ALF                                                   BESS0061
C                                                                       BESS0062
      IF(N)10,14,14                                                     BESS0063
   10 IF(IY-2)11,15,11                                                  BESS0064
C                                                                       BESS0065
   11 BI(2)=CONST*FNU*BI(1)+BI(2)                                       BESS0066
      IF(NN-1)14,14,12                                                  BESS0067
C                                                                       BESS0068
   12 FRAC=FNU                                                          BESS0069
      N1=NN-1                                                           BESS0070
      DO 13 I=1,N1                                                      BESS0071
      FRAC=FRAC-1.0                                                     BESS0072
   13 BI(I+2)=CONST*FRAC*BI(I+1)+BI(I)                                  BESS0073
C                                                                       BESS0074
   14 GO TO (16,15),IY                                                  BESS0075
   15 FM=FK1                                                            BESS0076
      N=MF                                                              BESS0077
       X=FK2                                                            BESS0078
   16 RETURN                                                            BESS0079
C                                                                       BESS0080
 17   KOUNT=1                                                           BESS0081
       GNU=FNU                                                          BESS0082
      C0=.25                                                            BESS0083
       C1 =.15625                                                       BESS0084
       C2 =-.375                                                        BESS0085
       C3 =.1171875                                                     BESS0086
       C4 =-1.15625                                                     BESS0087
       C5 =1.875                                                        BESS0088
       C6 =.09521484375                                                 BESS0089
       C7 =-2.38671875                                                  BESS0090
       C8 =14.2265625                                                   BESS0091
       C9 =-19.68750                                                    BESS0092
       C10=8.093261719E-2                                               BESS0093
       C11=-4.100585937                                                 BESS0094
       C12=58.224609375                                                 BESS0095
       C13=-277.87500                                                   BESS0096
       C14=354.3750                                                     BESS0097
       C15=.0416666666                                                  BESS0098
       C16=-.25                                                         BESS0099
       C17=.125E-1                                                      BESS0100
       C18=-.350                                                        BESS0101
       C19=.000558035718                                                BESS0102
       C20=- .4241071428                                                BESS0103
       C21=3.60267857                                                   BESS0104
       C22=-5.625                                                       BESS0105
       C23=.0030381944                                                  BESS0106
       C24=-.486111                                                     BESS0107
       C25=10.28645833                                                  BESS0108
       C26=-58.0                                                        BESS0109
       C27=78.75                                                        BESS0110
C                                                                       BESS0111
   18 AL1=GNU**2-.25                                                    BESS0112
       A2 =C0*AL1                                                       BESS0113
       A4 =C1*AL1                                                       BESS0114
       A4=(A4+C2)*AL1                                                   BESS0115
       A6=C3*AL1                                                        BESS0116
       A6=(A6+C4)*AL1                                                   BESS0117
       A6=(A6+C5)*AL1                                                   BESS0118
       A8=C6*AL1                                                        BESS0119
       A8=(A8+C7 )*AL1                                                  BESS0120
       A8=(A8+C8 )*AL1                                                  BESS0121
       A8=(A8+C9 )*AL1                                                  BESS0122
       A10=C10*AL1                                                      BESS0123
       A10=(A10+C11)*AL1                                                BESS0124
       A10=(A10+C12)*AL1                                                BESS0125
       A10=(A10+C13)*AL1                                                BESS0126
       A10=(A10+C14)*AL1                                                BESS0127
C                                                                       BESS0128
   19 PI=3.1415926535879                                                BESS0129
       TS=1.0/X                                                         BESS0130
       T2=TS**2                                                         BESS0131
C                                                                       BESS0132
      B=-A10*T2+A8                                                      BESS0133
      B=B*T2-A6                                                         BESS0134
      B=B*T2+A4                                                         BESS0135
      B=B*T2-A2                                                         BESS0136
      DOVT=B*T2+1.0                                                     BESS0137
C                                                                       BESS0138
       A2=.5*AL1                                                        BESS0139
       A4=C15*AL1                                                       BESS0140
       A4=(A4+C16)*AL1                                                  BESS0141
       A6=C17*AL1                                                       BESS0142
       A6=(A6+C18)*AL1                                                  BESS0143
       A6=(A6+.75)*AL1                                                  BESS0144
       A8=C19*AL1                                                       BESS0145
       A8=(A8+C20)*AL1                                                  BESS0146
       A8=(A8+C21)*AL1                                                  BESS0147
       A8=(A8+C22)*AL1                                                  BESS0148
       A10=C23*AL1                                                      BESS0149
       A10=(A10+C24)*AL1                                                BESS0150
       A10=(A10+C25)*AL1                                                BESS0151
       A10=(A10+C26)*AL1                                                BESS0152
       A10=(A10+C27)*AL1                                                BESS0153
C                                                                       BESS0154
      B=-A10*T2+A8                                                      BESS0155
      B=B*T2-A6                                                         BESS0156
      B=B*T2+A4                                                         BESS0157
      B=B*T2-A2                                                         BESS0158
      BNU=B*T2                                                          BESS0159
C                                                                       BESS0160
   20 F1=DOVT*SQRTF(TS/(PI*2.))*EXPF(BNU*X)*(1.-EXPF(-2.*X*(1.+BNU)))   BESS0161
      FK1=DOVT*SQRTF((PI*TS)/2.)*EXPF(-X*BNU)                           BESS0162
C                                                                       BESS0163
       IF(KOUNT-1) 21,21,22                                             BESS0164
 21    FSAVE=F1                                                         BESS0165
       FKSVE=FK1                                                        BESS0166
       GNU=FNU+1.0                                                      BESS0167
       KOUNT=2                                                          BESS0168
       GO TO 18                                                         BESS0169
 22    F2=F1                                                            BESS0170
       FK2=FK1                                                          BESS0171
       F1=FSAVE                                                         BESS0172
       FK1=FKSVE                                                        BESS0173
       IF(X-50.) 23,27,27                                               BESS0174
 23    IF(ABSF(F1)-ABSF(F2)) 24,24,25                                   BESS0175
 24    ALF=BI(2)/F2                                                     BESS0176
       GO TO 26                                                         BESS0177
 25   ALF=BI(1)/F1                                                      BESS0178
 26   BI(1)=F1                                                          BESS0179
       BI(2)=F2                                                         BESS0180
      I1=3                                                              BESS0181
      GO TO 8                                                           BESS0182
 27    BI(1)=F1                                                         BESS0183
       BI(2)=F2                                                         BESS0184
        IF(N) 10,14,28                                                  BESS0185
 28    IF(N-1) 14,14,29                                                 BESS0186
 29    N1=NN+1                                                          BESS0187
       FLI=0.0                                                          BESS0188
       DO 30  I=3,N1                                                    BESS0189
       FLI=FLI+1.0                                                      BESS0190
 30   BI(I)=-(CONST*(FNU+FLI)*BI(I-1)-BI(I-2))                          BESS0191
       GO TO 14                                                         BESS0192
      END                                                               BESS0193
CBESSJ NYU MATH UTILITY BESSEL J SUBROUTINE  3/15/64   F. RAGUSA        BESS0194
       SUBROUTINE BESSJ(X,FNU,N,F)                                      BESS0195
      DIMENSION F(1)                                                    BESS0196
      EQUIVALENCE(FM,MF)                                                BESS0197
C                                                                       BESS0198
       NN=XABSF(N)                                                      BESS0199
C     WHEN BESJ HAS BEEN CALLED BY BESY F(1) WILL CONTAIN THE INTEGER 13BESS0200
      FM=F(1)                                                           BESS0201
      IY=1                                                              BESS0202
       IF(MF-131070) 2,1,2                                              BESS0203
 1     IY=2                                                             BESS0204
 2    CONST=2.0/X                                                       BESS0205
C                                                                       BESS0206
      IF(X-50.) 6,8,8                                                   BESS0207
 6    X10=X+25.                                                         BESS0208
      K10=X10                                                           BESS0209
       N10=NN+10                                                        BESS0210
 40   M=XMAX0F(K10,N10)                                                 BESS0211
C                                                                       BESS0212
       IF(X-1.0) 3,3,41                                                 BESS0213
 3    KP=172.69388/(3.6888795-LOGF(X))                                  BESS0214
      M=XMIN0F(M,KP)                                                    BESS0215
       GO TO 4                                                          BESS0216
 41    KP=39.*X**.3333333                                               BESS0217
       M=XMIN0F(M,KP)                                                   BESS0218
 4     M=M/2                                                            BESS0219
 43   K=2*M+1                                                           BESS0220
      K2=K+1                                                            BESS0221
      K3=K+2                                                            BESS0222
      F(K2)=1.0E-37                                                     BESS0223
      F(K3)=0.0                                                         BESS0224
C                                                                       BESS0225
      DO5 L=1,K                                                         BESS0226
      I=K+1-L                                                           BESS0227
      FLI=I                                                             BESS0228
 5    F(I)=CONST*(FLI+FNU)*F(I+1)-F(I+2)                                BESS0229
C                                                                       BESS0230
C     FIND ALPHA EITHER FROM EQUA. 12,PAGE 4 WHEN X IS LESS THAN 8.0    BESS0231
C     OR FROM BESSEL FUNCT. FOR LARGE ARGUMENTS WHEN X IS =OR GREATER.  BESS0232
C                                                                       BESS0233
       IF(X-10.) 7,8,8                                                  BESS0234
    7 PHI=FNU+2.0                                                       BESS0235
      ALF=PHI*F(3)+F(1)                                                 BESS0236
      MO=3                                                              BESS0237
C                                                                       BESS0238
      DO15 I=2,M                                                        BESS0239
      MO=MO+2                                                           BESS0240
      FM2=2*I                                                           BESS0241
      FM1=I-1                                                           BESS0242
      FI=I                                                              BESS0243
      TEMP=((FNU+FM2)*(FNU+FM1))/(FI*(FNU+FM2-2.0))*PHI                 BESS0244
      PHI=TEMP                                                          BESS0245
 15   ALF=PHI*F(MO)+ALF                                                 BESS0246
C                                                                       BESS0247
      ALF=CONST**FNU*GAMMAF(FNU+1.0,0)*ALF                              BESS0248
C                                                                       BESS0249
       I1=1                                                             BESS0250
C                                                                       BESS0251
C     FIND J(N) EQUATION 7,PAGE 3,WHEN X LESS THAN 10.0                 BESS0252
C     OR J(2),J(3),...,J(N)=F(2)/ALPHA,...,F(N)/ALPHA WHERE             BESS0253
C     ALPHA=F(1)/J(1) AND J(1)=A*COS(PHI) FROM PATH 8.                  BESS0254
C                                                                       BESS0255
 16   DO17 I=I1,K                                                       BESS0256
 17   F(I)=F(I)/ALF                                                     BESS0257
C             TEST FOR NEGATIVE N  AND RECOMPUTE FS BY RECURSION.       BESS0258
       IF(N) 18,22,22                                                   BESS0259
 18    IF(IY-2) 19,22,19                                                BESS0260
 19    F(2)=CONST*FNU*F(1)-F(2)                                         BESS0261
       IF(NN-1) 22,22,20                                                BESS0262
 20    FRAC=FNU                                                         BESS0263
       N1=NN+1                                                          BESS0264
       DO 21  L=3,N1                                                    BESS0265
       FRAC=FRAC-1.0                                                    BESS0266
 21    F(L)=CONST*FRAC*F(L-1)-F(L-2)                                    BESS0267
C                                                                       BESS0268
C     IF ENTRY WAS FROM BESY RETURN A VALUE FOR Y(1) IN                 BESS0269
C     PLACE OF N.IY WILL BE EQUAL TO 2 IN THIS CASE.                    BESS0270
C                                                                       BESS0271
 22   GO TO (24,23),IY                                                  BESS0272
 23   FM=Y1                                                             BESS0273
        N=MF                                                            BESS0274
      X=Y2                                                              BESS0275
 24   RETURN                                                            BESS0276
C                                                                       BESS0277
C PATH 8. WHEN X IS GREATER THAN OR =TO 10.0                            BESS0278
C     COMPUTE J(1) FROM M.GOLDSTEIN PAPER BESSEL                        BESS0279
C     FUNCTIONS FOR LARGE ARGUMENTS.                                    BESS0280
C                                                                       BESS0281
 8     KOUNT=1                                                          BESS0282
       GNU=FNU                                                          BESS0283
       C0 =.25                                                          BESS0284
       C1 =.15625                                                       BESS0285
       C2 =-.375                                                        BESS0286
       C3 =.1171875                                                     BESS0287
       C4 =-1.15625                                                     BESS0288
       C5 =1.875                                                        BESS0289
       C6 =.09521484375                                                 BESS0290
       C7 =-2.38671875                                                  BESS0291
       C8 =14.2265625                                                   BESS0292
       C9 =-19.68750                                                    BESS0293
       C10=8.093261719E-2                                               BESS0294
       C11=-4.100585937                                                 BESS0295
       C12=58.224609375                                                 BESS0296
       C13=-277.87500                                                   BESS0297
       C14=354.3750                                                     BESS0298
       C15=.0416666666                                                  BESS0299
       C16=-.25                                                         BESS0300
       C17=.125E-1                                                      BESS0301
       C18=-.350                                                        BESS0302
       C19=.000558035718                                                BESS0303
       C20=- .4241071428                                                BESS0304
       C21=3.60267857                                                   BESS0305
       C22=-5.625                                                       BESS0306
       C23=.0030381944                                                  BESS0307
       C24=-.486111                                                     BESS0308
       C25=10.28645833                                                  BESS0309
       C26=-58.0                                                        BESS0310
       C27=78.75                                                        BESS0311
 9     AL1=GNU**2-.25                                                   BESS0312
       A2 =C0*AL1                                                       BESS0313
       A4 =C1*AL1                                                       BESS0314
       A4=(A4+C2)*AL1                                                   BESS0315
       A6=C3*AL1                                                        BESS0316
       A6=(A6+C4)*AL1                                                   BESS0317
       A6=(A6+C5)*AL1                                                   BESS0318
       A8=C6*AL1                                                        BESS0319
       A8=(A8+C7 )*AL1                                                  BESS0320
       A8=(A8+C8 )*AL1                                                  BESS0321
       A8=(A8+C9 )*AL1                                                  BESS0322
       A10=C10*AL1                                                      BESS0323
       A10=(A10+C11)*AL1                                                BESS0324
       A10=(A10+C12)*AL1                                                BESS0325
       A10=(A10+C13)*AL1                                                BESS0326
       A10=(A10+C14)*AL1                                                BESS0327
C                                                                       BESS0328
       PI=3.141592654                                                   BESS0329
       TS=1.0/X                                                         BESS0330
       T2=TS**2                                                         BESS0331
C                                                                       BESS0332
       B=A10*T2+A8                                                      BESS0333
       B=B*T2+A6                                                        BESS0334
       B=B*T2+A4                                                        BESS0335
       B=B*T2+A2                                                        BESS0336
       BNU=B*T2+1.0                                                     BESS0337
C                                                                       BESS0338
       ANU=BNU/SQRTF(.5*PI*X)                                           BESS0339
C                                                                       BESS0340
C       PAGE 20, EQUATION 12 TO GET PHI ZERO                            BESS0341
C                                                                       BESS0342
       A2=.5*AL1                                                        BESS0343
       A4=C15*AL1                                                       BESS0344
       A4=(A4+C16)*AL1                                                  BESS0345
       A6=C17*AL1                                                       BESS0346
       A6=(A6+C18)*AL1                                                  BESS0347
       A6=(A6+.75)*AL1                                                  BESS0348
       A8=C19*AL1                                                       BESS0349
       A8=(A8+C20)*AL1                                                  BESS0350
       A8=(A8+C21)*AL1                                                  BESS0351
       A8=(A8+C22)*AL1                                                  BESS0352
       A10=C23*AL1                                                      BESS0353
       A10=(A10+C24)*AL1                                                BESS0354
       A10=(A10+C25)*AL1                                                BESS0355
       A10=(A10+C26)*AL1                                                BESS0356
       A10=(A10+C27)*AL1                                                BESS0357
C                                                                       BESS0358
       B=A10*T2+A8                                                      BESS0359
       B=B*T2+A6                                                        BESS0360
       B=B*T2+A4                                                        BESS0361
       B=B*T2+A2                                                        BESS0362
       TPHI=B*T2+1.0                                                    BESS0363
       PHI=TPHI*X -(GNU+.5)*(PI/2.0)                                    BESS0364
       COP=COSF(PHI)                                                    BESS0365
       SIP=SINF(PHI)                                                    BESS0366
C                                                                       BESS0367
       F1=ANU*COP                                                       BESS0368
       Y1=ANU*SIP                                                       BESS0369
C                                                                       BESS0370
       IF(KOUNT-1) 10,10,11                                             BESS0371
C                                                                       BESS0372
 10    FSAVE=F1                                                         BESS0373
       YSAVE=Y1                                                         BESS0374
       GNU=FNU+1.0                                                      BESS0375
       KOUNT=2                                                          BESS0376
       GO TO 9                                                          BESS0377
C                                                                       BESS0378
 11    F2=F1                                                            BESS0379
       Y2=Y1                                                            BESS0380
       F1=FSAVE                                                         BESS0381
       Y1=YSAVE                                                         BESS0382
C                                                                       BESS0383
       IF(X-50.) 110,111,111                                            BESS0384
 110   IF(ABSF(F1)-ABSF(F2)) 12,12,13                                   BESS0385
 111   F(1)=F1                                                          BESS0386
       F(2)=F2                                                          BESS0387
       IF(N) 18,22,112                                                  BESS0388
 112   IF(N-1) 22,22,113                                                BESS0389
 113   N1=NN+1                                                          BESS0390
      FLI=0.0                                                           BESS0391
       DO 114  I=3,N1                                                   BESS0392
       FLI=FLI+1.0                                                      BESS0393
 114     F(I)=CONST*(FNU+FLI)*F(I-1)-F(I-2)                             BESS0394
       GO TO 22                                                         BESS0395
C                                                                       BESS0396
 12    ALF=F(2)/F2                                                      BESS0397
       GO TO 14                                                         BESS0398
C                                                                       BESS0399
 13    ALF=F(1)/F1                                                      BESS0400
 14    F(1)=F1                                                          BESS0401
       F(2)=F2                                                          BESS0402
       I1=3                                                             BESS0403
       GO TO 16                                                         BESS0404
      END                                                               BESS0405
CBESSK NYU MATH UTILITY BESSEL K SUBROUTINE  3/15/64   F. RAGUSA        BESS0406
      SUBROUTINE BESSK(X,FNU,N,BI,BK)                                   BESS0407
        DIMENSION BI(1),BK(1)                                           BESS0408
        EQUIVALENCE(FM,MF)                                              BESS0409
C                                                                       BESS0410
       COSHF(Z)=.5*(EXPF(Z)+(1.0/EXPF(Z)))                              BESS0411
       XSAVE=X                                                          BESS0412
        M=N                                                             BESS0413
       MF=131070                                                        BESS0414
       BI(1) =FM                                                        BESS0415
   13 CALL BESSI(X,FNU,N,BI)                                            BESS0416
        MF=N                                                            BESS0417
       BK(1)=FM                                                         BESS0418
       BK(2)=X                                                          BESS0419
       X=XSAVE                                                          BESS0420
       CONST=2.0/X                                                      BESS0421
       N=M                                                              BESS0422
       NN=XABSF(N)                                                      BESS0423
       N1=NN-1                                                          BESS0424
C                                                                       BESS0425
        IF(X-10.0) 14,43,43                                             BESS0426
 14   X10=X+25.                                                         BESS0427
       K10=X10                                                          BESS0428
       N10=NN+10                                                        BESS0429
       M=XMAX0F(K10,N10)                                                BESS0430
C                                                                       BESS0431
       IF(X-1.0) 1,30,30                                                BESS0432
 1     KP=172.69388/(3.6888795-LOGF(X))                                 BESS0433
       M=XMIN0F(M,KP)                                                   BESS0434
 2     M=M/2                                                            BESS0435
       K=2*M+1                                                          BESS0436
       CONS2=CONST**(2.0*FNU)                                           BESS0437
       PI=3.1415926535879                                               BESS0438
       ARG=PI*FNU                                                       BESS0439
       GARG=GAMMAF(FNU+1.0,0)**2                                        BESS0440
       TERM=CONS2*GARG                                                  BESS0441
C                                                                       BESS0442
 300   IF(FNU) 310,320,310                                              BESS0443
 310  DELTA1=-1.0/(2.0*FNU)*(ARG/SINF(ARG)-TERM)                        BESS0444
       DELTA2=TERM*(FNU+2.0)/(1.0-FNU)                                  BESS0445
       GO TO 330                                                        BESS0446
C                                                                       BESS0447
 320   DELTA1=-(57.72156649E-2+LOGF(X/2.0))                             BESS0448
       DELTA2=2.0                                                       BESS0449
C                                                                       BESS0450
 330   BK(1)=DELTA1*BI(1)                                               BESS0451
       I2=1                                                             BESS0452
       ML1=M-1                                                          BESS0453
C                                                                       BESS0454
       DO 340  I=1,ML1                                                  BESS0455
       IP1=I+1                                                          BESS0456
       I2=I2+2                                                          BESS0457
       FI2=2*IP1                                                        BESS0458
       FIM=I                                                            BESS0459
       FI=IP1                                                           BESS0460
       DENOM=FI*(FNU+FI2-2.0)*(FI-FNU)                                  BESS0461
       DELTA3=(FNU+FI2)*(2.0*FNU+FIM)*(FNU+FIM)/DENOM                   BESS0462
       DELTA3=DELTA3*DELTA2                                             BESS0463
       BK(1)=DELTA2*BI(I2)+BK(1)                                        BESS0464
 340   DELTA2=DELTA3                                                    BESS0465
C                                                                       BESS0466
       I2=I2+2                                                          BESS0467
       BK(1)=DELTA2*BI(I2)+BK(1)                                        BESS0468
       BK(1)=BK(1)*EXPF(2.0*X)                                          BESS0469
       GO TO 15                                                         BESS0470
C                                                                       BESS0471
 30   H=.2                                                              BESS0472
       I=34                                                             BESS0473
       Y=0.0                                                            BESS0474
       SUM=1.0                                                          BESS0475
       J=2                                                              BESS0476
  31   FACT=4.0                                                         BESS0477
       Y=Y+H                                                            BESS0478
      FY=EXPF(X*(1.0-COSHF(Y)))*COSHF(FNU*Y)                            BESS0479
       SUM=SUM+FACT*FY                                                  BESS0480
       IF(J-I) 40,41,41                                                 BESS0481
 40    J=J+1                                                            BESS0482
         FACT=2.0                                                       BESS0483
       Y=Y+H                                                            BESS0484
      FY=EXPF(X*(1.0-COSHF(Y)))*COSHF(FNU*Y)                            BESS0485
       SUM=SUM+FACT*FY                                                  BESS0486
       J=J+1                                                            BESS0487
       GO TO 31                                                         BESS0488
C                                                                       BESS0489
 41   Y=Y+H                                                             BESS0490
      FY=EXPF(X*(1.0-COSHF(Y)))*COSHF(FNU*Y)                            BESS0491
       SUM=SUM+FY                                                       BESS0492
       SUM=SUM*(H/3.0)                                                  BESS0493
      BK(1)=SUM                                                         BESS0494
 15    BK(2)=((1.0/X)-BK(1)*BI(2))/BI(1)                                BESS0495
C                                                                       BESS0496
 43    IF (N) 50,39,36                                                  BESS0497
 36    IF(N-1) 39,39,37                                                 BESS0498
 37    DO 38 I=1,N1                                                     BESS0499
       FLI=I                                                            BESS0500
 38    BK(I+2)= CONST*(FLI+FNU) *BK(I+1)+BK(I)                          BESS0501
 39     RETURN                                                          BESS0502
C                                                                       BESS0503
 50   BK(2)=-CONST*FNU*BK(1)+BK(2)                                      BESS0504
       BI(2)=CONST*FNU*BI(1)+BI(2)                                      BESS0505
        IF(NN-1) 39,39,51                                               BESS0506
 51    FRAC=FNU                                                         BESS0507
C                                                                       BESS0508
        DO 52  I=1,N1                                                   BESS0509
       FRAC=FRAC-1.0                                                    BESS0510
       BI(I+2)=CONST*FRAC*BI(I+1)+BI(I)                                 BESS0511
 52   BK(I+2)= -CONST*FRAC*BK(I+1)+BK(I)                                BESS0512
       GO TO 39                                                         BESS0513
       END                                                              BESS0514
CBESSY NYU MATH UTILITY SUBROUTINE FOR BESSEL Y        3/15/64 F. RAGUSABESS0515
      SUBROUTINE BESSY(X,FNU,N,BJ,BY)                                   BESS0516
        DIMENSION BJ(1),BY(1)                                           BESS0517
       EQUIVALENCE(FM,MF)                                               BESS0518
C                                                                       BESS0519
       XSAVE=X                                                          BESS0520
      M1=N                                                              BESS0521
       MF=131070                                                        BESS0522
       BJ(1)=FM                                                         BESS0523
       CALL BESSJ(X,FNU,N,BJ)                                           BESS0524
       MF=N                                                             BESS0525
       BY(1)=FM                                                         BESS0526
       YNU=BY(1)                                                        BESS0527
       N=M1                                                             BESS0528
       BY(2)=X                                                          BESS0529
       X=XSAVE                                                          BESS0530
C                                                                       BESS0531
       NN=XABSF(N)                                                      BESS0532
       N1=NN-1                                                          BESS0533
       CONST=2.0/X                                                      BESS0534
       PI=3.141592654                                                   BESS0535
C                                                                       BESS0536
       IF(X-10.0) 30,19,19                                              BESS0537
 30   X10=X+25.                                                         BESS0538
       K10=X10                                                          BESS0539
       N10=NN+10                                                        BESS0540
       M=XMAX0F(K10,N10)                                                BESS0541
C                                                                       BESS0542
       IF(X-1.0) 1,1,3                                                  BESS0543
 1    KP=172.69388/(3.6888795-LOGF(X))                                  BESS0544
      M=XMIN0F(M,KP)                                                    BESS0545
        GO TO 2                                                         BESS0546
 3     KP=39.*X**.3333333                                               BESS0547
       M=XMIN0F(M,KP)                                                   BESS0548
 2     M=M/2                                                            BESS0549
       K=2*M+1                                                          BESS0550
       ARG=FNU*PI                                                       BESS0551
       GARG=GAMMAF(1.0+FNU,0)**2                                        BESS0552
C                                                                       BESS0553
C      COMPUTE GAMMA ZERO EQU. 15,PG. 5 , IF NU=0 USE EQU. 16.          BESS0554
C                                                                       BESS0555
 14    IF(FNU) 15,16,15                                                 BESS0556
 15    TERM =(1.0/PI)* CONST **(2.0*FNU)                                BESS0557
       GAM1=COSF(ARG)/SINF(ARG)-TERM*(GARG/FNU)                         BESS0558
C      COMPUTE     GAMMA  ONE FOR NU NOT EQUAL ZERO.                    BESS0559
       GAM2=2.0 * TERM * GARG * (FNU+2.0) / (1.0-FNU)                   BESS0560
       GO TO 10                                                         BESS0561
C                                                                       BESS0562
C      COMPUTE GAMMA ZERO AND ONE FOR NU EQUAL ZERO.                    BESS0563
 16    TLOG=LOGF(X/2.0)                                                 BESS0564
       A=57.72156649E-2                                                 BESS0565
       PIH=2.0/PI                                                       BESS0566
       GAM1=PIH*(A+TLOG)                                                BESS0567
       GAM2=4.0/PI                                                      BESS0568
C                                                                       BESS0569
C      COMPUTE GAMMA, YNU, AND BY(1), AND BY(2)                         BESS0570
C      EQUATIONS 15,17, AND 18.                                         BESS0571
C                                                                       BESS0572
 10    BY(2)  =0.0                                                      BESS0573
       BY(1)=0.0                                                        BESS0574
       GAM3=0.0                                                         BESS0575
       E1=-(1.0/PI)*CONST  **(1.0+2.0*FNU) * GARG                       BESS0576
       BY(2)=E1*BJ(1)+BY(2)                                             BESS0577
       E1=GAM1-GAM2/2.0                                                 BESS0578
       BY(2)=E1*BJ(2)+BY(2)                                             BESS0579
       YNU=GAM1*BJ(1)                                                   BESS0580
       TXNU=3.0*FNU/X                                                   BESS0581
       AB=ABSF(BJ(1))-.000005                                           BESS0582
       I2=1                                                             BESS0583
        MP1=M+1                                                         BESS0584
C                                                                       BESS0585
       DO 11 I=2,MP1                                                    BESS0586
       I2=I2+2                                                          BESS0587
       FI=I                                                             BESS0588
       FIM=I-1                                                          BESS0589
       FI2=2*I                                                          BESS0590
       DENOM=  FI* (FI-FNU)*(FNU+FI2-2.0)                               BESS0591
       GAM3=(FNU+FI2)*(2.0*FNU+FIM)*(FNU+FIM)/DENOM                     BESS0592
       GAM3=-GAM3*GAM2                                                  BESS0593
       YNU=GAM2*BJ(I2)+YNU                                              BESS0594
       IF(AB) 18,18,23                                                  BESS0595
C      WHEN J(NU) IS NEAR ZERO COMPUTE BY(2) FROM EQ. 18,ELSE EQ. 17.   BESS0596
C                                                                       BESS0597
  18   E1=TXNU*GAM2                                                     BESS0598
       BY(2)=E1*BJ(I2)+BY(2)                                            BESS0599
       IF(I2-K) 25,110,110                                              BESS0600
 25    E1=(GAM2-GAM3)/2.0                                               BESS0601
       BY(2)=E1*BJ(I2+1)+BY(2)                                          BESS0602
 23    GAM1=GAM2                                                        BESS0603
 11    GAM2=GAM3                                                        BESS0604
C                                                                       BESS0605
 110   BY(1)=YNU                                                        BESS0606
       IF(AB) 19,19,17                                                  BESS0607
 17    BY(2)=(YNU*BJ(2)-2.0/(PI*X))/BJ(1)                               BESS0608
C                                                                       BESS0609
C      IF N=0 OR 1 GO OUT  ALL BY S COMPUTED.                           BESS0610
 19    IF(N) 50,49,20                                                   BESS0611
 20    IF(N-1) 49,49,21                                                 BESS0612
C                                                                       BESS0613
C       COMPUTE Y(N+1) BY RECURRENCE                                    BESS0614
C                                                                       BESS0615
 21    DO 22  I=1,N1                                                    BESS0616
       FI1=I                                                            BESS0617
 22    BY(I+2)=CONST*(FI1+FNU)*BY(I+1)-BY(I)                            BESS0618
C                                                                       BESS0619
 49    RETURN                                                           BESS0620
  50  IF(FNU-.500000) 54,53,54                                          BESS0621
  53  BY(2)=BJ(1)                                                       BESS0622
      IF(NN-1) 49,61,60                                                 BESS0623
  60  ARG=-1.0                                                          BESS0624
      BY(3)=ARG*BJ(2)                                                   BESS0625
      BJ(2)=CONST*FNU*BJ(1)-BJ(2)                                       BESS0626
      ARG=-ARG                                                          BESS0627
      IF (NN-2)  49,51,56                                               BESS0628
  56  DO 55  I=2,N1                                                     BESS0629
      BY(I+2)=ARG*BJ(I+1)                                               BESS0630
  55  ARG=-ARG                                                          BESS0631
       GO TO 51                                                         BESS0632
  54  BY(2)=CONST*FNU*BY(1)-BY(2)                                       BESS0633
       BJ(2)=CONST*FNU*BJ(1)-BJ(2)                                      BESS0634
      IF(NN-1) 49,49,51                                                 BESS0635
 51    FRAC=FNU                                                         BESS0636
       DO 52  I=1,N1                                                    BESS0637
       FRAC=FRAC-1.0                                                    BESS0638
       BJ(I+2)=CONST*FRAC*BJ(I+1)-BJ(I)                                 BESS0639
      IF(FNU-.50000) 58,52,58                                           BESS0640
  58   BY(I+2)=CONST*FRAC*BY(I+1)-BY(I)                                 BESS0641
   52 CONTINUE                                                          BESS0642
        GO TO 49                                                        BESS0643
 61   BJ(2)=CONST*FNU*BJ(1)-BJ(2)                                       BESS0644
      GO TO 49                                                          BESS0645
       END                                                              BESS0646
