       LBL     PRECES,X                                                      001
       ENTRY   PRECES                                                        002
       REM        THIS IS A GENERAL PRECESSION SUBROUTINE WHICH              003
       REM     INCLUDES SECULAR VARIATIONS(SECOND ORDER TERMS).              004
       REM     IT IS FORTRAN 2 COMPATIBLE WITH THE ARGUMENTS IN              005
       REM     THE FOLLOWING ORDER.                                          006
       REM                             ALPHA                                 007
       REM                             DELTA                                 008
       REM                             EPOCH1                                009
       REM                             EPOCH2                                010
       REM                             ALFA                                  011
       REM                             DLTA                                  012
       REM                                                                   013
       REM        ALPHA AND DELTA WILL BE PRECESSED FROM EPOCH1              014
       REM     TO EPOCH2 AND RETURNED TO ALFA AND DLTA..  ALL                015
       REM     ANGLES ARE IN RADIANS, AND THE TWO DATES,EPOCH1 AND           016
       REM     EPOCH2, ARE JULIAN DATES.                                     017
       REM     A FORTRAN CALLING PROGRAM WOULD HAVE ACCESS TO THIS           018
       REM     ROUTINE VIA THE FOLLOWING TYPE OF STATEMENT.                  019
       REM                                                                   020
       REM          CALL PRECES(ALPHA,DELTA,EPOCH1,EPOCH2,ALFA,DLTA)         021
       REM                                                                   022
       REM        ALL WORKING STORAGE IS WITHIN THE PROGRAM ITSELF           023
       REM     AND NO COMMON OR OTHER SPECIAL STORAGE IS NEEDED.             024
       REM     COORDINATES MAY BE PRECESSED IN EITHER DIRECTION,             025
       REM     DEPENDING ON THE ORDER OF EPOCH1 AND EPOCH2.                  026
DT     HTR     *-*              SINCE SECOND ORDER VAIATIONS ARE TAKEN       027
B4     HTR     *-*           INTO ACCOUNT , THIS ROUTINE MAY BE ACCUR        028
ALPHA  HTR     *-*           ATELY USED FOR 50 TO 60 YEARS IN EITHER         029
DELTA  HTR     *-*           DIRECTION. FOR LONGER PERIODS (SUCH AS BD)      030
SALPHA HTR     *-*           IT WILL BE NECESSARY TO TRANSFORM               031
CALPHA HTR     *-*           COORDINATES .                                   032
CDELTA HTR     *-*                                                           033
TDELTA HTR     *-*                                                           034
TEMP   HTR     *-*                                                           035
COS2D  HTR     *-*                                                           036
DADT   HTR     *-*                                                           037
DDDT   HTR     *-*                                                           038
D2ADT2 HTR     *-*                                                           039
D2DDT2 HTR     *-*                                                           040
N      DEC     9.71901176E-05          THESE DECIMAL DATA ITEMS ARE THE      041
M      DEC     2.23426878E-04       RADIAN VALUES OF NEWCOMBS CONSTANTS      042
DNDT   DEC     -4.0724349E-10       TAKEN FROM W.M. SMARTS ''SPHERICAL       043
DMDT   DEC     1.3526302E-09        ASTRONOMY''.                             044
       REM                                                                   045
       REM     SYMBOL DEFINITIONS COMPLETE                                   046
       SPACE   5                                                             047
PRECES SXD     B4,4                                                          048
       CLA*    1,4                                                           049
       STO     ALPHA                                                         050
       CLA*    2,4                                                           051
       STO     DELTA                                                         052
       CLA*    4,4                                                           053
       FSB*    3,4                                                           054
       FDP     =365.25                                                       055
       STQ     DT                                                            056
       CLA     ALPHA                                                         057
       TSX     $SIN,4                                                        058
       STO     SALPHA                                                        059
       CLA     ALPHA                                                         060
       TSX     $COS,4                                                        061
       STO     CALPHA                                                        062
       CLA     DELTA                                                         063
       TSX     $COS,4                                                        064
       STO     CDELTA                                                        065
       XCA                                                                   066
       FMP     CDELTA                                                        067
       STO     COS2D                                                         068
       CLA     DELTA                                                         069
       TSX     $SIN,4                                                        070
       FDP     CDELTA                                                        071
       STQ     TDELTA                                                        072
       FMP     SALPHA                                                        073
       STO     TEMP                                                          074
       XCA                                                                   075
       FMP     N                                                             076
       FAD     M                                                             077
       STO     DADT                                                          078
       LDQ     CALPHA                                                        079
       FMP     N                                                             080
       STO     DDDT                                                          081
       LDQ     TEMP                                                          082
       FMP     DNDT                                                          083
       FAD     DMDT                                                          084
       STO     TEMP                                                          085
       LDQ     TDELTA                                                        086
       FMP     CALPHA                                                        087
       XCA                                                                   088
       FMP     DADT                                                          089
       XCA                                                                   090
       FMP     N                                                             091
       FAD     TEMP                                                          092
       STO     TEMP                                                          093
       CLA     DDDT                                                          094
       FDP     COS2D                                                         095
       FMP     SALPHA                                                        096
       XCA                                                                   097
       FMP     N                                                             098
       FAD     TEMP                                                          099
       STO     D2ADT2                                                        100
       LDQ     DADT                                                          101
       FMP     SALPHA                                                        102
       XCA                                                                   103
       FMP     N                                                             104
       STO     TEMP                                                          105
       LDQ     DNDT                                                          106
       FMP     CALPHA                                                        107
       FSB     TEMP                                                          108
       STO     D2DDT2                                                        109
       LDQ     DT                                                            110
       FMP     =.500                                                         111
       STO     TEMP                                                          112
       XCA                                                                   113
       FMP     D2ADT2                                                        114
       FAD     DADT                                                          115
       XCA                                                                   116
       FMP     DT                                                            117
       FAD     ALPHA                                                         118
       LXD     B4,4                                                          119
       STO*    5,4                                                           120
       LDQ     D2DDT2                                                        121
       FMP     TEMP                                                          122
       FAD     DDDT                                                          123
       XCA                                                                   124
       FMP     DT                                                            125
       FAD     DELTA                                                         126
       STO*    6,4                                                           127
       TRA     7,4                                                           128
