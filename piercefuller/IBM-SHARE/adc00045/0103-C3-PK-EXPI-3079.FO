*     (3)         SAMPLE PROBLEM FORTRAN SOURCE PROGRAM DECK            TEST0000
*     LIST                                                              TEST0001
*     LABEL                                                             TEST0002
CTEST               TEST EXPI SUBROUTINE    J.W.COOLEY                  TEST0003
      WRITE OUTPUT TAPE 10,12                                           TEST0004
   12 FORMAT(24H1TEST EXPI,  J.W.COOLEY  / 5H0   X 7X 5HEXPIL 10X 5HEXPITEST0005
     1E 10X 4HEXPI )                                                    TEST0006
      DO 20 I=1,81                                                      TEST0007
      X = .5*FLOATF(I-21)                                               TEST0008
      A=EXPILF(X)                                                       TEST0009
      IF(X)16,14,16                                                     TEST0010
   14 B=0.                                                              TEST0011
      C=0.                                                              TEST0012
      GO TO 20                                                          TEST0013
   16 B=EXPIEF(X)                                                       TEST0014
      C=EXPIF(X)                                                        TEST0015
   20 WRITE OUTPUT TAPE 10,22,X,A,B,C                                   TEST0016
   22 FORMAT(1H   F6.2, 1P3E15.7 )                                      TEST0017
      CALL EXIT                                                         TEST0018
      END                                                               TEST0019
