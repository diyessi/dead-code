*     NBS   HF13                                                        HF130000
      SUBROUTINE HANK(KIND,ORDER,BRANCH,A,B,X,Y,MAGTUD)                 HF130001
      DIMENSION BR(2),BI(2),GAM(4)                                      HF130002
      IF(A*A+B*B) 300,400,300                                           HF130003
  300 MAGTUD=0                                                          HF130004
      SIGN=3-2*KIND                                                     HF130005
      SO=3.-6.*ORDER                                                    HF130006
      V=ORDER                                                           HF130007
      IF(B) 1,2,3                                                       HF130008
    1 SIY=-1.                                                           HF130009
      GO TO 4                                                           HF130010
    2 SIY=0.                                                            HF130011
      GO TO 4                                                           HF130012
    3 SIY=1.                                                            HF130013
    4 IF(SIY*SIGN)  5,5,6                                               HF130014
    5 RB=5.5                                                            HF130015
      GO TO 7                                                           HF130016
    6 RB=2.3                                                            HF130017
    7 CALL POLR  (A,B,R,THETA )                                         HF130018
      THETA=THETA+BRANCH*6.2831853                                      HF130019
      IF(R-RB) 10,100,100                                               HF130020
   10 KO=3.*ORDER+.1                                                    HF130021
      GAM(1)=-4.06235381                                                HF130022
      GAM(2)=2.6789385                                                  HF130023
   35 GAM(3)=-4.0184078                                                 HF130024
      GAM(4)=1.3541179                                                  HF130025
      DO 90 L=1,2                                                       HF130026
      KI=2*KO+1-L                                                       HF130027
   50 GR=(.5*R)**V*COSF(V*THETA)/GAM(KI)                                HF130028
      GI=(.5*R)**V*SINF(V*THETA)/GAM(KI)                                HF130029
      CALL SERIES(A,B,V   ,SUMR,SUMI)                                   HF130030
      CALL ZMPY(SUMR,SUMI,GR,GI,BR(L),BI(L))                            HF130031
   90 V=-V                                                              HF130032
      CALLZMPY(0.,1.1547005  ,SO*.5*BR(1)-BR(2),SO*.5*BI(1)-BI(2),GR,GI)HF130033
      X=BR(1)+SIGN*GR                                                   HF130034
      Y=BI(1)+SIGN*GI                                                   HF130035
      RETURN                                                            HF130036
  100 IGO=1                                                             HF130037
      C=A                                                               HF130038
   28 D=B                                                               HF130039
      SR=1.2533141  *SQRTF(R)                                           HF130040
      TR=SR*COSF(.5*THETA)                                              HF130041
      TI=SR*SINF(.5*THETA)                                              HF130042
      IF(ABSF(THETA)-4.7123890  ) 103,103,115                           HF130043
  103 IF(SIGN*(THETA+SIGN*1.5707963  )) 105,113,113                     HF130044
  105 C=-A                                                              HF130045
      D=-B                                                              HF130046
      CALLZMPY(TR,TI,0.,SIGN,TR,TI)                                     HF130047
      IGO=2                                                             HF130048
      GO TO 113                                                         HF130049
  115 IGO =3                                                            HF130050
      TR=-TR                                                            HF130051
      TI=-TI                                                            HF130052
  113 CALLZEXP(-SIGN*D,SIGN*(C-1.5707963  *(V+.5)),SR,SI,MAGTUD)        HF130053
      CALLSP(V,2.*SIGN*D,-2.*SIGN*C,RTR,RTI)                            HF130054
      CALL ZMPY(SR,SI,RTR,RTI,X,Y)                                      HF130055
      GO TO (135,192,192),IGO                                           HF130056
  192 CALLSP(V,-2.*SIGN*D,2.*SIGN*C,RTR,RTI)                            HF130057
      CALLZDIV(RTR,RTI,SR,SI,SR,SI)                                     HF130058
      CALLZMPY(SR,SI,SO*.5,-SIGN*.86602540  ,SR,SI)                     HF130059
      EX1=1.                                                            HF130060
      EX2=1.                                                            HF130061
      IF(MAGTUD) 195,200,197                                            HF130062
  195  EMA=2*MAGTUD                                                     HF130063
      EX1=EXPF(EMA)                                                     HF130064
      MAGTUD=-MAGTUD                                                    HF130065
      GO TO 200                                                         HF130066
  197  EMA=-2*MAGTUD                                                    HF130067
      EX2=EXPF(EMA)                                                     HF130068
  200 GO TO (135,205,210),IGO                                           HF130069
  205 X=SO*EX1*X+SR*EX2                                                 HF130070
      Y=SO*EX1*Y+SI*EX2                                                 HF130071
      GO TO 135                                                         HF130072
  210 X=-EX1*X-SO*SR*EX2                                                HF130073
      Y=-EX1*Y-SO*SI*EX2                                                HF130074
  135 CALLZDIV(X,Y,TR,TI,X,Y)                                           HF130075
  136 RETURN                                                            HF130076
  400 WRITE OUTPUT TAPE 6,401                                           HF130077
  401 FORMAT(35H ZERO ARGUMENT NOT DEFINED IN HANK.)                    HF130078
      CALL EXIT                                                         HF130079
      END                                                               HF130080
