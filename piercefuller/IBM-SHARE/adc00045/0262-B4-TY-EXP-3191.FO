*     FAP     EXP F,TWOXP F       KAHAN   APR/64                  V(0.5)EXPF0000
       COUNT  92                                                        EXPF0010
       ENTRY  EXP            EXPF(X) = E**X                             EXPF0020
       ENTRY  TWOXP          TWOXPF(Z) =2.**Z                           EXPF0030
 EXP   LAS    LT127          CHECK X AGAINST OVER/UNDERFLOW.            EXPF0040
       TRA    BIGE                                                      EXPF0050
       TPL    LARGE                                                     EXPF0060
 UFA   UFA    O224           FORM Z=X/LOG(2) ,FIXED POINT.              EXPF0070
       RQL    8                                                         EXPF0080
       LRS    14             MQ =X BQ7 .                                EXPF0090
       MPY    LOG2E          B1 AC = Z B8                               EXPF0100
       LRS    27                                                        EXPF0110
 RND   RND                   SEPARATE Z = I+1+F,ABSF(F).LE.1/2          EXPF0120
       ALS    27                                                        EXPF0130
       SUB    ONEB8                                                     EXPF0140
       STO    I              B8                                         EXPF0150
       XCA                                                              EXPF0160
       LRS    5              EXAMINE FRACTION(Z) TO GET F B5            EXPF0170
       TPL    POS                                                       EXPF0180
       LAS    HALF                                                      EXPF0190
       TRA    *+1            IF FRACTION IS NOT SMALLER THAN 1/2,       EXPF0200
       ADD    ONEB5          COMPLEMENT IT W.R.T. 1.B5                  EXPF0210
       TRA    XCA                                                       EXPF0220
 POS   CAS    HALF                                                      EXPF0230
       TRA    *+1                                                       EXPF0240
       SUB    ONEB5                                                     EXPF0250
 XCA   XCA                                                              EXPF0260
       STQ    F           B5 -1/2.LE. F.LE.+1/2                         EXPF0270
       VLM    F,0,32                                                    EXPF0280
       ADD    C            B7                                           EXPF0290
       STO    T              = C+F*F   B7.                              EXPF0300
       CLS    B            B12                                          EXPF0310
       DVH    T                                                         EXPF0320
       XCA                                                              EXPF0330
       ADD    A            B5                                           EXPF0340
       SUB    F                                                         EXPF0350
       STO    T              = A-B/(C+F*F)-F   B5                       EXPF0360
       CLA    F                                                         EXPF0370
       LDQ    O40                                                       EXPF0380
       VDH    T,0,29         MQ =4.*F/(A-B/(C+F*F)-F)                   EXPF0390
       XCA                                                              EXPF0400
       FAD    TWO            +2.                                        EXPF0410
       FRN                   AC = 2.**(1+F).                            EXPF0420
       ADD    I              *2.**I                                     EXPF0430
       TRA    1,4            EXP 116 , TWOXP 103 CYCLES (7090)          EXPF0440
 BIGE  TPL    LARGE                                                     EXPF0450
       CAS    LT129                                                     EXPF0460
       TRA    UFA                                                       EXPF0470
       TRA    UFA                                                       EXPF0480
 SMALL ZAC                   IF Z.LT.-129., RESULT IS 0.0 .             EXPF0490
       TRA    1,4                                                       EXPF0500
 LARGE CLA    INFY           IF Z.GE.127., RESULT IS INFINITY,          EXPF0510
       STO    OVFLO          AND OVERFLOW.                              EXPF0520
       TRA    1,4                                                       EXPF0530
 LT127 OCT    207540074637   LOG(2.**127)+.                             EXPF0540
 O224  OCT    224000000000                                              EXPF0550
 LOG2E OCT    270524354513   1/LOG(2) B1 .                              EXPF0560
 HALF  DEC    0.5B5                                                     EXPF0570
 ONEB8 DEC    1.0B8                                                     EXPF0580
 ONEB5 DEC    1.0B5                                                     EXPF0590
 O40   OCT    40                                                        EXPF0600
 C     DEC    125.07363368B7 CONSTANTS ADAPTED FROM                     EXPF0610
 A     DEC    17.334440011B5 DUIJVESTIJN AND DEKKERS (1961),            EXPF0620
 B     DEC    1807.19517714B12  PHILIPS RES. REPTS 16 P170.             EXPF0630
 LT129 OCT    607545523741   -LOG(2.** 129)+.                           EXPF0640
 TWO   DEC    2.0                                                       EXPF0650
 INFY  OCT    377777777777                                              EXPF0660
       COMMON -1                                                        EXPF0670
 OVFLO COMMON 1              OVERFLOW CELL                              EXPF0680
       COMMON -206                                                      EXPF0690
 I     COMMON 1              ERASABLE COMMON 77775-7.                   EXPF0700
 T     COMMON 1                                                         EXPF0710
 F     COMMON 1                                                         EXPF0720
       REM IF TWOXP IS NOT WANTED, DELETE CARDS 3,75-91.                EXPF0730
       REM IF EXP, DELETE 2,86,91,REPLACE 4-11BY79-85,45-48BY87-90      EXPF0740
 D127  DEC    127.                                                      EXPF0750
 O215  OCT    215000000000                                              EXPF0760
 BLOT  OCT    377773460000                                              EXPF0770
 D129  DEC    -129.                                                     EXPF0780
 TWOXP LAS    D127           CHECK Z AGAINST OVER/UNDERFLOW.            EXPF0790
       TRA    BIG2                                                      EXPF0800
       TPL    LARGE                                                     EXPF0810
 UFA2  UFA     O215          CONVERT TO FIXED POINT                     EXPF0820
       RQL    8                                                         EXPF0830
       LRS    14                                                        EXPF0840
       ACL    BLOT           (AC,MQ) = Z B0                             EXPF0850
       TRA    RND                                                       EXPF0860
 BIG2  TPL    LARGE                                                     EXPF0870
       CAS    D129                                                      EXPF0880
       TRA     UFA2                                                     EXPF0890
       TRA     UFA2                                                     EXPF0900
       TRA    SMALL          80 LOCATIONS + 3 ERASABLE COMMON           EXPF0910
       END                   V.KAHAN   APR. 1964                        EXPF0920
