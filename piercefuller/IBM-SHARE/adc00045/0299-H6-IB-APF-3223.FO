      SUBROUTINE PERM (NMJOBS,IPERM)                                    APF 0368
      DIMENSION R(40),IPERM(40)                                         APF 0369
      DO 1 I=1,NMJOBS                                                   APF 0370
    1 R(I)=RANDOM(1.)                                                   APF 0371
      DO 4 J=1,NMJOBS                                                   APF 0372
      RMAX=0.                                                           APF 0373
      DO 3 I=1,NMJOBS                                                   APF 0374
      IF(R(I)-RMAX)3,2,2                                                APF 0375
    2 K=I                                                               APF 0376
      RMAX=R(I)                                                         APF 0377
    3 CONTINUE                                                          APF 0378
      R(K)=0.                                                           APF 0379
    4 IPERM(J)=K                                                        APF 0380
      RETURN                                                            APF 0381
      END                                                               APF 0382
*     FAP                                                               APF 0383
       COUNT   450                                                      APF 0384
       ENTRY   INITEP                                                   APF 0385
       ENTRY   ESTART                                                   APF 0386
 START SXD     ESAVEC,4                                                 APF 0387
       LAC     M,1                                                      APF 0388
       CLA     KLEV-1,1                                                 APF 0389
       STA     S1                                                       APF 0390
       STA     S2                                                       APF 0391
       ANA     CNST2               0 IN BIT 21, 1 OTHERWISE             APF 0392
       SUB     ONE                                                      APF 0393
       PAX     0,1                                                      APF 0394
       CLA     NEGIF                                                    APF 0395
 S1    STO     0,1                 SET PROPER PART OF                   APF 0396
       TIX     *-1,1,1             UPPER MEMORY TO                      APF 0397
 S2    STO     0                   MINUS INFINITY                       APF 0398
       STZ     16384                                                    APF 0399
       CLA     ONE                 SET                                  APF 0400
       STO     K                   K TO 1                               APF 0401
       LAC     M,1                 -M TO IRA                            APF 0402
       ALS     -1,1                M-1                                  APF 0403
       ORA     CNST3               1 IN BIT 21, 0 OTHERWISE             APF 0404
       STA     SET                 INITIALIZE SET                       APF 0405
       TRA     MXPRF                                                    APF 0406
*              GENERATE NEXT SUBSET S OF SIZE K                         APF 0407
 NXSET CLA     SET                 SET TO AC                            APF 0408
       LAC     K,1                 -K TO IRA                            APF 0409
       CAS     KLEV-1,1                                                 APF 0410
       TRA     *+2                                                      APF 0411
       TRA     UPK                 LAST SUBSET OF SIZE K GENERATED      APF 0412
       LXA     ZERO,1              0 TO IRA     I                       APF 0413
       LXA     ZERO,2              0 TO IRB     J                       APF 0414
       TRA     *+3                                                      APF 0415
 B0    TXI     *+1,1,-1            I-1 TO I                             APF 0416
       ARS     1                                                        APF 0417
       LBT                                                              APF 0418
       TRA     B1                  BIT 35 IS 0                          APF 0419
       TRA     B0                  BIT 35 IS 1                          APF 0420
 B1    TXI     *+1,2,-1            J-1 TO J                             APF 0421
       ARS     1                                                        APF 0422
       LBT                                                              APF 0423
       TRA     B1                  0                                    APF 0424
       ANA     CNST1               1                                    APF 0425
       ALS     1,1                 1-(-I)                               APF 0426
       ORA     KLEV,1                                                   APF 0427
