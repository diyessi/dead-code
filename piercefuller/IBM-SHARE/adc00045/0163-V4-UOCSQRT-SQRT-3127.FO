*     FAP                                                                       
       LBL     SQRT                                                     SQRT0000
       COUNT   40                                                       SQRT0001
*      U. OF CHICAGO VERSION OF SINGLE PRECISION SQUARE ROOT            SQRT0002
*              CALLING SEQUENCE    TSX   $SQRT,4                        SQRT0003
*      ERROR CONDITION IS HANDLED BY (EXE)                              SQRT0004
       SPACE                                                            SQRT0005
       ENTRY   SQRT                                                     SQRT0006
       SPACE                                                            SQRT0007
 SQRT  TZE     1,4                                                      SQRT0008
       TMI     ERROR                                                    SQRT0009
       STO     BUFF          1ST APPROX. IS OBTAINED AS FOLLOWS         SQRT0010
       ANA     K1              BETWEEN 1/2 AND 1, BY LINE PASSING THRU  SQRT0011
       ARS     1                 3/4 AND 1                              SQRT0012
       ADD     BUFF            BETWEEN 1/4 AND 1/2, BY LINE PASSINGTHRU SQRT0013
       ARS     1                 1/2 AND 3/4                            SQRT0014
       ADD     K2                                                       SQRT0015
       SPACE                                                            SQRT0016
       SXA     SAVE,4        REFINE APPROX. BY 3 PASSES OF NEWTON-      SQRT0017
       AXT     3,4             RAPHSON LOOP                             SQRT0018
 LOOP  STO     BUFF+1                                                   SQRT0019
       CLA     BUFF                                                     SQRT0020
       FDP     BUFF+1                                                   SQRT0021
       XCA                                                              SQRT0022
       FAD     BUFF+1                                                   SQRT0023
       SUB     K1                                                       SQRT0024
       TIX     LOOP,4,1                                                 SQRT0025
       FRN                                                              SQRT0026
 SAVE  AXT     **,4                                                     SQRT0027
       TRA     1,4                                                      SQRT0028
       SPACE                                                            SQRT0029
 ERROR LDI     *+2                                                      SQRT0030
       TRA*    $(EXE)                                                   SQRT0031
       PZE     5,4,*+1                                                  SQRT0032
       SSP                                                              SQRT0033
       TRA     SQRT                                                     SQRT0034
       SPACE                                                            SQRT0035
  K1   OCT     1000000000                                               SQRT0036
  K2   OCT     100400000000                                             SQRT0037
 BUFF  BSS     2                                                        SQRT0038
       END                                                              SQRT0039
