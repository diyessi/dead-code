*ID NAME/SANSOM,PROB/63-085,TIME/10,LINES/2000                          MDAS0001
*     XEQ                                                               MDAS0002
      CALL MIDAS                                                        MDAS0003
      END                                                               MDAS0004
      SUBROUTINE MIDAS                                                  MDAS0005
CLIST OF FUNCTIONS AND PSEUDO-OPERATIONS                                MDAS0006
C    NEG    01    CHANGE SIGN                                           MDAS0007
C    SQR    02    SQUARE ROOT                                           MDAS0008
C    E      03    EXPONENTIAL                                           MDAS0009
C    LN     04    NATURAL LOGARITHM                                     MDAS0010
C    AT     05    ARC TANGENT                                           MDAS0011
C    ABS    06    ABSOLUTE VALUE                                        MDAS0012
C    M      21    MULTIPLY                                              MDAS0013
C    D      22    DIVIDE                                                MDAS0014
C    FIN    23    STOP PROBLEM                                          MDAS0015
C    BB     24    BANG-BANG                                             MDAS0016
C    OR     25    OUTPUT SWITCHING RELAY                                MDAS0017
C    I      26    INTEGRATE                                             MDAS0018
C    P      27    MULTIPLY                                              MDAS0019
C    IMP    28    IMPLICIT FUNCTION                                     MDAS0020
C    L      41    LIMIT                                                 MDAS0021
C    IR     42    INPUT SWITCHING RELAY                                 MDAS0022
C    DS     43    DEAD SPACE                                            MDAS0023
C    RES    44    SINE-COSINE                                           MDAS0024
C    DFG    45    DIODE FUNCTION GENERATOR                              MDAS0025
C    CF     46    VARIABLE CURVE FOLLOWER                               MDAS0026
C    F      48    VARIABLE FUNCTION                                     MDAS0027
C    G      49    CONSTANT FUNCTION                                     MDAS0028
C    CG     50    CONSTANT CURVE FOLLOWER                               MDAS0029
C    S      51    SUM                                                   MDAS0030
C    IC     52    INITIAL CONDITION                                     MDAS0031
C    K      53    PARAMETER                                             MDAS0032
C    RO     54    READ-OUT                                              MDAS0033
C    HDR    55    OUTPUT HEADING                                        MDAS0034
C    CON    56    CONSTANT                                              MDAS0035
C    FSW    57    FUNCTION SWITCH                                       MDAS0036
C    PAR    58    PARAMETER                                             MDAS0037
C    END          END OF PROGRAM                                        MDAS0038
      DIMENSION M(750,10),SYMB(1000),R(1000)                            MDAS0039
      DIMENSION MP(1000)                                                MDAS0040
      DIMENSION Y(100),P(100)                                           MDAS0041
      DIMENSION RMAX(1000),RMIN(1000)                                   MDAS0042
      DIMENSION BCD(12),FSYMB(1000)                                     MDAS0043
