*     NBS ERFI                                                          ERFI0000
      SUBROUTINE ERFINV(Y,J,X,ANSWER,RATIO,OUTNO)                       ERFI0001
      COMMON XINCRE,TEST,E,YLIMIT,VE                                    ERFI0002
      XINCR=XINCRE                                                      ERFI0003
      J=0                                                               ERFI0004
      X=0.                                                              ERFI0005
      IF(Y)4,4,2                                                        ERFI0006
   4  ANSWER=0.                                                         ERFI0007
      RATIO =0.                                                         ERFI0008
      GO TO 9                                                           ERFI0009
    2 IF(Y-YLIMIT)15,15,8                                               ERFI0010
    8 OUTNO=1.                                                          ERFI0011
      GO TO 10                                                          ERFI0012
   15 X=X+XINCR                                                         ERFI0013
   17 ANSWER=ERR169(X)                                                  ERFI0014
   31 J=J+1                                                             ERFI0015
      DIFFER=ANSWER-Y                                                   ERFI0016
      IF(ABSF(DIFFER)-TEST)12,12,11                                     ERFI0017
   11 IF(DIFFER)15,15,19                                                ERFI0018
   19 XINCR=0.5*XINCR                                                   ERFI0019
   23 X=X-XINCR                                                         ERFI0020
   27 ANSWER=ERR169(X)                                                  ERFI0021
   33 J=J+1                                                             ERFI0022
      DIFFER=ANSWER-Y                                                   ERFI0023
      IF(ABSF(DIFFER)-TEST)12,12,21                                     ERFI0024
   21 XINCR=0.5*XINCR                                                   ERFI0025
      IF(DIFFER)25,25,23                                                ERFI0026
   25 X=X+XINCR                                                         ERFI0027
      GO TO 27                                                          ERFI0028
   12 A=0.8862269*E                                                     ERFI0029
      V1=A*EXPF(X*X)                                                    ERFI0030
   18 EX=EXPF((X+V1)**2)                                                ERFI0031
      F1=V1-(A*EX)                                                      ERFI0032
      FPR=1.-(2.*A*(X+V1)*EX)                                           ERFI0033
      IF(FPR)20,20,22                                                   ERFI0034
   22 V2=V1-(F1/FPR)                                                    ERFI0035
      IF(ABSF((V2-V1)/V2)-VE)14,14,16                                   ERFI0036
   16 V1=V2                                                             ERFI0037
      GO TO 18                                                          ERFI0038
   14 RATIO=V2/X                                                        ERFI0039
      GO TO 9                                                           ERFI0040
   20 RATIO=0.                                                          ERFI0041
    9 OUTNO=0.                                                          ERFI0042
   10 RETURN                                                            ERFI0043
      END                                                               ERFI0044
