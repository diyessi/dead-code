       ORA     =O201000000000       FLOATS AND NORMALIZES RESULT        MCEXP035
       ADD     V                    MULTIPLIES BY 2**I                  MCEXP036
 EXT5  AXT     **,1                                                     MCEXP037
       TRA     1,4                                                      MCEXP038
 T102  CAS     =-88.028                                                 MCEXP039
       TRA     *+3                                                      MCEXP040
       TRA     ZERO                 IF TOO SMALL,                       MCEXP041
       TRA     ZERO                 RETURN WITH ZERO                    MCEXP042
       SSP                          IF ARGUMENT NEGATIVE, SET PLUS      MCEXP043
       SXA     I7,4                                                     MCEXP044
       TSX     T52,4                                                    MCEXP045
 I7    AXT     **,4                 COMPUTE E**-X=1/E**X                MCEXP046
       STO     X                                                        MCEXP047
       CLA     =1.0                                                     MCEXP048
       FDP     X                                                        MCEXP049
       XCA                                                              MCEXP050
       TRA     1,4                                                      MCEXP051
 ZERO  ZAC                          IF ARGUMENT TOO SMALL,              MCEXP052
       TRA     1,4                  RETURN WITH ZERO.                   MCEXP053
 INF   CLA     =O377777777777       IF ARGUMENT TOO LARGE,              MCEXP054
       TRA     1,4                  RETURN WITH INFINITY.               MCEXP055
