      CMD9=CMD5*CMD4                                                    AT621360
      CMD10=CMD5*CMD5                                                   AT621370
      C2=C*C                                                            AT621380
      C3=C2*C                                                           AT621390
      D2=D*D                                                            AT621400
      PBLN=ALOG(PB)                                                     AT621410
      TEM14=EMOR/ELM                                                    AT621420
      CALL SLITE (1)                                                    AT621430
C     COMPUTE USING ZB                                                  AT621440
      CALL STORE(Z6,Z6,1,ZB*.000001)                                    AT621450
  344 ZPD=PART(Z6,Z6,1)+D                                               AT621460
