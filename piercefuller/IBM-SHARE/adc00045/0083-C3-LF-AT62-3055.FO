     1  +ZPD/CMD3-2.0*D*ZDLOG/CMD3-D2/(ZPD*CMD3)                        AT621680
     2   -ZDLOG/CMD2-2.0*D/(ZPD*CMD2)+D2/(2.0*ZPD2*CMD2)                AT621690
     3     -1.0/(ZPD*CMD)+D/(ZPD2*CMD)-D2/(3.0*ZPD3*CMD)                AT621700
     4       +ZPC2/(2.0*CMD4)-2.0*C*ZPC/CMD4+C2*ZCLOG/CMD4              AT621710
      TEMP5=ZCDLOG/CMD4-1.0/(CMD3*ZPD)+1.0/(2.0*ZPD2*CMD2)              AT621720
     1   -1.0/(3.0*ZPD3*CMD)                                            AT621730
      TEM6=ZPC-C*ZCLOG                                                  AT621740
      TEM7=ZPC2/2.0-2.0*C*ZPC+C2*ZCLOG                                  AT621750
      TEM8=ZPC3/3.0-3.0*C*ZPC2/2.0+3.0*C2*ZPC-C3*ZCLOG                  AT621760
      TEM11=-ZDLOG/CMD10-1.0/(CMD9*ZPD)+1.0/(2.0*CMD8*ZPD2)             AT621770
     1   -1.0/(3.0*CMD7*ZPD3)+1.0/(4.0*CMD6*ZPD4)-1.0/(5.0*CMD5*ZPD5)   AT621780
     2         +1.0/(6.0*CMD4*ZPD6)-1.0/(7.0*CMD3*ZPD7)+1.0/(8.0*CMD2*ZPAT621790
     3D8)            -1.0/(9.0*CMD*ZPD9)+ZCLOG/CMD10                    AT621800
      TEM12=ZDLOG/CMD5+1.0/(CMD4*ZPD)-1.0/(2.0*CMD3*ZPD2)               AT621810
