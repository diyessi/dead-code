  802 IF(Z-ZBTAB(N))803,801,800                                         AT621130
  800 N=N+1                                                             AT621140
      GO TO 802                                                         AT621150
  801 J=N                                                               AT621160
      GO TO 804                                                         AT621170
  803 J=N-1                                                             AT621180
C     FIND ZB,PB,ELM,TMB,TM                                             AT621190
  804 ZB=ZBTB(J)                                                        AT621200
      PB=PZBTAB(J)                                                      AT621210
      ELM=ELMZTB(J)                                                     AT621220
      TMB=TMBZTB(J)                                                     AT621230
      TM=TMB+ELM*(Z-ZB)                                                 AT621240
C     COMPUTE P                                                         AT621250
      C=(-ZB+TMB/ELM)*.000001                                           AT621260
      D=6.3675708                                                       AT621270
      CMD=C-D                                                           AT621280
      CMD2=CMD*CMD                                                      AT621290
      CMD3=CMD2*CMD                                                     AT621300
      CMD4=CMD2*CMD2                                                    AT621310
      CMD5=CMD2*CMD3                                                    AT621320
      CMD6=CMD3*CMD3                                                    AT621330
