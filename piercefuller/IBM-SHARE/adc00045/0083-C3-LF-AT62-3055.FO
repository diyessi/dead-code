     X100000.,110000.,120000.,150000.,160000.,170000.,190000.,              0370
     X230000.,300000.,400000.,500000.,600000.,.3048,.45359237/              0380
C     SAVE SENSE LIGHT STATUS                                           AT620390
 1113 CALL SLITET(1,K000FX)                                             AT620400
       GO TO(1,2),K000FX                                                AT620410
    1 SAVE=1.0                                                          AT620420
      GOTO200                                                           AT620430
    2 SAVE=0.0                                                          AT620440
 200  IF(ZFT-2320000.0)7,7,25                                           AT620450
C     Z GREATER THAN 2320000.FT.                                        AT620460
   25 Z=2320000.0*CONV1                                                 AT620470
      GO TO 11                                                          AT620480
C     CONVERT Z FT. TO Z METERS                                         AT620490
    7 Z   =ZFT   *CONV1                                                 AT620500
C     COMPUTE H DOUBLE PRECISION                                        AT620510
 11   IF(Z-90000.0)1111,1111,98                                         AT620520
 1111 CALL STORE(ZDPR,ZDPR(1),1,Z)                                      AT620530
      CALL STORE(ZDPR,ZDPR(2),1,0.0)                                    AT620540
      Z6=ZDPR(1)*.000001D0                                              AT620550
  210 Z6P=Z6+6.3675708D0                                                AT620560
