     X160000.,170000.,190000.,230000.,300000.,400000.,500000.,600000.,      0300
     X99999999.,.16437801,.030074613,.0073544163,.0025216515,               0310
     X.00050617014,.00036942892,.00027925979,.00016852213,                  0320
     X.000069604207,.000018838460,.0000040303676,.0000010956796,            0330
     X.00000034502145,.003,.005,.01,.02,.015,.01,.007,.005,.004,.0033,      0340
     X.0026,.0017,.0011,180.65,210.65,260.65,360.65,960.65,1110.65,         0350
