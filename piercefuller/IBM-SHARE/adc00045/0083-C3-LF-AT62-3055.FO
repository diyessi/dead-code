C     Z LESS THAN 90000.M FIND H IN HMTAB TABLE                         AT620900
   70 N=1                                                               AT620910
  702 IF(H-HMTAB(N))703,701,700                                         AT620920
  700 N=N+1                                                             AT620930
      GO TO 702                                                         AT620940
  701 J=N                                                               AT620950
