      TMB=TMBTAB(J)                                                     AT621020
      TM=TMB+ELM*(H-HB)                                                 AT621030
  248 IF(ELM)72,73,72                                                   AT621040
C     IF ELM NOT =0 COMPUTE P                                           AT621050
   72 P   =EXP(ALOG(PB)-(GO*EMOR/ELM)*ALOG(TM/TMB))                     AT621060
