      SUBROUTINE NORMAL(M,N,B,C,TW,H)                                           
C     M=NO. OF ROWS                                                             
C     N= NO. OF COLUMNS                                                         
C      B= COEF. OF UNNORMALIZED MATRIX                                          
C      C= NORMALIZED AND WEIGHTED MATRIX                                        
C     TW= WEIGHTING FUNCTION TIME CONSTANT                                      
C     H= SPACING BETWEEN VALUES OF EMPIRICAL FUNCTION                           
      DIMENSION A(100,21),B(100,21),C(20,21),X(20)                              
      DO 12 I=1,M                                                               
      DO 12 J=1,N                                                               
 12   C(I,J)=0.                                                                 
      DO 10 I=1,M                                                               
      DO 10 J=1,N                                                               
 10   A(I,J)=B(I,J)                                                             
      L=N-1                                                                     
      DO 6 I=2,M                                                                
      TEMP=0.                                                                   
      IF(TW)7,8,7                                                               
 8    WF=1.0                                                                    
      GO TO 9                                                                   
 7    WF=EXPF(-FLOATF(I)*H/TW)                                                  
 9    CONTINUE                                                                  
      DO 4 J=1,L                                                                
 4    TEMP =TEMP+A(I,J)*A(I,J)                                                  
      DO 5 K=1,N                                                                
 5    A(I,K)=A(I,K)/SQRTF(TEMP)*WF                                              
 6    CONTINUE                                                                  
      DO 1 K=1,L                                                                
      DO 1 J=1,N                                                                
      DO 1 I=J,M                                                                
      C(K,J)=C(K,J)+A(I,K)*A(I,J)                                               
 1    C(J,K)=C(K,J)                                                             
      CALL ISIMEQ(C,20,L,1)                                                     
      DO 2 I=1,L                                                                
 2    X(I)=C(I,N)                                                               
      RETURN                                                                    
      END                                                                       
