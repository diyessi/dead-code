       REM     NBS CPK    COMPLEX ARITHMETIC PACKAGE                    CPK 0001
*     FAP                                                               CPK 0002
       COUNT   120                                                      CPK 0003
       LBL     851CAS,X                                                 CPK 0004
*              COMPLEX ARITHMETIC SUBROUTINES ZMPY AND ZDIV             CPK 0005
       ENTRY   ZMPY                                                     CPK 0006
       ENTRY   ZDIV                                                     CPK 0007
 ZMPY  LDQ*    2,4                                                      CPK 0008
       FMP*    4,4           B*D                                        CPK 0009
       STO     AC            MOST SIGN. PART (VAR)                      CPK 0010
       STQ     D             LEAST SIGN. PART (VAR)                     CPK 0011
       LDQ*    1,4                                                      CPK 0012
       FMP*    3,4           A*C                                        CPK 0013
       STQ     C             SAVE LEAST SIGN. PART (AC)                 CPK 0014
       FSB     AC            LESS MOST SIGN. PART (VAR)                 CPK 0015
       STO     AC            SAVE MOST SIGN. PART OF DIFF.              CPK 0016
       XCA                   LEAST SIGN. PART TO AC                     CPK 0017
       UFA     C             PLUS LEAST SIGN. PART (AC)                 CPK 0018
       UFS     D             LESS LEAST SIGN. PART (VAR)                CPK 0019
       FAD     AC            PLUS DIFF. OF MOST SIGN. PARTS             CPK 0020
       STO     TMP+1         REAL PART = AC-BD                          CPK 0021
       LDQ*    1,4                                                      CPK 0022
       FMP*    4,4           AD                                         CPK 0023
       STO     TMP                                                      CPK 0024
       LDQ*    2,4                                                      CPK 0025
       FMP*    3,4           BC                                         CPK 0026
       FAD     TMP           AD+BC                                      CPK 0027
       LDQ     TMP+1                                                    CPK 0028
 EXT   STO*    6,4           IMAGINARY PART                             CPK 0029
       STQ*    5,4                                                      CPK 0030
       TRA     7,4           RETURN TO CALLER                           CPK 0031
 ZDIV  SXA     EXOT,4                                                   CPK 0032
       CLA*    3,4                                                      CPK 0033
       TNZ     GOOD                                                     CPK 0034
       NZT*    4,4                                                      CPK 0035
       TRA     ERROR                                                    CPK 0036
 GOOD  LDQ*    4,4                                                      CPK 0037
       STO     C                                                        CPK 0038
       STQ     D                                                        CPK 0039
       LDQ*    1,4                                                      CPK 0040
       STQ     A             A                                          CPK 0041
       CLA*    2,4                                                      CPK 0042
       STO     B             B                                          CPK 0043
       SSP                                                              CPK 0044
       LRS     0                                                        CPK 0045
       TLQ     CS34          A LESS THAN B                              CPK 0046
       CLA     D                                                        CPK 0047
       LDQ     C                                                        CPK 0048
       SSP                                                              CPK 0049
       LRS     0                                                        CPK 0050
       TLQ     CASE2         C LESS THAN D                              CPK 0051
       TSX     CASE1,4       A AND C LARGEST ABSOLUTE VALUE             CPK 0052
       TRA     FDV07                                                    CPK 0053
 CASE2 CLS     C             A GREATER THAN B, C LESS THAN D            CPK 0054
       LDQ     D                                                        CPK 0055
       STO     D                                                        CPK 0056
       STQ     C                                                        CPK 0057
       TSX     CASE1,4                                                  CPK 0058
       TRA     FDV06                                                    CPK 0059
 CS34  CLA     D             CASE 3 OR 4                                CPK 0060
       LDQ     C             COMPARE C AND D                            CPK 0061
       SSP                                                              CPK 0062
       LRS     0                                                        CPK 0063
       TLQ     CASE4                                                    CPK 0064
       CLS     B             CASE 3                                     CPK 0065
       LDQ     A             A LESS THAN B, C GREATER THAN D            CPK 0066
       STO     A                                                        CPK 0067
       STQ     B                                                        CPK 0068
       TSX     CASE1,4                                                  CPK 0069
 FDV06 CLS     X                                                        CPK 0070
       LDQ     Y                                                        CPK 0071
 EXOT  AXT     ..,4                                                     CPK 0072
       TRA     EXT                                                      CPK 0073
 CASE4 CLS     A             A LESS THAN B, C LESS THAN D               CPK 0074
       LDQ     B                                                        CPK 0075
       STO     B                                                        CPK 0076
       STQ     A                                                        CPK 0077
       CLS     C                                                        CPK 0078
       LDQ     D                                                        CPK 0079
       STO     D                                                        CPK 0080
       STQ     C                                                        CPK 0081
       TSX     CASE1,4                                                  CPK 0082
 FDV07 LDQ     X                                                        CPK 0083
       CLA     Y                                                        CPK 0084
       TRA     EXOT                                                     CPK 0085
 CASE1 CLA     A             A/C INTO AC                                CPK 0086
       FDP     C                                                        CPK 0087
       STQ     AC                                                       CPK 0088
       CLA     B             B/A INTO BA                                CPK 0089
       FDP     A                                                        CPK 0090
       STQ     BA                                                       CPK 0091
       CLA     D             D/C INTO DC                                CPK 0092
       FDP     C                                                        CPK 0093
       STQ     DC            DC SQUARED PLUS ONE INTO DC2               CPK 0094
       FMP     DC                                                       CPK 0095
       FAD     FL1                                                      CPK 0096
       STO     DC2                                                      CPK 0097
       LDQ     DC            COMPUTE REAL PART OF ANSWER                CPK 0098
       FMP     BA                                                       CPK 0099
       FAD     FL1                                                      CPK 0100
       FDP     DC2                                                      CPK 0101
       FMP     AC                                                       CPK 0102
       STO     X             LEAVE IT IN X                              CPK 0103
       LFTM                  PREPARE TO TEST FOR UNDERFLOW CONDITION    CPK 0104
       TQO     *+1           TURN LITE OFF                              CPK 0105
       CLA     BA                                                       CPK 0106
       FSB     DC                                                       CPK 0107
       TQO     OVFL          TEST FOR UNDERFLOW                         CPK 0108
       EFTM                  RETURN TO NORMAL MODE                      CPK 0109
       FDP     DC2           FINISH COMPUTING IMAGINARY PART            CPK 0110
       FMP     AC                                                       CPK 0111
       STO     Y             LEAVE IT IN Y                              CPK 0112
       TRA     OUT                                                      CPK 0113
 OVFL  EFTM                  RETURN TO NORMAL MODE                      CPK 0114
       LDQ     AC            AVOID UNDERFLOW CAUSING CONDITION          CPK 0115
       FMP     DC                                                       CPK 0116
       STO     DC                                                       CPK 0117
       LDQ     AC                                                       CPK 0118
       FMP     BA                                                       CPK 0119
       FSB     DC                                                       CPK 0120
       FDP     DC2                                                      CPK 0121
       STQ     Y             LEAVE IMAGINARY PART IN Y                  CPK 0122
 OUT   TRA     1,4           RETURN TO CALLER                           CPK 0123
 ERROR LAC     EXOT,4                                                   CPK 0124
       SXA     EXOT,4                                                   CPK 0125
       CAL     TAPE                                                     CPK 0126
       CALL    (STH)                                                    CPK 0127
       TSX     FORM1,                                                   CPK 0128
       LDQ     EXOT                                                     CPK 0129
       STR                                                              CPK 0130
       CALL    (FIL)                                                    CPK 0131
       CALL    EXIT                                                     CPK 0132
 FL1   DEC     1.                                                       CPK 0133
 TAPE  OCT     000006000000                                             CPK 0134
 FORM1 BCI     6,(27H0C+DI IN ZDIV = 0.  LOC. = O5)                     CPK 0135
 ..    EQU     0                                                        CPK 0136
 TMP   BOOL    77773                                                    CPK 0137
 A     EQU     TMP                                                      CPK 0138
 B     EQU     TMP+1                                                    CPK 0139
 C     EQU     TMP+2                                                    CPK 0140
 D     EQU     TMP+3                                                    CPK 0141
 X     EQU     A                                                        CPK 0142
 Y     EQU     B                                                        CPK 0143
 AC    EQU     TMP+4                                                    CPK 0144
 BA    EQU     B                                                        CPK 0145
 DC    EQU     C                                                        CPK 0146
 DC2   EQU     D                                                        CPK 0147
       END                                                              CPK 0148
*     FAP                                                               CPK 0149
       COUNT   50                                                       CPK 0150
       LBL     851PLR,X                                                 CPK 0151
*              CONVERSION FROM RECTANGULAR TO POLAR COORDINATES         CPK 0152
       ENTRY   POLR                                                     CPK 0153
 POLR  SXA     EXIT,4                                                   CPK 0154
       CLA*    2,4                                                      CPK 0155
       STO     Y                                                        CPK 0156
       CLA*    1,4                                                      CPK 0157
       STO     X                                                        CPK 0158
       TZE     XZ            IS X ZERO                                  CPK 0159
       CLA     Y             NO                                         CPK 0160
       FDP     X                                                        CPK 0161
       XCA                                                              CPK 0162
       TSX     $ATAN,4                                                  CPK 0163
       STO     THETA         THETA=ATAN(Y/X)                            CPK 0164
       CLA     X                                                        CPK 0165
       TPL     FNDR                                                     CPK 0166
       CLA     Y                                                        CPK 0167
       LDQ     PI                                                       CPK 0168
       LRS     0                                                        CPK 0169
       XCA                                                              CPK 0170
       FAD     THETA                                                    CPK 0171
       STO     THETA                                                    CPK 0172
       TRA     FNDR                                                     CPK 0173
 XZ    CLA     Y             X IS ZERO                                  CPK 0174
       LDQ     PI2                                                      CPK 0175
       LRS     0                                                        CPK 0176
       STQ     THETA                                                    CPK 0177
 FNDR  CLA     Y             TEST RELATIVE MAGNITUDE OF X AND Y         CPK 0178
       SSP                                                              CPK 0179
       LDQ     X                                                        CPK 0180
       LRS     0                                                        CPK 0181
       TLQ     XSM                                                      CPK 0182
       CLA     THETA         X IS LARGER THAN Y                         CPK 0183
       TSX     $COS,4                                                   CPK 0184
       STO     TMP                                                      CPK 0185
       CLA     X             R=X/COS(THETA)                             CPK 0186
 OUT   FDP     TMP                                                      CPK 0187
 EXIT  AXT     ..,4                                                     CPK 0188
       STQ*    3,4                                                      CPK 0189
       CLA     THETA                                                    CPK 0190
       STO*    4,4           RETURN THETA                               CPK 0191
       TRA     5,4           RETURN TO CALLER                           CPK 0192
 XSM   CLA     THETA         Y IS LARGER THAN X                         CPK 0193
       TSX     $SIN,4                                                   CPK 0194
       STO     TMP                                                      CPK 0195
       CLA     Y             R=Y/SIN(THETA)                             CPK 0196
       TRA     OUT                                                      CPK 0197
 PI2   DEC     1.570796326                                              CPK 0198
 PI    DEC     3.141592654                                              CPK 0199
 ..    EQU     0                                                        CPK 0200
 TMP   BOOL    77774                                                    CPK 0201
 X     EQU     TMP-1                                                    CPK 0202
 Y     EQU     TMP-2                                                    CPK 0203
 THETA EQU     TMP-3                                                    CPK 0204
       END                                                              CPK 0205
*     FAP                                                               CPK 0206
       LBL     ZRTPLR,X                                                 CPK 0207
       COUNT   90                                                       CPK 0208
*              COMPLEX ROUTINES ZSQRT AND POLR / ZRTPLR                 CPK 0209
       ENTRY   ZSQRT                                                    CPK 0210
       ENTRY   -POLR                                                    CPK 0211
 POLR  CLA     LOCN                                                     CPK 0212
       STA     TZR                                                      CPK 0213
       CLA     TZR+3                                                    CPK 0214
       STO     OUT+2                                                    CPK 0215
 ZSQRT SXA     EXIT,4                                                   CPK 0216
       CLA*    2,4                                                      CPK 0217
       STO     B                                                        CPK 0218
       CLA*    1,4                                                      CPK 0219
       STO     A                                                        CPK 0220
 TZR   TZE     AZ            IS A ZERO                                  CPK 0221
       CLA     B             NO, POLR.                                  CPK 0222
       FDP     A                                                        CPK 0223
       XCA                                                              CPK 0224
       TSX     $ATAN,4                                                  CPK 0225
       STO     THETA         THETA=ATAN(Y/X)                            CPK 0226
       CLA     A                                                        CPK 0227
       TPL     FNDR                                                     CPK 0228
       CLA     B                                                        CPK 0229
       LDQ     PI                                                       CPK 0230
       LRS     0                                                        CPK 0231
       XCA                                                              CPK 0232
       FAD     THETA                                                    CPK 0233
       STO     THETA                                                    CPK 0234
       TRA     FNDR                                                     CPK 0235
 XZ    CLA     B             A IS ZERO                                  CPK 0236
       LDQ     PI2                                                      CPK 0237
       LRS     0                                                        CPK 0238
       STQ     THETA                                                    CPK 0239
 FNDR  CLA     B             TEST RELATIVE MAGNITUDE OF A AND B         CPK 0240
       SSP                                                              CPK 0241
       LDQ     A                                                        CPK 0242
       LRS     0                                                        CPK 0243
       TLQ     XSM                                                      CPK 0244
       CLA     THETA         A IS LARGER THAN B                         CPK 0245
       TSX     $COS,4                                                   CPK 0246
       STO     TMP                                                      CPK 0247
       CLA     A             R=A/COS(THETA)                             CPK 0248
 OUT   FDP     TMP                                                      CPK 0249
       STQ     X                                                        CPK 0250
       TRA     ANZ           INSTRUCTION MODIFIED FOR POLR, XCA.        CPK 0251
       LDQ     MOD                                                      CPK 0252
       STQ     *-2                                                      CPK 0253
       LXD     LOCN,4                                                   CPK 0254
       SXA     TZR,4                                                    CPK 0255
       LDQ     THETA                                                    CPK 0256
       TRA     EXIT          POLR, RETURN TO CALLER                     CPK 0257
 XSM   CLA     THETA         B IS LARGER THAN A                         CPK 0258
       TSX     $SIN,4                                                   CPK 0259
       STO     TMP                                                      CPK 0260
       CLA     B             R=B/SIN(THETA)                             CPK 0261
       TRA     OUT                                                      CPK 0262
 ANZ   CLA     A                                                        CPK 0263
       SSP                                                              CPK 0264
       FAD     X                                                        CPK 0265
       FDP     FL2           T=1/2(R+ABSF(A))                           CPK 0266
       XCA                                                              CPK 0267
       TSX     $SQRT,4                                                  CPK 0268
       STO     X                                                        CPK 0269
       XCA                                                              CPK 0270
       FMP     FL2                                                      CPK 0271
       STO     TMP                                                      CPK 0272
       CLA     B                                                        CPK 0273
       FDP     TMP                                                      CPK 0274
       STQ     TMP                                                      CPK 0275
       STQ     Y             Y=1/2(B/SQRT(T))                           CPK 0276
       CLA     A                                                        CPK 0277
       TMI     AM            IS A MINUS                                 CPK 0278
       CLA     X             NO                                         CPK 0279
 EXIT  AXT     ..,4                                                     CPK 0280
       STO*    3,4                                                      CPK 0281
       STQ*    4,4                                                      CPK 0282
       TRA     5,4           RETURN TO CALLER                           CPK 0283
 AM    CLA     B             A IS MINUS                                 CPK 0284
       LDQ     X                                                        CPK 0285
       LRS     0                                                        CPK 0286
       STQ     Y             Y=SQRT(T)*SIGN(B)                          CPK 0287
       CLA     TMP                                                      CPK 0288
       SSP                   X=1/2(ABSF(B/SQRT(T)))                     CPK 0289
       TRA     EXIT                                                     CPK 0290
 AZ    CLA     B             A IS ZERO                                  CPK 0291
       SSP                                                              CPK 0292
       FDP     FL2                                                      CPK 0293
       XCA                                                              CPK 0294
       TSX     $SQRT,4                                                  CPK 0295
       STO     X             X=SQRT(ABSF(B)/2)                          CPK 0296
       XCA                                                              CPK 0297
       CLA     B                                                        CPK 0298
       LRS     0             Y=X*SIGN(B)                                CPK 0299
       TRA     EXIT-1                                                   CPK 0300
 FL2   DEC     2.                                                       CPK 0301
 PI2   DEC     1.570796326                                              CPK 0302
 PI    DEC     3.141592654                                              CPK 0303
 LOCN  PZE     XZ,,AZ                                                   CPK 0304
 MOD   TRA     ANZ                                                      CPK 0305
 ..    EQU     0                                                        CPK 0306
 TMP   BOOL    77774                                                    CPK 0307
 A     EQU     TMP-1                                                    CPK 0308
 B     EQU     TMP-2                                                    CPK 0309
 X     EQU     TMP-3                                                    CPK 0310
 Y     EQU     TMP-4                                                    CPK 0311
 THETA EQU     Y                                                        CPK 0312
       END                                                              CPK 0313
