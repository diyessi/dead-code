*     LABEL                                                             MOUT0000
*     FAP                                                               MOUT0010
*MOUT          ***MULTIPLE-PRECISION INTEGER OUTPUT***                  MOUT0020
*              IND = MPOUT (BIN,NBIN,BCD,NBCD,MAXBCD,ERASE)             MOUT0030
       ENTRY   MPOUT                                                    MOUT0040
MPOUT  SXA     XR1,1                                                    MOUT0050
       SXA     XR2,2                                                    MOUT0060
       SXA     XR4,4                                                    MOUT0070
       CAL     1,4                                                      MOUT0080
       ADD     =1                                                       MOUT0090
       STA     NUM                                                      MOUT0100
       CAL     3,4                                                      MOUT0110
       ADD     =1                                                       MOUT0120
       STA     BCD                                                      MOUT0130
       CAL     6,4                                                      MOUT0140
       ADD     =1                                                       MOUT0150
       STA     BUF                                                      MOUT0160
       CLA*    2,4                                                      MOUT0170
       PDX     ,1                                                       MOUT0180
       CLA*    5,4                                                      MOUT0190
       PDX     ,2                                                       MOUT0200
       STZ     SIGN                                                     MOUT0210
A      CLA*    NUM             NUM+1,1                                  MOUT0220
       TNZ     B                                                        MOUT0230
       TIX     A,1,1                                                    MOUT0240
B      SXA     L,1                                                      MOUT0250
       TPL     C                                                        MOUT0260
       CLA     =O20                                                     MOUT0270
       STO     SIGN                                                     MOUT0280
C      CAL*    NUM             NUM+1,1                                  MOUT0290
D      STO*    BUF             BUF+1,1                                  MOUT0300
       TIX     C,1,1                                                    MOUT0310
       LXA     L,1                                                      MOUT0320
LOOP   SXA     L,1                                                      MOUT0330
       ZAC                                                              MOUT0340
E      LDQ*    BUF             BUF+1,1                                  MOUT0350
       DVH     =1000000                                                 MOUT0360
F      STQ*    BUF             BUF+1,1                                  MOUT0370
       TIX     E,1,1                                                    MOUT0380
G      STZ*    BCD             BCD+1,2                                  MOUT0390
       AXT     36,4                                                     MOUT0400
       XCA                                                              MOUT0410
H      ZAC                                                              MOUT0420
       DVH     =10                                                      MOUT0430
       ALS     36,4                                                     MOUT0440
J      ORS*    BCD             BCD+1,2                                  MOUT0450
       TIX     H,4,6                                                    MOUT0460
L      AXT     **,1            L,1                                      MOUT0470
ZET    NZT*    BUF             BUF+1,1                                  MOUT0480
       TNX     OUT,1,1                                                  MOUT0490
       TIX     LOOP,2,1                                                 MOUT0500
OUT    CLA*    BCD             BCD+1,2                                  MOUT0510
M      LGR     6                                                        MOUT0520
       TNZ     N                                                        MOUT0530
       CLA     =O60                                                     MOUT0540
       SUB     SIGN                                                     MOUT0550
       STZ     SIGN                                                     MOUT0560
N      TIX     M,4,1                                                    MOUT0570
O      STQ*    BCD             BCD+1,2                                  MOUT0580
       SUB     =O40                                                     MOUT0590
       TNZ     P                                                        MOUT0600
       LDQ     =O606060606040                                           MOUT0610
       TIX     O,2,1                                                    MOUT0620
P      PXD     ,2                                                       MOUT0630
XR4    AXT     **,4                                                     MOUT0640
       STD*    4,4                                                      MOUT0650
       TNX     EXIT,2,1                                                 MOUT0660
       CLA     =O606060606060                                           MOUT0670
Q      STO*    BCD             BCD+1,2                                  MOUT0680
       TIX     Q,2,1                                                    MOUT0690
EXIT   ZAC                                                              MOUT0700
R      ACL*    BUF             BUF+1,1                                  MOUT0710
       TIX     R,1,1                                                    MOUT0720
XR1    AXT     **,1                                                     MOUT0730
XR2    AXT     **,2                                                     MOUT0740
       TRA     7,4                                                      MOUT0750
SIGN   OCT                                                              MOUT0760
NUM    PZE     **,1                                                     MOUT0770
BUF    PZE     **,1                                                     MOUT0780
BCD    PZE     **,2                                                     MOUT0790
       END                                                              MOUT0800
