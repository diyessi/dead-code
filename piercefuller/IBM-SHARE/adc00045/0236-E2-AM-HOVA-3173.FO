       FOR                                                              HOVA0001
      COMMON ALPHA                                                      HOVA0002
      DIMENSIONT(25),Y(4,25),YACT(4,25),BETA(4),GAMMA(4),               HOVA0003
     1ALPHA(40),YNOW(4),DNOW(4),DDNOW(4),DPDY(4,4),                     HOVA0004
     2DPDYP(4,4),DYDAL(4,25,40),DYDBET(4,25,4),DYDGAM(4,25,4),CRV(100), HOVA0005
     3TERM1(4),TERM2(4),DPDA(4),XM(49,50),XL(49,50),DEL(100),TITLE(10)  HOVA0006
    1 FORMAT(3I4,F5.0,I4)                                               HOVA0007
    2 FORMAT(1X,7E10.0)                                                 HOVA0008
    3 FORMAT(///10H0ITERATION,I4/6H0ALPHA,13X,10HCORRECTION)            HOVA0009
    4 FORMAT(7(2X,E15.8))                                               HOVA0010
    5 FORMAT(5H0BETA)                                                   HOVA0011
    6 FORMAT(6H0GAMMA)                                                  HOVA0012
    7 FORMAT(9H1EQUATION,I4/3H  T,17X,8HY(GIVEN),10X,                   HOVA0013
     18HY(CALC.),10X,4HDEV.,14X,4HPCT.)                                 HOVA0014
    8 FORMAT(10H0RMS ERROR,E16.8)                                       HOVA0015
    9 FORMAT (10A6)                                                     HOVA0016
   10 FORMAT (1H1,10A6)                                                 HOVA0017
   11 FORMAT (11H0INPUT DATA//6H ALPHA)                                 HOVA0018
   12 FORMAT (6H0    T,17X,2HY1,16X,2HY2,16X,2HY3,16X,2HY4)             HOVA0019
  700 READ 9, TITLE                                                     HOVA0020
      READ1,N,M,MP,XINT,ITERA                                           HOVA0021
      IF(N)100,100,110                                                  HOVA0022
  100 CALL LGCHAR (8,6HEND JP)                                          HOVA0023
      CALL ERROUT (100)                                                 HOVA0024
  110 READ2,(ALPHA(I),I=1,M)                                            HOVA0025
      READ2,TAU,(BETA(I),I=1,N)                                         HOVA0026
      READ2,(GAMMA(I),I=1,N)                                            HOVA0027
      READ2,(T(I),I=1,MP)                                               HOVA0028
      DO120I=1,N                                                        HOVA0029
  120 READ2,(YACT(I,J),J=1,MP)                                          HOVA0030
      PRINT 10, TITLE                                                   HOVA0031
      PRINT 11                                                          HOVA0032
      PRINT 4, (ALPHA(I), I = 1,M)                                      HOVA0033
      PRINT 5                                                           HOVA0034
      PRINT 4, (BETA(I), I = 1,N)                                       HOVA0035
      PRINT 6                                                           HOVA0036
      PRINT 4, (GAMMA(I),I = 1,N)                                       HOVA0037
      PRINT 12                                                          HOVA0038
      DO 125 I = 1,MP                                                   HOVA0039
  125 PRINT 4, T(I),(YACT(J,I),J=1,N)                                   HOVA0040
      NGRPTS =MP*XFIXF(XINT)                                            HOVA0041
      NSKIP = NGRPTS/200 + 1                                            HOVA0042
      NSK = -1                                                          HOVA0043
      K = 0                                                             HOVA0044
      DO 740 I = 1,N                                                    HOVA0045
      DO 740 J = 1,MP                                                   HOVA0046
      K = K+1                                                           HOVA0047
      DEL(K) = T(J)                                                     HOVA0048
  740 CRV(K) = YACT(I,J)                                                HOVA0049
      CALL GRAPH (DEL,CRV,K,6H   T  ,6H   Y  ,TITLE,6H     X)           HOVA0050
      ITERM = 0                                                         HOVA0051
  730 TNOW=TAU                                                          HOVA0052
      DO140 I=1,N                                                       HOVA0053
      YNOW(I)=BETA(I)                                                   HOVA0054
  140 DNOW(I)=GAMMA(I)                                                  HOVA0055
      I=1                                                               HOVA0056
      H=(T(1)-TAU)/XINT                                                 HOVA0057
      SENSE LIGHT1                                                      HOVA0058
  220 CALLEVALDR(TNOW,YNOW,DNOW,DDNOW)                                  HOVA0059
      IF (ITERM-ITERA) 750,760,710                                      HOVA0060
  760 NSK = XMODF(NSK+1,NSKIP)                                          HOVA0061
      IF (NSK) 750,770,750                                              HOVA0062
  770 DO 780 K = 1,N                                                    HOVA0063
  780 DEL(K) = TNOW                                                     HOVA0064
      CALL ADPLOT (DEL,YNOW,N,6H     .)                                 HOVA0065
  750 IF (ABSF(TNOW-T(I))-.5*ABSF(H)) 150,150,160                       HOVA0066
  150 DO170J=1,N                                                        HOVA0067
  170 Y(J,I)=YNOW(J)                                                    HOVA0068
      IF(I-MP)180,190,190                                               HOVA0069
  180 I=I+1                                                             HOVA0070
      H=(T(I)-T(I-1))/XINT                                              HOVA0071
  160 TNOW=INDVF(TNOW,H)                                                HOVA0072
      DO200J=1,N                                                        HOVA0073
  200 YNOW(J)=DPNVF(YNOW(J),DNOW(J))                                    HOVA0074
      DO210J=1,N                                                        HOVA0075
  210 DNOW(J)=DPNVF(DNOW(J),DDNOW(J))                                   HOVA0076
      GO TO 220                                                         HOVA0077
  190 IF (ITERM-ITERA) 720,710,710                                      HOVA0078
  720 DO 800 I = 1,N                                                    HOVA0079
      ERMS = 0.                                                         HOVA0080
      DO 810 J = 1,MP                                                   HOVA0081
      DEV = Y(I,J)-YACT(I,J)                                            HOVA0082
  810 ERMS = ERMS + DEV*DEV                                             HOVA0083
      ERMS = SQRTF(ERMS/FLOATF(MP))                                     HOVA0084
  800 PRINT 8, ERMS                                                     HOVA0085
      DO230I=1,M                                                        HOVA0086
      TNOW=TAU                                                          HOVA0087
      DO240J=1,N                                                        HOVA0088
      YNOW(J)=0.                                                        HOVA0089
  240 DNOW(J)=0.                                                        HOVA0090
      J=1                                                               HOVA0091
      H=(T(1)-TAU)/XINT                                                 HOVA0092
      SENSE LIGHT1                                                      HOVA0093
  320 CALLDPHIDY(TNOW,YNOW,DNOW,DPDY)                                   HOVA0094
      CALLDPHDYP(TNOW,YNOW,DNOW,DPDYP)                                  HOVA0095
      CALLDPHIDA(TNOW,YNOW,DNOW,DPDA,I)                                 HOVA0096
      CALLAXMPY(DPDY,N,N,YNOW,N,TERM1,N)                                HOVA0097
      CALLAXMPY(DPDYP,N,N,DNOW,N,TERM2,N)                               HOVA0098
      DO250K=1,N                                                        HOVA0099
  250 DDNOW(K)=TERM1(K)+TERM2(K)+DPDA(K)                                HOVA0100
      IF (ABSF(TNOW-T(J))-.5*ABSF(H)) 260,260,270                       HOVA0101
  260 DO280K=1,N                                                        HOVA0102
  280 DYDAL(K,J,I)=YNOW(K)                                              HOVA0103
      IF(J-MP)290,230,230                                               HOVA0104
  290 J=J+1                                                             HOVA0105
      H=(T(J)-T(J-1))/XINT                                              HOVA0106
  270 TNOW=INDVF(TNOW,H)                                                HOVA0107
      DO300K=1,N                                                        HOVA0108
  300 YNOW(K)=DPNVF(YNOW(K),DNOW(K))                                    HOVA0109
      DO310K=1,N                                                        HOVA0110
  310 DNOW(K)=DPNVF(DNOW(K),DDNOW(K))                                   HOVA0111
      GO TO 320                                                         HOVA0112
  230 CONTINUE                                                          HOVA0113
      DO330I=1,N                                                        HOVA0114
      DO340J=1,N                                                        HOVA0115
      YNOW(J)=0.                                                        HOVA0116
  340 DNOW(J)=0.                                                        HOVA0117
      YNOW(I)=1.                                                        HOVA0118
      CALLDE1(TAU,T,XINT,MP,YNOW,DNOW,DYDBET,N,I)                       HOVA0119
  330 CONTINUE                                                          HOVA0120
      DO350I=1,N                                                        HOVA0121
      DO360J=1,N                                                        HOVA0122
      YNOW(J)=0.                                                        HOVA0123
  360 DNOW(J)=0.                                                        HOVA0124
      DNOW(I)=1.                                                        HOVA0125
      CALLDE1(TAU,T,XINT,MP,YNOW,DNOW,DYDGAM,N,I)                       HOVA0126
  350 CONTINUE                                                          HOVA0127
      ITERM = ITERM + 1                                                 HOVA0128
      ERASE,XM,XL                                                       HOVA0129
      DO420I=1,M                                                        HOVA0130
      DO420J=I,M                                                        HOVA0131
      DO400K=1,N                                                        HOVA0132
      DO400KK=1,MP                                                      HOVA0133
  400 XM(I,J)=XM(I,J)+DYDAL(K,KK,I)*DYDAL(K,KK,J)                       HOVA0134
  420 XM(J,I)=XM(I,J)                                                   HOVA0135
      MPLUS=M+1                                                         HOVA0136
      MPLUSN=M+N                                                        HOVA0137
      DO430I=MPLUS,MPLUSN                                               HOVA0138
      II=I-M                                                            HOVA0139
      DO430J=I,MPLUSN                                                   HOVA0140
      JJ=J-M                                                            HOVA0141
      DO410K=1,N                                                        HOVA0142
      DO410KK=1,MP                                                      HOVA0143
  410 XM(I,J)=XM(I,J)+DYDBET(K,KK,II)*DYDBET(K,KK,JJ)                   HOVA0144
  430 XM(J,I)=XM(I,J)                                                   HOVA0145
      MPNP=MPLUSN+1                                                     HOVA0146
      MPLS2N=MPLUSN+N                                                   HOVA0147
      DO450I=MPNP,MPLS2N                                                HOVA0148
      II=I-MPLUSN                                                       HOVA0149
      DO450J=I,MPLS2N                                                   HOVA0150
      JJ=J-MPLUSN                                                       HOVA0151
      DO 440 K = 1,N                                                    HOVA0152
      DO440KK=1,MP                                                      HOVA0153
  440 XM(I,J)=XM(I,J)+DYDGAM(K,KK,II)*DYDGAM(K,KK,JJ)                   HOVA0154
  450 XM(J,I)=XM(I,J)                                                   HOVA0155
      DO460J=MPLUS,MPLUSN                                               HOVA0156
      JJ=J-M                                                            HOVA0157
      DO460I=1,M                                                        HOVA0158
      DO 470 K = 1,N                                                    HOVA0159
      DO470KK=1,MP                                                      HOVA0160
  470 XM(I,J)=XM(I,J)+DYDAL(K,KK,I)*DYDBET(K,KK,JJ)                     HOVA0161
  460 XM(J,I)=XM(I,J)                                                   HOVA0162
      DO480J=MPNP,MPLS2N                                                HOVA0163
      JJ=J-MPLUSN                                                       HOVA0164
      DO480I=1,M                                                        HOVA0165
      DO490K=1,N                                                        HOVA0166
      DO490KK=1,MP                                                      HOVA0167
  490 XM(I,J)=XM(I,J)+DYDAL(K,KK,I)*DYDGAM(K,KK,JJ)                     HOVA0168
  480 XM(J,I)=XM(I,J)                                                   HOVA0169
      DO500I=MPLUS,MPLUSN                                               HOVA0170
      II=I-M                                                            HOVA0171
      DO500J=MPNP,MPLS2N                                                HOVA0172
      JJ=J-MPLUSN                                                       HOVA0173
      DO510K=1,N                                                        HOVA0174
      DO510KK=1,MP                                                      HOVA0175
  510 XM(I,J)=XM(I,J)+DYDBET(K,KK,II)*DYDGAM(K,KK,JJ)                   HOVA0176
  500 XM(J,I)=XM(I,J)                                                   HOVA0177
      MP2NP=MPLS2N+1                                                    HOVA0178
      DO520I=1,M                                                        HOVA0179
      DO520K=1,N                                                        HOVA0180
      DO520KK=1,MP                                                      HOVA0181
  520 XM(I,MP2NP)=XM(I,MP2NP)+DYDAL(K,KK,I)                             HOVA0182
     1*(YACT(K,KK)-Y(K,KK))                                             HOVA0183
      DO530I=MPLUS,MPLUSN                                               HOVA0184
      II=I-M                                                            HOVA0185
      DO530K=1,N                                                        HOVA0186
      DO530KK=1,MP                                                      HOVA0187
  530 XM(I,MP2NP)=XM(I,MP2NP)+DYDBET(K,KK,II)                           HOVA0188
     1*(YACT(K,KK)-Y(K,KK))                                             HOVA0189
      DO540I=MPNP,MPLS2N                                                HOVA0190
      II=I-MPLUSN                                                       HOVA0191
      DO540K=1,N                                                        HOVA0192
      DO540KK=1,MP                                                      HOVA0193
  540 XM(I,MP2NP)=XM(I,MP2NP)+DYDGAM(K,KK,II)                           HOVA0194
     1*(YACT(K,KK)-Y(K,KK))                                             HOVA0195
      CALLDPINV(XM,XL,MPLS2N,MP2NP,49,DEL)                              HOVA0196
      PRINT3,ITERM                                                      HOVA0197
      DO550I=1,M                                                        HOVA0198
      ALPHA(I)=ALPHA(I)+XM(I,MP2NP)                                     HOVA0199
  550 PRINT4,ALPHA(I),XM(I,MP2NP)                                       HOVA0200
      PRINT5                                                            HOVA0201
      DO560I=MPLUS,MPLUSN                                               HOVA0202
      II=I-M                                                            HOVA0203
      BETA(II)=BETA(II)+XM(I,MP2NP)                                     HOVA0204
  560 PRINT4,BETA(II),XM(I,MP2NP)                                       HOVA0205
      PRINT6                                                            HOVA0206
      DO130I=MPNP,MPLS2N                                                HOVA0207
      II=I-MPLUSN                                                       HOVA0208
      GAMMA(II)=GAMMA(II)+XM(I,MP2NP)                                   HOVA0209
  130 PRINT4,GAMMA(II),XM(I,MP2NP)                                      HOVA0210
      GO TO 730                                                         HOVA0211
  710 DO600I=1,N                                                        HOVA0212
      PRINT7,I                                                          HOVA0213
      ERMS=0.                                                           HOVA0214
      DO610J=1,MP                                                       HOVA0215
      DEV=Y(I,J)-YACT(I,J)                                              HOVA0216
      PCT=DEV/YACT(I,J)*100.                                            HOVA0217
      ERMS=ERMS+DEV*DEV                                                 HOVA0218
      DEL(J) = YACT(I,J)                                                HOVA0219
      CRV(J) = Y(I,J)                                                   HOVA0220
  610 PRINT 4, T(J),YACT(I,J),Y(I,J),DEV,PCT                            HOVA0221
      CALL GRAPH (T,DEL,MP,6H   T  ,6H   Y  ,TITLE,6H     X)            HOVA0222
      CALL ADPLOT(T,CRV,MP,6H     O)                                    HOVA0223
      ERMS=SQRTF(ERMS/FLOATF(MP))                                       HOVA0224
  600 PRINT8,ERMS                                                       HOVA0225
      GO TO 700                                                         HOVA0226
      END                                                               HOVA0227
       FOR                                                              HOVA0228
      SUBROUTINE DE1 (TAU,T,XINT,MP,YNOW,DNOW,DYDX,N,I)                 HOVA0229
      DIMENSIONT(25),YNOW(4),DNOW(4),DYDX(4,25,4),TERM1(4),             HOVA0230
     1TERM2(4),DPDY(4,4),DPDYP(4,4),DDNOW(4)                            HOVA0231
      TNOW=TAU                                                          HOVA0232
      J=1                                                               HOVA0233
      H=(T(1)-TAU)/XINT                                                 HOVA0234
      SENSELIGHT1                                                       HOVA0235
   80 CALLDPHIDY(TNOW,YNOW,DNOW,DPDY)                                   HOVA0236
      CALLDPHDYP(TNOW,YNOW,DNOW,DPDYP)                                  HOVA0237
      CALLAXMPY(DPDY ,N,N,YNOW,N,TERM1,N)                               HOVA0238
      CALLAXMPY(DPDYP,N,N,DNOW,N,TERM2,N)                               HOVA0239
      DO10K=1,N                                                         HOVA0240
   10 DDNOW(K)=TERM1(K)+TERM2(K)                                        HOVA0241
      IF (ABSF(TNOW-T(J))-.5*ABSF(H)) 20,20,30                          HOVA0242
   20 DO90K=1,N                                                         HOVA0243
   90 DYDX(K,J,I)=YNOW(K)                                               HOVA0244
      IF(J-MP)40,50,50                                                  HOVA0245
   50 RETURN                                                            HOVA0246
   40 J=J+1                                                             HOVA0247
      H=(T(J)-T(J-1))/XINT                                              HOVA0248
   30 TNOW=INDVF(TNOW,H)                                                HOVA0249
      DO60K=1,N                                                         HOVA0250
   60 YNOW(K)=DPNVF(YNOW(K),DNOW(K))                                    HOVA0251
      DO70K=1,N                                                         HOVA0252
   70 DNOW(K)=DPNVF(DNOW(K),DDNOW(K))                                   HOVA0253
      GOTO80                                                            HOVA0254
       END                                                              HOVA0256
       FOR                                                              HOVA0257
      SUBROUTINE AXMPY (A,NA,MA,X,NX,C,NC)                              HOVA0258
      DIMENSION A(4,4),X(4),C(4)                                        HOVA0259
      NC=NA                                                             HOVA0260
      KTOP=XMIN0F(NX,MA)                                                HOVA0261
      DO 1 I=1,NC                                                       HOVA0262
      C(I)=0.0                                                          HOVA0263
      DO 1 K=1,KTOP                                                     HOVA0264
    1 C(I)=C(I)+A(I,K)*X(K)                                             HOVA0265
      RETURN                                                            HOVA0266
       END                                                              HOVA0267
       FOR                                                              HOVA0268
      SUBROUTINE ERROUT (I)                                             HOVA0269
    1 FORMAT (9H ERROR   ,I3)                                           HOVA0270
    2 FORMAT (18H NORMAL COMPLETION)                                    HOVA0271
  100 IF (I-100) 102,108,112                                            HOVA0272
  102 WRITE OUTPUT TAPE 99,1,I                                          HOVA0273
  104 PRINT 1,I                                                         HOVA0274
  106 CALL END JOB                                                      HOVA0275
  108 WRITE OUTPUT TAPE 99,2                                            HOVA0276
  110 CALL END JOB                                                      HOVA0277
  112 WRITE OUTPUT TAPE 99,1,I                                          HOVA0278
  114 PRINT 1,I                                                         HOVA0279
  116 RETURN                                                            HOVA0280
      END                                                               HOVA0281
