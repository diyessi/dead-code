*     FAP                                                                       
       COUNT   100                                                              
       LBL     ASCN                                                     ASCN0000
*      SINGLE PRECISION ARCSINE AND ARCCOSINE                           ASCN0001
*              NORMALIZED ARGUMENT IN AC, ANSWER IS GIVEN IN AC         ASCN0002
*              CALLING SEQUENCE    TSX   $ASIN,4  OR  TSX   $ACOS,4     ASCN0003
*              IF MAGNITUDE OF ARG IS GREATER THAN 1, (EXEM) IS GIVEN   ASCN0004
       SPACE                                                            ASCN0005
       ENTRY   ACOS                                                     ASCN0006
       ENTRY   ASIN                                                     ASCN0007
       SPACE                                                            ASCN0008
 ACOS  STL     FLAG1         ARCCOS ENTRY.   SET FLAG                   ASCN0009
 ASIN  STO     SIGN          ARCSIN ENTRY    SAVE SIGN                  ASCN0010
       SXA     XR4,4                                                    ASCN0011
       SSP                                                              ASCN0012
       LDQ     ONE           IF MAGNITUDE GRT THAN 1, ERROR             ASCN0013
       TLQ     ERROR                                                    ASCN0014
       LDQ     HALF          IF MAGNITUDE GRT THAN 1/2, SKIP            ASCN0015
       TLQ     BIG                                                      ASCN0016
 SERIE STO     ARG           FOR /X/ SMALLER THAN 1/2,                  ASCN0017
       XCA                     COMPUTE ARCSIN(/X/) BY CHEBYSHEV         ASCN0018
       FMP     ARG               INTERPOLATION                          ASCN0019
       STO     SQ                                                       ASCN0020
       AXT     5,4                                                      ASCN0021
       ZAC                                                              ASCN0022
       FAD     COEF+5,4                                                 ASCN0023
       XCA                                                              ASCN0024
       FMP     SQ                                                       ASCN0025
       TIX     *-3,4,1                                                  ASCN0026
       XCA                   THIS PARTICULAR ORDER OF COMPUTATION HAS   ASCN0027
       FMP     ARG             A SUBSTANTIAL BEARING ON THE ACCURACY    ASCN0028
       FAD     ARG                                                      ASCN0029
       NZT     FLAG2         IF ORIG /X/ SMALLER THAN 1/2               ASCN0030
       TXI     *+3,4,-1        SET XR4=0, AND JUMP                      ASCN0031
       TZE     *+2           IF ORIG /X/ GREATER THAN 1/2               ASCN0032
       ADD     CH1             DOUBLE ARCSIN(SQRT((1-/X/)/2)), XR4=1    ASCN0033
       XEC     TEST+1,4                                                 ASCN0034
       TRA     *+3           IF ASIN AND BIG, OR IF ACOS AND SMALL,     ASCN0035
       CHS                     SUBTRACT THE WORK FROM PI/2              ASCN0036
       FAD     PIOV2                                                    ASCN0037
       LDQ     SIGN                                                     ASCN0038
       TQP     *+4           IF ORIGINAL ARG WAS +, ANSWER IS READY     ASCN0039
       CHS                   IF NEGATIVE AND ASIN, CHANGE SIGN OF ANS   ASCN0040
       ZET     FLAG1                                                    ASCN0041
       FAD     PI            IF NEGATIVE AND ACOS, SUBTRACT THE WORK    ASCN0042
       STZ     FLAG1           FROM PI                                  ASCN0043
       STZ     FLAG2                                                    ASCN0044
  XR4  AXT     **,4                                                     ASCN0045
       TRA     1,4                                                      ASCN0046
       SPACE                                                            ASCN0047
  BIG  SSM                   CASE WHEN /X/ IS GRT THAN 1/2              ASCN0048
       FAD     ONE                                                      ASCN0049
       TZE     *+2           OBTAIN MODIFIED ARGUMENT,                  ASCN0050
       SUB     CH1             SQRT((1-/X/)/2) AND MERGE MAIN           ASCN0051
       TSX     $SQRT,4           CIRCUIT TO COMPUTE ARCSINE             ASCN0052
       STL     FLAG2               OF THIS                              ASCN0053
       TRA     SERIE                                                    ASCN0054
       SPACE                                                            ASCN0055
 TEST  ZET     FLAG1                                                    ASCN0056
       NZT     FLAG1                                                    ASCN0057
       SPACE                                                            ASCN0058
 ERROR CLA     SIGN                                                     ASCN0059
       LDI     *+2                                                      ASCN0060
       TRA*    $(EXE)                                                   ASCN0061
       PZE     1,6,ERROR     CANT GET OUT OF THIS ERROR                 ASCN0062
       SPACE                                                            ASCN0063
 FLAG1 PZE                                                              ASCN0064
 FLAG2 PZE                                                              ASCN0065
 SIGN  BSS     1                                                        ASCN0066
  ARG  BSS     1                                                        ASCN0067
  SQ   BSS     1                                                        ASCN0068
 HALF  OCT     200400000000                                             ASCN0069
  CH1  OCT     1000000000                                               ASCN0070
 PIOV2 OCT     201622077325                                             ASCN0071
  PI   OCT     202622077325                                             ASCN0072
 COEF  OCT     174533367164    0.0424173419                             ASCN0073
       OCT     173611074307    0.0239940153                             ASCN0074
       OCT     174564717277    0.0455206330                             ASCN0075
       OCT     175462767135    0.0749469671                             ASCN0076
       OCT     176525253701    0.166667820                              ASCN0077
  ONE  OCT     201400000000                                             ASCN0078
       END                                                              ASCN0079
