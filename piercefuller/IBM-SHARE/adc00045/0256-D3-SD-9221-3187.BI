 1400 FORMAT (1H0//35H  INPUT ERROR.  TIME LIMIT NOT SET.)                      
 1500 FORMAT (1H0//72H  INPUT ERROR. NEGATIVE CONCENTRATION IN INITIAL D        
     1ISTRIBUTION SPECIFIED.)                                                   
 1600 FORMAT (1H0//54H  INPUT ERROR.  MORE THAN FIVE TELESCOPINGS SPECIF        
     1IED.)                                                                     
 1700 FORMAT (1H0//51H  INPUT ERROR.  GRID SPACING AFTER LAST TELESCOPIN        
     1G/15X,36H DOES NOT CONFORM WITH REQUIREMENTS.)                            
      END                                                                       
*     LABEL                                                                     
CVARI                                                                           
      SUBROUTINE VARI                                                           
C     FOR NONUNIFORM INITIAL DISTRIBUTION                                       
C     READS IN INITIAL CONCENTRATION PROFILE                                    
      COMMON NERR,QOLD,NGEOM,C,STEPL,CINIT,FBLOCK,R,RPRIME,FGEO,FF1,FF2,        
     1RPLUS,RMIN,STEPT,CFRONT,FLIN,NBOUND,CREAR,FLOUT,NREAR,NCGEO,NBLOCK        
     2,TIME,IEND,Q2                                                             
      DIMENSION C(641,2),R(641),RPLUS(639),RMIN(639)                            
      FREQUENCY 2(40),21(0,1,1)                                                 
    1 IEND = NBLOCK+1                                                           
      READ INPUT TAPE 5,10,(C(I,1),I=1,IEND)                                    
   10 FORMAT (11F7.5)                                                           
    2 DO 3 I=1,IEND                                                             
   21 IF (C(I,1)) 101,3,3                                                       
    3 CONTINUE                                                                  
      GO TO (5,4,4),NGEOM                                                       
    4 CALL GEO1                                                                 
    5 Q2 = AMOUNT(NBLOCK)                                                       
      CFRONT = C(1,1)                                                           
      CREAR = C(NBLOCK+1,1)                                                     
C     SENSE LIGHT SUPPRESS PRINTOUT OF TIME, TIME INCREMENT, RATE, AND          
C     FLOWS IN 'PRINT'                                                          
      SENSE LIGHT 1                                                             
      SENSE LIGHT 2                                                             
C     'PRINT' PRINTS OUT INITIAL CONCENTRATION PROFILE                          
      CALL PRINT                                                                
    6 RETURN                                                                    
C     ERROR IF NEGATIVE CONCENTRATION IN INPUT                                  
  101 NERR = 1                                                                  
      GO TO 6                                                                   
      END                                                                       
*     LABEL                                                                     
CLIST                                                                           
      SUBROUTINE LIST                                                           
C     FOR DETAILED TEXT DESCRIBING SYSTEM                                       
      COMMON NERR,QOLD,NGEOM,C,STEPL,CINIT,FBLOCK,R,RPRIME,FGEO,FF1,FF2,        
     1RPLUS,RMIN,STEPT,CFRONT,FLIN,NBOUND,CREAR,FLOUT,NREAR,NCGEO,NBLOCK        
     2,TIME,IEND,Q2,RATE,FACTOR,NAPPR,NGRAD,A,B,Q1,WFRONT,WREAR,XFREE,          
     3YFREE,JFREE,NTELE,NDIFF,NINIT,NAP,DIFM,TTOL,PTOL,Q                        
     4,NDCT,NDX,STP                                                             
      DIMENSION C(641,2),R(641),RPLUS(639),RMIN(639),Q(5)                       
      FREQUENCY 44(0,5,1),47(0,5,1),511(0,1,1),53(0,1,0),55(0,1,0),561(0LIST    
     1,1,0),71(5,1)                                                             
   11 GO TO (12,13,14,15,16,17),NCGEO                                           
   12 WRITE OUTPUT TAPE 6,120                                                   
      GO TO 21                                                                  
   13 WRITE OUTPUT TAPE 6,130                                                   
      GO TO 21                                                                  
   14 WRITE OUTPUT TAPE 6,140                                                   
      GO TO 21                                                                  
   15 WRITE OUTPUT TAPE 6,150,RPRIME                                            
      GO TO 21                                                                  
   16 WRITE OUTPUT TAPE 6,160                                                   
      GO TO 21                                                                  
   17 WRITE OUTPUT TAPE 6,170,RPRIME                                            
   21 WRITE OUTPUT TAPE 6,210                                                   
      GO TO (22,23,24),NBOUND                                                   
   22 WRITE OUTPUT TAPE 6,220,CFRONT                                            
      GO TO 31                                                                  
   23 WRITE OUTPUT TAPE 6,230,WFRONT                                            
      GO TO 31                                                                  
   24 WRITE OUTPUT TAPE 6,240                                                   
   31 GO TO (32,33,34,35),NREAR                                                 
   32 WRITE OUTPUT TAPE 6,320                                                   
      GO TO 41                                                                  
   33 WRITE OUTPUT TAPE 6,330,CREAR                                             
      GO TO 41                                                                  
   34 WRITE OUTPUT TAPE 6,340,WREAR                                             
      GO TO 41                                                                  
   35 WRITE OUTPUT TAPE 6,350                                                   
   41 WRITE OUTPUT TAPE 6,410,DIFM,A,B                                          
      GO TO (42,43),NDCT                                                        
   42 WRITE OUTPUT TAPE 6,420                                                   
      GO TO 44                                                                  
   43 WRITE OUTPUT TAPE 6,430                                                   
   44 IF (NDX) 7777,45,46                                                       
   45 WRITE OUTPUT TAPE 6,450                                                   
      GO TO 47                                                                  
   46 WRITE OUTPUT TAPE 6,460                                                   
   47 IF (NGRAD) 7777,48,49                                                     
   48 WRITE OUTPUT TAPE 6,480                                                   
      GO TO 51                                                                  
   49 WRITE OUTPUT TAPE 6,490                                                   
   51 WRITE OUTPUT TAPE 6,510,STEPL                                             
  511 IF (NAPPR) 7777,53,52                                                     
   52 WRITE OUTPUT TAPE 6,520,STP                                               
      GO TO 55                                                                  
   53 IF (NAP) 7777,55,54                                                       
   54 WRITE OUTPUT TAPE 6,540                                                   
   55 IF (NTELE) 7777,56,58                                                     
   56 WRITE OUTPUT TAPE 6,560                                                   
  561 IF (NTE) 7777,61,57                                                       
   57 WRITE OUTPUT TAPE 6,570                                                   
      GO TO 61                                                                  
   58 WRITE OUTPUT TAPE 6,580,Q(1)                                              
      IF (NTELE-1) 7777,61,59                                                   
   59 DO 60 I=2,NTELE                                                           
   60 WRITE OUTPUT TAPE 6,600,Q(I)                                              
   61 WRITE OUTPUT TAPE 6,610,PTOL,TTOL,TIME                                    
   71 GO TO (72,73),NINIT                                                       
   72 WRITE OUTPUT TAPE 6,720,CINIT,CFRONT,CREAR                                
      GO TO 81                                                                  
   73 WRITE OUTPUT TAPE 6,730                                                   
C     'VARI' READS IN INITIAL CONCENTRATION PROFILE (ONLY IF NONUNIFORM)        
      CALL VARI                                                                 
   81 RETURN                                                                    
  120 FORMAT (1H0//9X,12H FINITE SLAB)                                          
  130 FORMAT (1H0//9X, 9H MEMBRANE)                                             
  140 FORMAT (1H0//9X,15H SOLID CYLINDER)                                       
  150 FORMAT (1H0//9X,16H HOLLOW CYLINDER/14X,17H INTERNAL RADIUS F13.8)        
  160 FORMAT (1H0//9X,13H SOLID SPHERE)                                         
  170 FORMAT (1H0//9X,14H HOLLOW SPHERE/14X,17H INTERNAL RADIUS F13.8)          
  210 FORMAT (29H0         BOUNDARY CONDITIONS)                                 
  220 FORMAT (14X,28H FRONT BOUNDARY     CONSTANT/33X,16H CONCENTRATION         
     1 F14.8)                                                                   
  230 FORMAT (14X,43H FRONT BOUNDARY     VARIABLE, CLOSED SYSTEM/33X,14H        
     1 VOLUME RATIO F15.7)                                                      
  240 FORMAT (14X,41H FRONT BOUNDARY     VARIABLE, OPEN SYSTEM)                 
  320 FORMAT (14X,27H REAR BOUNDARY      NO FLOW)                               
  330 FORMAT (14X,28H REAR BOUNDARY      CONSTANT/33X,16H CONCENTRATION         
     1 F14.8)                                                                   
  340 FORMAT (14X,43H REAR BOUNDARY      VARIABLE, CLOSED SYSTEM/33X,14H        
     1 VOLUME RATIO F15.7)                                                      
  350 FORMAT (14X,41H REAR BOUNDARY      VARIABLE, OPEN SYSTEM)                 
  410 FORMAT (31H0         DIFFUSION COEFFICIENT/14X,24H MAXIMUM VALUE          
     1        F12.7/14X,24H PARAMETER VALUES     A F12.7/35X,3H B F12.7)        
  420 FORMAT (14X,42H MONOTONICAL FUNCTION OF CONCENTRATION AND/27X,29H         
     1DOES NOT INCREASE WITH TIME.)                                             
  430 FORMAT (14X,42H NOT MONOTONICAL FUNCTION OF CONCENTRATION/32X,24H         
     1OR INCREASES WITH TIME.)                                                  
  450 FORMAT (14X,33H INDEPENDENT OF SPACE COORDINATE.)                         
  460 FORMAT (14X,29H DEPENDS ON SPACE COORDINATE.)                             
  480 FORMAT (14X,39H INDEPENDENT OF CONCENTRATION GRADIENT.)                   
  490 FORMAT (14X,35H DEPENDS ON CONCENTRATION GRADIENT.)                       
  510 FORMAT (23H0         GRID SPACING ,18X, F10.8)                            
  520 FORMAT (14X,27H INITIAL GRID SPACING      F10.8)                          
  540 FORMAT (17X,32H (SUBROUTINE APP CANNOT BE USED))                          
  560 FORMAT (14X,16H NO TELESCOPING.)                                          
  570 FORMAT (17X,30H (SYSTEM CANNOT BE TELESCOPED))                            
  580 FORMAT (14X,16H TELESCOPING AT ,7X, F13.7)                                
  600 FORMAT (38X,F12.7)                                                        
  610 FORMAT (27H0         PRINTOUT SPACING ,11X, F12.7//9X,12H TIME LIM        
     1IT ,17X, F12.7//9X,19H TIME SET AT START ,10X, F12.7//9X,18H INITI        
     2AL CONDITION)                                                             
  720 FORMAT (14X,35H UNIFORM DISTRIBUTION              F12.7/14X,35H FR        
     1ONT-BOUNDARY CONCENTRATION      F12.7/14X,35H REAR-BOUNDARY CONCEN        
     2TRATION       F12.7)                                                      
  730 FORMAT (14X,24H NONUNIFORM DISTRIBUTION)                                  
 7777 CALL DUMP                                                                 
      END                                                                       
*     LABEL                                                                     
CAPP                                                                            
      SUBROUTINE APP                                                            
C     SMOOTHES OUT INITIAL SINGULARITY AT FRONT BOUNDARY (OPTIONAL)             
      COMMON NERR,QOLD,NGEOM,C,STEPL,CINIT,FBLOCK,R,RPRIME,FGEO,FF1,FF2,        
     1RPLUS,RMIN,STEPT,CFRONT,FLIN,NBOUND,CREAR,FLOUT,NREAR,NCGEO,NBLOCK        
     2,TIME,IEND,Q2,RATE,FACTOR,NAPPR,NGRAD,A,B,Q1,WFRONT,WREAR,XFREE,          
     3YFREE,JFREE,NTELE,NDIFF,NINIT,NAP,DIFM,TTOL,PTOL                          
      DIMENSION C(641,2),R(641),RPLUS(639),RMIN(639)                            
      FREQUENCY 501(4),5021(40),5036(0,1,0),521(4),523(30),5262(0,1,0),         
     15232(15),5233(5,1,5),524(0,1),530(15),5302(0,1,10),5413(0,1),5511         
     2(10,1,0),6011(20),6022(20)                                                
C     CALCULATION OF INITIAL GRID SPACING AND TIME INCREMENT AND                
C     SET UP INITIAL CONDITION                                                  
  501 DO 502 I=1,NAPPR                                                          
  502 STEPL = 0.5*STEPL                                                         
 5021 DO 503 I=1,NBLOCK                                                         
  503 C(I+1,1) = CINIT                                                          
      Q1 = CINIT                                                                
      QOLD = CINIT                                                              
      MBLOCK = NBLOCK                                                           
      STEPT = FACTOR*STEPL*STEPL                                                
C     ASSIGNMENT OF BRANCHES                                                    
 5036 IF (NGRAD) 505,505,504                                                    
  504 ASSIGN 526 TO NGRAD1                                                      
      GO TO 506                                                                 
  505 ASSIGN 525 TO NGRAD1                                                      
  506 GO TO (507,508,508),NGEOM                                                 
  507 ASSIGN 523 TO NGEO1                                                       
      ASSIGN 5272 TO NGEO2                                                      
      GO TO 511                                                                 
  508 ASSIGN 522 TO NGEO1                                                       
      ASSIGN 527 TO NGEO2                                                       
  511 GO TO (512,513,513),NBOUND                                                
  512 ASSIGN 541 TO NBOUN1                                                      
      GO TO 521                                                                 
  513 ASSIGN 532 TO NBOUN1                                                      
C     N-LOOP FOR NUMBER OF TELESCOPINGS IN APP                                  
  521 DO 604 N=1,NAPPR                                                          
      GO TO NGEO1,(522,523)                                                     
  522 CALL GEO1                                                                 
C     M-LOOP FOR NUMBER OF CONCENTRATION ROWS BETWEEN TELESCOPINGS              
  523 DO 561 M=2,MBLOCK                                                         
 5231 DMIN = DIF(0.5*(C(2,1)+C(1,1)),TIME,GRADC(1),A,A,B)                       
C     I-LOOP FOR NUMBER OF CONCENTRATION VALUES IN ROW                          
 5232 DO 528 I=2,NBLOCK                                                         
C     TIME SAVER TEST                                                           
 5233 IF (C(I-1,1)-CINIT) 524,529,524                                           
  524 GO TO NGRAD1,(525,526)                                                    
  525 GPLUS = GRADC(I)                                                          
  526 DPLUS = DIF(0.5*(C(I+1,1)+C(I,1)),TIME,GPLUS,A,A,B)                       
      DPL = DPLUS                                                               
 5262 IF (NERR) 7777,5263,606                                                   
 5263 GO TO NGEO2,(527,5272)                                                    
  527 DPLUS = DPLUS*RPLUS(I-1)                                                  
      DMIN = DMIN*RMIN(I-1)                                                     
C     CALCULATION OF CONCENTRATIONS                                             
 5272 CALL DIFEQ(I,FACTOR,DPLUS,DMIN,C)                                         
  528 DMIN = DPL                                                                
      IEND = NBLOCK+1                                                           
      GO TO 530                                                                 
  529 IEND = I                                                                  
  530 DO 531 I=3,IEND                                                           
      C(I-1,1) = C(I-1,2)                                                       
 5302 IF (C(I-1,1)) 801,531,531                                                 
  531 CONTINUE                                                                  
      TIME = TIME + STEPT                                                       
      GO TO NBOUN1,(532,541)                                                    
C     CALCULATION OF FRONT-BOUNDARY CONCENTRATION                               
  532 C(1,1) = BOUND(WFRONT)                                                    
C     SENSE LIGHT IS PICKED UP BY FUNCTION AMOUNT, SIGNIFIES CALL               
C     FROM APP                                                                  
  541 SENSE LIGHT 3                                                             
      Q2 = AMOUNT(NBLOCK)                                                       
C     CALCULATION OF IN- OR OUTFLOW                                             
      RATE = (Q2-Q1)/STEPT                                                      
 5413 IF QUOTIENT OVERFLOW 802,542                                              
  542 FLIN = RATE                                                               
C     TEST FOR PRINTOUT                                                         
  551 NPRIN = NPRINT(PTOL,Q2,TIME)                                              
 5511 GO TO (561,552,803),NPRIN                                                 
  552 CALL PRINT                                                                
 5521 IF (NERR) 7777,561,606                                                    
  561 Q1 = Q2                                                                   
C     TELESCOPING AND RESETTING OF MBLOCK                                       
  601 IHALF = (IEND-2)/2                                                        
 6011 DO 602 I=1,IHALF                                                          
  602 C(I+1,1) = C(2*I+1,1)                                                     
      IHALF = IHALF + 3                                                         
 6022 DO 603 I=IHALF,IEND                                                       
  603 C(I-1,1) = CINIT                                                          
      STEPL = 2.0*STEPL                                                         
      STEPT = 4.0*STEPT                                                         
C     SENSE LIGHT 4 TRIGGERS RECALCULATION OF SPACE-COORDINATE VALUES           
C     IN 'PRINT' AFTER TELESCOPING                                              
      SENSE LIGHT 4                                                             
  604 MBLOCK = NBLOCK - IHALF + 3                                               
  606 RETURN                                                                    
  801 NERR = 6                                                                  
      GO TO 606                                                                 
  802 NERR = 4                                                                  
      GO TO 606                                                                 
  803 NERR = 10                                                                 
      GO TO 606                                                                 
C     'CALL DUMP' CAN ONLY BE REACHED BY BINARY PATCHING                        
 7777 CALL DUMP                                                                 
      END                                                                       
*     LABEL                                                                     
CGEO1                                                                           
      SUBROUTINE GEO 1                                                          
C     CALCULATES GEOMETRICAL FACTORS FOR CYLINDERS AND SPHERES                  
      COMMON NERR,QOLD,NGEOM,C,STEPL,CINIT,FBLOCK,R,RPRIME,FGEO,FF1,FF2,        
     1RPLUS,RMIN,STEPT,CFRONT,FLIN,NBOUND,CREAR,FLOUT,NREAR,NCGEO,NBLOCK        
      DIMENSION C(641,2),R(641),RPLUS(639),RMIN(639)                            
      FREQUENCY 2(40),4(40)                                                     
    1 A1 = 1.0/(1.0-RPRIME)                                                     
      A3 = (2.0-RPRIME)*A1                                                      
      M = NGEOM - 1                                                             
      A2 = A3 - STEPL                                                           
      DENOM = A2 - STEPL                                                        
C     'RPLUS' AND 'RMIN' ARE MODIFICATION FACTORS IN FINITE-DIFFERENCE          
C     EQUATION                                                                  
    2 DO 3 I=2,NBLOCK                                                           
      RMIN(I-1) = (A2/DENOM)**M                                                 
      A2 = A2 - 2.0*STEPL                                                       
      RPLUS(I-1) = (A2/DENOM)**M                                                
    3 DENOM = DENOM - 2.0*STEPL                                                 
      IEND = NBLOCK + 1                                                         
C     R-FACTORS ARE WEIGHT FACTORS FOR CONCENTRATIONS IN CALCULATION            
C     OF TOTAL AMOUNT IN MEDIUM BY 'AMOUNT'                                     
    4 DO 5 I=1,IEND                                                             
      R(I) = A1**M                                                              
    5 A1 = A1 - STEPL                                                           
    6 A1 = 1.0 - RPRIME                                                         
      A2 = 1.0/(1.0-RPRIME**NGEOM)                                              
      A3 = 0.5*STEPL*A1                                                         
      A4 = NGEOM                                                                
      A5 = A1*A2*A4                                                             
C     'FF1' AND 'FF2' ARE MODIFICATION FACTORS FOR FLOWS ACROSS FRONT           
C     AND REAR BOUNDARIES (FOR HOLLOW CYLINDER AND HOLLOW SPHERE ONLY)          
      FF1 = A5*(1.0-A3)**M                                                      
      FF2 = A5*(RPRIME+A3)**M                                                   
C     'FGEO' IS FACTOR IN CALCULATION OF TOTAL AMOUNT IN MEDIUM                 
      FGEO = A1*A2**NGEOM                                                       
      GO TO (7,8),M                                                             
    7 FGEO = 0.66666667*FGEO                                                    
    8 RETURN                                                                    
      END                                                                       
*     LABEL                                                                     
CSPACE                                                                          
      SUBROUTINE SPACE                                                          
C     CALCULATES SPACE-COORDINATE VALUES FOR USE IN FINITE-DIFFERENCE           
C     EQUATION (ONLY FOR SPACE-DEPENDENT DIFFUSION COEFFICIENT)                 
      COMMON NERR,QOLD,NGEOM,C,STEPL,CINIT,FBLOCK,R,RPRIME,FGEO,FF1,FF2,        
     1RPLUS,RMIN,STEPT,CFRONT,FLIN,NBOUND,CREAR,FLOUT,NREAR,NCGEO,NBLOCK        
     2,TIME,IEND,Q2,RATE,FACTOR,NAPPR,NGRAD,A,B,Q1,WFRONT,WREAR,XFREE,          
     3YFREE,JFREE,NTELE,NDIFF,NINIT,NAP,DIFM,TTOL,PTOL,Q                        
     4,NDCT,NDX,STP,XVALUE                                                      
      DIMENSION C(641,2),R(641),RPLUS(639),RMIN(639),Q(5),XVALUE(640)           
      IF (NGEOM-1) 1,1,2                                                        
C     BRANCH FOR SLAB AND MEMBRANE                                              
    1 XVALUE(1) = 0.5*STEPL                                                     
      X = STEPL                                                                 
      GO TO 3                                                                   
C     BRANCH FOR CYLINDER AND SPHERE                                            
    2 XVALUE(1) = 1.0 - 0.5*STEPL                                               
      X = -STEPL                                                                
    3 DO 4 I=2,NBLOCK                                                           
    4 XVALUE(I) = XVALUE(I-1) + X                                               
      RETURN                                                                    
      END                                                                       
*     LABEL                                                                     
CGRADC                                                                          
      FUNCTION GRADC(I)                                                         
C     CALCULATES CONCENTRATION GRADIENT (ONLY FOR GRADIENT-DEPENDENT            
C     DIFFUSION COEFFICIENT OR SYSTEMS WITH FLOW ACROSS BOTH BOUNDARIES)        
      COMMON NERR,QOLD,NGEOM,C,STEPL                                            
      DIMENSION C(641,2)                                                        
      GRADC = (C(I+1,1)-C(I,1))/STEPL                                           
      RETURN                                                                    
      END                                                                       
*     LABEL                                                                     
CDIF                                                                            
      FUNCTION DIF(C,TIME,GRADC,SPACE,A,B)                                      
C     DIFFUSION COEFFICIENT                                                     
C     FOR ION-EXCHANGE TYPE CONCENTRATION DEPENDENCE                            
      COMMON NERR                                                               
      FREQUENCY 1(0,0,1)                                                        
      DIF = (1.0 + B*C)/(1.0 + A*C)                                             
    1 IF (DIF) 2,2,3                                                            
C     ERROR FOR NEGATIVE OR ZERO VALUE OF DIFFUSION COEFFICIENT                 
    2 NERR = 12                                                                 
    3 RETURN                                                                    
      END                                                                       
*     LABEL                                                                     
CDIF                                                                            
      FUNCTION DIF(C,TIME,GRADC,SPACE,A,B)                                      
C     DIFFUSION COEFFICIENT                                                     
C     FOR EXPONENTIAL CONCENTRATION DEPENDENCE                                  
      DIF = EXPF(B + A*C)                                                       
      RETURN                                                                    
      END                                                                       
*     LABEL                                                                     
CDIFEQ                                                                          
      SUBROUTINE DIFEQ(I,FACTOR,DPLUS,DMIN,C)                                   
      DIMENSION C(641,2)                                                        
      C(I,2) = C(I,1) + FACTOR*(DPLUS*(C(I+1,1)-C(I,1))-DMIN*(C(I,1)-           
     1C(I-1,1)))                                                                
      RETURN                                                                    
      END                                                                       
*     LABEL                                                                     
CBOUND                                                                          
      FUNCTION BOUND(WFRONT)                                                    
C     CALCULATES FRONT-BOUNDARY CONCENTRATION                                   
C     FOR CLOSED SYSTEM                                                         
      COMMON NERR,QOLD,NGEOM,C,STEPL,CINIT,FBLOCK,R,RPRIME,FGEO,FF1,FF2,        
     1RPLUS,RMIN,STEPT,CFRONT,FLIN,NBOUND                                       
      DIMENSION C(641,2),R(641),RPLUS(639),RMIN(639)                            
      FREQUENCY 1(0,1,0),21(0,1,10)                                             
    1 IF (NBOUND-2) 2,2,101                                                     
    2 BOUND = C(1,1) - WFRONT*STEPT*FLIN                                        
   21 IF (BOUND) 102,3,3                                                        
    3 RETURN                                                                    
  101 NERR = 1                                                                  
      GO TO 3                                                                   
C     ERROR IF BOUNDARY CONCENTRATION IS NEGATIVE                               
  102 NERR = 9                                                                  
      GO TO 3                                                                   
      END                                                                       
*     LABEL                                                                     
CRBOUND                                                                         
      FUNCTION RBOUND(WREAR)                                                    
C     CALCULATES REAR-BOUNDARY CONCENTRATION                                    
C     FOR CLOSED SYSTEM                                                         
      COMMON NERR,QOLD,NGEOM,C,STEPL,CINIT,FBLOCK,R,RPRIME,FGEO,FF1,FF2,        
     1RPLUS,RMIN,STEPT,CFRONT,FLIN,NBOUND,CREAR,FLOUT,NREAR,NCGEO,NBLOCK        
      DIMENSION C(641,2),R(641),RPLUS(639),RMIN(639)                            
      FREQUENCY 1(0,1,0),21(0,1,10)                                             
    1 IF (NREAR-3) 2,2,101                                                      
    2 RBOUND = C(NBLOCK+1,1) - WREAR*STEPT*FLOUT                                
   21 IF (RBOUND) 102,3,3                                                       
    3 RETURN                                                                    
  101 NERR = 2                                                                  
      GO TO 3                                                                   
C     ERROR IF BOUNDARY CONCENTRATION IS NEGATIVE                               
  102 NERR = 11                                                                 
      GO TO 3                                                                   
      END                                                                       
*     LABEL                                                                     
CNPRINT                                                                         
      FUNCTION NPRINT(PTOL,Q2,TIME)                                             
C     TRIGGERS PRINTOUT WHEN AMOUNT HAS DECREASED OR INCREASED BY PTOL          
C     SINCE PREVIOUS PRINTOUT (FOR FIRST PRINTOUT SINCE START)                  
      COMMON NERR,QOLD                                                          
      FREQUENCY 1(1,0,0),31(1,0,1)                                              
    1 IF (ABSF(QOLD-Q2)-PTOL)2,3,3                                              
    2 NPRINT = 1                                                                
C     NO PRINT                                                                  
      GO TO 6                                                                   
    3 NPRINT = 2                                                                
C     PRINT                                                                     
   31 IF (QOLD-Q2)4,11,5                                                        
    4 QOLD = QOLD + PTOL                                                        
      GO TO 6                                                                   
    5 QOLD = QOLD - PTOL                                                        
    6 RETURN                                                                    
C     ERROR IF AMOUNT IN MEDIUM HAS NOT CHANGED SINCE PREVIOUS PRINTOUT         
   11 NPRINT = 3                                                                
C     ERROR                                                                     
      GO TO 6                                                                   
      END                                                                       
*     LABEL                                                                     
CNEND                                                                           
      FUNCTION NEND(PTOL,Q2,CF,TIME)                                            
C     TERMINATES CALCULATION WHEN AMOUNT HAS APPROACHED FRONT-BOUNDARY          
C     CONCENTRATION TO WITHIN PTOL                                              
      FREQUENCY 1(0,0,1)                                                        
    1 IF (ABSF(Q2-CF)-PTOL) 2,3,3                                               
    2 NEND = 1                                                                  
C     END                                                                       
      GO TO 4                                                                   
    3 NEND = 2                                                                  
C     NO END                                                                    
    4 RETURN                                                                    
      END                                                                       
*     LABEL                                                                     
CNTEL                                                                           
      FUNCTION NTEL(O,Q1,Q2,TIME)                                               
C     TRIGGERS TELESCOPING WHEN AMOUNT HAS DECREASED BELOW OR INCREASED         
C     ABOVE Q(K) VALUES SPECIFIED BY INPUT                                      
      FREQUENCY 11(1,0,1),1(1,0,1),2(1,0,1)                                     
   11 IF (Q1-Q2) 1,5,2                                                          
    1 IF (O -  Q2) 3,3,4                                                        
    2 IF (O - Q2) 4,3,3                                                         
    3 NTEL = 1                                                                  
C     TELESCOPE                                                                 
      GO TO 6                                                                   
    4 NTEL = 2                                                                  
C     DON'T TELESCOPE                                                           
      GO TO 6                                                                   
C     ERROR IF AMOUNT IN MEDIUM DOES NOT CHANGE WITH TIME                       
    5 NTE = 3                                                                   
C     ERROR                                                                     
    6 RETURN                                                                    
      END                                                                       
