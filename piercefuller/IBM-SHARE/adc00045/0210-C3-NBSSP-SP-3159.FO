*     NBS   SP                                                          SP000000
      SUBROUTINE SP(P,C,B,RTR,RTI)                                      SP000001
      DIMENSION CVR(4),CVI(4) ,A( 8),H( 8)                              SP000002
      T=1.                                                              SP000003
      REAL1=1.                                                          SP000004
      AM1=0.                                                            SP000005
      RTR=1.                                                            SP000006
      RTI=0.                                                            SP000007
      CALL ZDIV(1.,0.,C,B,X,Y)                                          SP000008
      PP=4.*P*P                                                         SP000009
   20 PRELIM=(PP-(2.*T-1.)*(2.*T-1.))/(4.*T)                            SP000010
      U=PRELIM*X                                                        SP000011
      V=PRELIM*Y                                                        SP000012
      CALL ZMPY(REAL1,AM1,U,V,REAL2,AM2)                                SP000013
      IF((REAL2*REAL2+AM2*AM2)-(REAL1*REAL1+AM1*AM1))110,110,200        SP000014
  110 RTR=RTR+REAL2                                                     SP000015
      RTI=RTI+AM2                                                       SP000016
      CALL ZDIV(REAL2,AM2,RTR,RTI,QTR,QTI)                              SP000017
      REAL1=REAL2                                                       SP000018
      AM1=AM2                                                           SP000019
   10 T=T+1.                                                            SP000020
      IF((QTR*QTR+QTI*QTI)-1.E-16) 30, 30,20                            SP000021
  200 S=T-P-.5                                                          SP000022
      IF(S-25.)  201,201, 30                                            SP000023
  201 A(1)=1.7878605                                                    SP000024
      A(2)=3.5882389                                                    SP000025
      A(3)=5.9200900                                                    SP000026
      A(4)=8.8668464                                                    SP000027
      A(5)=1.2543589  E+1                                               SP000028
      A(6)=1.7140529  E+1                                               SP000029
      A(7)=2.3023343  E+1                                               SP000030
      A(8)=3.1129504    E+1                                             SP000031
      H(1)=4.7828652                                                    SP000032
      H(2)=3.3761327  E+1                                               SP000033
      H(3)=5.1231373  E+1                                               SP000034
      H(4)=2.5408127E+1                                                 SP000035
      H(5)=4.5375890                                                    SP000036
      H(6)=2.7433832  E-1                                               SP000037
      H(7)=4.3728310  E-3                                               SP000038
      H(8)=8.8275945  E-6                                               SP000039
      CVR(1)=0.                                                         SP000040
      CVI(1)=0.                                                         SP000041
      DO 205 I=1,8                                                      SP000042
      XS=A(I)**(S-5.)                                                   SP000043
      CALLZDIV(XS*C,XS*B,C+A(I),B,ADR,ADI)                              SP000044
      CVR(1)=CVR(1)+ADR*H(I)                                            SP000045
  205 CVI(1)=CVI(1)+ADI*H(I)                                            SP000046
      GA=GAMMA(S+1.)                                                    SP000047
      CVR(1)=CVR(1)/GA                                                  SP000048
      CVI(1)=CVI(1)/GA                                                  SP000049
      TERMR=   C*(P- .5)/(T+P- .5)                                      SP000050
      TERMI=   B*(P- .5)/(T+P- .5)                                      SP000051
      CALLZMPY(S+1.+C,B,CVR(1),CVI(1),CVR(2),CVI(2))                    SP000052
      CALLZDIV(CVR(2)-C,CVI(2)-B,C,B,CVR(2),CVI(2))                     SP000053
      CALL ZMPY(TERMR,TERMI,CVR(2),CVI(2),TR,TI)                        SP000054
      SUMR=CVR(1)-TR                                                    SP000055
      SUMI=CVI(1)-TI                                                    SP000056
  202 ADD=1.                                                            SP000057
      SIGN=-1.                                                          SP000058
      DO 211 N=2,3                                                      SP000059
      EN=N                                                              SP000060
      SIGN=-SIGN                                                        SP000061
      ZIP=(P-EN+.5) /(T+P-EN+.5)                                        SP000062
      CALLZMPY(   ZIP*C,   ZIP*B,TERMR,TERMI,TERMR,TERMI)               SP000063
      CALLZMPY(S+C+2.-EN,B,CVR(N),CVI(N),CVR(N+1),CVI(N+1))             SP000064
        CALLZDIV(CVR(N+1)+CVR(N-1)-ADD,CVI(N+1)+CVI(N-1),EN*C,EN*B ,    SP000065
     1 CVR(N+1),CVI(N+1))                                               SP000066
      CALLZMPY(TERMR,TERMI,CVR(N+1),CVI(N+1),TPR,TPI)                   SP000067
      IF(TPR*TPR+TPI*TPI-TR*TR-TI*TI) 206,212,212                       SP000068
  206 TR=TPR                                                            SP000069
      TI=TPI                                                            SP000070
      SUMR=SUMR+SIGN*TR                                                 SP000071
      SUMI=SUMI+SIGN*TI                                                 SP000072
  211 ADD=0.                                                            SP000073
  212 CALLZMPY(SUMR,SUMI,REAL2,AM2,REAL2,AM2)                           SP000074
      RTR=RTR+REAL2                                                     SP000075
      RTI=RTI+AM2                                                       SP000076
   30 RETURN                                                            SP000077
      END                                                               SP000078
