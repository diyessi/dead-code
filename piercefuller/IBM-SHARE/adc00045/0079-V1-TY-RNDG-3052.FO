*      FAP       RANDG       VERSION 3 (MARSAGLIA,S METH.)              RANDG000
       COUNT  74                                                        RANDG001
       ENTRY  RANDG          RANDG(Z)                                   RANDG002
 RANDG SXA    AXT,4          SAVE XR4.                                  RANDG003
       CLA*   1,4            AC=Z                                       RANDG004
       CAS    ZO             TEST WHETHER Z=ZO                          RANDG005
       TRA    NO             IF NOT, START NEW SEQUENCE.                RANDG006
 YES   TRA    ODD            IF Z=ZO, CONTINUE SEQUENCE (EVEN OR ODD).  RANDG007
 NO    STO    ZO             NEW SEQUENCE CONTINUES FROM ZO=Z.          RANDG008
       REM                   PRESERVE SIGN OF 0.0  .                    RANDG009
       UFA   =O200000000000  UNNORMALIZE Z TO RECONSTRUCT J.            RANDG010
       LBT                                                              RANDG011
       STZ    ZO             IF J IS EVEN SET SW=QUEER LATER.           RANDG012
       LDQ   =O100000000000  ENSURE LAST TWO BITS OF K ARE 01.          RANDG013
       LRS    27             MQ=FRACTIONAL PART (J) OF Z AND ITS SIGN   RANDG014
       ZAC                                                              RANDG015
       LGR    6              PUSH 01 TO BOTTOM OF K.                    RANDG016
       STQ    K                                                         RANDG017
       CLA    ZO             =0 IF J IS EVEN, =Z IF J IS ODD.           RANDG018
       TNZ    ODD            IF J IS ODD, GO TO ODD.                    RANDG019
       LDQ   =O5343277245    =INVERSE OF 565434455 MOD 10000000000      RANDG020
       TSX    RVRSE,4        REVERSE RANDR TO GET PREVIOUS ODD ZO.      RANDG021
       AXT    QUEER,4                                                   RANDG022
       SXA    SW,4           SET SW TO QUEER.                           RANDG023
 ODD   AXT    EVEN,4                                                    RANDG024
       SXA    YES,4          SET YES'SWITCH TO EVEN.                    RANDG025
 STOV  STO    V              =ODD RAND.NO. IN (-1.0, +1.0).             RANDG026
       TSX    RANDR,4                                                   RANDG027
       STO    ZO             =EVEN RAND. NO. IN (-1.0, +1.0).           RANDG028
       XCA                                                              RANDG029
       FMP    ZO                                                        RANDG030
       STO    R                                                         RANDG031
       LDQ    V                                                         RANDG032
       FMP    V                                                         RANDG033
       FAD    R                                                         RANDG034
       CAS    =O201400000000 COMPARE R WITH 1.0.                        RANDG035
       TRA     BIG                                                      RANDG036
       TRA     BIG                                                      RANDG037
       STO     R             =V*V+ZO*ZO.                                RANDG038
       TSX   $LOG,4          IF 0.0 L.T. R L.T. 1.0,  LOGF(R).          RANDG039
       ACL   =O001000000000  *2.                                        RANDG040
       FDH    R              /R.                                        RANDG041
       XCA                                                              RANDG042
       TSX   $SQRT,4         **1/2. (NOTE'USE MY SQRT F)                RANDG043
       STO    R              =-SQRTF(-2.*LOGF(V*V+ZO*ZO)/(V*V+ZO*ZO)).  RANDG044
       LDQ    ZO                                                        RANDG045
 SW    TRA    FMPR           (MAY BE QUEER)                             RANDG046
 QUEER AXT    FMPR,4                                                    RANDG047
       SXA    SW,4           RESTORE SW TO FMPR AS USUAL.               RANDG048
       TRA    EVEN                                                      RANDG049
 RANDR LDQ   =O565434455     (CF. RANDR(STARTR))                        RANDG050
 RVRSE MPY    K                                                         RANDG051
       STQ    K              =(...)*K, LAST 30 BITS ARE 4J+1.           RANDG052
       RQL    6              DELETE TOP 6 BITS, 7TH IS SIGN.            RANDG053
       CLA   =O200                                                      RANDG054
       LLS    27             FRACTION = J.                              RANDG055
       FAD    =O200000000000 NORMALIZE TO (-1.0,+1.0)                   RANDG056
       TRA    1,4                                                       RANDG057
 BIG   AXC    STOV-1,4                                                  RANDG058
       TRA    RANDR          TO SET V=NEW ODD RAND. NO. IN (-1.0,+1.0). RANDG059
 EVEN  AXT    ODD,4                                                     RANDG060
       SXA    YES,4          SET YES'SWITCH TO ODD.                     RANDG061
       TSX    RANDR,4                                                   RANDG062
       STO    ZO             =ODD RAND. NO. IN (-1.0,+1.0)              RANDG063
       LDQ    V                                                         RANDG064
 FMPR  FMP    R              RANDG=R*(V OR ZO ALTERNATELY).             RANDG065
 AXT   AXT    **,4           RESTORE XR4.                               RANDG066
       LDQ    ZO                                                        RANDG067
       STQ*   1,4            Z=ZO.                                      RANDG068
       TRA    2,4            RETURN.                                    RANDG069
 ZO    OCT    200400000001                                              RANDG070
 K     OCT    002000000005                                              RANDG071
 R     PZE    0                                                         RANDG072
 V     PZE     0             79 LOCATIONS             V.KAHAN  FEB./64  RANDG073
       END                                                              RANDG074
