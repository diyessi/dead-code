$EXECUTE       SORT                                                     LSOR0030
      FIL,INP/200,REE/1,MOD/B,DEN/L,BLO/520                             LSOR0040
      FIL,OUT,MOD/B,DEN/L,BLO/520                                       LSOR0050
      REC,TYP/F,LEN/13,FIE/(36B,108B)                                   LSOR0060
      SOR,FIL/200,SEQ/S,ORD/3,FIE/2                                     LSOR0070
      CHA,INP/UT3,MER/(A,B,UT)                                          LSOR0080
      OPT,CAR,TAP,NOC                                                   LSOR0090
