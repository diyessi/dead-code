      FIL,INP/200,REE/1,MOD/B,DEN/L,BLO/600                             MSOR0040
      FIL,OUT,MOD/B,DEN/L,BLO/600                                       MSOR0050
      REC,TYP/F,LEN/15,FIE/72B                                          MSOR0060
      SOR,FIL/200,SEQ/S,ORD/3,FIE/1                                     MSOR0070
      CHA,INP/UT3,MER/(A,B,UT)                                          MSOR0080
      OPT,CAR,TAP,NOC                                                   MSOR0090
      END                                                               MSOR0100
      LOAD SORT CONTROL CARDS                                                   
$ATTACH        RDA                                                      LSOR0010
