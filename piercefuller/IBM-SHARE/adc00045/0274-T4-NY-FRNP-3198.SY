          MEMBER DATA CARD SORT PREPARATION WITH SUBROUTINE WRITE               
CMDC      PREPARATION OF MEMBER DATA CARDS FOR SORTING                  MDCP0010
C         MEMBER DATA CARD SORT PREPARATION                             MDCP0020
C              THIS PROGRAM PRODUCES A BINARY TAPE OF THE MEMBER DATA   MDCP0030
C              CARDS. TO PREPARE THE FRAN MEMBER DATA CARD DECK, REMOVE MDCP0040
C              THE MEMBER HEADER CARD AND PLACE A BLANK CARD AFTER THE  MDCP0050
C              LAST DATA CARD.                                          MDCP0060
C                                                                       MDCP0070
      DIMENSION C(16),M(16),D(600)                                      MDCP0080
      COMMON C,M,C9,M9,D,A,B,LA,LB                                      MDCP0090
      EQUIVALENCE (C,M),(LA,A),(LB,B)                                   MDCP0100
      REWIND 4                                                          MDCP0110
B     A=644531636060                                                    MDCP0120
B     B=442544222551                                                    MDCP0130
   55 K=0                                                               MDCP0140
      DO 222 I=1,40                                                     MDCP0150
   22 READ INPUT TAPE 5,111,C(1),(M(J),J=2,3),C(4),(M(J),J=5,8),        MDCP0160
     *(C(J),J=9,16)                                                     MDCP0170
  111 FORMAT(A6,2I4,F6.0,I1,I2,I1,I2,4F6.0,2F5.0,2A6)                   MDCP0180
C                                                                       MDCP0190
C CHECKING UNIT CARDS                                                   MDCP0200
C                                                                       MDCP0210
      NR=M(1)-LA                                                        MDCP0220
C                                                                       MDCP0230
C CHECKING MEMBER CARDS                                                 MDCP0240
C                                                                       MDCP0250
      IF (NR) 11,22,11                                                  MDCP0260
   11 NR=M(1)-LB                                                        MDCP0270
      IF (NR) 66,33,66                                                  MDCP0280
   33 DO 44 J=1,15                                                      MDCP0290
      JK=J+K                                                            MDCP0300
      JI=J+1                                                            MDCP0310
   44 D(JK)=C(JI)                                                       MDCP0320
      K=K+15                                                            MDCP0330
  222 CONTINUE                                                          MDCP0340
      CALL WRITE(D,600)                                                 MDCP0350
      GO TO 55                                                          MDCP0360
   66 IF(K)77,77,77                                                     MDCP0370
   77 N=K+1                                                             MDCP0380
B     C9=377777777777                                                   MDCP0390
      DO 88 I=N,600                                                     MDCP0400
   88 D(I)=C9                                                           MDCP0410
      CALL WRITE(D,600)                                                 MDCP0420
   99 END FILE 4                                                        MDCP0430
      REWIND 4                                                          MDCP0440
      CALL EXIT                                                         MDCP0450
      END                                                               MDCP0460
       ENTRY   WRITE                                                    RITE0010
 WRITE SXA     EXIT,1                                                   RITE0020
       SXA     EXIT+1,2                                                 RITE0030
       CLA     1,4                                                      RITE0040
       ALS     18                                                       RITE0050
       SUB*    2,4                                                      RITE0060
       ARS     18                                                       RITE0070
       ADD     =1                                                       RITE0080
       STA     COMM                                                     RITE0090
       CLA*    2,4                                                      RITE0100
       STD     COMM                                                     RITE0110
       ARS     18                                                       RITE0120
       STA     TEMP                                                     RITE0130
       ADD     COMM                                                     RITE0140
       STA     A                                                        RITE0150
       CLA     TEMP                                                     RITE0160
       ARS     1                                                        RITE0170
       PAX     ,1                                                       RITE0180
       ADD     COMM                                                     RITE0190
       STA     B                                                        RITE0200
       AXT     1,2                                                      RITE0210
       CLA*    B                                                        RITE0220
       LDQ*    A                                                        RITE0230
       STQ*    B                                                        RITE0240
       STO*    A                                                        RITE0250
       TXI     *+1,2,1                                                  RITE0260
       TIX     *-5,1,1                                                  RITE0270
       AXT     10,1                                                     RITE0280
       WTBA    4                                                        RITE0290
       RCHA    COMM                                                     RITE0300
       TCOA    *                                                        RITE0310
       TRCA    *+2                                                      RITE0320
       TRA     EXIT                                                     RITE0330
       BSRA    4                                                        RITE0340
       TIX     *-6,1,1                                                  RITE0350
       HPR     1,5                                                      RITE0360
       WTBA    4                                                        RITE0370
       RCHA    COMM                                                     RITE0380
       TCOA    *                                                        RITE0390
 EXIT  AXT     **,1                                                     RITE0400
       AXT     **,2                                                     RITE0410
       TRA     3,4                                                      RITE0420
 COMM  IOCD    **,,**                                                   RITE0430
 A     PZE     **,1                                                     RITE0440
 B     PZE     **,2                                                     RITE0450
 TEMP  PZE                                                              RITE0460
       END                                                              RITE0470
          LOAD DATA CARD SORT PREPARATION WITH SUBROUTINE WRITE                 
CLDC      PREPARATION OF LOAD DATA CARDS FOR SORTING                    LDCP0010
C         LOAD DATA CARD SORT PREPARATION                               LDCP0020
C              THIS PROGRAM PRODUCES A BINARY TAPE OF THE LOAD DATA     LDCP0030
C              CARDS. TO PREPARE THE FRAN LOAD DATA CARD DECK, REPLACE  LDCP0040
C              THE LOAD HEADER CARD WITH THE ZONE CARD(SEE DOCUMENTA-   LDCP0050
C              TION) AND PLACE A BLANK CARD AFTER THE LAST DATA CARD.   LDCP0060
C                                                                       LDCP0070
      DIMENSION E(13),L(13),G(520)                                      LDCP0080
      COMMON E,L,E9,L9,KF,FK,M,W,N,D,A,B,C,D,NA,NB,NC,ND                LDCP0090
      EQUIVALENCE (E,L),(KF,FK),(W,M),(NA,A),(NB,B),(NC,C),(ND,D)       LDCP0100
      REWIND 4                                                          LDCP0110
B     A=714645256060                                                    LDCP0120
B     B=644531636060                                                    LDCP0130
B     C=434621242345                                                    LDCP0140
B     D=434621246060                                                    LDCP0150
      N=0                                                               LDCP0160
      M=0                                                               LDCP0170
      KF=0                                                              LDCP0180
    5 J=0                                                               LDCP0190
      DO 500 I=1,40                                                     LDCP0200
   15 READ INPUT TAPE 5,100,E(1),(L(K),K=2,3),(E(K),K=4,11),L(12)       LDCP0210
  100 FORMAT(A6,2I4,5F6.0,6X,2F6.0,A1,14X,I1)                           LDCP0220
C                                                                       LDCP0230
C CHECKING ZONE CARDS                                                   LDCP0240
C                                                                       LDCP0250
      NR=L(1)-NA                                                        LDCP0260
      IF (NR) 10,20,10                                                  LDCP0270
   20 N=L(2)                                                            LDCP0280
      GO TO 15                                                          LDCP0290
C                                                                       LDCP0300
C CHECKING UNIT CARDS                                                   LDCP0310
C                                                                       LDCP0320
   10 NR=L(1)-NB                                                        LDCP0330
      IF (NR) 40,15,40                                                  LDCP0340
C                                                                       LDCP0350
C CHECKING LOADCN CARDS                                                 LDCP0360
C                                                                       LDCP0370
   40 NR=L(1)-NC                                                        LDCP0380
      IF (NR) 50,60,50                                                  LDCP0390
   60 M=N+L(2)                                                          LDCP0400
      GO TO 15                                                          LDCP0410
C                                                                       LDCP0420
C CHECKING LOAD CARDS                                                   LDCP0430
C                                                                       LDCP0440
   50 NR=L(1)-ND                                                        LDCP0450
      IF (NR) 75,70,75                                                  LDCP0460
   70 IF (L(3)-L(2)) 25,35,35                                           LDCP0470
   25 KF=1                                                              LDCP0480
      LA=L(3)                                                           LDCP0490
      L(3)=L(2)                                                         LDCP0500
      L(2)=LA                                                           LDCP0510
      GO TO 80                                                          LDCP0520
   35 KF=0                                                              LDCP0530
   80 G(J+1)=FK                                                         LDCP0540
      DO 45 K=2,3                                                       LDCP0550
      JK=J+K                                                            LDCP0560
   45 G(JK)=E(K)                                                        LDCP0570
      G(J+4)=W                                                          LDCP0580
      DO 55 K=4,12                                                      LDCP0590
      JK=J+K+1                                                          LDCP0600
   55 G(JK)=E(K)                                                        LDCP0610
      J=J+13                                                            LDCP0620
  500 CONTINUE                                                          LDCP0630
      CALL WRITE(G,520)                                                 LDCP0640
      GO TO 5                                                           LDCP0650
   75 IF(J)65,65,65                                                     LDCP0660
   65 JI=J+1                                                            LDCP0670
B     E9=377777777777                                                   LDCP0680
      DO 85 I=JI,520                                                    LDCP0690
   85 G(I)=E9                                                           LDCP0700
      CALL WRITE(G,520)                                                 LDCP0710
   95 END FILE 4                                                        LDCP0720
      REWIND 4                                                          LDCP0730
      CALL EXIT                                                         LDCP0740
      END                                                               LDCP0750
