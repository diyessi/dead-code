      FIL,OUT,MOD/B,DEN/L,BLO/24                                        RSOR0050
      REC,TYP/F,LEN/24,FIE/(36B,108B)                                   RSOR0060
      SOR,FIL/100,SEQ/S,ORD/3,FIE/2                                     RSOR0070
