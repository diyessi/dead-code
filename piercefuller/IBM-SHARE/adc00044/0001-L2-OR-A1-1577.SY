       PAX     0,2                                                      AL302442
       PXA     0,2                                                      AL302444
       DELETE                                                           AL302480
       STL     DIMSW           RESET DIM SWITCH                         AL302490
       DELETE                                                           AL302550
ERROR3 SXD     *+1,2           ORIGINAL                                 AL302560
       TXI     *+1,4,**        CONTENTS                                 AL302570
       SXD     DIMX4,4         OF XR4                                   AL302580
       TSX     $ESCORT,4       FOR TRACEBACK                            AL302590
       TXI     *+2                                                      AL302600
       PZE     DIMX4                                                    AL302610
       TSX     $EXIT,4                                                  AL302620
DIMX4  PZE                                                              AL302630
       BCI     1,DIMLOC                                                 AL302640
       END                                                              AL302650
       END                                                              AL399999
