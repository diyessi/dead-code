*     FAP                                                                       
       COUNT   50                                                       ALH00005
       ENTRY   AVPSUB                                                   ALH00000
*      AVPSUB  ARRAY AS VALUE PARAMETER SUBROUTINE.                     ALH00010
*              CREATES A COPY OF ARRAY IN LOCAL ARRAY AREA.             ALH00020
*              MAKES PARAMETER IN CALLING SEQUENCE THE                  ALH00030
*              NAME OF ARRAY COPY.                                      ALH00040
*      CALLING SEQUENCE                                                 ALH00050
*      TSX     $AVPSUB,4                                                ALH00060
*      PZE     T1                  ADDR.OF COPY OF HEADER OF ARRAY PARAMALH00070
*      RETURNS HERE                                                     ALH00080
AVPSUB SXA     AVPEX,4             SAVE X4                              ALH00090
       CLA*    1,4                 GET COPY OF ARRAY HEADER             ALH00100
       STA     AVPA                LAST ADDRESS OF PROLOGUE             ALH00110
       ARS     18                                                       ALH00120
       STA     AVPA+1              FIRST ADDRESS OF PROLOGUE            ALH00130
       CLA*    $LAC                PLACE END ADDRESS OF ARRAY           ALH00140
       STA*    1,4                 COPY IN COPY ARRAY HEADER            ALH00150
       TSX     $SAVE,4             GO MAKE COPY OF PROLOGUE             ALH00160
AVPA   PZE     0                   FIRST ADDRESS                        ALH00170
       PZE     0                   LAST ADDRESS                         ALH00180
       CLA*    $LAC                                                     ALH00190
       ADD     ONE                                                      ALH00200
       STO     AVPA                HOLD END ADDRESS OF ARRAY COPY       ALH00210
       CLA*    AVPA+1              GET SIZE AND ADDRESS OF ARRAY        ALH00220
       STA     AVPB                SET START ADDRESS OF ARRAY TO COPY   ALH00230
       ARS     18                                                       ALH00240
       ADD     AVPB                GENERATE END ADDRESS OF ARRAY TO     ALH00250
       SUB     ONE                 COPY EQUAL TO SIZE + START - 1       ALH00260
       STO     AVPB+1              SET END ADDRESS                      ALH00270
       TSX     $SAVE,4             GO COPY ARRAY                        ALH00280
AVPB   PZE     0                   START ADDRESS OF ARRAY TO COPY       ALH00290
       PZE     0                   END ADDRESS                          ALH00300
AVPEX  AXT     *,4                                                      ALH00310
       CLA     AVPA                                                     ALH00320
       ALS     18                                                       ALH00330
       STD*    1,4                 PLACE START ADDR.OF ARRAY COPY IN HDRALH00340
       CLA*    $LAC                                                     ALH00350
       CAS*    $OAC                                                     ALH00360
       TRA     2,4                                                      ALH00370
       TRA     2,4                                                      ALH00380
       CLA     AVPEX               RAN OUT OF MEMORY SPACE              ALH00390
       STA     ER1                                                      ALH00400
       TSX     $ESCORT,4                                                ALH00410
       TXI     *+2,,2                                                   ALH00420
       PZE     ER1                                                      ALH00430
       TSX     $EXIT                                                    ALH00440
ER1    PZE                                                              ALH00450
ONE    PZE     1                                                        ALH00460
       END                                                              ALH00470
*     FAP                                                                       
       COUNT   30                                                       ALI00005
       ENTRY   SAVE                                                     ALI00000
*              SAVE ROUTINE AT OBJECT TIME MOVES TEMPORARIES INTO       ALI00010
*              DYNAMIC STORAGE PUSH DOWN.USES GLOBAL LAC WHICH          ALI00020
*              POINTS TO NEXT AVAILABLE LOC.IN DYNAMIC ARRAY STORAGE    ALI00030
*      CALLING SEQUENCE                                                 ALI00040
*      TSX     $SAVE,4                                                  ALI00050
*      PZE     T1                  FIRST ADDRESS OF BLOCK TO BE SAVED   ALI00060
*      PZE     T2                  LAST ADDRESS                         ALI00070
SAVE   SXA     RSAVEA,2            SAVE X2                              ALI00080
       CLA     2,4                 GET PARAMETER TWO FROM CALL          ALI00090
       ADD     ONE                                                      ALI00100
       STA     RSAVEB                                                   ALI00110
       SUB     1,4                 (P2-P1+1) PLACED IN X2               ALI00120
       PAX     0,2                                                      ALI00130
       CLA*    $LAC                                                     ALI00140
       ADD     ONE                                                      ALI00150
       STA     RSAVEC                                                   ALI00160
       PXA     0,2                                                      ALI00170
       SSM                                                              ALI00180
       ADD*    $LAC                LA C-(P2-P1+1)                       ALI00190
       STA*    $LAC                UPDATE LAC                           ALI00200
RSAVEB LDQ     *,2                 (P2+1) IN ADDRESS                    ALI00210
RSAVEC STQ     *,2                 (LAC+1) IN ADDRESS                   ALI00220
       TIX     RSAVEB,2,1                                               ALI00230
       LDQ*    $LAC                                                     ALI00240
       STQ*    1,4                                                      ALI00250
RSAVEA AXT     *,2                                                      ALI00260
       TRA     3,4                                                      ALI00270
ONE    PZE     1                                                        ALI00280
*                                  END OF SAVE ROUTINE                  ALI00290
       END                                                              ALI00300
⧻                                                                              ⧻
*     END TAPE                                                                  
