*     FAP                                                               VABSF000
       COUNT                                                            VABSF010
       ENTRY  IABS           I ABSF(Z),WHE-E 0=X++YT                    VABSF020
       ENTRY  VABS           = VABSF(X,Y)                               VABSF030
 IABS  CLA    X              =SQRTF(X*X+Y*Y)                            VABSF040
       LDQ    X-1            WITHOUT UNNECCESSARY OVER/UNDERFLOW        VABSF050
 VABS  XCL                   SET SIGNS POSITIVE                         VABSF060
       XCA                                                              VABSF070
       TLQ    *-1            PUT LARGER IN MQ                           VABSF080
       STQ    X              SAVE LARGER IN X                           VABSF090
       SXA    AXT,4                                                     VABSF100
       TZE    FAD            LEST X BE ZERO TOO                         VABSF110
       FDH    X              MAY HANG UP IF X IS NOT NORMALIZED         VABSF120
       STQ    X-1                                                       VABSF130
       FMP    X-1                                                       VABSF140
 FAD   FAD    ONE                                                       VABSF150
       FRN                                                              VABSF160
       TSX   $SQRT,4                                                    VABSF170
       XCA                   MQ=SQRTF(1.+(Y/X)**2)                      VABSF180
       FMP    X                                                         VABSF190
       FRN                                                              VABSF200
       STO    X              =SQRTF(X*X+Y*Y) IN REAL AC                 VABSF210
       STZ    X-1            CLEAR IMAG. AC                             VABSF220
 AXT   AXT    **,4                                                      VABSF230
       TRA    1,4            72 CYCLES+SQRT                             VABSF240
 ONE   DEC    1.0            23 LOCATIONS                               VA5SF250
       COMMON -206                                                      VABSF260
 X     COMMON 1                                                         VABSF270
       END                                                              VABSF280
