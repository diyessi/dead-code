C010  SUBROUTINE DISPLA(JOB,NIN,NOUT)                                   LPMD0000
      SUBROUTINE DISPLA(JOB,NIN,NOUT)                                   LPMD0010
C     THIS SUBPROGRAM DISPLAYS MATRICES OF LP/90 INPUT.  ABSF(JOB) IS   LPMD0020
C         THE NUMBER OF MATRICES TO BE DISPLAYED.                       LPMD0030
C         IF JOB IS POSITIVE WHOLE MATRICES ARE OUTPUT,                 LPMD0040
C         IF JOB IS NEGATIVE SECTIONS OF BLANK ROWS WILL BE IGNORED.    LPMD0050
C         NOUT IS THE LOGICAL OUTPUT TAPE.                              LPMD0060
C         NIN IS THE LOGICAL INPUT TAPE.                                LPMD0070
      DIMENSION EL1(8,1200),EL2(8,1200),AL(8),Q(1023),HD1(9),HD2(9),    LPMD0080
     1E(14),A(14),ROW(1200),SIGNR(1200),B(14),IAM(1023),F(14),          LPMD0090
     2NAMR(1200),HD3(9),HD4(9),HD5(9),HD6(9)                            LPMD0100
      COMMON      HD1,HD2,HD3,HD4,HD5,HD6,AL,B,F,E,A,IAM,Q,SIGNR,       LPMD0110
     1NAMR,ROW,EL1,EL2                                                  LPMD0120
   99 FORMAT(1H1)                                                       LPMD0130
   98 FORMAT(13A6,A2)                                                   LPMD0140
   97 FORMAT(1H 13A6,A2)                                                LPMD0150
   96 FORMAT(20H0ERROR IN CARD TYPE  13A6,A2)                           LPMD0160
   95 FORMAT(31H0TOO MANY ROW NAMES ENCOUNTERED)                        LPMD0170
   94 FORMAT(58H0THE FOLLOWING MATRIX ENTRY DOES NOT HAVE A VALID ROW NALPMD0180
     1ME/1H A6,4X13A6,A2)                                               LPMD0190
   93 FORMAT(1H0,5X,2A6,7(2X2A6))                                       LPMD0200
   92 FORMAT(1H 4H ROW,7XA6,7(8X,A6)//)                                 LPMD0210
   91 FORMAT(1H A1,A6,8(2X,2A6))                                        LPMD0220
   90 FORMAT(6X2A6,7(2X2A6))                                            LPMD0230
   89 FORMAT(1H )                                                       LPMD0240
      JOBS=JOB                                                          LPMD0250
      J=NIN                                                             LPMD0260
      N=NOUT                                                            LPMD0270
C     LINCNT IS THE NUMBER OF LINES PER PAGE.                           LPMD0280
      LINCNT=45                                                         LPMD0290
C     E( 1)=6H*                                                         LPMD0300
B     E( 1)=540000000000                                                LPMD0310
B     F( 1)=230000000000                                                LPMD0320
C     E( 2)=6HROW ID                                                    LPMD0330
B     E( 2)=514666603124                                                LPMD0340
B     F( 2)=263111174653                                                LPMD0350
C     E( 3)=6HBASIS                                                     LPMD0360
B     E( 3)=222162316260                                                LPMD0370
B     F( 3)=555615461517                                                LPMD0380
C     E( 4)=6HMATRIX                                                    LPMD0390
B     E( 4)=442163513167                                                LPMD0400
B     F( 4)=335614264610                                                LPMD0410
C     E( 5)=6H   CNT                                                    LPMD0420
B     E( 5)=606060234563                                                LPMD0430
B     F( 5)=171717543214                                                LPMD0440
C     E( 6)=6H   SUM                                                    LPMD0450
B     E( 6)=606060626444                                                LPMD0460
B     F( 6)=171717151333                                                LPMD0470
C     E( 7)=6HCURTAI                                                    LPMD0480
B     E( 7)=236451632131                                                LPMD0490
B     F( 7)=541326145646                                                LPMD0500
C     E( 8)=6HPARTIT                                                    LPMD0510
B     E( 8)=472151633163                                                LPMD0520
B     F( 8)=305626144614                                                LPMD0530
C     E( 9)=6HSLACK                                                     LPMD0540
B     E( 9)=624321234260                                                LPMD0550
B     F( 9)=153456543517                                                LPMD0560
C     E(10)=6HFIRST                                                     LPMD0570
B     E(10)=263151626360                                                LPMD0580
B     F(10)=514626151417                                                LPMD0590
C     E(11)=6H                                                          LPMD0600
B     E(11)=606060606060                                                LPMD0610
B     F(11)=171717171717                                                LPMD0620
C     E(12)=6HNEXT B                                                    LPMD0630
B     E(12)=452567636022                                                LPMD0640
B     F(12)=325210141755                                                LPMD0650
C     E(13)=6HEOF                                                       LPMD0660
B     E(13)=254626606060                                                LPMD0670
B     F(13)=523151171717                                                LPMD0680
C     E(14)=6H     0                                                    LPMD0690
B     E(14)=606060606000                                                LPMD0700
B     F(14)=171717171700                                                LPMD0710
C     IF JOBS IS NON-POSITIVE SECTIONS OF BLANK ROWS WILL BE IGNORED,   LPMD0720
C         OTHER WISE ALL MATRIX ENTRIES ARE OUTPUT.                     LPMD0730
      IF(JOBS) 101,101,201                                              LPMD0740
  101 ASSIGN 130 TO JUNK                                                LPMD0750
      GO TO 301                                                         LPMD0760
  201 ASSIGN 630 TO JUNK                                                LPMD0770
  301 DO 36 IJK=1,JOBS                                                  LPMD0780
      WRITE OUTPUT TAPE N,99                                            LPMD0790
C     INITIALIZE HEADING LINES PRIOR TO CALLING  CLEAR                  LPMD0800
B     HD3(9)=E(11)                                                      LPMD0810
B     HD4(9)=E(11)                                                      LPMD0820
B     HD5(9)=E(11)                                                      LPMD0830
B     HD6(9)=E(11)                                                      LPMD0840
      CALL CLEAR                                                        LPMD0850
      BP=6060606.                                                       LPMD0860
      I=0                                                               LPMD0870
C     INITIALIZE B VECTOR, THIS WILL BE REPLACED BY THE FIRST CARD  IF  LPMD0880
C         IT IS A COMMENT CARD                                          LPMD0890
B     B( 1)=633025602631                                                LPMD0900
B     B( 2)=516263602321                                                LPMD0910
B     B( 3)=512460316260                                                LPMD0920
B     B( 4)=454663602160                                                LPMD0930
B     B( 5)=234644442545                                                LPMD0940
B     B( 6)=636023215124                                                LPMD0950
B     B( 7)=606060606060                                                LPMD0960
B     B( 8)=606060606060                                                LPMD0970
B     B( 9)=606060606060                                                LPMD0980
B     B(10)=606060606060                                                LPMD0990
B     B(11)=606060606060                                                LPMD1000
B     B(12)=606060606060                                                LPMD1010
B     B(13)=606060606060                                                LPMD1020
B     B(14)=606060606060                                                LPMD1030
      II=0                                                              LPMD1040
      ASSIGN 3 TO IGO                                                   LPMD1050
      ASSIGN 27 TO IWENT                                                LPMD1060
      LIE=3                                                             LPMD1070
      DO 401 K=1,1200                                                   LPMD1080
  401 ROW(K)=0.                                                         LPMD1090
    1 READ INPUT TAPE J,98,A                                            LPMD1100
C     TEST FOR INITIAL COMMENT CARDS                                    LPMD1110
B     IF(A(1)*F(1)+(-A(1))*E(1)) 6,2,6                                  LPMD1120
    2 WRITE OUTPUT TAPE N,97,A                                          LPMD1130
      LIE=LIE+1                                                         LPMD1140
      GO TO IGO,(3,1)                                                   LPMD1150
    3 ASSIGN 1 TO IGO                                                   LPMD1160
C     SAVE FIRST COMMENT CARD FOR EACH PAGE OF OUTPUT                   LPMD1170
      DO 4 I1=1,14                                                      LPMD1180
    4 B(I1)=A(I1)                                                       LPMD1190
      GO TO 1                                                           LPMD1200
C     READ A NEW CARD                                                   LPMD1210
    5 READ INPUT TAPE J,98,A                                            LPMD1220
C     DETERMINE THE TYPE OF CARD                                        LPMD1230
    6 DO 7  K=1,13                                                      LPMD1240
      KOW=K                                                             LPMD1250
B     IF(A(1)*F(K)+(-A(1))*E(K)) 7,8,7                                  LPMD1260
    7 CONTINUE                                                          LPMD1270
C     ERROR IN CARD TYPE PRINT IT OUT AND IGNORE THE CARD               LPMD1280
      WRITE OUTPUT TAPE N,96,A                                          LPMD1290
      GO TO 5                                                           LPMD1300
C     BRANCH FOR PARTICULAR CARDS                                       LPMD1310
    8 GO TO (5,9,15,16,5,5,115,16,32,23,18,24,25),KOW                   LPMD1320
C     ROW ID                                                            LPMD1330
    9 READ INPUT TAPE J,98,A                                            LPMD1340
C     IS THIS CARD THE NEXT CARD AFTER THE LAST ROW NAME                LPMD1350
B     IF(A(1)*F(14)+(-A(1))*E(14)) 6,10,6                               LPMD1360
C     DETERMINE THE NUMBER OF ROW NAMES ON THIS CARD                    LPMD1370
B  10 AA=233000000000+000000000007*A(1)                                 LPMD1380
      AA=0.+AA                                                          LPMD1390
      IAA=XMIN0F(XMAX0F(1,XFIXF(AA)),5)                                 LPMD1400
      DO 13 IAB=1,IAA                                                   LPMD1410
      I2AB=2*IAB                                                        LPMD1420
      CALL SCRAMB(A(I2AB+1),L,M)                                        LPMD1430
C     L IS THE INDEX OF A(I2AB+1)                                       LPMD1440
      GO TO (12,11,14),M                                                LPMD1450
C     ONE OF THE NAMES HAS ALREADY BEEN ENCOUNTERED                     LPMD1460
   11 WRITE OUTPUT TAPE N,94,A(I2AB+1),A                                LPMD1470
      GO TO 13                                                          LPMD1480
   12 II=II+1                                                           LPMD1490
B     ROW(L)=A(I2AB+1)                                                  LPMD1500
      NAMR(L)=II                                                        LPMD1510
B     SIGNR(II)=SHIFT(A(I2AB))                                          LPMD1520
      IAM(II)=L                                                         LPMD1530
   13 CONTINUE                                                          LPMD1540
      GO TO 9                                                           LPMD1550
C     NO POINT IN CONTINUING  THIS RUN                                  LPMD1560
   14 WRITE OUTPUT TAPE N,95                                            LPMD1570
      CALL EXIT                                                         LPMD1580
C     BASIS CARDS FOLLOW                                                LPMD1590
   15 READ INPUT TAPE J,98,A                                            LPMD1600
C     IS THIS THE NEXT CARD AFTER THE LAST BASIS HEADING CARD           LPMD1610
B     IF(A(1)*F(14)+(-A(1))*E(14)) 6,15,6                               LPMD1620
C     PARTITION, CURTAIN, AND MATRIX ENTRIES                            LPMD1630
  115 HD5(I+1)=A(1)                                                     LPMD1640
      HD6(I+1)=A(2)                                                     LPMD1650
      BP=606050.                                                        LPMD1660
      GO TO 17                                                          LPMD1670
B  16 HD1(I+1)=A(1)                                                     LPMD1680
B     HD2(I+1)=A(2)                                                     LPMD1690
   17 READ INPUT TAPE J,98,A                                            LPMD1700
C     IS THIS CARD THE FIRST CARD AFTER THE LAST MATRIX ENTRY           LPMD1710
B     IF(A(1)*F(11)+(-A(1))*E(11)) 6,18,6                               LPMD1720
C     TEST FOR COLUMN NAME CHANGE                                       LPMD1730
B  18 IF(A(2)*(-BP)+(-A(2))*BP) 19,21,19                                LPMD1740
   19 IF(I-8) 20,25,25                                                  LPMD1750
   20 I=I+1                                                             LPMD1760
B     BP=A(2)                                                           LPMD1770
B     AL(I)=A(2)                                                        LPMD1780
C     DETERMINE ROW NAME                                                LPMD1790
   21 CALL SCRAMB(A(3),L,M)                                             LPMD1800
      GO TO (17,22,17),M                                                LPMD1810
B  22 EL1(I,L)=A(4)                                                     LPMD1820
B     EL2(I,L)=A(5)                                                     LPMD1830
      GO TO 17                                                          LPMD1840
C     FIRST B  CARD ENCOUNTERED SO START A NEW PAGE                     LPMD1850
   23 I=8                                                               LPMD1860
      GO TO 16                                                          LPMD1870
C     NEXT B               CARD ENCOUNTERED SO START A NEW COLUMN       LPMD1880
   24 BP=6060606.                                                       LPMD1890
      GO TO 16                                                          LPMD1900
C     WRITE OUT THIS SECTION OF THE MATRIX                              LPMD1910
   25 LINE=LINCNT                                                       LPMD1920
      ASSIGN 430 TO JUMP                                                LPMD1930
      DO 31 JK=1,II                                                     LPMD1940
      IF(LINCNT-LINE) 26,26,30                                          LPMD1950
   26 GO TO IWENT,(27,28)                                               LPMD1960
   27 ASSIGN 28 TO IWENT                                                LPMD1970
      LINE=LIE                                                          LPMD1980
      GO TO 29                                                          LPMD1990
   28 LINE=8                                                            LPMD2000
      WRITE OUTPUT TAPE N,99                                            LPMD2010
      WRITE OUTPUT TAPE N,97,B                                          LPMD2020
   29 WRITE OUTPUT TAPE N,93,(HD1(I),HD2(I),I=1,8)                      LPMD2030
      WRITE OUTPUT TAPE N,90,(HD3(I),HD4(I),I=1,8)                      LPMD2040
      WRITE OUTPUT TAPE N,90,(HD5(I),HD6(I),I=1,8)                      LPMD2050
      WRITE OUTPUT TAPE N,92,(AL(I),I=1,8)                              LPMD2060
   30 JJ=IAM(JK)                                                        LPMD2070
      GO TO JUNK,(130,630)                                              LPMD2080
C     IGNORE GROUPS OF BLANK ROWS                                       LPMD2090
  130 DO 330 I=1,8                                                      LPMD2100
B     IF(EL1(I,JJ)*F(11)+(-EL1(I,JJ))*E(11)) 530,230,530                LPMD2110
B 230 IF(EL2(I,JJ)*F(11)+(-EL2(I,JJ))*E(11)) 530,330,530                LPMD2120
  330 CONTINUE                                                          LPMD2130
      GO TO JUMP,(430,31)                                               LPMD2140
C     WRITE ONE BLANK LINE FOR EACH SET                                 LPMD2150
  430 WRITE OUTPUT TAPE N,89                                            LPMD2160
      LINE=LINE+1                                                       LPMD2170
      ASSIGN 31 TO JUMP                                                 LPMD2180
      GO TO 31                                                          LPMD2190
  530 ASSIGN 430 TO JUMP                                                LPMD2200
  630 LINE=LINE+1                                                       LPMD2210
      WRITE OUTPUT TAPE N,91,SIGNR(JK),ROW(JJ),(EL1(I,JJ),EL2(I,JJ),    LPMD2220
     1I=1,8)                                                            LPMD2230
   31 CONTINUE                                                          LPMD2240
      CALL CLEAR                                                        LPMD2250
      I=0                                                               LPMD2260
      IF(KOW-13) 20,36,20                                               LPMD2270
C     SLACK INTRODUCTION                                                LPMD2280
B  32 IF(A(2)*F(11)+(-A(2))*E(11)) 132,33,132                           LPMD2290
B 132 HD3(I+1)=A(1)                                                     LPMD2300
B     HD4(I+1)=A(2)                                                     LPMD2310
      BP=6060601.                                                       LPMD2320
      GO TO 17                                                          LPMD2330
   33 CALL SCRAMB(A(3),L,M)                                             LPMD2340
C     IGNORE IF ROW NOT SPECIFIED IN ROW NAMES                          LPMD2350
      GO TO (5,34,5),M                                                  LPMD2360
   34 JJ=NAMR(L)                                                        LPMD2370
C     IGNORE IF SLACK NOT SPECIFIED IN ROW NAMES                        LPMD2380
B     IF(SIGNR(JJ)*170000000000+(-SIGNR(JJ))*600000000000) 35,5,35      LPMD2390
B  35 A(4)=SIGNR(JJ)+006060600133                                       LPMD2400
B     A(5)=E(11)                                                        LPMD2410
B     A(2)=A(3)                                                         LPMD2420
      GO TO 19                                                          LPMD2430
   36 CONTINUE                                                          LPMD2440
      RETURN                                                            LPMD2450
      END                                                               LPMD2460
*020   SUBROUTINE CLEAR                                                 LPMD2470
       COUNT   45                                                       LPMD2480
*      THIS SUBPROGRAM STORES BCI BLANKS IN VARIOUS ARRAYS              LPMD2490
       ENTRY   CLEAR                                                    LPMD2500
       BCI     1,CLEAR                                                  LPMD2510
 CLEAR CAL     HD1-8                    SAVE LAST ENTRY BY MOVING       LPMD2520
       SLW     HD1                           IT TO FIRST ENTRY          LPMD2530
       CAL     HD2-8                                                    LPMD2540
       SLW     HD2                                                      LPMD2550
       CAL     HD3-8                                                    LPMD2560
       SLW     HD3                                                      LPMD2570
       CAL     HD4-8                                                    LPMD2580
       SLW     HD4                                                      LPMD2590
       CAL     HD5-8                                                    LPMD2600
       SLW     HD5                                                      LPMD2610
       CAL     HD6-8                                                    LPMD2620
       SLW     HD6                                                      LPMD2630
       SXA     XR1,1                                                    LPMD2640
       AXT     8,1                                                      LPMD2650
       CAL     BLANKS                                                   LPMD2660
  BLAN SLW     AL+1,1                   PLACE BLANKS IN REMAINDER       LPMD2670
       SLW     HD1,1                         OF THE ARRAYS              LPMD2680
       SLW     HD2,1                                                    LPMD2690
       SLW     HD3,1                                                    LPMD2700
       SLW     HD4,1                                                    LPMD2710
       SLW     HD5,1                                                    LPMD2720
       SLW     HD6,1                                                    LPMD2730
       TIX     BLAN,1,1                                                 LPMD2740
       AXT     9600,1                                                   LPMD2750
       SLW     EL1+1,1                                                  LPMD2760
       SLW     EL2+1,1                                                  LPMD2770
       TIX     *-2,1,1                                                  LPMD2780
   XR1 AXT     **,1                                                     LPMD2790
       TRA     1,4                      RETURN                          LPMD2800
BLANKS OCT     606060606060             BCI  BLANKS                     LPMD2810
   HD1 COMMON  9                                                        LPMD2820
   HD2 COMMON  9                                                        LPMD2830
   HD3 COMMON  9                                                        LPMD2840
   HD4 COMMON  9                                                        LPMD2850
   HD5 COMMON  9                                                        LPMD2860
   HD6 COMMON  9                                                        LPMD2870
    AL COMMON  8                                                        LPMD2880
  PADS COMMON  5702                                                     LPMD2890
   EL1 COMMON  9600                                                     LPMD2900
   EL2 COMMON  9600                                                     LPMD2910
       END                                                              LPMD2920
*030   FUNCTION SHIFT(A)                                                LPMD2930
       COUNT   9                                                        LPMD2940
       ENTRY   SHIFT                                                    LPMD2950
 SHIFT CAL*    1,4                      THIS ROUTINE SHIFTS THE RIGHT   LPMD2960
       LGL     30                            MOST CHARACTER TO THE LEFT LPMD2970
       ANA     *+2                           MOST POSITION AND MASKS OFFLPMD2980
       TRA     2,4                           ANY OTHER INFORMATION      LPMD2990
       OCT     770000000000                                             LPMD3000
       END                                                              LPMD3010
*040   SUBROUTINE SCRAMB(A,L,M)                                         LPMD3020
       COUNT   40                                                       LPMD3030
*      THIS SUBROUTINE EXAMINES THE VECTOR ROW TO SEE IF A IS IN IT.    LPMD3040
*         IF A IS IN ROW L INDICATES THE INDEX                          LPMD3050
*         M=1 IN CASE A IS NOT IN ROW                                   LPMD3060
*         M=2 IN CASE A IS IN ROW                                       LPMD3070
*         M=3 IN CASE ROW IS FULL AND A IS NOT IN ROW                   LPMD3080
       ENTRY   SCRAMB                                                   LPMD3090
       BCI     1,SCRAMB                                                 LPMD3100
SCRAMB SXA     BACK,1                                                   LPMD3110
       SXA     BACK+1,2                                                 LPMD3120
       LDQ*    1,4                      CALCULATE PRIME INDEX           LPMD3130
       MPY     ONES                                                     LPMD3140
       XCL                                                              LPMD3150
       PXD     ,0                                                       LPMD3160
       DVP     SIZE                                                     LPMD3170
       PAX     ,1                                                       LPMD3180
       TXI     *+1,1,1                  PRIME INDEX IN XR1              LPMD3190
       LXA     SIZE,2                                                   LPMD3200
       CAL     ROW+1,1                                                  LPMD3210
       TZE     HOLE                     TABLE ENTRY NOT FILLED          LPMD3220
       ERA*    1,4                                                      LPMD3230
       TZE     MATCH                    TABLE ENTRY MATCHES             LPMD3240
       TIX     *+2,1,1                  TABLE ENTRY FILLED,             LPMD3250
       LXA     SIZE,1                        SO GET A NEW ENTRY.        LPMD3260
       TIX     *-6,2,1                                                  LPMD3270
       AXT     3,2                      TABLE IS FULL       M=3         LPMD3280
       PXD     ,2                                                       LPMD3290
       STO*    3,4                      M                               LPMD3300
       PXD     ,1                                                       LPMD3310
       STO*    2,4                      L                               LPMD3320
  BACK AXT     **,1                                                     LPMD3330
       AXT     **,2                                                     LPMD3340
       TRA     4,4                                                      LPMD3350
  HOLE AXT     1,2                      ENTRY NOT IN TABLE  M=1         LPMD3360
       TRA     *-8                                                      LPMD3370
 MATCH AXT     2,2                      ENTRY IN TABLE      M=2         LPMD3380
       TRA     *-10                                                     LPMD3390
  SIZE PZE     1200                                                     LPMD3400
  ONES OCT     010101010101                                             LPMD3410
     B COMMON  4564                                                     LPMD3420
   ROW COMMON  1200                                                     LPMD3430
       END                                                              LPMD3440
