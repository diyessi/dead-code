       ENTRY   S.XSTR                                                   XFERX003
       ENTRY   S.SSIM                                                   XFERX004
       ENTRY   S.MEND                                                   XFERX005
S.SSIM TRA     **                                                       XFERX006
S.XMTP SXA     XR4,4                                                    XFERX007
       CAL     2             SAVE OLD INSTR                             XFERX008
       SLW     SAVE                                                     XFERX009
       CAL     NEW           REPLACE WITH TRANSFER TO S.XSTR            XFERX010
       TSX     S.SCCR,4                                                 XFERX011
       SLW     2                                                        XFERX012
XR4    AXT     **,4                                                     XFERX013
       XEC     S.SSIM        RETURN                                     XFERX014
S.MEND TRA     **                                                       XFERX015
       SXA     XR4,4                                                    XFERX016
RESTOR CAL     SAVE                                                     XFERX017
       TSX     S.SCCR,4                                                 XFERX018
       SLW     2                                                        XFERX019
       LXA     XR4,4                                                    XFERX020
       XEC     S.MEND        RETURN                                     XFERX021
NEW    TRA     S.XSTR                                                   XFERX022
S.XSTR SXA     XR4,4                                                    XFERX023
       LXA     0,4                                                      XFERX024
       TXL     SAVE,4,1      GET OUT OF STR LOOP                        XFERX025
       SXA     *+3,4                                                    XFERX026
