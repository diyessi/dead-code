$IBFTC HESS    LIST,DECK                                                HESS0001
C     SUBROUTINE TO PUT MATRIX IN UPPER HESSENBERG FORM.                HESS0002
      SUBROUTINE HESSEN(A,M)                                            HESS0003
      DIMENSION A(100,100), B(99)                                       HESS0004
      DOUBLE PRECISION SUM                                              HESS0005
      IF (M - 2) 30,30,32                                               HESS0006
   32 DO 40 LC = 3,M                                                    HESS0007
      N = M - LC + 3                                                    HESS0008
      N1 = N - 1                                                        HESS0009
      N2 = N - 2                                                        HESS0010
      NI = N1                                                           HESS0011
      DIV = ABS(A(N,N-1))                                               HESS0012
      DO 2 J = 1,N2                                                     HESS0013
      IF(ABS(A(N,J))- DIV) 2,2,1                                        HESS0014
    1 NI = J                                                            HESS0015
      DIV = ABS(A(N,J))                                                 HESS0016
    2 CONTINUE                                                          HESS0017
      IF(DIV) 3,40,3                                                    HESS0018
    3 IF(NI - N1) 4, 7,4                                                HESS0019
    4 DO 5 J = 1,N                                                      HESS0020
      DIV = A(J,NI)                                                     HESS0021
      A(J,NI) = A(J,N1)                                                 HESS0022
    5 A(J,N1) = DIV                                                     HESS0023
      DO 6 J = 1,M                                                      HESS0024
      DIV = A(NI,J)                                                     HESS0025
      A(NI,J) = A(N1,J)                                                 HESS0026
    6 A(N1,J) = DIV                                                     HESS0027
    7 DO 26 K = 1, N1                                                   HESS0028
   26 B(K) = A(N,K)/A(N,N-1)                                            HESS0029
      DO 45 J = 1,M                                                     HESS0030
      SUM = 0.0                                                         HESS0031
      IF (J - N1) 46,43,43                                              HESS0032
   46 IF(B(J))  41,43,41                                                HESS0033
   41 A(N,J) = 0.0                                                      HESS0034
      DO 42 K = 1,N1                                                    HESS0035
      A(K,J) = A(K,J) - A(K,N1)*B(J)                                    HESS0036
   42 SUM = SUM + A(K,J)*B(K)                                           HESS0037
      GO TO 45                                                          HESS0038
   43 DO 44 K = 1,N1                                                    HESS0039
   44 SUM = SUM + A(K,J)*B(K)                                           HESS0040
   45 A(N1,J) = SUM                                                     HESS0041
   40 CONTINUE                                                          HESS0042
   30 RETURN                                                            HESS0043
       END                                                              HESS0044
$IBFTC QRCN    LIST,DECK                                                QRCN0001
C       PROGRAM TO CALL QR TRANSFORMATION, MAXIMUM ITER IS 50.          QRCN0002
      SUBROUTINE QREIG(A,M,ROOTR,ROOTI,IPRNT)                           QRCN0003
      DIMENSION  A(100,100),             ROOTR(100), ROOTI(100)         QRCN0004
      N = M                                                             QRCN0005
      IF(IPRNT)  80,81,80                                               QRCN0006
 80   WRITE (6,104)                                                     QRCN0007
 81   ZERO = 0.0                                                        QRCN0008
      JJ=1                                                              QRCN0009
  177 XNN=0.0                                                           QRCN0010
      XN2=0.0                                                           QRCN0011
      AA = 0.0                                                          QRCN0012
      B = 0.0                                                           QRCN0013
      C = 0.0                                                           QRCN0014
      DD = 0.0                                                          QRCN0015
      R=0.0                                                             QRCN0016
      SIG=0.0                                                           QRCN0017
      ITER = 0                                                          QRCN0018
 17   IF(N-2)    13,14,12                                               QRCN0019
 13   IF(IPRNT)  82,83,82                                               QRCN0020
 82   WRITE (6,105)A(1,1)                                               QRCN0021
 83   ROOTR(1) = A(1,1)                                                 QRCN0022
      ROOTI(1) = 0.0                                                    QRCN0023
  1   RETURN                                                            QRCN0024
 14   JJ=-1                                                             QRCN0025
   12 X = (A(N-1,N-1) - A(N,N))**2                                      QRCN0026
      S = 4.0*A(N,N-1)*A(N-1,N)                                         QRCN0027
      ITER = ITER + 1                                                   QRCN0028
      IF(ABS(S/X).GT. 1.0E-8) GO TO 15                                  QRCN0029
   16 IF(ABS(A(N-1,N-1))-ABS(A(N,N)))  32,32,31                         QRCN0030
   31 E = A(N-1,N-1)                                                    QRCN0031
      G = A(N,N)                                                        QRCN0032
      GO TO 33                                                          QRCN0033
   32 G = A(N-1,N-1)                                                    QRCN0034
      E = A(N,N)                                                        QRCN0035
   33 F = 0.                                                            QRCN0036
      H = 0.                                                            QRCN0037
      GO TO 24                                                          QRCN0038
   15 S = X + S                                                         QRCN0039
      X = A(N-1,N-1) + A(N,N)                                           QRCN0040
      IF(S)    18,19,19                                                 QRCN0041
 19   SQ=SQRT(S)                                                        QRCN0042
      F=0.0                                                             QRCN0043
      H=0.0                                                             QRCN0044
      IF (X) 21,21,22                                                   QRCN0045
 21   E=(X-SQ)/2.0                                                      QRCN0046
      G=(X+SQ)/2.0                                                      QRCN0047
      GO TO 24                                                          QRCN0048
 22   G=(X-SQ)/2.0                                                      QRCN0049
      E=(X+SQ)/2.0                                                      QRCN0050
      GO TO 24                                                          QRCN0051
   18 F = SQRT(-S)/2.0                                                  QRCN0052
      E=X/2.0                                                           QRCN0053
      G=E                                                               QRCN0054
      H=-F                                                              QRCN0055
 24   IF(JJ)  28,70,70                                                  QRCN0056
   70 D = 1.0E-10*(ABS(G) + F)                                          QRCN0057
      IF(ABS(A(N-1,N-2)) .GT. D)  GO TO 26                              QRCN0058
 28   IF(IPRNT)  84,85,84                                               QRCN0059
 84   WRITE (6,105)E,F, ITER                                            QRCN0060
      WRITE (6,105)G,H                                                  QRCN0061
 85   ROOTR(N) = E                                                      QRCN0062
      ROOTI(N) = F                                                      QRCN0063
      ROOTR(N-1) = G                                                    QRCN0064
      ROOTI(N-1) = H                                                    QRCN0065
      N=N-2                                                             QRCN0066
      IF(JJ)  1,177,177                                                 QRCN0067
   26 IF(ABS(A(N,N-1)) .GT. 1.0E-10*ABS(A(N,N)))  GO TO 50              QRCN0068
 29   IF(IPRNT)  86,87,86                                               QRCN0069
 86   WRITE (6,105)A(N,N), ZERO, ITER                                   QRCN0070
 87   ROOTR(N) = A(N,N)                                                 QRCN0071
      ROOTI(N) = 0.0                                                    QRCN0072
      N=N-1                                                             QRCN0073
      GO TO 177                                                         QRCN0074
 50   IF(ABS(ABS(XNN/A(N,N-1))-1.0)-1.0E-6)  63,63,62                   QRCN0075
 62   IF(ABS(ABS(XN2/A(N-1,N-2))-1.0)-1.0E-6)  63,63,700                QRCN0076
 63   VQ=ABS(A(N,N-1))-ABS(A(N-1,N-2))                                  QRCN0077
 64   IF(VQ)   67,67,66                                                 QRCN0078
 66   IF(IPRNT)  88,85,88                                               QRCN0079
 88   WRITE (6,107)A(N-1,N-2)                                           QRCN0080
      GO TO 84                                                          QRCN0081
 67   IF(IPRNT)  89,87,89                                               QRCN0082
 89   WRITE (6,107)A(N,N-1)                                             QRCN0083
      GO TO 86                                                          QRCN0084
  700 IF(ITER .GT. 50) GO TO 63                                         QRCN0085
  701 Z1=         ((E-AA)**2+(F-B)**2)/(E*E+F*F)                        QRCN0086
      Z2=      ((G-C)**2+(H-DD)**2)/(G*G+H*H)                           QRCN0087
      IF(Z1-0.25)  51,51,52                                             QRCN0088
 51   IF(Z2-0.25)   53,53,54                                            QRCN0089
 53   R=E*G-F*H                                                         QRCN0090
      SIG=E+G                                                           QRCN0091
      GO TO 60                                                          QRCN0092
 54   R=E*E                                                             QRCN0093
      SIG=E+E                                                           QRCN0094
      GO TO 60                                                          QRCN0095
 52   IF(Z2-0.25) 55,55,601                                             QRCN0096
 55   R=G*G                                                             QRCN0097
      SIG=G+G                                                           QRCN0098
      GO TO 60                                                          QRCN0099
  601 R = 0.0                                                           QRCN0100
      SIG = 0.0                                                         QRCN0101
 60   XNN=A(N,N-1)                                                      QRCN0102
      XN2=A(N-1,N-2)                                                    QRCN0103
      CALL QRT(A,N,R,SIG,D)                                             QRCN0104
      AA=E                                                              QRCN0105
      B=F                                                               QRCN0106
      C=G                                                               QRCN0107
      DD=H                                                              QRCN0108
      GO TO 12                                                          QRCN0109
 104  FORMAT(////1X, 9HREAL PART  6X  14HIMAGINARY PART, 26X            QRCN0110
     1  13HTAKEN AS ZERO 6X 4HITER //)                                  QRCN0111
 105  FORMAT(1X,E15.8,3X,E15.8, 42X I3)                                 QRCN0112
 107  FORMAT(56X  E13.8)                                                QRCN0113
       END                                                              QRCN0114
$IBFTC *QRT    LIST,DECK                                                QRT 0001
      SUBROUTINE QRT(A,N,R,SIG,D)                                       QRT 0002
      DIMENSION  A(100,100),PSI(3),G(3)                                 QRT 0003
      N1 = N - 1                                                        QRT 0004
      IA = N - 2                                                        QRT 0005
      IP = IA                                                           QRT 0006
      IF(N-3) 101,10,60                                                 QRT 0007
 60   DO 12 J = 3,N1                                                    QRT 0008
      J1 = N - J                                                        QRT 0009
      IF(ABS(A(J1+1,J1))-D)    10,10,11                                 QRT 0010
 11   IF(ABS(A(J1+1,J1)*A(J1+2,J1+1)*(ABS(A(J1+1,J1+1)+A(J1+2,J1+2)     QRT 0011
     1-SIG)+ABS(A(J1+3,J1+2)))/(A(J1+1,J1+1)*(A(J1+1,J1+1)-SIG)+A(     JQRT 0012
     21+1,J1+2)*A(J1+2,J1+1)+R))-D)     10,10,12                        QRT 0013
 12   IP=J1                                                             QRT 0014
 10   DO  14  J=1,IP                                                    QRT 0015
      J1=IP-J+1                                                         QRT 0016
      IF(ABS(A(J1+1,J1))-D)    13,13,14                                 QRT 0017
 14   IQ=J1                                                             QRT 0018
 13   DO  100  I=IP,N1                                                  QRT 0019
      IF(I-IP)   16,15,16                                               QRT 0020
 15   G(1)=A(IP,IP)*(A(IP,IP)-SIG)+A(IP,IP+1)*A(IP+1,IP)+R              QRT 0021
      G(2)=A(IP+1,IP)*(A(IP,IP)+A(IP+1,IP+1)-SIG)                       QRT 0022
      G(3)=A(IP+1,IP)*A(IP+2,IP+1)                                      QRT 0023
      A(IP+2,IP)=0.0                                                    QRT 0024
      GO TO 19                                                          QRT 0025
 16   G(1)=A(I,I-1)                                                     QRT 0026
      G(2)=A(I+1,I-1)                                                   QRT 0027
      IF(I-IA)   17,17,18                                               QRT 0028
 17   G(3)=A(I+2,I-1)                                                   QRT 0029
      GO TO 19                                                          QRT 0030
 18   G(3)=0.0                                                          QRT 0031
   19 XK = SIGN(SQRT(G(1)**2 + G(2)**2 + G(3)**2), G(1))                QRT 0032
 22   IF(XK)   23,24,23                                                 QRT 0033
 23   AL=G(1)/XK+1.0                                                    QRT 0034
      PSI(1)=G(2)/(G(1)+XK)                                             QRT 0035
      PSI(2)=G(3)/(G(1)+XK)                                             QRT 0036
      GO TO 25                                                          QRT 0037
 24   AL=2.0                                                            QRT 0038
      PSI(1)=0.0                                                        QRT 0039
      PSI(2)=0.0                                                        QRT 0040
 25   IF(I-IQ)   26,27,26                                               QRT 0041
 26   IF(I-IP)    29,28,29                                              QRT 0042
 28   A(I,I-1)=-A(I,I-1)                                                QRT 0043
      GO TO 27                                                          QRT 0044
 29   A(I,I-1)=-XK                                                      QRT 0045
 27   DO 30  J=I,N                                                      QRT 0046
      IF(I-IA)  31,31,32                                                QRT 0047
 31   C=PSI(2)*A(I+2,J)                                                 QRT 0048
      GO TO 33                                                          QRT 0049
 32   C=0.0                                                             QRT 0050
 33   E=AL*(A(I,J)+PSI(1)*A(I+1,J)+C)                                   QRT 0051
      A(I,J)=A(I,J)-E                                                   QRT 0052
      A(I+1,J)=A(I+1,J)-PSI(1)*E                                        QRT 0053
      IF(I-IA)   34,34,30                                               QRT 0054
 34   A(I+2,J)=A(I+2,J)-PSI(2)*E                                        QRT 0055
 30   CONTINUE                                                          QRT 0056
      IF(I-IA)   35,35,36                                               QRT 0057
 35   L=I+2                                                             QRT 0058
      GO TO  37                                                         QRT 0059
 36   L=N                                                               QRT 0060
 37   DO  40  J=IQ,L                                                    QRT 0061
      IF(I-IA)  38,38,39                                                QRT 0062
 38   C=PSI(2)*A(J,I+2)                                                 QRT 0063
      GO TO  41                                                         QRT 0064
 39   C=0.0                                                             QRT 0065
 41   E=AL*(A(J,I)+PSI(1)*A(J,I+1)+C)                                   QRT 0066
      A(J,I)=A(J,I)-E                                                   QRT 0067
      A(J,I+1)=A(J,I+1)-PSI(1)*E                                        QRT 0068
      IF(I-IA)  42,42,40                                                QRT 0069
 42   A(J,I+2)=A(J,I+2)-PSI(2)*E                                        QRT 0070
 40   CONTINUE                                                          QRT 0071
      IF(I-N+3)   43,43,100                                             QRT 0072
 43   E=AL*PSI(2)*A(I+3,I+2)                                            QRT 0073
      A(I+3,I)=-E                                                       QRT 0074
      A(I+3,I+1)=-PSI(1)*E                                              QRT 0075
      A(I+3,I+2)=A(I+3,I+2)-PSI(2)*E                                    QRT 0076
 100  CONTINUE                                                          QRT 0077
 101  RETURN                                                            QRT 0078
       END                                                              QRT 0079
