       REM FORTRAN GRAPH PLOT  FOR BESYS3 USING AMPLOT                AMPLOF0001
       REM  S.E.GOOD    NOV 1961                                        PLOF0002
       ENTRY   LGCHAR                                                   PLOF0003
       ENTRY   CURVE                                                    PLOF0004
       ENTRY   FNPLOT                                                   PLOF0005
LGCHAR CLA*    1,4                                                      PLOF0006
       STD FNPLOT-10                                                    PLOF0007
       SXA     FNPLOT-5,4                                               PLOF0008
       CAL*    2,4                                                      PLOF0009
       SLW FNPLOT-2                                                     PLOF0010
       REM ASSUMES AMPLOT SEPARATELY COMPILED                           PLOF0011
       CALL CXPLOT                                                      PLOF0012
       FVE 0,1                                                          PLOF0013
       SIX 512,1,512                                                    PLOF0014
       SIX FNPLOT-3,3                                                   PLOF0015
       MZE    ,,1                                                       PLOF0016
       XIT XXXRET                                                       PLOF0017
       AXT   **,4                                                       PLOF0018
       TRA 3,4               RETURN FROM LGCHAR                         PLOF0019
       BCD 2(9H                                                         PLOF0020
       OCT 3000000                                                      PLOF0021
FNPLOT CLA 1,4                                                          PLOF0022
       STA ENTER+2                                                      PLOF0023
       CLA 2,4                                                          PLOF0024
       STA ENTER+4                                                      PLOF0025
       CLA 3,4                                                          PLOF0026
       STA ENTER+6                                                      PLOF0027
       CLA 4,4                                                          PLOF0028
       STA ENTER+7                                                      PLOF0029
       CLA 5,4                                                          PLOF0030
       ALS 18                                                           PLOF0031
       STD ENTER+7                                                      PLOF0032
       CLA 6,4                                                          PLOF0033
       STA ENTER+8                                                      PLOF0034
       CLA 7,4                                                          PLOF0035
       ALS 18                                                           PLOF0036
       STD ENTER+8                                                      PLOF0037
       CLA*    8,4                                                      PLOF0038
       ARS 18                                                           PLOF0039
       STA ENTER+9                                                      PLOF0040
       CLA*    9,4                                                      PLOF0041
       STD ENTER+9                                                      PLOF0042
       CLA*    10,4                                                     PLOF0043
       ARS 18                                                           PLOF0044
       STA ENTER+10                                                     PLOF0045
       CLA*    11,4                                                     PLOF0046
       STD ENTER+10                                                     PLOF0047
       CLA 12,4                                                         PLOF0048
       STA ENTER+11                                                     PLOF0049
       CLA 13,4                                                         PLOF0050
       ALS 18                                                           PLOF0051
       STD ENTER+11                                                     PLOF0052
       SXA  CURVE-2,4                                                   PLOF0053
       CALL CXPLOT                                                      PLOF0054
 ENTER MZE   ,,1             ADVANCE FILM                               PLOF0055
       SIX 552,1,982         CENTER TITLE                               PLOF0056
       SIX **,,1             FORMAT                                     PLOF0057
       SIX 552,1,939         CENTER X AXIA LABEL                        PLOF0058
       SIX **                FORMAT                                     PLOF0059
       SVN 32,1,464          CENTERY AXIS LABEL                         PLOF0060
       SVN **                FORMAT                                     PLOF0061
       PON **,,**            X RANGE                                    PLOF0062
       PON **,,**            Y RANGE                                    PLOF0063
       PON **,,**            X GRID LINES                               PLOF0064
       PON **,,**            Y GRID LINES                               PLOF0065
       PON **,,**            GRID LABEL FORMAT                          PLOF0066
       XIT XXXRET            RETURN                                     PLOF0067
       AXT  **,4                                                        PLOF0068
       TRA 14,4              END OF HEADING                             PLOF0069
 CURVE CLA 1,4               CURVE ONLY                                 PLOF0070
       STA DUPL+1                                                       PLOF0071
       CLA 2,4                                                          PLOF0072
       ALS 18                                                           PLOF0073
       STD DUPL+1                                                       PLOF0074
       CLA*    3,4                                                      PLOF0075
       ARS 18                                                           PLOF0076
       STA DUPL+2                                                       PLOF0077
       CLA 4,4                                                          PLOF0078
       ALS 18                                                           PLOF0079
       STD DUPL+2                                                       PLOF0080
       SXA  DUPL+4,4                                                    PLOF0081
 DUPL  CALL CXPLOT                                                      PLOF0082
       PTW **,,**            TABLE LOCATIONS                            PLOF0083
       PTW **,,**            LENGTH OF TABLE, PLOT CHAR.                PLOF0084
       XIT XXXRET                                                       PLOF0085
       AXT  **,4                                                        PLOF0086
       TRA 5,4               RETURN FROM CURVE                          PLOF0087
       END 0                                                            PLOF0088
