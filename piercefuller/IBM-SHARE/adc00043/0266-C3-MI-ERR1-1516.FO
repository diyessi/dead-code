C    ER.-   ERROR FUNCTION                                              ER-   ID
D     FUNCTION ER(X)                                                    ER-    1
      I = XINTF (10. * X) - 4                                           ER-    2
      IF (I - 1) 2, 1, 1                                                ER-    3
   1  IF (I - 7) 3, 4, 4                                                ER-    4
D  2  ER = ERFTS(X)                                                     ER-    5
      RETURN                                                            ER-    6
D  3  ER = TABLE(X, I)                                                  ER-    7
      RETURN                                                            ER-    8
D  4  ER = 1. - ERC(X)                                                  ER-    9
      RETURN                                                            ER-   10
      END                                                                       
C   ERC.-   ERROR-FUNCTION COMPLEMENT                                   ERC-  ID
D     FUNCTION ERC(X)                                                   ERC-   1
      I = XINTF (10. * X) - 3                                           ERC-   2
      IF (I -  8) 2, 1, 1                                               ERC-   3
   1  IF (I - 62) 3, 4, 4                                               ERC-   4
D  2  ERC = 1. - ER(X)                                                  ERC-   5
      RETURN                                                            ERC-   6
D  3  ERC = TABLE (X, I)                                                ERC-   7
      RETURN                                                            ERC-   8
D  4  ERC = ERFCA(X)                                                    ERC-   9
      RETURN                                                            ERC-  10
      END                                                                       
C  QERC.-   INTEGRATED-ERROR-FUNCTION COMPLEMENT                        QERC- ID
D     FUNCTION QERC(X)                                                  QERC-  1
D     QERC = 0.5641 8958 3547 7563 * EXPF( -X * X) - X * ERC(X)         QERC-  2
C            0.5641 8958 3547 7563 = 1. / DSQRT (PI)                    QERC-  3
      RETURN                                                            QERC-  4
      END                                                                       
C ERFTS.-   TAYLOR SERIES EXPANSION OF ERF(X)                           ERFTS-ID
D     FUNCTION ERFTS(X)                                                 ERFTS- 1
D     ZERO = 0.                                                         ERFTS- 2
D     ONE = 1.                                                          ERFTS- 3
D     TWO = 2.                                                          ERFTS- 4
      TEST = 0.4E-19                                                    ERFTS- 5
C     TEST IS THE CONVERGENCE CRITERION.  IT IS THE UPPER LIMIT         ERFTS- 6
C          ON THE MAGNITUDE OF THE LAST TERM.                           ERFTS- 7
D     TERMNO = ZERO                                                     ERFTS- 8
D     ODDNO = -ONE                                                      ERFTS- 9
D     SIGN = ONE                                                        ERFTS-10
D     SIZE = X                                                          ERFTS-11
D     SUM = X                                                           ERFTS-12
D     XSQ = X * X                                                       ERFTS-13
D  1  TERMNO = TERMNO + ONE                                             ERFTS-14
D     ODDNO = ODDNO + TWO                                               ERFTS-15
D     SIGN = -SIGN                                                      ERFTS-16
D     RATIO = ODDNO * XSQ / (TERMNO * (ODDNO + TWO))                    ERFTS-17
D     SIZE = SIZE * RATIO                                               ERFTS-18
D     SUM = SUM + SIGN * SIZE                                           ERFTS-19
      IF (SIZE - TEST) 2, 1, 1                                          ERFTS-20
D  2  ERFTS = 1.128 3791 6709 5513 * SUM                                ERFTS-21
C             1.128 3791 6709 5513 = 2. / DSQRT (PI)                    ERFTS-22
      RETURN                                                            ERFTS-23
      END                                                                       
C TABLE.-   ERF(X) AND ERFC(X) TABLE-SEARCH                             TABLE-ID
D     FUNCTION TABLE (X, I)                                             TABLE- 1
D     DIMENSION Y0(61)                                                  TABLE- 2
      IF (SENSE LIGHT 1) 1, 3                                           TABLE- 3
D  1  Y0(1) = ERFTS (0.5)                                               TABLE- 4
      DO 2  K = 2, 60                                                   TABLE- 5
D  2  Y0(K) = 0.                                                        TABLE- 6
D     Y0(61) = ERFCA (6.5)                                              TABLE- 7
D  3  H0 = 0.1                                                          TABLE- 8
D     X0I = H0 * FLOATF (I + 4)                                         TABLE- 9
D     H = X - X0I                                                       TABLE-10
      IF (Y0(I)) 10, 4, 9                                               TABLE-11
   4  J = I                                                             TABLE-12
      IF (J - 7) 5, 10, 7                                               TABLE-13
   5  J = J - 1                                                         TABLE-14
      IF (Y0(J)) 10, 5, 6                                               TABLE-15
D  6  X0J = H0 * FLOATF (J + 4)                                         TABLE-16
D     Y0J = Y0(J)                                                       TABLE-17
D     Y0(J + 1) = STINT (X0J, Y0J, H0)                                  TABLE-18
      J = J + 1                                                         TABLE-19
      IF (J - I) 6, 9, 10                                               TABLE-20
   7  J = J + 1                                                         TABLE-21
      IF (Y0(J)) 10, 7, 8                                               TABLE-22
D  8  X0J = H0 * FLOATF (J + 4)                                         TABLE-23
D     Y0J = Y0(J)                                                       TABLE-24
D     Y0(J - 1) = STINT (X0J, Y0J, -H0)                                 TABLE-25
      J = J - 1                                                         TABLE-26
      IF (J - I) 10, 9, 8                                               TABLE-27
D  9  Y0I = Y0(I)                                                       TABLE-28
D     TABLE = STINT (X0I, Y0I, H)                                       TABLE-29
      RETURN                                                            TABLE-30
  10  PRINT 11                                                          TABLE-31
  11 0 FORMAT(1H0, 27X, 74H  A MACHINE ERROR HAS OCCURRED IN TABLE WHILETABLE-32
     1 COMPUTING THE NEXT VALUE(S).)                                    TABLE-33
      RETURN                                                            TABLE-34
      END                                                                       
C STINT.-   TAYLOR-SERIES SUBTABULATION AND INTERPOLATION               STINT-ID
D     FUNCTION STINT (X0, Y0, H)                                        STINT- 1
D     DIMENSION Y (100), YH(100)                                        STINT- 2
D     ONE = 1.                                                          STINT- 3
D     TWO = 2.                                                          STINT- 4
D     CNORM = 1.128 3791 6709 5513                                      STINT- 5
C     CNORM = 2. / DSQRT (PI)                                           STINT- 6
D     TEST = 0.4E-19                                                    STINT- 7
C     TEST IS THE CONVERGENCE CRITERION. IT IS THE UPPER BOUND ON ABREL.STINT- 8
C     ABREL IS THE MAXIMUM VALUE OF THE RELATIVE MAGNITUDE OF THE       STINT- 9
C          REMAINDER AFTER N TERMS.                                     STINT-10
D     X0SQ = X0 * X0                                                    STINT-11
D     X0H = X0 + H                                                      STINT-12
D     X0HSQ = X0H * X0H                                                 STINT-13
D     Y(1) = CNORM * EXPF( -X0SQ)                                       STINT-14
D     YH(1) = CNORM * EXPF( -X0HSQ)                                     STINT-15
      IF (H) 2, 1, 3                                                    STINT-16
D  1  STINT = Y0                                                        STINT-17
      RETURN                                                            STINT-18
D  2  Y(1) = -Y(1)                                                      STINT-19
D     YH(1) = -YH(1)                                                    STINT-20
D  3  Y(2) = -TWO * X0 * Y(1)                                           STINT-21
D     YH(2) = -TWO * X0H * YH(1)                                        STINT-22
D     FACTOR = H * H / TWO                                              STINT-23
D     SUM = Y0 + Y(1) * H + Y(2) * FACTOR                               STINT-24
      DO 7  N = 3, 100                                                  STINT-25
D     TERMNO = N                                                        STINT-26
D     FACTOR = FACTOR * H / TERMNO                                      STINT-27
D     Y(N) = -TWO * (X0 * Y(N - 1) + (TERMNO - TWO) * Y(N - 2))         STINT-28
D     YH(N) = -TWO * (X0H * YH(N - 1) + (TERMNO - TWO) * YH(N - 2))     STINT-29
D     ABYN = ABSF (Y(N))                                                STINT-30
D     ABYHN = ABSF (YH(N))                                              STINT-31
D     ABRFAC = ABSF (FACTOR / SUM)                                      STINT-32
D     IF (ABYHN - ABYN) 5, 7, 4                                         STINT-33
D  4  ABREL = ABYHN * ABRFAC                                            STINT-34
      GO TO 6                                                           STINT-35
D  5  ABREL = ABYN * ABRFAC                                             STINT-36
C     ABREL IS THE MAXIMUM VALUE OF THE RELATIVE MAGNITUDE OF THE       STINT-37
C          REMAINDER AFTER N TERMS.                                     STINT-38
D  6  IF (ABREL - TEST) 9, 7, 7                                         STINT-39
D  7  SUM = SUM + Y(N) * FACTOR                                         STINT-40
      PRINT 8                                                           STINT-41
   8 0 FORMAT (1H0, 17X, 94H  ADEQUATE CONVERGENCE IN STINT FOR THE NEXTSTINT-42
     1 VALUE WAS NOT ATTAINED EVEN WITH 100 DERIVATIVES.)               STINT-43
D  9  STINT = SUM                                                       STINT-44
      RETURN                                                            STINT-45
      END                                                                       
C ERFCA.-   ASYMPTOTIC EXPANSION OF ERFC(X)                             ERFCA-ID
D     FUNCTION ERFCA(X)                                                 ERFCA- 1
D     ONE = 1.                                                          ERFCA- 2
D     TWO = 2.                                                          ERFCA- 3
      TEST = 0.4E-17                                                    ERFCA- 4
C     TEST IS THE CONVERGENCE CRITERION.  IT IS THE UPPER LIMIT         ERFCA- 5
C          ON THE RELATIVE MAGNITUDE OF THE LAST TERM.                  ERFCA- 6
      UNDFLO = 1.1E-38                                                  ERFCA- 7
C     UNDFLO IS THE TEST VALUE FOR THE OCCURENCE OF UNDERFLOW WITH SIZE.ERFCA- 8
D     XSQ = X * X                                                       ERFCA- 9
D     RTXSQ = ONE / (TWO * XSQ)                                         ERFCA-10
D     ODDNO = -ONE                                                      ERFCA-11
D     SIGN = ONE                                                        ERFCA-12
D     SIZE = ONE                                                        ERFCA-13
D     SUM = ONE                                                         ERFCA-14
      NMAX = XINTF(XSQ - 0.5) - 1                                       ERFCA-15
      DO 2  N = 1, NMAX                                                 ERFCA-16
D     ODDNO = ODDNO + TWO                                               ERFCA-17
D     SIGN = -SIGN                                                      ERFCA-18
D     RATIO = ODDNO * RTXSQ                                             ERFCA-19
D     SIZE = SIZE * RATIO                                               ERFCA-20
D     SUM = SUM + SIGN * SIZE                                           ERFCA-21
      RELMAG = SIZE / SUM                                               ERFCA-22
C     RELMAG IS THE RELATIVE MAGNITUDE OF THE LAST TERM.                ERFCA-23
      IF (RELMAG - TEST) 1, 2, 2                                        ERFCA-24
   1  IF (SIZE - UNDFLO) 4, 6, 6                                        ERFCA-25
   2  CONTINUE                                                          ERFCA-26
      PRINT 3                                                           ERFCA-27
   3 0 FORMAT (1H-, 4X, 124H  ADEQUATE CONVERGENCE IN ERFCA FOR THE NEXTERFCA-28
     1 VALUE WAS NOT ATTAINED, AND THE EXPANSION WAS TERMINATED WHEN DIVERFCA-29
     2ERGENCE BEGAN.)                                                   ERFCA-30
      GO TO 6                                                           ERFCA-31
   4  PRINT 5                                                           ERFCA-32
   5 0 FORMAT (1H-, 4X,  87H  ADEQUATE CONVERGENCE IN ERFCA FOR THE NEXTERFCA-33
     1 VALUE WAS NOT ATTAINED PRIOR TO UNDERFLOW.)                      ERFCA-34
D  6  A = (0.5641 8958 3547 7563 * EXPF(-XSQ) * SUM) / X                ERFCA-35
C          0.5641 8958 3547 7563 = 1. / DSQRT (PI)                      ERFCA-36
D     ERFCA = A                                                         ERFCA-37
      RETURN                                                            ERFCA-38
      END                                                                       
