CANE211      55 05042                                                   E2110001
C     LEAST SQUARE N-DIMENSIONAL SPHERE FIT USING ANZ013                E2110002
C                                                                       E2110003
      SUBROUTINE FCN(N,G,F,X,M1)                                        E2110004
C                                                                       E2110005
      DIMENSION G(6), X(6), COORD(6,150), COMP(6,150), DIST(150)        E2110006
C                                                                       E2110007
   10 IF (M1-2) 20, 50, 250                                             E2110008
C                                                                       E2110009
C     INPUT POINT COORDINATES                                           E2110010
C                                                                       E2110011
   20 READ 1000, NPOINT,IPRINT                                          E2110012
   30 DO 40 J=1,NPOINT                                                  E2110013
   40 READ 2000, (COORD(I,J),I=1,N)                                     E2110014
C                                                                       E2110015
C     EVALUATE FUNCTION                                                 E2110016
C                                                                       E2110017
   50 F1=0.0                                                            E2110018
   60 F2=0.0                                                            E2110019
   70 DO 140 J=1,NPOINT                                                 E2110020
   80 TERM=0.0                                                          E2110021
   90 DO 110 I=1,N                                                      E2110022
  100 COMP(I,J)=X(I)-COORD(I,J)                                         E2110023
  110 TERM=TERM+COMP(I,J)**2                                            E2110024
  120 F1=F1+TERM                                                        E2110025
  130 DIST(J)=SQRTF(TERM)                                               E2110026
  140 F2=F2+DIST(J)                                                     E2110027
  150 RADIUS=F2/FLOATF(NPOINT)                                          E2110028
  160 F=F1-RADIUS*F2                                                    E2110029
C                                                                       E2110030
C     COMPUTE GRADIENT VECTOR                                           E2110031
C                                                                       E2110032
  170 DO 230 I=1,N                                                      E2110033
  180 G1=0.0                                                            E2110034
  190 G2=0.0                                                            E2110035
  200 DO 220 J=1,NPOINT                                                 E2110036
  210 G1=G1+COMP(I,J)                                                   E2110037
  220 G2=G2+COMP(I,J)/DIST(J)                                           E2110038
  230 G(I)=2.0*(G1-RADIUS*G2)                                           E2110039
  240 RETURN                                                            E2110040
  250 WRITE OUTPUT TAPE 1, 3000,RADIUS                                  E2110041
  260 IF (IPRINT-1) 240,270,240                                         E2110042
C                                                                       E2110043
C     OPTIONALLY OUTPUT POINT COORDINATES AND DISTANCES FROM CENTER     E2110044
C                                                                       E2110045
  270 WRITE OUTPUT TAPE 1, 4000                                         E2110046
  280 DO 290 J=1,NPOINT                                                 E2110047
  290 WRITE OUTPUT TAPE 1, 5000, DIST(J), (COORD(I,J),I=1,N)            E2110048
  300 GO TO 240                                                         E2110049
 1000 FORMAT (2I6)                                                      E2110050
 2000 FORMAT (6E12.0)                                                   E2110051
 3000 FORMAT (25H0RADIUS OF FITTED SPHERE=1PE12.5)                      E2110052
 4000 FORMAT (43H0     DISTANCE         COORDINATES OF POINT)           E2110053
 5000 FORMAT (1H01PE14.5,3X,6E14.5)                                     E2110054
 5211 END (0,1,0,0,0)                                                   E2110055
