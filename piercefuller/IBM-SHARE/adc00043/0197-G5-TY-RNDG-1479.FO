      FUNCTION RANDG(X)                                                 RNDG0001
      IF(X-XOLD) 1,2,1                                                  RNDG0002
    2 X=RANDF(X)                                                        RNDG0003
      RANDG=Y                                                           RNDG0004
    3 RETURN                                                            RNDG0005
    1 ANGL=6.2831853*X                                                  RNDG0006
      X=RANDF(X)                                                        RNDG0007
      XOLD=X                                                            RNDG0008
      Z=SQRTF(-2.*LOGF(ABSF(X)-1.E-30))                                 RNDG0009
      Y=Z*COSF(ANGL)                                                    RNDG0010
      RANDG=Z*SINF(ANGL)                                                RNDG0011
      GO TO 3                                                           RNDG0012
      END                                                               RNDG0013
