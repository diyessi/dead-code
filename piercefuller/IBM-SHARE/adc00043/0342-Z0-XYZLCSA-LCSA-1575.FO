C                                 DIMENSION STATEMENT AND INPUT FORMATS STABL007
C                                                                       STABL008
      DIMENSION  X(6),Y(6),XU(3),YU(3),                                 STABL009
     1        F(6),FX(6),FY(6),G(6),GX(6),GY(6),TAUU(3),                STABL010
     2        PHIX(3),PHIY(3),OMEGAX(3),OMEGAY(3),XSIU(3),ETAU(3)       STABL011
      COMMON   X,Y,F,FX,FY,G,GX,GY,PRMTR1,PRMTR2,PRMTR3,PRMTR4,P,Q      STABL012
      COMMON PX,PY,QX,QY,PXX,PXY,PYY,QXX,QXY,QYY                        STABL013
