      JJ=1                                                              STABL043
      TETALC(JJ)=0.0                                                    STABL044
      FNO=NO                                                            STABL045
      DANGLE=2.0*3.141593/FNO                                           STABL046
      IF(ABSF(Y(1))-ABSF(X(1)))                          8000,8000,8001 STABL047
 8000 ANGLEO=ABSF(ATANF(Y(1)/X(1)))                                     STABL048
