*     DATA                                                              DATA1001
 VAN DER POL WITH LIAPUN FROM THE WRITE UP                              DATA1002
    0.100000    2.269385   10.000000   10.000000    0.010000    0.010000DATA1003
    0.001000    1.000000    0.000000    0.000000    0.000000  2000016400DATA1004
*     LIST                                                              EX1FN001
C                          VAN DER POL  EQUATION                        EX1FN002
                           SUBROUTINE FUNCT(K,J)                        EX1FN003
      DIMENSION  X(6),Y(6),XU(3),YU(3),                                 EX1FN004
     1        F(6),FX(6),FY(6),G(6),GX(6),GY(6),TAUU(3),                EX1FN005
     2        PHIX(3),PHIY(3),OMEGAX(3),OMEGAY(3),XSIU(3),ETAU(3)       EX1FN006
      COMMON   X,Y,F,FX,FY,G,GX,GY,PRMTR1,PRMTR2,PRMTR3,PRMTR4,P,Q      EX1FN007
      COMMON PX,PY,QX,QY,PXX,PXY,PYY,QXX,QXY,QYY                        EX1FN008
      COMMON XO,YO,PO,QO,PXO,PYO,QXO,QYO,XLC,YLC,DFDX,DFDY              EX1FN009
      DIMENSION XLC(100),YLC(100),TETALC(100),RADLC(100),A(100),B(100), EX1FN010
     1        XN(100),YN(100),XS(2000),YS(2000),ANGLS(2000)             EX1FN011
      P=Y(J)                                                            EX1FN012
        Q= PRMTR1*(1.0-X(J)**2.0)*Y(J) - X(J)                           EX1FN013
      PX=0.0                                                            EX1FN014
      PY=1.0                                                            EX1FN015
      QX=-PRMTR1*2.0*X(J)*Y(J)-1.0                                      EX1FN016
      QY=PRMTR1*(1.0-X(J)*X(J))                                         EX1FN017
      GO TO (10,10,30,30,50,60),K                                       EX1FN018
   10 F(J) = Q/P                                                        EX1FN019
      GO TO (50,100),K                                                  EX1FN020
   50  FX(J)=(QX*P-PX*Q)/P**2.0                                         EX1FN021
       FY(J)=(QY*P-PY*Q)/P**2.0                                         EX1FN022
      GO TO 100                                                         EX1FN023
   30  G(J)=P/Q                                                         EX1FN024
      GO TO (30,30,60,100),K                                            EX1FN025
   60 GX(J)= (PX*Q-QX*P)/Q**2.0                                         EX1FN026
      GY(J)= (PY*Q-QY*P)/Q**2.0                                         EX1FN027
  100 RETURN                                                            EX1FN028
      END                                                               EX1FN029
*     LIST                                                              LIAP1001
                             SUBROUTINE LIAPUN                          LIAP1002
      DIMENSION  X(6),Y(6),XU(3),YU(3),                                 LIAP1003
     1        F(6),FX(6),FY(6),G(6),GX(6),GY(6),TAUU(3),                LIAP1004
     2        PHIX(3),PHIY(3),OMEGAX(3),OMEGAY(3),XSIU(3),ETAU(3)       LIAP1005
      COMMON   X,Y,F,FX,FY,G,GX,GY,PRMTR1,PRMTR2,PRMTR3,PRMTR4,P,Q      LIAP1006
      COMMON PX,PY,QX,QY,PXX,PXY,PYY,QXX,QXY,QYY                        LIAP1007
      COMMON XO,YO,PO,QO,PXO,PYO,QXO,QYO,XLC,YLC,DFDX,DFDY              LIAP1008
      DIMENSION XLC(100),YLC(100),TETALC(100),RADLC(100),A(100),B(100), LIAP1009
     1        XN(100),YN(100),XS(2000),YS(2000),ANGLS(2000)             LIAP1010
      DFDX=X(2)-X(3)                                                    LIAP1011
      DFDY=Y(2)-Y(3)                                                    LIAP1012
      RETURN                                                            LIAP1013
      END                                                               LIAP1014
