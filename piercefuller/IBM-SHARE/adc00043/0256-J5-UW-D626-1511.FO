*     LABEL                                                             D626 000
      SUBROUTINE UWPLOT (DX,XL,DY,YT,YL,FMT,NCV,NPG,A,B,C,D,E,F,G,H,O,P)D626 001
      DIMENSION ROW(10,17),A(9),B(9),C(9),FMT(15),XSCL(11)              D626 002
B     BLNK=606060606060                                                 D626 003
B     DOT=606060606033                                                  D626 004
B     COMA=606060606073                                                 D626 005
B     STAR=606060606054                                                 D626 006
B     ZERO=606060606046                                                 D626 007
B     DOLAR=606060606053                                                D626 008
B     EX=606060606067                                                   D626 009
B     AMINS=606060606014                                                D626 010
B     EQUAL=606060606013                                                D626 011
B     QUEST=606060606061                                                D626 012
B     PLUS=606060606020                                                 D626 013
      NP=1                                                              D626 014
      XSCL(1)=XL                                                        D626 015
      LL=1                                                              D626 016
      NN=6                                                              D626 017
      CALL RTRN (NCV)                                                   D626 018
 2    WRITE OUTPUT TAPE6,7,NP                                           D626 019
      YSL=YT                                                            D626 020
      AMG=YT                                                            D626 021
 4    DO 8 I=1,10                                                       D626 022
      DO 6 J=1,17                                                       D626 023
B     ROW(I,J)=BLNK                                                     D626 024
 6    CONTINUE                                                          D626 025
 8    CONTINUE                                                          D626 026
      K=0                                                               D626 027
      CALL IMAGE (A,ROW,AMG,DOT,DY,LL,NN)                               D626 028
      K=K+1                                                             D626 029
      IF(NCV-K)14,14,10                                                 D626 030
 10   AMG=AMG+(10.0*DY)                                                 D626 031
      CALL IMAGE (B,ROW,AMG,STAR,DY,LL,NN)                              D626 032
      K=K+1                                                             D626 033
      IF(NCV-K)14,14,12                                                 D626 034
 12   AMG=AMG+(10.0*DY)                                                 D626 035
      CALL IMAGE(C,ROW,AMG,COMA,DY,LL,NN)                               D626 036
      K=K+1                                                             D626 037
      IF(NCV-K)14,14,22                                                 D626 038
 22   AMG=AMG+(10.0*DY)                                                 D626 039
      CALL IMAGE (D,ROW,AMG,ZERO ,DY,LL,NN)                             D626 040
      K=K+1                                                             D626 041
      IF(NCV-K)14,14,24                                                 D626 042
 24   AMG=AMG+(10.0*DY)                                                 D626 043
      CALL IMAGE (E,ROW,AMG,DOLAR,DY,LL,NN)                             D626 044
      K=K+1                                                             D626 045
      IF(NCV-K)14,14,26                                                 D626 046
 26   AMG=AMG+(10.0*DY)                                                 D626 047
      CALL IMAGE (F,ROW,AMG,EX   ,DY,LL,NN)                             D626 048
      K=K+1                                                             D626 049
      IF(NCV-K)14,14,28                                                 D626 050
 28   AMG=AMG+(10.0*DY)                                                 D626 051
      CALL IMAGE (G,ROW,AMG,AMINS,DY,LL,NN)                             D626 052
      K=K+1                                                             D626 053
      IF(NCV-K)14,14,30                                                 D626 054
 30   AMG=AMG+(10.0*DY)                                                 D626 055
      CALL IMAGE (H,ROW,AMG,EQUAL,DY,LL,NN)                             D626 056
      K=K+1                                                             D626 057
      IF(NCV-K)14,14,32                                                 D626 058
 32   AMG=AMG+(10.0*DY)                                                 D626 059
      CALL IMAGE (O,ROW,AMG,QUEST,DY,LL,NN)                             D626 060
      K=K+1                                                             D626 061
      IF(NCV-K)14,14,34                                                 D626 062
 34   AMG=AMG+(10.0*DY)                                                 D626 063
      CALL IMAGE (P,ROW,AMG,PLUS ,DY,LL,NN)                             D626 064
 14   WRITE OUTPUT TAPE 6,1,YSL,((ROW(I,J),J=1,17),I=1,1)               D626 065
      WRITE OUTPUT TAPE 6,3,((ROW(I,J),J=1,17),I=2,10)                  D626 066
      YSL=YSL-(DY*10.0)                                                 D626 067
      IF(AMG-YL)16,16,4                                                 D626 068
 16   WRITE OUTPUT TAPE 6,5,YSL                                         D626 069
      DO 18 I=2,11                                                      D626 070
      XSCL(I)=XSCL(I-1)+(DX*10.0)                                       D626 071
 18   CONTINUE                                                          D626 072
      WRITE OUTPUT TAPE 6,9,(XSCL(I),I=1,11)                            D626 073
      WRITE OUTPUT TAPE 6,FMT                                           D626 074
      XSCL(1)=XSCL(11)                                                  D626 075
      NP=NP+1                                                           D626 076
      LL=LL+100                                                         D626 077
      NN=LL+5                                                           D626 078
      IF(NPG-NP)20,2,2                                                  D626 079
 20   RETURN                                                            D626 080
 1    FORMAT(1H F9.2,1H-,17A6)                                          D626 081
 3    FORMAT(1H 9X,1H+,17A6)                                            D626 082
 5    FORMAT(1H F9.2,103HI+++++++++I+++++++++I+++++++++I+++++++++I++++++D626 083
     1+++I+++++++++I+++++++++I+++++++++I+++++++++I+++++++++I++)         D626 084
 7    FORMAT(1H1,96X,I3)                                                D626 085
 9    FORMAT(1H F12.2,10F10.2)                                          D626 086
      END                                                               D626 087
*     LABEL                                                             D626 088
      SUBROUTINE IMAGE (A,ROW,AMG,SMBL,DY,LL,NN)                        D626 089
      DIMENSION ROW(10,17),A(9)                                         D626 090
      PM=DY/2.0                                                         D626 091
      DO 14 L=1,10                                                      D626 092
      M=LL                                                              D626 093
      N=NN                                                              D626 094
      DO 12 J=1,17                                                      D626 095
      K=0                                                               D626 096
      DO 10 I=M,N                                                       D626 097
      IF(A(I)-(AMG+PM))4,6,8                                            D626 098
 4    IF(A(I)-(AMG-PM))8,8,6                                            D626 099
B6    WORD=ROW(L,J)                                                     D626 100
      CALL CURVN (WORD,SMBL,K)                                          D626 101
B     ROW(L,J)=WORD                                                     D626 102
 8    K=K+6                                                             D626 103
 10   CONTINUE                                                          D626 104
      M=N+1                                                             D626 105
      N=N+6                                                             D626 106
 12   CONTINUE                                                          D626 107
      AMG=AMG-DY                                                        D626 108
 14   CONTINUE                                                          D626 109
 16   RETURN                                                            D626 110
      END                                                               D626 111
