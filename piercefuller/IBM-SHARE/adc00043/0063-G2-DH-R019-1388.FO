 165  X(LS) = LOGF(X(LS)) * .434294482                                  R19 0207
 194  IF(IA(11)) 167,167,166                                            R19 0208
 166  IF(Y) 43,43,167                                                   R19 0209
 167  CONTINUE                                                          R19 0210
      KB = 2                                                            R19 0211
      DO 40 KC = 1,NE                                                   R19 0212
      IF(I(KC)) 168, 40,168                                             R19 0213
 168  P(1) = X(KC)                                                      R19 0214
      IF (JA(KC)-1) 36,36,37                                            R19 0215
 36   YC = P(1)*S(KB)+YC                                                R19 0216
      KB = KB+1                                                         R19 0217
      GO TO 40                                                          R19 0218
 37   L = JA(KC)                                                        R19 0219
      DO 38 K = 2,L                                                     R19 0220
 38   P(K) = P(1)*P(K-1)                                                R19 0221
      DO 39 K = 1,L                                                     R19 0222
      YC = YC + P(K)*S(KB)                                              R19 0223
 39   KB = KB+1                                                         R19 0224
 40   CONTINUE                                                          R19 0225
      IF(IA(11)) 42,42,41                                               R19 0226
 41   YC = EXPF(YC/.434294482)                                          R19 0227
 42   DA = Y-YC                                                         R19 0228
      D = D + DA**2                                                     R19 0229
      WRITE OUTPUT TAPE 3,113,Y,YC,DA                                   R19 0230
      SIGMAY = (Y-A)**2.+SIGMAY                                         R19 0231
 43   CONTINUE                                                          R19 0232
      DA = D                                                            R19 0233
      D = SQRTF(D/(Z - FLOATF(KA)))                                     R19 0234
      WRITE OUTPUT TAPE 3,106,D                                         R19 0235
      Y = 1. - (DA/SIGMAY) * (Z - 1.)/(Z - FLOATF(KA))                  R19 0236
      IF(Y) 170,171,171                                                 R19 0237
 170  DIVB = 0.                                                         R19 0238
      GO TO 172                                                         R19 0239
 171  DIVB = SQRTF(Y)                                                   R19 0240
