      KA = KA+1                                                         R19 0112
 18   S(KA) = P(K)                                                      R19 0113
 19   CONTINUE                                                          R19 0114
      S(KA+1) = Y                                                       R19 0115
      L = KA+1                                                          R19 0116
      DO 22 J = 1,L                                                     R19 0117
 22   B(1,J) = B(1,J)+S(J)                                              R19 0118
      DO 24 K = 2,KA                                                    R19 0119
      DO 23 KB = 1,L                                                    R19 0120
 23   B(K,KB) = B(K,KB)+S(K)*S(KB)                                      R19 0121
