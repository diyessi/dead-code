      S(KA) = B(KA,L)                                                   R19 0168
      KC = KA-1                                                         R19 0169
      DO 34 J = 1,KC                                                    R19 0170
      K = KA-J                                                          R19 0171
      P(1) = 0.                                                         R19 0172
      DO 32 KB = K,KC                                                   R19 0173
 32   P(1) = P(1)+B(K,KB+1)*S(KB+1)                                     R19 0174
      S(K) = B(K,L)-P(1)                                                R19 0175
 34   CONTINUE                                                          R19 0176
 470  WRITE OUTPUT TAPE 3,108,NUM                                       R19 0177
      WRITE OUTPUT TAPE 3,114                                           R19 0178
      WRITE OUTPUT TAPE 3,115                                           R19 0179
      WRITE OUTPUT TAPE 3,116,(I(J),J = 1,10)                           R19 0180
      IF(SENSE LIGHT 1) 344,343                                         R19 0181
