      WRITE OUTPUT TAPE 3,112                                           R19 0197
      SIGMAY = 0.                                                       R19 0198
      D = 0.                                                            R19 0199
      DO 43 JB = 1,M                                                    R19 0200
      YC = S(1)                                                         R19 0201
      READ INPUT TAPE 5,102,Y,(X(J),J = 1,NE)                           R19 0202
      DO 167 LS = 1,NE                                                  R19 0203
      IF( I(LS)   ) 167,167,163                                         R19 0204
 163  IF(IA(LS)) 194,194,164                                            R19 0205
