C     NON-LINEAR MULTIPLE CORRELATION PROGRAM     ROY HARDY             R19 0001
 100  FORMAT (11I1,I1,I3)                                               R19 0002
 101  FORMAT (I3, I2, 10I1)                                             R19 0003
 102  FORMAT (6F12.10)                                                  R19 0004
 103  FORMAT(114H0POLYNOMIAL COEFFICIENTS,THE FIRST TERM IS THE CONSTANTR19 0005
     1 TERM.THE FOLLOWING TERMS ARE X(1)**1,X(1)**2,ETC.,X(2)**1,)      R19 0006
 104  FORMAT(60H0X(2)**2,ETC.,UP TO X(N)**J AS SPECIFIED IN THE CONTROL R19 0007
     1CARD)                                                             R19 0008
 105  FORMAT(1H08E15.7)                                                 R19 0009
 106  FORMAT (34H0STANDARD ERROR OF ESTIMATE EQUALS F12.5)              R19 0010
 107  FORMAT(40H0INDEX OF MULTIPLE DETERMINATION EQUALS F9.7/38H0INDEX OR19 0011
     1F MULTIPLE CORRELATION EQUALS F9.7)                               R19 0012
 108  FORMAT(9H1PROBLEM I2)                                             R19 0013
 109  FORMAT(10I1)                                                      R19 0014
 110  FORMAT(36H0Y IS NEG. OR ZERO IN LOG CONVERSION)                   R19 0015
 111  FORMAT (11H0THERE ARE I2,23H VARIABLES IN THIS CASE)              R19 0016
 112  FORMAT (47H0      Y                YC                 DEV.)       R19 0017
 113  FORMAT (1H0F12.5,F17.7,F20.8)                                     R19 0018
 114  FORMAT(93H0IN THE LIST BELOW,1 MEANS THAT IND VAR IS INCLUDED,0 MER19 0019
     1ANS IT IS EXCLUDED IN THE CORRELATION)                            R19 0020
 115  FORMAT (31H0X1 X2 X3 X4 X5 X6 X7 X8 X9 X10)                       R19 0021
 116  FORMAT (1H0I2,9I3)                                                R19 0022
 117  FORMAT(3H0X( I2,35H) IS NEG. OR ZERO IN LOG CONVERSION)           R19 0023
 118  FORMAT (I2)                                                       R19 0024
 119  FORMAT( 91H0THIS CASE IS DEGENERATE. THE MATRIX IS SINGULAR. SOME R19 0025
     1OF THE IND. VARIABLES ARE DEPENDENT.)                             R19 0026
 120  FORMAT(20H0INSUFFICIENT POINTS)                                   R19 0027
 121  FORMAT(19H0TOO MANY VARIABLES)                                    R19 0028
 122  FORMAT(3HEOF)                                                     R19 0029
 123  FORMAT(18H0TURN SWITCH 5 OFF)                                     R19 0030
      DIMENSION IA(11), JA(10), B(41,42),X(10),S(42),P(4),I(10)         R19 0031
