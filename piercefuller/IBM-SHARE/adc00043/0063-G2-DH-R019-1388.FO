      B(K,KB) = B(K,KB)/DIVB                                            R19 0158
      IF QUOTIENT OVERFLOW 210,27                                       R19 0159
 27   CONTINUE                                                          R19 0160
      IF (KA-J) 31,31,28                                                R19 0161
 28   CONTINUE                                                          R19 0162
      DO 30 K = LS,KA                                                   R19 0163
      DO 29 KB = J,L                                                    R19 0164
 29   B(K,KB) = B(J,KB)-B(K,KB)                                         R19 0165
