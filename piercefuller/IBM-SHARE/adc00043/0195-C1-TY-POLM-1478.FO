      SUBROUTINE POLMY(N,X,Y,A)                                         POLM0001
C                                                                       POLM0002
      DIMENSION A(1),X(1),Y(1)                                          POLM0003
C                                                                       POLM0004
   00 J=N                                                               POLM0005
      N1=J-1                                                            POLM0006
      ASSIGN 20 TO IMAG                                                 POLM0007
   01 IF (XLOCF(X)-XLOCF(Y)) 02,111,02                                  POLM0008
   02 ASSIGN 30 TO IMAG                                                 POLM0009
      GO TO 111                                                         POLM0010
C                                                                       POLM0011
   10 P=-X(J)                                                           POLM0012
      R=Y(J)                                                            POLM0013
      A(J)=1.0                                                          POLM0014
      GO TO IMAG, (20,30)                                               POLM0015
C                                                                       POLM0016
   20 IF (N1-J) 23,21,21                                                POLM0017
   21 DO 22 I=J,N1                                                      POLM0018
   22   A(I)=A(I+1)+P*A(I)                                              POLM0019
   23 A(N1+1)= P*A(N1+1)                                                POLM0020
      J=J-1                                                             POLM0021
  111 IF (J) 50,60,10                                                   POLM0022
C                                                                       POLM0023
   30 IF (R) 31,20,31                                                   POLM0024
   31 IF (R+Y(J-1)) 50,32,50                                            POLM0025
   32 IF (P+X(J-1)) 50,40,50                                            POLM0026
C                                                                       POLM0027
   40 R=R*R+P*P                                                         POLM0028
      P=P+P                                                             POLM0029
      A(J-1)=0.0                                                        POLM0030
   41 IF (N1-J) 44,42,42                                                POLM0031
   42 DO 43 I=J,N1                                                      POLM0032
   43   A(I-1)=A(I+1)+P*A(I)+R*A(I-1)                                   POLM0033
   44 A(N1)= P*A(N1+1)+R*A(N1)                                          POLM0034
      A(N1+1)=R*A(N1+1)                                                 POLM0035
      J=J-2                                                             POLM0036
      GO TO 111                                                         POLM0037
C                                                                       POLM0038
   50 N1=J-1                                                            POLM0039
      WRITE OUTPUT TAPE 6,51,N1,J                                       POLM0040
   51 FORMAT(19H IN POLMY, ZERO NO.,I6,25H  IS NOT CONJUGATE TO NO.,I6) POLM0041
      CALL UNCLE                                                        POLM0042
   60 RETURN                                                            POLM0043
C                                                                       POLM0044
      FREQUENCY 01(0,1,0),20(1,10,10),30(1,10,1),31(0,1,0),32(0,1,0),   POLM0045
     1          41(1,10,10)                                             POLM0046
      END                                                               POLM0047
