*      FAP                   DSQT F           VERSION 2                 DSQT0001
       COUNT                 D SQRT F                                   DSQT0002
       ENTRY   DSQRT         D SQRTF(X)=X/ABSF(X)**(1/2)                DSQT0003
 DSQRT CLA     X1            (X1,X2)=X IN DOUBLE PRECISION,             DSQT0004
       TNZ     NOT0          WHERE X=(2**(2I-J))*F , J=0 OR 1           DSQT0005
       STO     X2                                                       DSQT0006
       LDQ     X2                                                       DSQT0007
       TRA     1,4           QUICK EXIT IF X=0.0                        DSQT0008
 NOT0  ACL     EXP           =128+1         B8                          DSQT0009
       LGR     28            AC=(128+2I-J+128+1)/2         B35          DSQT0010
       STO     I             =128+I         B35       WITH SIGN         DSQT0011
       SXA     AXT,4                                                    DSQT0012
       AXT     1,4                                                      DSQT0013
       TQP     ODD           MQ SIGN DIGIT = 1-J                        DSQT0014
 EVEN  AXT     0,4           XR4 = J                                    DSQT0015
 ODD   LDQ     X2                                                       DSQT0016
       LLS     8                                                        DSQT0017
       CLA     X1                                                       DSQT0018
       ANA     MASK          (AC,MQ) = F                   B8           DSQT0019
       LLS     6,4              *2**(6-J)                               DSQT0020
       SLW     X1            SET SIGN POSITIVE AND SET                  DSQT0021
       STQ     X2            (X1,X2) = (2**(-J))*F         B2           DSQT0022
       LAS     RTHAF,4       COMPARE X1 WITH .5**(J+.5)    B2           DSQT0023
 HI    TXI     LO,4,2        IF HI, ADD 2 TO XR4                        DSQT0024
       TRA     LO                                                       DSQT0025
 LO    ACL     C,4                                                      DSQT0026
       SLW     R             =X1+C                         B2           DSQT0027
       CLA     B,4                                                      DSQT0028
       VDH     R,0,17        MAY HANG UP IF X NOT NORMALIZED    B19     DSQT0029
       RQL     17                                                       DSQT0030
 CLEAR XCA                                                              DSQT0031
       SUB     A,4                                         B2           DSQT0032
       SLW     R             =A-B/(X1+C) = 1ST APPROX.,    B2           DSQT0033
       CLA     X1              WITH REL. ERROR LESS THAN .5E-4          DSQT0034
       LDQ     CLEAR         MQ ALMOST = 0                              DSQT0035
       LRS     2                                           B4           DSQT0036
       DVH     R                                           B2           DSQT0037
       XCA                                                              DSQT0038
       ADD     R             AC=(R+X1/R)/2=2ND APPROX.,    B1           DSQT0039
       STO     R               WITH REL. ERROR LESS THAN .2E-8          DSQT0040
       CLA     X1                                                       DSQT0041
       LDQ     X2            AC=(X1,X2)                    B2           DSQT0042
       DVH     R                       /R                  B1           DSQT0043
       XCA                                                              DSQT0044
       ADD     R                         +R                B1           DSQT0045
 MIN27 XCA     32768-27                                                 DSQT0046
       STQ     X1            =((R+X/R)/2)1                 B0           DSQT0047
       VDH     R,0,20                                                   DSQT0048
       RQL     7             MQ=((R+X/R)/2)2               BQ0          DSQT0049
       CLA     I                                                        DSQT0050
       ACL     MIN27         AC=128+I-27    B35       WITH SIGN         DSQT0051
       LRS     8                                                        DSQT0052
       STQ     X2            =DSQRTF(X)2                                DSQT0053
       CLA     I                                                        DSQT0054
       LDQ     X1                                                       DSQT0055
       LRS     8                                                        DSQT0056
       STQ     X1            =DSQRTF(X)1    WITH SIGN                   DSQT0057
       XCA                                                              DSQT0058
       LDQ     X2            WITH REL. ERROR AT MOST 2**(-53)           DSQT0059
 AXT   AXT     **,4            IF X IS NORMALIZED.                      DSQT0060
       TRA     1,4               TAKES 139 CYCLES.                      DSQT0061
 EXP   OCT     201000000000                                             DSQT0062
 MASK  OCT     000777777777                                             DSQT0063
       DEC     0.707106781B3       XR4=1 WHEN 1/4.LE.X.LT.1/2           DSQT0064
 RTHAF DEC     0.707106781B2           0      1/2.LE.X.LT.1             DSQT0065
       DEC     1.26371224B2  XR4=3 WHEN 2**(-3/2).LE.X.LT.1/2           DSQT0066
       DEC     2.52742448B2      2      2**(-1/2).LE.X.LT.1             DSQT0067
       DEC     0.89357950B2      1      1/4.LE.X.LT.2**(-3/2)           DSQT0068
 C     DEC     1.78715900B2      0      1/2.LE.X.LT.2**(-1/2)           DSQT0069
       DEC     2.19023538B3                                             DSQT0070
       DEC     6.19492120B3                                             DSQT0071
       DEC     1.30232175B3                                             DSQT0072
 B     DEC     3.68352217B3                                             DSQT0073
       DEC     1.94891070B2                                             DSQT0074
       DEC     2.75617594B2                                             DSQT0075
       DEC     1.63883202B2                                             DSQT0076
 A     DEC     2.31765845B2                 74 LOCATIONS                DSQT0077
       COMMON  -206                                                     DSQT0078
 X1    COMMON  1             ARGUMENTS 77777-6                          DSQT0079
 X2    COMMON  1             WORK SPACE 77775-4                         DSQT0080
 I     COMMON  1                                                        DSQT0081
 R     COMMON  1                            V.KAHAN        JULY 8, 1963 DSQT0082
       END                                                              DSQT0083
