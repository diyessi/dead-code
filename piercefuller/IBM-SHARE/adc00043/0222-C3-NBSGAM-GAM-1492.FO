*     NBS GAM                                                           GAM00000
      FUNCTION GAMMA(X)                                                 GAM00001
   75 FORMAT(53H GAMMA FUNCTION OF A NEGATIVE INTEGER IS NOT DEFINED.)  GAM00002
    5 IF(X) 10,24,15                                                    GAM00003
   10 N=-X                                                              GAM00004
      EN=-N-1                                                           GAM00005
      V=X-EN                                                            GAM00006
      IF(V-1.)20, 80, 20                                                GAM00007
   15 N=X                                                               GAM00008
      EN=N                                                              GAM00009
      V=X-EN                                                            GAM00010
   20 GAMMA=1.+V*(.42278434 +V*(.41184025  +V*(.081578219  +V*          GAM00011
     1(.074237908  +V*(-.00021090747  +V*(.010973696  +V*(-.002466748   GAM00012
     2+V*(.0015397681  -V*(.00034423420  -V*.000067710571  )))))))))    GAM00013
      IF(EN-2.) 37,25,30                                                GAM00014
   24 GAMMA=1.                                                          GAM00015
   25 RETURN                                                            GAM00016
   30 N=N-1                                                             GAM00017
      DO 35 I=2,N                                                       GAM00018
      FI=I                                                              GAM00019
   35 GAMMA=GAMMA*(FI+V)                                                GAM00020
      RETURN                                                            GAM00021
   37 N=2.-EN                                                           GAM00022
      DO 40 I=1,N                                                       GAM00023
      FI=2-I                                                            GAM00024
   40 GAMMA=GAMMA/(FI+V)                                                GAM00025
      RETURN                                                            GAM00026
   80 WRITE OUTPUT TAPE 6,75                                            GAM00027
      CALL EXIT                                                         GAM00028
      RETURN                                                            GAM00029
      END                                                               GAM00030
