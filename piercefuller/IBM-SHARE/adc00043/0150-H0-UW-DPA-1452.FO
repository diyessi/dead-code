CDPA          DIAGONAL MODEL PORTFOLIO ANALYSIS CODE                    DPA 0001
C             W.F. SHARPE,  UNIV. OF WASHINGTON                         DPA 0002
C         709/7090 VERSION                                              DPA 0003
C          PROGRAM WILL RUN ON 40K 1620 WITH FOLLOWING CHANGES          DPA 0004
C           1.  CHANGE INPUT STATEMENTS (CARDS 28,30,32 AND 44 )        DPA 0005
C           2.  CHANGE OUTPUT STATEMENTS (CARDS 29,31,40-42,46,48,49,   DPA 0006
C               104,110,112-114,199-202,211-214,218,220 AND 221 )       DPA 0007
C           3.  CHANGE CALL EXIT STATEMENTS (CARDS 47 AND 224 )         DPA 0008
C           4.  REDUCE DIMENSIONS (CARDS 10 AND 11) TO 80               DPA 0009
      DIMENSION AZ(2000),BZ(2000),QZ(2000),AB(2000),DB(2000)            DPA 0010
      DIMENSION BB(2000),ZI(2000),X(2000),T(2000),U(2000)               DPA 0011
 100  FORMAT ( 2F10.0 )                                                 DPA 0012
 101  FORMAT(43H INTEREST RATE AT WHICH FUNDS CAN BE LENT  ,F8.3)       DPA 0013
 102  FORMAT(48H INTEREST RATE AT WHICH FUNDS CAN BE BORROWED   ,F8.3)  DPA 0014
 103  FORMAT(55H NO     SECURITY                A         B          Q )DPA 0015
 104  FORMAT(1H I4,24H                          ,3F10.5 )               DPA 0016
 105  FORMAT (I5)                                                       DPA 0017
 107  FORMAT(12H EXP RETURN , F8.4,9H  ST DEV ,F8.4,11H ASSOC INT ,F8.4)DPA 0018
 108  FORMAT(17H PORT. 2 THROUGH ,I2,25H NOT SHOWN, INT. EXCEEDS ,F8.5) DPA 0019
 109  FORMAT(43H LENDING PORTFOLIO (NOT A CORNER PORTFOLIO) )           DPA 0020
 110  FORMAT(43H SLOPE OF E,V CURVE AT THIS POINT (DV/DE)   ,F8.5)      DPA 0021
 111  FORMAT(26H CORNER PORTFOLIO NUMBER   ,I3)                         DPA 0022
 112  FORMAT(8H INVEST ,F8.2,21H PERCENT IN SECURITY ,I5)               DPA 0023
 113  FORMAT (2H  )                                                     DPA 0024
 114  FORMAT(50H                                                    )   DPA 0025
 115  FORMAT (49H  NON-POSITIVE VALUE OF Q PROGRAM CANNOT CONTINUE )    DPA 0026
 116  FORMAT (42H DIAGONAL MODEL PORTFOLIO ANALYSIS - UWDPA )           DPA 0027
      WRITE OUTPUT TAPE 6, 116                                          DPA 0028
      READ INPUT TAPE 5,114                                             DPA 0029
      WRITE OUTPUT TAPE 6, 114                                          DPA 0030
      READ INPUT TAPE 5, 105, M                                         DPA 0031
      READ INPUT TAPE 5, 100, Y1, Y2                                    DPA 0032
      IF (Y1)201, 201, 202                                              DPA 0033
 201  Y1 = 1.0                                                          DPA 0034
 202  IF (Y2) 203,203,204                                               DPA 0035
 203  Y2 = 1000.0                                                       DPA 0036
 204  NUM = 1                                                           DPA 0037
      NHA = 0                                                           DPA 0038
      NSA = 0                                                           DPA 0039
      WRITE OUTPUT TAPE 6,101, Y1                                       DPA 0040
      WRITE OUTPUT TAPE 6,102, Y2                                       DPA 0041
      WRITE OUTPUT TAPE 6,103                                           DPA 0042
      DO 221 I = 1,M                                                    DPA 0043
      READ INPUT TAPE 5, 104, IM, AZ(I), BZ(I), QZ(I)                   DPA 0044
      IF (QZ(I) ) 220, 220, 221                                         DPA 0045
 220  WRITE OUTPUT TAPE 6, 115                                          DPA 0046
      CALL EXIT                                                         DPA 0047
 221  WRITE OUTPUT TAPE 6, 104,I,AZ(I),BZ(I), QZ(I)                     DPA 0048
      WRITE OUTPUT TAPE 6,113                                           DPA 0049
      NSEC = M-1                                                        DPA 0050
      N1 = M                                                            DPA 0051
      N2 = M+1                                                          DPA 0052
      N3 = M+2                                                          DPA 0053
      BZ(N1) = -1.                                                      DPA 0054
      DO 250 I = 1,N1                                                   DPA 0055
      AB(I) = AZ(I)/QZ(I)                                               DPA 0056
      BB(I) = BZ(I)/QZ(I)                                               DPA 0057
 250  DB(I) = 1.0/QZ(I)                                                 DPA 0058
      DB(N1) = 0.0                                                      DPA 0059
      YME = 0.0                                                         DPA 0060
      DO 253 I = 1,NSEC                                                 DPA 0061
      E = AZ(I) + BZ(I)*AZ(N1)                                          DPA 0062
      IF (E-YME) 253, 253, 252                                          DPA 0063
 252  YME = E                                                           DPA 0064
      KME = I                                                           DPA 0065
 253  CONTINUE                                                          DPA 0066
      DO 270 I = 1,NSEC                                                 DPA 0067
 270  ZI(I) = 0.0                                                       DPA 0068
      ZI(KME) = 1.0                                                     DPA 0069
      ZI(N1) = 1.0                                                      DPA 0070
      ZL = DB(KME)                                                      DPA 0071
      ZN = DB(KME)*BZ(KME)                                              DPA 0072
      ZP = ((BZ(KME)**2)/QZ(KME))+1.0/QZ(N1)                            DPA 0073
      SB = AZ(KME)*BB(KME) + AZ(N1)*BB(N1)                              DPA 0074
      SD = AZ(KME)*DB(KME)                                              DPA 0075
      T(KME) = 1.0                                                      DPA 0076
      T(N1) = BZ(KME)                                                   DPA 0077
      Z1 = ZP/(ZP*ZL-ZN**2)                                             DPA 0078
      Z2 = -ZN/(ZP*ZL-ZN**2)                                            DPA 0079
      Z3 = 1.0/ZN                                                       DPA 0080
      Z4 = -(Z1*ZL)/ZN                                                  DPA 0081
      Z5 = -(Z2*ZL) /ZN                                                 DPA 0082
      Z6 = Z3 + Z4                                                      DPA 0083
      T(N3) = -Z6                                                       DPA 0084
      T(N2) = -Z1                                                       DPA 0085
      U(N3) = Z6*SD + Z5*SB                                             DPA 0086
      U(N2) = Z1*SD + Z2*SB                                             DPA 0087
      ZMX = 0.0                                                         DPA 0088
      KMX = KME-1                                                       DPA 0089
      KP = KME + 1                                                      DPA 0090
      DO 276 I=1,KMX                                                    DPA 0091
      ZRM = (T(N2)+ BZ(I)*T(N3))/(AZ(I)-U(N2)-BZ(I)*U(N3))              DPA 0092
      IF (ZRM - ZMX ) 276, 276, 275                                     DPA 0093
 275  ZMX = ZRM                                                         DPA 0094
      KG = I                                                            DPA 0095
 276  CONTINUE                                                          DPA 0096
      DO 278 I = KP, NSEC                                               DPA 0097
      ZRM = ( T(N2) + BZ(I)*T(N3)) / ( AZ(I)-U(N2)-BZ(I)*U(N3))         DPA 0098
      IF (ZRM-ZMX) 278,278,277                                          DPA 0099
 277  ZMX = ZRM                                                         DPA 0100
      KG = I                                                            DPA 0101
 278  CONTINUE                                                          DPA 0102
      ZME = ZMX                                                         DPA 0103
      WRITE OUTPUT TAPE 6,111,NUM                                       DPA 0104
      E = YME                                                           DPA 0105
      VAR = QZ(KME) + (BZ(KME)**2)*QZ(N1)                               DPA 0106
      SDEV = VAR**.5                                                    DPA 0107
      Z2M = 2.0*ZME                                                     DPA 0108
      ZIR = E-(2.0*VAR)/Z2M                                             DPA 0109
      WRITE OUTPUT TAPE 6, 107,E,SDEV,ZIR                               DPA 0110
      HUND = 100.                                                       DPA 0111
      WRITE OUTPUT TAPE 6, 112, HUND, KME                               DPA 0112
      WRITE OUTPUT TAPE 6, 113                                          DPA 0113
      WRITE OUTPUT TAPE 6,113                                           DPA 0114
      GO TO 300                                                         DPA 0115
 299  IF (ZI(KG))300,300,400                                            DPA 0116
 300  ZL = ZL + DB(KG)                                                  DPA 0117
      ZN = ZN + BB(KG)                                                  DPA 0118
      ZP = ZP + (BZ(KG)**2)/QZ(KG)                                      DPA 0119
      SD = SD + AZ(KG)*DB(KG)                                           DPA 0120
      SB = SB + AZ(KG)* BB(KG)                                          DPA 0121
      ZI(KG) = 1.0                                                      DPA 0122
      GO TO 500                                                         DPA 0123
 400  ZL = ZL - DB(KG)                                                  DPA 0124
      ZN = ZN - BB(KG)                                                  DPA 0125
      ZP = ZP - (BZ(KG)**2)/QZ(KG)                                      DPA 0126
      SD = SD - AZ(KG) * DB(KG)                                         DPA 0127
      SB = SB - AZ(KG)*BB(KG)                                           DPA 0128
      ZI(KG) = 0.0                                                      DPA 0129
 500  Z1 = ZP/(ZP*ZL-ZN**2)                                             DPA 0130
      Z2 = -ZN/(ZP*ZL-ZN**2)                                            DPA 0131
      Z3 = 1.0/ZN                                                       DPA 0132
      Z4 = -(Z1 * ZL)/ZN                                                DPA 0133
      Z5 = -(Z2*ZL)/ZN                                                  DPA 0134
      Z6 = Z3 + Z4                                                      DPA 0135
      T(N3) = -Z6                                                       DPA 0136
      T(N2) = -Z1                                                       DPA 0137
      U(N3) = Z6*SD + Z5*SB                                             DPA 0138
      U(N2) = Z1*SD + Z2*SB                                             DPA 0139
      DO 524 I=1,N1                                                     DPA 0140
      IF (ZI(I)) 520,520,522                                            DPA 0141
 520  T(I) = 0.0                                                        DPA 0142
      U(I) = 0.0                                                        DPA 0143
      GO TO 524                                                         DPA 0144
 522  T(I) = Z1*DB(I) + Z6*BB(I)                                        DPA 0145
      R=AB(I)-SD*(Z1*DB(I)+Z6*BB(I))                                    DPA 0146
      S=SB*(Z2*DB(I)+Z5*BB(I))                                          DPA 0147
      U(I)=R-S                                                          DPA 0148
 524  CONTINUE                                                          DPA 0149
      ZMX = 0.0                                                         DPA 0150
      KGX = KG                                                          DPA 0151
      DO 570 I=1,NSEC                                                   DPA 0152
      IF (ZI(I))560,560,550                                             DPA 0153
 550  ZRM = -T(I)/U(I)                                                  DPA 0154
      IF (ZRM-ZME)552,570,570                                           DPA 0155
 552  IF(ZRM-ZMX)570,570,553                                            DPA 0156
 553  IF(I-KGX)554,570,554                                              DPA 0157
 554  ZMX = ZRM                                                         DPA 0158
      KG = I                                                            DPA 0159
      GO TO 570                                                         DPA 0160
 560  ZRM = (T(N2)+BZ(I)*T(N3))/(AZ(I)-U(N2)-BZ(I)*U(N3))               DPA 0161
      IF(ZRM-ZME)561,570,570                                            DPA 0162
 561  IF(ZRM-ZMX)570,570,562                                            DPA 0163
 562  IF(I-KGX)563,570,563                                              DPA 0164
 563  ZMX = ZRM                                                         DPA 0165
      KG = I                                                            DPA 0166
 570  CONTINUE                                                          DPA 0167
      Z1AM = ZME                                                        DPA 0168
      IF(ZMX)685,685,580                                                DPA 0169
 580  ZME = ZMX                                                         DPA 0170
      ELT = E                                                           DPA 0171
      E = 0.0                                                           DPA 0172
      VAR = 0.0                                                         DPA 0173
      DO 600 I = 1, N1                                                  DPA 0174
      X(I) = T(I)+U(I)*ZME                                              DPA 0175
      VAR = VAR + QZ(I)*(X(I)**2)                                       DPA 0176
 600  E = E + X(I)*AZ(I)                                                DPA 0177
      SDEV = VAR**.5                                                    DPA 0178
      Z2M = 2.0*ZME                                                     DPA 0179
      ZIR = E-(2.0*VAR)/Z2M                                             DPA 0180
      IF (ZIR-Y1) 602,602,614                                           DPA 0181
 602  CX = (Z1AM-ZME)/(ELT-E)                                           DPA 0182
      BX = 2.0*(ZME-CX*E)                                               DPA 0183
      AX = VAR-BX*E-CX*(E**2)                                           DPA 0184
      EINT  = -(2.0*AX + BX*Y1)/(2.0*CX*Y1 +BX)                         DPA 0185
      Z7L = BX*.5+CX*EINT                                               DPA 0186
      NHA = 1                                                           DPA 0187
      EX = 0.0                                                          DPA 0188
      SX = 0.0                                                          DPA 0189
      VX = 0.0                                                          DPA 0190
      ZLX = 0.0                                                         DPA 0191
      DO 608 I = 1, N1                                                  DPA 0192
      X(I)=T(I) + U(I)*Z7L                                              DPA 0193
      EX = EX + X(I)*AZ(I)                                              DPA 0194
 608  VX = VX + QZ(I)*X(I)**2                                           DPA 0195
      SX = VX**.5                                                       DPA 0196
      ZLX = 2.0*Z7L                                                     DPA 0197
      IF(NSA) 612,612,610                                               DPA 0198
 610  WRITE OUTPUT TAPE 6, 108, NUM, Y2                                 DPA 0199
 612  WRITE OUTPUT TAPE 6, 109                                          DPA 0200
      WRITE OUTPUT TAPE 6,107, EX, SX, Y1                               DPA 0201
      WRITE OUTPUT TAPE 6, 110,ZLX                                      DPA 0202
      GO TO 640                                                         DPA 0203
 614  NUM = NUM + 1                                                     DPA 0204
      IF(ZIR-Y2) 620,620,618                                            DPA 0205
 618  NSA = 1                                                           DPA 0206
      GO TO 299                                                         DPA 0207
 620  IF(NSA) 632,632,622                                               DPA 0208
 622  NSA = 0                                                           DPA 0209
      N1UM = NUM -1                                                     DPA 0210
      WRITE OUTPUT TAPE 6,108, N1UM, Y2                                 DPA 0211
 632  WRITE OUTPUT TAPE 6, 111, NUM                                     DPA 0212
      WRITE OUTPUT TAPE 6, 107,E,SDEV,ZIR                               DPA 0213
      WRITE OUTPUT TAPE 6, 110, Z2M                                     DPA 0214
 640  DO 644 I=1,NSEC                                                   DPA 0215
      IF(X(I)) 644,644,643                                              DPA 0216
 643  X(I) = 100. * X(I)                                                DPA 0217
      WRITE OUTPUT TAPE 6,112, X(I), I                                  DPA 0218
 644  CONTINUE                                                          DPA 0219
      WRITE OUTPUT TAPE 6, 113                                          DPA 0220
      WRITE OUTPUT TAPE 6, 113                                          DPA 0221
      IF(NHA)299,299,685                                                DPA 0222
 685  CONTINUE                                                          DPA 0223
      CALL EXIT                                                         DPA 0224
      END                                                               DPA 0225
