C                                                                       RLV 013 
C     SENSE LIGHT 1 IS ON WHILE PROGRAM IS IN RELTVY SUBROUTINE         RLV 014 
      SENSE LIGHT 1                                                     RLV 015 
C     CALCULATION OF SECOND DERIVATIVE DDP(J) AND X(J)                  RLV 016 
      DDP(1)=(2.0/0.0025**2)*(P(1)-2.5*P(2)+2.0*P(3)-0.5*P(4))          RLV 017 
      DO 57 J=2,KKK                                                     RLV 018 
      DDP(J)=C*T(J)*P(J)/X(J)+XL*(XL+1.0)*P(J)/(X(J)**2)                RLV 019 
     1-(C**2)*E  *P(J)                                                  RLV 020 
   57 CONTINUE                                                          RLV 021 
C     CALCULATION OF FIRST DERIVATIVE DP(J)                             RLV 022 
C                                                                       RLV 023 
      DP(1)=(-22.0*P(1)+36.0*P(2)-18.0*P(3)+4.0*P(4))/(0.03)            RLV 024 
      KKK2=KKK-2                                                        RLV 025 
      DX=0.0025                                                         RLV 026 
      DO 89 J=1,KKK2                                                    RLV 027 
      IF(XMODF(J,40))87,88,87                                           RLV 028 
   87 DP(J+1)=(P(J+2)-P(J  ))/(2.0*DX)-(DDP(J+2)-DDP(J  ))*(DX/12.0)    RLV 029 
      GO TO 89                                                          RLV 030 
   88 DX=DX+DX                                                          RLV 031 
      DP(J+1)=(P(J+2)-P(J-1))/(2.0*DX)-(DDP(J+2)-DDP(J-1))*(DX/12.0)    RLV 032 
   89 CONTINUE                                                          RLV 033 
      KKK1=KKK-1                                                        RLV 034 
   90 DP(KKK)=(P(KKK)-P(KKK1))/2.0/DX                                   RLV 035 
      Q1=0.0                                                            RLV 036 
      Q2=0.0                                                            RLV 037 
      Q3=0.0                                                            RLV 038 
      DX=0.0025                                                         RLV 039 
      ALPHA= DX/3.0                                                     RLV 040 
      QP1(1)=0.0                                                        RLV 041 
      QP2(1)=0.0                                                        RLV 042 
      QP3(1)=0.0                                                        RLV 043 
      KKKST=KKK-2                                                       RLV 044 
      IF(SW3)600,601,600                                                RLV 045 
  600 CONTINUE                                                          RLV 046 
      ZS=-T(1)/2.0                                                      RLV 047 
      XMQ1=5.0*(ZS**4)                                                  RLV 048 
      WRITE OUTPUT TAPE 6,307,(ZS,C,CC,E,GAM)                           RLV 049 
  601 CONTINUE                                                          RLV 050 
  100 DO 202 J=1,KKKST,2                                                RLV 051 
      TER2=C*X(J+2)*E-T(J+2)                                            RLV 052 
      B(J+2)=C*X(J+2)                                                   RLV 053 
      QP1(J+2)=((P(J+2)*TER2)**2)/(B(J+2)*  X(J+2))                     RLV 054 
      QP2(J+2)=((P(J+2)/B(J+2))**2)*(DT(J+2)  -T(J+2)/(  X(J+2)))       RLV 055 
      QP3(J+2)=P(J+2)*(DP(J+2)  )*(X(J+2)*DT(J+2)-T(J+2))/B(J+2)**2     RLV 056 
      TER1=C*X(J+1)*E-T(J+1)                                            RLV 057 
      B(J+1)=C*X(J+1)                                                   RLV 058 
      QP1(J+1)=((P(J+1)*TER1)**2)/(B(J+1)*  X(J+1))                     RLV 059 
      QP2(J+1)=((P(J+1)/B(J+1))**2)*(DT(J+1)  -T(J+1)/(  X(J+1)))       RLV 060 
      QP3(J+1)=P(J+1)*(DP(J+1)  )*(X(J+1)*DT(J+1)-T(J+1))/B(J+1)**2     RLV 061 
      Q1=Q1+ALPHA*(QP1(J)+4.0*QP1(J+1)+QP1(J+2))                        RLV 062 
      Q2=Q2+ALPHA*(QP2(J)+4.0*QP2(J+1)+QP2(J+2))                        RLV 063 
      Q3=Q3+ALPHA*(QP3(J)+4.0*QP3(J+1)+QP3(J+2))                        RLV 064 
      IF(SW3)602,603,602                                                RLV 065 
  602 CONTINUE                                                          RLV 066 
      EQ1=(ZS**4)*(5.0-(5.0-6.0*ZS*C*X(J+2)+2.0*((ZS*C*X(J+2))**2)      RLV 067 
     1*EXPF(-2.0*ZS*C*X(J+2))))                                         RLV 068 
      EXQ1=(ZS**4)*(5.0-6.0*ZS*C*X(J+2)+2.0((ZS*C*X(J+2))**2))          RLV 069 
     1*EXPF(-2.0*ZS*C*X(J+2))                                           RLV 070 
      XQ1=XMQ1-Q1                                                       RLV 071 
      JP=J+2                                                            RLV 072 
      WRITE OUTPUT TAPE 6,306,(JP,Q1,EQ1,XQ1,EXQ1,ALPHA)                RLV 073 
  603 CONTINUE                                                          RLV 074 
      JJJ=J+1                                                           RLV 075 
  200 IF(XMODF(JJJ,40))202 ,201,202                                     RLV 076 
  201 ALPHA=ALPHA+ALPHA                                                 RLV 077 
  202 CONTINUE                                                          RLV 078 
      DO 513 L=1,41                                                     RLV 079 
  513 BIN(L)=1.0                                                        RLV 080 
      CORR1=QP1(2)                                                      RLV 081 
      CORR2=QP2(2)                                                      RLV 082 
      CORR3=QP3(2)                                                      RLV 083 
      ASSIGN 5032 TO KFIR                                               RLV 084 
      ASSIGN 5072 TO KSEC                                               RLV 085 
      ASSIGN 5112 TO KTHIRD                                             RLV 086 
      ERROR1=0.0                                                        RLV 087 
      ERROR2=0.0                                                        RLV 088 
      ERROR3=0.0                                                        RLV 089 
      DO 514 L=2,40                                                     RLV 090 
      COR1=CORR1                                                        RLV 091 
      COR2=CORR2                                                        RLV 092 
      COR3=CORR3                                                        RLV 093 
      CORR1=0.0                                                         RLV 094 
      CORR2=0.0                                                         RLV 095 
      CORR3=0.0                                                         RLV 096 
      BETA=1.0                                                          RLV 097 
      DO 516 J=1,L                                                      RLV 098 
      CORR1=CORR1+QP1(J+1)*BIN(J)*BETA                                  RLV 099 
      CORR2=CORR2+QP2(J+1)*BIN(J)*BETA                                  RLV 100 
      CORR3=CORR3+QP3(J+1)*BIN(J)*BETA                                  RLV 101 
      BETA=-BETA                                                        RLV 102 
  516 CONTINUE                                                          RLV 103 
      GO TO KFIR,(5032,501,504)                                         RLV 104 
  501 XMAG1=ABSF(CORR1)-ABSF(COR1)                                      RLV 105 
      XMAS1=ABSF(CORR1)*10.0**9/QP1(2)-1.0                              RLV 106 
      IF(XMAG1)502,503,503                                              RLV 107 
  502 IF(XMAS1)503,503,5031                                             RLV 108 
  503 ASSIGN 504 TO KFIR                                                RLV 109 
      GO TO 504                                                         RLV 110 
 5032 ASSIGN 501 TO KFIR                                                RLV 111 
 5031 ERROR1=ERROR1+COR1                                                RLV 112 
  504 CONTINUE                                                          RLV 113 
      GO TO KSEC,(5072,505,508)                                         RLV 114 
  505 XMAG2=ABSF(CORR2)-ABSF(COR2)                                      RLV 115 
      XMAS2=ABSF(CORR2)*10.0**9/QP2(2)-1.0                              RLV 116 
      IF(XMAG2) 506,507,507                                             RLV 117 
  506 IF(XMAS2) 507,507,5071                                            RLV 118 
  507 ASSIGN 508 TO KSEC                                                RLV 119 
      GO TO 508                                                         RLV 120 
 5072 ASSIGN 505 TO KSEC                                                RLV 121 
 5071 ERROR2=ERROR2+COR2                                                RLV 122 
  508 CONTINUE                                                          RLV 123 
      GO TO KTHIRD,(5112,509,512)                                       RLV 124 
  509 XMAG3=ABSF(CORR3)-ABSF(COR3)                                      RLV 125 
      XMAS3=ABSF(CORR3)*10.0**9/QP3(2)-1.0                              RLV 126 
      IF(XMAG3) 510,511,511                                             RLV 127 
  510 IF(XMAS3) 511,511,5111                                            RLV 128 
  511 ASSIGN 512 TO KTHIRD                                              RLV 129 
      GO TO 512                                                         RLV 130 
 5112 ASSIGN 509 TO KTHIRD                                              RLV 131 
 5111 ERROR3=ERROR3+COR3                                                RLV 132 
  512 CONTINUE                                                          RLV 133 
      IF(SW3)604,605,604                                                RLV 134 
  604 WRITE OUTPUT TAPE 6,305,(ERROR1,ERROR2,ERROR3)                    RLV 135 
  605 CONTINUE                                                          RLV 136 
      DO 515 M=2,L                                                      RLV 137 
      N=L-M                                                             RLV 138 
  515 BIN(N+2)=BIN(N+2)+BIN(N+1)                                        RLV 139 
  514 CONTINUE                                                          RLV 140 
      Q1=Q1+0.0025*ERROR1/3.0                                           RLV 141 
      Q2=Q2+0.0025*ERROR2/3.0                                           RLV 142 
      Q3=Q3+0.0025*ERROR3/3.0                                           RLV 143 
  300 IF(SW3)3011,304,3011                                              RLV 144 
 3011 FKKK=KKK                                                          RLV 145 
      WRITE OUTPUT TAPE 6,301,(XL,E,FKKK,Q1,Q2,Q3)                      RLV 146 
  302 DO 303 J=1,KKK                                                    RLV 147 
      WRITE OUTPUT TAPE 6,301,(X(J),P(J),DP(J),DDP(J),T(J),DT(J))       RLV 148 
      WRITE OUTPUT TAPE 6,305,(QP1(J),QP2(J),QP3(J))                    RLV 149 
  303  CONTINUE                                                         RLV 150 
  304 CONTINUE                                                          RLV 151 
      SENSE LIGHT 0                                                     RLV 152 
  203 RETURN                                                            RLV 153 
      END                                                               RLV 154 
