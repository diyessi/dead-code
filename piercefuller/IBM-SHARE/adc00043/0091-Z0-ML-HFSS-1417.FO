C     HARTREE-FOCK-SLATER SELF-CONSISTENT ATOMIC FIELD PROGRAM          HFS 001 
C      ORIGINALLY  WRITTEN BY SHERWOOD SKILLMAN                         HFS 002 
C      RCA LABORATORIES, PRINCETON, NEW JERSEY, SPRING 1961             HFS 003 
C      MODIFIED BY FRANK HERMAN, SUMMER 1961                            HFS 004 
C      FURTHER MODIFIED BY RICHARD KORTUM,  LOCKHEED RESEARCH           HFS 005 
C       LABORATORIES, PALO ALTO, CALIFORNIA,  SUMMER 1962               HFS 006 
C     ITERATION NUMBER,MEASURE OF SELF-CONSISTENCY,AND ATOMIC NUMBER Z  HFS 007 
C     ARE ALWAYS PRINTED ON-LINE.                                       HFS 008 
C     OUTPUT TAPE B-5 CONTAINS SELF-CONSISTENT ATOMIC POTENTIAL,        HFS 009 
C      ENERGY EIGENVALUES, AND RADIAL WAVE FUNCTIONS                    HFS 010 
C      SUCCESSIVE SOLUTIONS SEPARATED BY END OF FILE                    HFS 011 
C     Z = ATOMIC NUMBER.  ION = IONICITY.  ZZZ = ION+1                  HFS 012 
C     IF KEY = 0   NORMALIZED NUMERICAL ATOMIC POTENTIAL IS READ IN     HFS 013 
C      FOR EVERY 4TH MESH POINT FROM 1 TO 437.                          HFS 014 
C     IF KEY = 1     NUMERICAL ATOMIC POTENTIAL IS TO BE READ IN.       HFS 015 
C     IF KEY = 2  EXTRAPOLATE FOR STARTING POTENTIAL                    HFS 016 
C     IPRATT IS THE NUMBER OF CONSECUTIVE ITERATIONS TO USE THE PRATT   HFS 017 
C      IMPROVEMENT SCHEME FOLLOWING EACH APPLICATION OF THE ARITHMETIC  HFS 018 
C      AVERAGE SCHEME.                                                  HFS 019 
C     MAXIT = MAXIMUM NO. OF ITERATIONS UNLESS MAXIT IS READ AS 0 ,     HFS 020 
C      IN WHICH CASE MAXIT IS SET TO 20.                                HFS 021 
C     NOCOPY =0, B-5 IS COPIED TO A-3. NOCOPY = 1, B-5 IS NOT COPIED.   HFS 022 
C     KUT = 1, THE CUTOFF POTENTIAL IS -2(ION+1)/R.                     HFS 023 
C     KUT = 0, NO CUTOFF POTENTIAL IS IMPOSED.                          HFS 024 
      DIMENSION X(521),RSCORE(521),RUINL1(521), RU2(521), RU(521),      HFS 025 
     1 NNLZ(24),R(521),RSVALE(521),RUFNL1(521), RU3(521), XI(521),      HFS 026 
     2 WWNL(24),V(521),RSATOM(521),RUINL2(521),XNUM(521), XJ(521),      HFS 027 
     3 NKKK(24),EE(24),RUEXCH(521),RUFNL2(521),DENM(521),               HFS 028 
     4 SNL(24,521),      SNLO(521),A(4,5)                               HFS 029 
      COMMON V,SNLO, R, RSCORE,RSVALE,RU,RUEXCH,XI,XJ,    RSATOM,  SNL, HFS 030 
     1RUINL1,RUFNL1,RUINL2,RUFNL2,XNUM,DENM,RU2,RU3,NNLZ,WWNL,NKKK,EE,A HFS 031 
      EQUIVALENCE (RSCORE,XNUM),(RSVALE,DENM)  ,(QQ,RSATOM)             HFS 032 
    1 FORMAT(F8.5,9F7.5)                                                HFS 033 
    2 FORMAT (I4,1P3E14.7,I4,1PE14.7)                                   HFS 034 
    3 FORMAT(F4.0,3I4)                                                  HFS 035 
    4 FORMAT(9F8.8)                                                     HFS 036 
    5 FORMAT(6H WWW= F4.0,6H ZZZ= F4.0,6H   Z= F4.0,11H   NCORES= I4,   HFS 037 
     1 11H   NVALES= I4,11H   NCSPVS= I4/25H CONTROL CARDS INCORRECT. ) HFS 038 
    6 FORMAT(6F5.2,F10.3)                                               HFS 039 
    7 FORMAT(I4,F4.0,F8.4)                                              HFS 040 
    8 FORMAT(I7,F7.0,1PE14.7,0P2(I6,F9.3))                              HFS 041 
    9 FORMAT(6(I5,1PE14.7))                                             HFS 042 
   10 FORMAT(1PE15.7,1P4E14.7)                                          HFS 043 
   11 FORMAT(10H  NCARDS= I4, 10H  MCARDS= I4)                          HFS 044 
  100 FORMAT(I4,2F8.6,5I4)                                              HFS 045 
  102 FORMAT(2F4.0,2F7.3)                                               HFS 046 
  103 FORMAT(6H ZZ1= F4.0,8H   ZZ2= F4.0,10H   BETA1= F7.3,             HFS 047 
     1 10H   BETA2= F7.3)                                               HFS 048 
  203 FORMAT(8H  KEY = I4)                                              HFS 049 
  908 FORMAT  (6H  ITER,7X,1HZ,4X5HDELTA,7X,30HI(DEL)  X(DEL)  I(CUT)  XHFS 050 
     1(CUT)  )                                                          HFS 051 
 2002 FORMAT(I4,1P3E14.7,I4,1PE14.7,8X,1HZ,I3,I4)                       HFS 052 
 2003 FORMAT(F4.0,3I4,56X,1HZ,I3,I4)                                    HFS 053 
 2010 FORMAT(1PE15.7,1P4E14.7,1X,1HZ,I3,I4)                             HFS 054 
 2011 FORMAT (1PE15.7,57X,1HZ,I3,I4)                                    HFS 055 
 9000 FORMAT (72H                                                       HFS 056 
     1                                )                                 HFS 057 
       REWIND 25                                                        HFS 058 
       NFILES =0                                                        HFS 059 
   15  CONTINUE                                                         HFS 060 
C     READ HEADING CARD.                                                HFS 061 
      READ INPUT TAPE 5,9000                                            HFS 062 
      WRITE OUTPUT TAPE 6,9000                                          HFS 063 
C     READ CONTROL CARDS AND INPUT POTENTIALS. CALCULATE TRIAL POTENTIALHFS 064 
      READ INPUT TAPE 5,100,KEY,TOL,THRESH,MESH,IPRATT,MAXIT,NOCOPY,KUT HFS 065 
      NCARDS=90                                                         HFS 066 
      PRINT 203,KEY                                                     HFS 067 
      IF(MAXIT) 104,104,105                                             HFS 068 
  104 MAXIT=20                                                          HFS 069 
  105 CONTINUE                                                          HFS 070 
  107 NBLOCK = (MESH)/40                                                HFS 071 
C     CONSTRUCT X MESH AND R MESH                                       HFS 072 
      I=1                                                               HFS 073 
      X(I)=0.0                                                          HFS 074 
      R(I)=0.0                                                          HFS 075 
      DELTAX=0.0025                                                     HFS 076 
      DO 25 J=1,NBLOCK                                                  HFS 077 
      DO 24 K=1,40                                                      HFS 078 
      I=I+1                                                             HFS 079 
   24 X(I)=X(I-1)+DELTAX                                                HFS 080 
   25 DELTAX=DELTAX+DELTAX                                              HFS 081 
      IF(KEY-1)1203,208,14                                              HFS 082 
   14 READ INPUT TAPE 5,10, (RU2(M),M=1,441)                            HFS 083 
      READ INPUT TAPE 5,10, (RU3(M),M=1,441)                            HFS 084 
      ZE2=-RU2(1)/2.0                                                   HFS 085 
      ZE3=-RU3(1)/2.0                                                   HFS 086 
      GO TO 205                                                         HFS 087 
C     READ IN ATOMIC POTENTIAL                                          HFS 088 
 1203 READ INPUT TAPE 5,1,(RU2(M),M=1,437,4)                            HFS 089 
      GO TO 205                                                         HFS 090 
  208 READ INPUT TAPE 5,10,(RU3(M),M=1,441)                             HFS 091 
      ZE3=-RU3(1)/2.0                                                   HFS 092 
  205 READ INPUT TAPE 5,3,Z,NCORES,NVALES,ION                           HFS 093 
      CALL TIME                                                         HFS 094 
       IF (Z) 1000,15  ,206                                             HFS 095 
  206  NFILES =NFILES+1                                                 HFS 096 
      IZ=Z                                                              HFS 097 
      NCSPVS=NCORES+NVALES                                              HFS 098 
      C=0.88534138/Z**(1.0/3.0)                                         HFS 099 
      TWOION=ION+ION                                                    HFS 100 
      ZZZ=ION+1                                                         HFS 101 
      TWOZZZ = ZZZ+ZZZ                                                  HFS 102 
      DO 224 I=2,MESH                                                   HFS 103 
  224 R(I)=C*X(I)                                                       HFS 104 
  210 READ INPUT TAPE 5,7,(NNLZ(I),WWNL(I),EE(I),I=1,NCSPVS)            HFS 105 
      WWW=0.0                                                           HFS 106 
      DO 112 I=1,NCSPVS                                                 HFS 107 
  112 WWW=WWW+WWNL(I)                                                   HFS 108 
      IF(ABSF(Z+1.0-WWW-ZZZ)-0.001) 114,113,113                         HFS 109 
  113 PRINT 5,WWW,ZZZ,Z,NCORES,NVALES,NCSPVS                            HFS 110 
      CALL EXIT                                                         HFS 111 
  114 CONTINUE                                                          HFS 112 
      IF (KEY-1) 204,207,16                                             HFS 113 
C     CONSTRUCT ATOMIC POTENIAL                                         HFS 114 
   16  IF(ABSF(ZE3-ZE2-Z+ZE3)-0.001) 18,18,1818                         HFS 115 
 1818 WRITE OUTPUT TAPE 6,1817,Z,ZE2,ZE3                                HFS 116 
 1817 FORMAT (27H0STARTING POTENTIALS AND Z=,F4.0,9H IN ERROR,2F4.0)    HFS 117 
      CALL EXIT                                                         HFS 118 
   18 DO 21 I=1,441                                                     HFS 119 
      RU(I) = RU3(I)+RU3(I)-RU2(I)                                      HFS 120 
   21 CONTINUE                                                          HFS 121 
      GO TO 211                                                         HFS 122 
  204 TWOZ=Z+Z                                                          HFS 123 
      DO 110 I=1,437,4                                                  HFS 124 
  110 RU(I)=-RU2(I)*TWOZ                                                HFS 125 
      RU(441)=RU(437)                                                   HFS 126 
      RU(445)=RU(437)                                                   HFS 127 
      M=9                                                               HFS 128 
      DO111 I=1,437,4                                                   HFS 129 
      M=M-1                                                             HFS 130 
      IF(M) 1100,1101,1101                                              HFS 131 
 1100 RU(I+1)=(22.0*RU(I)+11.0*RU(I+4)-RU(I+8))/32.0                    HFS 132 
      RU(I+2)=(10.0*RU(I)+15.0*RU(I+4)-RU(I+8))/24.0                    HFS 133 
      RU(I+3)=( 6.0*RU(I)+27.0*RU(I+4)-RU(I+8))/32.0                    HFS 134 
      M=9                                                               HFS 135 
      GO TO 111                                                         HFS 136 
 1101 RU(I+1)=(21.0*RU(I)+14.0*RU(I+4)-3.0*RU(I+8))/32.0                HFS 137 
      RU(I+2)=( 3.0*RU(I)+ 6.0*RU(I+4)-    RU(I+8))/ 8.0                HFS 138 
      RU(I+3)=( 5.0*RU(I)+30.0*RU(I+4)-3.0*RU(I+8))/32.0                HFS 139 
  111 CONTINUE                                                          HFS 140 
      GO TO 211                                                         HFS 141 
  207 IF(ABSF(ZE3-Z)-0.001)  215,215,220                                HFS 142 
  215 DO 213 I=1,441                                                    HFS 143 
      RU(I)=RU3(I)                                                      HFS 144 
  213 CONTINUE                                                          HFS 145 
      GO TO 211                                                         HFS 146 
  220 ZOZ=Z/ZE3                                                         HFS 147 
      DO 223 I=1,441                                                    HFS 148 
      RU(I)=RU3(I)*ZOZ                                                  HFS 149 
  223 CONTINUE                                                          HFS 150 
  211 V(1)=-9.9E35                                                      HFS 151 
      M=XMIN0F(441,MESH)                                                HFS 152 
      IF(KUT) 1212,1260,1212                                            HFS 153 
 1212 DO 1213 I= 1,M                                                    HFS 154 
 1213 V(I)= RU(I)/R(I)                                                  HFS 155 
      IF(MESH-M)1214,1214,1216                                          HFS 156 
 1214 DO 1215 I=442, MESH                                               HFS 157 
 1215 V(I)=-TWOION/R(I)                                                 HFS 158 
 1216 LIMIT=M                                                           HFS 159 
      ICUT= MESH                                                        HFS 160 
      IC=MESH                                                           HFS 161 
      GO TO 268                                                         HFS 162 
 1260 CONTINUE                                                          HFS 163 
      ICUT=0                                                            HFS 164 
      DO 26 I=2,M                                                       HFS 165 
      IF (ICUT) 261,261,263                                             HFS 166 
  261  IF( TWOZZZ+RU(I)) 264,264,262                                    HFS 167 
  262 ICUT =I                                                           HFS 168 
  263 V(I)=-TWOZZZ/R(I)                                                 HFS 169 
      GO TO 26                                                          HFS 170 
  264 V(I)=RU(I)/R(I)                                                   HFS 171 
   26 CONTINUE                                                          HFS 172 
      IF(ICUT) 265,265,266                                              HFS 173 
  265  ICUT=M                                                           HFS 174 
  266 LIMIT=ICUT                                                        HFS 175 
      IF(MESH-M) 268,268,267                                            HFS 176 
  267 CONTINUE                                                          HFS 177 
      DO 115 I=442,MESH                                                 HFS 178 
  115 V(I)=-TWOZZZ/R(I)                                                 HFS 179 
  268 CONTINUE                                                          HFS 180 
      DELTA =1000000.                                                   HFS 181 
      NITER=0                                                           HFS 182 
      NONMON =3                                                         HFS 183 
      IPRSW=0                                                           HFS 184 
      PRINT 908                                                         HFS 185 
C     START ITERATION                                                   HFS 186 
   27 MCARDS=90                                                         HFS 187 
      CALL TIME                                                         HFS 188 
      IF(MAXIT-NITER) 405,28,28                                         HFS 189 
  405 CONTINUE                                                          HFS 190 
      WRITE OUTPUT TAPE 6,450                                           HFS 191 
      DO 410 I=1,MESH,5                                                 HFS 192 
      WRITE OUTPUT TAPE 6,451,I,X    (I),RU3(I),RUINL1(I),RUFNL1(I),    HFS 193 
     1RUINL2(I),RUFNL2(I),RU(I)                                         HFS 194 
  410 CONTINUE                                                          HFS 195 
  450 FORMAT (40H1I,X,RU3,RUINL1,RUFNL1,RUINL2,RUFNL2,RU   )            HFS 196 
  451 FORMAT (I8,F10.4,1P6E16.7)                                        HFS 197 
      GO TO 205                                                         HFS 198 
   28 DO 29 I=1,MESH                                                    HFS 199 
      RSCORE(I)=0.0                                                     HFS 200 
   29 RSVALE(I)=0.0                                                     HFS 201 
C     SOLVE SCHROEDINGER EQUATION FOR EACH STATE IN TURN. ALSO CALCULATEHFS 202 
C           CORE AND VALENCE CHARGE DENSITY.                            HFS 203 
      DO 35 M=1,NCSPVS                                                  HFS 204 
      E=EE(M)                                                           HFS 205 
       NN=NNLZ(M)/100                                                   HFS 206 
       LAM =NNLZ(M)/10 -10*NN                                           HFS 207 
       XL= LAM                                                          HFS 208 
       CALL SCHEQ(Z,E,LAM,NN,KKK,MESH,C,THRESH)                         HFS 209 
      IF(M-NCORES)30,30,32                                              HFS 210 
   30 DO 31 I=1,KKK                                                     HFS 211 
   31 RSCORE(I)=RSCORE(I)+WWNL(M)*SNLO(I)**2                            HFS 212 
      GO TO 34                                                          HFS 213 
   32 DO 33 I=1,KKK                                                     HFS 214 
   33 RSVALE(I)=RSVALE(I)+WWNL(M)*SNLO(I)**2                            HFS 215 
   34 DO 201 I=1,KKK                                                    HFS 216 
  201 SNL(M,I)=SNLO(I)                                                  HFS 217 
      NKKK(M)=KKK                                                       HFS 218 
      MCARDS=MCARDS+2+((KKK-1)/40)*8                                    HFS 219 
   35 EE(M)=E                                                           HFS 220 
C     CALCULATE TOTAL CHARGE DENSITY AND ATOMIC EXCHANGE POTENTIAL      HFS 221 
      DO 37 I=1,MESH                                                    HFS 222 
   36 RSATOM(I)=RSCORE(I)+RSVALE(I)                                     HFS 223 
   37 RUEXCH(I)= -6.0*((3.0*R(I)*RSATOM(I))/315.82734)**(1.0/3.0)       HFS 224 
C     CALCULATE ATOMIC COULOMB POTENTIAL                                HFS 225 
      A1=0.0                                                            HFS 226 
      ASUM=0.0                                                          HFS 227 
      B1=0.0                                                            HFS 228 
      BSUM=0.0                                                          HFS 229 
      H=0.0025*C                                                        HFS 230 
      I=1                                                               HFS 231 
      XI(1)=0.0                                                         HFS 232 
      XJ(1)=0.0                                                         HFS 233 
      DO 39 J=1,NBLOCK                                                  HFS 234 
      DO 38 K=1,40                                                      HFS 235 
      I=I+1                                                             HFS 236 
      A2=RSATOM(I)/2.0                                                  HFS 237 
      A1=A1+A2                                                          HFS 238 
      B2=RSATOM(I)/(2.0*R(I))                                           HFS 239 
      B1=B1+B2                                                          HFS 240 
      XI(I)=ASUM+A1*H                                                   HFS 241 
      XJ(I)=BSUM+B1*H                                                   HFS 242 
      A1=A1+A2                                                          HFS 243 
   38 B1=B1+B2                                                          HFS 244 
      ASUM=XI(I)                                                        HFS 245 
      BSUM=XJ(I)                                                        HFS 246 
      A1=A2                                                             HFS 247 
      B1=B2                                                             HFS 248 
   39 H=H+H                                                             HFS 249 
   40 CONTINUE                                                          HFS 250 
   41 DO 44 I=1,MESH                                                    HFS 251 
      XI(I)=-2.0*Z+2.0*(XI(I)+R(I)*(XJ(MESH)-XJ(I)))                    HFS 252 
      XJ(I)=XI(I)+RUEXCH(I)                                             HFS 253 
   44 CONTINUE                                                          HFS 254 
   74 DO 75 I=1,MESH                                                    HFS 255 
      RUINL1(I)=RUINL2(I)                                               HFS 256 
      RUFNL1(I)=RUFNL2(I)                                               HFS 257 
      RUINL2(I)=RU(I)                                                   HFS 258 
   75 RUFNL2(I)=XJ(I)                                                   HFS 259 
   76 NITER=NITER+1                                                     HFS 260 
      PDELTA =DELTA                                                     HFS 261 
      DELTA =0.0                                                        HFS 262 
      DO 48 I=1,LIMIT                                                   HFS 263 
   45 SNLO(I)=RU(I)-XJ(I)                                               HFS 264 
   46 XI(I)=ABSF(SNLO(I))                                               HFS 265 
      IF (XI(I)-DELTA)48,48,47                                          HFS 266 
   47 DELTA=XI(I)                                                       HFS 267 
      IDELTA=I                                                          HFS 268 
   48 CONTINUE                                                          HFS 269 
      PRINT 8,NITER,Z,DELTA,IDELTA,X(IDELTA),ICUT,X(ICUT)               HFS 270 
C     TEST SELF-CONSISTENCY OF ATOMIC POTENTIAL.                        HFS 271 
   50 IF(DELTA-TOL) 58,51,51                                            HFS 272 
C     IF SCF CRITERION NOT SATISFIED, CALCULATE NEXT TRIAL POTENTIAL.   HFS 273 
   51 IF(IPRSW) 80,80,82                                                HFS 274 
   80 DO 81 I=2,LIMIT                                                   HFS 275 
   81 RU(I)=0.5*(RU(I)+XJ(I))                                           HFS 276 
      IF (MESH-LIMIT)  280,280,270                                      HFS 277 
  270 RUZM=XJ(MESH)                                                     HFS 278 
      RATIO =(RUZM-RU(LIMIT))/(RUZM-XJ(LIMIT))                          HFS 279 
      DO 271 I=LIMIT,MESH                                               HFS 280 
  271 RU(I)=RUZM-RATIO*(RUZM-XJ(I))                                     HFS 281 
      LIMIT =MESH                                                       HFS 282 
  280 IPRSW=IPRATT                                                      HFS 283 
      GO TO 87                                                          HFS 284 
   82 CONTINUE                                                          HFS 285 
  282 IF(NONMON) 80,80,183                                              HFS 286 
  183 IF(PDELTA-DELTA)184,184,185                                       HFS 287 
C     IF DELTA IS NOT MONOTONIC DECREASING FOUR TIMES, BYPASS           HFS 288 
C       PRATT IMPROVEMENT SCHEME                                        HFS 289 
  184 NONMON =NONMON-1                                                  HFS 290 
      IF(NONMON)80,80,185                                               HFS 291 
  185 ALPH=0.5                                                          HFS 292 
C     PRATT IMPROVEMENT SCHEME                                          HFS 293 
      DO 849 I=2,ICUT                                                   HFS 294 
      XNUM(I)=RUINL1(I)*RUFNL2(I)-RUINL2(I)*RUFNL1(I)                   HFS 295 
      DENM(I)=RUFNL2(I)-RUFNL1(I)-RUINL2(I)+RUINL1(I)                   HFS 296 
  182 IF(ABSF(DENM(I)/RUINL2(I))-0.0001) 83,83,84                       HFS 297 
   83 CONTINUE                                                          HFS 298 
  832 ALPH=0.5                                                          HFS 299 
      GO TO 846                                                         HFS 300 
   84 ALPH=(XNUM(I)/DENM(I)-RUFNL2(I))/SNLO(I)                          HFS 301 
      IF(ALPH) 841,845,842                                              HFS 302 
  841 ALPH=0.0                                                          HFS 303 
      GO TO 846                                                         HFS 304 
  842 IF(0.5-ALPH) 843,845,845                                          HFS 305 
  843 ALPH=0.5                                                          HFS 306 
  845 CONTINUE                                                          HFS 307 
  846 XI(I)=ALPH                                                        HFS 308 
  849 CONTINUE                                                          HFS 309 
      IPRSW=IPRSW-1                                                     HFS 310 
      IF(KUT) 1873,1849,1873                                            HFS 311 
 1849 CONTINUE                                                          HFS 312 
      IC=ICUT+20                                                        HFS 313 
      IC1=ICUT+1                                                        HFS 314 
       ADEL=XI(ICUT)/20.                                                HFS 315 
      DO 873 I=IC1,IC                                                   HFS 316 
      XI(I)=XI(I-1)-ADEL                                                HFS 317 
  873 XJ(I)=XI(I)                                                       HFS 318 
 1873 CONTINUE                                                          HFS 319 
      XJ(1)=0.5                                                         HFS 320 
      XJ(2)=XI(2)                                                       HFS 321 
      ASUM=XI(2)+XI(3)+XI(4)+XI(5)                                      HFS 322 
      DO 874 I=3,ICUT                                                   HFS 323 
      XJ(I)=ASUM*0.2                                                    HFS 324 
  874 ASUM=ASUM-XI(I-2)+XI(I+3)                                         HFS 325 
      IF(KUT) 1875,1874,1875                                            HFS 326 
 1874 CONTINUE                                                          HFS 327 
      IC1=IC+1                                                          HFS 328 
      DO 875 I=IC1,MESH                                                 HFS 329 
      XJ(I)=0.0                                                         HFS 330 
  875 RU(I)=RUFNL2(I)                                                   HFS 331 
 1875 CONTINUE                                                          HFS 332 
      DO 876 I=2,IC                                                     HFS 333 
  876 RU(I)= RUFNL2(I)+XJ(I)*SNLO(I)                                    HFS 334 
   87 CONTINUE                                                          HFS 335 
      IF(KUT) 2870,1870,2870                                            HFS 336 
 2870 ICUT=MESH                                                         HFS 337 
      LIMIT=MESH                                                        HFS 338 
      DO 2871 I=2,MESH                                                  HFS 339 
      VLAST= V(I)                                                       HFS 340 
      V(I)=RU(I)/R(I)                                                   HFS 341 
 2871 XI(I)=V(I)-VLAST                                                  HFS 342 
      GO TO 1861                                                        HFS 343 
 1870 CONTINUE                                                          HFS 344 
      ICUT =0                                                           HFS 345 
      DO 86 I=2,MESH                                                    HFS 346 
       VLAST=V(I)                                                       HFS 347 
      IF(ICUT) 851,851,853                                              HFS 348 
  851 IF(TWOZZZ+RU(I)) 854,854,852                                      HFS 349 
  852 ICUT=I                                                            HFS 350 
  853 V(I)=-TWOZZZ/R(I)                                                 HFS 351 
      GO TO 86                                                          HFS 352 
  854 V(I)=RU(I)/R(I)                                                   HFS 353 
   86 XI(I)=V(I)-VLAST                                                  HFS 354 
 1861 CONTINUE                                                          HFS 355 
      XI(1)=0.0                                                         HFS 356 
C     NEXT TRIAL EIGENVALUES PREDICTED BY PERTURBATION THEORY           HFS 357 
      NCARDS=90                                                         HFS 358 
      DO 55 M=1,NCSPVS                                                  HFS 359 
      K=(NKKK(M)-1)/40                                                  HFS 360 
      H=0.0025*C                                                        HFS 361 
      ASUM=0.0                                                          HFS 362 
      A1=0.0                                                            HFS 363 
      I=1                                                               HFS 364 
      DO 54 J=1,K                                                       HFS 365 
      DO 53 L=1,40                                                      HFS 366 
      I=I+1                                                             HFS 367 
      A2=XI(I)*SNL(M,I)**2                                              HFS 368 
   53 A1=A1+A2*H                                                        HFS 369 
      ASUM=ASUM+A1-(A2/2.0)*H                                           HFS 370 
      H=H+H                                                             HFS 371 
   54 A1=(A2/2.0)*H                                                     HFS 372 
      EE(M)=EE(M)+ASUM                                                  HFS 373 
   55 NCARDS=NCARDS+8*K+2                                               HFS 374 
      GO TO 27                                                          HFS 375 
C     RESULTS TRANSFERRED FROM INTERNAL MEMORY TO OUTPUT TAPE(S).       HFS 376 
C     OUTPUT IS ON TAPE B-5 FOR OFFLINE PUNCHING (BCD), AND IS          HFS 377 
C       COPIED TO NORMAL OUTPUT TAPE 6 (A3)                             HFS 378 
   58 CONTINUE                                                          HFS 379 
      CALL TIME                                                         HFS 380 
  580 PRINT 11,NCARDS,MCARDS                                            HFS 381 
      NC=1                                                              HFS 382 
      WRITE OUTPUT TAPE 25,2003,Z,NCORES,NVALES,ION,IZ,NC               HFS 383 
      DO 583 I=1,441                                                    HFS 384 
      IF(TWOION+RUINL2(I)) 583,583,581                                  HFS 385 
  581 DO 582 M=I,441                                                    HFS 386 
  582 RUINL2(M)=-TWOION                                                 HFS 387 
      GO TO 584                                                         HFS 388 
  583 CONTINUE                                                          HFS 389 
  584 CONTINUE                                                          HFS 390 
      DO 588 MIN=1,440,5                                                HFS 391 
      MAX= MIN+4                                                        HFS 392 
      NC=NC+1                                                           HFS 393 
      WRITE OUTPUT TAPE 25,2010,(RUINL2(M),M=MIN,MAX),IZ,NC             HFS 394 
  588 CONTINUE                                                          HFS 395 
      NC=NC+1                                                           HFS 396 
      WRITE OUTPUT TAPE 25,2011,RUINL2(441),IZ,NC                       HFS 397 
      DO 59 M=1,NCSPVS                                                  HFS 398 
      NLZ=NNLZ(M)                                                       HFS 399 
      KKK=NKKK(M)                                                       HFS 400 
      XL=NLZ/10-10*(NLZ/100)                                            HFS 401 
      LP=XL+1.0                                                         HFS 402 
C     COMPUTE FIRST TERM OF SERIES. (SNL(R)/R**(LAM+1) AT R=0)          HFS 403 
      DO 591 I=1,4                                                      HFS 404 
      A(I,1)=1.0                                                        HFS 405 
      A(I,2)=R(I+1)                                                     HFS 406 
      A(I,3)=R(I+1)*R(I+1)                                              HFS 407 
      A(I,4)=R(I+1)*A(I,3)                                              HFS 408 
  591 A(I,5)=SNL (M,I+1)/R(I+1)**LP                                     HFS 409 
      CALL CROSYM (4)                                                   HFS 410 
      NC=NC+1                                                           HFS 411 
      WRITE OUTPUT TAPE 25,2002,NLZ,XL,EE(M),WWNL(M),KKK,A(1,5),IZ,NC   HFS 412 
      K1=KKK-1                                                          HFS 413 
      DO598 MIN=1,K1 ,5                                                 HFS 414 
      NC=NC+1                                                           HFS 415 
      MAX= MIN+4                                                        HFS 416 
      WRITE OUTPUT TAPE 25,2010,(SNL(M,I),I=MIN,MAX),IZ,NC              HFS 417 
  598 CONTINUE                                                          HFS 418 
      NC=NC+1                                                           HFS 419 
      WRITE OUTPUT TAPE 25,2011,SNL(M,KKK),IZ,NC                        HFS 420 
   59 CONTINUE                                                          HFS 421 
      IF(KEY-1)  958,960,965                                            HFS 422 
  958 KEY=1                                                             HFS 423 
  960 DO 961 I=1,MESH                                                   HFS 424 
  961 RU3(I)=RU(I)                                                      HFS 425 
      ZE3=Z                                                             HFS 426 
      GO TO 205                                                         HFS 427 
  965 DO 966 I=1,MESH                                                   HFS 428 
      RU2(I)=RU3(I)                                                     HFS 429 
  966 RU3(I)=RU(I)                                                      HFS 430 
      ZE2=ZE3                                                           HFS 431 
      ZE3=Z                                                             HFS 432 
      GO TO 205                                                         HFS 433 
 1000 CONTINUE                                                          HFS 434 
       END FILE 25                                                      HFS 435 
      IF(NOCOPY)1008,1008,1005                                          HFS 436 
 1008 CONTINUE                                                          HFS 437 
       REWIND 25                                                        HFS 438 
      IF(NFILES)1003,1003,1002                                          HFS 439 
 1002 CALL COPY(25,6)                                                   HFS 440 
 1003 CONTINUE                                                          HFS 441 
 1005 CALL UNLOAD(25)                                                   HFS 442 
 2005  CALL EXIT                                                        HFS 443 
      END                                                               HFS 444 
                                                                        SCH 000 
C     SUBROUTINE SCHEQ                                                  SCH 001 
C     COMPUTE ENERGY EIGENVALUE AND WAVE FUNCTION                       SCH 002 
C      ORIGINALLY  WRITTEN BY SHERWOOD SKILLMAN                         SCH 003 
C      RCA LABORATORIES, PRINCETON, NEW JERSEY, SPRING 1961             SCH 004 
C      MODIFIED BY FRANK HERMAN, SUMMER 1961                            SCH 005 
C      FURTHER MODIFIED BY RICHARD KORTUM,  LOCKHEED RESEARCH           SCH 006 
C       LABORATORIES, PALO ALTO, CALIFORNIA,  SUMMER 1962               SCH 007 
       SUBROUTINE SCHEQ(ZZ,EN,LAMBDA,NOFL,KKK,MESS,SCF,THRESH)          SCH 008 
      DIMENSION                       P(5),Q(5),T(5),D(5)               SCH 009 
      DIMENSION R(521),RSCORE(521),RUINL1(521), RU2(521), RU(521),      SCH 010 
     1 NNLZ(24),       RSVALE(521),RUFNL1(521), RU3(521), XI(521),      SCH 011 
     2 WWNL(24),V(521),RSATOM(521),RUINL2(521),XNUM(521), XJ(521),      SCH 012 
     3 NKKK(24),EE(24),RUEXCH(521),RUFNL2(521),DENM(521),               SCH 013 
     4 SNL(24,521),      SNLO(521) , QQ(521)                            SCH 014 
      COMMON V,SNLO, R, RSCORE,RSVALE,RU,RUEXCH,XI,XJ,    RSATOM,  SNL, SCH 015 
     1RUINL1,RUFNL1,RUINL2,RUFNL2,XNUM,DENM,RU2,RU3,NNLZ,WWNL,NKKK,EE   SCH 016 
      EQUIVALENCE (RSCORE,XNUM),(RSVALE,DENM)  ,(QQ,RSATOM)             SCH 017 
C     SET UP CONSTANTS AND INITIALIZE                                   SCH 018 
       Z=ZZ                                                             SCH 019 
       LAM=LAMBDA                                                       SCH 020 
       NN=NOFL                                                          SCH 021 
       MESH=MESS                                                        SCH 022 
       C=SCF                                                            SCH 023 
      MANY = 200                                                        SCH 024 
   73 E=EN                                                              SCH 025 
      MOREV=0                                                           SCH 026 
      LESSV=0                                                           SCH 027 
      EMORE=0.0                                                         SCH 028 
      ELESS=0.0                                                         SCH 029 
      MORE=0                                                            SCH 030 
      LESS=0                                                            SCH 031 
      DE=0.0                                                            SCH 032 
      NPRINT=0                                                          SCH 033 
      LAMM=LAM-1                                                        SCH 034 
      LAMP=LAM+1                                                        SCH 035 
      XLP=LAMP                                                          SCH 036 
      NDCR=NN-LAMP                                                      SCH 037 
      B=LAM*LAMP                                                        SCH 038 
       OC=R(2)                                                          SCH 039 
      H=OC                                                              SCH 040 
      HSQ=H*H                                                           SCH 041 
      B3=(V(3)-V(2))/H-Z/HSQ                                            SCH 042 
      Y=H+H                                                             SCH 043 
      FLPS=4*LAM+6                                                      SCH 044 
      SLPT=6*LAM+12                                                     SCH 045 
      ELPT=8*LAM+20                                                     SCH 046 
      A1=-Z/XLP                                                         SCH 047 
      YSQ=Y*Y                                                           SCH 048 
       B1=-Z-Z                                                          SCH 049 
      AB1=A1*B1                                                         SCH 050 
      AB3=A1*B3                                                         SCH 051 
C     RAISE H AND Y TO LAM+1                                            SCH 052 
      HTL=H                                                             SCH 053 
      YTL=Y                                                             SCH 054 
      IF(LAM)77,1102,1100                                               SCH 055 
 1100 DO 1101 I=1,LAM                                                   SCH 056 
      HTL=HTL*H                                                         SCH 057 
 1101  YTL=YTL*Y                                                        SCH 058 
 1102 H1=HSQ                                                            SCH 059 
      BOHS=B/HSQ                                                        SCH 060 
      BOH=B1/H                                                          SCH 061 
      BTH=B3*H                                                          SCH 062 
      BQ3=BOHS+BOH+BTH                                                  SCH 063 
      BQ4=BOHS/4.+BOH/2.+BTH+BTH                                        SCH 064 
      EPL=8+LAM                                                         SCH 065 
      FPL=5+LAM                                                         SCH 066 
      XIFC=C*.21701389E-4                                               SCH 067 
C     START OUTWARD INTEGRATION                                         SCH 068 
   10 NPRINT=NPRINT+1                                                   SCH 069 
      EPS =E-EG                                                         SCH 070 
      EG =E                                                             SCH 071 
      IF(MANY-NPRINT)  900,75,75                                        SCH 072 
  900 WRITE OUTPUT TAPE 6,901,NN,LAM ,Z                                 SCH 073 
  901 FORMAT (20H   NO CONVERGENCE ON,I4,I1,F4.0)                       SCH 074 
       CALL DUMP                                                        SCH 075 
   77 NSTOP=77                                                          SCH 076 
  777 WRITE OUTPUT TAPE 6,770,NSTOP                                     SCH 077 
  770 FORMAT(5H0STOP,I4,8HIN SCHEQ)                                     SCH 078 
      CALL DUMP                                                         SCH 079 
   75 DO 11 I=1,MESH                                                    SCH 080 
   11 SNLO(I)=0.0                                                       SCH 081 
      IF(NPRINT-1) 77,500,529                                           SCH 082 
  500 CONTINUE                                                          SCH 083 
      DO 502  I= 4,MESH                                                 SCH 084 
      QQ(I) = V(I)+B/(R(I)*R(I))-E                                      SCH 085 
  502 CONTINUE                                                          SCH 086 
  516 M= MESH                                                           SCH 087 
      DO 520 I=4,MESH                                                   SCH 088 
      IF(QQ(M)) 519,520,520                                             SCH 089 
  519 IK=M+1                                                            SCH 090 
      GO TO  525                                                        SCH 091 
  520 M=M-1                                                             SCH 092 
  521 NSTOP =521                                                        SCH 093 
C     Q IS EVERYWHERE POSITIVE                                          SCH 094 
      GO TO 777                                                         SCH 095 
  525 IF(MESH-IK) 526,526,535                                           SCH 096 
  526 EPS = QQ(MESH-40)                                                 SCH 097 
      E = E+EPS                                                         SCH 098 
  529 CONTINUE                                                          SCH 099 
      DO 530 I=4,MESH                                                   SCH 100 
  530 QQ(I) = QQ(I)-EPS                                                 SCH 101 
      GO TO 516                                                         SCH 102 
  535 CONTINUE                                                          SCH 103 
   14 NCROSS=0                                                          SCH 104 
      SIGN=1.0                                                          SCH 105 
      H=OC                                                              SCH 106 
      Y=H+H                                                             SCH 107 
C     B= LAM*(LAM+1)                                                    SCH 108 
C     B1= -2.*Z                                                         SCH 109 
      B2=3.0*Z/H-E+2.0*V(2)-V(3)                                        SCH 110 
C     B3=(V(3)-V(2))/H -Z/HSQ                                           SCH 111 
C     A1= -Z/(LAM+1)                                                    SCH 112 
      A2=(AB1+B2)/FLPS                                                  SCH 113 
C     A2=(A1*B1+B2)/(4*LAM+6)                                           SCH 114 
      A3=(A2*B1+A1*B2+B3)/SLPT                                          SCH 115 
C     A3=(A2*B1+A1*B2+B3)/(6*LAM+12)                                    SCH 116 
      A4=(A3*B1+A2*B2+AB3)/ELPT                                         SCH 117 
C     A4=(A3*B1+A2*B2+A1*B3)/(8*LAM+20)                                 SCH 118 
      P(3)=(1.0+H*(A1+H*(A2+H*(A3+H*A4))))*HTL                          SCH 119 
C     P(3)=(1.0+A1*H+A2*H**2+A3*H**3+A4*H**4)*H**(XL+1.0)               SCH 120 
      P(4)=(1.0+Y*(A1+Y*(A2+Y*(A3+Y*A4))))*YTL                          SCH 121 
C     P(4)=(1.0+A1*Y+A2*Y**2+A3*Y**3+A4*Y**4)*Y**(XL+1.0)               SCH 122 
      Q(3)=BQ3+B2                                                       SCH 123 
C     Q(3)=(B+B1*H+B2*H**2+B3*H**3)/H**2                                SCH 124 
      Q(4)=BQ4+B2                                                       SCH 125 
C     Q(4)=(B+B1*Y+B2*Y**2+B3*Y**3)/Y**2                                SCH 126 
      SNLO(2)=P(3)                                                      SCH 127 
      SNLO(3)=P(4)                                                      SCH 128 
      I=3                                                               SCH 129 
       DX=OC                                                            SCH 130 
      H1=H**2                                                           SCH 131 
      H2=H1/12.0                                                        SCH 132 
      T(3)=P(3)*(1.0-H2*Q(3))                                           SCH 133 
      T(4)=P(4)*(1.0-H2*Q(4))                                           SCH 134 
      D(4)=T(4)-T(3)                                                    SCH 135 
      NCOUNT=3                                                          SCH 136 
      NINT=2                                                            SCH 137 
   15 I=I+1                                                             SCH 138 
C     IF END OF MESH IS REACHED, MODIFY TRIAL EIGENVALUE                SCH 139 
      IF(I-MESH) 16,3,3                                                 SCH 140 
    3 IF(NDCR-NCROSS) 32,33,33                                          SCH 141 
C     RETURN TO BEGINNING OF OUTWARD INTEGRATION IF NECESSARY           SCH 142 
   16 Q(5) =QQ(I)                                                       SCH 143 
      IF(IK-I)  29,29,21                                                SCH 144 
   21 D(5)=D(4)+H1*Q(4)*P(4)                                            SCH 145 
      T(5)=D(5)+T(4)                                                    SCH 146 
      IF(1.0-ABSF(H2*Q(5))) 3,3,501                                     SCH 147 
  501 P(5)=T(5)/(1.0-H2*Q(5))                                           SCH 148 
      SNLO(I) = P(5)                                                    SCH 149 
       IF(SIGN) 211,77,212                                              SCH 150 
  211  IF(P(5))  23,23,22                                               SCH 151 
  212  IF(P(5)) 22,23,23                                                SCH 152 
   22 NCROSS=NCROSS+1                                                   SCH 153 
C     COUNT CHANGES IN SIGN                                             SCH 154 
      SIGN=-SIGN                                                        SCH 155 
   23 NCOUNT=NCOUNT+1                                                   SCH 156 
      IF(7-NCOUNT)77,24,25                                              SCH 157 
   24 NCOUNT=2                                                          SCH 158 
   25 NINT=NINT+1                                                       SCH 159 
      IF(40-NINT)77,26,27                                               SCH 160 
   26 DX=DX+DX                                                          SCH 161 
      H=DX                                                              SCH 162 
      H1=H**2                                                           SCH 163 
      H2=H1/12.0                                                        SCH 164 
      NINT=0                                                            SCH 165 
      T(5)=P(5)*(1.0-H2*Q(5))                                           SCH 166 
      T(3)=P(3)*(1.0-H2*Q(3))                                           SCH 167 
      D(5)=T(5)-T(3)                                                    SCH 168 
   27 DO 28 K=1,4                                                       SCH 169 
      P(K)=P(K+1)                                                       SCH 170 
      T(K)=T(K+1)                                                       SCH 171 
      D(K)=D(K+1)                                                       SCH 172 
   28 Q(K)=Q(K+1)                                                       SCH 173 
      GO TO 15                                                          SCH 174 
   29 IF(NCOUNT-2)77,30,21                                              SCH 175 
   30 IF(NINT-4)21,21,31                                                SCH 176 
C     MATCHING RADIUS HAS BEEN REACHED GOING OUT                        SCH 177 
C     IF NDCR NOT EQUAL TO NCROSS, MODIFY TRIAL EIGENVALUE              SCH 178 
   31 EIGEN=E                                                           SCH 179 
      IF(NDCR-NCROSS) 32,35,33                                          SCH 180 
   32 MORE=1                                                            SCH 181 
C     TOO MANY CROSSINGS, INCREASE ABSF(E)                              SCH 182 
      MOREV=MOREV+1                                                     SCH 183 
       IF(MOREV-1) 50,53,52                                             SCH 184 
   50 NSTOP=50                                                          SCH 185 
      GO TO 777                                                         SCH 186 
   52 IF(E -EMORE) 53,54,54                                             SCH 187 
   53 EMORE=E                                                           SCH 188 
   54  IF (LESS) 55,56,64                                               SCH 189 
   55 NSTOP=55                                                          SCH 190 
      GO TO 777                                                         SCH 191 
   56 E=1.25*EG                                                         SCH 192 
      GO TO 10                                                          SCH 193 
   33 LESS=1                                                            SCH 194 
C     TOO FEW  CROSSINGS, DECREASE ABSF(E)                              SCH 195 
      LESSV=LESSV+1                                                     SCH 196 
       IF(LESSV-1) 57,60,59                                             SCH 197 
   57 NSTOP=57                                                          SCH 198 
      GO TO 777                                                         SCH 199 
   59 IF(ELESS- E) 60,61,61                                             SCH 200 
   60 ELESS=E                                                           SCH 201 
   61 IF(MORE) 62,63,64                                                 SCH 202 
   62 NSTOP=62                                                          SCH 203 
      GO TO 777                                                         SCH 204 
   63 E=0.75*EG                                                         SCH 205 
      GO TO 10                                                          SCH 206 
   64 E=0.5*(EMORE+ELESS)                                               SCH 207 
      GO TO 10                                                          SCH 208 
   35  IF(ABSF(SNLO(I-1))-ABSF(SNLO(I-2))) 351,354,354                  SCH 209 
C     CHECK TO SEE THAT WAVE IS IN THE DAMPED REGION (ABSOLUTE VALUE    SCH 210 
C       DECREASING AND SIGNS ALIKE)                                     SCH 211 
  351  IF (P(5)) 352,21 ,353                                            SCH 212 
  352  IF(SNLO(I-2)) 401,21,21                                          SCH 213 
  353  IF(SNLO(I-2)) 21,21,401                                          SCH 214 
  354  IF(1.0E+25 -ABSF(P(5)))33,33,21                                  SCH 215 
C     LARGE ABSOLUTE VALUE OF P IN WHAT SHOULD BE THE DAMPED REGION     SCH 216 
C       INDICATES TOO FEW PEAKS, DECREASE ABSF(E)                       SCH 217 
C     NOW NDCR = NCROSS AND MATCHING RADIUS LIES IN DAMPED REGION       SCH 218 
  401 IMATCH=I-2                                                        SCH 219 
      XMATCH=R(I-2)                                                     SCH 220 
      PPOUT=(T(4)-T(2)-0.5*(P(4)-P(2)))/H                               SCH 221 
      S2=PPOUT/P(3)                                                     SCH 222 
C     INTEGRATION IS BY 8 APPLICATIONS OF NEWTON-COTES CLOSED           SCH 223 
C       QUADRATURE FOR FIVE INTERVALS ON EACH BLOCK                     SCH 224 
C       XIFC =(5*H(BLOCK 1)/288)/2 ,H(1) =0.0025*SCALE FACTOR           SCH 225 
      SUM1=0.0                                                          SCH 226 
      XIF=XIFC                                                          SCH 227 
      I=1                                                               SCH 228 
      VALUE=0.0                                                         SCH 229 
   36 MM=8                                                              SCH 230 
      SUM2=0.0                                                          SCH 231 
      XIF=XIF+XIF                                                       SCH 232 
   37 Y=VALUE                                                           SCH 233 
      VALUE=SNLO(I+5)**2                                                SCH 234 
      SUM2=SUM2+19.0*(VALUE+Y)+75.0*(SNLO(I+4)**2+SNLO(I+1)**2)         SCH 235 
     1+50.0*(SNLO(I+2)**2+SNLO(I+3)**2)                                 SCH 236 
      I=I+5                                                             SCH 237 
       IF (IMATCH-I)  77,39,371                                         SCH 238 
  371  MM=MM-1                                                          SCH 239 
      IF(MM)77,38,37                                                    SCH 240 
   38 SUM1=SUM2*XIF+SUM1                                                SCH 241 
       GO TO 36                                                         SCH 242 
   39  SUM1= SUM1+SUM2*XIF                                              SCH 243 
   40 S1=SUM1/P(3)**2                                                   SCH 244 
      PMATCH=P(3)                                                       SCH 245 
      IF(NN-1)77,41,42                                                  SCH 246 
   41 XINW=EPL*XMATCH                                                   SCH 247 
C     FOR N =1, START INWARD INTEGRATION AT(8+LAM)*XMATCH OR X MAX      SCH 248 
      GO TO 421                                                         SCH 249 
   42 XINW=FPL*XMATCH                                                   SCH 250 
C     FOR N NOT=1, START AT (5+LAM)*XMATCH OR X MAX (END OF MESH)       SCH 251 
  421 DO 44  I= 41,MESH,40                                              SCH 252 
      IF(XINW-R(I))  43,43,44                                           SCH 253 
   43 KKK =I                                                            SCH 254 
      GO TO 45                                                          SCH 255 
   44 CONTINUE                                                          SCH 256 
      KKK =MESH                                                         SCH 257 
   45 I =KKK                                                            SCH 258 
      DX =R(I-1)-R(I)                                                   SCH 259 
      H =DX                                                             SCH 260 
      XIF=0.17361111E-1*DX                                              SCH 261 
      HSQ=H*H                                                           SCH 262 
      HSQ12=HSQ/12.0                                                    SCH 263 
      Q(3)= QQ(I)                                                       SCH 264 
      P(3)= EXPF(-R(I)*SQRTF(Q(3)))                                     SCH 265 
  402 SUM3=P(3)/Q(3)                                                    SCH 266 
      I=I-1                                                             SCH 267 
      Q(4) =QQ(I)                                                       SCH 268 
  404 P(4)=EXPF(-R(I)*SQRTF(Q(4)))                                      SCH 269 
      IF (ABSF(P(4))-1.0E-35) 4041,4041,405                             SCH 270 
 4041 KKK=KKK -40                                                       SCH 271 
      IF(KKK -IMATCH) 4042,4042,45                                      SCH 272 
 4042 WRITE OUTPUT TAPE 6,4043,Z ,NN,LAM,KKK                            SCH 273 
 4043 FORMAT  (6H0AT Z=,F6.0,6H  NL =,I3,I1,7H  KKK =,I5,22H IS LESS THASCH 274 
     1N IMATCH =,I5,43H INWARD INTEGRATION WILL BE TRIED AT KKK+40)     SCH 275 
      KKK =KKK +40                                                      SCH 276 
      P(4 ) = 1.5E-35                                                   SCH 277 
      P(3) = 1.0E-35                                                    SCH 278 
  405 IF(PMATCH)102,77,103                                              SCH 279 
  102 P(3)=-P(3)                                                        SCH 280 
      P(4)=-P(4)                                                        SCH 281 
  103 SNLO(I+1)=P(3)                                                    SCH 282 
      SNLO(I)=P(4)                                                      SCH 283 
      T(3)=P(3)*(1.0-HSQ12 *Q(3))                                       SCH 284 
      T(4)=P(4)*(1.0-HSQ12*Q(4))                                        SCH 285 
      D(4)=T(4)-T(3)                                                    SCH 286 
  104 DO 106 M=2,40                                                     SCH 287 
      I=I-1                                                             SCH 288 
      Q(5) =QQ(I)                                                       SCH 289 
      D(5)=HSQ*Q(4)*P(4)+D(4)                                           SCH 290 
      T(5)=D(5)+T(4)                                                    SCH 291 
      P(5)=T(5)/(1.0-HSQ12*Q(5))                                        SCH 292 
      IF(I-IMATCH+1)77,200,105                                          SCH 293 
  105 SNLO(I)=P(5)                                                      SCH 294 
      DO 106 K=1,4                                                      SCH 295 
      P(K)=P(K+1)                                                       SCH 296 
      T(K)=T(K+1)                                                       SCH 297 
      D(K)=D(K+1)                                                       SCH 298 
  106 Q(K)=Q(K+1)                                                       SCH 299 
      Q(5) =QQ(I-2)                                                     SCH 300 
      D(5)=HSQ*Q(4)*P(4)+D(4)                                           SCH 301 
      T(5)=D(5)+T(4)                                                    SCH 302 
       P(5)=T(5)/(1.0-HSQ12*Q(5))                                       SCH 303 
      P(5)=1.09375*P(4)+0.2734375*P(5)-0.546875*P(3)+0.21875*P(2)-      SCH 304 
     10.0390625*P(1)                                                    SCH 305 
      I=I-1                                                             SCH 306 
      DX=DX/2.0                                                         SCH 307 
      Q(5) =QQ(I)                                                       SCH 308 
      H=DX                                                              SCH 309 
      HSQ=H*H                                                           SCH 310 
      HSQ12=HSQ/12.0                                                    SCH 311 
      T(5)=P(5)*(1.0-HSQ12*Q(5))                                        SCH 312 
      T(4)=P(4)*(1.0-HSQ12*Q(4))                                        SCH 313 
      D(5)=T(5)-T(4)                                                    SCH 314 
      SNLO(I)=P(5)                                                      SCH 315 
      DO 107 L=1,4                                                      SCH 316 
      P(L)=P(L+1)                                                       SCH 317 
      T(L)=T(L+1)                                                       SCH 318 
      D(L)=D(L+1)                                                       SCH 319 
  107 Q(L)=Q(L+1)                                                       SCH 320 
      GO TO 104                                                         SCH 321 
C     MATCHING RADIUS HAS BEEN REACHED COMING IN                        SCH 322 
  200 K=KKK                                                             SCH 323 
      VALUE=SNLO(K)**2                                                  SCH 324 
      GO TO 202                                                         SCH 325 
 2001  CONTINUE                                                         SCH 326 
  201  SUM3=SUM3+XIF*SUM4                                               SCH 327 
       XIF =XIF*0.5                                                     SCH 328 
  202 MM=8                                                              SCH 329 
      SUM4 =0.0                                                         SCH 330 
  203 Y=VALUE                                                           SCH 331 
      VALUE=SNLO(K-5)**2                                                SCH 332 
      SUM4=SUM4+19.0*(VALUE+Y)+75.0*(SNLO(K-1)**2+SNLO(K-4)**2)         SCH 333 
     1+50.0*(SNLO(K-2)**2+SNLO(K-3)**2)                                 SCH 334 
      K=K-5                                                             SCH 335 
       IF(K-IMATCH) 77,2031,2030                                        SCH 336 
 2030  MM=MM-1                                                          SCH 337 
       IF(MM)  77,2001,203                                              SCH 338 
 2031 SUM3=SUM3+XIF*SUM4                                                SCH 339 
  204 S3=SUM3/P(4)**2                                                   SCH 340 
      PPIN=(T(5)-T(3)-0.5*(P(5)-P(3)))/H                                SCH 341 
      S4=PPIN/P(4)                                                      SCH 342 
      DE=(S2-S4)/(S1-S3)                                                SCH 343 
      IF(ABSF(DE/E)-THRESH) 300,205,205                                 SCH 344 
  205 E=E+DE                                                            SCH 345 
      IF(E)10,206,206                                                   SCH 346 
  206 E=E-DE                                                            SCH 347 
      DE=DE/2.0                                                         SCH 348 
      GO TO 205                                                         SCH 349 
C     IMPROVE TRIAL EIGENVALUE BY PERTURBATION THEORY IF NECESSARY      SCH 350 
C     CALCULATE THE NORMALIZED WAVE FUNCTIONS                           SCH 351 
  300  POP=PMATCH/P(4)                                                  SCH 352 
      DO 302 J=IMATCH,KKK                                               SCH 353 
  302 SNLO(J)=SNLO(J)*POP                                               SCH 354 
      SUM1=0.0                                                          SCH 355 
      J=1                                                               SCH 356 
      XIF=XIFC                                                          SCH 357 
      VALUE=0.0                                                         SCH 358 
  303 MM=8                                                              SCH 359 
      XIF=XIF+XIF                                                       SCH 360 
      SUM2=0.0                                                          SCH 361 
  304 Y=VALUE                                                           SCH 362 
      VALUE=SNLO(J+5)**2                                                SCH 363 
      SUM2=SUM2+19.0*(VALUE+Y)+75.0(SNLO(J+4)**2+SNLO(J+1)**2)          SCH 364 
     1+50.0*(SNLO(J+2)**2+SNLO(J+3)**2)                                 SCH 365 
      J=J+5                                                             SCH 366 
      MM=MM-1                                                           SCH 367 
      IF(MM)77,305,304                                                  SCH 368 
  305 SUM1=SUM1+XIF*SUM2                                                SCH 369 
      IF(KKK-J)77,307,303                                               SCH 370 
  307 C1=SQRTF(SUM1)                                                    SCH 371 
      IF(SNLO(3))308,77,310                                             SCH 372 
  308 C1=-C1                                                            SCH 373 
  310 DO 311 I=1,KKK                                                    SCH 374 
  311 SNLO(I)=SNLO(I)/C1                                                SCH 375 
      EN=E                                                              SCH 376 
      RETURN                                                            SCH 377 
      END                                                               SCH 378 
      SUBROUTINE CROSYM(M)                                              CRO 001 
C     SIMULTANEOUS EQUATION SOLVER                                      CRO 002 
C     WRITTEN BY I.C. HANSON, SCIENTIFIC COMPUTATION DEPARTMENT,        CRO 003 
C     LOCKHEED MISSLES AND SPACE COMPANY, SUNNYVALE, CALIFORNIA         CRO 004 
C     SOLVE M SIMULTANEOUS EQUATIONS BY THE METHOD OF CROUT             CRO 005 
      DIMENSION R(521),RSCORE(521),RUINL1(521), RU2(521), RU(521),      CRO 006 
     1 NNLZ(24),       RSVALE(521),RUFNL1(521), RU3(521), XI(521),      CRO 007 
     2 WWNL(24),V(521),RSATOM(521),RUINL2(521),           XJ(521),      CRO 008 
     3 NKKK(24),EE(24),RUEXCH(521),RUFNL2(521),                         CRO 009 
     4 SNL(24,521),      SNLO(521),A(4,5)                               CRO 010 
      COMMON V,SNLO, R, RSCORE,RSVALE,RU,RUEXCH,XI,XJ,    RSATOM,  SNL, CRO 011 
     1RUINL1,RUFNL1,RUINL2,RUFNL2,          RU2,RU3,NNLZ,WWNL,NKKK,EE,A CRO 012 
      N=M+1                                                             CRO 013 
      I1=1                                                              CRO 014 
    1 I3=I1                                                             CRO 015 
      SUM=ABSF(A(I1,I1))                                                CRO 016 
      DO3I=I1,M                                                         CRO 017 
      IF(SUM-ABSF(A(I,I1)))2,3,3                                        CRO 018 
    2 I3=I                                                              CRO 019 
      SUM=ABSF(A(I,I1))                                                 CRO 020 
    3 CONTINUE                                                          CRO 021 
      IF(I3-I1)4,6,4                                                    CRO 022 
    4 DO 5J=1,N                                                         CRO 023 
      SUM=-A(I1,J)                                                      CRO 024 
      A(I1,J)=A(I3,J)                                                   CRO 025 
    5 A(I3,J)=SUM                                                       CRO 026 
    6 I3=I1+1                                                           CRO 027 
      DO7I=I3,M                                                         CRO 028 
    7 A(I,I1)=A(I,I1)/A(I1,I1)                                          CRO 029 
   14 J2=I1-1                                                           CRO 030 
      I3=I1+1                                                           CRO 031 
      IF(J2)8,11,8                                                      CRO 032 
    8 DO9J=I3,N                                                         CRO 033 
      DO9I=1,J2                                                         CRO 034 
    9 A(I1,J)=A(I1,J)-A(I1,I)*A(I,J)                                    CRO 035 
      IF(I1-M)11,15,11                                                  CRO 036 
   11 J2=I1                                                             CRO 037 
      I1=I1+1                                                           CRO 038 
      DO12I=I1,M                                                        CRO 039 
      DO12J=1,J2                                                        CRO 040 
   12 A(I,I1)=A(I,I1)-A(I,J)*A(J,I1)                                    CRO 041 
      IF(I1-M)1,14,1                                                    CRO 042 
   15 DO17I=1,M                                                         CRO 043 
      J2=M-I                                                            CRO 044 
      I3=J2+1                                                           CRO 045 
      A(I3,N)=A(I3,N)/A(I3,I3)                                          CRO 046 
      IF(J2)16,18,16                                                    CRO 047 
   16 DO17J=1,J2                                                        CRO 048 
   17 A(J,N)=A(J,N)-A(I3,N)*A(J,I3)                                     CRO 049 
   18 RETURN                                                            CRO 050 
      END                                                               CRO 051 
