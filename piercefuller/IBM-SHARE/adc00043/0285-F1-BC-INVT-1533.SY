*     LABEL                                                             INVT 001
*     FORTRAN                                                           INVT 002
C          GENERAL MATRIX INVERSION SUBROUTINE                          INVT 003
C                                                                       INVT 004
      SUBROUTINE INVERT(A,NN,N,M,C)                                     INVT 005
C                                                                       INVT 006
      DIMENSION A(1),M(1),C(1)                                          INVT 007
C                                                                       INVT 008
      IF (NN-1) 80,70,80                                                INVT 009
   70 A(1)=1./A(1)                                                      INVT 010
      GO TO 300                                                         INVT 011
   80 DO 90 I=1,NN                                                      INVT 012
   90 M(I)=-I                                                           INVT 013
C                                                                       INVT 014
      DO 140 I=1,NN                                                     INVT 015
C                                                                       INVT 016
C     LOCATE LARGEST ELEMENT                                            INVT 017
C                                                                       INVT 018
      D=0.0                                                             INVT 019
      DO 112 L=1,NN                                                     INVT 020
      IF (M(L)) 100,100,112                                             INVT 021
  100 J=L                                                               INVT 022
      DO 110 K=1,NN                                                     INVT 023
      IF (M(K)) 103,103,108                                             INVT 024
  103 IF (ABSF(D)-ABSF(A(J))) 105,105,108                               INVT 025
  105 LD=L                                                              INVT 026
      KD=K                                                              INVT 027
      D=A(J)                                                            INVT 028
  108 J=J+N                                                             INVT 029
  110 CONTINUE                                                          INVT 030
  112 CONTINUE                                                          INVT 031
C                                                                       INVT 032
C     INTERCHANGE ROWS                                                  INVT 033
C                                                                       INVT 034
      TEMP=-M(LD)                                                       INVT 035
      M(LD)=M(KD)                                                       INVT 036
      M(KD)=TEMP                                                        INVT 037
      L=LD                                                              INVT 038
      K=KD                                                              INVT 039
      DO 114 J=1,NN                                                     INVT 040
      C(J)=A(L)                                                         INVT 041
      A(L)=A(K)                                                         INVT 042
      A(K)=C(J)                                                         INVT 043
      L=L+N                                                             INVT 044
  114 K=K+N                                                             INVT 045
C                                                                       INVT 046
C     DIVIDE COLUNM BY LARGEST ELEMENT                                  INVT 047
C                                                                       INVT 048
      NR=(KD-1)*N+1                                                     INVT 049
      NH=NR+N-1                                                         INVT 050
      DO 115 K=NR,NH                                                    INVT 051
  115 A(K)=A(K)/D                                                       INVT 052
C                                                                       INVT 053
C     REDUCE REMAINING ROWS AND COLUMNS                                 INVT 054
C                                                                       INVT 055
      L=1                                                               INVT 056
      DO 135 J=1,NN                                                     INVT 057
      IF (J-KD) 130,125,130                                             INVT 058
  125 L=L+N                                                             INVT 059
      GO TO 135                                                         INVT 060
  130 DO 134 K=NR,NH                                                    INVT 061
      A(L)=A(L)-C(J)*A(K)                                               INVT 062
  134 L=L+1                                                             INVT 063
  135 CONTINUE                                                          INVT 064
C                                                                       INVT 065
C     REDUCE ROW                                                        INVT 066
C                                                                       INVT 067
      C(KD)=-1.0                                                        INVT 068
      J=KD                                                              INVT 069
      DO 140 K=1,NN                                                     INVT 070
      A(J)=-C(K)/D                                                      INVT 071
  140 J=J+N                                                             INVT 072
C                                                                       INVT 073
C     INTERCHANGE COLUMNS                                               INVT 074
C                                                                       INVT 075
      DO 200 I=1,NN                                                     INVT 076
      L=0                                                               INVT 077
  150 L=L+1                                                             INVT 078
      IF(M(L)-I) 150,160,150                                            INVT 079
  160 K=(L-1)*N+1                                                       INVT 080
      J=(I-1)*N+1                                                       INVT 081
      M(L)=M(I)                                                         INVT 082
      M(I)=I                                                            INVT 083
      DO 200 L=1,NN                                                     INVT 084
      TEMP=A(K)                                                         INVT 085
      A(K)=A(J)                                                         INVT 086
      A(J)=TEMP                                                         INVT 087
      J=J+1                                                             INVT 088
  200 K=K+1                                                             INVT 089
C                                                                       INVT 090
  300 RETURN                                                            INVT 091
C                                                                       INVT 092
      END                                                               INVT 093
