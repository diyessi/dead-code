       PMC                                                              INGE0000
       LBL     INGE0000                                                 INGE0010
       COUNT   900                                                      INGE0020
       REM     SUBROUTINE INGE (X,P,I)                                  INGE0030
       REM                                                              INGE0040
       REM     15 MAR 63                                                INGE0050
       REM     RUDOLF LOESER                                            INGE0060
       REM                                                              INGE0070
       REM     INGE COMPUTES THE INCOMPLETE GAMMA FUNCTION OF X,P FOR   INGE0080
       REM     ALL POSITIVE VALUES OF X, AND FOR P=(2*N+1)*(1/2), FOR   INGE0090
       REM     N A POSITIVE INTEGER.                                    INGE0100
       REM                                                              INGE0110
       REM     THE ARGUMENTS X AND P MUST BE DOUBLE PRECISION QUANTITIESINGE0120
       REM     STORED IN THE FORTRAN II, V. 2, CONVENTION FOR DOUBLE    INGE0130
       REM     PRECISION CONSTANTS, - I.E. MOST SIGNIFICANT PART IN X,  INGE0140
       REM     LEAST SIGNIFICANT PART IN X-1. INGE RETURNS THE ANSWER   INGE0150
       REM     AS A DOUBLE PRECISION NUMBER STORED SIMILARLY IN I, I-1. INGE0160
       REM                                                              INGE0170
       REM     THE ANSWER IS PRECISE TO 14 OR MORE DECIMAL DIGITS.      INGE0180
       REM                                                              INGE0190
       REM     THERE ARE NO ERROR RETURNS -                             INGE0200
       REM     INGE WILL ALWAYS COMPUTE AN ANSWER, AND IF THE ARGUMENTS INGE0210
       REM     ARE NOT ACCEPTABLE AS GIVEN, THEN THEY WILL BE CHANGED TOINGE0220
       REM     BE ACCEPTABLE. SPECIFICALLY, THE SIGNS OF X AND P WILL   INGE0230
       REM     ALWAYS BE SET +, AND, MOREOVER, P WILL ALWAYS BE ROUNDED INGE0240
       REM     TO THE NEAREST ODD INTEGRAL MULTIPLE OF 1/2.             INGE0250
       REM     THEREFORE -                                              INGE0260
       REM     IF THIS SALVAGE PROCEDURE IS NOT WANTED, THE USER SHOULD INGE0270
       REM     TEST HIS ARGUMENTS HIMSELF BEFORE TELLING INGE TO USE    INGE0280
       REM     THEM.                                                    INGE0290
       REM                                                              INGE0300
       REM     INGE SAVES THE ARGUMENTS AND ANSWER FROM THE PREVIOUS    INGE0310
       REM     CALL, IN ORDER TO SAVE TIME BY SKIPPING PART OR ALL      INGE0320
       REM     OF THE COMPUTATION.                                      INGE0330
       REM                                                              INGE0340
       REM     INGE IS A COMPLETE ROUTINE, AND USES NO ADDITIONAL       INGE0350
       REM     SUBPROGRAMS. THE FMS LIBRARY ROUTINES FOR DSQRT AND DEXP INGE0360
       REM     HAVE BEEN BUILT DIRECTLY INTO THE PROGRAM.               INGE0370
       REM                                                              INGE0380
       REM     THE CALLING SEQUENCE IS    TSX   INGE,4                  INGE0390
       REM                                PZE   X                       INGE0400
       REM                                PZE   P                       INGE0410
       REM                                PZE   I                       INGE0420
       REM                                                              INGE0430
       REM                                                              INGE0440
       EJECT                                                            INGE0450
DLD    MACRO   AM,AL          DOUBLE LOAD                               INGE0460
       CLA     AM                                                       INGE0470
       LDQ     AL                                                       INGE0480
DLD    END                                                              INGE0490
       REM                                                              INGE0500
DST    MACRO   AM,AL          DOUBLE STORE                              INGE0510
       STO     AM                                                       INGE0520
       STQ     AL                                                       INGE0530
DST    END                                                              INGE0540
       REM                                                              INGE0550
DTR    MACRO   AM,AL,BM,BL    DOUBLE TRANSMIT                           INGE0560
       DLD     (AM),(AL)                                                INGE0570
       DST     (BM),(BL)                                                INGE0580
DTR    END                                                              INGE0590
       REM                                                              INGE0600
DAD    MACRO   AM,AL,BM,BL    DOUBLE FLOATING ADD                       INGE0610
       CLA     AM                                                       INGE0620
       FAD     BM                                                       INGE0630
       STO     E1                                                       INGE0640
       XCA                                                              INGE0650
       FAD     AL                                                       INGE0660
       FAD     BL                                                       INGE0670
       FAD     E1                                                       INGE0680
DAD    END                                                              INGE0690
       REM                                                              INGE0700
DSU    MACRO   AM,AL,BM,BL    DOUBLE FLOATING SUBTRACT                  INGE0710
       CLA     AM                                                       INGE0720
       FSB     BM                                                       INGE0730
       STO     E1                                                       INGE0740
       XCA                                                              INGE0750
       FAD     AL                                                       INGE0760
       FSB     BL                                                       INGE0770
       FAD     E1                                                       INGE0780
DSU    END                                                              INGE0790
       REM                                                              INGE0800
DMP    MACRO   AM,AL,BM,BL    DOUBLE FLOATING MULTIPLY                  INGE0810
       LDQ     BM                                                       INGE0820
       FMP     AM                                                       INGE0830
       STO     E1                                                       INGE0840
       STQ     E2                                                       INGE0850
       LDQ     BM                                                       INGE0860
       FMP     AL                                                       INGE0870
       FAD     E2                                                       INGE0880
       STO     E2                                                       INGE0890
       LDQ     AM                                                       INGE0900
       FMP     BL                                                       INGE0910
       FAD     E2                                                       INGE0920
       FAD     E1                                                       INGE0930
DMP    END                                                              INGE0940
       REM                                                              INGE0950
DDV    MACRO   AM,AL,BM,BL    DOUBLE FLOATING DIVIDE                    INGE0960
       CLA     AM                                                       INGE0970
       FDP     BM                                                       INGE0980
       STQ     E1                                                       INGE0990
       FAD     AL                                                       INGE1000
       FDP     BM                                                       INGE1010
       STQ     E2                                                       INGE1020
       CLS     BL                                                       INGE1030
       FDP     BM                                                       INGE1040
       FMP     E1                                                       INGE1050
       FAD     E2                                                       INGE1060
       FAD     E1                                                       INGE1070
DDV    END                                                              INGE1080
       REM                                                              INGE1090
DCS    MACRO                  DOUBLE CHANGE SIGN                        INGE1100
       CHS                                                              INGE1110
       LRS     0                                                        INGE1120
DCS    END                                                              INGE1130
       REM                                                              INGE1140
DSP    MACRO                  DOUBLE SET SIGN PLUS                      INGE1150
       SSP                                                              INGE1160
       LRS     0                                                        INGE1170
DSP    END                                                              INGE1180
       EJECT                                                            INGE1190
       ENTRY   INGE                                                     INGE1200
INGE   SXA     XRS,1                                                    INGE1210
       SXA     XRS+1,2                                                  INGE1220
       SXA     XRS+2,4                                                  INGE1230
       CLA     1,4 SET UP ADDRESS TO BRING X                            INGE1240
       STA     *+3                                                      INGE1250
       SUB     =1                                                       INGE1260
       STA     *+2                                                      INGE1270
       DTR     **,**,XO,XO-1 BRING X AND STORE IN XO                    INGE1280
       CLA     2,4 SET UP ADDRESS TO BRING P                            INGE1290
       STA     *+3                                                      INGE1300
       SUB     =1                                                       INGE1310
       STA     *+2                                                      INGE1320
       DTR     **,**,PO,PO-1 BRING P AND STORE IN PO                    INGE1330
       CLA     3,4 SET UP ADDRESSES TO STORE ANSWER                     INGE1340
       STA     *+4                                                      INGE1350
       SUB     =1                                                       INGE1360
       STA     *+3                                                      INGE1370
       TRA     MORE                                                     INGE1380
       REM                                                              INGE1390
INRE   DST     **,** RETURN RESULT                                      INGE1400
       DST     ILAST,ILAST-1 SAVE RESULT                                INGE1410
       DTR     XO,XO-1,XLAST,XLAST-1 SAVE XO                            INGE1420
       DTR     PO,PO-1,PLAST,PLAST-1 SAVE PO                            INGE1430
XRS    AXT     ,1                                                       INGE1440
       AXT     ,2                                                       INGE1450
       AXT     ,4                                                       INGE1460
       TRA     4,4                                                      INGE1470
       REM                                                              INGE1480
MORE   CLA     XO TEST XO                                               INGE1490
       TNZ     *+4                                                      INGE1500
       ZAC      SINCE XO=0, SET ANSWER =0                               INGE1510
       LDQ     =0                                                       INGE1520
       TRA     INRE AND GO                                              INGE1530
       REM                                                              INGE1540
       TPL     *+7                                                      INGE1550
       DLD     XO,XO-1 SINCE XO IS NEGATIVE, MAKE IT POSITIVE           INGE1560
       DSP                                                              INGE1570
       DST     XO,XO-1                                                  INGE1580
       REM                                                              INGE1590
       CAL     PO ADJUST PO -                                           INGE1600
       UFA     =O232000000000 ISOLATE ALL BITS GREATER THAN 1/4         INGE1610
       LDQ     =0 ZERO MQ                                               INGE1620
       ORA     =1 FORCE 1/2 BIT                                         INGE1630
       FAD     =0 NORMALIZE                                             INGE1640
       STO     PO (NOW SINGLE PRECISION ONLY)                           INGE1650
       STZ     PO-1                                                     INGE1660
       REM                                                              INGE1670
       REM     CHECK IF PART OF ANSWER IS KNOWN                         INGE1680
       DSU     XO,XO-1,XLAST,XLAST-1                                    INGE1690
       TNZ     CHCA                                                     INGE1700
       CLA     PO                                                       INGE1710
       SUB     PLAST                                                    INGE1720
       TNZ     RECU BASIC ANSWER KNOWN, COMPUTE RECURSION REL.          INGE1730
       REM                                                              INGE1740
       DLD     ILAST,ILAST-1 ENTIRE ANSWER KNOWN, BRING IT              INGE1750
       TRA     INRE AND GO                                              INGE1760
       REM                                                              INGE1770
CHCA   CLA     XO TEST IF XO GREATER THAN 39.0                          INGE1780
       SUB     =39.0                                                    INGE1790
       TMI     NOSIR NO, COMPUTE FOR P=0.5                              INGE1800
       REM                                                              INGE1810
       REM     YES, COMPUTE RECURSION RELATION ONLY                     INGE1820
       DLD     ((G)-51),((G)-102)                                       INGE1830
       TRA     INHM                                                     INGE1840
       REM                                                              INGE1850
NOSIR  CLA     XO DECIDE HOW TO COMPUTE                                 INGE1860
       SUB     =1.0                                                     INGE1870
       TMI     SERI USE INFINITE SERIES                                 INGE1880
       TPL     TAB USE TABLE                                            INGE1890
       DLD     ((G)),((G)-51) USE KNOWN ANSWER                          INGE1900
       REM                                                              INGE1910
INHM   DST     IG,IG-1 SAVE RESULT FOR P=0.5                            INGE1920
       REM                                                              INGE1930
       TRA     RECU                                                     INGE1940
       EJECT                                                            INGE1950
SERI   DLD     XO,XO-1 BRING XO                                         INGE1960
       TSX     DSQRT,4 FIND ITS SQUARE ROOT                             INGE1970
       DST     S1,S2                                                    INGE1980
       DMP     XO,XO-1,S1,S2 *XO                                        INGE1990
       DST     S1,S2                                                    INGE2000
       DMP     =2.,=0,S1,S2 *2.0                                        INGE2010
       DST     S1,S2 AND SAVE THIS NUMBER                               INGE2020
       REM                                                              INGE2030
       DTR     THR,THR-1,SSUM,SSUM-1 INITIALIZE SSUM                    INGE2040
       DTR     =1.,=0,XP,XP-1 INITIALIZE XP                             INGE2050
       REM                                                              INGE2060
       AXT     1,4 LOOP FOR SUCCESSIVE PARTIAL SUMS                     INGE2070
SLOP   DMP     XP,XP-1,XO,XO-1 XP=XP*XO                                 INGE2080
       DST     XP,XP-1                                                  INGE2090
       DDV     XP,XP-1,((B),4),((B)-18,4) TERM=XP/((2*I+3)*I FACT.)     INGE2100
       DST     TE,TE-1 SAVE TERM                                        INGE2110
       SSP      TEST TERM                                               INGE2120
       SUB     =1.E-18                                                  INGE2130
       TMI     ALL                                                      INGE2140
       DAD     TE,TE-1,SSUM,SSUM-1 TERM STILL SIGNIFICANT, ADD IT       INGE2150
       DST     SSUM,SSUM-1                                              INGE2160
       TXI     *+1,4,1 AND REPEAT LOOP                                  INGE2170
       TXL     SLOP,4,18 (NOT MORE THAN 18 TERMS NEEDED)                INGE2180
       REM                                                              INGE2190
ALL    DMP     SSUM,SSUM-1,S1,S2 ANSWER=SSUM*2*XO*SQRT(XO)              INGE2200
       TRA     INHM AND GO.                                             INGE2210
       EJECT                                                            INGE2220
TAB    CLA     XO FIND INDEX OF LARGEST ENTRY IN (X) TABLE              INGE2230
       UFA     =O233000000000 NOT EXCEEDING XO                          INGE2240
       RQL     9                                                        INGE2250
       PAX     ,1                                                       INGE2260
       TXL     *+2,1,4                                                  INGE2270
       TXI     TGO,1,12                                                 INGE2280
       LGL     1                                                        INGE2290
       PAX     ,1                                                       INGE2300
       TXL     *+2,1,5                                                  INGE2310
       TXI     TGO,1,7                                                  INGE2320
       LGL     1                                                        INGE2330
       PAX     ,1                                                       INGE2340
       TXL     *+2,1,7                                                  INGE2350
       TXI     TGO,1,1                                                  INGE2360
       LGL     1                                                        INGE2370
       PAX     ,1                                                       INGE2380
       TIX     *+1,1,7                                                  INGE2390
TGO    DTR     ((M),1),((M)-51,1),Z,Z-1 SET UP Z                        INGE2400
       DTR     ((X),1),((X)-51,1),LA,LA-1 SET UP LA FOR BRAK            INGE2410
       DSU     XO,XO-1,LA,LA-1 DEL=XO-(X)                               INGE2420
       TZE     OJOY IF DEL=0, ANSWER IS KNOWN                           INGE2430
       DST     DEL,DEL-1                                                INGE2440
       SXA     TSA,1                                                    INGE2450
       TRA     BRAK COMPUTE BRACKET FOR THIS DEL                        INGE2460
BRET   DST     T1,T2                                                    INGE2470
       DMP     T1,T2,Z,Z-1 INGE(XO)=G((X))+Z*BRACKET                    INGE2480
       DST     T1,T2                                                    INGE2490
TSA    AXT     ,1                                                       INGE2500
       DAD     T1,T2,((G),1),((G)-51,1)                                 INGE2510
       TRA     INHM AND GO HOME                                         INGE2520
       REM                                                              INGE2530
OJOY   DLD     ((G),1),((G)-51,1) BRING KNOWN ANSWER                    INGE2540
       TRA     INHM AND GO.                                             INGE2550
       REM                                                              INGE2560
BRAK   CLA     =1.E-18 COMPUTE CONVERGENCE CRITERION A                  INGE2570
       FDP     Z                                                        INGE2580
       STQ     A                                                        INGE2590
       AXT     50,1 INITIALIZE DELP TABLE                               INGE2600
       STZ     DELP,1                                                   INGE2610
       TIX     *-1,1,1                                                  INGE2620
       REM                                                              INGE2630
       AXT     0,1 INITIALIZE N                                         INGE2640
       TSX     BLIM,4 COMPUTE CONVERGENCE CRITERION B                   INGE2650
       TSX     FCOM,4 GET F(0)                                          INGE2660
       DST     B1,B2                                                    INGE2670
       DMP     B1,B2,DEL,DEL-1 *DEL                                     INGE2680
       DST     BSUM,BSUM-1 INITIALIZE BSUM                              INGE2690
       CLS     LA SET UP LAM (=-LA)                                     INGE2700
       STO     LAM                                                      INGE2710
       CLS     LA-1                                                     INGE2720
       STO     LAM-1                                                    INGE2730
       CLA     =-1. INITIALIZE LAP (=SUCCESSIVE POWERS OF LA, ALT. SGN) INGE2740
       STO     LAP                                                      INGE2750
       STZ     LAP-1                                                    INGE2760
       REM                                                              INGE2770
BLOP   TXI     *+1,1,1 LOOP FOR SUCCESSIVE PARTIAL BRACKET SUMS         INGE2780
       DMP     LAP,LAP-1,LAM,LAM-1 LAP*LAM=LAP                          INGE2790
       DST     LAP,LAP-1                                                INGE2800
       TSX     BLIM,4 RECOMPUTE CONVERGENCE CRITERION B                 INGE2810
       TSX     FCOM,4 GET F(N)                                          INGE2820
       DST     B1,B2 AND SAVE IT                                        INGE2830
       TSX     GDEL,4 GET DEL**(N+1)                                    INGE2840
       PZE     1 CASE 1                                                 INGE2850
       DST     B3,B4 AND SAVE                                           INGE2860
       DMP     B1,B2,B3,B4 NOW MULTIPLY                                 INGE2870
       DST     B1,B2                                                    INGE2880
       DMP     B1,B2,(C,1),(C-18,1) *C(N)                               INGE2890
       DST     B1,B2                                                    INGE2900
       DDV     B1,B2,LAP,LAP-1 /LAP                                     INGE2910
       DST     B1,B2                                                    INGE2920
       SSP      TEST MAGNITUDE OF CURRENT TERM                          INGE2930
       SUB     A                                                        INGE2940
       TMI     BHOM                                                     INGE2950
       DAD     BSUM,BSUM-1,B1,B2 TERM STILL SIGNIFICANT, ADD IT         INGE2960
       DST     BSUM,BSUM-1                                              INGE2970
       TRA     BLOP                                                     INGE2980
       REM                                                              INGE2990
BHOM   DLD     BSUM,BSUM-1 BRING SUM AND RETURN                         INGE3000
       TRA     BRET                                                     INGE3010
       EJECT                                                            INGE3020
FCOM   SXA     FHOM+2,4                                                 INGE3030
       AXT     1,2 INITIALIZE M                                         INGE3040
       SXA     *+4,1                                                    INGE3050
       SXA     *+2,2                                                    INGE3060
       TSX     GGEN,4 GET G(N,1)                                        INGE3070
       OCT     233000000000 M                                           INGE3080
       OCT     233000000000 N                                           INGE3090
       DST     FSUM,FSUM-1                                              INGE3100
       STZ     FSIGN INITIALIZE SIGN FLAG                               INGE3110
FLOP   TXI     *+1,2,1                                                  INGE3120
       SXA     *+4,1                                                    INGE3130
       SXA     *+2,2                                                    INGE3140
       TSX     GGEN,4 GET G(N,M)                                        INGE3150
       OCT     233000000000 M                                           INGE3160
       OCT     233000000000 N                                           INGE3170
       DST     F1,F2                                                    INGE3180
       TSX     GDEL,4 GET DEL**(M-1)                                    INGE3190
       PZE     2 CASE 2                                                 INGE3200
       DST     F3,F4                                                    INGE3210
       DMP     F1,F2,F3,F4                                              INGE3220
       DST     F1,F2                                                    INGE3230
       DDV     F1,F2,(FACT,2),(FACT-18,2) / M FACTORIAL                 INGE3240
       STO     F3 (SAVE M.S. FOR MAGNITUDE TEST LATER)                  INGE3250
       ZET     FSIGN ADJUST SIGN OF TERM                                INGE3260
       TRA     FPLUS                                                    INGE3270
       DCS      RESET SIGN                                              INGE3280
       AXT     1,4                                                      INGE3290
       SXA     FSIGN,4 RESET SIGN FLAG                                  INGE3300
       TRA     FSTORE                                                   INGE3310
FPLUS  AXT     0,4 RESET SIGN FLAG ONLY                                 INGE3320
       SXA     FSIGN,4                                                  INGE3330
FSTORE DST     F1,F2                                                    INGE3340
       REM                                                              INGE3350
       CLA     F3 CHECK MAGNITUDE OF TERM                               INGE3360
       SUB     B                                                        INGE3370
       TMI     FHOM                                                     INGE3380
       DAD     FSUM,FSUM-1,F1,F2 TERM STILL SIGNIFICANT, ADD IT         INGE3390
       DST     FSUM,FSUM-1                                              INGE3400
       TRA     FLOP                                                     INGE3410
       REM                                                              INGE3420
FHOM   DLD     FSUM,FSUM-1 BRING SUM AND RETURN                         INGE3430
       AXT     ,4                                                       INGE3440
       TRA     1,4                                                      INGE3450
       REM                                                              INGE3460
BLIM   SXA     BHYM,4 CONVERGENCE CRITERION B                           INGE3470
       TSX     GDEL,4                                                   INGE3480
       PZE     1 CASE 1                                                 INGE3490
       STO     E1                                                       INGE3500
       CLA     A                                                        INGE3510
       FDP     E1                                                       INGE3520
       STQ     B                                                        INGE3530
BHYM   AXT     ,4                                                       INGE3540
       TRA     1,4                                                      INGE3550
       REM                                                              INGE3560
GDEL   SXA     GHOM,4 COMPUTE DEL                                       INGE3570
       CLA     1,4 GET CODE                                             INGE3580
       AXT     0,4 CLEAR XR4                                            INGE3590
       SUB     =1 TEST CODE                                             INGE3600
       TZE     *+3                                                      INGE3610
       PXD     ,6 CASE 2, XR4=(XR2)-1                                   INGE3620
       TIX     *+3,4,1                                                  INGE3630
       PXD     ,5 CASE 1, XR4=(XR1)+1                                   INGE3640
       TXI     *+1,4,1                                                  INGE3650
       NZT     DELP,4 IS REQUIRED VALUE OF DELP ALREADY THERE           INGE3660
       TRA     GCOM NO, MUST COMPUTE IT                                 INGE3670
       DLD     (DELP,4),(DELP-25,4) YES, GET IT AND GO                  INGE3680
GHOM   AXT     ,4                                                       INGE3690
       TRA     2,4                                                      INGE3700
       REM                                                              INGE3710
GCOM   TXH     GET,4,1 TEST IF XR4=1                                    INGE3720
       DTR     DEL,DEL-1,(DELP,4),(DELP-25,4) YES, PUT DEL INTO DELP    INGE3730
       TRA     GHOM AND GO.                                             INGE3740
GET    DMP     DEL,DEL-1,(DELP+1,4),(DELP-24,4)                         INGE3750
       DST     (DELP,4),(DELP-25,4)                                     INGE3760
       TRA     GHOM                                                     INGE3770
       REM                                                              INGE3780
GGEN   ZAC      G GENERATOR                                             INGE3790
       FAD     1,4 NORMALIZE M                                          INGE3800
       STO     G1                                                       INGE3810
       FAD     2,4 FORM N+M                                             INGE3820
       STO     G2                                                       INGE3830
       CLA     G1                                                       INGE3840
       FDP     G2                                                       INGE3850
       STQ     G1                                                       INGE3860
       FDP     G2                                                       INGE3870
       XCA                                                              INGE3880
       FAD     G1                                                       INGE3890
       TRA     3,4                                                      INGE3900
       EJECT                                                            INGE3910
       REM     RECURSION RELATION FOR P GREATER THAN 0.5                INGE3920
       REM                                                              INGE3930
RECU   CLA     PO                                                       INGE3940
       SUB     =0.5                                                     INGE3950
       TNZ     BLAH                                                     INGE3960
       DLD     IG,IG-1 ANSWER ALREADY KNOWN, GET IT                     INGE3970
       TRA     INRE AND LEAVE                                           INGE3980
       REM                                                              INGE3990
BLAH   DLD     XO,XO-1 FIRST, COMPUTE CONSTANT                          INGE4000
       DCS                                                              INGE4010
       TSX     DEXP,4                                                   INGE4020
       DST     R1,R2                                                    INGE4030
       DLD     XO,XO-1                                                  INGE4040
       TSX     DSQRT,4                                                  INGE4050
       DST     R3,R4                                                    INGE4060
       DMP     R1,R2,R3,R4                                              INGE4070
       DST     GA,GA-1                                                  INGE4080
       REM                                                              INGE4090
       DTR     =1.5,=0,PG,PG-1 INITIALIZE PG                            INGE4100
       REM                                                              INGE4110
       DTR     XO,XO-1,PX,PX-1 INITIALIZE PX                            INGE4120
       REM                                                              INGE4130
       DTR     IG,IG-1,FN,FN-1 INITIALIZE FN                            INGE4140
       REM                                                              INGE4150
       REM     RECURSION LOOP                                           INGE4160
RELOOP DMP     PX,PX-1,GA,GA-1                                          INGE4170
       DST     R1,R2                                                    INGE4180
       DMP     FN,FN-1,PG,PG-1                                          INGE4190
       DST     R3,R4                                                    INGE4200
       DSU     R3,R4,R1,R2                                              INGE4210
       DST     FN,FN-1                                                  INGE4220
       CLA     PO CHECK IF FINISHED                                     INGE4230
       SUB     PG                                                       INGE4240
       TZE     YIPPEE YES                                               INGE4250
       DAD     PG,PG-1,=1.,=0 UPDATE PG                                 INGE4260
       DST     PG,PG-1                                                  INGE4270
       DMP     PX,PX-1,XO,XO-1 UPDATE PX                                INGE4280
       DST     PX,PX-1                                                  INGE4290
       TRA     RELOOP                                                   INGE4300
       REM                                                              INGE4310
YIPPEE DLD     FN,FN-1                                                  INGE4320
       TRA     INRE                                                     INGE4330
       EJECT                                                            INGE4340
       PZE                                                              INGE4350
PO     PZE                                                              INGE4360
       PZE                                                              INGE4370
IG     PZE                                                              INGE4380
