*     LABEL(DECRD)                                                      DECRD000
C     DECIMAL CARD READ SUBROUTINE                                      DECRD001
C                                                                       DECRD002
C ENG. COMP. LA -  J. WRIGHT                      SEPT. 1 , 1958        DECRD003
C                                                                       DECRD004
      SUBROUTINE DECRD (DATA)                                           DECRD005
      DIMENSION DRBU(5),DATA(1)                                         DECRD006
    9 READ INPUT TAPE 5,10,I1STL,(DRBU(I),I=1,5)                        DECRD007
   10 FORMAT (I12,5F12.0 )                                              DECRD008
      J=XABSF(I1STL)                                                    DECRD009
      DO 30 I=1,5                                                       DECRD010
      IF(DRBU(I)) 20,60,20                                              DECRD011
   20  DATA(J)= DRBU(I)                                                 DECRD012
   30 J=J+1                                                             DECRD013
      IF(I1STL) 50,40,9                                                 DECRD014
   40 CALL DUMP                                                         DECRD015
   50 RETURN                                                            DECRD016
   60 IF(SIGNF(2.,DRBU(I)))30,40,20                                     DECRD017
      END                                                               DECRD018
