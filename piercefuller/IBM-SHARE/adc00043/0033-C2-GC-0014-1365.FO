      SUBROUTINE DFERRI (X)                                             00140001
D     DIMENSION C(8), A(4), Y(3), X(8)                                  00140002
      DO 700 L=1,8                                                      00140003
D 700 C(L)=X(L)                                                         00140004
D     A(1)=1.0                                                          00140005
D     CLOD=.250*C(2)/C(1)                                               00140006
   14 IF (C(2)) 100, 101, 100                                           00140007
D 100 PLOD=C(1)**2                                                      00140008
D     P=C(3)/C(1)-.375*(C(2)**2)/PLOD                                   00140009
D     Q=C(4)/C(1)-.5*(C(3)*C(2))/(PLOD   )+.125*((C(2)/C(1))**3)        00140010
D     R=((C(2)**2)*C(3))/(16.0*(C(1)**3))-(3.0*(C(2)**4))/(256.0*(C(1)  00140011
D    1**4))-.25*(C(4)*C(2))/PLOD+C(5)/C(1)                              00140012
D 102 A(2)=-P                                                           00140013
D     A(3)=-4.0*R                                                       00140014
D     A(4)=4.0*P*R-Q**2                                                 00140015
      CALL DDVETA (A,Y, MTYPE)                                          00140016
      IF (MTYPE) 15, 15, 16                                             00140017
D  15 U=Y(1)                                                            00140018
      DO 666 L=2,3                                                      00140019
      IF (U-Y(L))  76, 666, 666                                         00140020
D  76 U=Y(L)                                                            00140021
  666 CONTINUE                                                          00140022
      GO TO 21                                                          00140023
   16 IF (Y(2)) 270, 271, 270                                           00140024
  271 IF(ABSF(Y(3))-10.0**(-7)) 272, 17, 17                             00140025
D 272 Y(2) = 0.0                                                        00140026
D     Y(3)=0.0                                                          00140027
      GO TO 15                                                          00140028
D 270 PLOD = ABSF(Y(3)/Y(2))-5.0E-7                                     00140029
      IF (PLOD) 18, 18, 17                                              00140030
D  17 U=Y(1)                                                            00140031
      GO TO 21                                                          00140032
D  18 PLOD=Y(1)-Y(2)                                                    00140033
      IF (PLOD) 20, 17, 17                                              00140034
D  20 U=Y(2)                                                            00140035
D  21 PLOD=U-P                                                          00140036
      IF (ABSF(PLOD)-10.0**(-10)) 200, 150, 150                         00140037
D 150 BIGA=SQRTF(PLOD)                                                  00140038
D     DISC1=BIGA**2-2.0*U+2.0*Q/BIGA                                    00140039
D     DISC2=DISC1-4.0*Q/BIGA                                            00140040
      IF (ABSF(DISC1)-10.0**(-15)) 204, 205, 205                        00140041
D 204 DISC1=0.0                                                         00140042
  205 IF (DISC1) 24, 22, 23                                             00140043
D  22   C (2)=0.0                                                       00140044
D       C (1)=-.50*BIGA                                                 00140045
D       C (3)=C(1)                                                      00140046
D       C (4)=0.0                                                       00140047
      GO TO 25                                                          00140048
D  23 DISC1=SQRTF(DISC1)                                                00140049
D       C (1)=.50*(DISC1-BIGA)                                          00140050
D       C (2)=0.0                                                       00140051
D       C (4)=0.0                                                       00140052
D       C (3)=   C(1)-DISC1                                             00140053
      GO TO 25                                                          00140054
D  24    C(1)=-.50*BIGA                                                 00140055
D       C (3)=  C (1)                                                   00140056
D     PLOD=ABSF(DISC1)                                                  00140057
D     C(2)   =.50*SQRTF(PLOD)                                           00140058
D     C(4)=-C(2)                                                        00140059
   25 IF(ABSF(DISC2)-10.0**(-15)) 210, 211, 211                         00140060
D 210 DISC2=0.0                                                         00140061
  211 IF (DISC2) 28, 26, 27                                             00140062
D  26   C (6)=0.0                                                       00140063
D       C (8)=  C (6)                                                   00140064
D       C (5)=.50*BIGA                                                  00140065
D       C (7)=  C (5)                                                   00140066
      GO TO 29                                                          00140067
D  27 DISC2=SQRTF(DISC2)                                                00140068
D       C (6)=0.0                                                       00140069
D       C (5)=.50*(DISC2+BIGA)                                          00140070
D       C (8)=0.0                                                       00140071
D       C (7)=  C (5)-DISC2                                             00140072
      GO TO 29                                                          00140073
D  28   C (5)=.50*BIGA                                                  00140074
D       C (7)=  C (5)                                                   00140075
D     PLOD=ABSF(DISC2)                                                  00140076
D       C (6)=.50*SQRTF(PLOD)                                           00140077
D     C(8)=-C(6)                                                        00140078
   29 DO 30  L=1,4                                                      00140079
D       C (2*L-1)=  C (2*L-1)-CLOD                                      00140080
   30 CONTINUE                                                          00140081
      DO 166 L=1,8                                                      00140082
D 166 X(L)= C(L)                                                        00140083
      RETURN                                                            00140084
D 101 P=C(3)    /C(1)                                                   00140085
D     Q=C(4)  /C(1)                                                     00140086
D     R=C(5) /C(1)                                                      00140087
      GO TO 102                                                         00140088
D 200 PLOD=P**2-4.0*R                                                   00140089
      IF (ABSF(PLOD)-10.0**(-15)) 201, 202, 202                         00140090
D 201 PLOD=0.0                                                          00140091
  202 IF (PLOD) 203, 300, 300                                           00140092
D 203 ABSZ=SQRTF(P**2-PLOD)/2.0                                         00140093
D     PHI  =ATAN2F(SQRTF(-PLOD),-P)                                     00140094
D     C(1)=ABSZ*COSF(PHI)                                               00140095
D     C(2)=ABSZ*SINF(PHI)                                               00140096
D     C(3)= C(1)                                                        00140097
D     C(4)=-C(2)                                                        00140098
D     C(5)=-C(1)                                                        00140099
D     C(6)= C(2)                                                        00140100
D     C(7)= C(5)                                                        00140101
D     C(8)=-C(2)                                                        00140102
      GO TO 29                                                          00140103
D 300 ZAP=SQRTF(PLOD)                                                   00140104
D     ZSQRE1=.50*(-P+ZAP)                                               00140105
D     ZSQRE2=ZSQRE1-ZAP                                                 00140106
      IF (ZSQRE1) 301, 302, 302                                         00140107
D 301 C(2)=SQRTF(-ZSQRE1)                                               00140108
D     C(4)=-C(2)                                                        00140109
D     C(1)=0.0                                                          00140110
D     C(3)=0.0                                                          00140111
      GO TO 310                                                         00140112
D 302 C(1)=SQRTF(ZSQRE1)                                                00140113
D     C(3)=-C(1)                                                        00140114
D     C(2)=0.0                                                          00140115
D     C(4)=0.0                                                          00140116
  310 IF (ZSQRE2) 303, 304, 304                                         00140117
D 303 C(6)=SQRTF(-ZSQRE2)                                               00140118
D     C(8)=-C(6)                                                        00140119
D     C(5)=0.0                                                          00140120
D     C(7)=0.0                                                          00140121
      GO TO 29                                                          00140122
D 304 C(5)=SQRTF(ZSQRE2)                                                00140123
D     C(7)=-C(5)                                                        00140124
D     C(6)=0.0                                                          00140125
D     C(8)=0.0                                                          00140126
      GO TO 29                                                          00140127
