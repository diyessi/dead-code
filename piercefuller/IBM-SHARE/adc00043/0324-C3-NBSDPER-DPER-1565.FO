D     VINCR(3)=.02                                                      DPER0286
D     VINCR(4)=.03                                                      DPER0287
D     VINCR(5)=.05                                                      DPER0288
      LV=5                                                              DPER0289
      KK=7                                                              DPER0290
D     PI=3.141592653589793                                              DPER0291
D     TEST=0.0000000000000002                                           DPER0292
      A=0.                                                              DPER0293
  200 IF(X)5,15,7                                                       DPER0294
D   5 X=-X                                                              DPER0295
D     SIGN=-1.000000000000000                                           DPER0296
      GO TO 11                                                          DPER0297
D   7 SIGN=1.000000000000000                                            DPER0298
      GO TO 11                                                          DPER0299
D  15 ERF=0.                                                            DPER0300
      GO TO 101                                                         DPER0301
   11 IF(X-5.75)17,19,21                                                DPER0302
   19 IF(X(2))17,17,21                                                  DPER0303
D  21 ERF=SIGN                                                          DPER0304
      GO TO 101                                                         DPER0305
   17 DO 25 L=1,LV                                                      DPER0306
      IF(X-V(L))27,29,25                                                DPER0307
   29 IF(X(2)-V(L+10))27,57,25                                          DPER0308
   25 CONTINUE                                                          DPER0309
D     YY=Y(270)                                                         DPER0310
D     DELTAX=X-5.700000000000000                                        DPER0311
D     X1=5.700000000000000                                              DPER0312
      GO TO 59                                                          DPER0313
   57 N=NVALUS(L)                                                       DPER0314
D     ERF=Y(N)*SIGN                                                     DPER0315
D     X=X*SIGN                                                          DPER0316
      GO TO 101                                                         DPER0317
   27 IF(L-1)31,31,33                                                   DPER0318
D  31 INTPT=X/VINCR(1)                                                  DPER0319
      IF(INTPT)63,63,64                                                 DPER0320
D  63 DELTAX=X                                                          DPER0321
D     YY=0.                                                             DPER0322
D     FACTOR=2./SQRTF(PI)                                               DPER0323
D     DENOM=1.                                                          DPER0324
D  60 AK=DELTAX                                                         DPER0325
D     SUM=AK*FACTOR                                                     DPER0326
      DO 62 J=2,KK                                                      DPER0327
D     QJ=J                                                              DPER0328
D     AK=DELTAX*DELTAX*AK*(2.*QJ-3.)/(2.*QJ-1.)                         DPER0329
D     DENOM=(QJ-1.)*DENOM                                               DPER0330
D     TERMK=FACTOR*AK*((-1.)**(J-1))/DENOM                              DPER0331
D     SUM=SUM+TERMK                                                     DPER0332
      IF(ABSF(TERMK)-TEST)41,41,62                                      DPER0333
   62 CONTINUE                                                          DPER0334
      GO TO 41                                                          DPER0335
D 64  QINTPT=INTPT                                                      DPER0336
D     X1=QINTPT*VINCR(1)                                                DPER0337
D     DELTAX=X-X1                                                       DPER0338
      N=1                                                               DPER0339
      GO TO 35                                                          DPER0340
D  33 INTPT=(X-V(L-1))/VINCR(L)                                         DPER0341
D     QINTPT=INTPT                                                      DPER0342
D     X1=(QINTPT*VINCR(L))+V(L-1)                                       DPER0343
D     DELTAX=X-X1                                                       DPER0344
      N=NVALUS(L-1)                                                     DPER0345
   35 NJ=INTPT+N                                                        DPER0346
D     YY=Y(NJ)                                                          DPER0347
D  59 FACTOR=2.*EXPF(-(X1*X1))/SQRTF(PI)                                DPER0348
D     DENOM=1.                                                          DPER0349
D  61 U=DELTAX/X1                                                       DPER0350
D     Q=DELTAX*X1                                                       DPER0351
D     B(1,1)=DELTAX                                                     DPER0352
D     SUM=B(1,1) *FACTOR                                                DPER0353
      DO 37 K=2,KK                                                      DPER0354
D     QK=K                                                              DPER0355
D     B(K,1)=2.*Q*(QK-1.)*B(K-1,1)/QK                                   DPER0356
D     AK=B(K,1)                                                         DPER0357
      DO 39 I=2,K                                                       DPER0358
D     QI=I                                                              DPER0359
D     B(K,I)=(U*(QK+QI-2.)*(QK-QI+1.)*B(K,I-1))/(2.*(QK+QI-1.)*(QI-1.)) DPER0360
D  39 AK=AK+B(K,I)                                                      DPER0361
D     DENOM=(QK-1.)*DENOM                                               DPER0362
D     TERMK=FACTOR*AK*((-1.)**(K-1))/DENOM                              DPER0363
D     SUM=SUM+TERMK                                                     DPER0364
      IF(ABSF(TERMK)-TEST)41,41,37                                      DPER0365
   37 CONTINUE                                                          DPER0366
D  41 ERF=(YY+SUM)*SIGN                                                 DPER0367
D     X=X*SIGN                                                          DPER0368
  101 RETURN                                                            DPER0369
      END                                                               DPER0370
