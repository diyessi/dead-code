* EIG4      342 04153    EIGENVALUES OF COMPLEX MATRICES                EIG4 001
      SUBROUTINE EIG4(A,N,M,RT,Z)                                       EIG4 002
I     DIMENSION A(70,70),RT(70),Z(1),TRACE(1),X(1),E(1)                 EIG4 003
      DIMENSION INT(70)                                                 EIG4 004
I     TRACE=A(1,1)                                                      EIG4 005
      DO 10 I=2,N                                                       EIG4 006
I10   TRACE=TRACE+A(I,I)                                                EIG4 007
      WRITE OUTPUT TAPE 6,5,TRACE,TRACE(2)                              EIG4 008
      CALL CXTRI(A,1.E-8,N,INT)                                         EIG4 009
I     TRACE=A(1,1)                                                      EIG4 010
      DO 11 I=2,N                                                       EIG4 011
I11   TRACE=TRACE+A(I,I)                                                EIG4 012
      WRITE OUTPUT TAPE 6,6,TRACE,TRACE(2)                              EIG4 013
      NU=0                                                              EIG4 014
      NV=0                                                              EIG4 015
 13   IF(NV-N)14,12,14                                                  EIG4 016
 14   NV=NV+1                                                           EIG4 017
      NU=NV                                                             EIG4 018
 16   IF(INT(NV))15,17,15                                               EIG4 019
 15   NV=NV+1                                                           EIG4 020
      GO TO 16                                                          EIG4 021
 17   IF(NV-NU)19,18,19                                                 EIG4 022
I18   RT(NU)=A(NU,NU)                                                   EIG4 023
I     X=RT(NU)                                                          EIG4 024
      WRITE OUTPUT TAPE 6,7,X,X(2)                                      EIG4 025
      GO TO 13                                                          EIG4 026
 19   IF(NV-NU-1)20,21,20                                               EIG4 027
 20   NP=XMIN0F(M,NV)                                                   EIG4 028
      CALL CXLAG(A,1.E-4,NP,NU,NV,RT,Z)                                 EIG4 029
      GO TO 13                                                          EIG4 030
I21   R=(.5,.0)*(A(NU,NU)+A(NV,NV))                                     EIG4 031
I     E=R**2-A(NU,NU)*A(NV,NV)+A(NU,NV)*A(NV,NU)                        EIG4 032
I     S=SQRTF(E)                                                        EIG4 033
I     RT(NU)=R+S                                                        EIG4 034
I     RT(NV)=R-S                                                        EIG4 035
I     X=RT(NU)                                                          EIG4 036
I     E=RT(NV)                                                          EIG4 037
      WRITE OUTPUT TAPE 6,7,X,X(2),E,E(2)                               EIG4 038
      GO TO 13                                                          EIG4 039
I12   X=(.0,.0)                                                         EIG4 040
      DO 24 J=1,M                                                       EIG4 041
I24   X=X+RT(J)                                                         EIG4 042
      WRITE OUTPUT TAPE 6,8,X,X(2)                                      EIG4 043
      RETURN                                                            EIG4 044
 5    FORMAT(1H030X,23HTRACE OF GIVEN MATRIX =E16.8,1H,E16.8)           EIG4 045
 6    FORMAT(1H027X,26HTRACE OF HESSENBERG FORM =E16.8,1H,E16.8)        EIG4 046
 7    FORMAT((11H0EIGENVALUE 12X,2E20.8))                               EIG4 047
 8    FORMAT(1H033X,20HSUM OF EIGENVALUES =E16.8,1H,E16.8)              EIG4 048
      END                                                               EIG4 049
      SUBROUTINE CXTRI(A,EPS,N,INT)                                     EIG4 050
I     DIMENSION A(70,70),C(1)                                           EIG4 051
      DIMENSION INT(70)                                                 EIG4 052
      N1=N-1                                                            EIG4 053
      N2=N-2                                                            EIG4 054
      DO 21 J=1,N1                                                      EIG4 055
      J1=J+1                                                            EIG4 056
      J2=J+2                                                            EIG4 057
      L=J1                                                              EIG4 058
      NJ1=N-J1                                                          EIG4 059
I     C=A(J,J1)                                                         EIG4 060
      S=ABSF(C)+ABSF(C(2))                                              EIG4 061
      IF(NJ1)15,15,6                                                    EIG4 062
 6    DO 12 K=J2,N                                                      EIG4 063
I     C=A(J,K)                                                          EIG4 064
      T=ABSF(C)+ABSF(C(2))                                              EIG4 065
      IF(T-S)12,12,11                                                   EIG4 066
 11   L=K                                                               EIG4 067
      S=T                                                               EIG4 068
 12   CONTINUE                                                          EIG4 069
      IF(L-J1)13,15,13                                                  EIG4 070
 13   DO 131 K=1,N                                                      EIG4 071
I     C=A(K,J+1)                                                        EIG4 072
I     A(K,J+1)=A(K,L)                                                   EIG4 073
I131  A(K,L)=C                                                          EIG4 074
 14   DO 141 K=1,N                                                      EIG4 075
I     C=A(J+1,K)                                                        EIG4 076
I     A(J+1,K)=A(L,K)                                                   EIG4 077
I141  A(L,K)=C                                                          EIG4 078
      R=0.                                                              EIG4 079
 15   DO 151 K=1,J                                                      EIG4 080
I     C=A(J,K)                                                          EIG4 081
      T=ABSF(C)+ABSF(C(2))                                              EIG4 082
 151  R=MAX1F(R,T)                                                      EIG4 083
      IF(S-EPS*R)16,16,17                                               EIG4 084
 16   L=0                                                               EIG4 085
      NJ1=0                                                             EIG4 086
      GO TO 181                                                         EIG4 087
I17   C=A(J,J+1)                                                        EIG4 088
      DO 18 K=J2,N                                                      EIG4 089
I18   A(J,K)=A(J,K)/C                                                   EIG4 090
 181  DO 20 I=1,N                                                       EIG4 091
      M=MIN0F(J,I-2)                                                    EIG4 092
I     U=(0.,0.)                                                         EIG4 093
      IF(NJ1)19,19,7                                                    EIG4 094
 7    DO 8 K=J2,N                                                       EIG4 095
I8    U=U+A(K,I)*A(J,K)                                                 EIG4 096
 19   IF(M)20,20,9                                                      EIG4 097
 9    DO 10 K=1,M                                                       EIG4 098
I10   U=U-A(K,I)*A(J+1,K+1)                                             EIG4 099
I20   A(J+1,I)=A(J+1,I)+U                                               EIG4 100
 21   INT(J)=L                                                          EIG4 101
 22   INT(N)=0                                                          EIG4 102
      RETURN                                                            EIG4 103
       END                                                              EIG4 104
      SUBROUTINE CXLAG(A,EPS,N1,NU,N,RT,Z)                              EIG4 105
I     DIMENSION A(70,70),P(3,71),RT(70),S1(1),S2(1),R(1),Z(1),B1(1),B2(1EIG4 106
I    1),B3(1),E(1),DELZ(1),F1(1),S(1),Q1(1)                             EIG4 107
      WRITE OUTPUT TAPE 6,1                                             EIG4 108
      BL1=1.                                                            EIG4 109
      NUQ=NU-1                                                          EIG4 110
      LLY=0                                                             EIG4 111
      DELOLD=1.                                                         EIG4 112
      ROLD=1.                                                           EIG4 113
      SUM1=0.                                                           EIG4 114
      SUM2=0.                                                           EIG4 115
      CALL FPTEST(X)                                                    EIG4 116
I     P(1,NU)=(1.,.0)                                                   EIG4 117
I     P(2,NU)=(.0,.0)                                                   EIG4 118
I     P(3,NU)=(.0,.0)                                                   EIG4 119
      NU1=NU+1                                                          EIG4 120
      CUP=0.                                                            EIG4 121
      DO 11 J=NU1,N                                                     EIG4 122
I     R=A(J-1,J)                                                        EIG4 123
 11   CUP=CUP+ABSF(R)+ABSF(R(2))                                        EIG4 124
      CUP=CUP/FLOATF(N-NU)                                              EIG4 125
      CAP=0.                                                            EIG4 126
C                                                                       EIG4 127
C     FIND THE TRACE OF A AND A**2                                      EIG4 128
C                                                                       EIG4 129
I     SPUR1=A(NU,NU)                                                    EIG4 130
I     SPUR2=SPUR1**2                                                    EIG4 131
      DO 13 J=NU1,N                                                     EIG4 132
I     T=A(J,J)                                                          EIG4 133
I     SPUR1=SPUR1+T                                                     EIG4 134
I13   SPUR2=SPUR2+T**2+(2.,0.)*A(J-1,J)*A(J,J-1)                        EIG4 135
I     S1=-SPUR1                                                         EIG4 136
I     S2=SPUR2                                                          EIG4 137
C                                                                       EIG4 138
C     INITIAL ITERATE (EITHER GIVEN OR FROM INFINITY)                   EIG4 139
C                                                                       EIG4 140
 131  IF(Z-1.E+35)23,14,14                                              EIG4 141
 14   F1=N-NUQ                                                          EIG4 142
      IF(ABSF(S1)+ABSF(S1(2))+ABSF(S2)+ABSF(S2(2))-1.E-6*CAP)15,15,16   EIG4 143
 15   Z=CUP                                                             EIG4 144
      GO TO 23                                                          EIG4 145
I16   D=(F1-(1.,0.))*(F1*S2-S1**2)                                      EIG4 146
I     Z=(SQRTF(D)-S1)/F1                                                EIG4 147
C                                                                       EIG4 148
C     EVALUATE POLYNOMIAL AND DERIVATIVES                               EIG4 149
C                                                                       EIG4 150
 23   P(1,NU)=1.0                                                       EIG4 151
      IF (LLY+NUQ-NU) 24,24,235                                         EIG4 152
 24   P(1,NU)=1.E-20                                                    EIG4 153
 235  DO 33 K=NU,N                                                      EIG4 154
I     T=-A(K,K+1)                                                       EIG4 155
 25   DO 33 L=1,3                                                       EIG4 156
      S=FLOATF(XMODF(L-1,3))                                            EIG4 157
I     R=-(Z*P(L,K)+S*P(L-1,K))                                          EIG4 158
      DO 28 J=NU,K                                                      EIG4 159
I28   R=R+P(L,J)*A(K,J)                                                 EIG4 160
      IF(X)29,34,29                                                     EIG4 161
 29   X=0                                                               EIG4 162
      P(1,NU)=P(1,NU)*1.E-15                                            EIG4 163
      IF(P(1,NU))30,30,235                                              EIG4 164
 30   F=.9*FLOATF(K-NU)/FLOATF(N-NU+1)                                  EIG4 165
      WRITE OUTPUT TAPE 6,4,Z(1),Z(2)                                   EIG4 166
I     Z=F*Z                                                             EIG4 167
I     P(1,NU)=(1.,0.)                                                   EIG4 168
      GO TO 235                                                         EIG4 169
 34   IF (N-K) 31,31,32                                                 EIG4 170
I31   P(L,K+1)=R                                                        EIG4 171
      GO TO 33                                                          EIG4 172
I32   P(L,K+1)=R/T                                                      EIG4 173
 33   CONTINUE                                                          EIG4 174
C                                                                       EIG4 175
C     SCALE DOWN THESE VALUES IF REQUIRED TO AVOID OVERFLOW             EIG4 176
C                                                                       EIG4 177
I35   B1=P(1,N+1)                                                       EIG4 178
I     B2=P(2,N+1)                                                       EIG4 179
I     B3=P(3,N+1)                                                       EIG4 180
      G1=ABSF(B1)+ABSF(B1(2))                                           EIG4 181
      G2=ABSF(B2)+ABSF(B2(2))                                           EIG4 182
      G3=ABSF(B3)+ABSF(B3(2))                                           EIG4 183
      S=MAX1F(G1,G2)                                                    EIG4 184
      S=MAX1F(S,G3)                                                     EIG4 185
      IF(S-1.E+19)43,43,36                                              EIG4 186
I36   B1=B1/(1.E+19,0.)                                                 EIG4 187
I     B2=B2/(1.E+19,0.)                                                 EIG4 188
      WRITE OUTPUT TAPE 6,2,Z(1),Z(2),G1,G2,G3                          EIG4 189
I     B3=B3/(1.E+19,0.)                                                 EIG4 190
C                                                                       EIG4 191
C     REMOVE EFFECT OF KNOWN ROOTS FROM S1,S2 THE LOG DERIVATIVES       EIG4 192
C                                                                       EIG4 193
I43   Q1=(.0,.0)                                                        EIG4 194
I     Q2=(.0,.0)                                                        EIG4 195
      IF(NUQ-NU)19,21,21                                                EIG4 196
 21   DO 44 J=NU,NUQ                                                    EIG4 197
I     D=(1.,0.)/(RT(J)-Z)                                               EIG4 198
I     Q1=Q1+D                                                           EIG4 199
I44   Q2=Q2+D**2                                                        EIG4 200
      IF (G1) 41,41,19                                                  EIG4 201
I19   S1=Q1+B2/B1                                                       EIG4 202
I     S2=(B2**2-B1*B3)/B1**2-Q2                                         EIG4 203
C                                                                       EIG4 204
C     FIND NEXT ITERATE                                                 EIG4 205
C                                                                       EIG4 206
      LLY=LLY+1                                                         EIG4 207
      IF(1.E+7-ZZ*(ABSF(S1)+ABSF(S1(2))))41,41,42                       EIG4 208
 41   MARK=1                                                            EIG4 209
      GO TO 100                                                         EIG4 210
 42   G=N-NUQ                                                           EIG4 211
 50   IF(BL1)65,65,66                                                   EIG4 212
 65   H=.5*(G-2.)                                                       EIG4 213
      GO TO 67                                                          EIG4 214
 66   H=G-1.                                                            EIG4 215
I67   D=H*(G*S2-S1**2)                                                  EIG4 216
I     E=SQRTF(D)                                                        EIG4 217
      IF(S1*E+S1(2)*E(2))55,56,56                                       EIG4 218
I55   E=-E                                                              EIG4 219
I56   DELZ=-G/(S1+E)                                                    EIG4 220
I     Z=Z+DELZ                                                          EIG4 221
      DELNEW=ABSF(DELZ)+ABSF(DELZ(2))                                   EIG4 222
      RNEW=DELNEW/DELOLD                                                EIG4 223
      ZZ=ABSF(Z)+ABSF(Z(2))                                             EIG4 224
C                                                                       EIG4 225
C     TEST FOR CYCLING AT 57 AND FOR LINEAR CONVERGENCE AT 571          EIG4 226
C                                                                       EIG4 227
      IF(LLY-3)62,62,57                                                 EIG4 228
 57   IF(DELNEW-MAX1F(3.*DELOLD,.5*ZZ))571,571,570                      EIG4 229
 570  IF(BL1)571,571,572                                                EIG4 230
 572  DELOLD=CAP+1.0                                                    EIG4 231
      ROLD=3.                                                           EIG4 232
      IF(LLY-15)14,14,100                                               EIG4 233
 571  IF(RNEW-.7*ROLD)62,58,58                                          EIG4 234
 58   MARK=3                                                            EIG4 235
      IF(DELNEW-.1*EPS*MAX1F(ZZ,.01*CAP)) 70,59,59                      EIG4 236
 59   IF(BL1)61,61,60                                                   EIG4 237
I60   Z=Z-DELZ                                                          EIG4 238
      BL1=0.                                                            EIG4 239
      GO TO 50                                                          EIG4 240
 61   BL1=1.                                                            EIG4 241
      GO TO 63                                                          EIG4 242
C                                                                       EIG4 243
C     TEST FOR AN EIGENVALUE                                            EIG4 244
C                                                                       EIG4 245
 62   IF(DELNEW-10.*EPS*MAX1F(ZZ,.001*CAP))64,64,63                     EIG4 246
 63   DELOLD=DELNEW                                                     EIG4 247
      ROLD=RNEW                                                         EIG4 248
      IF(LLY-15)23,23,100                                               EIG4 249
 64   MARK=2                                                            EIG4 250
 70   BL1=1.                                                            EIG4 251
C                                                                       EIG4 252
C     WE ACCEPT Z AS A ROOT                                             EIG4 253
C                                                                       EIG4 254
 100  NUQ=NUQ+1                                                         EIG4 255
I     RT(NUQ)=Z                                                         EIG4 256
      WRITE OUTPUT TAPE 6,3,Z,Z(2),LLY,MARK                             EIG4 257
      LLY=0                                                             EIG4 258
      CAP=MAX1F(ZZ,CAP)                                                 EIG4 259
      DELOLD=1.                                                         EIG4 260
      ROLD=1.                                                           EIG4 261
I     SUM1=SUM1+RT(NUQ)                                                 EIG4 262
I     SUM2=SUM2+RT(NUQ)**2                                              EIG4 263
I     S1=SUM1-SPUR1                                                     EIG4 264
I     S2=SUM2-SPUR2                                                     EIG4 265
      IF(NUQ-N1)84,101,101                                              EIG4 266
C                                                                       EIG4 267
C     A NEWTON STEP TOWARDS NEXT ROOT                                   EIG4 268
C                                                                       EIG4 269
 84   IF((ABSF(Q1)+ABSF(Q1(2)))*MAX1F(ZZ,.001*CAP)-1.E+4)86,86,14       EIG4 270
I86   Z=Z-B2/((.5,.0)*B3-B2*Q1)                                         EIG4 271
      GO TO 23                                                          EIG4 272
 101  CALL FPOLD                                                        EIG4 273
      RETURN                                                            EIG4 274
 1    FORMAT(1H050X,19HLAGUERRE ITERATIONS//31X,9HREAL PART10X,10H IMAG.EIG4 275
     1PART22X,1HP11X,7HP PRIME6X,11HP DBL PRIME)                        EIG4 276
 2    FORMAT(8H ITERATE20X,E15.8,5X,E15.8,8X,3E15.4)                    EIG4 277
 3    FORMAT(11H0EIGENVALUE12X,2E20.8,12X,I3,17H ITERATIONS,TEST I1//)  EIG4 278
 4    FORMAT(8H ITERATE20X,2E20.8,12X,9H OVERFLOW)                      EIG4 279
      END                                                               EIG4 280
*NUFPT    NU VERSION OF FPT.  VERSION 2  MAY 1962.  HAS ALTERNATE ENTRIEEIG4 281
*     FAP                                                               EIG4 282
       PCC                                                              EIG4 283
       COUNT   60                                                       EIG4 284
       LBL     NUFPT,9                                                  EIG4 285
       ENTRY   FPTEST                                                   EIG4 286
       ENTRY   FPOLD                                                    EIG4 287
       ENTRY   (FPT)                                                    EIG4 288
FPTEST CLA     8                                                        EIG4 289
       STO     NEW+1                   SAVE L(8)                        EIG4 290
       STZ     OVFLOW                  CLEAR 77462                      EIG4 291
       CLA     1,4                                                      EIG4 292
       STA     NEW+2                   L(CONTENTS OF L(0))              EIG4 293
       CLA     NEW                     L(TTR,(FPT))                     EIG4 294
       STO     8                       MUST USE THIS (FPT)              EIG4 295
       CLA     NEW+2                   L(STI,**)                        EIG4 296
       STO     ERROR+1                 MODIFY(FPT) SO EXEM              EIG4 297
       CLA     NEW+3                   DOES NOT ACT                     EIG4 298
       STO     ERROR+2                                                  EIG4 299
       TTR     2,4                                                      EIG4 300
 (FPT) STI     IND           SAVE INDICATORS.                           EIG4 301
       LDI     0             EXAMINE BITS 14-17 OF LOC ZERO             EIG4 302
       LFT     4             SKIP IF NON'OVERFLOW (BIT 15)              EIG4 303
       TTR     ERROR         (IN FPT + 3) OVERFLOW AC OR MQ             EIG4 304
       LFT     2             SKIP IF ACC NOT INVOLVED                   EIG4 305
       CLM                                                              EIG4 306
       LNT     6             SKIP AND COMPLEMENT                        EIG4 307
       COM                   ONCE ON ACC UNDRFLOW                       EIG4 308
       COM                                                              EIG4 309
       XCA                   GET MQ                                     EIG4 310
       LFT     1             SKIP IF N= MQ NOT INVOLVED                 EIG4 311
       CLM                                                              EIG4 312
       LNT     5             COMPLEMEMT ONCE ON                         EIG4 313
       COM                   MQ UNDERFLOW                               EIG4 314
       COM                                                              EIG4 315
       XCA                   RESTORE MQ AND ACC                         EIG4 316
       LDI     IND           RESTORE INDICATORS.                        EIG4 317
 EXIT  TTR*    0                                                        EIG4 318
 ERROR STI     OVFLOW        77462                                      EIG4 319
       LDI     *+2                                                      EIG4 320
       TTR     $(EXE)                                                   EIG4 321
       PZE     7,4,*+1                                                  EIG4 322
       LDI     OVFLOW        RETURN FROM EXE IF NOT IN MONITOR MODE     EIG4 323
       TTR     (FPT)+4                                                  EIG4 324
 NEW   TTR     (FPT)                   CONSTANT                         EIG4 325
       TTR     (FPT)                   SAVE ORIGINAL L(8) HERE          EIG4 326
       STI     **                      CONSTANT-STA OF VARIABLE HERE    EIG4 327
       TTR     ERROR+4                 CONST                            EIG4 328
       LDI     ERROR+3                 CONST                            EIG4 329
       TTR     $(EXE)                                                   EIG4 330
 FPOLD CLA     NEW+4                   RESTORE EXEM AFFECT              EIG4 331
       STO     ERROR+1                                                  EIG4 332
       CLA     NEW+5                                                    EIG4 333
       STO     ERROR+2                                                  EIG4 334
       CLA     NEW+1                   RESTORE L(8)                     EIG4 335
 SET   STO     8                                                        EIG4 336
       STZ     OVFLOW                  CLEAR 77462                      EIG4 337
       TRA     1,4                                                      EIG4 338
       COMMON  -2                                                       EIG4 339
 IND   COMMON  1                       77463                            EIG4 340
OVFLOW COMMON  1                                                        EIG4 341
       END                                                              EIG4 342
