C     EQU OF STATE 3 (MIXTURES)  DEV,FUGAM,FUGAC,FUDEM,VIETA            9138 001
      DIMENSION DA(2),SS(2),P(50), X(3),SUBST(4),Y(7),TCS(7),PCS(7),A(4)9138 002
      DIMENSION DS(7),XX(2),WS(7),WWS(7),R(7,7),HS(7),BR(7),AR(7),HHS(7)9138 003
      DIMENSION GFU1J(7),GFU3J(7),FU3J(7),GNFU1J(7)                     9138 004
   81 FORMAT(6H LFU1J,3X7F9.4)                                          9138 005
   82 FORMAT(6H LFU3J,3X7F9.4)                                          9138 006
   83 FORMAT(6H  FU3J,3X7F9.4)                                          9138 007
   84 FORMAT(8H0   LFU1F9.4,5H LFU2F9.4,5H LFU3F9.4,4H FU1F9.4,         9138 008
     24H FU3F9.4)                                                       9138 009
   85 FORMAT (25H EQU OF STATE 3(MIXTURES))                             9138 010
   86 FORMAT (12H COMPOSITION)                                          9138 011
    1 FORMAT(4A6,4F12.6)                                                9138 012
    2 FORMAT(6X1HT, 9X1HP, 9X2HTR, 8X2HPR, 8X2HZ1, 8X2HZ2, 8X2HZ3)      9138 013
    3 FORMAT(1H 4A6,4F12.6)                                             9138 014
    4 FORMAT(F12.6)                                                     9138 015
    5 FORMAT(2F12.6,4XI2,10XI2,6X2F12.6)                                9138 016
    6 FORMAT(12XF12.6)                                                  9138 017
    7 FORMAT(//)                                                        9138 018
    8 FORMAT(2F12.6)                                                    9138 019
   10 FORMAT(F12.4,6F10.4)                                              9138 020
      A(1)=1.0                                                          9138 021
      A(2)=-1.0                                                         9138 022
      READ   INPUT TAPE 5,5,COT,COP,NOS,NOM,FTAG,RTAG                   9138 023
   57 WRITE OUTPUT TAPE 6,85                                            9138 024
      WRITE OUTPUT TAPE 6,5,COT,COP,NOS,NOM,FTAG,RTAG                   9138 025
      IF (RTAG)93,93,91                                                 9138 026
   91 DO 92 JR=1,NOS                                                    9138 027
      READ   INPUT TAPE 5,10,(R(JS,JR),JS=1,7)                          9138 028
   92 WRITE OUTPUT TAPE 6,10,(R(JS,JR),JS=1,7)                          9138 029
   93 DO 52 JS=1,NOS                                                    9138 030
      READ   INPUT TAPE 5,1,(SUBST(M),M=1,4),DA(1),DA(2),WS(JS),WWS(JS) 9138 031
      WRITE OUTPUT TAPE 6,3,(SUBST(M),M=1,4),DA(1),DA(2),WS(JS),WWS(JS) 9138 032
      TCS(JS)=DA(1)*COT*0.001                                           9138 033
      PCS(JS)=DA(2)*COP                                                 9138 034
      WRITE OUTPUT TAPE 6,8,TCS(JS),PCS(JS)                             9138 035
      DS(JS)=0.08667*DA(1)/DA(2)                                        9138 036
   52 HS(JS) = 0.6541*DA(1)**1.25 / SQRTF(DA(2))                        9138 037
      WRITE OUTPUT TAPE 6,7                                             9138 038
      READ INPUT TAPE 5,5,TL,PL,NOT,NOP,DT,DP                           9138 039
   12 P(1)=PL                                                           9138 040
      JP = 2                                                            9138 041
      IF (DP)24,22,23                                                   9138 042
   24 P(JP)=P(JP-1)*2.0                                                 9138 043
      JP=JP+1                                                           9138 044
      IF (JP-NOP)25,25,27                                               9138 045
   25 P(JP)=P(JP-1)*2.5                                                 9138 046
      JP=JP+1                                                           9138 047
      IF (JP-NOP)26,26,27                                               9138 048
   26 P(JP)=P(JP-1)*2.0                                                 9138 049
      JP=JP+1                                                           9138 050
      IF (JP-NOP)24,24,27                                               9138 051
   28 READ INPUT TAPE 5,6,(P(JP))                                       9138 052
      JP=JP+1                                                           9138 053
   22 IF (JP-NOP)28,28,27                                               9138 054
   29 P(JP)=P(JP-1)+DP                                                  9138 055
      JP=JP+1                                                           9138 056
   23 IF (JP-NOP)29,29,27                                               9138 057
   27 DO 56 JM=1,NOM                                                    9138 058
      READ INPUT TAPE   5,10,(Y(JS),JS=1,NOS)                           9138 059
      WRITE OUTPUT TAPE 6,86                                            9138 060
      WRITE OUTPUT TAPE 6,10,(Y(JS),JS=1,NOS)                           9138 061
      WRITE OUTPUT TAPE 6,7                                             9138 062
      TC=0.0                                                            9138 063
      PC=0.0                                                            9138 064
      D =0.0                                                            9138 065
      HQ=0.0                                                            9138 066
      W =0.0                                                            9138 067
      WW=0.0                                                            9138 068
      DO 76 JS=1,NOS                                                    9138 069
      HHS(JS)=0.0                                                       9138 070
      IF (RTAG)73,73,71                                                 9138 071
   71 DO 72 JR=1,NOS                                                    9138 072
   72 HHS(JS)=HHS(JS)+Y(JR)*R(JS,JR)*HS(JR)                             9138 073
      GO TO 75                                                          9138 074
   73 DO 74 JR=1,NOS                                                    9138 075
   74 HHS(JS)=HHS(JS)+ Y(JR)*HS(JR)                                     9138 076
   75 HQ=HQ+Y(JS)*HS(JS)*HHS(JS)                                        9138 077
      D = D+Y(JS)*DS(JS)                                                9138 078
      TC=TC+Y(JS)*TCS(JS)                                               9138 079
      PC=PC+Y(JS)*PCS(JS)                                               9138 080
      W = W+Y(JS)*WS(JS)                                                9138 081
   76 WW=WW+Y(JS)*WWS(JS)                                               9138 082
      DO 77 JS=1,NOS                                                    9138 083
      BR(JS)=DS(JS)/D                                                   9138 084
   77 AR(JS)=2.0*HHS(JS)*HS(JS)/HQ - BR(JS)                             9138 085
      T=TL                                                              9138 086
      DO 37 JT=1,NOT                                                    9138 087
      B=D/T                                                             9138 088
      E=HQ/(D*T**1.5)                                                   9138 089
      TR = 0.001*T*COT/TC                                               9138 090
      IF (FTAG) 78,78,79                                                9138 091
   79 BDD = ((0.689 - 0.8316*TC)*TC/TR**4)**0.3333                      9138 092
      BA=(4.996*W*W+(0.03086+0.07683/PC)*(TR-1.0)**2)*(TR-1.0)          9138 093
     2/ (6.0*TR**4*BDD)                                                 9138 094
      BB = (0.01734 - 0.0002754*PC - 0.09772*TC**2)/(6.0*TR**4*BDD**2)  9138 095
      BC = 0.000000606*PC*(TR-1.0)/(TC*(0.689-0.8316*TC))               9138 096
   78 DO 34 JP=1,NOP                                                    9138 097
      Q=B*P(JP)                                                         9138 098
      A(3)=Q*(E-1.0-Q)                                                  9138 099
      A(4)=-E*Q**2                                                      9138 100
      CALL VIETA(A,X,MTYPE)                                             9138 101
      PR=P(JP)*COP/PC                                                   9138 102
      S = DEV(TR,PR,TC,PC,W)                                            9138 103
      IF (MTYPE) 42,41,41                                               9138 104
   41 XX(1)=X(1)                                                        9138 105
      NOZ = 1                                                           9138 106
      GO TO 43                                                          9138 107
   42 XX(2) = MIN1F(X(1),X(2),X(3))                                     9138 108
      XX(1) = MAX1F(X(1),X(2),X(3))                                     9138 109
      NOZ = 2                                                           9138 110
   43 WRITE OUTPUT TAPE 6,2                                             9138 111
      DO 44 JZ=1,NOZ                                                    9138 112
      SS(JZ) = XX(JZ) + S                                               9138 113
   44 WRITE OUTPUT TAPE 6,10,T,P(JP),TR,PR,XX(JZ),S,SS(JZ)              9138 114
      IF (FTAG) 48,48,45                                                9138 115
   45 GNFU2 = FUDEM(BA,BB,BC,BDD,PR)                                    9138 116
      GFU2  = GNFU2*0.434294                                            9138 117
      FU2   = EXPF(GNFU2)                                               9138 118
      DO 47 JZ=1,NOZ                                                    9138 119
      GNFU1 = FUGAM(Q,E,XX(JZ))                                         9138 120
      GFU1  = GNFU1*0.434294                                            9138 121
      GFU3  = GFU1 + GFU2                                               9138 122
      FU1   = EXPF(GNFU1)                                               9138 123
      FU3   = FU1*FU2                                                   9138 124
      WRITE OUTPUT TAPE 6,84,GFU1,GFU2,GFU3,FU1,FU3                     9138 125
      DO 46 JS = 1,NOS                                                  9138 126
      GNFU1J(JS) = FUGAC(Q,E,XX(JZ),BR(JS),AR(JS))                      9138 127
      GFU1J(JS)  = GNFU1J(JS)*0.434294                                  9138 128
      GFU3J(JS)  = GFU1J(JS) + GFU2                                     9138 129
   46 FU3J(JS) = FU2*EXPF(GNFU1J(JS))                                   9138 130
      WRITE OUTPUT TAPE 6,81,(GFU1J(JS),JS=1,NOS)                       9138 131
      WRITE OUTPUT TAPE 6,82,(GFU3J(JS),JS=1,NOS)                       9138 132
   47 WRITE OUTPUT TAPE 6,83,(FU3J(JS),JS=1,NOS)                        9138 133
      WRITE OUTPUT TAPE 6,7                                             9138 134
   48 CONTINUE                                                          9138 135
   34 CONTINUE                                                          9138 136
      T = T + DT                                                        9138 137
   37 CONTINUE                                                          9138 138
   56 CONTINUE                                                          9138 139
      READ INPUT TAPE 5,5,TL,PL,NOT,NOP,DT,DP                           9138 140
      IF (TL)39,39,12                                                   9138 141
   39 READ INPUT TAPE 5,5,COT,COP,NOS,NOM,FTAG,RTAG                     9138 142
      IF (NOM)40,40,57                                                  9138 143
   40 CALL EXIT                                                         9138 144
      END                                                               9138 145
