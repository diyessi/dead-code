*      DOUBLE PRECISION SINE COSINE                                            1
       LBL     DSC                                                             2
       COUNT   260                                                           003
       ENTRY   DSIN                                                          004
       ENTRY   DCOS                                                          005
       REM       DOUBLE PRECISION                                            006
       REM        SIN-COS ROUTINE                                            007
 DCOS  STI     SAVEI                                                         008
       CLA     PI2                                                           009
       LDQ     PI2+1                                                         010
       DST     4)-5                 MSP=4)-5,LSP=4)-4                        011
       DLD     4)-1                                                          012
       XCA                                                                   013
       TZE     EXITC          COS(0)=1,SET AT EXIT                           014
       DFAD    4)-5           COS ANGLE= SIN(ANGLE +90)                      015
       XCA                    LSP=4)-1,MSP=4)                                016
       DST     4)-1                                                          017
       LDI     SAVEI                                                         018
  DSIN SXA     EXIT,4                                                        019
       STI     SAVEI                                                         020
       DLD     4)-1                                                          021
       XCA                                                                   022
       TZE     EXIT                                                          023
       TPL     HEP                                                           024
       SSP                    WORK ON ABSOLUTE VALUE                         025
       LRS     0                                                             026
       DST     4)-1           MSP=4)-1,LSP=4)                                027
       LDQ     MONE           SET A MINUS FLAG FOR THE EXIT                  028
       TRA     AD1                                                           029
 HEP   DST     4)-1           MSP=4)-1,LSP=4)                                030
       LDQ     ONE            SET A PLUS  FLAG FOR THE EXIT                  031
  AD1  STQ     MULT2          DIV ARG BY 2PI,THAT IS,TREAT IT MOD 360        032
       CLA     PI22                                                          033
       LDQ     PI22+1                                                        034
       DST     4)-5           MSP=4)-5,LSP=4)-4                              035
       DLD     4)-1                                                          036
       DFDP    4)-5                                                          037
       DST     4)-3           ARG/2 PI    MSP=4)-3,LSP=4)-2                  038
       LDQ     OC             NEXT THE INTEGRAL PORTION IS ELIMINATED        039
       TLQ     AD2              TRA PWR GREATER THAN OCT 233 IN MSH          040
       LDQ     OCC2                                                          041
       TLQ     AD12                                                          042
       LDQ     4)-2           LSP                                            043
       TRA     AD3                                                           044
 AD12  UFA     OC                                                            045
       CHS                                                                   046
       FAD     4)-3                                                          047
       FAD     4)-2                                                          048
       TRA     AD3                                                           049
  AD2  CLA     4)-2           LSP                                            050
       LDQ     OC2                                                           051
       TLQ     EXIT                                                          052
       UFA     OC                                                            053
       CHS                                                                   054
       FAD     4)-2                                                          055
  AD3  DST     4)-1           MSP NOW IN AC,LSP NOW IN MQ                    056
       CLA     ET                                                            057
       LDQ     ET+1                                                          058
       DFMP    4)-1           BEGIN TO SEPARATE INTO QUADRANTS BY DIV BY     059
       DST     4)-1           PI/4--THIS CONVENIENTLY COMBINES INTO THE      060
       LDQ     OCC2           SINGLE STEP OF MULT. BY EIGHT                  061
       TLQ     AD31           (FR*2.PI)/(PI/4)                               062
       LXA     OCC2,4                                                        063
       TRA     AD4C                                                          064
  AD31 UFA     OC             NOW WE TRUNCATE TO A FRAC. AGAIN               065
       PAX     0,4            FOR THE REMAINING OPERATION OF                 066
       CHS                    QUADRANT REDUCTION.  BUT AT THE SAME TIME      067
       FAD     4)-1           PRESERVE IR(4) WHICH QUADRANT                  068
       STO     4)-1           AND THUS WHICH OCTANT WE REDUCED FROM          069
       PXA     0,4                                                           070
       LBT                                                                   071
       TRA     AD4C                                                          072
       ADD     ONE1           1 3 5 7   MAKE ODD EVEN FOR EASE               073
       PAX     0,4            2 4 6 8   IN HANDLING SERIES                   074
       CLA     4)-1                                                          075
       FAD     MONE                                                          076
       STO     4)-1                                                          077
       XCA                                                                   078
       FAD     4)                                                            079
       STO     4)             FR,MSP=4)-1,LSP=4)                             080
 AD4C  CLA     PI4                                                           081
       LDQ     PI4+1                                                         082
       DST     4)-3           MSP=4)-3,LSP=4)-2                              083
       DLD     4)-1                                                          084
       DFMP    4)-3           FR*(PI/4)                                      085
       DST     4)-1                     MSP=4)-1,LSP=4)                      086
       CLA     ONE                                                           087
       TXL     ADS,4,0        I=0  HERE WE BRANCH DEPENDING ON               088
       TXL     ADC,4,2        I=2  THE OCTANT THAT WAS REDUCED               089
       TXH     ADS,4,6        FROM.  IT STARTS THE SERIES TO COMPUTE         090
       TXH     ADCM,4,4       EITHER THE SINE OR THE COSINE(90-ANGLE)        091
       CHS                    ONE OF WHICH WE HAVE FROM THE REDUCTION.       092
  ADS  STO     MULT                                                          093
       CLA     ONE                                                           094
       STO     N2                                                            095
       DLD     4)-1                                                          096
       DST     4)-5           MSP=4)-1 INTO B1,LSP=4)=B2                     097
       TZE     EX                                                            098
       TRA     RTN                                                           099
 ADCM  CHS                                                                   100
  ADC  STO     MULT                                                          101
       STZ     4)-4                                                          102
       STZ     N2                                                            103
       CLA     4)-1           MSP=4)-1                                       104
       LDQ     ONE                                                           105
       STQ     4)-5                                                          106
       STQ     4)-1                                                          107
       LDQ     4)             LSP=4)                                         108
       STZ     4)                                                            109
       TZE     EX                                                            110
  RTN  DST     4)-7           C(AC)=MSP=4)-1 INTO A1,C(MQ)=LSP=4)INTO A2     111
       DFMP    4)-7           CONTENTS OF AC,MQ SQUARED                      112
       CHS                                                                   113
       LRS     0                                                             114
       DST     4)-7           MSP INTO A1,LSP INTO A2                        115
       LDQ     4)-1                                                          116
       FMP     LIMIT          THIS PROVIDES A TEST OF HOW MANY TERMS         117
       SSP                    MUST BE COMPUTED. THE SERIES REPEATS ,         118
       STO     TEST           ADDING HIGHER POWER TERMS,UNTIL THIS           119
       REM                    ACCURACY IS REACHED                            120
  ADL  CLA     N2                                                            121
       FAD     ONE                                                           122
       STO     N                                                             123
       FAD     ONE                                                           124
       STO     N2                                                            125
       LDQ     N2                                                            126
       FMP     N                                                             127
       STO     4)-9           NN                                             128
       STZ     4)-8           NN+1                                           129
       DLD     4)-7           A                                              130
       DFDP    4)-9           /NN                                            131
       DFMP    4)-5           X B                                            132
       DST     4)-5                                                          133
       DFAD    4)-1                                                          134
       DST     4)-1           LSP=4)-1,MSP=4)                                135
       CLA     4)-5                                                          136
       SSP                                                                   137
       LDQ     TEST                                                          138
       TLQ     ADL                                                           139
 EX    DLD     4)-1                                                          140
       STO     4)                                                            141
       STQ     4)-1                                                          142
       LDQ     MULT                                                          143
       FMP     MULT2                                                         144
       TPL     EXIT                                                          145
       CLS     4)                                                            146
       STO     4)                                                            147
       CLS     4)-1                                                          148
       STO     4)-1                                                          149
  EXIT AXT     0,4                                                           150
       LDI     SAVEI                                                         151
       TRA     1,4                                                           152
 EXITC CLA     ONE                                                           153
       STO     4)                                                            154
       STZ     4)-1                                                          155
       LDI     SAVEI                                                         156
       TRA     1,4                                                           157
  PI4  OCT     200622077325,145042055060                                     158
  PI2  OCT     201622077325,146042055060                                     159
  PI22 OCT     203622077325,150042055060                                     160
  OCC2 OCT     200000000000                                                  161
  OC   OCT     233000000000                                                  162
  OC2  OCT     230000000000                                                  163
  ET   DEC     8.0                                                           164
 ETP1  DEC     0.0                                                           165
  ONE  DEC     1.0                                                           166
  ONE1 DEC     1                                                             167
  MONE DEC     -1.0                                                          168
 LIMIT DEC     1.0E-16                                                       169
  MULT PZE     0                                                             170
 MULT2 PZE     0                                                             171
  N    PZE     0                                                             172
  N2   PZE     0                                                             173
  NN   PZE     0                                                             174
  NNP1 PZE     0                                                             175
  TEST PZE     0                                                             176
 D1    PZE     0,0,1                                                         177
 D2    PZE     0,0,2                                                         178
 D3    PZE     0,0,3                                                         179
 D4    PZE     0,0,4                                                         180
 D5    PZE     0,0,5                                                         181
 D6    PZE     0,0,6                                                         182
 D7    PZE     0,0,7                                                         183
 D8    PZE     0,0,8                                                         184
 D9    PZE     0,0,9                                                         185
 D10   PZE     0,0,10                                                        186
 D11   PZE     0,0,11                                                        187
 D12   PZE     0,0,12                                                        188
SAVEI  PZE     0                                                             189
       COMMON  -206                                                          190
 4)    COMMON  1                                                             191
       END                                                                   192
