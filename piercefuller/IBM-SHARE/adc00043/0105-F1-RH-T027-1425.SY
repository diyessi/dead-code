      SUBROUTINE FAMINV(K,PHI,B,DETERM)                                 RHT02701
C                                                                       RHT02702
C     FINITE AUTOCORRELATION MATRIX INVERSION                           RHT02703
C                                                                       RHT02704
I     DIMENSION PHI(76),B(75,75),PSI(75,2)                              RHT02705
      COMMON PHI,B,DETERM                                               RHT02706
    5 L = 75                                                            RHT02707
      N = K-1                                                           RHT02708
      DETERM = 1.0                                                      RHT02709
I     PSI(1,2) = PHI(2)                                                 RHT02710
I     Q = PHI(2)                                                        RHT02711
I     DELTA = (1.0,0.0) - ABSF(Q)**2                                    RHT02712
      DO 30 I=2,N                                                       RHT02713
I     SUM = (0.0,0.0)                                                   RHT02714
      IS = I-1                                                          RHT02715
      DO 10 J=1,IS                                                      RHT02716
      JS = I-J+1                                                        RHT02717
I     SUM = SUM + PSI(J,2)*PHI(JS)                                      RHT02718
I  10 PSI(J,1) = PSI(J,2)                                               RHT02719
I     Q = (PHI(I+1) - SUM)/DELTA                                        RHT02720
      DELT = DELTA                                                      RHT02721
      DETERM = DETERM*DELT                                              RHT02722
I     DELTA = DELTA - DELTA*ABSF(Q)**2                                  RHT02723
      DO 20 J=1,IS                                                      RHT02724
      JS = I-J                                                          RHT02725
I  20 PSI(J,2) = PSI(J,1) - Q*PSI(JS,1)                                 RHT02726
I  30 PSI(I,2) = Q                                                      RHT02727
      DO 40 I=1,N                                                       RHT02728
      PSI(I,1) = PSI(I,2)                                               RHT02729
   40 PSI(I,3) = -PSI(I,4)                                              RHT02730
      B = 1.0/DELT                                                      RHT02731
      B(N,N) = B                                                        RHT02732
      DO 50 I=2,N                                                       RHT02733
      IS = K-I                                                          RHT02734
I     B(1,I) = -( PSI(N,1)*PSI(IS,2) + PSI(I-1,1) )/DELTA               RHT02735
I  50 B(IS,N) = B(1,I)                                                  RHT02736
      NN = K/2                                                          RHT02737
      DO 60 I=2,NN                                                      RHT02738
      IS = K-I                                                          RHT02739
      DO 60 J=I,IS                                                      RHT02740
      JS = K-J                                                          RHT02741
I     B(I,J) = B(I-1,J-1) + ( PSI(I-1,2)*PSI(J-1,1)                     RHT02742
     1 - PSI(IS,1)*PSI(JS,2) )/DELTA                                    RHT02743
I  60 B(JS,IS) = B(I,J)                                                 RHT02744
      NN = N-1                                                          RHT02745
      DO 70 I=1,NN                                                      RHT02746
      IL = I+L                                                          RHT02747
      M = I+1                                                           RHT02748
      DO 70 J=M,N                                                       RHT02749
      JL = J+L                                                          RHT02750
      B(J,I) = B(I,J)                                                   RHT02751
   70 B(J,IL) = -B(I,JL)                                                RHT02752
      RETURN                                                            RHT02753
      END                                                               RHT02754
