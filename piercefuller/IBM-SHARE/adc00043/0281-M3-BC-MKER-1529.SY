*      LABEL                                                            MKER0001
*      FAP                                                              MKER0002
*MAKER000                                                               MKER0003
       REM     CHARACTER HANDLING ROUTINES GIO                          MKER0004
       COUNT   1200                                                     MKER0005
       7090                                                             MKER0006
       ENTRY   MAKER                      GENERATE A BLOK OF CODE       MKER0007
       ENTRY   BLOK (A,B,N)                                             MKER0008
       ENTRY   UNBLOK                     UNPACKING ROUTIN              MKER0009
       ENTRY   OCONV                      CONVERT BCD OCTAL TO BINARY   MKER0010
       ENTRY   REMAKE (BLOK)              RESTORE COM.REG. TO ORG.VALUE MKER0011
       ENTRY   MAKEDL                     MAKE A DELETE LIST            MKER0012
       ENTRY   MAKESL                     MAKE A SEPERATOR LIST         MKER0013
       ENTRY   MAKEXL                     MAKE AN EXCHANGE LIST         MKER0014
       ENTRY   MAKEIL                     PUT INDICES INTO THE LIST     MKER0015
       ENTRY   INDEX                      GET INDEX FROM CURRENT LIST   MKER0016
       ENTRY   IWHERE                     GIVE NUMBER OF CURRENT INPUT CMKER0017
       ENTRY   GET                        EXECUTE GENERATED CODE        MKER0018
       ENTRY   NGET                       EXECUTE GENERATED CODE        MKER0019
       ENTRY   GETSET        BLOK,COUNT   EXECUTE GENERATED CODE        MKER0020
       EJECT                                                            MKER0021
       REM     DEFINITIONS                                              MKER0022
     W EQU     36                         NUMBER OF BITS PER WORD       MKER0023
     C EQU     6                          NUMBER OF BITS PER CHARACTER  MKER0024
     K EQU     5*C                        SHIFT FROM ALL LEFT TO ALL RIGMKER0025
     I EQU     1                          INDEX FOR FORTRAN INDEXING    MKER0026
IC     EQU     -1                         FORTRAN 2 STORAGE OF COMREG   MKER0027
CARD   EQU     13            BASIC INPUT BLOK                           MKER0028
 CARD1 EQU     CARD+1        REAL INPUT BLOK                            MKER0029
CHARD1 EQU     CARD1*W/C+1   REAI PLUS END CHAR.                        MKER0030
  LIST EQU     0                                                        MKER0031
...    EQU     0                          INTIALIZE TO 0                MKER0032
OUTSIZ EQU     133                                                      MKER0033
       REM                                                              MKER0034
       REM     DEFINITION OF XRS                                        MKER0035
   XSP REM     4             FOR TSXS                                   MKER0036
    X4 EQU     4                                                        MKER0037
 XCODE EQU     1             MAKER PART 1                               MKER0038
  XDIF EQU     2             MAKER PART 2,3                             MKER0039
    XR EQU     1             MAKER PART 3                               MKER0040
    XM EQU     3             MAKER PART 3                               MKER0041
    XA EQU     5             BLOK+UNBLOK                                MKER0042
    XB EQU     6             BLOK+UNBLOK                                MKER0043
    XI EQU     1             GET-ALL                                    MKER0044
XBASIS EQU     3             GET-TABLE                                  MKER0045
 XCHAR EQU     4             GET-LIST                                   MKER0046
       REM                   AND MAKE S,X,D LIST ROUTINES               MKER0047
    XG EQU     2             GET-ALL                                    MKER0048
 XN    EQU     1             MAKE LS COUNT OF H-FIELD                   MKER0049
XPOSS  EQU     2     MAKEIL INDEX TO REFER TO SPECIAL WORD TABLE        MKER0050
X6     EQU     3                          MAKE ANY LIS   CHARCOUNT INPUTMKER0051
XLINK  EQU     4                    INTERNAL SUB INDEX FOR MAKEIL ROUT  MKER0052
XW     EQU     5           MAKE ANY LIST ,INPUT STRING WORDCOUNT        MKER0053
XINDEX EQU     6             MAKE IL, INDEX COUNTER                     MKER0054
XCH    EQU     7                    CHARACTER REFERNCING IN LIST ROUTS. MKER0055
X2     EQU     2           INDEX IN OCTAL CONVERSION                    MKER0056
XTAB   EQU     XCH           TABL SEARCH IN LIST GENERATORS             MKER0057
  BSEP BOOL    1                                                        MKER0058
       REM                                                              MKER0059
  BDEL BOOL    2                                                        MKER0060
  BXCH BOOL    4                                                        MKER0061
       EJECT                                                            MKER0062
 MAKER SYN     *                                                        MKER0063
       REM                                                              MKER0064
       SXA     MBACK,XCODE                SAVE INDEXES                  MKER0065
       REM     EQUAL TO XR                                              MKER0066
       SXA     MBACK+1,XDIF                                             MKER0067
       SXA     MBACK+2,XM                                               MKER0068
       REM                                                              MKER0069
       REM     MOVE BLOK OF CODE, MAKER PART 1                          MKER0070
       CLA     1,4           PICK UP WHERE GET IS TO BE                 MKER0071
       ANA     MASK          KNOCK OUT  TSX,0                           MKER0072
       SUB     LCODE         ALSO COMPUTE                               MKER0073
       TPL     POS       ADD RELOCATION TO ADDRESS IF GOING UP          MKER0074
       COM                   POS OR TWOS COMP                           MKER0075
       SUB    =1            SINCE THERE IS NOW A MINUS SIGN IN AC       MKER0076
   POS STA     DIF                                                      MKER0077
       CAL     =1            FORTRAN 2 STORES BACKW                     MKER0078
       ADD     1,4           AND ADD IT TO THE ORIGIN                   MKER0079
       STA     BLOKE         PLACE IT IN XR                             MKER0080
       AXT     CODEND-CODE,XCODE          PUT LENGTH OF CODE INTO XR    MKER0081
    PC CAL     CODEND,XCODE  AND MOVE                                   MKER0082
 BLOKE SLW     *-*,XCODE     ALL OF                                     MKER0083
       TIX     PC,XCODE,1    CODE                                       MKER0084
       REM                                                              MKER0085
       REM                                                              MKER0086
       REM                                                              MKER0087
       REM     PASS TO SET UP ROUTINE ACCORDING                         MKER0088
       REM                                                              MKER0089
       REM     TO CALLING SEQUENCE, MAKER PART 2                        MKER0090
       LAC     DIF,XDIF      DIFFERENCE BETWEEN CODE HERE AND           MKER0091
       REM     OUTPUT ADDRESS                                           MKER0092
       CLA     3,4                        PICK UP 'RESULT'              MKER0093
       STA     OUT,XDIF                   SO BLOK WILL GENERATE ITS OP  MKER0094
       REM                                INTO  IT                      MKER0095
       REM     LIMIT COUNT                NEW  GENERATED CODE           MKER0096
       CLA*    7,4                        PICK UP LIMIT                 MKER0097
       STO     N               STORE IN CALL.SEQ. REFERENCE OF BLOK     MKER0098
       PDC     ,XCODE                     FORTRAN 2    COMPLEMENT       MKER0099
       TZE     NON                        IF ZERO DO NOTHING            MKER0100
       TMI     WANTC                      TO BLOK ROUTINE, IF NEG SET   MKER0101
       CLA     OUT,XDIF        TO GIVE COUNT, OTHERWISE                 MKER0102
       TRA     NDONE                      SET TO GIVE FIRST WORD OF OUT MKER0103
 WANTC CLA     ISN                        PUT    . TJIS IS INDICATED BY MKER0104
 NDONE STA     RESULT,XDIF                PUTTING ADDRESS INTO FINAL CALMKER0105
       PXD     ,XCODE                                FOR  FO R LIMIT TESMKER0106
       STD     NLIM,XDIF                  T OF GENERATED CHARS          MKER0107
   NON SYN     *                                                        MKER0108
       EJECT                                                            MKER0109
       REM     COMREG.                                                  MKER0110
       CLA     4,4                        SEE DEFINITION BEHIND CODE    MKER0111
       STA     COM1,XDIF                  ADDRESS OF LOOK AHEAD CHAR    MKER0112
       ADD     IC1                                                      MKER0113
       STA     COM2,XDIF                  AND INPUT CHAR COUNT OF       MKER0114
       STA     COM2A,XDIF                 AND IF DONE SO NEW VALUE LEFT MKER0115
       ADD     IC1                                                      MKER0116
COM3A  STA     COM3,XDIF                  INPUT BLOK COUNT FOR UNBLOCKNGMKER0117
       STZ*    COM3,XDIF                                                MKER0118
       ADD     IC1                                                      MKER0119
       STA     COM4          HERE         SO WE CAN RESET INITIA        MKER0120
       ADD     IC1                        BLOK ADDRESS THAT IS USED TO  MKER0121
       STA     COM5,XDIF                  REMAKE. WHEREAS THIS LOC HAS  MKER0122
       STA     COM5A                THE ACTUAL REFERNCE WHICH IS MODIFIEMKER0123
       ADD     BLOKD                GO TO TOP FOR FORTRAN IV STORAGE    MKER0124
       STA     INP1,XDIF                  AND THEN THE AREAWHERE THE UN-MKER0125
       STA     GETI,XDIF                  BLOCKED CHARS. ARE KEPT       MKER0126
       REM                                                              MKER0127
       REM     SEP LIST                   IF NEG THAT IS                MKER0128
       CLA*    5,4                        WELL GET  THE COUNT           MKER0129
       TMI     SEPM                       TEST IF OUTPUTSTRING TO BE ENDMKER0130
       PDX     ,XM                                                      MKER0131
       TXH     LVIT,XM,OUTSIZ                                           MKER0132
       COM                                DED BY CHAR. OR BY COUNT      MKER0133
       REM ALS 18          FORTRAN IV                                   MKER0134
       STD     FIXTST,XDIF                SET COUNT HERE SO THAT 1 MORE MKER0135
 LVIT  CLA*    6,4                                                      MKER0136
       TMI     YES                                                      MKER0137
       CLA     TRA           DO NOT CHECK LIST                          MKER0138
       STD     DONT,XDIF                                                MKER0139
       STT     DONT,XDIF                                                MKER0140
   TRA TRA     DONES                                                    MKER0141
   YES SYN     *             DELETE OR XCHANGE, NO SEP                  MKER0142
       CAL     BASIS,XDIF           REMOVE SEPERATOR TRANSFERS FROM LISTMKER0143
       SLW     BASIS+1,XDIF         THAT  CHECKS ENTRIES                MKER0144
       CAL     BASIS+2,XDIF                                             MKER0145
       SLW     BASIS+3,XDIF                                             MKER0146
       SLW     BASIS+7,XDIF                                             MKER0147
       CAL     BASIS+4,XDIF                                             MKER0148
       SLW     BASIS+5,XDIF                                             MKER0149
       REM                                                              MKER0150
SEPM   CLA     6,4                  ALWAYS USE LIST GIVEN IN SECOND PLACMKER0151
       ACL     IC1           THE FIRST WORD OF LIST HAS ID INFORM       MKER0152
       STA     LIST1,XDIF                                               MKER0153
 DONES SYN     *                                                        MKER0154
       REM                                                              MKER0155
       REM     BEGIN OF STRING DEF. ONLY IN COMREG                      MKER0156
       CLA     2,4                                                      MKER0157
  COM4 STA     *-*                                                      MKER0158
COM5A  STA     *-*                                                      MKER0159
       REM                   ALSO MAKE SURE IN LIST                     MKER0160
       EJECT                                                            MKER0161
       REM     RELOCATE ADRESSES MAKER PART 2                           MKER0162
       LXA     SRLAD,XR                                                 MKER0163
   NCT CLA     ERLAD,XR                                                 MKER0164
       PDX     ,XM                                                      MKER0165
       STA     WORD                                                     MKER0166
  WORD CAL     *-*,XDIF                                                 MKER0167
       ACL     DIF            MODIFY ADDRESS BY MOVE AMOUNT             MKER0168
       STA*    WORD                                                     MKER0169
       TNX     REEKS,XM,1                                               MKER0170
       TXI     WORD,XDIF,-1                                             MKER0171
 REEKS SYN     *                                                        MKER0172
       LAC     DIF,XDIF       RESTORE CONTENTS OF XR                    MKER0173
       TIX     NCT,XR,1                                                 MKER0174
       REM                                                              MKER0175
       REM     INITIALIZE                                               MKER0176
       REM                                                              MKER0177
       CAL     FCODEL                                                   MKER0178
MBACK  AXT     *-*,XCODE                  RESET INDICES                 MKER0179
       AXT     *-*,XDIF                                                 MKER0180
       AXT     *-*,XM                                                   MKER0181
       TRA     8,4                        AND THAT SHOUD DO IT          MKER0182
DIF    PZE                    RELOCATION POS IF UP,COMPL IF DOWN        MKER0183
       EJECT                                                            MKER0184
REMAKE SYN     *                                                        MKER0185
       STL     0,4           NEXT TIME DO IT FASTER                     MKER0186
       REM     GET COM REG ADDRESSES                                    MKER0187
       CLA*    1,4                                                      MKER0188
       STA     *+1           ADDRESS IS CODE                            MKER0189
       CLA     *-*             ADDRESS IS COM+1                         MKER0190
       STA     RCOM                                                     MKER0191
       ADD     IC1           GET BLOK NO INPUT                          MKER0192
       STA     RCOMB                                                    MKER0193
       ADD     IC1           GET SOURCE STRING ORIGIN                   MKER0194
       STA     LBEG                                                     MKER0195
       ADD     IC1           GET CURRENT STRING ORIGIN                  MKER0196
       STA     LBEG1         HERE FOR CURRENT REFERENCE                 MKER0197
  LBEG CLA     *-*                                                      MKER0198
 LBEG1 STA     *-*           RESET TO REAL BEGIN LOC NOW                MKER0199
  RCOM STZ     *-*           RESET COM REGION                           MKER0200
 RCOMB STZ     *-*           NO INPUT IS UNBLOCKED                      MKER0201
       REM                                                              MKER0202
       TRA     2,4                                                      MKER0203
       EJECT                                                            MKER0204
       REM     GET ENTRY AND EXIT                                       MKER0205
   GET SYN     *                                                        MKER0206
NGET   SYN     *                                                        MKER0207
       STL     0,4           NEXT TIME DO IT FASTER                     MKER0208
       CLA     1,4           GET WHERE GET CODE IS                      MKER0209
       STA     OLD14                                                    MKER0210
GTTST  SYN     *             COME HERE FROM GETSET                      MKER0211
       SXA     EGAD,XI       INPUT CHAR.                                MKER0212
       SXA     EGAD+1,XBASIS REFERENCE ADDRESS LIST                     MKER0213
       SXA     EGAD+2,XCHAR  CHARACTER                                  MKER0214
       SXA     EGAD+3,XG     GOOD CHARACTER                             MKER0215
       AXT     0,XG          SET DUP CHAR                               MKER0216
       SXA     EEGAB,XA                                                 MKER0217
       SXA     EEGAB+1,XB                                               MKER0218
OLD14  TRA     *-*           GO TO GENERATED CODE                       MKER0219
       REM                                                              MKER0220
  EGAD AXT     *-*,XI                                                   MKER0221
       AXT     *-*,XBASIS                                               MKER0222
       AXT     *-*,XCHAR                                                MKER0223
       AXT     *-*,XG                                                   MKER0224
EEGAB  AXT     ...,XA                                                   MKER0225
       AXT     ...,XB                                                   MKER0226
       TRA     2,4                                                      MKER0227
       REM                                                              MKER0228
       EJECT                                                            MKER0229
GETSET SYN     *                          GET VARIABLE NO.OF CHAR.      MKER0230
       STL     0,4           NEXT TIME DO IT FASTER                     MKER0231
       CLA     1,4           PICK UP TXH                                MKER0232
       STA     OLD14         SET CODE ENTRY                             MKER0233
       ADD     DTXH                                                     MKER0234
       STA     LTXH                                                     MKER0235
       REM                   MODIFY CURRENT ROUTINE                     MKER0236
       CLA*    2,4                                                      MKER0237
       COM                                                              MKER0238
  LTXH STD     *-*                                                      MKER0239
       TXI     GTTST,4,-1      REDUCE INDEX BY ONE TO RETURN TO 3,4     MKER0240
       EJECT                                                            MKER0241
       REM     CODE FOR GET ROUTINE CENTER                              MKER0242
  CODE SYN     *                                                        MKER0243
COM2   LXA     *-*,XI                     SET INDEX FOR INPUT CHAR COUNTMKER0244
 COM3  ZET     *-*           TEST BLOK COUNT                            MKER0245
 A1    TRA     ISINP           READY TO PROCESS                         MKER0246
       REM                                                              MKER0247
NEWSET TSX     UNBLAK,4    GO TO SPECIAL INTERNAL ENTRY POINT FOR UNBLOKMKER0248
  COM5 PZE     *-*           INDIRECT REFERENCE TO CURRENT BEG.         MKER0249
 INP1  PZE     *-*           WORKING AREA INPUT IN COMREG               MKER0250
       PZE     SIZEB         NUMBER OF WORDS TO BE UNBLOCKED            MKER0251
 ISINP AXC     BASIS,XBASIS  NOW WERE SURE TO HAVE INPUT                MKER0252
       REM                                                              MKER0253
 GETI  CAL     *-*,XI        GET CURRENT CHARACTER                      MKER0254
  DELT SYN     *-1                                                      MKER0255
  DONT PAX     BASIS,XCHAR   FORTRAN 2                                  MKER0256
 LIST1 TRA*    LIST,XCHAR                                               MKER0257
       REM     LIST HAS REF. ADRESSES 0 TO 8                            MKER0258
 BASIS TXI     GOOD,XI,-1    0  GO TO PROPER                            MKER0259
       TRA     SEPR          1  AREA, DISCOUNTED INPUT                  MKER0260
       TXI     DELT,XI,-1    2  CHAR. INDEX IF USED                     MKER0261
       TXI     SND,XI,-1     3                                          MKER0262
       TXI     EXCH,XI,-1    4                                          MKER0263
       TRA     SNEX          5                                          MKER0264
       TXI     DELT,XI,-1    6  MEANING LESS                            MKER0265
       TXI     DSNX,XI,-1    7                                          MKER0266
EBASIS SYN     *                                                        MKER0267
BEND   EQU     NEWSET-BASIS             DISTANCE FOR 77 ENTRY TO FILL   MKER0268
       EJECT                                                            MKER0269
       REM         ROUTINE FOR INDICATED FUNCTIONS                      MKER0270
       REM                                                              MKER0271
       REM         INTERCHANGE GOOD CHAR                                MKER0272
 EXCH  CAL*    LIST1         PICK UP EXCHANGE CHAR                      MKER0273
       LGR     K                                                        MKER0274
       REM                                                              MKER0275
       REM     GOOD CHARACTER                                           MKER0276
  GOOD SLW     OUTPUT,XG     STORE GOOD CHAR                            MKER0277
CGOOD  SYN     *                                                        MKER0278
CHGOOD TXI     *+1,XG,-1                  COUNT GOOD CHARACTER HOORAAY  MKER0279
FIXTST TXH     GETI,XG,...                AND IF A FIXED NUMBER IS EXC. MKER0280
       TXI     *+1,XI,1        RESET COUNT TO START NEXT AT LOOK CHAR   MKER0281
       TXI     LASTC,XG,1                 EEDED GO AND DO NOT COUNT LASTMKER0282
       REM                                                              MKER0283
       REM     SEPERATE HERE WITH INTERCHANGE                           MKER0284
 SNEX  CAL*    LIST1                                                    MKER0285
       LGR     K                                                        MKER0286
       REM     SEPERATE WITH DELETE IS INDICATED                        MKER0287
   SND SYN     *             BY TXI ALREADY                             MKER0288
  DSNX SYN     SNEX          AND EXCHANGE GOES TO HELL                  MKER0289
  SEPR SYN     *                                                        MKER0290
       REM                                                              MKER0291
       REM     SEPERATION IF WANTED                                     MKER0292
 LASTC SYN     *             OR HAVE WE PASSED LAST CHAR                MKER0293
       REM                                                              MKER0294
  COM1 SLW     *-*           SAVE THIS CHAR FOR LOOK AHEAD              MKER0295
TOOBIG SYN     *                                                        MKER0296
       REM                   AND NOW PACK THE RESULT                    MKER0297
       TSX     BLAK,4                     INTERNAL ENTRY TO BLOK        MKER0298
   OUT PZE     *-*                                                      MKER0299
NLIM   TXH     SIZEOK,XG,...                                            MKER0300
RESULT CAL     *-*           MAY BE WORD OR COUNT                       MKER0301
 COM2A SXA     *-*,XI        SAVE INDEX TO INPUT CHAR                   MKER0302
       TRA     EGAD             AND LEAVE TO RESTORE ALL INDICES        MKER0303
 START TRA     CODE          TEMP. FORTRAN 2 ARRAY IS UPSIDE            MKER0304
CODEND SYN     *                                                        MKER0305
       EJECT                                                            MKER0306
       REM     TABLE OF RELOCATABLE ADDRESSES                           MKER0307
  RLAD PZE     A1,,1                                                    MKER0308
       PZE     ISINP,,1                                                 MKER0309
       PZE     DONT,,1                                                  MKER0310
       PZE     BASIS,,EXCH-BASIS+1                                      MKER0311
               CGOOD,,SNEX-CGOOD+1                                      MKER0312
       PZE     START,,1                                                 MKER0313
 ERLAD SYN     *                                                        MKER0314
 SRLAD PZE     ERLAD-RLAD                                               MKER0315
       REM                                                              MKER0316
       REM                                                              MKER0317
       REM     COMREG                                                   MKER0318
  LOOK REM     CONTAINS NEXT CHARACTER                                  MKER0319
   COM REM     INDEX TO CHAR IN UNBLOCKED INPUT                         MKER0320
  COMB REM     BLOK NO                                                  MKER0321
  LBEG REM     ORIGINAL BEGIN LOC                                       MKER0322
 LBEG1 REM     CURRENT BEGIN LOC                                        MKER0323
 INPUT REM     AREA FOR UNPACKED CHARS                                  MKER0324
       EJECT                                                            MKER0325
       REM     UNBLOK TAKES MULTIPLE CHAR WORDS AND GIVES 1 CHAR/WORD   MKER0326
       REM     A FORTRAN 2 BACKWARD, PACKED CHARS                       MKER0327
       REM     B CHARS, FORWARD, RIGHT ADJUSTED                         MKER0328
       REM     N FORTRAN 2 INTEGER SPEC. A                              MKER0329
       REM     ONE EXTRA WORD IN B INDICATES END                        MKER0330
UNBLOK SYN     *      OUTSIDE ENTRY WITH DIRECT ADDRESSING              MKER0331
       SXA     RSA,XA        SAVE XRS                                   MKER0332
       SXA     RSB,XB                                                   MKER0333
       CLA     1,4           PICK UP A-ADDRESS                          MKER0334
       TRA     GETHER                                                   MKER0335
UNBLAK SYN     *                                                        MKER0336
       CLA*    COM3-NEWSET,4   UPDATE BLOCK COUNT                       MKER0337
       ADD     =1              BY ONE                                   MKER0338
       STO*    COM3-NEWSET,4                                            MKER0339
       CLA*    COM5-NEWSET,4   UPDATE BLOCK ADDRESS                     MKER0340
       ADD     UNBLKD          NEXT TIME UNWRAP NEXT 12 WDS             MKER0341
       STA*    COM5-NEWSET,4   FROM CONDENSED INPUT                     MKER0342
       SUB     UNBLKD                                                   MKER0343
       AXT     0,XI            NUMBER OF CHARS USED                     MKER0344
GETHER SYN     *                                                        MKER0345
       STA     AIN           TO PICK UP PACKED WORD                     MKER0346
       CLA     2,4                        PICK UP ADDRESS TRUE OF B-REFEMKER0347
       PAC     ,XB           INTO XRS                                   MKER0348
       CLA*    3,4                        PICK UP THE COUNT             MKER0349
       TZE     GOUT          IF NEEDED                                  MKER0350
       PDX     ,XA           FORTRAN 2 INTEGER                          MKER0351
       TXI     *+1,XA,-1     COMPENSATE REF                             MKER0352
       SXD     LIMIT,XA                                                 MKER0353
       AXT     0,XA          SET A REF                                  MKER0354
   AIN LDQ     *-*,XA        GET A+WORD                                 MKER0355
 NDUP  EQU     3                                                        MKER0356
       PXD     0,0           GET ONLY                                   MKER0357
       LGL     C             ONE CHAR                                   MKER0358
       SLW     0,XB            THES CARDS ARE REQUIRED BECAUSE OF THE   MKER0359
       PXD     0,0             STUPIDITY OF FAP                         MKER0360
       LGL     C                                                        MKER0361
       SLW     1,XB                                                     MKER0362
       PXD     0,0             ST                                       MKER0363
       LGL     C                                                        MKER0364
       SLW     2,XB                                                     MKER0365
       PXD     0,0                                                      MKER0366
       LGL     C                                                        MKER0367
       SLW     3,XB                                                     MKER0368
       PXD     0,0                                                      MKER0369
       LGL     C                                                        MKER0370
       SLW     4,XB                                                     MKER0371
       PXD     0,0                                                      MKER0372
       LGL     C                                                        MKER0373
       SLW     5,XB                                                     MKER0374
       TXI     *+1,XB,-W/C   SET FOR NEXT SET                           MKER0375
       TXI     *+1,XA,I      AND INPUT WORD                             MKER0376
 LIMIT TXL     AIN,XA,*-*    UNTIL END                                  MKER0377
       LDQ     =O77           END CHARACTER         MD OF UNBLOCKED AREAMKER0378
       STQ     0,XB            SET TO     INDICATE EMD OF UNBLOCKED AREAMKER0379
GOUT   SYN     *                                                        MKER0380
   RSA AXT     *-*,XA        RESET XRS                                  MKER0381
   RSB AXT     *-*,XB                                                   MKER0382
       TRA     4,4                        RETURN TO CALLED OUTSIDE OR BKMKER0383
       EJECT                                                            MKER0384
       REM     BLOK GETS 1CHAR/WORD AND PACKS OUTPUT                    MKER0385
       REM     A IS STORED FORWARD ALREADY, CHARS                       MKER0386
       REM     B IS FORTRAN 2 STILL, WORDS                              MKER0387
       REM     N IS FORTRAN 2 TYPE INTEGER SPEC. A                      MKER0388
       REM     INTERNAL ENTRY HAS OTHER CALLING SEQUENCE WITH LIMIT TESTMKER0389
BLAK   SYN     *                                                        MKER0390
       TXL     OUTGO,XG,0      LEAVE HERE IF NO OUTPUT                  MKER0391
       CAL     NLIM-TOOBIG,4  PICK UP TESTCODE TXH GIVES OP LIMIT       MKER0392
       SLW     *+1            AND TEST LIMIT                            MKER0393
       ...     ...            TXH HERE TI TEST IF SIZEOK                MKER0394
       LXD     *-1,XG         SIZE LIMIT EXCEEDED SET TO MAX            MKER0395
SIZEOK PXA     0,XG           PICK UP SIZE                              MKER0396
       TZE     OUTGO                                                    MKER0397
       PAC     ,XA            COMPLEMENT IT                             MKER0398
       SXD     N,XA           GIVE IT FOR POSSIBLE OTPUT                MKER0399
       PXA     ,XA            AND PUT IN AC FOR ADDRESS MOD             MKER0400
       ACL     OUTBS          COMPUTE TRUE ADDRESS THROUGH DUMMY CLLING MKER0401
       TXI     COMBLA,4,1           CHANCE RETURN                       MKER0402
       REM                                                              MKER0403
 BLOK  CLA*    3,4           GET COUNT                                  MKER0404
       SXA     RA,XA         SAVE XRS                                   MKER0405
       TZE     OUTGO                                                    MKER0406
       ARS     18            FORTRAN 2                                  MKER0407
       PAX     0,XA          AND SET UP FOR USE                         MKER0408
       ACL     1,4           ADD REFERENCE ADDRESS                      MKER0409
COMBLA SYN     *                                                        MKER0410
       STA     ISENDA        TOP ADDRESS                                MKER0411
       SXA     TEST,XA       TO FIND OUT HOW EXCESS CHARS LATER         MKER0412
       SXA     RB,XB                                                    MKER0413
       CLA     2,4           RESULT                                     MKER0414
       PAC     ,XB           ADDRESS                                    MKER0415
ISENDA CAL     *-*,XA        PICK UP FIRST OF                           MKER0416
       TNX     LAST,XA,1     INPUT WORDS                                MKER0417
       DUP     3,W/C-1       AND THEN REMAINDER                         MKER0418
       ALS     C             AFTER SHIFT                                MKER0419
       ORA*    ISENDA        PICK UP REMAINING CHAR                     MKER0420
       TNX     LAST,XA,1     COUNTING ALONG                             MKER0421
       SLW     0,XB          STORE FINISHED WORD                        MKER0422
