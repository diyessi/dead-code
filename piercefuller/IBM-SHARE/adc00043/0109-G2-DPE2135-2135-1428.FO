  718 CONTINUE                                                               467
      DO 720 J=1,K                                                           468
  720 A(J,J)=1.                                                              469
      PRINT 917                                                              470
      DO 724 I=1,K                                                           471
  724 PRINT 918,I,(A(I,J),J=1,K)                                             472
C                  GET T*SE*SQRT(C(I,I))                                     473
      DO 726 J=1,K                                                           474
  726 SA(J)=T*SE*SA(J)                                                       475
