      IF (I-N) 302,302,316                                                   423
  316 GO TO (252,780,704,762,766,772),IBK2                                   424
C                  THIS IS THE END OF SUBROUTINE 2                           425
C                                                                            426
C     ..................................................................     427
C                  THIS IS THE CONFIDENCE LIMIT CALCULATION                  428
  700 DO 702 J=1,K                                                           429
  702 B(J)=BS(J)                                                             430
      PRINT 933,N,K,IP,M,FF,T,E,TAU                                         1430
      IBKA=2                                                                 431
C                  THIS WILL PRINT THE Y,YHAT,DELTA Y                        432
