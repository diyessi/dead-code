C                  WE NOW HAVE M                                             503
  740 PRINT 919                                                              504
      WS=K-IP                                                                505
      DO 750 J=1,K                                                           506
      IF(IP)743,743,741                                                      507
  741 DO 742 I=1,IP                                                          508
      IF(J-IB(I))742,746,742                                                 509
  742 CONTINUE                                                               510
  743 XMTM=0.                                                                511
      DO 744 JJ=1,K                                                          512
  744 XMTM=XMTM+A(J,JJ)**2                                                   513
      HJTD=SQRTF(SE*SE*WS*FF*XMTM)                                           514
      STE=SA(J)/T                                                            515
      OPL=BS(J)-SA(J)                                                        516
      OPU=BS(J)+SA(J)                                                        517
      SPL=BS(J)-HJTD                                                         518
      SPU=BS(J)+HJTD                                                         519
      PRINT 927,J,STE,OPL,OPU,SPL,SPU                                        520
      GO TO 750                                                              521
  746 PRINT 913,J                                                            522
  750 CONTINUE                                                               523
C                  NONLINEAR CONFIDENCE LIMIT                                524
      WS=K-IP                                                                525
      WS1=N-K+IP                                                             526
      PKN=WS/WS1                                                             527
      PC=PHIZ*(1.+FF*PKN)                                                    528
      PRINT 920,PC                                                           529
      PRINT 921                                                              530
      IFSS3=0                                                                531
      DO 790 J=1,K                                                           532
      IBKP=1                                                                 533
      DO 752 JJ=1,K                                                          534
  752 B(JJ)=BS(JJ)                                                           535
      IF(IP)758,758,754                                                      536
  754 DO 756 JJ=1,IP                                                         537
      IF(J-IB(JJ))756,787,756                                                538
  756 CONTINUE                                                               539
  758 DD=-1.                                                                 540
      IBKN=1                                                                 541
  760 D=DD                                                                   542
      B(J)=BS(J)+D*SA(J)                                                     543
      IBK2=4                                                                 544
      GO TO 300                                                              545
  762 PHI1=PHI                                                               546
      IF(PHI1-PC)764,770,770                                                 547
  764 D=D+DD                                                                 548
      IF(D/DD-5.)765,788,788                                                 549
  765 B(J)=BS(J)+D*SA(J)                                                     550
      IBK2=5                                                                 551
      GO TO 300                                                              552
  766 PHID=PHI                                                               553
      IF(PHID-PC)764,778,778                                                 554
  770 D=D/2.                                                                 555
      IF(D/DD-.001)788,788,771                                               556
  771 B(J)=BS(J)+D*SA(J)                                                     557
      IBK2=6                                                                 558
      GO TO 300                                                              559
  772 PHID=PHI                                                               560
      IF(PHID-PC)778,778,770                                                 561
  778 XK1=PHIZ/D+PHI1/(1.-D)+PHID/(D*(D-1.))                                 562
      XK2=-(PHIZ*(1.+D)/D+D/(1.-D)*PHI1+PHID/(D*(D-1.)))                     563
      XK3=PHIZ-PC                                                            564
      BC=(SQRTF(XK2*XK2-4.*XK1*XK3)-XK2)/(2.*XK1)                            565
      GO TO (779,784),IBKN                                                   566
  779 B(J)=BS(J)-SA(J)*BC                                                    567
      GO TO 781                                                              568
  784 B(J)=BS(J)+SA(J)*BC                                                    569
  781 IBK2=2                                                                 570
      GO TO 300                                                              571
  780 GO TO (782,786),IBKN                                                   572
  782 IBKN=2                                                                 573
      DD=1.                                                                  574
      BL=B(J)                                                                575
      PL=PHI                                                                 576
      GO TO 760                                                              577
  786 BU=B(J)                                                                578
      PU=PHI                                                                 579
      GO TO (783,795,785,789),IBKP                                           580
  783 PRINT 918,J,BL,PL,BU,PU                                                581
      GO TO 790                                                              582
  795 PRINT 915,J,BU,PU                                                      583
      GO TO 790                                                              584
  785 PRINT 918,J,BL,PL                                                      585
      GO TO 790                                                              586
  787 PRINT 913,J                                                            587
      GO TO 790                                                              588
  789 PRINT 914,J                                                            589
      GO TO 790                                                              590
  788 GO TO (791,792),IBKN                                                   591
C                  DELETE LOWER PRINT                                        592
  791 IBKP=2                                                                 593
      GO TO 780                                                              594
  792 GO TO (793,794),IBKP                                                   595
C                  DELETE UPPER PRINT                                        596
  793 IBKP=3                                                                 597
      GO TO 780                                                              598
C                  LOWER IS ALREADY DELETED, SO DELETE BOTH                  599
  794 IBKP=4                                                                 600
      GO TO 780                                                              601
  790 CONTINUE                                                               602
      GO TO 10                                                               603
