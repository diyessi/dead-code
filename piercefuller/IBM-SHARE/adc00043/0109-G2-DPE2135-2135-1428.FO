  704 IF(IFP)706,706,705                                                     434
  705 IBKA=3                                                                 435
      IFP=0                                                                  436
      GO TO 60                                                               437
  706 WS=N-K+IP                                                              438
      SE=SQRTF(PHI /WS)                                                      439
      PHIZ=PHI                                                               441
      IF (IFSS2)  707,707,709                                               1441
