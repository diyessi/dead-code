  709 PRINT 909, PHIZ,SE,RHO,XL                                             4441
C                  NOW WE HAVE MATRIX A                                      442
  708 GO TO (1122,1120),IBKT                                                 443
 1120 WRITE TAPE 3,A                                                         444
      REWIND 3                                                               445
      GO TO 1124                                                             446
 1122 DO 1123 II=1,K                                                         447
      III=II+10                                                              448
      DO 1123 JJ=1,K                                                         449
 1123 A(III,JJ)=A(II,JJ)                                                     450
 1124 IBKM=2                                                                 451
