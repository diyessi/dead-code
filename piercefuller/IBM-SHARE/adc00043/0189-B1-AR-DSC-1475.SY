*                 DOUBLE PRECISION SINE AND COSINE                      DSC  001
       LBL     DSC                                                      DSC  002
       COUNT   260                                                      DSC  003
       ENTRY   DSIN                                                     DSC  004
       ENTRY   DCOS                                                     DSC  005
       REM       DOUBLE PRECISION                                       DSC  006
       REM        SIN-COS ROUTINE                                       DSC  007
 DCOS  STI     SAVEI                                                    DSC  008
       CLA     PI2                                                      DSC  009
       LDQ     PI2+1                                                    DSC  010
       DST     4)-5                 MSP=4)-5,LSP=4)-4                   DSC  011
       DLD     4)-1                                                     DSC  012
       XCA                                                              DSC  013
       TZE     EXITC          COS(0)=1,SET AT EXIT                      DSC  014
       DFAD    4)-5           COS ANGLE= SIN(ANGLE +90)                 DSC  015
       XCA                    LSP=4)-1,MSP=4)                           DSC  016
       DST     4)-1                                                     DSC  017
       LDI     SAVEI                                                    DSC  018
  DSIN SXA     EXIT,4                                                   DSC  019
       STI     SAVEI                                                    DSC  020
       DLD     4)-1                                                     DSC  021
       XCA                                                              DSC  022
       TZE     EXIT                                                     DSC  023
       TPL     HEP                                                      DSC  024
       SSP                    WORK ON ABSOLUTE VALUE                    DSC  025
       LRS     0                                                        DSC  026
       DST     4)-1           MSP=4)-1,LSP=4)                           DSC  027
       LDQ     MONE           SET A MINUS FLAG FOR THE EXIT             DSC  028
       TRA     AD1                                                      DSC  029
 HEP   DST     4)-1           MSP=4)-1,LSP=4)                           DSC  030
       LDQ     ONE            SET A PLUS  FLAG FOR THE EXIT             DSC  031
  AD1  STQ     MULT2          DIV ARG BY 2PI,THAT IS,TREAT IT MOD 360   DSC  032
       CLA     PI22                                                     DSC  033
       LDQ     PI22+1                                                   DSC  034
       DST     4)-5           MSP=4)-5,LSP=4)-4                         DSC  035
       DLD     4)-1                                                     DSC  036
       DFDP    4)-5                                                     DSC  037
       DST     4)-3           ARG/2 PI    MSP=4)-3,LSP=4)-2             DSC  038
       LDQ     OC             NEXT THE INTEGRAL PORTION IS ELIMINATED   DSC  039
       TLQ     AD2              TRA PWR GREATER THAN OCT 233 IN MSH     DSC  040
       LDQ     OCC2                                                     DSC  041
       TLQ     AD12                                                     DSC  042
       LDQ     4)-2           LSP                                       DSC  043
       TRA     AD3                                                      DSC  044
 AD12  UFA     OC                                                       DSC  045
       CHS                                                              DSC  046
       FAD     4)-3                                                     DSC  047
       FAD     4)-2                                                     DSC  048
       TRA     AD3                                                      DSC  049
  AD2  CLA     4)-2           LSP                                       DSC  050
       LDQ     OC2                                                      DSC  051
       TLQ     EXIT                                                     DSC  052
       UFA     OC                                                       DSC  053
       CHS                                                              DSC  054
       FAD     4)-2                                                     DSC  055
  AD3  DST     4)-1           MSP NOW IN AC,LSP NOW IN MQ               DSC  056
       CLA     ET                                                       DSC  057
       LDQ     ET+1                                                     DSC  058
       DFMP    4)-1           BEGIN TO SEPARATE INTO QUADRANTS BY DIV BYDSC  059
       DST     4)-1           PI/4--THIS CONVENIENTLY COMBINES INTO THE DSC  060
       LDQ     OCC2           SINGLE STEP OF MULT. BY EIGHT             DSC  061
       TLQ     AD31           (FR*2.PI)/(PI/4)                          DSC  062
       LXA     OCC2,4                                                   DSC  063
       TRA     AD4C                                                     DSC  064
  AD31 UFA     OC             NOW WE TRUNCATE TO A FRAC. AGAIN          DSC  065
       PAX     0,4            FOR THE REMAINING OPERATION OF            DSC  066
       CHS                    QUADRANT REDUCTION.  BUT AT THE SAME TIME DSC  067
       FAD     4)-1           PRESERVE IR(4) WHICH QUADRANT             DSC  068
       STO     4)-1           AND THUS WHICH OCTANT WE REDUCED FROM     DSC  069
       PXA     0,4                                                      DSC  070
       LBT                                                              DSC  071
       TRA     AD4C                                                     DSC  072
       ADD     ONE1           1 3 5 7   MAKE ODD EVEN FOR EASE          DSC  073
       PAX     0,4            2 4 6 8   IN HANDLING SERIES              DSC  074
       CLA     4)-1                                                     DSC  075
       FAD     MONE                                                     DSC  076
       STO     4)-1                                                     DSC  077
       XCA                                                              DSC  078
       FAD     4)                                                       DSC  079
       STO     4)             FR,MSP=4)-1,LSP=4)                        DSC  080
 AD4C  LDQ     PI4            FR*(PI/4)                                 DSC  081
       FMP     4)-1                                                     DSC  082
       STO     TEMP           TO OCTANTS                                DSC  083
       STQ     TEMP2                                                    DSC  084
       LDQ     4)-1                                                     DSC  085
       FMP     PI4+1                                                    DSC  086
       FAD     TEMP2                                                    DSC  087
       STO     TEMP2                                                    DSC  088
       LDQ     PI4                                                      DSC  089
       FMP     4)                                                       DSC  090
       UFA     TEMP2                                                    DSC  091
       FAD     TEMP                                                     DSC  092
       DST     4)-1                                                     DSC  093
       CLA     ONE                                                      DSC  094
       TXL     ADS,4,0        I=0  HERE WE BRANCH DEPENDING ON          DSC  095
       TXL     ADC,4,2        I=2  THE OCTANT THAT WAS REDUCED          DSC  096
       TXH     ADS,4,6        FROM.  IT STARTS THE SERIES TO COMPUTE    DSC  097
       TXH     ADCM,4,4       EITHER THE SINE OR THE COSINE(90-ANGLE)   DSC  098
       CHS                    ONE OF WHICH WE HAVE FROM THE REDUCTION.  DSC  099
  ADS  STO     MULT                                                     DSC  100
       CLA     ONE                                                      DSC  101
       STO     N2                                                       DSC  102
       DLD     4)-1                                                     DSC  103
       DST     4)-5           MSP=4)-1 INTO B1,LSP=4)=B2                DSC  104
       TZE     EX                                                       DSC  105
       TRA     RTN                                                      DSC  106
 ADCM  CHS                                                              DSC  107
  ADC  STO     MULT                                                     DSC  108
       STZ     4)-4                                                     DSC  109
       STZ     N2                                                       DSC  110
       CLA     4)-1           MSP=4)-1                                  DSC  111
       LDQ     ONE                                                      DSC  112
       STQ     4)-5                                                     DSC  113
       STQ     4)-1                                                     DSC  114
       LDQ     4)             LSP=4)                                    DSC  115
       STZ     4)                                                       DSC  116
       TZE     EX                                                       DSC  117
  RTN  DST     4)-7           C(AC)=MSP=4)-1 INTO A1,C(MQ)=LSP=4)INTO A2DSC  118
       DFMP    4)-7           CONTENTS OF AC,MQ SQUARED                 DSC  119
       CHS                                                              DSC  120
       LRS     0                                                        DSC  121
       DST     4)-7           MSP INTO A1,LSP INTO A2                   DSC  122
       LDQ     4)-1                                                     DSC  123
       FMP     LIMIT          THIS PROVIDES A TEST OF HOW MANY TERMS    DSC  124
       SSP                    MUST BE COMPUTED. THE SERIES REPEATS ,    DSC  125
       STO     TEST           ADDING HIGHER POWER TERMS,UNTIL THIS      DSC  126
       REM                    ACCURACY IS REACHED                       DSC  127
  ADL  CLA     N2                                                       DSC  128
       FAD     ONE                                                      DSC  129
       STO     N                                                        DSC  130
       FAD     ONE                                                      DSC  131
       STO     N2                                                       DSC  132
       LDQ     N2                                                       DSC  133
       FMP     N                                                        DSC  134
       STO     4)-9           NN                                        DSC  135
       STZ     4)-8           NN+1                                      DSC  136
       DLD     4)-7           A                                         DSC  137
       DFDP    4)-9           /NN                                       DSC  138
       DFMP    4)-5           X B                                       DSC  139
       DST     4)-5                                                     DSC  140
       DFAD    4)-1                                                     DSC  141
       DST     4)-1           LSP=4)-1,MSP=4)                           DSC  142
       CLA     4)-5                                                     DSC  143
       SSP                                                              DSC  144
       LDQ     TEST                                                     DSC  145
       TLQ     ADL                                                      DSC  146
 EX    DLD     4)-1                                                     DSC  147
       STO     4)                                                       DSC  148
       STQ     4)-1                                                     DSC  149
       LDQ     MULT                                                     DSC  150
       FMP     MULT2                                                    DSC  151
       TPL     EXIT                                                     DSC  152
       CLS     4)                                                       DSC  153
       STO     4)                                                       DSC  154
       CLS     4)-1                                                     DSC  155
       STO     4)-1                                                     DSC  156
  EXIT AXT     0,4                                                      DSC  157
       LDI     SAVEI                                                    DSC  158
       TRA     1,4                                                      DSC  159
 EXITC CLA     ONE                                                      DSC  160
       STO     4)                                                       DSC  161
       STZ     4)-1                                                     DSC  162
       LDI     SAVEI                                                    DSC  163
       TRA     1,4                                                      DSC  164
 TEMP  PZE                                                              DSC  165
 TEMP2 PZE                                                              DSC  166
  PI4  OCT     200622077325,145042055060                                DSC  167
  PI2  OCT     201622077325,146042055060                                DSC  168
  PI22 OCT     203622077325,150042055060                                DSC  169
  OCC2 OCT     200000000000                                             DSC  170
  OC   OCT     233000000000                                             DSC  171
  OC2  OCT     230000000000                                             DSC  172
  ET   DEC     8.0                                                      DSC  173
 ETP1  DEC     0.0                                                      DSC  174
  ONE  DEC     1.0                                                      DSC  175
  ONE1 DEC     1                                                        DSC  176
  MONE DEC     -1.0                                                     DSC  177
 LIMIT DEC     1.0E-16                                                  DSC  178
  MULT PZE     0                                                        DSC  179
 MULT2 PZE     0                                                        DSC  180
  N    PZE     0                                                        DSC  181
  N2   PZE     0                                                        DSC  182
  NN   PZE     0                                                        DSC  183
  NNP1 PZE     0                                                        DSC  184
  TEST PZE     0                                                        DSC  185
 D1    PZE     0,0,1                                                    DSC  186
 D2    PZE     0,0,2                                                    DSC  187
 D3    PZE     0,0,3                                                    DSC  188
 D4    PZE     0,0,4                                                    DSC  189
 D5    PZE     0,0,5                                                    DSC  190
 D6    PZE     0,0,6                                                    DSC  191
 D7    PZE     0,0,7                                                    DSC  192
 D8    PZE     0,0,8                                                    DSC  193
 D9    PZE     0,0,9                                                    DSC  194
 D10   PZE     0,0,10                                                   DSC  195
 D11   PZE     0,0,11                                                   DSC  196
 D12   PZE     0,0,12                                                   DSC  197
SAVEI  PZE     0                                                        DSC  198
       COMMON  -206                                                     DSC  199
 4)    COMMON  1                                                        DSC  200
       END                                                              DSC  201
