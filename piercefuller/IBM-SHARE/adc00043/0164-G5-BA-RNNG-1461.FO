       COUNT   300                                                              
*NORMAL RANDOM NUMBER GENERATOR                                                 
*                                                                               
       ENTRY   RNST                                                             
       ENTRY   RNEX                                                             
       ENTRY   RNOR                                                             
 RNST  CLA*    1,4                                                              
       SSP                                                                      
       STO     U                                                                
       TRA     RNOR                                                             
 RNEX  SXD     RNST-2,4                                                         
       CLA     U                                                                
       TRA     2,4                                                              
 RNOR  SXD     RNST-2,4                                                         
       CLA     U                                                                
       ALS     7                                                                
       ADD     U                                                                
       ADD     C                                                                
       STO     U                  GENERATE U                                    
       ALS     1                                                                
       XCL                                                                      
       XCA                        GENERATE SIGN                                 
       LAS     C1                                                               
       TRA     R20                                                              
       TRA     R20                TO R20 IF U GE C1                             
       LRS     11                                                               
       PDC     0,4                SET TABLE 1 ADDRESS                           
       LLS     8                                                                
       ANA     M1                                                               
       ORA     TAB1,4             FLOATED X                                     
       LLS     0                                                                
       FAD     ZERO               NORMALIZED X                                  
       LXD     RNST-2,4                                                         
       TRA     2,4                EXIT                                          
 R20   LAS     C2                                                               
       TRA     R30                                                              
       TRA     R30                TO R30 IF U GE C2                             
       LRS     8                                                                
       PDC     0,4                SET TABLE 1 ADDRESS                           
       LLS     5                                                                
       ANA     M1                                                               
       ORA     TAB1-326,4         FLOATED X                                     
       LLS     0                                                                
       FAD     ZERO               NORMALIZED X                                  
       LXD     RNST-2,4                                                         
       TRA     2,4                EXIT                                          
 R30   LAS     C3                                                               
       TRA     R40                                                              
       TRA     R40                TO R40 IF U GE C3                             
       LRS     5                                                                
       PDC     0,4                SET TABLE 1 ADDRESS                           
       LLS     2                                                                
       ANA     M1                                                               
       ORA     TAB1-3697,4        FLOATED X                                     
       LLS     0                                                                
       FAD     ZERO                                                             
 R35   LXD     RNST-2,4           NORMALIZED X                                  
       TRA     2,4                                                              
 R40   STO     SIGN               SAVE SIGN                                     
       LAS     C4                                                               
       TRA     R70                                                              
       TRA     R70                TO R70 IF U GE C4                             
 R80   AXT     0,4                SET J=0                                       
       ALS     1                                                                
 R90   LAS     TABL2,4                                                          
       TXI     R90,4,-1                                                         
       TXI     R90,4,-1           TO R90 IF U GE TABL2(J)                       
       SXA     J,4                SAVE J                                        
       TXI     *+1,4,-48          TABL2(J+48)                                   
       LAS     TABL2,4                                                          
       TRA     R130                                                             
       TRA     R130               TO R130 IF U GE TABL2(J+48)                   
 R95   CLA     U                                                                
       ALS     7                                                                
       ADD     U                                                                
       ADD     C                                                                
       STO     U1                 GENERATE U1                                   
       ALS     7                                                                
       ADD     U1                                                               
       ADD     C                                                                
       STO     U                  GENERATE U2                                   
       CLA     U                                                                
       CAS     U1                                                               
       STO     MAX                MAX=U2                                        
       TRA     R100                                                             
       STO     MIN                MIN=U2                                        
       CLA     U1                                                               
       STO     MAX                MAX=U1                                        
       TRA     R110                                                             
 R100  CLA     U1                                                               
       STO     MIN                MIN=U1                                        
 R110  TXI     *+1,4,-48          TABL2(J+96)                                   
       CLA     MAX                                                              
       ALS     1                                                                
       LAS     TABL2,4                                                          
       TRA     R115                                                             
       TRA     R115               TO R115 IF MAX GE TABL2(J+96)                 
       TRA     R120               TO R120 IF MAX LT TABL2(J+96)                 
 R115  LXA     J,4                                                              
       TXI     *+1,4,48           TABL2(J-48)                                   
       CLA     MIN                                                              
       ARS     16                                                               
       SUB     DELTA                                                            
       STO     T1                                                               
       ADD     DELTA                                                            
       ADD     DELTA                                                            
       ORA     WC                                                               
       ADD     MPY2                                                             
       FAD     TABL2,4                                                          
       STO     T2                 2*TABL2(J-48) + DELMIN + DEL                  
       CLA     T1                                                               
       ARS     1                                                                
       ORA     WC                                                               
       FAD     ZERO                                                             
       SSP                                                                      
       XCA                                                                      
       FMP     T2                 W                                             
       TSX     $EXP,4             EXP(W)                                        
       FSB     =1.                                                              
       STO     T1                 EXP(W)-1                                      
       CLA     MAX                                                              
       SUB     MIN                                                              
       ARS     8                                                                
       ORA     MMMC                                                             
       FAD     ZERO               NORMALIZE MAX-MIN                             
       STO     T2                                                               
       LXA     J,4                                                              
       TXI     *+1,4,-144                                                       
       LDQ     TABL2,4            TABL2(J+144)                                  
       FMP     T1                                                               
       CAS     T2                                                               
       TRA     R120               TO R120 IF M-M LT EXP                         
       TRA     R95                                                              
       TRA     R95                TO R95 IF M-M GE EXP                          
 R120  LXA     J,4                                                              
       TXI     *+1,4,48           TABL2(J-48)                                   
       CLA     MIN                                                              
       ARS     15                                                               
       ORA     WC                                                               
       FAD     TABL2,4                                                          
       STO     T1                                                               
 R125  CLA     SIGN                                                             
       TMI     *+4                                                              
       CLA     T1                                                               
       LXD     RNST-2,4                                                         
       TRA     2,4                                                              
       CLS     T1                                                               
       TRA     *-3                                                              
 R130  TXI     *+1,4,96           TABL2(J-48)                                   
       CLA     U                                                                
       ALS     7                                                                
       ADD     U                                                                
       ADD     C                                                                
       STO     U                  GENERATE U                                    
       CLA     U                                                                
       ARS     15                                                               
       ORA     WC                                                               
       FAD     TABL2,4                                                          
       STO     T1                                                               
       TRA     R125                                                             
 R70   TSX     U1U2,4             GENERATE U1                                   
       STO     U1                                                               
       TSX     U1U2,4             GENERATE U2                                   
       STO     U2                                                               
       XCA                                                                      
       FMP     U2                                                               
       STO     T1                 U2**2                                         
       LDQ     U1                                                               
       FMP     U1                 U1**2                                         
       FAD     T1                 U1**2+U2**2                                   
       CAS     =1.                                                              
       TRA     R70                U1**2+U2**2 GT 1                              
       TRA     R70                                                              
       STO     T1                 S                                             
       TSX     $LOG,4             LN(S)                                         
       XCA                                                                      
       FMP     =2.                2*LN(S)                                       
       CHS                                                                      
       FAD     =9.                9-2*LN(S)                                     
       FDP     T1                                                               
       XCA                                                                      
       TSX     $SQRT,4                                                          
       STO     T2                 T                                             
       XCA                                                                      
       FMP     U1                 U1*T                                          
       STO     T1                                                               
       CAS     =3.                                                              
       TRA     R125                TO R125 IF U1*T GT 3                         
       NOP                                                                      
       LDQ     T2                                                               
       FMP     U2                 U2*T                                          
       STO     T1                                                               
       CAS     =3.                                                              
       TRA     R125                TO R125 IF U2*T GT 3                         
       NOP                                                                      
       TRA     R70                                                              
 U1U2  CLA     U                                                                
       ALS     7                                                                
       ADD     U                                                                
       ADD     C                                                                
       STO     U                  GENERATE U                                    
       CLA     U                                                                
       ARS     8                                                                
       ORA     MMMC               FLOAT U                                       
       FAD     ZERO               NORMALIZE U                                   
       TRA     1,4                EXIT WITH U IN AC                             
 ZERO  PZE                                                                      
 DELTA OCT     000002000000                                                     
 WC    OCT     203000000000                                                     
 M1    OCT     000003777777                                                     
 U     OCT     000000000000                                                     
 C     OCT     1                                                                
 C1    OCT     260000000000       54                                            
 C2    OCT     355400000000       733                                           
 C3    OCT     367410000000       7571                                          
 C4    OCT     377236103601       776474207403                                  
 MPY2  OCT     001000000000                                                     
 MMMC  OCT     200000000000                                                     
 T1    PZE                                                                      
 T2    PZE                                                                      
 SIGN  PZE                                                                      
