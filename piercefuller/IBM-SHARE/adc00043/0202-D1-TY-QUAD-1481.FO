C     ROMBERG INTEGRATION                                               QUAD0001
      FUNCTION QUAD(A,B,FCN,EPS,ETA,MIN)                                QUAD0002
    1 H=B-A                                                             QUAD0003
      DIMENSION Q(16)                                                   QUAD0004
      FCNA=FCN(A)                                                       QUAD0005
      FCNB=FCN(B)                                                       QUAD0006
      TABS=ABSF(H)*(ABSF(FCNA)+ABSF(FCNB))/2.                           QUAD0007
      T=H*(FCNA+FCNB)/2.                                                QUAD0008
      NX=1                                                              QUAD0009
      DO 12 N=1,15                                                      QUAD0010
      H=H/2.                                                            QUAD0011
      SUM=0                                                             QUAD0012
      SCORR=0                                                           QUAD0013
      SUMABS=0                                                          QUAD0014
      DO 2 I=1,NX                                                       QUAD0015
      XI=2.*FLOATF(I)-1.                                                QUAD0016
      FCNXI=FCN(A+XI*H)                                                 QUAD0017
      SUMABS=SUMABS+ABSF(FCNXI)                                         QUAD0018
      FCNXI=FCNXI+SCORR                                                 QUAD0019
      SS=SUM+FCNXI                                                      QUAD0020
      SCORR=(SUM-SS)+FCNXI                                              QUAD0021
    2 SUM=SS                                                            QUAD0022
      T=T/2. +H*SUM                                                     QUAD0023
      TABS=TABS/2. +ABSF(H)*SUMABS                                      QUAD0024
      Q(N)=2.*(T+H*SUM)/3.                                              QUAD0025
      IF(N-2)10,3,3                                                     QUAD0026
    3 F=4.                                                              QUAD0027
      DO 4 J=2,N                                                        QUAD0028
      I=N+1-J                                                           QUAD0029
      F=F*4.                                                            QUAD0030
    4 Q(I)=Q(I+1)+(Q(I+1)-Q(I))/(F-1.)                                  QUAD0031
      IF(N-3)9,5,5                                                      QUAD0032
    5 IF(N-MIN)9,6,6                                                    QUAD0033
    6 X=ABSF(Q(1)-QX2)+ABSF(QX2-QX1)                                    QUAD0034
      IF(TABS)7,8,7                                                     QUAD0035
    7 IF(X/TABS-3.*(ABSF(ETA)+0.14901161E-7))11,11,8                    QUAD0036
    8 IF(X-3.*ABSF(EPS))11,11,9                                         QUAD0037
    9 QX1=QX2                                                           QUAD0038
   10 QX2=Q(1)                                                          QUAD0039
   12 NX=NX*2                                                           QUAD0040
   11 QUAD=Q(1)                                                         QUAD0041
      RETURN                                                            QUAD0042
      END                                                               QUAD0043
