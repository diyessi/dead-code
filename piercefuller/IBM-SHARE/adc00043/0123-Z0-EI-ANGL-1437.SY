*      ANGLE CONVERTER ROUTINE                                               001
       LBL     ANGCON,X                                                      002
       ENTRY   RADIAN                                                        003
       ENTRY   DEGREE                                                        004
       ENTRY   TIME                                                          005
X      BSS     1                                                             006
D      BSS     1                                                             007
M      BSS     1                                                             008
TEMP   BSS     1                                                             009
       SPACE   5                                                             010
       REM       THIS ROUTINE TAKES A FLOATING POINT ANGLE IN THE FORM       011
       REM     58.07493 FOR 58 DEGREES, 7 MINUTES, 49.3 SECONDS AND          012
       REM     CONVERTS TO THE EQUIVALENT RADIAN ANGLE.                      013
       REM                                                                   014
       REM        THE OTHER TWO ENTRY POINTS CONVERT A RADIAN ANGLE          015
       REM     TO DEGREES MINUTES AND SECONDS OF ARC AND HOURS MINUTES       016
       REM     AND SECONDS OF TIME,THE ANSWERS BEING RETURNED IN THE         017
       REM     ABOVE FORM.                                                   018
       REM     THE ENTRY POINT NAMES ARE                                     019
       REM                              RADIAN                               020
       REM                              DEGREE                               021
       REM                              TIME                                 022
       REM                                                                   023
       REM     FORTRAN CALLING PROGRAMS MUST APPEND AN F TO THE ENTRY        024
       REM     POINT NAME, SINCE THE ROUTINE TAKES ITS ARGUMENT FROM         025
       REM     THE ACCUMULATOR AND LEAVES ITS RESULT IN THE ACCUMULATOR      026
       REM                                                                   027
       REM     FORTRAN INPUT TRUNCATION ERROR WILL BE AUTOMATICALLY          028
       REM     COMPENSATED.                                                  029
       REM                                                                   030
       REM       THE CHOP MACRO LEAVES A FLOATING INTEGER IN THE             031
       REM     ACCUMULATOR.                                                  032
       REM                                                                   033
       SPACE   5                                                             034
CHOP   MACRO                                                                 035
       UFA     =O233000000000                                                036
       FAD     =O233000000000                                                037
CHOP   END                                                                   038
       SPACE   5                                                             039
SPLIT  MACRO   NINES                                                         040
       TRA     *+4                                                           041
       HTR     *-*                                                           042
       HTR     *-*                                                           043
       HTR     *-*                                                           044
       STO     *-1                                                           045
       SSP                                                                   046
       UFA     =O233000000000                                                047
       STQ     *-5                                                           048
       FAD     =O233000000000                                                049
       STO     *-8                                                           050
       CLA     *-8                                                           051
       FAD     =O233000000000                                                052
       STO     *-10                                                          053
       FSM     NINES                                                         054
       TMI     *+6                                                           055
       CLA     =0.0                                                          056
       STO     *-14                                                          057
       CLA     *-16                                                          058
       FAD     =1.00                                                         059
       STO     *-18                                                          060
       CLA     *-17                                                          061
       TPL     *+7                                                           062
       CLA     *-20                                                          063
       SSM                                                                   064
       STO     *-22                                                          065
       CLA     *-24                                                          066
       SSM                                                                   067
       STO     *-26                                                          068
       LDQ     *-26                                                          069
       CLA     *-28                                                          070
SPLIT  END                                                                   071
       SPACE   5                                                             072
RADIAN SPLIT   =.599999                                                      073
       STO     D                                                             074
       FMP     =100.0                                                        075
       SPLIT   =.5999                                                        076
       STO     M                                                             077
       STQ     X                                                             078
       CLA     M                                                             079
       FDP     =60.00                                                        080
       STQ     M                                                             081
       CLA     X                                                             082
       FDP     =36.00                                                        083
       XCA                                                                   084
       FAD     M                                                             085
       FRN                                                                   086
       FAD     D                                                             087
       FRN                                                                   088
       XCA                                                                   089
       FMP     =1.7453293E-2                                                 090
       FRN                                                                   091
       TRA     1,4                                                           092
       SPACE   5                                                             093
TIME   FDP     =15.00                                                        094
       TRA     *+2                                                           095
       SPACE   5                                                             096
DEGREE XCA                                                                   097
       FMP     =57.295780                                                    098
       STO     X                                                             099
       CHOP                                                                  100
       STO     D                                                             101
       CHS                                                                   102
       FAD     X                                                             103
       FRN                                                                   104
       XCA                                                                   105
       FMP     =60.00                                                        106
       FRN                                                                   107
       STO     X                                                             108
       CHOP                                                                  109
       STO     M                                                             110
       CHS                                                                   111
       FAD     X                                                             112
       FRN                                                                   113
       XCA                                                                   114
       FMP     =.0060                                                        115
       FRN                                                                   116
       STO     TEMP                                                          117
       CLA     M                                                             118
       FDP     =100.0                                                        119
       XCA                                                                   120
       FAD     TEMP                                                          121
       FRN                                                                   122
       FAD     D                                                             123
       FRN                                                                   124
       TRA     1,4                                                           125
