      SUBROUTINE INVERT (A,N,IND,MLTPY,X,Y)                             F1CM0001
I     DIMENSION A(20,41),X(20),Y(20)                                    F1CM0002
      K=2*N+1                                                           F1CM0003
      IND=0                                                             F1CM0004
      L=N+1                                                             F1CM0005
      DO 1 I=1,N                                                        F1CM0006
      DO 1 J=L,K                                                        F1CM0007
I   1 A(I,J)=(0.,0.)                                                    F1CM0008
      J=1                                                               F1CM0009
   18 I=1                                                               F1CM0010
      NN=0                                                              F1CM0011
    4 IF(A(I,J))2,103,2                                                 F1CM0012
  103 JJ=J+41                                                           F1CM0013
      IF(A(I,JJ))2,3,2                                                  F1CM0014
    2 IF(A(I,2*N+1))3,5,3                                               F1CM0015
    3 IF(I-N)8,7,8                                                      F1CM0016
    7 I=0                                                               F1CM0017
    8 I=I+1                                                             F1CM0018
      NN=NN+1                                                           F1CM0019
      IF(N-NN)50,50,4                                                   F1CM0020
   50 IND=1                                                             F1CM0021
      RETURN                                                            F1CM0022
    5 A(I,2*N+1)=J                                                      F1CM0023
      K=N+J                                                             F1CM0024
I     A(I,K)=(1.,0.)                                                    F1CM0025
I     PIVOT=A(I,J)                                                      F1CM0026
      DO 6 M=J,K                                                        F1CM0027
I   6 A(I,M)=A(I,M)/PIVOT                                               F1CM0028
      DO 15 L=1,N                                                       F1CM0029
      IF(I-L)10,10,11                                                   F1CM0030
   10 KK=L+1                                                            F1CM0031
      IF(N-KK)12,13,13                                                  F1CM0032
I  13 PIVOT=A(KK,J)                                                     F1CM0033
      DO40 M=J,K                                                        F1CM0034
I  40 A(KK,M)=A(KK,M)-PIVOT*A(I,M)                                      F1CM0035
      GO TO 15                                                          F1CM0036
I  11 PIVOT=A(L,J)                                                      F1CM0037
      DO41 M=J,K                                                        F1CM0038
I  41 A(L,M)=A(L,M)-PIVOT*A(I,M)                                        F1CM0039
   15 CONTINUE                                                          F1CM0040
   12 IF(N-J)16,16,17                                                   F1CM0041
   17 J=J+1                                                             F1CM0042
      GO TO 18                                                          F1CM0043
   16 DO 20 I=1,N                                                       F1CM0044
      J=A(I,2*N+1)                                                      F1CM0045
      DO 20 K=1,N                                                       F1CM0046
      L=K+N                                                             F1CM0047
I  20 A(J,K)=A(I,L)                                                     F1CM0048
      DO 21 I=1,N                                                       F1CM0049
      J=A(I,2*N+1)                                                      F1CM0050
      DO 21 K=1,N                                                       F1CM0051
      L=I+N                                                             F1CM0052
I  21 A(K,L)=A(K,J)                                                     F1CM0053
      DO22 I=1,N                                                        F1CM0054
      DO22 J=1,N                                                        F1CM0055
      L=J+N                                                             F1CM0056
I  22 A(I,J)=A(I,L)                                                     F1CM0057
      IF(MLTPY) 201,202,201                                             F1CM0058
  202 RETURN                                                            F1CM0059
  201 DO 203 I=1,N                                                      F1CM0060
I     Y(I)=(0.,0.)                                                      F1CM0061
      DO203 J=1,N                                                       F1CM0062
I 203 Y(I)=A(I,J)*X(J)+Y(I)                                             F1CM0063
      RETURN                                                            F1CM0064
      END                                                               F1CM0065
