*           474 10152 EIGENVALUES OF REAL MATRICES                      EIG30001
C051/1 EIGENVALUES OF NON-SYMMETRIC MATRICES                            EIG30002
      SUBROUTINE EIG3(A,N,M,RTR,RTI)                                    EIG30003
      DIMENSION A(100,100),NC(100),RTR(100),RTI(100)                    EIG30004
      TRACE=A(1,1)                                                      EIG30005
      DO 10 I=2,N                                                       EIG30006
   10 TRACE=TRACE+A(I,I)                                                EIG30007
      WRITE OUTPUT TAPE 6,4,TRACE                                       EIG30008
      CALL TRING(A,1.E-7,N,NC)                                          EIG30009
      TRACE=A(1,1)                                                      EIG30010
      DO 11 I=2,N                                                       EIG30011
   11 TRACE=TRACE+A(I,I)                                                EIG30012
      WRITE OUTPUT TAPE 6,4,TRACE                                       EIG30013
      NU=0                                                              EIG30014
      NV=0                                                              EIG30015
   13 IF (NV-N)14,12,14                                                 EIG30016
   14 NV=NV+1                                                           EIG30017
      NU=NV                                                             EIG30018
   16 IF (NC(NV))15,17,15                                               EIG30019
   15 NV=NV+1                                                           EIG30020
      GO TO 16                                                          EIG30021
   17 IF (NV-NU)19,18,19                                                EIG30022
 18   RTR(NU)=A(NU,NU)                                                  EIG30023
      RTI(NU)=0.                                                        EIG30024
      WRITE OUTPUT TAPE 6,5,RTR(NU),RTI(NU)                             EIG30025
      GO TO 13                                                          EIG30026
   19 IF (NV-NU-1)20,21,20                                              EIG30027
 20   NP=XMIN0F(M,NV)                                                   EIG30028
      CALL LAGER(A,1.E-4,NP,NU,NV,RTR,RTI)                              EIG30029
      GO TO 13                                                          EIG30030
   21 RR=.5*(A(NU,NU)+A(NV,NV))                                         EIG30031
      E1=RR**2-A(NU,NU)*A(NV,NV)+A(NU,NV)*A(NV,NU)                      EIG30032
      S=SQRTF(ABSF(E1))                                                 EIG30033
      IF(E1)22,23,23                                                    EIG30034
 23   RTR(NU)=RR+S                                                      EIG30035
      RTI(NU)=0.                                                        EIG30036
      RTR(NV)=RR-S                                                      EIG30037
      RTI(NV)=0.                                                        EIG30038
 25   WRITE OUTPUT TAPE 6,5,RTR(NU),RTI(NU),RTR(NV),RTI(NV)             EIG30039
      GO TO 13                                                          EIG30040
 22   RTR(NU)=RR                                                        EIG30041
      RTI(NU)=S                                                         EIG30042
      RTR(NV)=RR                                                        EIG30043
      RTI(NV)=-S                                                        EIG30044
      GO TO 25                                                          EIG30045
 12   X=0.                                                              EIG30046
      CALL FPOLD                                                        EIG30047
      DO 24 J=1,M                                                       EIG30048
 24   X=X+RTR(J)                                                        EIG30049
      WRITE OUTPUT TAPE 6,6,X                                           EIG30050
      RETURN                                                            EIG30051
    4 FORMAT(1H048X,7HTRACE =E16.8)                                     EIG30052
    5 FORMAT (11H0EIGENVALUE 12X,2E20.8)                                EIG30053
 6    FORMAT(1H035X,20HSUM OF EIGENVALUES =E16.8)                       EIG30054
      END                                                               EIG30055
C051/2ALMOST TRIANGULAR (HESSENBERG) SUBROUTINE                         EIG30056
      SUBROUTINE TRING(A,EPS,N,INT)                                     EIG30057
      DIMENSION A(100,100),INT(100)                                     EIG30058
      WRITE OUTPUT TAPE 6,1                                             EIG30059
      N1=N-1                                                            EIG30060
      N2=N-2                                                            EIG30061
      DO 21 J=1,N1                                                      EIG30062
      S=ABSF(A(J,J+1))                                                  EIG30063
      J1=J+1                                                            EIG30064
      J2=J+2                                                            EIG30065
      L=J1                                                              EIG30066
      NJ1=N-J1                                                          EIG30067
      IF (NJ1) 15,15,6                                                  EIG30068
 6    DO 12 K=J2,N                                                      EIG30069
      T=ABSF(A(J,K))                                                    EIG30070
      IF(T-S)12,12,11                                                   EIG30071
 11   L=K                                                               EIG30072
      S=T                                                               EIG30073
 12   CONTINUE                                                          EIG30074
      IF(L-J1)13,15,13                                                  EIG30075
13    DO 131 K=1,N                                                      EIG30076
      T=A(K,J+1)                                                        EIG30077
      A(K,J+1)=A(K,L)                                                   EIG30078
131   A(K,L)=T                                                          EIG30079
14    DO 141 K=1,N                                                      EIG30080
      T=A(J+1,K)                                                        EIG30081
      A(J+1,K)=A(L,K)                                                   EIG30082
141   A(L,K)=T                                                          EIG30083
 15   IF(S-EPS*MIN1F(ABSF(A(J,J)),ABSF(A(J+1,J+1))))16,16,17            EIG30084
 16   L=0                                                               EIG30085
      NJ1=0                                                             EIG30086
      GO TO 181                                                         EIG30087
 17   T=A(J,J+1)                                                        EIG30088
      DO 18 K=J2,N                                                      EIG30089
 18   A(J,K)=A(J,K)/T                                                   EIG30090
 181  DO 20 I=1,N                                                       EIG30091
      M=MIN0F(J,I-2)                                                    EIG30092
      U=0.                                                              EIG30093
      IF (NJ1) 19,19,7                                                  EIG30094
7     DO 8 K=J2,N                                                       EIG30095
 8    U=U+A(K,I)*A(J,K)                                                 EIG30096
19    IF (M) 20,20,9                                                    EIG30097
 9    DO 10 K=1,M                                                       EIG30098
 10   U=U-A(K,I)*A(J+1,K+1)                                             EIG30099
 20   A(J+1,I)=A(J+1,I)+U                                               EIG30100
 21   INT(J)=L                                                          EIG30101
 22   INT(N)=0                                                          EIG30102
      RETURN                                                            EIG30103
 1    FORMAT(1H048X,22HALMOST TRIANGULAR FORM)                          EIG30104
      END                                                               EIG30105
C051/3LAGUERRE METHOD                                                   EIG30106
      SUBROUTINE LAGER(A,EPS,N1,NU,N,RTR,RTI)                           EIG30107
      DIMENSION A(100,100),P(6,101),RTR(100),RTI(100),B(6)              EIG30108
      WRITE OUTPUT TAPE 6,1                                             EIG30109
      ONCE=0.                                                           EIG30110
      BL1=1.                                                            EIG30111
      NUQ=NU-1                                                          EIG30112
      LLY=0                                                             EIG30113
      DELOLD=1.                                                         EIG30114
      ROLD=1.                                                           EIG30115
      EGSUM1=0.                                                         EIG30116
      EGSUM2=0.                                                         EIG30117
      CALL FPTEST(Z)                                                    EIG30118
      DO 10 L=2,6                                                       EIG30119
 10   P(L,NU)=0.                                                        EIG30120
      NU1=NU+1                                                          EIG30121
      CUP=0.                                                            EIG30122
      DO 11 J=NU1,N                                                     EIG30123
 11   CUP=CUP+ABSF(A(J-1,J))                                            EIG30124
      CUP=CUP/FLOATF(N-NU)                                              EIG30125
      CAP=0.                                                            EIG30126
      P(1,NU)=1.                                                        EIG30127
C                                                                       EIG30128
C     FIND TRACE OF H AND H SQUARED                                     EIG30129
C                                                                       EIG30130
      SPUR1=A(NU,NU)                                                    EIG30131
      SPUR2=A(NU,NU)**2                                                 EIG30132
      DO 13 J=NU1,N                                                     EIG30133
      SPUR1=SPUR1+A(J,J)                                                EIG30134
   13 SPUR2=SPUR2+A(J,J)**2+2.*A(J-1,J)*A(J,J-1)                        EIG30135
C                                                                       EIG30136
C     INITIAL ITERATE FROM INFINITY                                     EIG30137
C                                                                       EIG30138
   14 S1R=EGSUM1-SPUR1                                                  EIG30139
      S2R=SPUR2-EGSUM2                                                  EIG30140
      F1=N-NUQ                                                          EIG30141
      IF(ABSF(S1R)+ABSF(S2R)-1.E-7*CAP)15,15,16                         EIG30142
   15 XBAR=CUP                                                          EIG30143
      YBAR=0.                                                           EIG30144
      GO TO 23                                                          EIG30145
 16   F2=F1-1.                                                          EIG30146
      DR=F2*(F1*S2R-S1R**2)                                             EIG30147
      ER=SQRTF(ABSF(DR))                                                EIG30148
      IF(DR)17,18,18                                                    EIG30149
   17 XBAR=-2.*S1R/F1                                                   EIG30150
      YBAR=2.*ER/F1                                                     EIG30151
      GO TO 23                                                          EIG30152
   18 YBAR=0.                                                           EIG30153
      F2=SIGNF(1.,S1R)                                                  EIG30154
      IF(S1R)22,20,22                                                   EIG30155
   20 F2=0.                                                             EIG30156
   22 XBAR=-(S1R+F2*ER)/F1                                              EIG30157
C                                                                       EIG30158
C     EVALUATE POLYNOMIAL AND DERIVATIVES                               EIG30159
C                                                                       EIG30160
   23 IF(ABSF(YBAR)-ABSF(XBAR)*1.E-6)24,25,25                           EIG30161
   24 YBAR=0.                                                           EIG30162
   25 M=6                                                               EIG30163
      IF(YBAR)27,26,27                                                  EIG30164
   26 M=3                                                               EIG30165
 27   DO 34 K=NU,N                                                      EIG30166
      T=-A(K,K+1)                                                       EIG30167
      DO 34 L=1,M                                                       EIG30168
      S=SIGNF(1.,3.5-FLOATF(L))                                         EIG30169
      M1=L+3*XFIXF(S)                                                   EIG30170
      R=-XBAR*P(L,K)+YBAR*S*P(M1,K)-FLOATF(XMODF(L-1,3))*P(L-1,K)       EIG30171
      DO 28 J=NU,K                                                      EIG30172
 28   R=R+P(L,J)*A(K,J)                                                 EIG30173
      IF(Z)29,32,29                                                     EIG30174
 29   Z=0.                                                              EIG30175
      P(1,NU)=1.E-10*P(1,NU)                                            EIG30176
      IF(P(1,NU))30,30,27                                               EIG30177
 30   F=FLOATF(K-NU)/FLOATF(N-NU+1)                                     EIG30178
      WRITE OUTPUT TAPE 6,2,XBAR,YBAR,P(1,NU),F,ONCE                    EIG30179
      XBAR=XBAR*F                                                       EIG30180
      YBAR=YBAR*F                                                       EIG30181
      P(1,NU)=1.0                                                       EIG30182
      GO TO 27                                                          EIG30183
 32   IF(N-K)33,33,34                                                   EIG30184
 33   T=1.0                                                             EIG30185
 34   P(L,K+1)=R/T                                                      EIG30186
C                                                                       EIG30187
C     SCALE DOWN                                                        EIG30188
C                                                                       EIG30189
      DO 39 K=1,6                                                       EIG30190
   39 B(K)=0.                                                           EIG30191
      DO 35 J=1,M                                                       EIG30192
   35 B(J)=P(J,N+1)                                                     EIG30193
      G1=ABSF(B(1))+ABSF(B(4))                                          EIG30194
      G2=ABSF(B(2))+ABSF(B(5))                                          EIG30195
      G3=ABSF(B(3))+ABSF(B(6))                                          EIG30196
      WRITE OUTPUT TAPE 6,2,XBAR,YBAR,G1,G2,G3                          EIG30197
 2    FORMAT(8H ITERATE20X,E15.8,5X,E15.8,8X,3E15.4)                    EIG30198
      D=ABSF(B(1))                                                      EIG30199
      DO 36 K=2,M                                                       EIG30200
   36 D=MAX1F(D,ABSF(B(K)))                                             EIG30201
      CALL SCALE(D,B,M)                                                 EIG30202
      IF (G1) 41,41,43                                                  EIG30203
C                                                                       EIG30204
C     REMOVE KNOWN ROOTS                                                EIG30205
C                                                                       EIG30206
   43 Q1R=0.                                                            EIG30207
      Q1I=0.                                                            EIG30208
      Q2R=0.                                                            EIG30209
      Q2I=0.                                                            EIG30210
      IF(NUQ-NU)19,21,21                                                EIG30211
   21 DO 44 J=NU,NUQ                                                    EIG30212
      D1=RTR(J)-XBAR                                                    EIG30213
      D2=RTI(J)-YBAR                                                    EIG30214
      D=D1**2+D2**2                                                     EIG30215
      D1=D1/D                                                           EIG30216
      D2=-D2/D                                                          EIG30217
      Q1R=Q1R+D1                                                        EIG30218
      Q1I=Q1I+D2                                                        EIG30219
      Q2R=Q2R+D1**2-D2**2                                               EIG30220
   44 Q2I=Q2I+2.*D1*D2                                                  EIG30221
C                                                                       EIG30222
C     FIND S1 AND S2                                                    EIG30223
C                                                                       EIG30224
   19 T1R=B(2)/B(1)                                                     EIG30225
      T1I=0.                                                            EIG30226
      T2R=B(3)/B(2)                                                     EIG30227
      T2I=0.                                                            EIG30228
      IF(YBAR)45,46,45                                                  EIG30229
   45 D1=B(1)**2+B(4)**2                                                EIG30230
      D2=B(2)**2+B(5)**2                                                EIG30231
      T1R=(B(2)*B(1)+B(5)*B(4))/D1                                      EIG30232
      T1I=(B(5)*B(1)-B(4)*B(2))/D1                                      EIG30233
      T2R=(B(3)*B(2)+B(6)*B(5))/D2                                      EIG30234
      T2I=(B(6)*B(2)-B(5)*B(3))/D2                                      EIG30235
   46 S1R=T1R+Q1R                                                       EIG30236
      S1I=T1I+Q1I                                                       EIG30237
      S2R=T1R*(T1R-T2R)-T1I*(T1I-T2I)-Q2R                               EIG30238
      S2I=T1R*(T1I-T2I)+T1I*(T1R-T2R)-Q2I                               EIG30239
C                                                                       EIG30240
C     FIND THE NEXT ITERATE                                             EIG30241
C                                                                       EIG30242
      LLY=LLY+1                                                         EIG30243
      D=ABSF(XBAR)+ABSF(YBAR)                                           EIG30244
      IF(1.E+7-D*(ABSF(S1R)+ABSF(S1I))) 41,41,42                        EIG30245
   41 MARK=1                                                            EIG30246
      GO TO 100                                                         EIG30247
   42 G=N-NUQ                                                           EIG30248
   48 IF(YBAR-ABSF(X))50,50,49                                          EIG30249
   49 S1I=S1I+1./(2.*YBAR)                                              EIG30250
      S2R=S2R+1./(4.*YBAR**2)                                           EIG30251
      G=G-1.                                                            EIG30252
 50   IF(BL1)65,65,66                                                   EIG30253
 65   H=.5*(G-2.)                                                       EIG30254
      GO TO 67                                                          EIG30255
 66   H=G-1.                                                            EIG30256
 67   DR=H*(G*S2R-S1R**2+S1I**2)                                        EIG30257
      DI=H*(G*S2I-2.*S1R*S1I)                                           EIG30258
      IF(DI)53,51,53                                                    EIG30259
   51 EI=0.                                                             EIG30260
      ER=SQRTF(ABSF(DR))                                                EIG30261
      IF(DR)52,54,54                                                    EIG30262
   52 EI=ER                                                             EIG30263
      ER=0.                                                             EIG30264
      GO TO 54                                                          EIG30265
   53 CALL CXSQRT(DR,DI,ER,EI)                                          EIG30266
   54 IF(S1R*ER+S1I*EI)55,56,56                                         EIG30267
   55 ER=-ER                                                            EIG30268
      EI=-EI                                                            EIG30269
   56 D1=S1R+ER                                                         EIG30270
      D2=S1I+EI                                                         EIG30271
      D=D1**2+D2**2                                                     EIG30272
      X=-G*D1/D                                                         EIG30273
      XBAR=XBAR+X                                                       EIG30274
      Y=G*D2/D                                                          EIG30275
      YBAR=YBAR+Y                                                       EIG30276
      DELNEW=ABSF(X)+ABSF(Y)                                            EIG30277
      RNEW=DELNEW/DELOLD                                                EIG30278
      D=ABSF(XBAR)+ABSF(YBAR)                                           EIG30279
C                                                                       EIG30280
C     TEST FOR LINEAR CONVERGENCE                                       EIG30281
C                                                                       EIG30282
      IF(LLY-3)62,62,57                                                 EIG30283
 57   IF (DELNEW-MAX1F(3.*DELOLD,.5*D))571,571,570                      EIG30284
 570  IF (BL1) 571,571,572                                              EIG30285
 572  DELOLD=CAP                                                        EIG30286
      ROLD=3.                                                           EIG30287
      IF (LLY-15) 14,14,100                                             EIG30288
 571  IF(RNEW-.7*ROLD) 62,58,58                                         EIG30289
   58 MARK=3                                                            EIG30290
      IF(DELNEW-.001*EPS*CAP) 70,59,59                                  EIG30291
 59   IF(BL1)61,61,60                                                   EIG30292
 60   XBAR=XBAR-X                                                       EIG30293
      YBAR=YBAR-Y                                                       EIG30294
      BL1=0.                                                            EIG30295
      GO TO 48                                                          EIG30296
 61   BL1=1.                                                            EIG30297
      GO TO 63                                                          EIG30298
C                                                                       EIG30299
C     TEST FOR AN EIGENVALUE                                            EIG30300
C                                                                       EIG30301
   62 IF(DELNEW-EPS*MAX1F(D,.001*CAP))64,64,63                          EIG30302
 63   DELOLD=DELNEW                                                     EIG30303
      ROLD=RNEW                                                         EIG30304
      IF (LLY-15) 23,23,100                                             EIG30305
C                                                                       EIG30306
C     DO WE HAVE A COMPLEX APPROACH TO A REAL ROOT                      EIG30307
C                                                                       EIG30308
   64 MARK=2                                                            EIG30309
   70 BL1=1                                                             EIG30310
      IF(YBAR)71,100,71                                                 EIG30311
   71 IF(G2*ABSF(YBAR)-G1)72,100,100                                    EIG30312
   72 IF(ONCE)73,73,100                                                 EIG30313
   73 X=0.                                                              EIG30314
      ONCE=1.                                                           EIG30315
      YBAR=0.                                                           EIG30316
      GO TO 63                                                          EIG30317
C                                                                       EIG30318
C     WE ACCEPT (XBAR,YBAR) AS A ROOT                                   EIG30319
C                                                                       EIG30320
  100 NUQ=NUQ+1                                                         EIG30321
      RTR(NUQ)=XBAR                                                     EIG30322
      IF(ABSF(YBAR)-.001*ABSF(XBAR))74,74,75                            EIG30323
   74 YBAR=0.                                                           EIG30324
   75 IF(NUQ-NU) 9,76, 9                                                EIG30325
    9 IF(RTI(NUQ-1))76,76,77                                            EIG30326
   76 YBAR=ABSF(YBAR)                                                   EIG30327
      RTI(NUQ)=YBAR                                                     EIG30328
      GO TO 78                                                          EIG30329
   77 RTI(NUQ)=-ABSF(YBAR)                                              EIG30330
   78 WRITE OUTPUT TAPE 6,3,RTR(NUQ),RTI(NUQ),LLY,MARK                  EIG30331
    3 FORMAT(11H0EIGENVALUE12X,2E20.8,12X,I3,17H ITERATIONS,TEST I1//)  EIG30332
      LLY=0                                                             EIG30333
      CAP=MAX1F(D,CAP)                                                  EIG30334
      DELOLD=1.                                                         EIG30335
      ROLD=1.                                                           EIG30336
      EGSUM1=EGSUM1+RTR(NUQ)                                            EIG30337
      EGSUM2=EGSUM2+RTR(NUQ)**2-RTI(NUQ)**2                             EIG30338
      IF(NUQ-N1)80,101,101                                              EIG30339
   80 IF(YBAR)83,84,81                                                  EIG30340
   81 YBAR=-YBAR                                                        EIG30341
      GO TO 23                                                          EIG30342
   83 IF(NUQ-NU)31,84,31                                                EIG30343
   31 RTI(NUQ-1)=.5*(RTI(NUQ-1)-RTI(NUQ))                               EIG30344
      RTI(NUQ)=-RTI(NUQ-1)                                              EIG30345
C                                                                       EIG30346
C     A NEWTON ITERATE TOWARDS NEXT ROOT                                EIG30347
C                                                                       EIG30348
   84 ONCE=0.                                                           EIG30349
      Z=0.                                                              EIG30350
      IF((ABSF(Q1R)+ABSF(Q1I))*D-10000.)85,85,14                        EIG30351
 85   IF(ABSF(EGSUM1-SPUR1)+ABSF(EGSUM2-SPUR2)-1.E-5*CAP)15,15,86       EIG30352
   86 DR=B(3)+2.*(B(2)*Q1R-B(5)*Q1I)                                    EIG30353
      DI=B(6)+2.*(B(2)*Q1I+B(5)*Q1R)                                    EIG30354
      D2=DR**2+DI**2                                                    EIG30355
      XBAR=XBAR-2.*(DR*B(2)+DI*B(5))/D2                                 EIG30356
      YBAR=ABSF(YBAR-2.*(DR*B(5)-DI*B(2))/D2)                           EIG30357
      GO TO 23                                                          EIG30358
  101 RETURN                                                            EIG30359
    1 FORMAT(1H050X,19HLAGUERRE ITERATIONS/31X,9HREAL PART10X,10HIMAG. PEIG30360
     1ART22X,1HP11X,7HP PRIME6X,11HP DBL PRIME)                         EIG30361
      END                                                               EIG30362
C051/5COMPLEX SQUARE ROOT                                               EIG30363
      SUBROUTINE CXSQRT(A,B,X,Y)                                        EIG30364
      F=MAX1F(ABSF(A),ABSF(B))                                          EIG30365
      F=F*SQRTF((A/F)**2+(B/F)**2)                                      EIG30366
      IF(A)1,1,2                                                        EIG30367
    1 Y=SQRTF((F-A)*.5)                                                 EIG30368
      X=.5*B/Y                                                          EIG30369
      IF(X)4,3,3                                                        EIG30370
    4 X=-X                                                              EIG30371
      Y=-Y                                                              EIG30372
      GO TO 3                                                           EIG30373
    2 X=SQRTF((F+A)*.5)                                                 EIG30374
      Y=.5*B/X                                                          EIG30375
    3 RETURN                                                            EIG30376
      END                                                               EIG30377
*     FAP                                                               EIG30378
       COUNT   30                                                       EIG30379
*051/6         SUBROUTINE SCALE                                         EIG30380
       ENTRY   SCALE                                                    EIG30381
SCALE  SXA     AD,1          SUBROUTINE SCALE(D,B,M)                    EIG30382
       CLA     1,4                                                      EIG30383
       STA     *+1                                                      EIG30384
       CAL     **                                                       EIG30385
       ANA     MASK                                                     EIG30386
       SUB     TG                                                       EIG30387
       STO     TE                                                       EIG30388
       CLA     2,4                                                      EIG30389
       ADD     TF                                                       EIG30390
       STA     AA                                                       EIG30391
       STA     AB                                                       EIG30392
       CLA     3,4                                                      EIG30393
       STA     *+1                                                      EIG30394
       CLA     **                                                       EIG30395
       STD     AC                                                       EIG30396
       LXA     TF,1                                                     EIG30397
AA     CAL     **,1                                                     EIG30398
       SUB     TE                                                       EIG30399
       TPL     *+2                                                      EIG30400
       CLA     TH                                                       EIG30401
AB     SLW     **,1                                                     EIG30402
       TXI     *+1,1,1                                                  EIG30403
AC     TXL     AA,1                                                     EIG30404
AD     AXT     **,1                                                     EIG30405
       TRA     4,4                                                      EIG30406
MASK   OCT     377000000000                                             EIG30407
TE     OCT                                                              EIG30408
TF     OCT     000000000001                                             EIG30409
TG     OCT     200000000000                                             EIG30410
TH     OCT     000000000000                                             EIG30411
       END                                                              EIG30412
*NUFPT    NU VERSION OF FPT.  VERSION 2  MAY 1962.  HAS ALTERNATE ENTRIEEIG30413
*     FAP                                                               EIG30414
       PCC                                                              EIG30415
       COUNT   60                                                       EIG30416
       LBL     NUFPT,9                                                  EIG30417
       ENTRY   FPTEST                                                   EIG30418
       ENTRY   FPOLD                                                    EIG30419
       ENTRY   (FPT)                                                    EIG30420
FPTEST CLA     8                                                        EIG30421
       STO     NEW+1                   SAVE L(8)                        EIG30422
       STZ     OVFLOW                  CLEAR 77462                      EIG30423
       CLA     1,4                                                      EIG30424
       STA     NEW+2                   L(CONTENTS OF L(0))              EIG30425
       CLA     NEW                     L(TTR,(FPT))                     EIG30426
       STO     8                       MUST USE THIS (FPT)              EIG30427
       CLA     NEW+2                   L(STI,**)                        EIG30428
       STO     ERROR+1                 MODIFY(FPT) SO EXEM              EIG30429
       CLA     NEW+3                   DOES NOT ACT                     EIG30430
       STO     ERROR+2                                                  EIG30431
       TTR     2,4                                                      EIG30432
 (FPT) STI     IND           SAVE INDICATORS.                           EIG30433
       LDI     0             EXAMINE BITS 14-17 OF LOC ZERO             EIG30434
       LFT     4             SKIP IF NON'OVERFLOW (BIT 15)              EIG30435
       TTR     ERROR         (IN FPT + 3) OVERFLOW AC OR MQ             EIG30436
       LFT     2             SKIP IF ACC NOT INVOLVED                   EIG30437
       CLM                                                              EIG30438
       LNT     6             SKIP AND COMPLEMENT                        EIG30439
       COM                   ONCE ON ACC UNDRFLOW                       EIG30440
       COM                                                              EIG30441
       XCA                   GET MQ                                     EIG30442
       LFT     1             SKIP IF N= MQ NOT INVOLVED                 EIG30443
       CLM                                                              EIG30444
       LNT     5             COMPLEMEMT ONCE ON                         EIG30445
       COM                   MQ UNDERFLOW                               EIG30446
       COM                                                              EIG30447
       XCA                   RESTORE MQ AND ACC                         EIG30448
       LDI     IND           RESTORE INDICATORS.                        EIG30449
 EXIT  TTR*    0                                                        EIG30450
 ERROR STI     OVFLOW        77462                                      EIG30451
       LDI     *+2                                                      EIG30452
       TTR     $(EXE)                                                   EIG30453
       PZE     7,4,*+1                                                  EIG30454
       LDI     OVFLOW        RETURN FROM EXE IF NOT IN MONITOR MODE     EIG30455
       TTR     (FPT)+4                                                  EIG30456
 NEW   TTR     (FPT)                   CONSTANT                         EIG30457
       TTR     (FPT)                   SAVE ORIGINAL L(8) HERE          EIG30458
       STI     **                      CONSTANT-STA OF VARIABLE HERE    EIG30459
       TTR     ERROR+4                 CONST                            EIG30460
       LDI     ERROR+3                 CONST                            EIG30461
       TTR     $(EXE)                                                   EIG30462
 FPOLD CLA     NEW+4                   RESTORE EXEM AFFECT              EIG30463
       STO     ERROR+1                                                  EIG30464
       CLA     NEW+5                                                    EIG30465
       STO     ERROR+2                                                  EIG30466
       CLA     NEW+1                   RESTORE L(8)                     EIG30467
 SET   STO     8                                                        EIG30468
       STZ     OVFLOW                  CLEAR 77462                      EIG30469
       TRA     1,4                                                      EIG30470
       COMMON  -2                                                       EIG30471
 IND   COMMON  1                       77463                            EIG30472
OVFLOW COMMON  1                                                        EIG30473
       END                                                              EIG30474
