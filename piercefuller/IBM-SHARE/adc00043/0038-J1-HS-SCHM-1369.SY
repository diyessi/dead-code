*SCHM  WRITE CARD IMAGES ON TAPE 7 (SYSPP1) WHEN PUNCHING IS DEMANDED   SCHM0000
*     PACK                                                              SCHM0010
*     FAP                                                               SCHM0020
*SCHM  WRITE CARD IMAGES ON TAPE 7 (SYSPP1) WHEN PUNCHING IS DEMANDED   SCHM0030
       TTL   DURING EXECUTION OF 709/7090 FORTRAN II OBJECT PROGRAM     SCHM0040
       LBL     SCHM,X                                                   SCHM0050
       COUNT   120                                                      SCHM0060
*      THE TAPE IS WRITTEN IN THE BINARY MODE                           SCHM0070
*                                                                       SCHM0080
       ENTRY   (SCH)                                                    SCHM0090
 (SCH) LDQ     *+4                                                      SCHM0100
       CLA     *+2                                                      SCHM0110
       TRA*    $(IOH)                                                   SCHM0120
       PZE     16,,7          TO WRITE TAPE 7 IN BINARY                 SCHM0130
       TRA     *+1                                                      SCHM0140
       SXA     X4,4                                                     SCHM0150
       SXA     X1,1                                                     SCHM0160
       SXA     X2,2                                                     SCHM0170
       XEC*    $(TES)                                                   SCHM0180
       LXA     X4,4                                                     SCHM0190
       CLA     1,4                                                      SCHM0200
       PDX     ,2                GET WORD COUNT                         SCHM0210
       TXL     *+2,2,14          TRUNCATE IF NECESSARY                  SCHM0220
       AXT     14,2                                                     SCHM0230
       PXD     ,2                                                       SCHM0240
       ALS     1                                                        SCHM0250
       STD     CHN                                                      SCHM0260
       PXA     ,2                WORD COUNT                             SCHM0270
       ADM     1,4               PLUS RECORD ADDRESS                    SCHM0280
       STA     A3                                                       SCHM0290
       AXT     0,4               CONVERT BCD TO COLUMN BINARY IMAGE     SCHM0300
 A3    LDQ     **,2                                                     SCHM0310
       AXT     6,1                                                      SCHM0320
 PXD   PXD     ,0                                                       SCHM0330
       CAQ     TABLE,,1                                                 SCHM0340
       TNX     *+3,1,2                                                  SCHM0350
       ALS     12                                                       SCHM0360
       TRA     *-3                                                      SCHM0370
       SLW     I,4                                                      SCHM0380
       TXI     *+1,4,-1                                                 SCHM0390
       TNX     *+2,1,1                                                  SCHM0400
       TXI     PXD,1,4                                                  SCHM0410
       TIX     A3,2,1                                                   SCHM0420
       CAL     TES                                                      SCHM0430
       SLW*    $(TES)                                                   SCHM0440
       XEC*    $(WRS)                                                   SCHM0450
       AXC     CHN,4                                                    SCHM0460
       PXA     ,4                                                       SCHM0470
       STA*    $(WTC)                                                   SCHM0480
       XEC*    $(RCH)                                                   SCHM0490
 X1    AXT     **,1                                                     SCHM0500
 X2    AXT     **,2                                                     SCHM0510
 X4    AXT     **,4                                                     SCHM0520
       TRA     2,4               RETURN TO (IOH)                        SCHM0530
 TES   TSX     $(WER),4                                                 SCHM0540
 TABLE BSS     0                                                        SCHM0550
       OCT     1000                                                     SCHM0560
       OCT     400                                                      SCHM0570
       OCT     200                                                      SCHM0580
       OCT     100                                                      SCHM0590
       OCT     40                                                       SCHM0600
       OCT     20                                                       SCHM0610
       OCT     10                                                       SCHM0620
       OCT     4                                                        SCHM0630
       OCT     2                                                        SCHM0640
       OCT     1                                                        SCHM0650
       OCT     1000              TREAT OCTAL 12 AS ZERO                 SCHM0660
       OCT     102                                                      SCHM0670
       OCT     42                                                       SCHM0680
       OCT     22,12,6           SPECIAL CHARACTERS 8-5,8-6,8-7         SCHM0690
       REM               CHARACTERS WITH 12-ZONE                        SCHM0700
       OCT     4000                                                     SCHM0710
       OCT     4400                                                     SCHM0720
       OCT     4200                                                     SCHM0730
       OCT     4100                                                     SCHM0740
       OCT     4040                                                     SCHM0750
       OCT     4020                                                     SCHM0760
       OCT     4010                                                     SCHM0770
       OCT     4004                                                     SCHM0780
       OCT     4002                                                     SCHM0790
       OCT     4001                                                     SCHM0800
       OCT     5000                                                     SCHM0810
       OCT     4102                                                     SCHM0820
       OCT     4042                                                     SCHM0830
       OCT     4022,4012,4006                                           SCHM0840
       REM               CHARACTERS WITH 11-ZONE                        SCHM0850
       OCT     2000                                                     SCHM0860
       OCT     2400                                                     SCHM0870
       OCT     2200                                                     SCHM0880
       OCT     2100                                                     SCHM0890
       OCT     2040                                                     SCHM0900
       OCT     2020                                                     SCHM0910
       OCT     2010                                                     SCHM0920
       OCT     2004                                                     SCHM0930
       OCT     2002                                                     SCHM0940
       OCT     2001                                                     SCHM0950
       OCT     3000                                                     SCHM0960
       OCT     2102                                                     SCHM0970
       OCT     2042                                                     SCHM0980
       OCT     2022,2012,2006                                           SCHM0990
       OCT     0                                                        SCHM1000
       OCT     1400                                                     SCHM1010
       OCT     1200                                                     SCHM1020
       OCT     1100                                                     SCHM1030
       OCT     1040                                                     SCHM1040
       OCT     1020                                                     SCHM1050
       OCT     1010                                                     SCHM1060
       OCT     1004                                                     SCHM1070
       OCT     1002                                                     SCHM1080
       OCT     1001                                                     SCHM1090
       OCT     1202                                                     SCHM1100
       OCT     1102                                                     SCHM1110
       OCT     1042                                                     SCHM1120
       OCT     1022,1012,1006                                           SCHM1130
       REM               END OF CONVERT TABLE                           SCHM1140
 CHN   IOST    I,,**                                                    SCHM1150
 I     BSS     28                OUTPUT IMAGE BUFFER                    SCHM1160
       END                                                              SCHM1170
