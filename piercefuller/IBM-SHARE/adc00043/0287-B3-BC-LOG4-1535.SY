*     LABEL                                                                     
*     FAP                                                               BCLOG001
*LOG                                                                            
       COUNT   90                                                       BCLOG002
*      B3 BC LOG4   7090 FLOATING POINT LOG ROUTINE                     BCLOG003
*      MODIFICATION OF SHARE B3 IB LOG3 REVISED FOR BC 7090             BCLOG004
       ENTRY   LOG                                                      BCLOG005
       ENTRY   ALOG                                                     BCLOG006
       ENTRY   LOG10                                                    BCLOG007
       ENTRY   ALOG10                                                   BCLOG008
       ENTRY   TENLOG                                                   BCLOG009
 LOG10 SYN     *              LOG10F ENTRY                              BCLOG011
TENLOG SYN     *              TENLOGF ENTRY                             BCLOG012
       LDQ     XCA                                                      BCLOG013
       TXI     ALOG+2,4,1                                               BCLOG014
 LOG   SYN     *              LOGF ENTRY                                BCLOG015
       LDQ     TRA24                                                    BCLOG016
       TXI     ALOG+2,4,1                                               BCLOG017
ALOG10 SYN     *              ALOG10 ENTRY                              BCLOG018
       LDQ     XCA                                                      BCLOG019
       TRA     ALOG+1                                                   BCLOG020
ALOG   SYN     *              ALOG ENTRY                                BCLOG021
       LDQ     TRA24                                                    BCLOG022
       CLA*    1,4                                                      BCLOG023
       STQ     INSERT                                                   BCLOG024
       TMI     ERROR                                                    BCLOG025
 CONT  XCA                                                              BCLOG026
       ZAC                                                              BCLOG027
       LLS     8                                                        BCLOG028
       ALS     1                                                        BCLOG029
       SUB     =O401                                                    BCLOG030
       ORA     =154B8                                                   BCLOG031
       STO     COM                                                      BCLOG032
       ZAC                                                              BCLOG033
       XCA                                                              BCLOG034
       TZE     ERROR                                                    BCLOG035
       ARS     1                                                        BCLOG036
       ADD     =.707106781187B1                                         BCLOG037
       STO     COM+1                                                    BCLOG038
       SUB     =.707106781187B0                                         BCLOG039
       VDH     COM+1,0,29                                               BCLOG040
       STQ     COM+1                                                    BCLOG041
       VLM     COM+1,0,28                                               BCLOG042
       STO     COM+2                                                    BCLOG043
       LDQ     =O31                                                     BCLOG044
       VLM     COM+2,0,6                                                BCLOG045
       SUB     =.25963855429B4                                          BCLOG046
       SLW     COM+2                                                    BCLOG047
       CLS     =-.26455155161B5                                         BCLOG048
       VDH     COM+2,0,32                                               BCLOG049
       XCA                                                              BCLOG050
       SUB     COM+2                                                    BCLOG051
       ADD     =2.126106178B4                                           BCLOG052
       XCA                                                              BCLOG053
       LRS     7                                                        BCLOG054
       VLM     COM+1,0,26                                               BCLOG055
       ORA     =128B8                                                   BCLOG056
       FAD     =128B8                                                   BCLOG057
       FAD     COM                                                      BCLOG058
 XCA   XCA                                                              BCLOG059
       FMP     =6.93147180560E-01                                       BCLOG060
       FRN                                                              BCLOG061
       TNZ     *+3                                                      BCLOG062
       SSP                                                              BCLOG063
       TRA     2,4                                                      BCLOG064
INSERT PZE     0                                                        BCLOG065
       FMP     =.434294481903                                           BCLOG066
       FRN                                                              BCLOG067
 TRA24 TRA     2,4                                                      BCLOG068
 COM   OCT     ,,                                                       BCLOG069
 ERROR STO     COM            SAVE ARGUMENT                             BCLOG070
       TXI     *+1,4,-1        ADJUST XR4 FOR (ERPR)                    BCLOG071
       SXA     E,4            SAVE XR4                                  BCLOG072
       TZE     ZERO           ERROR, ARGUMENT IS ZERO. PRINT COMMENT.   BCLOG073
       TSX     $(ERPR),4                                                BCLOG074
       PZE     MESAGE+10,,10                                            BCLOG075
       PZE     E                                                        BCLOG076
 E     AXT     **,4           RESTORE XR4                               BCLOG077
       CLS     COM            PICK UP ABS(ARG)                          BCLOG078
       TXI     CONT,4,1       RETURN  LOG(ABS(ARG))                     BCLOG079
MESAGE BCI , LOG ARGUMENT NEGATIVE.         LOG(ABS(ARG)) RETURNED.     BCLOG080
 ZERO  TSX     $(ERPR),4                                                BCLOG081
       PZE     LINE+10,,10                                              BCLOG082
       PZE     E                                                        BCLOG083
       LXA     E,4            RESTORE XR4                               BCLOG084
       CLA     =O777777777777 PICK UP -0.170141179E39 AND RETURN.       BCLOG085
       TRA     1,4             EXIT                                     BCLOG086
 LINE  BCI , LOG ARGUMENT ZERO.         -0.170141179E39 RETURNED.       BCLOG087
       END                                                              BCLOG088
