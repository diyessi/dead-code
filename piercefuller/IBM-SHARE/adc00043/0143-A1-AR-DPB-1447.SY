*     DOUBLE PRECISION ADD,SUB,MULT,DIVIDE                                   001
       LBL     DPB                                                             2
       COUNT   100                                                           003
       ENTRY   (DFAD)                                                        004
       ENTRY   (DFSB)                                                        005
       ENTRY   (DFMP)                                                        006
       ENTRY   (DFDP)                                                        007
(DFAD) CLA     ADD                                                           008
       TRA     ADSU                                                          009
(DFSB) CLA     SUB                                                           010
 ADSU  STO     MOD                                                           011
       STI     SAVEI                                                         012
 GET   CAL     0                GET LOC STORED BY STR                        013
       STA     SAM+1            LEAST SIG PART                               014
       SUB     ONE                                                           015
       STA     SAM              MOST SIG PART                                016
       ADD     TWO                                                           017
       STA     TRANS            SET UP RETURN                                018
 SAM   CLA*    **              MSP                                           019
       LDQ*    **              LSP                                           020
       DST     4)-3                                                          021
       CLA     4)              MOST SIG PART                                 022
       LDQ     4)-1            LEAST SIG PART                                023
 MOD   NOP     4)-3            MODIFIED TO DFAD,DFSB                         024
       STO     4)              MOST  SIG PART                                025
       STQ     4)-1            LEAST SIG PART                                026
       LDI     SAVEI                                                         027
 TRANS TRA     **               RETURN TO PROGRAM                            028
(DFMP) CAL     0               GET LOC STORED BY STR                         029
       STA     SAM2+1           LSP                                          030
       SUB     ONE                                                           031
       STA     SAM2             MSP                                          032
       ADD     TWO                                                           033
       STA     TRANS            SET UP RETURN                                034
       STI     SAVEI                                                         035
 SAM2  CLA*    **              MSP                                           036
       LDQ*    **              LSP                                           037
       DST     4)-1                                                          038
       CLA     4)-2            MOST SIG. PART                                039
       LDQ     4)-3             LEAST SIG PART                               040
 MOD2  DFMP    4)-1                                                          041
       TRA     MOD+1                                                         042
(DFDP) STI     SAVEI                                                         043
       CAL     0                                                             044
       SUB     ONE                                                           045
       STA     *+1                                                           046
       CLA*    **                                                            047
       TZE     MES              TEST FOR DIV BY ZERO                         048
       CAL     0                                                             049
       STA     SAM1+1           LSP                                          050
       SUB     ONE                                                           051
       STA     SAM1             MSP                                          052
       ADD     TWO                                                           053
       STA     TRAN2                                                         054
 SAM1  CLA*    **              MSP                                           055
       LDQ*    **              LSP                                           056
       DST     4)-3                                                          057
       CLA     4)               MSP                                          058
       LDQ     4)-1             LSP                                          059
 MOD1  DFDP    4)-3                                                          060
       STO     4)-2                                                          061
       STQ     4)-3                                                          062
       LDI     SAVEI                                                         063
 TRAN2 TRA     **                                                            064
       PZE     (DFDP),0,0                                                     65
 MES   LDI     *-1                                                            66
       TSX    $EXIT,4                                                         67
 ADD   OCT     030100077774                                                   68
SUB    OCT     030300077774                                                   69
SAVEI  PZE     0                                                              70
 ONE   PZE     1                                                              71
 TWO   PZE     2                                                              72
       COMMON  -206                                                           73
 4)    COMMON  1                                                              74
       END                                                                    75
