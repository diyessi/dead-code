*     LABEL                                                                     
*     FAP                                                               ATAN0001
*ATAN                                                                           
       COUNT 100                                                        ATAN0002
*      B1 BC ATAN   FLOATING POINT INVERSE TANGENT ROUTINE              ATAN0003
*      SUMNERS ARCTAN ROUTINE REVISED FOR 7090                          ATAN0004
*      FLOATING PT. ATAN(X),ATANF(X), OR ATAN2(A/B),ATAN2F(A/B)         ATAN0005
       ENTRY   ATAN2                                                    ATAN0006
       ENTRY   ATAN                                                     ATAN0007
 ATAN2 STO     COM                                                      ATAN0009
       CLA     1,4                                                      ATAN0010
       STA     =15B9                                                    ATAN0011
       SUB     =15B9                                                    ATAN0012
       TZE     *+4             NON F                                    ATAN0013
       CLA     COM             F                                        ATAN0014
       STL     0,4                                                      ATAN0015
       TXI     *+4,4,2                                                  ATAN0016
       STL     0,4                                                      ATAN0017
       CLA*    1,4                                                      ATAN0018
       LDQ*    2,4                                                      ATAN0019
       TZE     3,4             A=0                                      ATAN0020
       STQ     COM                                                      ATAN0021
       ZET     COM                                                      ATAN0022
       TRA     NZ                                                       ATAN0023
       XCA                     A NOT 0, B=0                             ATAN0024
       CLA     PIO2                                                     ATAN0025
       LLS     0                                                        ATAN0026
       TRA     3,4                                                      ATAN0027
 NZ    FDP     COM             A NOT 0, B NOT 0                         ATAN0028
       XCA                                                              ATAN0029
       LDQ     COM                                                      ATAN0030
       TQP     CONT            B GTR 0,-PI/2 LSS ATAN(A/B) LSS PI/2     ATAN0031
       SXA     *+4,4                                                    ATAN0032
       TSX     CONT,4          B LSS 0                                  ATAN0033
 PI    DEC     3.14159266      PI                                       ATAN0034
 ONE   DEC     1.                                                       ATAN0035
       AXT     **,4                                                     ATAN0036
       TMI     *+3                                                      ATAN0037
       FSB     PI              A LSS 0, ATN=ATN-PI                      ATAN0038
       TRA     3,4                                                      ATAN0039
       FAD     PI              A GTR 0, ATN=ATN+PI                      ATAN0040
       TRA     3,4                                                      ATAN0041
 ATAN  XCA                                                              ATAN0042
       CLA     1,4                                                      ATAN0043
       STA     =15B9                                                    ATAN0044
       SUB     =15B9                                                    ATAN0045
       TZE     *+4             NON F                                    ATAN0046
       XCA                     F                                        ATAN0047
       STL     0,4                                                      ATAN0048
       TXI     *+4,4,2                                                  ATAN0049
       STL     0,4                                                      ATAN0050
       TXI     *+1,4,1                                                  ATAN0051
       CLA*    2,4                                                      ATAN0052
 CONT  STO     COM                                                      ATAN0053
       SSP                                                              ATAN0054
       SUB     ONE                                                      ATAN0055
       TPL     GTR                                                      ATAN0056
       LDQ     COM                                                      ATAN0057
 BACK  FMP     COM                                                      ATAN0058
       STO     COM+1                                                    ATAN0059
       FAD     =1.448631538                                             ATAN0060
       STO     COM+2                                                    ATAN0061
       CLS     A                                                        ATAN0062
       FDP     COM+2                                                    ATAN0063
       XCA                                                              ATAN0064
       FAD     COM+1                                                    ATAN0065
       FAD     =3.316335425                                             ATAN0066
       STO     COM+2                                                    ATAN0067
       CLS     =7.106760045                                             ATAN0068
       FDP     COM+2                                                    ATAN0069
       XCA                                                              ATAN0070
       FAD     COM+1                                                    ATAN0071
       FAD     =6.76213924                                              ATAN0072
       STO     COM+2                                                    ATAN0073
       CLA     =3.709256262                                             ATAN0074
       FDP     COM+2                                                    ATAN0075
       XCA                                                              ATAN0076
       FAD     =.1746554388                                             ATAN0077
       XCA                                                              ATAN0078
       FMP     COM                                                      ATAN0079
       TRA     3,4                                                      ATAN0080
 COM   DEC     ,,                                                       ATAN0081
 GTR   CLS     ONE                                                      ATAN0082
       FDP     COM                                                      ATAN0083
       STQ     COM                                                      ATAN0084
       SXA     *+4,4                                                    ATAN0085
       TSX     BACK,4                                                   ATAN0086
 PIO2  DEC     1.57079633                                               ATAN0087
 A     DEC     .2647686202                                              ATAN0088
       AXT     **,4                                                     ATAN0089
       TMI     *+3                                                      ATAN0090
       FSB     PIO2                                                     ATAN0091
       TRA     3,4                                                      ATAN0092
       FAD     PIO2                                                     ATAN0093
       TRA     3,4                                                      ATAN0094
       END                                                              ATAN0095
