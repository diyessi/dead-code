      SUBROUTINE RTSCH (A,N,X,IPRINT)                                           
I     DIMENSION X(91), A(91)                                                    
      DIMENSION S(91), ALPHA(2), BETA(2), V(2), Z(2), CI(4186)                  
      KCT=0                                                             S0466  1
      ICHECK=0                                                                  
      I2CK=0                                                                    
      ETA=1.                                                                    
      M=1                                                                       
      LJL=0                                                                     
      W=1.                                                                      
      MT=N+1                                                            MA599  1
      S(1)=1.                                                           MA599  1
      S(2)=1.                                                           MA599  1
      DO 12 JC=3,MT                                                             
   12 S(JC)=FLOATF(JC-1)*S(JC-1)                                        MA599  1
      DO 16 KD=1,MT                                                             
      DO 16 JD=1,KD                                                             
      IT=(KD*(KD-1))/2+JD                                                       
      MM=KD-JD+1                                                                
   16 CI(IT)=S(KD)/(S(JD)*S(MM))                                                
I     TT=A(1)                                                           MA599  1
I     CHECK=ABSF(TT)                                                    MA599  1
      IF(CHECK-1.E-6) 134,134,22                                        MA599  1
I  22 ALPHA=(0.,0.)                                                     MA599  1
      JZ=N+2                                                            MA599  1
      SR=W                                                                      
   40 CALL SEARCH (SR,ALPHA,R,CI,JZ,A)                                          
      KCT=0                                                                     
      IF(IPRINT) 1011,1015,1011                                                 
 1011 WOT 6,123, R                                                              
  123 FORMAT (3H R= E12.5 /  )                                                  
 1015 IF(JZ-95) 6,6,150                                                         
  150 I2CK=1                                                                    
I     BETA=ALPHA                                                        S0466  1
      GO TO 57                                                                  
    6 TUB=ALPHA(1)                                                              
      TAB=ALPHA(2)                                                      MA599  1
      IF(TUB) 46, 49, 46                                                MA599  1
   49 IF(TAB)  46, 47, 46                                               MA599  1
I  46 TEST=FCNN(ALPHA,A,N)                                                      
I     CHECK1=ABSF(TEST)                                                         
      IF(CHECK1-1.E-6) 48,48,54                                         MA599  1
   48 ETA=1.                                                            MA599  1
      GO TO 30                                                          MA599  1
   47 W=R                                                                       
I  54 V=(5.,0.)*R/(3.,0.)                                               MA599  1
I     U=V/(2.,0.)                                                       MA599 1 
I  56 BETA=ALPHA+V                                                      MA599  1
      KCT=KCT+1                                                         S0466  1
      IF(KCT-9) 50,61,61                                                S0466  1
   61 I2CK=2                                                                    
      GO TO 57                                                                  
I  50 U=(5.,0.)*R/(6.,0.)                                                       
I     CHECK2=ABSF(ALPHA-BETA)                                           MA599  1
      IF(CHECK2-1.E-5) 57,57,59                                                 
   57 ETA=-1.                                                           MA599  1
      GO TO 30                                                          MA599  1
   59 CALL RHUNT (A,U,BETA,JZ,V,SR,ALPHA,CI,ICHECK,R)                           
      IF(IPRINT) 1159,1881,1159                                                 
 1159 WOT 6,880, ALPHA(1), ALPHA(2), BETA(1), BETA(2), V(1), V(2)               
  880 FORMAT (7H ALPHA=2F12.7,6H BETA=2F12.7,3H V=2F12.7 /)                     
I1881 TEST=FCNN(BETA,A,N)                                                       
I     CHECK5=ABSF(TEST)                                                         
      IF(CHECK5-1.E-6) 902, 902, 906                                    MA599  1
  906 GO TO (40,56), ICHECK                                                     
I 134 BETA=(0.,0.)                                                              
  902 ETA=1.                                                            MA599  1
   30 AREAL= BETA(1)                                                    MA599  1
      AIMAG= BETA(2)                                                    MA599  1
I     X(M)=BETA                                                         S0466  1
      IF(IPRINT) 961,1543,961                                                   
  961 WOT 6,33, AREAL, AIMAG, ETA, M, I2CK                                      
   33 FORMAT (6H ROOT=1P2E14.5,5H ETA=0PF4.1, 3H M=I2,6H I2CK= I4 )             
I     Z=FCNN(BETA,A,N)                                                  MA599  1
  940 WOT 6,543, Z(1), Z(2)                                                     
  543 FORMAT (6H FCNN=2F12.7 ///)                                       MA599  1
 1543 CALL SYNDIV(A,N,BETA)                                                     
      I2CK=0                                                                    
      M=M+1                                                             MA599  1
      N=N-1                                                             MA599  1
      IF(N-2) 152,152,153                                                       
  152 LJL=LJL+1                                                                 
      GO TO (918,927,151), LJL                                                  
I 918 A1=A(1)                                                                   
I     A2=A(2)                                                                   
I     A3=A(3)                                                                   
I     DISC=SQRTF(A2**2-(4.,0.)*A1*A3)                                           
I 919 BETA=(-A2+DISC)/((2.,0.)*A3)                                              
      GO TO 902                                                                 
I 927 DISC=-DISC                                                                
      GO TO 919                                                                 
  153 IF(N-0) 151,151,136                                               MA599  1
I 136 TEST=FCNN ( BETA,A,N)                                             MA599  1
I     CHECK3=ABSF(TEST)                                                         
      IF(CHECK3-1.E-6) 30,30,22                                         MA599  1
  151 RETURN                                                                    
      END                                                                       
      SUBROUTINE SEARCH (SR,CT,R,CI,JZ,A)                                       
I     DIMENSION A(91), B(91), E(91)                                             
      DIMENSION CT(2), CI(4186)                                                 
      IT=1                                                              MA599  1
      LAMBDA=0                                                          MA599  1
      JJJ=0                                                                     
   39 R=2.**LAMBDA*SR                                                   MA599  1
      JJJ=JJJ+1                                                                 
      RHO=R                                                                     
      KS=JZ-1                                                                   
      KA=KS-1                                                           S0466  1
      DK=CT(1)                                                          MA599  1
      DJ=CT(2)                                                          MA599  1
      IF(DK-0.) 137, 109, 137                                           MA599  1
  109 IF(DJ-0.) 137, 199, 137                                           MA599  1
  199 DO 901 N=1,KS                                                             
I 901 E(N)=A(N)*RHO**(N-1)                                              MA599  1
      GO TO 170                                                         MA599  1
  137 DO 32 N=1,KS                                                              
I     ADD=(0.,0.)                                                               
      DO 231 K=N,KS                                                             
      L=K-N+1                                                                   
      KL=(K*(K-1))/2+L                                                          
      CM=CI(KL)                                                                 
I 231 ADD=ADD+A(K)*RHO**(N-1)*CT**(L-1)*CM                                      
I     E(N)=ADD                                                                  
   32 CONTINUE                                                                  
  170 DO 175 N=1,KS                                                             
      LV=JZ-N                                                           MA599  1
      LY=LV+91                                                          MA599  1
      KC=N+91                                                           MA599  1
      B(LV)=E(N)                                                        MA599  1
  175 B(LY)=-E(KC)                                                      MA599  1
      IF (JJJ-100) 64,307,307                                                   
  307 JZ=100                                                                    
      GO TO 101                                                                 
I  64 TGO=E(1)*B(KS)-E(KS)*B(1)                                         MA599  1
   80 IF(TGO) 83,66,66                                                  MA599  1
   66 IF(KS-2) 65, 65, 70                                                       
   65 IF(IT-2) 71,101,101                                               MA599  1
   71 LAMBDA=LAMBDA+1                                                   MA599  1
  306 GO TO 39                                                                  
   70 KS=KS-1                                                                   
      DO 76 N=1,KS                                                              
I  76 E(N)=B(KS+1)*E(N)-E(KS+1)*B(N)                                            
      DO 75 N=1,KS                                                              
      M=N+91                                                                    
      LV=KS-N+1                                                                 
      L=LV+91                                                                   
      B(N)=E(LV)                                                                
   75 B(M)=-E(L)                                                                
   63 JM=0                                                              S0466  1
      DO 61 N=1,KS                                                      S0466  1
I     TEX=E(N)                                                          S0466  1
I     VU=ABSF(TEX)                                                      S0466  1
      IF(VU) 60,61,60                                                   S0466  1
   60 JM=10                                                             S0466  1
   61 CONTINUE                                                          S0466  1
      IF(JM-10) 84,85,84                                                S0466  1
   85 DO 1190 J=1,KS                                                            
      KJ=KS+1-J                                                                 
I     SCALE=(E(J)+B(KJ))/(2.,0.)                                                
      IF(ABSF(SCALE)-1.E-4) 1190,1190, 68                                       
 1190 CONTINUE                                                                  
I1196 SCALE=(1.,0.)                                                             
   68 DO 79 N=1,KS                                                      S0466  1
I     B(N)=B(N)/SCALE                                                   S0466  1
I  79 E(N)=E(N)/SCALE                                                   S0466  1
   84 GO TO 64                                                          S0466  1
   83 LAMBDA=LAMBDA-1                                                   MA599  1
      IT=IT+1                                                           MA599  1
      GO TO 39                                                          MA599  1
  101 RETURN                                                                    
      END                                                                       
      SUBROUTINE RHUNT(A,U,BETA,JZ,V,SR,ALPHA,CI,ICHECK,R)                      
I     DIMENSION A(91), D(91), F(91)                                             
      DIMENSION CI(4186)                                                        
 3333 KS=JZ-1                                                           MA599  1
      KA=KS-1                                                           S0466  1
   38 DO 41 N=1,KS                                                      MA599  1
I     ADL=(0.,0.)                                                               
      DO 42 K=N,KS                                                              
      L=K-N+1                                                                   
      KLL=(K*(K-1))/2+L                                                         
      CJ=CI(KLL)                                                                
I     ADL=ADL+A(K)*U**(N-1)*BETA**(L-1)*CJ                                      
   42 CONTINUE                                                                  
I     F(N)=ADL                                                                  
   41 CONTINUE                                                          MA599  1
      DO 51 N=1,KS                                                      MA599  1
      NT=N+91                                                                   
      MC=KS+1-N                                                                 
      MZ=MC+91                                                                  
      D(N)=F(MC)                                                                
      D(NT)=-F(MZ)                                                              
   51 CONTINUE                                                          MA599  1
I1901 TGSO=F(1)*D(KS)-F(KS)*D(1)                                                
   90 IF(TGSO) 92,93,94                                                 MA599  1
   94 IF(KS-2) 266, 266, 200                                            MA599  1
I  92 ALPHA=BETA                                                        MA599  1
I     SR=U/(2.,0.)                                                      MA599  1
      ICHECK=1                                                          MA599  1
      GO TO 109                                                         MA599  1
I  93 U=(3.,0.)*U/(2.,0.)                                               MA599 1 
      GO TO 38                                                                  
  200 KS=KS-1                                                           MA599  1
      DO 476 N=1,KS                                                     MA599  1
I 476 F(N)=D(KS+1)*F(N)-F(KS+1)*D(N)                                    MA599  1
      DO 475 N=1,KS                                                     MA599  1
      MM=N+91                                                           MA599  1
      LVT=KS-N+1                                                                
      LL=LVT+91                                                         MA599  1
      D(N)=F(LVT)                                                               
  475 D(MM)=-F(LL)                                                              
  563 NM=0                                                              S0466  1
      DO 561 N=1,KS                                                     S0466  1
I     TEXT=F(N)                                                         S0466  1
I     UV=ABSF(TEXT)                                                     S0466  1
      IF(UV) 560,561,560                                                S0466  1
  560 NM=10                                                             S0466  1
  561 CONTINUE                                                          S0466  1
      IF(NM-10) 584,585,584                                             S0466  1
  585 DO 594 J=1,KS                                                             
      KJ=KS+1-J                                                                 
I     SCALE=(F(J)+D(KJ))/(2.,0.)                                                
      IF(ABSF(SCALE)-1.E-4) 594,594,217                                         
  594 CONTINUE                                                                  
I 686 SCALE=(1.,0.)                                                             
  217 DO 479 N=1,KS                                                     S0466  1
I     F(N)=F(N)/SCALE                                                   S0466  1
I 479 D(N)=D(N)/SCALE                                                   S0466  1
  584 GO TO 1901                                                        S0466  1
I 266 XXK=(0.,1.)                                                               
I     V=V*SQRTF(XXK)                                                            
      ICHECK=2                                                          MA599  1
  109 RETURN                                                                    
      END                                                                       
      SUBROUTINE SYNDIV (A,N,X)                                         MA599  1
I     DIMENSION A(91)                                                   MA599  1
      DIMENSION REM(2)                                                          
I     ADDON=(0.,0.)                                                     MA599  1
      MELVIN=N+1                                                        MA599  1
      DO 162 J=1,MELVIN                                                 MA599  1
I 162 ADDON=ADDON+A(J)*X**(J-1)                                         MA599  1
  631 DO 163 K=1,N                                                      MA599  1
I     ADDTO=(0.,0.)                                                     MA599  1
      DO 166 I=K,N                                                      MA599  1
      MA=MELVIN-I+K                                                     MA599  1
I 166 ADDTO=ADDTO+A(MA)*X**(N-I)                                        MA599  1
I     A(K)=ADDTO                                                        MA599  1
  163 CONTINUE                                                          MA599  1
I     A(MELVIN)=(0.,0.)                                                 MA599  1
      RETURN                                                                    
      END                                                                       
      FUNCTION FCNN (X,A,N)                                             MA599  1
I     DIMENSION A(91)                                                   MA599  1
I     SUME=(0.,0.)                                                      MA599  1
      NC=N+1                                                            MA599  1
      DO 216 I=1,NC                                                     MA599  1
I 216 SUME=SUME+A(I)*X**(I-1)                                           MA599  1
I     FCNN=SUME                                                                 
      RETURN                                                            MA599  1
      END                                                                       
