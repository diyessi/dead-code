* MSEN      050 08023 SETS AND SENSES BITS OF A WORD OR ARRAY           MSEN 001
*      FAP                                                              MSEN 002
       PCC                                                              MSEN 003
       LBL     MSENS,9                                                  MSEN 004
*MSENS TESTS AND SETS BITS IN A LONG WORD     LAPIDUS                   MSEN 005
       COUNT   50                                                       MSEN 006
       ENTRY   MSENS                                                    MSEN 007
*MSENS IS A FUNCTION MSENS(A,M,N)                                       MSEN 008
* MSENS USES THE SUBROUTINE INDIC                                       MSEN 009
*IMSNS REFERS TO I OF INDIC                                             MSEN 010
 MSENS SXD     MSENS-2,4                                                MSEN 011
       CLA*    3,4                                                      MSEN 012
       STO     SEQ2                                                     MSEN 013
       CLA     INDIC                                                    MSEN 014
       ADD     *+5                                                      MSEN 015
       STA     IMSNS                                                    MSEN 016
       CLA     *+2                                                      MSEN 017
       STO     *-4                                                      MSEN 018
       TRA     *+1                                                      MSEN 019
       CLA*    2,4                                                      MSEN 020
       LGR     54                                                       MSEN 021
       DVH     =36                                                      MSEN 022
       TNZ     *+6                                                      MSEN 023
       CLA     =O000043000000                                           MSEN 024
       STO     SEQ1                                                     MSEN 025
       XCA                                                              MSEN 026
       SUB     =1                                                       MSEN 027
       TRA     *+5                                                      MSEN 028
       SUB     =1                                                       MSEN 029
       ALS     18                                                       MSEN 030
       STO     SEQ1                                                     MSEN 031
       XCA                                                              MSEN 032
       SUB     1,4                                                      MSEN 033
       STA     AWORD                                                    MSEN 034
       CLA*    AWORD                                                    MSEN 035
       LDQ*    IMSNS                                                    MSEN 036
       STO*    IMSNS                                                    MSEN 037
       STQ*    AWORD                                                    MSEN 038
       CALL    INDIC,SEQ1,SEQ2                                          MSEN 039
       LDQ*    IMSNS                                                    MSEN 040
       LDI*    AWORD                                                    MSEN 041
       STQ*    AWORD                                                    MSEN 042
       STI*    IMSNS                                                    MSEN 043
       LXD     MSENS-2,4                                                MSEN 044
       TRA     4,4                                                      MSEN 045
 SEQ1  PZE                                                              MSEN 046
 SEQ2  PZE                                                              MSEN 047
 AWORD PZE                                                              MSEN 048
 IMSNS PZE                                                              MSEN 049
       END                                                              MSEN 050
