* POWR      367 10073          POWER SERIES PACKAGE                     POWR 001
CPEVAL    POWER SERIES FUNCTION TO EVALUATE A POLYNOMIAL IN 2 VARIABLES.POWR 002
C1        P IS A SQUARE 25,25 MATRIX OF ORDER LESS THAN OR =25 X 25     POWR 003
C2        AS WRITTEN.   DIMENSION MAY BE CHANGED BY CHANGING DIMENSION  POWR 004
C3        STATEMENT IN THIS SOURCE DECK.                                POWR 005
C4        WRITTEN AT NYU,AEC COMPUTING CENTER BY J.LEAVITT. PREPARED    POWR 006
C5        BY F.RAGUSA.                                                  POWR 007
C6        DEGREE IN X LESS THAN OR =K-1. SAME FOR Y. K IS ORDER OF MATRXPOWR 008
C7                                                                      POWR 009
      FUNCTION PEVAL(P,X,Y,K)                                           POWR 010
      DIMENSION S(25),P(25,25)                                          POWR 011
C         K = REAL SIZE OF P.                                           POWR 012
          K2=K-1                                                        POWR 013
      DO 1 N=1,K2                                                       POWR 014
          K3=K+1-N                                                      POWR 015
        S(N)=P(K3,N)                                                    POWR 016
      DO 1 I=2,K3                                                       POWR 017
          K4=K3+1-I                                                     POWR 018
        S(N)=S(N)*X+P(K4,N)                                             POWR 019
    1     CONTINUE                                                      POWR 020
      PEVAL =P(1,K)                                                     POWR 021
C                                                                       POWR 022
      DO 2 I=1,K2                                                       POWR 023
          K5=K-I                                                        POWR 024
      PEVAL=PEVAL*Y+S(K5)                                               POWR 025
    2     CONTINUE                                                      POWR 026
      RETURN                                                            POWR 027
       END                                                              POWR 028
*      LIST8                                                            POWR 029
CPINTX    POWER SERIES FUNCTION TO INTEGRATE P WITH RESPECT TO X.       POWR 030
C1        P IS A SQUARE 25,25 MATRIX OF ORDER LESS THAN OR =25 X 25     POWR 031
C2        AS WRITTEN.   DIMENSION MAY BE CHANGED BY CHANGING DIMENSION  POWR 032
C3        STATEMENT IN THIS SOURCE DECK.                                POWR 033
C4        WRITTEN AT NYU,AEC COMPUTING CENTER BY J.LEAVITT. PREPARED    POWR 034
C5        BY F.RAGUSA.                                                  POWR 035
C6                                                                      POWR 036
      FUNCTION PINTX(P,I,J)                                             POWR 037
      DIMENSION P(25,25)                                                POWR 038
          IF(I-1)1,1,2                                                  POWR 039
    1 PINTX=0.0                                                         POWR 040
          GO TO 5                                                       POWR 041
C7A       STATEMENT NO.S 2 THRU4 SET ASIDE IN CASE OTHER TESTS WANTED.  POWR 042
    2     CONTINUE                                                      POWR 043
      PINTX=P(I-1,J)/FLOATF(I-1)                                        POWR 044
    5     RETURN                                                        POWR 045
       END                                                              POWR 046
*      LIST8                                                            POWR 047
CPINTY    POWER SERIES FUNCTION TO INTEGRATE P WITH RESPECT TO Y.       POWR 048
C1        P IS A SQUARE 25,25 MATRIX OF ORDER LESS THAN OR =25 X 25     POWR 049
C2        AS WRITTEN.   DIMENSION MAY BE CHANGED BY CHANGING DIMENSION  POWR 050
C3        STATEMENT IN THIS SOURCE DECK.                                POWR 051
C4        WRITTEN AT NYU,AEC COMPUTING CENTER BY J.LEAVITT. PREPARED    POWR 052
C5        BY F.RAGUSA.                                                  POWR 053
C6                                                                      POWR 054
      FUNCTION PINTY(P,I,J)                                             POWR 055
      DIMENSION P(25,25)                                                POWR 056
          IF(J-1)1,1,2                                                  POWR 057
    1 PINTY=0.0                                                         POWR 058
          GO TO 5                                                       POWR 059
    2     CONTINUE                                                      POWR 060
      PINTY=P(I,J-1)/FLOATF(J-1)                                        POWR 061
    5     RETURN                                                        POWR 062
       END                                                              POWR 063
*      LIST8                                                            POWR 064
CPMPY     POWER SERIES FUNCTION TO MULTIPLY P TIMES Q.                  POWR 065
C1        P AND Q ARE SQUARE MATRICES OF ORDER LESS THAN OR=25X25 AS    POWR 066
C2        AS WRITTEN.   DIMENSION MAY BE CHANGED BY CHANGING DIMENSION  POWR 067
C3        STATEMENT IN THIS SOURCE DECK.                                POWR 068
C4        WRITTEN AT NYU,AEC COMPUTING CENTER BY J.LEAVITT. PREPARED    POWR 069
C5        BY F.RAGUSA.                                                  POWR 070
C6                                                                      POWR 071
      FUNCTION PMPY(P,Q,I,J)                                            POWR 072
      DIMENSION P(25,25),Q(25,25)                                       POWR 073
C                                                                       POWR 074
         SUM=0.0                                                        POWR 075
      DO 1 K=1,I                                                        POWR 076
      DO 1 L=1,J                                                        POWR 077
           M=I-K+1                                                      POWR 078
           N=J-L+1                                                      POWR 079
    1 SUM =P(K,L)*Q(M,N)+SUM                                            POWR 080
      PMPY=SUM                                                          POWR 081
      RETURN                                                            POWR 082
       END                                                              POWR 083
*      LIST8                                                            POWR 084
CPDERX    POWER SERIES FUNCTION TO FIND PARTIAL DERIV. WITH RESPECT TO XPOWR 085
C1        P IS A SQUARE 25,25 MATRIX OF ORDER LESS THAN OR =25 X 25     POWR 086
C2        AS WRITTEN.   DIMENSION MAY BE CHANGED BY CHANGING DIMENSION  POWR 087
C3        STATEMENT IN THIS SOURCE DECK.                                POWR 088
C4        WRITTEN AT NYU,AEC COMPUTING CENTER BY J.LEAVITT. PREPARED    POWR 089
C5        BY F.RAGUSA.                                                  POWR 090
C6                                                                      POWR 091
      FUNCTION PDERX(P,I,J)                                             POWR 092
      DIMENSION P(25,25)                                                POWR 093
C                                                                       POWR 094
      PDERX=FLOATF(I)*P(I+1,J)                                          POWR 095
      RETURN                                                            POWR 096
       END                                                              POWR 097
*      LIST8                                                            POWR 098
CPDERY    POWER SERIES FUNCTION TO FIND PARTIAL DERIV. WITH RESPECT TO YPOWR 099
C1        P IS A SQUARE 25,25 MATRIX OF ORDER LESS THAN OR =25 X 25     POWR 100
C2        AS WRITTEN.   DIMENSION MAY BE CHANGED BY CHANGING DIMENSION  POWR 101
C3        STATEMENT IN THIS SOURCE DECK.                                POWR 102
C4        WRITTEN AT NYU,AEC COMPUTING CENTER BY J.LEAVITT. PREPARED    POWR 103
C5        BY F.RAGUSA.                                                  POWR 104
C6                                                                      POWR 105
      FUNCTION PDERY(P,I,J)                                             POWR 106
      DIMENSION P(25,25)                                                POWR 107
C                                                                       POWR 108
      PDERY=FLOATF(J)*P(I,J+1)                                          POWR 109
      RETURN                                                            POWR 110
      END                                                               POWR 111
*     LIST8                                                             POWR 112
CPDIV     POWER SERIES FUNCTION TO DIVIDE P/Q.                          POWR 113
C1        P AND Q ARE SQUARE MATRICES OF ORDER LESS THAN OR=25X25 AS    POWR 114
C2        AS WRITTEN.   DIMENSION MAY BE CHANGED BY CHANGING DIMENSION  POWR 115
C3        STATEMENT IN THIS SOURCE DECK.                                POWR 116
C4        WRITTEN AT NYU,AEC COMPUTING CENTER BY J.LEAVITT. PREPARED    POWR 117
C5        BY F.RAGUSA.                                                  POWR 118
C6                                                                      POWR 119
      FUNCTION PDIV(P,Q,I,J,R)                                          POWR 120
      DIMENSION P(25,25),Q(25,25),R(25,25)                              POWR 121
C                                                                       POWR 122
          IF DIVIDE CHECK 30,30                                         POWR 123
   30 SUMA=0.0                                                          POWR 124
      SUMB=0.0                                                          POWR 125
          IF(I-1)1,1,2                                                  POWR 126
    1     IF(J-1)3,3,4                                                  POWR 127
    2     IF(J-1)5,5,6                                                  POWR 128
    3 PDIV=P(1,1)/Q(1,1)                                                POWR 129
          GO TO 8                                                       POWR 130
C                                                                       POWR 131
    4 J2=J-1                                                            POWR 132
      DO 44 L=1,J2                                                      POWR 133
          IF(R(1,L)) 80,44,80                                           POWR 134
   80 M=J-L+1                                                           POWR 135
          IF(Q(1,M))82,44,82                                            POWR 136
   82 SUMB=R(1,L)*Q(1,M)+SUMB                                           POWR 137
   44 CONTINUE                                                          POWR 138
C                                                                       POWR 139
      PDIV=(P(1,J)-SUMB)/Q(1,1)                                         POWR 140
          GO TO 8                                                       POWR 141
C                                                                       POWR 142
    5 I2=I-1                                                            POWR 143
      DO 55 K=1,I2                                                      POWR 144
          IF(R(K,1))  83,55,83                                          POWR 145
   83 K2=I-K+1                                                          POWR 146
          IF(Q(K2,1)) 81,55,81                                          POWR 147
   81 SUMA=R(K,1)*Q(K2,1)+SUMA                                          POWR 148
   55 CONTINUE                                                          POWR 149
C                                                                       POWR 150
      PDIV=(P(I,1)-SUMA)/Q(1,1)                                         POWR 151
          GO TO 8                                                       POWR 152
C                                                                       POWR 153
    6 I2=I-1                                                            POWR 154
      J2=J-1                                                            POWR 155
      DO 66 K=1,I2                                                      POWR 156
      DO 66 L=1,J                                                       POWR 157
          IF(R(K,L))  84,66,84                                          POWR 158
   84 L2=J+1-L                                                          POWR 159
      K2=I+1-K                                                          POWR 160
          IF(Q(K2,L2))85,66,85                                          POWR 161
   85 SUMA=R(K,L)*Q(K2,L2)+SUMA                                         POWR 162
   66 CONTINUE                                                          POWR 163
C                                                                       POWR 164
      DO 77  M=1,J2                                                     POWR 165
          IF(R(1,M))  86,77,86                                          POWR 166
   86 M2=J+1-M                                                          POWR 167
          IF(Q(1,M2)) 87,77,87                                          POWR 168
   87 SUMB=R(I,M)*Q(1,M2)+SUMB                                          POWR 169
   77 CONTINUE                                                          POWR 170
C                                                                       POWR 171
      PDIV=(P(I,J)-SUMA-SUMB)/Q(1,1)                                    POWR 172
       R(I,J)=PDIV                                                      POWR 173
    8 RETURN                                                            POWR 174
      END                                                               POWR 175
*      LIST8                                                            POWR 176
      SUBROUTINE   POIN(PQ,X1,Y1,K,RHO,III,SX,SY,XLIM,LL,NARG)          POWR 177
      IFINE=0                                                           POWR 178
C     K+1=DEGREE POLY,RHO=INTERPOLATION CONSTANT                        POWR 179
      DIMENSION SX(25,25),SY(25,25),PQ(25,25)                           POWR 180
      M=0                                                               POWR 181
      IF(NARG)4,1,4                                                     POWR 182
 1    WPQ=PEVAL(PQ,X1,Y1,K)                                             POWR 183
C     THIS EVALUATES C IN PQ(X,Y)=C WHERE X,Y ARE THE INITIAL VALUES    POWR 184
C     THIS EVALUATION IS DONE ONLY ONCE                                 POWR 185
 4    X=X1                                                              POWR 186
      Y=Y1                                                              POWR 187
 44   VDELX=PEVAL(SX,X1,Y1,K)                                           POWR 188
      VDELY=PEVAL(SY,X1,Y1,K)                                           POWR 189
      SZ=SQRTF(VDELX**2+VDELY**2)                                       POWR 190
 62   X1=X1-VDELY/SZ*RHO                                                POWR 191
      Y1=Y1+VDELX/SZ*RHO                                                POWR 192
      VPQ=PEVAL(PQ,X1,Y1,K)                                             POWR 193
C     THE INITIAL GUESS IS ALONG THE TANGENT A DISTANCE RHO             POWR 194
      IF(ABSF(VDELY)-XLIM)5,5,7                                         POWR 195
C     INTERPOLATION ALONG THE NORMAL TO THE TANGENT,TANGENT IS VERTICAL POWR 196
 5    VDELX=PEVAL(SX,X1,Y1,K)                                           POWR 197
      T=(WPQ-VPQ)/VDELX                                                 POWR 198
 55   X1=X1+T                                                           POWR 199
      VDELX=PEVAL(SX,X1,Y1,K)                                           POWR 200
      VPQ=PEVAL(PQ,X1,Y1,K)                                             POWR 201
      T=(WPQ-VPQ)/VDELX                                                 POWR 202
      IF(ABSF(T)-XLIM)50,50,6                                           POWR 203
 6    M=M+1                                                             POWR 204
      IF(M-LL)55,45,45                                                  POWR 205
 7    IF(ABSF(VDELX)-XLIM)8,8,10                                        POWR 206
C     INTERP ALONG THE NORMAL TO THE TANGENT,TANGENT IS HORIZONTAL      POWR 207
 8    VDELY=PEVAL(SY,X1,Y1,K)                                           POWR 208
      T=(WPQ-VPQ)/VDELY                                                 POWR 209
 88   Y1=Y1+T                                                           POWR 210
      VPQ=PEVAL(PQ,X1,Y1,K)                                             POWR 211
      VDELY=PEVAL(SY,X1,Y1,K)                                           POWR 212
      T=(WPQ-VPQ)/VDELY                                                 POWR 213
      IF(ABSF(T)-XLIM)50,50,9                                           POWR 214
 9    M=M+1                                                             POWR 215
      IF(M-LL)88,45,45                                                  POWR 216
C     INTERPOLATION IS ALONG THE NORMAL TO THE TANGENT                  POWR 217
 10   T=VDELY/VDELX                                                     POWR 218
      VDELX=PEVAL(SX,X1,Y1,K)                                           POWR 219
      VDELY=PEVAL(SY,X1,Y1,K)                                           POWR 220
      TT=VDELX+T*VDELY                                                  POWR 221
      TTT=(WPQ-VPQ)/TT                                                  POWR 222
 111  X1=X1+TTT                                                         POWR 223
      Y1=Y1+T*TTT                                                       POWR 224
      VDELX=PEVAL(SX,X1,Y1,K)                                           POWR 225
      VDELY=PEVAL(SY,X1,Y1,K)                                           POWR 226
      TT=VDELX+T*VDELY                                                  POWR 227
      VPQ=PEVAL(PQ,X1,Y1,K)                                             POWR 228
      TTT=(WPQ-VPQ)/TT                                                  POWR 229
      IF(ABSF(TTT)-XLIM)50,50,12                                        POWR 230
 12   M=M+1                                                             POWR 231
      IF(M-LL)111,45,45                                                 POWR 232
 45   IF(IFINE)47,48,47                                                 POWR 233
 47   III=999                                                           POWR 234
C     THIS INDICATES A FAILURE,BOTH WITH REGULAR AND SMALLER RHO        POWR 235
C     BY TESTING III THE INTERPOLATION CAN BE HALTED IN THE MAIN PROGRAMPOWR 236
      GO TO 52                                                          POWR 237
 48   IFINE=1                                                           POWR 238
      M=0                                                               POWR 239
      X1=X                                                              POWR 240
      Y1=Y                                                              POWR 241
      RHO=.1*RHO                                                        POWR 242
      GO TO 44                                                          POWR 243
 50   CONTINUE                                                          POWR 244
      IF(IFINE)51,52,51                                                 POWR 245
 51   RHO=10.*RHO                                                       POWR 246
C     INTERPOLATION FAILED,TRY A SMALLER RHO                            POWR 247
 52   RETURN                                                            POWR 248
      END                                                               POWR 249
*      LIST8                                                            POWR 250
CPEXP   FOR J. LEAVITT BY F) RAGUSA.  JUNE 24,1963.                     POWR 251
C                                                                       POWR 252
       SUBROUTINE PEXP(P,Q,N)                                           POWR 253
C                                                                       POWR 254
C      TO FIND THE COEFFICENTS Q(1),Q(2),...,Q(N  ) FOR  Q=EXP(P).      POWR 255
C                                                                       POWR 256
       DIMENSION P(1), Q(1)                                             POWR 257
C                                                                       POWR 258
       Q(1) = EXPF (P(1))                                               POWR 259
       Q(2) = P(2) * Q(1)                                               POWR 260
C                                                                       POWR 261
       NUF= N - 1                                                       POWR 262
       DO  1  K =  2,  NUF                                              POWR 263
       FK = K                                                           POWR 264
       KE = K + 1                                                       POWR 265
C                                                                       POWR 266
       Q(KE) = P(2) * Q(K) / FK                                         POWR 267
       KL = K-1                                                         POWR 268
       TEMP = 0.0                                                       POWR 269
C                                                                       POWR 270
       DO  2  I = 1,  KL                                                POWR 271
       K1= K-I                                                          POWR 272
       FI = I + 1                                                       POWR 273
  2    TEMP = FI * P(I+2) * Q(K1) + TEMP                                POWR 274
C                                                                       POWR 275
       Q(KE) = Q(KE) + 1.0 / FK * TEMP                                  POWR 276
  1    CONTINUE                                                         POWR 277
       RETURN                                                           POWR 278
       END                                                              POWR 279
*      LIST8                                                            POWR 280
CPLOG   FOR J. LEAVITT BY F) RAGUSA.  JUNE 24,1963.                     POWR 281
      SUBROUTINE PLOG(P,Q,N)                                            POWR 282
C      TO FIND THE COEFFICIENTS Q(1),Q(2),...Q(N  ) FOR  Q=LOG(P)       POWR 283
       DIMENSION P(1), Q(1)                                             POWR 284
      Q(1) =  LOGF( P(1) )                                              POWR 285
      Q(2) = P(2) / P(1)                                                POWR 286
      NUF = N - 1                                                       POWR 287
       DO 2  K = 2, NUF                                                 POWR 288
      KE = K + 1                                                        POWR 289
      KL =  K - 1                                                       POWR 290
      FK = K                                                            POWR 291
      TEMP = 0.0                                                        POWR 292
       DO 1  I = 1,  KL                                                 POWR 293
      FKI = K - I                                                       POWR 294
       KI = K - I                                                       POWR 295
  1   TEMP =  FKI * Q( KI + 1 ) * P (I+1) + TEMP                        POWR 296
       Q(KE) = ( P(KE) - (1.0/FK) * TEMP ) / P(1)                       POWR 297
  2   CONTINUE                                                          POWR 298
      RETURN                                                            POWR 299
       END                                                              POWR 300
*      LIST8                                                            POWR 301
CPPWR   FOR J. LEAVITT BY F) RAGUSA.  JUNE 24,1963.                     POWR 302
C                                                                       POWR 303
       SUBROUTINE PPWR(P,Q,XL,N)                                        POWR 304
C                                                                       POWR 305
C      TO FIND THE COEFFICIENTS Q(1),Q(2),...Q(N  ) FOR  Q=P **XL.      POWR 306
C                                                                       POWR 307
       DIMENSION P(1), Q(1)                                             POWR 308
C                                                                       POWR 309
       Q(1)=P(1)**XL                                                    POWR 310
       Q(2)=XL * Q(1) * P(2) / P(1)                                     POWR 311
       Q(3)=((( XL-1.0) /2.0) * Q(2)* P(2) + XL * Q(1) * P(3) ) / P(1)  POWR 312
C                                                                       POWR 313
       NUF= N-1                                                         POWR 314
       DO 2  K=  3,  NUF                                                POWR 315
       FK = K                                                           POWR 316
       KE = K + 1                                                       POWR 317
       Q(KE)= ((XL-FK + 1.0) / FK) * Q(K) * P(2) + XL * Q(1) * P(KE)    POWR 318
C                                                                       POWR 319
       KL = K - 1                                                       POWR 320
       TEMP = 0.0                                                       POWR 321
C                                                                       POWR 322
       DO  1  I = 2,  KL                                                POWR 323
       FI = I                                                           POWR 324
       K1 = KE - I                                                      POWR 325
  1    TEMP = ( FI * ( XL + 1.0 ) / FK - 1.0 ) * Q(K1) * P(I+1) + TEMP  POWR 326
C                                                                       POWR 327
       Q(KE) = ( Q(KE) + TEMP ) / P(1)                                  POWR 328
  2    CONTINUE                                                         POWR 329
       RETURN                                                           POWR 330
       END                                                              POWR 331
*      LIST8                                                            POWR 332
CPTRIG  FOR J. LEAVITT BY F) RAGUSA.  JUNE 24,1963.                     POWR 333
       SUBROUTINE PTRIG( P, Q, R, N)                                    POWR 334
C                                                                       POWR 335
C      TO FIND THE COEFFICIENTS Q(1), Q(2),...,Q(N  ) FOR Q= SIN(P)     POWR 336
C      AND R(1), R(2),..., R(N  )  FOR R = COS (P)                      POWR 337
C                                                                       POWR 338
       DIMENSION P(1), Q(1), R(1)                                       POWR 339
C                                                                       POWR 340
       Q(1)=SINF ( P(1) )                                               POWR 341
       R(1) = COSF ( P(1) )                                             POWR 342
       Q(2)= R(1) * P(2)                                                POWR 343
       R(2) = -Q(1) * P(2)                                              POWR 344
C                                                                       POWR 345
       NUF = N - 1                                                      POWR 346
       DO  2  K = 2,  NUF                                               POWR 347
       FK = K                                                           POWR 348
       KE = K + 1                                                       POWR 349
C                                                                       POWR 350
       Q(KE) = R(1) * P(KE)                                             POWR 351
       R(KE) =-Q(1) * P(KE)                                             POWR 352
       K1 = K - 1                                                       POWR 353
       TEMP1 = 0.0                                                      POWR 354
        TEMP2 = 0.0                                                     POWR 355
C                                                                       POWR 356
       DO  1   I= 1,  K1                                                POWR 357
        FKI = K - I                                                     POWR 358
        K2 = K - I                                                      POWR 359
        TEMP1 = FKI * R(I+1) * P(K2+1) + TEMP1                          POWR 360
 1     TEMP2 =  FKI * Q(I+1) * P(K2+1) + TEMP2                          POWR 361
C                                                                       POWR 362
       Q(KE) = Q(KE) + 1.0 / FK * TEMP1                                 POWR 363
       R(KE) = R(KE) - 1.0 / FK * TEMP2                                 POWR 364
  2    CONTINUE                                                         POWR 365
        RETURN                                                          POWR 366
       END                                                              POWR 367
