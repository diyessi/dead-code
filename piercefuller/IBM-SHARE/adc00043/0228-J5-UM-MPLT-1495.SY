UMMPLT REM 1060 04013                                                   UMPL0001
       ENTRY   PLOT1                                                    UMPL0002
       ENTRY   PLOT2                                                    UMPL0003
       ENTRY   PLOT3                                                    UMPL0004
       ENTRY   PLOT4                                                            
       ENTRY   OMIT                                                     U4PL0006
       ENTRY   FPLOT4                                                           
       REM         PLOTTING SUBROUTINE.   WRITES GRAPH IMAGES ON        UMPL0008
       REM         DECIMAL TAPE FOR SUBS[QUENT OFF-LINE PRINTING OR     UMPL0009
       REM         PUNCHING.  THE NUMBER OF COLUMNS IN ,HE              UMPL0010
       REM         PRINTED LINE OR PUN.HED CARD IS SET AT ASSEMB$Y.     UMPL0011
       REM    UNIVERSITY OF MICHIGAN COMPUTING CENTER   FEBRUARY 15,1961UMPL0012
       REM    PROGRAMMERS - BRICE CARNAHAN, LARRY EVANS                 UMPL0013
       REM  MODIFIED FOR 709 BY BOB ROSIN, MAY JUNE, 1961               UMPL0014
       REM  MODIFIED FOR 7090 BY DON BOETTNER AND PREPARED              UMPL0015
       REM  FOR SHARE BY GERALD LEVITT MARCH 15, 1963                   UMPL0016
       REM                                                              UMPL0017
       REM    FORTRN OR MAD CALLING SEQUENCES ARE                       UMPL0018
       REM      CALL OR EXECUTE  PLOT1 (NSCALE,NH,SBH,NV,SBV)           UMPL0019
       REM      CALL OR EXECUTE  PLOT2 (IMAGE,XMAX,XMIN,YMAX,YMIN)      UMPL0020
       REM      CALL OR EXECUTE  PLOT3 (BCD,X,Y,NDATA)                  UMPL0021
       REM              EXECUTE  PLOT4.(NCHAR,LABEL)                    UMPL0022
       REM      CALL            FPLOT4 (NCHAR,NHABCDEF....)             UMPL0023
       REM      CALL OR EXECUTE  OMIT (ARG)                             UMPL0024
       REM                                                              UMPL0025
       REM  PRESET THE FOLLOWING TWO INSTRUCTIONS BEFORE ASSEMBLY       UMPL0026
COL    EQU 132               SET COLUMNS IN OUTPUT LINE                 UMPL0027
SPACS  EQU 6                 SET UNUSED SPACES AT RIGHT EDGE OF PAGE    UMPL0028
       REM                   OR CARD.  SPACS MUST BE AT LEAST 6         UMPL0029
CDIM   EQU COL/6+2           SIZE OF C REGION                           UMPL0030
LNREC  EQU     1                                                        UMPL0031
       REM .............................................................UMPL0032
       REM                                                              UMPL0033
       REM         MAIN JOB OF PLOT1 IS TO EXAMINE ARGUMENTS AND PREPAREUMPL0034
       REM         SAMPLE GRIDLINE (DASH TO DASH-WORDS+1) AND SAMPLE    UMPL0035
       REM         NON-GRID LINE (BLANK TO BLANK-WORDS+1) FOR USE BY    UMPL0036
       REM         PLOT2                                                UMPL0037
       REM                                                              UMPL0038
PLOT1  SXD IR4,4        ENTRY TO PLOT1                                  UMPL0039
       SXD IR1,1        SAVE REGISTERS                                  UMPL0040
       SXD IR2,2                                                        UMPL0041
       CLA 1,4          SCALE FACTORS AND DECIMAL POINT POSITIONS       UMPL0042
       STA DELTA                                                        UMPL0043
       STA DELT                                                         UMPL0044
       STZ WRON1        WRON1 = 0      CLEAR ERROR FLAG, PLOT1          UMPL0045
       CLA ONE                                                          UMPL0046
       STO WRON3        WRON3 = 1      SET ERROR FLAG, MISSING PLOT2    UMPL0047
       CLA*    2,4      NH,  NUMBER OF HORIZONTAL GRID LINES            UMPL0048
       TSX FIX,2                                                        UMPL0049
       TZE ERR1         ZERO ARGUMENT ILLEGAL, ERROR RETURN             UMPL0050
       STO NH                                                           UMPL0051
       CLA*    3,4      SBH,  NUMBER OF SPACES BETWEEN HORIZ GRID LINES UMPL0052
       TSX FIX,2                                                        UMPL0053
       TZE ERR1         ZERO ARGUMENT ILLEGAL, ERROR RETURN             UMPL0054
       STO SBH                                                          UMPL0055
       LDQ SBH                                                          UMPL0056
       MPY NH                                                           UMPL0057
       STQ LINES        LINES = NH*SBH      MAXIMUM LINE INDEX          UMPL0058
       CLA*    4,4      NV,  NUMBER OF VERTICAL GRID LINES              UMPL0059
       TSX FIX,2                                                        UMPL0060
       TZE ERR1         ZERO ARGUMENT ILLEGAL, ERROR RETURN             UMPL0061
       STO NV                                                           UMPL0062
       CLA*    5,4      SBV, NUMBER OF SPACES BETWEEN VERT GRID LINES   UMPL0063
       TSX FIX,2                                                        UMPL0064
       TZE ERR1         ZERO ARGUMENT ILLEGAL, ERROR RETURN             UMPL0065
       STO SBV                                                          UMPL0066
       LDQ SBV                                                          UMPL0067
       MPY NV                                                           UMPL0068
       STQ TOT          TOT = SBV*NV        MAXIMUM COLUMN INDEX        UMPL0069
       LLS 35                                                           UMPL0070
       ADD ONE                                                          UMPL0071
       STO TOTAL        TOTAL = TOT + 1     TOTAL COLUMNS PER LINE      UMPL0072
       SUB GWID         WHENEVER TOTAL .G. GRAPH WIDTH, ERROR RETURN    UMPL0073
       TMI PASS                                                         UMPL0074
ERR1   CLA FPONE        RETURN ONE, UNSUCCESSFUL PLOT1                  UMPL0075
       STO WRON1        WRON1 = 1      SET ERROR FLAG, PLOT1            UMPL0076
       CLA     ER1                                                      UMPL0077
       STO     WRONG                                                    UMPL0078
IR22   TXL WRITE,0,**                                                   UMPL0079
PASS   CLA TOTAL                                                        UMPL0080
       TSX FLOAT,2                                                      UMPL0081
       FDP SIXF                                                         UMPL0082
       XCA                                                              UMPL0083
       FAD N999                                                         UMPL0084
       TSX FIX1,2                                                       UMPL0085
       STO WORDS        WORDS = TOTAL/6. ROUNDED UP TO NEAREST INTEGER  UMPL0086
       LDQ WORDS        WORDS, NUMBER OF MACHINE LOCATIONS PER LINE     UMPL0087
       MPY SIX                                                          UMPL0088
       STQ TOTLS        TOTLS = WORDS*6     BCD CHARACTERS PER LINE     UMPL0089
       LXA WORDS,2                                                      UMPL0090
       CLA TOTLS                                                        UMPL0091
       SUB TOTAL                                                        UMPL0092
       PAX 0,1                                                          UMPL0093
       CLA DSH,1        LAST WORD OF A HORIZONTAL GRID LINE             UMPL0094
       STO DASH+1,2     SET UP LAST WORD IN HORIZONTAL GRID LINE IMAGE  UMPL0095
       LDQ BLNKK        LAST WORD OF NON GRID LINE                      UMPL0096
       STQ BLANK+1,2    SET UP LAST WORD IN NON GRID LINE IMAGE         UMPL0097
       TIX *+2,2,1                                                      UMPL0098
       TXL *+5,0,       ONE WORD PER LINE CASE                          UMPL0099
       CLA DSH                                                          UMPL0100
       STO DASH+1,2     SET UP REMAINDER OF HORIZONTAL GRID LINE IMAGE  UMPL0101
       STQ BLANK+1,2    SET UP REMAINDER OF NON GRID LINE IMAGE         UMPL0102
       TIX *-2,2,1                                                      UMPL0103
       STZ I            I = 0, COLUMN INDEX FOR VERTICAL GRID POSITIONS UMPL0104
GAMMA  TSX PLACE,4      PLACE I FOR VERTICAL GRID LINE IN NON GRID IMAGEUMPL0105
       TXH IEYE                                                         UMPL0106
       TXH I                                                            UMPL0107
       TXH BLANK                                                        UMPL0108
       TSX PLACE,4      PLACE + AT INTERSECTION POINTS IN GRID LINE IMAGUMPL0109
       TXH IPLUS                                                        UMPL0110
       TXH I                                                            UMPL0111
       TXH DASH                                                         UMPL0112
       CLA I                                                            UMPL0113
       ADD SBV                                                          UMPL0114
       STO I            I=I+SBV, INCREMENT COLUMN INDEX FOR VERT GRID   UMPL0115
       SUB TOTAL                                                        UMPL0116
       TZE GAMMA        IF ZERO OR MINUS LINE IS UNFINISHED, RETURN     UMPL0117
       TMI GAMMA                                                        UMPL0118
DELTA  CLA **           NSCALE, DETERMINES SCALE FACTOR MODIFICATION    UMPL0119
       TZE ETA          STANDARD SCALE FACTORS AND DEC POINT POSITIONS  UMPL0120
       LXD FOUR,4       G3 = NSCALE-1       SCALE FACTOR FOR Y          UMPL0121
DELT   CLA **,4         G4 = NSCALE-2       DEC POINT POSITION FOR Y    UMPL0122
       TSX TFIX,2       G5 = NSCALE-3       SCALE FACTOR FOR X          UMPL0123
       STO G3+1,4       G7 = NSCALE-4       DEC POINT POSITION FOR X    UMPL0124
       TIX DELT,4,1                                                     UMPL0125
       REM              LEFT-MOST ABCISSA (BOTTOM) VALUE IS PRINTED     UMPL0126
       REM                 ACCORDING TO FORMAT G5 P F G6 . G7           UMPL0127
       REM              OTHER ABCISSA VALUES ARE PRINTED ACCORDING      UMPL0128
       REM                 TO FORMAT G5 P F G9 . G7                     UMPL0129
       REM              ORDINATE (LEFT) VALUES ARE PRINTED ACCORDING    UMPL0130
       REM                 TO FORMAT G3 P F9 . G4                       UMPL0131
ETA    CLA G4                                                           UMPL0132
       TZE *+4                                                          UMPL0133
       TPL *+3                                                          UMPL0134
       CLS ONE          NEG DEC POINT POSITION, INTEGER ORDINATE DESIREDUMPL0135
TWNTY  TXL *+4,0,COL/6                                                  UMPL0136
       LRS 35                                                           UMPL0137
       CLA EIGHT        MAX DEC PLACES FOR ORDINATE IS EIGHT            UMPL0138
       TLQ PASS3                                                        UMPL0139
       STO G4           WHENEVER G4 .G. 8, G4 = 8                       UMPL0140
PASS3  CLA G7                                                           UMPL0141
       SUB TEN          ABSCISSA DEC POINT POSITION TAKEN MODULO TEN    UMPL0142
       TPL *-1                                                          UMPL0143
       ADD TEN                                                          UMPL0144
       TZE *+3                                                          UMPL0145
       TPL *+2                                                          UMPL0146
       CLS ONE          NEG DEC POINT POSITION, INTEGER ABSCISSA DESIREDUMPL0147
       STO G7                                                           UMPL0148
       CLA SBV          SBV, COLUMNS AVAILABLE FOR EACH ABSCISSA VALUE  UMPL0149
       SUB ONE          LEAVE ONE BLANK TO SEPARATE NUMBERS             UMPL0150
       STO G9           G9 = SBV-1     FIELD WIDTH FOR ABSCISSA VALUES  UMPL0151
       LDQ G7           WHENEVER G7.GE.G9, G7 = G9-1                    UMPL0152
       TLQ PASS4        INSURES DECIMAL POINT INSIDE FIELD              UMPL0153
       SUB ONE                                                          UMPL0154
       STO G7                                                           UMPL0155
PASS4  CLA TWELV        TWELVE SPACES ON LEFT FOR ORDINATE AND LABEL    UMPL0156
       ADD G7                                                           UMPL0157
       STO G6           G6 = G7+12     FIELD WIDTH, LEFT ABSCISSA VALUE UMPL0158
       CLA RECLT                                                        UMPL0159
       SUB TOTAL                                                        UMPL0160
       SUB G6                                                           UMPL0161
       TPL *+3          WHENEVER RECLT-TOTAL-G6.L.0, MUST REDUCE G6     UMPL0162
       ADD G6                                                           UMPL0163
       STO G6           G6  REDUCED TO NUMBER OF COLUMNS AVAILABLE      UMPL0164
PASS5  CLA G6           WHENEVER G7.GE.G6, G7 = G6-1                    UMPL0165
       LDQ G7           INSURES DECIMAL POINT INSIDE LEFTMOST FIELD     UMPL0166
       TLQ EXIT-1                                                       UMPL0167
       SUB ONE                                                          UMPL0168
       STO G7                                                           UMPL0169
       LXD IR4,4        RESTORE REGISTERS                               UMPL0170
EXIT   PXD 0,0          RETURN ZERO, SUCCESSFUL PLOT1,PLOT2,PLOT3,PLOT4 UMPL0171
       LXD IR1,1                                                        UMPL0172
       LXD IR2,2                                                        UMPL0173
       TRA 6,4                                                          UMPL0174
       REM .............................................................UMPL0175
       REM         MAIN JOB OF PLOT2 IS TO REPEATEDLY LAY DOWN SAMPLE   UMPL0176
       REM         GRIDLINE (DASH TO DASH-WORDS+1) FOLLOWED BY (SBH-1)  UMPL0177
       REM         NON-GRID LINES (BLANK TO BLANK-WORDS+1) TO FORM THE  UMPL0178
       REM         GRID IN THE IMAGE REGION                             UMPL0179
PLOT2  SXD IR4,4        ENTRY TO PLOT2                                  UMPL0180
       SXD IR2,2        SAVE REGISTERS                                  UMPL0181
       SXD IR1,1                                                        UMPL0182
       CLA PLADD        PREPARE SWITCH FOR EXIT FROM TSTFP              UMPL0183
       COM                                                              UMPL0184
       STD SAVE4-1           PLOT3 ADD COMPLEMENT IN DEC OF TSTFP EXIT  UMPL0185
       STZ WRON3        WRON3 = 0      CLEAR ERROR FLAG, MISSING PLOT2  UMPL0186
       CLA WRON1                                                        UMPL0187
       TZE *+3                                                          UMPL0188
       CLA FPTWO        WRON1 ERROR FLAG SET, UNSUCCESSFUL PLOT1        UMPL0189
       TRA 6,4          RETURN TWO, UNSUCCESSFUL PLOT2                  UMPL0190
       CLA 1,4          ADDRESS OF THE IMAGE REGION                     UMPL0191
       STA PLT22                                                        UMPL0192
       STA PLT23                                                        UMPL0193
       STA PLT37                                                        UMPL0194
       STA ADDB                                                         UMPL0195
       STZ WRON2        WRON2 = 0      CLEAR ERROR FLAG, PLOT2          UMPL0196
       CLA*    2,4      XMAX, MAXIMUM ABSCISSA (X) VALUE                UMPL0197
       TSX TSTFP,2      TEST FOR FLOATING POINT ARGUMENT                UMPL0198
       STO XMAX                                                         UMPL0199
       CLA*    3,4      XMIN, MINIMUM ABSCISSA (X) VALUE                UMPL0200
       TSX TSTFP,2      TEST FOR FLOATING POINT ARGUMENT                UMPL0201
       STO XMIN                                                         UMPL0202
       CLA*    4,4      YMAX, MAXIMUM ORDINATE (Y) VALUE                UMPL0203
       TSX TSTFP,2      TEST FOR FLOATING POINT ARGUMENT                UMPL0204
       STO YMAX                                                         UMPL0205
       CLA*    5,4      YMIN, MINIMUM ORDINATE (Y) VALUE                UMPL0206
       TSX TSTFP,2      TEST FOR FLOATING POINT ARGUMENT                UMPL0207
       STO YMIN                                                         UMPL0208
       CLS XMIN                                                         UMPL0209
       FAD XMAX                                                         UMPL0210
       STO SPANX        SPANX = XMAX - XMIN      ABSCISSA SPAN          UMPL0211
       SSP                                                              UMPL0212
       SUB     =1E-32                                                   UMPL0213
       TMI BAD          WHENEVER XMIN .GE. XMAX, ERROR RETURN           UMPL0214
       CLS YMIN                                                         UMPL0215
       FAD YMAX                                                         UMPL0216
       STO SPANY        SPANY = YMAX - YMIN      ORDINATE SPAN          UMPL0217
       SSP                                                              UMPL0218
       SUB     =1E-32                                                   UMPL0219
       TMI BAD          WHENEVER YMIN .GE. YMAX, ERROR RETURN           UMPL0220
       CLA LINES                                                        UMPL0221
       TSX FLOAT,2                                                      UMPL0222
       FDP SPANY                                                        UMPL0223
       STQ U            U = LINES/SPANY     NUMBER OF LINES PER UNIT Y  UMPL0224
       CLA TOT                                                          UMPL0225
       TSX FLOAT,2                                                      UMPL0226
       FDP SPANX                                                        UMPL0227
       STQ V            V = TOT/SPANX       NUMBER OF COLUMNS PER UNIT XUMPL0228
       CLA NV                                                           UMPL0229
       TSX FLOAT,2                                                      UMPL0230
       STO TEMP                                                         UMPL0231
       CLA SPANX                                                        UMPL0232
       FDP TEMP                                                         UMPL0233
       STQ DELTX        DETLX = SPANX/NV    X INCR BETWN VERT GRID LINESUMPL0234
       CLA NH                                                           UMPL0235
       TSX FLOAT,2                                                      UMPL0236
       STO TEMP                                                         UMPL0237
       CLA SPANY                                                        UMPL0238
       FDP TEMP                                                         UMPL0239
       STQ DELTY        DELTY = SPANY/NH    Y INCR BETWN HORZ GRID LINESUMPL0240
       STZ I            I=0  INITIALIZE WORD COUNTER FOR IMAGE REGION   UMPL0241
       STZ J            J=0  INITIALIZE LINE COUNTER FOR IMAGE REGION   UMPL0242
TNEXT  STZ K            K=0  INITIALIZE WORD COUNTER FOR HORZ GRID LINE UMPL0243
LNEXT  CLA K            LOOP FROM LNEXT TO NEXT PLACES ONE HORIZONTAL   UMPL0244
       PAX 0,2          GRID LINE IMAGE (DASH REGION) INTO IMAGE REGION UMPL0245
       ADD I                                                            UMPL0246
       PAX 0,4                                                          UMPL0247
       CLA DASH,2                                                       UMPL0248
PLT22  STO **,4                                                         UMPL0249
       CLA K                                                            UMPL0250
       ADD ONE                                                          UMPL0251
       STO K            K = K+1        INCREMENT WORD COUNTER FOR LINE  UMPL0252
       SUB WORDS                                                        UMPL0253
NEXT   TNZ LNEXT        IF NONZERO, LINE IS UNFINISHED                  UMPL0254
       CLA I                                                            UMPL0255
       ADD WORDS                                                        UMPL0256
       STO I            I = I+WORDS    INCR WORD COUNTER FOR NEW LINE   UMPL0257
       CLA NH                                                           UMPL0258
       SUB J                                                            UMPL0259
       TZE EXIT-1       WHENEVER J.E.NH, IMAGE GRID COMPLETED           UMPL0260
       CLA ONE                                                          UMPL0261
       STO TEMP         TEMP = 1  INITIALIZE BETWEEN GRID LINE COUNTER  UMPL0262
TFIN   STZ K            K=0  INITIALIZE WORD COUNTER FOR EACH LINE      UMPL0263
LFIN   CLA K            LOOP FROM TFIN TO FNSH PLACES SBH NON GRID LINE UMPL0264
       PAX 0,2          IMAGES (BLANK REGION) INTO THE IMAGE REGION     UMPL0265
       ADD I                                                            UMPL0266
       PAX 0,4                                                          UMPL0267
       CLA BLANK,2                                                      UMPL0268
PLT23  STO **,4                                                         UMPL0269
       CLA K                                                            UMPL0270
       ADD ONE                                                          UMPL0271
       STO K            K = K+1        INCREMENT WORD COUNTER FOR LINE  UMPL0272
       SUB WORDS                                                        UMPL0273
FIN    TNZ LFIN         IF NONZERO, LINE IS UNFINISHED                  UMPL0274
       CLA I                                                            UMPL0275
       ADD WORDS                                                        UMPL0276
       STO I            I = I+WORDS    INCR WORD COUNTER FOR NEW LINE   UMPL0277
       CLA TEMP                                                         UMPL0278
       ADD ONE                                                          UMPL0279
       STO TEMP         TEMP = TEMP+1  INCREMENT BETWN GRID LINE COUNTERUMPL0280
       SUB SBH                                                          UMPL0281
FNSH   TNZ TFIN         IF NONZERO, MORE NON GRID LINES ARE REQUIRED    UMPL0282
       CLA J                                                            UMPL0283
       ADD ONE                                                          UMPL0284
       STO J            J = J+1   INCREMENT LINE COUNT FOR IMAGE REGION UMPL0285
NTEEN  TXL TNEXT,0,COL/6-1   RETURN FOR ANOTHER HORIZONTAL GRID LINE    UMPL0286
BAD    CLA FPTWO        RETURN TWO, UNSUCCESSFUL PLOT2                  UMPL0287
       STO WRON2        SET ERROR FLAG, PLOT2                           UMPL0288
       CLA     ER2                                                      UMPL0289
       STO     WRONG                                                    UMPL0290
WRITE  SXA     *+4,4                                                    UMPL0291
       STO     AC                                                       UMPL0292
       CALL SPRINT           WRITE ERROR COMMENT FOR WRONG              UMPL0293
       PZE WRONG,4           PLOT1 OR PLOT2 ARGUMENT                    UMPL0294
       AXT     0,4                                                      UMPL0295
       CLA     AC                                                       UMPL0296
INDX1  TXL EXIT+1,0,**                                                  UMPL0297
ERR3   SXA     *+4,4                                                    UMPL0298
       STO     AC                                                       UMPL0299
       CALL SPRINT           WRITE ERROR COMMENT FOR PLOT3 ARGUMENT     UMPL0300
       PZE     ER3,,3                                                   UMPL0301
       AXT     0,4                                                      UMPL0302
       CLA     AC                                                       UMPL0303
       TXL EXIT+1,0,    RETURN, REGISTER 4 UNCHANGED                    UMPL0304
       REM .............................................................UMPL0305
       REM         PLOT3 EXAMINES THE DATA POINT TO MAKE SURE IT IS     UMPL0306
       REM         FLOATING POINT AND THEN PLACES IT IN THE PROPER SPOT UMPL0307
       REM         IN THE IMAGE REGION                                  UMPL0308
PLOT3  SXD IR4,4        ENTRY TO PLOT3                                  UMPL0309
       SXD IR2,2        SAVE REGISTERS                                  UMPL0310
       SXD IR1,1                                                        UMPL0311
       STZ FLAG1        FLAG1 = 0      PLOT3 RETURN PRESET TO ZERO      UMPL0312
       CLA 1,4          BCD, ADDRESS OF THE PLOTTING CHARACTER          UMPL0313
       STA PLT36                                                        UMPL0314
       CLA 2,4          X,   BASE ADDRESS FOR X COORDINATES             UMPL0315
       STA PLT35                                                        UMPL0316
       CLA 3,4          Y,   BASE ADDRESS OF THE Y COORDINATES          UMPL0317
       STA PLT34                                                        UMPL0318
       CLA WRON1                                                        UMPL0319
       ORA WRON2                                                        UMPL0320
       TZE *+3                                                          UMPL0321
       CLA FTHRE        WRON1 OR WRON2 ERROR FLAG SET,BAD PLOT1 OR PLOT2UMPL0322
       TRA 5,4          RETURN THREE, UNSUCCESSFUL PLOT3                UMPL0323
       ORA WRON3                                                        UMPL0324
       TZE *+3                                                          UMPL0325
       CLA FTHRE        WRON3 ERROR FLAG SET, NO PREVIOUS PLOT2         UMPL0326
       TXI ERR3,4,1     RETURN THREE, UNSUCCESSFUL PLOT3                UMPL0327
       CLA*    4,4      NDATA, NUMBER OF DATA POINTS TO BE PLOTTED      UMPL0328
       TSX FIX,2                                                        UMPL0329
       TNZ *+3                                                          UMPL0330
       CLS FTHRE        IF NDATA = 0, NO DATA POINTS. RETURN MINUS THREEUMPL0331
       TRA 5,4                                                          UMPL0332
       STO NDATA                                                        UMPL0333
       STZ K            K=0       INITIALIZE DATA POINT COUNTER         UMPL0334
LTEND  LXA K,1                                                          UMPL0335
PLT34  CLS **,1         Y(K)      Y COORDINATE OF (K+1)TH DATA POINT    UMPL0336
       TSX TSTFP,2      TEST FOR FLOATING POINT ARGUMENT                UMPL0337
       FAD YMAX                                                         UMPL0338
       LRS 35                                                           UMPL0339
       FMP U                                                            UMPL0340
       TPL *+3                                                          UMPL0341
       FSB N05                                                          UMPL0342
       TXL *+2,0,                                                       UMPL0343
       FAD N05                                                          UMPL0344
       TSX FIX1,2                                                       UMPL0345
       STO I            I=(YMAX-Y(K))*U +OR- 0.5, LINE INDEX FOR DATA PTUMPL0346
       TZE *+5          Y COORDINATE LIES ON TOP GRID LINE              UMPL0347
       TMI THEND-2      REJECT POINT, LIES ABOVE TOP GRID LINE          UMPL0348
       SUB LINES                                                        UMPL0349
       TZE *+2          Y COORDINATE LIES ON BOTTOM GRID LINE           UMPL0350
       TPL THEND-2      REJECT POINT, LIES BELOW BOTTOM GRID LINE       UMPL0351
PLT35  CLA **,1         X(K)      X COORDINATE OF (K+1)TH DATA POINT    UMPL0352
       TSX TSTFP,2      TEST FOR FLOATING POINT ARGUMENT                UMPL0353
       FSB XMIN                                                         UMPL0354
       LRS 35                                                           UMPL0355
       FMP V                                                            UMPL0356
       TPL *+3                                                          UMPL0357
       FSB N05                                                          UMPL0358
PLADD  TXL *+2,0,PLOT3       (ADDRESS OF PLOT3 IN DECREMENT)            UMPL0359
       FAD N05                                                          UMPL0360
       TSX FIX1,2                                                       UMPL0361
       STO J            J=(X(K)-XMIN)*V +OR- 0.5, COL INDEX FOR DATA PT UMPL0362
       TZE *+5          X COORDINATE LIES ON LEFTMOST GRID LINE         UMPL0363
       TMI THEND-2      REJECT POINT, LIES TO LEFT OF LEFTMOST GRID LINEUMPL0364
       SUB TOT                                                          UMPL0365
       TZE *+2          X COORDINATE LIES ON RIGHTMOST GRID LINE        UMPL0366
       TPL THEND-2      REJECT POINT, LIES TO RIGHT OF RIGHT GRID LINE  UMPL0367
       LDQ TOTLS                                                        UMPL0368
       MPY I                                                            UMPL0369
       LLS 35                                                           UMPL0370
       ADD J                                                            UMPL0371
       STO L            L=TOTLS*I+J, CHARACTER POSITION IN IMAGE REGION UMPL0372
       TSX PLACE,4      PLACES PLOTTING CHARACTER BCD IN THE L TH       UMPL0373
PLT36  TXH **           CHARACTER POSITION OF THE IMAGE REGION          UMPL0374
       TXH L                                                            UMPL0375
PLT37  TXH **,0,-1                                                      UMPL0376
FOUR   TXL *+3,0,4                                                      UMPL0377
       CLS FTHRE                                                        UMPL0378
       STO FLAG1        FLAG1=-3, PLOT3 RETURN SET FOR REJECTED POINT   UMPL0379
THEND  CLA K                                                            UMPL0380
       ADD ONE                                                          UMPL0381
       STO K            K=K+1     INCREMENT DATA POINT COUNTER          UMPL0382
       SUB NDATA                                                        UMPL0383
       TNZ LTEND        IF NONZERO, MORE DATA POINTS TO BE PLOTTED      UMPL0384
       CLA FLAG1        PLOT3 RETURN                                    UMPL0385
       LXD IR4,4        RESTORE REGISTER 4                              UMPL0386
       TXI EXIT+1,4,1   INCREMENT REGISTER 4 AND RETURN                 UMPL0387
       REM .............................................................UMPL0388
       REM         PLOT4 DECOMPOSES THE STRING OF CHARACTERS IN LABEL   UMPL0389
       REM         AND WRITES THE CURRENT GRAPH ON TAPE OTAPE           UMPL0390
FPLOT4 CLA PLT37        ENTRY TO PLOT4, LABEL STORED FORWARD            UMPL0391
       TXL PLOT4+1,0,                                                   UMPL0392
PLOT4  CLA ONED         ENTRY TO PLOT4, LABEL STORED BACKWARD           UMPL0393
       STD PLT42-1      DECREMENT (-1 FORWARD), (+1 BACKWARD)           UMPL0394
       SXD IR4,4        SAVE REGISTERS                                  UMPL0395
       SXD IR2,2                                                        UMPL0396
       SXD IR1,1                                                        UMPL0397
       CLA WRON1                                                        UMPL0398
