       REM    TPOWR RAISES  10 TO THE INTEGRAL POWER N (N MAY BE +OR-)  UMPL0873
       REM                                                              UMPL0874
TPOWR  LDQ FPONE        ENTRY TO TPOWR      CALLING SEQUENCE IS         UMPL0875
       STQ Q                                  CLA N                     UMPL0876
       PAX 0,4                                TSX TPOWR,2               UMPL0877
       TXH *+3,4,0                          FLT PT RESULT IS IN ACC     UMPL0878
       CLA FPONE        ARG = 0             N MUST BE A SIGNED INTEGER  UMPL0879
       TRA 1,2          RETURN 1.           IN THE ADDRESS              UMPL0880
       TMI NGARG                                                        UMPL0881
       LDQ Q                                                            UMPL0882
       FMP FTEN                                                         UMPL0883
       STO Q                                                            UMPL0884
       TIX *-3,4,1                                                      UMPL0885
       TRA 1,2          RETURN FOR ARG .G. 0                            UMPL0886
NGARG  CLA Q                                                            UMPL0887
       FDP FTEN                                                         UMPL0888
       STQ Q                                                            UMPL0889
       TIX *-3,4,1                                                      UMPL0890
       CLA Q                                                            UMPL0891
       TRA 1,2          RETURN FOR ARG .L. 0                            UMPL0892
