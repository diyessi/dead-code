       FMP Q                                                            UMPL0809
       FAD Z                                                            UMPL0810
       STO Z            Z = Z - Q*TEMP                                  UMPL0811
       TXL STATA,0,     GO BACK AND TRY AGAIN                           UMPL0812
ONWD   CLA TEMP                                                         UMPL0813
       TSX FIX,2                                                        UMPL0814
       STO CHAR         CHAR = INTEGRAL PART OF Z/P                     UMPL0815
       TSX FLOAT,2                                                      UMPL0816
       LRS 35                                                           UMPL0817
       FMP P            ACCUMULATOR = CHAR*P                            UMPL0818
       CHS                                                              UMPL0819
       FAD Z            Z = Z - ACCUMULATOR                             UMPL0820
       STO Z                                                            UMPL0821
       CLA P                                                            UMPL0822
       FDP FTEN                                                         UMPL0823
       STQ P            P = P/10.                                       UMPL0824
       CLA NINE         WHEN CHAR .LE. 9, IT IS SMALL ENOUGH TO FIT     UMPL0825
       SUB CHAR         INTO ONE TYPEWHEEL                              UMPL0826
       TPL ALRIT                                                        UMPL0827
       STZ BOOL                                                         UMPL0828
       PXD 0,0          OTHERWISE (WHEN CHAR WONT FIT INTO ONE          UMPL0829
       LDQ CHAR         TYPEWHEEL) IT MUST BE TRUNCATED FROM LEFT       UMPL0830
       DVP TEN          FIRST PRINTED DIGIT IS THE REMAINDER IN THE     UMPL0831
       STO CHAR         ACCUMULATOR                                     UMPL0832
ALRIT  CLA BOOL         WHEN BOOL = 0, SOME NON-BLANK CHAR HAS ALREADY  UMPL0833
       TZE STLST        BEEN PLACED, SO CHAR MUST BE PLACED EVEN IF 0   UMPL0834
       CLA CHAR         WHEN CHAR = 0 (AND NO NON-BLANK CHAR HAS BEEN   UMPL0835
       TZE STOBK        PLACED,YET) BYPASS THE PLACING OF 0             UMPL0836
       CLA SI                                                           UMPL0837
       SUB N2           SINCE CHAR = NONZERO, SEE IF THERE IS ROOM TO   UMPL0838
       TPL STATC        PLACE LEADING SIGN (I.E. SI .L. N2)             UMPL0839
       CLA COUNT                                                        UMPL0840
       SUB ONE                                                          UMPL0841
       STO TEMP                                                         UMPL0842
       TSX PLACE,4      PLACE LEADING SIGN IN TYPEWHEEL COUNT-1         UMPL0843
       TXH SIGN                                                         UMPL0844
       TXH TEMP                                                         UMPL0845
       TXH REG                                                          UMPL0846
STATC  STZ BOOL         NON-BLANK CHAR HAS BEEN PLACED  BOOL = 0        UMPL0847
STLST  LDQ CHAR         MAKE CHAR (WHICH IS INTEGER LESS THAN 10)       UMPL0848
       RQL 30                LEFT ADJUSTED BCD CHARACTER                UMPL0849
       STQ TEMP                                                         UMPL0850
       TSX PLACE,4      PLACE CHAR IN TYPEBAR COUNT                     UMPL0851
       TXH TEMP                                                         UMPL0852
       TXH COUNT                                                        UMPL0853
       TXH REG                                                          UMPL0854
STOBK  CLA COUNT                                                        UMPL0855
       ADD ONE                                                          UMPL0856
       STO COUNT        COUNT = COUNT + 1                               UMPL0857
       CLS ONE                                                          UMPL0858
       ADD SI                                                           UMPL0859
       STO SI           SI = SI - 1                                     UMPL0860
       TPL LOOPA        WHEN SI .G. 0, REPEAT LOOP                      UMPL0861
       CLA BOOL         WHEN EXIT FROM LOOP WITH NO NONBLANK CHAR PLACEDUMPL0862
       TZE THRU         MUST BE INTEGER 0                               UMPL0863
       CLA COUNT                                                        UMPL0864
       SUB ONE          COUNT = COUNT - 1                               UMPL0865
       STO COUNT                                                        UMPL0866
       STZ TEMP         MAKE CHAR TO BE PLACED A $0$ (BCD 0)            UMPL0867
       STZ BOOL         BOOL = 0 TO EXIT FROM LOOP NEXT TIME            UMPL0868
INDX2  TXL STLST+3,0,** TRANSFER BACK TO PLACE THE $0$                  UMPL0869
THRU   LXD SIR4,4                                                       UMPL0870
       TRA 1,4          RETURN                                          UMPL0871
