       AXT     36,2                FIXUP BIT SHIFT COUNTER              IOP07470
 LPP3  SXA     QTEMP,4             SAVE IX4 FOR OUTPUT                  IOP07480
       AXT     3,4                                                      IOP07490
 LPP2  AXT     0,1                 FIXUP INPUT COUNTER                  IOP07500
 LPP1  TXI     *+1,1,2             ADD 2 TO COUNTER                     IOP07510
 ADFX1 LDQ     --,1                BRING UP WORD                        IOP07520
       RQL     36,2                KNOCK OFF BITS NOT NEEDED            IOP07530
       LGL     1                   SHIFT BIT INTO AC                    IOP07540
