*      FAP                                                              IOP00000
*     LABEL(IOSIM)                                                      IOP00010
*      SIMULATION OF 709 INPUT/OUTPUT ON THE --7040/44                  IOP00011
*                               A.S. FARHA           SEPT 1962          IOP00012
*              ADDRESS-NORTH AMERICAN AVIATION BLD. 6                   IOP00013
*                      5300 EAST 5TH AVE.                               IOP00014
*                      COLUMBUS, OHIO                                   IOP00015
       PCC     ON                                                       IOP00020
       PMC     ON                                                       IOP00030
       ENTRY   IOSIM                                                    IOP00040
 TDOA  OPD     -106071140000       TRA CHAN A IN OPERATION              IOP00050
 SEN   OPD     -176273140002       SENSE COMMAND                        IOP00060
 PWR   OPD     -176673140002       PRE WRITE TYPE.                      IOP00070
 PCS   OPD     -150573140002       PLACE CHARACTER FROM STORAGE         IOP00080
 SAC   OPD     -162373140002       STORE ACCUMULATOR CHARACTER          IOP00090
 TSL   OPD     -162771140000       TRANSFER AND SET LOCATION.           IOP00100
 MSM   OPD     -162371140000                                            IOP00110
 MIT   OPD     -134171140000                                            IOP00120
 PLT   OPD     -134171140000                                            IOP00130
 RDCB  OPD     076071140000        RESET DATA CHAN.                     IOP00140
 RDCC  OPD     076071140000                                             IOP00150
*      ACKNOWLEDGEMENT-SOME OF THE IDEAS AND CONCEPTS USED IN THIS      IOP00151
*                      SIMULATOR WERE CONTRIBUTED BY VINCE SPRAGUE NAA  IOP00152
*                      AND J.H. BRAUN IBM.                              IOP00153
*                                                                       IOP00160
*      THIS IS A PROGRAM THAT SIMULATES THE 709 IO ON THE 7044          IOP00170
*      ALL TAPE COMMANDS THAT USED CHANNEL-A-ON THE 709 HAVE BEEN       IOP00180
*      CHANGED TO USE CHAN -B-ON THE 7044 CHAN -B-S HAVE BEEN           IOP00190
*      CHANGED TO USE CHAN -C-.                                         IOP00200
*      THE FOLLOWING IS THE LIST OF COMMANDS THAT WERE SIM.             IOP00210
*      RDS,WRS,RCHA,RCHB,LCHA,LCHB,SCH,TCNA,TCNB,THE NEXT COMMANDS HAD  IOP00220
*      BE SIMULATED IN ORDER TO CHANGE THE CHANS FROM A TO B            IOP00230
*      BSR,BSF,WEF,REW,TCOA,TCOB,TRCA,TRCB,TEFA,TEFB,ETT                IOP00240
*      PRINTER,READER AND PUNCH COMMANDS WERE LEFT ON CHAN-A-           IOP00250
 IOSIM CLA     ADD33               SETUP ENTRY FOR SIMULATOR            IOP00260
       STO     27                                                       IOP00270
       TRA     1,4                                                      IOP00280
 ADD33 TRA     TBSTR                                                    IOP00290
 OUT4  TSL     RA4)                RESTORE CONDITIONS                   IOP00300
       PLT     QSWT9,,7                                                 IOP00310
       TRA*    26                                                       IOP00320
       TRA*    12                                                       IOP00330
 PXA   PXA     0,0,0                                                    IOP00340
 CCS   OPD     -134173140002       COMPARE CHARACTER WITH STORAGE       IOP00350
 IORD  MACRO   A,B,C                                                    IOP00360
       TXH     A,B,C                                                    IOP00370
 IORD  END                                                              IOP00380
 RA4)  TRA     --                                                       IOP00390
       CAL     AREGS+1             RESTORE AC WITHOUT TURNING ON        IOP00400
       ANA     =O-0                OVERFLOW LIGHTS                      IOP00410
       ALS     1                                                        IOP00420
       ORA     AREGS                                                    IOP00430
       STQ     AREGS                                                    IOP00440
       LDQ     AREGS+2                                                  IOP00450
       LLS     0                                                        IOP00460
       LDQ     AREGS                                                    IOP00470
 IX4   AXT     --,4                                                     IOP00480
       TRA*    RA4)                                                     IOP00490
 AREGS BSS     3                   LOCATIONS FOR AC  SAVING.            IOP00500
*      THIS IS THE TABLE THAT WILL GET TO PROPER ROUTINE                IOP00510
 SACI4 TRA     --                  SAVE CONDITIONS                      IOP00520
       SLW     AREGS               SAVE A-REG                           IOP00530
       ARS     1                   SAVE P BIT                           IOP00540
       STO     AREGS+2                                                  IOP00550
       SLW     AREGS+1                                                  IOP00560
       SXA     IX4,4               SAVE IX4                             IOP00570
       TRA*    SACI4                                                    IOP00580
 TBSTR TCOB    *                                                        IOP00590
       TCOC    *                                                        IOP00600
       TSL     SACI4                                                    IOP00610
       LAC     26,4                                                     IOP00620
       CLA     -1,4                                                     IOP00630
       MSM     QSWT9,,6             ON NOT TRAP                         IOP00640
 TSTPL TPL     XEXFX               TEST FOR XEC COMMAND                 IOP00650
       ANA     =O000077777777      ANA IN REST OF COMMAND               IOP00660
       PDX     0,4                                                      IOP00670
       TNX     *+3,4,31            GET RID EXTRA BIT                    IOP00680
       ORA     =O000060000000      OR IN INDIRECT BITS                  IOP00690
       TXI     *+1,4,-1                                                 IOP00700
       TXH     ERHLT,4,20          TEST FOR ERROR                       IOP00710
       TRA*    TBSTB,4                                                  IOP00720
 XEXFX SUB     =O002200000000      CHANGE TO CLA                        IOP00730
       LXA     IX4,4               RESTORE IX4                          IOP00740
       STO     *+1                                                      IOP00750
       CLA     --                  BRING UP NEXT ADDRESS                IOP00760
       TRA     TSTPL                                                    IOP00770
 ERHLT HPR     32767               ILLEGAL IO FOR SIMULATOR             IOP00780
       TRA     ERHLT                                                    IOP00781
*      THE FOLLOWING IS THE TABLE FOR THE COMMANDS THAT ARE SIMULATED.  IOP00790
       TRA     ETT                 BEGINNING OF TABLE                   IOP00800
       TRA     TEFB                THIS TABLE MUST BE KEPT IN ORDER.    IOP00810
       TRA     TEFA                                                     IOP00820
       TRA     TRCB                                                     IOP00830
       TRA     TRCA                                                     IOP00840
       TRA     TCOB                                                     IOP00850
       TRA     TCOA                                                     IOP00860
       TRA     REW                                                      IOP00870
       TRA     WEF                                                      IOP00880
       TRA     BSF                                                      IOP00890
       TRA     BSR                                                      IOP00900
       TRA     TCNB                                                     IOP00910
       TRA     TCNA                                                     IOP00920
       TRA     SCH                                                      IOP00930
       TRA     LCHB                                                     IOP00940
       TRA     LCHA                                                     IOP00950
       TRA     RCHB                                                     IOP00960
       TRA     RCHA                                                     IOP00970
       TRA     WRS                                                      IOP00980
 TBSTB TRA     RDS                 TABLE OF STIMULATE COMMANDS          IOP00990
*      THE FOLLOWING ARE THE SWITCHS USED NON ZERO EQUALS ON AND VISA   IOP01000
 QSWT1 PZE     0,,0                SWITCH FOR READ OR WRITE             IOP01010
 QSWT2 PZE     0,,0                SWITCH FOR CHAN A OR B               IOP01020
 QSWT3 PZE     0,,0                SWIT FOR IO COUNT OR RECORD          IOP01030
 QSWT4 PZE     0,,0                SWIT FOR PRINT RD OR PUNCH           IOP01040
 QSWT5 PZE     0,,0                SWIT TELLS IF IO COM WAS IOXT        IOP01050
 QSWT6 PZE     0,,0                TELLS IF LAST IO WAS SCATTER IO      IOP01060
 QSWT7 PZE     0,,0                ON IF IO IS NON TRANS COMMAND        IOP01070
 QSWT8 PZE     0,,0                FOR IOCDS WITH ZERO COUNT            IOP01080
 QSWT9 PZE     0,,0                SWITCH FOR CHANNEL TRAPS             IOP01090
 QSW10 PZE     0,,0                SWITCH FOR SELECT EXECUTION          IOP01100
 QTEMP PZE     0,,0                A TEMP STORAGE LOCATION              IOP01110
       REM                                                              IOP01120
*                                                                       IOP01130
*      ROUTINES FOR THE RDS AND WRS                                     IOP01140
 RDS   STZ     QSWT1               SET SWITCH OFF FOR READ              IOP01150
       TSL     RETRZ                                                    IOP01160
       ORA     RDSZ                ORA IN DUMMY RDS                     IOP01170
       LXD     QSW10,4             TEST IF LAST SELECT WAS EXECUTED     IOP01180
       TXL     *+2,4,0                                                  IOP01190
       XEC     QRDST               IF NOT EXECUTE IT                    IOP01200
       STO     QSW10               TURN SWITCH ON                       IOP01210
       SLW     QRDST               STO AWAY TOBE PROC LATER             IOP01220
       TRA     OUT4                EXIT                                 IOP01230
 RDSZ  RDS     0,,0                DUMMY RDS COMMAND                    IOP01240
*THIS IS ROUTINE FOR PERFORMING RDS AND WRS                             IOP01250
 QRDWR TRA     -                   RETURN ADDRESS                       IOP01260
       CAL     QSWT4               TEST FOR PERF GEAR                   IOP01270
       TNZ*    QRDWR               PERF GEAR SO RETURN.                 IOP01280
       CAL     QSWT2               TEST FOR CHAN A OR B                 IOP01290
       TNZ     *+4                                                      IOP01300
       TCOB    *                                                        IOP01310
       RDCB    1258                THIS ISNT ON 709 OR IN S40           IOP01320
 QRDST RDS     --,,--              EXCUTE READ OR WRITE SELECT.         IOP01330
 QSKIP TRA*    QRDWR               RETURN                               IOP01340
       TCOC    *                                                        IOP01350
       RDCC    1770                THIS ISNT ON 709 OR IN S40           IOP01360
       TRA     *-4                                                      IOP01370
*                                                                       IOP01380
 WRS   STO     QSWT1               TURN SWICH ON FOR WRITE              IOP01390
       TSL     RETRZ                                                    IOP01400
       ORA     WRSZ                OR IN WRS COMMAND                    IOP01410
       TRA     RDS+3               STO WD AND EXIT                      IOP01420
 WRSZ  WRS     0,,0                DUMMY WRS COMMAND                    IOP01430
*                                                                       IOP01440
*      THIS ROUTINE FIXS UP ADDRESS FOR RDS ETC                         IOP01450
*      ALSO TESTS TO SEE IF COMMAND USES PRINT READER OR PUNCH          IOP01460
*      IF IT USES ON LINE PERF GEAR IT LEAVES INSTR ON CHAN-A-          IOP01470
       STO     QSWT4               SWIT ON FOR PERF                     IOP01480
       CAL     QADDR               PUT NEW ADDRESS IN AC                IOP01490
 RETRZ TRA     --                  RETURN ADDRESS                       IOP01500
       ORA     PXA                 OR IN PXA COMMAND                    IOP01510
       SLW     *+2                                                      IOP01520
       LXA     IX4,4               RESTORE IX4                          IOP01530
       PXA     --,--               PUT IX AC                            IOP01540
       ANA     =O777                                                    IOP01550
       SUB     *-2                 SUB ADDRESS FROM IX                  IOP01560
       STA     QADDR               STORE NEW ADDRESS AWAY               IOP01570
       STZ     QSWT4               TURN THE SWITCH OFF                  IOP01580
       CLS     =O13                TEST FOR PERF GEAR                   IOP01590
       CCS     QADDR,,4                                                 IOP01600
       TRA     *+2                                                      IOP01610
       TRA     RETRZ-2             IF YES EXIT                          IOP01620
       CAL     QADDR               IF NOT ADD 1 TO CHANNEL              IOP01630
       ADD     =O1000                                                   IOP01640
       TRA*    RETRZ                                                    IOP01650
 QADDR PZE     --,0                FILL IN ADDRESS HERE                 IOP01660
*                                                                       IOP01670
*      RCH ROUTINE IT SIMULATES RCH AND SETS IO COMMAND FOR EXECUTION   IOP01680
 RCHA  STZ     QSWT2               SWITCH OFF FOR A                     IOP01690
       STZ     QSWT6               OFF PREVIOUS COMMAND NOT PROCEED     IOP01700
       STZ     QSWT8               SWITCH  OFF                          IOP01710
       ORA     QLOGA               PUT ADDR OF RCH IN CAL               IOP01720
       SLW     *+2                                                      IOP01730
 QRELD LXA     IX4,4               RESTORE IX4                          IOP01740
       CAL     --                  BRING UP IO COMMAND                  IOP01750
       SLW     QIORD               STO IO COMMAND AWAY                  IOP01760
       SLW     ORGIO               SAVE ORIGINAL IO COMMAND             IOP01770
       ARS     15                                                       IOP01780
       PDC     ,4                  PUT COMP OF OP CODE IN IX            IOP01790
       STZ     QSW10               TURN SELECT SWITCH OFF               IOP01800
       STZ     QSWT7               THE FOL TESTS NON TRANS AND          IOP01810
       ARS     1                   ALSO PUTS ZEROS IN 18 19             IOP01820
       LBT                         OF THE IORD COMMAND.                 IOP01830
       TRA     *+2                                                      IOP01840
       STO     QSWT7               SWICH ON NON TRANS CODE              IOP01850
       CAL     =O077777077777                                           IOP01860
       ANA     QIORD               PUT ZEROS 18 AND 19                  IOP01870
       ORA     =3B2                CLA IORD INTO A REG                  IOP01880
       STO     QIORD                                                    IOP01890
       STZ     QSWT5               TURN SWITCH OFF FOR IOXT             IOP01900
       TRA*    QIOTB,4             TRA TO RIGHT IO COMMAND              IOP01910
 QLOGA CAL     0,,0                DUMMY CAL                            IOP01920
 QIOTB TRA     IOCD                THIS IS TABLE THAT WILL              IOP01930
       TRA     TCH                 TRA TO PROPER IO ROUTINE.            IOP01940
       TRA     IORP                                                     IOP01950
       TRA     IORT                                                     IOP01960
       TRA     IOCP                                                     IOP01970
       TRA     IOCT                                                     IOP01980
       TRA     IOSP                                                     IOP01990
       TRA     IOST                                                     IOP02000
 RCHB  STO     QSWT2               SWITCH ON RCHB                       IOP02010
       TRA     RCHA+1                                                   IOP02020
 QIORD PZE     0,,0                LOC FOR 7044 NEW IO                  IOP02030
 ORGIO PZE     0,,0                LOCATION FOR ORIGINAL IOCOM          IOP02040
*      THIS ROUTINE EXECUTES RCH COMMANDS IT ALSO DOES SCH              IOP02050
       TSL     SACI4               SAVE CONDITIONS                      IOP02060
       STZ     QSWT9               OFF FOR TRAP                         IOP02070
 QRCHI TRA     *                   RETURN ADDRESS                       IOP02080
       CAL     QSWT2               TEST A OR B                          IOP02090
       TNZ     QRCHC               IF B GO TO CHAN C OP                 IOP02100
       CAL     QSWT4               TEST FOR PERF GEAR                   IOP02110
       TNZ     RCHQP               TRA IF PERF GEAR USED                IOP02120
       CLA     TRADR               STORE TRAP  RETURN                   IOP02130
       STO     13                                                       IOP02140
       TSL     RA4)                RESTORE CONDTIONS                    IOP02150
       RCHB    QIORD               EXECUTE RCH ON CHAN B                IOP02160
       ENB     2                   ENABLE TRAP CHAN-B-                  IOP02170
       TRA     OUT4+1              RETURN TO USER                       IOP02180
 TRAPB TCOB    *                                                        IOP02190
       SCHB    QSCHX               SAVE REGISTERS                       IOP02200
       TRA     QRCHI-2             RETURN                               IOP02210
 RCHQP CLA     =O1361              TEST FOR PRINTER                     IOP02220
       CAS     QADDR               COMPARE WITH ADDRESS OF RDS          IOP02230
       TRA     *+3                 NOT PRINTER                          IOP02240
       TRA     PRTTP               YES PRINTER                          IOP02250
       TRA     PRTTP               YES PRINTER                          IOP02260
       SUB     =O1321                                                   IOP02270
       TZE     RDORD               TRA TO READER ROUTINE                IOP02280
       TRA     PNCRT               TRA TO PUNCH ROUTINE                 IOP02290
       TRA*    QRCHI                                                    IOP02300
 QRCHC CLA     TRADR+1                                                  IOP02310
       STO     15                                                       IOP02320
       TSL     RA4)                RESTORE CONDITIONS                   IOP02330
       RCHC    QIORD               EXECUTE RCH ON CHAN-C-               IOP02340
       ENB     4                                                        IOP02350
       TRA     OUT4+1                                                   IOP02360
 TRAPC TCOC    *                                                        IOP02370
       CLA     14                                                       IOP02380
       STO     12                                                       IOP02390
       SCHC    QSCHX                                                    IOP02400
       TRA     QRCHI-2             RETURN                               IOP02410
 QSCHX PZE     0,,0                LOC FOR STORE CHANNELS               IOP02420
 TRADR TRA     TRAPB               CHANNEL TRAPING INSTRUCTIONS         IOP02430
       TRA     TRAPC                CHANGE WITH CAUTION                 IOP02440
       REM                                                              IOP02450
*      LOAD CHANNEL SIMULATING ROUTINE                                  IOP02460
 LCHA  STZ     QSWT2               TURN OFF SWT FOR CHAN-A-             IOP02470
       ORA     QLOGA                                                    IOP02480
       SLW     QRELD+1                                                  IOP02490
       CAL     QSWT5               TEST IF LST COM WAS IOCT             IOP02500
       TNZ     QRELD               IORT OR IOST                         IOP02510
*      IF POSSIBLE IO LIGHT SHOULD BE TURNED ON                         IOP02520
       TRA     QEXI                RETURN TOMAIN PROGRAM                IOP02530
 LCHB  STO     QSWT2               SWITCH ON FOR CHAN B                 IOP02540
       TRA     LCHA+1                                                   IOP02550
*                                                                       IOP02560
*      ALL THE IOCP,IOSP,IOCT AND IOST SETUP SWITS AN GO SCATTER ROUTINEIOP02570
*      THEIR SETUP ROUTINES FOLLOW                                      IOP02580
 IOCP  STO     QSWT3               SWITCH ON FOR COUNT COMMAND          IOP02590
       TRA     *+2                                                      IOP02600
 IOSP  STZ     QSWT3               SWIT OFF FOR RECORD COMMAND          IOP02610
       STZ     QSWT5               OFF FOR PROCEED                      IOP02620
       STO     QSWT6               ON FOR SCATTER COMMAND               IOP02630
       CAL     QSWT1               TEST RD OR WRITE                     IOP02640
       TZE     QSCAT               IF READ SWITCH OK                    IOP02650
       STO     QSWT3               IF WRT REC AN CNT COM SAME           IOP02660
       TRA     QSCAT                                                    IOP02670
 IOCT  STO     QSWT3               ON FOR COUNT COMMAND                 IOP02680
       TRA     IOST+1                                                   IOP02690
 IOST  STZ     QSWT3               OFF FOR REC COMMAND                  IOP02700
       STO     QSWT5               ON FOR TRA COMMAND                   IOP02710
       TRA     IOSP+2                                                   IOP02720
*      ROUTINE FOR IOCD FOLLOWS                                         IOP02730
 IOCD  STO     QSWT3               TURN SWT ON FOR CNT                  IOP02740
       CAL     QSWT6               TEST PREVIOUS IO SCATTER COM         IOP02750
       TNZ     QFXZ3                                                    IOP02760
       CAL     QSWT8               TEST IF PROCEED                      IOP02770
       TNZ     TSTZR                                                    IOP02780
 RETST TSL     IOCK                TRA TO FIX UP IF NON TRANS           IOP02790
       TSL     QRDWR               EXCUTE RDS OR WRS                    IOP02800
       TSL     QRCHI               EXCUTE RCH                           IOP02810
       TSL     WDPR                GO SUB ROUT WORDS TO PROC            IOP02820
       TMI     *+2                 IF MINUS EXECUTE RDS OVER            IOP02830
       TRA     QEXI                EXIT                                 IOP02840
       TSL     QRDWR               XEC THE RDS OR WRS                   IOP02850
       TRA     *-5                 RETURN RCH TEST                      IOP02860
 QFXZ3 CLA     QSWT1               TST WRITE COMMAND IF IS              IOP02870
       TZE     QSCAT-1             MAKE LOOK LIKE REC COMMAND.          IOP02880
       STZ     QSWT3                                                    IOP02890
       TRA     QSCAT-1                                                  IOP02900
 TSTZR LXD     QIORD,4              TEST ZERO WORD COUNT                IOP02910
       TXL     QEXI,4,0            EXIT IF ZERO                         IOP02920
       TRA     RETST               RETURN  NON ZERO                     IOP02930
*      ROUTINE TO CONVERT IORP                                          IOP02940
 IORP  STZ     QSWT5               SWT OFF FOR PROCEED                  IOP02950
       STZ     QSWT3               SWT OFF FOR RECORD COMMAND           IOP02960
       CAL     QSWT6               TEST PREVIOUS COMMAND SCATTER        IOP02970
       TNZ     QSCAT-1                                                  IOP02980
       TSL     IOCK                CHECK FOR NULL COMMAND               IOP02990
       TSL     QRDWR               EXECUTE RDS OR WRS                   IOP03000
       TSL     QRCHI               TRA TO RCH                           IOP03010
       STZ     QSWT6                                                    IOP03020
 QPROX LXA     QRELD+1,4           FIXUP NEXT IO COMMAND                IOP03030
       TXI     *+1,4,1             ADD 1 FOR NEXT ADDRESS               IOP03040
       SXA     QRELD+1,4                                                IOP03050
       SXA     QSWT8,4              TURN SWITCH ON                      IOP03060
       TRA     QRELD               RET FOR NEXT IO                      IOP03070
*      ROUTINE TO CONVERT IORT                                          IOP03080
 IORT  STO     QSWT5               TURN ON FOR TRANS COMMAND            IOP03090
       STZ     QSWT3               SET TO ZERO FOR RECORD               IOP03100
       CAL     QSWT6               TEST LAST COMMAND SCATTER            IOP03110
       TNZ     QSCAT-1                                                  IOP03120
       TSL     IOCK                CHECK FOR NULL                       IOP03130
       TSL     QRDWR                                                    IOP03140
       TSL     QRCHI                                                    IOP03150
       STZ     QSWT6                                                    IOP03160
       TRA     OUT4                EXIT                                 IOP03170
*      ROUTINE FOR TCH COMMAND                                          IOP03180
 TCH   CAL*    QIORD               SETUP CAL INSTRUC TO PICKUP          IOP03190
       TRA     QRELD+2             IO COMMAND FROM ADDRESS OF TCH       IOP03200
*                                                                       IOP03210
*      ROUTINE FOR TAKING CARE OF SPACING UNDER COUNT CONTROL           IOP03220
 IOCK  ADD     --                  RETURN ADDRESS                       IOP03230
       CAL     QSWT7               TEST NON TRANSMITING                 IOP03240
       TZE*    IOCK                IF IS RETURN                         IOP03250
       CAL     QIORD                                                    IOP03260
       SLW     QTEMP                                                    IOP03270
       CLA     QDUM1               PUT DUM REC IN IORD                  IOP03280
       STO     QIORD                                                    IOP03290
       CAL     QSWT3               TEST COUNT OR RECORD                 IOP03300
       TZE*    IOCK                IF REC RETURN                        IOP03310
 QLOP1 LXD     QTEMP,4             PUT COUNT INTO IX4                   IOP03320
       PXA     ,4                                                       IOP03330
       SUB     QCONS               SUB LENGTH OF BUFF                   IOP03340
       TZE*    IOCK                IF ZERO RETURN                       IOP03350
       TMI     QMIFX               FIXUP THEN RETURN                    IOP03360
       TIX     *+1,4,QCOUT         SUB LENTH BUF FROM COUNT             IOP03370
       SXD     QTEMP,4                                                  IOP03380
       TSL     QRDWR               RDS OR WRS                           IOP03390
       TSL     QRCHI               EXECUTE RCH                          IOP03400
       TSL     WDPR                TEST ALL WORDS PROCESSED             IOP03410
       TMI     *-3                                                      IOP03420
       TRA     QLOP1               ALL PROC CONTINUE                    IOP03430
 QMIFX SXD     QIORD,4             PUT WD COUNT IN IORD                 IOP03440
       TRA*    IOCK                RETURN                               IOP03450
*      THIS IS SUBROUTINE THAT WILL FIGURE OUT WORDS TO BE PROCESSED.   IOP03460
*      A SCH INSTRUCTION SHOULD BE GIVEN BEFORE ENTERING THE ROUTINE.   IOP03470
*      ON RETURN A-REG WILL HAVE A MINUS IF MORE WDS ARE TOBE PROC      IOP03480
 WDPR  TRA     --                  RETURN ADDRESS                       IOP03490
       LXA     QIORD,4             PICKUP ADDRESS IO COMMAND            IOP03500
       SXD     *+3,4                                                    IOP03510
       LXA     QSCHX,4             PUT ADDRESS SCH IN IX4               IOP03520
       SXA     QIORD,4             PUT NEW ADDRESS IN IO                IOP03530
       TIX     *+1,4,0             THE NEXT INSTRUCTIONS ARE            IOP03540
       SXA     QDUM2,4             USED TO SEE IF THE COUNT             IOP03550
       LXD     QIORD,4             WAS COMPLETELY USED.IF NOT IT        IOP03560
       PXA     ,4                  REPLACES EXISTING COUNT IN           IOP03570
       SUB     QDUM2               THE IORD AND RETURNS                 IOP03580
       TZE*    WDPR                EXIT ALL ARE PROCESSED               IOP03590
       TMI     *+3                                                      IOP03600
       PAX     ,4                                                       IOP03610
       SXD     QIORD,4             PUT NEW COUNT AWAY                   IOP03620
       CHS                         CHANGE TO MINUS                      IOP03630
       TRA*    WDPR                RETURN                               IOP03640
 QDUM2 PZE     0,,0                DUM LOC TO STO COUNT                 IOP03650
*      THIS ROUTINE HANDLES ALL SCATTER COMMANDS                        IOP03660
*      BY SCATTER I MEAN IO COMMANDS THAT DONT RELEASE THE CHAN IMM.    IOP03670
*      ON READS IT PUTS ALL THE INPUT INTO A BUFFER CALLED QNBUF        IOP03680
*      (SIZE OF BUF IS OPEN)AND THEN MOVES WORDS TO PROPER LOCATIONS    IOP03690
*      ON WRITES IT TRANSFERS THE WORDS FROM THE SPECIFIC               IOP03700
*      LOCATION TO QNBUF AND ARE WRITTEN AFTER RELEASE COMMAND.         IOP03710
       STZ     QSWT6                                                    IOP03720
 QSCAT SXA     QSVX2,2                                                  IOP03730
       CAL     QIORD               SAVE ORG IO COMMAND                  IOP03740
       PAX     ,4                                                       IOP03750
       SXD     QFXZ1,4             STO ADDRESS IN TXI COMMAND           IOP03760
       SLW     QTEMP                                                    IOP03770
       CAL     QDUM1                                                    IOP03780
       SLW     QIORD                                                    IOP03790
       LXD     QTEMP,4             PICKUP = WORDS IN IO COM.            IOP03800
 QFXZ1 TXI     *+1,4,--            THIS ROUTINE GIVES US THE            IOP03810
       SXA     QFXAD,4             COUNT + THE ADDRESS                  IOP03820
       SXA     QFXAW,4                                                  IOP03830
       LXD     QTEMP,4                                                  IOP03840
       CAL     QSWT1               TEST RD OR WRITE                     IOP03850
       TNZ     QZWRT               TRA IF WRITE COMMAND                 IOP03860
       TXH     *+3,4,0             TEST = OF WORDS FOR ZERO             IOP03870
       STZ     QYCNT               ZERO OUT WORDS                       IOP03880
       TRA     EXITZ+1                                                  IOP03890
       LXA     QYCNT,2                                                  IOP03900
       TXL     QRDAR,2,0           TEST QNBUF SEE IF ANY LEFT           IOP03910
       CAL     QSWT7               CHECK NON TRANS                      IOP03920
       TNZ     QFXAD+1                                                  IOP03930
       CLA     QNBUF+QCOUT,2       BRING UP WORD OUT OF BUF.            IOP03940
 QFXAD STO     --,4                STO WORD IN PROPER LOC.              IOP03950
