*     NBS SP                                                            SP000000
      SUBROUTINE SP(P,C,B,RTR,RTI)                                      SP000001
      DIMENSION CVR(4),CVI(4) ,A( 8),H( 8)                              SP000002
      T=1.                                                              SP000003
      REAL1=1.                                                          SP000004
      AM1=0.                                                            SP000005
      RTR=1.                                                            SP000006
      RTI=0.                                                            SP000007
      CALL ZDIV(1.,0.,C,B,X,Y)                                          SP000008
      PP=4.*P*P                                                         SP000009
   20 PRELIM=(PP-(2.*T-1.)*(2.*T-1.))/(4.*T)                            SP000010
      U=PRELIM*X                                                        SP000011
      V=PRELIM*Y                                                        SP000012
      CALL ZMPY(REAL1,AM1,U,V,REAL2,AM2)                                SP000013
      IF((REAL2*REAL2+AM2*AM2)-(REAL1*REAL1+AM1*AM1))110,110,200        SP000014
  110 RTR=RTR+REAL2                                                     SP000015
      RTI=RTI+AM2                                                       SP000016
      CALL ZDIV(REAL2,AM2,RTR,RTI,QTR,QTI)                              SP000017
      REAL1=REAL2                                                       SP000018
      AM1=AM2                                                           SP000019
   10 T=T+1.                                                            SP000020
      IF((QTR*QTR+QTI*QTI)-1.E-16) 30, 30,20                            SP000021
  200 S=T-P-.5                                                          SP000022
  201 A(1)=1.7878605                                                    SP000023
      A(2)=3.5882389                                                    SP000024
      A(3)=5.9200900                                                    SP000025
      A(4)=8.8668464                                                    SP000026
      A(5)=1.2543589  E+1                                               SP000027
      A(6)=1.7140529  E+1                                               SP000028
      A(7)=2.3023343  E+1                                               SP000029
      A(8)=3.1129504    E+1                                             SP000030
      H(1)=4.7828652                                                    SP000031
      H(2)=3.3761327  E+1                                               SP000032
      H(3)=5.1231373  E+1                                               SP000033
      H(4)=2.5408127E+1                                                 SP000034
      H(5)=4.5375890                                                    SP000035
      H(6)=2.7433832  E-1                                               SP000036
      H(7)=4.3728310  E-3                                               SP000037
      H(8)=8.8275945  E-6                                               SP000038
      CVR(1)=0.                                                         SP000039
      CVI(1)=0.                                                         SP000040
      DO 205 I=1,8                                                      SP000041
      XS=A(I)**(S-5.)                                                   SP000042
      CALLZDIV(XS*C,XS*B,C+A(I),B,ADR,ADI)                              SP000043
      CVR(1)=CVR(1)+ADR*H(I)                                            SP000044
  205 CVI(1)=CVI(1)+ADI*H(I)                                            SP000045
      GA=GAMMA(S+1.)                                                    SP000046
      CVR(1)=CVR(1)/GA                                                  SP000047
      CVI(1)=CVI(1)/GA                                                  SP000048
      TERMR=   C*(P- .5)/(T+P- .5)                                      SP000049
      TERMI=   B*(P- .5)/(T+P- .5)                                      SP000050
      CALLZMPY(S+1.+C,B,CVR(1),CVI(1),CVR(2),CVI(2))                    SP000051
      CALLZDIV(CVR(2)-C,CVI(2)-B,C,B,CVR(2),CVI(2))                     SP000052
      CALL ZMPY(TERMR,TERMI,CVR(2),CVI(2),TR,TI)                        SP000053
      SUMR=CVR(1)-TR                                                    SP000054
      SUMI=CVI(1)-TI                                                    SP000055
  202 ADD=1.                                                            SP000056
      SIGN=-1.                                                          SP000057
      DO 211 N=2,3                                                      SP000058
      EN=N                                                              SP000059
      SIGN=-SIGN                                                        SP000060
      ZIP=(P-EN+.5) /(T+P-EN+.5)                                        SP000061
      CALLZMPY(   ZIP*C,   ZIP*B,TERMR,TERMI,TERMR,TERMI)               SP000062
      CALLZMPY(S+C+2.-EN,B,CVR(N),CVI(N),CVR(N+1),CVI(N+1))             SP000063
        CALLZDIV(CVR(N+1)+CVR(N-1)-ADD,CVI(N+1)+CVI(N-1),EN*C,EN*B ,    SP000064
     1 CVR(N+1),CVI(N+1))                                               SP000065
      CALLZMPY(TERMR,TERMI,CVR(N+1),CVI(N+1),TPR,TPI)                   SP000066
      IF(TPR*TPR+TPI*TPI-TR*TR-TI*TI) 206,212,212                       SP000067
  206 TR=TPR                                                            SP000068
      TI=TPI                                                            SP000069
      SUMR=SUMR+SIGN*TR                                                 SP000070
      SUMI=SUMI+SIGN*TI                                                 SP000071
  211 ADD=0.                                                            SP000072
  212 CALLZMPY(SUMR,SUMI,REAL2,AM2,REAL2,AM2)                           SP000073
      RTR=RTR+REAL2                                                     SP000074
      RTI=RTI+AM2                                                       SP000075
   30 RETURN                                                            SP000076
      END                                                               SP000077
