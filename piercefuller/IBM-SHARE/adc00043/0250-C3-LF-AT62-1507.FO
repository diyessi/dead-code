      PZBTAB(13)=.00000034502145                                        AT620082
      ELMZTB(1)=.003                                                    AT620083
      ELMZTB(2)=.005                                                    AT620084
      ELMZTB(3)=.01                                                     AT620085
      ELMZTB(4)=.02                                                     AT620086
      ELMZTB(5)=.015                                                    AT620087
      ELMZTB( 6)=.01                                                    AT620088
      ELMZTB( 7)=.007                                                   AT620089
      ELMZTB( 8)=.005                                                   AT620090
      ELMZTB( 9)=.004                                                   AT620091
      ELMZTB(10)=.0033                                                  AT620092
      ELMZTB(11)=.0026                                                  AT620093
      ELMZTB(12)=.0017                                                  AT620094
      ELMZTB(13)=.0011                                                  AT620095
      TMBZTB(1)=180.65                                                  AT620096
      TMBZTB(2)=210.65                                                  AT620097
      TMBZTB(3)=260.65                                                  AT620098
      TMBZTB(4)=360.65                                                  AT620099
      TMBZTB(5)=960.65                                                  AT620100
      TMBZTB( 6)=1110.65                                                AT620101
      TMBZTB( 7)=1210.65                                                AT620102
      TMBZTB( 8)=1350.65                                                AT620103
      TMBZTB( 9)=1550.65                                                AT620104
      TMBZTB(10)=1830.65                                                AT620105
      TMBZTB(11)=2160.65                                                AT620106
      TMBZTB(12)=2420.65                                                AT620107
      TMBZTB(13)=2590.65                                                AT620108
      ZBTB(1)=90000.                                                    AT620109
      ZBTB(2)=100000.                                                   AT620110
      ZBTB(3)=110000.                                                   AT620111
      ZBTB(4)=120000.                                                   AT620112
      ZBTB(5)=150000.                                                   AT620113
      ZBTB( 6)=160000.                                                  AT620114
      ZBTB( 7)=170000.                                                  AT620115
      ZBTB( 8)=190000.                                                  AT620116
      ZBTB( 9)=230000.                                                  AT620117
      ZBTB(10)=300000.                                                  AT620118
      ZBTB(11)=400000.                                                  AT620119
      ZBTB(12)=500000.                                                  AT620120
      ZBTB(13)=600000.                                                  AT620121
      CONV1=.3048                                                       AT620122
  201 CONV2=.45359237                                                   AT620123
C     SAVE SENSE LIGHT STATUS                                           AT620124
 1113 IF(SENSELIGHT1)1,2                                                AT620125
    1 SAVE=1.                                                           AT620126
      GOTO200                                                           AT620127
    2 SAVE=0.                                                           AT620128
 200  IF(ZFT-2320000.0)7,7,25                                           AT620129
C     Z GREATER THAN 2320000.FT.                                        AT620130
   25 Z=2320000.0*CONV1                                                 AT620131
      GO TO 11                                                          AT620132
C     CONVERT Z FT. TO Z METERS                                         AT620133
    7 Z   =ZFT   *CONV1                                                 AT620134
C     COMPUTE H DOUBLE PRECISION                                        AT620135
 11   IF(Z-90000.)1111,1111,98                                          AT620136
 1111 ZDPR=Z                                                            AT620137
      ZDPR(2)=0.                                                        AT620138
D     Z6=ZDPR*.000001                                                   AT620139
D 210 Z6P=Z6+6.3675708                                                  AT620140
D 211 TEMP2=.0010559179*Z6+1.5640943                                    AT620141
D 212 TEM2=Z6P*Z6P                                                      AT620142
D 213 TEM3=TEM2*Z6P                                                     AT620143
D 214 TEM4=TEM2*TEM2                                                    AT620144
D 215 TEM5=TEM2*TEM3                                                    AT620145
D 216 TEM9=TEM4*TEM5                                                    AT620146
D     SINZ=SINF(.00052795893*Z6+.78204713)                              AT620147
D 217 HDPR=-40648635./(Z6P)-894899.28/TEM3-16302410./TEM9-7408.3724/TEM4AT620148
     1-135.55760*Z6*Z6-1724.8490*Z6+(2684697.8/TEM3)*(SINZ*SINZ)        AT620149
     2                  +(708.70509/TEM2-256757.85*Z6-1634923.8         AT620150
     3+.00079017959*LOGF(ZDPR+6367570.8))*(SINF(TEMP2))+(.74833436/     AT620151
     4(Z6P)-243160820.)*(COSF(TEMP2))+9646530.7284232                   AT620152
      H   =HDPR(1)                                                      AT620153
   15 IF(Z   -90000.)97,98,98                                           AT620154
   98 IF(Z   -170000.)96,95,95                                          AT620155
C     Z GREATER THAN 170000.M,COMPUTE M                                 AT620156
   95 EM   =(((((1.1805540E-33*Z   -3.4291620E-27)                      AT620157
     1*Z   +3.8159669E-21)*Z   -2.0402054E-15)                          AT620158
     2*Z   +5.6422141E-10)*Z   -1.0700489E-4)                           AT620159
     3*Z   +3.5629995E1                                                 AT620160
      EM   =EM   *28.9644/28.966                                        AT620161
  243 GOTO16                                                            AT620162
C     Z BETWEEN 90000.M AND 170000.M,COMPUTE M                          AT620163
   96 EM   =(((((1.418650900E-28*Z   -1.114583417E-22)                  AT620164
     1*Z   +3.592014161E-17)*Z   -6.066521302E-12)                      AT620165
     2*Z   +5.652151839E-7)*Z   -2.753003562E-2)                        AT620166
     3*Z   +5.76957191E2                                                AT620167
      EM   =EM   *28.9644/28.966                                        AT620168
  244 GOTO16                                                            AT620169
C     Z LESS THAN 90000.M,COMPUTE M                                     AT620170
   97 EM   =28.9644                                                     AT620171
   16 IF(Z   -90000.)70,70,500                                          AT620172
C     Z LESS THAN 90000.M FIND H IN HMTAB TABLE                         AT620173
   70 N=1                                                               AT620174
  702 IF(H-HMTAB(N))703,701,700                                         AT620175
  700 N=N+1                                                             AT620176
      GO TO 702                                                         AT620177
  701 J=N                                                               AT620178
      GO TO 704                                                         AT620179
  703 J=N-1                                                             AT620180
C     FIND HB,PB,ELM,TMB,TM                                             AT620181
  704 HB=HBTAB(J)                                                       AT620182
      PB=PBTAB(J)                                                       AT620183
      ELM=ELMTAB(J)                                                     AT620184
      TMB=TMBTAB(J)                                                     AT620185
      TM=TMB+ELM*(H-HB)                                                 AT620186
  248 IF(ELM)72,73,72                                                   AT620187
C     IF ELM NOT =0 COMPUTE P                                           AT620188
   72 P   =EXPF(LOGF(PB)-(GO*EMOR/ELM)*LOGF(TM   /TMB))                 AT620189
  249 GOTO90                                                            AT620190
C     IF ELM=0 COMPUTE P                                                AT620191
   73 P   =EXPF(LOGF(PB)-(GO*EMOR)*((H   -HB)/TMB))                     AT620192
      GO TO 90                                                          AT620193
C     Z GREATER THAN 90000.M FIND Z IN ZBTAB TABLE                      AT620194
  500 N=1                                                               AT620195
  802 IF(Z-ZBTAB(N))803,801,800                                         AT620196
  800 N=N+1                                                             AT620197
      GO TO 802                                                         AT620198
  801 J=N                                                               AT620199
      GO TO 804                                                         AT620200
  803 J=N-1                                                             AT620201
C     FIND ZB,PB,ELM,TMB,TM                                             AT620202
  804 ZB=ZBTB(J)                                                        AT620203
      PB=PZBTAB(J)                                                      AT620204
      ELM=ELMZTB(J)                                                     AT620205
      TMB=TMBZTB(J)                                                     AT620206
      TM=TMB+ELM*(Z-ZB)                                                 AT620207
C     COMPUTE P                                                         AT620208
      C=(-ZB+TMB/ELM)*.000001                                           AT620209
      D=6.3675708                                                       AT620210
      CMD=C-D                                                           AT620211
      CMD2=CMD*CMD                                                      AT620212
      CMD3=CMD2*CMD                                                     AT620213
      CMD4=CMD2*CMD2                                                    AT620214
      CMD5=CMD2*CMD3                                                    AT620215
      CMD6=CMD3*CMD3                                                    AT620216
      CMD7=CMD4*CMD3                                                    AT620217
      CMD8=CMD4*CMD4                                                    AT620218
      CMD9=CMD5*CMD4                                                    AT620219
      CMD10=CMD5*CMD5                                                   AT620220
      C2=C*C                                                            AT620221
      C3=C2*C                                                           AT620222
      D2=D*D                                                            AT620223
      PBLN=LOGF(PB)                                                     AT620224
      TEM14=EMOR/ELM                                                    AT620225
      SENSELIGHT1                                                       AT620226
C     COMPUTE USING ZB                                                  AT620227
      Z6=ZB*.000001                                                     AT620228
  344 ZPD=Z6+D                                                          AT620229
      ZPC=Z6+C                                                          AT620230
      ZPD2=ZPD*ZPD                                                      AT620231
      ZPD3=ZPD2*ZPD                                                     AT620232
      ZPD4=ZPD2*ZPD2                                                    AT620233
      ZPD5=ZPD2*ZPD3                                                    AT620234
      ZPD6=ZPD3*ZPD3                                                    AT620235
      ZPD7=ZPD3*ZPD4                                                    AT620236
      ZPD8=ZPD4*ZPD4                                                    AT620237
      ZPD9=ZPD5*ZPD4                                                    AT620238
      ZPC2=ZPC*ZPC                                                      AT620239
      ZPC3=ZPC2*ZPC                                                     AT620240
      ZDLOG=LOGF(ABSF(ZPD))+6.*LOGF(10.)                                AT620241
      ZCLOG=LOGF(ABSF(ZPC))+6.*LOGF(10.)                                AT620242
      ZCDLOG=LOGF(ABSF(ZPC/ZPD))                                        AT620243
      TEMP1=1./(-CMD*ZPD)+ZCDLOG/CMD2                                   AT620244
      TEMP2=-ZDLOG/CMD4-1./(CMD3*ZPD)+1./(2.*CMD2*ZPD2)-1./(3.*CMD*ZPD3)AT620245
     1+ZCLOG/CMD4                                                       AT620246
      TEMP3= D*ZDLOG/CMD4-ZPD/CMD4+ZDLOG/CMD3+D/(ZPD*CMD3)              AT620247
     1+1./(ZPD*CMD2)-D/(2.*ZPD2*CMD2)-1./(2.*ZPD2*CMD)                  AT620248
     2+D/(3.*ZPD3*CMD)+ZPC/CMD4-C*ZCLOG/CMD4                            AT620249
      TEMP4=-ZPD2/(2.*CMD4)+2.*D*ZPD/CMD4-D2*ZPLOG/CMD4                 AT620250
     1+ZPD/CMD3-2.*D*ZDLOG/CMD3-D2/(ZPD*CMD3)                           AT620251
     2-ZDLOG/CMD2-2.*D/(ZPD*CMD2)+D2/(2.*ZPD2*CMD2)                     AT620252
     3-1./(ZPD*CMD)+D/(ZPD2*CMD)-D2/(3.*ZPD3*CMD)                       AT620253
     4+ZPC2/(2.*CMD4)-2.*C*ZPC/CMD4+C2*ZCLOG/CMD4                       AT620254
      TEMP5=ZCDLOG/CMD4-1./(CMD3*ZPD)+1./(2.*ZPD2*CMD2)                 AT620255
     1-1./(3.*ZPD3*CMD)                                                 AT620256
      TEM6=ZPC-C*ZCLOG                                                  AT620257
      TEM7=ZPC2/2.-2.*C*ZPC+C2*ZCLOG                                    AT620258
      TEM8=ZPC3/3.-3.*C*ZPC2/2.+3.*C2*ZPC-C3*ZCLOG                      AT620259
      TEM11=-ZDLOG/CMD10-1./(CMD9*ZPD)+1./(2.*CMD8*ZPD2)                AT620260
     1-1./(3.*CMD7*ZPD3)+1./(4.*CMD6*ZPD4)-1./(5.*CMD5*ZPD5)            AT620261
     2+1./(6.*CMD4*ZPD6)-1./(7.*CMD3*ZPD7)+1./(8.*CMD2*ZPD8)            AT620262
     3-1./(9.*CMD*ZPD9)+ZCLOG/CMD10                                     AT620263
      TEM12=ZDLOG/CMD5+1./(CMD4*ZPD)-1./(2.*CMD3*ZPD2)                  AT620264
     1+1./(3.*CMD2*ZPD3)-1./(4.*CMD*ZPD4)-ZCLOG/CMD5                    AT620265
      TEM13=398.626940*TEMP1-39.227164*TEMP2-.041699200*TEMP3           AT620266
     1-1.4755045E-7*TEMP4+26.327892*TEMP5-.0026586747*TEM6              AT620267
     2+2.8074026E-6*TEM7+9.9336241E-12*TEM8-.017043125*ZCLOG            AT620268
     3                                      +1.4388483E3*TEM11          AT620269
     4+.29060526*TEM12+1.4673439E-5*ZCLOG                               AT620270
      IF(SENSELIGHT1)345,346                                            AT620271
  345 TEM15=TEM13                                                       AT620272
C     REPEAT USING Z                                                    AT620273
      Z6=Z   *.000001                                                   AT620274
      GOTO344                                                           AT620275
C     P NT/M2                                                           AT620276
  346 P   =EXPF(PBLN-TEM14*(TEM13-TEM15))                               AT620277
C     CONVERT P NT/M2 TO MB                                             AT620278
   90 PMB   =P   *.01                                                   AT620279
C     CONVERT P MB TO MM HG                                             AT620280
  265 PMM   =PMB   *(760./1013.25)                                      AT620281
C     T DEGREES KELVIN                                                  AT620282
  266 T   =TM   *(EM   /EMO)                                            AT620283
C     RHO KG/M3                                                         AT620284
  269 RHO   =EMOR*(P   /TM   )                                          AT620285
C     CS M/SEC                                                          AT620286
   18 CS   =SQRTF(GAM*TM   /EMOR)                                       AT620287
C     CONVERT P MM HG TO IN HG                                          AT620288
   17 PIN   =PMM   *12./(CONV1*1000.)                                   AT620289
C     CONVERT P IN HG TO LB/FT2                                         AT620290
      PIN   =PIN   *144./2.036                                          AT620291
C     CONVERT RHO KG/M3 TO LB/FT3                                       AT620292
  291 RHO   =RHO   *CONV1*CONV1*CONV1/CONV2                             AT620293
C     CONVERT RHO LB/FT3 TO SLUG/FT3                                    AT620294
      RHO   =RHO   /32.17404855                                         AT620295
      IF(ZFT-300000.)22,22,29                                           AT620296
   29 CS=894.50046                                                      AT620297
      GO TO 21                                                          AT620298
C     CS FT/SEC                                                         AT620299
   22 CS   =CS   /CONV1                                                 AT620300
C     RESTORE SENSE LIGHT STATUS                                        AT620301
   21 IF(SAVE)3,4,3                                                     AT620302
    3 SENSELIGHT1                                                       AT620303
      GOTO5                                                             AT620304
    4 IF(SENSELIGHT1)5,5                                                AT620305
    5 ANS(1)=RHO                                                        AT620306
      ANS(2)=PIN                                                        AT620307
      ANS(3)=TR                                                         AT620308
      ANS(4)=CS                                                         AT620309
      RETURN                                                            AT620310
       END                                                              AT620311
