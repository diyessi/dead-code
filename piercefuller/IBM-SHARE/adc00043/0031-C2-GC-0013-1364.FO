      SUBROUTINE DDVETA (C, RT, MTYPE)                                  00130001
D     DIMENSION C(4), RT(3), X(2)                                       00130002
      DO 10 L=2,4                                                       00130003
D  10 C(L)=C(L)/C(1)                                                    00130004
D     A=(3.0*C(3)-C(2)**2)/3.0                                          00130005
D     B=(2.0*(C(2))**3-9.0*C(2)*C(3)+27.0*C(4))/27.0                    00130006
D     Q=B**2/4.0+A**3/27.0                                              00130007
      IF (B) 600, 700, 600                                              00130008
  700 IF (ABSF(A)-.001) 12, 12, 300                                     00130009
  600 IF(ABSF(Q)-10.0**(-15)*B**2/4.0) 12, 300, 300                     00130010
  300 IF (Q) 11, 12, 13                                                 00130011
   12 MTYPE=0                                                           00130012
      GO TO 14                                                          00130013
   13 MTYPE=1                                                           00130014
      GO TO 15                                                          00130015
   11 MTYPE=-1                                                          00130016
D     Q  =ABSF(Q)                                                       00130017
D     R  =SQRTF(Q)                                                      00130018
D     PHI1=ATAN2F(R,-B/2.0)/3.0                                         00130019
D     POD =SQRTF(B**2/4.0+Q)                                            00130020
      IF (POD) 73, 70, 73                                               00130021
D  70 X(1)=0.0                                                          00130022
D     X(2)=0.0                                                          00130023
      GO TO 17                                                          00130024
D  73 EXPO=(LOGF(POD))/3.0                                              00130025
D     POD=EXPF(EXPO)                                                    00130026
D     X(1)=    POD*COSF(PHI1)                                           00130027
D     X(2)=    POD*SINF(PHI1)                                           00130028
      GO TO 17                                                          00130029
D  14 POD=-B/2.0                                                        00130030
      IF (POD) 83, 80, 83                                               00130031
D  80 X(1)=0.0                                                          00130032
      GO TO 84                                                          00130033
D  83 EXPO=(LOGF(ABSF(POD)))/3.0                                        00130034
D     X(1)=(POD /ABSF(POD))*EXPF(EXPO)                                  00130035
D  84 RT(1)=2.0*X(1)                                                    00130036
D     RT(2)=-X(1)                                                       00130037
D     RT(3)=RT(2)                                                       00130038
      GO TO 199                                                         00130039
D  15 Q=SQRTF(Q)                                                        00130040
D     CLOD=-B/2.0+Q                                                     00130041
D     PLOD=CLOD-2.0*Q                                                   00130042
D     IF (CLOD) 96, 95, 96                                              00130043
D  95 X(1)=0.0                                                          00130044
      GO TO 97                                                          00130045
D  96 EXPO=(LOGF(ABSF(CLOD)))/3.0                                       00130046
D     X(1)=(CLOD/ABSF(CLOD))*EXPF(EXPO)                                 00130047
D  97 IF (PLOD) 91, 90, 91                                              00130048
D  90 X(2)=0.0                                                          00130049
      GO TO 16                                                          00130050
D  91 EXPO=(LOGF(ABSF(PLOD)))/3.0                                       00130051
D     X(2)=(PLOD/ABSF(PLOD))*EXPF(EXPO)                                 00130052
D  16 RT(1)=X(1)+X(2)-C(2)/3.0                                          00130053
D     RT(2)=-.50*(X(1)+X(2))-C(2)/3.0                                   00130054
D     RT(3)=    .8660254037844385*(X(1)-X(2))                           00130055
      RETURN                                                            00130056
D  17 RT(1)=2.0*X(1)                                                    00130057
D     RT(2)=-X(1)+X(2)*1.732050807568877                                00130058
D     RT(3)=-X(1)-X(2)*1.732050807568877                                00130059
  199 DO 200 L=1,3                                                      00130060
D 200 RT(L)=RT(L)-C(2)/3.0                                              00130061
   18 RETURN                                                            00130062
