       TXL     LOOP1,1,**   =N-1   +N AT THE END OF EACH TXL  LOOP,4,** SLSQ0734
       SPACE                                                            SLSQ0735
       EJECT                                                            SLSQ0736
* INTERCHANGE ROWS, MAXX TH ROW AND J TH ROW.                           SLSQ0737
       LXA     MAXX,1                                                   SLSQ0738
       LXA     J,2                                                      SLSQ0739
 LOOP2 CLA     **,1     A,1                                             SLSQ0740
       LDQ     **,2      A,2                                            SLSQ0741
       XCA                                                              SLSQ0742
       STO     **,1     A,1                                             SLSQ0743
       STQ     **,2     A,2                                             SLSQ0744
       TXI     *+1,1,**      =N                                         SLSQ0745
       TXI     *+1,2,**          =N                                     SLSQ0746
       TXL     LOOP2,2,**   =NNIP  +1 AFTER  TXL   LOOP,4,**            SLSQ0747
       SPACE                                                            SLSQ0748
       LXA     J,2                                                      SLSQ0749
       PXA     ,2                                                       SLSQ0750
       SUB     MAXX                                                     SLSQ0751
       TZE     *+2                                                      SLSQ0752
       CLS     DET                                                      SLSQ0753
       STO     DET                                                      SLSQ0754
       LDQ     **,2      A,2                                            SLSQ0755
       STQ     ROW                                                      SLSQ0756
       FMP     DET                                                      SLSQ0757
       STO     DET                                                      SLSQ0758
       SPACE                                                            SLSQ0759
 LOOP3 CLA     **,2   A,2                                               SLSQ0760
       FDP     ROW                                                      SLSQ0761
       STQ     **,2          =A                                         SLSQ0762
       TXI     *+1,2,**     **=N                                        SLSQ0763
       TXL     LOOP3,2,**   =NNIP  +1 AFTER  TXL   LOOP,4,**            SLSQ0764
       SPACE                                                            SLSQ0765
       LXA     JUNK,2                                                   SLSQ0766
 LOOP4 LXA     J,4                                                      SLSQ0767
       CLA     **,2         A,2                                         SLSQ0768
       STO     ROW                                                      SLSQ0769
 LOOP5 LDQ     **,4    A,4                                              SLSQ0770
       FMP     ROW                                                      SLSQ0771
       STO     VALUE                                                    SLSQ0772
       CLA     **,2                                                     SLSQ0773
       FSB     VALUE                                                    SLSQ0774
       STO     **,2    A,2                                              SLSQ0775
       TXI     *+1,2,**      =N                                         SLSQ0776
       TXI     *+1,4,**         =N                                      SLSQ0777
       TXL     LOOP5,4,**         NNIP (NNIP+1) ETC                     SLSQ0778
       CLA     JUNK                                                     SLSQ0779
       ADD     ONE                                                      SLSQ0780
       STO     JUNK                                                     SLSQ0781
       LXA     JUNK,2                                                   SLSQ0782
       TXL     LOOP4,2,**   =N-1   +N AT THE END OF EACH TXL  LOOP,4,** SLSQ0783
 JBACK LXA     J,4                                                      SLSQ0784
       TXI     *+1,4,**         =N+1                                    SLSQ0785
       PXA     ,4                                                       SLSQ0786
       ADD     ONE                                                      SLSQ0787
       STO     JUNK                                                     SLSQ0788
       CLA     N1                                                       SLSQ0789
       ADD     N                                                        SLSQ0790
       STO     N1                                                       SLSQ0791
       PAX     N1,1                                                     SLSQ0792
       SXD     GO+3,1                                                   SLSQ0793
       CLA     NNIP                                                     SLSQ0794
       ADD     ONE                                                      SLSQ0795
       STO     NNIP                                                     SLSQ0796
 END1  TXL     LOOP,4,**   NN-2                                         SLSQ0797
       CLA     JUNK1                                                    SLSQ0798
       SUB     NN1    IN AC  ADDRESS OF ( A+NN1).                       SLSQ0799
       STA     LOOP6                                                    SLSQ0800
       STA     LOOP6+2                                                  SLSQ0801
       STA     *+4                                                      SLSQ0802
       STA     *+1                                                      SLSQ0803
       CLA     **                                                       SLSQ0804
       STO     ROW                                                      SLSQ0805
       LDQ     **     =A                                                SLSQ0806
       FMP     DET                                                      SLSQ0807
       STO     **   DET IN MAIN PROG.                                   SLSQ0808
       LXA     NN1,4                                                    SLSQ0809
       AXT     0,1                                                      SLSQ0810
 LOOP6 CLA     **,1    =A                                               SLSQ0811
       FDP     ROW                                                      SLSQ0812
       STQ     **,1   'A                                                SLSQ0813
       TXI     *+1,1,**   =N                                            SLSQ0814
       TXI     *+1,4,**    =N                                           SLSQ0815
       TXL     LOOP6,4,**   =NN1+NIP+IP                                 SLSQ0816
 TEMP1 AXT     0,1                                                      SLSQ0817
 TEMP2 AXT     0,2                                                      SLSQ0818
 TEMP3 AXT     0,4                                                      SLSQ0819
       STZ     MAXX                                                     SLSQ0820
       CLA     ONE                                                      SLSQ0821
       STO     JUNK                                                     SLSQ0822
       TRA     6,4                                                      SLSQ0823
 ROW                                                                    SLSQ0824
 VALUE                                                                  SLSQ0825
 J                                                                      SLSQ0826
 N                                                                      SLSQ0827
 DET                                                                    SLSQ0828
 ONE1  DEC     1.                                                       SLSQ0829
 ONE   PZE     1                                                        SLSQ0830
 IP                                                                     SLSQ0831
 NNIP                                                                   SLSQ0832
 N1                                                                     SLSQ0833
 NIP                                                                    SLSQ0834
 NN                                                                     SLSQ0835
