       END                                                              SLSQ0840
*      FAP                                                              SLSQ0841
* KADAKIA, COMBINATION OF DIFFERENT LEAST-SQUARES APPROXIMATION**SOLVE  SLSQ0842
*      M,N ARE STOREDIN THE DECREMENT PART OF LOCATIONS M,N RESP.       SLSQ0843
*      CALLING SEQUENCE                                                 SLSQ0844
*      TSX     SOLVE,4                                                  SLSQ0845
*              A                                                        SLSQ0846
*              M     NUMBER OF ROWS OF MATRIX A                         SLSQ0847
*              N          NUMBER OF COLUMNS OF MATRIX X                 SLSQ0848
*              X                                                        SLSQ0849
*   OR                                                                  SLSQ0850
*      CALL SOLVE(A,M,N,X)                                              SLSQ0851
*      STORAGE ALLOCATION FOR  A,X  AS FOLLOWS.                         SLSQ0852
*      IF MAIN PROG. IN FAP.                                            SLSQ0853
*    A BES     M*(M+N)-1                                                SLSQ0854
*      BSS     1                                                        SLSQ0855
*    X BES     M*N-1                                                    SLSQ0856
*      BSS     1                                                        SLSQ0857
*       IF MAIN PROG. IN FORTRAN                                        SLSQ0858
*                                DIMENSION A(M,M+N),X(M,N)              SLSQ0859
       LBL     SOLVE,X                                                  SLSQ0860
       EJECT                                                            SLSQ0861
       SPACE   4                                                        SLSQ0862
       ENTRY   SOLVE                                                    SLSQ0863
 SOLVE CLA     1,4                                                      SLSQ0864
       REM     A IS THE TRIANGULIZED MATRIX (M,M+N)                     SLSQ0865
       STA     LOOP4                                                    SLSQ0866
       STA     LOOP1                                                    SLSQ0867
       STA     MUMP                                                     SLSQ0868
       SPACE   3                                                        SLSQ0869
       CLA*    2,4                                                      SLSQ0870
       STO     N                                                        SLSQ0871
       REM     N=THE NUMBER OF ROWS OF THE MATRIX A.                    SLSQ0872
       STD     LOOP4+2                                                  SLSQ0873
       STD     LOOP4+3                                                  SLSQ0874
       SPACE   3                                                        SLSQ0875
       CLA*    3,4                                                      SLSQ0876
       STO     IP                                                       SLSQ0877
       REM     IP=THE NUMBER OF THE COLUMNS OF MATRIX  X.               SLSQ0878
       SPACE   3                                                        SLSQ0879
       CLA     4,4                                                      SLSQ0880
       REM     X IS THE SOLUTION MATRIX (M,N)                           SLSQ0881
       STA     LOOP4+1                                                  SLSQ0882
       STA     LOOP1+1                                                  SLSQ0883
       STA     MUMP+2                                                   SLSQ0884
       SPACE   3                                                        SLSQ0885
       REM     SAVE ALL INDEX REGISTERS.                                SLSQ0886
       SXA     TEMP1,1                                                  SLSQ0887
       SXA     TEMP2,2                                                  SLSQ0888
       SXA     TEMP3,4                                                  SLSQ0889
       SPACE   3                                                        SLSQ0890
       CLA     N                                                        SLSQ0891
       REM     N IS IN THE DECREMENT OF LOC. N                          SLSQ0892
       PDX     ,4                                                       SLSQ0893
       STZ     N                                                        SLSQ0894
       SXA     N,4                                                      SLSQ0895
       CLA     IP                                                       SLSQ0896
       REM     IP IS IN THE DECREMENT OF LOC. IP                        SLSQ0897
       PDX     ,4                                                       SLSQ0898
       STZ     IP                                                       SLSQ0899
       SXA     IP,4                                                     SLSQ0900
       SPACE   3                                                        SLSQ0901
       CLA     N                                                        SLSQ0902
       SUB     ONE                                                      SLSQ0903
       STO     N1                                                       SLSQ0904
       PAX     ,2                                                       SLSQ0905
       SXD     TEMP,2                                                   SLSQ0906
       LDQ     N                                                        SLSQ0907
       MPY     N                                                        SLSQ0908
       XCA                                                              SLSQ0909
       STO     NN                                                       SLSQ0910
       PAX     ,1                                                       SLSQ0911
       SXD     CAMP,1                                                   SLSQ0912
       SUB     =2                                                       SLSQ0913
       STO     NN2                                                      SLSQ0914
       ADD     N                                                        SLSQ0915
       STO     NNIP      NN2+N                                          SLSQ0916
       LDQ     N                                                        SLSQ0917
       MPY     IP                                                       SLSQ0918
       XCA                                                              SLSQ0919
       SUB     ONE                                                      SLSQ0920
       PAX     ,1                                                       SLSQ0921
       SXD     LOOP4+4,1                                                SLSQ0922
       LAC     N,1                                                      SLSQ0923
       SXD     LOOP1+4,1                                                SLSQ0924
       CLA     NN                                                       SLSQ0925
       SUB     ONE                                                      SLSQ0926
       STO     NN1                                                      SLSQ0927
       SPACE   4                                                        SLSQ0928
       EJECT                                                            SLSQ0929
       SPACE   2                                                        SLSQ0930
       CLA     NN                                                       SLSQ0931
       ADD     N1                                                       SLSQ0932
       PAX     ,1     NN+N1                                             SLSQ0933
       REM       IR1 = NN+N1       IR2 = N1                             SLSQ0934
       SPACE   2                                                        SLSQ0935
 LOOP4 CLA     **,1    =A                                               SLSQ0936
       STO     **,2   =X                                                SLSQ0937
       TXI     *+1,1,**   =N                                            SLSQ0938
       TXI     *+1,2,**    =N                                           SLSQ0939
       TXL     LOOP4,2,**    =N*IP-1                                    SLSQ0940
       LXA     NNIP,4                                                   SLSQ0941
       LXA     NN2,1                                                    SLSQ0942
       SXA     JUNK,1                                                   SLSQ0943
       LXA     N1,2                                                     SLSQ0944
 LOOP2 STZ     SUM                                                      SLSQ0945
 LOOP1 LDQ     **,1    =A                                               SLSQ0946
       FMP     **,2  =X                                                 SLSQ0947
       FAD     SUM                                                      SLSQ0948
       STO     SUM                                                      SLSQ0949
       TXI     *+1,1,**    =(-N)                                        SLSQ0950
 TEMP  TIX     LOOP3,2,**    N-1                                        SLSQ0951
       TXI     *+1,2,-1                                                 SLSQ0952
       TRA     MUMP                                                     SLSQ0953
 LOOP3 CLA     TEMP                                                     SLSQ0954
       STZ     DUMP                                                     SLSQ0955
       STD     DUMP                                                     SLSQ0956
