*      FAP                                                              SLSQ0570
* KADAKIA, COMBINATION OF DIFFERENT LEAST-SQUARES APPROXIMATION**TRING  SLSQ0571
       SPACE   3                                                        SLSQ0572
*  CALLING SEQUENCE                                                     SLSQ0573
*      TSX     TRING,4                                                  SLSQ0574
*              A                                                        SLSQ0575
*              B                                                        SLSQ0576
*              M                                                        SLSQ0577
*              N                                                        SLSQ0578
*              DET                                                      SLSQ0579
*  OR                                                                   SLSQ0580
*     CALL TRING(A,B,M,N,DET)                                           SLSQ0581
*              STORAGE ALLOCATION FOR A,B AS FOLLOWS=                   SLSQ0582
*                  IF MAIN PROG. IN FAP                                 SLSQ0583
*                                      A     BES     (M* M+N)- 1        SLSQ0584
*                                           BSS     1                   SLSQ0585
*                                      B     BES     M*N- 1             SLSQ0586
*                                           BSS     1                   SLSQ0587
*                  IF MAIN PROG. IN FORTRAN=                            SLSQ0588
*                                      DIMENSION A(M,M+N),B(M,N)        SLSQ0589
       SPACE   3                                                        SLSQ0590
       LBL     TRING,X                                                  SLSQ0591
       EJECT                                                            SLSQ0592
       ENTRY   TRING                                                    SLSQ0593
       SPACE   2                                                        SLSQ0594
 TRING CLA     1,4                                                      SLSQ0595
       REM     A IS THE MATRIX OF ORDER (N*N)                           SLSQ0596
       STA     GOTO+1                                                   SLSQ0597
       STA     LOOP+7                                                   SLSQ0598
       STA     LOOP1+1                                                  SLSQ0599
       STA     LOOP2                                                    SLSQ0600
       STA     LOOP2+1                                                  SLSQ0601
       STA     LOOP2+3                                                  SLSQ0602
       STA     LOOP2+4                                                  SLSQ0603
       STA     LOOP3-4                                                  SLSQ0604
       STA     LOOP3                                                    SLSQ0605
       STA     LOOP3+2                                                  SLSQ0606
       STA     LOOP4+1                                                  SLSQ0607
       STA     LOOP5                                                    SLSQ0608
       STA     LOOP5+3                                                  SLSQ0609
       STA     LOOP5+5                                                  SLSQ0610
       STA     JUNK1                                                    SLSQ0611
       SPACE   2                                                        SLSQ0612
       CLA     2,4                                                      SLSQ0613
       REM     B IS THE MATRIX OF ORDER (N*IP).                         SLSQ0614
       STA     GOTO                                                     SLSQ0615
       SPACE   2                                                        SLSQ0616
       CLA*    3,4                                                      SLSQ0617
       STO     N                                                        SLSQ0618
       REM     N= THE NUMBER OF ROWS OF THE MATRIX A.                   SLSQ0619
       STD     LOOP2+5                                                  SLSQ0620
       STD     LOOP2+6                                                  SLSQ0621
       STD     LOOP3+3                                                  SLSQ0622
       STD     LOOP5+6                                                  SLSQ0623
       STD     LOOP5+7                                                  SLSQ0624
       STD     LOOP6+3                                                  SLSQ0625
       STD     LOOP6+4                                                  SLSQ0626
       SPACE   2                                                        SLSQ0627
       CLA*    4,4                                                      SLSQ0628
       STO     IP                                                       SLSQ0629
       REM     IP= THE NUMBER OF COLUMNS OF THE MATRIX B.               SLSQ0630
       EJECT                                                            SLSQ0631
       SPACE   2                                                        SLSQ0632
       CLA     5,4                                                      SLSQ0633
       STA     LOOP6-3                                                  SLSQ0634
       REM     DET= VALUE OF THE DETERMINT OF THE MATRIX A.             SLSQ0635
       SPACE   2                                                        SLSQ0636
       REM     SAVE ALL INDEX REGISTERS.                                SLSQ0637
       SXA     TEMP1,1                                                  SLSQ0638
       SXA     TEMP2,2                                                  SLSQ0639
       SXA     TEMP3,4                                                  SLSQ0640
       SPACE   2                                                        SLSQ0641
       CLA     N                                                        SLSQ0642
       REM     N IS IN THE DECREMENT OF LOC. N.                         SLSQ0643
