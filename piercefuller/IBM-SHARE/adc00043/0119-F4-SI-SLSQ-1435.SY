       CLA     JUNK                                                     SLSQ0529
       PAX     ,4                                                       SLSQ0530
       TXI     *+1,4,-1                                                 SLSQ0531
       SXD     END3,4                                                   SLSQ0532
       STO     JUNK                                                     SLSQ0533
       AXT     0,4                                                      SLSQ0534
       LXA     CONST1,2                                                 SLSQ0535
       TXI     *+1,2,-1                                                 SLSQ0536
       SXA     CONST1,2                                                 SLSQ0537
       STZ     CONST                                                    SLSQ0538
       STZ     TEMP                                                     SLSQ0539
 END4  TXL     LOOP3,1,**   N1                                          SLSQ0540
       LXA     N,1                                                      SLSQ0541
