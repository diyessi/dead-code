       REM TO STORE MATRIX B IN N+1 TO N+IP COL. OF MATRIX A.           SLSQ0696
       LXA     NN,2                                                     SLSQ0697
       AXT     0,1                                                      SLSQ0698
 GOTO  CLA     **,1      B,1                                            SLSQ0699
       STO     **,2     A,2                                             SLSQ0700
       TXI     *+1,1,1                                                  SLSQ0701
       TXI     *+1,2,1                                                  SLSQ0702
       TXL     GOTO,1,**          =N*IP-1                               SLSQ0703
