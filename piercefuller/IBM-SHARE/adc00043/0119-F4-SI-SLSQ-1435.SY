*                                                                       SLSQ0000
*      FAP                                                              SLSQ0001
*  SUPER LEAST SQUARES PROG.           KADAKIA                          SLSQ0002
* KADAKIA, COMBINATION OF DIFFERENT LEAST-SQUARES APPROXIMATION*MAIN PROSLSQ0003
       LBL     SLSQ,X                                                   SLSQ0004
       EJECT                                                            SLSQ0005
       EXTERN  READX                                                    SLSQ0006
       EXTERN  WRIT                                                     SLSQ0007
       EXTERN  GETBCD                                                   SLSQ0008
       EXTERN  BCDOTX                                                   SLSQ0009
       EXTERN  NORMAL                                                   SLSQ0010
       EXTERN  TRING                                                    SLSQ0011
       EXTERN  SOLVE                                                    SLSQ0012
       EXTERN  $SQRT                                                    SLSQ0013
       REM  NORVAR = 0 READ VARIANCE COVARIANCE MATRICES                SLSQ0014
       REM  NORVAR = 1 READ NORMAL MATRICES.                            SLSQ0015
       REM  NORVAR = -1 READ INVERSE MATRICES.                          SLSQ0016
       REM     EQUAL = 0 MEANS ALL STD. DEV. ARE EQUAL. DO NOT READ TEEMSLSQ0017
       REM     EQUAL = 1 MEANS THEY ARE NOT EQUAL , READ THEM.          SLSQ0018
       REM  1ST CARD CONTAIN IDENTIFICATION INFORMATION.                SLSQ0019
       REM  2ND CARD CONTAIN N,M,NORVAR ,EQUAL                          SLSQ0020
       REM  3RD SET OF CARDS CONTAIN  DATA , NORMAL OR COVARIANCE MATRIXSLSQ0021
       REM                     AND THE LAST OF SET IS BLANK CARD.       SLSQ0022
       REM  4TH SET OF CARDS CONTAIN DATA , COEFFICIENTS FOR 1ST        SLSQ0023
       REM          OBSERVATION AND THEN 2ND OBSERVATION ETC. LAST CARD SLSQ0024
       REM                                           IS BLANK CARD.     SLSQ0025
       REM  5TH SET OF CARDS CONTAIN DATA , STD. DEV. AND NUMBER OF     SLSQ0026
       REM        OBSERVATIONS USED TO COMPUTE STD. DEV. LAST CARD IS   SLSQ0027
       REM                                                   BLANK.     SLSQ0028
       EJECT                                                            SLSQ0029
BEGIN  CLA     XINPUT     XINPUT= INPUT TAPE UNIT                       SLSQ0030
       TSX     READX,4                                                  SLSQ0031
               TITLE                                                    SLSQ0032
       REM   TO WRITE IDENTIFICATION INFORMATION                        SLSQ0033
       TSX     GETBCD,4                                                 SLSQ0034
               TITLE                                                    SLSQ0035
       PXD     ,0                                                       SLSQ0036
       CLA     TITLE                                                    SLSQ0037
       SUB     =H                                                       SLSQ0038
       TNZ     *+2                                                      SLSQ0039
       CALL    EXIT                                                     SLSQ0040
       CLA     XOUTPT                                                   SLSQ0041
       TSX     BCDOTX,4                                                 SLSQ0042
               MEST1,,TITLE+11                                          SLSQ0043
       CLA     XINPUT                                                   SLSQ0044
       TSX     READX,4                                                  SLSQ0045
               N  READ N,M,NORVAR,EQUAL                                 SLSQ0046
       CLA     XINPUT                                                   SLSQ0047
       TSX     READX,4                                                  SLSQ0048
       MZE     SIGMA                                                    SLSQ0049
       CLA     XINPUT                                                   SLSQ0050
       TSX     READX,4                                                  SLSQ0051
       MZE     Z                                                        SLSQ0052
       NZT     EQUAL                                                    SLSQ0053
       TRA     PRA.                                                     SLSQ0054
       CLA     XINPUT                                                   SLSQ0055
       TSX     READX,4                                                  SLSQ0056
       MZE     SIG                                                      SLSQ0057
 PRA.  LAC     M,4                                                      SLSQ0058
       SXD     *+1,4                                                    SLSQ0059
       TXI     *+1,4,**                                                 SLSQ0060
       SXD     NOOP+4,4                                                 SLSQ0061
       SXD     NUT2,4                                                   SLSQ0062
       SXD     MAGNUT,4                                                 SLSQ0063
       SXD     FURD.,4                                                  SLSQ0064
       AXT     0,2                                                      SLSQ0065
 AURD  LDQ     SIG,2                                                    SLSQ0066
       FMP     SIG,2                                                    SLSQ0067
       STO     SIG,2                                                    SLSQ0068
       TXI     *+1,2,-2                                                 SLSQ0069
FURD.  TXH     AURD,2,**    -(M+M)                                      SLSQ0070
       ZET     EQUAL                                                    SLSQ0071
       TRA     MUMP                                                     SLSQ0072
 NOOP  AXT     0,1                                                      SLSQ0073
       CLA     =1.                                                      SLSQ0074
       STO     SIG,1                                                    SLSQ0075
       TXI     *+1,1,-2                                                 SLSQ0076
       TXH     NOOP+1,1,**   -(M+M)                                     SLSQ0077
       EJECT                                                            SLSQ0078
 MUMP  TSX     NORMAL,4                                                 SLSQ0079
               SIGMA                                                    SLSQ0080
               Z                                                        SLSQ0081
               N                                                        SLSQ0082
               M                                                        SLSQ0083
               A                                                        SLSQ0084
               B                                                        SLSQ0085
               NORVAR                                                   SLSQ0086
               SIG                                                      SLSQ0087
* STORE ALL INTERGERS OR FIXED PT. VARIABLES IN THE DECREMENT PART.     SLSQ0088
*                                           I.E. IN FORTRAN FASHION*****SLSQ0089
*                                                                       SLSQ0090
       CLA     N                                                        SLSQ0091
       ADD     =1                                                       SLSQ0092
       PAX     ,1                                                       SLSQ0093
       SXD     MIP,1    MIP= N+1                                        SLSQ0094
       CLA     N                                                        SLSQ0095
       PAX     ,1                                                       SLSQ0096
       SXD     N,1                                                      SLSQ0097
       TSX     TRING,4                                                  SLSQ0098
               A                                                        SLSQ0099
               B                                                        SLSQ0100
               N                                                        SLSQ0101
               MIP                                                      SLSQ0102
               DET                                                      SLSQ0103
       TSX     SOLVE,4                                                  SLSQ0104
               A                                                        SLSQ0105
               N                                                        SLSQ0106
               MIP                                                      SLSQ0107
               X                                                        SLSQ0108
       EJECT                                                            SLSQ0109
       SPACE   4                                                        SLSQ0110
       REM   TO CALCULATE MEAN STD. DEV.                                SLSQ0111
       NZT     EQUAL                                                    SLSQ0112
       TRA     PUMP                                                     SLSQ0113
       AXT     -1,2                                                     SLSQ0114
       STZ     SUM1                                                     SLSQ0115
 NUT1  CLA     SIG,2                                                    SLSQ0116
       SUB     =1                                                       SLSQ0117
       ORA     =O233000000000                                           SLSQ0118
       FAD     =0.                                                      SLSQ0119
       STO     SIG,2                                                    SLSQ0120
       FAD     SUM1                                                     SLSQ0121
       STO     SUM1    NK(I)-1 , I=1,15,2                               SLSQ0122
       TXI     *+1,2,-2                                                 SLSQ0123
NUT2   TXH     NUT1,2,**   -(M+M)                                       SLSQ0124
       STZ     STDDEV                                                   SLSQ0125
       AXT     0,1                                                      SLSQ0126
       AXT     -1,2                                                     SLSQ0127
NUTMAG LDQ     SIG,2                                                    SLSQ0128
       FMP     SIG,1                                                    SLSQ0129
       FAD     STDDEV                                                   SLSQ0130
       STO     STDDEV                                                   SLSQ0131
       TXI     *+1,1,-2                                                 SLSQ0132
       TXI     *+1,2,-2                                                 SLSQ0133
MAGNUT TXH     NUTMAG,2,**    -(M+M)                                    SLSQ0134
       CLA     STDDEV                                                   SLSQ0135
       FDP     SUM1                                                     SLSQ0136
       XCA                                                              SLSQ0137
       TSX     SQRT,4                                                   SLSQ0138
       STO     STDDEV                                                   SLSQ0139
       EJECT                                                            SLSQ0140
       SPACE   4                                                        SLSQ0141
 PUMP  CLA     XOUTPT                                                   SLSQ0142
       TSX     BCDOTX,4                                                 SLSQ0143
               MES2,,MES2+5                                             SLSQ0144
       REM   TO WRITE SOLUTION VECTOR                                   SLSQ0145
       LXA     XOUTPT,4                                                 SLSQ0146
       SXD     PIG+2,4                                                  SLSQ0147
       SXD     END1+2,4                                                 SLSQ0148
       SXD     FURD,4                                                   SLSQ0149
       CLA     N                                                        SLSQ0150
       SUB     =1                                                       SLSQ0151
       PAX     ,1                                                       SLSQ0152
       SXD     PIG,1                                                    SLSQ0153
       AXT     0,1                                                      SLSQ0154
       TSX     WRIT,4                                                   SLSQ0155
               X,4+1,15*64+7                                            SLSQ0156
       TXI     *+1,1,1                                                  SLSQ0157
 PIG   TXL     *-3,1,**                                                 SLSQ0158
       TSX     WRIT,4                                                   SLSQ0159
       MZE     =H0     ,,**      OUTPUT TAPE UNIT                       SLSQ0160
       SPACE   3                                                        SLSQ0161
       REM     TO WRITE OUTPUT    (INVERSE MATRIX)                      SLSQ0162
       CLA     XOUTPT                                                   SLSQ0163
       TSX     BCDOTX,4                                                 SLSQ0164
               MES3,,MES3+6                                             SLSQ0165
       CLA     N                                                        SLSQ0166
       PAX     ,1                                                       SLSQ0167
       SXD     END1-1,1                                                 SLSQ0168
       LDQ     N                                                        SLSQ0169
       MPY     N                                                        SLSQ0170
       XCA                                                              SLSQ0171
       STA     NN2       N*N                                            SLSQ0172
       STA     MIP     MIP=NN2 AT THIS STAGE                            SLSQ0173
       PAX     ,1                                                       SLSQ0174
       SXD     END1,1                                                   SLSQ0175
       CLA     N                                                        SLSQ0176
       PAX     ,1                                                       SLSQ0177
       SUB     =1                                                       SLSQ0178
       ADD     N                                                        SLSQ0179
       PAX     ,2    (N-1)+N                                            SLSQ0180
       SXD     END2,2                                                   SLSQ0181
 LOOP  TSX     WRIT,4                                                   SLSQ0182
               X,4+1,15*64+7                                            SLSQ0183
       TXI     *+1,1,**     N                                           SLSQ0184
 END1  TXL     LOOP,1,**       N*N                                      SLSQ0185
       TSX     WRIT,4                                                   SLSQ0186
       MZE     =H0     ,,**      OUTPUT TAPE UNIT                       SLSQ0187
       PXA     ,1                                                       SLSQ0188
       SUB     NN2                                                      SLSQ0189
       ADD     =1                                                       SLSQ0190
       PAX     ,1                                                       SLSQ0191
       CLA     MIP      NN2                                             SLSQ0192
       ADD     =1                                                       SLSQ0193
       STO     MIP     NN2                                              SLSQ0194
       PAX     ,4                                                       SLSQ0195
       SXD     END1,4                                                   SLSQ0196
 END2  TXL     LOOP,1,**   (N-1)+N                                      SLSQ0197
       SPACE   3                                                        SLSQ0198
       NZT     EQUAL                                                    SLSQ0199
       TRA     BEGIN                                                    SLSQ0200
       REM       TO WRITE STD. DEVIATION                                SLSQ0201
       CLA     XOUTPT                                                   SLSQ0202
       TSX     BCDOTX,4                                                 SLSQ0203
               MES4,,MES4+2                                             SLSQ0204
       AXT     0,1                                                      SLSQ0205
       TSX     WRIT,4                                                   SLSQ0206
               STDDEV,4+1,15*64+7                                       SLSQ0207
       TSX     WRIT,4                                                   SLSQ0208
 FURD  MZE     =H0     ,,**    OUTPUT TAPE                              SLSQ0209
       TRA     BEGIN                                                    SLSQ0210
       EJECT                                                            SLSQ0211
 N                      NUMBER OF COEFFICIENTS.                         SLSQ0212
 M                      NUMBER OF OBSERVATIONS.                         SLSQ0213
NORVAR                                                                  SLSQ0214
 EQUAL                                                                  SLSQ0215
 MIP                    NUMBER OF COLUMNS OF MATRIX B.                  SLSQ0216
 DET                                                                    SLSQ0217
 NN2                                                                    SLSQ0218
STDDEV DEC     0                                                        SLSQ0219
SUM1   DEC     0                                                        SLSQ0220
XINPUT DEC     2  INPUT TAPE UNDER BELL SYSTEM                          SLSQ0221
XOUTPT DEC     3  OUTPUT TAPE UNDER BELL SYSTEM.                        SLSQ0222
 MEST1 BCD 01 COMBINATION OF DIFFERENT LEAST-SQUARES APPROXIMATIONS SAO SLSQ0223
 TITLE BSS     12                                                       SLSQ0224
 SIGMA BSS     3200    .50 *(8*8).   MAXIMUM LIMIT  M=50,N=8            SLSQ0225
 Z     BSS     400     .50*8.                                           SLSQ0226
 MES2  BCD 6-----SOLUTION VECTOR  (COEFFICIENTS)                        SLSQ0227
 MES3  BCD 7-                       INVERSE MARTIX                      SLSQ0228
 MES4  BCD 3-      STD.DEV.                                             SLSQ0229
 SIG   BSS     100   50 LOC. FOR STDDEV AND REMAINING FOR NUMBER OF OBSESLSQ0230
*                                                                       SLSQ0231
 A     BES     63                                                       SLSQ0232
       BSS     1                                                        SLSQ0233
 B     BES     71                                                       SLSQ0234
       BSS     1                                                        SLSQ0235
 X     BES     71                                                       SLSQ0236
       BSS     1                                                        SLSQ0237
       END                                                              SLSQ0238
*      FAP                                                              SLSQ0239
* KADAKIA, COMBINATION OF DIFFERENT LEAST-SQUARES APPROXIMATION* NORMAL SLSQ0240
       EJECT                                                            SLSQ0241
* READ SIGMA MATRICES ROWWISE  1ST ROW  AND 2ND ROW  ETC.               SLSQ0242
*      CALLING SEQUENCE FOR SUBROUTINE NORMAL                           SLSQ0243
*      TSX     NORMAL,4                                                 SLSQ0244
*              SIGMA                                                    SLSQ0245
*              Z                                                        SLSQ0246
*              N                                                        SLSQ0247
*              M                                                        SLSQ0248
*              A                                                        SLSQ0249
*              B                                                        SLSQ0250
*              NCNT                                                     SLSQ0251
*              SIG                                                      SLSQ0252
       SPACE   4                                                        SLSQ0253
*      NCNT = 0 READ VARIANCE-COVARIANCE MATRICES.                      SLSQ0254
*      NCNT = 1 READ NORMAL MATRICES .                                  SLSQ0255
*      NCNT = -1 READ INVERSE MATRICES, COVARIANCE MATRIX =             SLSQ0256
*                                             INVERSE MATRIX * SIG**2.  SLSQ0257
*      SIGMA(N,N) IS COVARIANCE MATRIX /R NORMAL MATRIX OR INVERSE MATRISLSQ0258
*                    DEPENDING ON THE VALUE OF NCNT.                    SLSQ0259
*      M = TOTAL NUMBER OF SIGMA MATRICES( THAT IS TOTAL NUMBER OF      SLSQ0260
*          LEAST SQUARES APPROXITATIONS THAT ARE TO BE COMBINE TO HAVE  SLSQ0261
*                A LEAST SQUARES APPROXIMATION WITH N COEFFICIENTS.     SLSQ0262
*      N = NUMBER OF UNKNOWNS COEFFICIENTS.                             SLSQ0263
*      A(N,N) IS ADDITIVE MATRIX OF ALL SIGMA MATRICES.                 SLSQ0264
*      B(N,N+1) IS RIGHT HAND SIDE MATRIX                ( 1ST COLUMN ISSLSQ0265
*          RIGHT HAND SIDE VECTOR AND 2ND TO N+1 COLUMNS ARE FOR        SLSQ0266
*                                      IDENTITY MATRIX.                 SLSQ0267
*      Z(N,N+1) IS SOLUTION MATRIX ( 1ST COLUMN IS SOLUTION VECTOR AND  SLSQ0268
*          2ND TO N+1 COLUMNS ARE FOR INVERSE MATIX).                   SLSQ0269
*      A,B  ARE STORED IN  BES  CONVENTION.                             SLSQ0270
*      Z, SIGMA MATRICES ARE STORED IN  BSS  CONVENTION.                SLSQ0271
       LBL     NORMAL,X                                                 SLSQ0272
       EJECT                                                            SLSQ0273
       SPACE   3                                                        SLSQ0274
       ENTRY   NORMAL                                                   SLSQ0275
       EXTERN  TRING                                                    SLSQ0276
       EXTERN  SOLVE                                                    SLSQ0277
NORMAL CLA     1,4        SIGMA                                         SLSQ0278
       STA     LOOP1                                                    SLSQ0279
       STA     LOOP4                                                    SLSQ0280
       STA     T0DO                                                     SLSQ0281
       STA     T7DO+1                                                   SLSQ0282
       STA     NUT5                                                     SLSQ0283
       STA     NUT5+2                                                   SLSQ0284
       STA     INVRSE                                                   SLSQ0285
       STA     INVRSE+2                                                 SLSQ0286
       SPACE   2                                                        SLSQ0287
       CLA     2,4       Z                                              SLSQ0288
       STA     LOOP4+1                                                  SLSQ0289
       SPACE   2                                                        SLSQ0290
       CLA*    3,4        N                                             SLSQ0291
       STA     N                                                        SLSQ0292
       CLA*    4,4     M                                                SLSQ0293
       STA     M                                                        SLSQ0294
       SPACE   2                                                        SLSQ0295
       CLA     5,4         A                                            SLSQ0296
       STA     LOOP2                                                    SLSQ0297
       STA     LOOP1+1                                                  SLSQ0298
       STA     LOOP1+2                                                  SLSQ0299
       STA     T0DO+1                                                   SLSQ0300
       STA     JUMP+1                                                   SLSQ0301
       STA     JUMP+7                                                   SLSQ0302
       SPACE   2                                                        SLSQ0303
       CLA     6,4       B                                              SLSQ0304
       STA     LOOP3+2                                                  SLSQ0305
       STA     LOOP4+3                                                  SLSQ0306
       STA     LOOP4+2                                                  SLSQ0307
       STA     LOOP5                                                    SLSQ0308
       STA     LOOP6                                                    SLSQ0309
       STA     LOOP6+2                                                  SLSQ0310
       STA     T2DO                                                     SLSQ0311
       STA     T3DO                                                     SLSQ0312
       STA     T3DO+2                                                   SLSQ0313
       STA     JUMP+2                                                   SLSQ0314
       STA     T7DO                                                     SLSQ0315
       STA     3..                                                      SLSQ0316
       CLA     7,4                                                      SLSQ0317
       STA     *+1                                                      SLSQ0318
       CLA     **                                                       SLSQ0319
       STO     NCNT                                                     SLSQ0320
       CLA     8,4       FOR SIG                                        SLSQ0321
       STA     NUT5+1                                                   SLSQ0322
       STA     INVRSE+1                                                 SLSQ0323
       EJECT                                                            SLSQ0324
       REM     SAVE ALL INDEX REGISTERS                                 SLSQ0325
       SXA     TEMP1,1                                                  SLSQ0326
       SXA     TEMP2,2                                                  SLSQ0327
       SXA     TEMP3,4                                                  SLSQ0328
       SPACE   3                                                        SLSQ0329
       LDQ     N                                                        SLSQ0330
       MPY     N                                                        SLSQ0331
       XCA                                                              SLSQ0332
       STO     NN                                                       SLSQ0333
       SUB     =1                                                       SLSQ0334
       STO     NN1                                                      SLSQ0335
       PAX     ,1                                                       SLSQ0336
       SXD     END2,1                                                   SLSQ0337
       SXD     T3DO-2,1                                                 SLSQ0338
       SXD     T3DO+4,1                                                 SLSQ0339
       CLA     N                                                        SLSQ0340
       SUB     =1                                                       SLSQ0341
       STO     N1                                                       SLSQ0342
       PAX     ,1                                                       SLSQ0343
       SXD     END4,1                                                   SLSQ0344
       ADD     =2          N+1                                          SLSQ0345
       PAX     ,1                                                       SLSQ0346
       SXD     LOOP6+3,1                                                SLSQ0347
       SXD     T3DO+3,1                                                 SLSQ0348
       CLA     NN                                                       SLSQ0349
       ADD     N1                                                       SLSQ0350
       PAX     ,1                                                       SLSQ0351
       SXD     LOOP6+4,1                                                SLSQ0352
       SXD     LOOP6-2,1                                                SLSQ0353
       LDQ     NN      N*N                                              SLSQ0354
       MPY     M                                                        SLSQ0355
       XCA                                                              SLSQ0356
       PAC     ,1                                                       SLSQ0357
       SXD     T6DO,1                                                   SLSQ0358
       SUB     NN                                                       SLSQ0359
       ADD     =1     NN*M-NN+1                                         SLSQ0360
       PAC     ,1                                                       SLSQ0361
       SXA     JUNK,1                                                   SLSQ0362
       SXD     END3,1                                                   SLSQ0363
       SXD     END1,1                                                   SLSQ0364
       LAC     NN,1                                                     SLSQ0365
       SXD     LOOP4+4,1                                                SLSQ0366
       SXD     END1-1,1                                                 SLSQ0367
       LAC     N,1                                                      SLSQ0368
       SXD     LOOP4+5,1                                                SLSQ0369
       SXD     END5,1                                                   SLSQ0370
       SXD     END3+3,1                                                 SLSQ0371
       SXD     END3+6,1                                                 SLSQ0372
       EJECT                                                            SLSQ0373
       SPACE   4                                                        SLSQ0374
       ZET     NCNT                                                     SLSQ0375
       TRA     BEGIN1                                                   SLSQ0376
       REM   COMPUTE INVERSES OF ALL COVARIANCE MATRICES.               SLSQ0377
PART1  STZ     DUMP                                                     SLSQ0378
       AXT     0,3                                                      SLSQ0379
       LAC     NN,4                                                     SLSQ0380
       SXD     T1DO,4                                                   SLSQ0381
       SXD     T4DO,4                                                   SLSQ0382
       SXA     DUMP1,4                                                  SLSQ0383
       SXA     TEMP,4                                                   SLSQ0384
       REM      LOOP   STORE COVARIANCE MATRIX INTO MATRIX A.           SLSQ0385
T0DO   CLA     **,1     SIGMA                                           SLSQ0386
       STO     **,2    A                                                SLSQ0387
       TXI     *+1,1,-1                                                 SLSQ0388
       TXI     *+1,2,1                                                  SLSQ0389
T1DO   TXH     T0DO,1,**    -NN                                         SLSQ0390
       AXT     0,4                                                      SLSQ0391
T2DO   STZ     **,4    B                                                SLSQ0392
       TXI     *+1,4,1                                                  SLSQ0393
       TXL     T2DO,4,**    NN-1                                        SLSQ0394
       AXT     0,4                                                      SLSQ0395
       REM     FORM  IDENTITY MATIX                                     SLSQ0396
T3DO   CLA     **,4    B                                                SLSQ0397
       FAD     =1.                                                      SLSQ0398
       STO     **,4    B                                                SLSQ0399
       TXI     *+1,4,**     N+1                                         SLSQ0400
       TXL     T3DO,4,**    NN-1                                        SLSQ0401
       CLA     N                                                        SLSQ0402
       PAX     ,4                                                       SLSQ0403
       SXD     NDEC,4                                                   SLSQ0404
       REM    SO WE HAVE MATRIX  A AND MATIX (I).                       SLSQ0405
 JUMP  TSX     TRING,4                                                  SLSQ0406
               **     A                                                 SLSQ0407
               **       B                                               SLSQ0408
               NDEC                                                     SLSQ0409
               NDEC                                                     SLSQ0410
               CONST                                                    SLSQ0411
       TSX     SOLVE,4                                                  SLSQ0412
               **          A                                            SLSQ0413
               NDEC                                                     SLSQ0414
               NDEC                                                     SLSQ0415
3..            **        B                                              SLSQ0416
       REM  LOOP STORE INVERSE OF COVARIANCE MATRIX INTO  ORIGINAL LOC. SLSQ0417
       LXA     DUMP,1                                                   SLSQ0418
       AXT     0,2                                                      SLSQ0419
T7DO   CLA     **,2     B                                               SLSQ0420
       STO     **,1     SIGMA                                           SLSQ0421
       TXI     *+1,1,-1                                                 SLSQ0422
       TXI     *+1,2,1                                                  SLSQ0423
T4DO   TXH     T7DO,1,**    -NN                                         SLSQ0424
       CLA     DUMP                                                     SLSQ0425
       ADD     TEMP        -NN                                          SLSQ0426
       STO     DUMP                                                     SLSQ0427
       PAX     ,1                                                       SLSQ0428
       CLA     DUMP1                                                    SLSQ0429
T5DO   ADD     TEMP      -NN                                            SLSQ0430
       STO     DUMP1                                                    SLSQ0431
       PAX     ,4                                                       SLSQ0432
       SXD     T1DO,4                                                   SLSQ0433
       SXD     T4DO,4                                                   SLSQ0434
       AXT     0,2                                                      SLSQ0435
T6DO   TXH     T1DO,1,**  -NN  *M                                       SLSQ0436
       TRA     BEGIN                                                    SLSQ0437
       EJECT                                                            SLSQ0438
       SPACE   4                                                        SLSQ0439
       REM     NORMAL MATRIX IS DIVIDED BY SIG ( STD. DEV.)             SLSQ0440
       REM             OR                                               SLSQ0441
       REM     INVERSE MATRIX IS MULTIPLY BY  SIG  IF NCNT IS NEGATIVE. SLSQ0442
       REM         SO COVARIANCE MATRIX  = INVERSE MATRIX*(SIG**2)      SLSQ0443
BEGIN1 STZ     DUMP                                                     SLSQ0444
       AXT     0,3                                                      SLSQ0445
       LAC     NN,4                                                     SLSQ0446
       SXD     NUTEND,4                                                 SLSQ0447
       SXA     DUMP1,4                                                  SLSQ0448
       SXD     NUTEN5,4                                                 SLSQ0449
       SXA     TEMP,4                                                   SLSQ0450
       LAC     M,4                                                      SLSQ0451
       SXD     *+1,4                                                    SLSQ0452
       TXI     *+1,4,**     -M                                          SLSQ0453
       SXD     ENDNUT,4                                                 SLSQ0454
       AXT     0,2                                                      SLSQ0455
NUT    CLA     NCNT                                                     SLSQ0456
       TMI     INVRSE                                                   SLSQ0457
NUT5   CLA     **,1    SIGMA                                            SLSQ0458
       FDP     **,2   SIG                                               SLSQ0459
       STQ     **,1   SIGMA                                             SLSQ0460
       TXI     *+1,1,-1                                                 SLSQ0461
NUTEND TXH     NUT5,1,**  -NN                                           SLSQ0462
       TRA     NUTEN5+1                                                 SLSQ0463
INVRSE LDQ     **,1   SIGMA                                             SLSQ0464
       FMP     **,2   SIG                                               SLSQ0465
       STO     **,1   SIGMA                                             SLSQ0466
       TXI     *+1,1,-1                                                 SLSQ0467
NUTEN5 TXH     INVRSE,1,**   -NN                                        SLSQ0468
       TXI     *+1,2,-2                                                 SLSQ0469
       CLA     DUMP                                                     SLSQ0470
       ADD     TEMP                                                     SLSQ0471
       STO     DUMP                                                     SLSQ0472
       PAX     ,1                                                       SLSQ0473
       CLA     DUMP1                                                    SLSQ0474
       ADD     TEMP                                                     SLSQ0475
       STO     DUMP1                                                    SLSQ0476
       PAX     ,4                                                       SLSQ0477
       SXD     NUTEND,4                                                 SLSQ0478
       SXD     NUTEN5,4                                                 SLSQ0479
ENDNUT TXH     NUT,2,**      -(M+M)                                     SLSQ0480
       CLA     NCNT                                                     SLSQ0481
       TMI     PART1                                                    SLSQ0482
       REM     GO TO PART1 IF  NCNT = -1 SO FAR , COVARIANCE MATRIX =   SLSQ0483
       REM             INVERSE MATRIX * SIG**2 IS DONE.                 SLSQ0484
       EJECT                                                            SLSQ0485
       SPACE   4                                                        SLSQ0486
BEGIN  AXT     0,3                                                      SLSQ0487
       SXA     TEMP,1                                                   SLSQ0488
 LOOP2 STZ     **,1     A                                               SLSQ0489
 LOOP1 CLA     **,2    SIGMA                                            SLSQ0490
       STO     **,1       A                                             SLSQ0491
       FAD     **,1       A                                             SLSQ0492
       TXI     *+1,2,**      -NN                                        SLSQ0493
 END1  TXH     LOOP1,2,**    -NN*M-NN+1                                 SLSQ0494
       CLA     END1                                                     SLSQ0495
       PDX     ,2                                                       SLSQ0496
       TXI     *+1,2,-1                                                 SLSQ0497
       SXD     END1,2                                                   SLSQ0498
       LXA     TEMP,2                                                   SLSQ0499
       TXI     *+1,2,-1                                                 SLSQ0500
       SXA     TEMP,2                                                   SLSQ0501
       TXI     *+1,1,1                                                  SLSQ0502
 END2  TXL     LOOP2,1,**    NN-1                                       SLSQ0503
       SPACE   4                                                        SLSQ0504
       REM  TO CALCULATE  MATRIX  B(N,1)                                SLSQ0505
       AXT     0,7                                                      SLSQ0506
LOOP3  SXA     CONST,4                                                  SLSQ0507
