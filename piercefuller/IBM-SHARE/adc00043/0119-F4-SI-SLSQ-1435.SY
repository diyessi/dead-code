       CLA     N                                                        SLSQ0653
       SUB     ONE                                                      SLSQ0654
       STO     N1                                                       SLSQ0655
       PAX     0,1                                                      SLSQ0656
       SXD     GO+3,1                                                   SLSQ0657
       SXD     JBACK-1,1                                                SLSQ0658
       XCA                                                              SLSQ0659
       MPY     IP                                                       SLSQ0660
       STQ     NIP                                                      SLSQ0661
       LDQ     N                                                        SLSQ0662
       MPY     N                                                        SLSQ0663
       XCA                                                              SLSQ0664
       SPACE   2                                                        SLSQ0665
       STO     NN                                                       SLSQ0666
       SPACE                                                            SLSQ0667
       ADD     NIP                                                      SLSQ0668
       ADD     IP                                                       SLSQ0669
       SUB     N                                                        SLSQ0670
       STO     NNIP       = (NN-1)+(IP-1)*N+1                           SLSQ0671
       CLA     NIP                                                      SLSQ0672
       ADD     IP                                                       SLSQ0673
       SPACE   2                                                        SLSQ0674
       SUB     ONE             = (N*IP)-1                               SLSQ0675
       PAX     0,1                                                      SLSQ0676
       SXD     GOTO+4,1                                                 SLSQ0677
       SPACE   2                                                        SLSQ0678
       CLA     N                                                        SLSQ0679
       ADD     ONE                                                      SLSQ0680
       PAX     0,1                                                      SLSQ0681
       SXD     JBACK+1,1                                                SLSQ0682
       SPACE   2                                                        SLSQ0683
       CLA     NN                                                       SLSQ0684
       SUB     ONE                                                      SLSQ0685
       STO     NN1                                                      SLSQ0686
       SUB     ONE     = NN-2                                           SLSQ0687
       PAX     0,4      = NN-1 IN IR4.                                  SLSQ0688
       SXD     END1,4                                                   SLSQ0689
       CLA     NN1                                                      SLSQ0690
       ADD     NIP                                                      SLSQ0691
       ADD     IP      IN AC  NN1+NIP+IP                                SLSQ0692
       PAX     0,4                                                      SLSQ0693
       SXD     LOOP6+5,4                                                SLSQ0694
