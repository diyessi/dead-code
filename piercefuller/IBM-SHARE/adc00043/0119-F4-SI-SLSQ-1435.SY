       SPACE   2                                                        SLSQ0717
       PXD     ,0                                                       SLSQ0718
       ADM     **,4      A,4                                            SLSQ0719
       STO     VALUE                                                    SLSQ0720
       PXA     ,4                                                       SLSQ0721
       ADD     ONE                                                      SLSQ0722
       PAX     0,1                                                      SLSQ0723
       SPACE                                                            SLSQ0724
 LOOP1 PXD     ,0                                                       SLSQ0725
       ADM     **,1       =A                                            SLSQ0726
       CAS     VALUE                                                    SLSQ0727
       TRA     GO                                                       SLSQ0728
