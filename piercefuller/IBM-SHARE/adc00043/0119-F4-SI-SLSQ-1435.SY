 LOOP4 LDQ     **,2     SIGMA                                           SLSQ0510
       FMP     **,4      Z                                              SLSQ0511
       FAD     **,1        B                                            SLSQ0512
       STO     **,1        B                                            SLSQ0513
       TXI     *+1,2,**      -NN                                        SLSQ0514
       TXI     *+1,4,**      -N                                         SLSQ0515
 END3  TXH     LOOP4,2,**       -(NN*(M-1)+1)                           SLSQ0516
       CLA     END3                                                     SLSQ0517
       PDX     ,2                                                       SLSQ0518
       TXI     *+1,2,**      -N                                         SLSQ0519
       SXD     END3,2                                                   SLSQ0520
       LXA     TEMP,2                                                   SLSQ0521
       TXI     *+1,2,**     -N                                          SLSQ0522
       SXA     TEMP,2                                                   SLSQ0523
       LXA     CONST,4                                                  SLSQ0524
       TXI     *+1,4,-1                                                 SLSQ0525
       SXA     CONST,4                                                  SLSQ0526
 END5  TXH     LOOP4,4,**     -N                                        SLSQ0527
