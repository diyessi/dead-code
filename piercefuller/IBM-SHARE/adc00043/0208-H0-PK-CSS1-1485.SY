*     LIST8                                                             CSS10001
*     LABEL                                                             CSS10002
CCSS1          CUTTING STOCK PROGRAM, SHARE VERSION 1                   CSS10003
C                                                                       CSS10004
      COMMON WWEQ,A,D,X,W,Q,B,IA,IMPT,ALPHA,L,M,N,NO,LL,I1,M1,MM,M2,ML1,CSS10005
     1INVT,LOCX,MDIM,LAG,LSTOP,MBAR,LPHS1,LOC,LAG,THETA,QBAR,T,TOTAL,E1,CSS10006
     2EXCESS,STOP1,STOP2,NA,NB,NC,BCD,TRIM                              CSS10007
      DIMENSION WWEQ(15,4),WW(15),CC(15),VV(15),BB(15),A(90,90),WWIN(90)CSS10008
     1,CCIN(90),VVIN(90),BBIN(90),D(90,90),Y(90),P(90),BRE(90),WRE(90),ACSS10009
     2A(90),AB(90),JO(90),JS(90),X(90),W(90),Q(90),B(90,90),QR(90),XINT(CSS10010
     390),EXTRA(90),IA(90),JOX(90),IMPT(90),JOY(90),ALPHA(12),BCD(90),  CSS10011
     4TRIM(20),WIN(90),QIN(90)                                          CSS10012
      EQUIVALENCE (WWEQ,WW),(WWEQ(16),CC),(WWEQ(31),VV),(WWEQ(46),BB),(ACSS10013
     1,WWIN),(A(91),CCIN),(A(181),VVIN),(A(271),BBIN),(A(361),WIN),(A(45CSS10014
     21),QIN),(D,Y),(D(181),BRE),(D(271),WRE),(D(361),AA),(D(451),AB),(DCSS10015
     3(541),JO),(D(631),JS),(B,QR),(B(91),XINT),(B(181),EXTRA),(IA,JOX),CSS10016
     4(IMPT,JOY),(D(91),P)                                              CSS10017
C                                                                       CSS10018
      NA=5                                                              CSS10019
      NB=6                                                              CSS10020
      NC=3                                                              CSS10021
      MDIM=90                                                           CSS10022
      REWIND NC                                                         CSS10023
   10 CALL INS1                                                         CSS10024
      CALL SETS1                                                        CSS10025
      CALL OUT1S1                                                       CSS10026
      NO=0                                                              CSS10027
    3 CALL INVTS1                                                       CSS10028
    2 CALL SLCKS1                                                       CSS10029
      IF (LOC)1,1,5                                                     CSS10030
    1 CALL COLS1                                                        CSS10031
      IF (LOC)8,8,5                                                     CSS10032
    5 CALL ROWS1                                                        CSS10033
      IF (LOC)8,8,9                                                     CSS10034
    9 CALL GES1                                                         CSS10035
      NO=NO+1                                                           CSS10036
      CALL CUTS1                                                        CSS10037
      IF (LOC)7,7,8                                                     CSS10038
    7 IF (XMODF(NO,INVT))2,3,2                                          CSS10039
    8 CALL OUT2S1                                                       CSS10040
      IF (LOC)11,6,11                                                   CSS10041
    6 CALL OUT3S1                                                       CSS10042
   11 IF (SENSE SWITCH 2)12,10                                          CSS10043
   12 CALL EXIT                                                         CSS10044
      END                                                               CSS10045
*     LIST8                                                             CSS10046
*     LABEL                                                             CSS10047
      SUBROUTINE COLS1                                                  CSS10048
C                                                                       CSS10049
      COMMON WWEQ,A,D,X,W,Q,B,IA,IMPT,ALPHA,L,M,N,NO,LL,I1,M1,MM,M2,ML1,CSS10050
     1INVT,LOCX,MDIM,LAG,LSTOP,MBAR,LPHS1,LOC,LAG,THETA,QBAR,T,TOTAL,E1,CSS10051
     2EXCESS,STOP1,STOP2,NA,NB,NC,BCD,TRIM                              CSS10052
      DIMENSION WWEQ(15,4),WW(15),CC(15),VV(15),BB(15),A(90,90),WWIN(90)CSS10053
     1,CCIN(90),VVIN(90),BBIN(90),D(90,90),Y(90),P(90),BRE(90),WRE(90),ACSS10054
     2A(90),AB(90),JO(90),JS(90),X(90),W(90),Q(90),B(90,90),QR(90),XINT(CSS10055
     390),EXTRA(90),IA(90),JOX(90),IMPT(90),JOY(90),ALPHA(12),BCD(90),  CSS10056
     4TRIM(20),WIN(90),QIN(90)                                          CSS10057
      EQUIVALENCE (WWEQ,WW),(WWEQ(16),CC),(WWEQ(31),VV),(WWEQ(46),BB),(ACSS10058
     1,WWIN),(A(91),CCIN),(A(181),VVIN),(A(271),BBIN),(A(361),WIN),(A(45CSS10059
     21),QIN),(D,Y),(D(181),BRE),(D(271),WRE),(D(361),AA),(D(451),AB),(DCSS10060
     3(541),JO),(D(631),JS),(B,QR),(B(91),XINT),(B(181),EXTRA),(IA,JOX),CSS10061
     4(IMPT,JOY),(D(91),P)                                              CSS10062
C                                                                       CSS10063
C     STEP A. REDUCE ENTRIES IN KNAPSACK PROBLEM                        CSS10064
      LOC=0                                                             CSS10065
      LOCW=(XMODF(NO,LOCX))                                             CSS10066
    2 MBAR=0                                                            CSS10067
      DO 3 JJ=1,M                                                       CSS10068
      IF (LOCW)1,4,1                                                    CSS10069
    1 IF (IMPT(JJ))3,3,4                                                CSS10070
    4 IF (M-JJ) 6,6,7                                                   CSS10071
    7 DO 8 J=JJ,MM                                                      CSS10072
      IF (LOCW)9,5,9                                                    CSS10073
    9 IF (IMPT(J+1))8,8,5                                               CSS10074
    5 IF (ABSF(B(1,JJ+1)-B(1,J+2))-E1)3,3,8                             CSS10075
    8 CONTINUE                                                          CSS10076
    6 MBAR=MBAR+1                                                       CSS10077
      AA(MBAR)=B(1,JJ+1)/W(JJ)                                          CSS10078
      JS(MBAR)=JJ                                                       CSS10079
      JO(MBAR)=1                                                        CSS10080
    3 CONTINUE                                                          CSS10081
      MMBAR=MBAR-1                                                      CSS10082
      IF (MMBAR)92,92,96                                                CSS10083
C                                                                       CSS10084
C     STEP B. REORDER REDUCED INEQUALITIES.                             CSS10085
   96 DO 99 JJ=2,MBAR                                                   CSS10086
      DO 99 J=JJ,MBAR                                                   CSS10087
      IF (AA(JJ-1)-AA(J)) 95,98,98                                      CSS10088
   95 JO(JJ-1)=JO(JJ-1)+1                                               CSS10089
      GO TO 99                                                          CSS10090
   98 JO(J)=JO(J)+1                                                     CSS10091
   99 CONTINUE                                                          CSS10092
   92 DO 97 J=1,MBAR                                                    CSS10093
      JJ=JO(J)                                                          CSS10094
      JJJ=JS(J)                                                         CSS10095
      WRE(JJ)=W(JJJ)                                                    CSS10096
   97 BRE(JJ)=B(1,JJJ+1)                                                CSS10097
C                                                                       CSS10098
C     STEP C. FIND BEST NEW COLUMN IF ANY                               CSS10099
      DO 82 L1=1,L                                                      CSS10100
      L2=L1+M1                                                          CSS10101
      IF (LOC)90,90,83                                                  CSS10102
   90 C=CC(L1)-B(1,L2)                                                  CSS10103
      GO TO 25                                                          CSS10104
   83 C=C-CC(L1-1)+B(1,L2-1)+CC(L1)-B(1,L2)                             CSS10105
C                                                                       CSS10106
C     STEP C2. COMPUTE AD LOC SOLUTION                                  CSS10107
   25 WWX=WW(L1)                                                        CSS10108
      COUNT=VV(L1)                                                      CSS10109
      DO 20 J=1,MBAR                                                    CSS10110
      AA(J)=MIN1F(COUNT,INTF(WWX/WRE(J)+E1))                            CSS10111
      IF (AA(J)) 20,20,27                                               CSS10112
   27 WWX=WWX-AA(J)*WRE(J)                                              CSS10113
      COUNT=COUNT-AA(J)                                                 CSS10114
   20 CONTINUE                                                          CSS10115
C                                                                       CSS10116
C     STEP C3. TEST FOR SOLUTION                                        CSS10117
   32 T=0.0                                                             CSS10118
      DO 30 J=1,MBAR                                                    CSS10119
   30 T=T+BRE(J)*AA(J)                                                  CSS10120
      IF (T-C-E1)40,40,38                                               CSS10121
   38 C=T                                                               CSS10122
      LOC=1                                                             CSS10123
      LL=L1                                                             CSS10124
      LL2=L2                                                            CSS10125
      DO 36 J=1,MBAR                                                    CSS10126
   36 AB(J)=AA(J)                                                       CSS10127
C                                                                       CSS10128
C     STEP C4. FIND K                                                   CSS10129
   40 IF (MMBAR)82,82,41                                                CSS10130
   41 COUNT=VV(L1)                                                      CSS10131
      K=0                                                               CSS10132
      DO 46 J=1,MMBAR                                                   CSS10133
      IF (AA(J))46,46,47                                                CSS10134
   47 K=J                                                               CSS10135
      COUNT=COUNT-AA(J)                                                 CSS10136
   46 CONTINUE                                                          CSS10137
      IF (K) 82,82,51                                                   CSS10138
C                                                                       CSS10139
C     STEP C5. TEST GROUP OF SOLUTIONS                                  CSS10140
   51 AA(K)=AA(K)-1.0                                                   CSS10141
      COUNT=COUNT+1.0                                                   CSS10142
      WWX=WW(L1)                                                        CSS10143
      T=C                                                               CSS10144
      DO 50 J=1,K                                                       CSS10145
      WWX=WWX-WRE(J)*AA(J)                                              CSS10146
   50 T=T-BRE(J)*AA(J)                                                  CSS10147
      IF (WWX*BRE(K+1)-T*WRE(K+1)-E1)65,65,70                           CSS10148
C                                                                       CSS10149
C     STEP C6. COMPUTE NEW K                                            CSS10150
   65 K=K-1                                                             CSS10151
      IF (K) 82,82,67                                                   CSS10152
   67 IF (AA(K)) 65,65,60                                               CSS10153
   60 COUNT=VV(L1)                                                      CSS10154
      DO 61 J=1,K                                                       CSS10155
   61 COUNT=COUNT-AA(J)                                                 CSS10156
      GO TO 51                                                          CSS10157
C                                                                       CSS10158
C     STEP C7. COMPUTE NEW SOLUTION                                     CSS10159
   70 DO 71 J=K,MMBAR                                                   CSS10160
      AA(J+1)=MIN1F(COUNT,INTF(WWX/WRE(J+1)+E1))                        CSS10161
      IF (AA(J+1))71,71,74                                              CSS10162
   74 WWX=WWX-AA(J+1)*WRE(J+1)                                          CSS10163
      COUNT=COUNT-AA(J+1)                                               CSS10164
   71 CONTINUE                                                          CSS10165
      GO TO 32                                                          CSS10166
C                                                                       CSS10167
C     STEP D. COPY AND UPDATE NEW VARIABLE                              CSS10168
   82 CONTINUE                                                          CSS10169
   89 IF (LOC)81,81,80                                                  CSS10170
   81 IF (LOCW)88,88,87                                                 CSS10171
   87 LOCW=0                                                            CSS10172
      GO TO 2                                                           CSS10173
   80 P(1)=-CC(LL)                                                      CSS10174
      DO 85 J=2,ML1                                                     CSS10175
   85 P(J)=0.0                                                          CSS10176
      DO 84 J=1,MBAR                                                    CSS10177
      JJ=JO(J)                                                          CSS10178
      JJJ=JS(J)                                                         CSS10179
   84 P(JJJ+1)=AB(JJ)                                                   CSS10180
      P(LL2)=1.0                                                        CSS10181
      DO 86 I=1,ML1                                                     CSS10182
      Y(I)=0.0                                                          CSS10183
      DO 86 J=1,ML1                                                     CSS10184
   86 Y(I)=Y(I)+P(J)*B(I,J)                                             CSS10185
   88 RETURN                                                            CSS10186
      END                                                               CSS10187
*     LIST8                                                             CSS10188
*     LABEL                                                             CSS10189
      SUBROUTINE CUTS1                                                  CSS10190
C                                                                       CSS10191
      COMMON WWEQ,A,D,X,W,Q,B,IA,IMPT,ALPHA,L,M,N,NO,LL,I1,M1,MM,M2,ML1,CSS10192
     1INVT,LOCX,MDIM,LAG,LSTOP,MBAR,LPHS1,LOC,LAG,THETA,QBAR,T,TOTAL,E1,CSS10193
     2EXCESS,STOP1,STOP2,NA,NB,NC,BCD,TRIM                              CSS10194
      DIMENSION WWEQ(15,4),WW(15),CC(15),VV(15),BB(15),A(90,90),WWIN(90)CSS10195
     1,CCIN(90),VVIN(90),BBIN(90),D(90,90),Y(90),P(90),BRE(90),WRE(90),ACSS10196
     2A(90),AB(90),JO(90),JS(90),X(90),W(90),Q(90),B(90,90),QR(90),XINT(CSS10197
     390),EXTRA(90),IA(90),JOX(90),IMPT(90),JOY(90),ALPHA(12),BCD(90),  CSS10198
     4TRIM(20),WIN(90),QIN(90)                                          CSS10199
      EQUIVALENCE (WWEQ,WW),(WWEQ(16),CC),(WWEQ(31),VV),(WWEQ(46),BB),(ACSS10200
     1,WWIN),(A(91),CCIN),(A(181),VVIN),(A(271),BBIN),(A(361),WIN),(A(45CSS10201
     21),QIN),(D,Y),(D(181),BRE),(D(271),WRE),(D(361),AA),(D(451),AB),(DCSS10202
     3(541),JO),(D(631),JS),(B,QR),(B(91),XINT),(B(181),EXTRA),(IA,JOX),CSS10203
     4(IMPT,JOY),(D(91),P)                                              CSS10204
C                                                                       CSS10205
      LOC=0                                                             CSS10206
      IF (LPHS1)16,16,19                                                CSS10207
   16 DO 18 I=2,M1                                                      CSS10208
      IF (IA(I))4,4,18                                                  CSS10209
   18 CONTINUE                                                          CSS10210
   19 LPHS1=LPHS1+1                                                     CSS10211
      T=-TOTAL                                                          CSS10212
      DO 11 I=2,M1                                                      CSS10213
      IF (X(I)-E1)11,11,14                                              CSS10214
   14 IF (A(1,I))15,11,11                                               CSS10215
   15 LL=IA(I)                                                          CSS10216
      T=T+X(I)*WW(LL)                                                   CSS10217
   11 CONTINUE                                                          CSS10218
      T=MAX1F(T*100.0/TOTAL,0.0)                                        CSS10219
      NOX=XMODF(NO-1,LAG)+1                                             CSS10220
      IF (LPHS1-LAG)1,1,2                                               CSS10221
    2 IF (TRIM(NOX)-T-STOP1)5,5,1                                       CSS10222
    5 IF (LSTOP)6,6,1                                                   CSS10223
    6 WRITE OUTPUT TAPE NB,10,NO,STOP1,LAG                              CSS10224
   10 FORMAT (8H0AT STEPI4,24H, TRIM REDUCED LESS THAN F10.4,16H PERCENTCSS10225
     1 IN LASTI4,6H STEPS)                                              CSS10226
      LSTOP=XABSF(LSTOP)                                                CSS10227
      IF (LSTOP)1,3,1                                                   CSS10228
    3 LOC=1                                                             CSS10229
    1 TRIM(NOX)=T                                                       CSS10230
      IF (T-STOP2)7,4,4                                                 CSS10231
    7 WRITE OUTPUT TAPE NB,8,STOP2                                      CSS10232
    8 FORMAT (65H0SOLUTION INTERRUPTED BECAUSE TRIM AT ACCEPTABLE LEVEL CSS10233
     1(LESS THAN,F10.4,9H PERCENT))                                     CSS10234
      GO TO 17                                                          CSS10235
    4 IF (SENSE SWITCH 2)12,9                                           CSS10236
   12 WRITE OUTPUT TAPE NB,20                                           CSS10237
   20 FORMAT (33H0SOLUTION INTERRUPTED BY OPERATOR)                     CSS10238
      PAUSE                                                             CSS10239
   17 LOC=1                                                             CSS10240
    9 RETURN                                                            CSS10241
      END                                                               CSS10242
*     LIST8                                                             CSS10243
*     LABEL                                                             CSS10244
      SUBROUTINE GES1                                                   CSS10245
C                                                                       CSS10246
      COMMON WWEQ,A,D,X,W,Q,B,IA,IMPT,ALPHA,L,M,N,NO,LL,I1,M1,MM,M2,ML1,CSS10247
     1INVT,LOCX,MDIM,LAG,LSTOP,MBAR,LPHS1,LOC,LAG,THETA,QBAR,T,TOTAL,E1,CSS10248
     2EXCESS,STOP1,STOP2,NA,NB,NC,BCD,TRIM                              CSS10249
      DIMENSION WWEQ(15,4),WW(15),CC(15),VV(15),BB(15),A(90,90),WWIN(90)CSS10250
     1,CCIN(90),VVIN(90),BBIN(90),D(90,90),Y(90),P(90),BRE(90),WRE(90),ACSS10251
     2A(90),AB(90),JO(90),JS(90),X(90),W(90),Q(90),B(90,90),QR(90),XINT(CSS10252
     390),EXTRA(90),IA(90),JOX(90),IMPT(90),JOY(90),ALPHA(12),BCD(90),  CSS10253
     4TRIM(20),WIN(90),QIN(90)                                          CSS10254
      EQUIVALENCE (WWEQ,WW),(WWEQ(16),CC),(WWEQ(31),VV),(WWEQ(46),BB),(ACSS10255
     1,WWIN),(A(91),CCIN),(A(181),VVIN),(A(271),BBIN),(A(361),WIN),(A(45CSS10256
     21),QIN),(D,Y),(D(181),BRE),(D(271),WRE),(D(361),AA),(D(451),AB),(DCSS10257
     3(541),JO),(D(631),JS),(B,QR),(B(91),XINT),(B(181),EXTRA),(IA,JOX),CSS10258
     4(IMPT,JOY),(D(91),P)                                              CSS10259
C                                                                       CSS10260
      DO 4 J=2,ML1                                                      CSS10261
    4 B(I1,J)=B(I1,J)/Y(I1)                                             CSS10262
      X(I1)=X(I1)/Y(I1)                                                 CSS10263
      DO 1 I=1,ML1                                                      CSS10264
      IF (I-I1)3,1,3                                                    CSS10265
    3 DO 2 J=2,ML1                                                      CSS10266
    2 B(I,J)=B(I,J)-B(I1,J)*Y(I)                                        CSS10267
      X(I)=X(I)-X(I1)*Y(I)                                              CSS10268
    1 CONTINUE                                                          CSS10269
      RETURN                                                            CSS10270
      END                                                               CSS10271
*     LIST8                                                             CSS10272
*     LABEL                                                             CSS10273
      SUBROUTINE INS1                                                   CSS10274
C                                                                       CSS10275
      COMMON WWEQ,A,D,X,W,Q,B,IA,IMPT,ALPHA,L,M,N,NO,LL,I1,M1,MM,M2,ML1,CSS10276
     1INVT,LOCX,MDIM,LAG,LSTOP,MBAR,LPHS1,LOC,LAG,THETA,QBAR,T,TOTAL,E1,CSS10277
     2EXCESS,STOP1,STOP2,NA,NB,NC,BCD,TRIM                              CSS10278
      DIMENSION WWEQ(15,4),WW(15),CC(15),VV(15),BB(15),A(90,90),WWIN(90)CSS10279
     1,CCIN(90),VVIN(90),BBIN(90),D(90,90),Y(90),P(90),BRE(90),WRE(90),ACSS10280
     2A(90),AB(90),JO(90),JS(90),X(90),W(90),Q(90),B(90,90),QR(90),XINT(CSS10281
     390),EXTRA(90),IA(90),JOX(90),IMPT(90),JOY(90),ALPHA(12),BCD(90),  CSS10282
     4TRIM(20),WIN(90),QIN(90)                                          CSS10283
      EQUIVALENCE (WWEQ,WW),(WWEQ(16),CC),(WWEQ(31),VV),(WWEQ(46),BB),(ACSS10284
     1,WWIN),(A(91),CCIN),(A(181),VVIN),(A(271),BBIN),(A(361),WIN),(A(45CSS10285
     21),QIN),(D,Y),(D(181),BRE),(D(271),WRE),(D(361),AA),(D(451),AB),(DCSS10286
     3(541),JO),(D(631),JS),(B,QR),(B(91),XINT),(B(181),EXTRA),(IA,JOX),CSS10287
     4(IMPT,JOY),(D(91),P)                                              CSS10288
C                                                                       CSS10289
   36 DO 16 J=1,MDIM                                                    CSS10290
      DO 5 I=1,MDIM                                                     CSS10291
    5 D(I,J)=0.0                                                        CSS10292
   16 QIN(J)=0.0                                                        CSS10293
      LOCX=2                                                            CSS10294
      LAG=10                                                            CSS10295
      E1=.0001                                                          CSS10296
      INVT=50                                                           CSS10297
      THETA=.25                                                         CSS10298
      EXCESS=.05                                                        CSS10299
      QBAR=-1.0                                                         CSS10300
      LSTOP=-1                                                          CSS10301
      STOP1=.1                                                          CSS10302
      STOP2=0.0                                                         CSS10303
      LPHS1=0                                                           CSS10304
      L=0                                                               CSS10305
      M=0                                                               CSS10306
      N=0                                                               CSS10307
      READ INPUT TAPE NA,1,ALPHA                                        CSS10308
    1 FORMAT (12A6)                                                     CSS10309
    4 L=L+1                                                             CSS10310
    6 READ INPUT TAPE NA,2,BETA,K,WWIN(L),CCIN(L),BBIN(L),VVIN(L)       CSS10311
    2 FORMAT (1A6,I4,4F10.0)                                            CSS10312
      K=XMIN0F(K+1,10)                                                  CSS10313
      GO TO (20,21,22,23,24,25,26,27,28,13),K                           CSS10314
   21 E1=WWIN(L)                                                        CSS10315
      GO TO 6                                                           CSS10316
   22 INVT=WWIN(L)                                                      CSS10317
      GO TO 6                                                           CSS10318
   23 THETA=WWIN(L)                                                     CSS10319
      GO TO 6                                                           CSS10320
   24 EXCESS=WWIN(L)/100.                                               CSS10321
      GO TO 6                                                           CSS10322
   25 QBAR=WWIN(L)                                                      CSS10323
      GO TO 6                                                           CSS10324
   26 LSTOP=0                                                           CSS10325
      GO TO 6                                                           CSS10326
   27 STOP1=WWIN(L)                                                     CSS10327
      GO TO 6                                                           CSS10328
   28 STOP2=WWIN(L)                                                     CSS10329
      GO TO 6                                                           CSS10330
   20 IF (WWIN(L))13,14,15                                              CSS10331
   15 IF (BBIN(L))13,3,4                                                CSS10332
    3 IF (N)9,9,10                                                      CSS10333
   10 DO 7 K=1,N                                                        CSS10334
B     IF (BETA*(-BCD(K))+(-BETA)*BCD(K))7,8,7                           CSS10335
    7 CONTINUE                                                          CSS10336
    9 N=N+1                                                             CSS10337
      K=N                                                               CSS10338
      BCD(N)=BETA                                                       CSS10339
    8 IF (M)39,39,19                                                    CSS10340
   19 DO 11 I=1,M                                                       CSS10341
      IF (WIN(I)-WWIN(L))11,12,11                                       CSS10342
   11 CONTINUE                                                          CSS10343
   39 M=M+1                                                             CSS10344
      I=M                                                               CSS10345
      WIN(I)=WWIN(L)                                                    CSS10346
   12 D(I,K)=D(I,K)+CCIN(L)                                             CSS10347
      QIN(I)=QIN(I)+CCIN(L)                                             CSS10348
      GO TO 6                                                           CSS10349
   14 L=L-1                                                             CSS10350
      IF (L*(M-1))37,37,18                                              CSS10351
   18 RETURN                                                            CSS10352
   13 READ INPUT TAPE NA,2,BETA,K,WWIN(L)                               CSS10353
      IF (WWIN(L))13,37,13                                              CSS10354
   37 WRITE OUTPUT TAPE NB,17,ALPHA                                     CSS10355
   17 FORMAT (18H0DATA ERROR, SKIP 12A6)                                CSS10356
      GO TO 36                                                          CSS10357
      END                                                               CSS10358
*     LIST8                                                             CSS10359
*     LABEL                                                             CSS10360
      SUBROUTINE INVTS1                                                 CSS10361
C                                                                       CSS10362
      COMMON WWEQ,A,D,X,W,Q,B,IA,IMPT,ALPHA,L,M,N,NO,LL,I1,M1,MM,M2,ML1,CSS10363
     1INVT,LOCX,MDIM,LAG,LSTOP,MBAR,LPHS1,LOC,LAG,THETA,QBAR,T,TOTAL,E1,CSS10364
     2EXCESS,STOP1,STOP2,NA,NB,NC,BCD,TRIM                              CSS10365
      DIMENSION WWEQ(15,4),WW(15),CC(15),VV(15),BB(15),A(90,90),WWIN(90)CSS10366
     1,CCIN(90),VVIN(90),BBIN(90),D(90,90),Y(90),P(90),BRE(90),WRE(90),ACSS10367
     2A(90),AB(90),JO(90),JS(90),X(90),W(90),Q(90),B(90,90),QR(90),XINT(CSS10368
     390),EXTRA(90),IA(90),JOX(90),IMPT(90),JOY(90),ALPHA(12),BCD(90),  CSS10369
     4TRIM(20),WIN(90),QIN(90)                                          CSS10370
      EQUIVALENCE (WWEQ,WW),(WWEQ(16),CC),(WWEQ(31),VV),(WWEQ(46),BB),(ACSS10371
     1,WWIN),(A(91),CCIN),(A(181),VVIN),(A(271),BBIN),(A(361),WIN),(A(45CSS10372
     21),QIN),(D,Y),(D(181),BRE),(D(271),WRE),(D(361),AA),(D(451),AB),(DCSS10373
     3(541),JO),(D(631),JS),(B,QR),(B(91),XINT),(B(181),EXTRA),(IA,JOX),CSS10374
     4(IMPT,JOY),(D(91),P)                                              CSS10375
C                                                                       CSS10376
      DO 1 J=1,ML1                                                      CSS10377
      DO 2 I=1,ML1                                                      CSS10378
      D(I,J)=A(I,J)                                                     CSS10379
    2 B(I,J)=0.0                                                        CSS10380
    1 B(J,J)=1.0                                                        CSS10381
      CALL LEQ (D,B,ML1,ML1,MDIM,MDIM,T)                                CSS10382
      DO 10 I=1,ML1                                                     CSS10383
      X(I)=0.0                                                          CSS10384
      DO 10 J=2,ML1                                                     CSS10385
   10 X(I)=X(I)+B(I,J)*Q(J-1)                                           CSS10386
      RETURN                                                            CSS10387
      END                                                               CSS10388
