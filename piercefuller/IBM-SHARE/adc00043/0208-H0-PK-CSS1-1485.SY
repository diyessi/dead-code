      SUBROUTINE OUT2S1                                                 CSS10421
C                                                                       CSS10422
      COMMON WWEQ,A,D,X,W,Q,B,IA,IMPT,ALPHA,L,M,N,NO,LL,I1,M1,MM,M2,ML1,CSS10423
     1INVT,LOCX,MDIM,LAG,LSTOP,MBAR,LPHS1,LOC,LAG,THETA,QBAR,T,TOTAL,E1,CSS10424
     2EXCESS,STOP1,STOP2,NA,NB,NC,BCD,TRIM                              CSS10425
      DIMENSION WWEQ(15,4),WW(15),CC(15),VV(15),BB(15),A(90,90),WWIN(90)CSS10426
     1,CCIN(90),VVIN(90),BBIN(90),D(90,90),Y(90),P(90),BRE(90),WRE(90),ACSS10427
     2A(90),AB(90),JO(90),JS(90),X(90),W(90),Q(90),B(90,90),QR(90),XINT(CSS10428
     390),EXTRA(90),IA(90),JOX(90),IMPT(90),JOY(90),ALPHA(12),BCD(90),  CSS10429
     4TRIM(20),WIN(90),QIN(90)                                          CSS10430
      EQUIVALENCE (WWEQ,WW),(WWEQ(16),CC),(WWEQ(31),VV),(WWEQ(46),BB),(ACSS10431
     1,WWIN),(A(91),CCIN),(A(181),VVIN),(A(271),BBIN),(A(361),WIN),(A(45CSS10432
     21),QIN),(D,Y),(D(181),BRE),(D(271),WRE),(D(361),AA),(D(451),AB),(DCSS10433
     3(541),JO),(D(631),JS),(B,QR),(B(91),XINT),(B(181),EXTRA),(IA,JOX),CSS10434
     4(IMPT,JOY),(D(91),P)                                              CSS10435
C                                                                       CSS10436
      IF (LPHS1)18,18,17                                                CSS10437
   18 T=0.0                                                             CSS10438
      DO 22 I=2,M1                                                      CSS10439
      IF (IA(I))23,23,22                                                CSS10440
   23 T=T+X(I)                                                          CSS10441
   22 CONTINUE                                                          CSS10442
      WRITE OUTPUT TAPE NB,19,T,WW(1)                                   CSS10443
   19 FORMAT (23H0SUPPLY INSUFFICIENT BY F10.3,16H ROLLS OF LENGTHF10.3)CSS10444
      LOC=-1                                                            CSS10445
   17 IF (LOC)20,8,10                                                   CSS10446
    8 WRITE OUTPUT TAPE NB,13                                           CSS10447
   13 FORMAT (25H0OPTIMAL SOLUTION REACHED)                             CSS10448
   10 WRITE OUTPUT TAPE NB,14,E1,THETA,EXCESS,QBAR,INVT,NO              CSS10449
   14 FORMAT (//19H0PROBLEM STATISTICS//8H0EPSILON,F25.7/6H0THETA,F27.7/CSS10450
     123H0PERCENT QUANTITY SLACK,2PF10.5/22H0MEDIAN ORDER QUANTITY,0PF11CSS10451
     2.3/20H0INVERSION FREQUENCY,I13/21H0NUMBER OF ITERATIONS,I12)      CSS10452
      DO 7 J=1,M                                                        CSS10453
    7 QR(J)=0.0                                                         CSS10454
      WRITE OUTPUT TAPE NB,1,ALPHA                                      CSS10455
    1 FORMAT (1H1,12A6//1H0,35X,29HOPTIMAL AND ROUNDED SOLUTIONS//1H0,7XCSS10456
     1,33HCUT THE FOLLOWING NUMBER OF ROLLS,8X12HFROM MACHINE,8X,32HIN TCSS10457
     2HE FOLLOWING CUTTING PATTERN/14X,07HOPTIMAL,13X,7HROUNDED,6X,14HROCSS10458
     3LL OF LENGTH,5X,15HLENGTH OF PIECE,4X,16HNUMBER OF PIECES/87X,14HOCSS10459
     4F THIS LENGTH//)                                                  CSS10460
      THETAC=1.0-THETA+E1                                               CSS10461
      TOTALX=0.0                                                        CSS10462
      TOTALR=0.0                                                        CSS10463
      TRIMX=0.0                                                         CSS10464
      TRIMR=0.0                                                         CSS10465
      DO 3 J=2,ML1                                                      CSS10466
      XINT(J)=0.0                                                       CSS10467
      IF (X(J)-E1)3,3,4                                                 CSS10468
    4 IF (A(1,J))5,3,3                                                  CSS10469
    5 XINT(J)=INTF(X(J)+THETAC)                                         CSS10470
      LL=IA(J)                                                          CSS10471
      TOTALX=TOTALX+WW(LL)*X(J)                                         CSS10472
      TOTALR=TOTALR+WW(LL)*XINT(J)                                      CSS10473
      LOC=0                                                             CSS10474
      T=WW(LL)                                                          CSS10475
      DO 11 I=2,M1                                                      CSS10476
      IF (A(I,J))11,11,12                                               CSS10477
   12 IF (LOC)9,9,15                                                    CSS10478
    9 WRITE OUTPUT TAPE NB,16,X(J),XINT(J),WW(LL),W(I-1),A(I,J)         CSS10479
   16 FORMAT (1H0,F20.3,F20.0,2F20.3,F20.0)                             CSS10480
      LOC=1                                                             CSS10481
      GO TO 2                                                           CSS10482
   15 WRITE OUTPUT TAPE NB,21,W(I-1),A(I,J)                             CSS10483
   21 FORMAT (61X,F20.3,F20.0)                                          CSS10484
    2 T=T-A(I,J)*W(I-1)                                                 CSS10485
      QR(I-1)=QR(I-1)+A(I,J)*XINT(J)                                    CSS10486
   11 CONTINUE                                                          CSS10487
      TRIMX=TRIMX+X(J)*T                                                CSS10488
      TRIMR=TRIMR+XINT(J)*T                                             CSS10489
    3 CONTINUE                                                          CSS10490
      TRIMX=TRIMX*100.0/TOTALX                                          CSS10491
      TRIMR=TRIMR*100.0/TOTALR                                          CSS10492
      WRITE OUTPUT TAPE NB,6,TOTAL,TOTALX,TOTALR,TRIMX,TRIMR            CSS10493
    6 FORMAT (//46H0TOTAL LENGTH OF ORDERED PAPER (IN ROLL-UNITS),F14.3/CSS10494
     146H0TOTAL LENGTH OF PAPER CUT IN OPTIMAL SOLUTION,F14.3/46H0TOTAL CSS10495
     2LENGTH OF PAPER CUT IN ROUNDED SOLUTION,F14.3/45H0PERCENTAGE OF TRCSS10496
     3IM WASTE IN OPTIMAL SOLUTION,F15.5/45H0PERCENTAGE OF TRIM WASTE INCSS10497
     4 ROUNDED SOLUTION,F15.5)                                          CSS10498
      LOC=0                                                             CSS10499
   20 RETURN                                                            CSS10500
      END                                                               CSS10501
*     LIST8                                                             CSS10502
*     LABEL                                                             CSS10503
      SUBROUTINE OUT3S1                                                 CSS10504
C                                                                       CSS10505
      COMMON WWEQ,A,D,X,W,Q,B,IA,IMPT,ALPHA,L,M,N,NO,LL,I1,M1,MM,M2,ML1,CSS10506
     1INVT,LOCX,MDIM,LAG,LSTOP,MBAR,LPHS1,LOC,LAG,THETA,QBAR,T,TOTAL,E1,CSS10507
     2EXCESS,STOP1,STOP2,NA,NB,NC,BCD,TRIM                              CSS10508
      DIMENSION WWEQ(15,4),WW(15),CC(15),VV(15),BB(15),A(90,90),WWIN(90)CSS10509
     1,CCIN(90),VVIN(90),BBIN(90),D(90,90),Y(90),P(90),BRE(90),WRE(90),ACSS10510
     2A(90),AB(90),JO(90),JS(90),X(90),W(90),Q(90),B(90,90),QR(90),XINT(CSS10511
     390),EXTRA(90),IA(90),JOX(90),IMPT(90),JOY(90),ALPHA(12),BCD(90),  CSS10512
     4TRIM(20),WIN(90),QIN(90)                                          CSS10513
      EQUIVALENCE (WWEQ,WW),(WWEQ(16),CC),(WWEQ(31),VV),(WWEQ(46),BB),(ACSS10514
     1,WWIN),(A(91),CCIN),(A(181),VVIN),(A(271),BBIN),(A(361),WIN),(A(45CSS10515
     21),QIN),(D,Y),(D(181),BRE),(D(271),WRE),(D(361),AA),(D(451),AB),(DCSS10516
     3(541),JO),(D(631),JS),(B,QR),(B(91),XINT),(B(181),EXTRA),(IA,JOX),CSS10517
     4(IMPT,JOY),(D(91),P)                                              CSS10518
C                                                                       CSS10519
      DO 14 I=1,M                                                       CSS10520
   14 READ TAPE NC,(D(I,J),J=1,N)                                       CSS10521
      DO 1 J=1,M                                                        CSS10522
    1 EXTRA(J)=QR(J)-Q(J)                                               CSS10523
      IF (N-1)13,13,2                                                   CSS10524
    2 WRITE OUTPUT TAPE NB,9,ALPHA                                      CSS10525
    9 FORMAT (1H1,12A6//1H0,24X,31HBREAKDOWN OF ORDER BY CUSTOMERS//1H0,CSS10526
     112X,8HCUSTOMER,7X,13HWIDTH ORDERED,4X,16HQUANTITY ORDERED,3X,17HQUCSS10527
     2ANTITY RECEIVED)                                                  CSS10528
   13 DO 5 J=1,N                                                        CSS10529
      LOC=0                                                             CSS10530
      DO 5 I=1,M                                                        CSS10531
      IF (D(I,J))5,5,3                                                  CSS10532
    3 T=SIGNF(MIN1F(ABSF(EXTRA(I)),INTF(EXCESS*D(I,J)+E1)),EXTRA(I))    CSS10533
      EXTRA(I)=EXTRA(I)-T                                               CSS10534
      T=D(I,J)+T                                                        CSS10535
      IF (N-1)5,5,15                                                    CSS10536
   15 IF (LOC)6,6,7                                                     CSS10537
    6 WRITE OUTPUT TAPE NB,8,BCD(J),W(I),D(I,J),T                       CSS10538
    8 FORMAT (1H0,14X,1A6,F20.3,2F20.0)                                 CSS10539
      LOC=1                                                             CSS10540
      GO TO 5                                                           CSS10541
    7 WRITE OUTPUT TAPE NB,4,W(I),D(I,J),T                              CSS10542
    4 FORMAT (21X,F20.3,2F20.0)                                         CSS10543
    5 CONTINUE                                                          CSS10544
      WRITE OUTPUT TAPE NB,10,ALPHA                                     CSS10545
   10 FORMAT (1H1,12A6//1H0,34X,31HEFFECT OF ROUNDING THE SOLUTION//1H0,CSS10546
     17X,13HWIDTH ORDERED,4X,16HQUANTITY ORDERED,3X,17HQUANTITY PRODUCEDCSS10547
     2,4X,36HEXCESS OR SHORTAGE OF ROLLS PRODUCED/71X,10HASSIGNABLE,6X,1CSS10548
     34HNOT ASSIGNABLE//)                                               CSS10549
      DO 11 I=1,M                                                       CSS10550
      T=QR(I)-Q(I)-EXTRA(I)                                             CSS10551
   11 WRITE OUTPUT TAPE NB,12,W(I),Q(I),QR(I),T,EXTRA(I)                CSS10552
   12 FORMAT (F21.3,4F20.0)                                             CSS10553
      REWIND NC                                                         CSS10554
      RETURN                                                            CSS10555
      END                                                               CSS10556
*     LIST8                                                             CSS10557
*     LABEL                                                             CSS10558
      SUBROUTINE ROWS1                                                  CSS10559
C                                                                       CSS10560
      COMMON WWEQ,A,D,X,W,Q,B,IA,IMPT,ALPHA,L,M,N,NO,LL,I1,M1,MM,M2,ML1,CSS10561
     1INVT,LOCX,MDIM,LAG,LSTOP,MBAR,LPHS1,LOC,LAG,THETA,QBAR,T,TOTAL,E1,CSS10562
     2EXCESS,STOP1,STOP2,NA,NB,NC,BCD,TRIM                              CSS10563
      DIMENSION WWEQ(15,4),WW(15),CC(15),VV(15),BB(15),A(90,90),WWIN(90)CSS10564
     1,CCIN(90),VVIN(90),BBIN(90),D(90,90),Y(90),P(90),BRE(90),WRE(90),ACSS10565
     2A(90),AB(90),JO(90),JS(90),X(90),W(90),Q(90),B(90,90),QR(90),XINT(CSS10566
     390),EXTRA(90),IA(90),JOX(90),IMPT(90),JOY(90),ALPHA(12),BCD(90),  CSS10567
     4TRIM(20),WIN(90),QIN(90)                                          CSS10568
      EQUIVALENCE (WWEQ,WW),(WWEQ(16),CC),(WWEQ(31),VV),(WWEQ(46),BB),(ACSS10569
     1,WWIN),(A(91),CCIN),(A(181),VVIN),(A(271),BBIN),(A(361),WIN),(A(45CSS10570
     21),QIN),(D,Y),(D(181),BRE),(D(271),WRE),(D(361),AA),(D(451),AB),(DCSS10571
     3(541),JO),(D(631),JS),(B,QR),(B(91),XINT),(B(181),EXTRA),(IA,JOX),CSS10572
     4(IMPT,JOY),(D(91),P)                                              CSS10573
C                                                                       CSS10574
C     FIND PIVOT ELEMENT                                                CSS10575
      LOC=0                                                             CSS10576
   11 DO 1 I=2,ML1                                                      CSS10577
      IF (Y(I)-E1)1,1,2                                                 CSS10578
    2 IF (LOC)6,6,4                                                     CSS10579
    4 IF (ABSF(X(I))*Y(I1)-Y(I)*ABSF(X(I1)))6,1,1                       CSS10580
    6 I1=I                                                              CSS10581
      LOC=1                                                             CSS10582
    1 CONTINUE                                                          CSS10583
      IF (LOC)3,8,5                                                     CSS10584
    8 LOC=-1                                                            CSS10585
      CALL INVTS1                                                       CSS10586
      GO TO 11                                                          CSS10587
    3 WRITE OUTPUT TAPE NB,7,ALPHA                                      CSS10588
    7 FORMAT (39H0NO PIVOT ELEMENT, SOLUTION INTERRUPTED)               CSS10589
      GO TO 9                                                           CSS10590
C                                                                       CSS10591
C     RECORD NEW COLUMN IN BASIS                                        CSS10592
    5 DO 10 I=1,ML1                                                     CSS10593
   10 A(I,I1)=P(I)                                                      CSS10594
      IA(I1)=LL                                                         CSS10595
    9 RETURN                                                            CSS10596
      END                                                               CSS10597
*     LIST8                                                             CSS10598
*     LABEL                                                             CSS10599
      SUBROUTINE SETS1                                                  CSS10600
C                                                                       CSS10601
      COMMON WWEQ,A,D,X,W,Q,B,IA,IMPT,ALPHA,L,M,N,NO,LL,I1,M1,MM,M2,ML1,CSS10602
     1INVT,LOCX,MDIM,LAG,LSTOP,MBAR,LPHS1,LOC,LAG,THETA,QBAR,T,TOTAL,E1,CSS10603
     2EXCESS,STOP1,STOP2,NA,NB,NC,BCD,TRIM                              CSS10604
      DIMENSION WWEQ(15,4),WW(15),CC(15),VV(15),BB(15),A(90,90),WWIN(90)CSS10605
     1,CCIN(90),VVIN(90),BBIN(90),D(90,90),Y(90),P(90),BRE(90),WRE(90),ACSS10606
     2A(90),AB(90),JO(90),JS(90),X(90),W(90),Q(90),B(90,90),QR(90),XINT(CSS10607
     390),EXTRA(90),IA(90),JOX(90),IMPT(90),JOY(90),ALPHA(12),BCD(90),  CSS10608
     4TRIM(20),WIN(90),QIN(90)                                          CSS10609
      EQUIVALENCE (WWEQ,WW),(WWEQ(16),CC),(WWEQ(31),VV),(WWEQ(46),BB),(ACSS10610
     1,WWIN),(A(91),CCIN),(A(181),VVIN),(A(271),BBIN),(A(361),WIN),(A(45CSS10611
     21),QIN),(D,Y),(D(181),BRE),(D(271),WRE),(D(361),AA),(D(451),AB),(DCSS10612
     3(541),JO),(D(631),JS),(B,QR),(B(91),XINT),(B(181),EXTRA),(IA,JOX),CSS10613
     4(IMPT,JOY),(D(91),P)                                              CSS10614
C                                                                       CSS10615
C     COMPUTE JOB PARAMETERS                                            CSS10616
      M1=M+1                                                            CSS10617
      MM=M-1                                                            CSS10618
      M2=M1+1                                                           CSS10619
      ML1=M+L+1                                                         CSS10620
      TOTAL=0.0                                                         CSS10621
      DO 1 I=1,M                                                        CSS10622
    1 TOTAL=TOTAL+WIN(I)*QIN(I)                                         CSS10623
C                                                                       CSS10624
C     SORT MACHINE LENGTHS, DESCENDING ORDER                            CSS10625
      DO 48 J=1,L                                                       CSS10626
   48 JOX(J)=1                                                          CSS10627
      IF (L-1)40,40,41                                                  CSS10628
   41 DO 47 JJ=2,L                                                      CSS10629
      DO 47 J=JJ,L                                                      CSS10630
      IF (WWIN(JJ-1)-WWIN(J))42,42,43                                   CSS10631
   42 JOX(JJ-1)=JOX(JJ-1)+1                                             CSS10632
      GO TO 47                                                          CSS10633
   43 JOX(J)=JOX(J)+1                                                   CSS10634
   47 CONTINUE                                                          CSS10635
   40 DO 49 J=1,L                                                       CSS10636
      JJ=JOX(J)                                                         CSS10637
      DO 49 I=1,4                                                       CSS10638
   49 WWEQ(JJ,I)=A(J,I)                                                 CSS10639
C                                                                       CSS10640
C     SORT ORDER LENGTHS, DESCENDING ORDER                              CSS10641
   56 DO 50 J=1,M                                                       CSS10642
   50 JOX(J)=1                                                          CSS10643
      DO 52 JJ=2,M                                                      CSS10644
      DO 53 J=JJ,M                                                      CSS10645
      IF (WIN(JJ-1)-WIN(J))55,55,54                                     CSS10646
   54 JOX(J)=JOX(J)+1                                                   CSS10647
      GO TO 53                                                          CSS10648
   55 JOX(JJ-1)=JOX(JJ-1)+1                                             CSS10649
   53 CONTINUE                                                          CSS10650
      I=JOX(JJ-1)                                                       CSS10651
   52 JOY(I)=JJ-1                                                       CSS10652
      I=JOX(M)                                                          CSS10653
      JOY(I)=M                                                          CSS10654
      DO 51 I=1,M                                                       CSS10655
      JJ=JOY(I)                                                         CSS10656
      W(I)=WIN(JJ)                                                      CSS10657
      Q(I)=QIN(JJ)                                                      CSS10658
   51 WRITE TAPE NC,(D(JJ,J),J=1,N)                                     CSS10659
C                                                                       CSS10660
C     FIND MEDIAN ORDER AND ASSIGN WEIGHTS                              CSS10661
      DO 11 J=1,M                                                       CSS10662
      JOX(J)=0                                                          CSS10663
   11 IMPT(J)=0                                                         CSS10664
      IF (QBAR)10,20,17                                                 CSS10665
   10 MED=(M)/2                                                         CSS10666
      DO 12 JJ=2,M                                                      CSS10667
      DO 13 J=JJ,M                                                      CSS10668
      IF (Q(JJ-1)-Q(J))14,15,15                                         CSS10669
   14 JOX(J)=JOX(J)+1                                                   CSS10670
      GO TO 13                                                          CSS10671
   15 JOX(JJ-1)=JOX(JJ-1)+1                                             CSS10672
   13 CONTINUE                                                          CSS10673
      IF (JOX(JJ-1)-MED)12,16,12                                        CSS10674
   12 CONTINUE                                                          CSS10675
      JJ=M+1                                                            CSS10676
   16 QBAR=Q(JJ-1)                                                      CSS10677
   17 JJ=0                                                              CSS10678
      DO 18 J=1,M                                                       CSS10679
      IF (Q(J)-QBAR)18,19,19                                            CSS10680
   19 IMPT(J)=1                                                         CSS10681
      JJ=JJ+1                                                           CSS10682
   18 CONTINUE                                                          CSS10683
      IF (M-JJ-2)20,22,22                                               CSS10684
   22 IF (JJ-2)20,21,21                                                 CSS10685
   20 LOCX=1                                                            CSS10686
C                                                                       CSS10687
C     SET UP BASIS MATRIX A                                             CSS10688
   21 DO 29 J=1,MDIM                                                    CSS10689
      DO 28 I=1,MDIM                                                    CSS10690
   28 A(I,J)=0.0                                                        CSS10691
   29 IA(J)=0                                                           CSS10692
      J=0                                                               CSS10693
      DO 26 I=M2,ML1                                                    CSS10694
      J=J+1                                                             CSS10695
      Q(I-1)=BB(J)                                                      CSS10696
   26 A(I,I)=1.0                                                        CSS10697
      DO 27 LL=1,L                                                      CSS10698
   27 AA(LL)=BB(LL)                                                     CSS10699
      DO 23 J=2,M1                                                      CSS10700
      DO 24 LL=1,L                                                      CSS10701
      A(J,J)=MIN1F(VV(LL),INTF(WW(LL)/W(J-1)+E1))                       CSS10702
      T=INTF(Q(J-1)/A(J,J)+1.0-E1)                                      CSS10703
      IF (AA(LL)-T)24,25,25                                             CSS10704
   25 AA(LL)=AA(LL)-T                                                   CSS10705
      A(1,J)=-CC(LL)                                                    CSS10706
      IA(J)=LL                                                          CSS10707
      II=M1+LL                                                          CSS10708
      A(II,J)=1.0                                                       CSS10709
      GO TO 23                                                          CSS10710
   24 CONTINUE                                                          CSS10711
      A(J,J)=MIN1F(VV(1),INTF(WW(1)/W(J-1)+E1))                         CSS10712
      A(1,J)=-1000.0*CC(1)                                              CSS10713
   23 CONTINUE                                                          CSS10714
      A(1,1)=1.0                                                        CSS10715
      REWIND NC                                                         CSS10716
      RETURN                                                            CSS10717
      END                                                               CSS10718
*     LIST8                                                             CSS10719
*     LABEL                                                             CSS10720
      SUBROUTINE SLCKS1                                                 CSS10721
C                                                                       CSS10722
      COMMON WWEQ,A,D,X,W,Q,B,IA,IMPT,ALPHA,L,M,N,NO,LL,I1,M1,MM,M2,ML1,CSS10723
     1INVT,LOCX,MDIM,LAG,LSTOP,MBAR,LPHS1,LOC,LAG,THETA,QBAR,T,TOTAL,E1,CSS10724
     2EXCESS,STOP1,STOP2,NA,NB,NC,BCD,TRIM                              CSS10725
      DIMENSION WWEQ(15,4),WW(15),CC(15),VV(15),BB(15),A(90,90),WWIN(90)CSS10726
     1,CCIN(90),VVIN(90),BBIN(90),D(90,90),Y(90),P(90),BRE(90),WRE(90),ACSS10727
     2A(90),AB(90),JO(90),JS(90),X(90),W(90),Q(90),B(90,90),QR(90),XINT(CSS10728
     390),EXTRA(90),IA(90),JOX(90),IMPT(90),JOY(90),ALPHA(12),BCD(90),  CSS10729
     4TRIM(20),WIN(90),QIN(90)                                          CSS10730
      EQUIVALENCE (WWEQ,WW),(WWEQ(16),CC),(WWEQ(31),VV),(WWEQ(46),BB),(ACSS10731
     1,WWIN),(A(91),CCIN),(A(181),VVIN),(A(271),BBIN),(A(361),WIN),(A(45CSS10732
     21),QIN),(D,Y),(D(181),BRE),(D(271),WRE),(D(361),AA),(D(451),AB),(DCSS10733
     3(541),JO),(D(631),JS),(B,QR),(B(91),XINT),(B(181),EXTRA),(IA,JOX),CSS10734
     4(IMPT,JOY),(D(91),P)                                              CSS10735
C                                                                       CSS10736
      LOC=0                                                             CSS10737
      T=-1.0                                                            CSS10738
      DO 3 J=2,M1                                                       CSS10739
      IF (B(1,J)+E1)1,3,3                                               CSS10740
    1 IF (LOC)5,5,6                                                     CSS10741
    6 IF (B(1,J)-B(1,I1))5,3,3                                          CSS10742
    5 I1=J                                                              CSS10743
      LOC=1                                                             CSS10744
    3 CONTINUE                                                          CSS10745
      DO 2 J=M2,ML1                                                     CSS10746
      IF (B(1,J)-E1)2,2,9                                               CSS10747
    9 IF (LOC)11,11,10                                                  CSS10748
   10 IF (B(1,J)-ABSF(B(1,I1)))2,2,11                                   CSS10749
   11 I1=J                                                              CSS10750
      LOC=1                                                             CSS10751
      T=1.0                                                             CSS10752
    2 CONTINUE                                                          CSS10753
      IF (LOC)7,7,4                                                     CSS10754
    4 DO 8 I=1,ML1                                                      CSS10755
      P(I)=0.0                                                          CSS10756
    8 Y(I)=T*B(I,I1)                                                    CSS10757
      P(I1)=T                                                           CSS10758
