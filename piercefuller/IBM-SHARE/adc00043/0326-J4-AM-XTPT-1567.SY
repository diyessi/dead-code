       ENTRY OUTCRT                                                     XTPT0001
OUTCRT CAL XTN1              ON INITIAL ENTRY (IOH) IS SET TO           XTPT0002
       LDQ (IOH)+32          BYPASS THE SYSTEM UNISERVO SELECT          XTPT0003
       SLW (IOH)+32          SUBROUTINE,(FIL) IS SET TO EXIT            XTPT0004
       STQ XTN1              TO OUTCRT AND A TRANSFER TO XCALL IS SET   XTPT0005
       CAL XTN2              AND EXECUTED.                              XTPT0006
       LDQ (FIL)+23                                                     XTPT0007
       SLW (FIL)+23          ON SECOND ENTRY-THE RETURN FROM (FIL)-     XTPT0008
       STQ XTN2              (IOH) AND (FIL) ARE RESTORED TO NORMAL     XTPT0009
       CAL XCALL             AND A TRANSFER TO FOUT IS PLACED IN XCALL  XTPT0010
       LDQ XTN3                                                         XTPT0011
       SLW XTN3                                                         XTPT0012
       STQ XCALL                                                        XTPT0013
 XCALL TRA FOUT                                                         XTPT0014
       STO XTN11                                                        XTPT0015
       STD XTN4              TO START ON A PARTICULAR LINE,             XTPT0016
       CLA XTN4              GO POSITION THE                            XTPT0017
       TNZ LSTOR             XTON BEAM, THEN SET THE SECOND             XTPT0018
       CLA XTN11             LINE OF THE OUTCRT CALL FOR                XTPT0019
       LRS 18                CORRECT EXECUTION                          XTPT0020
       PXA                                                              XTPT0021
       LLS 21                                                           XTPT0022
       STD 1,4                                                          XTPT0023
       STT 1,4                                                          XTPT0024
       SXA FOUT+1,4                                                     XTPT0025
       PXA ,,                                                           XTPT0026
       LDQ XTN5              AND LOAD XEDIT ADDRESS INTO THE MQ,        XTPT0027
       TRA (IOH)             THEN EXIT TO (IOH).                        XTPT0028
  FOUT SXA FOUT+4,4                                                     XTPT0029
       AXT *,4               ON THE RETURN, RESTORE THE                 XTPT0030
       CLA XTN11             SECOND LINE OF THE OUTCRT CALL,            XTPT0031
       STO 1,4               AND TRANSFER BACK TO THE                   XTPT0032
       AXT *,4               LINE FOLLOWING THE CALL.                   XTPT0033
       TTR 1,4                                                          XTPT0034
 LSTOR SXA XEDIT-2,4         XTRON BEAM POSITIONING SECTION.            XTPT0035
       ARS 18                                                           XTPT0036
       CAS =O2000            UPDATE THE LINE COUNTER                    XTPT0037
       NOP                                                              XTPT0038
       TRA *+2                                                          XTPT0039
       TRA *+3                                                          XTPT0040
       PXA                                                              XTPT0041
       STO XTN4                                                         XTPT0042
       STO XTN6                                                         XTPT0043
       LDQ =O120000000000    THEN POSITION THE XTRON BEAM               XTPT0044
       TSX TAPER,4                                                      XTPT0045
       CLA XTN4                                                         XTPT0046
       ARS 18                                                           XTPT0047
       ADD =O200000120000    AND                                        XTPT0048
       XCA                                                              XTPT0049
       TSX TAPER,4                                                      XTPT0050
       CAL XTN7              SET THE PCC SUPPRESSOR                     XTPT0051
       SLW GAMMA             IN XEDIT.                                  XTPT0052
       AXT *,4                                                          XTPT0053
       TRA XCALL+5                                                      XTPT0054
 XEDIT SXA S4,4              RETURN FROM (IOH) TO PLACE                 XTPT0055
       SXA S2,2              CONVERTED DATA ON XTON TAPE.               XTPT0056
       SXA S1,1                                                         XTPT0057
       CLA 1,4               COMPUTE INDEXING PARAMETER                 XTPT0058
       ARS 18                AND STORE (IOH) BUFFER LOCATIONS           XTPT0059
       ADD 1,4               IN XEDIT INSTRUCTIONS.                     XTPT0060
       PDX ,1                                                           XTPT0061
       STA CONE+8                                                       XTPT0062
       STA CONE+11                                                      XTPT0063
       STA CONE+12                                                      XTPT0064
       LXA XTN6,2                                                       XTPT0065
 GAMMA STA GAMMA+3           NORMAL, FOR LINE SELECTION-TRA PRSET       XTPT0066
       LDQ =O120000000000    ISSUE STOP PRINT ORDER                     XTPT0067
       TSX TAPER,4                                                      XTPT0068
       LDQ *,1               BRING IN FIRST (IOH) BUFFER WORD           XTPT0069
       PXD                   AND EXAMINE PROGRAM CONTROL CHARACTER      XTPT0070
       LGL 6                                                            XTPT0071
       TZE ZERO                                                         XTPT0072
       CAS =O10                                                         XTPT0073
       TXL HIGH                                                         XTPT0074
       TXL EIGHT                                                        XTPT0075
       ALS 2                                                            XTPT0076
       CAS =O10                                                         XTPT0077
       TXL FOUR                                                         XTPT0078
       TXL TWO                                                          XTPT0079
 CONE  LXA =O0,2             PCC=1. SET LINE COUNT TO 1,                XTPT0080
       LDQ =O560000000000    ADVANCE FRAME AND STOP PRINT               XTPT0081
       TSX ALTTAP,4                                                     XTPT0082
       SXA XTN6,2                                                       XTPT0083
       LDQ =O226060606060    SET 5 SPACE MARGIN                         XTPT0084
       TSX TAPER,4                                                      XTPT0085
       LDQ =O120000000000                                               XTPT0086
       TSX TAPER,4                                                      XTPT0087
       CLA *,1               PLACE XTON PRINT ORDER IN                  XTPT0088
       ANA =O007777777777    PLACE OF PCC ORDER IN THE                  XTPT0089
       ADD =O220000000000    FIRST WORD OF PACKET, THEN                 XTPT0090
       STO *,1               TRANSFER PACKET TO XTON                    XTPT0091
       LDQ *,1               TAPE OUTPUT BUFFER,                        XTPT0092
       TSX TAPER,4                                                      XTPT0093
       TIX *-2,1,1                                                      XTPT0094
       LDQ =O120000000000                                               XTPT0095
       TSX TAPER,4                                                      XTPT0096
 S1    AXT *,1                                                          XTPT0097
 S2    AXT *,2                                                          XTPT0098
 S4    AXT *,4                                                          XTPT0099
       TTR 2,4                                                          XTPT0100
 PRSET CAL XTN10             RELEASE THE PCC SUPPRESSOR IN THE          XTPT0101
       SLW GAMMA             XTON EDIT ROUTINE.                         XTPT0102
       TRA CONE+4                                                       XTPT0103
 HIGH  CAS =O40                                                         XTPT0104
       TXL SPACE                                                        XTPT0105
       TXL MINUS                                                        XTPT0106
       CLA XTN6              PCC=+. GO REPOSITION XTON BEAM             XTPT0107
       TRA TWO+3             AS PER LINE COUNT                          XTPT0108
 MINUS LDQ =O225212000000    PCC=-. CRN AND SOP THRICE,                 XTPT0109
       TSX TAPER,4                                                      XTPT0110
       TXI *+1,2,16                                                     XTPT0111
       TSX TAPER,4                                                      XTPT0112
       TXI *+1,2,16                                                     XTPT0113
       TSX TAPER,4                                                      XTPT0114
       TXI *+1,2,16                                                     XTPT0115
       TXH CONE,2,1023       IF FRAME IS FILLED, GO CHANGE FRAME,       XTPT0116
       TRA CONE+3            OTHERWISE PROCEED.                         XTPT0117
 SPACE LDQ =O225212000000    PCC=SPACE. ISSUE CRN AND SOP               XTPT0118
       TRA MINUS+5           ONCE.                                      XTPT0119
 ZERO  LDQ =O225212000000    PCC=0. ISSUE CRN AND SOP                   XTPT0120
       TRA MINUS+3           TWICE.                                     XTPT0121
 TWO   TXH CONE,2,496        PCC=2. CHANGE FRAME OR POSITION            XTPT0122
       CLA =O1000            BEAM TO MIDDLE OF FRAME.                   XTPT0123
       PAX,,2                                                           XTPT0124
       ADD =O200000120000                                               XTPT0125
       XCA                                                              XTPT0126
       TSX TAPER,4                                                      XTPT0127
       LDQ =O120000000000                                               XTPT0128
       TRA SPACE-4                                                      XTPT0129
 FOUR  TXH FOUR1,2,240       PCC=4. POSITION BEAM TO                    XTPT0130
       CLA =O400             SECOND QUARTER,                            XTPT0131
       TRA TWO+2                                                        XTPT0132
 FOUR1 TXH FOUR2,2,496       THIRD QUARTER,                             XTPT0133
       TRA TWO+1                                                        XTPT0134
 FOUR2 TXH CONE,2,752        FOURTH QUARTER OF FRAME                    XTPT0135
       CLA =O1400            OR CHANGE FRAME,                           XTPT0136
       TRA TWO+2                                                        XTPT0137
 EIGHT TXH EHT1,2,112        PCC=8. POSITION BEAM TO SECOND,            XTPT0138
       CLA =O200                                                        XTPT0139
       TRA TWO+2                                                        XTPT0140
 EHT1  TXH EHT2,2,240                                                   XTPT0141
       TRA FOUR+1            THIRD,                                     XTPT0142
 EHT2  TXH EHT3,2,368                                                   XTPT0143
       CLA =O600             FOURTH,                                    XTPT0144
       TRA TWO+2                                                        XTPT0145
 EHT3  TXH EHT4,2,496                                                   XTPT0146
       TRA TWO+1             FIFTH,                                     XTPT0147
 EHT4  TXH EHT5,2,624                                                   XTPT0148
       CLA =O1200            SIXTH,                                     XTPT0149
       TRA TWO+2                                                        XTPT0150
 EHT5  TXH EHT6,2,752                                                   XTPT0151
       TRA FOUR2+1           SEVENTH,                                   XTPT0152
 EHT6  TXH CONE,2,880        EIGHTH,                                    XTPT0153
       CLA =O1600            OR CHANGE FRAME.                           XTPT0154
       TRA TWO+2                                                        XTPT0155
 XTN1  TRA (IOH)+34                                                     XTPT0156
 XTN2  TTR OUTCRT                                                       XTPT0157
  XTN3 CLA 1,4                                                          XTPT0158
 XTN4  DEC 0                                                            XTPT0159
 XTN5  TRA XEDIT                                                        XTPT0160
 XTN6  DEC 0                                                            XTPT0161
 XTN7  TRA PRSET                                                        XTPT0162
 XTN10 STA GAMMA+3                                                      XTPT0163
 XTN11 DEC 0                                                            XTPT0164
       END                                                              XTPT0165
