                                                                        ,   0338
C                       ROUTINE  5                                      ,   0339
C                     CLEAR STORAGE                                     ,   0340
                                                                        ,   0341
  505 IF(NBADD-NBK2) 550,551,550                                        ,   0342
B 550 TEMP = (BADD*600000000000)                                        ,   0343
      IF (TEMP) 552,553,552                                             ,   0344
  553 LX = XMODF(NBAD,100)                                              ,   0345
  556 TIME = .0115*FLOATF(LI+1+LX)                                      ,   0346
      GO TO 525                                                         ,   0347
B 551 TEMP = (AADD*600000000000)                                        ,   0348
      CALL BCDOCT(NAADD,NAAD)                                           ,   0349
      IF(TEMP) 554,555,554                                              ,   0350
  555 LX = XMODF(NAAD,100)                                              ,   0351
      GO TO 556                                                         ,   0352
  554 N = L-1                                                           ,   0353
      DO 560 I=1,N,2                                                    ,   0354
      IF(ALATBL(I)-AADD) 560,561,560                                    ,   0355
  560 CONTINUE                                                          ,   0356
      GO TO 555                                                         ,   0357
  552 N = L-1                                                           ,   0358
      DO 570 I=1,N,2                                                    ,   0359
      IF(ALATBL(I)-BADD) 570,571,570                                    ,   0360
  570 CONTINUE                                                          ,   0361
      GO TO 553                                                         ,   0362
                                                                        ,   0363
  561 CALL BCDOCT(ALATBL(I+1),NAAD)                                     ,   0364
