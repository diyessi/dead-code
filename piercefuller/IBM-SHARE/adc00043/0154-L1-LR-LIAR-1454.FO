C      MOVE CHARACTERS AND EDIT                                         ,   0420
C                                                                       ,   0421
  514 TIME = .0115*FLOATF(LI+1+LA+LB+LY)                                ,   0422
      GO TO 525                                                         ,   0423
C                                                                       ,   0424
C                 ROUTINE  15                                           ,   0425
C           MOVE CHARACTERS AND SUPPRESS ZEROS                          ,   0426
C                                                                       ,   0427
  515 TIME = .0115*FLOATF(LI+1+3*LA)                                    ,   0428
      GO TO 525                                                         ,   0429
C                                                                       ,   0430
C            ROUTINE  16                                                ,   0431
C         MOVE AND INSERT ZEROS                                         ,   0432
C                                                                       ,   0433
  516 GO TO 4010                                                        ,   0434
C                                                                       ,   0435
C                           ROUTINE 17                                  ,   0436
C        MULTIPLY   (AVERAGE TIMING)                                    ,   0437
C                                                                       ,   0438
  517 TIME = .0115*FLOATF(LI+3+2*LA+5*LA+LB+7*LB)                       ,   0439
      GO TO 525                                                         ,   0440
C                                                                       ,   0441
C                      ROUTINE  19                                      ,   0442
C             STORE A  ADDRESS REGISTER                                 ,   0443
C                                                                       ,   0444
  519 TIME = .0115*FLOATF(LI+5)                                         ,   0445
      GO TO 525                                                         ,   0446
C                                                                       ,   0447
C                 ROUTINE  20                                           ,   0448
C          STORE B  ADDRESS REGISTER                                    ,   0449
C                                                                       ,   0450
  520 TIME = .0115*FLOATF(LI+4)                                         ,   0451
      GO TO 525                                                         ,   0452
C                                                                       ,   0453
C               ROUTINE  21                                             ,   0454
C       TO BYPASS  PSEUDO-OPS   --                                      ,   0455
C         DS, DSA, DCW, DC, ORG, END, CTL, EX                           ,   0456
C                                                                       ,   0457
  521 TIME=0.                                                           ,   0458
      GO TO 4010                                                        ,   0459
C                                                                       ,   0460
C                ROUTINE  18                                            ,   0461
C      READ, PRINT, PRINT READ, PUNCH, READ PUNCH,                      ,   0462
C                PRINT PUNCH, PRINT READ PUNCH                          ,   0463
C                                                                       ,   0464
                                                                        ,   0465
  101 TIME=.0115*FLOATF(LI+1)+75.                                       ,   0466
      GO TO 525                                                         ,   0467
  102 TIME=.0115*FLOATF(LI+1)+1.56                                      ,   0468
      GO TO 525                                                         ,   0469
  103 TIME=.0115*FLOATF(LI+1)+150.                                      ,   0470
      GO TO 525                                                         ,   0471
  104 TIME=.0115*FLOATF(LI+1)+240.                                      ,   0472
      GO TO 525                                                         ,   0473
  106 TIME=.0115*FLOATF(LI+1)+300.                                      ,   0474
      GO TO 525                                                         ,   0475
      END                                                               ,   0476
*      FAP                                                                      
       ENTRY   XITFPT                                                       0001
XITFPT LFTM                                                                 0002
       TRA     3,4                                                          0003
       END                                                                  0004
*     CARDS COLUMN                                                              
*     LIST8                                                                     
      SUBROUTINE ADDRS(AADD,ASIGN,ATAG,AADJ,ADD)                            0001
C        CONSTANTS FOR SUBROUTINE ADDRS                                     0002
B     ANH20 = 20 00 00 000000                                               0003
B     ANH14 = 14 00 00 00 00 00                                             0004
B     ANH74 = 74 00 00 00 00 00                                             0005
B     ONE = 00 00 00 00 00 01                                               0006
B     ANH1 = 10 00 00 000000                                                0007
B     ANH6 = 00 00 00 00 00 60                                              0008
B     ANBK1 = 60 00 00 000000                                               0009
B     ANBK2 = 60 60 60 60 60 60                                             0010
B     ANBK3 = 00 60 00 000000                                               0011
B     ANBK4 = 00 00 60 000000                                               0012
B     ANBK5 = 00 00 00 60 00 00                                             0013
B     ANH4 = 400000 000000                                                  0014
B     ANAST = 540000 000000                                                 0015
B     ANH2 = 020000 000000                                                  0016
B     AN1 = 010000 000000                                                   0017
B     AN3 = 030000 000000                                                   0018
B     XR39 = 60 31 03 11 71 60                                              0019
B     XR38 = 60 30 03 10 70 60                                              0020
B     XR37 = 60 27 03 07 67 60                                              0021
B     XR36 = 60 26 03 06 66 60                                              0022
B     XR35 = 60 25 03 05 65 60                                              0023
B     XR34 = 60 24 03 04 64 60                                              0024
B     XR33 = 60 23 03 03 63 60                                              0025
B     XR32 = 60 22 03 02 62 60                                              0026
B     XR31 = 60 21 03 01 61 60                                              0027
B     XR1 = 60 32 03 00 72 60                                               0028
B     XR29 = 60 51 02 11 51 60                                              0029
B     XR28 = 60 50 02 10 50 60                                              0030
B     XR27 = 60 47 02 07 47 60                                              0031
B     XR26 = 60 46 02 06 46 60                                              0032
B     XR25 = 60 45 02 05 45 60                                              0033
B     XR24 = 60 44 02 04 44 60                                              0034
B     XR23 = 60 43 02 03 43 60                                              0035
B     XR22 = 60 42 02 02 42 60                                              0036
B     XR21 = 60 41 02 01 41 60                                              0037
B     XR2 = 60 52 02 00 52 60                                               0038
B     XR19 = 60 71 01 11 31 60                                              0039
B     XR18 = 60 70 01 10 30 60                                              0040
B     XR17 = 60 67 01 07 27 60                                              0041
B     XR16 = 60 66 01 06 26 60                                              0042
B     XR15 = 60 65 01 05 25 00                                              0043
B     XR14 = 60 64 01 04 24 60                                              0044
B     XR13 = 60 63 01 03 23 60                                              0045
B     XR12 = 60 62 01 02 22 60                                              0046
B     XR11 = 60 61 01 01 21 60                                              0047
B     XR3 = 60 72 01 00 32 60                                               0048
      EQUIVALENCE(XR3(2),XR11),(XR3(3),XR12),(XR3(4),XR13),                 0049
     1(XR3(5),XR14),(XR3(6),XR15),(XR3(7),XR16),(XR3(8),XR17),              0050
     2(XR3(9),XR18),(XR3(10),XR19),(XR3(11),XR2),(XR3(12),XR21),            0051
     3(XR3(13),XR22),(XR3(14),XR23),(XR3(15),XR24),(XR3(16),XR25),          0052
     4(XR3(17),XR26),(XR3(18),XR27),(XR3(19),XR28),(XR3(20),XR29),          0053
     5(XR3(21),XR1),(XR3(22),XR31),(XR3(23),XR32),(XR3(24),XR33),           0054
     6(XR3(25),XR34),(XR3(26),XR35),(XR3(27),XR36),(XR3(28),XR37),          0055
     7(XR3(29),XR38),(XR3(30),XR39)                                         0056
      EQUIVALENCE(NH20,ANH20),(NH14,ANH14),(NH74,ANH74),(NH1,ANH1),         0057
     1(NH6,ANH6),(NBK1,ANBK1),(NBK2,ANBK2),(NBK3,ANBK3),(NBK4,ANBK4),       0058
     2(NBK5,ANBK5),(NH4,ANH4),(NAST,ANAST),(NH2,ANH2),(N1,AN1),(N3,AN3)     0059
      DIMENSION ALATBL(1500),XR1(1),XR2(1),XR3(1),LATBL(1500)               0060
      COMMON ZYX                                                            0061
      EQUIVALENCE(LCOUNT,COUNT,ZYX(2003))                                   0062
      EQUIVALENCE (ZYX(1),ALATBL,LATBL),(L,ZYX(2001)),(TEST,NTEST)          0063
      EQUIVALENCE (NTEST1,TEST1),(FLIP,NFLIP)                               0064
      EQUIVALENCE (ZYX(2002),ILOC,AILOC)                                    0065
      EQUIVALENCE (NCARD,ZYX(2016))  ,(MY,ZYX(2017))                        0066
      EQUIVALENCE (ADJ,NADJ)                                                0067
      EQUIVALENCE(L,ZYX(2001))                                              0068
      DIMENSION REF(1000)                                                   0069
      EQUIVALENCE(MMM,ZYX(2026))                                            0070
      EQUIVALENCE(NALOC,ANALOC),(REF,IEF,ZYX(12051))                        0071
      MMM=MMM                                                               0072
      MOVE1=0                                                               0073
      ADJ=AADJ                                                              0074
C TEST FOR BLANKS IN THE ADJUST POSITION                                    0075
      IF(NADJ-NBK2)  4003,4004,4003                                         0076
 4003 MOVE = 0                                                              0077
B     TEST = ADJ*000077000000                                               0078
      IF(NTEST-NBK4) 331,602,331                                            0079
  602  MOVE = 6                                                             0080
B 331  TEST = ADJ * 007700000000                                            0081
       IF(NTEST-NBK3) 604,603,604                                           0082
  603  IF(MOVE-6) 605,606,605                                               0083
  606  MOVE = 12                                                            0084
       GO TO 604                                                            0085
B 605  ADJ = ADJ*770077777777                                               0086
B 604  TEST = ADJ*770000000000                                              0087
       IF(NTEST-NBK1) 607,608,607                                           0088
B 608  ADJ = ADJ*007777777777                                               0089
  607  MOVE = MOVE+18                                                       0090
       ADJ = ARSF(MOVE,ADJ)                                                 0091
C                                                                           0092
C     TEST FOR ALPHABETIC CHARACTER IN ADDRESS                              0093
 4004 TEST=AADD                                                             0094
      IF(NTEST-NBK2) 4005,4006,4005                                         0095
B4005 TEST=AADD*600000000000                                                0096
      TEST=ARSF(1,TEST)                                                     0097
      IF(TEST) 401,363,401                                                  0098
C CHECK FOR PERCENT SIGN IN CC17                                            0099
B 401 TEST=AADD*770000000000                                                0100
      IF(NTEST-NH74)  4001,4002, 4001                                       0101
 4002 ADD=AADD                                                              0102
      GO TO 354                                                             0103
C TEST FOR * IN  ADDRESS POSITION                                           0104
 4001 IF(NTEST-NAST) 321,400,321                                            0105
  400 ARG1=ONE                                                              0106
       TEST = AILOC                                                         0107
      CALL BCDPLS(TEST,LCOUNT)                                              0108
      CALL BCDSUB(TEST,ARG1 )                                               0109
      ADD=TEST                                                              0110
      GO TO 362                                                             0111
  321 FLIP=AADD                                                             0112
      DO 322 J=1,L,2                                                        0113
      IF(LATBL(J)-NFLIP) 322,323,322                                        0114
  322 CONTINUE                                                              0115
      WRITE OUTPUT TAPE 4,995,NCARD                                         0116
  995 FORMAT(21H0ADDRESS IN CARD NO. I5,94H   IS NOT IN THE LABEL TABLE.    0117
     1                                                                 )    0118
      MY = MY+1                                                             0119
      ADD=0.0                                                               0120
      GO TO 354                                                             0121
  323 ALOC = ALATBL(J+1)                                                    0122
      CALL BCDOCT(ILOC,NALOC)                                               0123
B     AJCH=ARSF(22000000,J)                                                 0124
B     REF(MMM)=ANALOC+AJCH                                                  0125
      MMM=MMM+1                                                             0126
C     TEST TO SEE IF SYMBOL IS LEFT ADJUSTED                                0127
B     TEST = ALOC*000000000077                                              0128
      IF(NTEST-NH6) 320,325,320                                             0129
C     CHARACTER IS LEFT ADJUSTED                                            0130
C     TEST TO SEE IF CHARACTER IS ALPHABETIC                                0131
B 325 TEST=ALOC*600000000000                                                0132
      TEST=ARSF(1,TEST)                                                     0133
      IF(TEST) 360,361,360                                                  0134
  361 ADD = ARSF(12,ALOC)                                                   0135
      GO TO 362                                                             0136
C     CHARACTER IS RIGHT ADJUSTED                                           0137
  320 ADD = ALOC                                                            0138
  362 FLIP=ASIGN                                                            0139
      IF(NFLIP -NBK2) 326,335,326                                           0140
B 326 FLIP=FLIP*770000000000                                                0141
      IF(NFLIP-NH4) 600,328,600                                             0142
  600 IF(NFLIP-NH14) 601,328,601                                            0143
  601 IF(NFLIP-NH20)329,327,329                                             0144
  329 WRITE OUTPUT TAPE 4,994,NCARD                                         0145
  994 FORMAT(40H0ILLEGAL CODE IN SIGN FIELD OF CARD NO. I5,75H              0146
     1                                                                 )    0147
      MY = MY+1                                                             0148
  327 CALL BCDPLS(ADD,ADJ)                                                  0149
      GO TO 335                                                             0150
  328 CALL BCDSUB(ADD,ADJ)                                                  0151
  335 IF(SENSE LIGHT 2) 354,5003                                            0152
C     PUT IN 1401 ADDRESS EQUIVALENTS                                       0153
 5003 MODULO=0                                                              0154
B     OCTAL = 000004000000                                                  0155
B4012 TEST = ADD*777777000000                                               0156
      IF(TEST) 336,337,336                                                  0157
B 336 TEST = ADD*777774000000                                               0158
      IF(TEST) 4010,504,4010                                                0159
 4010 MODULO = MODULO+1                                                     0160
      CALL BCDSUB(ADD,OCTAL)                                                0161
      GO TO 336                                                             0162
B 504 TEST=ADD*777777000000                                                 0163
      IF(TEST) 5001,5002,5001                                               0164
B5001 TEST=ADD*3770000                                                      0165
      DO 338 J=1,30                                                         0166
B     TEST1 = XR3(J)*000077770000                                           0167
      IF(NTEST-NTEST1) 338,339,338                                          0168
  338 CONTINUE                                                              0169
B 339 TEST = XR3(J)*007700000000                                            0170
      TEST = ARSF(12,TEST)                                                  0171
B     ADD = (ADD*7777)+TEST                                                 0172
 5002 IF(MODULO) 702,337,702                                                0173
  702 NN = 31-10*MODULO                                                     0174
B     TEST=ADD*77                                                           0175
      TEST = ALSF(12,TEST)                                                  0176
      NNN=NN+10                                                             0177
      DO 501 J=NN,NNN                                                       0178
B     TEST1 = XR3(J)*000000770000                                           0179
      IF(NTEST-NTEST1) 501,503,501                                          0180
  501 CONTINUE                                                              0181
B 503  TEST=XR3(J)*000000007700                                             0182
      TEST=ARSF(6,TEST)                                                     0183
B      ADD=(ADD*777777777700)+TEST                                          0184
C     PUT IN INDEX REGISTER CODES                                           0185
  337 FLIP=ATAG                                                             0186
      IF(NFLIP-NBK2) 343,352,343                                            0187
B 343 TEST1 = ADD*000000007700                                              0188
      TEST1 = ALSF(6,TEST1)                                                 0189
B     TEST = ATAG*070000000000                                              0190
      IF(NTEST-N1) 510,340,510                                              0191
  510 IF(NTEST-NH2) 511,341,511                                             0192
  511 IF(NTEST-N3) 512,342,512                                              0193
  512 WRITE OUTPUT TAPE 4,513,NCARD                                         0194
  513 FORMAT(50H AN ILLEGAL INDEX IS BEING USED IN INSTRUCTION NO.  I5,     0195
     165H                                                                   0196
     2                                                        )             0197
      MY=MY+1                                                               0198
      GO TO 354                                                             0199
  340 DO 345 J=1,10                                                         0200
B     TEST = XR1(J)*000000770000                                            0201
      IF(NTEST-NTEST1) 345,346,345                                          0202
  345 CONTINUE                                                              0203
  993 FORMAT( 51H AN ILLEGAL CODE IN THE ADDRESS OF INSTRUCTION NO. I5,     0204
     164H IS BEING INDEXED                                                  0205
     2                                   )                                  0206
      WRITE OUTPUT TAPE 4,993,NCARD                                         0207
      MY = MY+1                                                             0208
B 346 TEST = XR1(J)*000000007700                                            0209
B 349 ADD = (ADD*777777770077)+TEST                                         0210
      GO TO 352                                                             0211
  341 DO 347 J=1,10                                                         0212
B     TEST = XR2(J)*000000770000                                            0213
      IF(NTEST-NTEST1) 347,348,347                                          0214
  347 CONTINUE                                                              0215
      WRITE OUTPUT TAPE 4,993,NCARD                                         0216
      MY = MY+1                                                             0217
B 348 TEST = XR2(J)*000000007700                                            0218
      GO TO 349                                                             0219
  342 DO 350 J=1,10                                                         0220
B     TEST = XR3(J)*000000770000                                            0221
      IF(NTEST-NTEST1) 350,351,350                                          0222
  350 CONTINUE                                                              0223
      WRITE OUTPUT TAPE 4,993,NCARD                                         0224
      MY = MY+1                                                             0225
B 351 TEST = XR3(J)*000000007700                                            0226
      GO TO 349                                                             0227
C     SHIFT ADDRESS TO HIGH ORDER                                           0228
  352 NSHIFT=18                                                             0229
B     AMASK=000000400000                                                    0230
      CALL SHIFT(NSHIFT,AMASK,ADD)                                          0231
      GO TO 354                                                             0232
  360 ADD = ALOC                                                            0233
      GO TO 354                                                             0234
 4006 ADD=AADD                                                              0235
      GO TO 354                                                             0236
  363 TEST=AADD                                                             0237
      CALL ADJUST (TEST)                                                    0238
      ADD=TEST                                                              0239
      GO TO 362                                                             0240
  354 RETURN                                                                0241
      END                                                                   0242
*     CARDS COLUMN                                                              
*     LIST8                                                                     
      SUBROUTINE ADJUST (AADD)                                              0001
      EQUIVALENCE(NBK2,ANBK2),(NBK5,ANBK5),(NBK4,ANBK4),(NBK3,ANBK3)        0002
C       CONSTANTS FOR SUBROUTINE ADJUST                                     0003
B     ANBK2 = 000000 006000                                                 0004
B     ANBK5 = 00 00 00 60 00 00                                             0005
B     ANBK4 = 00 00 60 00 00 00                                             0006
B     ANBK3 = 00 60 00 00 00 00                                             0007
      EQUIVALENCE (TEST,NTEST)                                              0008
      MOVE1=0                                                               0009
B     TEST=AADD*7700                                                        0010
      IF(NTEST-NBK2) 8000,8004,8000                                         0011
 8004 MOVE1=MOVE1+6                                                         0012
B  26 TEST=AADD*000000770000                                                0013
      IF(NTEST-NBK5) 8000,8001,8000                                         0014
 8001 MOVE1=MOVE1+6                                                         0015
B     TEST=AADD*000077000000                                                0016
      IF(NTEST-NBK4)  8000,8002,8000                                        0017
 8002 MOVE1=MOVE1+6                                                         0018
B      TEST=AADD*007700000000                                               0019
      IF(NTEST-NBK3) 8000,8003,8000                                         0020
 8003 MOVE1=MOVE1+6                                                         0021
 8000 MOVE1=MOVE1+6                                                         0022
      AADD=ARSF(MOVE1,AADD)                                                 0023
      RETURN                                                                0024
      END                                                                   0025
*     CARDS COLUMN                                                              
*     LIST8                                                                     
      SUBROUTINE BCDPLS(IANSWR,NDIGIT)                                      0001
C     CONSTANTS FOR SUBROUTINE BCDPLS                                       0002
B     ANONE=000000 000001                                                   0003
B     ANTWO=000000000002                                                    0004
B     AN21= 000000000021                                                    0005
B     ANELV=000000 000011                                                   0006
B     AK16=00 01 06 000000                                                  0007
      EQUIVALENCE(NONE,ANONE),(NTWO,ANTWO),(N21,AN21),(NELV,ANELV),         0008
     1(K16,AK16)                                                            0009
      EQUIVALENCE(ANUMBR,NUMBR),(CHAR,NCHAR)                                0010
      NUMBR=IANSWR+NDIGIT                                                   0011
      NCARRY=0                                                              0012
  100 DO 101 J=1,5                                                          0013
B     CHAR=(ANUMBR *000000000077)                                           0014
      IF(NCHAR-NELV )2,2,1                                                  0015
    1 IF(NCHAR-N21  ) 3,3,4                                                 0016
    3 SENSE LIGHT 3                                                         0017
      GO TO 4                                                               0018
    2 FAKE=LRSF(6,NCHAR)                                                    0019
      NUMBR=XARSF(6,NUMBR)+NCARRY                                           0020
      NCARRY=0                                                              0021
      GO TO 101                                                             0022
    4 NCHAR=NCHAR+NCARRY                                                    0023
      NCHAR=NCHAR-NTWO                                                      0024
      NCARRY=NONE                                                           0025
B     CHAR=(CHAR*000000000007)                                              0026
      IF(SENSE LIGHT 3) 2,7                                                 0027
B   7 CHAR=(CHAR+000000000010)                                              0028
      GO TO 2                                                               0029
  101 CONTINUE                                                              0030
      N=0                                                                   0031
      IANSWR=XLLSF(30,N)                                                    0032
      IF(IANSWR-K16)103,102,102                                             0033
  102 CALL BCDSUB(IANSWR,K16)                                               0034
  103 RETURN                                                                0035
      END                                                                   0036
*     CARDS COLUMN                                                              
*     LIST8                                                                     
      SUBROUTINE BCDOCT(MARTHA,NTOTAL)                                      0001
      EQUIVALENCE (CHAR,NCHAR), (ARG,NARG)                                  0002
      NARG=MARTHA                                                           0003
      N=0                                                                   0004
      NTOTAL=0                                                              0005
      DO 20 J=1,6                                                           0006
B     CHAR=ARG*000000000077                                                 0007
      NCHAR=XALSF(18,NCHAR)                                                 0008
      NTOTAL=NCHAR*(10**N)+NTOTAL                                           0009
      N=N+1                                                                 0010
      NARG=XARSF(6,NARG)                                                    0011
   20 CONTINUE                                                              0012
      RETURN                                                                0013
      END                                                                   0014
*     CARDS COLUMN                                                              
*     LIST8                                                                     
      SUBROUTINE SHIFT(NSHIFT,AMASK,ANUMBR)                                 0001
B     TEST=AMASK*ANUMBR                                                     0002
      ANUMBR=ALSF(NSHIFT,ANUMBR)                                            0003
      IF(TEST)  1,2,1                                                       0004
B   1 ANUMBR=ANUMBR+400000000000                                            0005
    2 RETURN                                                                0006
      END                                                                   0007
*     CARDS COLUMN                                                              
*     LIST8                                                                     
      SUBROUTINE PLACEL(ALABEL,AILOC)                                       0001
      DIMENSION  ALATBL(1500)                                               0002
      COMMON ZYX                                                            0003
      EQUIVALENCE (ALATBL,ZYX(1)),( L,ZYX(2001))                            0004
      EQUIVALENCE (NCARD,ZYX(2016))  ,(MY,ZYX(2017))                        0005
      L=L                                                                   0006
      DO 1 K=1,L,2                                                          0007
      IF(ALATBL(K)-ALABEL) 1,2,1                                            0008
   10 FORMAT(13H0THE LABEL   A6,15H   IN CARD NO. I5,81H   IS A DUPLICAT    0009
     1E                                                                )    0010
    2 WRITE OUTPUT TAPE 4,10,ALABEL,NCARD                                   0011
      MY = MY+1                                                             0012
    1 CONTINUE                                                              0013
B     ALATBL(L)=ALABEL                                                      0014
B     ALATBL(L+1)=AILOC                                                     0015
      L=L+2                                                                 0016
      RETURN                                                                0017
      END                                                                   0018
*     CARDS COLUMN                                                              
*     LIST8                                                                     
      SUBROUTINE READ                                                       0001
      COMMON ZYX                                                            0002
      DIMENSION ALPHA(1)                                                    0003
      EQUIVALENCE (ALPHA(1),AADJ,ZYX(2005)),(ALPHA(2),ATAG,ZYX(2006)),      0004
     1 (ALPHA(3),BADD,ZYX(2007)),(ALPHA(4),BSIGN,ZYX(2008)),                0005
     2 (ALPHA(5),BADJ,ZYX(2009)),(ALPHA(6),BTAG,ZYX(2010)),                 0006
     3  (ALPHA(7),D,ZYX(2011)),(ALPHA(8),CMNTS(1),ZYX(2012)),               0007
     4 (ALPHA(9),CMNTS(2),ZYX(2013)),(ALPHA(10),CMNTS(3),ZYX(2014))         0008
      EQUIVALENCE (ALABEL,LABEL,ZYX(2020)) ,(OP,IOP,ZYX(2021))              0009
      EQUIVALENCE(AADD,NAADD,ZYX(2022)),(ASIGN,NASIGN,ZYX(2023))            0010
      EQUIVALENCE (ICNT,AICNT,ZYX(2024))                                    0011
 5000 READ INPUT TAPE 7,1,ICNT,ALABEL,OP,AADD,ASIGN,AADJ,ATAG,BADD,         0012
     1BSIGN,BADJ,BTAG,D,CMNTS (1),CMNTS(2),CMNTS(3)                         0013
    1 FORMAT(5X,A2,A6,A3,A6,A1,A3,A1,A6,A1,A3,A1,A1,A6,A6,A4)               0014
      RETURN                                                                0015
      END                                                                   0016
*     LIST8                                                                     
*     CARDS COLUMN                                                              
      SUBROUTINE BCDSUB(IANSWR,DECRE)                                       0001
C     CONSTANTS FOR SUBROUTINE BCDSUB                                       0002
B     ANONE=000000 000001                                                   0003
B     ANTWO=000000 000002                                                   0004
B     ANH6=000000 000060                                                    0005
B     AN37=000000 000037                                                    0006
B     AK16=00 01 06 00 00 00                                                0007
      EQUIVALENCE(NONE,ANONE),(NTWO,ANTWO),(NH6,ANH6),(N37,AN37),           0008
     1(K16,AK16)                                                            0009
      EQUIVALENCE(ANUMBR,NUMBR),(CHAR,NCHAR),(ALOW,NALOW),(TEST,NTEST),     0010
     1(NDIGIT,DGT)                                                          0011
      EQUIVALENCE (TEMP,NTEMP),(HOLE,NHOLE)                                 0012
      DIGIT=DECRE                                                           0013
  102 TEMP=DIGIT                                                            0014
      NHOLE=IANSWR                                                          0015
B     DGT=(-DIGIT)*377777777777                                             0016
      NUMBR=IANSWR +NDIGIT+NONE                                             0017
  100 DO 101 J=1,5                                                          0018
B     CHAR=(ANUMBR*000000000077)                                            0019
B     TEST=(CHAR*000000000070)                                              0020
B     ALOW=(CHAR*000000000007)                                              0021
      IF(NTEST-NH6  )3,2,1                                                  0022
    1 NCHAR=NALOW+NTWO                                                      0023
B     GO TO 3                                                               0024
    2 NCHAR=NALOW+NTWO                                                      0025
B     CHAR=(CHAR*000000000007)                                              0026
    3 FAKE=LRSF(6,NCHAR)                                                    0027
      NUMBR=XARSF(6,NUMBR)                                                  0028
  101 CONTINUE                                                              0029
      IF(NUMBR-N37) 103,104,103                                             0030
  103 IF(SW) 105,106,105                                                    0031
  104 IANSWR=NTEMP                                                          0032
      DIGIT=HOLE                                                            0033
      SW=1.0                                                                0034
      GO TO 102                                                             0035
  105 N=0                                                                   0036
      IANSWR=XLLSF(30,N)                                                    0037
      NTEMP=IANSWR                                                          0038
      IANSWR=K16                                                            0039
      DIGIT=TEMP                                                            0040
      SW=0.0                                                                0041
      GO TO 102                                                             0042
  106 N=0                                                                   0043
      IANSWR=XLLSF(30,N)                                                    0044
      RETURN                                                                0045
      END                                                                   0046
