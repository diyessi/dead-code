  606 IF(LLB-NTW2) 601,608,608                                          ,   0300
  608 LB = 5                                                            ,   0301
      GO TO 607                                                         ,   0302
  601 LLB=XARSF(12,LLB)                                                 ,   0303
      CALL BCDOCT(LLB,LB)                                               ,   0304
  607 IF(LLQ-NTW3) 602,610,610                                          ,   0305
  610 LQ = 5                                                            ,   0306
      GO TO 609                                                         ,   0307
  602 CALL BCDOCT(LLQ,LQ)                                               ,   0308
  609 LCNT=XARSF(24,LCOUNT)                                             ,   0309
      CALL BCDOCT(LCNT,LI)                                              ,   0310
                                                                        ,   0311
      IF(IDENT-9) 529,521,529                                           ,   0312
  529 GO TO (101,102,103,104,104,106,106,503,503,521,512,517,502,503,   ,   0313
     1507,506,514,508,521,520,521,507,503,506,521,503,511,513,503,521,  ,   0314
     2511,519,521,507,521,521,505,502,521,509,504,504,516,506,515,521,  ,   0315
     3504,510,521,521,521,521,521,521,521,521,521,521,521 ), J          ,   0316
