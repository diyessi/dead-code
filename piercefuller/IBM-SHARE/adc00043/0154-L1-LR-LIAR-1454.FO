B     TABL = 00 00 03 20 40 60                                              0044
B     AMO = 000000325200                                                    0045
      EQUIVALENCE(NH4,ANH4),(NTW1,ANTW1),(NTW2,ANTW2),(NTW3,ANTW3),         0046
     1(NBK2,ANBK2),(MBD,AMBD),(MBC,AMBC),(MBB,AMBB),(MBA,AMBA),             0047
     2(N80,AN80),(J1,AJ1),(K2,AK2),(L3,AL3),(M4,AM4),(N5,AN5)               0048
      COMMON ZYX                                                            0049
      DIMENSION BUFFER(10000),NBUFFR(10000)                                 0050
      DIMENSION NCMNTS(1)                                                   0051
      DIMENSION ALATBL(1500), DICT(60), CMNTS(3)                            0052
      DIMENSION TABL(1), ALPHA(1), AMO(11)                                  0053
      EQUIVALENCE (AMO(2),TABL),  (AMO(3),R9),  (AMO(4),Q8),                0054
     1(AMO(5),P7),   (AMO(6),O6),   (AMO(7),N5),   (AMO(8),M4),             0055
     2(AMO(9),L3),   (AMO(10),K2),   (AMO(11),J1)                           0056
      EQUIVALENCE (ALPHA(1),AADJ,ZYX(2005)),(ALPHA(2),ATAG,ZYX(2006)),      0057
     1 (ALPHA(3),BADD,ZYX(2007)),(ALPHA(4),BSIGN,ZYX(2008)),                0058
     2 (ALPHA(5),BADJ,ZYX(2009)),(ALPHA(6),BTAG,ZYX(2010)),                 0059
     3  (ALPHA(7),D,ZYX(2011)),(ALPHA(8),CMNTS(1),ZYX(2012)),               0060
     4 (ALPHA(9),CMNTS(2),ZYX(2013)),(ALPHA(10),CMNTS(3),ZYX(2014))         0061
      EQUIVALENCE(TOTIME,ZYX(2015))                                         0062
      EQUIVALENCE (NCARD,ZYX(2016))  ,(MY,ZYX(2017)) ,(PCH,ZYX(2018))       0063
      EQUIVALENCE(CMNTS(1),NCMNTS(1)   )                                    0064
      EQUIVALENCE (ALATBL,ZYX(1)),( L,ZYX(2001))                            0065
      EQUIVALENCE(NTEST,TEST),(NBADD,BADD),(D,ND)                           0066
      EQUIVALENCE (ICNT,AICNT),(CC75,NCC75),(CC74,NCC74),(CC71,NCC71)       0067
      EQUIVALENCE(CC60,NCC60),(CC67,NCC67),(CC68,NCC68)                     0068
      EQUIVALENCE (CC56,NCC56),(CC57,NCC57)                                 0069
      EQUIVALENCE (ZYX(2002),ILOC,AILOC)                                    0070
      EQUIVALENCE (COUNT,LCOUNT,ZYX(2003)) ,(MARTHA,ZYX(2004))              0071
      EQUIVALENCE (ARG,NARG),(CHAR,NCHAR),(BAD,NBAD),(AAD,NAAD)             0072
      EQUIVALENCE (LQ,LY,LZ),(ALA,LLA),(ALB,LLB),(ALQ,LLQ)                  0073
      EQUIVALENCE(ASIGN,NASIGN)                                             0074
      EQUIVALENCE(BUFFER,NBUFFR,ZYX(2050)),(BLOAD,ZYX(2019))                0075
      EQUIVALENCE (ALABEL,LABEL,ZYX(2020)) ,(OP,IOP,ZYX(2021))              0076
      EQUIVALENCE(AADD,NAADD,ZYX(2022)),(ASIGN,NASIGN,ZYX(2023))            0077
      EQUIVALENCE(KCTL,ZYX(2025))                                           0078
      II=-19                                                                0079
  300 IF(BLOAD) 9000,9000,9001                                              0080
 9001 IF(II+19) 9004,9003,9004                                              0081
 9004 IF(II-9981) 9000,9003,9003                                            0082
 9003 READ TAPE 2,BUFFER                                                    0083
      II=-19                                                                0084
 9000 II=II+20                                                              0085
      LCOUNT=NBUFFR(II)                                                     0086
      ALABEL=BUFFER(II+1)                                                   0087
      OP=BUFFER(II+2)                                                       0088
      AADD=BUFFER(II+3)                                                     0089
      ASIGN=BUFFER(II+4)                                                    0090
      AADJ=BUFFER(II+5)                                                     0091
      ATAG=BUFFER(II+6)                                                     0092
      BADD=BUFFER(II+7)                                                     0093
      BSIGN=BUFFER(II+8)                                                    0094
      BADJ=BUFFER(II+9)                                                     0095
      BTAG=BUFFER(II+10)                                                    0096
      D=BUFFER(II+11)                                                       0097
      CMNTS(1)=BUFFER(II+12)                                                0098
      CMNTS(2)=BUFFER(II+13)                                                0099
      CMNTS(3)=BUFFER(II+14)                                                0100
      IDENT=NBUFFR(II+15)                                                   0101
      OPCODE=BUFFER(II+16)                                                  0102
      ILOC =NBUFFR(II+17)                                                   0103
      J = NBUFFR(II+18)                                                     0104
      NCARD=NBUFFR(II+19)                                                   0105
      NCC60=NBK2                                                            0106
      NCC67 = NBK2                                                          0107
      NCC68 = NBK2                                                          0108
      NCC71 = NBK2                                                          0109
      NCC74 = NBK2                                                          0110
      NCC75 = NBK2                                                          0111
      GO TO (310,311,312,313,314,315,316,317,706,707,316,331,319),IDENT     0112
C                                                                           0113
C     INSTRUCTION CARD ROUTINE                                              0114
C                                                                           0115
  319 CALL ADDRS (AADD,ASIGN,ATAG,AADJ,CC68)                                0116
      CALL ADDRS (BADD,BSIGN,BTAG,BADJ,CC71)                                0117
      CC74 = D                                                              0118
      CC67=OPCODE                                                           0119
      NCHAR=ILOC                                                            0120
      CALL BCDPLS(NCHAR,LCOUNT)                                             0121
      TEST=ONE                                                              0122
      CALL BCDSUB(NCHAR,TEST)                                               0123
      CHAR=ALSF( 6,CHAR)                                                    0124
      CALL ADDRS(NCHAR,NBK2,NBK2,NBK2,CC60)                                 0125
      SENSE LIGHT 4                                                         0126
      IF (NAADD-NBK2) 321,322,321                                           0127
  322 CC68 = CC74                                                           0128
      NCC74 = NBK2                                                          0129
  321 IF (NBADD-NBK2) 323,324,323                                           0130
  324 CC71 = CC74                                                           0131
      NCC74 = NBK2                                                          0132
  323 ARG1=C66                                                              0133
  325 CC56=CL                                                               0134
  320 NTEST = LCOUNT                                                        0135
      CALL BCD PLS(TEST,ARG1)                                               0136
      NSHIFT=18                                                             0137
B     AMASK=000000400000                                                    0138
      CALL SHIFT(NSHIFT,AMASK,TEST)                                         0139
      CC57=TEST                                                             0140
B 327 TEST=AILOC*77                                                         0141
      IF (NTEST-MBD) 84,85,84                                               0142
   84 ILOC=XALSF(6,ILOC)                                                    0143
   85 IF(SENSE LIGHT4) 86,87                                                0144
   87 CALL ADDRS (ILOC,NBK2,NBK2,NBK2,CC60 )                                0145
   86 LCOUNT=XALSF(24,LCOUNT)                                               0146
  330 IF(MARTHA) 604,4010,599                                               0147
 4010 IF(PCH) 720,721,720                                                   0148
  721 CTL=3HS*                                                              0149
      GO TO 9011                                                            0150
  720 CTL=6HS                                                               0151
 9011 IF(TIME) 9010,9012,9010                                               0152
 9012 IF(TOTIME) 9010,9013,9010                                             0153
 9013 WRITE OUTPUT TAPE 6,9014,CTL,NCARD,LCOUNT,ALABEL,OP,AADD,ASIGN,AAD    0154
     1J,ATAG,BADD,BSIGN,BADJ,BTAG,D,CMNTS(1),CMNTS(2),CMNTS(3),CC56,CC57,   0155
     1,CC60,CC63,CC67,CC68,CC71,CC74,CC75,ILOC                          ,   0156
 9014 FORMAT(A3,I3,2X,A2,A6,A3,A6,A1,A3,A1,A6,A1,A3,A1,A1,A6,A6,A4,A1,  ,   0157
     1A3,A3,A4,A1,A3,A3,A1,A1,4X,A5,25X)                                ,   0158
      GO T O 9015                                                       ,   0159
 9010 WRITE OUTPUT TAPE 6,66,CTL,NCARD,LCOUNT,ALABEL,OP,AADD,ASIGN,AADJ,,   0160
     1ATAG,BADD,BSIGN,BADJ,BTAG,D,CMNTS(1),CMNTS(2),CMNTS(3),CC56,CC57, ,   0161
     2CC60,CC63,CC67,CC68,CC71,CC74,CC75,ILOC,TIME,TOTIME               ,   0162
   66 FORMAT( A3 ,I3,2X,A2,A6,A3,A6,A1,A3,A1,A6,A1,A3,A1,A1,A6,A6,A4,A1,,   0163
     1A3,A3,A4,A1,A3,A3,A1,A1,4X,A5,F10.2,F15.3)                        ,   0164
 9015 IF(SENSE LIGHT 1)  5000,300                                       ,   0165
 5000 RETURN                                                            ,   0166
C                                                                       ,   0167
C     DCW CARD                                                          ,   0168
C                                                                       ,   0169
  312 CC75 = CF                                                         ,   0170
      CC56 = CL                                                         ,   0171
  326 ARG1=C23                                                          ,   0172
      IF(NASIGN-NBK2) 411,320,411                                       ,   0173
  411 CALL BCDOCT(LCOUNT,NTEST)                                         ,   0174
      DO 413 I=1,10                                                     ,   0175
B     CHAR=TABL(I)*777777000000                                         ,   0176
      NTEST=NTEST-NCHAR                                                 ,   0177
      IF(NTEST) 412,412,413                                             ,   0178
  413 CONTINUE                                                          ,   0179
  412 NTEST=NTEST+NCHAR                                                 ,   0180
      N =(6-NTEST)*6                                                    ,   0181
      ARG=ALPHA(I)                                                      ,   0182
      CHAR=LRSF(N,ARG)                                                  ,   0183
B     TEST=CHAR*000000000077                                            ,   0184
      DO 415 K=1,11                                                     ,   0185
B     ARG=AMO(K)*000000000077                                           ,   0186
      IF(NARG-NTEST) 415,414,415                                        ,   0187
  415 CONTINUE                                                          ,   0188
      WRITE OUTPUT TAPE 4,996,NCARD                                     ,   0189
      MY = MY+1                                                         ,   0190
  996 FORMAT(39H0AN ALPHABETIC FIELD ON DC OR DCW CARD I5,76H   HAS BEEN,   0191
     1 SIGNED.                                                         ),   0192
      GO TO 320                                                         ,   0193
  414 IF(NASIGN-NH4) 111,110,111                                        ,   0194
B 110 TEST=AMO(K)*000000007777                                          ,   0195
      ARG=ARSF(6,TEST)                                                  ,   0196
      GO TO 112                                                         ,   0197
B 111 TEST=AMO(K)*000000770000                                          ,   0198
      ARG=ARSF(12,TEST)                                                 ,   0199
B 112 CHAR=CHAR*777777777700+ARG                                        ,   0200
      ALPHA(I)=LLSF(N,CHAR)                                             ,   0201
      IF (N-30) 320,700,320                                             ,   0202
  700 IF(NASIGN-NH4) 320,715,320                                        ,   0203
B 715 ALPHA(I)=ALPHA(I)+400000000000                                    ,   0204
      GO TO 320                                                         ,   0205
C                                                                       ,   0206
C     DC CARD                                                           ,   0207
C                                                                       ,   0208
  313 CC75 = C5                                                         ,   0209
      CC56 = CM                                                         ,   0210
      GO TO 326                                                         ,   0211
C                                                                       ,   0212
C     DSA CARD                                                          ,   0213
C                                                                       ,   0214
  311 CC75 = CG                                                         ,   0215
      CC56 = CL                                                         ,   0216
      CC57=C26                                                          ,   0217
      CALL ADDRS(BADD,BSIGN,BTAG,BADJ,AADJ)                             ,   0218
      GO TO 327                                                         ,   0219
C                                                                       ,   0220
C     ORG CARD                                                          ,   0221
C                                                                       ,   0222
  314 CC75 = C2                                                         ,   0223
      CALL ADDRS(AADD,NBK2,NBK2,NBK2,CC68 )                             ,   0224
  331 CC56 = C1                                                         ,   0225
      CC57 = C56                                                        ,   0226
      GO TO 86                                                          ,   0227
C                                                                       ,   0228
C     CONTROL CARD ROUTINE                                              ,   0229
C                                                                       ,   0230
  316 CC75 = CR                                                         ,   0231
      GO TO 331                                                         ,   0232
C                                                                       ,   0233
C     DS CARD ROUTINE                                                   ,   0234
C                                                                       ,   0235
  310 CC75 = CD                                                         ,   0236
B     TEST=AILOC*000000007777                                           ,   0237
      IF(NTEST-MBC) 51,50,51                                            ,   0238
   50 AILOC=ARSF(12,AILOC)                                              ,   0239
B  51 TEST=AILOC*000077000000                                           ,   0240
B     AMASK=000040000000                                                ,   0241
      CALL SHIFT(12,AMASK,TEST)                                         ,   0242
      CC67 = TEST                                                       ,   0243
B     TEST = AILOC*000000777777                                         ,   0244
B     AMASK=000000400000                                                ,   0245
      CALL SHIFT(18,AMASK,TEST)                                         ,   0246
      CC68=TEST                                                         ,   0247
B     AMASK=004000000000                                                ,   0248
      CALL SHIFT(6,AMASK,AILOC )                                        ,   0249
      GO TO 331                                                         ,   0250
C                                                                       ,   0251
C     EXECUTE CARD                                                      ,   0252
C                                                                       ,   0253
  317 CC75 = CQ                                                         ,   0254
      IF (NAADD-NBK2) 335,336,335                                       ,   0255
  336 CC57=C63                                                          ,   0256
      CC56=CPT                                                          ,   0257
      GO TO 330                                                         ,   0258
  335 CALL ADDRS (AADD,ASIGN,ATAG,AADJ,CC57)                            ,   0259
      CC56=CB                                                           ,   0260
      GO TO 330                                                         ,   0261
C                                                                       ,   0262
C     END CARD                                                          ,   0263
C                                                                       ,   0264
  315 CC75 = CJ                                                         ,   0265
      CC56 = CCS                                                        ,   0266
      NCC60=N80                                                         ,   0267
      SENSE LIGHT 1                                                     ,   0268
      IF (NAADD-NBK2) 341,342,341                                       ,   0269
  342 CC57 = ZERO                                                       ,   0270
      GO TO 750                                                         ,   0271
  341 CALL ADDRS (AADD,ASIGN,ATAG,AADJ,CC57)                            ,   0272
C INSERTION FOR B.J.M.                                                  ,   0273
  750 CC68=CC57                                                         ,   0274
      CALL ADDRS(BADD,BSIGN,NBK2,BADJ,CC71)                             ,   0275
      GO TO 330                                                         ,   0276
C  STOP TIMING ROUTINE                                                  ,   0277
  707 MARTHA=0                                                          ,   0278
      TIME=0.0                                                          ,   0279
      TOTIME=0.0                                                        ,   0280
      GO TO 316                                                         ,   0281
C ROUTINE TO TURN TIMING ON                                             ,   0282
  706 IF(NAADD-NBK2)  708,709,708                                       ,   0283
  708 MARTHA=1                                                          ,   0284
      GO TO 316                                                         ,   0285
  709 MARTHA=-1                                                         ,   0286
      GO TO 316                                                         ,   0287
  604 LA = 5                                                            ,   0288
      LB = 5                                                            ,   0289
      LQ = 5                                                            ,   0290
      GO TO 609                                                         ,   0291
B 599 ALA = CMNTS(1)*777700000000                                       ,   0292
B     ALB=CMNTS(1)*000077770000                                         ,   0293
B     ALQ=CMNTS(1)*000000007777                                         ,   0294
  603 IF(LLA-NTW1) 600,605,605                                          ,   0295
  605 LA = 5                                                            ,   0296
      GO TO 606                                                         ,   0297
  600 LLA=XARSF(24,LLA)                                                 ,   0298
