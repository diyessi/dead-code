CANM101      51 05142                                                   M1010001
C     ALGEBRAIC SORT---SUBROUTINE SORT                                  M1010002
C                                                                       M1010003
      SUBROUTINE SORT (A,TEMP,N,MODE)                                   M1010004
C                                                                       M1010005
      DIMENSION A(1), TEMP(1)                                           M1010006
C                                                                       M1010007
    5 N2HALF=1                                                          M1010008
   10 N2=N2HALF+N2HALF                                                  M1010009
   15 IF (N2HALF-N) 20, 140, 140                                        M1010010
   20 NREM=XMODF(N,N2)                                                  M1010011
   25 N1=N-NREM                                                         M1010012
   30 IF (N1) 60, 60, 40                                                M1010013
   40 DO 50 I=1,N1,N2                                                   M1010014
   45 I1=I+N2HALF                                                       M1010015
   50 CALL MERGE (A(I),N2HALF,A(I1),N2HALF,TEMP(I),MODE)                M1010016
   60 NREM1=NREM-N2HALF                                                 M1010017
   65 NLIMIT=N1                                                         M1010018
   70 IF (NREM1) 100, 100, 75                                           M1010019
   75 NLIMIT=N                                                          M1010020
   80 I1=N1+N2HALF                                                      M1010021
   90 CALL MERGE (A(N1+1),N2HALF,A(I1+1),NREM1,TEMP(N1+1),MODE)         M1010022
  100 DO 110 I=1,NLIMIT                                                 M1010023
  110 A(I)=TEMP(I)                                                      M1010024
  120 N2HALF=N2HALF+N2HALF                                              M1010025
  130 GO TO 10                                                          M1010026
  140 RETURN                                                            M1010027
      END (0,1,0,0,0)                                                   M1010028
C     ALGEBRAIC SORT---SUBROUTINE MERGE                                 M1010029
C                                                                       M1010030
      SUBROUTINE MERGE (JX,J,KX,K,LX,MODE)                              M1010031
C                                                                       M1010032
      DIMENSION JX(1), KX(1), LX(1)                                     M1010033
C                                                                       M1010034
    5 L=J+K                                                             M1010035
   10 J1=1                                                              M1010036
   15 K1=1                                                              M1010037
   20 DO 130 L1=1,L                                                     M1010038
   30 IF (J1-J) 40, 40, 110                                             M1010039
   40 IF (K1-K) 50, 50, 80                                              M1010040
   50 GO TO (60,70), MODE                                               M1010041
   60 IF (KX(K1)-JX(J1)) 110, 110, 80                                   M1010042
   70 IF (KX(K1)-JX(J1)) 80, 80, 110                                    M1010043
   80 LX(L1)=JX(J1)                                                     M1010044
   90 J1=J1+1                                                           M1010045
  100 GO TO 130                                                         M1010046
  110 LX(L1)=KX(K1)                                                     M1010047
  120 K1=K1+1                                                           M1010048
  130 CONTINUE                                                          M1010049
  140 RETURN                                                            M1010050
      END (0,1,0,0,0)                                                   M1010051
