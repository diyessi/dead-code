      SUBROUTINE DDFERI (SC)                                            00160001
D     DIMENSION C(8), A(4), Y(3)                                        00160002
      DIMENSION SC(8)                                                   00160003
      DO 400 L=1,5                                                      00160004
  400 C(L)=SC(L)                                                        00160005
      DO 401 L=9,16                                                     00160006
  401 C(L)=0.0                                                          00160007
D     A(1)=1.0                                                          00160008
D     CLOD=.250*C(2)/C(1)                                               00160009
   14 IF (C(2)) 100, 101, 100                                           00160010
D 100 PLOD=C(1)**2                                                      00160011
D     P=C(3)/C(1)-.375*(C(2)**2)/PLOD                                   00160012
D     Q=C(4)/C(1)-.5*(C(3)*C(2))/(PLOD   )+.125*((C(2)/C(1))**3)        00160013
D     R=((C(2)**2)*C(3))/(16.0*(C(1)**3))-(3.0*(C(2)**4))/(256.0*(C(1)  00160014
D    1**4))-.25*(C(4)*C(2))/PLOD+C(5)/C(1)                              00160015
D 102 A(2)=-P                                                           00160016
D     A(3)=-4.0*R                                                       00160017
D     A(4)=4.0*P*R-Q**2                                                 00160018
      CALL DDVETA (A,Y, MTYPE)                                          00160019
      IF (MTYPE) 15, 15, 16                                             00160020
D  15 U=Y(1)                                                            00160021
      DO 666 L=2,3                                                      00160022
      IF (U-Y(L))  76, 666, 666                                         00160023
D  76 U=Y(L)                                                            00160024
  666 CONTINUE                                                          00160025
      GO TO 21                                                          00160026
   16 IF (Y(2)) 270, 271, 270                                           00160027
  271 IF(ABSF(Y(3))-10.0**(-7)) 272, 17, 17                             00160028
D 272 Y(2) = 0.0                                                        00160029
D     Y(3)=0.0                                                          00160030
      GO TO 15                                                          00160031
D 270 PLOD = ABSF(Y(3)/Y(2))-5.0E-7                                     00160032
      IF (PLOD) 18, 18, 17                                              00160033
D  17 U=Y(1)                                                            00160034
      GO TO 21                                                          00160035
D  18 PLOD=Y(1)-Y(2)                                                    00160036
      IF (PLOD) 20, 17, 17                                              00160037
D  20 U=Y(2)                                                            00160038
D  21 PLOD=U-P                                                          00160039
      IF (ABSF(PLOD)-10.0**(-10)) 200, 150, 150                         00160040
D 150 BIGA=SQRTF(PLOD)                                                  00160041
D     DISC1=BIGA**2-2.0*U+2.0*Q/BIGA                                    00160042
D     DISC2=DISC1-4.0*Q/BIGA                                            00160043
      IF (ABSF(DISC1)-10.0**(-15)) 204, 205, 205                        00160044
D 204 DISC1=0.0                                                         00160045
  205 IF (DISC1) 24, 22, 23                                             00160046
D  22   C (2)=0.0                                                       00160047
D       C (1)=-.50*BIGA                                                 00160048
D       C (3)=C(1)                                                      00160049
D       C (4)=0.0                                                       00160050
      GO TO 25                                                          00160051
D  23 DISC1=SQRTF(DISC1)                                                00160052
D       C (1)=.50*(DISC1-BIGA)                                          00160053
D       C (2)=0.0                                                       00160054
D       C (4)=0.0                                                       00160055
D       C (3)=   C(1)-DISC1                                             00160056
      GO TO 25                                                          00160057
D  24    C(1)=-.50*BIGA                                                 00160058
D       C (3)=  C (1)                                                   00160059
D     PLOD=ABSF(DISC1)                                                  00160060
D     C(2)   =.50*SQRTF(PLOD)                                           00160061
D     C(4)=-C(2)                                                        00160062
   25 IF(ABSF(DISC2)-10.0**(-15)) 210, 211, 211                         00160063
D 210 DISC2=0.0                                                         00160064
  211 IF (DISC2) 28, 26, 27                                             00160065
D  26   C (6)=0.0                                                       00160066
D       C (8)=  C (6)                                                   00160067
D       C (5)=.50*BIGA                                                  00160068
D       C (7)=  C (5)                                                   00160069
      GO TO 29                                                          00160070
D  27 DISC2=SQRTF(DISC2)                                                00160071
D       C (6)=0.0                                                       00160072
D       C (5)=.50*(DISC2+BIGA)                                          00160073
D       C (8)=0.0                                                       00160074
D       C (7)=  C (5)-DISC2                                             00160075
      GO TO 29                                                          00160076
D  28   C (5)=.50*BIGA                                                  00160077
D       C (7)=  C (5)                                                   00160078
D     PLOD=ABSF(DISC2)                                                  00160079
D       C (6)=.50*SQRTF(PLOD)                                           00160080
D     C(8)=-C(6)                                                        00160081
   29 DO 30  L=1,4                                                      00160082
D       C (2*L-1)=  C (2*L-1)-CLOD                                      00160083
   30 CONTINUE                                                          00160084
      DO 166 L=1,8                                                      00160085
  166 SC(L)=C(L)                                                        00160086
      RETURN                                                            00160087
D 101 P=C(3)    /C(1)                                                   00160088
D     Q=C(4)  /C(1)                                                     00160089
D     R=C(5) /C(1)                                                      00160090
      GO TO 102                                                         00160091
D 200 PLOD=P**2-4.0*R                                                   00160092
      IF (ABSF(PLOD)-10.0**(-15)) 201, 202, 202                         00160093
D 201 PLOD=0.0                                                          00160094
  202 IF (PLOD) 203, 300, 300                                           00160095
D 203 ABSZ=SQRTF(P**2-PLOD)/2.0                                         00160096
D     PHI  =ATAN2F(SQRTF(-PLOD),-P)                                     00160097
D     C(1)=ABSZ*COSF(PHI)                                               00160098
D     C(2)=ABSZ*SINF(PHI)                                               00160099
D     C(3)= C(1)                                                        00160100
D     C(4)=-C(2)                                                        00160101
D     C(5)=-C(1)                                                        00160102
D     C(6)= C(2)                                                        00160103
D     C(7)= C(5)                                                        00160104
D     C(8)=-C(2)                                                        00160105
      GO TO 29                                                          00160106
D 300 ZAP=SQRTF(PLOD)                                                   00160107
D     ZSQRE1=.50*(-P+ZAP)                                               00160108
D     ZSQRE2=ZSQRE1-ZAP                                                 00160109
      IF (ZSQRE1) 301, 302, 302                                         00160110
D 301 C(2)=SQRTF(-ZSQRE1)                                               00160111
D     C(4)=-C(2)                                                        00160112
D     C(1)=0.0                                                          00160113
D     C(3)=0.0                                                          00160114
      GO TO 310                                                         00160115
D 302 C(1)=SQRTF(ZSQRE1)                                                00160116
D     C(3)=-C(1)                                                        00160117
D     C(2)=0.0                                                          00160118
D     C(4)=0.0                                                          00160119
  310 IF (ZSQRE2) 303, 304, 304                                         00160120
D 303 C(6)=SQRTF(-ZSQRE2)                                               00160121
D     C(8)=-C(6)                                                        00160122
D     C(5)=0.0                                                          00160123
D     C(7)=0.0                                                          00160124
      GO TO 29                                                          00160125
D 304 C(5)=SQRTF(ZSQRE2)                                                00160126
D     C(7)=-C(5)                                                        00160127
D     C(6)=0.0                                                          00160128
D     C(8)=0.0                                                          00160129
      GO TO 29                                                          00160130
