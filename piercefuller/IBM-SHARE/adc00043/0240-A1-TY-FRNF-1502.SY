       COUNT   30                                                       FRNF0001
       ENTRY   FRN                   FRNF(EXPRESSION)                   FRNF0002
 FRN   FRN                           THIS PROGRAM CHANGES               FRNF0003
       XCA                           ...                                FRNF0004
       CAL     MASK                  TSX $FRN,4                         FRNF0005
       ORA     32767,4               ...                                FRNF0006
       ERA     SXD                             TO                       FRNF0007
       TZE     CAL                   ...                                FRNF0008
       CLA     FRN                   FRN                                FRNF0009
 STO   STO     0,4                   ...                                FRNF0010
       XCA                                    AND                       FRNF0011
       TRA     1,4                   ...                                FRNF0012
 CAL   CAL     MASK                  SXD XR4,4                          FRNF0013
       ORA     1,4                   TSX $FRN,J                         FRNF0014
       ERA     LXD                   LXD XR4,4                          FRNF0015
       TNZ     STO-1                 ...                                FRNF0016
       CLA     FRN                             TO                       FRNF0017
       STO     32767,4               ...                                FRNF0018
       PXA     0,4                   FRN                                FRNF0019
       ERA     MASK                  TRA *+2                            FRNF0020
       ADD     TRA                   LXD XR4,4                          FRNF0021
       TRA     STO                   ...                                FRNF0022
 MASK  DEC     32767                                                    FRNF0023
 SXD   SXD     32767,4                                                  FRNF0024
 LXD   LXD     32767,4                                                  FRNF0025
 TRA   TRA     3                                                        FRNF0026
       END                                                              FRNF0027
