       TMI     ERREX          NEGATIVE ARGUMENT                              019
       STZ     4)-1           ARGUMENT WITHIN 1.0E-6 OF ZERO-SET TO ZERO     020
       STZ     4)                                                            021
       TRA     1,4                                                           022
  CONT ACL     =O201000000000                                                023
       TRA     F                                                             024
  ODD  SUB     4)                                                            025
       ACL     =1.375                                                        026
       TPL     L                                                             027
  IT   ARS     1                                                             028
       SLW     4)-3                                                          029
       CLA     4)                                                            030
       FDP     4)-3                                                          031
       XCA                                                                   032
       ACL     4)-3                                                          033
       ARS     1                                                             034
       STO     4)-3                                                          035
       CLA     4)             SQR...1/2(B1+(A1+A2)/B1)                       036
       FDP     4)-3                                                          037
       XCA                                                                   038
       ACL     4)-3           B1  APRROX. TO X                               039
  F    LRS     1                                                             040
       STO     4)-3                                                          041
       STZ     4)-2           MAKE LSP OF B1 ZERO                            042
       STZ     4)-4                                                          043
       CLA     P5                                                            044
