      SUBROUTINE DVIETA (SC, SRT, MTYPE )                               00120001
D     DIMENSION C(4), RT(3), X(2)                                       00120002
      DIMENSION SRT(3), SC(4)                                           00120003
      DO 666 I=1,4                                                      00120004
  666 C(I)=SC(I)                                                        00120005
      DO 76 L = 5,8                                                     00120006
   76 C(L)=0.0                                                          00120007
      DO 10 L=2,4                                                       00120008
D  10 C(L)=C(L)/C(1)                                                    00120009
D     A=(3.0*C(3)-C(2)**2)/3.0                                          00120010
D     B=(2.0*(C(2))**3-9.0*C(2)*C(3)+27.0*C(4))/27.0                    00120011
D     Q=B**2/4.0+A**3/27.0                                              00120012
      IF (B) 600, 700, 600                                              00120013
  700 IF (ABSF(A)-.001) 12, 12, 300                                     00120014
  600 IF(ABSF(Q)-10.0**(-15)*B**2/4.0) 12, 300, 300                     00120015
  300 IF (Q) 11, 12, 13                                                 00120016
   12 MTYPE=0                                                           00120017
      GO TO 14                                                          00120018
   13 MTYPE=1                                                           00120019
      GO TO 15                                                          00120020
   11 MTYPE=-1                                                          00120021
D     Q  =ABSF(Q)                                                       00120022
D     R  =SQRTF(Q)                                                      00120023
D     PHI1=ATAN2F(R,-B/2.0)/3.0                                         00120024
D     POD =SQRTF(B**2/4.0+Q)                                            00120025
      IF (POD) 73, 70, 73                                               00120026
D  70 X(1)=0.0                                                          00120027
D     X(2)=0.0                                                          00120028
      GO TO 17                                                          00120029
D  73 EXPO=(LOGF(POD))/3.0                                              00120030
D     POD=EXPF(EXPO)                                                    00120031
D     X(1)=    POD*COSF(PHI1)                                           00120032
D     X(2)=    POD*SINF(PHI1)                                           00120033
      GO TO 17                                                          00120034
D  14 POD=-B/2.0                                                        00120035
      IF (POD) 83, 80, 83                                               00120036
D  80 X(1)=0.0                                                          00120037
      GO TO 84                                                          00120038
D  83 EXPO=(LOGF(ABSF(POD)))/3.0                                        00120039
D     X(1)=(POD /ABSF(POD))*EXPF(EXPO)                                  00120040
D  84 RT(1)=2.0*X(1)                                                    00120041
D     RT(2)=-X(1)                                                       00120042
D     RT(3)=RT(2)                                                       00120043
      GO TO 199                                                         00120044
D  15 Q=SQRTF(Q)                                                        00120045
D     CLOD=-B/2.0+Q                                                     00120046
D     PLOD=CLOD-2.0*Q                                                   00120047
D     IF (CLOD) 96, 95, 96                                              00120048
D  95 X(1)=0.0                                                          00120049
      GO TO 97                                                          00120050
D  96 EXPO=(LOGF(ABSF(CLOD)))/3.0                                       00120051
D     X(1)=(CLOD/ABSF(CLOD))*EXPF(EXPO)                                 00120052
D  97 IF (PLOD) 91, 90, 91                                              00120053
D  90 X(2)=0.0                                                          00120054
      GO TO 16                                                          00120055
D  91 EXPO=(LOGF(ABSF(PLOD)))/3.0                                       00120056
D     X(2)=(PLOD/ABSF(PLOD))*EXPF(EXPO)                                 00120057
D  16 RT(1)=X(1)+X(2)-C(2)/3.0                                          00120058
D     RT(2)=-.50*(X(1)+X(2))-C(2)/3.0                                   00120059
D     RT(3)=    .8660254037844385*(X(1)-X(2))                           00120060
      GO TO 500                                                         00120061
D  17 RT(1)=2.0*X(1)                                                    00120062
D     RT(2)=-X(1)+X(2)*1.732050807568877                                00120063
D     RT(3)=-X(1)-X(2)*1.732050807568877                                00120064
  199 DO 200 L=1,3                                                      00120065
D 200 RT(L)=RT(L)-C(2)/3.0                                              00120066
  500 DO 250 L=1,3                                                      00120067
  250 SRT(L)=RT(L)                                                      00120068
      RETURN                                                            00120069
