       DLD     4)-1           (N                                            0046
       XCA                                                                  0047
       DFDP    4)-3             /B                                          0048
       DFAD    4)-3                 + B)                                    0049
       DFMP    4)-5                     *.5                                 0050
       STO     4)                                                           0051
       STQ     4)-1                                                         0052
       LDI     SAVEI                                                        0053
       TRA     1,4                                                          0054
       PZE     2,7,*+1                                                        55
ERREX  LDI     *-1                                                            56
       TSX    *EXIT,4                                                         57
SAVEI  PZE     0                                                              58
 EPS   DEC     1.E-6                                                          59
   P5  DEC     0.5                                                            60
       COMMON -206                                                            61
  4)   COMMON 1                                                               62
       END                                                                    63
*      DOUBLE  PRECISION EXPONENTIAL FUNCTION-DEXP(3                        0001
       LBL     DEX3                                                            2
       COUNT   25                                                           0003
       ENTRY   DEXP(3                                                       0004
       REM     SOLVEX**Y      WHEREX(MSP)=4),X(LSP)=4)-1                    0005
       REM                          Y(MSP)=4)-2,Y(LSP)=4)-3                 0006
DEXP(3 SXA     EXIT,4                                                       0007
       STI     SAVEI                                                        0008
       CLA     4)             X(MSP)                                        0009
       TZE     EXIT                                                         0010
       DLD     4)-3                                                         0011
       STO     SAVEL                                                          12
       STQ     SAVEM                                                          13
       TSX     $DLOG,4        FIND LN OF X                                  0014
       CLA     SAVEM                                                          15
       LDQ     SAVEL                                                          16
       DST     4)-5                                                           17
       DLD     4)-1                                                           18
       XCA                                                                    19
       DFMP    4)-5           Y*LN(X)                                         20
       STO     4)             PUT LN OF ANS IN PSEUDO                         21
       STQ     4)-1           AC, THEN GET ANTI-LOG (EXP) IN PSEUDO AC        22
       TSX     $DEXP,4        AND                                             23
  EXIT AXT     0,4            RETURN TO CALLER                                24
       LDI     SAVEI                                                          25
       TRA     1,4                                                            26
SAVEI  PZE     0                                                              27
SAVEM  PZE                                                                    28
SAVEL  PZE                                                                    29
       COMMON  -206                                                           30
  4)   COMMON  1                                                              31
       END                                                                    32
*      DOUBLE PRECISION MOD FUNCTION                                        0001
       LBL     DMOD                                                         0002
       COUNT   25                                                           0003
       ENTRY   DMOD                                                         0004
DMOD   STI     SAVEI                                                        0005
       DLD     4)-3                                                         0006
       XCA                                                                  0007
       DST     4)-3           ARG2                                          0008
       CLA     UFA                                                          0009
       LDQ     UFA+1          NORMALIZATION EXPONENT                        0010
       DST     4)-5                                                         0011
       DLD     4)-1           ARG1                                          0012
       XCA                                                                  0013
       DST     4)-1                                                         0014
       DFDP    4)-3           ARG1/ARG2                                     0015
       DUFA    4)-5           INTEGRAL VALUE=(ARG1/ARG2)                    0016
       DFAD    4)-5                                                         0017
       DFMP    4)-3           ARG2*(ARG1/ARG2)                              0018
       DST     4)-3                                                         0019
       DLD     4)-1           ARG1                                          0020
       DFSB    4)-3           - ARG2(ARG1/ARG2)                             0021
       STO     4)                                                           0022
       STQ     4)-1                                                         0023
       LDI     SAVEI                                                        0024
       TRA     1,4                                                          0025
SAVEI  PZE     0                                                            0026
  UFA  OCT     266000000000                                                 0027
       OCT     233000000000                                                 0028
       COMMON  -206                                                         0029
  4)   COMMON  1                                                            0030
       END                                                                  0031
*                 DOUBLE PRECISION SINE AND COSINE                          0001
       LBL     DSC                                                             2
       COUNT   260                                                          0003
       ENTRY   DSIN                                                         0004
       ENTRY   DCOS                                                         0005
       REM       DOUBLE PRECISION                                           0006
       REM        SIN-COS ROUTINE                                           0007
 DCOS  STI     SAVEI                                                        0008
       CLA     PI2                                                          0009
       LDQ     PI2+1                                                        0010
       DST     4)-5                 MSP=4)-5,LSP=4)-4                       0011
       DLD     4)-1                                                         0012
       XCA                                                                  0013
       TZE     EXITC          COS(0)=1,SET AT EXIT                          0014
       DFAD    4)-5           COS ANGLE= SIN(ANGLE +90)                     0015
       XCA                    LSP=4)-1,MSP=4)                               0016
       DST     4)-1                                                         0017
       LDI     SAVEI                                                        0018
  DSIN SXA     EXIT,4                                                       0019
       STI     SAVEI                                                        0020
       DLD     4)-1                                                         0021
       XCA                                                                  0022
       TZE     EXIT                                                         0023
       TPL     HEP                                                          0024
       SSP                    WORK ON ABSOLUTE VALUE                        0025
       LRS     0                                                            0026
       DST     4)-1           MSP=4)-1,LSP=4)                               0027
       LDQ     MONE           SET A MINUS FLAG FOR THE EXIT                 0028
       TRA     AD1                                                          0029
 HEP   DST     4)-1           MSP=4)-1,LSP=4)                               0030
       LDQ     ONE            SET A PLUS  FLAG FOR THE EXIT                 0031
  AD1  STQ     MULT2          DIV ARG BY 2PI,THAT IS,TREAT IT MOD 360       0032
       CLA     PI22                                                         0033
       LDQ     PI22+1                                                       0034
       DST     4)-5           MSP=4)-5,LSP=4)-4                             0035
       DLD     4)-1                                                         0036
       DFDP    4)-5                                                         0037
       DST     4)-3           ARG/2 PI    MSP=4)-3,LSP=4)-2                 0038
       LDQ     OC             NEXT THE INTEGRAL PORTION IS ELIMINATED       0039
       TLQ     AD2              TRA PWR GREATER THAN OCT 233 IN MSH         0040
       LDQ     OCC2                                                         0041
       TLQ     AD12                                                         0042
       LDQ     4)-2           LSP                                           0043
       TRA     AD3                                                          0044
 AD12  UFA     OC                                                           0045
       CHS                                                                  0046
       FAD     4)-3                                                         0047
       FAD     4)-2                                                         0048
       TRA     AD3                                                          0049
  AD2  CLA     4)-2           LSP                                           0050
       LDQ     OC2                                                          0051
       TLQ     EXIT                                                         0052
       UFA     OC                                                           0053
       CHS                                                                  0054
       FAD     4)-2                                                         0055
  AD3  DST     4)-1           MSP NOW IN AC,LSP NOW IN MQ                   0056
       CLA     ET                                                           0057
       LDQ     ET+1                                                         0058
       DFMP    4)-1           BEGIN TO SEPARATE INTO QUADRANTS BY DIV BY    0059
       DST     4)-1           PI/4--THIS CONVENIENTLY COMBINES INTO THE     0060
       LDQ     OCC2           SINGLE STEP OF MULT. BY EIGHT                 0061
       TLQ     AD31           (FR*2.PI)/(PI/4)                              0062
       LXA     OCC2,4                                                       0063
       TRA     AD4C                                                         0064
  AD31 UFA     OC             NOW WE TRUNCATE TO A FRAC. AGAIN              0065
       PAX     0,4            FOR THE REMAINING OPERATION OF                0066
       CHS                    QUADRANT REDUCTION.  BUT AT THE SAME TIME     0067
       FAD     4)-1           PRESERVE IR(4) WHICH QUADRANT                 0068
       STO     4)-1           AND THUS WHICH OCTANT WE REDUCED FROM         0069
       PXA     0,4                                                          0070
       LBT                                                                  0071
       TRA     AD4C                                                         0072
       ADD     ONE1           1 3 5 7   MAKE ODD EVEN FOR EASE              0073
       PAX     0,4            2 4 6 8   IN HANDLING SERIES                  0074
       CLA     4)-1                                                         0075
       FAD     MONE                                                         0076
       STO     4)-1                                                         0077
       XCA                                                                  0078
       FAD     4)                                                           0079
       STO     4)             FR,MSP=4)-1,LSP=4)                            0080
 AD4C  CLA     PI4                                                          0081
       LDQ     PI4+1                                                        0082
       DST     4)-3           MSP=4)-3,LSP=4)-2                             0083
       DLD     4)-1                                                         0084
       DFMP    4)-3           FR*(PI/4)                                     0085
       DST     4)-1                     MSP=4)-1,LSP=4)                     0086
       CLA     ONE                                                          0087
       TXL     ADS,4,0        I=0  HERE WE BRANCH DEPENDING ON              0088
       TXL     ADC,4,2        I=2  THE OCTANT THAT WAS REDUCED              0089
       TXH     ADS,4,6        FROM.  IT STARTS THE SERIES TO COMPUTE        0090
       TXH     ADCM,4,4       EITHER THE SINE OR THE COSINE(90-ANGLE)       0091
       CHS                    ONE OF WHICH WE HAVE FROM THE REDUCTION.      0092
  ADS  STO     MULT                                                         0093
       CLA     ONE                                                          0094
       STO     N2                                                           0095
       DLD     4)-1                                                         0096
       DST     4)-5           MSP=4)-1 INTO B1,LSP=4)=B2                    0097
       TZE     EX                                                           0098
       TRA     RTN                                                          0099
 ADCM  CHS                                                                  0100
  ADC  STO     MULT                                                         0101
       STZ     4)-4                                                         0102
       STZ     N2                                                           0103
       CLA     4)-1           MSP=4)-1                                      0104
       LDQ     ONE                                                          0105
       STQ     4)-5                                                         0106
       STQ     4)-1                                                         0107
       LDQ     4)             LSP=4)                                        0108
       STZ     4)                                                           0109
       TZE     EX                                                           0110
  RTN  DST     4)-7           C(AC)=MSP=4)-1 INTO A1,C(MQ)=LSP=4)INTO A2    0111
       DFMP    4)-7           CONTENTS OF AC,MQ SQUARED                     0112
       CHS                                                                  0113
       LRS     0                                                            0114
       DST     4)-7           MSP INTO A1,LSP INTO A2                       0115
       LDQ     4)-1                                                         0116
       FMP     LIMIT          THIS PROVIDES A TEST OF HOW MANY TERMS        0117
       SSP                    MUST BE COMPUTED. THE SERIES REPEATS ,        0118
       STO     TEST           ADDING HIGHER POWER TERMS,UNTIL THIS          0119
       REM                    ACCURACY IS REACHED                           0120
  ADL  CLA     N2                                                           0121
       FAD     ONE                                                          0122
       STO     N                                                            0123
       FAD     ONE                                                          0124
       STO     N2                                                           0125
       LDQ     N2                                                           0126
       FMP     N                                                            0127
       STO     4)-9           NN                                            0128
       STZ     4)-8           NN+1                                          0129
       DLD     4)-7           A                                             0130
       DFDP    4)-9           /NN                                           0131
       DFMP    4)-5           X B                                           0132
       DST     4)-5                                                         0133
       DFAD    4)-1                                                         0134
       DST     4)-1           LSP=4)-1,MSP=4)                               0135
       CLA     4)-5                                                         0136
       SSP                                                                  0137
       LDQ     TEST                                                         0138
       TLQ     ADL                                                          0139
 EX    DLD     4)-1                                                         0140
       STO     4)                                                           0141
       STQ     4)-1                                                         0142
       LDQ     MULT                                                         0143
       FMP     MULT2                                                        0144
       TPL     EXIT                                                         0145
       CLS     4)                                                           0146
       STO     4)                                                           0147
       CLS     4)-1                                                         0148
       STO     4)-1                                                         0149
  EXIT AXT     0,4                                                          0150
       LDI     SAVEI                                                        0151
       TRA     1,4                                                          0152
 EXITC CLA     ONE                                                          0153
       STO     4)                                                           0154
       STZ     4)-1                                                         0155
       LDI     SAVEI                                                        0156
       TRA     1,4                                                          0157
  PI4  OCT     200622077325,145042055060                                    0158
  PI2  OCT     201622077325,146042055060                                    0159
  PI22 OCT     203622077325,150042055060                                    0160
  OCC2 OCT     200000000000                                                 0161
  OC   OCT     233000000000                                                 0162
  OC2  OCT     230000000000                                                 0163
  ET   DEC     8.0                                                          0164
 ETP1  DEC     0.0                                                          0165
  ONE  DEC     1.0                                                          0166
  ONE1 DEC     1                                                            0167
  MONE DEC     -1.0                                                         0168
 LIMIT DEC     1.0E-16                                                      0169
  MULT PZE     0                                                            0170
 MULT2 PZE     0                                                            0171
  N    PZE     0                                                            0172
  N2   PZE     0                                                            0173
  NN   PZE     0                                                            0174
  NNP1 PZE     0                                                            0175
  TEST PZE     0                                                            0176
 D1    PZE     0,0,1                                                        0177
 D2    PZE     0,0,2                                                        0178
 D3    PZE     0,0,3                                                        0179
 D4    PZE     0,0,4                                                        0180
 D5    PZE     0,0,5                                                        0181
 D6    PZE     0,0,6                                                        0182
 D7    PZE     0,0,7                                                        0183
 D8    PZE     0,0,8                                                        0184
 D9    PZE     0,0,9                                                        0185
 D10   PZE     0,0,10                                                       0186
 D11   PZE     0,0,11                                                       0187
 D12   PZE     0,0,12                                                       0188
SAVEI  PZE     0                                                            0189
       COMMON  -206                                                         0190
 4)    COMMON  1                                                            0191
       END                                                                  0192
