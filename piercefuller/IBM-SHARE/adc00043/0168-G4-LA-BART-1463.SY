CBARTT   BARTLETTS TEST OF K VARIANCES                                   BART001
C     CODED NOVEMBER,1961...                                             BART002
C     REFERENCE  DIXON AND MASSEY PAGE 179                               BART003
C     K  =  NUMBER OF VARIANCES TO BE TESTED                             BART004
C     N  =  FREQUENCY OF ITH VARIANCE                                    BART005
C     V  =  ITH VARIANCE                                                 BART006
C     F  =  RESULTING  F  VALUE                                          BART007
C     DF1  = DEGREES OF FREEDOM FOR GREATER  MS (NUMERATOR)              BART008
C     DF2  =  DEGREES OF FREEDOM FOR LESSER  MS (DENOMINATOR)            BART009
      SUBROUTINEBARTT(K,N,V,F,DF1,DF2)                                   BART010
      DIMENSIONN(20),V(20)                                               BART011
      JTOT=0                                                             BART012
      DO12I=1,K                                                          BART013
   12 JTOT=JTOT+N(I)                                                     BART014
      FF=FLOATF(JTOT-K)                                                  BART015
      SP=0.                                                              BART016
      DO18I=1,K                                                          BART017
   18 SP=SP+FLOATF(N(I)-1)*V(I)                                          BART018
      SP=SP/FF                                                           BART019
      CM=FF*LOGF(SP)                                                     BART020
      DO24I=1,K                                                          BART021
   24 CM=CM-FLOATF(N(I)-1)*LOGF(V(I))                                    BART022
      AA=0.                                                              BART023
      DO30I=1,K                                                          BART024
   30 AA=AA+1./FLOATF(N(I)-1)                                            BART025
      A=(1./FLOATF(3*(K-1)))*(AA-1./FF)                                  BART026
      DF1=K-1                                                            BART027
      DF2=(FLOATF(K)+1.)/(A**2)                                          BART028
      B=DF2/(1.-A+(2./DF2))                                              BART029
      F=DF2*CM/(DF1*(B-CM))                                              BART030
      RETURN                                                             BART031
      END                                                                BART032
