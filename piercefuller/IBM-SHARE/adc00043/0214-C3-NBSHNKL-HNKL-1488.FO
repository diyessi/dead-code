*     NBS HNKL                                                          HNKL0000
      SUBROUTINE HANKEL(KIND,ORDR,ORDI,ZR,ZI,HR,HI,MAG)                 HNKL0001
      DIMENSION ASNU(3,4)  ,SUMR(3),SUMI(3)                             HNKL0002
      IF(ZR) 950,1,1                                                    HNKL0003
    1 ASNU(1,1)=.125                                                    HNKL0004
      ASNU(1,2)=-.20833333                                              HNKL0005
      ASNU(2,1)=.0234375                                                HNKL0006
      ASNU(2,2)=-.13368056                                              HNKL0007
      ASNU(2,3)=.11140046                                               HNKL0008
      ASNU(3,1)=.48828125E-2                                            HNKL0009
      ASNU(3,2)=-.059414063                                             HNKL0010
      ASNU(3,3)=.12309751                                               HNKL0011
      ASNU(3,4)=-.068387506                                             HNKL0012
      MAG=0                                                             HNKL0013
      SIG=1.                                                            HNKL0014
      METHOD=1                                                          HNKL0015
      MAP=1                                                             HNKL0016
      OR=ORDR                                                           HNKL0017
      OI=ORDI                                                           HNKL0018
    2 SK=3-2*KIND                                                       HNKL0019
      CALLZDIV(ORDR,ORDI,ZR,ZI,CX,CY)                                   HNKL0020
      CALL ZMPY(CX,CY,CX,CY,QR,QI)                                      HNKL0021
      IF(CY) 5,10,25                                                    HNKL0022
    5 SIG=-1.                                                           HNKL0023
      GO TO 25                                                          HNKL0024
   10 IF(ABSF(CX)-1.) 12,15,15                                          HNKL0025
   12 ALPHA=0.                                                          HNKL0026
      BETA=ACOSF(CX)                                                    HNKL0027
      TR=0.                                                             HNKL0028
      TI=TANF(BETA)                                                     HNKL0029
      GO TO 45                                                          HNKL0030
   15 BETA=0.                                                           HNKL0031
      ALPHA=LOGF(ABSF(CX)+SQRTF(CX*CX-1.))                              HNKL0032
      TR=TANHF(ALPHA)                                                   HNKL0033
      TI=0.                                                             HNKL0034
      MAP=6                                                             HNKL0035
      IF(CX) 20,45,45                                                   HNKL0036
   20 METHOD=2                                                          HNKL0037
      OR=-OR                                                            HNKL0038
      OI=-OI                                                            HNKL0039
      CX=-CX                                                            HNKL0040
      GO TO 45                                                          HNKL0041
   25 CALLZSQRT(QR-1.,QI,SR,SI)                                         HNKL0042
      TX=CX-SIG*SR                                                      HNKL0043
      TY=CY-SIG*SI                                                      HNKL0044
      ALPHA=-.5*LOGF(TX*TX+TY*TY)                                       HNKL0045
      IF(ALPHA*CY) 30,30,35                                             HNKL0046
   30 TX=CX+SIG*SR                                                      HNKL0047
      TY=CY+SIG*SI                                                      HNKL0048
      ALPHA=-.5*LOGF(TX*TX+TY*TY)                                       HNKL0049
   35 E=EXPF(ALPHA)                                                     HNKL0050
      CAL =(E+1./E)*.5                                                  HNKL0051
      SAL=(E-1./E)*.5                                                   HNKL0052
      CBTA=CX/CAL                                                       HNKL0053
      BETA=ACOSF(CBTA)                                                  HNKL0054
      SBTA=SINF(BETA)                                                   HNKL0055
   40 CALLZDIV(CBTA*SAL,SBTA*CAL,CX,CY,TR,TI)                           HNKL0056
   45 CALLZMPY(OR,OI,TR-ALPHA,TI-BETA,ZETR,ZETI)                        HNKL0057
      CALLZDIV(1.,0.,TR,TI,CTR,CTI)                                     HNKL0058
      CALLZMPY(CTR,CTI,CTR,CTI,SQR,SQI)                                 HNKL0059
  125 TEST=1.                                                           HNKL0060
      CALLZDIV(CTR,CTI,OR,OI,FACR,FACI)                                 HNKL0061
      DO 150 I=1,3                                                      HNKL0062
      TCX=SQR                                                           HNKL0063
      TCY=SQI                                                           HNKL0064
      SUMR(I)=ASNU(I,1)                                                 HNKL0065
      SUMI(I)=0.                                                        HNKL0066
      FI=2*I+1                                                          HNKL0067
      DO 130 K=1,I                                                      HNKL0068
      SUMR(I)=SUMR(I)+ASNU(I,K+1)*TCX                                   HNKL0069
      SUMI(I)=SUMI(I)+ASNU(I,K+1)*TCY                                   HNKL0070
  130 CALLZMPY(SQR,SQI,TCX,TCY,TCX,TCY)                                 HNKL0071
      CALLZMPY(SUMR(I),SUMI(I) ,FACR,FACI,SUMR(I),SUMI(I))              HNKL0072
      TESS=SUMR(I)*SUMR(I)+SUMI(I)*SUMI(I)                              HNKL0073
      IF(TEST-TESS) 135,135,145                                         HNKL0074
  135 DO 140 K=I,3                                                      HNKL0075
      SUMR(K)=0.                                                        HNKL0076
  140 SUMI(K)=0.                                                        HNKL0077
      GO TO 152                                                         HNKL0078
  145 TEST=TESS                                                         HNKL0079
      CALLZDIV(FI*CTR,FI*CTI,OR,OI,TX,TY)                               HNKL0080
  150 CALLZMPY(TX,TY,FACR,FACI,FACR,FACI)                               HNKL0081
  152 DO 46 K=1,3                                                       HNKL0082
      KT=4-K                                                            HNKL0083
      TESS=SUMR(KT)*SUMR(KT)+SUMI(KT)*SUMI(KT)                          HNKL0084
      IF(TESS) 46,46,47                                                 HNKL0085
   46 TESS=1.                                                           HNKL0086
   47 TEST=1.E-4/(ZR*ZR+ZI*ZI)                                          HNKL0087
      IF(TEST-TESS) 250,60,60                                           HNKL0088
   60 TEST=1.-BETA*CBTA/SBTA-ALPHA*SAL/CAL                              HNKL0089
      IF(TEST) 85,65,65                                                 HNKL0090
   65 IF(CX) 70,155,155                                                 HNKL0091
   70 IF(TEST+3.1415927  *CBTA/SBTA) 75,155,155                         HNKL0092
   75 IF(SK*CY) 80,155,155                                              HNKL0093
   80 MAP=3                                                             HNKL0094
      GO TO 155                                                         HNKL0095
   85 IF(CX) 90,95,95                                                   HNKL0096
   90 METHOD=2                                                          HNKL0097
      OR=-ORDR                                                          HNKL0098
      OI=-ORDI                                                          HNKL0099
      CX=-CX                                                            HNKL0100
      CY=-CY                                                            HNKL0101
      SIG=-SIG                                                          HNKL0102
      ALPHA=-ALPHA                                                      HNKL0103
      BETA=3.1415927  -BETA                                             HNKL0104
      SAL=-SAL                                                          HNKL0105
      CBTA=-CBTA                                                        HNKL0106
      GO TO 100                                                         HNKL0107
   95 IF(TEST+3.1415927  *CBTA/SBTA) 100,115,115                        HNKL0108
  100 IF(SK*CY) 105,110,110                                             HNKL0109
  105 MAP=5                                                             HNKL0110
      GO TO 155                                                         HNKL0111
  110 MAP=4                                                             HNKL0112
      GO TO 155                                                         HNKL0113
  115 IF(SK*CY) 155,120,120                                             HNKL0114
  120 MAP=2                                                             HNKL0115
  155 CALLZEXP(SK*ZETR,SK*(ZETI-.78539816),C,S,MAG)                     HNKL0116
      CALLZMPY(1.57079633  *OR,1.57079633  *OI,TI,-TR,BX,BY)            HNKL0117
      CALLZSQRT(BX,BY,BX,BY)                                            HNKL0118
      CALLZDIV(C,S,BX,BY,DX,DY)                                         HNKL0119
      CALLZMPY(DX,DY,1.+SK*SUMR(1)+SUMR(2)+SK*SUMR(3),                  HNKL0120
     1SK*SUMI(1)+SUMI(2)+SK*SUMI(3),HR,HI)                              HNKL0121
      GO TO (200,300,300,300,300,300),MAP                               HNKL0122
  200 GO TO (910,900),METHOD                                            HNKL0123
  250 U=0.                                                              HNKL0124
      SIP=-1.                                                           HNKL0125
      IF(MAP-6) 254,251,251                                             HNKL0126
  251 SIP=SK                                                            HNKL0127
      U=SK                                                              HNKL0128
  254 CALLZMPY(0.,SIP,ZETR,ZETI,ARGR,ARGI)                              HNKL0129
      IF(ARGR) 255,260,260                                              HNKL0130
  255 IF(CY*ARGI) 260,260,256                                           HNKL0131
  256 U=-ABSF(CY)/CY                                                    HNKL0132
  260 CALLZDIV(ALPHA,BETA,TR,TI,TR,TI)                                  HNKL0133
      CALLZSQRT(1.-TR,-TI,TR,TI)                                        HNKL0134
      CALLZMPY(TR,TI,.86602540 ,SK*.5,SR,SI)                            HNKL0135
      CALL HANK(KIND,.33333333   ,U,ARGR,ARGI,HR,HI,MAG)                HNKL0136
      CALLZMPY(SR,SI,HR,HI,HR,HI)                                       HNKL0137
      IF(MAP-6) 200,275,275                                             HNKL0138
  275 HR=SK*HR                                                          HNKL0139
      HI=SK*HI                                                          HNKL0140
      GO TO 200                                                         HNKL0141
  300 CALLZMPY(C,S,BX,BY,DX,DY)                                         HNKL0142
      CALLZDIV(1.-SK*SUMR(1)+SUMR(2)-SK*SUMR(3),-SK*SUMI(1)+SUMI(2)-    HNKL0143
     1SK*SUMI(3),DX,DY,A,B)                                             HNKL0144
      GO TO (200,305,400,500,500,700),MAP                               HNKL0145
  305 EA=1.                                                             HNKL0146
      EB=1.                                                             HNKL0147
      IF(MAG) 306,310,308                                               HNKL0148
  306 EA=2*MAG                                                          HNKL0149
      EA=EXPF(EA)                                                       HNKL0150
      MAG=-MAG                                                          HNKL0151
      GO TO 310                                                         HNKL0152
  308 EB=-2*MAG                                                         HNKL0153
      EB=EXPF(EB)                                                       HNKL0154
  310 HR=EA*HR-EB*A                                                     HNKL0155
      HI=EA*HI-EB*B                                                     HNKL0156
      GO TO 200                                                         HNKL0157
  400 CALLZEXP( SK*OI*6.2831853,-SK*OR*6.2831853,EXR,EXI,MTG)           HNKL0158
      CALLZMPY(EXR,EXI,A,B,A,B)                                         HNKL0159
      MTG=MTG-MAG                                                       HNKL0160
  403 EA=1.                                                             HNKL0161
      EB=1.                                                             HNKL0162
      IF(MAG-MTG)405,405,410                                            HNKL0163
  405 EA=MAG-MTG                                                        HNKL0164
      EA=EXPF(EA)                                                       HNKL0165
      MAG=MTG                                                           HNKL0166
      GO TO 310                                                         HNKL0167
  410 EB=MTG-MAG                                                        HNKL0168
      EB=EXPF(EB)                                                       HNKL0169
      GO TO 310                                                         HNKL0170
  500 M=((1.-ALPHA*SAL/CAL)*SBTA/CBTA+BETA)/3.1415927                   HNKL0171
      SMK=SIGNF(1.,CY)                                                  HNKL0172
      EM=M                                                              HNKL0173
      CALLZEXP(-SMK*3.1415927*OI*(EM+1.),SMK*3.1415927*OR*(EM+1.),EXR,EXHNKL0174
     1I,MEX)                                                            HNKL0175
      IF(OI) 515,501,515                                                HNKL0176
  501 MOR=OR                                                            HNKL0177
      TOR=MOR                                                           HNKL0178
      IF(ABSF(TOR-OR)-.5E-8) 502,502,515                                HNKL0179
  502 IF(XMODF(MOR,2)) 504,503,504                                      HNKL0180
  503 SOR=1.                                                            HNKL0181
      GO TO 505                                                         HNKL0182
  504 SOR=-1.                                                           HNKL0183
  505 ROA=1.                                                            HNKL0184
      ROB=2.*SOR                                                        HNKL0185
      MEX=0                                                             HNKL0186
      IF(MOR-2) 506,507,508                                             HNKL0187
  506 ROC=ROA                                                           HNKL0188
      GO TO 510                                                         HNKL0189
  507 ROC=ROB                                                           HNKL0190
      GO TO 510                                                         HNKL0191
  508 DO 509 I=3,M                                                      HNKL0192
      ROC=2.*SOR*ROB-ROA                                                HNKL0193
      ROA=ROB                                                           HNKL0194
  509 ROB=ROC                                                           HNKL0195
  510 ROI=0.                                                            HNKL0196
      GO TO 520                                                         HNKL0197
  515 CALLZSIN(EM*OR*3.1415927,EM*OI*3.1415927,SOR,SOI,MSO)             HNKL0198
      CALLZSIN(OR*3.1415927,OI*3.1415927,DOR,DOI,MDO)                   HNKL0199
      CALLZDIV(SOR,SOI,DOR,DOI,SOR,SOI)                                 HNKL0200
      CALLZMPY(SOR,SOI,EXR,EXI,ROC,ROI)                                 HNKL0201
      MEX=MEX+MSO-MDO                                                   HNKL0202
  520 GO TO (200,305,400,550,600,700),MAP                               HNKL0203
  550 IF(XABSF(MEX)-18) 560,560,552                                     HNKL0204
  552 IF(MEX) 553,560,565                                               HNKL0205
  553 ROC=1.                                                            HNKL0206
      ROI=0.                                                            HNKL0207
      MEX=0                                                             HNKL0208
      GO TO 565                                                         HNKL0209
  560 EMA=2.7182818**MEX                                                HNKL0210
      ROC=1.+EMA*ROC                                                    HNKL0211
      ROI=EMA*ROI                                                       HNKL0212
      MEX=0                                                             HNKL0213
  565 CALLZMPY(HR,HI,ROC,ROI,HR,HI)                                     HNKL0214
      EA=1.                                                             HNKL0215
      EB=1.                                                             HNKL0216
      IF(MAG+MEX) 570,570,575                                           HNKL0217
  570 EA=2.7182818**(2*MAG+MEX )                                        HNKL0218
      MAG=-MAG                                                          HNKL0219
      GO TO 310                                                         HNKL0220
  575 EB=2.7182818**(-2*MAG-MEX)                                        HNKL0221
      MAG=MAG+MEX                                                       HNKL0222
      GO TO 310                                                         HNKL0223
  600 CALLZMPY(ROC,ROI,-SK*A,-SK*B,A,B)                                 HNKL0224
      MEX=MEX-MAG                                                       HNKL0225
      EA=1.                                                             HNKL0226
      EB=1.                                                             HNKL0227
      IF(MAG-MEX) 610,310,620                                           HNKL0228
  610 EA=2.7182818**(MAG-MEX)                                           HNKL0229
      MAG=MEX                                                           HNKL0230
      GO TO 310                                                         HNKL0231
  620 EB=2.7182818**(MEX-MAG)                                           HNKL0232
      GO TO 310                                                         HNKL0233
  700 GO TO (705,710),KIND                                              HNKL0234
  705 HR=.5*HR                                                          HNKL0235
      HI=.5*HI                                                          HNKL0236
      GO TO 305                                                         HNKL0237
  710 A=-.5*A                                                           HNKL0238
      B=-.5*B                                                           HNKL0239
      GO TO 305                                                         HNKL0240
  900 CALLZEXP(3.1415927*ORDI,-3.1415927*ORDR,A,B,MA)                   HNKL0241
      CALLZMPY(HR,HI,A,B,HR,HI)                                         HNKL0242
      MAG=MAG+MA                                                        HNKL0243
  910 RETURN                                                            HNKL0244
  950 WRITE OUTPUT TAPE 6,951                                           HNKL0245
  951 FORMAT(46H HANKEL DOES NOT ACCEPT NEGATIVE RE(ARGUMENT).)         HNKL0246
      CALL EXIT                                                         HNKL0247
      END                                                               HNKL0248
