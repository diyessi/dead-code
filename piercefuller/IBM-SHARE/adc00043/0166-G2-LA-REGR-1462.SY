CREGRETM  THIS COMPUTES R                                               REGR 000
      DIMENSION          X( 5,700),Y( 5,700),N(20),XTOT(20),HEADER(12), REGR 001
     1YTOT(20),XYTOT(20),SUMX2(20),SUMY2(20),SUMCP(20),XBAR(20),YBAR(20)REGR 002
     2,SUMDX( 5,700),SUMDY( 5,700),SUMDC( 5,700),R2(20),R(20),RP1(20),RMREGR 003
     31(20),Z(20),VARX2(20),VARY2(20),                                  REGR 004
     4UL(20),VL(20),ULR(20),VLR(20),STD(20),A(20),                      REGR 005
     5B(20),F(20),S2(20),SD(20),AP(20),FMT(12),HEAD(5,12)               REGR 006
    1 FORMAT(1H1)                                                       REGR 007
   67 FORMAT(24I3)                                                      REGR 008
   68 FORMAT(12A6)                                                      REGR 009
 1234 DO79I=1,5                                                         REGR 010
      READINPUTTAPE10,68,(HEAD(I,J),J=1,12)                             REGR 011
      READINPUTTAPE10,67,M,N(I),INA                                     REGR 012
      READINPUTTAPE10,68,FMT                                            REGR 013
      L=N(I)                                                            REGR 014
      GOTO(70,73),INA                                                   REGR 015
   70 READINPUTTAPE10,FMT,(Y(I,J),X(I,J),J=1,L)                         REGR 016
      GOTO74                                                            REGR 017
   73 READINPUTTAPE10,FMT,(Y(I,J),J=1,L)                                REGR 018
      READINPUTTAPE10,68,FMT                                            REGR 019
      READINPUTTAPE10,FMT,(X(I,J),J=1,L)                                REGR 020
   74 IF(M-I)79,12,79                                                   REGR 021
   79 CONTINUE                                                          REGR 022
   12 VARP=0.0                                                          REGR 023
      DF=0.0                                                            REGR 024
      CP=0.0                                                            REGR 025
      XD=0.0                                                            REGR 026
      B1=0.0                                                            REGR 027
      BIN=0.0                                                           REGR 028
      BID=0.0                                                           REGR 029
      SP=0.0                                                            REGR 030
      XBA=0.0                                                           REGR 031
      YBA=0.0                                                           REGR 032
      TOAD=0.0                                                          REGR 033
      TL=0.0                                                            REGR 034
      DO 8338     I=1,5                                                 REGR 035
      XTOT(I)=0.0                                                       REGR 036
      YTOT(I)=0.0                                                       REGR 037
      XYTOT(I)=0.0                                                      REGR 038
      SUMX2(I)=0.0                                                      REGR 039
      SUMY2(I)=0.0                                                      REGR 040
 8338 SUMCP(I)=0.0                                                      REGR 041
      DO9 I=1,M                                                         REGR 042
      L=N(I)                                                            REGR 043
      DO9 J=1,L                                                         REGR 044
      XTOT(I)=X(I,J)+XTOT(I)                                            REGR 045
      YTOT(I)=Y(I,J)+YTOT(I)                                            REGR 046
    9 XYTOT(I)=(X(I,J))*(Y(I,J))+XYTOT(I)                               REGR 047
      DO10I=1,M                                                         REGR 048
      Q=N(I)                                                            REGR 049
      XBAR(I)=XTOT(I)/Q                                                 REGR 050
   10 YBAR(I)=YTOT(I)/Q                                                 REGR 051
      DO39 I=1,M                                                        REGR 052
      L=N(I)                                                            REGR 053
      DO39 J=1,L                                                        REGR 054
      SUMDX(I,J)=(X(I,J)-XBAR(I))                                       REGR 055
      SUMDY(I,J)=(Y(I,J)-YBAR(I))                                       REGR 056
      SUMDC(I,J)=(X(I,J)-XBAR(I))*(Y(I,J)-YBAR(I))                      REGR 057
      SUMX2(I)=(SUMDX(I,J))**2+SUMX2(I)                                 REGR 058
      SUMY2(I)=(SUMDY(I,J))**2+SUMY2(I)                                 REGR 059
   39 SUMCP(I)=SUMDC(I,J)+SUMCP(I)                                      REGR 060
      T=1.96                                                            REGR 061
      DO99I=1,M                                                         REGR 062
      Q=N(I)                                                            REGR 063
      B(I)=SUMCP(I)/SUMX2(I)                                            REGR 064
      F(I)=Q-2.0                                                        REGR 065
      SD(I)=SUMY2(I)-(B(I)*SUMCP(I))                                    REGR 066
      S2(I)=SD(I)/F(I)                                                  REGR 067
      VARP=SD(I)+VARP                                                   REGR 068
      DF=F(I)+DF                                                        REGR 069
      CP=SUMCP(I)+CP                                                    REGR 070
      XD=SUMX2(I)+XD                                                    REGR 071
      XBA=XBAR(I)+XBA                                                   REGR 072
      YBA=YBAR(I)+YBA                                                   REGR 073
      R2(I)=(SUMCP(I))**2/((SUMX2(I))*(SUMY2(I)))                       REGR 074
      R(I)=SQRTF(R2(I))                                                 REGR 075
      RP1(I)=R(I)+1.0                                                   REGR 076
      RM1(I)=1.0-R(I)                                                   REGR 077
      Z(I)=.5*(LOGF(RP1(I))-LOGF(RM1(I)))                               REGR 078
      KL=N(I)-3                                                         REGR 079
      P=KL                                                              REGR 080
      STD(I)=1.0/P                                                      REGR 081
      UL(I)=Z(I)+T*SQRTF(STD(I))                                        REGR 082
      VL(I)=Z(I)-T*SQRTF(STD(I))                                        REGR 083
      ULR(I)=    TANHF(UL(I))                                           REGR 084
   99 VLR(I)= TANHF(VL(I))                                              REGR 085
      VARPOL=VARP/DF                                                    REGR 086
      BBAR=CP/XD                                                        REGR 087
      TM=M                                                              REGR 088
      YBAM=YBA/TM                                                       REGR 089
      XBAM=XBA/TM                                                       REGR 090
      DO85I=1,M                                                         REGR 091
      SP=(((B(I)-BBAR)**2)*SUMX2(I))+SP                                 REGR 092
   85 A(I)=YBAR(I)-B(I)*XBAR(I)                                         REGR 093
      VAR1=VARPOL                                                       REGR 094
      VAR2=SP/(TM-1.0)                                                  REGR 095
      DO86I=1,M                                                         REGR 096
      Q=N(I)                                                            REGR 097
      BIN=Q   *(XBAR(I)-XBAM)*(YBAR(I))                                 REGR 098
     1+BIN                                                              REGR 099
   86 BID=Q   *((XBAR(I)-XBAM)**2)+BID                                  REGR 100
      BHAT=BIN/BID                                                      REGR 101
      DO87I=1,M                                                         REGR 102
      Q=N(I)                                                            REGR 103
      TL=Q+TL                                                           REGR 104
   87 TOAD=Q*((YBAR(I)-YBAM-(BHAT*(XBAR(I)-XBAM)))**2)+TOAD             REGR 105
      VAR3=TOAD/(TM-2.0)                                                REGR 106
      VAR0=VAR1+VAR2+VAR3                                               REGR 107
      STD0=SQRTF(VAR0)                                                  REGR 108
      COMBO=(1.0/BID)+(1.0/XD)                                          REGR 109
      COMBOT=SQRTF(COMBO)                                               REGR 110
      DENO=STD0*COMBOT                                                  REGR 111
      T=(BHAT-BBAR)/DENO                                                REGR 112
      BTOT=(BBAR*XD+BHAT*BID)/(XD+BID)                                  REGR 113
      VAR4=(BHAT-BBAR)**2/COMBO                                         REGR 114
      TT=2.0*TM                                                         REGR 115
      VAR=((TL-TT)*VAR1+(TM-1.0)*VAR2+(TM-2.0)                          REGR 116
     1*VAR3+VAR4 )/(TL-2.0)                                             REGR 117
      DO75I=1,M                                                         REGR 118
      L=N(I)                                                            REGR 119
   49 WRITEOUTPUTTAPE9,1                                                REGR 120
   50 WRITEOUTPUTTAPE9,68,(HEAD(I,J),J=1,12)                            REGR 121
      WRITE OUTPUT TAPE9,82,(X(I,J),Y(I,J),J=1,L)                       REGR 122
      WRITE OUTPUT TAPE 9, 51 ,X BAR (I)                                REGR 123
   51 FORMAT(1H0//18H THE MEAN OF X IS 1PE14.7)                         REGR 124
      QDQ=N(I)-1                                                        REGR 125
      VARX2(I)=SUMX2(I)/QDQ                                             REGR 126
      VARY2(I)=SUMY2(I)/QDQ                                             REGR 127
      WRITE OUTPUT TAPE 9, 52 , VARX2(I)                                REGR 128
   52 FORMAT(22H0THE VARIANCE OF X IS 1PE14.7)                          REGR 129
      WRITE OUTPUT TAPE 9, 53, VARY2(I)                                 REGR 130
   53 FORMAT(22H0THE VARIANCE OF Y IS 1PE14.7)                          REGR 131
      WRITE OUTPUT TAPE9, 54, YBAR(I)                                   REGR 132
   54 FORMAT(18H0THE MEAN OF Y IS 1PE14.7)                              REGR 133
      WRITE OUTPUT TAPE 9, 55, L                                        REGR 134
   55 FORMAT(31H0THE NUMBER OF OBSERVATIONS IS I3)                      REGR 135
   17 FORMAT(32H0THE CORRELATION COEFFICIENT IS E14.7)                  REGR 136
   82 FORMAT(108H0          X                 Y                 X       REGR 137
     1          Y                 X                 Y      //(1P6E18.7) REGR 138
     2//)                                                               REGR 139
      WRITE OUTPUT TAPE 9,17,R(I)                                       REGR 140
      WRITE OUTPUT TAPE 9,20,ULR(I)                                     REGR 141
   20 FORMAT(24H0THE UPPER .95 LIMIT IS E14.7)                          REGR 142
   30 FORMAT(24H0THE LOWER .95 LIMIT IS E14.7//)                        REGR 143
   75 WRITE OUTPUT TAPE 9,30,VLR(I)                                     REGR 144
      WRITEOUTPUTTAPE9,424                                              REGR 145
  424 FORMAT(27H1    STRAIGHT LINE ANALYSIS///)                         REGR 146
      DO426I=1,M                                                        REGR 147
  430 WRITEOUTPUTTAPE9,68,(HEAD(I,J),J=1,12)                            REGR 148
  426 WRITE OUTPUT TAPE 9,425,(I,A(I),B(I))                             REGR 149
  425 FORMAT(28H0INDIVIDUAL REGRESSION LINE I2,                         REGR 150
     116H WITH INTERCEPT 1PE16.7,11H AND SLOPE 1PE16.7///)              REGR 151
  435 IF(M-1)1234,1234,437                                              REGR 152
  437 CALLBARTT(M,N,S2,FBART,DF1,DF2)                                   REGR 153
      WRITE OUTPUT TAPE9,7777                                           REGR 154
 7777 FORMAT(26H0RESULTS OF BARTLETTS TEST)                             REGR 155
  439 WRITEOUTPUTTAPE9,427,FBART,DF1,DF2                                REGR 156
  427 FORMAT(3H0F=1PE16.7,6H WITH 0PF9.2,5H AND F9.2,                   REGR 157
     119H DEGREES OF FREEDOM//)                                         REGR 158
      DO443I=1,M                                                        REGR 159
  500 AP(I)=YBAR(I)-((BBAR)*XBAR(I))                                    REGR 160
  444 FORMAT(26H0PARALLEL REGRESSION LINE I3,                           REGR 161
     115H HAS INTERCEPT 1PE16.7,11H AND SLOPE 1PE16.7/)                 REGR 162
  443 WRITE OUTPUT TAPE9,444,(I,AP(I),BBAR)                             REGR 163
      ABAM=YBAM-BHAT*XBAM                                               REGR 164
      WRITE OUTPUT TAPE 9,445,ABAM,BHAT                                 REGR 165
  445 FORMAT(44H0THE REGRESSION LINE OF MEANS HAS INTERCEPT 1PE16.7,    REGR 166
     111H AND SLOPE 1PE16.7/)                                           REGR 167
      ABAT=YBAM-(BTOT*XBAM)                                             REGR 168
      WRITEOUTPUTTAPE9,446,ABAT,BTOT                                    REGR 169
  446 FORMAT(72H0THE REGRESSION LINE FOR THE TOTAL NUMBER OF OBSERVATIONREGR 170
     1S HAS INTERCEPT 1PE16.7,11H AND SLOPE 1PE16.7///)                 REGR 171
      WRITE OUTPUT TAPE9,447                                            REGR 172
  447 FORMAT(52H0PARTITIONING OF VARIANCES ABOUT THE REGRESSION LINE//) REGR 173
      WRITE OUTPUT TAPE9,448                                            REGR 174
  448 FORMAT(43H0       VARIATION          DF     VARIANCES)            REGR 175
      WRITE OUTPUT TAPE9,449,VAR4                                       REGR 176
  449 FORMAT(31H0BETWEEN BHAT AND BBAR     1    1PE16.7)                REGR 177
      ML2=M-2                                                           REGR 178
      MLT=TL                                                            REGR 179
      WRITE OUTPUT TAPE9,450,ML2,VAR3                                   REGR 180
  450 FORMAT(25H0ABOUT LINE FOR MEANS    I3,3H   1PE16.7)               REGR 181
      MIR=MLT-2*M                                                       REGR 182
      ML1=M-1                                                           REGR 183
      WRITE OUTPUT TAPE9,451,ML1,VAR2                                   REGR 184
  451 FORMAT(25H0BETWEEN SLOPES          I3,3H   1PE16.7)               REGR 185
      WRITE OUTPUT TAPE9,452,MIR,VAR1                                   REGR 186
  452 FORMAT(25H0ABOUT THE M LINES       I3,3H   1PE16.7)               REGR 187
      MTR=MLT-2                                                         REGR 188
      WRITE OUTPUT TAPE9,453,MTR,VAR                                    REGR 189
  453 FORMAT(25H0ABOUT LINE FOR TOTAL    I3,3H   1PE16.7)               REGR 190
      GO TO 1234                                                        REGR 191
      END                                                               REGR 192
