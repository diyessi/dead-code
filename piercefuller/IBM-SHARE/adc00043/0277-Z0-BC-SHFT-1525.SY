*     LABEL                                                                     
*     FAP                                                               SHIFT001
*SHIFT                                                                          
       COUNT   70                                                       SHIFT002
       PMC     ON                                                       SHIFT004
       PCC     ON                                                       SHIFT005
SHIFT  MACRO   A,B,OP1,DELETE,OP2,OP3,D,C                               SHIFT006
A      CLA*    B,4                                                      SHIFT007
       ARS     18                                                       SHIFT008
       STA     C                                                        SHIFT009
       OP1'*   1,4                                                      SHIFT010
       IFF     1,INSERT,DELETE                                          SHIFT011
       LDQ*    2,4                                                      SHIFT012
C      OP2     **                                                       SHIFT013
       OP3'*   D,4                                                      SHIFT014
       IFF     1,INSERT,DELETE                                          SHIFT015
       STQ*    4,4                                                      SHIFT016
       TRA     B+1,4                                                    SHIFT017
SHIFT  END                                                              SHIFT018
       ENTRY   ALS                                                      SHIFT019
       ENTRY   ARS                                                      SHIFT020
       ENTRY   LLS                                                      SHIFT021
       ENTRY   LRS                                                      SHIFT022
       ENTRY   LGL                                                      SHIFT023
       ENTRY   LGR                                                      SHIFT024
       ENTRY   RQL                                                      SHIFT025
       ENTRY   ROTATE                                                   SHIFT026
       SHIFT   ALS,3,CLA,DELETE,ALS,STO,2                               SHIFT027
       SHIFT   ARS,3,CLA,DELETE,ARS,STO,2                               SHIFT028
       SHIFT   LLS,5,CLA,INSERT,LLS,STO,3                               SHIFT029
       SHIFT   LRS,5,CLA,INSERT,LRS,STO,3                               SHIFT030
       SHIFT   LGL,5,CAL,INSERT,LGL,SLW,3                               SHIFT031
       SHIFT   LGR,5,CAL,INSERT,LGR,SLW,3                               SHIFT032
       SHIFT   RQL,3,LDQ,DELETE,RQL,STQ,2                               SHIFT033
ROTATE CAL*    5,4                                                      SHIFT034
       SXA     XR2,2                                                    SHIFT035
       PDX     ,2                                                       SHIFT036
       CAL*    1,4                                                      SHIFT037
       LDQ*    2,4                                                      SHIFT038
       TNX     *+3,2,35                                                 SHIFT039
       XCL                                                              SHIFT040
       TXI     *-2,2,-1                                                 SHIFT041
       SLW     =1                                                       SHIFT042
       SXA     S1,2                                                     SHIFT043
       SXA     S2,2                                                     SHIFT044
XR2    AXT     **,2                                                     SHIFT045
S1     LGL     **                                                       SHIFT046
       SLW*    3,4                                                      SHIFT047
       STQ     =0                                                       SHIFT048
       LDQ     =1                                                       SHIFT049
       ZAC                                                              SHIFT050
S2     LGL     **                                                       SHIFT051
       ACL     =0                                                       SHIFT052
       SLW*    4,4                                                      SHIFT053
       TRA     6,4                                                      SHIFT054
       END                                                              SHIFT055
