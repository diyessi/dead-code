*      JOB     T04905,NICOLE SIMON       SI-MMPY                                
*      FAP                                                                      
* SI MMPY ... FLOATING POINT MATRIX MULTIPLICATION ... NICOLE SIMON     MMPY0010
*   GENERAL (NXM) * (NXK) MATRIX MULTIPLICATION                         MMPY0020
*   H. WADZINSKI, N. SIMON                                              MMPY0030
       REM  TO MULTIPLY A(IXK) * B(KXJ) = C(IXJ)                        MMPY0040
       REM  CALL MATMPY (A,I,K,B,J,C,I1,I2,I3)                          MMPY0050
       REM    WHERE A(IXK) IS THE I1-ST ARRAY IN A(IXKXI1)              MMPY0060
       REM      AND B(KXJ) IS THE I2-ND ARRAY IN B(IXKXI2)              MMPY0070
       REM      AND C(IXJ) IS THE I3-RD ARRAY IN C(IXKXI3)              MMPY0080
       REM     USE MAXIMUM DIMENSION WHEN MULTIPLYING SUBMATRICES       MMPY0090
       REM        IF G(4X4) IS A SUBMATRIX OF A(5X6) AND                MMPY0100
       REM           H(4X3) IS A SUBMATRIX OF B(6X8) ...                MMPY0110
       REM             CALL MATMPY (G,5,6,H,8,P,1,1,1)                  MMPY0120
       REM        TO FORM PRODUCT OF G WITH H                           MMPY0130
       ENTRY   MATMPY                                                   MMPY0140
MATMPY SXA     HOLD1,1                                                  MMPY0150
       SXA     HOLD2,2                                                  MMPY0160
       SXA     HOLD4,4                                                  MMPY0170
 ADDRC CLA*    2,4         I                                            MMPY0180
       STD     D)I                                            D)I       MMPY0190
       XCA                                                              MMPY0200
       MPY*    5,4         I*J                                          MMPY0210
       ARS     1                                                        MMPY0220
       STA     SET4                                           SET4      MMPY0230
       STO     A)IJ                                                     MMPY0240
       XCA                 I*J IN ADDR OF MQ                            MMPY0250
       MPY*    9,4         I*J*I3 IN DECR OF MQ                         MMPY0260
       XCA                                                              MMPY0270
       ARS     18                                                       MMPY0280
       SUB     A)IJ        I*J*I3-I*J                                   MMPY0290
       SSM                                                              MMPY0300
       ADD     6,4         LOC OF C(1,1,I3)                             MMPY0310
       ADD     A)1                                                      MMPY0320
       STA     SETC                                           SETC      MMPY0330
       STA     MPY+6                                                    MMPY0340
       STA     MPY+7                                                    MMPY0350
       STA     TAIL                                                     MMPY0360
       STA     TAIL+3                                                   MMPY0370
       REM                                                              MMPY0380
 ADDRB CLA*    3,4         K                                            MMPY0390
       STD     D)K                                            D)K       MMPY0400
       XCA                                                              MMPY0410
       MPY*    5,4         K*J                                          MMPY0420
       ARS     1                                                        MMPY0430
       STA     SET2                                           SET2      MMPY0440
       STO     A)IJ        A)IJ=K*J                                     MMPY0450
       XCA                 K*J IN ADDR OF MQ                            MMPY0460
       MPY*    8,4         K*J*I2 IN DECR OF MQ                         MMPY0470
       XCA                                                              MMPY0480
       ARS     18                                                       MMPY0490
       SUB     A)IJ        K*J*I2-K*J                                   MMPY0500
       SSM                                                              MMPY0510
       ADD     4,4         LOC OF B(1,1,I2)                             MMPY0520
       ADD     A)1         LOC+1 OF B(1,1,I2)                           MMPY0530
       STA     MPY+1                                          MPY+1     MMPY0540
       STA     MPY+4                                                    MMPY0550
       REM                                                              MMPY0560
 ADDRA LDQ*    2,4                                                      MMPY0570
       MPY*    3,4         I*K                                          MMPY0580
       ARS     1                                                        MMPY0590
       STA     SET1                                           SET1      MMPY0600
       STO     A)IJ        A)IJ=I*K                                     MMPY0610
       XCA                 I*K IN ADDR OF MQ                            MMPY0620
       MPY*    7,4         I*K*I1 IN DECR OF MQ                         MMPY0630
       XCA                                                              MMPY0640
       ARS     18                                                       MMPY0650
       SUB     A)IJ        I*K*I1-I*K                                   MMPY0660
       SSM                                                              MMPY0670
       ADD     1,4         LOC OF A(1,1,I1)                             MMPY0680
       ADD     A)1         LOC+1 OF A(1,1,I1)                           MMPY0690
       STA     MPY                                            MPY       MMPY0700
       STA     MPY+3                                                    MMPY0710
       LXA     A)IJ,1                                                   MMPY0720
       PXD     ,1          I*K                                          MMPY0730
       SUB*    2,4         I*K-I                                        MMPY0740
       STD     D)RS1                                          D)RS1     MMPY0750
 SET4  AXT     **,4        ** = I*J        INDEX FOR C                  MMPY0760
 SET2  AXT     **,2        ** = K*J,2      INDEX FOR B                  MMPY0770
 SET1  AXT     **,1        ** = I*K        INDEX FOR A                  MMPY0780
 SETC  STZ     **,4        ** = C+1                                     MMPY0790
       STZ     C2                                                       MMPY0800
 MPY   ZET     **,1        ** = A+1    TEST FOR                         MMPY0810
       NZT     **,2        ** = B+1      ZERO                           MMPY0820
       TXI     D)I,2,-1                    ELEMENTS                     MMPY0830
       LDQ     **,1        ** = A+1                                     MMPY0840
       FMP     **,2        ** = B+1                                     MMPY0850
       STQ     HOLD                                                     MMPY0860
       FAD     **,4        ** = C+1                                     MMPY0870
       STO     **,4        ** = C+1                                     MMPY0880
       XCA                                                              MMPY0890
       FAD     HOLD                                                     MMPY0900
       FAD     C2                                                       MMPY0910
       STO     C2                                                       MMPY0920
       TXI     *+1,2,-1                                                 MMPY0930
 D)I   TIX     MPY,1,**    ** = I                                       MMPY0940
 TAIL  CLA     **,4        ** = C+1                                     MMPY0950
       FAD     C2                                                       MMPY0960
       FRN                                                              MMPY0970
       STO     **,4        ** = C+1                                     MMPY0980
       TNX     HOLD1,4,1                                                MMPY0990
       TNX     SET1,1,1                                                 MMPY1000
 D)K   TXI     *+1,2,**    ** = K                                       MMPY1010
 D)RS1 TXI     SETC,1,**   ** = I*K-I                                   MMPY1020
 HOLD1 AXT     **,1                                                     MMPY1030
 HOLD2 AXT     **,2                                                     MMPY1040
 HOLD4 AXT     **,4                                                     MMPY1050
       TRA     10,4                                                     MMPY1060
 A)1   OCT     000000000001                                             MMPY1070
 A)IJ                                                                   MMPY1080
 HOLD                                                                   MMPY1090
 C2                                                                     MMPY1100
       EJECT                                                            MMPY1110
       END                                                              MMPY1120
*      FAP                                                                      
*  A MACRO THAT CAN BE USED BY FAP PROGRAMS TO CALL SI-MMPY                     
       PMC                                                                      
       EXTERN  MATMPY                                                           
       SPACE   3                                                                
MATMPY MACRO   A,L,M,B,N,C,I,J,K                                                
       TSX     MATMPY,4                                                         
       PZE     A-1                                                              
       PZE     ='L'B17                                                          
       PZE     ='M'B17                                                          
       PZE     B-1                                                              
       PZE     ='N'B17                                                          
       PZE     C-1                                                              
       IFF     1,1,I                                                            
       PZE     =1B17                                                            
       IFF     0,1,I                                                            
       PZE     I                                                                
       IFF     1,1,J                                                            
       PZE     =1B17                                                            
       IFF     0,1,J                                                            
       PZE     J                                                                
       IFF     1,1,K                                                            
       PZE     =1B17                                                            
       IFF     0,1,K                                                            
       PZE     K                                                                
MATMPY END                                                                      
       SPACE   3                                                                
       REM  EXAMPLE OF EXPANDED MACRO                                           
       MATMPY  A,48,48,B,3,C,1,1,J                                              
       SPACE   3                                                                
A      BES     2304                                                             
B      BES     144                                                              
C      BES     144                                                              
J                                                                               
       END                                                                      
