*     NBS TAU   SOLUTION OF RICATTI DIFFERENTIAL EQUATION                       
      SUBROUTINE TAU (S,DR,DI,TR,TI)                                    TAU 0000
      DIMENSION TZERO(5), TIN(5)                                        TAU 0001
      IF(ITM) 16,15,16                                                  TAU 0002
   15 TZERO(1)=1.8557571                                                TAU 0003
      TZERO(2)=3.2446076                                                TAU 0004
      TZERO(3)=4.3816712                                                TAU 0005
      TZERO(4)=5.3866138                                                TAU 0006
      TZERO(5)=6.3052630                                                TAU 0007
      TIN(1)=.80861652                                                  TAU 0008
      TIN(2)=2.5780961                                                  TAU 0009
      TIN(3)=3.8257153                                                  TAU 0010
      TIN(4)=4.8918203                                                  TAU 0011
      TIN(5)=5.8513010                                                  TAU 0012
      ITM=1                                                             TAU 0013
      SINT=.86602540                                                    TAU 0014
      COST=.5                                                           TAU 0015
   16 IF(S-5.) 1,2,2                                                    TAU 0016
    1 IC=S+1.                                                           TAU 0017
      TSO=TZERO(IC)                                                     TAU 0018
      TSIN=TIN(IC)                                                      TAU 0019
      GO TO 3                                                           TAU 0020
    2 Y1=1.1780972*(4.*S+3.)                                            TAU 0021
      Y12=Y1*Y1                                                         TAU 0022
      Y14=Y12*Y12                                                       TAU 0023
      Y13RT=CBRTF(Y1)                                                   TAU 0024
      TSO=Y13RT*Y13RT/1.2599211                                         TAU 0025
      TSO=TSO+TSO/(9.6*Y12)-TSO/(7.2*Y14)+.92928404*TSO/(Y14*Y12)       TAU 0026
      Y2=1.1780972*(4.*S+1.)                                            TAU 0027
      Y22=Y2*Y2                                                         TAU 0028
      Y24=Y22*Y22                                                       TAU 0029
      Y23RT=CBRTF(Y2)                                                   TAU 0030
      TSIN=Y23RT*Y23RT/1.259921                                         TAU 0031
      TSIN=TSIN-.14583333*TSIN/Y22+.12152778*TSIN/Y24-.87395351*TSIN/(Y2TAU 0032
     12*Y24)                                                            TAU 0033
    3 DELTA2=DR*DR+DI*DI                                                TAU 0034
      IF(DELTA2*TSO-.5) 5,10,10                                         TAU 0035
   10 ASSIGN 1001 TO N                                                  TAU 0036
C                                                                       TAU 0037
C     ASYMPTOTIC SERIES (1/DELTA SUB E = DEL)                           TAU 0038
   11 TS1=TSIN                                                          TAU 0039
      DELR=DR/DELTA2                                                    TAU 0040
      DELI=-DI/DELTA2                                                   TAU 0041
      ASSIGN 30 TO J                                                    TAU 0042
   20 SUMR=COST*TS1                                                     TAU 0043
      SUMI=SINT*TS1                                                     TAU 0044
      TS2=TS1*TS1                                                       TAU 0045
      TS3=TS2*TS1                                                       TAU 0046
      TS4=TS2*TS2                                                       TAU 0047
      TS5=TS2*TS3                                                       TAU 0048
      TS6=TS3*TS3                                                       TAU 0049
      TS7=TS3*TS4                                                       TAU 0050
      TS9=TS4*TS5                                                       TAU 0051
      TS12=TS6*TS6                                                      TAU 0052
      TS15=TS9*TS6                                                      TAU 0053
      CALL ZMPY (DELR,DELI,DELR,DELI,DEL2R,DEL2I)                       TAU 0054
      CALL ZMPY (DELR,DELI,DEL2R,DEL2I,DEL3R,DEL3I)                     TAU 0055
      CALL ZMPY (DEL2R,DEL2I,DEL2R,DEL2I,DEL4R,DEL4I)                   TAU 0056
      CALL ZMPY (DEL2R,DEL2I,DEL3R,DEL3I,DEL5R,DEL5I)                   TAU 0057
      CALL ZMPY (DEL3R,DEL3I,DEL3R,DEL3I,DEL6R,DEL6I)                   TAU 0058
      CALL ZMPY (DEL3R,DEL3I,DEL4R,DEL4I,DEL7R,DEL7I)                   TAU 0059
      CALL ZMPY (DEL4R,DEL4I,DEL4R,DEL4I,DEL8R,DEL8I)                   TAU 0060
      CALL ZMPY (DEL4R,DEL4I,DEL5R,DEL5I,DEL9R,DEL9I)                   TAU 0061
      CALL ZMPY (DEL5R,DEL5I,DEL5R,DEL5I,DEL10R,DEL10I)                 TAU 0062
      CALL ZMPY (DEL5R,DEL5I,DEL6R,DEL6I,DEL11R,DEL11I)                 TAU 0063
      GO TO J,  (30, 60)                                                TAU 0064
   30 TSR=-COST/(2.*TS1)                                                TAU 0065
      TSI=SINT/(2.*TS1)                                                 TAU 0066
      CALL ZMPY (TSR,TSI,DELR,DELI,PP1R,PP1I)                           TAU 0067
      CALL POLR(PP1R,PP1I,PP1MOD,PP1PHI)                                TAU 0068
      K=1                                                               TAU 0069
      TSA=TS1                                                           TAU 0070
   40 IF (PP1MOD/TSA - 4.E-7)  50,50,41                                 TAU 0071
   41 GO TO (101,102,103,104,105,106,107,108,109,50), K                 TAU 0072
  101 PP2R=.125/TS3*DEL2R                                               TAU 0073
      PP2I=.125/TS3*DEL2I                                               TAU 0074
      GO TO 110                                                         TAU 0075
  102 TSR=-COST/TS2                                                     TAU 0076
      TSI=-SINT/TS2                                                     TAU 0077
      CALL ZMPY (TSR,TSI,DEL3R,DEL3I,PP2R,PP2I)                         TAU 0078
      CONST=-(.83333333E-1-.0625/TS3)                                   TAU 0079
      GO TO 120                                                         TAU 0080
  103 TSR=-COST/TS4                                                     TAU 0081
      TSI=SINT/TS4                                                      TAU 0082
      CALL ZMPY (TSR,TSI,DEL4R,DEL4I,PP2R,PP2I)                         TAU 0083
      CONST=-(.72916667E-1-.0390625/TS3)                                TAU 0084
      GO TO 120                                                         TAU 0085
  104 PP2R=DEL5R                                                        TAU 0086
      PP2I=DEL5I                                                        TAU 0087
      CONST=-(-.025/TS3+.065625/TS6-.02734375/TS9)                      TAU 0088
      GO TO 120                                                         TAU 0089
  105 TSR=COST/TS5                                                      TAU 0090
      TSI=SINT/TS5                                                      TAU 0091
      CALL ZMPY (TSR,TSI,DEL6R,DEL6I,PP2R,PP2I)                         TAU 0092
      CONST=-(.40277778E-1-.06015625/TS3+.20507812E-1/TS6)              TAU 0093
      GO TO 120                                                         TAU 0094
  106 TSR=-COST/TS4                                                     TAU 0095
      TSI=SINT/TS4                                                      TAU 0096
      CALL ZMPY (TSR,TSI,DEL7R,DEL7I,PP2R,PP2I)                         TAU 0097
      CONST=-(.89285714E-2-.52777778E-1/TS3+.55859375E-1/TS6-.16113281E-TAU 0098
     11/TS9)                                                            TAU 0099
      GO TO 120                                                         TAU 0100
  107 PP2R=DEL8R                                                        TAU 0101
      PP2I=DEL8I                                                        TAU 0102
      CONST=-(.21651786E-1/TS6-.63671875E-1/TS9+.52368164E-1/TS12-      TAU 0103
     1.13092041E-1/TS15)                                                TAU 0104
      GO TO 120                                                         TAU 0105
  108 TSR=COST/TS5                                                      TAU 0106
      TSI=SINT/TS5                                                      TAU 0107
      CALL ZMPY (TSR,TSI,DEL9R,DEL9I,PP2R,PP2I)                         TAU 0108
      CONST=-(.34722222E-2-.37646054E-1/TS3+.73448351E-1/TS6-.49458822E-TAU 0109
     11/TS9+.10910034E-1/TS12)                                          TAU 0110
      GO TO 120                                                         TAU 0111
  109 TSR=COST/TS7                                                      TAU 0112
      TSI=-SINT/TS7                                                     TAU 0113
      CALL ZMPY (TSR,TSI,DEL10R,DEL10I,PP2R,PP2I)                       TAU 0114
      CONST=-(.11453373E-1-.56531980E-1/TS3+.82380642E-1/TS6-.46985881E-TAU 0115
     11/TS9+.92735291E-2/TS12)                                          TAU 0116
  120 PP2R=PP2R*CONST                                                   TAU 0117
      PP2I=PP2I*CONST                                                   TAU 0118
  110 CALL POLR(PP2R,PP2I,PP2MOD,PP2PHI)                                TAU 0119
      IF (PP2MOD - PP1MOD)  42,50,50                                    TAU 0120
   42 SUMR=SUMR+PP1R                                                    TAU 0121
      SUMI=SUMI+PP1I                                                    TAU 0122
      CALL POLR(SUMR,SUMI,TSA,TSPHIA)                                   TAU 0123
      PP1MOD=PP2MOD                                                     TAU 0124
      PP1R=PP2R                                                         TAU 0125
      PP1I=PP2I                                                         TAU 0126
      K=K+1                                                             TAU 0127
      GO TO 40                                                          TAU 0128
   50 ERRA=PP1MOD                                                       TAU 0129
      TRA=SUMR                                                          TAU 0130
      TIA=SUMI                                                          TAU 0131
  200 GO TO N,  (1001,1002,1003)                                        TAU 0132
 1001 IF(DELTA2*TSA-.5) 45,500,500                                      TAU 0133
   45 ASSIGN 1003 TO N                                                  TAU 0134
      GO TO 7                                                           TAU 0135
 1002 IF(DELTA2*TSC-.3) 501,501,46                                      TAU 0136
   46 ASSIGN 1003 TO N                                                  TAU 0137
      GO TO 11                                                          TAU 0138
 1003 IF (ERRA-ERRC)  500,500,501                                       TAU 0139
C                                                                       TAU 0140
C     CONVERGENT SERIES                                                 TAU 0141
    5 IF(DELTA2*TSO-.3) 6,6,10                                          TAU 0142
    6 ASSIGN 1002 TO N                                                  TAU 0143
    7 TS1=TSO                                                           TAU 0144
      DELR=DR                                                           TAU 0145
      DELI=DI                                                           TAU 0146
      ASSIGN 60 TO J                                                    TAU 0147
      GO TO 20                                                          TAU 0148
   60 SUMR=SUMR-DELR                                                    TAU 0149
      SUMI=SUMI-DELI                                                    TAU 0150
      TS1R=COST*TS1                                                     TAU 0151
      TS1I=SINT*TS1                                                     TAU 0152
      CALL ZMPY (TS1R,TS1I,DEL3R,DEL3I,PP1R,PP1I)                       TAU 0153
      SUMR=SUMR-.66666667*PP1R+COST*DEL4R                               TAU 0154
      SUMI=SUMI-.66666667*PP1I+COST*DEL4I                               TAU 0155
      TS2R=-COST*TS2                                                    TAU 0156
      TS2I=SINT*TS2                                                     TAU 0157
      CALL ZMPY (TS2R,TS2I,DEL5R,DEL5I,PP1R,PP1I)                       TAU 0158
      SUMR=SUMR-.8*PP1R                                                 TAU 0159
      SUMI=SUMI-.8*PP1I                                                 TAU 0160
      CALL ZMPY (TS1R,TS1I,DEL6R,DEL6I,PP1R,PP1I)                       TAU 0161
      CONST=.71428571-1.1428571*TS3                                     TAU 0162
      SUMR=SUMR+1.5555556*PP1R-CONST*DEL7R                              TAU 0163
      SUMI=SUMI+1.5555556*PP1I-CONST*DEL7I                              TAU 0164
      CALL ZMPY (TS2R,TS2I,DEL8R,DEL8I,PP1R,PP1I)                       TAU 0165
      SUMR=SUMR+3.8666667*PP1R                                          TAU 0166
      SUMI=SUMI+3.8666667*PP1I                                          TAU 0167
      CALL ZMPY (TS1R,TS1I,DEL9R,DEL9I,PP1R,PP1I)                       TAU 0168
      CONST=4.0493827-1.7777778*TS3                                     TAU 0169
      CONST1=1.3428571-8.8685714*TS3                                    TAU 0170
      TRC=SUMR-CONST*PP1R+CONST1*DEL10R                                 TAU 0171
      TIC=SUMI-CONST*PP1I+CONST1*DEL10I                                 TAU 0172
      CALL POLR(TRC,TIC,TSC,TSPHIC)                                     TAU 0173
      CALL ZMPY (TS2R,TS2I,DEL11R,DEL11I,PP1R,PP1I)                     TAU 0174
      CONST=15.305051-2.9090909*TS3                                     TAU 0175
      PP1R=-CONST*PP1R                                                  TAU 0176
      PP1I=-CONST*PP1I                                                  TAU 0177
      CALL POLR(PP1R,PP1I,ERRC,ERPHIC)                                  TAU 0178
      GO TO 200                                                         TAU 0179
  500 ERR=ERRA                                                          TAU 0180
      TR=TRA                                                            TAU 0181
      TI=TIA                                                            TAU 0182
      TS=TSA                                                            TAU 0183
      TSPHI=TSPHIA                                                      TAU 0184
      TSZ=TSIN                                                          TAU 0185
      GO TO 550                                                         TAU 0186
  501 ERR=ERRC                                                          TAU 0187
      TR=TRC                                                            TAU 0188
      TI=TIC                                                            TAU 0189
      TS=TSC                                                            TAU 0190
      TSPHI=TSPHIC                                                      TAU 0191
      TSZ=TSO                                                           TAU 0192
  550 DEL2T=DELTA2*TS                                                   TAU 0193
      RETURN                                                            TAU 0194
      END                                                               TAU 0195
