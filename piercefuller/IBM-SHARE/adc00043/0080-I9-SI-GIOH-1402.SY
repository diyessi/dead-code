       BSS     -2                                                      *LMH00171
       STA     STOP+3                SAVE FORMAT LOCATION FOR EXEM.    *LMH00551
       PZE     0,1,*+2               INCORRECT FORMAT STATEMENT.       *LMH02580
       PZE                           LOCATION OF FORMAT.               *LMH02581
       CLA     TRAST                 PICK UP TRA*, AND                 *LMH02930
CCEFLT NOP     *+4                   IF INPUT                          *LMH04340
       TXL     FXPT,4,21           * EXIT TO CCFFXD FOR E INPUT.       *LMH04360
       TXI     GNPT0,4,DBC+1-23    * EXIT TO GNPT0 FOR G INPUT.        *LMH04361
       REM  . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*LMH04651
       REM  G INPUT / ENTRY FROM CCEFLT AFTER G ON FORMAT SCAN.        *LMH04652
GNPT0  SXA     CNVSW,4               DBC+1 TO CNVSW.                   *LMH04653
       LXA     INT,4                                                   *LMH04654
       SXA     COUNT,4                                                 *LMH04655
       AXT     80,4                  FIELD WIDTH=CARD SIZE.            *LMH04656
       SXA     INT,4                 SCAN ON COMMA PUTS INT IN WIDTH.  *LMH04657
 TRAST TRA*    T5 (ROT,SCAN5)        IF G IS ON, CONTINUE SCAN.        *LMH04658
       REM  ENTRY FROM FIXSW IN DBC                                    *LMH04659
 GNPT1 LDQ     D                                                       *LMH04660
       TQP     *+2                   WAS DECIMAL FOUND...              *LMH04661
       TRA     DBEXIT-1            * NO, INTEGER CONVERSION.           *LMH04662
       LXD     U,1                   YES,                              *LMH04663
       TXH     FIXSW+1,1,0         * IF U HAS DECREMENT, E CONVERSION. *LMH04664
       SXD     U,4                   HO, IT IS F CONVERSION,           *LMH04665
       REM  INDIRECT ADDRESS TABLE.                                    *LMH04667
 EXE1  PZE     (EXE),,DBC2           IGNORE LEADING ALPHABETICS,       *LMH04668
 EXE2  PZE     (EXE),,DBC+1          NUMBERS FOLLOWED BY ALPHABETICS.  *LMH04669
 T1    PZE     DBC9,,GNPT2           IGNORE LEADING E, ACT ON DECIMAL. *LMH04670
 T2    PZE     DBC3,,DBC15           BLANKS                            *LMH04671
 T3    PZE     ER3+1,,DBC15          WILL TERMINATE                    *LMH04672
 T4    PZE     DBC12,,DBC15          G FIELD.                          *LMH04673
 T5    PZE     ROT,,SCAN5                                              *LMH04674
 T6    PZE     DBC+1,,ROT                                              *LMH04675
 T7    PZE     DBC-1,,SCAN5                                            *LMH04676
 T8    PZE     DBEXIT-1,,GNPT1                                         *LMH04677
       REM  SET INDIRECT ADDRESS TABLE FOR G OR F/I CONVERSION.        *LMH04678
       CAL     TRAST                                                   *LMH04679
       STD     FIXSW                                                   *LMH04680
 ROT   XCA                                                             *LMH04681
       AXT     10,4                                                    *LMH04682
       LDQ     T8+1,4                RESET                             *LMH04683
       RQL     18                    INDIRECT TRANSFER                 *LMH04684
       STQ     T8+1,4                TABLE.                            *LMH04685
       TIX     *-3,4,1                                                 *LMH04686
       XCA                                                             *LMH04687
       TRA*    T7 (DBC-1,SCAN5)      IF G HAS JUST BEEN SET, GO TO SCAN*LMH04688
       LXA     WIDTH,4                                                 *LMH04689
       REM  DBC / DECIMAL TO BINARY CONVERSION ROUTINE.                *LMH04690
 DBC   TRA*    T6 (DBC+1,ROT)        IF G IS ON, RESET IT OFF.         *LMH04691
       CLA     MZE                   INITIALIZE.                       *LMH04692
       STO     N                     ..                                *LMH04693
       REM  ENTRY FROM DBC LEADING CHARACTER SCAN                      *LMH04761
 GNPT2 CAS     POINT                 BETWEEN MINUS (40) AND PLUS (20). *LMH04762
       TRA     DBC2                  IGNORE CHARACTER, CONTINUE SCAN.  *LMH04763
       TRA     DBC9                  DECIMAL POINT BEGINS FIELD.       *LMH04764
       TRA*    T1  (DBC9,GNPT2)      FOR LEGAL                         *LMH04910
       TRA*    T2 (DBC3,DBC15)       IGNORE IT.                        *LMH05130
       TRA*    T3 (*+3,DBC15)        EXIT FOR                          *LMH05370
       TRA*    T4 (DBC12,DBC15)      TREAT BLANK AS ZERO.              *LMH05500
FIXSW  TRA*    T8 (DBEXIT-1,GNPT1)   SWITCH SET NOP FOR F, TRA* FOR I. *LMH05870
       TRA*    EXE1                * EXECUTION ERROR.                  *LMH06250
       TRA*    EXE2                * EXECUTION ERROR.                  *LMH06290
       TRA*    EXE2                * EXECUTION ERROR.                  *LMH06320
       TRA*    EXE2                * EXECUTION ERROR.                  *LMH06350
