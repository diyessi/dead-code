C                                 TLU                                   00000000
C**** TABLE LOOK UP SUBROUTINE                    REVISED OCT.10,1961   00000010
C                                                                       00000020
C      CONDITIONS                                                       00000030
C        1. TWO AND THREE DIMENSIONS                                    00000040
C        2. TWO OR MORE DEPENDENT VARIABLES                             00000050
C        3. LINEAR ITERPOLATION                                         00000060
      SUBROUTINE TLU(TB,ANS)                                            00000070
C                                                                       00000080
  510  FIRSTF(X,Y,Z) = X - Z*(X-Y)                                      00000090
C                                                                       00000100
      DIMENSION  COM(5000),ANS(1),TB(1)                                 00000110
C                                                                       00000120
      EQUIVALENCE            (COM(4010),NDIM  )   ,(COM(4011),NTAB  )   00000130
     1,(COM(4012),NX    )   ,(COM(4013),NY    )   ,(COM(4014),XG    )   00000140
     2,(COM(4015),YG    )                                               00000150
C                                                                       00000160
      COMMON  COM                                                       00000170
C                                                                       00000180
      IF(NX) 850,850,525                                                00000190
  525 JXX=1                                                             00000200
  527 IXX = JXX + NY                                                    00000210
      IF(NDIM-3) 560,550,850                                            00000220
  550 CALL RATIO(NY,YG,(TB(JXX)),RATY,J)                                00000230
  560 CALL RATIO(NX,XG,(TB(IXX)),RATX,I)                                00000240
      IF(NDIM-3) 580,630,850                                            00000250
C                                                                       00000260
C                            2 DIMENSIONAL CASE                         00000270
C                                                                       00000280
  580 NP = I + IXX + NX - 1                                             00000290
  590  DO 610 K=1,NTAB                                                  00000300
  593 IF(NP-1)850,594,600                                               00000310
  594 ANS(K) = TB(NP)                                                   00000320
  595 GO TO 610                                                         00000330
  600 ANS(K) = FIRSTF(TB(NP),TB(NP-1),RATX)                             00000340
  610  NP = NP + NX                                                     00000350
  620  GO TO 850                                                        00000360
C                                                                       00000370
C                            3 DIMENSIONAL CASE                         00000380
C                                                                       00000390
  630 NP = I + NX*(J-1) + IXX + NX -1                                   00000400
  640 DO 692 K =1,NTAB                                                  00000410
  643 IF(NP-1)850,644,650                                               00000420
  644 ANS(K) = TB(NP)                                                   00000430
  645 NP = NP + NX * NY                                                 00000440
  646 GO TO 692                                                         00000450
  650 A = FIRSTF(TB(NP),TB(NP-1),RATX)                                  00000460
  660  NP = NP - NX                                                     00000470
  670 B = FIRSTF(TB(NP),TB(NP-1),RATX)                                  00000480
  680  ANS(K) = FIRSTF(A,B,RATY)                                        00000490
  690  NP = NP + NX * ( NY + 1 )                                        00000500
  692 CONTINUE                                                          00000510
  850 RETURN                                                            00000520
      END                                                               00000530
       SUBROUTINE  RATIO (NV,GV,TV,RAT,NC)                              00000540
      DIMENSION TV(1)                                                   00000550
  110  IF (GV - TV(1) ) 120 , 120 , 150                                 00000560
  120  NC = 1                                                           00000570
  130  RAT = 0.                                                         00000580
  140  GO TO 220                                                        00000590
  150 DO 170 NCNT=2,NV                                                  00000600
  155 NC=NCNT                                                           00000610
  160  IF ( GV - TV(NC))200 , 130 , 170                                 00000620
  170  CONTINUE                                                         00000630
  190  GO TO 130                                                        00000640
  200  RAT =(TV(NC) - GV) / ( TV(NC) - TV(NC - 1))                      00000650
       FREQUENCY 110(1,1,10),150(15),160(1,0,10)                        00000660
  220  RETURN                                                           00000670
      END                                                               00000680
