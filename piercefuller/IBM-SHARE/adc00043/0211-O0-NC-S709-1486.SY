       STO     TMP          STORE AC. NO Q OR P BITS.                   S7091770
       STQ     MQ           STORE MQ.                                   S7091780
 PXA   PXA     ,0           CLEAR AC.                                   S7091790
       LLS     1            MQ 1 BIT TO AC WITH PROPER SIGN.            S7091800
       TRA     RNDX         CONTINUE.                                   S7091810
 RND   PXD     ,0           CLEAR AC.                                   S7091820
       STQ     MQ           SAVE MQ.                                    S7091830
       LLS     1            MQ 1 BIT TO AC 35                           S7091840
       LDQ     ACHXX        WITH PROPER                                 S7091850
       LLS     0            SIGN.                                       S7091860
       STO     TMP          SAVE ROUNDING BIT.                          S7091870
       TSL     RACR         RESET ORIGINAL AC.                          S7091880
 RNDX  ADD     TMP          ROUND.                                      S7091890
       LDQ     MQ           RESTORE MQ.                                 S7091900
       TRA*    0            GO TO NEXT INSTRUCTION.                     S7091910
 NZT   CLA*    ATXXX        FETCH STORAGE.                              S7091920
       TNZ     JOT          STORAGE NON-ZERO, UP EXIT.                  S7091930
       TRA     OUT          STORAGE ZERO, NORMAL EXIT.                  S7091940
 ZET   CLA*    ATXXX        FETCH STORAGE.                              S7091950
       TNZ     OUT          STORAGE NON-ZERO, NORMAL EXIT.              S7091960
 JOT   CAL     0            AUGMENT                                     S7091970
       ADD     A1           EXIT ADDRESS                                S7091980
       STA     0            BY ONE.                                     S7091990
 OUT   CLA     ACHXX        FETCH AC SIGN WITH Q BIT IN POSITION 35.    S7092000
       TZE     *+3          IF ZERO, NO Q BIT.                          S7092010
       ACL     MSKLG        MAKE P BIT WITHOUT OVERFLOW. SIGN RETAINED. S7092020
 A1    ALS     1            RESTORE Q BIT.                              S7092030
       ORA     ACLXX        ANNEX LOGICAL AC.                           S7092040
       TRA*    0            GO TO NEXT INSTRUCTION.                     S7092050
 ANS   CAL*    ATXXX        FETCH STORAGE.                              S7092060
       ANA     ACLXX        AND TO THE AC.                              S7092070
       TRA     SLW          CONTINUE.                                   S7092080
 ORS   CAL*    ATXXX        FETCH STORAGE.                              S7092090
       ORA     ACLXX        OR TO THE AC.                               S7092100
       TRA     SLW          CONTINUE.                                   S7092110
 SLQ   CAL*    ATXXX        FETCH STORAGE.                              S7092120
       ANA     MSKAT        GET RIGHT HALF.                             S7092130
       SLW     TMP          SAVE IT.                                    S7092140
       STQ     MQ           GET                                         S7092150
       CAL     MSKL         LEFT HALF                                   S7092160
       ANA     MQ           OF MQ.                                      S7092170
       TRA     SLW-1        CONTINUE.                                   S7092180
 STP   CAL*    ATXXX        FETCH STORAGE.                              S7092190
       ANA     MSKNP        GET ALL BUT THE PREFIX.                     S7092200
       SLW     TMP          SAVE IT.                                    S7092210
       CAL     MSKP         FETCH PREFIX MASK.                          S7092220
       TRA     SLW-2        CONTINUE.                                   S7092230
 STT   CAL*    ATXXX        FETCH STORAGE.                              S7092240
