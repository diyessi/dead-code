       SLW     TMP          SAVE IT.                                    S7092260
       CAL     MSKT         FETCH TAG MASK.                             S7092270
       ANA     ACLXX        EXTRACT.                                    S7092280
       ORA     TMP          ASSEMBLE RESULT.                            S7092290
 SLW   SLW*    ATXXX        PUT IN STORAGE.                             S7092300
       TRA     OUT          EXIT.                                       S7092310
 SSM   SAC     ACHXX,,6     MAKE STORED AC SIGN MINUS.                  S7092320
       TRA     OUT          RESTORE AC WITH MINUS SIGN, EXIT.           S7092330
 SLC   PZE     --           EXIT FOR ROUTINE USED BY SLN, SLT.          S7092340
       ORA     PXA          CREATE PXA A,T                              S7092350
