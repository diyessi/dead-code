*THE FOLLOWING SIMULATION OF CAQ ASSUMES THAT THE TABLE ACCESSED IS SUCHS7093780
*THAT NO CARRY OUT OF THE P BIT POSITION WILL OCCUR, WHICH IS NORMAL    S7093790
*USAGE.  SEE APPENDIX FOR ANOTHER ROUTINE.                              S7093800
 CAQ   TNX     CAQE,4,16    HERE FOR CAQ, JUMP IF ZERO COUNT.           S7093810
       STQ     MQ           GET HIGH MQ                                 S7093820
       PCS     MQ,,0        BYTE IN AC.                                 S7093830
       SAC     *+2,,5       SET FOR TABLE LOOK UP.                      S7093840
       RQL     6            ROTATE FOR NEXT BYTE.                       S7093850
       CAL     --,2         TABLE LOOK UP.                              S7093860
       PAC     ,2           SET NEXT TABLE ORIGIN.                      S7093870
       ACL     ACLXX        AUGMENT LOGICAL                             S7093880
       SLW     ACLXX        ADDER.                                      S7093890
       TIX     CAQ+1,4,1    COUNT DOWN TEST. IF 1 PROCEED TO CAQE.      S7093900
 CRQ   TNX     CAQE,4,2*16  JUMP IF 0 COUNT, OTHERWISE REMOVE CRQ FLAG. S7093910
       PXD     ,0           CLEAR AC.                                   S7093920
       LGL     6            BYTE TO AC.                                 S7093930
       STA     *+1          SET TABLE LOOK UP.                          S7093940
       PCS     --,2,0       GET HIGH BYTE FROM TABLE.                   S7093950
       LGR     6            PUT IN LOW ORDER                            S7093960
       RQL     6            POSITION OF MQ.                             S7093970
       CAL*    *-3          SET NEXT                                    S7093980
       PAC     ,2           TABLE ORIGIN.                               S7093990
       TIX     CRQ+1,4,1    COUNT DOWN. IF 1 NEXT INST EFFECTS TRANSFER.S7094000
 CVR   TNX     CAQE,4,3*16  JUMP IF 0 COUNT, OTHERWISE REMOVE CVR FLAG. S7094010
       TSL     RACR         RESTORE ORIGINAL AC.                        S7094020
       SAC     *+3,,5       SET TLU PICKUP.                             S7094030
       ARS     6            PREPARE FOR PLACEMENT                       S7094040
       SLW     ACLXX        OF HIGH BYTE.                               S7094050
       CAL     --,2         TABLE LOOK-UP.                              S7094060
       PAC     ,2           SET NEXT ORIGIN.                            S7094070
       ANA     MSKHB        MASK HIGH BYTE.                             S7094080
       ORA     ACLXX        OR HIGH BYTE INTO PLACE.                    S7094090
       TIX     *-7,4,1      COUNT DOWN TEST.                            S7094100
       SLW     ACLXX        SAVE RESULTANT.                             S7094110
       CLA     ACHXX        AT END OF A CVR WITH NON-ZERO COUNT THERE   S7094120
       ARS     1            IS NO Q BIT SO MAKE SURE IT IS OUT IN THE   S7094130
       STO     ACHXX        FINAL PROCESSING.                           S7094140
 CAQE  CAL     *+4          GET LOW TAG BIT                             S7094150
       ANA     ATXXX        OF ORIGINAL CONVERT INSTRUCTION.            S7094160
       TZE     *+3          JUMP IF NOT A ONE.                          S7094170
       PXA     ,2           CONTENTS OF ADDRESS OF                      S7094180
       PAC     ,1           LAST ORIGIN TO IR1.                         S7094190
 IR2   AXT     --,2         RESTORE IR2.                                S7094200
 OUT4  LXA     IR4,4        RESTORE IR4.                                S7094210
       TRA     OUT          EXIT.                                       S7094220
 RACR  PZE     --           RESTORE AC ROUTINE EXIT.                    S7094230
       CLA     ACHXX        FETCH AC SIGN WITH Q BIT IN POSITION 35.    S7094240
       TZE     *+3          IF ZERO, NO Q BIT.                          S7094250
       ACL     MSKLG        MAKE P BIT WITHOUT OVERFLOW. SIGN RETAINED. S7094260
       ALS     1            RESTORE Q BIT.                              S7094270
       ORA     ACLXX        OR IN LOGICAL AC.                           S7094280
       TRA*    RACR         RETURN WITH AC COMPLETELY RESTORED.         S7094290
 ENK   LDQ     KEYXX        SIMULATE ENK.                               S7094300
       TRA     OUT                                                      S7094310
 KEYXX EQU     9            SUGGESTED ADDRESS. MAY BE CHANGED.          S7094320
*                  TO SIMULATE ENK, THE KEY SETTING MUST BE MANUALLY    S7094330
*                  READ INTO THE DESIRED CELL PRIOR TO STARTING PROG.   S7094340
 ACLXX PZE                   STORAGE FOR AC LOGICAL                     S7094350
 ACHXX PZE                   STORAGE FOR AC SIGN AND Q BITS             S7094360
 INDXX PZE                   STORAGE FOR SIMULATED INDICATORS           S7094370
 SLXXX PZE                   STORAGE FOR SIMULATED SENSE LIGHTS         S7094380
 ZERO  DEC     0                                                        S7094390
 SEVEN DEC     7                                                        S7094400
 MSKT  DEC     7B20          TAG MASK                                   S7094410
 MSKAT OCT     777777        ADDRESS AND TAG MASK                       S7094420
 OP18  DEC     18B11         OPCODE 18 USED TO CHANGE XEC TO CLA        S7094430
 MSKNP OCT     77777777777   MASK FOR ALL BUT PREFIX                    S7094440
 MSKCH DEC     255B8         CHARACTERISTIC MASK                        S7094450
 MSKLG OCT     377777777777  35 BITS                                    S7094460
 MSKP  DEC     -3B2          PREFIX MASK                                S7094470
 MSKHB DEC     -31B5         HIGH BYTE MASK                             S7094480
 MSKL  OCT     777777000000  LEFT HALF MASK                             S7094490
 MSKNT OCT     777777077777  MASK FOR ALL BUT TAG                       S7094500
 STR   HPR     1            HALT FOR ERROR CAUSED BY PURE STR           S7094510
       TRA     *-1          IN LEFT HALF.                               S7094520
 ERR   HPR     -1,7         CODE NOT IN LIST. HALT. IR4 HAS THE BAD CODES7094530
       TRA     *-1       USER MAY WISH TO INSERT HIS OWN ERROR ROUTINE. S7094540
*THE FOLLOWING ROUTINE IS INCLUDED TO ALLOW FOR THE POSSIBILITY         S7094550
*THAT SOME SLN OR SLF MAY HAVE BEEN CODED AS A PSE.                     S7094560
 PSE   ORA     PXA          CREATE PXA A,T.                             S7094570
       SLW     *+1          SET FOR EXECUTION.                          S7094580
       PXA     --,--        PXA A,T                                     S7094590
       SUB     *-1          GET EFFECTIVE                               S7094600
       PAX     ,4           ADDRESS                                     S7094610
       TIX     *,4,4096     MODULO 4096.                                S7094620
       SXA     *+4,4        SAVE EFFECTIVE ADDRESS.                     S7094630
       TXI     *+1,4,-SL    SUBTRACT 140 FLAG.                          S7094640
       TXL     SLNP,4,7     JUMP IF A SENSE LIGHT.                      S7094650
       LXA     IR4,4        RESTORE IR4.                                S7094660
       PSE     --           EXECUTE PSE.                                S7094670
       TRA     OUT          NORMAL EXIT.                                S7094680
       TRA     JOT          UP EXIT.                                    S7094690
 SLNP  SXA     ARS,4        SET UP                                      S7094700
       PXA     ,4           TO USE SLN ROUTINE.                         S7094710
       LXA     IR4,4        RESTORE IR4.                                S7094720
       TRA     SLN+1        CONTINUE IN THE SLN ROUTINE.                S7094730
 SL    BOOL    140          OCTAL VALUE OF SLF ADDRESS CODE.            S7094740
* * * * * * * * * * * * * * *  APPENDIX  * * * * * * * * * * * * * * *  S7094750
 CCS   OPD     -134173140002       COMPARE CHARACTER WITH STORAGE.      S7094760
*           THE FOLLOWING ROUTINE IS BELIEVED TO PROVIDE AN ACCURATE    S7094770
*SIMULATION OF CAQ IN ALL POSSIBLE CASES.  IF ONE IS APT TO BE USING    S7094780
*CAQ WITH POSSIBLE CARRIES FROM THE P BIT POSITION IT SHOULD BE         S7094790
*SUBSTITUTED FOR THE CAQ ROUTINE GIVEN ABOVE.                           S7094800
*CAQ   TNX     CAQE,4,16    DROP CAQ FLAG. GO TO CAQE ON 0 COUNT.       S7094810
*      STL     OVFL         SET NON-ZERO FLAG IF                        S7094820
*      TOV     *+2          AC OVERFLOW ON.                             S7094830
*      SXA     OVFL,0       CHANGE TO ZERO FLAG IF NO OVFL.             S7094840
*      RQL     6            ROTATE AND SAVE                             S7094850
*      STQ     MQ           MQ FOR EACH COUNT.                          S7094860
*      PCS     MQ,,5        SET                                         S7094870
*      SAC     *+1,,5       PICKUP.                                     S7094880
*      CLA     --,2         FETCH TABLE VALUE.                          S7094890
*      PAC     ,2           SET NEXT ORIGIN.                            S7094900
*      STO     TMP          SAVE AUGEND.                                S7094910
*      LDQ     =1           SET MQ FOR ADDITION.                        S7094920
*      TSL     RACR         RESET AC.                                   S7094930
*      VMA     TMP,,1       FULL LOGICAL ADD AND SHIFT 1.               S7094940
*      LRS     1            SAVE SIGN AND SHIFT 1.                      S7094950
*      SSP                  PREPARE FOR POSSIBLE AUGMENTATION.          S7094960
*      CCS     TMP,,7       PLUS TEST.  IF MINUS ADD 1B2.               S7094970
*      SUB     MON          ADD BIT TO EFFECTIVE P POSITION.            S7094980
*      LLS     2            REPOSITION AND RESTORE SIGN.                S7094990
*      LDQ     MQ           REGAIN MQ.                                  S7095000
*      SLW     ACLXX        SAVE ACCUMULATOR P AND 1 TO 35 BITS.        S7095010
*      ARS     36           SAVE                                        S7095020
*      STO     ACHXX        SIGN AND Q BITS.                            S7095030
*      TIX     CAQ+4,4,1    CONTINUE UNTIL FULL COUNT IS PROCESSED.     S7095040
*      CLS     MON          TURN ON AC                                  S7095050
*      ALS     2            OVERFLOW INDICATOR.                         S7095060
*OVFL  AXT     --,4         PUT FLAG IN IR4.                            S7095070
*      TXH     CAQE,4,0     LEAVE ON IF OVFL WAS ON ORIGINALLY.         S7095080
*      TOV     CAQE         TURN OFF AC OVFL.                           S7095090
*                                                                       S7095100
*         THE FOLLOWING ROUTINE IS BELIEVED TO PROVIDE AN ACCURATE      S7095110
*SIMULATION OF FRN IN ALL POSSIBLE CASES. THIS ROUTINE PROVIDES FOR     S7095120
*UNUSUAL USE OF FRN IN CASES WHERE THE P OR Q BITS MAY BE PRESENT.      S7095130
*FRN   STQ     MQ           SAVE MQ.                                    S7095140
*      RQL     9            PUT 9 BIT IN MQ SIGN.                       S7095150
*      LLS     0            PUT SIGN IN AC.                             S7095160
*      LDQ     MQ           RESTORE MQ.                                 S7095170
*      TPL     OUT          OUT IF ROUNDING BIT IS ZERO.                S7095180
*      CAL     ACLXX        FETCH AC LOGICAL.                           S7095190
*      PBT                  IS P BIT PRESENT.                           S7095200
*      TRA     FRNC         NO, GO TO NORMAL CONTINUATION.              S7095210
*      SLW     OFL          YES.  SET MINUS IN OVERFLOW INDICATOR.      S7095220
*      TOV     *+2          USE MINUS TO SHOW AC OVERFLOW WAS ON.       S7095230
*      STZ     OFL          MAKE OFL PLUS TO SHOW NO AC OVERFLOW.       S7095240
*      TSL     RACR         RESTORE AC.                                 S7095250
*      LDQ     =1           LOAD MQ WITH A ONE.                         S7095260
*      LRS     0            GIVE IT SIGN OF AC.                         S7095270
*      STQ     TMP          STORE FOR ADDITION.                         S7095280
*      LDQ     MQ           RESTORE MQ.                                 S7095290
*      ADD     TMP          ROUND.                                      S7095300
*      SLW     ACLXX        STORE                                       S7095310
*      ARS     36           ENTIRE                                      S7095320
*      STO     ACHXX        ACCUMULATOR.                                S7095330
*      CLS     MON          TURN ON AC                                  S7095340
*      ALS     2            OVERFLOW INDICATOR.                         S7095350
*      CCS     OFL,,6       MINUS TEST. HOP IF - LEAVING OVFL ON.       S7095360
*      TOV     *+1          IF PLUS TURN AC OVERFLOW OFF.               S7095370
*      CAL     ACLXX        FETCH LOGICAL PART.                         S7095380
*      PBT                  IS P BIT STILL THERE.                       S7095390
*      TRA     FRNPD        NO. THEREFORE GO TO NO TRAP.                S7095400
*FRNP  ANA     MSKFR        YES. GET FRACTION.                          S7095410
*      TNZ     *+4          IF NOT 0, NO CARRY FROM 9 BIT.              S7095420
*      CAL     ACLXX        IF ZERO, CARRY OCCURRED, SO                 S7095430
*      ORA     MSK9         OR IN A BIT IN POSITION 9.                  S7095440
*      SLW     ACLXX        SAVE AC LOGICAL.                            S7095450
*      CLA     ACHXX        FETCH Q BIT WITH SIGN.                      S7095460
*      TNZ     OUT+2        IF Q BIT, NO TRAP, EXIT.                    S7095470
*      ORA     ACLXX        SET AC FOR TRAP CAUSED BY P BIT.            S7095480
*      AXT     6,4          SET AC FLOATING PT. OVERFLOW                S7095490
*      SXD     0,4          TRAP INDICATOR.                             S7095500
*      LXA     IR4,4        RESTORE IR4.                                S7095510
*      TRA     8            FLOATING PT. TRAP.                          S7095520
*FRNC  ACL     =1           NO P BIT, SO NO POSSIBLE CARRY AROUND       S7095530
*      SLW     ACLXX        IN AUGMENTING AC LOGICAL.                   S7095540
*      PBT                  NOW, IS THERE A P BIT.                      S7095550
*      TRA     *+2          NO, NORMAL CONTINUATION.                    S7095560
*      TRA     FRNP         YES, GO FINISH, CHECKING FOR TRAP.          S7095570
*      ANA     MSKFR        CHECK FRACTION                              S7095580
*      TNZ     OUT          FOR ZERO.                                   S7095590
*      CAL     ACLXX        IF ZERO,                                    S7095600
*FRNPD ORA     MSK9         OR IN BIT IN POSITION 9.                    S7095610
*      SLW     ACLXX        SAVE AC LOGICAL.                            S7095620
*      TRA     OUT          GO TO RESTORE AC AND RETURN.                S7095630
*OFL   PZE                  STORAGE TO INDICATE AC OVERFLOW.            S7095640
*MSK9  DEC     1B9          9 BIT FOR FLOATING FRACTION.                S7095650
*MSKFR OCT     777777777    MASK FOR FLOATING FRACTION.                 S7095660
*                                                                       S7095670
       END                                                              S7095680
