      FUNCTION  DEV(TR,PR,TC,PC,W)                                      9137 201
      DEV = PR*(4.996*(TR-1.0)*W**2 + (0.01734-0.0002754*PC-0.09772     9137 202
     2*TC**2)*PR + (0.03086+0.07683/PC)*(TR-1.0)**3 - 0.000001819       9137 203
     3*PC*(TR-1.0)*PR**2) / (TR**4+(0.689-0.8316*TC)*TC*PR**3)          9137 204
      RETURN                                                            9137 205
      END                                                               9137 206
      FUNCTION FUGAM(Q,E,Z)                                             9137 207
      FUGAM = (Z-1.0 - LOGF(Z-Q) - E*LOGF(1.0+Q/Z))                     9137 208
      RETURN                                                            9137 209
      END                                                               9137 210
      FUNCTION FUDEM(BA,BB,BC,BDD,PR)                                   9137 211
      BD = BDD*PR                                                       9137 212
      HE = LOGF((1.0 + BD)**2/(1.0 - BD + BD**2))                       9137 213
      HD = 3.4641*ATANF(1.1547*BD-0.57735)                              9137 214
      CC = -LOGF(1.0+BD**3)                                             9137 215
      FUDEM = (BA - BB)*HE + (BA + BB)*(HD + 1.8318) + BC*CC            9137 216
      RETURN                                                            9137 217
      END                                                               9137 218
