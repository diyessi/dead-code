*              32K 709/7090 FORTRAN LIBRARY                             L3E00000
       COUNT   14                                                       L3E00010
       TTL     EXPONENTIAL ROUTINE-FLOATING PT. BASE AND EXPONENT / 9XP3L3E00020
       LBL     9XP3,X                                                   L3E00030
       ENTRY   EXP(3                                                    L3E00040
 EXP(3 TZE     1,4           BASE ZERO                                  L3E00050
       SSP                                                              L3E00060
       SXA     OUT,4         SAVE IR4                                   L3E00070
       STQ     EXP1          SAVE EXPONENT                              L3E00080
       TSX     $LOG,4        FIND LN OF X                               L3E00090
       XCA                                                              L3E00100
       FMP     EXP1          MULTIPLY BY EXPONENT                       L3E00110
       TSX     $EXP,4        GET ANTI-LOG ( EXP )                       L3E00120
 OUT   AXT     **,4          RESTORE IR4                                L3E00130
       TRA     1,4           RETURN                                     L3E00140
 EXP1  PZE     0                                                        L3E00150
       END                                                              L3E00160
