C     CHECKOUT OF REVISED EXP(3 FUNCTION FOR 709/7090 FORTRAN II                
      WRITE OUTPUT TAPE 6,1                                                     
    1 FORMAT ( 20H1BEGIN TEST OF EXP(3  )                                       
      Y=2.0                                                                     
      DO 10 I=1,10                                                              
      X=5-I                                                                     
      A=Y**X                                                                    
   10 WRITE OUTPUT TAPE 6,2,X,A                                                 
    2 FORMAT ( 6H02.0**,F4.1,1H=,F9.4  )                                        
      WRITE OUTPUT TAPE 6,3                                                     
    3 FORMAT (30H1CHECK OVERFLOW AND UNDERFLOW  )                               
      Y=EXPF(1.0)**87.0                                                         
      A=Y**2.0                                                                  
      X=2                                                                       
      WRITE OUTPUT TAPE 6,2,X,A                                                 
      B=(-Y**2.0)                                                               
      WRITE OUTPUT TAPE 6,2,X,B                                                 
      CALL EXIT                                                                 
      END                                                                       
