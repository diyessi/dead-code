*     LABEL                                                             RNKT0001
CRUNGE                                                                  RNKT0002
      SUBROUTINE RUNGE (N, X, Y, TOL, YMIN, H, XOUT, MARK)              RNKT0003
      DIMENSION Y(1), TOL(1),YMIN(1), XOUT(1), MARK(1), YOUT(50),       RNKT0004
     1          Y1(50), Y2(50), Y3(50), DY(50), LSAV(5), MSAV(5)        RNKT0005
      DO 10 I=1,5                                                       RNKT0006
      LSAV(I)=0                                                         RNKT0007
   10 MSAV(I)=MARK(I)                                                   RNKT0008
      IF (SENSE LIGHT1) 15,20                                           RNKT0009
   15 LSAV(1)=1                                                         RNKT0010
   20 IF (SENSE LIGHT2) 25,30                                           RNKT0011
   25 LSAV(2)=1                                                         RNKT0012
   30 IF (SENSE LIGHT3) 35,40                                           RNKT0013
   35 LSAV(3)=1                                                         RNKT0014
   40 J = MARK(1)                                                       RNKT0015
      JMAX      = MARK(2)                                               RNKT0016
      IFREQ     = MARK(3)                                               RNKT0017
      LMAX      = MARK(4)                                               RNKT0018
      M         = MARK(5)                                               RNKT0019
      L         = 1                                                     RNKT0020
      CALL RUNKUT (N, X, Y, DY, H, TOL, YMIN, X1, X2, X3, Y1, Y2, Y3,   RNKT0021
     1             J, JMAX, INDEX, IFREQ, L, LMAX, SAME, M, XOUT)       RNKT0022
      DO 50 I=1,5                                                       RNKT0023
   50 MARK(I)=MSAV(I)                                                   RNKT0024
      IF (LSAV(1)) 60,60,55                                             RNKT0025
   55 SENSE LIGHT1                                                      RNKT0026
   60 IF (LSAV(2)) 70,70,65                                             RNKT0027
   65 SENSE LIGHT2                                                      RNKT0028
   70 IF (LSAV(3)) 80,80,75                                             RNKT0029
   75 SENSE LIGHT3                                                      RNKT0030
   80 RETURN                                                            RNKT0031
      END                                                               RNKT0032
*     LABEL                                                             RNKT0033
CRUNKUT                                                                 RNKT0034
      SUBROUTINE RUNKUT (N, X, Y, DY, H, TOL, YMIN, X1, X2, X3, Y1, Y2, RNKT0035
     1          Y3, J, JMAX, INDEX, IFREQ, L, LMAX, SAME, M, XOUT)      RNKT0036
      DIMENSION Y(1), DY(1), TOL(1), YMIN(1), Y1(1), Y2(1), Y3(1),      RNKT0037
     1YOUT(50), XOUT(1)                                                 RNKT0038
      GO TO (4000, 4040), M                                             RNKT0039
 4000 INDEX     = 0                                                     RNKT0040
      JJ        = J                                                     RNKT0041
 4001 XTEST     = XOUT(JJ) - X                                          RNKT0042
      IF (XTEST) 4030, 4002, 4030                                       RNKT0043
 4002 JJ        = JJ + 1                                                RNKT0044
      IF (JJ - J - 50) 4001, 4001, 4012                                 RNKT0045
 4012 WRITE OUTPUT TAPE 6, 4015                                         RNKT0046
 4015 FORMAT (41H0ERROR IN XOUT(J) VALUES. EXIT IS CALLED.)             RNKT0047
      CALL EXIT                                                         RNKT0048
 4030 IF (H) 4003, 4010, 4003                                           RNKT0049
 4003 IF (ABSF(H) - 0.4 * ABSF(XTEST)) 4020, 4020, 4010                 RNKT0050
 4010 H         = 0.4 * XTEST                                           RNKT0051
 4020 CALL ADJSTP (N, X, Y, DY, H, TOL, YMIN,     Y1, Y2, Y3, X1, X2,   RNKT0052
     1X3, J, JMAX, L, LMAX, SAME, NORD, M, XOUT, YOUT)                  RNKT0053
      IF (SENSE LIGHT 3) 4100, 4040                                     RNKT0054
 4040 INDEX     = INDEX + 1                                             RNKT0055
      SAME      = 6HRUNKUT                                              RNKT0056
      CALL INTPOL (N, X, Y, DY, H, XOUT, YOUT, L, J, JMAX, M, LMAX)     RNKT0057
      IF (SENSE LIGHT 3) 4100, 4043                                     RNKT0058
 4043 CALL STEP (N, X, Y, DY, H, L, LMAX, SAME, NORD)                   RNKT0059
      X1        = X2                                                    RNKT0060
      X2        = X3                                                    RNKT0061
      X3        = X                                                     RNKT0062
      DO 4050 I = 1, N                                                  RNKT0063
      Y1(I)     = Y2(I)                                                 RNKT0064
      Y2(I)     = Y3(I)                                                 RNKT0065
 4050 Y3(I)     = Y(I)                                                  RNKT0066
      IF (INDEX - IFREQ) 4040, 4060, 4060                               RNKT0067
 4060 INDEX     = 0                                                     RNKT0068
      CALL ADJSTP (N, X, Y, DY, H, TOL, YMIN,     Y1, Y2, Y3, X1, X2,   RNKT0069
     1X3, J, JMAX, L, LMAX, SAME, NORD, M, XOUT, YOUT)                  RNKT0070
      IF (SENSE LIGHT 3) 4100, 4040                                     RNKT0071
 4100 RETURN                                                            RNKT0072
      END                                                               RNKT0073
*     LABEL                                                             RNKT0074
CADJSTP                                                                 RNKT0075
      SUBROUTINE ADJSTP (N, X, Y, DY, H, TOL, YMIN,     Y1, Y2, Y3, X1, RNKT0076
     1  X2, X3, J, JMAX, L, LMAX, SAME, NORD, M, XOUT, YOUT)            RNKT0077
      DIMENSION  Y(1), DY(1), Y1(1) , Y2(1) , Y3(1) , Y4(50), DELY(50), RNKT0078
     1YOUT(1),   E(50), HFIRST(50), HORDER(50), TOL(1), YMIN(1), XOUT(1)RNKT0079
      HFACT     = 1.0 E+31                                              RNKT0080
      HFACT1    = 1.0E+30                                               RNKT0081
      GO TO (2001, 3001), M                                             RNKT0082
 3001 H1        = H                                                     RNKT0083
      H         = 2.0 * H                                               RNKT0084
      X         = X1                                                    RNKT0085
      DO 3000 I = 1, N                                                  RNKT0086
 3000 Y(I)      = Y1(I)                                                 RNKT0087
      GO TO 2021                                                        RNKT0088
 2001 SENSE LIGHT 1                                                     RNKT0089
 2002 H1        = H                                                     RNKT0090
      XXX       = X                                                     RNKT0091
      DO 2000 I = 1, N                                                  RNKT0092
 2000 Y1(I)     = Y(I)                                                  RNKT0093
      X1        = X                                                     RNKT0094
      SAME      = 6HADJSTP                                              RNKT0095
      CALL INTPOL (N, X, Y, DY, H, XOUT, YOUT, L, J, JMAX, M, LMAX)     RNKT0096
      IF (SENSE LIGHT 2) 2120, 2003                                     RNKT0097
 2003 CALL STEP (N, X, Y, DY, H, L, LMAX, SAME, NORD)                   RNKT0098
      DO 2010 I = 1, N                                                  RNKT0099
 2010 Y2(I)     = Y(I)                                                  RNKT0100
      X2        = X                                                     RNKT0101
      CALL INTPOL (N, X, Y, DY, H, XOUT, YOUT, L, J, JMAX, M, LMAX)     RNKT0102
      IF (SENSE LIGHT 2) 2120, 2013                                     RNKT0103
 2013 CALL STEP (N, X, Y, DY, H, L, LMAX, SAME, NORD)                   RNKT0104
      DO 2020 I = 1, N                                                  RNKT0105
      Y3(I)     = Y(I)                                                  RNKT0106
 2020 Y(I)      = Y1(I)                                                 RNKT0107
      X3        = X                                                     RNKT0108
      X         = XXX                                                   RNKT0109
      H         = 2.0 * H                                               RNKT0110
 2021 CALL STEP (N, X, Y, DY, H, L, LMAX, SAME, NORD)                   RNKT0111
      ORDER     = NORD                                                  RNKT0112
      DIV       = 2.0 **(NORD  + 1) - 2.0                               RNKT0113
      DO 2060 I = 1, N                                                  RNKT0114
      Y4(I)     = Y(I)                                                  RNKT0115
      DELY(I)   = ABSF (Y4(I) - Y3(I))                                  RNKT0116
      E(I)      = DELY(I) / DIV                                         RNKT0117
      IF (E(I) / ABSF(Y2(I)) -       TOL(I)) 2030, 2022, 2022           RNKT0118
 2022 IF ( ABSF ( Y2(I) / YMIN(I)) - 1.0 ) 2030, 2040, 2040             RNKT0119
 2030 HFIRST(I) = 1.0E+30                                               RNKT0120
      GO TO 2050                                                        RNKT0121
 2040 HORDER(I) = ABSF (Y2(I)) * TOL(I) / E(I)                          RNKT0122
      HFIRST(I) = HORDER(I) ** (1.0 / ( ORDER + 1.0))                   RNKT0123
 2050 CONTINUE                                                          RNKT0124
 2060 HFACT     = MIN1F (HFACT, HFIRST(I))                              RNKT0125
      IF (HFACT1 - HFACT) 2062, 2062, 2067                              RNKT0126
 2062 H         = 2.0 * H1                                              RNKT0127
      GO TO (2002, 2100), M                                             RNKT0128
 2067 H         = H1 * HFACT                                            RNKT0129
      GO TO (2070, 2100), M                                             RNKT0130
 2070 IF (SENSE LIGHT 1) 2080, 2095                                     RNKT0131
 2080 IF (ABSF(H) - ABSF(H1)) 2082, 2095, 2095                          RNKT0132
 2082 DO 2090 I = 1, N                                                  RNKT0133
 2090 Y(I)      = Y1(I)                                                 RNKT0134
      X         = XXX                                                   RNKT0135
      GO TO 2002                                                        RNKT0136
 2095 M         = 2                                                     RNKT0137
 2100 DO 2110 I = 1, N                                                  RNKT0138
 2110 Y(I)      = Y3(I)                                                 RNKT0139
 2120 RETURN                                                            RNKT0140
      END                                                               RNKT0141
*     LABEL                                                             RNKT0142
CSTEP                                                                   RNKT0143
      SUBROUTINE STEP (N, X, Y, DY, H, L, LMAX, NAME, NORD)             RNKT0144
      DIMENSION  Y(1), DY(1), Y0(50), P1(50), P2(50), P3(50), P4(50),   RNKT0145
     1           DELTAY(50)                                             RNKT0146
      NORD      = 4                                                     RNKT0147
 1000 DO 1010 I = 1, N                                                  RNKT0148
 1010 Y0(I)     = Y(I)                                                  RNKT0149
      X0        =X                                                      RNKT0150
      CALL DIFFEQ (N, X, Y, DY)                                         RNKT0151
      DO 1020 I = 1, N                                                  RNKT0152
      P1(I)     = DY(I) * H                                             RNKT0153
 1020 Y(I)      = Y0(I) + P1(I) / 2.0                                   RNKT0154
      X         = X0 + H / 2.0                                          RNKT0155
      CALL DIFFEQ (N, X, Y, DY)                                         RNKT0156
      DO 1030 I = 1, N                                                  RNKT0157
      P2(I)     = DY(I) * H                                             RNKT0158
 1030 Y(I)      = Y0(I) + P2(I) / 2.0                                   RNKT0159
      CALL DIFFEQ (N, X, Y, DY)                                         RNKT0160
      DO 1040 I = 1, N                                                  RNKT0161
      P3(I)     = DY(I) * H                                             RNKT0162
 1040 Y(I)      = Y0(I) + P3(I)                                         RNKT0163
      X         = X0 + H                                                RNKT0164
      CALL DIFFEQ (N, X, Y, DY)                                         RNKT0165
      DO 1050 I = 1, N                                                  RNKT0166
      P4(I)     = DY(I) * H                                             RNKT0167
      DELTAY(I) = (P1(I) + 2.0 * P2(I) + 2.0 * P3(I) + P4(I)) / 6.0     RNKT0168
 1050 Y(I)      = Y0(I) + DELTAY(I)                                     RNKT0169
      IF (L) 1090, 1090, 1060                                           RNKT0170
 1060 IF (LMAX - L) 1070, 1080, 1080                                    RNKT0171
 1070 L         = 0                                                     RNKT0172
      GO TO 1090                                                        RNKT0173
 1080 CALL CHECK (N, X, Y, DY, H, L, NAME)                              RNKT0174
      L         = L + 1                                                 RNKT0175
 1090 RETURN                                                            RNKT0176
      END                                                               RNKT0177
*     LABEL                                                             RNKT0178
CINTPOL                                                                 RNKT0179
      SUBROUTINE INTPOL (N, X, Y, DY, H, XOUT, YOUT, L, J, JMAX, M,LMAX)RNKT0180
      DIMENSION Y(1), DY(1), YOUT(1 ),YY(50), XOUT(1)                   RNKT0181
 5004 IF (ABSF(XOUT(J) - X) - ABSF(H)) 5001, 5001, 5020                 RNKT0182
 5001 GO TO (5003, 5002), M                                             RNKT0183
 5002 L         = 0                                                     RNKT0184
 5003 HOUT      = XOUT(J) - X                                           RNKT0185
      XX        = X                                                     RNKT0186
      DO 5000 I = 1, N                                                  RNKT0187
 5000 YY(I)     = Y(I)                                                  RNKT0188
      SAME      = 6HINTPOL                                              RNKT0189
      CALL STEP (N, XX, YY, DY, HOUT, L, LMAX, SAME, NORD)              RNKT0190
      XOUT(J)   = XX                                                    RNKT0191
      DO 5010 I = 1, N                                                  RNKT0192
 5010 YOUT(I)   = YY(I)                                                 RNKT0193
      CALL PRINT (N, XOUT, YOUT, DY, J)                                 RNKT0194
      J         = J + 1                                                 RNKT0195
      IF (J - JMAX) 5004, 5004, 5015                                    RNKT0196
 5015 SENSE LIGHT 2                                                     RNKT0197
      SENSE LIGHT 3                                                     RNKT0198
 5020 RETURN                                                            RNKT0199
      END                                                               RNKT0200
*     LABEL                                                             RNKT0201
CCHECK                                                                  RNKT0202
      SUBROUTINE CHECK (N, X, Y, DY, H, L, SAME)                        RNKT0203
      DIMENSION Y(1), DY(1)                                             RNKT0204
      WRITE OUTPUT TAPE 6, 6005, L, SAME, X, H                          RNKT0205
 6005 FORMAT (1H0, 49X, 4HL = I5/                                       RNKT0206
     1  49X, 44H THE SUBROUTINE WHICH CALLED STEP IS ****** A6/         RNKT0207
     2  49X, 46H THE MAGNITUDE OF THE INDEPENDENT VARIABLE IS 1PE14.5/  RNKT0208
     3  49X, 35H THE MAGNITUDE OF THE STEP SIZE IS 1PE14.5/             RNKT0209
     4  49X, 1H , 19HDEPENDENT VARIABLES)                               RNKT0210
      WRITE OUTPUT TAPE 6, 6025, (Y(I), I = 1, N)                       RNKT0211
 6025 FORMAT (50X, 1P5E14.5)                                            RNKT0212
      WRITE OUTPUT TAPE 6, 6035                                         RNKT0213
 6035 FORMAT (1H , 49X, 13HDIFFERENTIALS)                               RNKT0214
      WRITE OUTPUT TAPE 6, 6025, (DY(I), I = 1, N)                      RNKT0215
      RETURN                                                            RNKT0216
      END                                                               RNKT0217
*     LABEL                                                             RNKT0218
CPRINT                                                                  RNKT0219
      SUBROUTINE PRINT (N, XOUT, YOUT, DY, J)                           RNKT0220
      DIMENSION XOUT(1), YOUT(1), DY(1)                                 RNKT0221
      WRITE OUTPUT TAPE 6, 6005, J, XOUT(J), (YOUT(I), I = 1, N)        RNKT0222
 6005 FORMAT (1H0, I4, 1P9E13.5/(18X, 1P8E13.5))                        RNKT0223
      RETURN                                                            RNKT0224
      END                                                               RNKT0225
*  STEP (5TH ORDER)  THIS DECK SHOULD REPLACE STEP 4TH ORDER IF USED    RNKT0226
*     '''''''''  BOTH STEP 4 AND STEP 5 SHOULD NOT BE USED '''''''''''''RNKT0227
*     LABEL                                                             RNKT0228
CSTEP                                                                   RNKT0229
      SUBROUTINE STEP (N, X, Y, DY, H, L, LMAX, SAME, NORD)             RNKT0230
      DIMENSION Y(1), DY(1), Y0(50), DELTAY(50), P1(50), P2(50),        RNKT0231
     1          P3(50), P4(50), P5(50), P6(50)                          RNKT0232
      NORD      = 5                                                     RNKT0233
      DO 5000 I = 1, N                                                  RNKT0234
 5000 Y0(I)     = Y(I)                                                  RNKT0235
      X0        = X                                                     RNKT0236
      CALL DIFFEQ (N, X, Y, DY)                                         RNKT0237
      DO 5010 I = 1, N                                                  RNKT0238
      P1(I)     = DY(I) * H                                             RNKT0239
 5010 Y(I)      = Y0(I) + P1(I) / 3.0                                   RNKT0240
      X         = X0 + H / 3.0                                          RNKT0241
      CALL DIFFEQ (N, X, Y, DY)                                         RNKT0242
      DO 5020 I = 1, N                                                  RNKT0243
      P2(I)     = DY(I) * H                                             RNKT0244
 5020 Y(I)      = Y0(I) + 0.24 * P2(I) + 0.16 * P1(I)                   RNKT0245
      X         = X0 + 0.4 * H                                          RNKT0246
      CALL DIFFEQ (N, X, Y, DY)                                         RNKT0247
      DO 5030 I = 1, N                                                  RNKT0248
      P3(I)     = DY(I) * H                                             RNKT0249
 5030 Y(I)      = Y0(I) + 3.75 * P3(I) - 3.0 * P2(I) + 0.25 * P1(I)     RNKT0250
      X         = X0 + H                                                RNKT0251
      CALL DIFFEQ (N, X, Y, DY)                                         RNKT0252
      DO 5040 I = 1, N                                                  RNKT0253
      P4(I)     = DY(I) * H                                             RNKT0254
 5040 Y(I)      = Y0(I) + (8.0 * P4(I) - 50.0 * P3(I) + 90.0 * P2(I) +  RNKT0255
     1            6.0 * P1(I))/ 81.0                                    RNKT0256
      X         = X0 + 2.0 * H / 3.0                                    RNKT0257
      CALL DIFFEQ (N, X, Y, DY)                                         RNKT0258
      DO 5050 I = 1, N                                                  RNKT0259
      P5(I)     = DY(I) * H                                             RNKT0260
 5050 Y(I)      = Y0(I) + (8.0 * P4(I) + 10.0 * P3(I) + 36.0 * P2(I) +  RNKT0261
     1            6.0 * P1(I))/ 75.0                                    RNKT0262
      X         = X0 + 0.8 * H                                          RNKT0263
      CALL DIFFEQ (N, X, Y, DY)                                         RNKT0264
      DO 5060 I = 1, N                                                  RNKT0265
      P6(I)     = DY(I) * H                                             RNKT0266
      DELTAY(I) = (23.0 * P1(I) + 125.0 * P3(I) - 81.0 * P5(I) +        RNKT0267
     1             125.0 * P6(I)) / 192.0                               RNKT0268
 5060 Y(I)      = Y0(I) + DELTAY(I)                                     RNKT0269
      X         = X0 + H                                                RNKT0270
      IF (L) 1090, 1090, 1060                                           RNKT0271
 1060 IF (LMAX - L) 1070, 1080, 1080                                    RNKT0272
 1070 L         = 0                                                     RNKT0273
      GO TO 1090                                                        RNKT0274
 1080 CALL CHECK (N, X, Y, DY, H, L, SAME)                              RNKT0275
      L         = L + 1                                                 RNKT0276
 1090 RETURN                                                            RNKT0277
      END                                                               RNKT0278
