       LBL     JULIAN,X                                                      001
       REM                   JULIAN                                          002
       SPACE   5                                                             003
       REM       JULIAN IS A CALENDAR ROUTINE WHICH RETURNS A JULIAN         004
       REM     DATE TO A CALLING PROGRAM WHICH HAS SUPPLIED IT WITH AN       005
       REM     ORDINARY (GREGORIAN) DATE. THE JULIAN DATE, BY DEFINITION     006
       REM     IS THE NUMBER OF ELAPSED DAYS SINCE NOON JANUARY 0,4713BC     007
       REM     BY GREGORIAN RECKONING. SINCE THE JULIAN DAY STARTS AT        008
       REM     NOON RATHER THAN MIDNIGHT, THE RETURNED DATES WILL HAVE       009
       REM     A FRACTIONAL .5 ATTACHED.                                     010
       REM                                                                   011
       REM                   EXAMPLE                                         012
       REM        THE JULIAN DATE OF JANUARY FIRST 1900 0 HOURS UT           013
       REM     IS      2415020.5     .                                       014
       REM                                                                   015
       REM        SINCE THE JULIAN TIME SCALE IS LINEAR, THAT IS, IT         016
       REM     INVOLVES ONLY DAYS, AND NOT YEARS AND MONTHS, THE             017
       REM     DIFFERENCE BETWEEN TWO JULIAN DATES IS THE NUMBER OF          018
       REM     DAYS BETWEEN THE CORRESPONDING GREGORIAN DATES.               019
       REM                                                                   020
       REM                   EXAMPLE                                         021
       REM                                                                   022
       REM        J.D. OF  MARCH  IST 1960 IS    2436994.5                   023
       REM                                                                   024
       REM        J.D. OF  APRIL 22ND 1933 IS    2427184.5                   025
       REM                                                                   026
       REM        THE DIFFERENCE OF THESE TWO NUMBERS, 9810, IS THE          027
       REM     NUMBER OF DAYS BETWEEN THE TWO GIVEN GREGORIAN DATES.         028
       REM                                                                   029
       REM                             USE                                   030
       REM                                                                   031
       REM        FORTRAN CALLING PROGRAMS MAY USE THIS ROUTINE BY           032
       REM     APPENDING AN F TO THE ENTRY POINT NAME,I.E.,                  033
       REM          DATE1=JULIANF(DATE)                                      034
       REM     OR THE DIFFERENCE MAY BE COMPUTED DIRECTLY AS IN              035
       REM        ELAPSE=JULIANF(DAY1)-JULIANF(DAY2)                         036
       REM        THE INPUT IS A FLOATING POINT NUMBER IN THE FORM           037
       REM                   7.041776 FOR JULY 4TH 1776                      038
       REM                  12.312157 FOR DECEMBER 31ST 2157                 039
       REM     THE DECIMAL POINT MUST SEPARATE THE MONTH AND DAY             040
       REM     AND THERE MUST BE TWO DIGITS FOR THE DAY.                     041
       REM        THE ROUTINE WILL RETURN VALID RESULTS FOR ANY AD DATE      042
       REM     EARLIER THAN ABOUT 10,000 AD. THE RESULT WILL BE LEFT IN      043
       REM     THE ACCUMULATOR AS A NORMALIZED FLOATING POINT NUMBER.        044
       REM                                                                   045
       REM        FAP CALLING PROGRAMS USE THE FOLLOWING                     046
       REM                        CLA    DATE                                047
       REM                        TSX    $JULIAN,4                           048
       REM                        STO    ANSWER                              049
       REM                                                                   050
       REM     W. WELLER  DEARBORN OBSERVATORY  MARCH 1963                   051
       EJECT                                                                 052
       ENTRY   JULIAN                                                        053
       SPACE   2                                                             054
DIGITS MACRO   NUMBER                                                        055
       TRA     *+2                                                           056
       HTR     *                                                             057
       FMP     NUMBER                                                        058
       UFA     =O233000000000                                                059
       STQ     *-3                                                           060
       LRS     0                                                             061
       ANA     =O000000377777                                                062
       LLS     0                                                             063
       LDQ     *-7                                                           064
       STO     *-8                                                           065
       XCA                                                                   066
       FAD     =O233000000000                                                067
       XCA                                                                   068
       CLA     *-12                                                          069
DIGITS END                                                                   070
       SPACE   2                                                             071
SPLIT  MACRO   NINES                                                         072
       TRA     *+4                                                           073
       HTR     *-*                                                           074
       HTR     *-*                                                           075
       HTR     *-*                                                           076
       STO     *-1                                                           077
       SSP                                                                   078
       UFA     =O233000000000                                                079
       STQ     *-5                                                           080
       FAD     =O233000000000                                                081
       STO     *-8                                                           082
       CLA     *-8                                                           083
       FAD     =O233000000000                                                084
       STO     *-10                                                          085
       FSM     NINES                                                         086
       TMI     *+6                                                           087
       CLA     =0.0                                                          088
       STO     *-14                                                          089
       CLA     *-16                                                          090
       FAD     =1.00                                                         091
       STO     *-18                                                          092
       CLA     *-17                                                          093
       TPL     *+7                                                           094
       CLA     *-20                                                          095
       SSM                                                                   096
       STO     *-22                                                          097
       CLA     *-24                                                          098
       SSM                                                                   099
       STO     *-26                                                          100
       LDQ     *-26                                                          101
       CLA     *-28                                                          102
SPLIT  END                                                                   103
       SPACE   5                                                             104
AFIX   MACRO                                                                 105
       UFA     =O233000000000                                                106
       LRS     0                                                             107
       ANA     =O000000377777                                                108
       LLS     0                                                             109
AFIX   END                                                                   110
       EJECT                                                                 111
JULIAN XCA                                                                   112
       DIGITS  =1.                                                           113
       SUB     =1                                                            114
       STO     M                                                             115
       DIGITS  =100.                                                         116
       STO     D                                                             117
       FMP     =100.                                                         118
       SPLIT   =.992                                                         119
       STQ     DT                                                            120
       AFIX                                                                  121
       STO     C                                                             122
       LDQ     DT                                                            123
       FMP     =100.0                                                        124
       SPLIT   =.5                                                           125
       AFIX                                                                  126
       STO     Y                                                             127
       STZ     DT                                                            128
       SXA     BOX,4                                                         129
       CLA     C                                                             130
       ANA     =O3                                                           131
       TNZ     *+5                                                           132
       CLA     =1                                                            133
       STO     DT                                                            134
       CLA     Y                                                             135
       TRA     *+3                                                           136
       CLA     Y                                                             137
       TZE     *+13                                                          138
       LRS     2                                                             139
       ADD     DT                                                            140
       STO     DT                                                            141
       PXD     ,0                                                            142
       LLS     2                                                             143
       TNZ     *+7                                                           144
       CLA     M                                                             145
       ARS     1                                                             146
       TNZ     *+4                                                           147
       CLA     DT                                                            148
       SUB     =1                                                            149
       STO     DT                                                            150
       CLA     DT                                                            151
       ADD     D                                                             152
       STO     DT                                                            153
       LDQ     Y                                                             154
       MPY     =365                                                          155
       XCA                                                                   156
       ADD     DT                                                            157
       STO     DT                                                            158
       CLA     C                                                             159
       TNZ     *+3                                                           160
       CLA     =1721041                                                      161
       TRA     *+21                                                          162
       LRS     2                                                             163
       PAX     ,4                                                            164
       PXD     ,0                                                            165
       TXL     *+3,4,0                                                       166
       ADD     =146101                                                       167
       TXI     *-2,4,-1                                                      168
       ADD     =1721041                                                      169
       ADD     DT                                                            170
       STO     DT                                                            171
       CLA     C                                                             172
       ANA     =O3                                                           173
       TNZ     *+4                                                           174
       CLA     DT                                                            175
       SUB     =1                                                            176
       TRA     *+6                                                           177
       PAX     ,4                                                            178
       CLA     DT                                                            179
       TXL     *+3,4,0                                                       180
       ADD     =36525                                                        181
       TXI     *-2,4,-1                                                      182
       STO     DT                                                            183
       LXA     M,4                                                           184
       CLA     MONTAB,4                                                      185
       ADD     DT                                                            186
       AXT     1,4                                                           187
       SSP                                                                   188
       LRS     1                                                             189
       TZE     *+2                                                           190
       TXI     *-2,4,1                                                       191
       PXA     ,4                                                            192
       STQ     M                                                             193
       ADD     =O200                                                         194
       ALS     27                                                            195
       STO     C                                                             196
       PXD     ,0                                                            197
       LDQ     M                                                             198
       LLS     27                                                            199
       ORA     C                                                             200
       UFA     =O233000000000                                                201
       FAD     =O233000000000                                                202
       FAD     =.5                                                           203
       LXA     BOX,4                                                         204
       TRA     1,4                                                           205
D      PZE                                                                   206
DT     PZE                                                                   207
Y      PZE                                                                   208
BOX    PZE                                                                   209
C      PZE                                                                   210
M      PZE                                                                   211
       DEC     333                                                           212
       DEC     303                                                           213
       DEC     272                                                           214
       DEC     242                                                           215
       DEC     211                                                           216
       DEC     180                                                           217
       DEC     150                                                           218
       DEC     119                                                           219
       DEC     89                                                            220
       DEC     58                                                            221
       DEC     30                                                            222
