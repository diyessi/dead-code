      K      =PI,TF,DELT                                                        
      K      =M,C1,K,C2,F                                                       
      IC     =I1,I2                                                             
      NEG1   =K                                                                 
      START  =                                                                  
      M1     =I1,C1                                                             
      M2     =I2,NEG1                                                           
      S1     =F,M1,M2                                                           
      D1     =S1,M                                                              
      I1     =D1                                                                
      I2     =I1                                                                
      FIN1   =I2,C2                                                             
      FIN2   =IT,TF                                                             
      RO1    =PI,IT                                                             
      RO2    =PI,S1,D1,I1,I2,M1,M2                                              
      RO3    =PI                                                                
      END    =                                                                  
