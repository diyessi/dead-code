$IBFTC OUT     M94,LIST,REF,XR7                                                 
      SUBROUTINE OUT(N,A,B,C,D,E,F,G)                                           
      IF(N)11,12,11                                                             
   12 WRITE(6,27)                                                               
   27 FORMAT(5H0    )                                                           
      RETURN                                                                    
   11 CONTINUE                                                                  
      GO TO (1,2,3,4,5,6),N                                                     
    1 WRITE(6,21)B                                                              
   21 FORMAT(1PE12.4)                                                           
      GO TO 10                                                                  
    2 WRITE(6,22)B,C                                                            
   22 FORMAT(1P2E12.4)                                                          
      GO TO 10                                                                  
    3 WRITE(6,23)B,C,D                                                          
   23 FORMAT(1P3E12.4)                                                          
      GO TO 10                                                                  
    4 WRITE(6,24)B,C,D,E                                                        
   24 FORMAT(1P4E12.4)                                                          
      GO TO 10                                                                  
    5 WRITE(6,25)B,C,D,E,F                                                      
   25 FORMAT(1P5E12.4)                                                          
      GO TO 10                                                                  
    6 WRITE(6,26)B,C,D,E,F,G                                                    
   26 FORMAT(1P6E12.4)                                                          
   10 RETURN                                                                    
      END                                                                       
$IBFTC IN      M94,LIST,REF,XR7                                                 
      SUBROUTINE IN(A,B,C,D,E,F,DACK)                                           
      IF(DACK)10,10,20                                                          
   10 DACK = 1.0                                                                
      WRITE(6,100)                                                              
  100 FORMAT(23H1INPUT DATA AS FOLLOWS //5H DATA/5H CARD/14H COUNT    DA        
     1TA//)                                                                     
      ICT = 1                                                                   
   20 READ(32,1)A,B,C,D,E,F                                                     
    1 FORMAT(6F10.5)                                                            
      WRITE(6,2)ICT,A,B,C,D,E,F                                                 
    2 FORMAT(I4,1X,1P6E12.4//)                                                  
      ICT = ICT +1                                                              
      RETURN                                                                    
      END                                                                       
$IBFTC HEAD    M94,LIST,REF,XR7                                                 
      SUBROUTINE HEAD                                                           
      DIMENSION HD(60)                                                          
      READ(32,1000)(HD(I),I=1,60)                                               
 1000 FORMAT(12A6)                                                              
      WRITE(6,1001)(HD(I),I=1,60)                                               
 1001 FORMAT(1H1,12A6/(1X,12A6))                                                
      WRITE(6,1002)                                                             
 1002 FORMAT(//)                                                                
      RETURN                                                                    
      END                                                                       
$IBFTC FOREFR  M94,LIST,REF,XR7                                                 
      SUBROUTINE FOREFR(ITAPE)                                                  
      IXTP = ITAPE                                                              
      ENDFILE IXTP                                                              
      REWIND IXTP                                                               
      RETURN                                                                    
      END                                                                       
$IBFTC RDFOR   M94,LIST,REF,XR7                                                 
      SUBROUTINE RDFOR(NTAPE,TAR)                                               
      DIMENSION TAR(1)                                                          
      READ(NTAPE,1000)(TAR(J),J=1,14)                                           
 1000 FORMAT(13A6,A2)                                                           
      RETURN                                                                    
      END                                                                       
$IBFTC WRFOR   M94,LIST,REF,XR7                                                 
      SUBROUTINE WRFOR(KTAPE,TAR)                                               
      DIMENSION TAR(1)                                                          
      WRITE(KTAPE,2000)(TAR(J),J=1,14)                                          
 2000 FORMAT(13A6,A2)                                                           
      RETURN                                                                    
      END                                                                       
