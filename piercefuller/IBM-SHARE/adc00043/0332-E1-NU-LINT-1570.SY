* LINT      111 08263  LAGRANGE POLYNOMIAL INTERPOLATION                LINT 001
      SUBROUTINE LINT(NN,XX,DH,A0,IFLAG,FCT,CD)                         LINT 002
      DIMENSION A(500),AD1(500),AD2(500),FCT(500),COMPR(500), CD(3)     LINT 003
      WRITE OUTPUT TAPE 6,8999,(FCT(J),J=1,NN)                          LINT 004
 8999 FORMAT(54H1THE COMPUTER HAS BEEN GIVEN THE FOLLOWING INFORMATION/ LINT 005
     131H0THE VALUES OF THE FUNCTION ARE/(1X 10F10.4))                  LINT 006
      WRITE OUTPUT TAPE 6,9000,A0,DH                                    LINT 007
 9000 FORMAT(29H0THE VALUE OF THE MIDPOINT IS 5XF10.4/43H THE INCREMENT LINT 008
     1BETWEEN SUCCEEDING POINTS IS 5X F10.4/1H0/1H0/32H0THE RESULTS ARE LINT 009
     2AS FOLLOWS. . .)                                                  LINT 010
      P=(XX-A0)/DH                                                      LINT 011
      IP=P                                                              LINT 012
      XIP=IP                                                            LINT 013
      IF(XIP-P)1,999,1                                                  LINT 014
    1 XN=NN                                                             LINT 015
      COMP=1.0                                                          LINT 016
      IF(NN-2*(NN/2))102,2,102                                          LINT 017
    2 DO 3 J=2,NN                                                       LINT 018
      XJ=J                                                              LINT 019
    3 COMP=COMP*(P+0.5*XN-XJ)/(XN+1.-XJ)                                LINT 020
      A(1)=-COMP                                                        LINT 021
      DO 4 J=2,NN                                                       LINT 022
      JM=J-1                                                            LINT 023
      XK=JM-NN/2                                                        LINT 024
      COMPR(JM)=(XK-0.5*XN)/(0.5*XN+XK)                                 LINT 025
    4 A(J)=A(JM)*COMPR(JM)*(P-XK)/(P-XK-1.)                             LINT 026
      GO TO 201                                                         LINT 027
    5 DO 6 J=2,NN                                                       LINT 028
      XJ=J                                                              LINT 029
    6 COMP=COMP+1./(P+XN*0.5-XJ)                                        LINT 030
      AD1(1)=COMP*A(1)                                                  LINT 031
      DO 7 J=2,NN                                                       LINT 032
      JM=J-1                                                            LINT 033
      XK=JM-NN/2                                                        LINT 034
    7 AD1(J)=COMPR(JM)*(-A(JM)/(P-XK-1.)**2+AD1(JM)+AD1(JM)/(P-XK-1.))  LINT 035
      GO TO 202                                                         LINT 036
    8 DO 9 J=2,NN                                                       LINT 037
      XJ=J                                                              LINT 038
    9 COMP1=COMP1+1./(P+XN*0.5-XJ)**2                                   LINT 039
      AD2(1)=AD1(1)*COMP-A(1)*COMP1                                     LINT 040
      DO 10 J=2,NN                                                      LINT 041
      JM=J-1                                                            LINT 042
      XK=JM-NN/2                                                        LINT 043
   10 AD2(J)=COMPR(JM)*(-2.*AD1(JM)/(P-XK-1.)**2+2.*A(JM)/(P-XK-1.)**3  LINT 044
     1+AD2(JM)+AD2(JM)/(P-XK-1.))                                       LINT 045
      GO TO 203                                                         LINT 046
  102 NNM=NN-1                                                          LINT 047
      DO 103 J=1,NNM                                                    LINT 048
      XJ=J                                                              LINT 049
  103 COMP=COMP*(P+0.5*(XN-1.)-XJ)/(XN-XJ)                              LINT 050
      A(1)=COMP                                                         LINT 051
      DO 104 J=2,NN                                                     LINT 052
      JM=J-1                                                            LINT 053
      XK=JM-(NN+1)/2                                                    LINT 054
      COMPR(JM)=(XK-0.5*(XN-1.))/(0.5*(XN+1.)+XK)                       LINT 055
  104 A(J)=A(JM)*COMPR(JM)*(P-XK)/(P-XK-1.)                             LINT 056
      GO TO 201                                                         LINT 057
  105 DO 106 J=1,NNM                                                    LINT 058
      XJ=J                                                              LINT 059
  106 COMP=COMP+1./(P+0.5*(XN-1.)-XJ)                                   LINT 060
      AD1(1)=COMP*A(1)                                                  LINT 061
      DO 107 J=2,NN                                                     LINT 062
      JM=J-1                                                            LINT 063
      XK=JM-(NN+1)/2                                                    LINT 064
  107 AD1(J)=COMPR(JM)*(-A(JM)/(P-XK-1.)**2+AD1(JM)+AD1(JM)/(P-XK-1.))  LINT 065
      GO TO 202                                                         LINT 066
  108 DO 109 J=1,NNM                                                    LINT 067
      XJ=J                                                              LINT 068
  109 COMP1=COMP1+1./(P+0.5*(XN-1.)-XJ)**2                              LINT 069
      AD2(1)=AD1(1)*COMP-A(1)*COMP1                                     LINT 070
      DO 110 J=2,NN                                                     LINT 071
      JM=J-1                                                            LINT 072
      XK=JM-(NN+1)/2                                                    LINT 073
  110 AD2(J)=COMPR(JM)*(-2.*AD1(JM)/(P-XK-1.)**2+2.*A(JM)/(P-XK-1.)**3  LINT 074
     1+AD2(JM)+AD2(JM)/(P-XK-1.))                                       LINT 075
      GO TO 203                                                         LINT 076
  201 PRT=0.0                                                           LINT 077
      DO 301 I=1,NN                                                     LINT 078
  301 PRT=PRT+A(I)*FCT(I)                                               LINT 079
      CD(1)=PRT                                                         LINT 080
      WRITE OUTPUT TAPE 6,9001,XX,PRT                                   LINT 081
 9001 FORMAT(40H0THE VALUE OF THE LAGRANGE POLYNOMIAL AT F10.4,2X       LINT 082
     16HEQUALS 2X F12.4)                                                LINT 083
      IF(IFLAG)998,998,302                                              LINT 084
  302 COMP=0.0                                                          LINT 085
      IF(NN-2*(NN/2))105,5,105                                          LINT 086
  202 PRT=0.0                                                           LINT 087
      DO 303 I=1,NN                                                     LINT 088
  303 PRT=PRT+AD1(I)*FCT(I)                                             LINT 089
      PRT=PRT/DH                                                        LINT 090
      CD(2)=PRT                                                         LINT 091
      WRITE OUTPUT TAPE 6,9002,XX,PRT                                   LINT 092
 9002 FORMAT(64H0THE VALUE OF THE FIRST DERIVATIVE OF THE LAGRANGE POLYNLINT 093
     1OMIAL AT F10.4,2X 6HEQUALS 2X F12.4)                              LINT 094
      IF(IFLAG-1)998,998,304                                            LINT 095
  304 COMP1=0.0                                                         LINT 096
      IF(NN-2*(NN/2))108,8,108                                          LINT 097
  203 PRT=0.0                                                           LINT 098
      DO 305 I=1,NN                                                     LINT 099
  305 PRT=PRT+AD2(I)*FCT(I)                                             LINT 100
      PRT=PRT/DH**2                                                     LINT 101
      CD(3)=PRT                                                         LINT 102
      WRITE OUTPUT TAPE 6,9003,XX,PRT                                   LINT 103
 9003 FORMAT(65H0THE VALUE OF THE SECOND DERIVATIVE OF THE LAGRANGE POLYLINT 104
     1NOMIAL AT F10.4,2X 6HEQUALS 2X F12.4)                             LINT 105
      GO TO 998                                                         LINT 106
  999 WRITE OUTPUT TAPE 6,9004                                          LINT 107
 9004 FORMAT(71H1SUBROUTINE LINT CANNOT PERFORM COMPUTATIONS AT ANY OF TLINT 108
     1HE GIVEN POINTS)                                                  LINT 109
  998 RETURN                                                            LINT 110
      END                                                               LINT 111
