*     L A B E L                                                                 
*      C A R D S    C O L U M N                                                 
*     F A P                                                                     
*                        STORAGE TO CARD HOLLERITH FOR THE 7090             0001
       COUNT   30                                                           0002
       LBL     SCH,N                                                        0003
       ENTRY   (SCH)                                                        0004
 (SCH) LDQ     *+3           WE ARE GOING TO USE                            0005
       CLA     *+3           OUTPUT TAPE NO. 6                              0006
       TRA*    $(IOH)                                                       0007
       TRA     SCH                                                          0008
       PZE     0,0,6         OUTPUT TAPE NO.                                0009
       REM                                                                  0010
 SCH   SXA     AXT4,4        SAVE IX4                                       0011
 TEST  TSX     $(WER),4      CHECK PREVIOUS OUTPUT.                         0012
       SXA     AXT2,2        SAVEIX2                                        0013
       LXA     AXT4,4                                                       0014
       AXT     14,2                                                         0015
       CLA     BLANKS                                                       0016
       STO     BUFF+14,2                                                    0017
       TIX     *-1,2,1                                                      0018
       CLA     1,4                                                          0019
       PDX     0,2                                                          0020
       STA     LOAD                                                         0021
       AXT     0,4                                                          0022
       CAL     DOLL          PICK UP A DOLLAR SIGN                          0023
 LOAD  LDQ     **,4                                                         0024
       LGL     30            MOVE OVER THE WHOLE BUFFER                     0025
 STOR  SLW     BUFF,4        WITH A DOLLAR SIGN AS THE FIRST CHARACTER      0026
       LGL     6                                                            0027
       TXI     *+1,4,-1                                                     0028
       TIX     LOAD,2,1                                                     0029
       LDQ     DOLL          FILL OUT THE LAST WORD                         0030
       LGL     30            WITH FIVE BLANKS                               0031
 LAST  SLW     BUFF,4                                                       0032
       CAL     TEST                                                         0033
       SLW*    $(TES)                                                       0034
       XEC*    $(WRS)                                                       0035
       AXC     IOC,4                                                        0036
       PXA     0,4                                                          0037
       STA*    $(WTC)                                                       0038
       XEC*    $(RCH)                                                       0039
 AXT2  AXT     **,2                                                         0040
 AXT4  AXT     **,4                                                         0041
       TRA     2,4                                                          0042
 BUFF  BSS     14                                                           0043
BLANKS BCD 1                                                                0044
 DOLL  BCD 1     $                                                          0045
 IOC   IOST    BUFF,,14                                                     0046
       END                                                                  0047
