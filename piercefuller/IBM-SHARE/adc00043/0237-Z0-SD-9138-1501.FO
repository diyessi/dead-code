      FUNCTION  DEV(TR,PR,TC,PC,W)                                      9138 201
      DEV = PR*(4.996*(TR-1.0)*W**2 + (0.01734-0.0002754*PC-0.09772     9138 202
     2*TC**2)*PR + (0.03086+0.07683/PC)*(TR-1.0)**3 - 0.000001819       9138 203
     3*PC*(TR-1.0)*PR**2) / (TR**4+(0.689-0.8316*TC)*TC*PR**3)          9138 204
      RETURN                                                            9138 205
      END                                                               9138 206
      FUNCTION FUGAM(Q,E,Z)                                             9138 207
      FUGAM = (Z-1.0 - LOGF(Z-Q) - E*LOGF(1.0+Q/Z))                     9138 208
      RETURN                                                            9138 209
      END                                                               9138 210
      FUNCTION FUDEM(BA,BB,BC,BDD,PR)                                   9138 211
      BD = BDD*PR                                                       9138 212
      HE = LOGF((1.0 + BD)**2/(1.0 - BD + BD**2))                       9138 213
      HD = 3.4641*ATANF(1.1547*BD-0.57735)                              9138 214
      CC = -LOGF(1.0+BD**3)                                             9138 215
      FUDEM = (BA - BB)*HE + (BA + BB)*(HD + 1.8318) + BC*CC            9138 216
      RETURN                                                            9138 217
      END                                                               9138 218
      FUNCTION FUGAC(Q,E,Z,BR,AR)                                       9138 219
      FUGAC = ((Z-1.0)*BR - LOGF(Z-Q) - E*AR*LOGF(1.0+Q/Z))             9138 220
      RETURN                                                            9138 221
      END                                                               9138 222
