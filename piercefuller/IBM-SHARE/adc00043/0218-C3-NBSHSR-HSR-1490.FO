*     NBS HSR                                                           HSR00000
      SUBROUTINE SERIES (A,B,V,SUMR,SUMI)                               HSR00001
      CALL ZMPY(.25*A,.25*B,A,B,SQR,SQI)                                HSR00002
      IF(V) 6,5,6                                                       HSR00003
    5 TERMR=1.                                                          HSR00004
      GO TO 7                                                           HSR00005
    6 TERMR=1./V                                                        HSR00006
    7 TERMI=0.                                                          HSR00007
      SUMR=TERMR                                                        HSR00008
      SUMI=TERMI                                                        HSR00009
      EN=0.                                                             HSR00010
   10 EN=EN+1.                                                          HSR00011
      CALLZMPY(TERMR,TERMI,-SQR/(EN*(V+EN)),-SQI/(EN*(V+EN)),           HSR00012
     1TERMR,TERMI)                                                      HSR00013
      SUMR=SUMR+TERMR                                                   HSR00014
      SUMI=SUMI+TERMI                                                   HSR00015
      IF((TERMR*TERMR+TERMI*TERMI)/(SUMR*SUMR+SUMI*SUMI)-1.E-17)20,20,10HSR00016
   20 RETURN                                                            HSR00017
      END                                                               HSR00018
