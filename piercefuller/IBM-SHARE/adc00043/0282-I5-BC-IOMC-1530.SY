*      BC I9 IOMC - I/O MACROS FOR SHARE DISTRIBUTION                           
       NOCRS                                                            IOMC  01
READ   MACRO   A,B                                                      IOMC  02
       CAL     =O5000000                                                        
       TSX     $(TSH),4                                                         
       TSX     A,0                                                              
       IRP     B                                                        IOMC  05
       A.R.G   O.P.I,B                                                  IOMC  06
       IRP                                                              IOMC  07
       TSX     $(RTN),4                                                 IOMC  08
READ   END                                                              IOMC  09
WRITE  MACRO   A,B                                                      IOMC  10
       CAL     =O6000000                                                        
       TSX     $(STH),4                                                         
       TSX     A,0                                                              
       IRP     B                                                        IOMC  13
       A.R.G   O.P.O,B                                                  IOMC  14
       IRP                                                              IOMC  15
       TSX     $(FIL),4                                                 IOMC  16
WRITE  END                                                              IOMC  17
PUNCH  MACRO   A,B                                                      IOMC  18
       CAL     =O7000000                                                        
       TSX     $(STH),4                                                         
       TSX     A,0                                                              
       IRP     B                                                        IOMC  21
       A.R.G   O.P.O,B                                                  IOMC  22
       IRP                                                              IOMC  23
       TSX     $(FIL),4                                                 IOMC  24
PUNCH  END                                                              IOMC  25
A.R.G  MACRO   OP,C,D,E,F                                               IOMC  26
       IFF     1,D                                                      IOMC  27
       OP      C                                                        IOMC  28
       IFF     0,D                                                      IOMC  29
       C.H.EK  OP,C,D,E,F                                               IOMC  30
A.R.G  END                                                              IOMC  31
C.H.EK MACRO   OP,C,D,E,F                                               IOMC  32
       IFF     1,E                                                      IOMC  33
       S.U.BC  OP,C,D                                                   IOMC  34
       IFF     0,E                                                      IOMC  35
       L.O.OP  OP,C,D,E,F                                               IOMC  36
C.H.EK END                                                              IOMC  37
S.U.BC MACRO   OP,C,D                                                   IOMC  38
       LAC     D,4                                                      IOMC  39
       OP      C'-1,(,4)                                                IOMC  40
S.U.BC END                                                              IOMC  41
L.O.OP MACRO   OP,C,D,E,F                                               IOMC  42
       LAC     E,4                                                      IOMC  43
       TXI     *+1,4,-1                                                 IOMC  44
       SXD     *+4,4                                                    IOMC  45
       IFF     0,F                                                      IOMC  46
       LAC     F,4                                                      IOMC  47
       IFF     1,F                                                      IOMC  48
       LXD     *-2,4                                                    IOMC  49
       SXD     *+5,4                                                    IOMC  50
       LAC     D,4                                                      IOMC  51
       TXL     *+4,4,**                                                 IOMC  52
       OP      C'-1,(,4)                                                IOMC  53
       TXI     *-3,4,**                                                 IOMC  54
L.O.OP END                                                              IOMC  55
O.P.I  MACRO   A,B                                                      IOMC  56
       STR                                                              IOMC  57
       STQ     A'B                                                      IOMC  58
O.P.I  END                                                              IOMC  59
O.P.O  MACRO   A,B                                                      IOMC  60
       LDQ     A'B                                                      IOMC  61
       STR                                                              IOMC  62
O.P.O  END                                                              IOMC  63
