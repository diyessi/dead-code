*     FAP                                                               FIND0001
*      SUBROUTINE FIND                                                  FIND0002
*      CALLED BY ...         CALL FIND                                  FIND0003
*                            FORTRAN READ INPUT LIST STATEMENT          FIND0004
       LBL     FIND,X                                                   FIND0005
       COUNT   100                                                      FIND0006
       ENTRY   FIND                                                     FIND0007
       BCI     1,FIND                                                   FIND0008
 SX4   PZE     0                                                        FIND0009
 FIND  SXD     SX4,4                                                    FIND0010
*      SEARCH FOR TSX **,4 AND LOOK FOR TSX (TSH),4                     FIND0011
 NX    CAL     1,4                                                      FIND0012
       ANA     =O777777700000                                           FIND0013
       ERA     TSX4                                                     FIND0014
       TNZ     TXI                                                      FIND0015
       CLA     2,4                                                      FIND0016
       STA     FORM                                                     FIND0017
       CLA     1,4                                                      FIND0018
       STA     TRA                                                      FIND0019
       STA     TRB                                                      FIND0020
       STA     *+1                                                      FIND0021
       CAL     **                                                       FIND0022
       ERA     $(TSH)                                                   FIND0023
       TZE     *+2                                                      FIND0024
 TXI   TXI     NX,4,-1                                                  FIND0025
       CLA     TRAP                                                     FIND0026
 TRA   STO     **                                                       FIND0027
       LXD     SX4,4                                                    FIND0028
       TRA     1,4                                                      FIND0029
 TRAP  TRA     *+1                                                      FIND0030
       SXD     SX4,4                 ENTRY FROM         (TSH)           FIND0031
       CLA     $(TSH)                                                   FIND0032
 TRB   STO     **                                                       FIND0033
       CLA     2                                                        FIND0034
       STO     C(2)                                                     FIND0035
       CLA     SW                                                       FIND0036
       STP     SW                                                       FIND0037
       CLA     STRAP                                                    FIND0038
       STO     2                                                        FIND0039
       STZ     N                                                        FIND0040
       SXA     S1,0                                                     FIND0041
       SXA     S2,0                                                     FIND0042
       LXD     SX4,4                                                    FIND0043
       TRA     2,4                                                      FIND0044
 STRAP TRA     *+1                   ENTRY FROM STORE AND TRAP          FIND0045
       CLA     0                                                        FIND0046
       STA     EXIT                                                     FIND0047
 SW    TXH     SPS                                                      FIND0048
       SXD     SX4,4                                                    FIND0049
 RETF  CLA     N                                                        FIND0050
       SUB     =1                                                       FIND0051
       STO     N                                                        FIND0052
       TMI     GETF                                                     FIND0053
 FUNC  TSX     $FLDEC,4                                                 FIND0054
       PZE     =O3000000                                                FIND0055
       STO     WORD                                                     FIND0056
       TSX     $TESDEC,4                                                FIND0057
       PZE     DMP                                                      FIND0058
       TZE     SPCH                                                     FIND0059
       TMI     ALFA                                                     FIND0060
 ASW   TXH     SPCH                  TRANSFER IF ALPHA SPECIFIED        FIND0061
       LXD     SX4,4                                                    FIND0062
       LDQ     WORD                                                     FIND0063
 EXIT  TRA     **                                                       FIND0064
 ALFA  TXH     ASW+1                                                    FIND0065
 SPCH  CAL     TXL                   SUSPEND TRANSMISSION               FIND0066
       STP     SW                                                       FIND0067
       TRA     ASW+1                                                    FIND0068
 SPS   LDQ     =0                                                       FIND0069
       TRA     EXIT                                                     FIND0070
 GETF  SXA     I1,1                  SCAN FORMAT STATEMENT              FIND0071
       SXA     I2,2                                                     FIND0072
 S1    AXT     **,1                                                     FIND0073
 S2    AXT     **,2                                                     FIND0074
       LDQ     MQ                                                       FIND0075
 ISH   STZ     N                                                        FIND0076
 NXT   TIX     NXCH,2,1                                                 FIND0077
       AXT     6,2                                                      FIND0078
 FORM  LDQ     **,1                                                     FIND0079
       TXI     *+1,1,1                                                  FIND0080
 NXCH  PXD     ,0                                                       FIND0081
       LGL     6                                                        FIND0082
       STO     CH                                                       FIND0083
       PAX     ,4                                                       FIND0084
       TXH     AL,4,9                                                   FIND0085
       CLA     N                                                        FIND0086
       ALS     2                                                        FIND0087
       ADD     N                                                        FIND0088
       ALS     1                                                        FIND0089
       ADD     CH                                                       FIND0090
       STO     N                                                        FIND0091
       TRA     NXT                                                      FIND0092
 AL    TXL     ALL,4,23                                                 FIND0093
       TXL     ISH,4,24                                                 FIND0094
       TXL     ALL,4,27                                                 FIND0095
       TXL     ENDFM,4,28                                               FIND0096
       TXL     ALL,4,47                                                 FIND0097
       TXL     NXT,4,48                                                 FIND0098
       TXL     ENDFM,4,59                                               FIND0099
       TXL     NXT,4,60                                                 FIND0100
 ALL   CLA     N                                                        FIND0101
       TNZ     *+3                                                      FIND0102
       CLA     =1                                                       FIND0103
       STO     N                                                        FIND0104
       SXA     S1,1                                                     FIND0105
       SXA     S2,2                                                     FIND0106
       STQ     MQ                                                       FIND0107
 I1    AXT     **,1                                                     FIND0108
 I2    AXT     **,2                                                     FIND0109
 TXL   TXL     ISA,4,17                                                 FIND0110
       TXL     ISF,4,22                                                 FIND0111
       TXL     ISI,4,25                                                 FIND0112
 ENDFM AXT     0,1                                                      FIND0113
       AXT     0,2                                                      FIND0114
       TRA     S2+1                  REPEAT FORMAT                      FIND0115
 ISA   CAL     TXL                                                      FIND0116
       STP     ALFA                                                     FIND0117
       STP     ASW                                                      FIND0118
       TRA     RETF                                                     FIND0119
 ISI   CLA     $INDEC                                                   FIND0120
       STA     FUNC                                                     FIND0121
       CLA     TXL                                                      FIND0122
       TRA     ISA+1                                                    FIND0123
 ISF   CLA     $FLDEC                                                   FIND0124
       TRA     ISI+1                                                    FIND0125
 TSX4  TSX     0,4                                                      FIND0126
 DMP   DEC     0                                                        FIND0127
 MQ    DEC     0                                                        FIND0128
 N     DEC     0                                                        FIND0129
 WORD  DEC     0                                                        FIND0130
 CH    DEC     0                                                        FIND0131
       COMMON  -166                                                     FIND0132
 C(2)  COMMON  1                     SEE ROUTINE(RTN) IN (IOH)          FIND0133
       END                                                              FIND0134
