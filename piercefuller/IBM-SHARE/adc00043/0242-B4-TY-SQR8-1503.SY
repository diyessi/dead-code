       COUNT  50      SQRT F VERSION 8                                  SQR80001
       ENTRY  SQRT    SQRTF(X)=X/ABSF(X)**(1/2)                         SQR80002
 SQRT  TZE    1,4             =(2**I)*R  WHERE                          SQR80003
       LDQ    EXPT    ABSF(X)=(2**(2I-J))*F, J=0 OR 1                   SQR80004
       SXA    AXT,4   WE WANT R**2=G=F/2**J                             SQR80005
       LRS    27      MQ=F ROUNDED WITH SIGN                            SQR80006
       AXT    0,4                                                       SQR80007
       LBT                                                              SQR80008
 EVEN  AXT    1,4     XR4=1-J                                           SQR80009
 ODD   ACL    EXPT,4                                                    SQR80010
       STO    I       NEW EXPONENT                                      SQR80011
       XCA                                                              SQR80012
       LAS    RTHAF   COMPARE F WITH (1/2)**(1/2)                       SQR80013
 HI    LRS    10,4    IF XR4=0, 1/4.LT.G.LT.(1/2)**(3/2)                SQR80014
       TXI    LO+1,4,2       1, 1/2.LT.G.LT.(1/2)**(1/2)                SQR80015
 LO    LRS    10,4           2, (1/2)**(3/2).LT.G.LT.1/2                SQR80016
       SLQ    I              3, (1/2)**(1/2).LT.G.LT.1                  SQR80017
       STO    G       STORE G/2 WITH SIGN                               SQR80018
       ACL    C,4                                                       SQR80019
       SLW    R                                                         SQR80020
       CLS    B,4                                                       SQR80021
       VDH    R,0,27                                                    SQR80022
       XCA                                                              SQR80023
       ADD    A,4                                                       SQR80024
       STO    R       R/2=A-B/(C+G/2) TO 4 SIG. FIGS.                   SQR80025
       CLA    G                                                         SQR80026
       LDQ    I       (AC,MQ)=SIGN, G/2, 2**I                           SQR80027
       VDH    R,0,26                                                    SQR80028
       XCA                                                              SQR80029
       ACL    R       NEW R =R/2+(G/2)/(R/2)/2                          SQR80030
 AXT   AXT    *-*,4         =G**(1/2)   (WITH SIGN)                     SQR80031
       TRA    1,4     TO 8 SIG. FIGS. UNLESS X IS UNNORMALIZED          SQR80032
       OCT    000000000200     NOTE - ROUTINE MAY HANG UP IF            SQR80033
 EXPT  OCT    362000000201     ENTERED WITH 1 IN P OR Q SUCH            SQR80034
 RTHAF DEC    0.707106781B0    THAT SQRTF(X) WOULD OVERFLOW.            SQR80035
       DEC    2.7741703B9      A3                                       SQR80036
       DEC    1.9489107B9                                               SQR80037
       DEC    2.3176585B9                                               SQR80038
 A     DEC    1.6388320B9                                               SQR80039
       DEC    6.3157259B10     B3                                       SQR80040
       DEC    2.1902354B10                                              SQR80041
       DEC    3.6835222B10                                              SQR80042
 B     DEC    1.3023217B10                                              SQR80043
       DEC    2.5598195B9      C3                                       SQR80044
       DEC    1.2637122B9                                               SQR80045
       DEC    1.7871590B9                                               SQR80046
 C     DEC    0.8935795B9                                               SQR80047
       COMMON -206+1           +WK.SP.  77774-6                         SQR80048
 R     COMMON 1                                                         SQR80049
 G     COMMON 1                                                         SQR80050
 I     COMMON 1                V.KAHAN, JUNE 9, 1963                    SQR80051
       END                                                              SQR80052
