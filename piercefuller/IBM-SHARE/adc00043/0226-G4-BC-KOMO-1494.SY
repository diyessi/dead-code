       TRA     LSTAL                                                    KOMO 163
*              FORM T1 AND T2 WHEN THERE ARE 2 PRIMES                   KOMO 164
 UP2   LGL     9                                                        KOMO 165
 LSTNP ORS*    PFX0          INSERT LAST NP                             KOMO 166
       XCL                                                              KOMO 167
 LSTAL ORS*    PFX0A         INSERT LAST ALPHA                          KOMO 168
T1CNT  TXI     *+1,3,-1                                                 KOMO 169
