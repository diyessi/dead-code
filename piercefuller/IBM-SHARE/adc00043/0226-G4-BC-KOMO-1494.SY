 ADVP  TXI     PRITB2,2,1                                               KOMO 082
 DONE  SXD     PFX,1                                                    KOMO 083
 FX2   AXT     *-*,2                                                    KOMO 084
 FX3   AXT     *-*,3                                                    KOMO 085
       PXA     0,1                                                      KOMO 086
       STO     SUMP             SUMP= N, THE NUMBER OF PRIMES           KOMO 087
 REPL  CLA     FACT+1,1      PICK UP PRIME                              KOMO 088
