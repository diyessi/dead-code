PRIFIN SXD     NPMAX,3                                                  KOMO 054
*              FORM T1 AND T2 TABLES - THE PRIME                        KOMO 055
*              DECOMPOSITIONS OF THE NUMBERS FROM 2 TO FMAX             KOMO 056
       LXD     FMAX1,3                                                  KOMO 057
 T1GEN SXA     COMP,3                                                   KOMO 058
FACTOR SXA     FX2,2                                                    KOMO 059
       SXA     FX3,3                                                    KOMO 060
       AXT     1,2                                                      KOMO 061
       AXT     0,1                                                      KOMO 062
PRITB2 CLA     PTABLE+1,2                                               KOMO 063
       STO     PRIME                                                    KOMO 064
       PXD     0,0                                                      KOMO 065
       LDQ     COMP                                                     KOMO 066
       DVH     PRIME                                                    KOMO 067
       TNZ     ADVP                                                     KOMO 068
       AXT     1,3                                                      KOMO 069
 REDUC STQ     COMP                                                     KOMO 070
