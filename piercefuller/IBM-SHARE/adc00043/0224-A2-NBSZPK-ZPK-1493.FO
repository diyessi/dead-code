*     NBS ZPK            FIRST SUBROUTINE IS NBS ZMPY                   ZPK00000
      SUBROUTINE ZMPY(A , B , C , D , X , Y )                           ZPK00001
      EX=(A*C-B*D)                                                      ZPK00002
      Y=A*D+C*B                                                         ZPK00003
      X=EX                                                              ZPK00004
      RETURN                                                            ZPK00005
      END                                                               ZPK00006
*     NBS ZDIV                                                          ZPK00007
      SUBROUTINE ZDIV(A, B, C, D, X, Y)                                 ZPK00008
C     ZDIV RETURNS X+I*Y=(A+I*B)*/(C+I*D)                               ZPK00009
      DEN=C*C+D*D                                                       ZPK00010
      IF(DEN) 12, 12, 11                                                ZPK00011
   11 EX=(A*C+B*D)/DEN                                                  ZPK00012
      Y=(C*B-A*D)/DEN                                                   ZPK00013
      X=EX                                                              ZPK00014
      RETURN                                                            ZPK00015
   12 WRITE OUTPUT TAPE 6,13                                            ZPK00016
   13 FORMAT(21H ZERO DIVISOR IN ZDIV)                                  ZPK00017
      CALL EXIT                                                         ZPK00018
      END                                                               ZPK00019
*     NBS ZSQRT                                                         ZPK00020
      SUBROUTINE ZSQRT (A, B, X, Y)                                     ZPK00021
      S=1.                                                              ZPK00022
      IF(B) 1,5,5                                                       ZPK00023
    1 S=-1.                                                             ZPK00024
    5 IF(A) 2,4,2                                                       ZPK00025
    2 X=SQRTF(.5*(SQRTF(A*A+B*B)+ABSF(A)))                              ZPK00026
      D=B/(2.*X)                                                        ZPK00027
      Y=D                                                               ZPK00028
      IF(A) 3,10,10                                                     ZPK00029
    3 Y=S*X                                                             ZPK00030
      X=S*D                                                             ZPK00031
      GO TO 10                                                          ZPK00032
    4 X=SQRTF(S*B*.5)                                                   ZPK00033
      Y=S*X                                                             ZPK00034
   10 RETURN                                                            ZPK00035
      END                                                               ZPK00036
*     NBS ZSIN                                                          ZPK00037
      SUBROUTINE ZSIN(A,B,X,Y,MAG)                                      ZPK00038
      SIG=1.                                                            ZPK00039
      MAG=B                                                             ZPK00040
      SCALE=MAG                                                         ZPK00041
      IF(SCALE) 5,10,10                                                 ZPK00042
    5 SIG=-1.                                                           ZPK00043
      MAG=-MAG                                                          ZPK00044
   10 EA=EXPF(B-SIG*SCALE)                                              ZPK00045
      EB=EXPF(-B-SIG*SCALE)                                             ZPK00046
      X=COSF(A)*(EA-EB)*.5                                              ZPK00047
      Y=SINF(A)*(EB+EA)*.5                                              ZPK00048
      RETURN                                                            ZPK00049
      END                                                               ZPK00050
*     NBS ZEXP                                                          ZPK00051
      SUBROUTINE ZEXP(A,B,X,Y,MAGTUD)                                   ZPK00052
      MAGTUD=A                                                          ZPK00053
      SCALE=MAGTUD                                                      ZPK00054
      E=EXPF(A-SCALE)                                                   ZPK00055
      X=E*COSF(B)                                                       ZPK00056
      Y=E*SINF(B)                                                       ZPK00057
      RETURN                                                            ZPK00058
      END                                                               ZPK00059
*     NBS POLAR                                                         ZPK00060
      SUBROUTINE POLAR(X,Y,R,THETA)                                     ZPK00061
      S=1.                                                              ZPK00062
      R=SQRTF(X*X+Y*Y)                                                  ZPK00063
      IF(Y) 2, 3, 3                                                     ZPK00064
    2 S=-1.                                                             ZPK00065
    3 IF(X) 10,5,15                                                     ZPK00066
    5 THETA=S*1.5707963268                                              ZPK00067
      RETURN                                                            ZPK00068
   10 THETA=S*3.141592654 + ATANF(Y/X)                                  ZPK00069
      RETURN                                                            ZPK00070
   15 THETA=ATANF(Y/X)                                                  ZPK00071
      RETURN                                                            ZPK00072
      END                                                               ZPK00073
