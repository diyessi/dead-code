       ENDUP                                                            EDA00200
*      FAP     ( REASSEMBLE FORTRAN SYSTEM EDITOR FOR MAD )             EDB00000
       UPDATE  11                                                       EDB00000
       DELETE THRU                                                      EDB00020
F1     CAL     CTRL                                                   MIEDB02300
       ZET     MADFLG        IS THIS MAD                              MIEDB04031
       TRA     MADMRE        YES                                      MIEDB04032
       ZET     MADFLG        IS THIS MAD                              MIEDB07571
       TRA     MWRITE        YES                                      MIEDB07572
OVER   LXD     WBUF+1,4      HERE IF RECORD TOO LARGE                 MIEDB13960
       TXL     OVER.,4,349   CHECK FOR MAD (RECORD 35.0)              MIEDB13961
       TXL     MADRT,4,350   SKIP IF FOUND                            MIEDB13962
OVER.  TSX     PRINT,4       OTHERWISE PRINT RECORD TOO LARGE         MIEDB13963
       REM                                                            MIEDB16090
MADRT  STL     MADFLG        HERE WHEN RECORD CARD FOR MAD FOUND      MIEDB16100
       CAL     WTBS                                                   MIEDB16101
       ARS     9                                                      MIEDB16102
       PAC     0,1                                                    MIEDB16103
       STL     TESTER,1                                               MIEDB16104
       STL     TCOS                                                   MIEDB16106
       XEC     TCOS                                                   MIEDB16107
       XEC     TRCS                                                   MIEDB16108
       CAL     CTRL+2                                                 MIEDB16110
       SLW     MADB                                                   MIEDB16120
       CAL     CTRL+3                                                 MIEDB16130
       SLW     MADB+1                                                 MIEDB16140
       CAL     WBUF                                                   MIEDB16150
       SLW     MWBUF                                                  MIEDB16160
       CAL     WBUF+1                                                 MIEDB16170
       SLW     MWBUF+1                                                MIEDB16180
       CAL     IBUF                                                   MIEDB16190
       SLW     MIBUF                                                  MIEDB16200
       CAL     IBUF+1                                                 MIEDB16210
       SLW     MIBUF+1                                                MIEDB16220
       CAL     OBUF                                                   MIEDB16230
       SLW     MOBUF                                                  MIEDB16240
       CAL     OBUF+1                                                 MIEDB16250
       SLW     MOBUF+1                                                MIEDB16260
       LXD     MADB,4        MAD RECORD WORD COUNT                    MIEDB16270
       PXA     0,4           CLEAR BUFFER FOR MAD                     MIEDB16280
       ADD     LOBUF2        ..                                       MIEDB16290
       STA     *+1           ..                                       MIEDB16300
       STZ     **,4          ..                                       MIEDB16310
       TIX     *-1,4,1       ..                                       MIEDB16320
       TRA     F1            BACK TO EDITOR                           MIEDB16330
       REM                                                            MIEDB16340
MADMRE CAL     MADB          HERE FOR MAD BINARY DATA CARD            MIEDB16350
       STA     TEMP                                                   MIEDB16360
       CAL     CTRL                                                   MIEDB16370
       ANA     =O77777                                                MIEDB16380
       CAS     LOWLOC                                                 MIEDB16390
       TRA     *+3                                                    MIEDB16400
       TRA     *+2                                                    MIEDB16410
       TRA     ERROR                                                  MIEDB16420
       CAL     CTRL                                                   MIEDB16430
       ARS     18                                                     MIEDB16440
       ADD     CTRL                                                   MIEDB16450
       ANA     =O177777                                               MIEDB16460
       CAS     LHILOC                                                 MIEDB16470
       TRA     ERROR                                                  MIEDB16480
       NOP                                                            MIEDB16490
       CAL     CTRL                                                   MIEDB16500
       SUB     TEMP                                                   MIEDB16510
       ADD     LOBUF2                                                 MIEDB16520
       STA     *+4                                                    MIEDB16530
       PDX     0,1                                                    MIEDB16540
       AXT     0,2                                                    MIEDB16550
       CAL     CTRL+1,2                                               MIEDB16560
       SLW     **,2                                                   MIEDB16570
       TXI     *+1,2,-1                                               MIEDB16580
       TIX     *-3,1,1                                                MIEDB16590
       TRA     ENTERC                                                 MIEDB16600
       REM                                                            MIEDB16610
MWRITE CAL     MADB+1        HERE TO WRITE MAD ON SYSTEM TAPE         MIEDB16620
       SLW     OBUF+1                                                 MIEDB16630
       CAL     MADB                                                   MIEDB16640
       SLW     OBUF                                                   MIEDB16650
       PDX     0,2                                                    MIEDB16660
       TXI     *+1,2,2                                                MIEDB16670
       SXD     CWS,2                                                  MIEDB16680
       STL     FLAG,1                                                 MIEDB16690
       XEC     WTBS                                                   MIEDB16700
       XEC     RCHS                                                   MIEDB16710
       STL     TESTER,1                                               MIEDB16715
       STL     TCOS                                                   MIEDB16720
       XEC     TCOS                                                   MIEDB16725
       XEC     TRCS                                                   MIEDB16730
       STZ     MADFLG                                                 MIEDB16740
       CAL     MWBUF                                                  MIEDB16750
       SLW     WBUF                                                   MIEDB16760
       CAL     MWBUF+1                                                MIEDB16770
       SLW     WBUF+1                                                 MIEDB16780
       CAL     MIBUF+1                                                MIEDB16790
       SLW     IBUF+1                                                 MIEDB16800
       CAL     MIBUF                                                  MIEDB16810
       SLW     IBUF                                                   MIEDB16820
       CAL     MOBUF                                                  MIEDB16830
       SLW     OBUF                                                   MIEDB16840
       CAL     MOBUF+1                                                MIEDB16850
       SLW     OBUF+1                                                 MIEDB16860
       TRA     K                                                      MIEDB16870
       REM                                                            MIEDB16880
IOPR   IOCD    IMAGE,,24                                              MIEDB16890
PSE    SPTA    **                                                     MIEDB16900
PRNT   PZE     **                                                     MIEDB16910
HAFRO  PZE     **                                                     MIEDB16920
STROBE PZE     **                                                     MIEDB16930
MADFLG PZE                                                            MIEDB16940
MWBUF  OCT     ,                                                      MIEDB16950
MIBUF  OCT     ,                                                      MIEDB16960
MOBUF  OCT     ,                                                      MIEDB16970
MADB   OCT     ,                                                      MIEDB16980
IMAGE  BSS     26                                                     MIEDB16990
       COMMON  -206                                                   MIEDB17000
       COMMON  27                                                     MIEDB17010
CTRL   COMMON  28                                                     MIEDB17020
CBUF   COMMON  SIZE                                                   MIEDB17030
WBUF   COMMON  SIZE                                                   MIEDB17040
IBUF   COMMON  SIZE                                                   MIEDB17050
OBUF   COMMON  1                                                      MIEDB17060
       END                                                            MIEDB17070
*      FAP     ( DUMMY TO SPACE INPUT TAPE TO FORTRAN MONITOR SCAN )    EDC00000
       UPDATE  11,,,D                                                   EDC00000
       ENDUP                                                          MIF0E23910
*      FAP     ( REASSEMBLE FORTRAN MONITOR SCAN FOR MAD )              F0F00000
       UPDATE  11                                                       F0F00000
       DELETE THRU                                                      F0F00020
       OCT     212342774421  ACK-MA                                   MIF0F01382
       OCT     247777777777  D-----                                   MIF0F01383
               MAD                                                    MIF0F01573
       REM                                                            MIF0F06531
MAD    TSX     BKIN,4        BACKSPACE OVER NEXT INPUT RECORD         MIF0F06532
       TSX     (TAPE),4      SPACE SYSTEM TAPE TO MAD                 MIF0F06533
               GTMAD,,(SKBP) ..                                       MIF0F06534
               ,,1           ..                                       MIF0F06535
       TSX     (PRNT),4      PRINT BEGIN TRANSLATION                  MIF0F06536
               COMBT,,4      ..                                       MIF0F06537
       TSX     (PRNT),4      SPACE                                    MIF0F06538
               SPACE,,1      ..                                       MIF0F06539
       TRA     LOAD          GO TO LOAD MAD                           MIF0F06540
       REM                                                            MIF0F06541
GTMAD  PZE     22,,1         SKIP TO MAD CONTROL WORD FOR IOP         MIF0F07325
COMBT  BCI     4,0      BEGIN TRANSLATION                             MIF0F07805
       END                                                            MIF0F08100
*      FAP     ( REASSEMBLE DEBUG, BSS CONTROL AND LIB. SEARCH FOR MAD )F0G00000
       UPDATE  11                                                       F0G00000
       DELETE THRU                                                      F0G00020
       ORG     24850                                                  MIF0G00630
       LXD     (PGCT),4      NO. OF LINES TO OUTPUT PAGE          MOD.03F0G08010
       SXA     LINPG,4                                            MOD.03F0G08020
       DELETE                                                           F0G10230
       TNZ     EFND-1                                             MOD.04F0G18370
       TXI     EFNE,1,8                                           MOD.04F0G18371
       CAL     IM,1          TEST IF THIS IS                          MIF0H01521
       ADD     COMN          A VECTOR VALUES                          MIF0H01522
       ANA     ADMSK         CARD                                     MIF0H01523
       LAS     LCOMN         LOADING INTO COMMON                      MIF0H01524
       TRA     VVCD.         YES                                      MIF0H01525
       TRA     VVCD.         YES, GO TO WRITE ON B2                   MIF0H01526
       CLA     IM,1          NO, MUST BE NORMAL ABS CARD              MIF0H01530
       REM                                                            MIF0H01671
VVCD.  STZ     IM+1,1        VECTOR VALUES CARD COMES HERE            MIF0H01672
       STA     IM+1,1        FORM CONTROL WORD IN CHECKSUM            MIF0H01673
       PXD     0,2           ..                                       MIF0H01674
       STD     IM+1,1        ..                                       MIF0H01675
       ZET     PRSCM.        IS THIS THE FIRST VV CARD                MIF0H01676
       TRA     VVCD2.        NO, SKIP REWIND                          MIF0H01677
       TSX     (TAPE),4      YES, REWIND B2                           MIF0H01678
               REWND,,(SKBP) ..                                       MIF0H01679
               ,,2           ..                                       MIF0H01680
       STL     PRSCM.        SET SWITCH TO PRESET COMMON              MIF0H01681
VVCD2. TXL     *+2,1,0       SET IR1 TO WRITE OUT OF RIGHT BUFFER     MIF0H01682
       AXT     -1,1          ..                                       MIF0H01683
       TSX     (TAPE),4      WRITE VV CARD ON B2                      MIF0H01684
               WRVV.,1,(WBNC) ..                                      MIF0H01685
               ,,2            ..                                      MIF0H01686
       TRA     L             BACK FOR NEXT CARD                       MIF0H01687
       REM                                                            MIF0H01688
       AXT     LPRG.,1       MOVE LOADER TO UPPER CORE                MIF0H05280
       CAL     EPRG.,1       ..                                       MIF0H05285
       SLW     TOPMEM,1      ..                                       MIF0H05290
       TIX     *-2,1,1       ..                                       MIF0H05295
       LXD     TAG,1                                                  MIF0H05300
       TXI     BPRG.,1,TOPMEM-LPRG.-TABL                              MIF0H05305
       REM                                                            MIF0H05310
BPRG.. STZ     BPRG.,1       CLEAR UNUSED MEMORY                      MIF0H05315
..01   TIX     BPRG.,1,1     ..                                       MIF0H05320
..02   NZT     BPRG.+21      ARE ANY VECTOR VALUES CARDS ON B2        MIF0H05325
..03   TRA     BPRG.+14      NO, SKIP AN4 7O TO PR67914               MIF0H05330
..04   WEFB    2             YES, READ THEM IN                        MIF0H05335
..05   REWB    2                                                      MIF0H05340
..06   AXT     10,1          ERROR COUNT                              MIF0H05345
..07   RTBB    2             LOAD V.V. CARDS                          MIF0H05350
..08   RCHB    BPRG.+19      ..                                       MIF0H05355
..09   TCOB    BPRG.+09      ..                                       MIF0H05360
..10   TRCB    BPRG.+16      ..                                       MIF0H05365
..11   TEFB    BPRG.+13      ..                                       MIF0H05370
..12   TRA     BPRG.+06      ..                                       MIF0H05372
..13   REWB    2             HERE WHEN V.V. CARDS READ                MIF0H05374
..14   AXT     0,7           CLEAR IRS                                MIF0H05376
PROG   TRA     **            GO GO GO GO GO GO GO GO GO GO GO GO GO   MIF0H05378
..16   BSRB    2             ERROR, BACKSPACE B2                      MIF0H05380
..17   TIX     BPRG.+07      COUNTS ERRORS                            MIF0H05382
..18   HTR     BPRG.+6       STOP IF TO MANY ERRORS                   MIF0H05384
..19   IOCP    BPRG.+20,,1                                            MIF0H05386
..20   IOCD    **,,**                                                 MIF0H05388
PRSCM. PZE     0             SET NON-ZERO WHEN FIRST V.V. CARD MET    MIF0H05390
EPRG.  SYN     *                                                      MIF0H05392
LPRG.  SYN     EPRG.-BPRG..                                           MIF0H05394
BPRG.  SYN     TOPMEM-LPRG.                                           MIF0H05396
       REM                                                            MIF0H05398
       STZ     FMR           NO.                                      MIF0H06345
       TRA     SPS2          ..                                       MIF0H06350
       LXA     LINECT,4                                           MOD.06F0H06440
       TXI     *+1,4,1                                            MOD.06F0H06450
       SXA     LINECT,4                                           MOD.06F0H06460
COMNT1 ZET     NOSTON                                             MOD.06F0H06470
       TRA     COMBC                                              MOD.06F0H06480
BSLCW  MZE     2,,1          BACKSPACE 1 FILE AND 2 RECORDS CW        MIF0H07850
WRVV.  IOCD    IM+1,,23                                               MIF0H08562
       IOCD    IM+BUFSIZ+2,,23                                        MIF0H08564
*                                                                     MIF0H08566
       END                                                            MIF0I02630
