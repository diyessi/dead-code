CANE209      47 08211                                                   E2090001
C     A GENERAL PROGRAM FOR LEAST SQUARE POLYNOMIAL FIT USING ANE206    E2090002
      DIMENSION A(20,8), B(20,4), X(50), Y(50,4), W(50), SUM(4),        E2090003
     X          RESID(50,4), STD(8,4), EVAL(50), X1(50)                 E2090004
    5 IF (SENSE SWITCH 1) 7,10                                          E2090005
    7 CALL RITAP1(2)                                                    E2090006
   10 READ 1000, N, M, N1, L, IEVAL                                     E2090007
   15 IF (N) 300, 10, 20                                                E2090008
   20 DO 30 I=1,N                                                       E2090009
   30 READ 2000, X(I), W(I), (Y(I,J),J=1,L)                             E2090010
   33 IF (N1) 40, 40, 35                                                E2090011
   35 READ 2000, (X1(I),I=1,N1)                                         E2090012
   40 CALL LSQPOL(X,Y,W,RESID,N,SUM,L,A,B,M)                            E2090013
   50 DEG=N-M-1                                                         E2090014
   60 DO 80 I=1,M                                                       E2090015
   70 DO 80 J=1,L                                                       E2090016
   80 STD(I,J)=SQRTF(SUM(J)*A(I,I)/DEG)                                 E2090017
   90 PRINT 3000, N, M, N1, L                                           E2090018
  100 DO 110 I=1,M                                                      E2090019
  110 PRINT 4000, (A(I,J),J=1,M)                                        E2090020
  120 DO 198 J=1,L                                                      E2090021
  130 PRINT 5000, (B(I,J), STD(I,J), I=1,M)                             E2090022
  140 PRINT 6000, SUM(J)                                                E2090023
  150 IF (IEVAL) 190, 190, 160                                          E2090024
  160 DO 170 I=1,N                                                      E2090025
  170 EVAL(I)=RESID(I,J)+Y(I,J)                                         E2090026
  180 PRINT 7000, (X(I),W(I),Y(I,J),EVAL(I),RESID(I,J),I=1,N)           E2090027
  190 IF (N1) 198, 198, 192                                             E2090028
  192 DO 194 I=1,N1                                                     E2090029
  194 EVAL(I)=POLYE1F(X1(I),M,XLOCF(B(1,J)))                            E2090030
  196 PRINT 8000, (X1(I),EVAL(I),I=1,N1)                                E2090031
  198 PRINT 9000                                                        E2090032
  200 GO TO 10                                                          E2090033
  300 PAUSE 77777                                                       E2090034
  310 GO TO 10                                                          E2090035
 1000 FORMAT (12I6)                                                     E2090036
 2000 FORMAT (6E12.0)                                                   E2090037
 3000 FORMAT (48H1ANE209 LEAST SQUARE POLYNOMIAL FIT USING ANE206/      E2090038
     X        3H0N=I3,5H   M=I2,6H   N1=I2,5H   L=I2/13H0ERROR MATRIX)  E2090039
 4000 FORMAT (1H01P8E14.5)                                              E2090040
 5000 FORMAT (37H0         COEFFICIENT           ERROR/(1H01P2E20.7))   E2090041
 6000 FORMAT (36H0WEIGHTED SUM OF SQUARED DEVIATIONS=1PE13.5)           E2090042
 7000 FORMAT (70H0        X          WEIGHT           Y         EVALUATIE2090043
     XON     RESIDUAL/(1H01P5E14.5))                                    E2090044
 8000 FORMAT (29H0     EXTRA X      EVALUATION/(1H01P2E14.5))           E2090045
 9000 FORMAT (54H0- - - - - - - - - - - - - - - - - - - - - - - - - - -)E2090046
 5209 END (0,1,0,0,1)                                                   E2090047
