C  ORTOSS 0366 08011     TRANSIENT OR STEADY STATE TEMPERATURES         TOSS0001
C   DEPEND ON MAX NUMBER OF INTERNAL NODES                              TOSS0002
      DIMENSION CAP(400),QINT(400),QINTO(400),T(400),TEMCHA(400)        TOSS0003
     1,TEMRAT(400),IMAT(400)                                            TOSS0004
C   DEPEND ON MAX NUMBER OF INTERNAL NODES AND INTERNAL CONNECTORS      TOSS0005
      DIMENSION Y(400,13),IJ(400,13)                                    TOSS0006
C   DEPEND ON MAX NUMBER OF SURFACE NODES AND BOUNDARY CONNECTORS       TOSS0007
      DIMENSION C(200,10),CC(200,10),H(200,10),SAREA(200),ST(200)       TOSS0008
     1,YS(200,12),IJS(200,11)                                           TOSS0009
C   DEPEND ON MAX NUMBER OF BOUNDARY NODES                              TOSS0010
      DIMENSION BT(220),IB(220)                                         TOSS0011
C   DEPEND ON MAX NUMBER OF BOUNDARY TABLES AND ENTRIES TO TEMP TABLES  TOSS0012
      DIMENSION TB(20,25),TT(20,25)                                     TOSS0013
C   DEPEND ON MAX NUMBER OF MATERIALS                                   TOSS0014
      DIMENSION CAPMAT(50),VOLCON(50),MATNAM(50)                        TOSS0015
C   DEPEND ON MAX NUMBER OF POWER LIBRARY ENTRIES                       TOSS0016
      DIMENSION QQ(50),TQ(50)                                           TOSS0017
C   DEPEND ON MAX NUMBER OF DESIRED AVERAGES                            TOSS0018
      DIMENSION INO(2,50)                                               TOSS0019
C   DEPEND ON MAX NUMBER OF DESIRED PRINTOUTS                           TOSS0020
      DIMENSION PRNT(50)                                                TOSS0021
C   INDEPENDENT OF DESIRED MAXIMUMS                                     TOSS0022
      DIMENSION ID(14)                                                  TOSS0023
C   FLOATING STORAGE                                                    TOSS0024
      COMMON AE,AO,BT,C,CAP,CAPMAT,CC,CRIT,CRITIM,DELTAT,FLUX,H,PERCEN  TOSS0025
     1,PRNT,Q,QCOND,QINT,QINTO,QMULT,QQ,REDEP,RELENA,RELENB,REWID,SAREA TOSS0026
     2,ST,SURDEP,SURWID,T,TAVG,TB,TEMCHA,TEMRAT,TIME,TIMEO,TIMFIN,TQ,TT TOSS0027
     3,TYM,VOL,VOLCAP,VOLCON,VOLDEN,VOLDEP,VOLLEN,VOLWID,Y,YS           TOSS0028
C   FIXED STORAGE                                                       TOSS0029
      COMMON I,IB,IBMAX,IBON,IBOTOT,IC,ICATOT,ICON,ICOV,ICS,ICSB,ICSOV  TOSS0030
     1,ID,IJ,IJS,IMAT,IMAX,INAV,INAVG,INNE,INNO,INO,INTYM,IPT,IPTOUT    TOSS0031
     2,ISMAX,ISTOP,ISUN,ISUTOT,J,K,L,LEFT,LIBQ,LIBQN,LIBQT,LIBT,LIBTN   TOSS0032
     3,LIBTT,LIM,MAT,MATA,MATB,MATNAM,MATOT,MAXAVE,MAXBND,MAXCON,MAXINT TOSS0033
     4,MAXMAT,MAXPRT,MAXQQ,MAXRAD,MAXSUR,MAXTAB,MAXTB,NP,NUMPRT         TOSS0034
C     STORE MAXIMUM DIMENSIONS                                          TOSS0035
      CALLMAXDIM                                                        TOSS0036
C     INPUT, OUTPUT, AND SETUP ID AND LIMITS CARDS                      TOSS0037
    1 CONTINUE                                                          TOSS0038
      READINPUTTAPE10,901,ID                                            TOSS0039
      WRITEOUTPUTTAPE9,900                                              TOSS0040
      WRITEOUTPUTTAPE9,949,ID                                           TOSS0041
      READINPUTTAPE10,902,TIMEO,TIMFIN,DELTAT,CRIT,CRITIM,IPT,LIM       TOSS0042
      INTYM=LIMTO(LIM)                                                  TOSS0043
      TIME=TIMEO                                                        TOSS0044
      WRITEOUTPUTTAPE9,903,TIMEO,TIMFIN,DELTAT,CRIT,CRITIM,IPT,INTYM    TOSS0045
C     INITIALIZE COUNTERS,PARAMETERS,AND WORKING STORAGE                TOSS0046
      IF(SENSELIGHT3)12,12                                              TOSS0047
   12 IF(SENSELIGHT4)4,4                                                TOSS0048
    4 IPTOUT=0                                                          TOSS0049
      ISTOP=0                                                           TOSS0050
      ISMAX=0                                                           TOSS0051
      IBOTOT=0                                                          TOSS0052
      IBMAX=0                                                           TOSS0053
      NP=1                                                              TOSS0054
      IF(IPT)7,8,8                                                      TOSS0055
    7 IPT=-IPT                                                          TOSS0056
      DO28I=1,MAXINT                                                    TOSS0057
   28 Y(I,1)=0.                                                         TOSS0058
      GOTO9                                                             TOSS0059
    8 MATOT=0                                                           TOSS0060
      IMAX=0                                                            TOSS0061
      DO5I=1,MAXSUR                                                     TOSS0062
      DO5J=1,MAXRAD                                                     TOSS0063
      C(I,J)=0.                                                         TOSS0064
    5 CC(I,J)=0.                                                        TOSS0065
      DO6I=1,MAXINT                                                     TOSS0066
      DO6K=1,MAXCON                                                     TOSS0067
      Y(I,K)=0.                                                         TOSS0068
    6 IJ(I,K)=0                                                         TOSS0069
      J=MAXRAD+1                                                        TOSS0070
      DO10I=1,MAXSUR                                                    TOSS0071
      DO10K=1,J                                                         TOSS0072
   10 IJS(I,K)=0                                                        TOSS0073
      DO11I=1,MAXBND                                                    TOSS0074
   11 IB(I)=0                                                           TOSS0075
    9 IF(XABSF(IPT-3)-1)3,3,2                                           TOSS0076
    2 IPT=1                                                             TOSS0077
    3 CONTINUE                                                          TOSS0078
C     INPUT, OUTPUT, COUNT MATERIALS, COMPUTE MATERIAL VARIABLES        TOSS0079
      WRITEOUTPUTTAPE9,904                                              TOSS0080
   29 READINPUTTAPE10,905,I,MAT,(VOLCAP,VOLDEN,VOLCON(MAT))             TOSS0081
      IF(MAT)30,35,30                                                   TOSS0082
   30 MATOT=MATOT+1                                                     TOSS0083
      MATNAM(MAT)=I                                                     TOSS0084
      WRITEOUTPUTTAPE9,906,MATNAM(MAT),MAT,VOLCAP,VOLDEN,VOLCON(MAT)    TOSS0085
      CAPMAT(MAT)=VOLCAP*VOLDEN*60.                                     TOSS0086
      GOTO29                                                            TOSS0087
   35 CONTINUE                                                          TOSS0088
C     INPUT, OUTPUT,       INTERNAL NODES, COMPUTE NODE VARIABLES       TOSS0089
      WRITEOUTPUTTAPE9,907                                              TOSS0090
   36 READINPUTTAPE10,908,I,MAT,VOLLEN,VOLWID,VOLDEP,Q,AO               TOSS0091
      IF(I)43,44,38                                                     TOSS0092
   38 IJ(I,1)=I                                                         TOSS0093
      IMAT(I)=MAT                                                       TOSS0094
      IMAX= XMAX0F(IMAX,I)                                              TOSS0095
   42 VOL=VOLLEN*VOLWID*VOLDEP                                          TOSS0096
      CAP(I)=CAPMAT(MAT)*VOL                                            TOSS0097
      QINTO(I)=Q*VOL                                                    TOSS0098
      WRITEOUTPUTTAPE9,909,I,MATNAM(MAT),MAT,VOLLEN,VOLWID,VOLDEP,VOL,Q TOSS0099
     1,CAP(I)                                                           TOSS0100
      IF(BZNF(AO))36,37,37                                              TOSS0101
   37 T(I)=AO                                                           TOSS0102
      GOTO36                                                            TOSS0103
   43 I=-I                                                              TOSS0104
      DO71J=2,MAXCON                                                    TOSS0105
      K=IJ(I,J)                                                         TOSS0106
      IJ(I,J)=0                                                         TOSS0107
      Y(I,J)=0.                                                         TOSS0108
      IF(K)76,71,72                                                     TOSS0109
   72 DO74L=2,MAXCON                                                    TOSS0110
      IF(IJ(K,L)-I)74,75,74                                             TOSS0111
   75 Y(K,L)=0.                                                         TOSS0112
      IJ(K,L)=-0                                                        TOSS0113
   74 CONTINUE                                                          TOSS0114
      GOTO71                                                            TOSS0115
   76 K=-K                                                              TOSS0116
      INNE=MAXRAD+1                                                     TOSS0117
      DO77L=1,INNE                                                      TOSS0118
   77 IJS(K,L)=0                                                        TOSS0119
   71 CONTINUE                                                          TOSS0120
      IJ(I,1)=0                                                         TOSS0121
      Y(I,1)=0.                                                         TOSS0122
      GOTO36                                                            TOSS0123
   44 CONTINUE                                                          TOSS0124
C      INPUT, OUTPUT TEMPERATURES.  DEFINE SURFACE AND BOUNDARY NODES.  TOSS0125
      I=10                                                              TOSS0126
      GOTO(61,62,63,63),IPT                                             TOSS0127
   60 ICON=-1                                                           TOSS0128
      CALLBTEMP                                                         TOSS0129
      GOTO65                                                            TOSS0130
   63 IF(SENSELIGHT2)64,60                                              TOSS0131
   64 REWIND11                                                          TOSS0132
      READINPUTTAPE11,908,ICON                                          TOSS0133
      I=11                                                              TOSS0134
   62 SENSELIGHT2                                                       TOSS0135
   61 CALLTEMPS                                                         TOSS0136
   65 WRITEOUTPUTTAPE9,948                                              TOSS0137
      DO50IBON=1,MAXBND                                                 TOSS0138
      IF(BNODEF(IB(IBON)))48,50,46                                      TOSS0139
   46 J=IBON+ICS                                                        TOSS0140
      LIBTT=IB(IBON)                                                    TOSS0141
      WRITEOUTPUTTAPE9,947,J,(TB(IBON,LIBT),TT(IBON,LIBT),LIBT=1,LIBTT) TOSS0142
   48 IBOTOT=IBOTOT+1                                                   TOSS0143
      IBMAX=XMAX0F(IBMAX,IBON)                                          TOSS0144
   50 CONTINUE                                                          TOSS0145
      IF(IBMAX )52,52,438                                               TOSS0146
  438 CALLBTCOMP                                                        TOSS0147
   52 CONTINUE                                                          TOSS0148
C     INPUT, OUTPUT INTERNAL CONNECTORS, COMPUTE ADMITTANCES            TOSS0149
      WRITEOUTPUTTAPE9,910                                              TOSS0150
  120 READINPUTTAPE10,911,I,J,RELENA,RELENB,REWID,REDEP                 TOSS0151
      IF(I)169,170,124                                                  TOSS0152
  124 MATA=IMAT(I)                                                      TOSS0153
      IF(I-MAXINT)134,134,120                                           TOSS0154
  134 IF(J-IC-MAXSUR)135,135,120                                        TOSS0155
  135 IF(J-IC)130,130,125                                               TOSS0156
  130 DO140K=2,MAXCON                                                   TOSS0157
      IF(IJ(I,K))139,145,139                                            TOSS0158
  139 IF(IJ(I,K)-J)140,145,140                                          TOSS0159
  140 CONTINUE                                                          TOSS0160
      GOTO120                                                           TOSS0161
  145 IJ(I,K)=J                                                         TOSS0162
      MATB=IMAT(J)                                                      TOSS0163
      WRITEOUTPUTTAPE9,912,I,J,MATNAM(MATA),MATA,RELENA,MATNAM(MATB),MATTOSS0164
     1B,RELENB,REWID,REDEP                                              TOSS0165
      Y(I,K)=(REWID*REDEP)/(12.*((RELENA/VOLCON(MATA))                  TOSS0166
     1+(RELENB/VOLCON(MATB))))                                          TOSS0167
  150 DO155L=2,MAXCON                                                   TOSS0168
      IF(IJ(J,L))154,165,154                                            TOSS0169
  154 IF(IJ(J,L)-I)155,165,155                                          TOSS0170
  155 CONTINUE                                                          TOSS0171
      GOTO120                                                           TOSS0172
  165 IJ(J,L)=I                                                         TOSS0173
      Y(J,L)=Y(I,K)                                                     TOSS0174
      GOTO120                                                           TOSS0175
  125 ISUN=J-IC                                                         TOSS0176
      DO167K=2,MAXCON                                                   TOSS0177
      IF(IJ(I,K))166,168,166                                            TOSS0178
  166 IF(IJ(I,K)+ISUN)167,168,167                                       TOSS0179
  167 CONTINUE                                                          TOSS0180
      GOTO120                                                           TOSS0181
  168 IJ(I,K)=-ISUN                                                     TOSS0182
      WRITEOUTPUTTAPE9,913,I,J,MATNAM(MATA),MATA,RELENA,REWID,REDEP     TOSS0183
      Y(I,K)=(REWID*REDEP)/(12.*(RELENA/VOLCON(MATA)))                  TOSS0184
      IJS(ISUN,1)=I                                                     TOSS0185
      YS(ISUN,1)=Y(I,K)                                                 TOSS0186
      GOTO120                                                           TOSS0187
  169 I=-I                                                              TOSS0188
      IF(J-IC)111,111,112                                               TOSS0189
  111 DO 110 K=2,MAXCON                                                 TOSS0190
      IF(IJ(I,K)-J)110,113,110                                          TOSS0191
  113 IJ(I,K)=-0                                                        TOSS0192
      Y(I,K)=0.                                                         TOSS0193
  110 CONTINUE                                                          TOSS0194
      DO114K=2,MAXCON                                                   TOSS0195
      IF(IJ(J,K)-I)114,115,114                                          TOSS0196
  115 IJ(J,K)=-0                                                        TOSS0197
      Y(J,K)=0.                                                         TOSS0198
  114 CONTINUE                                                          TOSS0199
      GOTO120                                                           TOSS0200
  112 J=J-IC                                                            TOSS0201
      DO118K=2,MAXCON                                                   TOSS0202
      IF(IJ(I,K)+J)118,119,118                                          TOSS0203
  119 IJ(I,K)=-0                                                        TOSS0204
      Y(I,K)=0.                                                         TOSS0205
  118 CONTINUE                                                          TOSS0206
      I=MAXRAD+1                                                        TOSS0207
      DO116K=1,I                                                        TOSS0208
  116 IJS(J,K)=0                                                        TOSS0209
      GOTO120                                                           TOSS0210
  170 CONTINUE                                                          TOSS0211
C     INPUT,OUTPUT SURFACE CONNECTORS, COMPUTE ADMITTANCES              TOSS0212
      WRITEOUTPUTTAPE9,914                                              TOSS0213
  175 CALLSURCON                                                        TOSS0214
      DO171I=1,IMAX                                                     TOSS0215
      DO171K=2,MAXCON                                                   TOSS0216
  171 Y(I,1)=Y(I,1)-Y(I,K)                                              TOSS0217
      DO172IBON=1,MAXBND                                                TOSS0218
      IF(BNODEF(IB(IBON)))173,172,173                                   TOSS0219
  173 IBMAX=XMAX0F(IBMAX,IBON)                                          TOSS0220
  172 CONTINUE                                                          TOSS0221
C     INPUT,OUTPUT POWER LIBRARY, AVERAGES RANGES, AND PRINTOUT TIMES   TOSS0222
      CALLPOWER                                                         TOSS0223
      CALLAVIN                                                          TOSS0224
      INAVG=INAVG/2                                                     TOSS0225
      CALLPRNTYM                                                        TOSS0226
C     OUTPUT THE ADMITTANCE MATRIX                                      TOSS0227
      WRITEOUTPUTTAPE9,920                                              TOSS0228
      CALLOUTIA                                                         TOSS0229
      IF(ISUTOT)195,194,195                                             TOSS0230
  195 CONTINUE                                                          TOSS0231
      WRITEOUTPUTTAPE9,922                                              TOSS0232
      CALLOUTSA                                                         TOSS0233
  194 CONTINUE                                                          TOSS0234
C      TEST FOR CONVERG OF TYPE 2, IF NECESSARY                         TOSS0235
      GOTO(199,199,198,198),IPT                                         TOSS0236
  198 IF(ICON)590,590,199                                               TOSS0237
  590 WRITEOUTPUTTAPE9,966                                              TOSS0238
      GOTO1                                                             TOSS0239
  199 CONTINUE                                                          TOSS0240
C     COMPUTE MINIMUM TIME CONSTANT                                     TOSS0241
      CALLTAUM                                                          TOSS0242
C     BEGIN CALCULATION OF NEW TEMPERATURE DISTRIBUTION                 TOSS0243
C     DETERMINE CURRENT INTERNAL HEAT GENERATION                        TOSS0244
  200 CONTINUE                                                          TOSS0245
      CALLQLOOK                                                         TOSS0246
C     CALCULATE NEW INTERNAL TEMPERATURES                               TOSS0247
      TIME = TIME+DELTAT                                                TOSS0248
      ICON=1-ICATOT                                                     TOSS0249
      CALLCOMPT                                                         TOSS0250
C     TEST FOR SURFACE AND BOUNDARY NODES                               TOSS0251
      IF(ISUTOT)300,300,225                                             TOSS0252
  225 CONTINUE                                                          TOSS0253
C     FIND NEW BOUNDARY TEMPERATURES                                    TOSS0254
      CALLBTCOMP                                                        TOSS0255
C     CALCULATE NEW SURFACE TEMPERATURES AND FILM COEFFICIENTS          TOSS0256
      CALLSTCOMP                                                        TOSS0257
C     TEST FOR CONVERG, FINAL TIME, PRINT TIME, AND OPERATOR INTERRUPT  TOSS0258
  300 CONTINUE                                                          TOSS0259
      IF(CRITIM-TIME)301,301,325                                        TOSS0260
  301 IF(ICON)325,325,330                                               TOSS0261
  325 IF(TIMFIN-TIME)330,330,340                                        TOSS0262
  330 ISTOP=1                                                           TOSS0263
  335 IPTOUT=1                                                          TOSS0264
      GOTO345                                                           TOSS0265
  340 IF(TIME-PRNT(NP))345,335,335                                      TOSS0266
  345 CONTINUE                                                          TOSS0267
      CALLNTRPT                                                         TOSS0268
  490 IF(IPTOUT)200,200,500                                             TOSS0269
C     OUTPUT TEMPERATURE DISTRIBUTION                                   TOSS0270
  500 IPTOUT=0                                                          TOSS0271
      WRITEOUTPUTTAPE9,964,NP                                           TOSS0272
      WRITEOUTPUTTAPE9,949,ID                                           TOSS0273
      NP=NP+1                                                           TOSS0274
      PERCEN=((TIME-TIMEO)/(TIMFIN-TIMEO))*100.                         TOSS0275
      WRITEOUTPUTTAPE9,950,TIME,PERCEN                                  TOSS0276
      CALLOUTT(1,IMAX)                                                  TOSS0277
      IF(ISUTOT)520,520,505                                             TOSS0278
  505 WRITEOUTPUTTAPE9,953                                              TOSS0279
      CALLOUST                                                          TOSS0280
      WRITEOUTPUTTAPE9,955                                              TOSS0281
      CALLOUTBT(ICSOV,ICSB)                                             TOSS0282
  520 IF(INAVG)540,540,525                                              TOSS0283
  525 WRITEOUTPUTTAPE9,956                                              TOSS0284
      DO535INAV=1,INAVG                                                 TOSS0285
      TAVG=0.0                                                          TOSS0286
      INNO=INO(1,INAV)                                                  TOSS0287
      INNE=INO(2,INAV)                                                  TOSS0288
      AO=INNO                                                           TOSS0289
      AE=INNE                                                           TOSS0290
      DO530I=INNO,INNE                                                  TOSS0291
  530 TAVG=T(I)+TAVG                                                    TOSS0292
      TAVG=TAVG/(AE-AO+1.)                                              TOSS0293
  535 WRITEOUTPUTTAPE9,957,INNO,INNE,TAVG                               TOSS0294
  540 CONTINUE                                                          TOSS0295
      WRITEOUTPUTTAPE9,959                                              TOSS0296
      CALLOUTRAT(1,IMAX)                                                TOSS0297
      IF(LIM)541,542,541                                                TOSS0298
  541 TYM=LIM-LIMIT(LEFT)                                               TOSS0299
      TYM=TYM/6.                                                        TOSS0300
      WRITEOUTPUTTAPE9,963,TYM                                          TOSS0301
  542 CONTINUE                                                          TOSS0302
C     DETERMINE FLOW AND MAKE APPROPRIATE COMMENTS                      TOSS0303
      IF(ISTOP)543,543,545                                              TOSS0304
  543 IF(LEFT)544,200,200                                               TOSS0305
  544 WRITEOUTPUTTAPE9,960                                              TOSS0306
  545 IF(ICON)555,555,550                                               TOSS0307
  550 WRITEOUTPUTTAPE9,961                                              TOSS0308
  555 WRITEOUTPUTTAPE9,962                                              TOSS0309
  556 GOTO(570,560,570,560),IPT                                         TOSS0310
  560 REWIND11                                                          TOSS0311
      WRITEOUTPUTTAPE11,908,ICON                                        TOSS0312
      CALLSAVTEM                                                        TOSS0313
      REWIND11                                                          TOSS0314
  570 WRITEOUTPUTTAPE8,965,(ID(I),I=1,13)                               TOSS0315
      CALLPCHTEM                                                        TOSS0316
      GOTO1                                                             TOSS0317
C     FORMATS                                                           TOSS0318
  900 FORMAT(1H1,17X,66HTOSS  A TRANSIENT OR STEADY STATE TEMPERATURE DITOSS0319
     1STRIBUTION PROGRAM)                                               TOSS0320
  901 FORMAT(13A6,A2)                                                   TOSS0321
  902 FORMAT(5F10.4,2I10/1X)                                            TOSS0322
  903 FORMAT(15H0SPECIFICATIONS///8X,7HINITIAL8X,5HFINAL10X,4HTIME2X,2(6TOSS0323
     1X,8HCONVERGE)/2(10X,4HTIME),8X,9HINCREMENT5X,8HCRITERIA7X,5HAFTER TOSS0324
     211X,4HTYPE/1X,5F14.4,2I14)                                        TOSS0325
  904 FORMAT(10H0MATERIALS/14X,3HNO.6X,9HHEAT CAP.7X,7HDENSITY5X,12HCONDTOSS0326
     1UCTIVITY)                                                         TOSS0327
  905 FORMAT(A6,I4,3F10.4)                                              TOSS0328
  906 FORMAT(5X,A6,I5,3F15.4)                                           TOSS0329
  907 FORMAT(15H0INTERNAL NODES/7X,4HNODE4X,8HMATERIAL 7X,6HLENGTH6X,5HWTOSS0330
     1IDTH 7X,5HDEPTH 7X,6HVOLUME 8X,9HBASE GEN.8X,8HCAPACITY)          TOSS0331
  908 FORMAT(2I10,3F10.4,E10.4,F10.2)                                   TOSS0332
  909 FORMAT(I11,A9,I4,4F12.4,2E17.4)                                   TOSS0333
  910 FORMAT(20H0INTERNAL CONNECTORS/10X,5HNODES2X,2(5X,8HMATERIAL5X,6HLTOSS0334
     1ENGTH),10X,5HWIDTH5X,5HDEPTH)                                     TOSS0335
  911 FORMAT(2I10,4F10.4)                                               TOSS0336
  912 FORMAT(5X,2I6,2(A10,I4,F10.4),6X,2F10.4)                          TOSS0337
  913 FORMAT(5X,2I6,A10,I4,F10.4,30X,2F10.4)                            TOSS0338
  914 FORMAT(19H0SURFACE CONNECTORS/10X,5HNODES6X,9HMECHANISM10X,5HWIDTHTOSS0339
     17X,5HDEPTH7X,4HAREA8X,9HFILM COEF)                                TOSS0340
  920 FORMAT(21H0INTERNAL ADMITTANCES/6X,15HINTERNAL  SELF  5(3X,6HBORDETOSS0341
     1R 8X)/4X,6(4X,4HNODE4X,5HADMIT))                                  TOSS0342
  922 FORMAT(20H0SURFACE ADMITTANCES/5X,7HSURFACE6X,8HINTERNAL11X,4(8HBOTOSS0343
     1UNDARY11X)/6X,4HNODE6X,5(4HNODE4X,5HADMIT6X))                     TOSS0344
  947 FORMAT(I6/(F15.2,F10.4,F10.2,F10.4,F10.2,F10.4,F10.2,F10.4,F10.2,FTOSS0345
     110.4))                                                            TOSS0346
  948 FORMAT(28H0BOUNDARY TEMPERATURE TABLES/2X,4HNODE5(4X,4HTEMP6X,4HTITOSS0347
     1ME2X))                                                            TOSS0348
  949 FORMAT(1H0,10X,14A6)                                              TOSS0349
  950 FORMAT(25H0THE TEMPERATURES AT TIMEF14.4/F12.2,23H  PERCENT OF TOTTOSS0350
     1AL TIME//22H0INTERNAL TEMPERATURES/5X,5(7X,4HNODE5X,4HTEMP))      TOSS0351
  953 FORMAT(21H0SURFACE TEMPERATURES/12X,4HNODE7X,4HTEMP7X,2(7HCONNECT3TOSS0352
     1X,9HFILM COEF3X,12HSURFACE FLUX5X))                               TOSS0353
  955 FORMAT(22H0BOUNDARY TEMPERATURES/5X,5(7X,4HNODE5X,4HTEMP))        TOSS0354
  956 FORMAT(22H0AVERAGED TEMPERATURES/    (16X,5HNODES6X,8HTEMP AVE))  TOSS0355
  957 FORMAT(   3(I15,4H  TOI5,F11.2))                                  TOSS0356
  959 FORMAT(27H0RATE OF TEMPERATURE CHANGE/5X,5(7X,4HNODE5X,4HRATE))   TOSS0357
  960 FORMAT(30H0THIS CASE TERMINATED BY CLOCK)                         TOSS0358
  961 FORMAT(66H0THE TEMPERATURE DISTRIBUTION HAS REACHED A STEADY STATETOSS0359
     1 CONDITION)                                                       TOSS0360
  962 FORMAT(39H1THIS  TOSS  INVESTIGATION IS COMPLETED)                TOSS0361
  963 FORMAT(21H0ELAPSED MACHINE TIMEF7.2,8H MINUTES)                   TOSS0362
  964 FORMAT(11H1OUTPUT NO.I4)                                          TOSS0363
  965 FORMAT(2HC 13A6)                                                  TOSS0364
  966 FORMAT(30H1THIS CASE CANNOT BE CONTINUED)                         TOSS0365
      END                                                               TOSS0366
