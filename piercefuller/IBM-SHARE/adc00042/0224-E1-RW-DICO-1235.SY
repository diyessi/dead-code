C     SUBROUTINE FOR GENERATION OF DERVIATIVE FORMULAS.                 RWDICO01
C                                                                       DICO0002
      SUBROUTINE DICO(K,N,XI,XTAB,C)                                    DICO0003
      DIMENSION C(25),XTAB(25),MA(24)                                   DICO0004
      FACTK=1.0                                                         DICO0005
      DO 5002 L7=1,K                                                    DICO0006
      XL7=L7                                                            DICO0007
 5002 FACTK=FACTK*XL7                                                   DICO0008
      LTERMS=N-1-K                                                      DICO0009
      IF(LTERMS)999,5000,5000                                           DICO0010
 5000 DO 2000 J=1,N                                                     DICO0011
      SUM=0.0                                                           DICO0012
      DENOM=1.0                                                         DICO0013
      DO 4000 L6=1,N                                                    DICO0014
      IF(J-L6)4001,4000,4001                                            DICO0015
 4001 XL=XTAB(J)-XTAB(L6)                                               DICO0016
      DENOM=DENOM*XL                                                    DICO0017
 4000 CONTINUE                                                          DICO0018
      PART=1.0                                                          DICO0019
      IF(LTERMS)1000,3200,1000                                          DICO0020
 1000 L2=1                                                              DICO0021
      L3=1                                                              DICO0022
 1008 IF(L2-J)1002,1003,1002                                            DICO0023
 1002 IF(XTAB(L2)-XI)1004,1003,1004                                     DICO0024
 1003 L2=L2+1                                                           DICO0025
      GO TO 1008                                                        DICO0026
 1004 IF(L2-N)1005,1005,1006                                            DICO0027
 1006 L3=L3-1                                                           DICO0028
      IF(L3)2000,2000,1007                                              DICO0029
 1007 L2=MA(L3)                                                         DICO0030
      GO TO 1003                                                        DICO0031
 1005 MA(L3)=L2                                                         DICO0032
      L3=L3+1                                                           DICO0033
      IF(L3-LTERMS)1003,1003,3000                                       DICO0034
 3000 DO 3100 L4=1,LTERMS                                               DICO0035
      MSUB=MA(L4)                                                       DICO0036
 3100 PART=PART*(XI-XTAB(MSUB))                                         DICO0037
      SUM=SUM+PART                                                      DICO0038
      PART=1.0                                                          DICO0039
      L3=LTERMS                                                         DICO0040
      GO TO 1007                                                        DICO0041
 3200 SUM=1.0                                                           DICO0042
 2000 C(J)=(SUM*FACTK)/DENOM                                            DICO0043
 901  RETURN                                                            DICO0044
 999  DO 902 J=1,N                                                      DICO0045
 902  C(J)=0.0                                                          DICO0046
      GO TO 901                                                         DICO0047
      END                                                               DICO004H
