CANC001     336 07151                                                   C0010001
      DIMENSION K1(80),KFRM(80,8),KTO(80,8),M1(81),N1(81),              C0010002
     XA1(15,80),B1(15,80),LVL(80,14),NL(80),LX(81),LP(81),              C0010003
     XW(15),A(11250),B(11250)                                           C0010004
      COMMON LTEM                                                       C0010005
      MAXA=11250                                                        C0010006
    1 READ200,IDENT,NC                                                  C0010007
      DO 2 I=1,NC                                                       C0010008
      READ 200,K1(I),(KFRM(I,J1),J1=1,8)                                C0010009
      READ 200,(KTO(I,J1),J1=1,8)                                       C0010010
      READ 200,M,N                                                      C0010011
      READ 202,(A1(J,I),J=1,M)                                          C0010012
      READ 202,(B1(J,I),J=1,N)                                          C0010013
  200 FORMAT(12I6)                                                      C0010014
  202 FORMAT(6E12.5)                                                    C0010015
      IF(K1(I)-I)4,3,4                                                  C0010016
    3 M1(I)=M                                                           C0010017
    2 N1(I)=N                                                           C0010018
      GO TO 9                                                           C0010019
    4 PRINT5                                                            C0010020
    5 FORMAT(33H BOXES NOT ORDERED CONSECUTIVELY    )                   C0010021
    6 PAUSE11111                                                        C0010022
      GOTO1                                                             C0010023
    9 CALL LOOP(A1,B1,A,B,M1,N1,KFRM,KTO,LP,LX,NC)                      C0010024
   10 CALL LVLSTO(NC,KFRM,KTO,N1,LVL,NL,NLT,LX,LP)                      C0010025
      LMAX=LVL(NLT,1)                                                   C0010026
      LTEM=NC+1                                                         C0010027
      LX(LTEM)=LX(LMAX)+LX(1)                                           C0010028
      LP(LTEM)=LP(NC)+LX(NC)                                            C0010029
      IF(LP(LTEM)+LX(LTEM)-MAXA)26,26,24                                C0010030
   24 PRINT 25                                                          C0010031
   25 FORMAT(26H EXCEEDS MAXIMUM STORAGE    )                           C0010032
      STOP33333                                                         C0010033
   26 DO27 I=1,NC                                                       C0010034
      M=M1(I)                                                           C0010035
      DO28 J1=1,M                                                       C0010036
      IND=LP(I)+J1                                                      C0010037
   28 A(IND)=A1(J1,I)                                                   C0010038
      N=N1(I)                                                           C0010039
      DO27 J2=1,N                                                       C0010040
      IND=LP(I)+J2                                                      C0010041
   27 B(IND)=B1(J2,I)                                                   C0010042
      IF(SENSE SWITCH 2)29,30                                           C0010043
   29 DO 300 I=1,NLT                                                    C0010044
      NLJ=NL(I)                                                         C0010045
  300 WRITE OUTPUT TAPE2,210,I,(LVL(I,J),J=1,NLJ)                       C0010046
  210 FORMAT(3H L=I3,4(7H   BOX=I3))                                    C0010047
   30 CALL SYSTFN(KFRM,KTO,M1,N1,A,B,A1,B1,LVL,NL,NLT,LX,LP,LMAX)       C0010048
      WRITE OUTPUT TAPE2,208,IDENT                                      C0010049
  208 FORMAT(35H1AN C001  SYSTEMS EVALUATION  CASE I6)                  C0010050
      M=M1(1)                                                           C0010051
      N=N1(1)                                                           C0010052
      WRITE OUTPUT TAPE2,220                                            C0010053
  220 FORMAT(25H0SYSTEM TRANSFER FUNCTION/18H0A0,  A1,  A2,....)        C0010054
      WRITE OUTPUT TAPE2,250,(A(J),J=1,M)                               C0010055
      WRITE OUTPUT TAPE2,221                                            C0010056
  221 FORMAT(18H0B0,  B1,  B2,....)                                     C0010057
      WRITE OUTPUT TAPE2,250,(B(J),J=1,N)                               C0010058
  250 FORMAT(1H0 8E13.4)                                                C0010059
   50 READ 202,(W(J),J=2,7)                                             C0010060
      DO 60 J=2,7                                                       C0010061
      W=W(J)                                                            C0010062
      IF(W)61,62,61                                                     C0010063
   61 M=M1(1)                                                           C0010064
      CALL POLYVA(A,M,W,S)                                              C0010065
      C1=S                                                              C0010066
      M=M1(1)-1                                                         C0010067
      IF(M)57,51,52                                                     C0010068
   52 CALL POLYVA(A,M,W,S)                                              C0010069
      C2=S                                                              C0010070
   53 M=N1(1)                                                           C0010071
      CALL POLYVA(B,M,W,S)                                              C0010072
      D1=S                                                              C0010073
      M=N1(1)-1                                                         C0010074
      IF(M)57,54,55                                                     C0010075
   55 CALL POLYVA(B,M,W,S)                                              C0010076
      D2=S                                                              C0010077
   56 N=M1(1)-1                                                         C0010078
      CALL POLYVB(N,C1,C2,W,A11,A2)                                     C0010079
      N=N1(1)-1                                                         C0010080
      CALL POLYVB(N,D1,D2,W,B11,B2)                                     C0010081
      CALL OUTPUT(A11,A2,B11,B2,W)                                      C0010082
   60 CONTINUE                                                          C0010083
      GOTO50                                                            C0010084
   51 C2=0.                                                             C0010085
      GOTO 53                                                           C0010086
   54 D2=0.                                                             C0010087
      GOTO 56                                                           C0010088
   57 STOP55055                                                         C0010089
   62 END FILE 2                                                        C0010090
      STOP 77777                                                        C0010091
      END(0,1,0,0,1)                                                    C0010092
      SUBROUTINE LOOP(A1,B1,A,B,M1,N1,KFRM,KTO,LP,LX,NC)                C0010093
      DIMENSION KA(25),KB(25),A(1),B(1),M1(1),N1(1),LP(1),LX(1),        C0010094
     XA1(15,80),B1(15,80),KFRM(80,8),KTO(80,8)                          C0010095
      COMMON LTEM                                                       C0010096
      LTEM=NC+1                                                         C0010097
      LP(LTEM)=100                                                      C0010098
      READ 100,N                                                        C0010099
  100 FORMAT(12I6)                                                      C0010100
      IF(N)2,21,2                                                       C0010101
    2 READ 100,(KA(I),KB(I),I=1,N)                                      C0010102
      DO 19 I=1,N                                                       C0010103
      L1=KA(I)                                                          C0010104
      L2=KB(I)                                                          C0010105
      LP(L1)=0                                                          C0010106
      LP(L2)=50                                                         C0010107
      DO 4 J1=1,15                                                      C0010108
      A(J1)=A1(J1,L1)                                                   C0010109
      B(J1)=B1(J1,L1)                                                   C0010110
      IND=LP(L2)+J1                                                     C0010111
      A(IND)=A1(J1,L2)                                                  C0010112
    4 B(IND)=B1(J1,L2)                                                  C0010113
      CALL MLTFR(A,B,M1,N1,LP,L1,L2)                                    C0010114
      NA=M1(L2)                                                         C0010115
      DO 6 J1=1,NA                                                      C0010116
      IND1=LP(LTEM)+J1                                                  C0010117
      IND2=LP(L2)+J1                                                    C0010118
    6 B(IND1)=B(IND2)-A(IND2)                                           C0010119
      NN=NA+1                                                           C0010120
      IF(NN-N1(L2))7,7,8                                                C0010121
    7 NB=N1(L2)                                                         C0010122
      DO 9 J1=NN,NB                                                     C0010123
      IND1=LP(LTEM)+J1                                                  C0010124
      IND2=LP(L2)+J1                                                    C0010125
    9 B(IND1)=B(IND2)                                                   C0010126
    8 DO 10 J1=1,NB                                                     C0010127
      IND=LP(L2)+J1                                                     C0010128
      A(IND)=B(IND)                                                     C0010129
      IND1=LP(LTEM)+J1                                                  C0010130
   10 B(IND)=B(IND1)                                                    C0010131
      M1(L2)=N1(L2)                                                     C0010132
      CALL MLTFR(A,B,M1,N1,LP,L2,L1)                                    C0010133
      DO 12 J1=1,8                                                      C0010134
      IF(KTO(L1,J1)-L2)12,11,12                                         C0010135
   12 CONTINUE                                                          C0010136
   11 DO 13 J2=J1,7                                                     C0010137
   13 KTO(L1,J2)=KTO(L1,J2+1)                                           C0010138
   15 KTO(L1,8)=0.                                                      C0010139
   14 DO 16 J1=1,8                                                      C0010140
      IF(KFRM(L1,J1)-L2)16,17,16                                        C0010141
   16 CONTINUE                                                          C0010142
   17 DO 18 J2=J1,7                                                     C0010143
   18 KFRM(L1,J2)=KFRM(L1,J2+1)                                         C0010144
   20 KFRM(L1,8)=0.                                                     C0010145
      N1(L2)=1                                                          C0010146
      M1(L2)=1                                                          C0010147
      NA=N1(L1)                                                         C0010148
      DO 22 J1=1,NA                                                     C0010149
      A1(J1,L1)=A(J1)                                                   C0010150
   22 B1(J1,L1)=B(J1)                                                   C0010151
   19 LX(L2)=N1(L2)                                                     C0010152
   21 RETURN                                                            C0010153
      END(0,1,0,0,1)                                                    C0010154
      SUBROUTINE LVLSTO(NC,KFRM,KTO,N1,LVL,NL,NLT,LX,LP)                C0010155
      DIMENSION KFRM(80,8),KTO(80,8),N1(1),LVL(80,14),NL(1),LX(1),LP(1) C0010156
   10 NL(1)=1                                                           C0010157
      LVL(1,1)=1                                                        C0010158
      DO 11 I1=2,NC                                                     C0010159
      NL(I1)=0                                                          C0010160
      NLVL=I1-1                                                         C0010161
      NLN=NL(NLVL)                                                      C0010162
      DO 11 I=1,NLN                                                     C0010163
      LS=LVL(NLVL,I)                                                    C0010164
      DO 11 J=1,8                                                       C0010165
      KT=KTO(LS,J)                                                      C0010166
      IF(KT)17,11,12                                                    C0010167
   12 DO 13 J1=1,8                                                      C0010168
      KF=KFRM(KT,J1)                                                    C0010169
      IF(KF)70,13,14                                                    C0010170
   14 DO 15 J2=1,NLVL                                                   C0010171
      NLN1=NL(J2)                                                       C0010172
      DO 15 J3=1,NLN1                                                   C0010173
      IF(KF-LVL(J2,J3))15,13,15                                         C0010174
   15 CONTINUE                                                          C0010175
      GOTO11                                                            C0010176
   13 CONTINUE                                                          C0010177
      GOTO16                                                            C0010178
   11 CONTINUE                                                          C0010179
      GOTO 17                                                           C0010180
   16 NLJ=NL(I1)                                                        C0010181
      DO19 I2=1,NLJ                                                     C0010182
      LL=LVL(I1,I2)                                                     C0010183
      IF(KT-LL)19,11,19                                                 C0010184
   19 CONTINUE                                                          C0010185
      NL(I1)=NL(I1)+1                                                   C0010186
      NLJ=NL(I1)                                                        C0010187
      IF(14-NLJ)25,18,18                                                C0010188
   25 PRINT 26,I1                                                       C0010189
   26 FORMAT(34H EXCESSIVE NO. OF BOXES AT LEVEL  I3)                   C0010190
      STOP44444                                                         C0010191
   18 LVL(I1,NLJ)=KT                                                    C0010192
      NLT=I1                                                            C0010193
      GOTO 11                                                           C0010194
   70 STOP22022                                                         C0010195
   17 LX(1)=0                                                           C0010196
      DO21 I1=2,NLT                                                     C0010197
      NLJ=NL(I1)                                                        C0010198
      DO21 J1=1,NLJ                                                     C0010199
      L=LVL(I1,J1)                                                      C0010200
      KT=0                                                              C0010201
      DO 22 J2=1,8                                                      C0010202
      KF=KFRM(L,J2)                                                     C0010203
      IF(KF)70,21,22                                                    C0010204
   22 KT=KT+LX(KF)                                                      C0010205
   21 LX(L)=KT+N1(L)                                                    C0010206
      LX(1)=N1(1)                                                       C0010207
      L=LVL(2,1)                                                        C0010208
      IF(LX(L)-15)28,29,29                                              C0010209
   28 LX(L)=15                                                          C0010210
   29 LP(1)=0                                                           C0010211
      DO23 L=2,NC                                                       C0010212
   23 LP(L)=LP(L-1)+LX(L-1)                                             C0010213
      RETURN                                                            C0010214
      END(0,1,0,0,1)                                                    C0010215
      SUBROUTINE SYSTFN(KFRM,KTO,M1,N1,A,B,A1,B1,LVL,NL,NLT,LX,LP,LMAX) C0010216
      DIMENSION A(1),B(1),M1(1),N1(1),NL(1),LX(1),LP(1),                C0010217
     XKFRM(80,8),KTO(80,8),A1(15,80),B1(15,80),LVL(80,14)               C0010218
      COMMON LTEM                                                       C0010219
      MX=M1(LMAX)                                                       C0010220
      NX=N1(LMAX)                                                       C0010221
   30 L=LVL(3,1)                                                        C0010222
      IF(L)49,45,31                                                     C0010223
   31 DO320 I1=3,NLT                                                    C0010224
      NLJ=NL(I1)                                                        C0010225
      DO320 J1=1,NLJ                                                    C0010226
      L=LVL(I1,J1)                                                      C0010227
      KF=KFRM(L,1)                                                      C0010228
      IF(KF-1)49,38,37                                                  C0010229
   37 N=N1(KF)                                                          C0010230
      DO33 J2=1,N                                                       C0010231
      IND1=LP(LMAX)+J2                                                  C0010232
      IND2=LP(KF)+J2                                                    C0010233
      A(IND1)=A(IND2)                                                   C0010234
   33 B(IND1)=B(IND2)                                                   C0010235
      M1(LMAX)=M1(KF)                                                   C0010236
      N1(LMAX)=N1(KF)                                                   C0010237
      NA=2                                                              C0010238
   41 DO43 J2=NA,8                                                      C0010239
      KF=KFRM(L,J2)                                                     C0010240
      IF(KF-1)321,36,34                                                 C0010241
   34 CALL ADFRAC(A,B,M1,N1,LP,KF,LMAX)                                 C0010242
   43 CONTINUE                                                          C0010243
  321 IF(I1-NLT)32,45,45                                                C0010244
   32 CALL MLTFR(A,B,M1,N1,LP,LMAX,L)                                   C0010245
  320 CONTINUE                                                          C0010246
   38 KF=KFRM(L,2)                                                      C0010247
      IF(KF)149,149,39                                                  C0010248
   39 N=N1(KF)                                                          C0010249
      DO40 J=1,N                                                        C0010250
      IND1=LP(LMAX)+J                                                   C0010251
      IND2=LP(KF)+J                                                     C0010252
      B(IND1)=B(IND2)                                                   C0010253
   40 A(IND1)=A(IND2)+B(IND1)                                           C0010254
      N1(LMAX)=N1(KF)                                                   C0010255
      M1(LMAX)=N1(LMAX)                                                 C0010256
      NA=3                                                              C0010257
      GOTO 41                                                           C0010258
   36 M=M1(LMAX)                                                        C0010259
      DO 42 J=1,M                                                       C0010260
      IND1=LP(LMAX)+J                                                   C0010261
   42 A(IND1)=A(IND1)+B(IND1)                                           C0010262
      M=M1(LMAX)+1                                                      C0010263
      N=N1(LMAX)                                                        C0010264
      DO44 J=M,N                                                        C0010265
      IND1=LP(LMAX)+J                                                   C0010266
   44 A(IND1)=B(IND1)                                                   C0010267
      M1(LMAX)=N1(LMAX)                                                 C0010268
      GOTO 43                                                           C0010269
   45 LA=LVL(2,1)                                                       C0010270
      IF(LA-LMAX)46,48,46                                               C0010271
   46 DO47 J=1,NX                                                       C0010272
      IND1=LP(LA)+J                                                     C0010273
      A(IND1)=A1(J,LMAX)                                                C0010274
   47 B(IND1)=B1(J,LMAX)                                                C0010275
      M1(LA)=MX                                                         C0010276
      N1(LA)=NX                                                         C0010277
      CALL MLTFR(A,B,M1,N1,LP,LA,LMAX)                                  C0010278
   48 CALL MLTFR(A,B,M1,N1,LP,LMAX,1)                                   C0010279
      RETURN                                                            C0010280
   49 STOP33033                                                         C0010281
  149 STOP44044                                                         C0010282
      END(0,1,0,0,1)                                                    C0010283
      SUBROUTINE POLYVA(A,M,W,S)                                        C0010284
      DIMENSION A(1)                                                    C0010285
      S=A(M)                                                            C0010286
   11 IF(M-2)14,14,12                                                   C0010287
   12 S=S*W**2                                                          C0010288
      M=M-2                                                             C0010289
      S=S-A(M)                                                          C0010290
      IF(M-2)14,14,13                                                   C0010291
   13 S=S*W**2                                                          C0010292
      M=M-2                                                             C0010293
      S=S+A(M)                                                          C0010294
      GOTO 11                                                           C0010295
   14 RETURN                                                            C0010296
      END(0,1,0,0,1)                                                    C0010297
      SUBROUTINE POLYVB(N,C1,C2,W,A1,A2)                                C0010298
      D=MODF(N,2)                                                       C0010299
      IF(D)17,12,11                                                     C0010300
   11 N=N-1                                                             C0010301
      D=MODF(N,4)                                                       C0010302
      IF(D)17,16,15                                                     C0010303
   12 D=MODF(N,4)                                                       C0010304
      IF(D)17,14,13                                                     C0010305
   13 A1=-C1                                                            C0010306
      A2=C2*W                                                           C0010307
      RETURN                                                            C0010308
   14 A1=C1                                                             C0010309
      A2=-C2*W                                                          C0010310
      RETURN                                                            C0010311
   15 A1=-C2                                                            C0010312
      A2=-C1*W                                                          C0010313
      RETURN                                                            C0010314
   16 A1=C2                                                             C0010315
      A2=C1*W                                                           C0010316
      RETURN                                                            C0010317
   17 STOP66066                                                         C0010318
      END(0,1,0,0,1)                                                    C0010319
      SUBROUTINE ADFRAC(A,B,M1,N1,LP,I1,I2)                             C0010320
      COMMON LTEM                                                       C0010321
      DIMENSION A(1),B(1),M1(1),N1(1),LP(1)                             C0010322
      M=M1(I1)+N1(I2)-1                                                 C0010323
      N=M1(I2)+N1(I1)-1                                                 C0010324
      IF(M-N)11,12,12                                                   C0010325
   12 J1=I1                                                             C0010326
      J2=I2                                                             C0010327
      M2=M                                                              C0010328
      KD=N                                                              C0010329
      GOTO 13                                                           C0010330
   11 J1=I2                                                             C0010331
      J2=I1                                                             C0010332
      M2=N                                                              C0010333
      KD=M                                                              C0010334
   13 CALL MTPY(A,B,M1,N1,LP,J1,J2,A)                                   C0010335
      CALL MTPY(A,B,M1,N1,LP,J2,J1,B)                                   C0010336
      M1(I2)=M2                                                         C0010337
      DO 14 J=1,KD                                                      C0010338
      ID1=LP(LTEM)+J                                                    C0010339
   14 A(ID1)=B(ID1)+A(ID1)                                              C0010340
      DO15 J=1,M2                                                       C0010341
      ID1=LP(LTEM)+J                                                    C0010342
      ID2=LP(I2)+J                                                      C0010343
   15 A(ID2)=A(ID1)                                                     C0010344
      CALL MTPY(B,B,N1,N1,LP,I1,I2,B)                                   C0010345
      N1(I2)=N1(I2)+N1(I1)-1                                            C0010346
      N2=N1(I2)                                                         C0010347
      DO 16 J=1,N2                                                      C0010348
      ID1=LP(LTEM)+J                                                    C0010349
      ID2=LP(I2)+J                                                      C0010350
   16 B(ID2)=B(ID1)                                                     C0010351
      RETURN                                                            C0010352
      END(0,1,0,0,1)                                                    C0010353
      SUBROUTINE MLTFR(A,B,M1,N1,LP,I1,I2)                              C0010354
      COMMON LTEM                                                       C0010355
      DIMENSION A(1),B(1),M1(1),N1(1),LP(1)                             C0010356
      CALL MTPY(A,A,M1,M1,LP,I1,I2,A)                                   C0010357
      MT=M1(I1)+M1(I2)-1                                                C0010358
      DO11 J=1,MT                                                       C0010359
      ID1=LP(I2)+J                                                      C0010360
      ID2=LP(LTEM)+J                                                    C0010361
   11 A(ID1)=A(ID2)                                                     C0010362
      M1(I2)=MT                                                         C0010363
      CALL MTPY(B,B,N1,N1,LP,I1,I2,B)                                   C0010364
      MT=N1(I1)+N1(I2)-1                                                C0010365
      DO12 J=1,MT                                                       C0010366
      ID1=LP(I2)+J                                                      C0010367
      ID2=LP(LTEM)+J                                                    C0010368
   12 B(ID1)=B(ID2)                                                     C0010369
      N1(I2)=MT                                                         C0010370
      RETURN                                                            C0010371
      END(0,1,0,0,1)                                                    C0010372
      SUBROUTINE MTPY(A,B,M1,N1,LP,I1,I2,C)                             C0010373
      COMMON LTEM                                                       C0010374
      DIMENSIONA(1),B(1),M1(1),N1(1),LP(1),C(1)                         C0010375
      M=M1(I1)                                                          C0010376
      N=N1(I2)                                                          C0010377
      MT=M+N-1                                                          C0010378
      DO 11 I=1,MT                                                      C0010379
      ID1=LP(LTEM)+I                                                    C0010380
   11 C(ID1)=0.                                                         C0010381
      DO12 J=1,M                                                        C0010382
      DO12 K=1,N                                                        C0010383
      ID1=LP(LTEM)+J+K-1                                                C0010384
      ID2=LP(I1)+J                                                      C0010385
      ID3=LP(I2)+K                                                      C0010386
   12 C(ID1)=A(ID2)*B(ID3)+C(ID1)                                       C0010387
      RETURN                                                            C0010388
      END(0,1,0,0,1)                                                    C0010389
      SUBROUTINE OUTPUT(A1,A2,B1,B2,W)                                  C0010390
      BD=B1**2+B2**2                                                    C0010391
      ABR=(A1*B1+A2*B2)/BD                                              C0010392
      BBR=(A2*B1-A1*B2)/BD                                              C0010393
      R=SQRTF(ABR**2+BBR**2)                                            C0010394
      PHI=ATANF(BBR/ABR)                                                C0010395
      WRITE OUTPUT TAPE2,1000,W,A1,A2,B1,B2,ABR,BBR,R,PHI               C0010396
 1000 FORMAT(3H0W=E11.4,6H   A1=E11.4,6H   A2=E11.4,6H   B1=E11.4,6H   BC0010397
     X2=E11.4/3H0A=E11.4,5H   B=E11.4,5H   R=E11.4,7H   PHI=E11.4)      C0010398
      RETURN                                                            C0010399
      END(0,1,0,0,1)                                                    C0010400
