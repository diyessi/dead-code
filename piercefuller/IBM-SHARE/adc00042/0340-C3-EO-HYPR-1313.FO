*     LIST                                                              EOHYPR01
      SUBROUTINE HYPFN(A1,A2,B1,B2,C1,C2,Z,EP,F1,F2)                    EOHYPR02
      IF(ABSF(Z)-1.)1,2,2                                               EOHYPR03
 2    WRITE OUTPUT TAPE 3,3                                             EOHYPR04
 3    FORMAT(///47H ARGUMENT OF HYPFN GREATER THAN OR EQUAL TO ONE///)  EOHYPR05
      CALL EXIT                                                         EOHYPR06
 1    I=0                                                               EOHYPR07
      F1=1.                                                             EOHYPR08
      F2=0.                                                             EOHYPR09
      A3=A1                                                             EOHYPR10
      B3=B1                                                             EOHYPR11
      C3=C1                                                             EOHYPR12
      S1=1.                                                             EOHYPR13
      S2=0.                                                             EOHYPR14
      A=1.                                                              EOHYPR15
 4    S3=S1*A3-S2*A2                                                    EOHYPR16
      S4=S1*A2+S2*A3                                                    EOHYPR17
      S1=S3*B3-S4*B2                                                    EOHYPR18
      S2=S3*B2+S4*B3                                                    EOHYPR19
      X1=C3**2+C2**2                                                    EOHYPR20
      S3=(S1*C3+S2*C2)/X1                                               EOHYPR21
      S4=(-S1*C2+S2*C3)/X1                                              EOHYPR22
      S1=S3*Z/A                                                         EOHYPR23
      S2=S4*Z/A                                                         EOHYPR24
      F1=F1+S1                                                          EOHYPR25
      F2=F2+S2                                                          EOHYPR26
      EP1=SQRTF((S1**2+S2**2)/(F1**2+F2**2))                            EOHYPR27
      IF(EP1-EP)5,6,6                                                   EOHYPR28
 6    I=I+1                                                             EOHYPR29
      A3=A3+1.                                                          EOHYPR30
      B3=B3+1.                                                          EOHYPR31
      C3=C3+1.                                                          EOHYPR32
      A=A+1.                                                            EOHYPR33
      IF(I-30)4,9,9                                                     EOHYPR34
 9    IF(EP1-0.01)5,7,7                                                 EOHYPR35
 7    EP2=SQRTF(S1**2+S2**2)                                            EOHYPR36
      WRITE OUTPUT TAPE 3,8,Z,EP1,EP2                                   EOHYPR37
 8    FORMAT(///44H ERROR IN HYPFN ROUTINE FOR ARGUMENT EQUALS E10.4/23HEOHYPR38
     1 RELATIVE ERROR EQUALS E15.7/23H ABSOLUTE ERROR EQUALS E15.7///)  EOHYPR39
 5    RETURN                                                            EOHYPR40
      END                                                               EOHYPR41
