      SUBROUTINE EIGENH(A,VALU,N)                                       OREIG 01
      DIMENSION A(10,10,2),VALU(10),DIAG(10),SUPERD( 9,2),              OREIG 02
     1VALL(10),Q( 9),COS(2),SIN(2),T1(2),T2(2)                          OREIG 03
      ANORM=0.                                                          OREIG 04
      DO 6 I=1,N                                                        OREIG 05
      DO 6 J=1,N                                                        OREIG 06
    6 ANORM=ANORM+A(I,J,1)**2+A(I,J,2)**2                               OREIG 07
      ANORM=SQRTF(ANORM)                                                OREIG 08
      NN=N-2                                                            OREIG 09
      DO 160 I=1,NN                                                     OREIG 10
      II=I+2                                                            OREIG 11
      DO 160 J=II,N                                                     OREIG 12
      T1=A(I,I+1,1)                                                     OREIG 13
      T1(2)=A(I,I+1,2)                                                  OREIG 14
      T2=A(I,J,1)                                                       OREIG 15
      T2(2)=-A(I,J,2)                                                   OREIG 16
      IF(T2**2+T2(2)**2)910,160,910                                     OREIG 17
  910 T=SQRTF(T1**2+T1(2)**2+T2**2+T2(2)**2)                            OREIG 18
      SIN=T2/T                                                          OREIG 19
      SIN(2)=T2(2)/T                                                    OREIG 20
      COS=T1/T                                                          OREIG 21
      COS(2)=T1(2)/T                                                    OREIG 22
      DO 105 K=1,N                                                      OREIG 23
      T2=COS*A(K,I+1,1)+COS(2)*A(K,I+1,2)+SIN*A(K,J,1)-SIN(2)*A(K,J,2)  OREIG 24
      T2(2)=COS*A(K,I+1,2)-COS(2)*A(K,I+1,1)+SIN*A(K,J,2)+SIN(2)*A(K,J,1OREIG 25
     1)                                                                 OREIG 26
      T3=COS*A(K,J,1)-COS(2)*A(K,J,2)-SIN*A(K,I+1,1)-SIN(2)*A(K,I+1,2)  OREIG 27
      A(K,J,2)=COS*A(K,J,2)+COS(2)*A(K,J,1)-SIN*A(K,I+1,2)+SIN(2)*A(K,I+OREIG 28
     11,1)                                                              OREIG 29
      A(K,J,1)=T3                                                       OREIG 30
      A(K,I+1,1)=T2                                                     OREIG 31
  105 A(K,I+1,2)=T2(2)                                                  OREIG 32
      DO 125 K=I,N                                                      OREIG 33
      T2=COS*A(I+1,K,1)-COS(2)*A(I+1,K,2)+SIN*A(J,K,1)+SIN(2)*A(J,K,2)  OREIG 34
      T2(2)=COS*A(I+1,K,2)+COS(2)*A(I+1,K,1)+SIN*A(J,K,2)-              OREIG 35
     1SIN(2)*A(J,K,1)                                                   OREIG 36
      T3=COS*A(J,K,1)+COS(2)*A(J,K,2)-SIN*A(I+1,K,1)+SIN(2)*A(I+1,K,2)  OREIG 37
      A(J,K,2)=COS*A(J,K,2)-COS(2)*A(J,K,1)-SIN*A(I+1,K,2)-             OREIG 38
     1SIN(2)*A(I+1,K,1)                                                 OREIG 39
      A(J,K,1)=T3                                                       OREIG 40
      A(I+1,K,1)=T2                                                     OREIG 41
  125 A(I+1,K,2)=T2(2)                                                  OREIG 42
  160 CONTINUE                                                          OREIG 43
      DO200I=1,N                                                        OREIG 44
      DIAG(I)=A(I,I,1)                                                  OREIG 45
      VALU(I)=ANORM                                                     OREIG 46
  200 VALL(I)=-ANORM                                                    OREIG 47
      DO230I=2,N                                                        OREIG 48
      SUPERD(I-1,1)=A(I-1,I,1)                                          OREIG 49
      SUPERD(I-1,2)=A(I-1,I,2)                                          OREIG 50
  230 Q(I-1)=SUPERD(I-1,1)**2+SUPERD(I-1,2)**2                          OREIG 51
      TAU=0.0                                                           OREIG 52
      I=1                                                               OREIG 53
  260 MATCH=0                                                           OREIG 54
      T2=0.0                                                            OREIG 55
      T1=1.0                                                            OREIG 56
      DO450J=1,N                                                        OREIG 57
      P=DIAG(J)-TAU                                                     OREIG 58
      IF(T2)300,330,300                                                 OREIG 59
  300 IF(T1)310,370,310                                                 OREIG 60
  310 T=P*T1-Q(J-1)*T2                                                  OREIG 61
      IF ACCUMULATOR OVERFLOW 311,410                                   OREIG 62
  311 T1=T1*1.E-30                                                      OREIG 63
      T2=T2*1.E-30                                                      OREIG 64
      GO TO 310                                                         OREIG 65
  330 IF(T1)335,350,350                                                 OREIG 66
  335 T1=-1.0                                                           OREIG 67
      T=-P                                                              OREIG 68
      GOTO410                                                           OREIG 69
  350 T1=1.0                                                            OREIG 70
      T=P                                                               OREIG 71
      GOTO410                                                           OREIG 72
  370 IF(Q(J-1))380,350,380                                             OREIG 73
  380 IF(T2)400,390,390                                                 OREIG 74
  390 T=-1.0                                                            OREIG 75
      GOTO410                                                           OREIG 76
  400 T=1.0                                                             OREIG 77
  410 IF(T1)425,420,420                                                 OREIG 78
  420 IF(T)440,430,430                                                  OREIG 79
  425 IF(T)430,440,440                                                  OREIG 80
  430 MATCH=MATCH+1                                                     OREIG 81
  440 T2=T1                                                             OREIG 82
  450 T1=T                                                              OREIG 83
      DO 531 K=1,N                                                      OREIG 84
      IF(K-MATCH)470,470,520                                            OREIG 85
  470 IF(TAU-VALL(K))530,530,480                                        OREIG 86
  480 VALL(K)=TAU                                                       OREIG 87
      GOTO530                                                           OREIG 88
  520 IF(TAU-VALU(K))525,530,530                                        OREIG 89
  525 VALU(K)=TAU                                                       OREIG 90
  530 CONTINUE                                                          OREIG 91
  531 CONTINUE                                                          OREIG 92
  540 IF(VALU(I)-VALL(I)-5.0E-8)570,570,550                             OREIG 93
  550 IF(VALU(I))560,580,560                                            OREIG 94
  560 IF(ABSF(VALL(I)/VALU(I)-1.0)-5.0E-8)570,570,580                   OREIG 95
  570 I=I+1                                                             OREIG 96
      IF(I-N)540,540,890                                                OREIG 97
  580 TAU=(VALL(I)+VALU(I))/2.0                                         OREIG 98
      GOTO260                                                           OREIG 99
  890 RETURN                                                            OREIG100
  950 END                                                               OREIG101
