       ENTRY   -(FIL)                                                   9LUP0010
       ENTRY   -(RTN)                                                   9LUP0011
*                                                                       9LUP0012
 (IOH) XCA                           INITIALIZATION =                   9LUP0013
       SXA  AX1,1                    SAVE                               9LUP0014
       SXA  AX2,2                    INDEX                              9LUP0015
       SXA  AX4,4                    REGISTERS.                         9LUP0016
       STA  TYPE                     SET ADDRESS FOR TYPE OF I/O.       9LUP0017
       STD  INITSW                   SET SWITCHES ( INPUT / NOP,        9LUP0018
       STD  CCOCTL                   OUTPUT / TRA).                     9LUP0019
       STD  CCINTG                   ..                                 9LUP0020
       STD  CCHOLL                   ..                                 9LUP0021
       STD  CCFFXD+2                 ..                                 9LUP0022
       STD  CCEFLT                   ..                                 9LUP0023
       STD  CCBLNK                   ..                                 9LUP0024
       STD  CCALPH                   ..                                 9LUP0025
       STD  INOUT+1                  ..                                 9LUP0026
       CLA  NOP                      RESET                              9LUP0027
       STD  ENDFSW                   END OF FORMAT SWITCH.              9LUP0028
       CLA     TRA               RESET FIELD                            9LUP0029
       STD     EXITSW            EXIT SWITCH                            9LUP0030
       CAL  *+1                      SAVE                               9LUP0031
       DCT                           CONDITION                          9LUP0032
       CAL  NOP                      OF DIVIDE                          9LUP0033
       SLW  DCR                      CHECK TRIGGER.                     9LUP0034
       LFTM                          LEAVE FLOATING TRAP MODE.          9LUP0035
       CAL  0                        SAVE                               9LUP0036
       SLW  C(0)                     C(0),                              9LUP0037
       CAL  2                        SAVE                               9LUP0038
       SLW  C(2)                     C(2).                              9LUP0039
       STZ     0                 CLEAR LOCATION 0                       9LUP0040
       LAC  AX4,4                    SETUP RETURN ADDRESS               9LUP0041
       TXI  *+1,4,2                  (TSX+2)                            9LUP0042
       SXA  0,4                      IN LOCATION 0.                     9LUP0043
       CAL  IOCNV                    SETUP LIST TRAP ADDRESS            9LUP0044
       SLW  2                        IN LOCATION 2.                     9LUP0045
       STZ  INT                      RESET INT.                         9LUP0046
       STZ  PEX                      RESET PEX.                         9LUP0047
       SXA  ENDX,0                   RESET END PAREN COUNT.             9LUP0048
       XCA                           RESTORE UNIT TAG TO AC.            9LUP0049
INITSW NOP  PSW1                                                        9LUP0050
USW1   TRA  NOUNP                UNPACK SWITCHES NOP-UNPACK,TRA-NORM    9LUP0051
       CLA  UNP1                 RESET UNPACK COUNTERS TO VALUES AT     9LUP0052
       STA  DX1                  END OF PREVIOUS OPERATION              9LUP0053
       CLA  UNP2                                                        9LUP0054
       STA  DX2                                                         9LUP0055
       CLA     UMQD          SET PARTIAL WORD FROM                      9LUP0056
       STO     MQD           PREVIOUS UNPACK                            9LUP0057
       CLA  LBUF                 RESET  PACK COUNTERS                   9LUP0058
       STA  PA1                                                         9LUP0059
       CLA  L(1)                                                        9LUP0060
       STO  PA2                                                         9LUP0061
       TRA     RST+2         BYPASS INPUT AND COUNTER RESET             9LUP0062
NOUNP  TSX     $(IOS),4                                                 9LUP0063
       TSX     INOUT,4                                                  9LUP0064
TRA    TRA     RST+2                                                    9LUP0065
PSW1   TRA  RST                  PACK SWITCH  TRA-NORMAL NOP-PACK       9LUP0066
       CLA  PA1                  SET PACK COUNTERS FROM END OF          9LUP0067
       STA  PAK)                 PREVIOUS OPERATION.                    9LUP0068
       CLA  PA2                                                         9LUP0069
       STO  WORD                                                        9LUP0070
       CLA  L(1)                 RESET UNPACK SWITCHES                  9LUP0071
       STA  UNP1                                                        9LUP0072
       STA  UNP2                                                        9LUP0073
       TRA     RST+2                                                    9LUP0074
RST    TSX     $(IOS),4                                                 9LUP0075
       TSX     REST,4                                                   9LUP0076
       LXA  AX4,4                    PREPARE                            9LUP0077
       CLA  1,4                      TO SCAN                            9LUP0078
       PAC  ,2                       FORMAT STATEMENT.                  9LUP0079
       PDX  ,1                       SET                                9LUP0080
       AXT  1,4                      DIRECTION                          9LUP0081
       TXL  *+2,1,0                  OF FORMAT                          9LUP0082
       AXT  -1,4                     SCAN                               9LUP0083
       SXD  FSET1,4                  EITHER                             9LUP0084
       SXD  HSET1,4                  FORWARDS                           9LUP0085
       SXD  BSET1,4                  OR BACKWARDS.                      9LUP0086
       REM  FORMAT SCAN / ENTRY FROM NUMBER.                            9LUP0087
SCAN1  LDQ  0,2                      EXAMINE                            9LUP0088
       AXT  6,1                      NEXT                               9LUP0089
SCAN2  PXD  ,0                       FORMAT                             9LUP0090
       LGL  6                        CHARACTER,                         9LUP0091
       PAX  ,4                       AND TAKE                           9LUP0092
SCAN3  TRA* FRMTR,4                * INDICATED TRANSFER.                9LUP0093
*                                                                       9LUP0094
