* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * 9LUP0369
*                                                                       9LUP0370
       REM  ENTRY FROM FORMAT SCAN ON F.                                9LUP0371
CCFFXD CLS  PEX                      MOVE NEGATIVE OF                   9LUP0372
       STO  EXP                      SCALE FACTOR INTO EXP.             9LUP0373
       NOP  *+3                      IF INPUT,                          9LUP0374
       REM  ENTRY FROM CCEFLT.                                          9LUP0375
FXPT   CLA  NOP                      PICKUP NOP, AND                    9LUP0376
       TRA  SETFX                  * GO SET FIXSW.                      9LUP0377
       AXT  CHAR,4                   IF OUTPUT,                         9LUP0378
       SXA  FXFL1,4                  SET                                9LUP0379
       AXT  1,4                      FXFL1,2,3                          9LUP0380
       SXD  FXFL2,4                  IN CONVERSION ROUTINE              9LUP0381
       SXD  FXFL3,4                  FOR FIXED POINT,                   9LUP0382
       AXT  FXD,4                    PICKUP FXD, AND                    9LUP0383
       TRA  SETAD                  * GO SET CNVSW.                      9LUP0384
*                                                                       9LUP0385
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * 9LUP0386
*                                                                       9LUP0387
       REM  ENTRY FROM FORMAT SCAN ON E.                                9LUP0388
CCEFLT NOP  *+3                      IF INPUT,                          9LUP0389
       STZ  EXP                      CLEAR EXP, AND                     9LUP0390
       TRA  FXPT                   * EXIT TO CCFFXD.                    9LUP0391
       AXT  CHAR-4,4                 IF OUTPUT,                         9LUP0392
       SXA  FXFL1,4                  SET                                9LUP0393
       AXT  5,4                      FXFL1,2,3                          9LUP0394
       SXD  FXFL2,4                  IN CONVERSION ROUTINE              9LUP0395
       SXD  FXFL3,4                  FOR FLOATING POINT.                9LUP0396
       AXT  FLT,4                    PICKUP FLT, AND                    9LUP0397
       TRA  SETAD                  * GO SET CNVSW.                      9LUP0398
