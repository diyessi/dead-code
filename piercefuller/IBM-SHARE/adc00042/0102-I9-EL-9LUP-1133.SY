* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * 9LUP0163
*                                                                       9LUP0164
       REM  ENTRY FROM FORMAT SCAN ON NUMBER.                           9LUP0165
NUMBER STO  DIG                      CONVERT                            9LUP0166
       CLA  INT                      BCD                                9LUP0167
       ALS  2                        DIGITS                             9LUP0168
       ADD  INT                      TO                                 9LUP0169
       ALS  1                        BINARY                             9LUP0170
       ACL  DIG                      INTEGER.                           9LUP0171
       REM  ENTRY FROM CCSCFM.                                          9LUP0172
SCAN4  STO  INT                      SET INT.                           9LUP0173
       REM  ENTRY FROM CCCMMA, CCDCPT.                                  9LUP0174
SCAN5  TIX  SCAN2,1,1              * IF CHARACTER COUNT IS EXHAUSTED,   9LUP0175
 FSET1 TXI  SCAN1,2,1              * EXAMINE NEXT FORMAT WORD.          9LUP0176
*                                                                       9LUP0177
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * 9LUP0178
*                                                                       9LUP0179
       REM  ENTRY FROM FORMAT SCAN ON LEFT PARENTHESIS.                 9LUP0180
CCLPAR SXA  BX1,1                    SAVE CURRENT                       9LUP0181
       SXA  BX2,2                    SCAN POSITION                      9LUP0182
       STQ  MQR                      FOR POSSIBLE RESCAN.               9LUP0183
       LXA  INT,4                    SAVE                               9LUP0184
       SXA  BX4,4                    GROUP COUNT, AND                   9LUP0185
       SXA  GROUPX,4                 GROUP INDEX.                       9LUP0186
       LXA  ENDX,4                   ADD 1 TO                           9LUP0187
       TXI  *+1,4,1                  END PAREN COUNT                    9LUP0188
       SXA  ENDX,4                   TO DETERMINE END OF FORMAT.        9LUP0189
       SXA  PARX,4                   SAVE PAREN INDEX FOR RESCAN.       9LUP0190
       TRA  SCAN                   * THEN CONTINUE SCAN.                9LUP0191
*                                                                       9LUP0192
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * 9LUP0193
*                                                                       9LUP0194
       REM  ENTRY FROM FORMAT SCAN ON COMMA.                            9LUP0195
CCCMMA TSX  FIELD,4                * GO PROCESS CURRENT FIELD.          9LUP0196
       REM  ENTRY FROM CCSLSH,CCRPAR,CCHOLL,CCBLNK.                     9LUP0197
RESUME LDQ  MQ                       RESTORE                            9LUP0198
CX1    AXT  ..,1                     CURRENT                            9LUP0199
CX2    AXT  ..,2                     POSITION OF FORMAT SCAN,           9LUP0200
       REM  ENTRY FROM CCLPAR,CCSCFP,CCRPAR,CCINTG,CCHOLL.              9LUP0201
SCAN   STZ  INT                      CLEAR INT, AND                     9LUP0202
       TRA  SCAN5                  * CONTINUE FORMAT SCAN.              9LUP0203
*                                                                       9LUP0204
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * 9LUP0205
*                                                                       9LUP0206
       REM  ENTRY FROM FORMAT SCAN ON SLASH.                            9LUP0207
CCSLSH TSX  FIELD,4                * GO PROCESS CURRENT FIELD.          9LUP0208
       TSX  INOUT,4                * GO PREPARE FOR NEXT LINE OF I/O.   9LUP0209
       TRA  RESUME                 * GO RESUME SCAN.                    9LUP0210
*                                                                       9LUP0211
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * 9LUP0212
*                                                                       9LUP0213
       REM  ENTRY FROM FORMAT SCAN ON P.                                9LUP0214
CCSCFP CLA  INT                      MOVE SCALE FACTOR                  9LUP0215
       STO  PEX                      INTO PEX.                          9LUP0216
       TRA  SCAN                   * GO CONTINUE SCAN.                  9LUP0217
*                                                                       9LUP0218
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * 9LUP0219
4                                                                       9LUP0220
       REM  ENTRY FROM FORMAT SCAN ON O.                                9LUP0221
CCOCTL NOP  *+3                      (INPUT / NOP, OUTPUT / TRA).       9LUP0222
       AXT  ONPT,4                   PICKUP OCTAL INPUT DESIGNATION,    9LUP0223
       TRA  SETAD                  * AND GO SET MODE SWITCH.            9LUP0224
       AXT  OOUT,4                   PICKUP OCTAL OUTPUT DESIGNATION,   9LUP0225
       TRA  SETAD                  * AND GO SET MODE SWITCH.            9LUP0226
*                                                                       9LUP0227
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * 9LUP0228
*                                                                       9LUP0229
       REM  ENTRY FROM FORMAT SCAN ON MINUS.                            9LUP0230
CCSCFM CLS  INT                      SET SIGN OF SCALE FACTOR NEGATIVE, 9LUP0231
       TRA  SCAN4                  * AND GO CONTINUE SCAN.              9LUP0232
*                                                                       9LUP0233
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * 9LUP0234
*                                                                       9LUP0235
       REM  ENTRY FROM FORMAT SCAN ON RIGHT PARENTHESIS.                9LUP0236
CCRPAR TSX  FIELD,4                * GO PROCESS CURRENT FIELD.          9LUP0237
BX4    AXT  ..,4                     TEST GROUP COUNT, AND              9LUP0238
       TIX  GROUP,4,1                PROCESS GROUP UNTIL EXHAUSTED.     9LUP0239
ENDX   AXT  ..,4                     THEN TEST END COUNT, AND           9LUP0240
       TNX  ENDFMT,4,1               IF NOT EXHAUSTED,                  9LUP0241
       SXA  ENDX,4                   REDUCE COUNT, AND                  9LUP0242
       TRA  RESUME                 * GO RESUME SCAN.                    9LUP0243
       REM  ENTRY FROM FORMAT SCAN ON ILLEGAL CONTROL CHARACTER.        9LUP0244
STOP   LDI     *+2               EXIT FOR EXECUTION                     9LUP0245
       TRA     $(EXE)            ERROR                                  9LUP0246
       PZE     0,1,*+1           INCORRECT FORMAT STATMNT.              9LUP0247
ENDFMT CLA  TRA                      SET SWITCH IN IOCNV                9LUP0248
       STD  ENDFSW                   FOR END OF FORMAT, AND             9LUP0249
       TRA  LIST                   * GO SEE IF LIST IS EXHAUSTED.       9LUP0250
       REM  REENTRY FROM IOCNV AFTER END OF FORMAT.                     9LUP0251
RESCAN CLA  NOP                      RESET                              9LUP0252
       STD  ENDFSW                   END OF FORMAT SWITCH.              9LUP0253
       STD  EXITSW                   SET EXIT SWITCH IN FIELD.          9LUP0254
       TSX  INOUT,4                * GO PREPARE FOR NEXT LINE OF I/O.   9LUP0255
PARX   AXT  ..,4                     PICKUP PAREN INDEX TO              9LUP0256
       SXA  ENDX,4                   RESET END COUNT.                   9LUP0257
GROUPX AXT  ..,4                     PICKUP GROUP INDEX TO              9LUP0258
GROUP  SXA  BX4,4                    SET GROUP COUNT.                   9LUP0259
BX1    AXT  ..,1                     RESET FORMAT POSITION              9LUP0260
BX2    AXT  ..,2                     TO BEGINNING OF                    9LUP0261
       LDQ  MQR                      LAST GROUP, AND                    9LUP0262
       TRA  SCAN                   * GO CONTINUE SCAN.                  9LUP0263
*                                                                       9LUP0264
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * 9LUP0265
*                                                                       9LUP0266
       REM  ENTRY FROM FORMAT SCAN ON DECIMAL POINT.                    9LUP0267
CCDCPT CAL  DCPT                     MODIFY                             9LUP0268
       SLW  SCAN3                    SCAN.                              9LUP0269
       STZ  DIG                      CLEAR DIG.                         9LUP0270
       TRA  SCAN5                  * GO CONTINUE SCAN.                  9LUP0271
       REM  REENTRY FROM FORMAT SCAN.                                   9LUP0272
DCPT   TRA  *+1                      COLLECT                            9LUP0273
       TXH  *+3,4,9                  DECIMAL                            9LUP0274
       STO  DIG                      POSITION                           9LUP0275
       TRA  SCAN5                  * MODULO 9.                          9LUP0276
       SUB  BLANK                    ON NEXT                            9LUP0277
       TZE  SCAN5                  * CONTROL CHARACTER,                 9LUP0278
       CAL  *+2                      RESET                              9LUP0279
       SLW  SCAN3                    FORMAT SCAN                        9LUP0280
       TRA* FRMTR,4                * AND GO CONTINUE SCAN.              9LUP0281
*                                                                       9LUP0282
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * 9LUP0283
*                                                                       9LUP0284
       REM  ENTRY FROM FORMAT SCAN ON I.                                9LUP0285
CCINTG NOP  *+5                      IF INPUT,                          9LUP0286
       CLA  TRA                      PICKUP TRA, AND                    9LUP0287
       REM  ENTRY FROM CCFFXD.                                          9LUP0288
SETFX  STD  FIXSW                    SET FIXSW, AND                     9LUP0289
       AXT  DBC,4                    PICKUP DBC TO                      9LUP0290
       TRA  *+2                      CONTINUE BELOW.                    9LUP0291
       AXT  INTG,4                   IF OUTPUT, PICKUP INTG, AND        9LUP0292
       REM  ENTRY FROM CCFFXD, CCEFLT, CCOCTL, CCALPH.                  9LUP0293
SETAD  SXA  CNVSW,4                  SET CNVSW.                         9LUP0294
       LXA  INT,4                    PICKUP INT, AND                    9LUP0295
       SXA  COUNT,4                  SET COUNT.                         9LUP0296
       TRA  SCAN                   * GO CONTINUE SCAN.                  9LUP0297
*                                                                       9LUP0298
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * 9LUP0299
*                                                                       9LUP0300
       REM  ENTRY FROM FORMAT SCAN ON H.                                9LUP0301
CCHOLL NOP  HOUT                     IF INPUT,                          9LUP0302
HNPT   LXA  INT,4                    REPLACE                            9LUP0303
       LDQ  MQD                      HOLLERITH                          9LUP0304
       SXA  CX2,2                    FIELD                              9LUP0305
       CAL  0,2                      IN                                 9LUP0306
       LXA  DX1,2                    FORMAT                             9LUP0307
       TNX  HNPT3,1,1                STATEMENT                          9LUP0308
       SXA  CX1,1                    WITH                               9LUP0309
       ARS  6                        THE                                9LUP0310
       TIX  *-1,1,1                  SPECIFIED                          9LUP0311
       LXA  CX1,1                    NUMBER                             9LUP0312
HNPT1  TIX  HNPT2,2,1                OF                                 9LUP0313
       LXA  DX2,2                    BCD                                9LUP0314
       TXI  *+1,2,-1                 CHARACTERS                         9LUP0315
       XEC  WHICH                                                       9LUP0316
       SXA  DX2,2                    THE                                9LUP0317
       AXT  6,2                      INPUT                              9LUP0318
HNPT2  LGL  6                        BUFFER.                            9LUP0319
       TNX  HNPT4,4,1                ..                                 9LUP0320
       TIX  HNPT1,1,1                ..                                 9LUP0321
HNPT3  LXA  CX2,1                    ..                                 9LUP0322
       SLW  0,1                      ..                                 9LUP0323
HSET1  TXI  *+1,1,1                  ..                                 9LUP0324
       SXA  CX2,1                    ..                                 9LUP0325
       AXT  6,1                      ..                                 9LUP0326
       TRA  HNPT1                    ..                                 9LUP0327
HNPT4  SXA  DX1,2                    ..                                 9LUP0328
       LXA  CX2,2                    ..                                 9LUP0329
       STQ  MQD                      ..                                 9LUP0330
       SXA  CX1,1                    ..                                 9LUP0331
       TXL  HNPT5,1,1                ..                                 9LUP0332
       LDQ  0,2                      ..                                 9LUP0333
       RQL  6                        ..                                 9LUP0334
       TXI  *+1,1,1                  ..                                 9LUP0335
       TXL  *-2,1,6                  ..                                 9LUP0336
       STQ  MQ                       ..                                 9LUP0337
       LXA  CX1,1                    ..                                 9LUP0338
       TNX  HNPT5,1,1                ..                                 9LUP0339
       LGL  6                        ..                                 9LUP0340
       TIX  *-1,1,1                  ..                                 9LUP0341
HNPT5  SLW  0,2                      ..                                 9LUP0342
       TRA  RESUME                 * GO RESUME FORMAT SCAN.             9LUP0343
       REM  ENTRY FROM CCBLNK.                                          9LUP0344
HOUT   CLA  PAK)                 IF OUTPUT,                             9LUP0345
       STA  HOUT3                    MOVE                               9LUP0346
       CAL  WORD                     THE                                9LUP0347
       LXA  INT,4                    SPECIFIED                          9LUP0348
       TNO  *+1                      NUMBER                             9LUP0349
HOUT1  TIX  HOUT2,1,1                OF                                 9LUP0350
       AXT  6,1                      FORMAT                             9LUP0351
BSET1  TXI  *+1,2,1                  CHARACTERS                         9LUP0352
       LDQ  0,2                      (OR BLANKS)                        9LUP0353
HOUT2  LGL  6                        INTO                               9LUP0354
       TNO  HOUT4                    THE                                9LUP0355
       SXA     HXR4,4                                                   9LUP0356
       LXA     HOUT3,4                                                  9LUP0357
WHAT1  TXH  HXR4,4,REC+19                                               9LUP0358
HOUT3  SLW  ..                       OUTPUT                             9LUP0359
       TXI     *+1,4,1           BUFFER                                 9LUP0360
       SXA     HOUT3,4                                                  9LUP0361
       SXA     PAK),4                                                   9LUP0362
       CAL  L(1)                     ..                                 9LUP0363
HXR4   AXT     ..,4                                                     9LUP0364
HOUT4  TIX  HOUT1,4,1                ..                                 9LUP0365
       SLW     WORD                                                     9LUP0366
       TRA     SCAN                                                     9LUP0367
