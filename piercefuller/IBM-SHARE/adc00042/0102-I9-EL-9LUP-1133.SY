*   ENDICOTT LABORATORY    LOAD, UNLOAD, PACK, UNPACK  MODIFIED 9IOH    9LUP0000
*      FOR USE WITH 709 FORTRAN LIBRARY                                 9LUP0001
*(IOH)      INPUT-OUTPUT HOLLERITH   USED BY (TSH),(STH),(CSH),(SCH),   9LUP0002
*                                    AND (SPH).                         9LUP0003
       ENTRY   LOAD                                                     9LUP0004
       ENTRY   UNLOAD                                                   9LUP0005
       ENTRY   PACK                                                     9LUP0006
       ENTRY   UNPACK                                                   9LUP0007
