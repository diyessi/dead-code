       REM  FORMAT TRANSFER TABLE =                                     9LUP0097
       PZE  STOP                     77                                 9LUP0098
       PZE  STOP                     76                                 9LUP0099
       PZE  STOP                     75                                 9LUP0100
       PZE  CCLPAR                   74                                 9LUP0101
       PZE  CCCMMA                   73                                 9LUP0102
       PZE  STOP                     72                                 9LUP0103
       PZE  STOP                     71                                 9LUP0104
       PZE  STOP                     70                                 9LUP0105
       PZE  CCBLNK                   67                                 9LUP0106
