F      TXH     *-8,2,0                                                  CPS10472
       AXT     2,4                                                      CPS10473
       PXD     0,4                                                      CPS10474
       PDX     0,1                                                      CPS10475
SO1    CLA*    ASOR1                                                    CPS10476
       CAS*    ASOR2                                                    CPS10477
       TRA     INT                                                      CPS10478
       TRA     INT                                                      CPS10479
       LXA     ZERO,2                                                   CPS10480
       LDQ*    ASOR2                                                    CPS10481
       STO*    ASOR2                                                    CPS10482
       STQ*    ASOR1                                                    CPS10483
       NZT     G                                                        CPS10484
       TTR     M1+1                                                     CPS10485
       XEC     B,2                                                      CPS10486
       XEC     C,2                                                      CPS10487
       XEC     D,2                                                      CPS10488
       XEC     E,2                                                      CPS10489
       TXI     *+1,2,-1                                                 CPS10490
M1     TXH     *-5,2,0                                                  CPS10491
       TIX     *+1,1,1                                                  CPS10492
       TXH     SO1,1,1                                                  CPS10493
INT    TXI     *+1,4,1                                                  CPS10494
       TXL     SO1-2,4,0                                                CPS10495
       LXD     FASORT-3,4                                               CPS10496
       LXD     FASORT-1,1                                               CPS10497
       LXA     FASORT-1,2                                               CPS10498
