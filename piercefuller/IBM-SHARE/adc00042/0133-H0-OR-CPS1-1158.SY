       END                                                              CPS10515
C     RENUMBER SUBROUTINE                                               CPS10516
      SUBROUTINE RENUMB(N,I2,J2)                                        CPS10517
      DIMENSION ID1(2000),JD1(2000),DATA1(2000),IDENT(12),ID2(2000),    CPS10518
     1JD2(2000),DATA2(2000),TES(2000),TLF(2000),W(2000),AA(25),I2(2000),CPS10519
     2J2(2000)                                                          CPS10520
      COMMON ID1,ID2,DATA1,DATA2,TES,N,W,JD1,JD2,TLF,IC,AA,             CPS10521
     1MIN,MAX,IDENT,JCT,ICT,ISR,ITC,INT,IDM                             CPS10522
      ISTART=2                                                          CPS10523
      IHOLD=I2(1)                                                       CPS10524
      I2(1)=1                                                           CPS10525
      DO 5 L=2,IDM                                                      CPS10526
      DO 1 K=ISTART,N                                                   CPS10527
      IF(I2(K)-IHOLD)4,3,4                                              CPS10528
    3 I2(K)=I2(K-1)                                                     CPS10529
      GO TO 1                                                           CPS10530
    4 IHOLD1=I2(K)                                                      CPS10531
      DO 2 J=1,N                                                        CPS10532
      IF(J2(J)-IHOLD)2,9,2                                              CPS10533
    9 J2(J)=I2(K-1)                                                     CPS10534
    2 CONTINUE                                                          CPS10535
      IHOLD=IHOLD1                                                      CPS10536
      ISTART=K                                                          CPS10537
      GO TO 6                                                           CPS10538
    1 CONTINUE                                                          CPS10539
      ISTART=N                                                          CPS10540
      GO TO 15                                                          CPS10541
    7 ISTART=ISTART-1                                                   CPS10542
   15 DO 10 I=1,N                                                       CPS10543
      IF(J2(I)-IHOLD)10,11,10                                           CPS10544
   11 J2(I)=I2(ISTART)                                                  CPS10545
   10 CONTINUE                                                          CPS10546
      N=N                                                               CPS10547
      IHOLD=J2(N)                                                       CPS10548
      J2(N)=I2(N)+1                                                     CPS10549
      DO 12 I=1,N                                                       CPS10550
      IF(J2(I)-IHOLD)12,13,12                                           CPS10551
   13 J2(I)=J2(N)                                                       CPS10552
   12 CONTINUE                                                          CPS10553
      MIN=1                                                             CPS10554
      MAX=J2(N)                                                         CPS10555
      GO TO 8                                                           CPS10556
    6 I2(ISTART)=L                                                      CPS10557
      ISTART=ISTART+1                                                   CPS10558
      IF(ISTART-N)5,5,7                                                 CPS10559
    5 CONTINUE                                                          CPS10560
    8 RETURN                                                            CPS10561
      END                                                               CPS10562
