C     CPS PROGRAM W A GRAY  AND  E M KIDD                               CPS10001
      DIMENSION ID1(2000),JD1(2000),DATA1(2000),IDENT(12),ID2(2000),    CPS10002
     1JD2(2000),DATA2(2000),TES(2000),TLF(2000),W(2000),AA(25),G(2000), CPS10003
     2A(4)                                                              CPS10004
      COMMON ID1,ID2,DATA1,DATA2,TES,N,W,JD1,JD2,TLF,IC,AA,             CPS10005
     1MIN,MAX,IDENT,JCT,ICT,ISR,ITC,INT,IDM,G,A,KCRC                    CPS10006
      READ INPUT TAPE 10,4,(A(I),I=1,4),KCRC                            CPS10007
    4 FORMAT(4A6,I2)                                                    CPS10008
      NE=0                                                              CPS10009
      JCT=1                                                             CPS10010
      ICT=0                                                             CPS10011
      IC=0                                                              CPS10012
      IDM=2000                                                          CPS10013
  299 CALL INPUT(NE)                                                    CPS10014
      IF(IC)300,301,300                                                 CPS10015
  301 CALL EDIT(NE)                                                     CPS10016
  300 IF(NE)302,302,299                                                 CPS10017
  302 CALL START                                                        CPS10018
      CALL FINISH                                                       CPS10019
      REWIND 3                                                          CPS10020
      WRITE OUTPUT TAPE 9,91                                            CPS10021
   91 FORMAT(1H1)                                                       CPS10022
      WRITE OUTPUT TAPE 9,99,IDENT,JCT                                  CPS10023
   99 FORMAT(1H 11A6,1A1,4X,9H OPTION =I3,//)                           CPS10024
      N=N                                                               CPS10025
      L2=JD1(N)                                                         CPS10026
      IF(TLF(L2))299,299,51                                             CPS10027
   51 WRITE OUTPUT TAPE 9,20                                            CPS10028
   20 FORMAT(115H    IDENT    CRITICAL    OLD    =     NEW    =    DURATCPS10029
     1ION       START  TIME          FINISH  TIME            FLOAT)     CPS10030
      WRITEOUTPUTTAPE9,21                                               CPS10031
   21 FORMAT(118H0              PATH       I     J      I     J         CPS10032
     1        EARLY      LATE      EARLY       LATE      TOTAL   FREE)  CPS10033
   60 DO 90 K=1,N                                                       CPS10034
      L1=ID1(K)                                                         CPS10035
      L2=JD1(K)                                                         CPS10036
      TEF=TES(L1)+DATA1(K)                                              CPS10037
      TLS=TLF(L2)-DATA1(K)                                              CPS10038
      TF=TLF(L2)-TEF                                                    CPS10039
      FF=TES(L2)-TEF                                                    CPS10040
   62 IF(TF)64,64,63                                                    CPS10041
   64 WRITE OUTPUT TAPE 9,66,W(K),DATA2(K),A(4),ID2(K),JD2(K),          CPS10042
     1ID1(K),JD1(K),DATA1(K),TES(L1),TLS,TEF,TLF(L2),TF,FF              CPS10043
      GO TO 88                                                          CPS10044
   63 WRITE OUTPUT TAPE 9,66,W(K),DATA2(K),A(3),ID2(K),JD2(K),          CPS10045
     1ID1(K),JD1(K),DATA1(K),TES(L1),TLS,TEF,TLF(L2),TF,FF              CPS10046
   66 FORMAT(1H0,3A6,2X,2I6,I7,I6,3X,F8.2,3X,F8.2,2X,F8.2,              CPS10047
     13X,F8.2,3X,F8.2,3X,2F8.2)                                         CPS10048
   88 IF(ITC)90,89,90                                                   CPS10049
   89 ID1(K)=K                                                          CPS10050
      WRITE TAPE 3,TEF,TES(L1),W(K),DATA2(K),FF,ID2(K),JD2(K),TF        CPS10051
   90 CONTINUE                                                          CPS10052
      REWIND 3                                                          CPS10053
      IF(ITC)299,70,299                                                 CPS10054
   70 CALL CRCAL                                                        CPS10055
      GO TO 299                                                         CPS10056
      END                                                               CPS10057
C     DATA AND OPTION INPUT SUBROUTINE                                  CPS10058
      SUBROUTINE INPUT(NE)                                              CPS10059
      DIMENSION ID1(2000),JD1(2000),DATA1(2000),IDENT(12),ID2(2000),    CPS10060
     1JD2(2000),DATA2(2000),TES(2000),TLF(2000),W(2000),AA(25),A(4),    CPS10061
     2G(2000)                                                           CPS10062
      COMMON ID1,ID2,DATA1,DATA2,TES,N,W,JD1,JD2,TLF,IC,AA,             CPS10063
     1MIN,MAX,IDENT,JCT,ICT,ISR,ITC,INT,IDM,G,A,KCRC                    CPS10064
    1 REWIND 1                                                          CPS10065
      IF(ICT-JCT)2,6,3                                                  CPS10066
    6 CALL EXIT                                                         CPS10067
    2 JCT=0                                                             CPS10068
      READ INPUT TAPE 10,104,(AA(I),I=1,KCRC)                           CPS10069
  104 FORMAT(24A3)                                                      CPS10070
      READ INPUT TAPE 10,100,ISR,ITC,INT,ICT,IDENT                      CPS10071
  100 FORMAT(3I1,I2,11A6,1A1)                                           CPS10072
      DO 32 K=1,IDM                                                     CPS10073
      READ INPUT TAPE 10,105,ID1(K),JD1(K),DATA1(K),W(K),               CPS10074
     1DATA2(K),ID2(K),JD2(K),TES(K),TLF(K)                              CPS10075
  105 FORMAT(2I5,F10.0,6A6)                                             CPS10076
      IF(ID1(K))32,33,32                                                CPS10077
   33 N=K-1                                                             CPS10078
      GO TO 30                                                          CPS10079
   32 CONTINUE                                                          CPS10080
      WRITE OUTPUT TAPE 9,103,IDENT                                     CPS10081
  103 FORMAT(1H111A6,1A1/25H NO OF JOBS EXCEEDS LIMIT)                  CPS10082
      CALL EXIT                                                         CPS10083
    3 JCT=JCT+1                                                         CPS10084
      IC=1                                                              CPS10085
   13 READ INPUT TAPE 10,106,IDENT                                      CPS10086
  106 FORMAT(11A6,1A1)                                                  CPS10087
    9 IF(ITC)22,40,22                                                   CPS10088
   22 READ TAPE 1,(DATA1(K),K=1,N)                                      CPS10089
   17 READ INPUT TAPE 10,101,IHOLD,JHOLD,DHOLD,PM,ZM,IM,JM,XM,YM        CPS10090
  101 FORMAT(2I5,F10.0,6A6)                                             CPS10091
      IF(IHOLD)5,30,5                                                   CPS10092
    5 DO 7 K=1,N                                                        CPS10093
      IF(ID2(K)-IHOLD)7,8,7                                             CPS10094
    8 DO 20 M=K,N                                                       CPS10095
      IF(JD2(M)-JHOLD)20,10,20                                          CPS10096
   10 IF(ID2(M)-ID2(K))11,12,11                                         CPS10097
   12 ID2(M)=IHOLD                                                      CPS10098
      JD2(M)=JHOLD                                                      CPS10099
      DATA1(M)=DHOLD                                                    CPS10100
      W(M)=PM                                                           CPS10101
      DATA2(M)=ZM                                                       CPS10102
      IF(ITC)17,60,17                                                   CPS10103
   60 ID1(M)=IM                                                         CPS10104
      JD1(M)=JM                                                         CPS10105
      TES(M)=XM                                                         CPS10106
      TLF(M)=YM                                                         CPS10107
      GO TO 17                                                          CPS10108
   20 CONTINUE                                                          CPS10109
    7 CONTINUE                                                          CPS10110
      GO TO 11                                                          CPS10111
   40 READ TAPE 1,(ID2(I),JD2(I),DATA1(I),W(I),DATA2(I),ID1(I),         CPS10112
     1JD1(I),TES(I),TLF(I),I=1,N)                                       CPS10113
      GO TO 17                                                          CPS10114
   11 WRITE OUTPUT TAPE 9,102,IHOLD,JHOLD,IDENT,JCT                     CPS10115
  102 FORMAT(16H1          NO I=I5,7H  OR J=I5,5H  IN 11A6,1A4,7H OPTIONCPS10116
     1I5)                                                               CPS10117
      NE=1                                                              CPS10118
      GO TO 17                                                          CPS10119
   30 IF(NE)36,36,1                                                     CPS10120
   36 IF(ITC)31,42,31                                                   CPS10121
   42 IF(IC)35,31,35                                                    CPS10122
   35 WRITE TAPE 2,(ID1(I),JD1(I),TES(I),TLF(I),I=1,N)                  CPS10123
      READ TAPE 1,(ID1(I),JD1(I),I=1,N)                                 CPS10124
   31 REWIND 1                                                          CPS10125
      REWIND 2                                                          CPS10126
      RETURN                                                            CPS10127
      END                                                               CPS10128
      SUBROUTINE EDIT(NE)                                               CPS10129
      DIMENSION ID1(2000),JD1(2000),DATA1(2000),IDENT(12),ID2(2000),    CPS10130
     1JD2(2000),DATA2(2000),TES(2000),TLF(2000),W(2000),AA(25)          CPS10131
      COMMON ID1,ID2,DATA1,DATA2,TES,N,W,JD1,JD2,TLF,IC,AA,             CPS10132
     1MIN,MAX,IDENT,JCT,ICT,ISR,ITC,INT,IDM                             CPS10133
      CALL FASORT(N,8,ID1,JD1,DATA1,W,DATA2,ID2,JD2,TES,TLF)            CPS10134
  300 I1=1                                                              CPS10135
      DO 4 K=2,N                                                        CPS10136
      IF(ID1(K)-ID1(K-1))3,4,3                                          CPS10137
    3 I2=K-1                                                            CPS10138
      IF(I1-I2)12,13,12                                                 CPS10139
   12 IX=I2-I1+1                                                        CPS10140
      CALL FASORT(IX,8,JD1(I1),ID1(I1),DATA1(I1),W(I1),DATA2(I1),ID2(I1)CPS10141
     1,JD2(I1),TES(I1),TLF(I1))                                         CPS10142
   13 I1=K                                                              CPS10143
    4 CONTINUE                                                          CPS10144
   50 IF(ITC)81,62,81                                                   CPS10145
   62 WRITE TAPE 1,(ID1(I),JD1(I),DATA1(I),W(I),DATA2(I),ID2(I),        CPS10146
     1JD2(I),TES(I),TLF(I),I=1,N)                                       CPS10147
      WRITE TAPE 2,(ID2(I),JD2(I),TES(I),TLF(I),I=1,N)                  CPS10148
      REWIND 2                                                          CPS10149
      GO TO 60                                                          CPS10150
   81 WRITE TAPE 1,(DATA1(I),I=1,N)                                     CPS10151
   60 DO 72 I=1,N                                                       CPS10152
      ID2(I)=ID1(I)                                                     CPS10153
   72 JD2(I)=JD1(I)                                                     CPS10154
   14 DO 5 K=1,N                                                        CPS10155
      IF(ID1(K)-JD1(K))6,7,7                                            CPS10156
    6 IF(K-1)8,5,8                                                      CPS10157
    8 IF(ID1(K-1)-ID1(K))5,5,9                                          CPS10158
    7 WRITE OUTPUT TAPE 9,100,K                                         CPS10159
  100 FORMAT(13H1         I =I4,24H GREATER THAN OR EQUAL J)            CPS10160
      NE=1                                                              CPS10161
      GO TO 5                                                           CPS10162
    9 WRITE OUTPUT TAPE 9,101,K                                         CPS10163
  101 FORMAT(30H1  I ARRAY OUT OF SORT.  K IS I4)                       CPS10164
      NE=1                                                              CPS10165
    5 CONTINUE                                                          CPS10166
      REWIND3                                                           CPS10167
      WRITETAPE3,(JD1(I),DATA1(I),I=1,N)                                CPS10168
      REWIND3                                                           CPS10169
      CALL FASORT(N,1,JD1,DATA1)                                        CPS10170
      NX=N-1                                                            CPS10171
      NN=1                                                              CPS10172
      DO 400 I=1,NX                                                     CPS10173
      IF(ID1(I)-ID1(I+1))401,400,400                                    CPS10174
  401 M1=ID1(I+1)                                                       CPS10175
      NO=0                                                              CPS10176
      DO 404 J=NN,N                                                     CPS10177
      IF(JD1(J)-M1)405,407,406                                          CPS10178
  406 NN=J                                                              CPS10179
      GO TO 408                                                         CPS10180
  405 WRITEOUTPUTTAPE9,411,JD1(J)                                       CPS10181
  411 FORMAT(//17H          NO I = I5,7H  VALUE)                        CPS10182
      NE=1                                                              CPS10183
      GO TO 404                                                         CPS10184
  407 NO=1                                                              CPS10185
  404 CONTINUE                                                          CPS10186
  408 IF(NO)400,409,400                                                 CPS10187
  409 WRITEOUTPUTTAPE 9, 410, M1                                        CPS10188
  410 FORMAT(//17H          NO J = I5,7H  VALUE)                        CPS10189
      NE=1                                                              CPS10190
  400 CONTINUE                                                          CPS10191
      IF(JD1(N)-JD1(NN))412,413,412                                     CPS10192
  412 DO 415 I=NN,N                                                     CPS10193
      IF(JD1(I)-JD1(N))416,415,416                                      CPS10194
  416 WRITEOUTPUTTAPE9,411,JD1(I)                                       CPS10195
      NE=1                                                              CPS10196
  415 CONTINUE                                                          CPS10197
  413 READTAPE3,(JD1(I),DATA1(I),I=1,N)                                 CPS10198
      REWIND3                                                           CPS10199
      IF(NE)75,15,75                                                    CPS10200
   15 CALL RENUMB(N,ID1,JD1)                                            CPS10201
      IF(ITC)75,76,75                                                   CPS10202
   76 WRITE TAPE 1,(ID1(I),JD1(I),I=1,N)                                CPS10203
   75 REWIND 1                                                          CPS10204
   11 RETURN                                                            CPS10205
      END                                                               CPS10206
C     CRAFT CALCULATION AND VARIABLE TIME INTERVAL DETERMINATION        CPS10207
      SUBROUTINE CRCAL                                                  CPS10208
      DIMENSION ID1(2000),ID2(2000),DATA1(2000),TES(2000),W(2000),      CPS10209
     1JD1(2000),JD2(2000),TLF(2000),DATA2(2000),AA(25),IDENT(12),G(2000)CPS10210
     2,A(4)                                                             CPS10211
      COMMON ID1,ID2,DATA1,DATA2,TES,N,W,JD1,JD2,TLF,IC,AA,             CPS10212
     1MIN,MAX,IDENT,JCT,ICT,ISR,ITC,INT,IDM,G,A                         CPS10213
      WRITE OUTPUT TAPE 9,801                                           CPS10214
  801 FORMAT(1H1)                                                       CPS10215
      ISS=IDM-1                                                         CPS10216
      DO 29 I=1,N                                                       CPS10217
   29 READ TAPE 3,W(I),TES(I),JD1(I),DATA2(I),DATA1(I),ID2(I),          CPS10218
     1JD2(I),TLF(I)                                                     CPS10219
      REWIND 3                                                          CPS10220
      READ TAPE 2,(ID2(I),JD2(I),JD1(I),DATA2(I),I=1,N)                 CPS10221
      REWIND 2                                                          CPS10222
C     SORT ON EARLY FINISH AND CARRY THE 4 RESOURCES,ES AND TF          CPS10223
      CALL FASORT(N,6,W,TES,ID2,JD2,JD1,DATA2,TLF)                      CPS10224
C     SORT ON EARLY START AND CARRY THE 4 RESOURCES,TF AND CHECK        CPS10225
      CALL FASORT(N,6,TES,ID2,JD2,JD1,DATA2,TLF,ID1)                    CPS10226
      WRITE TAPE 2,(ID2(K),JD2(K),JD1(K),DATA2(K),TLF(K),K=1,N)         CPS10227
      REWIND 2                                                          CPS10228
      DO 39 I=1,N                                                       CPS10229
   39 READ TAPE 3,W(I),TES(I),DATA1(I),JD1(I),DATA2(I),ID2(I),JD2(I),   CPS10230
     1G(I)                                                              CPS10231
      REWIND 3                                                          CPS10232
C     SORT ON EARLY FINISH AND CARRY THE 2 IDENT WORDS,I,J,FF,AND TF    CPS10233
      CALL FASORT(N,7,W,TES,DATA1,DATA2,ID2,JD2,JD1,G)                  CPS10234
C     SORT ON EARLY START AND CARRY THE 2 IDENT WORDS,I,J,FF,AND TF     CPS10235
      CALL FASORT(N,6,TES,DATA1,DATA2,ID2,JD2,JD1,G)                    CPS10236
C     ASCERTAIN GRID INTERVALS AND STORE IN TLF ARRAY                   CPS10237
      N3=1                                                              CPS10238
      H3=W(N)                                                           CPS10239
      TLF(1)=0.0                                                        CPS10240
      N2=1                                                              CPS10241
   38 DO 20 I=1,ISS                                                     CPS10242
      DO 21 K=N2,N                                                      CPS10243
      IF(TES(K)-TLF(I))23,21,22                                         CPS10244
   22 N2=K                                                              CPS10245
      H1=TES(K)                                                         CPS10246
      GO TO 23                                                          CPS10247
   21 CONTINUE                                                          CPS10248
   23 DO 24 L=N3,N                                                      CPS10249
      IF(W(L)-TLF(I))31,24,25                                           CPS10250
   25 N3=L                                                              CPS10251
      H2=W(L)                                                           CPS10252
      GO TO 26                                                          CPS10253
   24 CONTINUE                                                          CPS10254
   26 IF(H1-H2)28,27,27                                                 CPS10255
   27 TLF(I+1)=H2                                                       CPS10256
      IF(H3-H2)31,31,20                                                 CPS10257
   31 N1=I                                                              CPS10258
      GO TO 37                                                          CPS10259
   28 IF(H1-TLF(I))27,27,30                                             CPS10260
   30 TLF(I+1)=H1                                                       CPS10261
   20 CONTINUE                                                          CPS10262
      WRITE OUTPUT TAPE 9,32                                            CPS10263
   32 FORMAT(1H0,34H NO OF TIME INTERVALS EXCEEDS 2000//)               CPS10264
      N1=ISS                                                            CPS10265
   37 REWIND 3                                                          CPS10266
      REWIND 4                                                          CPS10267
      N2=0                                                              CPS10268
   70 K1=1                                                              CPS10269
   74 KH=1                                                              CPS10270
      JH=1                                                              CPS10271
  755 DO 90 L=1,N1                                                      CPS10272
      IF(N2)1,2,1                                                       CPS10273
    1 JD1(L)=0                                                          CPS10274
    2 DO 800 K=KH,N                                                     CPS10275
      IF(W(K)-TLF(L))800,800,81                                         CPS10276
   81 KH=K                                                              CPS10277
      GO TO 83                                                          CPS10278
  800 CONTINUE                                                          CPS10279
   83 LL=L+1                                                            CPS10280
      NC=0                                                              CPS10281
      DO 84 J=JH,N                                                      CPS10282
      IF(TES(J)-TLF(LL))85,90,90                                        CPS10283
   85 N3=ID1(J)                                                         CPS10284
      IF(N3-KH)84,87,87                                                 CPS10285
   87 NC=NC+1                                                           CPS10286
      IF(NC-1)89,89,91                                                  CPS10287
   89 JH=J                                                              CPS10288
   91 IF(N2)108,99,108                                                  CPS10289
   99 IF(W(N3)-TLF(LL))169,160,169                                      CPS10290
  160 TT=A(1)                                                           CPS10291
      GO TO 163                                                         CPS10292
  169 IF(TES(J)-TLF(L))162,161,162                                      CPS10293
  161 TT=A(2)                                                           CPS10294
      GO TO 163                                                         CPS10295
  162 TT=A(3)                                                           CPS10296
  163 IF(G(J))164,164,165                                               CPS10297
  164 T1=A(4)                                                           CPS10298
      GO TO 166                                                         CPS10299
  165 T1=A(3)                                                           CPS10300
C     PLACE I,J, 2 IDENT WORDS,START OR END AND CRITICAL STAR ON TAPE 3 CPS10301
  166 WRITE TAPE 3,DATA1(J),JD1(J),ID2(J),JD2(J),TLF(L),TLF(LL),        CPS10302
     1DATA2(J),TT,T1                                                    CPS10303
      GO TO 84                                                          CPS10304
C     PLACE WORDS 1, 2, 3,4 AND TOTAL FLOAT ON TAPE 4                   CPS10305
  108 WRITE OUTPUT TAPE 4,3,ID2(J),JD2(J),DATA1(J),DATA2(J),G(J)        CPS10306
      JD1(L)=JD1(L)+1                                                   CPS10307
    3 FORMAT(1H ,4A6,F10.3)                                             CPS10308
   84 CONTINUE                                                          CPS10309
   90 CONTINUE                                                          CPS10310
      GO TO(101,102),K1                                                 CPS10311
  101 REWIND 4                                                          CPS10312
      REWIND 3                                                          CPS10313
      N2=1                                                              CPS10314
      READ TAPE 2,(ID2(I),JD2(I),DATA1(I),DATA2(I),G(I),I=1,N)          CPS10315
      REWIND 2                                                          CPS10316
      K1=2                                                              CPS10317
      GO TO 74                                                          CPS10318
  102 REWIND 4                                                          CPS10319
      K1=IDM/2                                                          CPS10320
  140 DO 150 I=1,N1                                                     CPS10321
  151 NN=JD1(I)                                                         CPS10322
  153 DO 154 K=1,NN                                                     CPS10323
      KK=K+K1                                                           CPS10324
      READ INPUT TAPE 4,156,W(KK),W(K),TES(KK),TES(K),DATA1(KK),        CPS10325
     1DATA1(K),DATA2(KK),DATA2(K),TLF(K)                                CPS10326
  154 READ TAPE 3,ID1(K),ID1(KK),ID2(K),ID2(KK),G(K),G(KK),TLF(KK),     CPS10327
     2JD2(K),JD2(KK)                                                    CPS10328
  156 FORMAT(1X,4(F3.0,1A3),F10.3)                                      CPS10329
      CALL CRAFT(NN,K1)                                                 CPS10330
  150 CONTINUE                                                          CPS10331
      REWIND 4                                                          CPS10332
      REWIND 3                                                          CPS10333
      RETURN                                                            CPS10334
      END                                                               CPS10335
C     CALCULATE CRAFT SUMS AND CRAFT OUTPUT                             CPS10336
      SUBROUTINE CRAFT(NN,K1)                                           CPS10337
      DIMENSION XX(25),X1(25),AA(25),ID1(2000),JD1(2000),DATA1(2000),   CPS10338
     1ID2(2000),JD2(2000),DATA2(2000),TES(2000),TLF(2000),W(2000),      CPS10339
     2IDENT(12),G(2000),A(4)                                            CPS10340
      COMMON ID1,ID2,DATA1,DATA2,TES,N,W,JD1,JD2,TLF,IC,AA,             CPS10341
     1MIN,MAX,IDENT,JCT,ICT,ISR,ITC,INT,IDM,G,A,KCRC,XX,X1              CPS10342
      WRITE OUTPUT TAPE 9,3                                             CPS10343
    3 FORMAT(/1H0,119H   IDENT     CRITICAL     I     J      NO TYPE    CPS10344
     1  NO TYPE      NO TYPE      NO TYPE   TOTAL FLOAT  FREE FLOAT  CHACPS10345
     2NGE//)                                                            CPS10346
      DO 30 I=1,NN                                                      CPS10347
      II=I+K1                                                           CPS10348
   30 WRITE OUTPUT TAPE 9,6,ID1(I),ID1(II),JD2(II),ID2(I),ID2(II),      CPS10349
     1W(II),W(I),TES(II),TES(I),DATA1(II),DATA1(I),DATA2(II),DATA2(I),  CPS10350
     2TLF(I),TLF(II),JD2(I)                                             CPS10351
    6 FORMAT(1H ,3A6,3X,2I6,4(4X,F4.0,2X,1A3),2(4X,F8.2),4X,1A6)        CPS10352
      DO 60 I=1,KCRC                                                    CPS10353
      XX(I)=0.0                                                         CPS10354
   60 X1(I)=AA(I)                                                       CPS10355
      DO 8 K=1,NN                                                       CPS10356
      KK=K+K1                                                           CPS10357
      NX=0                                                              CPS10358
      DO 19 M=1,KCRC                                                    CPS10359
      IF(NX-4)90,8,8                                                    CPS10360
   90 IF(AA(M)-W(K))40,50,40                                            CPS10361
   40 IF(AA(M)-TES(K))41,51,41                                          CPS10362
   41 IF(AA(M)-DATA1(K))42,52,42                                        CPS10363
   42 IF(AA(M)-DATA2(K))19,53,19                                        CPS10364
   53 XX(M)=XX(M)+DATA2(KK)                                             CPS10365
      GO TO 9                                                           CPS10366
   50 XX(M)=XX(M)+W(KK)                                                 CPS10367
      GO TO 9                                                           CPS10368
   51 XX(M)=XX(M)+TES(KK)                                               CPS10369
      GO TO 9                                                           CPS10370
   52 XX(M)=XX(M)+DATA1(KK)                                             CPS10371
    9 NX=NX+1                                                           CPS10372
   19 CONTINUE                                                          CPS10373
    8 CONTINUE                                                          CPS10374
      WRITE OUTPUT TAPE 9,20,G(K),G(KK)                                 CPS10375
   20 FORMAT(40H0               TOTALS FOR TIME INTERVALF7.2,8H THROUGHFCPS10376
     18.2)                                                              CPS10377
      M8=1                                                              CPS10378
   18 DO 14 M=1,KCRC                                                    CPS10379
      IF(XX(M))15,14,15                                                 CPS10380
   15 XX(M8)=XX(M)                                                      CPS10381
      X1(M8)=X1(M)                                                      CPS10382
      M8=M8+1                                                           CPS10383
   14 CONTINUE                                                          CPS10384
      M8=M8-1                                                           CPS10385
      IF(M8)11,11,10                                                    CPS10386
   10 WRITE OUTPUT TAPE 9,22,(XX(I),X1(I),I=1,M8)                       CPS10387
   22 FORMAT(20H                    F4.0,4H OF 1A3,9X,F4.0,4H OF 1A3,9X,CPS10388
     1F4.0,4H OF 1A3,9X,F4.0,4H OF 1A3)                                 CPS10389
   11 RETURN                                                            CPS10390
      END                                                               CPS10391
C     START SUBROUTINE FOR CPS                                          CPS10392
      SUBROUTINE START                                                  CPS10393
      DIMENSION ID1(2000),JD1(2000),DATA1(2000),IDENT(12),ID2(2000),    CPS10394
     1JD2(2000),DATA2(2000),TES(2000),TLF(2000),W(2000),AA(25)          CPS10395
      COMMON ID1,ID2,DATA1,DATA2,TES,N,W,JD1,JD2,TLF,IC,AA,             CPS10396
     1MIN,MAX,IDENT,JCT,ICT,ISR,ITC,INT,IDM                             CPS10397
      TES(1)=0.0                                                        CPS10398
      TES(2)=DATA1(1)                                                   CPS10399
      DO6I=3,MAX                                                        CPS10400
      M2=0                                                              CPS10401
      I1=I                                                              CPS10402
      DO7L=1,N                                                          CPS10403
      IF(ID1(L)-I1)13,12,12                                             CPS10404
   13 IF(JD1(L)-I1)7,8,7                                                CPS10405
    8 M3=ID1(L)                                                         CPS10406
      IF(M2)10,11,10                                                    CPS10407
   10 W1=DATA1(L)+TES(M3)                                               CPS10408
      IF(W1-W2)7,7,11                                                   CPS10409
   11 W2=DATA1(L)+TES(M3)                                               CPS10410
      M2=1                                                              CPS10411
    7 CONTINUE                                                          CPS10412
   12 TES(I)=W2                                                         CPS10413
    6 CONTINUE                                                          CPS10414
      RETURN                                                            CPS10415
      END                                                               CPS10416
C     FINISH SUBROUTINE FOR CPS                                         CPS10417
      SUBROUTINE FINISH                                                 CPS10418
      DIMENSION ID1(2000),JD1(2000),DATA1(2000),IDENT(12),ID2(2000),    CPS10419
     1JD2(2000),DATA2(2000),TES(2000),TLF(2000),W(2000),AA(25)          CPS10420
      COMMON ID1,ID2,DATA1,DATA2,TES,N,W,JD1,JD2,TLF,IC,AA,             CPS10421
     1MIN,MAX,IDENT,JCT,ICT,ISR,ITC,INT,IDM                             CPS10422
      TLF(MAX)=TES(MAX)                                                 CPS10423
      N2=MAX-1                                                          CPS10424
      TLF(N2)=TLF(MAX)-DATA1(N)                                         CPS10425
      DO25J=2,N2                                                        CPS10426
      N1=MAX-J                                                          CPS10427
      M2=0                                                              CPS10428
      DO20K=1,N                                                         CPS10429
   27 IF(ID1(K)-N1)20,22,26                                             CPS10430
   22 M3=JD1(K)                                                         CPS10431
      IF(M2)23,21,23                                                    CPS10432
   23 W1=TLF(M3)-DATA1(K)                                               CPS10433
      IF(W1-W2)21,20,20                                                 CPS10434
   21 W2=TLF(M3)-DATA1(K)                                               CPS10435
      M2=1                                                              CPS10436
   20 CONTINUE                                                          CPS10437
   26 TLF(N1)=W2                                                        CPS10438
   25 CONTINUE                                                          CPS10439
      RETURN                                                            CPS10440
      END                                                               CPS10441
       COUNT   40                                                       CPS10442
       ENTRY   FASORT                                                   CPS10443
