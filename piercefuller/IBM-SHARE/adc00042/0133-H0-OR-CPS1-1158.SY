FASORT SXD     *-3,4                                                    CPS10445
       SXD     FASORT-1,1                                               CPS10446
       SXA     FASORT-1,2                                               CPS10447
       CLA*    1,4                                                      CPS10448
       STD     INT+1                                                    CPS10449
       CLA*    2,4                                                      CPS10450
       PDC     0,2                                                      CPS10451
       SXD     F,2                                                      CPS10452
       SXD     M1,2                                                     CPS10453
       SXD     M2,2                                                     CPS10454
       SXD     G,2                                                      CPS10455
       CLA     3,4                                                      CPS10456
       ADD     =O100001                                                 CPS10457
       STO     ASOR1                                                    CPS10458
       ADD     =1                                                       CPS10459
