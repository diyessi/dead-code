C     TAYLOR SERIES METHOD FOR RATIONAL FITS                            RATF0001
      DIMENSION A(101,21),A1(101,21),A2(101),B(101),B1(101,21),         RATF0002
     1B2(101),X(21),R(101),C(10),E(10),TEMP(10),U(101),                 RATF0003
     2S(101),D1(101),D2(101)                                            RATF0004
      DIMENSION KR(21)                                                  RATF0005
      COMMON TEMP                                                       RATF0006
 1    READ INPUT TAPE 2,2,AA,BB,K,N,M,KB,KTAG                           RATF0007
      READ INPUT TAPE 2,3,(C(J),J=1,10),(E(J),J=1,10),                  RATF0008
     1(TEMP(J),J=1,10),(X(J),J=1,N)                                     RATF0009
      READ INPUT TAPE 2,4,(KR(J),J=1,N)                                 RATF0010
 2    FORMAT(2E20.8,5I5)                                                RATF0011
 3    FORMAT(5E14.8)                                                    RATF0012
 4    FORMAT(12I5)                                                      RATF0013
      WRITE OUTPUT TAPE 3,5,AA,BB,K,N,M,KB,KTAG                         RATF0014
      WRITE OUTPUT TAPE 3,6,(C(J),J=1,10),(E(J),J=1,10),(TEMP(J),J=1,10)RATF0015
      WRITE OUTPUT TAPE 3,7,(KR(J),J=1,N)                               RATF0016
 5    FORMAT(5H1 AA=E15.8,5H  BB=E15.8,4H  K=I4,4H  N=I4,4H  M=I7,5H  KBRATF0017
     1=I4,7H  KTAG=I2)                                                  RATF0018
 6    FORMAT(5E20.8)                                                    RATF0019
 7    FORMAT(5H  KR=21I5)                                               RATF0020
      K1=K+1                                                            RATF0021
      M1=2*M                                                            RATF0022
      GO TO(10,12),KTAG                                                 RATF0023
 10   READ INPUT TAPE 2,11,(U(J),S(J),J=1,M)                            RATF0024
 11   FORMAT(2E15.8)                                                    RATF0025
      GO TO 13                                                          RATF0026
 12   CALL POINTS(AA,BB,M,U,S)                                          RATF0027
 13   F=0.                                                              RATF0028
      WRITE OUTPUT TAPE 3,11,(U(J),S(J),J=1,M)                          RATF0029
      DO 19 I=1,M                                                       RATF0030
      D1(I)=0.                                                          RATF0031
      D2(I)=0.                                                          RATF0032
      I1=M+I                                                            RATF0033
      DO 14 J=1,K                                                       RATF0034
      A1(I,J)=-U(I)**KR(J)                                              RATF0035
      D1(I)=D1(I)+X(J)*A1(I,J)                                          RATF0036
      A1(I1,J)=-A1(I,J)                                                 RATF0037
      B1(I,J)=0.                                                        RATF0038
 14   B1(I1,J)=0.                                                       RATF0039
      DO 15 J=K1,N                                                      RATF0040
      B1(I,J)=U(I)**KR(J)                                               RATF0041
      B1(I1,J)=B1(I,J)                                                  RATF0042
      D2(I)=D2(I)+X(J)*B1(I,J)                                          RATF0043
      A1(I,J)=S(I)*B1(I,J)                                              RATF0044
      D1(I)=D1(I)+X(J)*A1(I,J)                                          RATF0045
 15   A1(I1,J)=-A1(I,J)                                                 RATF0046
      B2(I)=H(E,U(I))                                                   RATF0047
      B2(I1)=B2(I)                                                      RATF0048
      A2(I)=S(I)*B2(I)-G(C,U(I))                                        RATF0049
      A2(I1)=-A2(I)                                                     RATF0050
      D2(I)=D2(I)+B2(I)                                                 RATF0051
      D2(I1) = D2(I)                                                    RATF0052
      D1(I)=D1(I)+A2(I)                                                 RATF0053
      R(I)=D1(I)/D2(I)                                                  RATF0054
      IF(D2(I))16,16,17                                                 RATF0055
 16   CALL DUMP(D2,D2(301),1)                                           RATF0056
 17   IF(ABSF(R(I))-F)19,19,18                                          RATF0057
 18   F=ABSF(R(I))                                                      RATF0058
 19   CONTINUE                                                          RATF0059
      DO 26 KTQ=1,KB                                                    RATF0060
 20   DO 22 I=1,M1                                                      RATF0061
      DO 21 J=1,N                                                       RATF0062
 21   A(I,J)=(A1(I,J)-F*B1(I,J))/D2(I)                                  RATF0063
 22   B(I)=(F*B2(I)-A2(I))/D2(I)                                        RATF0064
      CALL INQLTY(M1,N,A,B,X,R)                                         RATF0065
      WRITE OUTPUT TAPE 3,23,(X(J),J=1,N)                               RATF0066
 23   FORMAT(5H0  X=5E20.8)                                             RATF0067
      F1=0.                                                             RATF0068
      DO 25 I=1,M                                                       RATF0069
      I1=I+M                                                            RATF0070
      D1(I)=(R(I)-R(I1))*D2(I)/2.                                       RATF0071
      D2(I)=-(R(I)+R(I1))*D2(I)/(2.*F)                                  RATF0072
      R(I)=D1(I)/D2(I)                                                  RATF0073
      IF(ABSF(R(I))-F1)25,25,24                                         RATF0074
 24   F1=ABSF(R(I))                                                     RATF0075
 25   CONTINUE                                                          RATF0076
      F=F1                                                              RATF0077
 26   WRITE OUTPUT TAPE 3,27,F,(R(I),I=1,M)                             RATF0078
 27   FORMAT(5H0  F=E17.8/(5E17.8))                                     RATF0079
      GO TO 1                                                           RATF0080
      END                                                               RATF0081
C     INEQUALITYCODEDESCENTMETHOD                                       RATF0082
      SUBROUTINEINQLTY(M,N,A,B,X,R)                                     RATF0083
      DIMENSIONIV(21)                                                   RATF0084
      DIMENSIONA(101,21),A1(21,42),A2(21,42),B(101),T(101),R(101),      RATF0085
     1S(42),Y(21),D(21),A3(21,42),X(21)                                 RATF0086
      BG2=1.E28                                                         RATF0087
      NP1=N+1                                                           RATF0088
      E=1.0E-3                                                          RATF0089
      DO42KTQ=1,M                                                       RATF0090
 1    BG1=-1.E27                                                        RATF0091
      DO4I=1,M                                                          RATF0092
      R(I)=-B(I)                                                        RATF0093
      DO2J=1,N                                                          RATF0094
 2    R(I)=R(I)+X(J)*A(I,J)                                             RATF0095
      IF(R(I)-BG1)4,4,3                                                 RATF0096
 3    BG1=R(I)                                                          RATF0097
 4    CONTINUE                                                          RATF0098
      WRITEOUTPUTTAPE3,5,KTQ,BG1                                        RATF0099
 5    FORMAT (22H1 NUMBER OF THE CYCLE=I6/19H  MAXIMUM RESIDUAL=F30.15) RATF0100
      WRITE OUTPUT TAPE 3,6,(X(J),J=1,N)                                RATF0101
 6    FORMAT (10H0 X-VECTOR/(1P6E17.8))                                 RATF0102
      WRITE OUTPUT TAPE 3,7,(R(I),I=1,M)                                RATF0103
 7    FORMAT (11H0 RESIDUALS/(1P6E17.8))                                RATF0104
      IF(BG1-BG2)9,9,8                                                  RATF0105
 8    RETURN                                                            RATF0106
 9    BG2=BG1                                                           RATF0107
      N1=0                                                              RATF0108
      DO12I=1,M                                                         RATF0109
      IF (BG1-R(I)-ABSF(BG1)*E) 10,10,12                                RATF0110
 10   N1=N1+1                                                           RATF0111
      IV(N1)=I                                                          RATF0112
      DO11J=1,N                                                         RATF0113
 11   A1(N1,J)=A(I,J)                                                   RATF0114
 12   CONTINUE                                                          RATF0115
 13   IF(N1-NP1)14,18,17                                                RATF0116
 14   DO15I=1,N1                                                        RATF0117
      A2(I,N1+1)=-1.                                                    RATF0118
      DO15J=1,N1                                                        RATF0119
      A2(I,J)=0                                                         RATF0120
      DO15K=1,N                                                         RATF0121
   15 A2(I,J)=A2(I,J)+A1(I,K)*A1(J,K)                                   RATF0122
      CALLMATS(A2,D,N1,MMNN)                                            RATF0123
      DO16J=1,N                                                         RATF0124
      Y(J)=0                                                            RATF0125
      DO16I=1,N1                                                        RATF0126
 16   Y(J)=Y(J)+D(I)*A1(I,J)                                            RATF0127
      GOTO30                                                            RATF0128
 17   E=E/10.                                                           RATF0129
 18   DO22I=1,N                                                         RATF0130
      A2(I,NP1)=0                                                       RATF0131
      DO20J=1,N                                                         RATF0132
      A2(I,J)=0                                                         RATF0133
      DO19K=1,NP1                                                       RATF0134
 19   A2(I,J)=A2(I,J)+A1(K,I)*A1(K,J)                                   RATF0135
 20   A3(I,J)=A2(I,J)                                                   RATF0136
      DO21K=1,NP1                                                       RATF0137
 21   A2(I,NP1)=A2(I,NP1)-A1(K,I)                                       RATF0138
 22   A3(I,NP1)=A2(I,NP1)                                               RATF0139
      CALLMATS(A2,Y,N,MMNN)                                             RATF0140
      SUM=0                                                             RATF0141
      DO24I=1,NP1                                                       RATF0142
      D(I)=1.                                                           RATF0143
      DO23J=1,N                                                         RATF0144
 23   D(I)=D(I)+A1(I,J)*Y(J)                                            RATF0145
 24   SUM=SUM+D(I)                                                      RATF0146
      BG=0                                                              RATF0147
      GRM=1.                                                            RATF0148
      IF(SUM)26,30,25                                                   RATF0149
 25   GRM=-1.                                                           RATF0150
 26   DO28J=1,N                                                         RATF0151
      IF(GRM*D(J)-BG)28,28,27                                           RATF0152
 27   JMAX=J                                                            RATF0153
      BG=GRM*D(J)                                                       RATF0154
 28   CONTINUE                                                          RATF0155
      IF(BG)8,8,29                                                      RATF0156
 29   A3(JMAX,N+1)=GRM*(SUM-D(JMAX))/BG                                 RATF0157
      CALLMATS(A3,Y,N,MMNN)                                             RATF0158
 30   RATE=-1.                                                          RATF0159
      DO31I=1,M                                                         RATF0160
      T(I)=0                                                            RATF0161
      DO31J=1,N                                                         RATF0162
 31   T(I)=T(I)+A(I,J)*Y(J)                                             RATF0163
 32   TMIN=1.E27                                                        RATF0164
      DO37I=1,M                                                         RATF0165
      DO33K=1,N1                                                        RATF0166
      IF(I-IV(K)) 33,37,33                                              RATF0167
   33 CONTINUE                                                          RATF0168
 34   T2=(BG1-R(I))/(T(I)-RATE)                                         RATF0169
      IF(T2)37,37,35                                                    RATF0170
 35   IF(T2-TMIN)36,36,37                                               RATF0171
 36   TMIN=T2                                                           RATF0172
      IMET=I                                                            RATF0173
      T3=T(I)                                                           RATF0174
 37   CONTINUE                                                          RATF0175
      IF(TMIN-1.E26)39,8,8                                              RATF0176
   39 DO 38 J=1,N                                                       RATF0177
 38   X(J)=X(J)+TMIN*Y(J)                                               RATF0178
      WRITE OUTPUT TAPE 3,6,(X(J),J=1,N)                                RATF0179
      IF (T3) 40,42,42                                                  RATF0180
 40   N1=N1+1                                                           RATF0181
      IV(N1)=IMET                                                       RATF0182
      DO41I=1,M                                                         RATF0183
 41   R(I)=R(I)+T(I)*TMIN                                               RATF0184
      WRITE OUTPUT TAPE 3,7,(R(I),I=1,M)                                RATF0185
      BG1=BG1+TMIN*RATE                                                 RATF0186
      RATE=T3                                                           RATF0187
      GOTO32                                                            RATF0188
 42   CONTINUE                                                          RATF0189
      SUBROUTINE MATS (A,X,N,M)                                         RATF0190
      DIMENSION A(21,42),X(21)                                          RATF0191
      IF(N-1) 1,30,1                                                    RATF0192
   30 X(1) = A(1,2)/A(1,1)                                              RATF0193
      GO TO 21                                                          RATF0194
    1 MMM=N-1                                                           RATF0195
    3 M=N+1                                                             RATF0196
    4 DO 12 I=1,MMM                                                     RATF0197
    5 JJJ = M-I+1                                                       RATF0198
    6 DO 8 J=1,JJJ                                                      RATF0199
    7 JJ=M+1-J                                                          RATF0200
    8 A(I,JJ)=A(I,JJ)/A(I,I)                                            RATF0201
    9 MM=I+1                                                            RATF0202
   10 DO 12 K=MM,N                                                      RATF0203
   11 DO 12 KK=MM,M                                                     RATF0204
   12 A(K,KK)=A(K,KK)-A(K,I)*A(I,KK)                                    RATF0205
   13 X(N) = A(N,N+1)/A(N,N)                                            RATF0206
   14 DO 20 I=1,MMM                                                     RATF0207
   15 B = 0.0                                                           RATF0208
   16 II= N-I                                                           RATF0209
   17 JJ=II+1                                                           RATF0210
   18 DO 19 J=JJ,N                                                      RATF0211
   19 B=B+A(II,J)*X(J)                                                  RATF0212
   20 X(II) = A(II,M)-B                                                 RATF0213
   21 RETURN                                                            RATF0214
      SUBROUTINE H(E,T)                                                 RATF0215
      DIMENSION E(10)                                                   RATF0216
      H = E(10)                                                         RATF0217
      DO 1 I=1,9                                                        RATF0218
      I1 = 10-I                                                         RATF0219
 1    H = H*T+E(I1)                                                     RATF0220
      RETURN                                                            RATF0221
      SUBROUTINE G(C,T)                                                 RATF0222
      DIMENSION C(10)                                                   RATF0223
      G = C(10)                                                         RATF0224
      DO 1 I=1,9                                                        RATF0225
      I1 = 10-I                                                         RATF0226
 1    G = G*T+C(I1)                                                     RATF0227
      RETURN                                                            RATF0228
C     SUBROUTINE POINTS FOR TANGENT FUNCTION                            RATF0229
      SUBROUTINE POINTS (A,B,M,U,S)                                     RATF0230
      DIMENSION U(101),S(101)                                           RATF0231
      Y = M-1                                                           RATF0232
      DO 2 J=1,M                                                        RATF0233
      X = J-1                                                           RATF0234
      U(J) = A+(B-A)*X/Y                                                RATF0235
 2    S(J) = TANF(U(J))                                                 RATF0236
      RETURN                                                            RATF0237
