*     FORTRAN                                                           GAMA 001
      SUBROUTINE GAMA (A,X,GAM,B,ER )                                   GAMA 002
C                                                                       GAMA 003
C     THE PURPOSE OF THIS SUBROUTINE IS TO CALL  GAMMA(X,A,GAM,B,NVB)   GAMA 004
C     WHICH IS THE REAL BUSINESS END OF THE NORMALIZED INCOMPLETE GAMMA GAMA 005
C     FUNCTION EVALUATING ROUTINE.                                      GAMA 006
C                                                                       GAMA 007
C     THIS SUBROUTINE MAY BE ALTERED - WITHOUT CHANGING GAMMA(    )     GAMA 008
C     E.G.  BY DIVIDING THE PARAMETERS BY TWO SO AS TO GET CHI-SQUARES  GAMA 009
C                                                                       GAMA 010
C     GAM=1 IF X IS NOT ZERO AND A=0 OR A NEGATIVE INTEGER              GAMA 011
C     GAM=0 WHENEVER X=0 IRRESPECTIVE OF A                              GAMA 012
C                                                                       GAMA 013
      DIMENSION NVB(5)                                                  GAMA 014
      ER=0.                                                             GAMA 015
      IF(X) 35,43,27                                                    GAMA 016
 27   IF(A) 28,28,43                                                    GAMA 017
 28   IF(A-INTF(A) ) 35,37,37                                           GAMA 018
 35   ER=2.                                                             GAMA 019
  37  GAM=0.                                                            GAMA 020
      B=0.                                                              GAMA 021
      RETURN                                                            GAMA 022
  43  CALL GAMMA(A,X,GAM,B,NVB )                                        GAMA 023
C                                                                       GAMA 024
      IF(NVB(2)-4) 45,48,48                                             GAMA 025
  45  RETURN                                                            GAMA 026
  48  ER=NVB(2)                                                         GAMA 027
      RETURN                                                            GAMA 028
      END                                                               GAMA 029
*     FORTRAN                                                           GAMA 030
      SUBROUTINE WHICH ( X,A,ASYMC,CNTFR,GAUSW,IBB,NVB,Z,B,N11  )       GAMA 031
C                                                                       GAMA 032
C       THIS SUBROUTINE IS CALLED IN ORDER TO CHOOSE WHICH OF THE       GAMA 033
C       APPROXIMATIONS IS TO BE TRIED FIRST IN CALCULATING  GAMMA(A,X)  GAMA 034
C                                                                       GAMA 035
C     THIS SUBROUTINE MAY BE ALTERED - WITHOUT CHANGING GAMMA(    )     GAMA 036
C                                                                       GAMA 037
C     GAUSW,ASYMC,CNTFR  ARE SWITCHES WHICH ARE SET EQUAL TO ONE IF THE GAMA 038
C     GAUSSIAN,ASYMPTOTIC, OR CONTINUED FRACTION METHODS ARE TO BE USED.GAMA 039
C                                                                       GAMA 040
C     IBB  ADDS TO THE UPPER BOUND ON THE COUNT OF THE NUMBER OF        GAMA 041
C     ITERATIONS FOR EACH METHOD.   IF IBB=0, BOUND =100.               GAMA 042
C                                                                       GAMA 043
C     THERE NOW FOLLOWS A TABLE OF MEANINGS FOR THE VECTOR NVB.         GAMA 044
C                                                                       GAMA 045
C       NVB(1)  IS THE  EXP  FOR THE ACCURACY CONTROL FACTOR  P         GAMA 046
C        P = 2.*10.0**EXP(-7)  UNLESS NVB(1) IS SPECIFIED               GAMA 047
C                                                                       GAMA 048
C                                                                       GAMA 049
C       NVB(2) FLAGS OVERFLOW.  THE OVERFLOW MAY EFFECT THE             GAMA 050
C     RESULTS WHEN NVB(2) IS GREATER THAN THREE.                        GAMA 051
C                                                                       GAMA 052
C       NVB(3) COUNTS THE NUMBER OF ITERATIONS OR TERMS ACTUALLY USED   GAMA 053
C                                                                       GAMA 054
C       NVB(4) IS A SWITCH, WHEN NVB(4)=1  INFORMATION ABOUT THE NUMBER GAMA 055
C       OF TERMS NEEDED TO REACH AN ACCURACY OF  P, TYPE OF SERIES      GAMA 056
C       EXPANSION,VALUES OF GAMMA,ETC.,ARE PRINTED OUT BY THE SUBROUTINEGAMA 057
C                                                                       GAMA 058
C       NVB(5) , WHEN NOT EQUAL TO ZERO, CAUSES THE SUBROUTINE TO       GAMA 059
C       CALCULATE  GAMMA  SUCESSIVELY BY SEVERAL DIFFERENT METHODS.     GAMA 060
C                                                                       GAMA 061
      DIMENSION NVB(5)                                                  GAMA 062
      IBB=100                                                           GAMA 063
      A1 =2.                                                            GAMA 064
      NVB(2) = 0.                                                       GAMA 065
C     NVB(4)=1                                                          GAMA 066
      NVB(5)=0                                                          GAMA 067
  75  IF(X-200.) 80,102,102                                             GAMA 068
 80   IF(A-INTF(A) ) 85,83,85                                           GAMA 069
  83  IF(A-20.) 99,99,98                                                GAMA 070
  85  IF(A+X-13. )  102,102,98                                          GAMA 071
  98  IF(X-A) 102,100,100                                               GAMA 072
  99  N11= 150./A                                                       GAMA 073
  100 ASYMC=1.                                                          GAMA 074
      GO TO 104                                                         GAMA 075
  102  ASYMC=0.                                                         GAMA 076
 104  IF(X-  A ) 107,105,105                                            GAMA 077
  105 IF(X-1. ) 107,107,106                                             GAMA 078
  106  CNTFR=1.                                                         GAMA 079
      GO TO 109                                                         GAMA 080
  107  CNTFR=0.                                                         GAMA 081
  109 IF(500. -X ) 111,111,112                                          GAMA 082
  111 TRD=.333333333                                                    GAMA 083
      A9=9.*A                                                           GAMA 084
      Z=((X/A)**TRD-1.+1./A9 -2./(A9*A9) )*SQRTF(A9)                    GAMA 085
      IF(ABSF(Z) -A1) 121,121,112                                       GAMA 086
  121 GAUSW=1.                                                          GAMA 087
      GO TO 113                                                         GAMA 088
  112 GAUSW=0.0                                                         GAMA 089
  113 RETURN                                                            GAMA 090
      END                                                               GAMA 091
*     FORTRAN                                                           GAMA 092
      SUBROUTINE GAMMA(A,X,GAM,B,NVB)                                   GAMA 093
C                                                                       GAMA 094
C         INCOMPLETE GAMMA FUNCTION SUBROUTINE                          GAMA 095
C                                                                       GAMA 096
C                                                                       GAMA 097
C     SUBROUTINE GAMMA(A,X,GAM,B,NVB)  IS A ROUTINE FOR EVALUATING THE  GAMA 098
C     NORMALIZED GAMMA FUNCTION                                         GAMA 099
C                                                                       GAMA 100
C                 GAM(A,X) = GAMMA(A,X)/GAMMA(A)                        GAMA 101
C                                                                       GAMA 102
C     FOR ALL REAL  X  AND  A  GREATER THAN OR EQUAL TO ZERO.           GAMA 103
C                                                                       GAMA 104
C     ACCURACY IS ABOUT PLUS OR MINUS .000001  EXCEPT FOR LARGE A NEAR XGAMA 105
C     OR  A  LESS THAN .1  UNLESS OTHERWISE SPECIFIED IN  WHICH.        GAMA 106
C                                                                       GAMA 107
C     THE GAMMA INTEGRAL IS FROM  X  TO INFINITY                        GAMA 108
C     IT IS ALSO EQUAL TO THE  A-1 TH. POISSON SUM                      GAMA 109
C                                                                       GAMA 110
C     IN THE PEARSON TABLES OF THE INCOMPLETE GAMMA FUNCTION            GAMA 111
C     I(U,P) = 1 - GAM( P+1, U*SQRTF(P+1)  )                            GAMA 112
C     I( X/(A**(1/2)), A-1 ) = 1 - GAM(A,X)                             GAMA 113
C                                                                       GAMA 114
C     AND FOR CHI-SQUARE PERCENTILE TABLES, THE PROBABILITY THAT        GAMA 115
C     CHI-SQUARE IS LESS THAN  CX   IS                                  GAMA 116
C       PROB( CX, DF ) = 1. - GAM( DF/2 , CX/2 )                        GAMA 117
C     THAT IS TO SAY X = CX/2   AND  A = DF/2                           GAMA 118
C       OR  CHI-SQUARE = 2*X  AND DF = 2*A                              GAMA 119
C                                                                       GAMA 120
C     B  IS THE A-TH.  POISSON TERM.                                    GAMA 121
C     IT IS ALSO ACCURATE TO ABOUT .0001 PERCENT.                       GAMA 122
C                                                                       GAMA 123
      DIMENSION NVB(5) ,AS(8)                                           GAMA 124
      N11=1                                                             GAMA 125
      IF(SWX-1.111)110,120,110                                          GAMA 126
 110  CONTINUE                                                          GAMA 127
      AS(1)=-.577191652                                                 GAMA 128
      AS(2)=0.988205891                                                 GAMA 129
      AS(3)=-.897056937                                                 GAMA 130
      AS(4)=0.918206857                                                 GAMA 131
      AS(5)=-.756704078                                                 GAMA 132
      AS(6)=0.482199394                                                 GAMA 133
      AS(7)=-.193527818                                                 GAMA 134
      AS(8)=0.035868343                                                 GAMA 135
      E=2.718281828                                                     GAMA 136
      TPI= 6.28318530                                                   GAMA 137
      CZP=-35.0                                                         GAMA 138
      CZ=10.0**CZP                                                      GAMA 139
      CZR = 1./CZ                                                       GAMA 140
      SWX=1.111                                                         GAMA 141
  120 AFR=A-INTF(A)                                                     GAMA 142
      DEM=A + 1.                                                        GAMA 143
      F=1.0                                                             GAMA 144
      XP=-7.                                                            GAMA 145
      SWS=0.                                                            GAMA 146
      SWT=0.                                                            GAMA 147
      SWW=0.                                                            GAMA 148
      SWR=0.                                                            GAMA 149
      SFS=0.                                                            GAMA 150
      SWG=0.                                                            GAMA 151
      Z=0.                                                              GAMA 152
      NVB(2)=0                                                          GAMA 153
      NS=0                                                              GAMA 154
      NT=0                                                              GAMA 155
      NR=0                                                              GAMA 156
      BT = .4342944819                                                  GAMA 157
      X1 = (SQRTF(A))*(11.  + 5.0*(BT*LOGF(A) - .9)**2 )                GAMA 158
  148 IF(X-CZ) 149,149,150                                              GAMA 159
  149 B=0.                                                              GAMA 160
      GAM=1.                                                            GAMA 161
      GAMT = 1.                                                         GAMA 162
      SWT=1.                                                            GAMA 163
      GO TO 400                                                         GAMA 164
C                                                                       GAMA 165
  150 IF(A- 0.5 ) 155,155,151                                           GAMA 166
 151  IF(A - 40. ) 152,152,190                                          GAMA 167
  152 IF(X - X1) 156,156,153                                            GAMA 168
C                                                                       GAMA 169
 153  B=0.                                                              GAMA 170
 154  GAM=0.                                                            GAMA 171
      SWW=1.0                                                           GAMA 172
      GO TO 400                                                         GAMA 173
C                                                                       GAMA 174
  155 IF(X - 85.  )  156,156,153                                        GAMA 175
C                                                                       GAMA 176
C                                                                       GAMA 177
C     CALCULATION OF THE POISSON TERM B(X,A)                            GAMA 178
  156 DO 170 I=1,50                                                     GAMA 179
      DEM=DEM-1.0                                                       GAMA 180
      IF(DEM-1.0)175,159,160                                            GAMA 181
C                                                                       GAMA 182
  159 F=X*F                                                             GAMA 183
      GO TO 175                                                         GAMA 184
  160 F=(X/DEM)*F                                                       GAMA 185
 163  IF(F-CZ) 153,170,170                                              GAMA 186
  170 CONTINUE                                                          GAMA 187
  171 PRINT 901                                                         GAMA 188
      RETURN                                                            GAMA 189
C                                                                       GAMA 190
  175 EXPX = E**X                                                       GAMA 191
      GGF=LOGF(F/EXPX)                                                  GAMA 192
C                                                                       GAMA 193
C     GAMMA FUNCTION OF ONE PLUS THE FRACTIONAL PART OF A               GAMA 194
C     FROM CHEBYSCHEV APPROXIMATION OF POWER 8 (HASTINGS)               GAMA 195
C     ACCURATE TO WITHIN + OR - .0000 002                               GAMA 196
C                                                                       GAMA 197
 176  GS=0.0                                                            GAMA 198
      DO 180 J=1,8                                                      GAMA 199
      JS=9-J                                                            GAMA 200
  180 GS=GS*AFR+AS(JS)                                                  GAMA 201
      GA=1.+GS*AFR                                                      GAMA 202
C                                                                       GAMA 203
  181 GGB= AFR*LOGF(X)  + GGF - LOGF(GA)                                GAMA 204
      GO TO 193                                                         GAMA 205
C                                                                       GAMA 206
 187  B=0.                                                              GAMA 207
      BAM=0.                                                            GAMA 208
       GO TO 196                                                        GAMA 209
C                                                                       GAMA 210
C     STIRLINGS APPROXIMATION EXTENDED                                  GAMA 211
  190 WPT=LOGF(X) - LOGF(A) + 1. - X/A                                  GAMA 212
      GGB = A*WPT -.5*(LOGF(TPI)+LOGF(A)) - 1./(12.*A) +1./(360.*A**3)  GAMA 213
  193 IF(GGB + 85.) 187,194,194                                         GAMA 214
  194 B= E**GGB                                                         GAMA 215
  195 BAM=(A/X)*B                                                       GAMA 216
 196   CALL      WHICH ( X,A,ASYMC,CNTFR,GAUSW,IBB,NVB,Z,B,N11 )        GAMA 217
       V=NVB(1)                                                         GAMA 218
      IF(NVB(1)) 125,130,125                                            GAMA 219
  125 XP=-ABSF( V)                                                      GAMA 220
  130 P=2.*10.0**XP                                                     GAMA 221
      IUB=IBB + 100                                                     GAMA 222
  197 IF(GAUSW) 198,198,700                                             GAMA 223
  198 IF(ASYMC) 199,199,300                                             GAMA 224
  199 IF(CNTFR) 200,200,600                                             GAMA 225
C                                                                       GAMA 226
C                                                                       GAMA 227
C     CONVERGENT SERIES FOR SMALL X                                     GAMA 228
      FREQUENCY 207(1,1,15)                                             GAMA 229
  200 SWT=1.                                                            GAMA 230
 201  T=1.                                                              GAMA 231
 202  SUMT=1.                                                           GAMA 232
 203  DO 230 NT=1,IUB                                                   GAMA 233
 204  ZT=NT                                                             GAMA 234
 205  T=T*X/(A + ZT )                                                   GAMA 235
 206  RAT = T/SUMT                                                      GAMA 236
 207  IF(RAT-P)240,240,220                                              GAMA 237
 220  SUMT=SUMT+T                                                       GAMA 238
 221  IF(SUMT - CZR) 230,230,235                                        GAMA 239
 230  CONTINUE                                                          GAMA 240
      WRITE OUTPUT TAPE 6,904                                           GAMA 241
      NVB(2) = 5                                                        GAMA 242
      GO TO 240                                                         GAMA 243
C     PRINT 903                                                         GAMA 244
  235 NVB(2)=6                                                          GAMA 245
  240 GAMT=1.0-B*SUMT                                                   GAMA 246
      GAM=GAMT                                                          GAMA 247
      GO TO 400                                                         GAMA 248
C                                                                       GAMA 249
C     ASYMPTOTIC SERIES FOR LARGE X, A GREATER THAN 1                   GAMA 250
      FREQUENCY 303(100,0,100), 319(100,1,1) , 322(1,1,15)              GAMA 251
  300 SWS=1.                                                            GAMA 252
      S=1.                                                              GAMA 253
      SUMS=1.                                                           GAMA 254
      XM=-X                                                             GAMA 255
C                                                                       GAMA 256
  315 DO 330 NS=1,IUB                                                   GAMA 257
 316  ZS=NS                                                             GAMA 258
 317  CE=(ZS-A)/XM                                                      GAMA 259
 348  NACE = ABSF(CE)                                                   GAMA 260
 319  IF(NACE-N11 ) 320,340,340                                         GAMA 261
 320  S=CE*S                                                            GAMA 262
 321  RAS=ABSF(S/SUMS)                                                  GAMA 263
 322  IF(RAS-P)350,350,330                                              GAMA 264
  330 SUMS=SUMS+S                                                       GAMA 265
      WRITE OUTPUT TAPE 6,904                                           GAMA 266
C                                                                       GAMA 267
      NVB(2) = 4                                                        GAMA 268
  340 GAMS=BAM*SUMS                                                     GAMA 269
      GO TO 199                                                         GAMA 270
C                                                                       GAMA 271
  350 GAMS=BAM*SUMS                                                     GAMA 272
      GAM=GAMS                                                          GAMA 273
      IF(NVB(5) -2) 400,400,199                                         GAMA 274
C                                                                       GAMA 275
C     CONTINUED FRACTION APPROX. TO GAMMA  FOR X LARGE RELATIVE TO  A   GAMA 276
C       ODD PART                                                        GAMA 277
      FREQUENCY   641(1,1,15), 642(100,100,0), 632(100,100,0)           GAMA 278
  600 SWR = 1.                                                          GAMA 279
 601  AAM=1./X                                                          GAMA 280
 602  BBM=1.                                                            GAMA 281
 603  AA= (X+1.)/(X*X)                                                  GAMA 282
 604  BB=(X+2.-A)/X                                                     GAMA 283
 605  APPX=AA/BB                                                        GAMA 284
 620  DO 647 N=2,IUB                                                    GAMA 285
 621  SN=N                                                              GAMA 286
 622  AC= -(SN-1.)*(SN-A)/(X*X)                                         GAMA 287
 623  BC= (X+2.*SN-A)/X                                                 GAMA 288
 624  AAP=BC*AA+AC*AAM                                                  GAMA 289
 625  AAA=ABSF(AAP)                                                     GAMA 290
 642  IF(AAA-CZR) 643,643,655                                           GAMA 291
 643  CONTINUE                                                          GAMA 292
 644  BBP=BC*BB+AC*BBM                                                  GAMA 293
 645  BBB=ABSF(BBP)                                                     GAMA 294
 632  IF(BBB-CZR) 633,633,655                                           GAMA 295
 633  CONTINUE                                                          GAMA 296
 634  AAM=AA                                                            GAMA 297
 635  AA=AAP                                                            GAMA 298
 636  BBM=BB                                                            GAMA 299
 637  BB=BBP                                                            GAMA 300
 638  APPXM=APPX                                                        GAMA 301
 639  APPX=AA/BB                                                        GAMA 302
      RAR=ABSF((APPX-APPXM)/APPXM)                                      GAMA 303
  641 IF(RAR-P) 650,650,647                                             GAMA 304
 647  CONTINUE                                                          GAMA 305
  650 NR=3*N                                                            GAMA 306
 651  CFCT=A*APPX                                                       GAMA 307
      GO TO 660                                                         GAMA 308
 655  GAMR=B*A*APPX                                                     GAMA 309
C                                                                       GAMA 310
  661 SFS=1.                                                            GAMA 311
      NVB(2)=3                                                          GAMA 312
      NR=3*N                                                            GAMA 313
 662  CNTFR=0.                                                          GAMA 314
      GO TO 300                                                         GAMA 315
  660 GAMR=B*CFCT                                                       GAMA 316
      IF(CFCT) 661,661,665                                              GAMA 317
 665  GAM=GAMR                                                          GAMA 318
      IF(NVB(5) -3) 400,400,662                                         GAMA 319
C                                                                       GAMA 320
C                                                                       GAMA 321
C                                                                       GAMA 322
  700 SWG=1.                                                            GAMA 323
      IF(Z) 710,705,710                                                 GAMA 324
  705 TRD=.33333333                                                     GAMA 325
      A9= 9.*A                                                          GAMA 326
      Z=((X/A)**TRD - 1. + 1./A9  - 2./(A9*A9) )*SQRTF(A9)              GAMA 327
 710  CALL GAUSS(Z,GAAM)                                                GAMA 328
      IF(GAAM) 775,780,780                                              GAMA 329
 775  NVB(2)=2                                                          GAMA 330
      GO TO 198                                                         GAMA 331
 780  IF(NVB(5))785,785,198                                             GAMA 332
  785 GAM=GAAM                                                          GAMA 333
      GO TO 400                                                         GAMA 334
C                                                                       GAMA 335
C                                                                       GAMA 336
  400 IF(NVB(4)-1)401,402,401                                           GAMA 337
  401 GO TO 900                                                         GAMA 338
  402 IF(SWZ-1.1111)403,405,403                                         GAMA 339
  403 SWZ=1.1111                                                        GAMA 340
 404  WRITE OUTPUT TAPE 6,911,P                                         GAMA 341
 405  WRITE OUTPUT TAPE 6,906                                           GAMA 342
      IF(SWS-1. ) 420,418,420                                           GAMA 343
 418  WRITE OUTPUT TAPE 6,918,NVB(2),NS,      RAS,X1,GAMS,GA,B,X,A      GAMA 344
 420  IF(SWR-1.0) 433,431,433                                           GAMA 345
  431 IF(SFS-1. ) 4316,4315,4316                                        GAMA 346
 4315 WRITE OUTPUT TAPE 6,962,RAR,NR                                    GAMA 347
 4316 WRITE OUTPUT TAPE 6,948, NVB(2),NR,      RAR,X1,GAMR,GA,B,X,A     GAMA 348
 433  IF(SWT-1.0)430,428,430                                            GAMA 349
 428  WRITE OUTPUT TAPE 6,928,NVB(2), NT,        RAT,X1,GAMT,GA,B,X,A   GAMA 350
 430  IF(SWW-1.0)440,438,440                                            GAMA 351
 438  WRITE OUTPUT TAPE 6,938,X1,GAM,X,A                                GAMA 352
  440 IF(SWG - 1.) 450,448,450                                          GAMA 353
  448 RAG=(GAAM - GAM)/GAM                                              GAMA 354
      WRITE OUTPUT TAPE 6,958, Z,RAG,X1,GAAM,GA,B,X,A,                  GAMA 355
 450  GO TO 900                                                         GAMA 356
C                                                                       GAMA 357
 900  NVB(3) = NS + NT + NR                                             GAMA 358
      RETURN                                                            GAMA 359
C                                                                       GAMA 360
  901 FORMAT(20H LOOP IN CALC. OF B                                    )GAMA 361
  902 FORMAT(55H  FLOATING POINT UNDER-SPILL GAMMA                     )GAMA 362
  903 FORMAT(50H POSSIBILITY OF FLOATING POINT OVERFLOW IN GAMMA       )GAMA 363
 962  FORMAT(84H FLOATING POINT SPILL IN CONTINUED FRACTION CALCULATION GAMA 364
     1 OF GAMMA.  RELATIVE ERROR   F10.8, 5X,I3,17H TERMS CALCULATED   )GAMA 365
  904 FORMAT(50H UPPER BOUND ON ITERATION COUNT REACHED IN GAMMA       )GAMA 366
 906  FORMAT(1H  )                                                      GAMA 367
 911  FORMAT(120H  TYPE OF             NUMBER      Z     LAST TERM      GAMA 368
     1X1     GAMMA(X,A)    GAMMA (ONE +      B           X        A    /GAMA 369
     2       115H EXPANSION   NVB(2)  OF TERMS           OVER  SUM      GAMA 370
     3       /GAMMA(A)     FRCT.PART A)                                /GAMA 371
     4   38X, F9.8               )                                      GAMA 372
 928  FORMAT( 12H CONVERGENT, I5, 4X, I4, 3X, 9X  ,     F10.8, 3X,      GAMA 373
     1  F8.4 , 3X, F10.8, 3X, F10.8,1X,F13.8, 3X, F7.3, 2X, F8.4  )     GAMA 374
 918  FORMAT( 12H ASYMPTOTIC, I5, 4X, I4, 3X, 9X  ,     F10.8, 3X,      GAMA 375
     1  F8.4 , 3X, F10.8, 3X, F10.8,1X,F13.8, 3X, F7.3, 2X, F8.4  )     GAMA 376
 938  FORMAT (14H X EXCEEDS X1 36X, F8.4, 3X, F10.8,31X,F7.3, 2X,F8.4  )GAMA 377
 948  FORMAT( 12H CONT.FRACT. I5, 4X, I4, 3X, 9X  ,     F10.8, 3X,      GAMA 378
     1  F8.4 , 2X, F11.8, 3X, F10.8,1X,F13.8, 3X, F7.3, 2X, F8.4  )     GAMA 379
  958 FORMAT(12H GAUSSIAN     5X,6X,F11.7,3X,F10.8, 3X,                 GAMA 380
     1  F8.4 , 2X, F11.8, 3X, F10.8,1X,F13.8, 3X, F7.3, 2X, F8.4  )     GAMA 381
      END                                                               GAMA 382
*     FORTRAN                                                           GAMA 383
      SUBROUTINE  GAUSS(Z,ALPHA)                                        GAMA 384
      DIMENSION AT(6)                                                   GAMA 385
      CZZ=200.0                                                         GAMA 386
      SQR2 = 1.41421356                                                 GAMA 387
      X=ABSF(Z/SQR2)                                                    GAMA 388
      AT(1) = .0705230784                                               GAMA 389
      AT(2) = .0422820123                                               GAMA 390
      AT(3) = .0092705272                                               GAMA 391
      AT(4) = .0001520143                                               GAMA 392
      AT(5) = .0002765672                                               GAMA 393
      AT(6) = .0000430638                                               GAMA 394
C                                                                       GAMA 395
      GR=0.                                                             GAMA 396
      DO 720  J=1,6                                                     GAMA 397
      JS=7-J                                                            GAMA 398
  720  GR=GR*X + AT(JS)                                                 GAMA 399
      GR = 1. + GR*X                                                    GAMA 400
      IF(GR - CZZ) 740,740,730                                          GAMA 401
  730 PH=0.                                                             GAMA 402
      GO TO 750                                                         GAMA 403
  740 PH=1./GR**16                                                      GAMA 404
  750 ALPHA = 0.5*PH                                                    GAMA 405
      IF(Z) 755,760,760                                                 GAMA 406
  755 ALPHA = 0.5 + 0.5*(1.-PH)                                         GAMA 407
  760 RETURN                                                            GAMA 408
      END                                                               GAMA 409
