      SUBROUTINE PIV1                                                   IP92A221
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP92A222
     1,KC1,BND,ALPHA,N7,N8,NSW3                                         IP92A223
      DIMENSION A(204,104),LT(104),B(104),KC(104),JORDER(104),JZEROS(104IP92A224
     1),KR(204),U(204),D(204),INDEX(204),ALPHA(3)                       IP92A225
      KC1=KR(I1)                                                        IP92A226
      DO 3 J=1,N                                                        IP92A227
    3 B(J)=A(I1,J)                                                      IP92A228
   23 DNM=1.0                                                           IP92A229
      KSIG=0                                                            IP92A230
      TOL=0.0                                                           IP92A231
      J1=JORDER(KC1)                                                    IP92A232
      IF (B(J1)+100000.0)31,30,30                                       IP92A233
   31 V=INTF(-B(J1)/100.0)                                              IP92A234
      DO 32 J=1,N                                                       IP92A235
      BB=B(J)/V                                                         IP92A236
      B(J)=INTF(BB)                                                     IP92A237
      IF (B(J)-BB)32,32,34                                              IP92A238
   34 B(J)=B(J)-1.0                                                     IP92A239
   32 CONTINUE                                                          IP92A240
   27 J1=JORDER(KC1)                                                    IP92A241
   30 IF (B(J1)+1.0)4,5,4                                               IP92A242
    4 KSIG=1                                                            IP92A243
      DIV=-(B(J1))                                                      IP92A244
      DNM=MAX1F(1.0,INTF(DNM*DIV+.5))                                   IP92A245
      IF (DNM-100000.0)8,8,18                                           IP92A246
    8 TOL=.5/DNM                                                        IP92A247
      DO 6 J=1,N                                                        IP92A248
    6 B(J)=B(J)/DIV                                                     IP92A249
    5 ASTR=0.0                                                          IP92A250
      DO 10 I=2,M1                                                      IP92A251
      IF (KR(I)-KC1)11,10,10                                            IP92A252
   11 AA=A(I,1)+A(I,J1)*B(1)                                            IP92A253
      IF (AA+TOL)25,10,10                                               IP92A254
   25 IF (ABSF(ASTR-AA)-TOL)15,15,16                                    IP92A255
   15 IF (KR(I)-KR(I1))17,10,10                                         IP92A256
   16 IF (ASTR-AA)10,999,17                                             IP92A257
  999 CALL OFF (5H PIV1,9,ASTR,AA)                                      IP92A258
   17 ASTR=AA                                                           IP92A259
      I1=I                                                              IP92A260
   10 CONTINUE                                                          IP92A261
      IF (ASTR)14,9,999                                                 IP92A262
   14 KC1=0                                                             IP92A263
      B(1)=ASTR                                                         IP92A264
      DO 13 J=2,N                                                       IP92A265
      B(J)=A(I1,J)+A(I1,J1)*B(J)                                        IP92A266
      IF (B(J)+TOL)20,13,13                                             IP92A267
   20 IF (KC(J)-KC1)13,997,21                                           IP92A268
  997 CALL OFF (5H PIV1,10,J,JORDER(KC1))                               IP92A269
   21 KC1=KC(J)                                                         IP92A270
   13 CONTINUE                                                          IP92A271
      IF (KC1)24,24,27                                                  IP92A272
    9 IF (KSIG)996,24,18                                                IP92A273
  996 CALL OFF (5H PIV1,11,KSIG,0)                                      IP92A274
   18 DO 19 J=1,N                                                       IP92A275
      BB=B(J)+TOL                                                       IP92A276
      B(J)=INTF(BB)                                                     IP92A277
      IF (BB)22,19,19                                                   IP92A278
   22 B(J)=B(J)-1.0                                                     IP92A279
   19 CONTINUE                                                          IP92A280
      GO TO 23                                                          IP92A281
   24 RETURN                                                            IP92A282
      END (0,1,0,0,1)                                                   IP92A283
