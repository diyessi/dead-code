     3            STA(372), STS(372), TOC(372), TGP(372), RESULT(400),  ERTS1111
     4            DDA(400), XPRED(40), TRDCYL(40), RSUM(10), V(5),      ERTS1112
     5            CFDEG1(4), CFDEG2(4), CFDEG3(4), BB(5,5), MSW(10),    ERTS1113
     6            SPARE(100)                                            ERTS1114
C                                                                       ERTS1115
      COMMON  LR, X, K, RA, A, OMA, CMA, ROC, B, UCL, BCL, ERC, PAF,    ERTS1116
     1        PAS, WMA, BTM, STA, STS, TOC, TGP, RESULT, DDA,           ERTS1117
     2        XPRED, TRDCYL, RSUM, V, CFDEG1, CFDEG2, CFDEG3, BB, MSW,  ERTS1118
     3        KC, KODE, LFSTYR, N, NFSTYR, NDDA, SIGMA, K33, LLSTYR,    ERTS1119
     4        NP1, NP7, NP8, NP12, NP14, N1, N5, N11, N12, KK, NOPTS,   ERTS1120
     5        NOBLK, KDAY, KMO, KYR, KPAGE, NPAGE, SPARE, LY, R, C, D,  ERTS1121
     6        O, S, CI, MCD                                             ERTS1122
C                                                                       ERTS1123
C                                                                       ERTS1124
C         PREPARATION OF TWENTY-FOUR MONTH FORECAST                     ERTS1125
 8998 LY = LY                                                           ERTS1126
 9000 IF(K(33))9500, 9001, 9001                                         ERTS1127
 9001 IF(K(33)-4)9002, 9005, 9500                                       ERTS1128
 9002 M = K(33)                                                         ERTS1129
 9003 MK = K(33)                                                        ERTS1130
 9004 GO TO 9010                                                        ERTS1131
 9005 M = 3                                                             ERTS1132
 9006 MK = 3                                                            ERTS1133
 9010 NP = XMODF(N,12)                                                  ERTS1134
 9012 IF(KODE) 9013,9013,9020                                           ERTS1135
 9013 DO 9016 I=1,24                                                    ERTS1136
 9015 NPI=I+NP                                                          ERTS1137
 9016 DDA(NPI)=10000.0                                                  ERTS1138
 9017 GO TO 9032                                                        ERTS1139
 9020 MM1=(LR(1)-NFSTYR)*12+N                                           ERTS1140
 9022 IF(NDDA-MM1-24) 9013,9023,9023                                    ERTS1141
 9023 DO 9026 I=1,24                                                    ERTS1142
 9024 II=I+MM1                                                          ERTS1143
 9025 NPI = I+NP                                                        ERTS1144
 9026 DDA(NPI) = DDA(II)                                                ERTS1145
 9032 DO 9038 I=1,12                                                    ERTS1146
 9034 II=N+I                                                            ERTS1147
 9035 NPI = I+NP                                                        ERTS1148
 9036 PAF(NPI) = PAF(II)                                                ERTS1149
 9038 PAF(NPI+12) = PAF(II)                                             ERTS1150
 9060 IF(NP)9080, 9080, 9062                                            ERTS1151
 9062 LLR1 = LR(LY)                                                     ERTS1152
 9064 LLR2 = LLR1+1                                                     ERTS1153
 9066 LLR3 = LLR1+2                                                     ERTS1154
 9068 DO 9076 I = 1,NP                                                  ERTS1155
 9070 DDA(I) = 0.0                                                      ERTS1156
 9072 PAF(I) = 0.0                                                      ERTS1157
 9074 TRDCYL(I) = 0.0                                                   ERTS1158
 9076 XPRED(I) = 0.0                                                    ERTS1159
 9078 GO TO 9084                                                        ERTS1160
 9080 LLR1 = LR(LY)+1                                                   ERTS1161
 9082 LLR2 = LLR1+1                                                     ERTS1162
 9084 NPP24 = NP+24                                                     ERTS1163
 9085 KK = 33                                                           ERTS1164
 9086 MSW(2) = 1                                                        ERTS1165
 9087 CALL PRINT                                                        ERTS1166
 9088 WRITE OUTPUT TAPE 6, 7541                                         ERTS1167
 9090 IF(NP)9092, 9092, 9094                                            ERTS1168
 9092 WRITE OUTPUT TAPE 6, 7190, LLR1, (DDA(I),I = 1,12),LLR2, (DDA(I),IERTS1169
     1= 13,24),LLR1, (PAF(I),I = 1,12),LLR2,(PAF(I),I = 13,24)          ERTS1170
 9093 GO TO 9100                                                        ERTS1171
 9094 WRITE OUTPUT TAPE 6, 7190, LLR1, (DDA(I),I = 1,12),LLR2, (DDA(I),IERTS1172
     1= 13,24), LLR3, (DDA(I), I = 25,NPP24)                            ERTS1173
 9095 WRITE OUTPUT TAPE 6, 7543                                         ERTS1174
 9096 WRITE OUTPUT TAPE 6, 7190, LLR1,(PAF(I),I = 1,12), LLR2,(PAF(I),I ERTS1175
     1= 13,24), LLR3,(PAF(I), I = 25,NPP24)                             ERTS1176
 9100 WRITE OUTPUT TAPE 6, 7544                                         ERTS1177
C                                                                       ERTS1178
C         LEAST SQUARE CALCULATION OF TREND LINE                        ERTS1179
 9105 WRITE OUTPUT TAPE 6, 7542                                         ERTS1180
 9120 IF(K(33)) 9500,9400, 9121                                         ERTS1181
 9121 LS=2*M+1                                                          ERTS1182
 9122 LB=M+2                                                            ERTS1183
 9124 LV=M+1                                                            ERTS1184
 9126 RSUM(1)=N                                                         ERTS1185
 9128 DO 9130 J=2,LS                                                    ERTS1186
 9130 RSUM(J)=0.0                                                       ERTS1187
 9132 DO 9134 J=1,LV                                                    ERTS1188
 9134 V(J)=0.0                                                          ERTS1189
 9135 XM=0.0                                                            ERTS1190
 9140 DO 9160 I=1,N                                                     ERTS1191
 9141 XM=XM+1.0                                                         ERTS1192
 9142 P=1.0                                                             ERTS1193
 9144 V(1)=V(1)+PAS(I)                                                  ERTS1194
 9146 DO 9152 J=2,LV                                                    ERTS1195
 9148 P=XM*P                                                            ERTS1196
 9150 RSUM(J) = RSUM(J)+P                                               ERTS1197
 9152 V(J)=V(J)+PAS(I)*P                                                ERTS1198
 9154 DO 9160 J=LB,LS                                                   ERTS1199
 9156 P=XM*P                                                            ERTS1200
 9160 RSUM(J) = RSUM(J)+P                                               ERTS1201
C                                                                       ERTS1202
C         CALCULATION OF TREND EQUATION COEFFICIENTS                    ERTS1203
 9165 IF(K(33)-4)9169, 9168, 9500                                       ERTS1204
 9168 M = 1                                                             ERTS1205
 9169 LB = M+2                                                          ERTS1206
 9170 LV = M+1                                                          ERTS1207
 9171 DO 9176 I=1,LV                                                    ERTS1208
 9172 DO 9176 K=1,LV                                                    ERTS1209
 9174 J = K+I                                                           ERTS1210
 9176 BB(K,I)=RSUM(J-1)                                                 ERTS1211
 9178 DO 9180 K=1,LV                                                    ERTS1212
 9180 BB(K,LB)=V(K)                                                     ERTS1213
 9230 DO 9248 L=1, LV                                                   ERTS1214
 9232 DIVB=BB(L,L)                                                      ERTS1215
 9234 DO 9236 J = L,LB                                                  ERTS1216
 9236 BB(L,J)=BB(L,J)/DIVB                                              ERTS1217
 9238 I1 = L + 1                                                        ERTS1218
 9240 IF(I1 - LB) 9242, 9250, 9250                                      ERTS1219
 9242 DO 9248 I = I1, LV                                                ERTS1220
 9244 FMULTB=BB(I,L)                                                    ERTS1221
 9246 DO 9248 J = L, LB                                                 ERTS1222
 9248 BB(I,J)=BB(I,J)-BB(L,J)*FMULTB                                    ERTS1223
 9250 A(LV)=BB(LV,LB)                                                   ERTS1224
 9252 I=LV                                                              ERTS1225
 9254 SIGMA=0.0                                                         ERTS1226
 9256 DO 9258  J=I,LV                                                   ERTS1227
 9258 SIGMA=SIGMA + BB(I-1,J) * A(J)                                    ERTS1228
 9260 I=I-1                                                             ERTS1229
 9262 A(I) =BB(I,LB) - SIGMA                                            ERTS1230
 9264 IF (I-1) 9270,  9270,  9254                                       ERTS1231
 9270 DO 9284 I=1, LV                                                   ERTS1232
 9272 GO TO (9274, 9278, 9282), M                                       ERTS1233
 9274 CFDEG1 (I) = A(I)                                                 ERTS1234
 9276 GO TO 9284                                                        ERTS1235
 9278 CFDEG 2(I) = A(I)                                                 ERTS1236
 9280 GO TO 9284                                                        ERTS1237
 9282 CFDEG 3 (I) = A(I)                                                ERTS1238
 9284 CONTINUE                                                          ERTS1239
 9290 IF(M-MK)9292, 9300, 9300                                          ERTS1240
 9292 M = M+1                                                           ERTS1241
 9294 GO TO 9169                                                        ERTS1242
C                                                                       ERTS1243
C     TWENTY-FOUR MONTH EXTRAPOLATION OF TREND-CYCLIC EQUATION          ERTS1244
 9300 IF(K(33)-4)9304, 9303, 9500                                       ERTS1245
 9303 M = 1                                                             ERTS1246
 9304 MP1 = M+1                                                         ERTS1247
 9305 DO 9316 I = 1,4                                                   ERTS1248
 9306 GO TO (9307,9310,9314),M                                          ERTS1249
 9307 A(I) = CFDEG1(I)                                                  ERTS1250
 9308 GO TO 9316                                                        ERTS1251
 9310 A(I) = CFDEG2(I)                                                  ERTS1252
 9312 GO TO 9316                                                        ERTS1253
 9314 A(I) = CFDEG3(I)                                                  ERTS1254
 9316 CONTINUE                                                          ERTS1255
 9320 DO 9336 I = 1,24                                                  ERTS1256
 9322 XX = I+N                                                          ERTS1257
 9324 Z = A(MP1)                                                        ERTS1258
 9326 DO 9330 JJ = 1,M                                                  ERTS1259
 9328 MM = M-JJ                                                         ERTS1260
 9330 Z = A(MM+1)+Z*XX                                                  ERTS1261
 9332 NPI = I+NP                                                        ERTS1262
 9334 TRDCYL(NPI) = Z                                                   ERTS1263
 9336 XPRED(NPI) = Z*PAF(NPI)/DDA(NPI)*100.0                            ERTS1264
 9338 WRITE OUTPUT TAPE 6, 8338, M, (A(I),I=1,MP1)                      ERTS1265
 9340 IF(NP) 9342, 9342, 9348                                           ERTS1266
 9342 WRITE OUTPUT TAPE 6, 7190, LLR1, (TRDCYL(I), I= 1,12),LLR2,(TRDCYLERTS1267
     1(I),I=13,24),LLR1,(XPRED(I),I=1,12),LLR2,(XPRED(I),I=13,24)       ERTS1268
 9346 GO TO 9360                                                        ERTS1269
 9348 WRITE OUTPUT TAPE 6, 7190, LLR1, (TRDCYL(I), I= 1,12),LLR2,(TRDCYLERTS1270
     1(I),I= 13,24),LLR3, (TRDCYL(I),I= 25,NPP24)                       ERTS1271
 9349 WRITE OUTPUT TAPE 6, 7543                                         ERTS1272
 9350 WRITE OUTPUT TAPE 6, 7190, LLR1,(XPRED(I),I= 1,12),LLR2,(XPRED(I),ERTS1273
     1I = 13,24),LLR3,(XPRED(I),I = 25,NPP24)                           ERTS1274
 9360 WRITE OUTPUT TAPE 6, 7544                                         ERTS1275
 9361 IF(M-MK)9362, 9500, 9500                                          ERTS1276
 9362 M = M+1                                                           ERTS1277
 9364 GO TO 9304                                                        ERTS1278
C                                                                       ERTS1279
C        EXTRAPOLATION USING ZERO ORDER TREND-CYCLIC EQUATION           ERTS1280
 9400 MP1=M+1                                                           ERTS1281
 9402 FN=N                                                              ERTS1282
 9404 YSUM=0.0                                                          ERTS1283
 9406 DO 9408 I=1,N                                                     ERTS1284
 9408 YSUM=YSUM+PAS(I)                                                  ERTS1285
 9410 A(1)=YSUM/FN                                                      ERTS1286
 9412 DO 9418 I=1,24                                                    ERTS1287
 9414 NPI=I+NP                                                          ERTS1288
 9416 TRDCYL(NPI)=A(1)                                                  ERTS1289
 9418 XPRED(NPI)=TRDCYL(NPI)*PAF(NPI)/DDA(NPI)*100.0                    ERTS1290
 9420 GO TO 9338                                                        ERTS1291
 9500 MSW(1) = 1                                                        ERTS1292
 9510 RETURN                                                            ERTS1293
C                                                                       ERTS1294
C        F O R M A T S                                                  ERTS1295
C                                                                       ERTS1296
 7190 FORMAT(1H0I5,12F9.1)                                              ERTS1297
