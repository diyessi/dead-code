C               RATIOS                                                  ERTS0867
 3705 DO3720 I=1,N1                                                     ERTS0868
 3720 STA(I) = (TOC(I+1)/TOC(I)-1.0)*100.0                              ERTS0869
 3725 KK = 22                                                           ERTS0870
 3730 IF(K(22)-22 )3810,3740,3810                                       ERTS0871
 3740 NOPTS = N - 1                                                     ERTS0872
 3742 NOBLK = 1                                                         ERTS0873
 3744 DO 3746 I = 1, NOPTS                                              ERTS0874
 3746 RESULT (I+1) = STA (I)                                            ERTS0875
 3748 CALL PRINT                                                        ERTS0876
C                                                                       ERTS0877
C     TABLE 23  IRREGULAR COMPONENTS (RATIOS OF FINAL SEASONALLY        ERTS0878
C               ADJUSTED SERIES TO ITS WEIGHTED 15-MONTH MOVING AVERAGE)ERTS0879
 3810 DO 3820 I=1,N                                                     ERTS0880
 3820 ERC(I)=(PAS(I)/WMA(I))*100.                                       ERTS0881
 3825 KK = 23                                                           ERTS0882
 3830 IF(K(23)-23 )3900,3840,3900                                       ERTS0883
 3840 NOPTS = N                                                         ERTS0884
 3842 NOBLK = 0                                                         ERTS0885
 3844 DO 3846 I = 1, NOPTS                                              ERTS0886
