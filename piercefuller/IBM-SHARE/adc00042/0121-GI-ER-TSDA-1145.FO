      SUBROUTINE PRINT2                                                 ERTS1484
C                                                                       ERTS1485
      DIMENSION   LR(50), X(372), K(50), RA(372), A(372), OMA(372),     ERTS1486
     1            CMA(372), ROC(372), B(372), UCL(372), BCL(372),       ERTS1487
     2            ERC(372), PAF(372), PAS(372), WMA(372), BTM(384),     ERTS1488
     3            STA(372), STS(372), TOC(372), TGP(372), RESULT(400),  ERTS1489
