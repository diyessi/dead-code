 3900 SUM=0.                                                            ERTS0891
 3910 DO3940 I=1,N1                                                     ERTS0892
 3930 OMA(I) = (ERC(I+1)/ERC(I)-1.0)*100.0                              ERTS0893
 3940 SUM=SUM+ABSF(OMA(I))                                              ERTS0894
 3950 R=SUM/XN1                                                         ERTS0895
 3955 KK = 24                                                           ERTS0896
 3960 IF(K(24)-24)4005,3970,4005                                        ERTS0897
 3970 NOPTS = N - 1                                                     ERTS0898
 3972 NOBLK = 1                                                         ERTS0899
 3974 DO 3976 I = 1, NOPTS                                              ERTS0900
 3976 RESULT (I+1) = OMA(I)                                             ERTS0901
 3978 CALL PRINT                                                        ERTS0902
C                                                                       ERTS0903
C     TABLE 25  PERCENT CHANGE FROM PRECEDING MONTH, WEIGHTED 15-MONTH  ERTS0904
C               MOVING AVERAGE OF THE FINAL SEASONALLY ADJUSTED SERIES  ERTS0905
 4005 SUM=0.                                                            ERTS0906
 4010 DO4040 I=1,N1                                                     ERTS0907
 4030 A(I) = (WMA(I+1)/WMA(I)-1.0)*100.0                                ERTS0908
