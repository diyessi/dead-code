C     MAIN PROGRAM                                                      ERTS0001
C     TIME SERIES DECOMPOSITION AND ADJUSTMENT                          ERTS0002
C                                                                       ERTS0003
C     L. T. UNG            ESSO RESEARCH AND ENGINEERING CO.            ERTS0004
C                                      OCTOBER 26, 1960                 ERTS0005
C                                                                       ERTS0006
C                                                                       ERTS0007
C     ------------------------------------------------------------------ERTS0008
C                                                                       ERTS0009
C     DEFINITION OF INPUT SYMBOLS -                                     ERTS0010
C     KODE = INPUT OPTION INDEX                                         ERTS0011
C     KC = SERIES IDENTIFICATION NUMBER                                 ERTS0012
C     N = TOTAL NUMBER OF MONTHS (OR ELEMENTS) IN THE TIME SERIES       ERTS0013
C     X = ORIGINAL OBSERVATIONS                                         ERTS0014
C     K33 = FORECASTING OPTION                                          ERTS0015
C     LFSTYR = FIRST YEAR OF TIME SERIES                                ERTS0016
C     NFSTYR = FIRST YEAR OF DELIVERY DAY ADJUSTMENT FACTORS (IF        ERTS0017
C             REQUIRED)                                                 ERTS0018
C     NDDA  = NUMBER OF DELIVERY DAY ADJUSTMENT FACTORS                 ERTS0019
C     SIGMA = MULTIPLE OF STANDARD ERROR TO BE USED IN SETTING          ERTS0020
C             UPPER AND LOWER CONTROL LIMITS FOR DETERMINING EXTREME    ERTS0021
C             SEASONAL-IRREGULAR RATIOS                                 ERTS0022
C                                                                       ERTS0023
C     ------------------------------------------------------------------ERTS0024
C                                                                       ERTS0025
C                                                                       ERTS0026
      DIMENSION    KORE(2)                                              ERTS26.1
      DIMENSION   LR(50), X(372), K(50), RA(372), A(372), OMA(372),     ERTS0027
     1            CMA(372), ROC(372), B(372), UCL(372), BCL(372),       ERTS0028
     2            ERC(372), PAF(372), PAS(372), WMA(372), BTM(384),     ERTS0029
     3            STA(372), STS(372), TOC(372), TGP(372), RESULT(400),  ERTS0030
     4            DDA(400), XPRED(40), TRDCYL(40), RSUM(10), V(5),      ERTS0031
     5            CFDEG1(4), CFDEG2(4), CFDEG3(4), BB(5,5), MSW(10),    ERTS0032
     6            SPARE(100)                                            ERTS0033
C                                                                       ERTS0034
      EQUIVALENCE  (KORE(1),LR(1))                                      ERTS34.1
      COMMON  LR, X, K, RA, A, OMA, CMA, ROC, B, UCL, BCL, ERC, PAF,    ERTS0035
     1        PAS, WMA, BTM, STA, STS, TOC, TGP, RESULT, DDA,           ERTS0036
     2        XPRED, TRDCYL, RSUM, V, CFDEG1, CFDEG2, CFDEG3, BB, MSW,  ERTS0037
     3        KC, KODE, LFSTYR, N, NFSTYR, NDDA, SIGMA, K33, LLSTYR,    ERTS0038
     4        NP1, NP7, NP8, NP12, NP14, N1, N5, N11, N12, KK, NOPTS,   ERTS0039
     5        NOBLK, KDAY, KMO, KYR, KPAGE, NPAGE, SPARE                ERTS0040
C                                                                       ERTS0041
C     CLEARS WORKING AREAS (OCTAL LOCATIONS 60147 - 77462 )             ERTS41.1
   90 DO 95 I = 1,7884                                                  ERTS41.2
   95 KORE(I) = 0                                                       ERTS41.3
  100 CALL INPUT                                                        ERTS0042
  110 IF(MSW(1) - 1 ) 1200, 200, 1200                                   ERTS0043
  200 CALL T0205                                                        ERTS0044
  210 IF(MSW(1) - 1) 1200, 300, 1200                                    ERTS0045
  300 CALL T0610                                                        ERTS0046
  310 IF(MSW(1) - 1) 1200, 400, 1200                                    ERTS0047
  400 CALL T1113                                                        ERTS0048
  410 IF(MSW(1) - 1) 1200, 500, 1200                                    ERTS0049
  500 CALL T1418                                                        ERTS0050
  510 IF(MSW(1) - 1) 1200, 600, 1200                                    ERTS0051
  600 CALL T1925                                                        ERTS0052
  610 IF(MSW(1) - 1) 1200, 700, 1200                                    ERTS0053
  700 CALL T2628                                                        ERTS0054
  710 IF(MSW(1) - 1) 1200, 800, 1200                                    ERTS0055
  800 CALL FORCST                                                       ERTS0056
 1200 MSW(1)=0                                                          ERTS0057
 1210 MSW(2)=0                                                          ERTS0058
 1220 CALL RETURN                                                       ERTS0059
       END                                                              ERTS0060
      SUBROUTINE INPUT                                                  ERTS0061
C                                                                       ERTS0062
C                                                                       ERTS0063
      DIMENSION   LR(50), X(372), K(50), RA(372), A(372), OMA(372),     ERTS0064
     1            CMA(372), ROC(372), B(372), UCL(372), BCL(372),       ERTS0065
     2            ERC(372), PAF(372), PAS(372), WMA(372), BTM(384),     ERTS0066
     3            STA(372), STS(372), TOC(372), TGP(372), RESULT(400),  ERTS0067
     4            DDA(400), XPRED(40), TRDCYL(40), RSUM(10), V(5),      ERTS0068
     5            CFDEG1(4), CFDEG2(4), CFDEG3(4), BB(5,5), MSW(10),    ERTS0069
     6            SPARE(100)                                            ERTS0070
C                                                                       ERTS0071
      COMMON  LR, X, K, RA, A, OMA, CMA, ROC, B, UCL, BCL, ERC, PAF,    ERTS0072
     1        PAS, WMA, BTM, STA, STS, TOC, TGP, RESULT, DDA,           ERTS0073
     2        XPRED, TRDCYL, RSUM, V, CFDEG1, CFDEG2, CFDEG3, BB, MSW,  ERTS0074
     3        KC, KODE, LFSTYR, N, NFSTYR, NDDA, SIGMA, K33, LLSTYR,    ERTS0075
     4        NP1, NP7, NP8, NP12, NP14, N1, N5, N11, N12, KK, NOPTS,   ERTS0076
     5        NOBLK, KDAY, KMO, KYR, KPAGE, NPAGE, SPARE, LY            ERTS0077
C                                                                       ERTS0078
C                                                                       ERTS0079
C        CHECK OF INPUT DATA AND PREPARATION OF PRINTOUT                ERTS0080
   30 DO 34 I=1,4                                                       ERTS0081
   32 READINPUT TAPE 5, 7033                                            ERTS0082
   34 WRITE OUTPUT TAPE 6, 7033                                         ERTS0083
   35 READ INPUT TAPE 5, 6036,KEY                                       ERTS0084
      IF(KEY-1111) 36 , 37, 36                                          ERTS0085
   36 WRITE OUTPUT TAPE 6, 7100                                         ERTS0086
      GO TO 174                                                         ERTS0087
   37 READ INPUT TAPE 5, 7036,KC,KODE,LFSTYR,N,NFSTYR,NDDA,SIGMA,K33,   ERTS0088
     1KMO,       KDAY, KYR                                              ERTS0089
   40 LY = (N+11)/12                                                    ERTS0090
   41 LLSTYR = LFSTYR+LY-1                                              ERTS0091
   43 WRITE OUTPUT TAPE 6, 7043,KC,LFSTYR,LLSTYR,N,SIGMA                ERTS0092
   44 IF(84-N)45, 45, 6970                                              ERTS0093
   45 IF(N-360) 46, 46, 6970                                            ERTS0094
   46 IF(KODE) 6940, 47, 48                                             ERTS0095
   47 WRITE OUTPUT TAPE 6, 7045                                         ERTS0096
      GO TO 52                                                          ERTS0097
   48 IF(KODE-1) 49, 49, 6940                                           ERTS0098
   49 WRITE OUTPUT TAPE 6, 7047                                         ERTS0099
      K(31) = 31                                                        ERTS0100
      K(32) = 32                                                        ERTS0101
   50 IF(84-NDDA) 51,51,6970                                            ERTS0102
   51 IF(NDDA-372) 52,52,6970                                           ERTS0103
   52 IF (K33) 53,55,55                                                 ERTS0104
   53 WRITE OUTPUT TAPE 6, 7053                                         ERTS0105
   54 GO TO 63                                                          ERTS0106
   55 IF (K33-4) 56,56,6985                                             ERTS0107
   56 WRITE OUTPUT TAPE 6, 7056                                         ERTS0108
   57 IF (K33-3) 58,58,60                                               ERTS0109
   58 WRITE OUTPUT TAPE 6, 7058, K33                                    ERTS0110
   59 GO TO 62                                                          ERTS0111
   60 WRITE OUTPUT TAPE 6, 7060                                         ERTS0112
   62 READ INPUT TAPE 5, 7062,(K(J),J=1,40)                             ERTS0113
   63 READ INPUT TAPE 5, 6036, KEY                                      ERTS0114
      IF(KEY-2222) 64, 66, 64                                           ERTS0115
   64 WRITE OUTPUT TAPE 6, 7110                                         ERTS0116
   65 GO TO 174                                                         ERTS0117
   66 JJ = 0                                                            ERTS0118
      DO 68 I = 1,40                                                    ERTS0119
      IF(K(I)-I)68, 67, 68                                              ERTS0120
   67 JJ = JJ+1                                                         ERTS0121
      LR(JJ) = K(I)                                                     ERTS0122
   68 CONTINUE                                                          ERTS0123
   70 WRITE OUTPUT TAPE 6, 7070                                         ERTS0124
   72 IF(JJ) 74,74,73                                                   ERTS0125
   73 WRITE OUTPUT TAPE 6, 7073, (LR(I),I=1,JJ)                         ERTS0126
 1073 NPAGE=JJ+1                                                        ERTS0127
 1075 IF(K33) 1079, 1077, 1077                                          ERTS0128
 1077 NPAGE = NPAGE + 1                                                 ERTS0129
 1079 IF(K(30)-30) 1093, 1081, 1093                                     ERTS0130
 1081 NPAGE=NPAGE+1                                                     ERTS0131
 1093 KPAGE=1                                                           ERTS0132
 1095 WRITE OUTPUT TAPE 6, 7500,KPAGE,NPAGE,KMO,KDAY,KYR                ERTS0133
 1097 KPAGE = KPAGE + 1                                                 ERTS0134
   74 K(33)=K33                                                         ERTS0135
   76 READ INPUT TAPE 5, 7075, (X(I),I=1,N)                             ERTS0136
   77 READ INPUT TAPE 5, 6036, KEY                                      ERTS0137
      IF(KEY-3333) 78, 79, 78                                           ERTS0138
   78 WRITE OUTPUT TAPE 6, 7120                                         ERTS0139
      GO TO 174                                                         ERTS0140
   79 LR(1) = LFSTYR                                                    ERTS0141
      DO 80 I = 2,LY                                                    ERTS0142
   80 LR(I) = LR(I-1)+1                                                 ERTS0143
C                                                                       ERTS0144
   81 NP1=N+1                                                           ERTS0145
   82 NP7=N+7                                                           ERTS0146
   83 NP8=N+8                                                           ERTS0147
   84 NP12=N+12                                                         ERTS0148
   85 NP14=N+14                                                         ERTS0149
      NP24 = N + 24                                                     ERTS0150
   86 N1=N-1                                                            ERTS0151
   87 N5=N-5                                                            ERTS0152
   88 N11=N-11                                                          ERTS0153
   89 N12=N-12                                                          ERTS0154
      MSW(2)=0                                                          ERTS0155
C                                                                       ERTS0156
C     TABLE 1 ORIGINAL OBSERVATIONS.                                    ERTS0157
   90 KK = 1                                                            ERTS0158
   91 IF(K(1)-1) 100, 92, 100                                           ERTS0159
   92 NOPTS = N                                                         ERTS0160
   93 NOBLK = 0                                                         ERTS0161
   94 DO 95  I=1,NOPTS                                                  ERTS0162
   95 RESULT(I) = X(I)                                                  ERTS0163
   96 CALL PRINT                                                        ERTS0164
C                                                                       ERTS0165
C     OPTIONS-  KODE=0  NO DELIVERY-DAY ADJUSTMENT NEEDED               ERTS0166
C                    1  DDA FACTORS TO BE ENTERED AFTER DATA            ERTS0167
C                                                                       ERTS0168
  100 IF(KODE) 178, 178, 105                                            ERTS0169
  105 READ INPUT TAPE 5, 7084, (DDA(I),I=1,NDDA)                        ERTS0170
  110 READ INPUT TAPE 5, 6036, KEY                                      ERTS0171
  112 IF(KEY-4444) 114, 120, 114                                        ERTS0172
  114 WRITE OUTPUT TAPE 6, 7130                                         ERTS0173
  116 GO TO 174                                                         ERTS0174
  120 IF(LR(1)-NFSTYR) 6950, 122, 122                                   ERTS0175
  122 MM1 = (LR(1)-NFSTYR)*12                                           ERTS0176
  123 IF(K33) 124, 126, 126                                             ERTS0177
  124 MM2 = MM1 + N                                                     ERTS0178
  125 GO TO 130                                                         ERTS0179
  126 MM2 = MM1 + NP24                                                  ERTS0180
  130 IF(NDDA-MM2) 6950, 132, 132                                       ERTS0181
  132 DO 136 I=1,NP24                                                   ERTS0182
  134 II = I + MM1                                                      ERTS0183
  136 DDA(I) = DDA(II)                                                  ERTS0184
C                                                                       ERTS0185
C     TABLE 31 DELIVERY-DAY ADJUSTMENT FACTORS                          ERTS0186
  140 KK = 31                                                           ERTS0187
  142 IF(K(31)-31) 154, 144, 154                                        ERTS0188
  144 NOPTS = N                                                         ERTS0189
  145 NOBLK = 0                                                         ERTS0190
  146 DO 148 I = 1,NOPTS                                                ERTS0191
  148 RESULT(I) = DDA(I)                                                ERTS0192
  149 CALL PRINT                                                        ERTS0193
C                                                                       ERTS0194
C     TABLE 32 ADJUSTED OBSERVATIONS                                    ERTS0195
  154 DO 158 I=1,N                                                      ERTS0196
  158 X(I) = DDA(I)*X(I)/10000.0                                        ERTS0197
  161 KK = 32                                                           ERTS0198
  162 IF(K(32)-32)178, 164, 178                                         ERTS0199
  164 NOPTS = N                                                         ERTS0200
  166 NOBLK = 0                                                         ERTS0201
  168 DO 170 I=1, NOPTS                                                 ERTS0202
  170 RESULT(I) = X(I)                                                  ERTS0203
  172 CALL PRINT                                                        ERTS0204
  173 GO TO 178                                                         ERTS0205
 6940 WRITE OUTPUT TAPE 6, 7940                                         ERTS0206
 6942 GO TO 174                                                         ERTS0207
 6950 WRITE OUTPUT TAPE 6, 7950                                         ERTS0208
 6952 GO TO 174                                                         ERTS0209
 6970 WRITE OUTPUT TAPE 6, 7970                                         ERTS0210
 6972 GO TO 174                                                         ERTS0211
 6985 WRITE OUTPUT TAPE 6, 7985                                         ERTS0212
 6987 GO TO 174                                                         ERTS0213
  174 MSW(1)=2                                                          ERTS0214
  176 GO TO 180                                                         ERTS0215
  178 MSW(1)=1                                                          ERTS0216
  180 RETURN                                                            ERTS0217
C                                                                       ERTS0218
C                                                                       ERTS0219
C        F O R M A T S                                                  ERTS0220
C                                                                       ERTS0221
 6036 FORMAT(I6)                                                        ERTS0222
 7033 FORMAT(72H                                                        ERTS0223
     1                )                                                 ERTS0224
 7036 FORMAT(6I6,F6.4,4I6)                                              ERTS0225
 7043 FORMAT(1H /////26H          TIME SERIES NO. I6 //16H          YEARERTS0226
     1S I6, 4H TO I6 //26H          NO. OF ELEMENTS I6 //91H          COERTS0227
     2NTROL LIMITS USED IN DETERMINING EXTREME VALUES IN SEASONAL-IRREGUERTS0228
     3LAR RATIOS - // F25.4, 25H  TIMES STANDARD ERRORS  )              ERTS0229
 7045 FORMAT(61H0         NO CORRECTION FOR DELIVERY DAY ADJUSTMENT FACTERTS0230
     1ORS. )                                                            ERTS0231
 7047 FORMAT( 94H0         TO BE CORRECTED FOR DELIVERY DAY ADJUSTMENT FERTS0232
     1ACTORS BEFORE ANALYSIS.  SEE TABLE 31. )                          ERTS0233
 7053 FORMAT( 33H0         NO FORECAST REQUESTED. )                     ERTS0234
 7056 FORMAT( 48H0         TWENTY-FOUR MONTH FORECAST REQUESTED. )      ERTS0235
 7058 FORMAT( 47H               DEGREE OF EQUATION TO BE USED - I2 )    ERTS0236
 7060 FORMAT( 62H               DEGREES OF EQUATIONS TO BE USED - 1,2,  ERTS0237
     1AND 3. )                                                          ERTS0238
 7062 FORMAT(24I3)                                                      ERTS0239
 7070 FORMAT( 41H0         TABLES TO BE PRINTED OUT.  NO -)             ERTS0240
 7073 FORMAT( I20,7I10)                                                 ERTS0241
 7075 FORMAT(6F12.0)                                                    ERTS0242
 7084 FORMAT(12F6.0)                                                    ERTS0243
 7100 FORMAT( 64H1         PLEASE CHECK NUMBER OF PROBLEM IDENTIFICATIONERTS0244
     1 CARDS.  )                                                        ERTS0245
 7110 FORMAT( 54H1         PLEASE CHECK NUMBER OF PROGRAM CONTROL CARDS)ERTS0246
 7120 FORMAT( 61H1         PLEASE CHECK NUMBER OF TIME SERIES ELEMENTS CERTS0247
     1ARDS.  )                                                          ERTS0248
 7130 FORMAT( 72H1         PLEASE CHECK NUMBER OF DELIVERY-DAY ADJUSTMENERTS0249
     1T FACTOR CARDS.  )                                                ERTS0250
 7500 FORMAT( 1H ///// 15H          PAGE  I2, 4H OF  I2 / 18H          DERTS0251
     1ATE -   I2, 1H/ I2, 1H/ I4 )                                      ERTS0252
 7940 FORMAT(67H1         CODE NO. FOR DELIVERY-DAY ADJUSTMENT FACTORS NERTS0253
     1OT 0 OR 1.  )                                                     ERTS0254
 7950 FORMAT( 65H1         TIME PERIOD OF INPUT DATA OUTSIDE THAT OF DDAERTS0255
     1 FACTORS. )                                                       ERTS0256
 7970 FORMAT(110H1         NO. ITEMS IN TIME SERIES OR DELIVERY DAY ADJUERTS0257
     1STMENT FACTORS EXCEEDED RANGES OF 84-360 OR 84-372.    )          ERTS0258
 7985 FORMAT( 31H1         FORECASTING OPTION = I2, 43H , OR GREATER THAERTS0259
     1N PERMISSIBLE VALUE OF 4. )                                       ERTS0260
       END                                                              ERTS0261
      SUBROUTINE T0205                                                  ERTS0262
C                                                                       ERTS0263
      DIMENSION   LR(50), X(372), K(50), RA(372), A(372), OMA(372),     ERTS0264
     1            CMA(372), ROC(372), B(372), UCL(372), BCL(372),       ERTS0265
     2            ERC(372), PAF(372), PAS(372), WMA(372), BTM(384),     ERTS0266
     3            STA(372), STS(372), TOC(372), TGP(372), RESULT(400),  ERTS0267
     4            DDA(400), XPRED(40), TRDCYL(40), RSUM(10), V(5),      ERTS0268
     5            CFDEG1(4), CFDEG2(4), CFDEG3(4), BB(5,5), MSW(10),    ERTS0269
     6            SPARE(100)                                            ERTS0270
C                                                                       ERTS0271
      COMMON  LR, X, K, RA, A, OMA, CMA, ROC, B, UCL, BCL, ERC, PAF,    ERTS0272
     1        PAS, WMA, BTM, STA, STS, TOC, TGP, RESULT, DDA,           ERTS0273
     2        XPRED, TRDCYL, RSUM, V, CFDEG1, CFDEG2, CFDEG3, BB, MSW,  ERTS0274
     3        KC, KODE, LFSTYR, N, NFSTYR, NDDA, SIGMA, K33, LLSTYR,    ERTS0275
     4        NP1, NP7, NP8, NP12, NP14, N1, N5, N11, N12, KK, NOPTS,   ERTS0276
     5        NOBLK, KDAY, KMO, KYR, KPAGE, NPAGE, SPARE, LY            ERTS0277
C                                                                       ERTS0278
C     TABLE 2 RATIOS OF EACH MONTH TO AVERAGE OF PRECEDING AND FOLLOWINGERTS0279
C             MONTHS, ALSO ARITHMETIC MEANS OF RATIOS FOR EACH MONTH.   ERTS0280
  200 DO 210 I=2,N1                                                     ERTS0281
  210 RA(I)=(2.*X(I))/(X(I-1)+X(I+1))*100.0                             ERTS0282
  225 KK = 2                                                            ERTS0283
  230 IF(K(2)-2) 500, 240, 500                                          ERTS0284
  240 NOPTS = N -2                                                      ERTS0285
  242 NOBLK = 1                                                         ERTS0286
  246 DO 248 I = 1, NOPTS                                               ERTS0287
  248 RESULT (I+1) = RA (I+1)                                           ERTS0288
  250 CALL PRINT                                                        ERTS0289
C                                                                       ERTS0290
  300 RA(1) = 0.0                                                       ERTS0291
  310 MY = 1                                                            ERTS0292
  380 SUM=0.                                                            ERTS0293
  390 DO 420 I=MY,N,12                                                  ERTS0294
  400 SUM=SUM+RA(I)                                                     ERTS0295
  410 IF(RA(I+12))430,430,420                                           ERTS0296
  420 CONTINUE                                                          ERTS0297
  430 DN=((I-MY)/12)+1                                                  ERTS0298
  432 IF(MY-1) 434, 434, 440                                            ERTS0299
  434 DN = DN - 1.                                                      ERTS0300
  440 STA(MY)=SUM/DN                                                    ERTS0301
  450 IF(MY-12)460,6400,6400                                            ERTS0302
  460 MY=MY+1                                                           ERTS0303
  470 GO TO 380                                                         ERTS0304
C                                                                       ERTS0305
C     TABLE 3 TWELVE-MONTH MOVING AVERAGE OF THE ORIGINAL SERIES        ERTS0306
  500 A(1)=0.0                                                          ERTS0307
  510 DO 520 I=1,12                                                     ERTS0308
  520 A(1)=A(1)+X(I)                                                    ERTS0309
  540 DO 550 I=2,N11                                                    ERTS0310
  550 A(I)=A(I-1)-X(I-1)+X(I+11)                                        ERTS0311
  555 DO 560 I=1,N11                                                    ERTS0312
  560 OMA(I)=A(I)/12.                                                   ERTS0313
  577 KK = 3                                                            ERTS0314
  580 IF(K(3)-3) 600, 582, 600                                          ERTS0315
  582 NOPTS = N - 11                                                    ERTS0316
  584 NOBLK = 5                                                         ERTS0317
  588 DO 590 I = 1, NOPTS                                               ERTS0318
  590 RESULT(I+5) = OMA(I)                                              ERTS0319
  592 CALL PRINT                                                        ERTS0320
C                                                                       ERTS0321
C     TABLE 4 CENTERED TWELVE-MONTH MOVING AVERAGE                      ERTS0322
  600 DO 610 I=1,N12                                                    ERTS0323
  610 CMA(I)=(OMA(I)+OMA(I+1))/2.                                       ERTS0324
  615 KK = 4                                                            ERTS0325
  620 IF(K(4)-4) 700, 630, 700                                          ERTS0326
  630 NOPTS = N - 12                                                    ERTS0327
  632 NOBLK = 6                                                         ERTS0328
  636 DO 638 I = 1, NOPTS                                               ERTS0329
  638 RESULT (I+6) = CMA(I)                                             ERTS0330
  640 CALL PRINT                                                        ERTS0331
C                                                                       ERTS0332
C     TABLE 5 RATIOS OF ORIGINAL OBSERVATIONS TO CENTERED TWELVE-MONTH  ERTS0333
C             MOVING AVERAGE                                            ERTS0334
  700 DO 710 I=1,N12                                                    ERTS0335
  710 ROC(I)=X(I+6)/CMA(I)*100.0                                        ERTS0336
  735 KK = 5                                                            ERTS0337
  740 IF(K(5)-5) 800, 750, 800                                          ERTS0338
  750 NOPTS = N - 12                                                    ERTS0339
  752 NOBLK = 6                                                         ERTS0340
  756 DO 758 I = 1, NOPTS                                               ERTS0341
  758 RESULT (I+6) = ROC(I)                                             ERTS0342
  760 CALL PRINT                                                        ERTS0343
  780 GO TO 800                                                         ERTS0344
 6400 WRITE OUTPUT TAPE 6, 7400, (STA (I),I=1,12)                       ERTS0345
 6420 GO TO 500                                                         ERTS0346
  800 MSW(1)=1                                                          ERTS0347
  820 RETURN                                                            ERTS0348
C                                                                       ERTS0349
C        F O R M A T S                                                  ERTS0350
C                                                                       ERTS0351
 7400 FORMAT(20H0           AVERAGES//F15.1,11F9.1)                     ERTS0352
       END                                                              ERTS0353
      SUBROUTINE T0610                                                  ERTS0354
C                                                                       ERTS0355
      DIMENSION   LR(50), X(372), K(50), RA(372), A(372), OMA(372),     ERTS0356
     1            CMA(372), ROC(372), B(372), UCL(372), BCL(372),       ERTS0357
     2            ERC(372), PAF(372), PAS(372), WMA(372), BTM(384),     ERTS0358
     3            STA(372), STS(372), TOC(372), TGP(372), RESULT(400),  ERTS0359
     4            DDA(400), XPRED(40), TRDCYL(40), RSUM(10), V(5),      ERTS0360
     5            CFDEG1(4), CFDEG2(4), CFDEG3(4), BB(5,5), MSW(10),    ERTS0361
     6            SPARE(100)                                            ERTS0362
C                                                                       ERTS0363
      COMMON  LR, X, K, RA, A, OMA, CMA, ROC, B, UCL, BCL, ERC, PAF,    ERTS0364
     1        PAS, WMA, BTM, STA, STS, TOC, TGP, RESULT, DDA,           ERTS0365
     2        XPRED, TRDCYL, RSUM, V, CFDEG1, CFDEG2, CFDEG3, BB, MSW,  ERTS0366
     3        KC, KODE, LFSTYR, N, NFSTYR, NDDA, SIGMA, K33, LLSTYR,    ERTS0367
     4        NP1, NP7, NP8, NP12, NP14, N1, N5, N11, N12, KK, NOPTS,   ERTS0368
     5        NOBLK, KDAY, KMO, KYR, KPAGE, NPAGE, SPARE, LY,AMP        ERTS0369
C                                                                       ERTS0370
C     TABLE 6 PRELIMINARY SEASONAL ADJUSTMENT FACTORS                   ERTS0371
  800 ASSIGN 1015 TO M1                                                 ERTS0372
  804 NX = N12                                                          ERTS0373
  805 DO 810 I=1,N                                                      ERTS0374
  810 ROC(I)=ROC(I)/100.                                                ERTS0375
  815 MY=1                                                              ERTS0376
  820 DO 825 I=1,N                                                      ERTS0377
  825 TOC(I)=ROC(I)                                                     ERTS0378
  830 DO 845 I=MY,N,12                                                  ERTS0379
  835 B(I+24)=(ROC(I)+ROC(I+12)+ROC(I+24)+ROC(I+36)+ROC(I+48))/5.       ERTS0380
  840 IF(NX-(I+60))850, 845, 845                                        ERTS0381
  845 CONTINUE                                                          ERTS0382
  850 B(MY)=.4*ROC(MY)+.4*ROC(MY+12)+.2*ROC(MY+24)                      ERTS0383
  855 B(MY+12)=.3*ROC(MY)+.3*ROC(MY+12)+.2*ROC(MY+24)+.2*               ERTS0384
     1ROC(MY+36)                                                        ERTS0385
  860 B(I+36)=.3*ROC(I+48)+.3*ROC(I+36)+.2*ROC(I+24)+.2*ROC(I+12)       ERTS0386
  865 B(I+48)=.4*ROC(I+48)+.4*ROC(I+36)+.2*ROC(I+24)                    ERTS0387
  870 TN=((I-MY)/12)+5                                                  ERTS0388
  875 LEND=I+48                                                         ERTS0389
  880 VAR=0.                                                            ERTS0390
  885 DO 890 L=MY,LEND,12                                               ERTS0391
  890 VAR=VAR+((ROC(L)-B(L))**2)/TN                                     ERTS0392
  895 S=SQRTF(VAR)                                                      ERTS0393
  900 DO 910 L=MY,LEND,12                                               ERTS0394
  905 UCL(L)=B(L)+SIGMA*S                                               ERTS0395
  910 BCL(L)=B(L)-SIGMA*S                                               ERTS0396
  915 IF(UCL(MY)-ROC(MY))  920,920,925                                  ERTS0397
  920 ROC(MY)=(TOC(MY)+TOC(MY+12)+TOC(MY+24))/3.                        ERTS0398
  925 IF(BCL(MY)-ROC(MY))   935,930,930                                 ERTS0399
  930 ROC(MY)=(TOC(MY)+TOC(MY+12)+TOC(MY+24))/3.                        ERTS0400
  935 IF(UCL(LEND)-ROC(LEND))   940,940,945                             ERTS0401
  940 ROC(LEND)=(TOC(LEND)+TOC(LEND-12)+TOC(LEND-24))/3.                ERTS0402
  945 IF(BCL(LEND)-ROC(LEND))   955,950,950                             ERTS0403
  950 ROC(LEND)=(TOC(LEND)+TOC(LEND-12)+TOC(LEND-24))/3.                ERTS0404
  955 LST=MY+12                                                         ERTS0405
  960 NST=LEND-12                                                       ERTS0406
  965 DO 990 L=LST,NST,12                                               ERTS0407
  970 IF(UCL(L)-ROC(L))    975,975,980                                  ERTS0408
  975 ROC(L)=(TOC(L-12)+TOC(L)+TOC(L+12))/3.                            ERTS0409
  980 IF(BCL(L)-ROC(L))    990,985,985                                  ERTS0410
  985 ROC(L)=(TOC(L-12)+TOC(L)+TOC(L+12))/3.                            ERTS0411
  990 CONTINUE                                                          ERTS0412
  995 IF(MY-12)    1000,1010,1010                                       ERTS0413
 1000 MY=MY+1                                                           ERTS0414
 1005 GO TO 830                                                         ERTS0415
 1010 GO TO M1,(1015,1745)                                              ERTS0416
 1015 ASSIGN 1270 TO M2                                                 ERTS0417
 1020 DO 1025 I=1,N12                                                   ERTS0418
 1025 ERC(I+6) = ROC(I)                                                 ERTS0419
 1030 DO 1035 I=1,6                                                     ERTS0420
 1035 ERC(I) = ERC(I+12)                                                ERTS0421
 1045 DO 1050 I=N5,N                                                    ERTS0422
 1050 ERC(I) = ERC(I-12)                                                ERTS0423
 1100 NCOMP = LY*12                                                     ERTS0424
 1110 DO 1115 I=NP1,NCOMP                                               ERTS0425
 1115 ERC(I) = (ERC(I-24)+ERC(I-12))/2.0                                ERTS0426
 1120 L = 1                                                             ERTS0427
 1125 J = 12                                                            ERTS0428
 1130 SUM = 0.0                                                         ERTS0429
 1135 DO 1140 I=L,J                                                     ERTS0430
 1140 SUM = SUM + ERC(I)                                                ERTS0431
 1145 XBAR = SUM/12.0                                                   ERTS0432
 1150 DO 1155 I=L,J                                                     ERTS0433
 1155 ERC(I) = ERC(I)/XBAR                                              ERTS0434
 1160 L = L+12                                                          ERTS0435
 1165 J = J+12                                                          ERTS0436
 1170 IF(J-NCOMP) 1130, 1130, 1265                                      ERTS0437
 1265 GO TO M2,(1270,1948)                                              ERTS0438
 1270 ASSIGN 1365 TO M3                                                 ERTS0439
 1275 MY=1                                                              ERTS0440
 1280 DO 1295 I=MY,N,12                                                 ERTS0441
 1285 PAF(I+24)=(ERC(I)+2.*ERC(I+12)+3.*ERC(I+24)+2.*ERC(I+36)          ERTS0442
     1+ERC(I+48))/9.                                                    ERTS0443
 1290 IF(N-(I+60))1300, 1295, 1295                                      ERTS0444
 1295 CONTINUE                                                          ERTS0445
 1300 PAF(MY)=(9.*ERC(MY)+7.*ERC(MY+12)+2.*ERC(MY+24))/18.              ERTS0446
 1305 PAF(MY+12)=(5.*ERC(MY)+7.*ERC(MY+12)+4.*ERC(MY+24)+2.*            ERTS0447
     1ERC(MY+36))/18.                                                   ERTS0448
 1310 PAF(I+36)=(5.*ERC(I+48)+7.*ERC(I+36)+4.*ERC(I+24)                 ERTS0449
     1+2.*ERC(I+12))/18.                                                ERTS0450
 1315 PAF(I+48)=(9.*ERC(I+48)+7.*ERC(I+36)+2.*ERC(I+24))/18.            ERTS0451
 1320 PAF(I+60)=(3.*PAF(I+48)-PAF(I+36))/2.                             ERTS0452
 1330 IF(MY-12)    1335,1345,1345                                       ERTS0453
 1335 MY=MY+1                                                           ERTS0454
 1340 GO TO 1280                                                        ERTS0455
 1345 CONTINUE                                                          ERTS0456
 1350 DO 1355 I=1,NP12                                                  ERTS0457
 1355 PAF(I)=PAF(I)*100.                                                ERTS0458
 1360 GO TO M3,(1365,1960)                                              ERTS0459
 1365 KK = 6                                                            ERTS0460
 1367 IF(K(6)-6) 1405,1370,1405                                         ERTS0461
 1370 NOPTS = N                                                         ERTS0462
 1372 NOBLK = 0                                                         ERTS0463
 1376 DO 1378 I = 1, NOPTS                                              ERTS0464
 1378 RESULT (I) = PAF (I)                                              ERTS0465
 1380 CALL PRINT                                                        ERTS0466
C                                                                       ERTS0467
C     TABLE 7 PRELIMINARY SEASONALLY ADJUSTED SERIES                    ERTS0468
 1405 DO 1410 I=1,N                                                     ERTS0469
 1410 PAS(I)=X(I)/PAF(I)*100.0                                          ERTS0470
 1412 KK = 7                                                            ERTS0471
 1415 IF(K(7)-7)1505,1420,1505                                          ERTS0472
 1420 NOPTS = N                                                         ERTS0473
 1422 NOBLK = 0                                                         ERTS0474
 1426 DO 1428 I = 1, NOPTS                                              ERTS0475
 1428 RESULT (I) = PAS(I)                                               ERTS0476
 1430 CALL PRINT                                                        ERTS0477
C                                                                       ERTS0478
C     TWELVE MONTHS TO DATE OF ORIGINAL SERIES                          ERTS0479
 1505 KK = 29                                                           ERTS0480
 1510 IF(K(29)-29)1550,1520,1550                                        ERTS0481
 1520 NOPTS = N - 11                                                    ERTS0482
 1522 NOBLK = 11                                                        ERTS0483
 1524 DO 1526 I = 1, NOPTS                                              ERTS0484
 1526 RESULT (I+11) = A(I)                                              ERTS0485
 1528 CALL PRINT                                                        ERTS0486
C                                                                       ERTS0487
C     TABLE 8 WEIGHTED 15-MONTH MOVING AVERAGE (SPENCERS 15-TERM FORMULAERTS0488
C             ) OF PRELIMINARY SEASONALLY ADJUSTED SERIES               ERTS0489
 1550 DO 1555 I=1,7                                                     ERTS0490
 1555 BTM(I)=(PAS(1)+PAS(2)+PAS(3)+PAS(4))/4.                           ERTS0491
 1575 DO1580 I=NP8,NP14                                                 ERTS0492
 1580 BTM(I)=(PAS(N-3)+PAS(N-2)+PAS(N-1)+PAS(N))/4.                     ERTS0493
 1585 DO1588 I=8,NP7                                                    ERTS0494
 1588 BTM(I)=PAS(I-7)                                                   ERTS0495
 1590 DO1592 I=1,N                                                      ERTS0496
 1592 WMA(I)=(-3.*BTM(I)-6.*BTM(I+1)-5.*BTM(I+2)+3.*                    ERTS0497
     1BTM(I+3)+21.*BTM(I+4)+46.*BTM(I+5)+67.*BTM(I+6)+                  ERTS0498
     274.*BTM(I+7)+67.*BTM(I+8)+46.*BTM(I+9)+21.*                       ERTS0499
     3BTM(I+10)+3.*BTM(I+11)-5.*BTM(I+12)-6.*BTM(I+13)-                 ERTS0500
     43.*BTM(I+14))/320.                                                ERTS0501
 1593 KK = 8                                                            ERTS0502
 1594 IF(K(8)-8)1615,1595,1615                                          ERTS0503
 1595 NOPTS = N                                                         ERTS0504
 1596 NOBLK = 0                                                         ERTS0505
 1597 DO 1598 I = 1, NOPTS                                              ERTS0506
 1598 RESULT (I) = WMA (I)                                              ERTS0507
 1599 CALL PRINT                                                        ERTS0508
C                                                                       ERTS0509
C     TABLE 9 RATIOS OF ORIGINAL TO WEIGHTED 15-MONTH MOVING AVERAGE    ERTS0510
 1615 DO 1620 I=1,N                                                     ERTS0511
 1620 ROC(I)=X(I)/WMA(I)*100.0                                          ERTS0512
 1625 KK = 9                                                            ERTS0513
 1630 IF(K( 9)- 9)1700,1640,1700                                        ERTS0514
 1640 NOPTS = N                                                         ERTS0515
 1642 NOBLK = 0                                                         ERTS0516
 1644 DO 1646 I = 1, NOPTS                                              ERTS0517
 1646 RESULT (I) = ROC (I)                                              ERTS0518
 1648 CALL PRINT                                                        ERTS0519
C                                                                       ERTS0520
C     TABLE 10 SMOOTHED RATIOS OF ORIGINAL TO WEIGHTED 15-MONTH MOVING  ERTS0521
C              AVERAGE                                                  ERTS0522
 1700 DO 1705 I=1,N                                                     ERTS0523
 1705 BTM(I)=PAS(I)/WMA(I)                                              ERTS0524
 1710 DN = N - 1                                                        ERTS0525
 1715 AMP=0.                                                            ERTS0526
 1720 DO 1725 I=1,N1                                                    ERTS0527
 1725 AMP=AMP+ABSF(BTM(I+1)-BTM(I))                                     ERTS0528
 1730 AMP=(AMP/DN)*100.                                                 ERTS0529
 1735 ASSIGN 1745 TO M1                                                 ERTS0530
 1738 NX = N                                                            ERTS0531
 1740 GO TO 815                                                         ERTS0532
 1745 KK = 10                                                           ERTS0533
 1750 IF(K(10)-10)1800,1760,1800                                        ERTS0534
 1760 NOPTS = N                                                         ERTS0535
 1762 NOBLK = 0                                                         ERTS0536
 1764 DO 1766 I = 1, NOPTS                                              ERTS0537
 1766 RESULT(I) = ROC (I)                                               ERTS0538
 1768 CALL PRINT                                                        ERTS0539
C                                                                       ERTS0540
C     TABLES 10 * AND 10**, STABLE ADJUSTMENT FACTORS AND SEASONALLY    ERTS0541
C                           ADJUSTED SERIES BASED ON A CONSTANT         ERTS0542
C                           SEASONAL PATTERN                            ERTS0543
 1800 KK = 30                                                           ERTS0544
 1802 IF(K(30)-30) 1940,1805,1940                                       ERTS0545
 1805 MY=1                                                              ERTS0546
 1810 SUMS=0.                                                           ERTS0547
 1815 DO 1830 I=MY,N,12                                                 ERTS0548
 1820 SUMS=SUMS+ROC(I)                                                  ERTS0549
 1825 IF(ROC(I+12))1835,1835,1830                                       ERTS0550
 1830 CONTINUE                                                          ERTS0551
 1835 C=((I-MY)/12)+1                                                   ERTS0552
 1840 STA(MY)=SUMS/C                                                    ERTS0553
 1845 IF(MY-12)1850,1860,1860                                           ERTS0554
 1850 MY=MY+1                                                           ERTS0555
 1855 GO TO 1810                                                        ERTS0556
 1860 SUM=0.                                                            ERTS0557
 1865 DO 1870 I=1,12                                                    ERTS0558
 1870 SUM=SUM+STA(I)                                                    ERTS0559
 1875 AUG=SUM/12.                                                       ERTS0560
 1880 DO 1885 I=1,12                                                    ERTS0561
 1885 STA(I)=(STA(I)/AUG)*100.                                          ERTS0562
 1890 MSW(2)=1                                                          ERTS0563
 1892 CALL PRINT                                                        ERTS0564
 1894 LRO=0                                                             ERTS0565
 1896 WRITE OUTPUT TAPE 6, 7896,LRO,(STA(I),I=1,12)                     ERTS0566
 1898 KK = 34                                                           ERTS0567
C                                                                       ERTS0568
 1915 MY=1                                                              ERTS0569
 1917 DO1920 I=MY,N,12                                                  ERTS0570
 1918 STS(I)=X(I)/STA(MY)*100.0                                         ERTS0571
 1919 IF(X(I+12))1922,1922,1920                                         ERTS0572
 1920 CONTINUE                                                          ERTS0573
 1922 IF(MY-12)1924,1930,1924                                           ERTS0574
 1924 MY=MY+1                                                           ERTS0575
 1926 GO TO 1917                                                        ERTS0576
 1930 NOPTS = N                                                         ERTS0577
 1931 NOBLK = 0                                                         ERTS0578
 1932 DO 1933 I = 1, NOPTS                                              ERTS0579
