 3494 CALL PRINT                                                        ERTS0834
C                                                                       ERTS0835
C     TABLE 20  PERCENT CHANGE FROM PRECEDING MONTH, FINAL SEASONAL     ERTS0836
C               FACTORS                                                 ERTS0837
 3505 SUM=0.                                                            ERTS0838
 3510 DO3540 I=1,N1                                                     ERTS0839
 3530 CMA(I) = (PAF(I+1)/PAF(I)-1.0)*100.0                              ERTS0840
 3540 SUM=SUM+ABSF(CMA(I))                                              ERTS0841
 3550 S=SUM/XN1                                                         ERTS0842
 3555 KK = 20                                                           ERTS0843
 3560 IF(K(20)-20 )3605,3570,3605                                       ERTS0844
 3570 NOPTS = N - 1                                                     ERTS0845
 3572 NOBLK = 1                                                         ERTS0846
 3574 DO 3576 I = 1, NOPTS                                              ERTS0847
 3576 RESULT (I+1) = CMA (I)                                            ERTS0848
 3578 CALL PRINT                                                        ERTS0849
C                                                                       ERTS0850
C     TABLE 21  PERCENT CHANGE FROM PRECEDING MONTH, FINAL SEASONALLY   ERTS0851
C               ADJUSTED SERIES                                         ERTS0852
 3605 SUM=0.                                                            ERTS0853
 3610 DO 3640 I=1,N1                                                    ERTS0854
 3630 ROC(I) = (PAS(I+1)/PAS(I)-1.0)*100.0                              ERTS0855
 3640 SUM=SUM+ABSF(ROC(I))                                              ERTS0856
 3650 CI=SUM/XN1                                                        ERTS0857
 3655 KK = 21                                                           ERTS0858
 3660 IF(K(21)-21 )3705,3670,3705                                       ERTS0859
 3670 NOPTS = N - 1                                                     ERTS0860
 3672 NOBLK = 1                                                         ERTS0861
 3674 DO 3676 I = 1, NOPTS                                              ERTS0862
 3676 RESULT (I+1) = ROC (I)                                            ERTS0863
 3678 CALL PRINT                                                        ERTS0864
C                                                                       ERTS0865
