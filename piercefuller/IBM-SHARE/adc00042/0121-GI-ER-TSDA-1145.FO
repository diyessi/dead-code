 7896 FORMAT(1H0I5,12F9.1)                                              ERTS0595
       END                                                              ERTS0596
      SUBROUTINE T1113                                                  ERTS0597
C                                                                       ERTS0598
      DIMENSION   LR(50), X(372), K(50), RA(372), A(372), OMA(372),     ERTS0599
     1            CMA(372), ROC(372), B(372), UCL(372), BCL(372),       ERTS0600
     2            ERC(372), PAF(372), PAS(372), WMA(372), BTM(384),     ERTS0601
     3            STA(372), STS(372), TOC(372), TGP(372), RESULT(400),  ERTS0602
     4            DDA(400), XPRED(40), TRDCYL(40), RSUM(10), V(5),      ERTS0603
     5            CFDEG1(4), CFDEG2(4), CFDEG3(4), BB(5,5), MSW(10),    ERTS0604
     6            SPARE(100)                                            ERTS0605
C                                                                       ERTS0606
      COMMON  LR, X, K, RA, A, OMA, CMA, ROC, B, UCL, BCL, ERC, PAF,    ERTS0607
     1        PAS, WMA, BTM, STA, STS, TOC, TGP, RESULT, DDA,           ERTS0608
     2        XPRED, TRDCYL, RSUM, V, CFDEG1, CFDEG2, CFDEG3, BB, MSW,  ERTS0609
     3        KC, KODE, LFSTYR, N, NFSTYR, NDDA, SIGMA, K33, LLSTYR,    ERTS0610
     4        NP1, NP7, NP8, NP12, NP14, N1, N5, N11, N12, KK, NOPTS,   ERTS0611
     5        NOBLK, KDAY, KMO, KYR, KPAGE, NPAGE, SPARE, LY,AMP        ERTS0612
C                                                                       ERTS0613
C                                                                       ERTS0614
C     TABLE 11 CENTERED RATIOS OF ORIGINAL TO WEIGHTED 15-MONTH MOVING  ERTS0615
C              AVERAGE (ADJUSTED TO TOTAL OF 1200 EACH YEAR)            ERTS0616
C                                                                       ERTS0617
 2048 LY = LY                                                           ERTS0618
 2050 DO2060 I=1,NP12                                                   ERTS0619
 2060 ERC(I)=ERC(I)*100.                                                ERTS0620
 2065 KK = 11                                                           ERTS0621
 2070 IF(K(11)-11) 2100, 2075, 2100                                     ERTS0622
 2075 NOPTS = N                                                         ERTS0623
 2076 NOBLK = 0                                                         ERTS0624
 2078 DO 2080 I = 1, NOPTS                                              ERTS0625
 2080 RESULT (I) = ERC (I)                                              ERTS0626
 2082 CALL PRINT                                                        ERTS0627
C                                                                       ERTS0628
C     TABLE 12 FINAL SEASONAL ADJUSTMENT FACTORS (S SERIES)             ERTS0629
 2100 IF(AMP-2.0) 2260, 2110, 2110                                      ERTS0630
 2110 MY=1                                                              ERTS0631
 2120 DO2150 I=MY,N,12                                                  ERTS0632
 2130 PAF(I+36)=(ERC(I)+2.*ERC(I+12)+3.*ERC(I+24)                       ERTS0633
     1+3.*ERC(I+36)+3.*ERC(I+48)+2.*ERC(I+60)+ERC(I+72))/15.            ERTS0634
 2140 IF(N-(I+84)) 2160, 2150, 2150                                     ERTS0635
 2150 CONTINUE                                                          ERTS0636
 2160 PAF(MY)=(6.*ERC(MY)+6.*ERC(MY+12)+2.*ERC(MY+24)+                  ERTS0637
     1ERC(MY+36))/15.                                                   ERTS0638
 2170 PAF(MY+12)=(9.*ERC(MY)+9.*ERC(MY+12)+6.*ERC(MY+24)                ERTS0639
     1+4.*ERC(MY+36)+2.*ERC(MY+48))/30.                                 ERTS0640
 2180 PAF(MY+24)=(5.*ERC(MY)+7.*ERC(MY+12)+6.*ERC(MY+24)                ERTS0641
     1+6.*ERC(MY+36)+4.*ERC(MY+48)+2.*ERC(MY+60))/30.                   ERTS0642
 2190 PAF(I+48)=(5.*ERC(I+72)+7.*ERC(I+60)+6.*ERC(I+48)+                ERTS0643
     16.*ERC(I+36)+4.*ERC(I+24)+2.*ERC(I+12))/30.                       ERTS0644
 2200 PAF(I+60)=(9.*ERC(I+72)+9.*ERC(I+60)+6.*ERC(I+48)                 ERTS0645
     1+4.*ERC(I+36)+2.*ERC(I+24))/30.                                   ERTS0646
 2210 PAF(I+72)=(6.*ERC(I+72)+6.*ERC(I+60)+2.*ERC                       ERTS0647
     1(I+48)+ERC(I+36))/15.                                             ERTS0648
 2220 PAF(I+84)=(3.*PAF(I+72)-PAF(I+60))/2.                             ERTS0649
 2230 IF(MY-12) 2240,2260,2260                                          ERTS0650
 2240 MY=MY+1                                                           ERTS0651
 2250 GO TO 2120                                                        ERTS0652
 2260 KK = 12                                                           ERTS0653
 2265 LR (LY+1) = LR (LY) + 1                                           ERTS0654
 2270 IF(K(12)-12)2300,2280,2300                                        ERTS0655
 2280 NOPTS = N + 12                                                    ERTS0656
 2282 NOBLK = 0                                                         ERTS0657
 2284 DO 2286 I = 1, NOPTS                                              ERTS0658
 2286 RESULT (I) = PAF (I)                                              ERTS0659
 2288 CALL PRINT                                                        ERTS0660
C                                                                       ERTS0661
C     TABLE 13 FINAL SEASONALLY ADJUSTED SERIES (CI SERIES)             ERTS0662
 2300 DO2320 I=1,N                                                      ERTS0663
 2320 PAS(I)=X(I)/PAF(I)*100.0                                          ERTS0664
 2325 KK = 13                                                           ERTS0665
 2330 IF(K(13)-13)2355,2340,2355                                        ERTS0666
 2340 NOPTS = N                                                         ERTS0667
 2342 NOBLK = 0                                                         ERTS0668
 2344 DO 2346 I = 1, NOPTS                                              ERTS0669
 2346 RESULT (I) = PAS(I)                                               ERTS0670
 2348 CALL PRINT                                                        ERTS0671
 2355 MSW(1) = 1                                                        ERTS0672
 2360 RETURN                                                            ERTS0673
       END                                                              ERTS0674
      SUBROUTINE T1418                                                  ERTS0675
C                                                                       ERTS0676
      DIMENSION   LR(50), X(372), K(50), RA(372), A(372), OMA(372),     ERTS0677
     1            CMA(372), ROC(372), B(372), UCL(372), BCL(372),       ERTS0678
     2            ERC(372), PAF(372), PAS(372), WMA(372), BTM(384),     ERTS0679
     3            STA(372), STS(372), TOC(372), TGP(372), RESULT(400),  ERTS0680
     4            DDA(400), XPRED(40), TRDCYL(40), RSUM(10), V(5),      ERTS0681
     5            CFDEG1(4), CFDEG2(4), CFDEG3(4), BB(5,5), MSW(10),    ERTS0682
     6            SPARE(100)                                            ERTS0683
C                                                                       ERTS0684
      COMMON  LR, X, K, RA, A, OMA, CMA, ROC, B, UCL, BCL, ERC, PAF,    ERTS0685
     1        PAS, WMA, BTM, STA, STS, TOC, TGP, RESULT, DDA,           ERTS0686
     2        XPRED, TRDCYL, RSUM, V, CFDEG1, CFDEG2, CFDEG3, BB, MSW,  ERTS0687
     3        KC, KODE, LFSTYR, N, NFSTYR, NDDA, SIGMA, K33, LLSTYR,    ERTS0688
     4        NP1, NP7, NP8, NP12, NP14, N1, N5, N11, N12, KK, NOPTS,   ERTS0689
     5        NOBLK, KDAY, KMO, KYR, KPAGE, NPAGE, SPARE, LY            ERTS0690
C                                                                       ERTS0691
C                                                                       ERTS0692
C     TABLE 14 RATIOS OF CI TO AVERAGE OF PRECEDING AND FOLLOWING VALUESERTS0693
 2405 DO2410 I=2,N1                                                     ERTS0694
 2410 RA(I)=(2.*PAS(I))/(PAS(I-1)+PAS(I+1))*100.0                       ERTS0695
 2420 KK = 14                                                           ERTS0696
 2430 IF(K(14)-14)2800,2440,2800                                        ERTS0697
 2440 NOPTS = N - 2                                                     ERTS0698
 2442 NOBLK = 1                                                         ERTS0699
 2444 DO 2446 I = 1, NOPTS                                              ERTS0700
 2446 RESULT(I+1) = RA(I+1)                                             ERTS0701
 2448 CALL PRINT                                                        ERTS0702
C                                                                       ERTS0703
C     MONTHLY ARITHMETIC MEANS OF ABOVE RATIOS                          ERTS0704
 2500 RA(1) = 0.0                                                       ERTS0705
 2550 MY = 1                                                            ERTS0706
 2580 SUM = 0.                                                          ERTS0707
 2590 DO2620 I=MY,N,12                                                  ERTS0708
 2600 SUM=SUM+RA(I)                                                     ERTS0709
 2610 IF(RA(I+12))2630,2630,2620                                        ERTS0710
 2620 CONTINUE                                                          ERTS0711
 2630 DN=((I-MY)/12)+1                                                  ERTS0712
 2632 IF(MY-1) 2634, 2634, 2640                                         ERTS0713
 2634 DN = DN - 1.0                                                     ERTS0714
 2640 STA(MY)=SUM/DN                                                    ERTS0715
 2650 IF(MY-12)2660,3300, 3300                                          ERTS0716
 2660 MY=MY+1                                                           ERTS0717
 2670 GO TO 2580                                                        ERTS0718
C                                                                       ERTS0719
C     TABLE 15 12-MONTH MOVING AVERAGE OF CI                            ERTS0720
 2800 A(1)=0.                                                           ERTS0721
 2810 DO2820 I=1,12                                                     ERTS0722
 2820 A(1)=A(1)+PAS(I)                                                  ERTS0723
 2840 DO2850 I=2,N11                                                    ERTS0724
 2850 A(I)=A(I-1)-PAS(I-1)+PAS(I+11)                                    ERTS0725
 2860 DO2870 I=1,N11                                                    ERTS0726
C     TEMPORARY STORAGE OF OMA OF ORIGINAL SERIES IN CMA AREA           ERTS0727
 2865 CMA(I) = OMA(I)                                                   ERTS0728
 2870 OMA(I)=A(I)/12.                                                   ERTS0729
 2875 KK = 15                                                           ERTS0730
 2880 IF(K(15)-15)2905,2882,2905                                        ERTS0731
 2882 NOPTS = N - 11                                                    ERTS0732
 2884 NOBLK = 5                                                         ERTS0733
 2886 DO 2888 I = 1, NOPTS                                              ERTS0734
 2888 RESULT (I+5) = OMA(I)                                             ERTS0735
 2890 CALL PRINT                                                        ERTS0736
C                                                                       ERTS0737
C     TABLE 16 RATIO OF 12-MONTH MOVING AVERAGES, FINAL SEASONALLY ADJUSERTS0738
C              TED SERIES TO ORIGINAL                                   ERTS0739
 2905 DO2910 I=1,N11                                                    ERTS0740
 2910 ROC(I)=(OMA(I)/CMA(I))*100.                                       ERTS0741
 2915 KK = 16                                                           ERTS0742
 2920 IF(K(16)-16)3000,2930,3000                                        ERTS0743
 2930 NOPTS = N - 11                                                    ERTS0744
 2932 NOBLK = 5                                                         ERTS0745
 2934 DO 2936 I = 1, NOPTS                                              ERTS0746
 2936 RESULT (I+5) = ROC (I)                                            ERTS0747
 2938 CALL PRINT                                                        ERTS0748
C                                                                       ERTS0749
C     TABLE 17 RATIOS OF FOLLOWING 12 MONTHS TO PRECEDING JANUARY, FINALERTS0750
C              SEASONALLY ADJUSTED SERIES                               ERTS0751
 3000 JA=2                                                              ERTS0752
 3010 JB=13                                                             ERTS0753
 3020 DO3030 I=JA,JB                                                    ERTS0754
 3030 ROC(I)=(PAS(I)/PAS(JA-1))*100.                                    ERTS0755
 3040 IF(JB-N)3050,3095,3095                                            ERTS0756
 3050 JA=JA+12                                                          ERTS0757
 3060 JB=JB+12                                                          ERTS0758
 3070 IF(JB-N)3020,3020,3080                                            ERTS0759
 3080 JB=N                                                              ERTS0760
 3090 GO TO 3020                                                        ERTS0761
 3095 KK = 17                                                           ERTS0762
 3096 IF(K(17)-17)3110,3097,3110                                        ERTS0763
 3097 NOPTS = N - 1                                                     ERTS0764
 3098 NOBLK = 1                                                         ERTS0765
 3100 DO 3102 I = 1, NOPTS                                              ERTS0766
 3102 RESULT (I+1) = ROC (I+1)                                          ERTS0767
 3103 CALL PRINT                                                        ERTS0768
C                                                                       ERTS0769
C     TABLE 18 WEIGHTED 15-MONTH MOVING AVERAGE OF FINAL SEASONALLY     ERTS0770
C              ADJUSTED SERIES                                          ERTS0771
 3110 DO 3120 I=1,7                                                     ERTS0772
 3120 BTM(I)=(PAS(1)+PAS(2)+PAS(3)+PAS(4))/4.                           ERTS0773
 3160 DO3170 I=NP8,NP14                                                 ERTS0774
 3170 BTM(I)=(PAS(N-3)+PAS(N-2)+PAS(N-1)+PAS(N))/4.                     ERTS0775
 3180 DO3190 I=8,NP7                                                    ERTS0776
 3190 BTM(I)=PAS(I-7)                                                   ERTS0777
 3200 DO3210 I=1,N                                                      ERTS0778
 3210 WMA(I)=(-3.*BTM(I)-6.*BTM(I+1)-5.*BTM(I+2)+3.*                    ERTS0779
     1BTM(I+3)+21.*BTM(I+4)+46.*BTM(I+5)+67.*BTM(I+6)+                  ERTS0780
     274.*BTM(I+7)+67.*BTM(I+8)+46.*BTM(I+9)+21.*                       ERTS0781
     3BTM(I+10)+3.*BTM(I+11)-5.*BTM(I+12)-6.*BTM(I+13)-                 ERTS0782
     43.*BTM(I+14))/320.                                                ERTS0783
 3215 KK = 18                                                           ERTS0784
 3220 IF(K(18)-18)3350,3230,3350                                        ERTS0785
 3230 NOPTS = N                                                         ERTS0786
 3232 NOBLK = 0                                                         ERTS0787
 3234 DO 3236 I = 1, NOPTS                                              ERTS0788
 3236 RESULT (I) = WMA (I)                                              ERTS0789
 3238 CALL PRINT                                                        ERTS0790
 3240 GO TO 3350                                                        ERTS0791
 3300 WRITE OUTPUT TAPE 6, 7400, (STA(I),I=1,12)                        ERTS0792
 3310 GO TO 2800                                                        ERTS0793
 3350 MSW(1) = 1                                                        ERTS0794
 3360 RETURN                                                            ERTS0795
C                                                                       ERTS0796
C        F O R M A T S                                                  ERTS0797
C                                                                       ERTS0798
 7400 FORMAT(20H0           AVERAGES//F15.1,11F9.1)                     ERTS0799
       END                                                              ERTS0800
      SUBROUTINE T1925                                                  ERTS0801
C                                                                       ERTS0802
      DIMENSION   LR(50), X(372), K(50), RA(372), A(372), OMA(372),     ERTS0803
     1            CMA(372), ROC(372), B(372), UCL(372), BCL(372),       ERTS0804
     2            ERC(372), PAF(372), PAS(372), WMA(372), BTM(384),     ERTS0805
