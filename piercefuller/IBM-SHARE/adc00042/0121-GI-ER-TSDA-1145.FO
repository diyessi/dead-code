 4050 C=SUM/XN1                                                         ERTS0910
 4060 D=C                                                               ERTS0911
 4065 KK = 25                                                           ERTS0912
 4070 IF(K(25)-25 )4100,4072,4100                                       ERTS0913
 4072 NOPTS = N - 1                                                     ERTS0914
 4074 NOBLK = 1                                                         ERTS0915
 4076 DO 4078 I = 1, NOPTS                                              ERTS0916
