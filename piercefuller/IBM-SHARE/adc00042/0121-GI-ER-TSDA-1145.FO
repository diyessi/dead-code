 4080 CALL PRINT                                                        ERTS0918
 4100 MSW(1) = 1                                                        ERTS0919
 4110 RETURN                                                            ERTS0920
C                                                                       ERTS0921
       END                                                              ERTS0922
      SUBROUTINE T2628                                                  ERTS0923
