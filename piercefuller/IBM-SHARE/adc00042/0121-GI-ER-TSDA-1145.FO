 4110 X(1) = RTOC                                                       ERTS0946
 4120 RTOS=R/S                                                          ERTS0947
 4130 STOC=S/C                                                          ERTS0948
 4140 RTOO=R/O                                                          ERTS0949
 4150 CTOO=C/O                                                          ERTS0950
 4160 STOO=S/O                                                          ERTS0951
 4170 DO4320 J=2,5                                                      ERTS0952
 4180 NJ=N-J                                                            ERTS0953
 4190 SUM=0.                                                            ERTS0954
 4200 SUMS=0.                                                           ERTS0955
 4210 DO 4280 I=1,NJ                                                    ERTS0956
 4220 LKC=I+J                                                           ERTS0957
 4270 SUMS = SUMS + ABSF((ERC(LKC)/ERC(I)-1.0)*100.0)                   ERTS0958
 4280 SUM = SUM + ABSF((WMA(LKC)/WMA(I)-1.0)*100.0)                     ERTS0959
 4320 X(J) = SUMS/SUM                                                   ERTS0960
 4330 DO4400 I=1,5                                                      ERTS0961
 4340 CMA(I) = X(I)                                                     ERTS0962
 4350 X(I) = X(I) - 1.0                                                 ERTS0963
 4360 IF( X(I) )4370,4370,4390                                          ERTS0964
 4370 BCL(I) = X(I)                                                     ERTS0965
 4380 GO TO 4400                                                        ERTS0966
 4390 BCL(I) = X(I) - 50.0                                              ERTS0967
 4400 CONTINUE                                                          ERTS0968
 4410 SMALL=BCL(1)                                                      ERTS0969
 4420 MCD=1                                                             ERTS0970
 4430 DO4470 I=2,5                                                      ERTS0971
 4440 IF(SMALL-BCL(I))4450,4470,4470                                    ERTS0972
 4450 SMALL=BCL(I)                                                      ERTS0973
 4460 MCD=I                                                             ERTS0974
 4470 CONTINUE                                                          ERTS0975
 4472 IF(1.0-CMA(5)) 4474, 4474, 4480                                   ERTS0976
 4474 MCD = 0                                                           ERTS0977
 4476 MCD1 = 6                                                          ERTS0978
 4478 GO TO 4484                                                        ERTS0979
