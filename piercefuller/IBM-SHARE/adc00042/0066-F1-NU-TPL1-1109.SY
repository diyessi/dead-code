C  NU TPL1 QUASI-TRIDIAGONAL MATRIX ROUTINE 001-265                          001
C     CONTAINS 265 FORTRAN SOURCE LANGUAGE CARDS INCLUDING SUBROUTINES  TPL1 002
      DIMENSION AM(80,80),B(80,80),D(80,80),E(80,80),                   TPL1 003
     XC(80),G(80),Y(80),IPQ(100)                                        TPL1 004
      COMMON AM,B,C,IPQ                                                 TPL1 005
      EQUIVALENCE(AM,D),(B,E),(C,G,Y)                                   TPL1 006
      READ 46,IMQ                                                       TPL1 007
      READ 47,(IPQ(I),I=1,IMQ)                                          TPL1 008
      CALL  EFM                                                         TPL1 009
      K0=0                                                              TPL1 010
      K1=1                                                              TPL1 011
      CALL FORM A1(K1,K2,K3)                                            TPL1 012
      GO TO 2                                                           TPL1 013
    1 K1=K1+1                                                           TPL1 014
      CALL FORMA(K1,K2,K3)                                              TPL1 015
    2 CALL INVERT(AM,B,K3)                                              TPL1 016
      WRITE TAPE 6,((B(I,J),I=1,K3),J=1,K3)                             TPL1 017
    4 IF(SENSE SWITCH 6)18,5                                            TPL1 018
   18 PRINT 65,K1                                                       TPL1 019
      GO TO 22                                                          TPL1 020
    5 IF(K1-IMQ)1,6,1                                                   TPL1 021
    6 K0=1                                                              TPL1 022
   19 PRINT 42                                                          TPL1 023
      GO TO 22                                                          TPL1 024
   16 K1=1                                                              TPL1 025
      CALL FORM Y1(K1,K2,K3)                                            TPL1 026
      WRITE TAPE 7,(G(I),I=1,K2)                                        TPL1 027
    7 K1=K1+1                                                           TPL1 028
      CALL FORM Y(K1,K2,K3)                                             TPL1 029
      WRITE TAPE 7,(G(I),I=1,K3)                                        TPL1 030
    8 IF(K1-IMQ)7,9,7                                                   TPL1 031
    9 K0=K0+1                                                           TPL1 032
   20 PRINT 43                                                          TPL1 033
      GO TO 22                                                          TPL1 034
   29 M=IMQ+1                                                           TPL1 035
      CALL FORM VL(K3,IMQ)                                              TPL1 036
      GO TO 17                                                          TPL1 037
   10 K0=K0+1                                                           TPL1 038
      K1=K1-1                                                           TPL1 039
      CALL FORM V(K1,K2,K3,K4,IMQ)                                      TPL1 040
   17 CALL ENDV(K3)                                                     TPL1 041
      M=M-1                                                             TPL1 042
      CALL OUTPUT(K3,M)                                                 TPL1 043
   14 IF(K1-1)10,21,10                                                  TPL1 044
   21 PRINT 44                                                          TPL1 045
   40 STOP 40                                                           TPL1 046
   22 CALL DUMP                                                         TPL1 047
      IF(SENSE SWITCH 5)24,23                                           TPL1 048
   23 IF(K0-1)5,16,29                                                   TPL1 049
   24 CALL RERUN(K0,K1,IMQ)                                             TPL1 050
      GO TO 23                                                          TPL1 051
 42   FORMAT( 31H END PART I. A INVERSE FORMED. )                               
 43   FORMAT (25H END PART 2. Y ON TAPE 7.)                             TPL1 053
 44   FORMAT( 28H FINISHED ANSWERS ON TAPE 5.)                          TPL1 054
 65   FORMAT( 22H DUMPED AT A INVERSE  I3)                              TPL1 055
   46 FORMAT(1I3)                                                       TPL1 056
   47 FORMAT(24I3)                                                      TPL1 057
      END(2,2,2,2,2)                                                            
      SUBROUTINE FORM A1(K1,K2,K3)                                      TPL1 059
      DIMENSION AM(80,80),B(80,80),D(80,80),E(80,80),                   TPL1 060
     XC(80),G(80),Y(80),IPQ(100)                                        TPL1 061
      COMMON AM,B,C,IPQ                                                 TPL1 062
      EQUIVALENCE(AM,D),(B,E),(C,G,Y)                                   TPL1 063
      K2=IPQ(K1)                                                        TPL1 064
      K3=K2                                                             TPL1 065
      READ TAPE 2,((AM(J,K),J=1,K2),K=1,K2)                             TPL1 066
      RETURN                                                            TPL1 067
      END(2,2,2,2,2)                                                            
      SUBROUTINE FORM A(K1,K2,K3)                                       TPL1 069
      DIMENSION AM(80,80),B(80,80),D(80,80),E(80,80),                   TPL1 070
     XC(80),G(80),Y(80),IPQ(100)                                        TPL1 071
      COMMON AM,B,C,IPQ                                                 TPL1 072
      EQUIVALENCE(AM,D),(B,E),(C,G,Y)                                   TPL1 073
      K2=K3                                                             TPL1 074
      K3=IPQ(K1)                                                        TPL1 075
      READ TAPE 3,((D(J,K),J=1,K3),K=1,K2)                              TPL1 076
      CALL MPY(K2,K3,K2)                                                TPL1 077
      READ TAPE 4,((E(J,K),J=1,K2),K=1,K3)                              TPL1 078
      CALL MPY(K2,K3,K3)                                                TPL1 079
      DO 2 I=1,K3                                                       TPL1 080
      DO 2 J=1,K3                                                       TPL1 081
    2 B(I,J)=D(I,J)                                                     TPL1 082
      READ TAPE 2,((AM(J,K),J=1,K3),K=1,K3)                             TPL1 083
      DO 3 I=1,K3                                                       TPL1 084
      DO 3 J=1,K3                                                       TPL1 085
    3 AM(I,J)=AM(I,J)-B(I,J)                                            TPL1 086
      RETURN                                                            TPL1 087
      END(2,2,2,2,2)                                                            
      SUBROUTINE MPY(K2,K3,KK)                                          TPL1 089
      DIMENSION AM(80,80),B(80,80),D(80,80),E(80,80),                   TPL1 090
     XC(80),G(80),Y(80),IPQ(100)                                        TPL1 091
      COMMON AM,B,C,IPQ                                                 TPL1 092
      EQUIVALENCE(AM,D),(B,E),(C,G,Y)                                   TPL1 093
      DO 4  I=1,K3                                                      TPL1 094
      DO 2  J=1,KK                                                      TPL1 095
      C(J)=0.0                                                          TPL1 096
      DO 2  K=1,K2                                                      TPL1 097
      IF (D(I,K)) 1,2,1                                                 TPL1 098
 1    IF (E(K,J)) 3,2,3                                                 TPL1 099
    3 C(J)=D(I,K)*B(K,J)+C(J)                                           TPL1 100
 2    CONTINUE                                                          TPL1 101
      DO 4  J=1,KK                                                      TPL1 102
    4 D(I,J)=C(J)                                                       TPL1 103
      RETURN                                                            TPL1 104
            END(2,2,2,2,2)                                                      
      SUBROUTINE INVERT (A,B,N)                                         TPL1 106
      DIMENSION A(80,80),B(80,80)                                       TPL1 107
      COMMON  A,B                                                       TPL1 108
      DO 1 I=1,N                                                        TPL1 109
      DO 1 J=1,N                                                        TPL1 110
      IF(I-J)2,3,2                                                      TPL1 111
 2    B(I,J)=0                                                          TPL1 112
      GO TO 1                                                           TPL1 113
 3    B(I,J)=1.0                                                        TPL1 114
 1    CONTINUE                                                          TPL1 115
      LA=XLOCF(A(1,1))                                                  TPL1 116
      LB=XLOCF(B(1,1))                                                  TPL1 117
      IA=LA-XLOCF(A(1,2))                                               TPL1 118
      IB=LB-XLOCF(B(1,2))                                               TPL1 119
      DUMMY=LEQF(LA,LB,N,N,IA,IB)                                       TPL1 120
      RETURN                                                            TPL1 121
      END(2,2,2,2,2)                                                            
      SUBROUTINE FORM Y1(K1,K2,K3)                                      TPL1 123
      DIMENSION AM(80,80),B(80,80),D(80,80),E(80,80),                   TPL1 124
     XC(80),G(80),Y(80),IPQ(100)                                        TPL1 125
      COMMON AM,B,C,IPQ                                                 TPL1 126
      EQUIVALENCE(AM,D),(B,E),(C,G,Y)                                   TPL1 127
      REWIND 6                                                          TPL1 128
      REWIND 3                                                          TPL1 129
      K2=IPQ(K1)                                                        TPL1 130
      K3=K2                                                             TPL1 131
      READ TAPE 5,(G(I),I=1,K2)                                         TPL1 132
      RETURN                                                            TPL1 133
      END(2,2,2,2,2)                                                            
      SUBROUTINE FORM Y(K1,K2,K3)                                       TPL1 135
      DIMENSION AM(80,80),B(80,80),D(80,80),E(80,80),                   TPL1 136
     XC(80),G(80),Y(80),IPQ(100)                                        TPL1 137
      COMMON AM,B,C,IPQ                                                 TPL1 138
      EQUIVALENCE(AM,D),(B,E),(C,G,Y)                                   TPL1 139
 7    K2=K3                                                             TPL1 140
      K3=IPQ(K1)                                                        TPL1 141
      READ TAPE 3,((D(J,K),J=1,K3),K=1,K2)                              TPL1 142
      READ TAPE 6,((B(J,K),J=1,K2),K=1,K2)                              TPL1 143
      CALL MPY  (K2,K3,K2)                                              TPL1 144
      BACKSPACE 7                                                       TPL1 145
      READ TAPE 7,(G(I),I=1,K2)                                         TPL1 146
 51   DO 53  I=1,K3                                                     TPL1 147
      B(1,I)=0.0                                                        TPL1 148
      DO 53  K=1,K2                                                     TPL1 149
      IF (D(I,K)) 52,53,52                                              TPL1 150
   52 B(1,I)=D(I,K)*G(K)+B(1,I)                                         TPL1 151
 53   CONTINUE                                                          TPL1 152
      READ TAPE 5,(D(1,I),I=1,K3)                                       TPL1 153
      DO 54  I=1,K3                                                     TPL1 154
   54 G(I)=D(1,I)-B(1,I)                                                TPL1 155
      RETURN                                                            TPL1 156
      END(2,2,2,2,2)                                                            
      SUBROUTINE FORM VL(K3,IMQ)                                        TPL1 158
      DIMENSION AM(80,80),B(80,80),D(80,80),E(80,80),                   TPL1 159
     XC(80),G(80),Y(80),IPQ(100)                                        TPL1 160
      COMMON AM,B,C,IPQ                                                 TPL1 161
      EQUIVALENCE(AM,D),(B,E),(C,G,Y)                                   TPL1 162
 99   READ TAPE 6                                                       TPL1 163
 100  REWIND 2                                                          TPL1 164
      REWIND 3                                                          TPL1 165
      REWIND 5                                                          TPL1 166
      K3=IPQ(IMQ)                                                       TPL1 167
      BACKSPACE 7                                                       TPL1 168
      BACKSPACE 6                                                       TPL1 169
      READ TAPE 7,(Y(I),I=1,K3)                                         TPL1 170
      READ TAPE 6,((AM(J,K),J=1,K3),K=1,K3)                             TPL1 171
      RETURN                                                            TPL1 172
      END(2,2,2,2,2)                                                            
      SUBROUTINE FORM V(K1,K2,K3,K4,IMQ)                                TPL1 174
      DIMENSION AM(80,80),B(80,80),D(80,80),E(80,80),                   TPL1 175
     XC(80),G(80),Y(80),IPQ(100)                                        TPL1 176
      COMMON AM,B,C,IPQ                                                 TPL1 177
      EQUIVALENCE(AM,D),(B,E),(C,G,Y)                                   TPL1 178
      K4=K3                                                             TPL1 179
      K3=IPQ(K1)                                                        TPL1 180
      K2=2                                                              TPL1 181
      DO 11   I=1,K2                                                    TPL1 182
      BACKSPACE 7                                                       TPL1 183
 11   BACKSPACE 6                                                       TPL1 184
      IF (K1-(IMQ-1))16,17,16                                           TPL1 185
 16   BACKSPACE 4                                                       TPL1 186
 17   BACKSPACE 4                                                       TPL1 187
 13   READ TAPE 4,((D(J,K),J=1,K3),K=1,K4)                              TPL1 188
 55   DO 57  I=1,K3                                                     TPL1 189
      C(I)=0.0                                                          TPL1 190
      DO 57  K=1,K4                                                     TPL1 191
      IF (  D(I,K)) 56,57,56                                            TPL1 192
   56 C(I)=D(I,K)*B(1,K)+C(I)                                           TPL1 193
 57   CONTINUE                                                          TPL1 194
      READ TAPE 7,  (AM(1,I),I=1,K3)                                    TPL1 195
      DO 58  I=1,K3                                                     TPL1 196
   58 Y(I)=AM(1,I)-C(I)                                                 TPL1 197
      READ TAPE 6,((AM(I,K),I=1,K3),K=1,K3)                             TPL1 198
      RETURN                                                            TPL1 199
      END(2,2,2,2,2)                                                            
      SUBROUTINE ENDV(K3)                                               TPL1 201
      DIMENSION AM(80,80),B(80,80),D(80,80),E(80,80),                   TPL1 202
     XC(80),G(80),Y(80),IPQ(100)                                        TPL1 203
      COMMON AM,B,C,IPQ                                                 TPL1 204
      EQUIVALENCE(AM,D),(B,E),(C,G,Y)                                   TPL1 205
 59   DO 61  I=1,K3                                                     TPL1 206
      B(1,I)=0.0                                                        TPL1 207
      DO 61  K=1,K3                                                     TPL1 208
      IF (AM(I,K))  60,61,60                                            TPL1 209
   60 B(1,I)=AM(I,K)*Y(K)+B(1,I)                                        TPL1 210
 61   CONTINUE                                                          TPL1 211
      RETURN                                                            TPL1 212
      END(2,2,2,2,2)                                                            
      SUBROUTINE  OUTPUT(K3,M)                                          TPL1 214
      DIMENSION AM(80,80),B(80,80),D(80,80),E(80,80),                   TPL1 215
     XC(80),G(80),Y(80),IPQ(100)                                        TPL1 216
      COMMON AM,B,C,IPQ                                                 TPL1 217
      EQUIVALENCE(AM,D),(B,E),(C,G,Y)                                   TPL1 218
      WRITE     OUTPUT TAPE 5,64,(M,(I,B(1,I),I=1,K3))                  TPL1 219
      IF (SENSE SWITCH 3)  62,14                                        TPL1 220
 62   PRINT 64,(M,(I,B(1,I),I=1,K3))                                    TPL1 221
 64   FORMAT(4H1V  I4/(1H I4,1H=1PE14.7,1H I4,1H=1PE14.7))              TPL1 222
   14 RETURN                                                            TPL1 223
      END(2,2,2,2,2)                                                            
      SUBROUTINE DUMP                                                   TPL1 225
      YI=SOSF(1)                                                        TPL1 226
      RETURN                                                            TPL1 227
      END(2,2,2,2,2)                                                            
      SUBROUTINE RERUN(K0,K1,IMQ)                                       TPL1 229
      REWIND 2                                                          TPL1 230
      REWIND 3                                                          TPL1 231
      REWIND 4                                                          TPL1 232
      REWIND 5                                                          TPL1 233
      REWIND 6                                                          TPL1 234
      REWIND 7                                                          TPL1 235
      PRINT 45                                                          TPL1 236
 45   FORMAT(47H IF S.S.5 USED FOR GETTING OFF NOW IS THE TIME./66H IF STPL1 237
     X.S.5 USED FOR RERUN PURPOSE SET S.S.5 UP AND HIT START BUTTON)    TPL1 238
      PAUSE 24                                                          TPL1 239
      IF(K0-1)25,37,34                                                  TPL1 240
 25   IF (K1-2) 26,28,29                                                TPL1 241
 26   DO 27  I=1,K1                                                     TPL1 242
      READ TAPE 2                                                       TPL1 243
 27   READ TAPE 6                                                       TPL1 244
      GO TO 39                                                          TPL1 245
 28   READ TAPE 3                                                       TPL1 246
      READ  TAPE 4                                                      TPL1 247
      GO TO 26                                                          TPL1 248
 29   K=K1-1                                                            TPL1 249
      DO 30  I=1,K                                                      TPL1 250
      READ TAPE 3                                                       TPL1 251
 30   READ TAPE 4                                                       TPL1 252
      GO TO 26                                                          TPL1 253
 34   DO 35  K=1,IMQ                                                    TPL1 254
 35   READ TAPE 7                                                       TPL1 255
      K=IMQ-1                                                           TPL1 256
      DO 36  I=1,K                                                      TPL1 257
      READ TAPE 4                                                       TPL1 258
 36   READ TAPE 6                                                       TPL1 259
      GO TO 39                                                          TPL1 260
 37   K=IMQ-1                                                           TPL1 261
      DO 38  I=1,K                                                      TPL1 262
 38   READ TAPE 4                                                       TPL1 263
   39 RETURN                                                            TPL1 264
      END(2,2,2,2,2)                                                            
