*     LIST                                                              EOBESL01
      SUBROUTINE BESSEL(A1,B1,X1,Y1,BR,BI,DBR,DBI,NTBS)                 EOBESL02
      DIMENSION US(2),VS(2),USD(2),VSD(2)                               EOBESL03
      X12=X1**2                                                         EOBESL04
      Y12=Y1**2                                                         EOBESL05
      R12=X12+Y12                                                       EOBESL06
      R1=SQRTF(R12)                                                     EOBESL07
      RZ=R1-8.                                                          EOBESL08
      ITEST=0                                                           EOBESL09
   21 IT=30                                                             EOBESL10
      US(1)=1.                                                          EOBESL11
      VS(1)=0.                                                          EOBESL12
      UT=1.                                                             EOBESL13
      VT=0.                                                             EOBESL14
    5 FORMAT(36H LAST CONTRIBUTION TO BESSEL SERIES=E11.3)              EOBESL15
      IF(RZ)12,12,13                                                    EOBESL16
   12 X2=X12-Y12                                                        EOBESL17
      Y2=2.*X1*Y1                                                       EOBESL18
      USD(1)=A1+0.5                                                     EOBESL19
      VSD(1)=B1                                                         EOBESL20
      GO TO 31                                                          EOBESL21
   13 US(2)=0.                                                          EOBESL22
      VS(2)=0.                                                          EOBESL23
      USD(1)=0.                                                         EOBESL24
      VSD(1)=0.                                                         EOBESL25
      USD(2)=0.                                                         EOBESL26
      VSD(2)=0.                                                         EOBESL27
      CU1=(A1-B1)*(A1+B1)                                               EOBESL28
      CV1=2.*A1*B1                                                      EOBESL29
      NTBSMP=1.6*R1                                                     EOBESL30
      IF(NTBSMP-NTBSM)30,31,31                                          EOBESL31
   30 IT=NTBSMP                                                         EOBESL32
   31 DO 3 I=2,IT                                                       EOBESL33
      NTBS=I                                                            EOBESL34
      FI=FLOATF(I-1)                                                    EOBESL35
      IF(RZ)14,14,15                                                    EOBESL36
   14 A1P=A1+FI                                                         EOBESL37
      C1=-4.*(A1P**2+B1**2)*FI                                          EOBESL38
      UTP=(UT*A1P+VT*B1)/C1                                             EOBESL39
      VTP=(VT*A1P-UT*B1)/C1                                             EOBESL40
      UT=UTP*X2-VTP*Y2                                                  EOBESL41
      VT=UTP*Y2+VTP*X2                                                  EOBESL42
      A1D=A1P+FI+0.5                                                    EOBESL43
      UTD=A1D*UT-B1*VT                                                  EOBESL44
      VTD=A1D*VT+B1*UT                                                  EOBESL45
      J=1                                                               EOBESL46
      GO TO 10                                                          EOBESL47
   15 X4=0.5*(-1.)**I                                                   EOBESL48
      C1=X4/R12                                                         EOBESL49
      CU2=C1*(FI-1.+(0.25-CU1)/FI)                                      EOBESL50
      CV2=C1*CV1/FI                                                     EOBESL51
      UTP=CU2*UT+CV2*VT                                                 EOBESL52
      VTP=CU2*VT-CV2*UT                                                 EOBESL53
      UT=UTP*X1+VTP*Y1                                                  EOBESL54
      VT=VTP*X1-UTP*Y1                                                  EOBESL55
      CD1=-FI/R12                                                       EOBESL56
      CDU=CD1*X1                                                        EOBESL57
      CDV=CD1*Y1                                                        EOBESL58
      UTD=UT*CDU+VT*CDV                                                 EOBESL59
      VTD=VT*CDU-UT*CDV                                                 EOBESL60
      J=1.6+X4                                                          EOBESL61
   10 US(J)=US(J)+UT                                                    EOBESL62
      VS(J)=VS(J)+VT                                                    EOBESL63
      USD(J)=USD(J)+UTD                                                 EOBESL64
      VSD(J)=VSD(J)+VTD                                                 EOBESL65
      ST=ABSF(UT/US(J))+ABSF(VT/VS(J))+ABSF(UTD/USD(J))+ABSF(VTD/VSD(J))EOBESL66
      IF(ST-0.000001)20,20,3                                            EOBESL67
    3 CONTINUE                                                          EOBESL68
      IF(ITEST)18,19,18                                                 EOBESL69
   19 ITEST=1                                                           EOBESL70
      RZ=RZ-7.                                                          EOBESL71
      GO TO 21                                                          EOBESL72
   18 WRITE OUTPUT TAPE 3,5,ST                                          EOBESL73
   20 IF(RZ)16,16,17                                                    EOBESL74
   16 CALL GAMMA(A1+1.,B1,GFR,GFI)                                      EOBESL75
      R1P=0.5*R1                                                        EOBESL76
      IF(X1)6,7,4                                                       EOBESL77
    7 TH=1.57079633                                                     EOBESL78
      GO TO 9                                                           EOBESL79
    4 TH=ATANF(ABSF(Y1/X1))                                             EOBESL80
      GO TO 9                                                           EOBESL81
    6 TH=3.14159265-ATANF(ABSF(Y1/X1))                                  EOBESL82
    9 IF(Y1)11,8,8                                                      EOBESL83
   11 TH=-TH                                                            EOBESL84
    8 X4=(A1-0.5)*TH+B1*LOGF(R1P)                                       EOBESL85
      CX4=COSF(X4)                                                      EOBESL86
      SX4=SINF(X4)                                                      EOBESL87
      X5=R1P**(A1-0.5)*EXPF(-TH*B1)/(GFR**2+GFI**2)*0.886226925         EOBESL88
      UXD=(GFR*CX4+GFI*SX4)*X5                                          EOBESL89
      VXD=(GFR*SX4-GFI*CX4)*X5                                          EOBESL90
      UX=UXD*X1-VXD*Y1                                                  EOBESL91
      VX=VXD*X1+UXD*Y1                                                  EOBESL92
      BR=UX*US(1)-VX*VS(1)                                              EOBESL93
      BI=UX*VS(1)+VX*US(1)                                              EOBESL94
      DBR=UXD*USD(1)-VXD*VSD(1)                                         EOBESL95
      DBI=UXD*VSD(1)+VXD*USD(1)                                         EOBESL96
      RETURN                                                            EOBESL97
   17 USD(1)=USD(1)+US(2)                                               EOBESL98
      VSD(1)=VSD(1)+VS(2)                                               EOBESL99
      USD(2)=USD(2)-US(1)                                               EOBES100
      VSD(2)=VSD(2)-VS(1)                                               EOBES101
      UARG=X1-1.57079633*(A1+0.5)                                       EOBES102
      VARG=Y1-1.57079633*B1                                             EOBES103
      E1=EXPF(VARG)                                                     EOBES104
      E2=1./E1                                                          EOBES105
      HC=(E1+E2)/2.                                                     EOBES106
      HS=(E1-E2)/2.                                                     EOBES107
      TC=COSF(UARG)                                                     EOBES108
      TS=SINF(UARG)                                                     EOBES109
      CAU=HC*TC                                                         EOBES110
      CAV=-HS*TS                                                        EOBES111
      SAU=HC*TS                                                         EOBES112
      SAV=HS*TC                                                         EOBES113
      BR=US(1)*CAU-VS(1)*CAV+US(2)*SAU-VS(2)*SAV                        EOBES114
      BI=US(1)*CAV+VS(1)*CAU+US(2)*SAV+VS(2)*SAU                        EOBES115
      DBR=USD(1)*CAU-VSD(1)*CAV+USD(2)*SAU-VSD(2)*SAV                   EOBES116
      DBI=USD(1)*CAV+VSD(1)*CAU+USD(2)*SAV+VSD(2)*SAU                   EOBES117
      RETURN                                                            EOBES118
      END                                                               EOBES119
*     LIST                                                              EOBES120
      SUBROUTINE GAMMA(A1,A2,F1,F2)                                     EOBES121
      DIMENSION S(4)                                                    EOBES122
      F1=1.                                                             EOBES123
      F2=0.                                                             EOBES124
      IF(A)1,2,1                                                        EOBES125
    2 S(1)=1./12.                                                       EOBES126
      S(2)=1./288.                                                      EOBES127
      S(3)=-139./51840.                                                 EOBES128
      S(4)=-571./2488320.                                               EOBES129
      A=SQRTF(2.*3.14159265)                                            EOBES130
    1 IF(A1-10.)3,4,4                                                   EOBES131
    3 C1=A1**2+A2**2                                                    EOBES132
      IF(C1)6,7,6                                                       EOBES133
    6 C2=(F1*A1+F2*A2)/C1                                               EOBES134
      F2=(F2*A1-F1*A2)/C1                                               EOBES135
      F1=C2                                                             EOBES136
      A1=A1+1.                                                          EOBES137
      GO TO 1                                                           EOBES138
    4 C1=A1**2+A2**2                                                    EOBES139
      B1=A1/C1                                                          EOBES140
      B2=-A2/C1                                                         EOBES141
      C1=1.                                                             EOBES142
      C2=0.                                                             EOBES143
      C3=B1                                                             EOBES144
      C4=B2                                                             EOBES145
      DO 5I=1,4                                                         EOBES146
      C1=C1+S(I)*C3                                                     EOBES147
      C2=C2+S(I)*C4                                                     EOBES148
      C5=C3*B1-C4*B2                                                    EOBES149
      C4=C3*B2+C4*B1                                                    EOBES150
    5 C3=C5                                                             EOBES151
      C3=F1*C1-F2*C2                                                    EOBES152
      F2=F1*C2+F2*C1                                                    EOBES153
      F1=C3                                                             EOBES154
      C1=EXPF(-A1)                                                      EOBES155
      C2=COSF(-A2)*C1                                                   EOBES156
      C3=SINF(-A2)*C1                                                   EOBES157
      C4=0.5*LOGF(A1**2+A2**2)                                          EOBES158
      C5=ATANF(A2/A1)                                                   EOBES159
      C6=(A1-0.5)*C4-A2*C5                                              EOBES160
      C7=(A1-0.5)*C5+A2*C4                                              EOBES161
      C1=EXPF(C6)                                                       EOBES162
      C4=COSF(C7)*C1*A                                                  EOBES163
      C5=SINF(C7)*C1*A                                                  EOBES164
      C1=F1*C4-F2*C5                                                    EOBES165
      F2=F1*C5+F2*C4                                                    EOBES166
      F1=C1*C2-F2*C3                                                    EOBES167
      F2=C1*C3+F2*C2                                                    EOBES168
      GO TO 8                                                           EOBES169
    7 WRITE OUTPUT TAPE 3,9                                             EOBES170
    9 FORMAT(///39H GAMMA FUNCTION OF NEG. INTEGER OR ZERO///)          EOBES171
      CALL EXIT                                                         EOBES172
    8 RETURN                                                            EOBES173
      END                                                               EOBES174
