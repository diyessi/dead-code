*DRTR     TV DRTR - DATA REARRANGEMENT AND TRANSFORMATION                       
C          J. W. VINYARD, COMPUTING CENTER, TVA                                 
      DIMENSION X(41),FMT1(12),FMT2(12),NR(200),KR(200),J(200),I(200),C(DRTR0001
     1200),D(200),BCDCC(12),N(200),K(200)                               DRTR0002
      READ 1,KKK                                                        DRTR0003
    1 FORMAT(3I10)                                                      DRTR0004
      DO 1000 KL=1,KKK                                                  DRTR0005
      READ 1,NCC,NRC,NTRC                                               DRTR0006
      IF(NCC) 2000,2000,2001                                            DRTR0007
 2001 DO 10 LJ=1,NCC                                                    DRTR0008
      READ 2,(BCDCC(NN),NN=1,12)                                        DRTR0009
    2 FORMAT(12A6)                                                      DRTR0010
      WRITE OUTPUT TAPE 6,2,(BCDCC(NN),NN=1,12)                         DRTR0011
      PRINT 2,(BCDCC(NN),NN=1,12)                                       DRTR0012
   10 CONTINUE                                                          DRTR0013
 2000 READ 2,(FMT1(NN),NN=1,12),(FMT2(NN),NN=1,12)                      DRTR0014
      READ 1,L,M,L12                                                    DRTR0015
      IF(NRC)30,40,30                                                   DRTR0016
   30 READ 3,(NR(NN),KR(NN),NN=1,NRC)                                   DRTR0017
    3 FORMAT(18I4)                                                      DRTR0018
   40 IF(NTRC)50,60,50                                                  DRTR0019
   50 READ 4,(N(NN),K(NN),J(NN),I(NN),C(NN),D(NN),NN=1,NTRC)            DRTR0020
    4 FORMAT(4I4,2F9.0)                                                 DRTR0021
   60 DO 20 NN=1,M                                                      DRTR0022
      READ INPUT TAPE 5,FMT1,(X(LZ),LZ=1,L)                             DRTR0023
      IF(NRC)61,62,61                                                   DRTR0024
   61 DO 11 LL=1,NRC                                                    DRTR0025
      INR=NR(LL)                                                        DRTR0026
      IKR=KR(LL)                                                        DRTR0027
      X(INR)=X(IKR)                                                     DRTR0028
   11 CONTINUE                                                          DRTR0029
   62 IF(NTRC)71,72,71                                                  DRTR0030
   71 DO 15 LL=1,NTRC                                                   DRTR0031
      IN=N(LL)                                                          DRTR0032
      IK=K(LL)                                                          DRTR0033
      IJ=J(LL)                                                          DRTR0034
      II=I(LL)                                                          DRTR0035
      CC=C(LL)                                                          DRTR0036
      DD=D(LL)                                                          DRTR0037
      GO TO(100,200,300,400,500,600,700,800,900,901),II                 DRTR0038
  100 X(IN)=X(IK)**CC/X(IJ)**DD                                         DRTR0039
      GO TO 15                                                          DRTR0040
  200 X(IN)=X(IK)*X(IJ)                                                 DRTR0041
      GO TO 15                                                          DRTR0042
  300 X(IN)=LOGF(X(IK))                                                 DRTR0043
      GO TO 15                                                          DRTR0044
  400 X(IN)=SINF(X(IK))                                                 DRTR0045
      GO TO 15                                                          DRTR0046
  500 X(IN)=COSF(X(IK))                                                 DRTR0047
      GO TO 15                                                          DRTR0048
  600 X(IN)=.43429448*LOGF(X(IK))                                       DRTR0049
      GO TO 15                                                          DRTR0050
  700 X(IN)=SQRTF(X(IK))                                                DRTR0051
      GO TO 15                                                          DRTR0052
  800 X(IN)=X(IK)+X(IJ)                                                 DRTR0053
      GO TO 15                                                          DRTR0054
  900 X(IN)=X(IK)-X(IJ)                                                 DRTR0055
      GO TO 15                                                          DRTR0056
  901 X(IN)=X(IK)*CC                                                    DRTR0057
   15 CONTINUE                                                          DRTR0058
   72 WRITE OUTPUT TAPE 6,FMT2,(X(LZ),LZ=1,L12)                         DRTR0059
      IF(NN-3)73,73,20                                                  DRTR0060
   73 PRINT FMT2,(X(LZ),LZ=1,L12)                                       DRTR0061
   20 CONTINUE                                                          DRTR0062
      REWIND 5                                                          DRTR0063
      IF(SENSE SWITCH 1)905,1000                                        DRTR0064
  905 CALL GETOF                                                        DRTR0065
 1000 CONTINUE                                                          DRTR0066
      END FILE 6                                                        DRTR0067
      STOP 77777                                                        DRTR0068
      END(2,2,2,2,0)                                                    DRTR0069
