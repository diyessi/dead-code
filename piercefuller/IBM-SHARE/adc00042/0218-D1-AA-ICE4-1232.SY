      SUBROUTINE ICE (P,TT,TP,E1,E2,NN,Y,DY,F,L,INDEX,I)                ICE40001
      DIMENSION Y(1),DY(1),F(1)                                         ICE40002
      T = TT                                                            ICE40003
      GO TO (100,200,300,400),L                                         ICE40004
 100  IG=IG                                                             ICE40005
      GO TO (101,102),IG                                                ICE40006
 101  J = 1                                                             ICE40007
      L = 2                                                             ICE40008
      M = 0                                                             ICE40009
      TS = T                                                            ICE40010
      DO 106 K = 1,N                                                    ICE40011
      K1 = K+3*N                                                        ICE40012
      K2 = K1+N                                                         ICE40013
      K3 = N + K                                                        ICE40014
      F(K1) = Y(K)                                                      ICE40015
      F(K3) = F(K1)                                                     ICE40016
 106  F(K2) = DY(K)                                                     ICE40017
      GO TO 402                                                         ICE40018
 102  CALL INTEG(T,DT,   N,Y,DY,F,J,I)                                  ICE40019
      J = J+1                                                           ICE40020
      IF(J-I   ) 103,103,104                                            ICE40021
 103  L = 1                                                             ICE40022
      GO TO 402                                                         ICE40023
 104  M = M+1                                                           ICE40024
 105  GO TO (110,120,130),M                                             ICE40025
 110  DO 111 K = 1,N                                                    ICE40026
      K1 = K+N+N                                                        ICE40027
 111  F(K1) = Y(K)                                                      ICE40028
 112  DO 113 K = 1,N                                                    ICE40029
      K1 = K+3*N                                                        ICE40030
      K2 = K1+N                                                         ICE40031
      K3 = N + K                                                        ICE40032
      Y(K) = F(K1)                                                      ICE40033
      F(K3) = F(K1)                                                     ICE40034
 113  DY(K) = F(K2)                                                     ICE40035
      T = TS                                                            ICE40036
      IF(T) 114,116,114                                                 ICE40037
 114  IF(ABSF(H/T)-.000001) 115,115,116                                 ICE40038
 115  M = 0                                                             ICE40039
      L = 4                                                             ICE40040
      GO TO 402                                                         ICE40041
 116  DT = .5*H                                                         ICE40042
      M = 1                                                             ICE40043
      J = 1                                                             ICE40044
      GO TO 300                                                         ICE40045
 120  DO 121 K = 1,N                                                    ICE40046
      K1 = K+N                                                          ICE40047
 121  F(K1) = Y(K)                                                      ICE40048
      M = 2                                                             ICE40049
      J = 1                                                             ICE40050
      IG = 2                                                            ICE40051
      L = 1                                                             ICE40052
      GO TO 402                                                         ICE40053
 130  DO 131 K = 1,N                                                    ICE40054
      K1 = K+2*N                                                        ICE40055
      F(K) = (Y(K)-F(K1))/(2.**I-1.)                                    ICE40056
      Y(K) = Y(K) +F(K)                                                 ICE40057
      IF(ABSF(Y(K))-.00001)139,139,140                                  ICE40058
 139  F(K) = 0.                                                         ICE40059
      GO TO 131                                                         ICE40060
 140  F(K) = ABSF(F(K)/Y(K))                                            ICE40061
 131  CONTINUE                                                          ICE40062
      E = F                                                             ICE40063
      INDEX = 1                                                         ICE40064
      IF (N-1)1335,1335,1315                                            ICE40065
 1315 DO 133 K = 2,N                                                    ICE40066
      IF(E-F(K)) 132,133,133                                            ICE40067
 132  INDEX = K                                                         ICE40068
      E = F(K)                                                          ICE40069
 133  CONTINUE                                                          ICE40070
 1335 IF(E -E1) 134,135,135                                             ICE40071
 134  H = H+H                                                           ICE40072
 1345 DT = H                                                            ICE40073
      GO TO 401                                                         ICE40074
 135  IF(E-E2)1345,1345,136                                             ICE40075
 136  DO 137 K = 1,N                                                    ICE40076
      K1 = K+N                                                          ICE40077
      K2 = K+N+N                                                        ICE40078
 137  F(K2) = F(K1)                                                     ICE40079
 138  H = .5*H                                                          ICE40080
      GO TO 112                                                         ICE40081
 200  MU=MU                                                             ICE40082
      GO TO (203,204),MU                                                ICE40083
 203  H = MAX1F(MAX1F(H,H1),H2)                                         ICE40084
      MU = 2                                                            ICE40085
 204  H1 = ABSF(H)                                                      ICE40086
      IF(P) 205,206,206                                                 ICE40087
 205  H = -H1                                                           ICE40088
      GO TO 207                                                         ICE40089
 206  H = H1                                                            ICE40090
 207  IF(ABSF(P)-H1) 208,209,209                                        ICE40091
 208  H = P                                                             ICE40092
 209  T2 = TP-T                                                         ICE40093
      IF(T2) 210,212,210                                                ICE40094
 210  H2 = ABSF(T2)                                                     ICE40095
      IF(TP) 211,213,211                                                ICE40096
 211  IF(ABSF(T2/TP)-.00001) 212,213,213                                ICE40097
 212  T = TP                                                            ICE40098
      L = 3                                                             ICE40099
      GO TO 402                                                         ICE40100
 213  M = 0                                                             ICE40101
      J = 1                                                             ICE40102
      IF(H1-H2) 215,215,214                                             ICE40103
 214  MU = 1                                                            ICE40104
      H = T2                                                            ICE40105
 215  DT = H                                                            ICE40106
 300  IG = 2                                                            ICE40107
      GO TO 102                                                         ICE40108
 400  MU = 2                                                            ICE40109
      H = P                                                             ICE40110
      DT = P                                                            ICE40111
      N = NN                                                            ICE40112
 401  IG = 1                                                            ICE40113
      L = 1                                                             ICE40114
 402  TT = T                                                            ICE40115
      RETURN                                                            ICE40116
      END(0,1,0,0,0)                                                    ICE40117
