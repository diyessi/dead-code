      LINE = LINE+1                                                     80003529
      DO 6675 IC=2,6                                                    80003530
      IF (MCP(IC,KK)) 6675,6675,6673                                    80003531
 6673 WRITE OUTPUT TAPE 6,6654,MCP(IC,KK),MNP(IC,KK),LW(IC)             80003532
      LINE = LINE+1                                                     80003533
 6675 CONTINUE                                                          80003534
      GO TO 244                                                         80003535
 6680 FND  = 0.0                                                        80003536
C     TEST IF MAN SCHEDULING REPORT DESIRED                             80003537
      IF(MSRP) 129, 129, 6681                                           80003538
C     FINISH DUMMY JOB                                                  80003539
 66810WRITE OUTPUT TAPE 6,6671,ALW(1,LL),NDAY,HOUR,(ALW(IC,LL),IC=2,7), 80003540
     1IW(LL),JW(LL),FND, MCW(1,LL),MNW(1,LL),MNW(1,LL),FLTF             80003541
      LINE = LINE+1                                                     80003542
      GO TO 129                                                         80003543
C     SET TAPE 4 FOR NEXT PHASE. DUMMY INFO. FIRST NEGATIVE             80003544
C      TEST IF CHAIN 4 IS DESIRED                                       80003545
 5500 IF(ICH4) 5390, 5390, 5501                                         80003546
C     SET TAPE 4 FOR NEXT PHASE   FIRST WORD = 32767                    80003547
 5501 IW(1) = 32767                                                     80003548
      WRITE TAPE 4,(IW(I),I=1,30)                                       80003549
      END FILE 4                                                        80003550
      REWIND 4                                                          80003551
C     PROVIDE TITLE, DATE, IUNIT,UNIT FOR CHAIN 4                       80003552
      WRITE TAPE 3, TITLE, DATE, IUNIT,UNIT                             80003553
      CALL CHAIN(4, 2)                                                  80003554
  800 WRITE OUTPUTTAPE 6,803,IS,ISE,NF,NFF                              80003555
  803 FORMAT (21H CARD OUT OF SEQUENCE  4I6      )                      80003556
      GO TO 5000                                                        80003557
 1902 WRITE OUTPUT TAPE 6,1901                                          80003558
      GO TO 5000                                                        80003559
 1901 FORMAT (25H QUEUE CAP. EXCEEDED.       )                          80003560
 1903 FORMAT (27H INPROCESSQUEUE EXCEEDED.   )                          80003561
  904 WRITE OUTPUT TAPE 6,1903                                          80003562
 6690 FORMAT ( I2 )                                                     80003563
 5390 READ INPUT TAPE 5,  6690, K1                                      80003564
 5000 CALL DUMP                                                         80003565
      IF(K1 - 7) 5400, 5395, 5400                                       80003566
 5395 CALL CHAIN(1, 2)                                                  80003567
 5400 CALL EXIT                                                         80003568
      END                                                               80003569
*     CHAIN(4,2)                                                        80004001
C80004         LESS - CRITICAL PATH    CHAIN 4                          80004002
      COMMON   XP,MP                                                    80004003
     0DIMENSION MP(16,1750),KRAFT(2,40),KNAME(4,40),TITLE(6),DATE(3),   80004004
     1           MAN(30), XP(16,1750)                                   80004005
      EQUIVALENCE (XP(1),MP(1))                                         80004006
C     INITIALIZE - SET LIMITS                                           80004007
      NMP = 16                                                          80004008
      KFT = 40                                                          80004009
      JBS = 1750                                                        80004010
      REWIND 4                                                          80004011
C     READ TAPE 3 FOR TITLE, DATE, IUNIT, UNIT                          80004012
      REWIND 3                                                          80004013
      READ TAPE 3,TITLE, DATE, IUNIT, UNIT                              80004014
C     READ IN CRAFT NAMES                                               80004015
   20 J = 1                                                             80004016
   25 READ INPUT TAPE 5,901,K,KRAFT(1,J),KRAFT(2,J),(KNAME(I,J),I=1,4)  80004017
      IF(K - 6) 801, 30, 35                                             80004018
   30 IF(J -KFT) 32, 802, 802                                           80004019
   32 J = J + 1                                                         80004020
      GO TO 25                                                          80004021
   35 NC = J - 1                                                        80004022
      K1 = K                                                            80004023
C     READ IN JOB DATA                                                  80004024
      ICT = 1                                                           80004025
   38 READ TAPE 4,      (MAN(I), I = 1,30)                              80004026
        DO 40 K = 1,6                                                   80004027
        L = 2*K                                                         80004028
   400  XP(K,ICT) = 1000000.0 * FLOATF(MAN(K)) + 1000.0 * FLOATF(MAN(L +80004029
     1  5)) + FLOATF(MAN(L + 6))                                        80004030
        DO 45 K = 7,13                                                  80004031
        L = K + 12                                                      80004032
   45   MP(K,ICT) = MAN(L)                                              80004033
      MP(14,ICT) = MAN(26)                                              80004034
      XP(15,ICT) = 10000.0 * FLOATF(MAN(27)) + FLOATF(MAN(28))          80004035
      YZ         = 10000.0 * (FLOATF(MAN(29))) + ABSF(FLOATF(MAN(30)))  80004036
      XP(16,ICT) = SIGNF( YZ , FLOATF( MAN(30)  ) )                     80004037
      IF (MAN(1)-32766) 50,60,60                                        80004038
   50 IF(ICT - JBS)  55, 57, 57                                         80004039
   55 ICT = ICT +1                                                      80004040
      GO TO 38                                                          80004041
   57 WRITE OUTPUT TAPE 6, 907                                          80004042
      GO TO 285                                                         80004043
   60 ICT = ICT - 1                                                     80004044
C     FIND NEXT CRAFT TO BE LISTED                                      80004045
   70   DO 250 ISER = 1,ICT                                             80004046
   75     DO 210 KR = 1,6                                               80004047
          IF(XP(KR,ISER))210, 210, 80                                   80004048
   80     KNO = XP(KR,ISER)/ 1000000.0                                  80004049
C           FIND LOCATION OF CRAFT NAME AND RANGE FOR REPORT            80004050
            DO  85  KRN = 1,NC                                          80004051
            IF ( KNO - KRAFT(1,KRN)) 85,90,83                           80004052
   83       IF ( KRAFT(2,KRN) - KNO ) 85,90,90                          80004053
   85       CONTINUE                                                    80004054
C         NO NAME FOR CRAFT FOUND  HENCE NO CRAFT REPORT                80004055
          XP(KR,ISER) = -XP(KR,ISER)                                    80004056
          GO TO 210                                                     80004057
C         INITIALIZE HEADING FOR CRAFT REPORT                           80004058
   90     KNO1 = KRAFT(1,KRN)                                           80004059
          KNO2 = KRAFT(2,KRN)                                           80004060
   92     LINE = 45                                                     80004061
          IPAGE = 0                                                     80004062
C         FIND JOB WITH CRAFT = KFT , UNPACK AND OUTPUT                 80004063
            DO 200  IS = ISER,ICT                                       80004064
              DO 190 IR = 1,6                                           80004065
              IF ( XP(IR,IS) ) 190,190, 95                              80004066
   95         KNO3 = XP(IR,IS) / 1000000.0                              80004067
              IF ( KNO3 - KNO1) 190,100,97                              80004068
   97         IF ( KNO2 - KNO3) 190,100,100                             80004069
C             UNPACK CRAFT NO, JOB MANPOWER AND TOTAL MANPOWER          80004070
  100           DO 105 M = 1,6                                          80004071
                XYZ = ABSF(XP(M,IS))                                    80004072
                MAN(M) =  XYZ    /1000000.0                             80004073
                YZ=  XYZ     - 1000000.0 * FLOATF(MAN(M))               80004074
                MAN(M+6) =YZ/1000.0                                     80004075
  105           MAN(M+12) = YZ- 1000.0 * FLOATF(MAN(M+6))               80004076
              INO  =   XP(15,IS)/10000.0                                80004077
              JNO =   XP(15,IS) - 10000.0 * FLOATF(INO)                 80004078
C             COVERT TIME TO SHIFTS AND UNITS                           80004079
              ITM = XABSF(MP(14,IS))                                    80004080
              IDAY1 = ITM/IUNIT                                         80004081
              HOUR1 = FLOATF(ITM - IUNIT * IDAY1) / UNIT                80004082
              XY    = ABSF(XP(16,IS))                                   80004083
              IDUR  = XY / 10000.0                                      80004084
              IFLT  = XY - 10000.0 * FLOATF(IDUR)                       80004085
              DUR   = FLOATF(IDUR) / UNIT                               80004086
              FLT   = ABSF(FLOATF(IFLT)) / UNIT                         80004087
              IF (XP(16,IS)) 120,110,110                                80004088
  110         ITM   = ITM + IFLT                                        80004089
              IDAY2 = ITM / IUNIT                                       80004090
              HOUR2 = FLOATF(ITM - IUNIT * IDAY2) / UNIT                80004091
              GO TO 130                                                 80004092
  120         IDAY2 = IDAY1                                             80004093
              HOUR2 = ABSF(HOUR1)                                       80004094
              FLT   = -FLT                                              80004095
C             TEST IF PUTPUT HEADINGS ARE NEEDED                        80004096
  130         IF(LINE - 45)  140, 135, 135                              80004097
C             RESET LINE NO., STEP PAGE NO. AND PRINT HEADINGS          80004098
  135         LINE  = 0                                                 80004099
              IPAGE = IPAGE + 1                                         80004100
     0        WRITE OUTPUT TAPE 6, 902, TITLE, IPAGE, DATE, (KNAME(N,KRN80004101
     1        ), N = 1,4)                                               80004102
C             INCREMENT TO INDICATE WORKING DAY                         80004103
  140         IDAY1 = IDAY1 + 1                                         80004104
              IDAY2 = IDAY2 + 1                                         80004105
C             TEST FOR DELAYED JOB                                      80004106
              IF(MP(14,IS)) 141, 145, 145                               80004107
C             WRITE DELAYED JOB                                         80004108
  1410        WRITE OUTPUT TAPE 6, 903, MP(7,IS), IDAY1, HOUR1, IDAY2,  80004109
     1        HOUR2, (MP(N,IS),N = 8,13), INO , JNO, DUR, MAN(1),MAN(7),80004110
     2        MAN(13) , FLT                                             80004111
              GO TO 147                                                 80004112
C             WRITE START JOB                                           80004113
  1450        WRITE OUTPUT TAPE 6, 904, MP(7,IS), IDAY1, HOUR1, IDAY2,  80004114
     1        HOUR2, (MP(N,IS),N= 8,13), INO, JNO , DUR, MAN(1), MAN(7),80004115
     2        MAN(13) , FLT                                             80004116
  147         LINE = LINE + 1                                           80004117
C             WRITE MULTIPLE CRAFTS                                     80004118
                DO 150 M = 2,6                                          80004119
                IF ( MAN(M) ) 150,150,148                               80004120
  148           WRITE OUTPUT TAPE 6, 905,MAN(M) , MAN(M+6), MAN(M+12)   80004121
                LINE = LINE + 1                                         80004122
  150           CONTINUE                                                80004123
C             SET ALL CRAFTS IN CRAFT REPORT RANGE NEGATIVE             80004124
                DO 180 IM = IR,6                                        80004125
                IF(XP(IM,IS)) 180, 180, 160                             80004126
  160           KNO3 = XP(IM,IS) / 1000000.0                            80004127
                IF(KNO3 - KNO1) 180, 170, 165                           80004128
  165           IF(KNO2 - KNO3) 180, 170, 170                           80004129
  170           XP(IM,IS) = -XP(IM,IS)                                  80004130
  180           CONTINUE                                                80004131
  185         GO TO 200                                                 80004132
  190         CONTINUE                                                  80004133
  200       CONTINUE                                                    80004134
  210     CONTINUE                                                      80004135
  250   CONTINUE                                                        80004136
C     RESET CRAFT WORDS POSITIVE                                        80004137
  260   DO 270 ISER = 1,ICT                                             80004138
          DO 265 KR = 1,6                                               80004139
  265     XP(KR,ISER) = ABSF(XP(KR,ISER))                               80004140
  270   CONTINUE                                                        80004141
C     WRITE ITEM REPORT                                                 80004142
C     INITIALIZE REPORT                                                 80004143
      LINE  = 45                                                        80004144
      IPAGE =  0                                                        80004145
      KOUNT =  ICT                                                      80004146
C     FIND MINIMUM ITEM NUMBER                                          80004147
  320 LOC = 1                                                           80004148
      IITEM = MP(7,1)                                                   80004149
        DO 330 ITEST = 1,ICT                                            80004150
        IF(MP(7,ITEST)- IITEM) 325, 330, 330                            80004151
  325   IITEM = MP(7,ITEST)                                             80004152
        LOC = ITEST                                                     80004153
  330   CONTINUE                                                        80004154
C     FIND ALL JOBS WITH ITEM NUMBERS = TO MINIMUM                      80004155
        DO 500 IS = LOC, ICT                                            80004156
        IF(MP(7,IS) - IITEM)  500, 340, 500                             80004157
C             UNPACK CRAFT NO, JOB MANPOWER AND TOTAL MANPOWER          80004158
  340           DO 350 M = 1,6                                          80004159
                XYZ = ABSF(XP(M,IS))                                    80004160
                MAN(M) =  XYZ    /1000000.0                             80004161
                YZ=  XYZ     - 1000000.0 * FLOATF(MAN(M))               80004162
                MAN(M+6) =YZ/1000.0                                     80004163
  350           MAN(M+12) = YZ- 1000.0 * FLOATF(MAN(M+6))               80004164
              INO  =   XP(15,IS)/10000.0                                80004165
              JNO =   XP(15,IS) - 10000.0 * FLOATF(INO)                 80004166
C             COVERT TIME TO SHIFTS AND UNITS                           80004167
              ITM = XABSF(MP(14,IS))                                    80004168
              IDAY1 = ITM/IUNIT                                         80004169
              HOUR1 = FLOATF(ITM - IUNIT * IDAY1) / UNIT                80004170
              XY    = ABSF(XP(16,IS))                                   80004171
              IDUR  = XY / 10000.0                                      80004172
              IFLT  = XY - 10000.0 * FLOATF(IDUR)                       80004173
              DUR   = FLOATF(IDUR) / UNIT                               80004174
              FLT   = ABSF(FLOATF(IFLT)) / UNIT                         80004175
              IF (XP(16,IS)) 370, 360, 360                              80004176
  360         ITM   = ITM + IFLT                                        80004177
              IDAY2 = ITM / IUNIT                                       80004178
              HOUR2 = FLOATF(ITM - IUNIT * IDAY2) / UNIT                80004179
              GO TO 375                                                 80004180
  370         IDAY2 = IDAY1                                             80004181
              HOUR2 = ABSF(HOUR1)                                       80004182
              FLT   = -FLT                                              80004183
C             INCREMENT TO INDICATE WORKING DAY                         80004184
  375         IDAY1 = IDAY1 + 1                                         80004185
              IDAY2 = IDAY2 + 1                                         80004186
C             TEST IF PUTPUT HEADINGS ARE NEEDED                        80004187
  380         IF(LINE - 45)  390,385,385                                80004188
C             RESET LINE NO., STEP PAGE NO. AND PRINT HEADINGS          80004189
  385         LINE  = 0                                                 80004190
              IPAGE = IPAGE + 1                                         80004191
              WRITE OUTPUT TAPE 6, 912, TITLE, IPAGE, DATE              80004192
C             TEST FOR DELAYED JOB                                      80004193
  390         IF(MP(14,IS)) 391,395,395                                 80004194
C             WRITE DELAYED JOB                                         80004195
  3910        WRITE OUTPUT TAPE 6, 903, MP(7,IS), IDAY1, HOUR1, IDAY2,  80004196
     1        HOUR2, (MP(N,IS),N = 8,13), INO , JNO, DUR, MAN(1),MAN(7),80004197
     2        MAN(13) , FLT                                             80004198
              GO TO 397                                                 80004199
C             WRITE START JOB                                           80004200
  3950        WRITE OUTPUT TAPE 6, 904, MP(7,IS), IDAY1, HOUR1, IDAY2,  80004201
     1        HOUR2, (MP(N,IS),N= 8,13), INO, JNO , DUR, MAN(1), MAN(7),80004202
     2        MAN(13) , FLT                                             80004203
  397         LINE = LINE + 1                                           80004204
C             WRITE MULTIPLE CRAFTS                                     80004205
                DO 400 M = 2,6                                          80004206
                IF ( MAN(M) ) 400,400,398                               80004207
  398           WRITE OUTPUT TAPE 6, 905,MAN(M) , MAN(M+6), MAN(M+12)   80004208
                LINE = LINE + 1                                         80004209
  400           CONTINUE                                                80004210
C       SET ITEM TO VERY LARGE NUMBER                                   80004211
        MP(7,IS) = 131071                                               80004212
        KOUNT = KOUNT - 1                                               80004213
  500   CONTINUE                                                        80004214
C     TEST IF ALL ITEMS NUMBERS DONE                                    80004215
      IF(KOUNT) 280, 280, 510                                           80004216
  510 WRITE OUTPUT TAPE 6, 911                                          80004217
      LINE = LINE + 1                                                   80004218
      GO TO 320                                                         80004219
  280 WRITE OUTPUT TAPE 6, 906, TITLE                                   80004220
  285 IF(K1 - 7) 290, 295, 290                                          80004221
  290 CALL EXIT                                                         80004222
  295 CALL CHAIN(1, 2)                                                  80004223
  801 WRITE OUTPUT TAPE 6, 909                                          80004224
      GO TO 285                                                         80004225
  802 WRITE OUTPUT TAPE 6, 910                                          80004226
      GO TO 285                                                         80004227
C     FORMAT STATEMENTS                                                 80004228
  900 FORMAT (I2,6A6/I2,3A6,I2)                                         80004229
  901 FORMAT ( 3I2, 4A6 )                                               80004230
  9020FORMAT (1H1 35X,6A6,34X,5HPAGE I2//45X,3A6///37X,4A6//22H ITEM   E80004231
     1ARLY     LATE 26X,3HJOB 19X,40HI     J   DURA CRAFT  MEN   TOTAL  80004232
     2  JOB/24H  NO. DAY HOUR  DAY HOUR 20X,11HDESCRIPTION 13X,44HNODE  80004233
     3NODE  TION  NO.  REQD  IN CRAFT  FLOAT/6H            )            80004234
  9030FORMAT (1H A3,I5,F5.1,I5,F5.1,9H DELAYED 5A6,A4,I5,I6,F6.1,I4,I6, 80004235
     1        I8,F9.1)                                                  80004236
  904 FORMAT (1H A3,I5,F5.1,I5,F5.1,9X,5A6,A4,I5,I6,F6.1,I4,I6,I8,F9.1) 80004237
  905 FORMAT (1H 83X,I4,I6,I8)                                          80004238
  906 FORMAT (35H1END OF MANSCHEDULING ITEM LIST     6A6)               80004239
  907 FORMAT (46H1 NO. OF JOBS HAVE EXCEDED TABLE SIZE OF 1750.)        80004240
  909 FORMAT (26H1 CRAFT NAME CARD NOT NO 6)                            80004241
  910 FORMAT (42H1 CRAFT NAME TABLE OF 40 HAS BEEN EXCEDED.)            80004242
  911 FORMAT (1H )                                                      80004243
  9120FORMAT (1H1 35X,6A6,34X,5HPAGE I2//45X,3A6///         22H ITEM   E80004244
     1ARLY     LATE 26X,3HJOB 19X,40HI     J   DURA CRAFT  MEN   TOTAL  80004245
     2  JOB/24H  NO. DAY HOUR  DAY HOUR 20X,11HDESCRIPTION 13X,44HNODE  80004246
     3NODE  TION  NO.  REQD  IN CRAFT  FLOAT/6H            )            80004247
      END                                                               80004248
