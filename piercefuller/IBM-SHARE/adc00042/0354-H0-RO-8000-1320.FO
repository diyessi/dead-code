*     CHAIN(1,2)                                                        80001001
C80001         LESS - CRITICAL PATH    CHAIN 1                          80001002
      DIMENSION  TIJ(8000 ),TIJN(8000 ),ITD(8000 )                      80001003
      DIMENSION MANP(12),DATA(20)                                       80001004
      COMMON TIJ , TIJN , ITD                                           80001005
  111 FORMAT (A3,I5,2I4,6(I2,I3),5A6,A4     )                           80001006
      MAXD=8000                                                         80001007
      REWIND 3                                                          80001008
      REWIND 4                                                          80001009
      REWIND 8                                                          80001010
  100 K=1                                                               80001011
      DO 50 N=1,MAXD                                                    80001012
      TIJ(N)=0.0                                                        80001013
      TIJN(N)=0.0                                                       80001014
   50 ITD(N) =0                                                         80001015
      DO 10 N=1,MAXD                                                    80001016
     0READ INPUT TAPE 5,111,DATA(1),INO,JNO,LDUR,(MANP(I),I=1,12),      80001017
     1(DATA(I),I=2,7)                                                   80001018
      IF (INO)2,3,4                                                     80001019
    3 WRITE OUTPUT TAPE 6,3003                                          80001020
 3003 FORMAT(22H0INO MUST NOT BE ZERO.)                                 80001021
      GO TO 3999                                                        80001022
    2 INO = -INO                                                        80001023
      K=2                                                               80001024
    4 WRITE TAPE 3,INO,JNO,(DATA(I),I=1,7),(MANP(I),I=1,12)             80001025
      I=INO                                                             80001026
      J=JNO                                                             80001027
      TI=I                                                              80001028
      TI=TI*10000.                                                      80001029
      TJ=J                                                              80001030
      TIJN(N)=TI+TJ                                                     80001031
      DL=LDUR                                                           80001032
      DL=DL*10000.                                                      80001033
      ITD(N) = LDUR                                                     80001034
      IF(TIJ(J)-(TIJ(I)+DL))5,9,9                                       80001035
    5 TIJ(J)=(TIJ(I)+DL)                                                80001036
    9 GO TO (10,20),K                                                   80001037
   10 CONTINUE                                                          80001038
      WRITE OUTPUT TAPE 6,3004                                          80001039
 3004 FORMAT(31H0THERE ARE TOO MANY DATA CARDS.)                        80001040
      GO TO 3999                                                        80001041
   20 BETA=TIJ(J)/10000.                                                80001042
      DO 30 K=1,MAXD                                                    80001043
   30 TIJ(K)=TIJ(K)+BETA                                                80001044
      END FILE 3                                                        80001045
      REWIND 3                                                          80001046
      K=1                                                               80001047
      M=N                                                               80001048
   45 A=TIJN(M)                                                         80001049
      B=A/10000.                                                        80001050
      I=B                                                               80001051
      B=I                                                               80001052
      B=B*10000.                                                        80001053
      J=A-B                                                             80001054
      GO TO(70,80),K                                                    80001055
   70 DL = ITD(M)                                                       80001056
      A=TIJ(J)                                                          80001057
      B=A/10000.                                                        80001058
      L=B                                                               80001059
      B=L                                                               80001060
      B=B*10000.                                                        80001061
      GAMA=A-B                                                          80001062
      A=TIJ(I)                                                          80001063
      B=A/10000.                                                        80001064
      L=B                                                               80001065
      B=L                                                               80001066
      B=B*10000.                                                        80001067
      BETA=A-B                                                          80001068
      IF(BETA-(GAMA-DL))40,40,42                                        80001069
   42 TIJ(I)=B+(GAMA-DL)                                                80001070
   40 M=M-1                                                             80001071
      IF(M-1)44,45,45                                                   80001072
   44 K=2                                                               80001073
   81 II=0                                                              80001074
      JJ=0                                                              80001075
   52 DO 65 M=1,N                                                       80001076
      GO TO 45                                                          80001077
   80 IF(I-II)61,62,63                                                  80001078
   61 WRITE OUTPUT TAPE 6,3005                                          80001079
 3005 FORMAT(38H0DATA CHECK--I VALUES ARE OUT OF SORT.)                 80001080
      GO TO 3999                                                        80001081
   62 IF(J-JJ)64,60,63                                                  80001082
   64 WRITE OUTPUT TAPE 6,3007                                          80001083
 3007 FORMAT(44H0DATA CHECK--SAME I VALUES BUT J VALUES ARE             80001084
     X12HOUT OF SORT.)                                                  80001085
      GO TO 3999                                                        80001086
   60 WRITE OUTPUT TAPE 6,3006                                          80001087
 3006 FORMAT(44H0DATA CHECK--TWO CARDS HAVE THE SAME I AND J            80001088
     X1H.)                                                              80001089
      GO TO 3999                                                        80001090
   63 II=I                                                              80001091
      JJ=J                                                              80001092
      EST=TIJ(I)/10000.                                                 80001093
      IEST=EST                                                          80001094
      EST=IEST                                                          80001095
      DL = ITD(M)                                                       80001096
      DX=DL*10000.                                                      80001097
      LD=DL                                                             80001098
      EFT=EST+DL                                                        80001099
      FLFT=TIJ(J)                                                       80001100
      A=FLFT/10000.                                                     80001101
      L=A                                                               80001102
      A=L                                                               80001103
      A=A*10000.                                                        80001104
      FLFT=FLFT-A                                                       80001105
      FLST=FLFT-DL                                                      80001106
      TFT=FLST-EST                                                      80001107
      PIJ=TIJN(M)+90000000.                                             80001108
      PDEST=(DL*10000.)+EST+90000000.                                   80001109
      PLSEF=(FLST*10000.)+EFT+90000000.                                 80001110
      PLFTF=(FLFT*10000.)+TFT+90000000.                                 80001111
      IEFT=EFT                                                          80001112
      LFT=FLFT                                                          80001113
      LST=FLST                                                          80001114
      LTF=TFT                                                           80001115
      IF(LTF)68,71,71                                                   80001116
   68 WRITE OUTPUT TAPE 6,3008                                          80001117
 3008 FORMAT(25H0TOTAL FLOAT IS NEGATIVE.)                              80001118
      GO TO 3999                                                        80001119
   71 READ TAPE 3,INO,JNO,(DATA(IC),IC=1,19)                            80001120
      IF ((I-INO)+(J-JNO)) 73,74,73                                     80001121
   73 WRITE OUTPUT TAPE 6,730,I,INO,J,JNO                               80001122
  730 FORMAT (37H SEQUENCE ERROR MERGING CP AND INPUT    4I6   )        80001123
      GO TO 3999                                                        80001124
   74 WRITE TAPE 8,IEST,LTF,I,J,LD,LST,IEFT,LFT,(DATA(IC),IC=1,19)      80001125
      WRITE TAPE 4,LTF,IEST,I,J,LD,LST,IEFT,LFT,(DATA(IC),IC=1,7)       80001126
   65 CONTINUE                                                          80001127
      IEST = 32767                                                      80001128
      LTF = 32767                                                       80001129
      WRITE TAPE 8,IEST,LTF,I,J,LD,LST,IEFT,LFT,(DATA(IC),IC=1,19)      80001130
      WRITE TAPE 4,LTF,IEST,I,J,LD,LST,IEFT,LFT,(DATA(IC),IC=1,7)       80001131
      END FILE 4                                                        80001132
      REWIND 4                                                          80001133
      END FILE 8                                                        80001134
      REWIND 8                                                          80001135
      CALL CHAIN(2, 2)                                                  80001136
 3999 CALL EXIT                                                         80001137
      END                                                               80001138
*     CHAIN(2,2)                                                        80002001
C80002         LESS - CRITICAL PATH    CHAIN 2                          80002002
C     SORT TAPE 4 FOR LISTING OF CP BY FLOAT                            80002003
C     SORT TAPE 8 FOR INPUT TO MANSCHEDULING. SORT BY FLOAT WITHIN EARLY80002004
C     START. END OF TAPE 4 IS FOUND BY FLOAT = 32767. TAPE 8 IS ASSUMED 80002005
C     TO HAVE THE SAME NO. OF  JOBS AS TAPE 4.                          80002006
      DIMENSION  ICP(15,1750), XP(16,1750), MP(8), DESC(7), KR(12)      80002007
      COMMON  ICP, XP, MP,DESC,KR                                       80002008
      EQUIVALENCE (ICP(1),XP(1))                                        80002009
C     SET DIMENSION LIMITS                                              80002010
      NXP = 16                                                          80002011
      NCP =15                                                           80002012
C     READ AND COUNT DATA FROM TAPE 4.                                  80002013
      ICT = 1                                                           80002014
      REWIND 4                                                          80002015
   10 READ TAPE 4 , ( ICP(J,ICT), J=1,NCP )                             80002016
      ICT = ICT + 1                                                     80002017
      IF (ICP(1,ICT-1) - 32766) 10,10,20                                80002018
   20 REWIND 4                                                          80002019
      N = ICT-2                                                         80002020
      NOUT = N                                                          80002021
C     FIND SMALLEST FLOAT AND OUTPUT                                    80002022
   25 MIN = 32767                                                       80002023
      DO 40 I = 1,N                                                     80002024
      IF (MIN - ICP(1,I)) 40,40,30                                      80002025
C     PUT SMALLEST IN MIN                                               80002026
   30 MIN = ICP(1,I)                                                    80002027
C     LOCATION OF FIRST WITH FLOAT = MIN                                80002028
      IFRST = I                                                         80002029
   40 CONTINUE                                                          80002030
C     OUTPUT ALL THOSE WITH FLOAT = MIN AND SET FLOAT = 32767           80002031
      DO 60  I = IFRST,N                                                80002032
      IF (MIN - ICP(1,I)) 60,50,60                                      80002033
   50 WRITE TAPE 4,( ICP(J,I),J=1, NCP )                                80002034
C     COUNT OUTPUT FOR END TEST                                         80002035
      NOUT  = NOUT - 1                                                  80002036
      ICP(1,I) = 32767                                                  80002037
   60 CONTINUE                                                          80002038
C     GO FIND NEXT MIN                                                  80002039
      IF (NOUT) 65,65,25                                                80002040
C     WRITE LAST RECORD (32767 = FLOAT),ENDFILE 4 AND REWIND4           80002041
   65 WRITE TAPE 4, (ICP(J,N+1),J=1,NCP )                               80002042
      ENDFILE 4                                                         80002043
      REWIND 4                                                          80002044
C     SET TO READ TAPE 8 , DATA PLUS LAST RECORD                        80002045
      M = N +1                                                          80002046
        DO  80  J = 1 , M                                               80002047
        READ TAPE 8,(MP(I),I = 1 , 8), (DESC(I),I = 1,7), (KR(I),I=1,12)80002048
C       PACK DATA FOR STORAGE                                           80002049
          DO  70  K = 1 , 4                                             80002050
   70     XP(K,J) = FLOATF(MP(2 * K - 1)) * 10000.0 + FLOATF(MP(2 * K)) 80002051
          DO  75  K = 5 , 11                                            80002052
   75     XP(K,J) = DESC(K - 4)                                         80002053
C       PACK CRAFT AND MANPOWER DATA                                    80002054
     0  XP(12,J) = 100000. * FLOATF(KR(1)) + 100. * FLOATF(KR(2)) +     80002055
     1 FLOATF(KR(3))                                                    80002056
     0  XP(13,J) = 100000. * FLOATF(KR(4))+1000. * FLOATF(KR(5)) +      80002057
     1 FLOATF(KR(6))                                                    80002058
     0  XP(14,J) = 100000. * FLOATF(KR(7))+100.  * FLOATF(KR(8)) +      80002059
     1 FLOATF(KR(9))                                                    80002060
     0  XP(15,J) = 100000. * FLOATF(KR(10))+1000.* FLOATF(KR(11))+      80002061
     1 FLOATF(KR(12))                                                   80002062
   80   CONTINUE                                                        80002063
C     REWIND TAPE FOR OUTPUT                                            80002064
      REWIND 8                                                          80002065
      NOUT = N                                                          80002066
      NST  = 1                                                          80002067
C     SELECT DATA BY FLOAT WITH IN EARLY START. NST IS USED TO PREVENT  80002068
C     SEARCHING DATA AT BEGINNING WHICH HAS BEEN OUTPUT.                80002069
  100 FMIN = 99999999.0                                                 80002070
C     IC CONTROLS INCREASING NST                                        80002071
      IC = 1                                                            80002072
C     SEARCH FOR SMALLEST ES AND FLOAT                                  80002073
      DO 150 I = NST,N                                                  80002074
      GO TO (110,120),IC                                                80002075
  110 IF(XP(1,I) - FMIN) 115, 150, 150                                  80002076
  115 NST = I                                                           80002077
      IC = 2                                                            80002078
  120 IF(XP(1,I) - FMIN) 130, 150, 150                                  80002079
C     SET FMIN TO SMALLER                                               80002080
  130 FMIN = XP(1,I)                                                    80002081
      IFRST = I                                                         80002082
  150 CONTINUE                                                          80002083
C     OUTPUT ALL VALUES WITH MINIMUM EARLY START AND FLOAT VALUES       80002084
        DO  180  J = IFRST, N                                           80002085
        IF(XP(1,J) - FMIN) 180, 170, 180                                80002086
  170     DO  172  K = 1, 4                                             80002087
          X = XP(K,J) / 10000.0                                         80002088
          MP(2 * K - 1) = X                                             80002089
          Y = XP(K,J) - FLOATF(MP(2 * K - 1)) * 10000.0                 80002090
  172     MP(2 * K) = Y                                                 80002091
          DO  174  K = 5, 11                                            80002092
  174     DESC(K - 4) = XP(K,J)                                         80002093
C       UNPACK CRAFT AND MANPOWER DATA                                  80002094
        L = 10                                                          80002095
          DO 176  K = 1,7,6                                             80002096
          L = L + 2                                                     80002097
          XYZ = XP(L,J)                                                 80002098
          KR(K) = XYZ / 100000.0                                        80002099
          YZ = XYZ - 100000.0 * FLOATF(KR(K))                           80002100
          KR(K+1) = YZ / 100.0                                          80002101
  176     KR(K+2) =  YZ - FLOATF(KR(K+1)) * 100.0                       80002102
        L = 11                                                          80002103
          DO 178 K = 4,10,6                                             80002104
          L = L + 2                                                     80002105
          XYZ = XP(L,J)                                                 80002106
          KR(K) = XYZ / 100000.0                                        80002107
          YZ = XYZ - 100000.0 * FLOATF(KR(K))                           80002108
          KR(K+1) = YZ / 1000.0                                         80002109
  178     KR(K+2) =  YZ - 1000.0 * FLOATF(KR(K+1))                      80002110
        NOUT = NOUT - 1                                                 80002111
        WRITE TAPE 8, (MP(I),I = 1,8), (DESC(I),I = 1,7), (KR(I),I=1,12)80002112
        XP(1,J) = 99999999.0                                            80002113
  180   CONTINUE                                                        80002114
C     TEST FOR END                                                      80002115
      IF(NOUT) 190, 190, 100                                            80002116
  190 MP(1) = 32767                                                     80002117
      MP(2) = 32767                                                     80002118
      WRITE TAPE 8, (MP(I),I = 1,8),(DESC(I),I = 1,7), (KR(I), I=1,12)  80002119
      END FILE 8                                                        80002120
      REWIND 8                                                          80002121
      CALL CHAIN(3, 2 )                                                 80002122
      END                                                               80002123
*     CHAIN(3, 2 )                                                      80003001
C80003         LESS - CRITICAL PATH    CHAIN 3                          80003002
C              LESS - MANPOWER SCHEDULE                                 80003003
      EQUIVALENCE (ITEM , DATA(1) )                                     80003004
      DIMENSION JP(400),NDP(400),ISP(400),LSP(400),JF(400),LCW(400)     80003005
      DIMENSION IW(400),JW(400),NDW(400),ISW(400),LSW(400),IP(400)      80003006
      DIMENSION MCP(6,400),LCP(400),MCR(6),MR(6)                        80003007
      DIMENSION L(100),M(100),MC(100),MNW(6,400),MCW(6,400),MNP(6,400)  80003008
      DIMENSION AL(8),LA(12),ALW(7,400),ALP(7,400),LW(6)                80003009
      DIMENSION TITLE(6), DATE(3)                                       80003010
     0COMMON TITLE ,DATE , JP,NDP,ISP,LSP,JF,LCW,IW,JW,NDW,ISW,LSW,IP,  80003011
     1MCP,LCP, MCR,MR, L ,M,MC,MNW,MCW,MNP,AL,LA,ALW,ALP,LW             80003012
 1998 KDM=1                                                             80003013
      REWIND 3                                                          80003014
      NPAGE=1                                                           80003015
      LPAGE=0                                                           80003016
      IPG =1                                                            80003017
      MAXD2=400                                                         80003018
      LINE=45                                                           80003019
      KDAY=0                                                            80003020
      NWL=0                                                             80003021
      NIP=0                                                             80003022
      ISE=0                                                             80003023
      NFF=0                                                             80003024
      MAXD1=100                                                         80003025
      DO 11 J=1,MAXD1                                                   80003026
   11 L(J)=0                                                            80003027
      MC(1)=0                                                           80003028
      M(1)=0                                                            80003029
      MT=2                                                              80003030
C  ZERO OUT LC AREAS                                                    80003031
      DO 12 J=1,MAXD2                                                   80003032
      LCW(J)=0                                                          80003033
   12 LCP(J)=0                                                          80003034
      LC1=0                                                             80003035
      KSW1=0                                                            80003036
 1000 REWIND 4                                                          80003037
C     READ IN CONTROL CARDS NUMBERED 1 THROUGH 3.  LAST ONE MUST BE NEG.80003038
 1001 READ INPUT TAPE 5, 1002, ICOD, MCCOD, MPCOD, MSRP1, ICH41         80003039
 1002  FORMAT (2I2,3I4)                                                 80003040
      IF(ICOD)2004,2025,2001                                            80003041
 2004 ICOD=-ICOD                                                        80003042
      KSW1=1                                                            80003043
C     NUMBERS 1,2 AND 3 OK.  NO. 4 MEANS LAST CARD NO 1-3 NOT NEGATIVE  80003044
 2001 GO TO (13, 2011, 2021, 2025),ICOD                                 80003045
   13 MPCD=MPCOD                                                        80003046
      MCCD = MCCOD                                                      80003047
      MSRP = MSRP1                                                      80003048
      ICH4 = ICH41                                                      80003049
      GO TO 2003                                                        80003050
 2011 KDM=MPCOD                                                         80003051
      GO TO 2003                                                        80003052
 2021 MC(MT)=MCCOD                                                      80003053
      M(MT)=MPCOD                                                       80003054
      MT=MT+1                                                           80003055
 2003 IF(KSW1)1001,1001,2027                                            80003056
 2025 WRITE OUTPUT TAPE 6,2026                                          80003057
 2026 FORMAT(29H ERROR IN CONTROL CARD NUMBER)                          80003058
      GO TO 5000                                                        80003059
 2027 READ INPUT TAPE 5,7073,ITP1,TITLE,ITP2,DATE,IUNIT                 80003060
 7073 FORMAT ( I2,6A6 / I2,3A6, I2)                                     80003061
C     TYPE 4 CARD CONTAINS TITLE OF PROJECT.                            80003062
      IF (ITP1-4) 2025,2260,2025                                        80003063
C     TYPE 5 CARD CONTAINS DATE OF REPORT AND IUNIT                     80003064
 2260 IF (ITP2-5) 2025,7100,2025                                        80003065
 7100 UNIT = IUNIT                                                      80003066
      IUNIT = 8 * IUNIT                                                 80003067
C     TEST FOR CRITICAL PATH REPORT                                     80003068
      IF(MCCD) 19, 19, 7040                                             80003069
 7040 READ TAPE 4,LTF,IEST,II,JJ,ND,LST,IEFT,LFT,(AL(IC),IC=1,7)        80003070
C     CONVERT INTEGER TO FLOATING POINT UNITS OR 10THS OF UNITS         80003071
      FIEST =  FLOATF(IEST)/UNIT                                        80003072
      FLST  =  FLOATF(LST )/UNIT                                        80003073
      FIEFT =  FLOATF(IEFT)/UNIT                                        80003074
      FLFT  =  FLOATF(LFT )/UNIT                                        80003075
      FLTF  =  FLOATF(LTF )/UNIT                                        80003076
      FND   =  FLOATF(ND  )/UNIT                                        80003077
      IF(IEST-32767)2028,7101,7101                                      80003078
C     WRITE CRITICAL PATH REPORT                                        80003079
 2028 IF(LPAGE)2029,2029,2034                                           80003080
C     WRITE REPORT HEADINGS                                             80003081
 2029 WRITE OUTPUT TAPE 6,2030,TITLE,NPAGE,DATE                         80003082
 20300FORMAT(1H1 34X,6A6,37X,5HPAGE  I2/ 45X,14HCRITICAL  PATH  //45X,  80003083
     13A6 /// 6H  ITEM17X,3HJOB20X,56HI     J   DURATION  EARLY   LATE  80003084
     2 EARLY   LATE    FLOAT / 5H  NO. 14X,11HDESCRIPTION 14X,50HNODE  N80003085
     3ODE  IN HOURS  START  START  FINISH  FINISH  / 6H         )       80003086
      NPAGE=NPAGE+1                                                     80003087
 20340WRITE OUTPUT TAPE 6,2035,(AL(IC),IC=1,7 ),II,JJ,FND,FIEST,FLST,   80003088
     1FIEFT,FLFT,FLTF                                                   80003089
 2035 FORMAT (2X,A3,3X,5A6,A4,2I6,6F8.1)                                80003090
      LPAGE=LPAGE+1                                                     80003091
      IF (LPAGE - 50 ) 7040, 2038, 2038                                 80003092
 2038 LPAGE=0                                                           80003093
      GO TO 7040                                                        80003094
 7101 REWIND 4                                                          80003095
C     TESTFOR MANSCHEDULING                                             80003096
   19 IF ( MPCD ) 5390, 5390, 18                                        80003097
   18 IF(MSRP + ICH4) 5510, 5510, 20                                    80003098
 5510 WRITE OUTPUT TAPE 6, 5511                                         80003099
      GO TO 5400                                                        80003100
 5511 FORMAT (24H1ERROR IN CONTROL CARD 1 )                             80003101
   200READ TAPE 8,IS,NF,II,JJ,ND,LS,IF ,LF,(AL(IC),IC=1,7),(MCR(JC),    80003102
     1MR(JC),JC=1,6)                                                    80003103
      IF(IS-32767)355,354,354                                           80003104
  354 LC=32                                                             80003105
      GO TO 7000                                                        80003106
  355 IF(IS-ISE)800,810,820                                             80003107
  810 IF(NF-NFF)800,820,820                                             80003108
  820 ISE=IS                                                            80003109
      NFF=NF                                                            80003110
      LCI=LC                                                            80003111
      DO 3000 MK=1,6                                                    80003112
      DO 821 J=1,MAXD1                                                  80003113
      IF(MCR(MK)-MC(J))821,822,821                                      80003114
  821 CONTINUE                                                          80003115
 8211 WRITE OUTPUT TAPE 6,1111,II ,JJ,MCR(MK)                           80003116
      GO TO 5000                                                        80003117
  822 IF(MR(MK)-M(J)-L(J))3000,3000,824                                 80003118
  824 WRITE OUTPUT TAPE 6,825,II ,JJ                                    80003119
