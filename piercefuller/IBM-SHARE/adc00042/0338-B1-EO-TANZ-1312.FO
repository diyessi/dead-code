*     LIST                                                              EOTANZ01
      SUBROUTINE COMTAN(A1,A2,F1,F2)                                    EOTANZ02
      A1P=A1/3.14159265                                                 EOTANZ03
      IF(ABSF(ABSF(INTF(A1P)-A1P)-0.5)-0.00001)1,1,2                    EOTANZ04
 1    IF(A2)3,4,3                                                       EOTANZ05
 4    WRITE OUTPUT TAPE 3,5                                             EOTANZ06
 5    FORMAT(///43H ARGUMENT OF TAN HALF AN ODD MULTIPLE OF PI///)      EOTANZ07
      CALL EXIT                                                         EOTANZ08
 3    F1=0.                                                             EOTANZ09
      X1=EXPF(2.*A2)                                                    EOTANZ10
      F2=(X1+1.)/(X1-1.)                                                EOTANZ11
      GO TO 6                                                           EOTANZ12
 2    A=EXPF(2.*A2)                                                     EOTANZ13
      B=A+1.                                                            EOTANZ14
      C=A-1.                                                            EOTANZ15
      D1=SINF(A1)/COSF(A1)                                              EOTANZ16
      D2=D1*B                                                           EOTANZ17
      D3=D1*C                                                           EOTANZ18
      D4=B**2+D3**2                                                     EOTANZ19
      F1=(D2*B-C*D3)/D4                                                 EOTANZ20
      F2=(D2*D3+C*B)/D4                                                 EOTANZ21
 6    RETURN                                                            EOTANZ22
      END                                                               EOTANZ23
