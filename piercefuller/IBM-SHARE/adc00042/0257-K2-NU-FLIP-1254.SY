* FLIP       38 12271   SUBROUTINE TO FLIP AN ARRAY                     FLIP0001
*FLIP  SUBROUTINE.  NYU. WRITTEN BY RUTH LEES.                          FLIP0002
*      TAKES MATRIX STORED IN NATURAL ORDER AND                         FLIP0003
*      STORES IT IN INVERSE NATURAL ORDER FOR FORTRAN                   FLIP0004
*      ENTER BY CALL FLIP,A,N,B                                         FLIP0005
*      WHERE   A=INITIAL ADDRESS (LOW ORDER)                            FLIP0006
*              N=ADDRESS OF LOCATION CONTAINING NUMBER OF ELEMENTS (IN  FLIP0007
*                 THE DECREMENT PART)                                   FLIP0008
*              B=LOCATION WHERE FIRST WORD ADDRESS OF FLIPPED ARRAY IS  FLIP0009
*              TO BE STORED.                                            FLIP0010
       COUNT   26                                                       FLIP0011
       ENTRY   FLIP                                                     FLIP0012
 FLIP  SXA     OUT,1                                                    FLIP0013
       SXA     OUT+1,2                                                  FLIP0014
       SXD     FLIP-2,4      FOR NORMAL ERROR PROCEDURE                 FLIP0015
       AXT     1,2                                                      FLIP0016
       CLA*    2,4           N                                          FLIP0017
       ANA     =O77777000000                                            FLIP0018
       PDX     ,1                                                       FLIP0019
       ARS     1             N/2                                        FLIP0020
       STD     MOVE+6                                                   FLIP0021
       ARS     17            N IN ADDRESS                               FLIP0022
       ADD     1,4           A+N                                        FLIP0023
       STA     MOVE                                                     FLIP0024
       STA     MOVE+1                                                   FLIP0025
       SUB     =O1           A+N-1=B                                    FLIP0026
       STA*    3,4           FOR OUTPUT                                 FLIP0027
 MOVE  CLA     **,1          A INITIALLY                                FLIP0028
       LDQ     **,2          B INITIALLY                                FLIP0029
       STQ*    MOVE          A                                          FLIP0030
       STO*    MOVE+1        B                                          FLIP0031
       TXI     *+1,2,1                                                  FLIP0032
       TXI     *+1,1,-1                                                 FLIP0033
       TXL     MOVE,2,0      DECR=N/2                                   FLIP0034
 OUT   AXT     ,1                                                       FLIP0035
       AXT     ,2                                                       FLIP0036
       TRA     4,4                                                      FLIP0037
       END                                                              FLIP0038
