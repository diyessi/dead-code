C         USING HASTINGS'  'MORE BETTER' ERROR FUNCTION   PAGE 169      BVN 001 
      FUNCTION  BVN(A,B,UM,VM,US,VS,R,NINT)                             BVN 002 
    1 XH1 =(A-UM)/US                                                    BVN 003 
      YK1 = (B -VM)/VS                                                  BVN 004 
      S2=1.414213562                                                    BVN 005 
      IF(XH1)4,2,6                                                      BVN 006 
    2 IF(YK1)7,3,9                                                      BVN 007 
    3 BVN = .25 + ASINF(R)/6.283185307                                  BVN 008 
      GO TO 99                                                          BVN 009 
    4 IF(YK1)8,5,5                                                      BVN 010 
    5 AR=-R                                                             BVN 011 
      XH=-XH1                                                           BVN 012 
      YK=YK1                                                            BVN 013 
      AH = ERR169(XH/S2)                                                BVN 014 
      AK = ERR169(YK/S2)                                                BVN 015 
      BB = -1.0                                                         BVN 016 
      ADD = (1.-AK)/2.0                                                 BVN 017 
      GOTO10                                                            BVN 018 
    6 IF(YK1)7,9,9                                                      BVN 019 
    7 AR=-R                                                             BVN 020 
      XH=XH1                                                            BVN 021 
      YK=-YK1                                                           BVN 022 
      AH = ERR169(XH/S2)                                                BVN 023 
      AK = ERR169(YK/S2)                                                BVN 024 
      BB = -1.0                                                         BVN 025 
      ADD = (1. - AH)/2.0                                               BVN 026 
      GOTO10                                                            BVN 027 
    8  XH = -XH1                                                        BVN 028 
      YK=-YK1                                                           BVN 029 
      AR = R                                                            BVN 030 
      AH = ERR169(XH/S2)                                                BVN 031 
      AK = ERR169(YK/S2)                                                BVN 032 
      BB =  1.0                                                         BVN 033 
       ADD = (AH + AK)/2.0                                              BVN 034 
      GOTO10                                                            BVN 035 
    9 XH=XH1                                                            BVN 036 
      YK=YK1                                                            BVN 037 
      AR = R                                                            BVN 038 
      AH = ERR169(XH/S2)                                                BVN 039 
      AK = ERR169(YK/S2)                                                BVN 040 
      BB =  1.0                                                         BVN 041 
      ADD = 0.0                                                         BVN 042 
   10 IF(AR)17,11,12                                                    BVN 043 
   11 VOL = (1. - AH - AK + AH*AK)/4.0                                  BVN 044 
      GO TO 33                                                          BVN 045 
   12 IF(AR-1.0) 22, 14,13                                              BVN 046 
   13 BVN=-1.                                                           BVN 047 
      GO TO 99                                                          BVN 048 
   14 IF(XH - YK)     16,15,15                                          BVN 049 
   15 VOL = (1. - AH)/2.0                                               BVN 050 
      GO TO 33                                                          BVN 051 
   16 VOL = (1. - AK)/2.0                                               BVN 052 
      GO TO 33                                                          BVN 053 
   17 IF (AR + 1.0) 18, 19, 22                                          BVN 054 
   18 BVN=-2.0                                                          BVN 055 
      GO TO 99                                                          BVN 056 
   19 IF ( XH + YK) 33, 20, 20                                          BVN 057 
   20 BVN=0.0                                                           BVN 058 
      GO TO 99                                                          BVN 059 
   22 IF(NINT)23,23,24                                                  BVN 060 
   23 IF (XH - .51) 237,237,231                                         BVN 061 
  231 IF (YK - .51) 238, 238, 232                                       BVN 062 
  232 IF (AR - .949) 233, 234, 234                                      BVN 063 
  233 N = 64                                                            BVN 064 
      GO TO 25                                                          BVN 065 
  234 IF (AR- .9749) 235, 236, 236                                      BVN 066 
  235 N = 128                                                           BVN 067 
      GO TO 25                                                          BVN 068 
  236 N = 256                                                           BVN 069 
       GO TO 25                                                         BVN 070 
  237 IF (XH - .11) 236, 236, 235                                       BVN 071 
  238 IF (YK - .11) 236, 236, 235                                       BVN 072 
   24 N=NINT                                                            BVN 073 
   25 XINTL=(1.570796327+ASINF(AR))/FLOATF(N)                           BVN 074 
      C=XINTL/18.84955592                                               BVN 075 
      Z=1.570796327-ASINF(AR)                                           BVN 076 
      DO31I=1,N                                                         BVN 077 
      IF(I-1)26,26,27                                                   BVN 078 
   26 W = Z                                                             BVN 079 
      GOTO28                                                            BVN 080 
   27 W=Z+FLOATF(I-1)*XINTL                                             BVN 081 
   28 F=EXPF(-.5*(XH**2+YK**2-2.*XH*YK*COSF(W)) *(SINF(W))**(-2))       BVN 082 
      IF(I-1)29,29,30                                                   BVN 083 
   29 VOL=F                                                             BVN 084 
      GOTO31                                                            BVN 085 
   30 VOL=VOL+2.**(-I+2*(I/2)+2)*F                                      BVN 086 
      IF(VOL*.000000001-4.*F)31,31,32                                   BVN 087 
   31 CONTINUE                                                          BVN 088 
   32 VOL=C*VOL                                                         BVN 089 
   33 BVN =BB*VOL + ADD                                                 BVN 090 
   99 RETURN                                                            BVN 091 
      END( 0,1,0,0,0)                                                   BVN 092 
