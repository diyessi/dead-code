      SUBROUTINE PIV1                                                   IP82A785
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP82A786
     1,KC1,BND,ALPHA                                                    IP82A787
      DIMENSION A(77,37),LT(37),B(37),KC(37),JORDER(37),JZEROS(37),KR(77IP82A788
     1),U(77),D(77),INDEX(77),ALPHA(3)                                  IP82A789
      KC1=KR(I1)                                                        IP82A790
      DO 3 J=1,N                                                        IP82A791
    3 B(J)=A(I1,J)                                                      IP82A792
   23 DNM=1.0                                                           IP82A793
      KSIG=0                                                            IP82A794
      TOL=0.0                                                           IP82A795
      J1=JORDER(KC1)                                                    IP82A796
      IF (B(J1)+100000.0)31,30,30                                       IP82A797
   31 V=INTF(-B(J1)/100.0)                                              IP82A798
      DO 32 J=1,N                                                       IP82A799
      BB=B(J)/V                                                         IP82A800
      B(J)=INTF(BB)                                                     IP82A801
      IF (B(J)-BB)32,32,34                                              IP82A802
   34 B(J)=B(J)-1.0                                                     IP82A803
   32 CONTINUE                                                          IP82A804
   27 J1=JORDER(KC1)                                                    IP82A805
   30 IF (B(J1)+1.0)4,5,4                                               IP82A806
    4 KSIG=1                                                            IP82A807
      DIV=-(B(J1))                                                      IP82A808
      DNM=MAX1F(1.0,INTF(DNM*DIV+.5))                                   IP82A809
      IF (DNM-100000.0)8,8,18                                           IP82A810
    8 TOL=.5/DNM                                                        IP82A811
      DO 6 J=1,N                                                        IP82A812
    6 B(J)=B(J)/DIV                                                     IP82A813
    5 ASTR=0.0                                                          IP82A814
      DO 10 I=2,M1                                                      IP82A815
      IF (KR(I)-KC1)11,10,10                                            IP82A816
   11 AA=A(I,1)+A(I,J1)*B(1)                                            IP82A817
      IF (AA+TOL)25,10,10                                               IP82A818
   25 IF (ABSF(ASTR-AA)-TOL)15,15,16                                    IP82A819
   15 IF (KR(I)-KR(I1))17,10,10                                         IP82A820
   16 IF (ASTR-AA)10,999,17                                             IP82A821
  999 STOP 71                                                           IP82A822
   17 ASTR=AA                                                           IP82A823
      I1=I                                                              IP82A824
   10 CONTINUE                                                          IP82A825
      IF (ASTR)14,9,999                                                 IP82A826
   14 KC1=0                                                             IP82A827
      B(1)=ASTR                                                         IP82A828
      DO 13 J=2,N                                                       IP82A829
      B(J)=A(I1,J)+A(I1,J1)*B(J)                                        IP82A830
      IF (B(J)+TOL)20,13,13                                             IP82A831
   20 IF (KC(J)-KC1)13,997,21                                           IP82A832
  997 STOP 73                                                           IP82A833
   21 KC1=KC(J)                                                         IP82A834
   13 CONTINUE                                                          IP82A835
      IF (KC1)24,24,27                                                  IP82A836
    9 IF (KSIG)996,24,18                                                IP82A837
  996 STOP 74                                                           IP82A838
   18 DO 19 J=1,N                                                       IP82A839
      BB=B(J)+TOL                                                       IP82A840
      B(J)=INTF(BB)                                                     IP82A841
      IF (BB)22,19,19                                                   IP82A842
   22 B(J)=B(J)-1.0                                                     IP82A843
   19 CONTINUE                                                          IP82A844
      GO TO 23                                                          IP82A845
   24 RETURN                                                            IP82A846
      END(0,1,0,0,1)                                                    IP82A847
