       STA     HRWEGO+2                                                     0412
       CLA     3,4                                                          0413
       ADD     NP1-3                                                        0414
       STA     HRWEGO+4                                                     0415
       LXA     NP1,2                                                        0416
HRWEGO CLA*    1,4                                                          0417
       CLM                                                                  0418
       LDQ     0,2            A(0)+1 BUILT                                  0419
       DVP*    2,4                                                          0420
       STQ     0,2            C(0)+1 BUILT                                  0421
       TIX     HRWEGO+2,2,1                                                 0422
       STO     E0                                                           0423
  EISN LXA     NP1-1,2                                                      0424
       CLM                                                                  0425
       STO     E0,2                                                         0426
       TIX     EISN+2,2,1                                                   0427
       TRA     OUT2                                                         0428
 QZERO STO     CUE            M-R=0                                         0429
       CLA     1,4                                                          0430
       ADD     NP1-3                                                        0431
