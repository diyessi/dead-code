*     FAP                                                                   0001
       COUNT   700                                                          0002
*      TEVPAP - VARIABLE PRECISION ARITHMETIC PACKAGE                       0003
       ENTRY   SETUP                                                        0004
       ENTRY   CONVRT                                                       0005
       ENTRY   RECNVT                                                       0006
       ENTRY   ADD                                                          0007
       ENTRY   SUB                                                          0008
       ENTRY   MPY                                                          0009
       ENTRY   DIV                                                          0010
       ENTRY   IF                                                           0011
   NP1 COMMON  5                                                            0012
    MP COMMON  3                                                            0013
    NP COMMON  1                                                            0014
    D0 COMMON  51                                                           0015
    E0 COMMON  51                                                           0016
    F0 COMMON  55                                                           0017
    Q0 COMMON  55                                                           0018
*      ----- SETUP -----                                                    0019
 SETUP CLA*    1,4                                                          0020
       STA     NP1-1                                                        0021
       SUB     =1                                                           0022
       STA     NP1-2                                                        0023
       ADD     =2                                                           0024
       STA     NP1                                                          0025
       XCA                                                                  0026
       PXD                                                                  0027
       DVP     =16                                                          0028
       XCA                                                                  0029
       ADD     NP1                                                          0030
       ALS     18                                                           0031
       STD     NP                                                           0032
       CLA*    2,4                                                          0033
       STA     MP                                                           0034
       ALS     18                                                           0035
       STD     MP-2                                                         0036
       CLA     =1                                                           0037
       STO     NP1-3                                                        0038
       ALS     18                                                           0039
       STO     MP-1                                                         0040
       STZ     NP1-4                                                        0041
       TRA     3,4                                                          0042
*      ----- CONVRT -----                                                   0043
CONVRT SXA     IR1,1                                                        0044
       SXA     IR2,2                                                        0045
       LXA     MP,1           IR1 CONTAINS M                                0046
       CLA     NP1-4          C(AC)=0                                       0047
       STD     LOP2+8                                                       0048
       CLA     1,4            A0                                            0049
       ADD     NP1-3          A0+1                                          0050
       STA     LOP2-2                                                       0051
       SUB     MP             A0+1-M                                        0052
       STA     LOP2+4                                                       0053
       SUB     NP1-3          A0+1-M+1                                      0054
       STA     FORE                                                         0055
       STA     FIN                                                          0056
       PXA     0,1                                                          0057
       TZE     STUP-5                                                       0058
  LOP1 CLA     LOP2+4                                                       0059
       STA     LOP2+1                                                       0060
       ADD     NP1-3                                                        0061
       STA     LOP2+4                                                       0062
       LXA     NP1-3,2                                                      0063
       LDQ     0,1            A0+1 BUILT                                    0064
       STQ     HOLDA                                                        0065
  LOP2 LDQ     =10000000000   ASUBM+1, ASUBM+2, )))                         0066
       MPY     0,2                                                          0067
       XCA                                                                  0068
       ADD     HOLDA                                                        0069
       STO     0,2            ASUBM+1,ASUBM+2,...                           0070
       ARS     35                                                           0071
       STQ     HOLDA                                                        0072
       ADD     HOLDA                                                        0073
       TXH     FORE,2,0       BUILT 0,1,2,...,M-1                           0074
       STO     HOLDA                                                        0075
       TXI     LOP2,2,1                                                     0076
  FORE STO     0              BUILT A(M)                                    0077
       CLA     MP-1                                                         0078
       ADD     LOP2+8                                                       0079
       STD     LOP2+8                                                       0080
       TIX     LOP1,1,1                                                     0081
*      PLACING ZEROS FROM  A(M+1) TO A(N)                                   0082
       CLA     NP1                                                          0083
       SUB     MP             N-M+1                                         0084
       PAX     0,1                                                          0085
       CLA*    1,4                                                          0086
       CLM                                                                  0087
  STUP TIX     FIN,1,1                                                      0088
   IR1 AXT     0,1                                                          0089
   IR2 AXT     0,2                                                          0090
       TRA     2,4                                                          0091
   FIN STO     0,1                                                          0092
       TRA     STUP                                                         0093
 HOLDA PZE                                                                  0094
*      ----- RECNVT -----                                                   0095
RECNVT SXA     AUT,1                                                        0096
       SXA     AUT+1,2                                                      0097
       LXA     NP1-4,2                                                      0098
       LXA     NP1,1                                                        0099
       CLA     NP                                                           0100
       STD     FIXER                                                        0101
       CLA     1,4                                                          0102
       ADD     NP1-3                                                        0103
       STA     *+1                                                          0104
       LDQ     **,1                                                         0105
       STQ     D0+1,1                                                       0106
       TIX     *-2,1,1                                                      0107
       XCA                                                                  0108
       CLM                                                                  0109
       LXA     NP1,1                                                        0110
  MULT LDQ     D0+1,1                                                       0111
       DVP     =10000000000                                                 0112
       STQ     D0+1,1                                                       0113
       TIX     MULT,1,1                                                     0114
       STO     F0,2                                                         0115
       TXI     FIXER,2,1                                                    0116
 FIXER TXH     AUT,2,0        DEC. CONTAINS NP(NO. OF LOC. FOR OUTPUT)      0117
       TRA     MULT-2                                                       0118
   AUT AXT     0,1                                                          0119
       AXT     0,2                                                          0120
       TRA     2,4                                                          0121
*      ----- ADD -----                                                      0122
   ADD CLA     =O040000000000                                               0123
       STD     ADD2                                                         0124
       STD     LOOP2+1                                                      0125
       STD     LOOP3+2                                                      0126
       CLA     NP1-4                                                        0127
       CAS*    1,4                                                          0128
       TRA     TESTB          A0 LESS OR = -0                               0129
       NOP                                                                  0130
       CAS*    2,4            A0 GREATER OR = +0                            0131
       TRA     HERE2          A0 AND B0 DIFFER IN SIGN (ADD)                0132
       NOP                                                                  0133
       TRA     HERE           A0 AND B0 SAME SIGN (ADD)                     0134
 TESTB CAS*    2,4                                                          0135
       TRA     HERE                                                         0136
       NOP                                                                  0137
       TRA     HERE2                                                        0138
*      ----- SUB -----                                                      0139
   SUB CLA     =O040200000000                                               0140
       STD     ADD2                                                         0141
       STD     LOOP2+1                                                      0142
       STD     LOOP3+2                                                      0143
       CLA     NP1-4                                                        0144
       CAS*    1,4                                                          0145
       TRA     TESTB2         A0 LESS OR =-0                                0146
       NOP                                                                  0147
       CAS*    2,4            A0 GREATER OR = +0                            0148
       TRA     HERE           A0 AND B0 DIFFER IN SIGN (SUB)                0149
       NOP                                                                  0150
       TRA     HERE2          A0 AND B0 SAME SIGN (SUB)                     0151
TESTB2 CAS*    2,4                                                          0152
       TRA     HERE2                                                        0153
       NOP                                                                  0154
  HERE SXA     SV1,1                                                        0155
       LXA     NP1-4,1                                                      0156
       CLA     1,4                                                          0157
       STA     ADD1                                                         0158
       CLA     2,4                                                          0159
       STA     ADD2                                                         0160
       CLA     3,4                                                          0161
       STA     ADD3                                                         0162
       CLA     NP1-2                                                        0163
       ALS     18                                                           0164
       STD     SUM1                                                         0165
       CLA*    1,4                                                          0166
 LOOP1 ARS     35                                                           0167
  ADD1 ADD     0,1                                                          0168
  ADD2 ADD     0,1                                                          0169
  ADD3 STO     0,1                                                          0170
  SUM1 TXH     TST1,1,0                                                     0171
       TXI     LOOP1,1,1                                                    0172
  TST1 ARS     35                                                           0173
       TNZ     ASOUT                                                        0174
   SV1 AXT     0,1                                                          0175
       TRA     4,4                                                          0176
 ASOUT TSX     ERROR,4                                                      0177
       PZE     0,0,1                                                        0178
 HERE2 SXA     DONE,1                                                       0179
       SXA     GOMAN+2,1                                                    0180
       LXA     NP1,1                                                        0181
       CLA     1,4                                                          0182
       STA     LOOP3+1                                                      0183
       ADD     NP1-3                                                        0184
       STA     LOOP2                                                        0185
       CLA     2,4                                                          0186
       STA     LOOP3+2                                                      0187
       ADD     NP1-3                                                        0188
       STA     LOOP2+1                                                      0189
       CLA     3,4                                                          0190
       STA     LOOP3+3                                                      0191
       ADD     NP1-3                                                        0192
       STA     GOMAN                                                        0193
       CLA     NP1-2                                                        0194
       ALS     18                                                           0195
       STD     LOOP3+5                                                      0196
 LOOP2 CLA     0,1            A0+1 BUILT                                    0197
       ADD     0,1            B0+1 BUILT                                    0198
       TNZ     CHK                                                          0199
       TIX     LOOP2,1,1                                                    0200
       LXA     NP1,1                                                        0201
 GOMAN STO     0,1            C0+1 BUILT                                    0202
       TIX     GOMAN,1,1                                                    0203
       AXT     0,1                                                          0204
       TRA     4,4                                                          0205
   CHK LXA     NP1-4,1                                                      0206
       CLM                                                                  0207
       ACL     NP1-3                                                        0208
       STO     ES                                                           0209
       ALS     35                                                           0210
       SUB     ES                                                           0211
       STO     SIGN                                                         0212
       CLA     ES                                                           0213
 LOOP3 ADD     SIGN                                                         0214
       ADD     0,1            A0 BUILT                                      0215
       ADD     0,1            B0 BUILT                                      0216
       STO     0,1            C0 BUILT                                      0217
       ARS     35                                                           0218
       TXH     DONE,1,0                                                     0219
       TXI     LOOP3,1,1                                                    0220
  DONE AXT     0,1                                                          0221
       TRA     4,4                                                          0222
    ES PZE                                                                  0223
  SIGN PZE                                                                  0224
*      ----- MPY -----                                                      0225
   MPY SXA     SAV1,1                                                       0226
       SXA     SAV2,2                                                       0227
       CAL     1,4                                                          0228
       STA     LODQ           ADDRESS OF A0 TO LODQ                         0229
       CAL     2,4                                                          0230
       STA     MPIE           ADDRESS OF B0 TO MPIE                         0231
       LXA     NP1,1          LOADS 1 WITH N+1                              0232
  STZD STZ     D0+1,1                                                       0233
       TIX     STZD,1,1                                                     0234
       LXA     NP1-4,1        LOADS 1 WITH ZERO (J VALUE)                   0235
       CLA     NP1-2                                                        0236
       ALS     18                                                           0237
       STD     ON             PUTS N-1 IN DECREMENT OF ON                   0238
       STD     IND            PUTS N-1 IN DECREMENT OF IND                  0239
  LAP1 LXA     NP1-4,2                                                      0240
       STZ     E0                                                           0241
  LODQ LDQ     0,2                                                          0242
  MPIE MPY     0,1                                                          0243
       STO     E0-1,2                                                       0244
       XCA                                                                  0245
       ADD     E0,2                                                         0246
       STO     E0,2                                                         0247
       ARS     35                                                           0248
       ADD     E0-1,2                                                       0249
       STO     E0-1,2                                                       0250
   IND TXH     EXT2,2,0                                                     0251
       TXI     LODQ,2,1                                                     0252
  EXT2 PXA     0,1            C(AC)=J                                       0253
       ADD     NP1-3          C(AC)=J+1                                     0254
       PAX     0,2            C(2)=J+1                                      0255
       ADD     LAP1+1                                                       0256
       SUB     NP1            E0+J+1-N-1                                    0257
       STA     TEST                                                         0258
  TEST ZET     0,2                                                          0259
       TRA     MOUT           IF OVERFLOW                                   0260
       TIX     TEST,2,1                                                     0261
       PXA     0,1            C(AC)=J                                       0262
       SSM                    C(AC)=-J                                      0263
       ADD     NP1-2          C(AC)=N-1-J                                   0264
       ALS     18                                                           0265
       STD     TOTAL          DECREMENT OF TOTAL CONTAINS N-1-J             0266
       PXA     0,1                                                          0267
       SSM                    C(AC)=-J                                      0268
       ADD     STZD           D0+1-J                                        0269
       SUB     NP1-3          D0+1-J-1                                      0270
       STA     D1             D0-J                                          0271
       STA     D2             D0-J                                          0272
       CLM                                                                  0273
       PAX     0,2                                                          0274
  LAP2 ARS     35                                                           0275
       ADD     E0,2                                                         0276
 D1    ADD     0,2            D0-J IN ADDRESS                               0277
 D2    STO     0,2            D0-J IN ADDRESS                               0278
 TOTAL TXH     TEST1,2,0                                                    0279
       TXI     LAP2,2,1                                                     0280
 TEST1 ARS     35                                                           0281
       TNZ     MOUT           CHECKS D(N+1) FOR OVERFLOW                    0282
    ON TXH     TSF,1,0        DECREMENT CONTAINS N-1                        0283
       TXI     LAP1,1,1                                                     0284
   TSF LXA     NP1,2                                                        0285
       CLA     3,4                                                          0286
       ADD     NP1-3                                                        0287
       STA     NEAR                                                         0288
   FAR LDQ     D0+1,2         2 CONTAINS N+1                                0289
  NEAR STQ     0,2            ADDRESS CONTAINS C0+1                         0290
       TIX     FAR,2,1                                                      0291
  SAV1 AXT     0,1                                                          0292
  SAV2 AXT     0,2                                                          0293
       TRA     4,4                                                          0294
  MOUT TSX     ERROR,4                                                      0295
       PZE     0,0,2                                                        0296
*      ----- DIV -----                                                      0297
   DIV SXA     GONER,4                                                      0298
       SXA     SAVE1,1                                                      0299
       SXA     SAVE2,2                                                      0300
       NOP     D0                                                           0301
       CLA     2,4                                                          0302
       STA     BR+3                                                         0303
       ADD     NP1-3                                                        0304
       STA     BCHEX+1                                                      0305
       STA     FNDS+1                                                       0306
       ADD     NP1-3                                                        0307
       STA     FNDS+2                                                       0308
       CLA     1,4                                                          0309
       ADD     NP1-3                                                        0310
       STA     CZERO3+6                                                     0311
       STA     ACHEX+1                                                      0312
       STA     ABYONE                                                       0313
       LXA     NP1,1          C(1)=N+1                                      0314
       CLA*    1,4                                                          0315
       CLM                                                                  0316
 BCHEX STO     D0,1                                                         0317
       CLA     0,1            B(0)+1 BUILT                                  0318
       TNZ     ISBEQA                                                       0319
       STO     D0+1,1                                                       0320
       TIX     BCHEX+1,1,1                                                  0321
BSZERO TSX     ERROR,4                                                      0322
       PZE     0,0,3                                                        0323
ISBEQA CLA     1,4                                                          0324
       SUB     2,4                                                          0325
       TZE     BEQA                                                         0326
    BR SXA     RP1,1                                                        0327
       TXH     FNDS,1,1                                                     0328
       CLS     NP1-3                                                        0329
       ADM     0              B(0) BUILT                                    0330
       TNZ     RSZERO                                                       0331
       TRA     BISONE                                                       0332
  FNDS STZ     ESS                                                          0333
       CLA     0,1            B(0)+1                                        0334
       LDQ     0,1                                                          0335
       STO     HOLDBR                                                       0336
       LLS     1                                                            0337
       TOV     ACHEX                                                        0338
       STO     HOLDBR         B(R) IN HOLDBR                                0339
       CLA     ESS                                                          0340
       ADD     NP1-3                                                        0341
       STO     ESS            2**S BUILT IN ESS                             0342
       CLA     HOLDBR                                                       0343
       TRA     FNDS+4                                                       0344
 ACHEX LXA     NP1,2          C(1)=N+1                                      0345
       CLA     0,2            A(0)+1 BUILT                                  0346
       TNZ     AM                                                           0347
       TIX     ACHEX+1,2,1                                                  0348
       TRA     ASZERO                                                       0349
    AM SXA     MP1,2          C(MP1)=M+1                                    0350
       CLA     MP1                                                          0351
       SUB     RP1                                                          0352
       TZE     QZERO          CUE=M+1-R+1,IF ZERO SPECIAL SUBROUTINE        0353
       TPL     QPLUS                                                        0354
       TRA     QNEG           IF NEGATIVE, SPECIAL SUBR                     0355
   RP1 PZE                                                                  0356
   MP1 PZE                                                                  0357
HOLDBR PZE                                                                  0358
   ESS PZE                                                                  0359
ASZERO LXA     NP1,2          IF REACHES THIS POINT,A0 IS ZERO              0360
       CLA     3,4                                                          0361
       ADD     NP1-3          C(2)=0                                        0362
       STA     CZERO1                                                       0363
       CLA*    1,4                                                          0364
       CLM                                                                  0365
       LDQ*    1,4                                                          0366
       DVP     HOLDBR                                                       0367
CZERO1 STQ     0,2            C(0)+1 BUILT                                  0368
       STO     E0+1,2                                                       0369
       TIX     CZERO1,2,1                                                   0370
       TRA     OUT2                                                         0371
BISONE LXA     NP1,2          IF REACHES THIS POINT,B0 IS + OR - ONE        0372
       CLA     3,4                                                          0373
       ADD     NP1-3                                                        0374
       STA     ABYONE+2                                                     0375
       CLA*    1,4                                                          0376
       CLM                                                                  0377
ABYONE LDQ     0,2            A(/)+1 BUILT                                  0378
       DVP*    2,4                                                          0379
       STQ     0,2            C(0)+1 BUILT                                  0380
       STO     E0+1,2                                                       0381
       TIX     ABYONE,2,1                                                   0382
       TRA     OUT2                                                         0383
  BEQA LXA     NP1,1          IF REACHES THIS POINT, B0=A0                  0384
       CLA     3,4                                                          0385
