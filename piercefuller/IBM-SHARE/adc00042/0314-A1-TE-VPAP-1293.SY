       TIX     CZERO2,1,1                                                   0393
       CLA     NP1-3                                                        0394
       STO     0                                                            0395
       TRA     OUT2                                                         0396
  QNEG CLA     3,4                                                          0397
       ADD     NP1-3                                                        0398
       STA     CZERO3+5                                                     0399
CZERO3 LXA     NP1,1                                                        0400
       CLA*    2,4                                                          0401
       CLM                                                                  0402
       XCA                                                                  0403
       MPY*    *+2                                                          0404
       STQ     0,1            C(0)+1 BUILT                                  0405
       CLA     0,1            A(0)+1 BUILT                                  0406
       STO     E0+1,1                                                       0407
       TIX     *-3,1,1                                                      0408
       TRA     OUT2                                                         0409
RSZERO CLA     1,4            IF REACHES THIS POINT,B IS ONLY ONE LOC.      0410
