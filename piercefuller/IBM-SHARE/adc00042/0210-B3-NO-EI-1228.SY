NOEI         86 09121                                                   EI   001
      FUNCTION  EI(X, FLGEI)                                            EI   002
C      FLGEI  =  +, GIVES VALUE OF N MEETING ERROR ALLOWANCE            EI   003
C             = -1, ABSOLUTE VALUE OF X TOO LARGE FOR EXPF---NO CALCN.  EI   004
C        SUPPLY ERROR ALLOWED FOR EXPONENTIAL INTEGRAL TO FLGEI BEFORE  EI   005
C                                      USING FUNCTION.                  EI   006
      XCM  =  8.                                                        EI   007
      XCP  =  16.                                                       EI   008
      NM  =  50                                                         EI   009
      ABX  =  ABSF(X)                                                   EI   010
   10 IF  (X)     11, 70, 13                                            EI   011
   11 IF  (ABX - XCM)     12, 130, 130                                  EI   012
   12 ERR  =  FLGEI                                                     EI   013
      GO TO 15                                                          EI   014
   13 IF  (ABX - XCP)     14, 130, 130                                  EI   015
   14 ERR  =  FLGEI/2.                                                  EI   016
   15 EI  =  .57721567 + LOGF(ABSF(X))                                  EI   017
      DO 20     N  =  1, 5                                              EI   018
   20 EI  =  EI + T(N,X)                                                EI   019
      N  =  6                                                           EI   020
   25 DEL  =  T(N,X)                                                    EI   021
      W  =  DEL/EI                                                      EI   022
      IF  (ABSF(W) - ERR)     28, 28, 40                                EI   023
   28 EI  =  EI + DEL                                                   EI   024
   30 FLGEI  =  N                                                       EI   025
   35 RETURN                                                            EI   026
   40 IF  (N - NM)     50, 60, 60                                       EI   027
   50 EI  =  EI + DEL                                                   EI   028
      N  =  N + 1                                                       EI   029
      GO TO 25                                                          EI   030
   60 WRITE OUTPUT TAPE 6, 200, NM, FLGEI, N, X, DEL, EI, W             EI   031
      GO TO 28                                                          EI   032
   70 EI  =  -1.70140184E38                                             EI   033
      FLGEI  =  0.                                                      EI   034
      GO TO 35                                                          EI   035
  130 IF  (ABX     - 88.028)     140, 140, 185                          EI   036
  140 NMP  =  ABX                                                       EI   037
      IF  (NMP - NM)     141, 142, 142                                  EI   038
  141 NM  =  NMP                                                        EI   039
  142 EI  =  1.                                                         EI   040
      DO 145     N  =  1, 5                                             EI   041
  145 EI  =  EI + V(N,X)                                                EI   042
      N  =  6                                                           EI   043
  150 DEL  =  V(N,X)                                                    EI   044
      W  =  DEL/EI                                                      EI   045
  152 IF  (ABSF(W) - FLGEI)     160, 160, 170                           EI   046
  160 EI  =  EI * EXPF(X)/X                                             EI   047
      FLGEI  =  N - 1                                                   EI   048
      GO TO 35                                                          EI   049
  170 IF  (N - NM)     175, 210, 210                                    EI   050
  175 EI  =  EI + DEL                                                   EI   051
      N  =  N + 1                                                       EI   052
      GO TO 150                                                         EI   053
  185 IF  (X)     190, 195, 195                                         EI   054
  190 EI  =  0.                                                         EI   055
      GO TO 30                                                          EI   056
  195 FLGEI  = -1.                                                      EI   057
      GO TO 35                                                          EI   058
  200 FORMAT  (//41H0EXPONENTIAL INTEGRAL REQUIRES MORE THAN I3, 20H TEREI   059
     1MS FOR ACCURACY E15.8, 12H, SPECIFIED./5H N = I3, 6H, X = E15.8,  EI   060
     2  8H, DEL = E15.8, 18H, SUM N-1 TERMS = E15.8, 6H, W = E15.8//)   EI   061
  210 WRITE OUTPUT TAPE 6, 215, NM, FLGEI, N, X, DEL, EI, W             EI   062
      GO TO 160                                                         EI   063
  215 FORMAT  (// 91H GREATEST ACCURACY OF EXPONENTIAL INTEGRAL OBTAINABEI   064
     1LE ONLY BY OMITTING ALL TERMS FROM NM = I3, 20H ON. THIS GIVES LESEI   065
     2S/6H THAN E15.8, 20H ACCURACY SPECIFIED./5H N = I3, 6H, X = E15.8,EI   066
     3 8H, DEL = E15.8, 18H, SUM N-1 TERMS = E15.8, 6H, W = E15.8//)    EI   067
      END                                                               EI   068
C        T(N,X) RECURSION FOR EXPONENTIAL INTEGRAL CALCULATION          EI   069
      FUNCTION  T(N,X)                                                  EI   070
      IF  (N - 1)     10, 10, 20                                        EI   071
   10 T  =  X                                                           EI   072
   15 RETURN                                                            EI   073
   20 FN  =  N                                                          EI   074
      T  =  T * X * (FN - 1.) / (FN**2)                                 EI   075
      GO TO 15                                                          EI   076
      END                                                               EI   077
C        V(N,X) RECURSION FOR EXPONENTIAL INTEGRAL CALCULATION          EI   078
      FUNCTION  V(N,X)                                                  EI   079
      IF  (N - 1)     10, 10, 20                                        EI   080
   10 V  =  1./X                                                        EI   081
   15 RETURN                                                            EI   082
   20 FN  =  N                                                          EI   083
      V  =  V * FN/X                                                    EI   084
      GO TO 15                                                          EI   085
      END                                                               EI   086
