*WHPSL REM 0055 02131                                                   PSL 0001
*      FAP                                                              PSL 0002
*      PRESSURE OF SATURATED LIQUID (PSL) STEAM TABLE SUBROUTINE        PSL 0003
       COUNT  50                                                        PSL 0004
       ENTRY  PSL                                                       PSL 0005
 PSL   CAS    =O206617777777 T VS 50.                                   PSL 0006
       CAS    =O212540545707 T VS 705.4                                 PSL 0007
       TRA    PSLER          ERROR - T OUT OF RANGE                     PSL 0008
       TRA    PSLER          X                                          PSL 0009
       SXA    PSL1,4                                                    PSL 0010
       AXT    0,4            ASSUME T LESS THAN 200.                    PSL 0011
       FAD    =459.688                                                  PSL 0012
       STO    E+1            T IN DEGREES R                             PSL 0013
       FSB    =1165.086                                                 PSL 0014
       STO    E+2            T - T CRITICAL X                           PSL 0015
       FDP    E+1                                                       PSL 0016
       STQ    E+1            X/(T+459.688)                              PSL 0017
       LDQ    E+2                                                       PSL 0018
       CLS    =505.398                                                  PSL 0019
       TLQ    *+2            O.K.                                       PSL 0020
       AXC    1,4            NO - T GREATER OR EQUAL 200.               PSL 0021
       FMP    PSLD,4                                                    PSL 0022
       FAD    =1.                                                       PSL 0023
       STO    E+3            1.+D*X                                     PSL 0024
       LDQ    PSLD+2,4       E OR C                                     PSL 0025
       TXL    *+4,4,0                                                   PSL 0026
       FMP    E+2                                                       PSL 0027
       FAD    PSLD+4         C                                          PSL 0028
       DUP    2,2                                                       PSL 0029
       XCA                                                              PSL 0030
       FMP    E+2                                                       PSL 0031
       FAD    PSLD+5,4       B                                          PSL 0032
       XCA                                                              PSL 0033
       FMP    E+2                                                       PSL 0034
       FAD    PSLD+7,4       A                                          PSL 0035
       FDP    E+3                                                       PSL 0036
       FMP    E+1                                                       PSL 0037
       FAD    =8.0728362     LN(3206.182)                               PSL 0038
 PSL1  AXT    **,4                                                      PSL 0039
       TRA*   $EXP           ARGUMENT MUST BE IN RANGE                  PSL 0040
 PSLD  DEC    -.001215470111,-.00766360055,-.46203229E-8                PSL 0041
       DEC    1.439870206E-11,-2.96725673E-9,-7.50675994E-3             PSL 0042
       DEC    -.0529739118,7.46908269,7.70517043                        PSL 0043
 PSLER SXD    PSL-2,4                                                   PSL 0044
       CALL   ERROR,BCD                                                 PSL 0045
       PXD    ,0             RETURN 0 FOR ERROR                         PSL 0046
       LXD    PSL-2,4                                                   PSL 0047
       TRA    1,4                                                       PSL 0048
 BCD   BCI    4,TEMPERATURE OUT OF RANGE                                PSL 0049
       OCT    777777777777                                              PSL 0050
*IF T BELOW 200, 149 CYCLES HERE + 122 IN EXP = 271 CYCLES, .59078 MS.  PSL 0051
*OTHERWISE -     168 CYCLES HERE + 122 IN EXP = 290 CYCLES, .63220 MS.  PSL 0052
       COMMON -168                                                      PSL 0053
 E     COMMON -1             USES E+1 - E+3                             PSL 0054
       END                                                              PSL 0055
