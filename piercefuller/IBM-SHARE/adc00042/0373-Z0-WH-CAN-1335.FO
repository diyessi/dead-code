*     LIST                                                               CAN0001
C CAN  CYLINDER ANALYSIS PROGRAM                                         CAN0002
      COMMON R(50),R1(50),R2(50),R3(50),R4(50),R5(50),R6(50),R7(50),     CAN0003
     1R8(50),R9(50),R10(50),P2A(51),P1A(51),P2E(51),P1E(51),EF2(51),     CAN0004
     2EF1(51),Q2(51),Q1(51),PR(51),PE(51),E,XMU,K,ITITLE(24),V2(51),PI,  CAN0005
     3ITAPE,JTAPE,CIND,AAA,XMI,XPI,V1(51),V16(51),V17(51),V18(51),V19(51 CAN0006
     4),V20(51),V22(51),B12(51),S2(51),V25(51),C1(51),V51(51),V52(51),   CAN0007
     5V53(51),V54(51),C2(51),C3(51),C4(51),PSI2(51),E7(51),E8(51),E9(51) CAN0008
     6,E10(51),E11(51),E12(51),U2(51),DEF2(51),XM2(51),XP2(51),U1(51),   CAN0009
     7DEF1(51),XM3(51),XP3(51),XM5(51),XP4(51),H1(51),H2(51),RS2(51),    CAN0010
     8RS1(51),AB1(51),AB2(51),AX1(51),AX2(51),TI(51),XP5(51),XM4(51),    CAN0011
     9 LCL, DEL(51),HP1(51),HP2(51),HL1(51),HL2(51),HA(51),R1U(51)       CAN0012
      COMMON AXA(51),SI1(51),SI2(51),SI3(51),DR(51),RSA(51),IPAGE,LGPH,  CAN0013
     1LEXT,V21(51),R11(50),R12(50),T1(51),T2(51)                         CAN0014
      EQUIVALENCE  (P1A,E7,XM2),(P2A,E8,XP2),(P1E,E9,U1),(P2E,E10,U2),   CAN0015
     1(EF1,E11,DEF1),(EF2,E12,DEF2),(Q1,C1,XP3),(Q2,C2,XM3),(C3,XP4),    CAN0016
     2(C4,XP5),(B12,XM4),(PSI2,XM5),(T1,RS1),(T2,RS2),(V16,DEL),(V17,DR) CAN0017
     3,(V18,HP1,H1),(V19,HP2,H2),(V20,HL1,AX1),(V22,HL2,AX2),(V51,AXA),  CAN0018
     4(V52,RSA),(V53,SI2),(V54,SI1),(V25,HA),(TI,SI3)                    CAN0019
      DIMENSION HH1(2),HH2(8)                                            CAN0020
      PI = 3.1415927                                                     CAN0021
      ITAPE = 5                                                          CAN0022
      JTAPE = 6                                                          CAN0023
 2    READ INPUT TAPE ITAPE,2001,ITITLE                                  CAN0024
 2001 FORMAT (12A6)                                                      CAN0025
      READ INPUT TAPE ITAPE,8000,E,XMU,AAA,CIND,AL,AG,AE                 CAN0026
      K = AAA                                                            CAN0027
      LGPH = AG                                                          CAN0028
      LEXT = AE                                                          CAN0029
      LCL=AL                                                             CAN0030
      IF (CIND   ) 1,1,3                                                 CAN0031
1     READ INPUT TAPE ITAPE,8000,(R9(I),R1(I),R10(I),R2(I),V2(I),T1(I),  CAN0032
     1R11(I),Q1(I),R4(I),P1E(I),R6(I),P1A(I),R8(I),EF1(I),PE(I),PR(I),   CAN0033
     2EF2(I),T2(I),R12(I),Q2(I),R3(I),P2E(I),R5(I),P2A(I),R7(I),I=1,K )  CAN0034
      GO TO 85                                                           CAN0035
3     READ INPUT TAPE ITAPE,8000,(W1,W1,W1,W1,W1   ,T1(I),               CAN0036
     1R11(I),Q1(I),R4(I),P1E(I),R6(I),P1A(I),R8(I),EF1(I),PE(I),PR(I),   CAN0037
     2EF2(I),T2(I),R12(I),Q2(I),R3(I),P2E(I),R5(I),P2A(I),R7(I),I=1,K )  CAN0038
85    XPI=1.+XMU                                                         CAN0039
      XMI = 1.-XMU                                                       CAN0040
      DO 107 I=1,K                                                       CAN0041
      I=I                                                                CAN0042
      IF(CIND) 81,81,100                                                 CAN0043
 81   IF (R9(I)) 82,82,83                                                CAN0044
 82   R9(I)= R1(I)                                                       CAN0045
83    IF(R1(I)) 820,820,830                                              CAN0046
820   R1(I)=R9(I)                                                        CAN0047
830   IF(R10(I)) 84,84,990                                               CAN0048
 84   R10(I) =R2(I)                                                      CAN0049
990   IF(R2(I)) 840,840,991                                              CAN0050
840   R2(I)=R10(I)                                                       CAN0051
991   IF(R1(I)-R2(I)) 841,842,843                                        CAN0052
841   W2=R1(I)                                                           CAN0053
      R1(I)=R2(I)                                                        CAN0054
      R2(I)=W2                                                           CAN0055
      WRITE OUTPUT TAPE JTAPE,2003,I                                     CAN0056
843   IF(R9(I)-R10(I))844,81,99                                          CAN0057
844   W2=R9(I)                                                           CAN0058
      R9(I)=R10(I)                                                       CAN0059
      R10(I)=W2                                                          CAN0060
      WRITE OUTPUT TAPE JTAPE,2003,I                                     CAN0061
 99   R(I)=(2./3.)*(R1(I)+R2(I)-(R1(I)*R2(I))/(R1(I)+R2(I)))             CAN0062
 100  TI(I)=    ( R1(I)-R2(I))**3*(R1(I)**2+4.*R1(I)*R2(I)+R2(I)**2)     CAN0063
 101  TI(I)= TI(I)/(24.*(R1(I)**2+R1(I)*R2(I)+R2(I)**2)* XMI *XPI)       CAN0064
102   W1=(R9(I)+R10(I))*(R1(I)-R2(I))**3*(R1(I)**2+4.*R1(I)*R2(I)+R2(I)* CAN0065
     1*2)                                                                CAN0066
      V1(I)=18.*XPI*XMI*(R9(I)-R10(I))*(R1(I)+R2(I))/W1                  CAN0067
104   V1(I)=SQRTF(V1(I))                                                 CAN0068
 105  V1(I)= SQRTF (V1(I))                                               CAN0069
106   IF(R1(I)-R2(I)) 841,842,107                                        CAN0070
 107  CONTINUE                                                           CAN0071
      CALL OUTINP                                                        CAN0072
992   CALL PHI                                                           CAN0073
      CALL GEO (ADR)                                                     CAN0074
      CALL CALCM                                                         CAN0075
      CALL STRESS  (ADR)                                                 CAN0076
993   CALL OUTPUT                                                        CAN0077
      IF(LGPH) 2,2,4                                                     CAN0078
4     W=0.                                                               CAN0079
      DO 75 I=1,K                                                        CAN0080
      W=W+V2(I)                                                          CAN0081
      H2(I+1)=W                                                          CAN0082
75    H1(I+1)=W                                                          CAN0083
      H2(1)=0.                                                           CAN0084
      H1(1)=0.                                                           CAN0085
      DEF1(K+1)=DEF2(K)                                                  CAN0086
      U1(K+1)=U2(K)                                                      CAN0087
      K=K+1                                                              CAN0088
      NCUVE=3                                                            CAN0089
      NAB=100                                                            CAN0090
      NORD=39                                                            CAN0091
      NIS=2                                                              CAN0092
      CALL NAME(HH1,HH2,6HROTATI,6HON    ,6HRADIAL,6H      ,6HCUMULA,    CAN0093
     16HTIVE  ,6HLENGTH)                                                 CAN0094
      CALL PLOT (NCUVE,K,NAB,NORD,NIS,H2,DEF1,U1,DEL,U2,ITITLE,HH1,HH2)  CAN0095
      CALL NAME(HH1,HH2,6HOUTSID,6HE     ,6HINSIDE,6H      ,6HMEMBRA,    CAN0096
     16HNE    ,6HLENGTH)                                                 CAN0097
      NIS=1                                                              CAN0098
      CALL PLOT (NCUVE,K,NAB,NORD,NIS,H1,SI1,SI2,SI3,U1,ITITLE,HH1,HH2)  CAN0099
      GO TO 2                                                            CAN0100
842   WRITE OUTPUT TAPE JTAPE,2002                                       CAN0101
2002  FORMAT(1H1 //////7X,    27HCHECK DATA FOR THIS PROBLEM /7X,    38H CAN0102
     1THE OUTSIDE AND INSIDE RADII ARE EQUAL /7X, 30HTHERE HAVE BEEN NO  CAN0103
     2CALCULATION )                                                      CAN0104
      CALL OUTINP                                                        CAN0105
      GO TO 2                                                            CAN0106
8000  FORMAT(5E14.0)                                                     CAN0107
2003  FORMAT(//////// 20X,45HTHIS PROBLEM  REQUIRED CHANGING RADII ON RI CAN0108
     1NG   I3)                                                           CAN0109
      END                                                                CAN0110
*      LIST                                                              CAN0111
      SUBROUTINE OUTINP                                                  CAN0112
C PRINTS THE INPUT                                                       CAN0113
      COMMON R(50),R1(50),R2(50),R3(50),R4(50),R5(50),R6(50),R7(50),     CAN0114
     1R8(50),R9(50),R10(50),P2A(51),P1A(51),P2E(51),P1E(51),EF2(51),     CAN0115
     2EF1(51),Q2(51),Q1(51),PR(51),PE(51),E,XMU,K,ITITLE(24),V2(51),PI,  CAN0116
     3ITAPE,JTAPE,CIND,AAA,XMI,XPI,V1(51),V16(51),V17(51),V18(51),V19(51 CAN0117
     4),V20(51),V22(51),B12(51),S2(51),V25(51),C1(51),V51(51),V52(51),   CAN0118
     5V53(51),V54(51),C2(51),C3(51),C4(51),PSI2(51),E7(51),E8(51),E9(51) CAN0119
     6,E10(51),E11(51),E12(51),U2(51),DEF2(51),XM2(51),XP2(51),U1(51),   CAN0120
     7DEF1(51),XM3(51),XP3(51),XM5(51),XP4(51),H1(51),H2(51),RS2(51),    CAN0121
     8RS1(51),AB1(51),AB2(51),AX1(51),AX2(51),TI(51),XP5(51),XM4(51),    CAN0122
     9 LCL, DEL(51),HP1(51),HP2(51),HL1(51),HL2(51),HA(51),R1U(51)       CAN0123
      COMMON AXA(51),SI1(51),SI2(51),SI3(51),DR(51),RSA(51),IPAGE,LGPH,  CAN0124
     1LEXT,V21(51),R11(50),R12(50),T1(51),T2(51)                         CAN0125
      EQUIVALENCE  (P1A,E7,XM2),(P2A,E8,XP2),(P1E,E9,U1),(P2E,E10,U2),   CAN0126
     1(EF1,E11,DEF1),(EF2,E12,DEF2),(Q1,C1,XP3),(Q2,C2,XM3),(C3,XP4),    CAN0127
     2(C4,XP5),(B12,XM4),(PSI2,XM5),(T1,RS1),(T2,RS2),(V16,DEL),(V17,DR) CAN0128
     3,(V18,HP1,H1),(V19,HP2,H2),(V20,HL1,AX1),(V22,HL2,AX2),(V51,AXA),  CAN0129
     4(V52,RSA),(V53,SI2),(V54,SI1),(V25,HA),(TI,SI3)                    CAN0130
      NF=1                                                               CAN0131
      NSET=1                                                             CAN0132
      MC=17                                                              CAN0133
      IPAGE =1                                                           CAN0134
      WRITE OUTPUT TAPE JTAPE, 2000,IPAGE                                CAN0135
 2000 FORMAT (1H1   5X81H WESTINGHOUSE CAN 62 PROGRAM FOR DIGITAL COMPUT CAN0136
     1ER WITH FORTRAN INTERPETIVE SYSTEM10X8HPAGE NO I3,   /  6X    80H  CAN0137
     2(SHORT CYLINDER GROUP SOLUTION FOR AXISYMMETRIC BODIES WITH IRREGU CAN0138
     3LAR OUTLINE) //)                                                   CAN0139
      WRITE OUTPUT TAPE JTAPE,2002, ITITLE                               CAN0140
 2002 FORMAT (35X 12A6)                                                  CAN0141
      IF(CIND   ) 2104,2104,2105                                         CAN0142
2104  WRITE OUTPUT TAPE JTAPE,2016                                       CAN0143
2016  FORMAT(// 6X,35H NEW GEOMETRY USED IN THIS PROBLEM   )             CAN0144
      GO TO 60                                                           CAN0145
2105  WRITE OUTPUT TAPE JTAPE,2017                                       CAN0146
2017  FORMAT(// 6X,35H OLD GEOMETRY USED IN THIS PROBLEM   )             CAN0147
      GO TO 60                                                           CAN0148
60    IF(LCL) 61,61,62                                                   CAN0149
61    WRITE OUTPUT TAPE JTAPE,2050                                       CAN0150
2050  FORMAT( 7X,42HLOCAL FLEXIBILITY NOT USED IN THIS PROBLEM  )        CAN0151
      GO TO 63                                                           CAN0152
62    WRITE OUTPUT TAPE JTAPE,2051                                       CAN0153
2051  FORMAT( 7X,38HLOCAL FLEXIBILITY USED IN THIS PROBLEM  )            CAN0154
63    WRITE OUTPUT TAPE JTAPE,2052,E,XMU                                 CAN0155
2052  FORMAT (7X,24HMODULUS OF ELASTICITY = F9.0,4X,16HPOISSON RATIO =   CAN0156
     1F8.4 //)                                                           CAN0157
      GO TO 17                                                           CAN0158
1     IPAGE =IPAGE +1                                                    CAN0159
      WRITE OUTPUT TAPE JTAPE,2036,IPAGE                                 CAN0160
 2036 FORMAT (1H198X, 8HPAGE NO.  I3 )                                   CAN0161
17    GO TO (2,3,4,200),NSET                                             CAN0162
2     WRITE OUTPUT TAPE JTAPE,2003                                       CAN0163
2003  FORMAT(//  3X,13HCYL.  OUTSIDE 6X,7HOUTSIDE 9X, 6HINSIDE 7X,6HINSI CAN0164
     2DE 13X, 6HLENGTH 10X,2HT1 11X,3HRT1 /3X,3HNO. 3X,11HHOOP RADIUS    CAN0165
     32X,14HBENDING RADIUS 2X,11HHOOP RADIUS 2X,14HBENDING RADIUS 5X,    CAN0166
     46HINCHES 10X,3HLBS 9X, 6HINCHES /9X,6HINCHES 7X,6HINCHES 10X,      CAN0167
     56HINCHES 7X,6HINCHES //)                                           CAN0168
      GO TO 5                                                            CAN0169
3     WRITE OUTPUT TAPE JTAPE,2004                                       CAN0170
2004  FORMAT(// 3X,4HCYL. 6X,3HQ1  11X,3HRQ1 12X,3HPO1 11X,3HRO1 13X,    CAN0171
     23HPA1 10X,3HRA1 11X,2HF1/3X,3HNO.7X,3HLBS 11X,3HIN.12X,3HPSI 11X,  CAN0172
     33HIN. 13X,3HPSI 10X,3HIN.11X 3HLBS  //)                            CAN0173
      GO TO 5                                                            CAN0174
4     WRITE OUTPUT TAPE JTAPE,2005                                       CAN0175
2005  FORMAT(// 3X,4HCYL. 6X,3HPOR 11X,3HPIR 12X, 3HF2 11X, 3HT2 13X,    CAN0176
     13HRT2 10X,3HQ2 11X,3HRQ2 /3X,3HNO.7X,3HLBS 11X,3HLBS 12X 3HLBS     CAN0177
     211X,3HLBS 13X,3HIN.10X,3HLBS 11X,3HIN. //)                         CAN0178
      GO TO 5                                                            CAN0179
200   WRITE OUTPUT TAPE JTAPE,2021                                       CAN0180
2021  FORMAT(// 3X,4HCYL. 6X,3HPO2 11X,3HRO2 12X, 3HPA211X, 3HRA2 /3X,   CAN0181
     13HNO. 7X, 3HPSI 11X,3HIN.12X,3HPSI 11X,3HIN. //)                   CAN0182
5     DO 6 I=NF,K                                                        CAN0183
      I=I                                                                CAN0184
      MC=MC+1                                                            CAN0185
      GO TO (7,8,9,201),NSET                                             CAN0186
7     WRITE OUTPUT TAPE JTAPE,2006,I,R9(I),R1(I),R10(I),R2(I),V2(I),     CAN0187
     1T1(I),R11(I)                                                       CAN0188
      GO TO 10                                                           CAN0189
8     WRITE OUTPUT TAPE JTAPE,2206,I,Q1(I),R4(I),P1E(I),R6(I),P1A(I),    CAN0190
     1R8(I),EF1(I)                                                       CAN0191
      GO TO 10                                                           CAN0192
9     WRITE OUTPUT TAPE JTAPE,2216,I,PE(I),PR(I),EF2(I),T2(I),R12(I),    CAN0193
     1Q2(I),R3(I)                                                        CAN0194
      GO TO 10                                                           CAN0195
201   WRITE OUTPUT TAPE JTAPE,2022,I,P2E(I),R5(I),P2A(I),R7(I)           CAN0196
10    IF(K-I)   6,6,20                                                   CAN0197
20    IF (MC-44) 6,11,11                                                 CAN0198
6     CONTINUE                                                           CAN0199
13    GO TO (14,15,202,16 ), NSET                                        CAN0200
14    NSET = 2                                                           CAN0201
18    NF=1                                                               CAN0202
      MC=MC+5                                                            CAN0203
      IF(MC-35) 17,21,21                                                 CAN0204
21    MC=6                                                               CAN0205
      GO TO 1                                                            CAN0206
15    NSET =3                                                            CAN0207
      GO TO 18                                                           CAN0208
202   NSET =4                                                            CAN0209
      GO TO 18                                                           CAN0210
11    NF=I +1                                                            CAN0211
      GO TO 21                                                           CAN0212
16    RETURN                                                             CAN0213
2022  FORMAT(I6,F14.4,F13.6,F15.4,F15.6)                                 CAN0214
2216  FORMAT(I6,F14.4,F13.4,F15.4,F15.4,F15.6,F14.4,F13.6)               CAN0215
2206  FORMAT(I6,F13.4,F14.6,F15.4,F15.6,F15.4,F14.6,F13.4)               CAN0216
2006  FORMAT(I6,2F13.6,3X,2F13.6,3X,F14.6,F15.4,F12.6)                   CAN0217
      END                                                                CAN0218
*     LIST                                                               CAN0219
      SUBROUTINE  PHI                                                    CAN0220
C CALCULATION OF PHI TERMS WITH PHI = V                                  CAN0221
      COMMON R(50),R1(50),R2(50),R3(50),R4(50),R5(50),R6(50),R7(50),     CAN0222
     1R8(50),R9(50),R10(50),P2A(51),P1A(51),P2E(51),P1E(51),EF2(51),     CAN0223
     2EF1(51),Q2(51),Q1(51),PR(51),PE(51),E,XMU,K,ITITLE(24),V2(51),PI,  CAN0224
     3ITAPE,JTAPE,CIND,AAA,XMI,XPI,V1(51),V16(51),V17(51),V18(51),V19(51 CAN0225
     4),V20(51),V22(51),B12(51),S2(51),V25(51),C1(51),V51(51),V52(51),   CAN0226
     5V53(51),V54(51),C2(51),C3(51),C4(51),PSI2(51),E7(51),E8(51),E9(51) CAN0227
     6,E10(51),E11(51),E12(51),U2(51),DEF2(51),XM2(51),XP2(51),U1(51),   CAN0228
     7DEF1(51),XM3(51),XP3(51),XM5(51),XP4(51),H1(51),H2(51),RS2(51),    CAN0229
     8RS1(51),AB1(51),AB2(51),AX1(51),AX2(51),TI(51),XP5(51),XM4(51),    CAN0230
     9 LCL, DEL(51),HP1(51),HP2(51),HL1(51),HL2(51),HA(51),R1U(51)       CAN0231
      COMMON AXA(51),SI1(51),SI2(51),SI3(51),DR(51),RSA(51),IPAGE,LGPH,  CAN0232
     1LEXT,V21(51),R11(50),R12(50),T1(51),T2(51)                         CAN0233
      EQUIVALENCE  (P1A,E7,XM2),(P2A,E8,XP2),(P1E,E9,U1),(P2E,E10,U2),   CAN0234
     1(EF1,E11,DEF1),(EF2,E12,DEF2),(Q1,C1,XP3),(Q2,C2,XM3),(C3,XP4),    CAN0235
     2(C4,XP5),(B12,XM4),(PSI2,XM5),(T1,RS1),(T2,RS2),(V16,DEL),(V17,DR) CAN0236
     3,(V18,HP1,H1),(V19,HP2,H2),(V20,HL1,AX1),(V22,HL2,AX2),(V51,AXA),  CAN0237
     4(V52,RSA),(V53,SI2),(V54,SI1),(V25,HA),(TI,SI3)                    CAN0238
C  K= NO OF RINGS                                                        CAN0239
C  V1,V2, AND V4 TO BE INPUT                                             CAN0240
      DO 125  I= 1,K                                                     CAN0241
      V3    = V1(I) * V2(I)                                              CAN0242
117   IF(V3   -35.) 108 ,108 ,1201                                       CAN0243
 108  F1  = SINF(V3   )                                                  CAN0244
 109  F2  = COSF(V3   )                                                  CAN0245
 110  EX1 = EXPF(V3   )                                                  CAN0246
 111  EX2  = 1./EX1                                                      CAN0247
 112  F3   = .5* EX1 - .5* EX2                                           CAN0248
 113  F4   = .5* EX1 + .5* EX2                                           CAN0249
 114  IF (V3   -.05) 115,115,1171                                        CAN0250
 115  F5 =(F3+F1)*(V3   **3/3.+V3   **7/2520.)                           CAN0251
 116  GO TO 118                                                          CAN0252
1201   W2=1./(2.*(TI(I)/(XMI*XPI))*V1(I))                                CAN0253
1202  V16(I)= W2/V1(I)                                                   CAN0254
1203  V17(I)= -V16(I)/V1(I)                                              CAN0255
1204  V19(I)=  0.                                                        CAN0256
1205  V18(I)= 0.                                                         CAN0257
1206  V20(I)=  W2*2.                                                     CAN0258
1207  V22(I)=  0.                                                        CAN0259
      GO TO 125                                                          CAN0260
 1171 F5 = F3**2 - F1**2                                                 CAN0261
118   F6=2.*(TI(I)/(XMI*XPI))*V1(I)                                      CAN0262
 119  F6  = F5 * F6                                                      CAN0263
 120  V16(I)=(F1**2 +F3**2)/(F6*V1(I))                                   CAN0264
 121  V17(I)=-(F3*F4 -F1*F2)/(F6*V1(I)**2)                               CAN0265
 122  V18(I)=(-2.*F3*F1)/(F6* V1(I))                                     CAN0266
 123  V19(I)= -(F3*F2-F4*F1)/(F6 *V1(I)**2)                              CAN0267
 124  V20(I)= 2.*(F3*F4 +F1*F2)/F6                                       CAN0268
 1251 V22(I) = -2. * (F3*F2+F4*F1)/F6                                    CAN0269
 125  CONTINUE                                                           CAN0270
      IF(LCL) 1219,1219,1250                                             CAN0271
1250  DO 1221 J=1,K                                                      CAN0272
      I=J                                                                CAN0273
      IF(K-I) 1221,1221,1209                                             CAN0274
1209  F1= R1(I)-R2(I)                                                    CAN0275
      F2= R1(I+1)-R2(I+1)                                                CAN0276
      F3= F1/F2                                                          CAN0277
      IF(F3-1.7)1210,1211,1211                                           CAN0278
1210  IF(F3-.58  )126 ,126 ,1221                                         CAN0279
126    I=J+1                                                             CAN0280
1211  IF(R(I)-.5) 1215,1216,1216                                         CAN0281
1215  F1=0.                                                              CAN0282
      GO TO 1217                                                         CAN0283
1216  W1=  (R(I)+.5)* LOGF(R(I)+.5)-(R(I)-.5)*LOGF(R(I)-.5)+.5           CAN0284
      W2= 1.408 * XMI * XPI  * W1                                        CAN0285
      W1=1./(1.+(.491*XMI*XPI*W1*W1**.3333)/R(I)**2)                     CAN0286
      W1= SQRTF(SQRTF(W1**3))                                            CAN0287
      F1= W2/W1                                                          CAN0288
1217  W1=SQRTF(1.+.277/R(I)**2)                                          CAN0289
      F2= 1.238 /W1                                                      CAN0290
      W1=SQRTF(SQRTF(1. +.347/R(I)**2))                                  CAN0291
      F4= 5.78/W1                                                        CAN0292
      V20(I)= V20(I) +  F4                                               CAN0293
      V16(I)= V16(I) + F2                                                CAN0294
1221  V17(I)= V17(I) - F1                                                CAN0295
1219  RETURN                                                             CAN0296
      END                                                                CAN0297
*     LIST                                                               CAN0298
      SUBROUTINE  GEO  (ADR)                                             CAN0299
C LOADING TERMS DUE TO GEOMETRY                                          CAN0300
      COMMON R(50),R1(50),R2(50),R3(50),R4(50),R5(50),R6(50),R7(50),     CAN0301
     1R8(50),R9(50),R10(50),P2A(51),P1A(51),P2E(51),P1E(51),EF2(51),     CAN0302
     2EF1(51),Q2(51),Q1(51),PR(51),PE(51),E,XMU,K,ITITLE(24),V2(51),PI,  CAN0303
     3ITAPE,JTAPE,CIND,AAA,XMI,XPI,V1(51),V16(51),V17(51),V18(51),V19(51 CAN0304
     4),V20(51),V22(51),B12(51),S2(51),V25(51),C1(51),V51(51),V52(51),   CAN0305
     5V53(51),V54(51),C2(51),C3(51),C4(51),PSI2(51),E7(51),E8(51),E9(51) CAN0306
     6,E10(51),E11(51),E12(51),U2(51),DEF2(51),XM2(51),XP2(51),U1(51),   CAN0307
     7DEF1(51),XM3(51),XP3(51),XM5(51),XP4(51),H1(51),H2(51),RS2(51),    CAN0308
     8RS1(51),AB1(51),AB2(51),AX1(51),AX2(51),TI(51),XP5(51),XM4(51),    CAN0309
     9 LCL, DEL(51),HP1(51),HP2(51),HL1(51),HL2(51),HA(51),R1U(51)       CAN0310
      COMMON AXA(51),SI1(51),SI2(51),SI3(51),DR(51),RSA(51),IPAGE,LGPH,  CAN0311
     1LEXT,V21(51),R11(50),R12(50),T1(51),T2(51)                         CAN0312
      EQUIVALENCE  (P1A,E7,XM2),(P2A,E8,XP2),(P1E,E9,U1),(P2E,E10,U2),   CAN0313
     1(EF1,E11,DEF1),(EF2,E12,DEF2),(Q1,C1,XP3),(Q2,C2,XM3),(C3,XP4),    CAN0314
     2(C4,XP5),(B12,XM4),(PSI2,XM5),(T1,RS1),(T2,RS2),(V16,DEL),(V17,DR) CAN0315
     3,(V18,HP1,H1),(V19,HP2,H2),(V20,HL1,AX1),(V22,HL2,AX2),(V51,AXA),  CAN0316
     4(V52,RSA),(V53,SI2),(V54,SI1),(V25,HA),(TI,SI3)                    CAN0317
      S1=0.                                                              CAN0318
      ADR=(T1(1)+Q1(1)-(P1A(1)*(R8(1)**2-R2(1)**2)-P1E(1)*(R1(1)**2-     CAN0319
     1R6(1)**2))*PI)/(PI*(R1(1)**2-R2(1)**2))                            CAN0320
      DO 147 I=1,K                                                       CAN0321
 127  A    = .5/(R(I)*PI)                                                CAN0322
      B16 = A * (R(I)-R12(I))                                            CAN0323
      B15 = A * (R(I)-R11(I))                                            CAN0324
 128  B1   = A    *(R(I) - R4(I))                                        CAN0325
 138  B7   = A   * PI*(R8(I)**2-R2(I)**2)                                CAN0326
 139  B8   = A   * PI*(R1(I)**2 - R6(I)**2)                              CAN0327
 140  B9   = A   * PI *(R7(I)**2 -R2(I)**2)                              CAN0328
 141  B10    = A   *PI *(R1(I)**2 -R5(I)**2)                             CAN0329
130   B2   =B7   *  ( 2.*(R2(I)**2+R2(I)*R8(I)+R8(I)**2)/(3.*(R2(I)+R8(I CAN0330
     1))) -R(I))                                                         CAN0331
132   B3   =B8   *  ( 2.*(R1(I)**2+R1(I)*R6(I)+R6(I)**2)/(3.*(R1(I)+R6(I CAN0332
     1))) -R(I))                                                         CAN0333
 133  B4   = A   * (R(I) - R3(I))                                        CAN0334
135   B5   =B9   *  ( 2.*(R2(I)**2+R2(I)*R7(I)+R7(I)**2)/(3.*(R2(I)+R7(I CAN0335
     1))) -R(I))                                                         CAN0336
137   B6   =B10   * ( 2.*(R1(I)**2+R1(I)*R5(I)+R5(I)**2)/(3.*(R1(I)+R5(I CAN0337
     1))) -R(I))                                                         CAN0338
C TRANSMITTED CONSTANTS                                                  CAN0339
 143  V51(I)= Q1(I) * B1   + P1A(I)*B2   + P1E(I)* B3 +T1(I)*B15         CAN0340
 144  V52(I)= Q2(I) * B4   + P2A(I)*B5   + P2E(I)* B6+T2(I)*B16          CAN0341
 145  V53(I)= EF1(I)*A                                                   CAN0342
 146  V54(I)= EF2(I)*A                                                   CAN0343
      S2(I)=S1   +Q1(I)*A   -P1A(I)*B7   -P1E(I)*B8   -Q2(I)*A           CAN0344
     1+P2A(I)*B9   +P2E(I)* B10    +T1(I)*A -T2(I)*A                     CAN0345
      IF (I-K) 1470,1472,1472                                            CAN0346
 1470 B12(I) = R(I)/R(I+1)                                               CAN0347
      GO TO 1471                                                         CAN0348
 1472 B12(I) = 0.                                                        CAN0349
      GO TO 147                                                          CAN0350
 1471 S1      =S2(I)*B12(I)                                              CAN0351
 147  CONTINUE                                                           CAN0352
C CONSTANT ADDED TO DEFLECTION GEOMETRY AND LOAD DEPENDENT               CAN0353
 148  DO 158  I=1,K                                                      CAN0354
 149  B11   = R9(I)**2-R10(I)**2                                         CAN0355
 150  V25(I)=((R9(I)**2*R10(I)**2)/(  B11   ))*(XPI* 1./R(I))            CAN0356
 151  V25(I)= V25(I)*(PR(I)-PE(I))+R(I)*XMI*(PR(I)*R10(I)**2-PE(I)*R9(I) CAN0357
     1**2)/   B11                                                        CAN0358
C CONSTANT IN  EQUATIONS WITH M AND P NOW STAR M AND P                   CAN0359
 153  C1(I) = V16(I)*V51(I)+V17(I)*V53(I)+V18(I)*V52(I)+V19(I)*V54(I)    CAN0360
 154 1+V25(I)                                                            CAN0361
 155  C2(I) =V20(I)*V51(I)-V16(I)*V53(I)+V22(I)*V52(I) -V18(I)*V54(I)    CAN0362
 156  C3(I)= V18(I)*V51(I)+V19(I)*V53(I)+V16(I)*V52(I)                   CAN0363
 157 1+V17(I)*V54(I)+ V25(I)                                             CAN0364
 158  C4(I)= -V22(I)*V51(I)+V18(I)*V53(I)-V20(I)*V52(I)+V16(I)*V54(I)    CAN0365
      RETURN                                                             CAN0366
      END                                                                CAN0367
*     LIST                                                               CAN0368
      SUBROUTINE  CALCM                                                  CAN0369
C INITIAL RING WITH M1 AND P1 = 0                                        CAN0370
      COMMON R(50),R1(50),R2(50),R3(50),R4(50),R5(50),R6(50),R7(50),     CAN0371
     1R8(50),R9(50),R10(50),P2A(51),P1A(51),P2E(51),P1E(51),EF2(51),     CAN0372
     2EF1(51),Q2(51),Q1(51),PR(51),PE(51),E,XMU,K,ITITLE(24),V2(51),PI,  CAN0373
     3ITAPE,JTAPE,CIND,AAA,XMI,XPI,V1(51),V16(51),V17(51),V18(51),V19(51 CAN0374
     4),V20(51),V22(51),B12(51),S2(51),V25(51),C1(51),V51(51),V52(51),   CAN0375
     5V53(51),V54(51),C2(51),C3(51),C4(51),PSI2(51),E7(51),E8(51),E9(51) CAN0376
     6,E10(51),E11(51),E12(51),U2(51),DEF2(51),XM2(51),XP2(51),U1(51),   CAN0377
     7DEF1(51),XM3(51),XP3(51),XM5(51),XP4(51),H1(51),H2(51),RS2(51),    CAN0378
     8RS1(51),AB1(51),AB2(51),AX1(51),AX2(51),TI(51),XP5(51),XM4(51),    CAN0379
     9 LCL, DEL(51),HP1(51),HP2(51),HL1(51),HL2(51),HA(51),R1U(51)       CAN0380
      COMMON AXA(51),SI1(51),SI2(51),SI3(51),DR(51),RSA(51),IPAGE,LGPH,  CAN0381
     1LEXT,V21(51),R11(50),R12(50),T1(51),T2(51)                         CAN0382
      EQUIVALENCE  (P1A,E7,XM2),(P2A,E8,XP2),(P1E,E9,U1),(P2E,E10,U2),   CAN0383
     1(EF1,E11,DEF1),(EF2,E12,DEF2),(Q1,C1,XP3),(Q2,C2,XM3),(C3,XP4),    CAN0384
     2(C4,XP5),(B12,XM4),(PSI2,XM5),(T1,RS1),(T2,RS2),(V16,DEL),(V17,DR) CAN0385
     3,(V18,HP1,H1),(V19,HP2,H2),(V20,HL1,AX1),(V22,HL2,AX2),(V51,AXA),  CAN0386
     4(V52,RSA),(V53,SI2),(V54,SI1),(V25,HA),(TI,SI3)                    CAN0387
      DO 160  I=1,K                                                      CAN0388
 160  PSI2(I)=S2(I)*(R(I+1) -R(I))* B12(I)                               CAN0389
 161  E1   =V16(1) -V16(2)  * B12(1)                                     CAN0390
 162  E2   =V17(1) +V17(2)  * B12(1)                                     CAN0391
 163  E3   =-C3(1)+ C1(2)   +PSI2(1)*V16(2)                              CAN0392
 164  E4   =-V20(1) -V20(2)  * B12(1)                                    CAN0393
 165  E5   = V16(1) -V16(2)  * B12(1)                                    CAN0394
 166  E6   =-C4(1) + C2(2)   + V20(2)  * PSI2(1)                         CAN0395
 167  I=1                                                                CAN0396
 168  EE   = E1   *E5    -E2   *E4                                       CAN0397
 169  E7(I) =(E5   *V18(I+1) -E2   *V22(I+1))/EE                         CAN0398
 170  E8(I) =(E5   *V19(I+1) +E2   *V18(I+1))/EE                         CAN0399
 171  E9(I) =(E5   *E3    - E2   *E6   )/EE                              CAN0400
 172  EE   = - EE                                                        CAN0401
 173  E10(I)=(E4   *V18(I+1) -E1   *V22(I+1))/EE                         CAN0402
 174  E11(I)= (E4   *V19(I+1) +E1   *V18(I+1))/EE                        CAN0403
 175  E12(I)= (E4   *E3    -E1   * E6   )/EE                             CAN0404
 176  E13   = V18(I+1)*B12(I)*E7(I)-V19(I+1)*B12(I)*E10(I)+V16(I+1)      CAN0405
 177  E14   = -V19(I+1)*B12(I)*E11(I)+V18(I+1)*B12(I)*E8(I)+V17(I+1)     CAN0406
 178  E15   = C3(I+1)+V18(I+1)*(PSI2(I)+B12(I)*E9(I))-V19(I+1)*B12(I)*   CAN0407
     1E12(I)                                                             CAN0408
 179  E16   = -V22(I+1)*B12(I)*E7(I)-V18(I+1)*B12(I)*E10(I)-V20(I+1)     CAN0409
 180  E17   = -V22(I+1)*B12(I)*E8(I)-V18(I+1)*B12(I)*E11(I)+V16(I+1)     CAN0410
 181  E18   = C4(I+1)-V22(I+1)*(PSI2(I)+B12(I)*E9(I))-V18(I+1)*B12(I)    CAN0411
     1*E12(I)                                                            CAN0412
 182  IF (K-1-I) 191,191,183                                             CAN0413
 183  I = I+1                                                            CAN0414
 184  E1   = E13      -V16(I+1)* B12(I)                                  CAN0415
 185  E2   = E14      +V17(I+1)* B12(I)                                  CAN0416
 186  E3   = C1(I+1) +PSI2(I)*V16(I+1) -E15                              CAN0417
 187  E4   = E16      -V20(I+1)* B12(I)                                  CAN0418
 188  E5   = E17      -V16(I+1)* B12(I)                                  CAN0419
 189  E6   = C2(I+1) + V20(I+1)* PSI2(I) -E18                            CAN0420
 190  GO TO 168                                                          CAN0421
C LAST RING DEF. AND ANGLE                                               CAN0422
 191  U2(I+1) = E15                                                      CAN0423
 192  DEF2(I+1) = E18                                                    CAN0424
 193  XM2(I+1)=0.                                                        CAN0425
 194  XP2(I+1)=0.                                                        CAN0426
      J = K-1                                                            CAN0427
      DO 207 M = 1,J                                                     CAN0428
 197  I = K-M                                                            CAN0429
 198  XM2(I)=E7(I)* XM2(I+1) +E8(I)* XP2(I+1) +E9(I)                     CAN0430
 199  XP2(I)=E10(I)* XM2(I+1) + E11(I)* XP2(I+1) + E12(I)                CAN0431
 200  U1(I+1)=V16(I+1)*B12(I)*XM2(I)-V17(I+1)*B12(I)*XP2(I)+V18(I+1)*    CAN0432
 201 1XM2(I+1)+V19(I+1)* XP2(I+1)+C1(I+1)+ V16(I+1)*PSI2(I)              CAN0433
 202  DEF1(I+1)=V20(I+1)*B12(I)*XM2(I) +V16(I+1)*B12(I)*XP2(I)+V22(I+1)  CAN0434
 203 1*XM2(I+1) -V18(I+1)*XP2(I+1) +C2(I+1)+ V20(I+1)* PSI2(I)           CAN0435
 204  U2(I+1)=V18(I+1)*B12(I)*XM2(I) -V19(I+1)*B12(I)*XP2(I)+V16(I+1)    CAN0436
 205 1*XM2(I+1) +V17(I+1)*XP2(I+1)+C3(I+1) +V18(I+1)*PSI2(I)             CAN0437
 207  DEF2(I+1)=-V22(I+1)*B12(I)*XM2(I)-V18(I+1)*B12(I)*XP2(I)-V20(I+1)  CAN0438
     1*XM2(I+1)+V16(I+1)*XP2(I+1)+C4(I+1)-V22(I+1)*PSI2(I)               CAN0439
      U1(1)= V18(1)* XM2(1)+V19(1)* XP2(1) +C1(1)                        CAN0440
      DEF1(1)=V22(1)*XM2(1)-V18(1)* XP2(1) +C2(1)                        CAN0441
      U2(1)  =V16(1)*XM2(1)+V17(1)* XP2(1) +C3(1)                        CAN0442
      DEF2(1)=-V20(1)*XM2(1)+V16(1)*XP2(1) +C4(1)                        CAN0443
C CAL. M1 AND P1 TO BE TRANSMITTED                                       CAN0444
 1940 XP3(1)= 0.                                                         CAN0445
 1941 XM3(1)= 0.                                                         CAN0446
      DO 2061 I=1,K                                                      CAN0447
 2001 U1(I) = U1(I)/E                                                    CAN0448
 2021 DEF1(I) = DEF1(I)/E                                                CAN0449
 2041 U2(I) = U2(I)/E                                                    CAN0450
 2061 DEF2(I) = DEF2(I)/E                                                CAN0451
 208  DO 210 I=2,K                                                       CAN0452
 209  XM3(I)= B12(I-1)*(XM2(I-1)+S2(I-1)*(R(I)-R(I-1)))                  CAN0453
 210  XP3(I)= -B12(I-1)* XP2(I-1)                                        CAN0454
 211  DO 215 I =1,K                                                      CAN0455
 212  XP5(I) = XP3(I) +V53(I)                                            CAN0456
 213  XP4(I) = XP2(I) +V54(I)                                            CAN0457
 214  XM5(I) = XM3(I) +V51(I)                                            CAN0458
 215  XM4(I) = XM2(I) +V52(I)                                            CAN0459
      RETURN                                                             CAN0460
      END                                                                CAN0461
*      LIST                                                              CAN0462
      SUBROUTINE STRESS (ADR)                                            CAN0463
      COMMON R(50),R1(50),R2(50),R3(50),R4(50),R5(50),R6(50),R7(50),     CAN0464
     1R8(50),R9(50),R10(50),P2A(51),P1A(51),P2E(51),P1E(51),EF2(51),     CAN0465
     2EF1(51),Q2(51),Q1(51),PR(51),PE(51),E,XMU,K,ITITLE(24),V2(51),PI,  CAN0466
     3ITAPE,JTAPE,CIND,AAA,XMI,XPI,V1(51),V16(51),V17(51),V18(51),V19(51 CAN0467
     4),V20(51),V22(51),B12(51),S2(51),V25(51),C1(51),V51(51),V52(51),   CAN0468
     5V53(51),V54(51),C2(51),C3(51),C4(51),PSI2(51),E7(51),E8(51),E9(51) CAN0469
     6,E10(51),E11(51),E12(51),U2(51),DEF2(51),XM2(51),XP2(51),U1(51),   CAN0470
     7DEF1(51),XM3(51),XP3(51),XM5(51),XP4(51),H1(51),H2(51),RS2(51),    CAN0471
     8RS1(51),AB1(51),AB2(51),AX1(51),AX2(51),TI(51),XP5(51),XM4(51),    CAN0472
     9 LCL, DEL(51),HP1(51),HP2(51),HL1(51),HL2(51),HA(51),R1U(51)       CAN0473
      COMMON AXA(51),SI1(51),SI2(51),SI3(51),DR(51),RSA(51),IPAGE,LGPH,  CAN0474
     1LEXT,V21(51),R11(50),R12(50),T1(51),T2(51)                         CAN0475
      EQUIVALENCE  (P1A,E7,XM2),(P2A,E8,XP2),(P1E,E9,U1),(P2E,E10,U2),   CAN0476
     1(EF1,E11,DEF1),(EF2,E12,DEF2),(Q1,C1,XP3),(Q2,C2,XM3),(C3,XP4),    CAN0477
     2(C4,XP5),(B12,XM4),(PSI2,XM5),(T1,RS1),(T2,RS2),(V16,DEL),(V17,DR) CAN0478
     3,(V18,HP1,H1),(V19,HP2,H2),(V20,HL1,AX1),(V22,HL2,AX2),(V51,AXA),  CAN0479
     4(V52,RSA),(V53,SI2),(V54,SI1),(V25,HA),(TI,SI3)                    CAN0480
      J=K+1                                                              CAN0481
      DO 101 I=1,J                                                       CAN0482
      IF(I-1) 4,4,43                                                     CAN0483
43    IF(I-J) 44,2,2                                                     CAN0484
44    W1=R1(I)-R2(I)                                                     CAN0485
      W2=R1(I-1)-R2(I-1)                                                 CAN0486
      IF(W1-W2) 4,4,2                                                    CAN0487
2     N1=1                                                               CAN0488
15    L=I-1                                                              CAN0489
3     W1=R9(L)**2 - R10(L)**2                                            CAN0490
      W2=PR(L)*R10(L)**2 - PE(L)*R9(L)**2                                CAN0491
      W3=R9(L)**2 * R10(L)**2 *(PR(L)-PE(L))                             CAN0492
5     HP1(I)=(W2+W3/R1(L)**2)/W1                                         CAN0493
      R1U(I)=N1                                                          CAN0494
      RS1(I)=-PR(L)                                                      CAN0495
      W4= TI(L)/(R1(L)-R(L))                                             CAN0496
      GO TO (23,24),N1                                                   CAN0497
23    AB1(I)=-XM2(L)/W4                                                  CAN0498
      DR(I)=(S2(L)*2.*R(L))/(R1(L)**2-R2(L)**2)                          CAN0499
      GO TO 7                                                            CAN0500
24    AB1(I)=-XM3(L)/W4                                                  CAN0501
      IF(I-1) 7,7,13                                                     CAN0502
13    DR(I)=(S2(L-1)*R(L-1)*2.)/(R1(L)**2-R2(L)**2)                      CAN0503
      GO TO 7                                                            CAN0504
4     N1=2                                                               CAN0505
      L=I                                                                CAN0506
      GO TO 3                                                            CAN0507
7     HP2(I)=(W2 + W3/R2(L)**2)/W1                                       CAN0508
      W4= TI(L)/(R(L)-R2(L))                                             CAN0509
      RS2(I)=-PE(L)                                                      CAN0510
      GO TO (25,26),N1                                                   CAN0511
26    AB2(I)= XM3(L)/W4                                                  CAN0512
      GO TO 30                                                           CAN0513
25    AB2(I)= XM2(L)/W4                                                  CAN0514
30    GO TO (14,17),N1                                                   CAN0515
14    W1=U2(L)*E -V25(L)                                                 CAN0516
16    W2= XPI *R9(L)**2 + XMI* R(L)**2                                   CAN0517
      HL1(I)=( (W1*(R9(L)**2 + R1(L)**2))/ (W2*R1(L)**2)  )*R(L)         CAN0518
      GO TO 18                                                           CAN0519
17    W1= U1(L)*E-V25(L)                                                 CAN0520
      GO TO 16                                                           CAN0521
18    W2= XPI* R10(L)**2 + XMI* R(L)**2                                  CAN0522
101   HL2(I)=((W1*( R10(L)**2 + R2(L)**2))/ (W2*R2(L)**2) )*R(L)         CAN0523
      DR(1)=ADR                                                          CAN0524
      DR(J)= S2(K)/(PI*(R1(K)**2-R2(K)**2))                              CAN0525
      DR(J)=DR(J)*2.*PI*R(K)                                             CAN0526
      DO 100 I=1,J                                                       CAN0527
68    H1(I)= HP1(I)+HL1(I)                                               CAN0528
      H2(I)= HP2(I)+HL2(I)                                               CAN0529
      HA(I)=(H1(I)+H2(I))/2.                                             CAN0530
      AX1(I)= AB1(I)+ DR(I)                                              CAN0531
      AX2(I)= AB2(I)+ DR(I)                                              CAN0532
      AXA(I)=(AX1(I)+AX2(I))/2.                                          CAN0533
100   RSA(I)=(RS2(I)+RS1(I))/2.                                          CAN0534
      DO 1 I=1,J                                                         CAN0535
      W1=ABSF(RS1(I)-H2(I))                                              CAN0536
      W2= ABSF(H2(I)-AX2(I))                                             CAN0537
      W3= ABSF(AX2(I)-RS1(I))                                            CAN0538
50    IF(W1-W2) 51,51,52                                                 CAN0539
51    IF(W2-W3) 53,53,54                                                 CAN0540
52    IF(W1-W3) 53,53,55                                                 CAN0541
53    SI2(I)=W3                                                          CAN0542
      GO TO 56                                                           CAN0543
54    SI2(I)=W2                                                          CAN0544
      GO TO 56                                                           CAN0545
55    SI2(I)=W1                                                          CAN0546
56    W1 = ABSF(RS2(I) - H1(I))                                          CAN0547
      W2 = ABSF(H1 (I) -AX1(I))                                          CAN0548
      W3 = ABSF(AX1(I) -RS2(I))                                          CAN0549
      IF(W1-W2) 57,57,58                                                 CAN0550
57    IF(W2-W3) 59,59,60                                                 CAN0551
58    IF(W1-W3) 59,59,61                                                 CAN0552
59    SI1(I) =W3                                                         CAN0553
      GO TO 62                                                           CAN0554
60    SI1(I) =W2                                                         CAN0555
      GO TO 62                                                           CAN0556
61    SI1(I) =W1                                                         CAN0557
62    W1= ABSF(RSA(I)-HA(I))                                             CAN0558
      W2= ABSF(HA(I)-AXA(I))                                             CAN0559
      W3= ABSF(AXA(I)-RSA(I))                                            CAN0560
      IF(W1-W2) 63,63,64                                                 CAN0561
63    IF(W2-W3) 65,65,66                                                 CAN0562
64    IF(W1-W3) 65,65,67                                                 CAN0563
65    SI3(I)=W3                                                          CAN0564
      GO TO 1                                                            CAN0565
67    SI3(I)=W1                                                          CAN0566
      GO TO 1                                                            CAN0567
66    SI3(I)=W2                                                          CAN0568
1     CONTINUE                                                           CAN0569
      W2=E*PI                                                            CAN0570
      DEL(1)=0.                                                          CAN0571
      DO 41 I=1,K                                                        CAN0572
      DEL(I+1)=(S2(I)*V2(I))/((R1(I)**2-R2(I)**2)*W2)                    CAN0573
      DEL(I+1)  =DEL(I+1)*10.**6                                         CAN0574
41    DEL(I+1)= DEL(I+1)+DEL(I)                                          CAN0575
      DO 200 I=1,K                                                       CAN0576
      U1(I)=U1(I)*10.**6                                                 CAN0577
      U2(I)=U2(I)*10.**6                                                 CAN0578
      DEF1(I)=DEF1(I)*10.**6                                             CAN0579
200   DEF2(I)=DEF2(I)*10.**6                                             CAN0580
      RETURN                                                             CAN0581
      END                                                                CAN0582
