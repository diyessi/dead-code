      SUBROUTINE BULD (H1,H2,H3,H4,H5,H6,H7,H8,H9,H10,H11,NH,G1,G2,G3)   CAN0750
      DIMENSION H(11)                                                    CAN0751
C FORMAT BUILDING                                                        CAN0752
      H(1) =H1                                                           CAN0753
      H(2) =H2                                                           CAN0754
      H(3) =H3                                                           CAN0755
      H(4) =H4                                                           CAN0756
      H(5) =H5                                                           CAN0757
      H(6) =H6                                                           CAN0758
      H(7) =H7                                                           CAN0759
      H(8) =H8                                                           CAN0760
      H(9) =H9                                                           CAN0761
      H(10)=H10                                                          CAN0762
      H(11)=H11                                                          CAN0763
      IF (NH-10) 1,1,2                                                   CAN0764
1     NXX =1                                                             CAN0765
      NC =0                                                              CAN0766
5     IF(NH-NXX) 4,3,3                                                   CAN0767
3     NC=NC+1                                                            CAN0768
      NXX=NXX+1                                                          CAN0769
       GO TO 5                                                           CAN0770
4     IF(NC-10)20,19,19                                                  CAN0771
19     G1=H11                                                            CAN0772
      G2=H(1)                                                            CAN0773
      G3=H(10)                                                           CAN0774
      GO TO 18                                                           CAN0775
20    G1=H11                                                             CAN0776
      G2=H11                                                             CAN0777
      G3=H(NC)                                                           CAN0778
      GO TO 18                                                           CAN0779
2     NXX =10                                                            CAN0780
      MC=0                                                               CAN0781
      NC=0                                                               CAN0782
6     IF (NH-NXX) 7,8,8                                                  CAN0783
8     MC =MC+1                                                           CAN0784
      NXX=NXX+10                                                         CAN0785
      GO TO 6                                                            CAN0786
7      NXX=10*MC                                                         CAN0787
9      IF(NH-NXX) 10,10,11                                               CAN0788
11    NC=NC+1                                                            CAN0789
      NXX=NXX+1                                                          CAN0790
      GO TO 9                                                            CAN0791
10     IF(MC-10) 12,13,14                                                CAN0792
13    G1=H(1)                                                            CAN0793
      G2=H(10)                                                           CAN0794
      GO TO 15                                                           CAN0795
12    G1=H11                                                             CAN0796
      G2=H(MC)                                                           CAN0797
      GO TO 15                                                           CAN0798
14     G1=H1                                                             CAN0799
      G2=H1                                                              CAN0800
15     IF(NC) 16,16,17                                                   CAN0801
16    NC=10                                                              CAN0802
17    G3=H(NC)                                                           CAN0803
18    RETURN                                                             CAN0804
      END                                                                CAN0805
