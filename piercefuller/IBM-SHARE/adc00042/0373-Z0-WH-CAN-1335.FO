      SUBROUTINE PLOT(NCURVE,NOP,NA,NO,INS,X,Y1,Y2,Y3,Y4,IDENT,ABS,FCT)  CAN0827
      DIMENSION  X(51 ),Y1(51 ),Y2(51 ),Y3(51 ),Y4(51 ),Y(51 ,4),        CAN0828
     2NY(51 ,4),NSF(5)                                                   CAN0829
      DIMENSION POINT(14),FORMT(7),GORMT(12),DUM1(4),DUM2(4),D3(5),      CAN0830
     1NX(51 ),NNN(4),IDENT(24),FCT(8),DD(4),ZNN(4), FTC(4),ABS(2)        CAN0831
C PLOT ROUTINE                                                           CAN0832
      JTAPE=6                                                            CAN0833
      FTC(1)=FCT(2)                                                      CAN0834
      FTC(2)=FCT(4)                                                      CAN0835
      FTC(3)=FCT(6)                                                      CAN0836
      FTC(4)=FCT(8)                                                      CAN0837
      FCT(2)=FCT(3)                                                      CAN0838
      FCT(3)=FCT(5)                                                      CAN0839
      FCT(4)=FCT(7)                                                      CAN0840
      DO 10 N=1,NCURVE                                                   CAN0841
      GO TO (1,2,3,4),N                                                  CAN0842
1     DO 6  I=1,NOP                                                      CAN0843
6     Y(I,1) = Y1(I)                                                     CAN0844
      GO TO 10                                                           CAN0845
2     DO 7  I=1,NOP                                                      CAN0846
7     Y(I,2)= Y2(I)                                                      CAN0847
      GO TO 10                                                           CAN0848
3     DO 8 I=1,NOP                                                       CAN0849
8     Y(I,3)=Y3(I)                                                       CAN0850
      GO TO 10                                                           CAN0851
4     DO 9 I=1,NOP                                                       CAN0852
9     Y(I,4)=Y4(I)                                                       CAN0853
10    CONTINUE                                                           CAN0854
      CALL INIT(4H(1H+,2HX,,1H),3H1H+,3H1H0,3H1H$,3H1H*,3HI5,,3HI5),1H(, CAN0855
     15HE9.2,,5HE9.2),POINT, 4H20X,,4H16X,)                              CAN0856
      FORMT(1)=POINT(8)                                                  CAN0857
      FORMT(5)=POINT(9)                                                  CAN0858
      FORMT(7)=POINT(10)                                                 CAN0859
      DO 11 J=1,NCURVE                                                   CAN0860
      Z1=0.                                                              CAN0861
      Z2=0.                                                              CAN0862
      DO 12 I=1,NOP                                                      CAN0863
      IF (Y(I,J))13,14,14                                                CAN0864
14    IF(Y(I,J)-Z1)12,12,15                                              CAN0865
15    Z1=Y(I,J)                                                          CAN0866
      GO TO 12                                                           CAN0867
13    IF(Y(I,J)-Z2)16,12,12                                              CAN0868
16    Z2=Y(I,J)                                                          CAN0869
12    CONTINUE                                                           CAN0870
      DUM2(J)=Z1                                                         CAN0871
11    DUM1(J)=Z2                                                         CAN0872
      Z1=0.                                                              CAN0873
      Z2=0.                                                              CAN0874
      DO 17 I=1,NOP                                                      CAN0875
      IF(X(I)) 18,19,19                                                  CAN0876
19    IF(X(I)-Z1) 17,17,20                                               CAN0877
20    Z1=X(I)                                                            CAN0878
      GO TO 17                                                           CAN0879
18    IF(X(I)-Z2) 160,17,17                                              CAN0880
160   Z2=X(I)                                                            CAN0881
17    CONTINUE                                                           CAN0882
      D3(5)=Z1+ABSF(Z2)                                                  CAN0883
      Z1=0.                                                              CAN0884
      DO 53 J=1,NCURVE                                                   CAN0885
      IF(DUM2(J)-Z1)53,53,531                                            CAN0886
531   Z1=DUM2(J)                                                         CAN0887
      NN=J                                                               CAN0888
53    CONTINUE                                                           CAN0889
      YMAX=Z1                                                            CAN0890
      Z1=0.                                                              CAN0891
      DO 59 J=1,NCURVE                                                   CAN0892
      IF(DUM1(J)-Z1) 533,59,59                                           CAN0893
533   Z1=DUM1(J)                                                         CAN0894
59    CONTINUE                                                           CAN0895
      YMIN=Z1                                                            CAN0896
      SS=NO                                                              CAN0897
       SS=SS-2.                                                          CAN0898
      IF(YMAX)  191,191,190                                              CAN0899
191   IF(YMIN)  190,192,192                                              CAN0900
192   DO 5   J=1,4                                                       CAN0901
5     D3(J)=1.                                                           CAN0902
      NPLU=1                                                             CAN0903
      GO TO 154                                                          CAN0904
190   IF(YMAX+YMIN) 200,201,201                                          CAN0905
200   WS=ABSF(YMIN)                                                      CAN0906
      W1=YMAX/WS +1.                                                     CAN0907
      WW=SS/W1 + .9                                                      CAN0908
204   NNLU=WW                                                            CAN0909
      NPLU=NO-NNLU                                                       CAN0910
      GO TO 112                                                          CAN0911
201   WS= YMAX                                                           CAN0912
      W1= ABSF(YMIN)/WS+1.                                               CAN0913
      WW=SS/W1 + .9                                                      CAN0914
205   NPLU=WW                                                            CAN0915
      NNLU=NO-NPLU                                                       CAN0916
112   DO 41 K=1,5                                                        CAN0917
      IF(K-NCURVE) 43,43,42                                              CAN0918
42    IF(K-5) 50,44,44                                                   CAN0919
44    SS=NA                                                              CAN0920
       SS=SS-2.                                                          CAN0921
      WS=D3(K)                                                           CAN0922
      WW=SS                                                              CAN0923
      GO TO 111                                                          CAN0924
43    GO TO (150,151),INS                                                CAN0925
150   NJ=WW                                                              CAN0926
      WW=NJ                                                              CAN0927
111   D3(K)= WS/WW                                                       CAN0928
      GO TO 41                                                           CAN0929
151   WS1=NPLU                                                           CAN0930
      WS1=DUM2(K)/WS1                                                    CAN0931
      WS2=NNLU                                                           CAN0932
      WS2=ABSF(DUM1(K))/WS2                                              CAN0933
      IF(WS1-WS2)206,207,207                                             CAN0934
206   WW=NNLU                                                            CAN0935
      WS= ABSF(DUM1(K))                                                  CAN0936
