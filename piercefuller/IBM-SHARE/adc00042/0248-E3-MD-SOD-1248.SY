      SUBROUTINE SOD (F,H,NP,NPT,L,Y,DY)                                MDSOD000
      DIMENSION F(1),Y(1),DY(1)                                         MDSOD001
      N=(NP-1)/2                                                        MDSOD002
      M=2*N                                                             MDSOD003
      I=NPT-N                                                           MDSOD004
      J=N+1                                                             MDSOD005
      DO 90 K=1,NPT                                                     MDSOD006
      DY(K)=0.0                                                         MDSOD007
   90 Y(K)=0.0                                                          MDSOD008
    1 SUMA1=0.0                                                         MDSOD009
      SUMA2=0.0                                                         MDSOD010
      SUMC1=0.0                                                         MDSOD011
      SUMC2=0.0                                                         MDSOD012
      SUMF1=0.0                                                         MDSOD013
      SUMF2=0.0                                                         MDSOD014
      DO 10 K=0,M                                                       MDSOD015
      U=K                                                               MDSOD016
      W=N                                                               MDSOD017
      G=J                                                               MDSOD018
      U=U-W                                                             MDSOD019
      JFK=G+U+.5                                                        MDSOD020
      SUMA1=SUMA1+U**4                                                  MDSOD021
      SUMA2=SUMA2+U**2                                                  MDSOD022
      SUMC1=SUMC1+U**2                                                  MDSOD023
      SUMC2=SUMC2+1.                                                    MDSOD024
      SUMF1=SUMF1+F(JFK)*U**2                                           MDSOD025
   10 SUMF2=SUMF2+F(JFK)                                                MDSOD026
      CUMA1=SUMA1*SUMC2                                                 MDSOD027
      CUMA2=SUMA2*SUMC1                                                 MDSOD028
      CUMF1=SUMF1*SUMC2                                                 MDSOD029
      CUMF2=SUMF2*SUMC1                                                 MDSOD030
      SUBA=CUMA1-CUMA2                                                  MDSOD031
      SUBF=CUMF1-CUMF2                                                  MDSOD032
      A=SUBF/SUBA                                                       MDSOD033
      IF (L) 20,20,30                                                   MDSOD034
   20 C=(SUMF2-SUMA2*A)/SUMC2                                           MDSOD035
      IF (J-(N+1))30,30,21                                              MDSOD036
   30 SUMB=0.0                                                          MDSOD037
      SUMFB=0.0                                                         MDSOD038
      B=1.0                                                             MDSOD039
      DO 31 K=0,M                                                       MDSOD040
      U=K                                                               MDSOD041
      W=N                                                               MDSOD042
      G=J                                                               MDSOD043
      U=U-W                                                             MDSOD044
      JFK=G+U+.5                                                        MDSOD045
      SUMB=SUMB+U**2                                                    MDSOD046
   31 SUMFB=SUMFB+F(JFK)*U                                              MDSOD047
      B=SUMFB/SUMB                                                      MDSOD048
      IF (L) 2,2,3                                                      MDSOD049
    2 IF (J-(N+1))40,40,4                                               MDSOD050
    3 IF (J-(N+1)) 60,60,70                                             MDSOD051
    4 IF (J-I) 3,50,50                                                  MDSOD052
   40 DO 41 K=1,N                                                       MDSOD053
      U=K                                                               MDSOD054
      G=J                                                               MDSOD055
      U=-U                                                              MDSOD056
      JFK=G+U+.5                                                        MDSOD057
   41 Y(JFK)=A*U**2+B*U+C                                               MDSOD058
   21 Y(J)=C                                                            MDSOD059
      IF (L) 5,6,6                                                      MDSOD060
    5 IF (J-I) 9,30,30                                                  MDSOD061
    6 IF (J-I) 7,30,30                                                  MDSOD062
    7 IF (J-(N+1)) 3,3,30                                               MDSOD063
    9 J=J+1                                                             MDSOD064
      GO TO 1                                                           MDSOD065
   50 DO 51 K=1,N                                                       MDSOD066
      JFK=J+K                                                           MDSOD067
      U=K                                                               MDSOD068
   51 Y(JFK)=A*U**2+B*U+C                                               MDSOD069
      IF (L) 100,70,70                                                  MDSOD070
   60 DO 61 K=1,N                                                       MDSOD071
      U=K                                                               MDSOD072
      G=J                                                               MDSOD073
      U=-U                                                              MDSOD074
      JFK=G+U+.5                                                        MDSOD075
   61 DY(JFK)=(2.*A*U+B)/H                                              MDSOD076
   70 DY(J)=B/H                                                         MDSOD077
      IF (J-I) 12,80,80                                                 MDSOD078
   12 J=J+1                                                             MDSOD079
      IF (J-I) 14,1,1                                                   MDSOD080
   14 IF (L) 1,1,30                                                     MDSOD081
   80 DO 81 K=1,N                                                       MDSOD082
      JFK=J+K                                                           MDSOD083
      U=K                                                               MDSOD084
   81 DY(JFK)=(2.*A*U+B)/H                                              MDSOD085
  100 RETURN                                                            MDSOD086
      END                                                               MDSOD087
