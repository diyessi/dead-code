       COUNT   100                                                      SEL00000
       LBL     IOSEL,X                                                  SEL00010
*IOSEL  I-O SELECT SUBPROGRAM FOR IOPAR - SAO - NORRIS - JULY 61        SEL00020
*                                                                       SEL00030
*       SELECT SUPERVISOR FOR ASYNCRONOUS BI-CHANNEL OPERATION          SEL00040
*       WITH OVERLAP OF MAIN PROGRAM EXECUTION.                         SEL00050
*                                                                       SEL00060
*      TSX     IOSEL,4                                                  SEL00070
*      TSX     SYMUNT   LOC OF SYMBOLIC OR REAL UNIT DESIGNATION        SEL00080
*      TSX     CDWRD    LOC OF CODE WORD, ADR=L(CHN PRG), DEC=SELCT CODESEL00090
*      TSX     CKTSX    LOC OF TSX TO ANY CHECKING PRG TO PRECEED IOSCF SEL00100
*      TSX     ERROR    LOC OF 4 WORD BSS     ARRAY FOR ERROR INF.      SEL00110
*                                                                       SEL00120
*                                                                       SEL00130
*       SELECT CODE, BITS 3-11 ON FOR - REWX, BSFX, BSRX, RUNX, RDSX,   SEL00140
*       RCHX, WEFX, WRSX, RCHX /BIT 12 CKTSX IS TO BE USED /BIT 13 ON   SEL00150
*       TO INDICATE BINARY MODE (TAPE ONLY)                             SEL00160
*       BIT 14 ON - DO NOT USE IOSCC AFTER IOSCF                        SEL00170
*       BIT 17 ON - CHANGE TAPE REELS WHENEVER NECESSARY                SEL00180
*       C(SYMUNT) - SYM UNIT IN DEC PLUS MODE IN ADR OR JUST REAL UNIT  SEL00190
*       IN ADR                                                          SEL00200
*                                                                       SEL00210
       ENTRY   IOSEL                                                    SEL00220
       ENTRY   ERROR                                                    SEL00230
*                                                                       SEL00240
IOSEL  SXD     IOSEL-2,4                                                SEL00250
       SXA     XR2,2                                                    SEL00260
       STI     SAVIND                                                   SEL00270
ONCE5  TRA     *+1                                                      SEL00280
       CAL*    $SCNAC                                                   SEL00290
       STA     WSCNAC                                                   SEL00300
       CAL*    $CHIND                                                   SEL00310
       STA     WCHIND                                                   SEL00320
       CAL*    $CHERR                                                   SEL00330
       STA     WCHERR                                                   SEL00340
       STL     ONCE5                                                    SEL00350
       LDI*    2,4                                                      SEL00360
       CLM                                                              SEL00370
       LNT     20                                                       SEL00380
       TRA     SELA                                                     SEL00390
       LDI*    1,4                                                      SEL00400
       RNT     200                                                      SEL00410
       TRA     SELA                                                     SEL00420
       RNT     100                                                      SEL00430
       CAL     BNTAP                                                    SEL00440
SELA   ORA*    1,4                                                      SEL00450
       CALL    IOSUP                                                    SEL00460
       SLW     CHNEL                                                    SEL00470
       PDX     0,2                                                      SEL00480
       TSX     $FINIO,4                                                 SEL00490
       TSX     *-1,0                                                    SEL00500
       CAL     CHNEL                                                    SEL00510
       CALL    IOSUP                                                    SEL00520
       SLW     CHNEL                                                    SEL00530
       PDX     0,2                                                      SEL00540
       LXD     IOSEL-2,4                                                SEL00550
       SLW*    1,4                                                      SEL00560
       CAL     4,4                                                      SEL00570
       STA*    ERROR                                                    SEL00580
       CAL*    3,4                                                      SEL00590
       ORA     =O074000400000                                           SEL00600
WSCNAC SLW     ..,2                                                     SEL00610
WCHERR STZ     ..,2                                                     SEL00620
       LDI*    2,4                                                      SEL00630
WCHIND STI     ..,2                                                     SEL00640
       LFT     040000                                                   SEL00650
       XEC*    $REWX                                                    SEL00660
       LFT     020000                                                   SEL00670
       XEC*    $BSFX                                                    SEL00680
       LFT     010000                                                   SEL00690
       XEC*    $BSRX                                                    SEL00700
       LFT     004000                                                   SEL00710
       XEC*    $RUNX                                                    SEL00720
       LNT     003000                                                   SEL00730
       TTR     RD2                                                      SEL00740
       PIA                                                              SEL00750
       PAC     0,4                                                      SEL00760
       XEC*    $RDSX                                                    SEL00770
       XEC*    $RCHX                                                    SEL00780
       TRA     WRITE                                                    SEL00790
RD2    LFT     002000                                                   SEL00800
       XEC*    $RDSX                                                    SEL00810
WRITE  LFT     000400                                                   SEL00820
       XEC*    $WEFX                                                    SEL00830
       LNT     000300                                                   SEL00840
       TTR     WR2                                                      SEL00850
       PIA                                                              SEL00860
       PAC     0,4                                                      SEL00870
       XEC*    $WRSX                                                    SEL00880
       XEC*    $RCHX                                                    SEL00890
       TRA     SEE                                                      SEL00900
WR2    LFT     000200                                                   SEL00910
       XEC*    $WRSX                                                    SEL00920
SEE    IOT                                                              SEL00930
       CALL    IOTER                                                    SEL00940
       LXD     IOSEL-2,4                                                SEL00950
XR2    AXT     ..,2                                                     SEL00960
       LDI     SAVIND                                                   SEL00970
       XEC*    $ENB                                                     SEL00980
       TRA     5,4                                                      SEL00990
BNTAP  OCT     20                                                       SEL01000
CHNEL  PZE                                                              SEL01010
SAVIND PZE                                                              SEL01020
       PZE                                                              SEL01030
       PZE                                                              SEL01040
ERROR  CAL     *,2                                                      SEL01050
..     EQU     0                                                        SEL01060
       END                                                              SEL01070
       COUNT   50                                                       END00000
       LBL     ENDIO,X                                                  END00010
*ENDIO  I-O COMPLETION    SUBP. FOR FORTRAN USAGE OF IOPAR-NORRIS-SAO   END00020
*                                                                       END00030
*      TSX     $ENDIO,4                                                 END00040
*      TSX     CHANEL     DEC OF LOC CHANEL = CHANNEL INDEX (1 OR 2).   END00050
*      TSX     FLAG       LOC FLAG (AND ACT IS SET TO ZERO IF CHANNEL   END00060
*        RETURN            IS FREE, SET TO NONZERO IF BUSY, SET MINUS   END00070
*                          IF CHANNEL INDEX WRONG.                      END00080
*                                                                       END00090
       ENTRY   ENDIO                                                    END00100
*                                                                       END00110
ENDIO  EQU     *                                                        END00120
       SXD     ENDIO-2,4                                                END00130
       SXA     XRB,2                                                    END00140
       CLA*    1,4                                                      END00150
       PDX     0,2                                                      END00160
       TXL     ERR,2,0                                                  END00170
       TXH     ERR,2,2                                                  END00180
       TSX     $FINIO,4                                                 END00190
       TSX     BUSY                                                     END00200
       PXA     0,0                                                      END00210
OUT    EQU     *                                                        END00220
       LXD     ENDIO-2,4                                                END00230
       STO*    2,4                                                      END00240
XRB    AXT     **,2                                                     END00250
       XEC*    $ENB                                                     END00260
       TRA     3,4                                                      END00270
BUSY   EQU     *                                                        END00280
CAL    CAL     CLA                                                      END00290
       TRA     OUT                                                      END00300
ERR    EQU     *                                                        END00310
CLA    CLA     CAL                                                      END00320
       TRA     OUT                                                      END00330
       END                                                              END00340
       COUNT   60                                                       FIN00000
       LBL     FINIO,X                                                  FIN00010
*FINIO  I-O SUBPROGRAM FOR IOPAR - SAO - NORRIS - JULY 61               FIN00020
*                                                                       FIN00030
*       RETURNS 1,4 IF       CHANNEL IN OPERATION                       FIN00040
*       FREES NON-OPERATIVE CHANNEL BY COMPLETING   PREVIOUS ACTION     FIN00050
*                                                                       FIN00060
*      LXD     CHANEL,2       LOAD CHANNEL INDEX                        FIN00070
*      TSX     $FINIO,4                                                 FIN00080
*      TSX     *-1,0                   RETURN IF CHANNEL IN OPERATION   FIN00090
*      XEC* $ENB        POINT OF RETURN                                 FIN00100
*                                                                       FIN00110
*                                                                       FIN00120
       ENTRY   FINIO                                                    FIN00130
*                                                                       FIN00140
FINIO  EQU     *                                                        FIN00150
       XEC*    $DSB                                                     FIN00160
       SXD     FINIO-2,4                                                FIN00170
       STI     SAVIND                                                   FIN00180
ONCE5  TRA     *+1                                                      FIN00190
       CAL*    $SCNAC                                                   FIN00200
       STA     WSCNAC                                                   FIN00210
       CAL*    $CHIND                                                   FIN00220
       STA     WCHIND                                                   FIN00230
       CAL*    $CHERR                                                   FIN00240
       STA     WCHERR                                                   FIN00250
       STL     ONCE5                                                    FIN00260
WCHIND LDI     **,2                                                     FIN00270
       AXC     TFIN,4                                                   FIN00280
       XEC*    $TCOX                                                    FIN00290
WSCNAC CLA     **,2                                                     FIN00300
       TZE     FIN                                                      FIN00310
       LNT     40                                                       FIN00320
       TRA     CHEK2                                                    FIN00330
       STA     CHECK                                                    FIN00340
CHECK  CALL    IOSCF                                                    FIN00350
WCHERR LDI     **,2                                                     FIN00360
       CALL    IOSCF                                                    FIN00370
       OSI*    WCHERR                                                   FIN00380
       STI*    WCHERR                                                   FIN00390
       LDI*    WCHIND                                                   FIN00400
       LFT     10                                                       FIN00410
       TTR     PASS                                                     FIN00420
       CALL    IOSCC                                                    FIN00430
PASS   EQU     *                                                        FIN00440
       AXC     TFIN,4                                                   FIN00450
       XEC*    $TCOX                                                    FIN00460
       STZ*    WSCNAC                                                   FIN00470
       TRA     FIN                                                      FIN00480
TFIN   LXD     FINIO-2,4                                                FIN00490
       TXI     *+1,4,1                                                  FIN00500
       TRA     *+2                                                      FIN00510
FIN    LXD     FINIO-2,4                                                FIN00520
       LDI     SAVIND                                                   FIN00530
       TRA     2,4                                                      FIN00540
SAVIND PZE                                                              FIN00550
WAT    EQU     WCHIND                                                   FIN00560
CHEK2  EQU     WCHERR                                                   FIN00570
       END                                                              FIN00580
       COUNT   180                                                      SUP00000
       LBL     IOSUP,X                                                  SUP00010
*IOSUP  I-O SUPERVISOR FOR IOPAR - SAO - NORRIS - JULY 61               SUP00020
*                                                                       SUP00030
*      CLA    SYMTAP  ( SYMTAPE IN DEC PLUS MODE IN ADR, OR UNIT IN ADR)SUP00040
*      TSX    IOSUP,4                                                   SUP00050
*      XEC* $ENB        POINT OF RETURN                                 SUP00060
*      STO    CHANEL  ( CHANNEL IN DEC, UNIT IN ADR, NEG IF IOSUP BUSY) SUP00070
*                                                                       SUP00080
       ENTRY   IOSUP                                                    SUP00090
       ENTRY  -RDSX                                                     SUP00100
       ENTRY  -WRSX                                                     SUP00110
       ENTRY  -WEFX                                                     SUP00120
       ENTRY  -BSRX                                                     SUP00130
       ENTRY  -BSFX                                                     SUP00140
       ENTRY  -REWX                                                     SUP00150
       ENTRY  -RUNX                                                     SUP00160
       ENTRY  -RCHX                                                     SUP00170
       ENTRY  -LCHX                                                     SUP00180
       ENTRY  -SCHX                                                     SUP00190
       ENTRY  -RDCX                                                     SUP00200
       ENTRY  -TCOX                                                     SUP00210
       ENTRY  -TEFX                                                     SUP00220
       ENTRY  -TRCX                                                     SUP00230
       ENTRY  -BTTX                                                     SUP00240
       ENTRY  -ETTX                                                     SUP00250
       ENTRY  -SCNAC                                                    SUP00260
       ENTRY  -CHIND                                                    SUP00270
       ENTRY  -CHREG                                                    SUP00280
       ENTRY  -CHERR                                                    SUP00290
*                                                                       SUP00300
IOSUP  EQU     *                                                        SUP00310
       XEC*   $DSB                                                      SUP00320
       SXD     IOSUP-2,4                                                SUP00330
       SXA     XR2,2                                                    SUP00340
       TNZ     *+3                                                      SUP00350
       CAL     AC                                                       SUP00360
       TRA     PASS                                                     SUP00370
AGAIN  SLW     AC             SAVE AC                                   SUP00380
ONCE6  TRA     *+1                                                      SUP00390
       AXT     0,4            ZER0 TO INDEX                             SUP00400
       XEC*    $UNIT                                                    SUP00410
       STD     LIMIT          INITIALIZE FOR SIZE UNIT TABLE            SUP00420
       CAL     AC                                                       SUP00430
       STL     ONCE6          SET TRA TO BYPASS THIS NEXT TIME          SUP00440
       ANA     =O777757                                                 SUP00450
       TZE     SYMTAP         UNIT NOT GIVEN, SYMBOLIC TAPE GIVEN       SUP00460
       ORA     AC                                                       SUP00470
       TRA     RESUME         UNIT GIVEN                                SUP00480
SYMTAP CAL     AC                                                       SUP00490
       PDX     0,4                                                      SUP00500
LIMIT  TXH     STOP,4,..      TEST FOR ILLEGAL SYMBOLIC UNIT            SUP00510
       TXL     STOP,4,0                                                 SUP00520
       TXL     *+3,4,20                                                 SUP00530
       AXT     0,2                                                      SUP00540
       SXA     AC,2                                                     SUP00550
       XEC*    $UNIT                                                    SUP00560
       TZE     STOP           TEST FOR EMPTY ENTRY                      SUP00570
       ORS     AC                                                       SUP00580
RESUME ARS     9                                                        SUP00590
       ANA     =O17                                                     SUP00600
       PAX     0,2                                                      SUP00610
       SXD     AC,2           SET DEC TO CHANNEL                        SUP00620
       CAL     AC             CHANNEL AND UNIT TO AC                    SUP00630
       XEC     SCNAC          IS CHANNEL FREE.                          SUP00640
       TRA     PASS           CHANNEL NOT FREE.                         SUP00650
       STA*    RDSX                                                     SUP00660
       STA*    WRSX                                                     SUP00670
       STA*    WEFX                                                     SUP00680
       STA*    BSRX                                                     SUP00690
       STA*    BSFX                                                     SUP00700
       STA*    REWX                                                     SUP00710
       STA*    RUNX                                                     SUP00720
PASS   XEC     SCNAC                                                    SUP00730
       SSM              AC MINUS IF CHANNEL NOT FREE                    SUP00740
OUT    LXD     IOSUP-2,4      RETURN WITH CHANNEL PLUS UNIT IN AC       SUP00750
XR2    AXT     ..,2                                                     SUP00760
       TRA     1,4                                                      SUP00770
STOP   EQU     *                                                        SUP00780
       CAL     =O20                                                     SUP00790
       ANS     AC                                                       SUP00800
       XCL                                                              SUP00810
       HPR     0,6                                                      SUP00820
       ENK                                                              SUP00830
       XCL                                                              SUP00840
       ORA     AC                                                       SUP00850
       TRA     AGAIN                                                    SUP00860
AC     BSS     1                                                        SUP00870
..     EQU     0                                                        SUP00880
*                                                                       SUP00890
*                   CHANNEL TABLES                                      SUP00900
*                                                                       SUP00910
       RTDB    5                                                        SUP00920
       RTDA    5                                                        SUP00930
       NOP                                                              SUP00940
RDSX   XEC     *-1,2                                                    SUP00950
       WTDB    5                                                        SUP00960
       WTDA    5                                                        SUP00970
       NOP                                                              SUP00980
WRSX   XEC     *-1,2                                                    SUP00990
       WEFB    5                                                        SUP01000
       WEFA    5                                                        SUP01010
       NOP                                                              SUP01020
WEFX   XEC     *-1,2                                                    SUP01030
       BSRB    5                                                        SUP01040
       BSRA    5                                                        SUP01050
       NOP                                                              SUP01060
BSRX   XEC     *-1,2                                                    SUP01070
       BSFB                                                             SUP01080
       BSFA                                                             SUP01090
       NOP                                                              SUP01100
BSFX   XEC     *-1,2                                                    SUP01110
       REWB    5                                                        SUP01120
       REWA    5                                                        SUP01130
       NOP                                                              SUP01140
REWX   XEC     *-1,2                                                    SUP01150
       OCT     477200000000                                             SUP01160
       OCT     477200000000                                             SUP01170
       NOP                                                              SUP01180
RUNX   XEC     *-1,2                                                    SUP01190
       OCT     076000002352                                             SUP01200
       OCT     076000001352                                             SUP01210
       NOP                                                              SUP01220
RDCX   XEC     *-1,2                                                    SUP01230
       RCHB    0,4                                                      SUP01240
       RCHA    0,4                                                      SUP01250
       NOP                                                              SUP01260
RCHX   XEC     *-1,2                                                    SUP01270
       LCHB    0,4                                                      SUP01280
       LCHA    0,4                                                      SUP01290
       NOP                                                              SUP01300
LCHX   XEC     *-1,2                                                    SUP01310
       SCHB    REGB                                                     SUP01320
       SCHA    REGA                                                     SUP01330
       NOP                                                              SUP01340
SCHX   XEC     *-1,2                                                    SUP01350
       TCOB    0,4                                                      SUP01360
       TCOA    0,4                                                      SUP01370
       NOP                                                              SUP01380
TCOX   XEC     *-1,2                                                    SUP01390
       TEFB    0,4                                                      SUP01400
       TEFA    0,4                                                      SUP01410
       NOP                                                              SUP01420
TEFX   XEC     *-1,2                                                    SUP01430
       TRCB    0,4                                                      SUP01440
       TRCA    0,4                                                      SUP01450
       NOP                                                              SUP01460
TRCX   XEC     *-1,2                                                    SUP01470
       BTTB                                                             SUP01480
       BTTA                                                             SUP01490
       NOP                                                              SUP01500
BTTX   XEC     *-1,2                                                    SUP01510
       ETTB                                                             SUP01520
       ETTA                                                             SUP01530
       NOP                                                              SUP01540
ETTX   XEC     *-1,2                                                    SUP01550
REGB   PZE     ..                                                       SUP01560
REGA   PZE     ..                                                       SUP01570
       NOP                                                              SUP01580
CHREG  CAL     *-1,2                                                    SUP01590
       PZE     ..,,..   ADR = L(I-O COMMAND)  DEC = ACTION INDICATORS   SUP01600
       PZE     ..,,..                                                   SUP01610
       NOP                                                              SUP01620
CHIND  CAL     *-1,2                                                    SUP01630
       PZE     ..,,0    ADR = L(SPECIAL CHECKING ROUTINE)               SUP01640
       PZE     ..,,0                                                    SUP01650
       NOP                                                              SUP01660
SCNAC  ZET     *-1,2    SKIP ON CHANNEL NOT ACTIVE                      SUP01670
       PZE     0,,..    DEC = CHANNEL ERROR CODE / BIT 14-17 ON FOR     SUP01680
       PZE     0,,..    POSITIVE TESTS OF BTTX, TE0FX, TRCX, AND ETTX.  SUP01690
       NOP                                                              SUP01700
CHERR  CAL     *-1,2                                                    SUP01710
       END                                                              SUP01720
       COUNT   60                                                       UNIT0000
       LBL     UNIT,X                                                   UNIT0010
*UNIT   I-O UNIT TABLE FOR IOPAR - SAO - NORRIS - JULY 61               UNIT0020
*                                                                       UNIT0030
       ENTRY   UNIT                                                     UNIT0040
*                                                                       UNIT0050
UNIT   CAL     BASE,4                                                   UNIT0060
       PZE     PRINT                                                    UNIT0070
       PZE     PUNCH                                                    UNIT0080
       PZE     READ                                                     UNIT0090
       PZE     B0                                                       UNIT0100
       PZE     B9                                                       UNIT0110
       PZE     B8                                                       UNIT0120
       PZE     B7                                                       UNIT0130
       PZE     B6                                                       UNIT0140
       PZE     A0                                                       UNIT0150
       PZE     A9                                                       UNIT0160
       PZE     A8                                                       UNIT0170
       PZE     A7                                                       UNIT0180
       PZE     A6                                                       UNIT0190
       PZE     B5                                                       UNIT0200
       PZE     A5                                                       UNIT0210
       PZE     B1                                                       UNIT0220
       PZE     B4                                                       UNIT0230
       PZE     A3                                                       UNIT0240
       PZE     A2                                                       UNIT0250
       PZE     A4                                                       UNIT0260
       PZE     B3                                                       UNIT0270
       PZE     B2                                                       UNIT0280
       PZE     A1                                                       UNIT0290
BASE   PZE     BASE,,NUNITS                                             UNIT0300
       PZE     READ                                                     UNIT0310
       PZE     PUNCH                                                    UNIT0320
       PZE     PRINT                                                    UNIT0330
NUNITS EQU     BASE-UNIT-1                                              UNIT0340
READ   BOOL    1321                                                     UNIT0350
PUNCH  BOOL    1341                                                     UNIT0360
PRINT  BOOL    1361                                                     UNIT0370
A1     BOOL    1201                                                     UNIT0380
A2     BOOL    1202                                                     UNIT0390
A3     BOOL    1203                                                     UNIT0400
A4     BOOL    1204                                                     UNIT0410
A5     BOOL    1205                                                     UNIT0420
A6     BOOL    1206                                                     UNIT0430
A7     BOOL    1207                                                     UNIT0440
A8     BOOL    1210                                                     UNIT0450
A9     BOOL    1211                                                     UNIT0460
A0     BOOL    1212                                                     UNIT0470
B1     BOOL    2201                                                     UNIT0480
B2     BOOL    2202                                                     UNIT0490
B3     BOOL    2203                                                     UNIT0500
B4     BOOL    2204                                                     UNIT0510
B5     BOOL    2205                                                     UNIT0520
B6     BOOL    2206                                                     UNIT0530
B7     BOOL    2207                                                     UNIT0540
B8     BOOL    2210                                                     UNIT0550
B9     BOOL    2211                                                     UNIT0560
B0     BOOL    2212                                                     UNIT0570
       END                                                              UNIT0580
       COUNT   50                                                       SCF00000
       LBL     IOSCF,X                                                  SCF00010
*IOSCF  I-O STANDARD CHANNEL FLAGER  FOR IOPAR - SAO - NORRIS - JULY 61 SCF00020
*                                                                       SCF00030
*       SETS C(CHERRX) BIT 14-17 ON FOR POSITIVE TESTS - BTTX, TEFX,    SCF00040
*       TRCX, AND ETTX (BITS OFF OTHERWISE).                            SCF00050
*       IR2 MUST HAVE CHANNEL INDEX                                     SCF00060
*                                                                       SCF00070
       ENTRY   IOSCF                                                    SCF00080
       ENTRY   IOSCA                                                    SCF00090
*                                                                       SCF00100
IOSCF  SXD     IOSCF-2,4                                                SCF00110
       STZ     SKPFG                                                    SCF00120
       TTR     *+3                                                      SCF00130
IOSCA  XEC     IOSCF                                                    SCF00140
       STL     SKPFG                                                    SCF00150
       STI     SAVIND                                                   SCF00160
       XEC*    $SCHX                                                    SCF00170
       IOT                                                              SCF00180
       CALL    IOTER                                                    SCF00190
ONCE7  TRA     *+1                                                      SCF00200
       CAL*    $CHERR                                                   SCF00210
       STA     WCHERR                                                   SCF00220
       STL     ONCE7                                                    SCF00230
WCHERR LDI     ..,2                                                     SCF00240
       NZT     SKPFG                                                    SCF00250
       RIL     11                                                       SCF00260
       SIL     06                                                       SCF00270
       XEC*    $BTTX                                                    SCF00280
       SIL     10                                                       SCF00290
       XEC*    $ETTX                                                    SCF00300
       SIL     01                                                       SCF00310
       AXC     EOF,4                                                    SCF00320
       XEC*    $TEFX                                                    SCF00330
       RIL     04                                                       SCF00340
EOF    AXC     RED,4                                                    SCF00350
       XEC*    $TRCX                                                    SCF00360
       RIL     02                                                       SCF00370
RED    STI*    WCHERR                                                   SCF00380
       LDI     SAVIND                                                   SCF00390
       LXD     IOSCF-2,4                                                SCF00400
       TRA     1,4                                                      SCF00410
SAVIND PZE                                                              SCF00420
SKPFG  PZE                                                              SCF00430
..     EQU     0                                                        SCF00440
       END                                                              SCF00450
       COUNT   30                                                       IOT00000
       LBL     IOTER,X                                                  IOT00010
*IOTER   I-O  IOT ERROR ROUTINE FOR IOPAR - SAO - NORRIS - JULY 61      IOT00020
*                                                                       IOT00030
*        XR2 MUST CONTAIN CHANNEL INDEX                                 IOT00040
*                                                                       IOT00050
       ENTRY   IOTER                                                    IOT00060
*                                                                       IOT00070
IOTER  SXD     IOTER-2,4                                                IOT00080
       STI     SAVIND                                                   IOT00090
ONCE3  TRA     *+1                                                      IOT00100
       CAL*    $CHERR                                                   IOT00110
       STA     WCHERR                                                   IOT00120
       STL     ONCE3                                                    IOT00130
       XEC*    $CHIND                                                   IOT00140
       PAI                    DISPLAY ACTION INDICATORS                 IOT00150
       LFT     002000                                                   IOT00160
       HPR     0,3                                                      IOT00170
       LFT     000600                                                   IOT00180
       HPR     0,5                                                      IOT00190
       LFT     002600                                                   IOT00200
       TRA     WCHERR                                                   IOT00210
       LFT     001100                                                   IOT00220
       HPR     0,4                                                      IOT00230
WCHERR LDI     ..,2                                                     IOT00240
       SIL     400000                                                   IOT00250
       STI*    WCHERR                                                   IOT00260
       LDI     SAVIND                                                   IOT00270
       LXD     IOTER-2,4                                                IOT00280
