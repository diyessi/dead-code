*     LIST8                                                             IPM2A220
*     LABEL                                                             IPM2A221
      SUBROUTINE PIV1                                                   IPM2A222
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIPM2A223
     1,KC1,BND,ALPHA,N7,N8,NSW3                                         IPM2A224
      DIMENSION A(204,104),LT(104),B(104),KC(104),JORDER(104),JZEROS(104IPM2A225
     1),KR(204),U(204),D(204),INDEX(204),ALPHA(3)                       IPM2A226
      KC1=KR(I1)                                                        IPM2A227
      DO 3 J=1,N                                                        IPM2A228
    3 B(J)=A(I1,J)                                                      IPM2A229
   23 DNM=1.0                                                           IPM2A230
      KSIG=0                                                            IPM2A231
      TOL=0.0                                                           IPM2A232
      J1=JORDER(KC1)                                                    IPM2A233
      IF (B(J1)+100000.0)31,30,30                                       IPM2A234
   31 V=INTF(-B(J1)/100.0)                                              IPM2A235
      DO 32 J=1,N                                                       IPM2A236
      BB=B(J)/V                                                         IPM2A237
      B(J)=INTF(BB)                                                     IPM2A238
      IF (B(J)-BB)32,32,34                                              IPM2A239
   34 B(J)=B(J)-1.0                                                     IPM2A240
   32 CONTINUE                                                          IPM2A241
   27 J1=JORDER(KC1)                                                    IPM2A242
   30 IF (B(J1)+1.0)4,5,4                                               IPM2A243
    4 KSIG=1                                                            IPM2A244
      DIV=-(B(J1))                                                      IPM2A245
      DNM=MAX1F(1.0,INTF(DNM*DIV+.5))                                   IPM2A246
      IF (DNM-100000.0)8,8,18                                           IPM2A247
    8 TOL=.5/DNM                                                        IPM2A248
      DO 6 J=1,N                                                        IPM2A249
    6 B(J)=B(J)/DIV                                                     IPM2A250
    5 ASTR=0.0                                                          IPM2A251
      DO 10 I=2,M1                                                      IPM2A252
      IF (KR(I)-KC1)11,10,10                                            IPM2A253
   11 AA=A(I,1)+A(I,J1)*B(1)                                            IPM2A254
      IF (AA+TOL)25,10,10                                               IPM2A255
   25 IF (ABSF(ASTR-AA)-TOL)15,15,16                                    IPM2A256
   15 IF (KR(I)-KR(I1))17,10,10                                         IPM2A257
   16 IF (ASTR-AA)10,999,17                                             IPM2A258
  999 CALL OFF (5H PIV1,9,ASTR,AA)                                      IPM2A259
   17 ASTR=AA                                                           IPM2A260
      I1=I                                                              IPM2A261
   10 CONTINUE                                                          IPM2A262
      IF (ASTR)14,9,999                                                 IPM2A263
   14 KC1=0                                                             IPM2A264
      B(1)=ASTR                                                         IPM2A265
      DO 13 J=2,N                                                       IPM2A266
      B(J)=A(I1,J)+A(I1,J1)*B(J)                                        IPM2A267
      IF (B(J)+TOL)20,13,13                                             IPM2A268
   20 IF (KC(J)-KC1)13,997,21                                           IPM2A269
  997 CALL OFF (5H PIV1,10,J,JORDER(KC1))                               IPM2A270
   21 KC1=KC(J)                                                         IPM2A271
   13 CONTINUE                                                          IPM2A272
      IF (KC1)24,24,27                                                  IPM2A273
    9 IF (KSIG)996,24,18                                                IPM2A274
  996 CALL OFF (5H PIV1,11,KSIG,0)                                      IPM2A275
   18 DO 19 J=1,N                                                       IPM2A276
      BB=B(J)+TOL                                                       IPM2A277
      B(J)=INTF(BB)                                                     IPM2A278
      IF (BB)22,19,19                                                   IPM2A279
   22 B(J)=B(J)-1.0                                                     IPM2A280
   19 CONTINUE                                                          IPM2A281
      GO TO 23                                                          IPM2A282
   24 RETURN                                                            IPM2A283
      END                                                               IPM2A284
