*     FORTRAN                                                           GAM2 000
      SUBROUTINE GAM2 (AINPUT,XINPUT,ER,GAM,GIM,H,SW)                   GAM2 001
C                                                                       GAM2 002
C   AS WRITTEN, THE CALLING SEQUENCE REQUIRES SINGLE PRECISION ARGUMENTSGAM2 003
C   FOR BOTH ITS INPUT AND OUTPUT DATA.                                 GAM2 004
C                                                                       GAM2 005
C   THE FIRST SEVERAL CARDS AFTER THE DIMENSION STATEMENTS ( CARDS      GAM2 006
C   NUMBERED 96 THROUGH 102) ALLOW THE USER THE OPTION OF CHOOSING      GAM2 007
C   WHETHER THIS CALLING SEQUENCE IS TO CONTAIN  SINGLE- OR DOUBLE-     GAM2 008
C   PRECISION ARGUMENTS.                                                GAM2 009
C                                                                       GAM2 010
C                                                                       GAM2 011
D     DIMENSION CS(8)                                                   GAM2 012
      DIMENSION  A(2),X(2),GAMD(2),GIMD(2),BD(2)                        GAM2 013
C                                                                       GAM2 014
  96  A(1)=AINPUT                                                       GAM2 015
  97  A(2)=0.                                                           GAM2 016
  98  X(1)=XINPUT                                                       GAM2 017
  99  X(2)=0.                                                           GAM2 018
      GO TO 110                                                         GAM2 019
C                                                                       GAM2 020
 100  GAM=GAMD(1)                                                       GAM2 021
 101  GIM=GIMD(1)                                                       GAM2 022
 102  H=BD(1)                                                           GAM2 023
      RETURN                                                            GAM2 024
C                                                                       GAM2 025
C  NOTE                                                                 GAM2 026
C     TO CHANGE FROM A SINGLE- TO A DOUBLE- PRECISION CALLING SEQUENCE, GAM2 027
C     ALTER STATEMENTS 96 TO 102 BY FIRST PLACING A -D- IN COLUMN ONE,  GAM2 028
C     INSTEAD OF  -C- , AND THEN SUBSTITUTE THE FOLLOWING CARDS.        GAM2 029
C  96 A=AINPUT                                                          GAM2 030
C  97 CONTINUE   (OR OMIT THIS CARD IF YOU WISH.)                       GAM2 031
C  98 X=XINPUT                                                          GAM2 032
C  99 CONTINUE   (OR OMIT THIS CARD IF YOU WISH.)                       GAM2 033
C 100 GAM=GAMD                                                          GAM2 034
C 101 GIM=GIMD                                                          GAM2 035
C 102 H=BD                                                              GAM2 036
C     THE SUBROUTINE WHICH CALLS GAM2 MUST THEN HAVE A -D- IN COLUMN ONEGAM2 037
C     IN STATEMENTS WHICH REFER TO  AINPUT, XINPUT, GAM, GIM, AND H.    GAM2 038
C                                                                       GAM2 039
C                                                                       GAM2 040
C                                                                       GAM2 041
 110  CONTINUE                                                          GAM2 042
C     CS(1)=(1./6.)/(1.*2.)                                             GAM2 043
D     CS(1)=8.333333333333333E-2                                        GAM2 044
C     CS(2)=(1./30.)/(3.*4.)                                            GAM2 045
D     CS(2)=2.777777777777778E-3                                        GAM2 046
C     CS(3)=(1./42.)/(5.*6.)                                            GAM2 047
D     CS(3)=7.936507936507936E-4                                        GAM2 048
C     CS(4)=(1./30.)/(7.*8.)                                            GAM2 049
D     CS(4)=.0005952380952380                                           GAM2 050
C     CS(5)=(5./66.)/(9.*10.)                                           GAM2 051
D     CS(5)=.0008417508417508                                           GAM2 052
C     CS(6)=(691./2730.)/(11.*12.)                                      GAM2 053
D     CS(6)=.001917526917526917                                         GAM2 054
C     CS(7)=(7./6.)/(13.*14.)                                           GAM2 055
D     CS(7)=.00641025641025                                             GAM2 056
C     CS(8)=(3617./510.)/(15.*16.)                                      GAM2 057
C     CS(8)=.02955065359                                                GAM2 058
D     CK=5.0E-16                                                        GAM2 059
D     PI=3.141592653589793                                              GAM2 060
C     TPIL=LOGF(2.*PI)                                                  GAM2 061
D     TPIL=1.837877066409345                                            GAM2 062
 121  ER=0.                                                             GAM2 063
D     PA=INTF(A)                                                        GAM2 064
      IPA=XINTF(A)                                                      GAM2 065
      IF(X-CK)123,123,130                                               GAM2 066
C                                                                       GAM2 067
D123  GAMD=1.                                                           GAM2 068
D     GIMD=0.                                                           GAM2 069
D     BD=0.                                                             GAM2 070
      GO TO 100                                                         GAM2 071
C                                                                       GAM2 072
 130  IF(A-CK)133,133,140                                               GAM2 073
D133  IF(A- PA)135,137,137                                              GAM2 074
 135  ER=9.                                                             GAM2 075
D137  GAMD=0.                                                           GAM2 076
D     GIMD=1.                                                           GAM2 077
D     BD=0.                                                             GAM2 078
      GO TO 100                                                         GAM2 079
C                                                                       GAM2 080
 140  CONTINUE                                                          GAM2 081
 141  NL=7                                                              GAM2 082
D     BCOE=1.                                                           GAM2 083
D     TB=A                                                              GAM2 084
C      IF  A  LESS THAN 8, GAMMA(A) CALCULATED BACKWARDS FROM GAMMA(8)  GAM2 085
C       UNLESS A=AN INTEGER  IN WHICH CASE THE FACTORIAL IS CALCULATED  GAM2 086
C       DIRECTLY.                                                       GAM2 087
D     IF(A - 8.) 152,157,157                                            GAM2 088
D152  TB=8. + A - PA                                                    GAM2 089
D     IF(A-PA)153,170,153                                               GAM2 090
D153  TC=TB-CK                                                          GAM2 091
D     WPX=(A-TB)*LOGF(X)                                                GAM2 092
      DO 155 I=1,11                                                     GAM2 093
C     NL CHOSEN SO AS TO GIVE 13 DECIMAL PLACES IN THE LOG GAMMA(A)     GAM2 094
D     IF(TC-A)165,165,154                                               GAM2 095
D154  BCOE=BCOE*TC                                                      GAM2 096
D155  TC=TC-1.                                                          GAM2 097
C                                                                       GAM2 098
D157  WPX=0.                                                            GAM2 099
      IF(IPA-15)165,165,158                                             GAM2 100
 158  IF(IPA-100)159,161,161                                            GAM2 101
 159  NL=5                                                              GAM2 102
      GO TO 165                                                         GAM2 103
 161  NL=3                                                              GAM2 104
 165  GO TO 178                                                         GAM2 105
                                                                        GAM2 106
 170  ICOE=1                                                            GAM2 107
      DO 175 I=1,IPA                                                    GAM2 108
 175  ICOE=ICOE*I                                                       GAM2 109
D     AFAC=ICOE                                                         GAM2 110
D     BCOE=1./AFAC                                                      GAM2 111
D     GGB=A*LOGF(X)-X                                                   GAM2 112
      GO TO 184                                                         GAM2 113
C                                                                       GAM2 114
C     CALCULATION OF THE POISSON TERM USING STIRLING'S SERIES           GAM2 115
D178  RS=-1./(TB*TB)                                                    GAM2 116
      NL1=NL+1                                                          GAM2 117
D     GS=0.0                                                            GAM2 118
      DO 180 J=1,NL                                                     GAM2 119
      JS=NL1-J                                                          GAM2 120
D180  GS=GS*RS+CS(JS)                                                   GAM2 121
D     SERB=GS/TB                                                        GAM2 122
D     WPP=(TPIL + LOGF(TB))/2. + SERB                                   GAM2 123
D181  WPT=LOGF(X/TB) + 1. - (X/TB)                                      GAM2 124
D     GGB=TB*WPT - WPP +WPX                                             GAM2 125
C                                                                       GAM2 126
 184  IF(GGB + 80.) 185,188,188                                         GAM2 127
 185  IF(X-A)123,186,137                                                GAM2 128
 186  ER=7.                                                             GAM2 129
      RETURN                                                            GAM2 130
D 188 BD=BCOE*EXPF(GGB)                                                 GAM2 131
      CALL GAM21(A,X,SW,GAMD,GIMD,BD,ER,IPA )                           GAM2 132
 190  GO TO 100                                                         GAM2 133
C                                                                       GAM2 134
      END                                                               GAM2 135
*     FORTRAN                                                           GAM2 136
      SUBROUTINE GAM21(A,X,SW,GAMD,GIMD,BD,ER,IPA )                     GAM2 137
C                                                                       GAM2 138
C     THIS SUBROUTINE CORRESPONDS TO  -WHICH-  IN SUBROUTINE GAMA       GAM2 139
C     AND IS THE SUBROUTINE WHICH MAKES THE CHOICE OF METHOD AS         GAM2 140
C     A FUNCTION OF REGIONS OF -X- AND -A- .                            GAM2 141
C     JP IS THE POWER OF TWO WHICH LIMITS THE RELATIVE ACCURACY .       GAM2 142
C     FOR 10 SIGNIFICANT DIGITS SET  JP = -34 (APPROX.)                 GAM2 143
C     FOR  8 SIGNIF. DIGITS SET  JP=-28 (APPROX.) FOR -X- LESS THAN  A1.GAM2 144
      IGAUS = -1                                                        GAM2 145
      JP=-34                                                            GAM2 146
      IW=SW                                                             GAM2 147
      IWS=1 - IW*IW                                                     GAM2 148
      ONE=1.0000001                                                     GAM2 149
      A1=200.                                                           GAM2 150
      A5=5.5                                                            GAM2 151
      JA6=30100                                                         GAM2 152
      AN1=ONE                                                           GAM2 153
      IF(A-32700.)75,75,70                                              GAM2 154
C                                                                       GAM2 155
 70   IPA=32700                                                         GAM2 156
      GO TO 111                                                         GAM2 157
 75   JA2=75                                                            GAM2 158
      IF(X-A1) 76,111,111                                               GAM2 159
C                                                                       GAM2 160
 76   A3=500.                                                           GAM2 161
      JA4=23                                                            GAM2 162
 80   IF(A-INTF(A))84,83,84                                             GAM2 163
 83   AN1=A3/A                                                          GAM2 164
      IF(IPA - JA2) 100,100,98                                          GAM2 165
 84   CONTINUE                                                          GAM2 166
 85   IF(IPA + IX - JA4) 102,102,98                                     GAM2 167
 98   IF(X-A)102,100,100                                                GAM2 168
 100  IASYM=1                                                           GAM2 169
      GO TO 104                                                         GAM2 170
 102  IASYM=-1                                                          GAM2 171
 104  IF(X-A)107,105,105                                                GAM2 172
 105  IF( X -1.) 107,107,106                                            GAM2 173
 106  ICNFR=1                                                           GAM2 174
      GO TO 109                                                         GAM2 175
 107  ICNFR=-1                                                          GAM2 176
 109  IF(IPA-JA6*IWS) 120,120,111                                       GAM2 177
C                                                                       GAM2 178
D111  TRD=.333333333333333                                              GAM2 179
D     V=9.0*A                                                           GAM2 180
      JP=-38                                                            GAM2 181
D     V3=3.*V**3                                                        GAM2 182
D     ZEAN=1. - 1./V  + 10./V3                                          GAM2 183
D     SIGMA = SQRTF( 1./V  -13./V3 )                                    GAM2 184
D     ZD= ( (X/A)**TRD  -  ZEAN  )/SIGMA                                GAM2 185
C                                                                       GAM2 186
 110  IF(IPA - JA6*IWS) 117,117,114                                     GAM2 187
C                                                                       GAM2 188
C     CORRECTION TERM TO THE NORMAL VARIATE  (BIOMETRIKA, 1960 )        GAM2 189
D114  CQ=1.0                                                            GAM2 190
D     ZSQ=ZD*ZD                                                         GAM2 191
D     VSQR = SQRTF(V)                                                   GAM2 192
D     H= -(2.*(ZSQ-CQ)/VSQR  -  (ZSQ*ZD - 3.*ZD )/4.  )/(3.*V)          GAM2 193
D     ZD=ZD+H                                                           GAM2 194
C                                                                       GAM2 195
C                                                                       GAM2 196
      IF(ABSF(ZD) - A5) 113,113,116                                     GAM2 197
 113  IF(IPA - JA6) 116,115,115                                         GAM2 198
 115  IGAUS=1                                                           GAM2 199
      ICNFR=-1                                                          GAM2 200
      IASYM=-1                                                          GAM2 201
      GO TO 120                                                         GAM2 202
 116  IGAUS=-1                                                          GAM2 203
 117  IF(X-A1) 120,125,125                                              GAM2 204
 120  CALL       GAM22(IASYM,ICNFR,IGAUS,A,X,IW,GAMD,GIMD,BD,ER,ZD,AN1, GAM2 205
     1 JP,A1)                                                           GAM2 206
      RETURN                                                            GAM2 207
C                                                                       GAM2 208
 125  A8L= .037*SQRTF(A) + .7                                           GAM2 209
      A8U1=3.0 + .00007*A                                               GAM2 210
      A8U2=3.5 + .000033*A                                              GAM2 211
      A8U3=5.5                                                          GAM2 212
      A7=MIN1F(A8L,A8U1,A8U2,A8U3 )                                     GAM2 213
C                                                                       GAM2 214
      IF(ZD-A7) 126,126,129                                             GAM2 215
 126  ICNFR=-1                                                          GAM2 216
      IF(X-A) 127,128,128                                               GAM2 217
 127  IASYM=-1                                                          GAM2 218
      GO TO 112                                                         GAM2 219
 128  IASYM=1                                                           GAM2 220
      GO TO 112                                                         GAM2 221
 129  IASYM=-1                                                          GAM2 222
      ICNFR=1                                                           GAM2 223
 112  GO TO 120                                                         GAM2 224
C                                                                       GAM2 225
      END                                                               GAM2 226
*     LABEL                                                                     
*     FAP                                                               GAM2 227
*                                                                       GAM2 228
*                                                                       GAM2 229
*                                                                       GAM2 230
       COUNT   5                                                        GAM2 231
       ENTRY   ICHR                                                     GAM2 232
 ICHR  CLA*    1,4                                                      GAM2 233
       SSP                                                              GAM2 234
       ARS     9                                                        GAM2 235
       TRA     2,4                                                      GAM2 236
*                                                                       GAM2 237
*                                                                       GAM2 238
*                                                                       GAM2 239
       END                                                              GAM2 240
*     FORTRAN                                                           GAM2 241
      SUBROUTINE GAM22(IASYM,ICNFR,IGAUS,AQ,XQ,IW,GAMD,GIMD,BD,ER,ZD,   GAM2 242
     1 AN1,JP,A1 )                                                      GAM2 243
C                                                                       GAM2 244
C     THIS SUBROUTINE USES METHODS A,B,C OR D TO CALCULATE GAMMA(A,X)/GAGAM2 245
C                                                                       GAM2 246
      DIMENSION EER(4)                                                  GAM2 247
D     A=AQ                                                              GAM2 248
D     X=XQ                                                              GAM2 249
      DO 190 I=1,4                                                      GAM2 250
 190  EER(I)=0.                                                         GAM2 251
      ICNV=-1                                                           GAM2 252
C                                                                       GAM2 253
C                                                                       GAM2 254
      IF(XMAX0F(IASYM,ICNFR,IGAUS))191,191,192                          GAM2 255
 191  ICNV=1                                                            GAM2 256
 192  IF(IW)196,197,196                                                 GAM2 257
D196  GAMT=0                                                            GAM2 258
D     GAMS=0                                                            GAM2 259
D     GAMR=0                                                            GAM2 260
D     GAAM=0                                                            GAM2 261
      ZS=0.                                                             GAM2 262
      ZT=0.                                                             GAM2 263
      ZR=0.                                                             GAM2 264
D     ZG=0.                                                             GAM2 265
      GO TO 701                                                         GAM2 266
 197  IF(IGAUS)198,198,700                                              GAM2 267
 198  IF(IASYM)199,199,300                                              GAM2 268
 199  IF(ICNFR)200,200,600                                              GAM2 269
C                                                                       GAM2 270
C                                                                       GAM2 271
C                                                                       GAM2 272
C     CONVERGENT SERIES FOR SMALL X (METHOD A )                         GAM2 273
      FREQUENCY 207(1,1,10)                                             GAM2 274
 200  CONTINUE                                                          GAM2 275
D201  T=1.                                                              GAM2 276
D202  SUMT=1.                                                           GAM2 277
D     ZT=0.                                                             GAM2 278
 203  DO 230 NT=1,50                                                    GAM2 279
      DO 220 JT=1,NT                                                    GAM2 280
C                                                                       GAM2 281
D204  ZT=ZT+1.                                                          GAM2 282
D205  T=T*X/(A+ZT)                                                      GAM2 283
D220  SUMT=SUMT+T                                                       GAM2 284
C     TEST FOR SUFFICIENT NUMBER OF TERMS                               GAM2 285
      JRAT=ICHR(T)-ICHR(SUMT)                                           GAM2 286
 207  IF(JRAT-JP)240,240,230                                            GAM2 287
 230  CONTINUE                                                          GAM2 288
      EER(1)=5.                                                         GAM2 289
D240  GAMT=1.0-BD*SUMT                                                  GAM2 290
      GO TO 400                                                         GAM2 291
C                                                                       GAM2 292
C                                                                       GAM2 293
C                                                                       GAM2 294
C  (METHOD B)                                                           GAM2 295
C     ASYMPTOTIC SERIES FOR LARGE X,A GREATER THAN 1                    GAM2 296
      FREQUENCY 325(1,1,10)                                             GAM2 297
 300  CONTINUE                                                          GAM2 298
 301  CONTINUE                                                          GAM2 299
D     S=1.                                                              GAM2 300
D     SUMS=1.                                                           GAM2 301
D     ZS=0.                                                             GAM2 302
      DO 330 NS=1,50                                                    GAM2 303
      DO 320 JS=1,NS                                                    GAM2 304
C                                                                       GAM2 305
D     ZS=ZS+1.                                                          GAM2 306
D     CE=(A-ZS)/X                                                       GAM2 307
      IF(ABSF(CE) - AN1) 315,340,340                                    GAM2 308
D315  S = CE*S                                                          GAM2 309
D320  SUMS=SUMS+S                                                       GAM2 310
C     ACCURACY TEST FOR SUFFICIENT NUMBER OF TERMS                      GAM2 311
      JRAS=ICHR(S)-ICHR(SUMS)                                           GAM2 312
 325  IF(JRAS-JP)350,350,330                                            GAM2 313
 330  CONTINUE                                                          GAM2 314
      EER(2)=5.                                                         GAM2 315
 340  EER(2)=2. + EER(2)                                                GAM2 316
D     GAMS=(A/X)*BD*SUMS                                                GAM2 317
      IASYM=-1                                                          GAM2 318
      IF(IW) 199,199,601                                                GAM2 319
D350  GAMS=(A/X)*BD*SUMS                                                GAM2 320
      IF(IASYM)352,352,351                                              GAM2 321
 351  ICNFR=-1                                                          GAM2 322
 352  IF(IW)400,400,601                                                 GAM2 323
C                                                                       GAM2 324
C                                                                       GAM2 325
C                                                                       GAM2 326
C                                                                       GAM2 327
C  (METHOD C)                                                           GAM2 328
C     CONTINUED FRACTION APPROX.(ODD PART.)                             GAM2 329
      FREQUENCY 642(100,100,0),632(100,100,0)                           GAM2 330
 600  CONTINUE                                                          GAM2 331
 601  CZR=1.0E+35                                                       GAM2 332
D     AAM=1./X                                                          GAM2 333
D     XSQ=X*X                                                           GAM2 334
D602  BBM=1.                                                            GAM2 335
D603  AA=(X+1.)/XSQ                                                     GAM2 336
D604  BB=(X+2.-A)/X                                                     GAM2 337
D605  APPX=AA/BB                                                        GAM2 338
 620  DO 647 N=2,500                                                    GAM2 339
C                                                                       GAM2 340
D621  SN=N                                                              GAM2 341
D622  AC=-(SN-1.)*(SN-A)/XSQ                                            GAM2 342
D623  BC=(X+2.*SN-A)/X                                                  GAM2 343
D624  AAP=BC*AA+AC*AAM                                                  GAM2 344
D625  AAA=ABSF(AAP)                                                     GAM2 345
 642  IF(AAA-CZR)643,643,655                                            GAM2 346
 643  CONTINUE                                                          GAM2 347
D644  BBP=BC*BB+AC*BBM                                                  GAM2 348
D645  BBB=ABSF(BBP)                                                     GAM2 349
D632  IF(BBB-CZR)633,633,655                                            GAM2 350
 633  CONTINUE                                                          GAM2 351
D634  AAM=AA                                                            GAM2 352
D635  AA=AAP                                                            GAM2 353
D636  BBM=BB                                                            GAM2 354
D637  BB=BBP                                                            GAM2 355
D638  APPXM=APPX                                                        GAM2 356
D639  APPX=AA/BB                                                        GAM2 357
D     APXD=(APPX - APPXM)                                               GAM2 358
 640  JRAR=ICHR(APXD) - ICHR(APPXM)                                     GAM2 359
 641  IF(JRAR-JP)650,650,647                                            GAM2 360
 647  CONTINUE                                                          GAM2 361
      EER(3)=5                                                          GAM2 362
 650  ZR=3*N                                                            GAM2 363
D     GAMR=BD*A*APPX                                                    GAM2 364
      IF(GAMR)660,660,651                                               GAM2 365
 651  IF(IW)400,400,201                                                 GAM2 366
C                                                                       GAM2 367
C                                                                       GAM2 368
C     IN CASE OF FLOATING POINT SPILL IN CONTINUED FRACTIONS METHOD     GAM2 369
D655  GAMR=BD*A*APPX                                                    GAM2 370
 660  EER(3)=3                                                          GAM2 371
      ZR=3*N                                                            GAM2 372
      IF(X-A1)663,661,661                                               GAM2 373
 661  IF(X-A) 663,663,662                                               GAM2 374
 662  IASYM=1                                                           GAM2 375
 663  ICNFR=-1                                                          GAM2 376
      IF(IW)198,198,201                                                 GAM2 377
C                                                                       GAM2 378
C                                                                       GAM2 379
C                                                                       GAM2 380
C                                                                       GAM2 381
C  (METHOD D) CALLING SEQUENCE.                                         GAM2 382
 700  CONTINUE                                                          GAM2 383
 701  CALL       GAM23( ZD,GAAM,ZG,JRAG,A,X,BD )                        GAM2 384
      IF(GAAM)775,780,780                                               GAM2 385
 775  EER(4)=4.                                                         GAM2 386
D     GAAM=ABSF(GAAM)                                                   GAM2 387
      IGAUS=-1                                                          GAM2 388
      GO TO 198                                                         GAM2 389
 780  IF(IGAUS) 783,783,781                                             GAM2 390
 781  ICNFR=-1                                                          GAM2 391
      IASYM=-1                                                          GAM2 392
 783  IF(IW) 198,400,301                                                GAM2 393
C                                                                       GAM2 394
C                                                                       GAM2 395
C                                                                       GAM2 396
C  SELECTION OF THE BEST VALUES WHEN MORE THAN ONE METHOD WAS USED.     GAM2 397
 400  ICHZ=1+(1*(1+ICNV)+2*(1+IASYM)+3*(1+ICNFR)+4*(1+IGAUS))/2         GAM2 398
      IF(ICHZ-5)402,402,401                                             GAM2 399
 401  ICHZ=6                                                            GAM2 400
 402  GO TO (403,404,405,406,407,408),ICHZ                              GAM2 401
D404  GAMD=GAMT                                                         GAM2 402
      GO TO 410                                                         GAM2 403
D405  GAMD=GAMS                                                         GAM2 404
      GO TO 410                                                         GAM2 405
D406  GAMD=GAMR                                                         GAM2 406
      GO TO 410                                                         GAM2 407
D407  GAMD=GAAM                                                         GAM2 408
      GO TO 410                                                         GAM2 409
 403  EER(1)=2                                                          GAM2 410
D408  GAMD=0                                                            GAM2 411
      EER(4)=2                                                          GAM2 412
D410  GIMD = 1. - GAMD                                                  GAM2 413
      ER=EER(1)+EER(2)+EER(3)+EER(4)+ER                                 GAM2 414
      IF(IW)425,420,425                                                 GAM2 415
 420  RETURN                                                            GAM2 416
 425  CALL       GAM24(EER,GAMT,GAMS,GAMR,GAAM,GAMD,GIMD,BD,ZD,ZG,ZS,ZT,GAM2 417
     1ZR,A,X,JRAT,JRAS,JRAR,JRAG,IGAUS,IASYM,ICNFR,ICNV,IW,JP )         GAM2 418
      RETURN                                                            GAM2 419
C                                                                       GAM2 420
C                                                                       GAM2 421
      END                                                               GAM2 422
*     FORTRAN                                                           GAM2 423
      SUBROUTINE GAM23( ZD,GAAM,ZG,JRAG,A,X,BD )                        GAM2 424
C       R2PIS = 1./SQRTF((2.*PI)                                        GAM2 425
D     R2PIS=0.398942280401433                                           GAM2 426
      IF(A-10.) 300,200,200                                             GAM2 427
D200  EX=1.                                                             GAM2 428
      JG=-38                                                            GAM2 429
C                                                                       GAM2 430
C     EXPANSION FOR THE ERROR FUNCTION (GAUSSIAN APPROX. )              GAM2 431
D201  T=1.                                                              GAM2 432
D     SUMG=1.                                                           GAM2 433
D     ZG2=1.                                                            GAM2 434
D     ZG=0.                                                             GAM2 435
D     ZS=(ZD*ZD)/2.                                                     GAM2 436
C                                                                       GAM2 437
 210  DO 230 NG=1,20                                                    GAM2 438
 211  DO 220 JG=1,NG                                                    GAM2 439
C                                                                       GAM2 440
D 212 ZG2=ZG2+2.                                                        GAM2 441
D213  ZG=ZG + 1.                                                        GAM2 442
D214  T=-ZS*T/ZG                                                        GAM2 443
D215  G=1./ZG2                                                          GAM2 444
D216  GT=G*T                                                            GAM2 445
D220  SUMG=GT + SUMG                                                    GAM2 446
C                                                                       GAM2 447
C      TEST FOR SUFFICIENT NUMBER OF TERMS                              GAM2 448
      JRAG=ICHR(GT) - ICHR(SUMG)                                        GAM2 449
      IF(JRAG-JG) 240,240,230                                           GAM2 450
 230  CONTINUE                                                          GAM2 451
D     EX=-1.                                                            GAM2 452
C                                                                       GAM2 453
D240  GS=ZD*R2PIS*SUMG                                                  GAM2 454
D     GAAM=(.5 - GS)*EX                                                 GAM2 455
      RETURN                                                            GAM2 456
C                                                                       GAM2 457
C       EXPONENTIAL APPROXIMATION .  GOOD FOR VERY LOW VALUES OF  A.    GAM2 458
C     USEFUL ONLY AS A CHECK ON THE CONVERGENT-SERIES CALCULATIONS .    GAM2 459
C   NOTE.                                                               GAM2 460
C     IF SPACE IS LIMITED, THE REMAINING PORTION OF THIS SUBROUTINE     GAM2 461
C     (GAM23) MAY BE OMITTED FROM THE PROGRAM AND REPLACED BY THE SINGLEGAM2 462
C     STATEMENT                                                         GAM2 463
C 300  RETURN                                                           GAM2 464
C                                                                       GAM2 465
D300  XE=1.                                                             GAM2 466
D     SUME=1.                                                           GAM2 467
D     S=A                                                               GAM2 468
      DO 330 JE=1,200                                                   GAM2 469
D     ZE=JE                                                             GAM2 470
D     S=-S*X/ZE                                                         GAM2 471
D     SE=S/(ZE + A)                                                     GAM2 472
D320  SUME=SE + SUME                                                    GAM2 473
      JRG=ICHR(SE)                                                      GAM2 474
      IF(JRG - 200) 322,322,350                                         GAM2 475
 322  JRAG=JRG - ICHR(SUME)                                             GAM2 476
      IF(JRAG-JG) 340,340,330                                           GAM2 477
 330  CONTINUE                                                          GAM2 478
D     XE=-1.                                                            GAM2 479
D340  GAAM= (1. - BD*EXPF(X)*SUME )*XE                                  GAM2 480
D     ZG=ZE*1.3                                                         GAM2 481
      RETURN                                                            GAM2 482
C                                                                       GAM2 483
C                                                                       GAM2 484
D350  GAAM = -1.                                                        GAM2 485
      RETURN                                                            GAM2 486
C                                                                       GAM2 487
      END                                                               GAM2 488
*     FORTRAN                                                           GAM2 489
      SUBROUTINE GAM24(EER,GAMT,GAMS,GAMR,GAAM,GAMD,GIMD,BD,ZD,ZG,ZS,ZT,GAM2 490
     1ZR,A,X,JRAT,JRAS,JRAR,JRAG,IGAUS,IASYM,ICNFR,ICNV,IW,JP )         GAM2 491
C                                                                       GAM2 492
C     THIS SUBROUTINE ACCOMPLISHES THE PRINT-OUT WHEN SWITCH -SW- IS    GAM2 493
C     SET EQUAL TO PLUS OR MINUS ONE.   IF SPACE IS LIMITED, AND THE    GAM2 494
C     COMPARISON OF METHODS AND PRINT OUT FEATURE IS NOT DESIRED        GAM2 495
C     (I.E. SWITCH SW=0 ALWAYS.) THEN THIS SUBROUTINE (GAM24) MAY BE    GAM2 496
C     REPLACED BY THE SINGLE STATEMENT                                  GAM2 497
C     RETURN                                                            GAM2 498
C     WHICH SHOULD BE PLACED IMMEDIATELY AFTER THE DIMENSION STATEMENT. GAM2 499
C                                                                       GAM2 500
      DIMENSION EER(5)                                                  GAM2 501
      IPA=A                                                             GAM2 502
      IF(IPA-IPPA) 40,50,40                                             GAM2 503
 40   WRITE OUT PUT TAPE 6,902,JP                                       GAM2 504
 50   WRITE OUTPUT TAPE 6,903                                           GAM2 505
 903  FORMAT(1H  )                                                      GAM2 506
      IPPA=IPA                                                          GAM2 507
C                                                                       GAM2 508
      DO 450 I=1,4                                                      GAM2 509
      GO TO (200,100,300,400 ),I                                        GAM2 510
 100  NS=-ZS                                                            GAM2 511
      IF(IW-NS  ) 450,110,110                                           GAM2 512
D110  NV=ICHR(GAMS-GAMD)                                                GAM2 513
      NS=NS*IASYM                                                       GAM2 514
      NVA=NV-ICHR(GAMD)                                                 GAM2 515
      NVI=NV-ICHR(GIMD)                                                 GAM2 516
      HS1=(+6HASYMPT)                                                   GAM2 517
      HS2=(+6HOTIC. )                                                   GAM2 518
D     BFL=A*LOGF(X) - X                                                 GAM2 519
      IF(BFL-75.) 140,140,145                                           GAM2 520
D140  BFT=EXPF(BFL)/BD                                                  GAM2 521
      GO TO 150                                                         GAM2 522
D145   BFT=-0.                                                          GAM2 523
D150  GIMS=1.-GAMS                                                      GAM2 524
      WRITE OUTPUT TAPE 6,901,HS1,HS2,EER(2), A,X,NS,JRAS,NVA,NVI,GAMS, GAM2 525
     1 GIMS,GIMD                                                        GAM2 526
      GO TO 450                                                         GAM2 527
 200  NT=-ZT                                                            GAM2 528
      IF(IW - NT ) 450,210,210                                          GAM2 529
D210  NV=ICHR(GAMT-GAMD)                                                GAM2 530
      NT=NT*ICNV                                                        GAM2 531
      NVI=NV-ICHR(GIMD)                                                 GAM2 532
      NVA=NV-ICHR(GAMD)                                                 GAM2 533
      HS1=(+6HCONVER)                                                   GAM2 534
      HS2=(+6HGENT  )                                                   GAM2 535
D     GIMT=1.-GAMT                                                      GAM2 536
      WRITE OUTPUT TAPE 6,901,HS1,HS2,EER(1), A,X,NT,JRAT,NVA,NVI,GAMT, GAM2 537
     1 GIMT,BD                                                          GAM2 538
      GO TO 450                                                         GAM2 539
 300  NR=-ZR                                                            GAM2 540
      IF(IW -NR  ) 450,310,310                                          GAM2 541
D310  NV=ICHR(GAMR-GAMD)                                                GAM2 542
      NR=NR*ICNFR                                                       GAM2 543
      NVA=NV-ICHR(GAMD)                                                 GAM2 544
      NVI=NV-ICHR(GIMD)                                                 GAM2 545
      HS1=(+6HCONT.F)                                                   GAM2 546
      HS2=(+6HRACT. )                                                   GAM2 547
D     GIMR=1.-GAMR                                                      GAM2 548
D     U=X/SQRTF(A)                                                      GAM2 549
      WRITE OUTPUT TAPE 6,901,HS1,HS2,EER(3), A,U,NR,JRAR,NVA,NVI,GAMR, GAM2 550
     1 GIMR,GAMD                                                        GAM2 551
      GO TO 450                                                         GAM2 552
 400  NG=-ZG                                                            GAM2 553
      IF(IW -NG  ) 450,410,410                                          GAM2 554
D410  GGDI = (GAMD - GAAM)                                              GAM2 555
      GNV=GGDI                                                          GAM2 556
      NV=ICHR(GNV)                                                      GAM2 557
      NG=NG*IGAUS                                                       GAM2 558
      NVA=NV-ICHR(GAMD)                                                 GAM2 559
      NVI=NV-ICHR(GIMD)                                                 GAM2 560
      IF(A-10.)415,415,420                                              GAM2 561
 415  HS1=(+6HEXPONE )                                                  GAM2 562
      HS2=(+6HNTIAL  )                                                  GAM2 563
      GO TO 430                                                         GAM2 564
 420  HS1=(+6H GAUSS)                                                   GAM2 565
      HS2=(+6HIAN +  )                                                  GAM2 566
D430  GIIM=1.-GAAM                                                      GAM2 567
      WRITE OUTPUT TAPE 6,901,HS1,HS2,EER(4),A,ZD,NG,JRAG,NVA,NVI,GAAM, GAM2 568
     1GIIM,GGDI                                                         GAM2 569
      GO TO 450                                                         GAM2 570
 450  CONTINUE                                                          GAM2 571
 902  FORMAT(119H1 METHODS   ERR.       A        X,U,Z     ITERATION    GAM2 572
     1 ACCURACIES           GAM                            H (OR D     /GAM2 573
     2       119H                    VARIABLE   VARIABLE     COUNT      GAM2 574
     3EXP. -BASE 2                       GIM=1-GAM       EXACT-EST.)   /GAM2 575
     4  54X,I3,12H  /GAM /GIM                                          )GAM2 576
 901  FORMAT( 1X,2A6,F3.0,1X,2F11.4, 5X,I4,4X, 3I5, 2X, 3E17.8  )       GAM2 577
      RETURN                                                            GAM2 578
C                                                                       GAM2 579
C                                                                       GAM2 580
C                                                                       GAM2 581
C     SUBROUTINE  GAM24  REQUIRES ABOUT 4100 WORDS OF MEMORY.           GAM2 582
C     THE FIRST PART OF ITS OUTPUT LOOKS LIKE                           GAM2 583
C                                                                       GAM2 584
C                                                                            585
C      METHODS   ERR.     A          X,U,Z     ITERATION    ACCURACIES       586
C                      VARIABLE    VARIABLES     COUNT     EXP. -BASE 2      587
C                                                         -38  /GAM /GIM     588
C                                                                            589
C     CONVERGENT   5.  70000.0000 71480.0000     1275       -7   25   -0     590
C     ASYMPTOTIC.  0.  70000.0000 71480.0000     -861      -39 -102 -128     591
C     CONT.FRACT.  0.  70000.0000   270.1690       42      -38  -34  -60     592
C      GAUSSIAN +  0.  70000.0000     5.5562       66      -52  -12  -38     593
C                                                                            594
C                                                                            595
C     HERE  A=70000.  X=71480.  U(PEARSONS VAR.)=270.169  AND  Z=5.5562 GAM2 596
C                                                                       GAM2 597
C     THE  5.  UNDER  ERR.  INDICATES AN ERROR IN  METHOD A  DUE TO     GAM2 598
C     THE MAXIMUM ITERATION COUNT BEING REACHED FOR THIS METHOD.        GAM2 599
C                                                                       GAM2 600
C     THE ITERATION COUNT -IS AN EFFECTIVE COUNT- BASED ON THE NUMBER   GAM2 601
C     OF MACHINE CYCLES REQUIRED BY METHOD A  FOR EACH ITERATION.       GAM2 602
C                                                                       GAM2 603
C     E.G. THE INDICATED EFFECTIVE ITERATION COUNT FOR METHOD C (CONT.  GAM2 604
C     FRACT.) IS 3 TIMES THE ACTUAL NUMBER OF ITERATIONS FOR THAT       GAM2 605
C     METHOD.                                                           GAM2 606
C                                                                       GAM2 607
C                                                                       GAM2 608
C     A MINUS SIGN ON THE ITERATION COUNT IS USED TO INDICATE THE       GAM2 609
C     OPTIMUM METHOD, THE ONE TO BE EMPLOYED WHEN SWITCH SW = 0.        GAM2 610
C                                                                       GAM2 611
C     ACCURACIES ARE EXPRESSED AS INTEGER POWERS OF 2.                  GAM2 612
C     THE FIRST NUMBER IS THE RELATIVE SIZE OF THE FIRST OMITTED        GAM2 613
C     POWER SERIES TERM.                                                GAM2 614
C     THE SECOND IS THE RELATIVE ERROR IN GAM, COMPUTED BY COMPARISON   GAM2 615
C     WITH THE OPTIMUM METHOD VALUE.                                    GAM2 616
C     THE THIRD IS THE RELATIVE ERROR IN GIM.                           GAM2 617
C                                                                       GAM2 618
C                                                                       GAM2 619
C     THE NEXT TWO COLUMNS OF PRINT-OUT (NOT-SHOWN) GIVE THE ACTUAL     GAM2 620
C     VALUES OF -GAM- AND -GIM- EXPRESSED AS 8 PLACE FLOATING POINT NOS.GAM2 621
C     FOR EACH METHOD OF COMPUTATION,                                   GAM2 622
C                                     AND THE LAST COLUMN (NOT SHOWN)   GAM2 623
C     GIVES H(THE POISSON TERM), GIM(OPTIMUM),GAM(OPTIMUM), AND         GAM2 624
C     THE DIFFERENCE  GAM(METHOD D)  MINUS  GAM(OPTIMUM METHOD).        GAM2 625
C                                                                       GAM2 626
C                                                                       GAM2 627
C     WHEN SWITCH SW=0., THERE IS NO PRINT-OUT                          GAM2 628
C     AND THE COMPUTATIONS ARE PERFORMED BY ONLY ONE METHOD.            GAM2 629
      END                                                               GAM2 630
