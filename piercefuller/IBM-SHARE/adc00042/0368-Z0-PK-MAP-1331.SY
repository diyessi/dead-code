*     LIST8                                                                     
      COMMON X,Y,SYM,ALXSQ,ALYSQ,BETAX,BETAY,HSQ                                
      DIMENSION X(100),Y(100),SYM(36),ALXSQ(100),ALYSQ(100),BETAX(100),B        
     1ETAY(100),HSQ(100),ITILE(2),ISEG(2),II(2)                                 
      READ INPUT TAPE 7,50,A,B,H1,H2,Z                                          
      ADD=0.0                                                                   
      DO 10 K=1,100                                                             
      X(K)=Z+ADD                                                                
      Y(K)=Z+ADD                                                                
      ADD=ADD+.05                                                               
   10 CONTINUE                                                                  
      WRITE OUTPUT TAPE 10,700,(X(J),Y(J),J=1,100)                              
      REWIND 1                                                                  
      DO 11 J=1,100                                                             
      ALX1=((H1**2)+(X(J)**2)+(A**2))+SQRTF((((H1**2)+(X(J)**2)+(A**2))*        
     1*2)-(4.*(A**2)*(X(J)**2)))                                                
      ALX1=1./SQRTF(ALX1)                                                       
      ALX1=ALX1*(-H1/(A*SQRTF(2.)))                                             
      ALX2=(1.+(X(J)**2+H1**2+A**2))*(((H1**2+X(J)**2+A**2)**2)-4.*A**2*        
     1X(J)**2)                                                                  
      ALX2=1./SQRTF(ALX2)                                                       
      ALX2=2.+ALX2                                                              
      ALPHX=ALX1*ALX2                                                           
      ALXSQ(J)=ALPHX*ALPHX                                                      
      ALY1=((H2**2)+(Y(J)**2)+(B**2))+SQRTF((((H2**2)+(Y(J)**2)+(B**2))*        
     1*2)-(4.*(B**2)*(Y(J)**2)))                                                
      ALY1=1./SQRTF(ALY1)                                                       
      ALY1=ALY1*(-H2/(B*SQRTF(2.)))                                             
      ALY2=(1.+(Y(J)**2+H2**2+B**2))*(((H2**2+Y(J)**2+B**2)**2)-4.*B**2*        
     1Y(J)**2)                                                                  
      ALY2=1./SQRTF(ALY2)                                                       
      ALY2=2.+ALY2                                                              
      ALPHY=ALY1*ALY2                                                           
      ALYSQ(J)=ALPHY*ALPHY                                                      
      BETAX(J)=(H1**2+X(J)**2+A**2)+SQRTF((H1**2+X(J)**2+A**2)**2-4.*A**        
     12*X(J)**2)*(1./2.*A**2)                                                   
      BETAY(J)=(H2**2+Y(J)**2+B**2)+SQRTF((H2**2+Y(J)**2+B**2)**2-4.*B**        
     12*Y(J)**2)*(1./2.*B**2)                                                   
   11 CONTINUE                                                                  
      DO 13 I=1,100                                                             
      DO 12 J=1,100                                                             
      HSQ(J)=(ALXSQ(I)/(BETAX(I)-1.))+(ALYSQ(J)/(BETAY(J)-1.))                  
   12 CONTINUE                                                                  
      WRITE TAPE 1,(HSQ(L),L=1,100)                                             
   13 CONTINUE                                                                  
      REWIND 1                                                                  
      READ INPUT TAPE 7,51,(SYM(J),J=1,36)                                      
      DO 14 LL = 1,2                                                            
      REWIND 1                                                                  
      ISENSE = LL-1                                                             
      CALL MAP(100,100,3,26,SYM,ISENSE,0,26,9,0)                                
   14 CONTINUE                                                                  
   50 FORMAT (2F4.1,2F4.2,F5.1)                                                 
   51 FORMAT (36A1)                                                             
 700  FORMAT (2F9.3)                                                            
      CALL EXIT                                                                 
      END                                                                       
*     DATA                                                                      
15.015.00.250.50+12.5                                                           
ABCDEFGHIJKLMNOPQRSTUVWXYZ123456789*                                            
*     LIST8                                                             MAP 0001
*     LABEL                                                             MAP 0002
CPKMAP                                                                  MAP 0003
*CONTOUR MAP - 7090 VERSION                                             MAP 0004
      SUBROUTINE MAP(MM,NN,KKK,KKKK,SYM,ISENSE,ITOTL,ITILE,ISEG,II)     MAP 0005
      DIMENSION A(100,100),T(4097),AT(100,100),SYM(36),TIN(26),TAX(26), MAP 0006
     1ITILE(5),ISEG(5),II(5),NTABLE(26),MTABLE(9)                       MAP 0007
C        FOR EQUAL NUMERICAL RANGE IN EACH SEGMENT, ISENSE = 0.         MAP 0008
C        FOR EQUAL NUMBER OF ELEMENTS IN EACH SEGMENT, ISENSE = NON-ZEROMAP 0009
      M=MM                                                              MAP 0010
      N=NN                                                              MAP 0011
      GO TO (402,403,404),KKK                                           MAP 0012
C        CARD INPUT, WRITE ORIGINAL MATRIX AND MAP.                     MAP 0013
 402  DO 10 I=1,M                                                       MAP 0014
 10   READ INPUT TAPE 7,4,(A(I,J),J=1,N)                                MAP 0015
      WRITE OUTPUT TAPE 10,600                                          MAP 0016
      DO 20 I=1,M                                                       MAP 0017
 20   WRITE OUTPUT TAPE 10,4,(A(I,J),J=1,N)                             MAP 0018
      GO TO 700                                                         MAP 0019
C        TAPE INPUT, WRITE ORIGINAL MATRIX AND MAP.                     MAP 0020
 403  DO 420 I=1,M                                                      MAP 0021
 420  READ TAPE 1,(A(I,J),J=1,N)                                        MAP 0022
      WRITE OUTPUT TAPE 10,600                                          MAP 0023
      DO 430 I=1,M                                                      MAP 0024
 430  WRITE OUTPUT TAPE 10,4,(A(I,J),J=1,N)                             MAP 0025
      GO TO 700                                                         MAP 0026
C        TAPE INPUT, WRITE MAP ONLY.                                    MAP 0027
 404  DO 440 I=1,M                                                      MAP 0028
 440  READ TAPE 1,(A(I,J),J=1,N)                                        MAP 0029
 700  L=0                                                               MAP 0030
C        CONVERT TWO-DIMENSIONAL ARRAY TO ONE-DIMENSION.                MAP 0031
      DO 30 J=1,N                                                       MAP 0032
      DO 30 I=1,M                                                       MAP 0033
      L=L+1                                                             MAP 0034
 30   A(L)=A(I,J)                                                       MAP 0035
      J=0                                                               MAP 0036
      I=M*N                                                             MAP 0037
C        BIG IS COMPLEX ELEMENT REPRESENTATION.                         MAP 0038
B     BIG=377777777777                                                  MAP 0039
      DO 40 L=1,I                                                       MAP 0040
      IF (A(L)-BIG)40,15,40                                             MAP 0041
 15   J=J+1                                                             MAP 0042
C        J IS NUMBER OF COMPLEX ELEMENTS.                               MAP 0043
 40   CONTINUE                                                          MAP 0044
      IF (J-I) 901,900,901                                              MAP 0045
C        IF ALL ELEMENTS ARE COMPLEX, GO TO END OF PROGRAM WITH NO MAP. MAP 0046
 901  NCE=J                                                             MAP 0047
      NROWS=M                                                           MAP 0048
      NCOLS=N                                                           MAP 0049
      N = KKKK                                                          MAP 0050
C        N IS NUMBER OF SEGMENTS REQUESTED.                             MAP 0051
      NREAL = I-J                                                       MAP 0052
C        NREAL IS NUMBER OF REAL ELEMENTS IN ENTIRE ARRAY.              MAP 0053
      CALL SORT (A,T,L,AT)                                              MAP 0054
      IF (ISENSE)102,102,101                                            MAP 0055
 101  NINSEG = NREAL/N                                                  MAP 0056
      LREMIN = NREAL-(N*NINSEG)                                         MAP 0057
C        SET UP MAX,MIN,FREQUENCY TABLE FOR EQUAL SEGMENTS.             MAP 0058
      CALL MIMAX(ISENSE,AT,N,TIN,TAX,NTABLE,NINSEG,LREMIN)              MAP 0059
      WRITE OUTPUT TAPE 10,999                                          MAP 0060
      WRITE OUTPUT TAPE 10,109                                          MAP 0061
      GO TO 103                                                         MAP 0062
 102  FLOATN = N                                                        MAP 0063
C        SET UP MAX,MIN,FREQUENCY TABLE FOR EQUAL RANGES.               MAP 0064
      CALL MIMAX(ISENSE,AT,FLOATN,N,TIN,TAX,NTABLE,NREAL,RANGE)         MAP 0065
      WRITE OUTPUT TAPE 10,999                                          MAP 0066
      WRITE OUTPUT TAPE 10,79,RANGE                                     MAP 0067
 103  WRITE OUTPUT TAPE 10,89,(SYM(J),NTABLE(J),TIN(J),TAX(J),J=1,N)    MAP 0068
      IF (ITOTL)800,800,802                                             MAP 0069
 802  LLLL = 0                                                          MAP 0070
      DO 805 LBAR = 1,ITOTL                                             MAP 0071
      FLISEG = ISEG(LBAR)                                               MAP 0072
      IITILE = ITILE(LBAR)                                              MAP 0073
      ITOTAL = 0                                                        MAP 0074
      IISEG = ISEG(LBAR)                                                MAP 0075
      IF (IITILE-1)811,812,811                                          MAP 0076
 811  DO 810 LL = 2,IITILE                                              MAP 0077
 810  ITOTAL = ITOTAL + NTABLE(LL-1)                                    MAP 0078
 812  IF (ISENSE)105,105,104                                            MAP 0079
 104  NINSEG = NTABLE(IITILE)/IISEG                                     MAP 0080
      LREMIN=NTABLE(IITILE)-(IISEG*NINSEG)                              MAP 0081
C        SET UP MAX,MIN,FREQUENCY TABLE FOR SUBDIVISION OF EQUAL SEGS.  MAP 0082
      CALL MIMAX(ISENSE,AT(ITOTAL+1),IISEG,TIN,TAX,MTABLE(LLLL+1),      MAP 0083
     1NINSEG,LREMIN)                                                    MAP 0084
      WRITE OUTPUT TAPE 10,99,SYM(IITILE)                               MAP 0085
      WRITE OUTPUT TAPE 10,109                                          MAP 0086
      GO TO 106                                                         MAP 0087
C        SET UP MAX,MIN,FREQUENCY TABLE FOR SUBDIVISION OF EQUAL RANGES.MAP 0088
 105  CALL MIMAX(ISENSE,AT(ITOTAL+1),FLISEG,IISEG,TIN,TAX,MTABLE(LLLL+1)MAP 0089
     1,NTABLE(IITILE),RANGE)                                            MAP 0090
      WRITE OUTPUT TAPE 10,99,SYM(IITILE)                               MAP 0091
      WRITE OUTPUT TAPE 10,79,RANGE                                     MAP 0092
 106  DO 803 LL=1,IISEG                                                 MAP 0093
      III=II(LBAR)+LL+26                                                MAP 0094
      IIII=LLLL+LL                                                      MAP 0095
 803  WRITE OUTPUT TAPE 10,89,SYM(III),MTABLE(IIII),TIN(LL),TAX(LL)     MAP 0096
 805  LLLL=LLLL+ISEG(LBAR)                                              MAP 0097
C        STORE SYMBOLS IN MAJOR ARRAY.                                  MAP 0098
 800  CALL STSYM(AT,SYM,L,NTABLE,NCE)                                   MAP 0099
      IF(ITOTL)500,500,501                                              MAP 0100
 501  DO 505 LBAR = 1,ITOTL                                             MAP 0101
      IITILE=ITILE(LBAR)                                                MAP 0102
      III=II(LBAR)+27                                                   MAP 0103
      ITOTAL=0                                                          MAP 0104
      IIII = II(LBAR)+1                                                 MAP 0105
      IF(IITILE-1)815,816,815                                           MAP 0106
 815  DO 821 LL=2,IITILE                                                MAP 0107
 821  ITOTAL=ITOTAL+NTABLE(LL-1)                                        MAP 0108
C        STORE SYMBOLS IN ONE OR MORE SUBDIVISIONS.                     MAP 0109
 816  CALL STSYM(AT(ITOTAL+1),SYM(III),NTABLE(IITILE), MTABLE(IIII),0)  MAP 0110
 505  CONTINUE                                                          MAP 0111
C        WRITE MAP.                                                     MAP 0112
 500  WRITE OUTPUT TAPE 10,12                                           MAP 0113
      K=1                                                               MAP 0114
      KK = L-NROWS+1                                                    MAP 0115
      DO 70 J=1,NROWS                                                   MAP 0116
      WRITE OUTPUT TAPE 10,13,(A(L),L=K,KK,NROWS)                       MAP 0117
      K=K+1                                                             MAP 0118
 70   KK=KK+1                                                           MAP 0119
      GO TO 998                                                         MAP 0120
 900  WRITE OUTPUT TAPE 10,905                                          MAP 0121
 998  WRITE OUTPUT TAPE 10,999                                          MAP 0122
 4    FORMAT (4E18.8)                                                   MAP 0123
 12   FORMAT (15H1CONTOUR MATRIX///)                                    MAP 0124
 13   FORMAT (10H          100A1)                                       MAP 0125
 79   FORMAT(///29H THE RANGE OF EACH SEGMENT = E16.8,///7H SYMBOL,5X,  MAP 0126
     19HFREQUENCY,15X,7HMINIMUM,20X,7HMAXIMUM//)                        MAP 0127
 99   FORMAT(///22H SYMBOL SUBDIVIDED IS 1A1)                           MAP 0128
 89   FORMAT(4X,1A1,10X,I4,8X,E18.8,8X,E18.8)                           MAP 0129
 109  FORMAT (///7H SYMBOL,5X,9HFREQUENCY,15X,7HMINIMUM,20X,7HMAXIMUM//)MAP 0130
 600  FORMAT (16H1ORIGINAL MATRIX)                                      MAP 0131
 905  FORMAT (4X,77HTHERE IS NO MAP SINCE ALL ELEMENTS ARE COMPLEX AND WMAP 0132
     1OULD APPEAR AS ASTERISKS.)                                        MAP 0133
 999  FORMAT (1H1)                                                      MAP 0134
      RETURN                                                            MAP 0135
      END                                                               MAP 0136
*     LABEL                                                             MAP 0137
*     FAP                                                               MAP 0138
*SORT                                                                   MAP 0139
       COUNT   310                                                      MAP 0140
       ENTRY   SORT                                                     MAP 0141
 SORT  SXA     FINIS,1                                                  MAP 0142
       SXA     XR2,2                                                    MAP 0143
       SXA     XR4,4                                                    MAP 0144
       CLA 1,4               A - ORIGINAL MATRIX                        MAP 0145
       ADD FONE                                                         MAP 0146
       STA LPA1                                                         MAP 0147
       STA LPB1                                                         MAP 0148
       STA LPB1L                                                        MAP 0149
       CLA 2,4               T - COUNTING TABLE                         MAP 0150
       STA LPA1T                                                        MAP 0151
       STA LPA1T+2                                                      MAP 0152
       STA LPA2T                                                        MAP 0153
       STA LPA2T+2                                                      MAP 0154
       STA LPA3T                                                        MAP 0155
       STA LPA3T+2                                                      MAP 0156
       STA LPT                                                          MAP 0157
       STA LPT+1                                                        MAP 0158
       ADD FONE                                                         MAP 0159
       STA LPB1T                                                        MAP 0160
       STA LPB1T+3                                                      MAP 0161
       STA LPB2T                                                        MAP 0162
       STA LPB2T+3                                                      MAP 0163
       STA LPB3T                                                        MAP 0164
       STA LPB3T+3                                                      MAP 0165
       ADD FONE                                                         MAP 0166
       STA ZT+1                                                         MAP 0167
       CLA 3,4               L - TOTAL NUMBER OF ELEMENTS               MAP 0168
       STA *+1                                                          MAP 0169
       CLA **                                                           MAP 0170
       STO L                                                            MAP 0171
       STD LPB1-2                                                       MAP 0172
       STD LPA2-2                                                       MAP 0173
       STD LPB2-2                                                       MAP 0174
       STD LPA3-2                                                       MAP 0175
       STD LPB3-2                                                       MAP 0176
       STD SWTCH-2                                                      MAP 0177
       CLA 4,4               AT - MATRIX AFTER SORT, WHICH WILL CONTAIN MAP 0178
       STA     LPB1L+5       THE LOCATIONS OF THE SORTED ELEMENTS,      MAP 0179
       STA LPB2T+6           RATHER THAN THE NUMERICAL ELEMENTS         MAP 0180
       STA LPB3T+5           THEMSELVES.                                MAP 0181
       ADD FONE                                                         MAP 0182
       STA LPA2                                                         MAP 0183
       STA LPB2                                                         MAP 0184
       STA LPA3                                                         MAP 0185
       STA LPB3                                                         MAP 0186
       STA SWTCH                                                        MAP 0187
       STA SWTCH+2                                                      MAP 0188
       STA SWTCH+5                                                      MAP 0189
       STA SHIFT+1                                                      MAP 0190
       STA AGAIN-2                                                      MAP 0191
       STA AGAIN                                                        MAP 0192
       STA AGAIN+4                                                      MAP 0193
       STA AGAIN+6                                                      MAP 0194
       TSX ZT,4                                                         MAP 0195
 LPA1  CAL **,1              FIRST PASS                                 MAP 0196
       ANA MSK                                                          MAP 0197
       PAX 0,4                                                          MAP 0198
 LPA1T CLA **,4                                                         MAP 0199
       ADD FONE                                                         MAP 0200
       STO **,4                                                         MAP 0201
       TXI *+1,1,1                                                      MAP 0202
       TXL LPA1,1,**                                                    MAP 0203
       TSX PT,4                                                         MAP 0204
 LPB1  CLA **,1                                                         MAP 0205
       ANA MSK                                                          MAP 0206
       PAX 0,4                                                          MAP 0207
 LPB1T CLA **,4                                                         MAP 0208
       PAX 0,2                                                          MAP 0209
       ADD FONE                                                         MAP 0210
       STO **,4                                                         MAP 0211
 LPB1L CAL **,1                                                         MAP 0212
       PXD 0,1                                                          MAP 0213
       ARS 18                                                           MAP 0214
       SUB CON                                                          MAP 0215
       ACL LPB1L                                                        MAP 0216
       STA **,2                                                         MAP 0217
       TXI *+1,1,1                                                      MAP 0218
       TXL LPB1,1,**                                                    MAP 0219
       TSX ZT,4                                                         MAP 0220
 LPA2  CLA **,1              SECOND PASS                                MAP 0221
       STA LPA2+2                                                       MAP 0222
       CAL **                                                           MAP 0223
       ALS 6                                                            MAP 0224
       ANA MSK                                                          MAP 0225
       PDX 0,4                                                          MAP 0226
 LPA2T CLA **,4                                                         MAP 0227
       ADD FONE                                                         MAP 0228
       STO **,4                                                         MAP 0229
       TXI *+1,1,1                                                      MAP 0230
       TXL LPA2,1,**                                                    MAP 0231
       TSX PT,4                                                         MAP 0232
 LPB2  CLA **,1                                                         MAP 0233
       STA LPB.                                                         MAP 0234
 LPB.  CAL **                                                           MAP 0235
       ALS 6                                                            MAP 0236
       ANA MSK                                                          MAP 0237
       PDX 0,4                                                          MAP 0238
 LPB2T CLA **,4                                                         MAP 0239
       PAX 0,2                                                          MAP 0240
       ADD FONE                                                         MAP 0241
       STO **,4                                                         MAP 0242
       CAL LPB.                                                         MAP 0243
       ALS 18                                                           MAP 0244
       STD **,2                                                         MAP 0245
       TXI *+1,1,1                                                      MAP 0246
       TXL LPB2,1,**                                                    MAP 0247
       TSX ZT,4                                                         MAP 0248
 LPA3  CLA **,1              THIRD PASS                                 MAP 0249
       ARS 18                                                           MAP 0250
       STA LPA3+3                                                       MAP 0251
       CAL **                                                           MAP 0252
       ARS 6                                                            MAP 0253
       PDX 0,4                                                          MAP 0254
 LPA3T CLA **,4                                                         MAP 0255
       ADD FONE                                                         MAP 0256
       STO **,4                                                         MAP 0257
       TXI *+1,1,1                                                      MAP 0258
       TXL LPA3,1,**                                                    MAP 0259
       TSX PT,4                                                         MAP 0260
 LPB3  CLA **,1                                                         MAP 0261
       ARS 18                                                           MAP 0262
       STA LPB3.                                                        MAP 0263
 LPB3. CAL **                                                           MAP 0264
       ARS 6                                                            MAP 0265
       PDX 0,4                                                          MAP 0266
 LPB3T CLA **,4                                                         MAP 0267
       PAX 0,2                                                          MAP 0268
       ADD FONE                                                         MAP 0269
       STO **,4                                                         MAP 0270
       CAL LPB3.                                                        MAP 0271
       STA **,2                                                         MAP 0272
       TXI *+1,1,1                                                      MAP 0273
       TXL LPB3,1,**                                                    MAP 0274
       LXD L,1                                                          MAP 0275
 SWTCH CLA **,1              MOVE LOCATIONS FROM ADDRESS TO DECREMENT   MAP 0276
       ALS 18                PORTION OF AT.                             MAP 0277
       STD **,1                                                         MAP 0278
       TIX SWTCH,1,1                                                    MAP 0279
       LXD L,1                                                          MAP 0280
       CLA **,1                                                         MAP 0281
       STA *+1                                                          MAP 0282
       CLA **                                                           MAP 0283
       TMI SHIFT                                                        MAP 0284
 FINIS AXT     **,1                                                     MAP 0285
 XR2   AXT     **,2                                                     MAP 0286
 XR4   AXT     **,4                                                     MAP 0287
       TRA 5,4               RETURN TO MAIN PROGRAM.                    MAP 0288
 SHIFT LXD L,1                                                          MAP 0289
       CLA **,1                                                         MAP 0290
       STA *+1                                                          MAP 0291
       CLA **                                                           MAP 0292
       TPL NOM               COUNT NEGATIVE NUMBERS.                    MAP 0293
       TIX SHIFT+1,1,1                                                  MAP 0294
 NOM   PXD 0,1                                                          MAP 0295
       STO COUNT             COUNT EQUALS NUMBER OF POSITIVE NUMBERS.   MAP 0296
       CLA L                                                            MAP 0297
       SUB COUNT                                                        MAP 0298
       STO COUNT                                                        MAP 0299
       PDX 0,1                                                          MAP 0300
       LXA FONE,2                                                       MAP 0301
       LXD L,4                                                          MAP 0302
       CLA **,4                                                         MAP 0303
       ARS 18                                                           MAP 0304
 AGAIN STA **,2              FLIP NEGATIVE NUMBERS TO BOTTOM OF SORT.   MAP 0305
       TXI *+1,2,1                                                      MAP 0306
       TIX *+1,4,1                                                      MAP 0307
       TIX AGAIN-2,1,1                                                  MAP 0308
       CLA **,1                                                         MAP 0309
       ARS 18                                                           MAP 0310
       STA **,2                                                         MAP 0311
       TXI *+1,1,1                                                      MAP 0312
       TXI *+1,2,1                                                      MAP 0313
       TIX AGAIN+4,4,1                                                  MAP 0314
       TRA FINIS                                                        MAP 0315
 PT    AXT     4096,1                                                   MAP 0316
       AXT     -1,2                                                     MAP 0317
       CLA C                                                            MAP 0318
 LPT   ADD **,2                                                         MAP 0319
       STO **,2                                                         MAP 0320
       TNX *+2,1,1                                                      MAP 0321
       TXI LPT,2,1                                                      MAP 0322
       LXA FONE,1                                                       MAP 0323
       TRA 1,4                                                          MAP 0324
 ZT    AXT     4097,1        ZERO COUNTING TABLE.                       MAP 0325
       STZ **,1                                                         MAP 0326
       TIX *-1,1,1                                                      MAP 0327
       LXA FONE,1                                                       MAP 0328
       TRA 1,4                                                          MAP 0329
 CON   OCT 100000                                                       MAP 0330
 ZERO  PZE                                                              MAP 0331
 FONE  DEC 1                                                            MAP 0332
 C     PZE                                                              MAP 0333
 COUNT PZE                                                              MAP 0334
 MSK   OCT 007777007777                                                 MAP 0335
    L  PZE                                                              MAP 0336
       END                                                              MAP 0337
*     LABEL                                                             MAP 0338
*     FAP                                                               MAP 0339
*MIMAX                                                                  MAP 0340
       COUNT   60                                                       MAP 0341
       ENTRY   MIMAX                                                    MAP 0342
MIMAX  SXA     IR1,1                                                    MAP 0343
       SXA     IR2,2                                                    MAP 0344
       SXA     IR4,4                                                    MAP 0345
       ZET*    1,4           ISENSE                                     MAP 0346
       TRA     EQUALS        EQUAL SEGMENTS                             MAP 0347
       CLA     2,4           AT                                         MAP 0348
       STA     MIMAX5                                                   MAP 0349
       STA     MIMAX7                                                   MAP 0350
       STA     MIMAX3-1                                                 MAP 0351
       STA     MIMAX3                                                   MAP 0352
       STA     MIMAX2                                                   MAP 0353
       STA     MIMA10                                                   MAP 0354
       STA     MIMA12                                                   MAP 0355
       CLA     3,4           N FLOATED                                  MAP 0356
       STA     MIMAX8                                                   MAP 0357
       CLA*    4,4           N                                          MAP 0358
       SUB     ONE                                                      MAP 0359
       STD     MIMAX6-1                                                 MAP 0360
       CLA     5,4           TIN                                        MAP 0361
       STA     MIMAX3+1                                                 MAP 0362
       STA     ER                                                       MAP 0363
       CLA     6,4           TAX                                        MAP 0364
       STA     MIMA10+1                                                 MAP 0365
       STA     ER+1                                                     MAP 0366
       STA     MIMA13                                                   MAP 0367
       CLA     7,4           NTABLE                                     MAP 0368
       STA     MIMA11                                                   MAP 0369
       STA     ER+2                                                     MAP 0370
       STA     IR1-1                                                    MAP 0371
       CLA*    8,4           N REAL                                     MAP 0372
       PDX     ,1                                                       MAP 0373
       TXI     *+1,1,-1                                                 MAP 0374
       SXD     MIMAX6+2,1                                               MAP 0375
       SXD     MIMAX1,1                                                 MAP 0376
       TXI     *+1,1,-1                                                 MAP 0377
       SXD     ER1,1                                                    MAP 0378
       TXI     *+1,1,1                                                  MAP 0379
       CLA     9,4           RANGE                                      MAP 0380
       STA     MIMAX3+2                                                 MAP 0381
       STA     MIMAX9                                                   MAP 0382
MIMAX5 CLA*    **,1          AT                                         MAP 0383
MIMAX7 FSB*    **            AT                                         MAP 0384
MIMAX8 FDP     **            N FLOATED                                  MAP 0385
MIMAX9 STQ     **            RANGE                                      MAP 0386
       AXT     0,6                                                      MAP 0387
       CLA*    **,2          AT                                         MAP 0388
MIMAX3 LDQ*    **,2          AT                                         MAP 0389
       STQ     **,4          TIN                                        MAP 0390
       FAD     **            RANGE                                      MAP 0391
       AXT     0,1                                                      MAP 0392
MIMAX2 CAS*    **,2          AT                                         MAP 0393
       TXI     MIMAX1,2,1    AC GREATER                                 MAP 0394
       TXI     MIMAX1,2,1    AC EQUAL                                   MAP 0395
       TXL     ER1,1,0       AC LESS                                    MAP 0396
       XCA                                                              MAP 0397
       PXD     ,1                                                       MAP 0398
MIMA11 STO     **,4          TABLE                                      MAP 0399
       XCA                                                              MAP 0400
       TXI     *+1,2,-1                                                 MAP 0401
MIMA10 LDQ*    **,2          AT                                         MAP 0402
