* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * BIOH0173
*                                                                       BIOH0174
       REM  ENTRY FROM FORMAT SCAN ON NUMBER.                           BIOH0175
NUMBER STO  DIG                      CONVERT                            BIOH0176
       CLA  INT                      BCD                                BIOH0177
 ALS   ALS  2                        DIGITS                             BIOH0178
       ADD  INT                      TO                                 BIOH0179
       ALS  1                        BINARY                             BIOH0180
       ACL  DIG                      INTEGER.                           BIOH0181
       REM  ENTRY FROM CCSCFM.                                          BIOH0182
SCAN4  STO  INT                      SET INT.                           BIOH0183
       REM  ENTRY FROM CCCMMA, CCDCPT.                                  BIOH0184
SCAN5  TIX  SCAN2,1,1              * IF CHARACTER COUNT IS EXHAUSTED,   BIOH0185
 FSET1 TXI  SCAN1,2,1              * EXAMINE NEXT FORMAT WORD.          BIOH0186
*                                                                       BIOH0187
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * BIOH0188
*                                                                       BIOH0189
       REM  ENTRY FROM FORMAT SCAN ON LEFT PARENTHESIS.                 BIOH0190
CCLPAR SXA  BX1,1                    SAVE CURRENT                       BIOH0191
       SXA  BX2,2                    SCAN POSITION                      BIOH0192
       STQ  MQR                      FOR POSSIBLE RESCAN.               BIOH0193
       LXA  INT,4                    SAVE                               BIOH0194
       SXA  BX4,4                    GROUP COUNT, AND                   BIOH0195
       SXA  GROUPX,4                 GROUP INDEX.                       BIOH0196
       LXA  ENDX,4                   ADD 1 TO                           BIOH0197
       TXI  *+1,4,1                  END PAREN COUNT                    BIOH0198
       SXA  ENDX,4                   TO DETERMINE END OF FORMAT.        BIOH0199
       SXA  PARX,4                   SAVE PAREN INDEX FOR RESCAN.       BIOH0200
       TRA  SCAN                   * THEN CONTINUE SCAN.                BIOH0201
*                                                                       BIOH0202
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * BIOH0203
*                                                                       BIOH0204
       REM  ENTRY FROM FORMAT SCAN ON COMMA.                            BIOH0205
CCCMMA TSX  FIELD,4                * GO PROCESS CURRENT FIELD.          BIOH0206
       REM  ENTRY FROM CCSLSH,CCRPAR,CCHOLL,CCBLNK.                     BIOH0207
RESUME LDQ  MQ                       RESTORE                            BIOH0208
CX1    AXT  ..,1                     CURRENT                            BIOH0209
CX2    AXT  ..,2                     POSITION OF FORMAT SCAN,           BIOH0210
       REM  ENTRY FROM CCLPAR,CCSCFP,CCRPAR,CCINTG,CCHOLL.              BIOH0211
SCAN   STZ  INT                      CLEAR INT, AND                     BIOH0212
       TRA  SCAN5                  * CONTINUE FORMAT SCAN.              BIOH0213
*                                                                       BIOH0214
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * BIOH0215
*                                                                       BIOH0216
       REM  ENTRY FROM FORMAT SCAN ON SLASH.                            BIOH0217
CCSLSH TSX  FIELD,4                * GO PROCESS CURRENT FIELD.          BIOH0218
       TSX  INOUT,4                * GO PREPARE FOR NEXT LINE OF I/O.   BIOH0219
       TRA  RESUME                 * GO RESUME SCAN.                    BIOH0220
*                                                                       BIOH0221
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * BIOH0222
*                                                                       BIOH0223
       REM  ENTRY FROM FORMAT SCAN ON P.                                BIOH0224
CCSCFP CLA  INT                      MOVE SCALE FACTOR                  BIOH0225
       STO  PEX                      INTO PEX.                          BIOH0226
       TRA  SCAN                   * GO CONTINUE SCAN.                  BIOH0227
*                                                                       BIOH0228
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * BIOH0229
*                                                                       BIOH0230
       REM  ENTRY FROM FORMAT SCAN ON O.                                BIOH0231
CCOCTL NOP  *+3                      (INPUT / NOP, OUTPUT / TRA).       BIOH0232
       AXT  ONPT,4                   PICKUP OCTAL INPUT DESIGNATION,    BIOH0233
       TRA  SETAD                  * AND GO SET MODE SWITCH.            BIOH0234
       AXT  OOUT,4                   PICKUP OCTAL OUTPUT DESIGNATION,   BIOH0235
       TRA  SETAD                  * AND GO SET MODE SWITCH.            BIOH0236
*                                                                       BIOH0237
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * BIOH0238
*                                                                       BIOH0239
       REM  ENTRY FROM FORMAT SCAN ON MINUS.                            BIOH0240
CCSCFM CLS  INT                      SET SIGN OF SCALE FACTOR NEGATIVE, BIOH0241
       TRA  SCAN4                  * AND GO CONTINUE SCAN.              BIOH0242
*                                                                       BIOH0243
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * BIOH0244
*                                                                       BIOH0245
       REM  ENTRY FROM FORMAT SCAN ON RIGHT PARENTHESIS.                BIOH0246
CCRPAR TSX  FIELD,4                * GO PROCESS CURRENT FIELD.          BIOH0247
BX4    AXT  ..,4                     TEST GROUP COUNT, AND              BIOH0248
       TIX  GROUP,4,1                PROCESS GROUP UNTIL EXHAUSTED.     BIOH0249
ENDX   AXT  ..,4                     THEN TEST END COUNT, AND           BIOH0250
       TNX  ENDFMT,4,1               IF NOT EXHAUSTED,                  BIOH0251
       SXA  ENDX,4                   REDUCE COUNT, AND                  BIOH0252
       TRA  RESUME                 * GO RESUME SCAN.                    BIOH0253
       REM  ENTRY FROM FORMAT SCAN ON ILLEGAL CONTROL CHARACTER.        BIOH0254
STOP   LDI     *+2               EXIT FOR EXECUTION                     BIOH0255
       TRA     $(EXE)            ERROR                                  BIOH0256
       PZE     0,1,*+1           INCORRECT FORMAT STATMNT.              BIOH0257
ENDFMT CLA  TRA                      SET SWITCH IN IOCNV                BIOH0258
       STD  ENDFSW                   FOR END OF FORMAT, AND             BIOH0259
       TRA  LIST                   * GO SEE IF LIST IS EXHAUSTED.       BIOH0260
       REM  REENTRY FROM IOCNV AFTER END OF FORMAT.                     BIOH0261
RESCAN CLA  NOP                      RESET                              BIOH0262
       STD  ENDFSW                   END OF FORMAT SWITCH.              BIOH0263
       STD  EXITSW                   SET EXIT SWITCH IN FIELD.          BIOH0264
       TSX  INOUT,4                * GO PREPARE FOR NEXT LINE OF I/O.   BIOH0265
PARX   AXT  ..,4                     PICKUP PAREN INDEX TO              BIOH0266
       SXA  ENDX,4                   RESET END COUNT.                   BIOH0267
GROUPX AXT  ..,4                     PICKUP GROUP INDEX TO              BIOH0268
GROUP  SXA  BX4,4                    SET GROUP COUNT.                   BIOH0269
BX1    AXT  ..,1                     RESET FORMAT POSITION              BIOH0270
BX2    AXT  ..,2                     TO BEGINNING OF                    BIOH0271
       LDQ  MQR                      LAST GROUP, AND                    BIOH0272
       TRA  SCAN                   * GO CONTINUE SCAN.                  BIOH0273
*                                                                       BIOH0274
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * BIOH0275
*                                                                       BIOH0276
       REM  ENTRY FROM FORMAT SCAN ON DECIMAL POINT.                    BIOH0277
CCDCPT CAL  DCPT                     MODIFY                             BIOH0278
       SLW  SCAN3                    SCAN.                              BIOH0279
       STZ  DIG                      CLEAR DIG.                         BIOH0280
       TRA  SCAN5                  * GO CONTINUE SCAN.                  BIOH0281
       REM  REENTRY FROM FORMAT SCAN.                                   BIOH0282
DCPT   TRA  *+1                      COLLECT                            BIOH0283
       TXH  *+3,4,9                  DECIMAL                            BIOH0284
       STO  DIG                      POSITION                           BIOH0285
       TRA  SCAN5                  * MODULO 9.                          BIOH0286
       SUB  BLANK                    ON NEXT                            BIOH0287
       TZE  SCAN5                  * CONTROL CHARACTER,                 BIOH0288
       CAL  *+2                      RESET                              BIOH0289
       SLW  SCAN3                    FORMAT SCAN                        BIOH0290
       TRA* FRMTR,4                * AND GO CONTINUE SCAN.              BIOH0291
*                                                                       BIOH0292
*********ENTRY FROM FORMAT SCAN ON J************************************BIOH0293
*                                                                       BIOH0294
CCJNTG NOP     *+4                                                      BIOH0295
       CLA     NOP                                                      BIOH0296
       STD     DBEXIT-1                                                 BIOH0297
       TRA     CCINTG+3                                                 BIOH0298
       CLA     NOP                                                      BIOH0299
       STD     INTG+1                                                   BIOH0300
       AXT     INTG,4                                                   BIOH0301
       TRA     SETAD                                                    BIOH0302
*                                                                       BIOH0303
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * BIOH0304
*                                                                       BIOH0305
       REM  ENTRY FROM FORMAT SCAN ON I.                                BIOH0306
CCINTG NOP     *+7                                                      BIOH0307
       CLA     ALS                                                      BIOH0308
       STD     DBEXIT-1                                                 BIOH0309
       CLA  TRA                      PICKUP TRA, AND                    BIOH0310
       REM  ENTRY FROM CCFFXD.                                          BIOH0311
SETFX  STD  FIXSW                    SET FIXSW, AND                     BIOH0312
       AXT  DBC,4                    PICKUP DBC TO                      BIOH0313
       TRA     *+4                                                      BIOH0314
       AXT  INTG,4                   IF OUTPUT, PICKUP INTG, AND        BIOH0315
       CLA     ARS                                                      BIOH0316
       STD     INTG+1                                                   BIOH0317
       REM  ENTRY FROM CCFFXD, CCEFLT, CCOCTL, CCALPH.                  BIOH0318
SETAD  SXA  CNVSW,4                  SET CNVSW.                         BIOH0319
       LXA  INT,4                    PICKUP INT, AND                    BIOH0320
       SXA  COUNT,4                  SET COUNT.                         BIOH0321
       TRA  SCAN                   * GO CONTINUE SCAN.                  BIOH0322
*                                                                       BIOH0323
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * BIOH0324
*                                                                       BIOH0325
       REM  ENTRY FROM FORMAT SCAN ON H.                                BIOH0326
CCHOLL NOP  HOUT                     IF INPUT,                          BIOH0327
HNPT   LXA  INT,4                    REPLACE                            BIOH0328
       LDQ  MQD                      HOLLERITH                          BIOH0329
       SXA  CX2,2                    FIELD                              BIOH0330
       CAL  0,2                      IN                                 BIOH0331
       LXA  DX1,2                    FORMAT                             BIOH0332
       TNX  HNPT3,1,1                STATEMENT                          BIOH0333
       SXA  CX1,1                    WITH                               BIOH0334
 ARS   ARS  6                        THE                                BIOH0335
       TIX  *-1,1,1                  SPECIFIED                          BIOH0336
       LXA  CX1,1                    NUMBER                             BIOH0337
HNPT1  TIX  HNPT2,2,1                OF                                 BIOH0338
       LXA  DX2,2                    BCD                                BIOH0339
       TXI  *+1,2,-1                 CHARACTERS                         BIOH0340
       XEC  WHICH                                                       BIOH0341
       SXA  DX2,2                    THE                                BIOH0342
       AXT  6,2                      INPUT                              BIOH0343
HNPT2  LGL  6                        BUFFER.                            BIOH0344
       TNX  HNPT4,4,1                ..                                 BIOH0345
       TIX  HNPT1,1,1                ..                                 BIOH0346
HNPT3  LXA  CX2,1                    ..                                 BIOH0347
       SLW  0,1                      ..                                 BIOH0348
HSET1  TXI  *+1,1,1                  ..                                 BIOH0349
       SXA  CX2,1                    ..                                 BIOH0350
       AXT  6,1                      ..                                 BIOH0351
       TRA  HNPT1                    ..                                 BIOH0352
HNPT4  SXA  DX1,2                    ..                                 BIOH0353
       LXA  CX2,2                    ..                                 BIOH0354
       STQ  MQD                      ..                                 BIOH0355
       SXA  CX1,1                    ..                                 BIOH0356
       TXL  HNPT5,1,1                ..                                 BIOH0357
       LDQ  0,2                      ..                                 BIOH0358
       RQL  6                        ..                                 BIOH0359
       TXI  *+1,1,1                  ..                                 BIOH0360
       TXL  *-2,1,6                  ..                                 BIOH0361
       STQ  MQ                       ..                                 BIOH0362
       LXA  CX1,1                    ..                                 BIOH0363
       TNX  HNPT5,1,1                ..                                 BIOH0364
       LGL  6                        ..                                 BIOH0365
       TIX  *-1,1,1                  ..                                 BIOH0366
HNPT5  SLW  0,2                      ..                                 BIOH0367
       TRA  RESUME                 * GO RESUME FORMAT SCAN.             BIOH0368
       REM  ENTRY FROM CCBLNK.                                          BIOH0369
HOUT   CLA  PAK)                 IF OUTPUT,                             BIOH0370
       STA  HOUT3                    MOVE                               BIOH0371
       CAL  WORD                     THE                                BIOH0372
       LXA  INT,4                    SPECIFIED                          BIOH0373
       TNO  *+1                      NUMBER                             BIOH0374
HOUT1  TIX  HOUT2,1,1                OF                                 BIOH0375
       AXT  6,1                      FORMAT                             BIOH0376
BSET1  TXI  *+1,2,1                  CHARACTERS                         BIOH0377
       LDQ  0,2                      (OR BLANKS)                        BIOH0378
HOUT2  LGL  6                        INTO                               BIOH0379
       TNO  HOUT4                    THE                                BIOH0380
       SXA     HXR4,4                                                   BIOH0381
       LXA     HOUT3,4                                                  BIOH0382
 WHAT1 TXH     HXR4,4,REC+21                                            BIOH0383
HOUT3  SLW  ..                       OUTPUT                             BIOH0384
       TXI     *+1,4,1           BUFFER                                 BIOH0385
       SXA     HOUT3,4                                                  BIOH0386
       SXA     PAK),4                                                   BIOH0387
       CAL  L(1)                     ..                                 BIOH0388
HXR4   AXT     ..,4                                                     BIOH0389
HOUT4  TIX  HOUT1,4,1                ..                                 BIOH0390
       SLW     WORD                                                     BIOH0391
       TRA     SCAN                                                     BIOH0392
*                                                                       BIOH0393
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * BIOH0394
*                                                                       BIOH0395
       REM  ENTRY FROM FORMAT SCAN ON F.                                BIOH0396
CCFFXD CLS  PEX                      MOVE NEGATIVE OF                   BIOH0397
       STO  EXP                      SCALE FACTOR INTO EXP.             BIOH0398
       NOP  *+3                      IF INPUT,                          BIOH0399
       REM  ENTRY FROM CCEFLT.                                          BIOH0400
FXPT   CLA  NOP                      PICKUP NOP, AND                    BIOH0401
       TRA  SETFX                  * GO SET FIXSW.                      BIOH0402
       AXT  CHAR,4                   IF OUTPUT,                         BIOH0403
       SXA  FXFL1,4                  SET                                BIOH0404
       AXT  1,4                      FXFL1,2,3                          BIOH0405
       SXD  FXFL2,4                  IN CONVERSION ROUTINE              BIOH0406
       SXD  FXFL3,4                  FOR FIXED POINT,                   BIOH0407
       AXT  FXD,4                    PICKUP FXD, AND                    BIOH0408
       TRA  SETAD                  * GO SET CNVSW.                      BIOH0409
*                                                                       BIOH0410
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * BIOH0411
*                                                                       BIOH0412
       REM  ENTRY FROM FORMAT SCAN ON E.                                BIOH0413
CCEFLT NOP (3                                                           BIOH0414
       STZ  EXP                      CLEAR EXP, AND                     BIOH0415
       TRA  FXPT                   * EXIT TO CCFFXD.                    BIOH0416
       AXT  CHAR-4,4                 IF OUTPUT,                         BIOH0417
       SXA  FXFL1,4                  SET                                BIOH0418
       AXT  5,4                      FXFL1,2,3                          BIOH0419
       SXD  FXFL2,4                  IN CONVERSION ROUTINE              BIOH0420
       SXD  FXFL3,4                  FOR FLOATING POINT.                BIOH0421
       AXT  FLT,4                    PICKUP FLT, AND                    BIOH0422
       TRA  SETAD                  * GO SET CNVSW.                      BIOH0423
 (3    TXL CCEFLT+3,4,21                                                BIOH0424
       AXT CHAR-4,4                                                     BIOH0425
