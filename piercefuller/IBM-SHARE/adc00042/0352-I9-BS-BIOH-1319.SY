*BIOH       FORTRAN BUFFERED INPUT/OUTPUT HOLLERITH                     BIOH0000
*      FOR USE WITH 709 FORTRAN LIBRARY                                 BIOH0001
*(IOH)      INPUT-OUTPUT HOLLERITH   USED BY (TSH),(STH),(CSH),(SCH),   BIOH0002
*                                    AND (SPH).                         BIOH0003
       COUNT   1300                                                     BIOH0004
       ENTRY   LOAD                                                     BIOH0005
       ENTRY   UNLOAD                                                   BIOH0006
       ENTRY   PACK                                                     BIOH0007
       ENTRY   UNPACK                                                   BIOH0008
       ENTRY   SETUP                                                    BIOH0009
       ENTRY   RESET                                                    BIOH0010
       ENTRY   (IOH)                                                    BIOH0011
       ENTRY   (FIL)                                                    BIOH0012
       ENTRY   (RTN)                                                    BIOH0013
       ENTRY   ERLOC                                                    BIOH0014
       EXTERN  (IOS)                                                    BIOH0015
       EXTERN  (EXE)                                                    BIOH0016
       EXTERN  IDEC                                                     BIOH0017
       EXTERN  ODEC                                                     BIOH0018
       EXTERN  IOEND                                                    BIOH0019
       EXTERN  IORPT                                                    BIOH0020
       EXTERN  IORDY                                                    BIOH0021
*                                                                       BIOH0022
 (IOH) XCA                           INITIALIZATION =                   BIOH0023
       SXA  AX1,1                    SAVE                               BIOH0024
       SXA  AX2,2                    INDEX                              BIOH0025
       SXA  AX4,4                    REGISTERS.                         BIOH0026
       STA  TYPE                     SET ADDRESS FOR TYPE OF I/O.       BIOH0027
       STD  INITSW                   SET SWITCHES ( INPUT / NOP,        BIOH0028
       STD  CCOCTL                   OUTPUT / TRA).                     BIOH0029
       STD  CCINTG                   ..                                 BIOH0030
       STD     CCJNTG                                                   BIOH0031
       STD  CCHOLL                   ..                                 BIOH0032
       STD  CCFFXD+2                 ..                                 BIOH0033
       STD  CCEFLT                   ..                                 BIOH0034
       STD  CCBLNK                   ..                                 BIOH0035
       STD  CCALPH                   ..                                 BIOH0036
       STD  INOUT+1                  ..                                 BIOH0037
       CLA  NOP                      RESET                              BIOH0038
       STD  ENDFSW                   END OF FORMAT SWITCH.              BIOH0039
       CLA     TRA               RESET FIELD                            BIOH0040
       STD     EXITSW            EXIT SWITCH                            BIOH0041
       CAL  *+1                      SAVE                               BIOH0042
       DCT                           CONDITION                          BIOH0043
       CAL  NOP                      OF DIVIDE                          BIOH0044
       SLW  DCR                      CHECK TRIGGER.                     BIOH0045
       LFTM                          LEAVE FLOATING TRAP MODE.          BIOH0046
       CAL  0                        SAVE                               BIOH0047
       SLW  C(0)                     C(0),                              BIOH0048
       CAL  2                        SAVE                               BIOH0049
       SLW  C(2)                     C(2).                              BIOH0050
       STZ     0                 CLEAR LOCATION 0                       BIOH0051
       LAC  AX4,4                    SETUP RETURN ADDRESS               BIOH0052
       TXI  *+1,4,2                  (TSX+2)                            BIOH0053
       SXA  0,4                      IN LOCATION 0.                     BIOH0054
       CAL  IOCNV                    SETUP LIST TRAP ADDRESS            BIOH0055
       SLW  2                        IN LOCATION 2.                     BIOH0056
       STZ  INT                      RESET INT.                         BIOH0057
       STZ  PEX                      RESET PEX.                         BIOH0058
       SXA  ENDX,0                   RESET END PAREN COUNT.             BIOH0059
       XCA                           RESTORE UNIT TAG TO AC.            BIOH0060
INITSW NOP  PSW1                                                        BIOH0061
USW1   TRA  NOUNP                UNPACK SWITCHES NOP-UNPACK,TRA-NORM    BIOH0062
       SXA     IR41,4                                                   BIOH0063
       LXD     LTAPE,4                                                  BIOH0064
       CLA  UNP1,4               RESET UNPACK COUNTERS TO VALUES AT     BIOH0065
       STA  DX1                  END OF PREVIOUS OPERATION              BIOH0066
       ARS     18                                                       BIOH0067
       STA  DX2                                                         BIOH0068
       CLA     UMQD,4        SET PARTIAL WORD FROM                      BIOH0069
       STO     MQD           PREVIOUS UNPACK                            BIOH0070
 IR41  AXT     0,4                                                      BIOH0071
       TRA     RST+2         BYPASS INPUT AND COUNTER RESET             BIOH0072
NOUNP  TSX     $(IOS),4                                                 BIOH0073
       TSX     INOUT,4                                                  BIOH0074
TRA    TRA     RST+2                                                    BIOH0075
PSW1   TRA  RST                  PACK SWITCH  TRA-NORMAL NOP-PACK       BIOH0076
       SXA     IR42,4                                                   BIOH0077
       LXD     UTAPE,4                                                  BIOH0078
       CLA  PA1,4                SET PACK COUNTERS FROM END OF          BIOH0079
       STA  PAK)                 PREVIOUS OPERATION.                    BIOH0080
       CLA  PA2,4                                                       BIOH0081
       STO  WORD                                                        BIOH0082
 IR42  AXT     0,4                                                      BIOH0083
       TRA     RST+2                                                    BIOH0084
RST    TSX     $(IOS),4                                                 BIOH0085
       TSX     REST,4                                                   BIOH0086
       LXA  AX4,4                    PREPARE                            BIOH0087
       CLA  1,4                      TO SCAN                            BIOH0088
       PAC  ,2                       FORMAT STATEMENT.                  BIOH0089
       PDX  ,1                       SET                                BIOH0090
       AXT  1,4                      DIRECTION                          BIOH0091
       TXL  *+2,1,0                  OF FORMAT                          BIOH0092
       AXT  -1,4                     SCAN                               BIOH0093
       SXD  FSET1,4                  EITHER                             BIOH0094
       SXD  HSET1,4                  FORWARDS                           BIOH0095
       SXD  BSET1,4                  OR BACKWARDS.                      BIOH0096
       REM  FORMAT SCAN / ENTRY FROM NUMBER.                            BIOH0097
SCAN1  LDQ  0,2                      EXAMINE                            BIOH0098
       AXT  6,1                      NEXT                               BIOH0099
SCAN2  PXD  ,0                       FORMAT                             BIOH0100
       LGL  6                        CHARACTER,                         BIOH0101
       PAX  ,4                       AND TAKE                           BIOH0102
SCAN3  TRA* FRMTR,4                * INDICATED TRANSFER.                BIOH0103
*                                                                       BIOH0104
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * BIOH0105
*                                                                       BIOH0106
       REM  FORMAT TRANSFER TABLE =                                     BIOH0107
       PZE  STOP                     77                                 BIOH0108
       PZE  STOP                     76                                 BIOH0109
       PZE  STOP                     75                                 BIOH0110
       PZE  CCLPAR                   74                                 BIOH0111
       PZE  CCCMMA                   73                                 BIOH0112
       PZE  STOP                     72                                 BIOH0113
       PZE  STOP                     71                                 BIOH0114
       PZE  STOP                     70                                 BIOH0115
       PZE  CCBLNK                   67                                 BIOH0116
       PZE  STOP                     66                                 BIOH0117
       PZE  STOP                     65                                 BIOH0118
       PZE  STOP                     64                                 BIOH0119
       PZE  STOP                     63                                 BIOH0120
       PZE  STOP                     62                                 BIOH0121
       PZE  CCSLSH                   61                                 BIOH0122
       PZE  SCAN5                    60                                 BIOH0123
       PZE  STOP                     57                                 BIOH0124
       PZE  STOP                     56                                 BIOH0125
       PZE  STOP                     55                                 BIOH0126
       PZE  STOP                     54                                 BIOH0127
       PZE  STOP                     53                                 BIOH0128
       PZE  STOP                     52                                 BIOH0129
       PZE  STOP                     51                                 BIOH0130
       PZE  STOP                     50                                 BIOH0131
       PZE  CCSCFP                   47                                 BIOH0132
       PZE  CCOCTL                   46                                 BIOH0133
       PZE  STOP                     45                                 BIOH0134
       PZE  STOP                     44                                 BIOH0135
       PZE  STOP                     43                                 BIOH0136
       PZE  STOP                     42                                 BIOH0137
       PZE     CCJNTG                41                                 BIOH0138
       PZE  CCSCFM                   40                                 BIOH0139
       PZE  STOP                     37                                 BIOH0140
       PZE  STOP                     36                                 BIOH0141
       PZE  STOP                     35                                 BIOH0142
       PZE  CCRPAR                   34                                 BIOH0143
       PZE  CCDCPT                   33                                 BIOH0144
       PZE  STOP                     32                                 BIOH0145
       PZE  CCINTG                   31                                 BIOH0146
       PZE  CCHOLL                   30                                 BIOH0147
       PZE CCEFLT                    27                                 BIOH0148
       PZE  CCFFXD                   26                                 BIOH0149
       PZE  CCEFLT                   25                                 BIOH0150
       PZE  STOP                     24                                 BIOH0151
       PZE  STOP                     23                                 BIOH0152
       PZE  STOP                     22                                 BIOH0153
       PZE  CCALPH                   21                                 BIOH0154
       PZE  STOP                     20                                 BIOH0155
       PZE  STOP                     17                                 BIOH0156
       PZE  STOP                     16                                 BIOH0157
       PZE  STOP                     15                                 BIOH0158
       PZE  STOP                     14                                 BIOH0159
       PZE  STOP                     13                                 BIOH0160
       PZE  STOP                     12                                 BIOH0161
       PZE  NUMBER                   11                                 BIOH0162
       PZE  NUMBER                   10                                 BIOH0163
       PZE  NUMBER                   7                                  BIOH0164
       PZE  NUMBER                   6                                  BIOH0165
       PZE  NUMBER                   5                                  BIOH0166
       PZE  NUMBER                   4                                  BIOH0167
       PZE  NUMBER                   3                                  BIOH0168
       PZE  NUMBER                   2                                  BIOH0169
       PZE  NUMBER                   1                                  BIOH0170
FRMTR  PZE  NUMBER                   0                                  BIOH0171
