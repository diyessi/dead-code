GROUPX TXI STOP,,..                  62                                 FIOP0132
 PARX  TXI CCSLSH,,..                61 /                               FIOP0133
 FILX  TXI SCAN5,,..                 60 BLANK                           FIOP0134
 CNT   TXI STOP,,..                  57                                 FIOP0135
 IOX4  TXI STOP,,..                  56                                 FIOP0136
