       REM  ADVANCED INPUT-OUTPUT  SYSTEM.  WBH                         FIOP0000
NOBLE  REM 704 FORTRAN II LIBRARY / INPUT-OUTPUT HOLLERITH / NOV 59.    FIOP0001
 IOH   REM ENTRY POINTS= DBC, BDC. USED WITH= TSH, STH, CSH, SCH, SPH.  FIOP0002
       REM                                                              FIOP0003
       FUL                          ENTER FUL  MODE FOR PROGRAM CARD.   FIOP0004
       ORG 0                         PROGRAM CARD.                      FIOP0005
       MZE ,,NUMB-2                                                     FIOP0006
       PZE                                                              FIOP0007
       PZE FIXN+1,,(IOH)I            ..                                 FIOP0008
       PZE COMMON                    ..                                 FIOP0009
       BCD 1RESET                   5L                                  FIOP0010
       PZE RESET                    5R                                  FIOP0011
       BCD 1UNPACK                  7L                                  FIOP0012
       PZE UNPACK                   7R                                  FIOP0013
       BCD 1PACK                    6L                                  FIOP0014
       PZE PACK                     6R                                  FIOP0015
       BCD 1LOAD                                                        FIOP0016
       PZE LOAD                                                         FIOP0017
LEP    BCD 1UNLOAD                                                      FIOP0018
       PZE UNLOAD                                                       FIOP0019
       BCD 1(IOH)I                   ..                                 FIOP0020
       MZE (IOH)I                                                       FIOP0021
       BCD 1(IOH)O                   ..                                 FIOP0022
       MZE (IOH)O                                                       FIOP0023
       BCD 1(DBC)                    ..                                 FIOP0024
       MZE (DBC)                                                        FIOP0025
       BCD 1(BDC)                    ..                                 FIOP0026
       MZE (BDC)                                                        FIOP0027
       BCD 1(FIL)                    ..                                 FIOP0028
       MZE (FIL)                     ..                                 FIOP0029
NUMB   SYN *                                                            FIOP0030
       REM  . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . FIOP0031
       REL                                                              FIOP0032
       ORG 0                         TRANSFER VECTOR.                   FIOP0033
 (RTN) BCD 1(RTN)                    ..                                 FIOP0034
       REM  . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . FIOP0035
(IOH)I TTR (DBC)                     INITIALIZATION =                   FIOP0036
(IOH)O TTR (BDC)                     ..                                 FIOP0037
 (DBC) LDQ NOP                       INPUT.                             FIOP0038
       TTR *+2                       ..                                 FIOP0039
 (BDC) LDQ TRA                       OUTPUT.                            FIOP0040
       LTM                           LEAVE TRAPPING MODE.               FIOP0041
       SXD AX1,1                     SAVE                               FIOP0042
       SXD AX2,2                     INDEX                              FIOP0043
       SXD AX4,4                     REGISTERS.                         FIOP0044
       STA TYPE                      SET ADDRESS FOR TYPE OF I/O.       FIOP0045
       SLQ INITSW                    SET SWITCHES ( INPUT / NOP,        FIOP0046
       SLQ CCOCTL                    OUTPUT / TRA).                     FIOP0047
       SLQ CCINTG                    ..                                 FIOP0048
       SLQ CCHOLL                    ..                                 FIOP0049
       SLQ CCFFXD+2                  ..                                 FIOP0050
       SLQ CCEFLT                    ..                                 FIOP0051
       SLQ CCBLNK                    ..                                 FIOP0052
       SLQ CCALPH                    ..                                 FIOP0053
       SLQ INOUT+1                   ..                                 FIOP0054
       SLQ OPTSW                     ..                                 FIOP0055
       SLQ USW4                                                         FIOP0056
       CLA NOP                       RESET                              FIOP0057
       STD ENDFSW                    END OF FORMAT SWITCH.              FIOP0058
       STO NPTSW                     RESET INPUT SWITCH.                FIOP0059
       CAL 0                         PICKUP                             FIOP0060
       STA *+3                       FORMAT AND UNIT PARAMETERS.        FIOP0061
       ADD L(1)                      SETUP                              FIOP0062
       STA EXIT                      EXIT ADDRESS.                      FIOP0063
       CAL ..                        COMPLEMENT                         FIOP0064
       COM                           UNIT                               FIOP0065
       STD UNIT                      DESIGNATION, AND                   FIOP0066
       PAX ,2                        FORMAT ADDRESS.                    FIOP0067
       LXA 1,1                       SET                                FIOP0068
       CAL D(1                       DIRECTION                          FIOP0069
       TXL *+2,1,(IOH)O              OF FORMAT                          FIOP0070
       CAL D(M1                      SCAN                               FIOP0071
       STD FSET1                     EITHER                             FIOP0072
       STD HSET1                     FORWARDS                           FIOP0073
       STD BSET1                     BACKWARDS.                         FIOP0074
       CAL IOCNV                     SETUP LIST TRAP ADDRESS            FIOP0075
       SLW 1                         IN LOCATION 1.                     FIOP0076
       STZ INT                       RESET INT.                         FIOP0077
       STZ PEX                       RESET PEX.                         FIOP0078
       SXD ENDX,0                    RESET END PAREN COUNT.             FIOP0079
INITSW NOP PSW1                     IF INPUT                            FIOP0080
USW1   TRA NOUNP                    UNPACK SWITCHES NOP-UNPACK,TRA-NORM FIOP0081
       CLA TRA                                                          FIOP0082
       STD USW1                     RESET SWITCH FOR SUBSEQUENT READ.   FIOP0083
       CLA UNP1                                                         FIOP0084
       STD DX1                      SET UP COUNTERS AT VALUES AT END OF FIOP0085
       CLA UNP2                     PREVIOUS OPERATION                  FIOP0086
       STO DX2                                                          FIOP0087
       CLA LBUF                                                         FIOP0088
       STA PA1                      RESET  PACK  COUNTERS               FIOP0089
       CLA L(1)                                                         FIOP0090
       STO PA2                                                          FIOP0091
       TRA SCAN1                    BYPASS INPUT AND COUNTER RESET      FIOP0092
NOUNP  CLA TRA                      THIS IS A NORMAL INPUT, SO SET      FIOP0093
       STD USW2                     SWITCH 2 TO PROPER BRANCH           FIOP0094
       STD USW4                                                         FIOP0095
       CLA INPUT+2                  SET WHICH TO USE SMALL BUFFER       FIOP0096
       STA WHICH                                                        FIOP0097
       TSX INOUT,4                 * GO READ FIRST RECORD.              FIOP0098
TRA    TRA SCAN1                    IF OUTPUT,                          FIOP0099
PSW1   TRA RST                      PACK SWITCH  TRA-NORMAL, NOP-PACK   FIOP0100
       CLA PA1                                                          FIOP0101
       STA PAK)                     SET PACK COUNTERS FROM END OF       FIOP0102
       CLA PA2                       PREVIOUS OPERATION.                FIOP0103
       STO WORD                                                         FIOP0104
       CLA D(1                      RESET UNPACK SWITCHES.              FIOP0105
       STD UNP1                                                         FIOP0106
       STD UNP2                                                         FIOP0107
       TRA SCAN1                    BYPASS  RESET                       FIOP0108
RST    TSX REST,4                   GO RESET.                           FIOP0109
       REM  FORMAT SCAN / ENTRY FROM NUMBER.                            FIOP0110
SCAN1  LDQ -1,2                      EXAMINE                            FIOP0111
       LXA A(6,1                     NEXT                               FIOP0112
SCAN2  PXD ,0                        FORMAT                             FIOP0113
   A(6 LGL 6                         CHARACTER,                         FIOP0114
       PAX ,4                        AND TAKE                           FIOP0115
SCAN3  TRA FRMTR,4                 * INDICATED TRANSFER.                FIOP0116
       REM  . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . FIOP0117
       REM FORMAT TRANSFER TABLE =                                      FIOP0118
