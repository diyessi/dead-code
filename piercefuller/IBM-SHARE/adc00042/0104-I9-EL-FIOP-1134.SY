       TXI CCHOLL                    30 H                               FIOP0158
       TXI STOP                      27                                 FIOP0159
       TXI CCFFXD                    26 F                               FIOP0160
       TXI CCEFLT                    25 E                               FIOP0161
       TXI STOP                      24                                 FIOP0162
       TXI STOP                      23                                 FIOP0163
       TXI STOP                      22                                 FIOP0164
       TXI CCALPH                    21 A                               FIOP0165
       TXI STOP                      20                                 FIOP0166
       TXI STOP                      17                                 FIOP0167
       TXI STOP                      16                                 FIOP0168
       TXI STOP                      15                                 FIOP0169
       TXI STOP                      14                                 FIOP0170
       TXI STOP                      13                                 FIOP0171
       TXI STOP                      12                                 FIOP0172
       TXI NUMBER                    11 9                               FIOP0173
       TXI NUMBER                    10 8                               FIOP0174
       TXI NUMBER                    7                                  FIOP0175
       TXI NUMBER                    6                                  FIOP0176
       TXI NUMBER                    5                                  FIOP0177
       TXI NUMBER                    4                                  FIOP0178
       TXI NUMBER                    3                                  FIOP0179
       TXI NUMBER                    2                                  FIOP0180
       TXI NUMBER                    1                                  FIOP0181
 FRMTR BSS 0                         0                                  FIOP0182
       REM  . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . FIOP0183
       REM  ENTRY FROM FORMAT SCAN ON NUMBER.                           FIOP0184
NUMBER STO DIG                       CONVERT                            FIOP0185
       CLA INT                       BCD                                FIOP0186
       ALS 2                         DIGITS                             FIOP0187
       ADD INT                       TO                                 FIOP0188
       ALS 1                         BINARY                             FIOP0189
       ACL DIG                       INTEGER.                           FIOP0190
       REM  ENTRY FROM CCSCFM.                                          FIOP0191
SCAN4  STO INT                       SET INT.                           FIOP0192
       REM  ENTRY FROM CCCMMA, CCDCPT.                                  FIOP0193
SCAN5  TIX SCAN2,1,1               * IF CHARACTER COUNT IS EXHAUSTED,   FIOP0194
 FSET1 TXI SCAN1,2,-1              * EXAMINE NEXT FORMAT WORD.          FIOP0195
       REM  . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . FIOP0196
       REM  ENTRY FROM FORMAT SCAN ON LEFT PARENTHESIS.                 FIOP0197
CCLPAR SXD BX1,1                     SAVE CURRENT                       FIOP0198
       SXD BX2,2                     SCAN POSITION                      FIOP0199
       STQ MQR                       FOR POSSIBLE RESCAN.               FIOP0200
       LXA INT,4                     SAVE                               FIOP0201
       SXD BX4,4                     GROUP COUNT, AND                   FIOP0202
       SXD GROUPX,4                  GROUP INDEX.                       FIOP0203
       LXD ENDX,4                    ADD 1 TO                           FIOP0204
 D(1   TXI *+1,4,1                   END PAREN COUNT                    FIOP0205
       SXD ENDX,4                    TO DETERMINE END OF FORMAT.        FIOP0206
       SXD PARX,4                    SAVE PAREN INDEX FOR RESCAN.       FIOP0207
       TRA SCAN                    * THEN CONTINUE SCAN.                FIOP0208
       REM  . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . FIOP0209
       REM  ENTRY FROM FORMAT SCAN ON COMMA.                            FIOP0210
CCCMMA TSX FIELD,4                 * GO PROCESS CURRENT FIELD.          FIOP0211
       REM  ENTRY FROM CCSLSH,CCRPAR,CCHOLL,CCBLNK.                     FIOP0212
RESUME LDQ MQ                        RESTORE                            FIOP0213
       LXD CX1,1                     CURRENT                            FIOP0214
       LXD CX2,2                     POSITION OF FORMAT SCAN,           FIOP0215
       REM  ENTRY FROM CCLPAR,CCSCFP,CCRPAR,CCINTG,CCHOLL.              FIOP0216
SCAN   STZ INT                       CLEAR INT, AND                     FIOP0217
       TRA SCAN5                   * CONTINUE FORMAT SCAN.              FIOP0218
       REM  . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . FIOP0219
       REM  ENTRY FROM FORMAT SCAN ON SLASH.                            FIOP0220
CCSLSH TSX FIELD,4                 * GO PROCESS CURRENT FIELD.          FIOP0221
       TSX INOUT,4                 * GO PREPARE FOR NEXT LINE OF I/O.   FIOP0222
       TRA RESUME                  * GO RESUME SCAN.                    FIOP0223
       REM  . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . FIOP0224
       REM  ENTRY FROM FORMAT SCAN ON P.                                FIOP0225
CCSCFP CLA INT                       MOVE SCALE FACTOR                  FIOP0226
       STO PEX                       INTO PEX.                          FIOP0227
       TRA SCAN                    * GO CONTINUE SCAN.                  FIOP0228
       REM  . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . FIOP0229
       REM  ENTRY FROM FORMAT SCAN ON O.                                FIOP0230
CCOCTL NOP *+3                       (INPUT / NOP, OUTPUT / TRA).       FIOP0231
       CAL A(ONPT                    PICKUP OCTAL INPUT DESIGNATION,    FIOP0232
       TRA SETAD                   * AND GO SET CNVSW.                  FIOP0233
       CAL A(OOUT                    PICKUP OCTAL OUTPUT DESIGNATION,   FIOP0234
       TRA SETAD                   * AND GO SET CNVSW.                  FIOP0235
       REM  . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . FIOP0236
       REM  ENTRY FROM FORMAT SCAN ON MINUS.                            FIOP0237
CCSCFM CLS INT                       SET SIGN OF SCALE FACTOR NEGATIVE, FIOP0238
       TRA SCAN4                   * AND GO CONTINUE SCAN.              FIOP0239
       REM  . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . FIOP0240
       REM  ENTRY FROM FORMAT SCAN ON RIGHT PARENTHESIS.                FIOP0241
CCRPAR TSX FIELD,4                 * GO PROCESS CURRENT FIELD.          FIOP0242
       LXD BX4,4                     TEST GROUP COUNT, AND              FIOP0243
       TIX GROUP,4,1                 PROCESS GROUP UNTIL EXHAUSTED.     FIOP0244
       LXD ENDX,4                    THEN TEST END COUNT, AND           FIOP0245
       TNX ENDFMT,4,1                IF NOT EXHAUSTED,                  FIOP0246
       SXD ENDX,4                    REDUCE COUNT, AND                  FIOP0247
       TRA RESUME                  * GO RESUME SCAN.                    FIOP0248
       REM  ENTRY FROM FORMAT SCAN ON ILLEGAL CONTROL CHARACTER.        FIOP0249
 STOP  HPR 5,1                     * PRESS START TO TREAT AS END FORMAT.FIOP0250
ENDFMT CLA TRA                       SET SWITCH IN IOCNV                FIOP0251
       STD ENDFSW                    FOR END OF FORMAT, AND             FIOP0252
       TRA LIST                    * GO SEE IF LIST IS EXHAUSTED.       FIOP0253
       REM  REENTRY FROM IOCNV AFTER END OF FORMAT.                     FIOP0254
RESCAN CLA NOP                       RESET                              FIOP0255
       STD ENDFSW                    END OF FORMAT SWITCH.              FIOP0256
       STD EXITSW                    SET EXIT SWITCH IN FIELD.          FIOP0257
       TSX INOUT,4                 * GO PREPARE FOR NEXT LINE OF I/O.   FIOP0258
       LXD PARX,4                    PICKUP PAREN INDEX TO              FIOP0259
       SXD ENDX,4                    RESET END COUNT.                   FIOP0260
       LXD GROUPX,4                  PICKUP GROUP INDEX TO              FIOP0261
GROUP  SXD BX4,4                     SET GROUP COUNT.                   FIOP0262
       LXD BX1,1                     RESET FORMAT POSITION              FIOP0263
       LXD BX2,2                     TO BEGINNING OF                    FIOP0264
       LDQ MQR                       LAST GROUP, AND                    FIOP0265
       TRA SCAN                    * GO CONTINUE SCAN.                  FIOP0266
       REM  . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . FIOP0267
       REM  ENTRY FROM FORMAT SCAN ON DECIMAL POINT.                    FIOP0268
CCDCPT CAL DCPT                      MODIFY                             FIOP0269
       SLW SCAN3                     SCAN.                              FIOP0270
       STZ DIG                       CLEAR DIG.                         FIOP0271
       TRA SCAN5                   * GO CONTINUE SCAN.                  FIOP0272
       REM  REENTRY FROM FORMAT SCAN.                                   FIOP0273
DCPT   TRA *+1                       COLLECT                            FIOP0274
       TXH *+3,4,9                   DECIMAL                            FIOP0275
       STO DIG                       POSITION                           FIOP0276
       TRA SCAN5                   * MODULO 9.                          FIOP0277
       SUB BLANK                     ON NEXT                            FIOP0278
       TZE SCAN5                   * CONTROL CHARACTER,                 FIOP0279
       CAL *+2                       RESET                              FIOP0280
       SLW SCAN3                     FORMAT SCAN                        FIOP0281
       TRA FRMTR,4                 * AND GO CONTINUE SCAN.              FIOP0282
       REM  . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . FIOP0283
       REM  ENTRY FROM FORMAT SCAN ON I.                                FIOP0284
CCINTG NOP *+5                       IF INPUT,                          FIOP0285
       CLA TRA                       PICKUP TRA, AND                    FIOP0286
       REM  ENTRY FROM CCFFXD.                                          FIOP0287
SETFX  STD FIXSW                     SET FIXSW, AND                     FIOP0288
       CAL A(DBC                     PICKUP DBC AND                     FIOP0289
       TRA *+2                       CONTINUE BELOW.                    FIOP0290
       CAL A(INTG                    IF OUTPUT, PICKUP INTG, AND        FIOP0291
       REM  ENTRY FROM CCFFXD, CCALPH, CCOCTL.                          FIOP0292
SETAD  STA CNVSW                     SET CNVSW.                         FIOP0293
       LXA INT,4                     PICKUP INT, AND                    FIOP0294
       SXD CNT,4                     SET COUNT.                         FIOP0295
       TRA SCAN                    * GO CONTINUE SCAN.                  FIOP0296
       REM  . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . FIOP0297
