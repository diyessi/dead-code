       LXD CX2,2                     ..                                 FIOP0328
       STQ MQD                       ..                                 FIOP0329
       SXD CX1,1                     ..                                 FIOP0330
       TXL HNPT5,1,1                 ..                                 FIOP0331
       LDQ -1,2                      ..                                 FIOP0332
       RQL 6                         ..                                 FIOP0333
       TXI *+1,1,1                   ..                                 FIOP0334
       TXL *-2,1,6                   ..                                 FIOP0335
       STQ MQ                        ..                                 FIOP0336
       LXD CX1,1                     ..                                 FIOP0337
