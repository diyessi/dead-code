       TTL  704 FORTRAN INPUT-OUTPUT LIST SIMULATOR FOR IBM 7090      BSFIOC0001
       ZST                                                              FIOC0002
*                                                                       FIOC0003
       ENTRY (BDC)                                                      FIOC0004
       ENTRY (DBC)                                                      FIOC0005
       ENTRY (IOH)O                                                     FIOC0006
       ENTRY (IOH)I                                                     FIOC0007
       ENTRY (LEV)                                                      FIOC0008
*                                                                       FIOC0009
 (BDC) STZ  1                      STORE OUTPUT SWITCH.                 FIOC0010
 (DBC) STL  SCAN                   FORWARD FORMAT SCAN                  FIOC0011
       TTR  *+3                                                         FIOC0012
(IOH)O STZ  1                      STORE OUTPUT SWITCH.                 FIOC0013
(IOH)I SXA  SCAN,0                 REVERSE FORMAT SCAN.                 FIOC0014
       STA  TYPE                   SET I/O TYPE.                        FIOC0015
       SXA  XR1,1                  SAVE                                 FIOC0016
       SXA  XR2,2                  INDEX                                FIOC0017
       SXA  XR4,4                  REGISTERS.                           FIOC0018
 SCAN  AXT  **,2                                                        FIOC0019
       SXD  TYPE+1,2               SET FORMAT DIRECTION.                FIOC0020
       LTM                                                              FIOC0021
       CAL* 0                                                           FIOC0022
       STA  TYPE+1                 SET FORMAT LOCATION.                 FIOC0023
       PDX  ,4                     SAVE UNIT DESIGNATION                FIOC0024
       CLA  0                      SET                                  FIOC0025
       ACL  =1                     RETURN                               FIOC0026
       STA  IOXIT                  ADDRESS.                             FIOC0027
       PAC  ,1                                                          FIOC0028
       AXT  0,2                                                         FIOC0029
       ZET  1                                                           FIOC0030
       AXC  1,2                    IF INPUT PICK UP (RTN) VECTOR.       FIOC0031
       CAL* RVEC,2                 IF OUTPUT, (FIL) VECTOR.             FIOC0032
       LAS* 1,1                                                         FIOC0033
       TXI  *-1,1,-1                                                    FIOC0034
       TRA  *+2                                                         FIOC0035
       TXI  *-3,1,-1                                                    FIOC0036
       LDQ  1,1                                                         FIOC0037
       STQ  SVWRD                                                       FIOC0038
       STA  ENDUP                  SET PROPER EXIT ROUTINE              FIOC0039
       CAL  MYXIT                                                       FIOC0040
       SLW  1,1                    SET TRA TO RESTORE.                  FIOC0041
       CAL  IOTYP                                                       FIOC0042
       LDQ  IOTYP+1                                                     FIOC0043
       NZT  1                      DETERMINE INPUT/OUTPUT LIST.         FIOC0044
       XCL                         IF OUTPUT.                           FIOC0045
       SLW  LIST                                                        FIOC0046
       STQ  LIST+2                                                      FIOC0047
       CAL  QTYP,2                 LDQ OR STQ.                          FIOC0048
       SLW  LIST+1                                                      FIOC0049
       CAL  UNIT,4                 PICK UP UNIT DESIGNATION.            FIOC0050
 TYPE  TSX  **,4                   (CSH),(TSH),(SPH),(STH),OR (SCH).    FIOC0051
       PZE  **,,**                 PZE  L(FMT),,DIRECTION               FIOC0052
       CAL  CN(1)                                                       FIOC0053
       SLW  1                                                           FIOC0054
 XR1   AXT  **,1                   RESTORE                              FIOC0055
 XR2   AXT  **,2                   INDEX                                FIOC0056
 XR4   AXT  **,4                   REGISTERS.                           FIOC0057
 IOXIT TTR  **                     EXIT TO LIST                         FIOC0058
       REM                                                              FIOC0059
*          ENTER HERE FROM LIST                                         FIOC0060
 CN(1) TTR  *+1                                                         FIOC0061
       LTM                                                              FIOC0062
       CLA  0                                                           FIOC0063
       ACL  =1                                                          FIOC0064
       STA  LXIT                   SET RETURN EXIT.                     FIOC0065
       CAL* 0                                                           FIOC0066
       STA  *+3                    SET LIST                             FIOC0067
       STT  *+2                    PARAMETERS.                          FIOC0068
 LIST  ***                         STR IF INPUT, NOP IF OUTPUT          FIOC0069
       ***                         STQ IF INPUT, LDQ IF OUTPUT          FIOC0070
       ***                         NOP IF INPUT, STR IF OUTPUT          FIOC0071
       ETM                         RESTORE TRAP MODE AND                FIOC0072
 LXIT  TTR  **                     EXIT TO LIST.                        FIOC0073
       REM                                                              FIOC0074
*          ENTER HERE TO SAVE CONSOLE                                   FIOC0075
 (LEV) ACL  =2                                                          FIOC0076
       STA  XIT                    SET RETURN ADDRESS.                  FIOC0077
       CAL  0                                                           FIOC0078
       SLW  C(0)                   SAVE C(0).                           FIOC0079
       CAL  1                                                           FIOC0080
       SLW  C(1)                   SAVE C(1).                           FIOC0081
       CAL  8                                                           FIOC0082
       SLW  C(8)                   SAVE C(8).                           FIOC0083
       CAL  *+4                                                         FIOC0084
       SLW  1                                                           FIOC0085
       CLA  *+3                                                         FIOC0086
       TRA  *+4                                                         FIOC0087
       TTR  *+1                                                         FIOC0088
       LTM                                                              FIOC0089
       CHS                                                              FIOC0090
       STO  MODE                   SAVE TRAP MODE.                      FIOC0091
       LDQ  NOP                    SAVE                                 FIOC0092
       TOV  *+2                    AC                                   FIOC0093
       LDQ  *-1                    OVERFLOW.                            FIOC0094
       SLQ  ACOV                                                        FIOC0095
       LDQ  NOP                    SAVE                                 FIOC0096
       TQO  *+2                    MQ                                   FIOC0097
       LDQ  *-1                    OVERFLOW.                            FIOC0098
       SLQ  MQOV                                                        FIOC0099
       LDQ  *+1                    SAVE                                 FIOC0100
       DCT                         DIVIDE                               FIOC0101
       LDQ  NOP                    CHECK.                               FIOC0102
       STQ  DCT                                                         FIOC0103
       CAL  FPTRA                                                       FIOC0104
       SLW  8                                                           FIOC0105
       SXA  XIT-1,4                                                     FIOC0106
       AXT  4,4                    SAVE FP TRAP.                        FIOC0107
       CLA  37ETC                                                       FIOC0108
       FAD  37ETC                                                       FIOC0109
 FP    SXA  FMODE,4                -0760...2  EFTM                      FIOC0110
       LFTM                        -0760...4  LFTM                      FIOC0111
       AXT  **,4                                                        FIOC0112
 XIT   TTR  **                     EXIT TO LIST.                        FIOC0113
 FPTRA TXI  FP,4,-2                                                     FIOC0114
       REM                                                              FIOC0115
*          ENTER HERE WHEN LIST IS EXHAUSTED.                           FIOC0116
 MYXIT TTR  *+1                                                         FIOC0117
       LTM                                                              FIOC0118
       ADD  =1                                                          FIOC0119
       STA  XITAD-1                SET RESTORE ADDRESS.                 FIOC0120
       ADD  =1                                                          FIOC0121
       STA  XITAD                  SET RETURN ADDRESS.                  FIOC0122
       SXA  *+2,4                                                       FIOC0123
 ENDUP TSX  **,4                   (RTN) IF INPUT, (FIL) IF OUTPUT.     FIOC0124
       AXT  **,4                                                        FIOC0125
       CAL  C(0)                                                        FIOC0126
       SLW  0                      RESTORE C(0).                        FIOC0127
       CAL  C(1)                                                        FIOC0128
       SLW  1                      RESTORE C(1)                         FIOC0129
       CAL  C(8)                                                        FIOC0130
       SLW  8                      RESTORE C(8).                        FIOC0131
       LFTM                                                             FIOC0132
       LDQ  37ETC                  TURN ON                              FIOC0133
       FMP  37ETC                  CONSOLE                              FIOC0134
       DVP  =0                     INICATORS                            FIOC0135
 ACOV  TOV  *+1                    THEN                                 FIOC0136
 MQOV  TQO  *+1                    RESTORE                              FIOC0137
 DCT   DCT                         THEM.                                FIOC0138
 NOP   NOP                                                              FIOC0139
 FMODE MSE  **                     EFTM OR LFTM                         FIOC0140
 MODE  LTM                                                              FIOC0141
       CAL  SVWRD                                                       FIOC0142
       SLW  **                     RESTORE PROGRAM WORD.                FIOC0143
 XITAD TTR  **                     RETURN TO PROGRAM                    FIOC0144
       REM                                                              FIOC0145
*          CONSTANTS AND SUCH                                           FIOC0146
 RVEC  PZE  /TV/(FIL)                                                   FIOC0147
       PZE  /TV/(RTN)                                                   FIOC0148
 IOTYP STR                                                              FIOC0149
       NOP                                                              FIOC0150
 QTYP  LDQ  **,**                                                       FIOC0151
       STQ  **,**                                                       FIOC0152
 37ETC OCT  377777777777                                                FIOC0153
       REM                                                              FIOC0154
*          IOU EQUIVALENCE TABLE                                        FIOC0155
       PZE  ,,A81        11                                             FIOC0156
       PZE  ,,A2         10                                             FIOC0157
       PZE  ,,A3          9                                             FIOC0158
       PZE  ,,A9          8                                             FIOC0159
       PZE  ,,B9          7                                             FIOC0160
       PZE  ,,A8          6                                             FIOC0161
       PZE  ,,B8          5                                             FIOC0162
       PZE  ,,A7          4                                             FIOC0163
       PZE  ,,B7          3                                             FIOC0164
       PZE  ,,A6          2                                             FIOC0165
       PZE  ,,B6          1                                             FIOC0166
 UNIT  SYN  *                                                           FIOC0167
 A81   BOOL 121                                                         FIOC0168
 A2    BOOL 2                                                           FIOC0169
 A3    BOOL 3                                                           FIOC0170
 A9    BOOL 11                                                          FIOC0171
 B9    BOOL 23                                                          FIOC0172
 A8    BOOL 10                                                          FIOC0173
 B8    BOOL 22                                                          FIOC0174
 A7    BOOL 7                                                           FIOC0175
 B7    BOOL 21                                                          FIOC0176
 A6    BOOL 6                                                           FIOC0177
 B6    BOOL 20                                                          FIOC0178
       REM                                                              FIOC0179
*          STORAGE FOR (LEV) AND (RTN)                                  FIOC0180
 C(0)  PZE                                                              FIOC0181
 C(1)  PZE                                                              FIOC0182
 C(8)  PZE                                                              FIOC0183
 SVWRD PZE                                                              FIOC0184
       END                                                              FIOC0185
