CANE210      72 01022                                                   E2100001
C     CHEBYSHEV LINE FIT                                                E2100002
C                                                                       E2100003
      SUBROUTINE MINMAX (X,Y,RESID,N,A,B)                               E2100004
C                                                                       E2100005
      DIMENSION X(1), Y(1), RESID(1), T(3), Q(3)                        E2100006
C                                                                       E2100007
C     STEP ONE--CHOOSE THREE DATA POINTS                                E2100008
C                                                                       E2100009
  110 DO 130 I=1,3                                                      E2100010
  120 T(I)=X(I)                                                         E2100011
  130 Q(I)=Y(I)                                                         E2100012
C                                                                       E2100013
C     STEP TWO--FIND THE CHEBYSHEV LINE FOR THIS TRIPLE                 E2100014
C                                                                       E2100015
  210 TEMP=T(3)-T(1)                                                    E2100016
  220 A=(Q(3)-Q(1))/TEMP                                                E2100017
  225 TEMP=(T(3)*Q(1)-T(1)*Q(3))/TEMP                                   E2100018
  230 H=-(A*T(2)+TEMP-Q(2))/2.0                                         E2100019
  235 K=1                                                               E2100020
  240 IF (H) 250, 260, 260                                              E2100021
  250 K=2                                                               E2100022
  260 B=TEMP+H                                                          E2100023
C                                                                       E2100024
C     STEP THREE--CALCULATE ERRORS AT ALL REMAINING POINTS              E2100025
C                                                                       E2100026
  310 TEMP=H*1.000001                                                   E2100027
  315 L=2                                                               E2100028
  320 DO 350 I=1,N                                                      E2100029
  325 RESID(I)=A*X(I)+B-Y(I)                                            E2100030
  330 IF (ABSF(TEMP)-ABSF(RESID(I))) 335, 350, 350                      E2100031
  335 TEMP=RESID(I)                                                     E2100032
  340 L=1                                                               E2100033
  345 J=I                                                               E2100034
  350 CONTINUE                                                          E2100035
  360 GO TO (370,600), L                                                E2100036
  370 IF (TEMP) 375, 380, 380                                           E2100037
  375 L=2                                                               E2100038
  380 TEMP=X(J)                                                         E2100039
C                                                                       E2100040
C     STEP 4--CHOOSE A NEW TRIPLE                                       E2100041
C                                                                       E2100042
  410 IF (TEMP-T(2)) 420, 450, 450                                      E2100043
  420 GO TO (430,440), K                                                E2100044
  430 GO TO (520,480), L                                                E2100045
  440 GO TO (480,520), L                                                E2100046
  450 GO TO (460,470), K                                                E2100047
  460 GO TO (560,490), L                                                E2100048
  470 GO TO (490,560), L                                                E2100049
  480 IF (TEMP-T(1)) 500, 580, 580                                      E2100050
  490 IF (TEMP-T(3)) 580, 580, 540                                      E2100051
  500 T(3)=T(2)                                                         E2100052
  505 Q(3)=Q(2)                                                         E2100053
  510 T(2)=T(1)                                                         E2100054
  515 Q(2)=Q(1)                                                         E2100055
  520 T(1)=TEMP                                                         E2100056
  525 Q(1)=Y(J)                                                         E2100057
  530 GO TO 210                                                         E2100058
  540 T(1)=T(2)                                                         E2100059
  545 Q(1)=Q(2)                                                         E2100060
  550 T(2)=T(3)                                                         E2100061
  555 Q(2)=Q(3)                                                         E2100062
  560 T(3)=TEMP                                                         E2100063
  565 Q(3)=Y(J)                                                         E2100064
  570 GO TO 210                                                         E2100065
  580 T(2)=TEMP                                                         E2100066
  585 Q(2)=Y(J)                                                         E2100067
  590 GO TO 210                                                         E2100068
C                                                                       E2100069
  600 RETURN                                                            E2100070
C                                                                       E2100071
      END (0,1,0,0,0)                                                   E2100072
