       ENTRY   HOLRTH              A, NH HOLLERITH.TEXT                 HOLR0001
HOLRTH CLA     2,4                                                      HOLR0002
       STA     CLA                                                      HOLR0003
       CLA     1,4                                                      HOLR0004
       STA     STO                                                      HOLR0005
       SXA     LX1,1                                                    HOLR0006
       SXA     LX4,4                                                    HOLR0007
       AXT     0,5                                                      HOLR0008
 CLA   CLA     *-*,1               PLACE HOLLERITH TEXT IN ACCUMULATOR  HOLR0009
       CAS     =O-377777777777     HAVE WE REACHED OUR LAST BCI WORD    HOLR0010
       TXI     STO,1,-1               IF NOT, GO TO STO                 HOLR0011
 LX1   AXT     0,1                    IF SO, RETURN                     HOLR0012
 LX4   AXT     0,4                                                      HOLR0013
       TRA     3,4                                                      HOLR0014
 STO   STO     *-*,4          STO  STORE HOLLERITH TEXT                 HOLR0015
       TXI     CLA,4,1             AND REPEAT PROCESS ON NEXT BCI WORD  HOLR0016
       END                                                              HOLR0017
