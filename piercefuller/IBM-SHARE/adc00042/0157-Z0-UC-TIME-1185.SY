*              FORTRAN SUBROUTINE...TIME...                  J. C. KELLY     001
*     FAP                                                                    002
*              FORTRAN SUBROUTINE...TIME...                  J. C. KELLY     003
*                                                            CALTEX N Y      004
*                                                            E D P DEPT.     005
*                                                            JUNE 3,1961     006
*              EXECUTE AS FORTRAN SUBROUTINE                                 007
*              CALL TIME (XXX,YYY)                                           008
*              WHERE ARGUMENT XXX IS THE FIRST WORD OF A 12 WORD ARRAY       009
*              DEFINED IN A DIMENSION STATEMENT AND YYY, N TH ARGUMENT       010
*              IN THE CALL STATEMENT, REPRESENTS THE LOCATION WHICH WILL     011
*              CONTAIN THE FIXED POINT VARIABLE(CLOCK IMAGE) UPON RETURN     012
*                                                                            013
       ENTRY   TIME                                                          014
       HTR                      STORAGE FOR IR 4                             015
       HTR                      STORAGE FOR IR 2                             016
       HTR                      STORAGE FOR IR 1                             017
 TIME  SXD     TIME-1,1         SAVE IR 1                                    018
       SXD     TIME-2,2         SAVE IR 2                                    019
       SXD     TIME-3,4         SAVE IR 4                                    020
       CLA     1,4                                                           021
       STA     L2                                                            022
       CLA     2,4                                                           023
       STA     RES1                                                          024
       STA     RES2                                                          025
       STA     RES3                                                          026
       AXT     36,1                                                          027
       AXT     24,2                                                          028
       AXT     6,4                                                           029
       SXD     THSIX,1          ZERO                                         030
       STZ     CARD+24,2            PRINT                                    031
       TIX     *-1,2,1                   AREA                                032
       AXT     0,1                                                           033
 L2    LDQ     **,1             COMMENT AREA (1,4)                           034
       PXD     0,0                                                           035
       LGL     6                BCD CHARACTER SHIFT                          036
       STO     OCT2             ONE BCD CHARACTER                            037
       STQ     BCD5             SAVE OTHER CHARACTERS                        038
       AXT     47,2                                                          039
 L1    PXD     0,0                                                           040
       LDQ     CHTAB+47,2                                                    041
       LGL     18               SPLIT CHARACTER TABLE                        042
       SUB     OCT2             CHECK ONE CHARACTER                          043
       TZE     FOUND            FOUND CHARACTER IN CHARACTER TABLE           044
       TIX     L1,2,1           LOOK AGAIN                                   045
       LDQ     OCT2             CHARACTER NOT IN TABLE  SUBSTITUTE BLANK     046
 FOUND AXT     0,2                                                           047
       PXD     0,0                                                           048
       LGL     1                CREATE COLUMN                                049
 LN12  ACL     CARD+22,2                     FOR                             050
       ALS     1                                PRINT IMAGE                  051
 LIN12 SLW*    LN12                                                          052
       TXI     *+1,2,2                                                       053
       TXL     FOUND+1,2,23                                                  054
 NOTF  LXD     THSIX,2                                                       055
       TXH     *+4,2,2                                                       056
       TXL     *+4,2,1                                                       057
       CLA     NOP                                                           058
       STO     LN12+1                                                        059
       TIX     REENT,2,1                                                     060
       CLA     ALS1                                                          061
       STO     LN12+1                                                        062
       TXL     OUT,1,1                                                       063
 OTSID CAL     LN12             INITIALIZE                                   064
       ADD     =O000000000001             FOR NEXT                           065
       STA     LN12                               36 CHARACTERS              066
       AXT     36,2                                                          067
 REENT SXD     THSIX,2                                                       068
       LDQ     BCD5                                                          069
       TIX     L2+1,4,1                                                      070
       AXT     6,4                                                           071
       TXI     *+1,1,1                                                       072
       TXL     L2,1,11                                                       073
 OUT   CAL     LN12             REINITIALIZE                                 074
       SUB     =O000000000001                                                075
       STA     LN12                          LEFT                            076
 WPRNT WPDA                                                                  077
       RCHA    IO1              WRITE COMMENT                                078
       TCOA    *                                                             079
       RPRA                                                                  080
       SPRA    6                ENERGIZE CLOCK                               081
       SPRA    9                SUPPRESS SPACE                               082
       RCHA    IO2              ECHO IN CLOCK IMPULSE                        083
       TCOA    *                                                             084
       CAL     =O004000000000   CONVERT                                      085
       SLW     MASK                                                          086
       AXT     6,2                                                           087
       TRA     IN                       CLOCK                                088
 RETUR ALS     1                                                             089
       STO     HOLD                           IMPULSE                        090
       ALS     2                                                             091
       ADD     HOLD                                                          092
 RES1  STO     **               (VALUE)                                      093
 IN    AXT     17,1                                                          094
       AXT     0,4                                                           095
       CAL     MASK                                                          096
       ANA     ECHO+22,1                                                     097
       TNZ     *+3                                                           098
       TXI     *+1,4,-1                                                      099
       TIX     *-4,1,2                                                       100
       CAL     MASK                                                          101
       LRS     1                                                             102
       SLW     MASK                                                          103
       CLA     TABLE,4                                                       104
 RES2  ADD     **               (VALUE)                                      105
       TIX     RETUR,2,1                                                     106
       ALS     18                                                            107
 RES3  STO     **               (VALUE)                                      108
       LXD     TIME-3,4                                                      109
       LXD     TIME-2,2                                                      110
       LXD     TIME-1,1                                                      111
       TRA     3,4              RETURN TO MAIN PROGRAM                       112
 TABLE PZE     9                                                             113
       PZE     8                                                             114
       PZE     7                                                             115
       PZE     6                                                             116
       PZE     5                                                             117
       PZE     4                                                             118
       PZE     3                                                             119
       PZE     2                                                             120
       PZE     1                                                             121
       PZE     0                                                             122
*  (CHTAB) TABLE OF CHARACTERS IN ORDER OF FREQUENCY OF USE IN ENGLISH       123
 CHTAB OCT     000060000000     BLANK                                        124
       OCT     000025402000     E                                            125
       OCT     000063110000     T                                            126
       OCT     000051200100     R                                            127
       OCT     000031400100     I                                            128
       OCT     000045202000     N                                            129
       OCT     000046201000     O                                            130
       OCT     000021440000     A                                            131
       OCT     000062120000     S                                            132
       OCT     000024404000     D                                            133
       OCT     000043210000     L                                            134
       OCT     000023410000     C                                            135
       OCT     000030400200     H                                            136
       OCT     000026401000     F                                            137
       OCT     000064104000     U                                            138
       OCT     000000100000     0                                            139
       OCT     000001040000     1                                            140
       OCT     000002020000     2                                            141
       OCT     000003010000     3                                            142
       OCT     000004004000     4                                            143
       OCT     000005002000     5                                            144
       OCT     000006001000     6                                            145
       OCT     000007000400     7                                            146
       OCT     000010000200     8                                            147
       OCT     000011000100     9                                            148
       OCT     000013010200     =                                            149
       OCT     000014004200     - (SPECIAL)                                  150
       OCT     000020400000     +                                            151
       OCT     000033410200     .                                            152
       OCT     000034404200     )                                            153
       OCT     000040200000     - (MINUS)                                    154
       OCT     000053210200     $                                            155
       OCT     000054204200     *                                            156
       OCT     000061140000     /                                            157
       OCT     000073110200     ,                                            158
       OCT     000074104200     (                                            159
       OCT     000047200400     P                                            160
       OCT     000044204000     M                                            161
       OCT     000070100200     Y                                            162
       OCT     000027400400     G                                            163
       OCT     000066101000     W                                            164
       OCT     000065102000     V                                            165
       OCT     000022420000     B                                            166
       OCT     000067100400     X                                            167
       OCT     000042220000     K                                            168
       OCT     000050200200     Q                                            169
       OCT     000041240000     J                                            170
       OCT     000071100100     Z                                            171
 IO1   IOCT    CARD,,24         COMMENT (HOLLERITH)                          172
 IO2   IOCP    LINE,,18         9 THRU 1 ROW OUT                             173
       IOCPN   ECHO,,2          8-4 ECHO IN                                  174
       IOCP    LINE+18,,2       ZERO ROW OUT                                 175
       IOCPN   ECHO+2,,2        8-3 ECHO IN                                  176
       IOCP    LINE+20,,2       11 ROW OUT                                   177
       IOCP    ECHO+4,,2        9 ECHO IN                                    178
       IOCP    LINE+22,,2       12 ROW OUT                                   179
       IOCT    ECHO+6,,16       8 THRU 1 ECHO IN                             180
 CARD  BSS     24                                                            181
 LINE  BSS     24                                                            182
 ECHO  BSS     24                                                            183
 MASK  PZE                                                                   184
 HOLD  PZE                                                                   185
 THSIX PZE                                                                   186
 OCT2  PZE                                                                   187
 BCD5  PZE                                                                   188
 NOP   NOP                                                                   189
 ALS1  ALS     1                                                             190
       END                                                                   191
