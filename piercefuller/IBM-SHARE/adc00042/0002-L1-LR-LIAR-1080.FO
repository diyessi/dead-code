SXR18 OCT   607001103060                                                LIAR 878
SXR17 OCT   606701072760                                                LIAR 879
SXR16 OCT   606601062660                                                LIAR 880
SXR15 OCT   606501052500                                                LIAR 881
SXR14 OCT   606401042460                                                LIAR 882
SXR13 OCT   606301032360                                                LIAR 883
SXR12 OCT   606201022260                                                LIAR 884
SXR11 OCT   606101012160                                                LIAR 885
SXR3  OCT   607201003260                                                LIAR 886
      DIMENSION ALATBL(1500),XR1(1),XR2(1),XR3(1),LATBL(1500)           LIAR 887
      COMMON ZYX                                                        LIAR 888
      EQUIVALENCE(LCOUNT,COUNT,ZYX(2003))                               LIAR 889
      EQUIVALENCE (ZYX(1),ALATBL,LATBL),(L,ZYX(2001)),(TEST,NTEST)      LIAR 890
      EQUIVALENCE (NTEST1,TEST1),(FLIP,NFLIP)                           LIAR 891
      EQUIVALENCE (ZYX(2002),ILOC,AILOC)                                LIAR 892
      EQUIVALENCE (NCARD,ZYX(2016))  ,(MY,ZYX(2017))                    LIAR 893
      EQUIVALENCE (ADJ,NADJ)                                            LIAR 894
      EQUIVALENCE(L,ZYX(2001))                                          LIAR 895
      MOVE1=0                                                           LIAR 896
      ADJ=AADJ                                                          LIAR 897
C TEST FOR BLANKS IN THE ADJUST POSITION                                LIAR 898
      IF(NADJ-NBK2)  4003,4004,4003                                     LIAR 899
 4003 MOVE = 0                                                          LIAR 900
B     TEST = ADJ*000077000000                                           LIAR 901
      IF(NTEST-NBK4) 331,602,331                                        LIAR 902
  602  MOVE = 6                                                         LIAR 903
B 331  TEST = ADJ * 007700000000                                        LIAR 904
       IF(NTEST-NBK3) 604,603,604                                       LIAR 905
  603  IF(MOVE-6) 605,606,605                                           LIAR 906
  606  MOVE = 12                                                        LIAR 907
       GO TO 604                                                        LIAR 908
B 605  ADJ = ADJ*770077777777                                           LIAR 909
B 604  TEST = ADJ*770000000000                                          LIAR 910
       IF(NTEST-NBK1) 607,608,607                                       LIAR 911
B 608  ADJ = ADJ*007777777777                                           LIAR 912
  607  MOVE = MOVE+18                                                   LIAR 913
       ADJ = ARSF(MOVE,ADJ)                                             LIAR 914
C     TEST FOR ALPHABETIC CHARACTER IN ADDRESS                          LIAR 915
 4004 TEST=AADD                                                         LIAR 916
      IF(NTEST-NBK2) 4005,4006,4005                                     LIAR 917
B4005 TEST=AADD*600000000000                                            LIAR 918
      TEST=ARSF(1,TEST)                                                 LIAR 919
      IF(TEST) 401,363,401                                              LIAR 920
C CHECK FOR PERCENT SIGN IN CC17                                        LIAR 921
B 401 TEST=AADD*770000000000                                            LIAR 922
      IF(NTEST-NH74)  4001,4002, 4001                                   LIAR 923
 4002 ADD=AADD                                                          LIAR 924
      GO TO 354                                                         LIAR 925
C TEST FOR * IN  ADDRESS POSITION                                       LIAR 926
 4001 IF(NTEST-NAST) 321,400,321                                        LIAR 927
  400 ARG1=ONE                                                          LIAR 928
       TEST = AILOC                                                     LIAR 929
      CALL BCDPLS(TEST,LCOUNT)                                          LIAR 930
      CALL BCDSUB(TEST,ARG1 )                                           LIAR 931
      ADD=TEST                                                          LIAR 932
      GO TO 362                                                         LIAR 933
  321 FLIP=AADD                                                         LIAR 934
      DO 322 J=1,L,2                                                    LIAR 935
      IF(LATBL(J)-NFLIP) 322,323,322                                    LIAR 936
  322 CONTINUE                                                          LIAR 937
      WRITE OUTPUT TAPE 4,995,NCARD                                     LIAR 938
  995 FORMAT(21H0ADDRESS IN CARD NO. I5,94H   IS NOT IN THE LABEL TABLE.LIAR 939
     1                                                                 )LIAR 940
      MY = MY+1                                                         LIAR 941
      ADD=0.0                                                           LIAR 942
      GO TO 354                                                         LIAR 943
  323 ALOC = ALATBL(J+1)                                                LIAR 944
C     TEST TO SEE IF SYMBOL IS LEFT ADJUSTED                            LIAR 945
B     TEST = ALOC*000000000077                                          LIAR 946
      IF(NTEST-NH6) 320,325,320                                         LIAR 947
C     CHARACTER IS LEFT ADJUSTED                                        LIAR 948
C     TEST TO SEE IF CHARACTER IS ALPHABETIC                            LIAR 949
B 325 TEST=ALOC*600000000000                                            LIAR 950
      TEST=ARSF(1,TEST)                                                 LIAR 951
      IF(TEST) 360,361,360                                              LIAR 952
  361 ADD = ARSF(12,ALOC)                                               LIAR 953
      GO TO 362                                                         LIAR 954
C     CHARACTER IS RIGHT ADJUSTED                                       LIAR 955
  320 ADD = ALOC                                                        LIAR 956
  362 FLIP=ASIGN                                                        LIAR 957
      IF(NFLIP -NBK2) 326,335,326                                       LIAR 958
B 326 FLIP=FLIP*770000000000                                            LIAR 959
      IF(NFLIP-NH4) 600,328,600                                         LIAR 960
  600 IF(NFLIP-NH14) 601,328,601                                        LIAR 961
  601 IF(NFLIP-NH20)329,327,329                                         LIAR 962
  329 WRITE OUTPUT TAPE 4,994,NCARD                                     LIAR 963
  994 FORMAT(40H0ILLEGAL CODE IN SIGN FIELD OF CARD NO. I5,75H          LIAR 964
     1                                                                 )LIAR 965
      MY = MY+1                                                         LIAR 966
  327 CALL BCDPLS(ADD,ADJ)                                              LIAR 967
      GO TO 335                                                         LIAR 968
  328 CALL BCDSUB(ADD,ADJ)                                              LIAR 969
C     PUT IN 1401 ADDRESS EQUIVALENTS                                   LIAR 970
B 335 TEST = ADD*000077000000                                           LIAR 971
      IF(TEST) 336,337,336                                              LIAR 972
B 336 TEST=ADD*000003770000                                             LIAR 973
B     GEO=ADD*000004000000                                              LIAR 974
B     BJM=ADD*000070000000                                              LIAR 975
B     TEST1=ADD*000003000000                                            LIAR 976
      IF (TEST1) 504,520,504                                            LIAR 977
  504 DO 338 J=1,30                                                     LIAR 978
B     TEST1 = XR3(J)*000077770000                                       LIAR 979
      IF(NTEST-NTEST1) 338,339,338                                      LIAR 980
  338 CONTINUE                                                          LIAR 981
B 339 TEST=XR3(J)*007700000000                                          LIAR 982
      TEST = ARSF(12,TEST)                                              LIAR 983
B     ADD = (ADD*000000007777)+TEST                                     LIAR 984
      GO TO 521                                                         LIAR 985
B 520 ADD=ADD*000000777777                                              LIAR 986
  521 IF(BJM) 505,544,505                                               LIAR 987
  505 WRITE OUTPUT TAPE 4,506, NCARD                                    LIAR 988
  506 FORMAT( 63H AN ADDRESS GREATER THAN 7999 IS BEING USED IN INSTRUCTLIAR 989
     1ION NO. I5, 52H                                                   LIAR 990
     2                                     )                            LIAR 991
      MY = MY+1                                                         LIAR 992
      GO TO 354                                                         LIAR 993
C CODING FOR 8K 1401                                                    LIAR 994
  544 IF(GEO) 500,337,500                                               LIAR 995
B 500 TEST = ADD*000000000077                                           LIAR 996
      TEST = ALSF(12,TEST)                                              LIAR 997
      DO 501 J=1,10                                                     LIAR 998
B     TEST1=XR1(J)*000000770000                                         LIAR 999
      IF(NTEST-NTEST1) 501,503,501                                      LIAR 000
  501 CONTINUE                                                          LIAR 001
B 503  TEST=XR1(J)*000000007700                                         LIAR 002
      TEST=ARSF(6,TEST)                                                 LIAR 003
B      ADD=(ADD*777777777700)+TEST                                      LIAR 004
C     PUT IN INDEX REGISTER CODES                                       LIAR 005
  337 FLIP=ATAG                                                         LIAR 006
      IF(NFLIP-NBK2) 343,352,343                                        LIAR 007
B 343 TEST1 = ADD*000000007700                                          LIAR 008
      TEST1 = ALSF(6,TEST1)                                             LIAR 009
B     TEST = ATAG*070000000000                                          LIAR 010
      IF(NTEST-N1) 510,340,510                                          LIAR 011
  510 IF(NTEST-NH2) 511,341,511                                         LIAR 012
  511 IF(NTEST-N3) 512,342,512                                          LIAR 013
  512 WRITE OUTPUT TAPE 4,513,NCARD                                     LIAR 014
  513 FORMAT(50H AN ILLEGAL INDEX IS BEING USED IN INSTRUCTION NO.  I5, LIAR 015
     165H                                                               LIAR 016
     2                                                        )         LIAR 017
      MY=MY+1                                                           LIAR 018
      GO TO 354                                                         LIAR 019
  340 DO 345 J=1,10                                                     LIAR 020
B     TEST = XR1(J)*000000770000                                        LIAR 021
      IF(NTEST-NTEST1) 345,346,345                                      LIAR 022
  345 CONTINUE                                                          LIAR 023
  993 FORMAT( 51H AN ILLEGAL CODE IN THE ADDRESS OF INSTRUCTION NO. I5, LIAR 024
     164H IS BEING INDEXED                                              LIAR 025
     2                                   )                              LIAR 026
      WRITE OUTPUT TAPE 4,993,NCARD                                     LIAR 027
      MY = MY+1                                                         LIAR 028
B 346 TEST = XR1(J)*000000007700                                        LIAR 029
B 349 ADD = (ADD*777777770077)+TEST                                     LIAR 030
      GO TO 352                                                         LIAR 031
  341 DO 347 J=1,10                                                     LIAR 032
B     TEST = XR2(J)*000000770000                                        LIAR 033
      IF(NTEST-NTEST1) 347,348,347                                      LIAR 034
  347 CONTINUE                                                          LIAR 035
      WRITE OUTPUT TAPE 4,993,NCARD                                     LIAR 036
      MY = MY+1                                                         LIAR 037
B 348 TEST = XR2(J)*000000007700                                        LIAR 038
      GO TO 349                                                         LIAR 039
  342 DO 350 J=1,10                                                     LIAR 040
B     TEST = XR3(J)*000000770000                                        LIAR 041
      IF(NTEST-NTEST1) 350,351,350                                      LIAR 042
  350 CONTINUE                                                          LIAR 043
      WRITE OUTPUT TAPE 4,993,NCARD                                     LIAR 044
      MY = MY+1                                                         LIAR 045
B 351 TEST = XR3(J)*000000007700                                        LIAR 046
      GO TO 349                                                         LIAR 047
C     SHIFT ADDRESS TO HIGH ORDER                                       LIAR 048
  352 NSHIFT=18                                                         LIAR 049
B     AMASK=000000400000                                                LIAR 050
      CALL SHIFT(NSHIFT,AMASK,ADD)                                      LIAR 051
      GO TO 354                                                         LIAR 052
  360 ADD = ALOC                                                        LIAR 053
      GO TO 354                                                         LIAR 054
 4006 ADD=AADD                                                          LIAR 055
      GO TO 354                                                         LIAR 056
  363 TEST=AADD                                                         LIAR 057
      CALL ADJUST (TEST)                                                LIAR 058
      ADD=TEST                                                          LIAR 059
      GO TO 362                                                         LIAR 060
  354 RETURN                                                            LIAR 061
      SUBROUTINE BCDOCT(MARTHA,NTOTAL)                                  LIAR 062
      EQUIVALENCE (CHAR,NCHAR), (ARG,NARG)                              LIAR 063
      NARG=MARTHA                                                       LIAR 064
      N=0                                                               LIAR 065
      NTOTAL=0                                                          LIAR 066
      DO 20 J=1,6                                                       LIAR 067
B     CHAR=ARG*000000000077                                             LIAR 068
      NCHAR=XALSF(18,NCHAR)                                             LIAR 069
      NTOTAL=NCHAR*(10**N)+NTOTAL                                       LIAR 070
      N=N+1                                                             LIAR 071
      NARG=XARSF(6,NARG)                                                LIAR 072
   20 CONTINUE                                                          LIAR 073
      RETURN                                                            LIAR 074
      SUBROUTINE SHIFT(NSHIFT,AMASK,ANUMBR)                             LIAR 075
B     TEST=AMASK*ANUMBR                                                 LIAR 076
      ANUMBR=ALSF(NSHIFT,ANUMBR)                                        LIAR 077
      IF(TEST)  1,2,1                                                   LIAR 078
B   1 ANUMBR=ANUMBR+400000000000                                        LIAR 079
    2 RETURN                                                            LIAR 080
      SUBROUTINE BCDSUB(IANSWR,DIGIT)                                   LIAR 081
SNONE OCT   1                                                           LIAR 082
SNTWO OCT   2                                                           LIAR 083
SNH6  OCT   60                                                          LIAR 084
      EQUIVALENCE(ANUMBR,NUMBR),(CHAR,NCHAR),(ALOW,NALOW),(TEST,NTEST), LIAR 085
     1(NDIGIT,DGT)                                                      LIAR 086
B     DIGIT=(-DIGIT)                                                    LIAR 087
B     DGT=DIGIT*377777777777                                            LIAR 088
      NUMBR=IANSWR +NDIGIT+NONE                                         LIAR 089
  100 DO 101 J=1,5                                                      LIAR 090
B     CHAR=(ANUMBR*000000000077)                                        LIAR 091
B     TEST=(CHAR*000000000070)                                          LIAR 092
B     ALOW=(CHAR*000000000007)                                          LIAR 093
      IF(NTEST-NH6  )3,2,1                                              LIAR 094
    1 NCHAR=NALOW+NTWO                                                  LIAR 095
B     GO TO 3                                                           LIAR 096
    2 NCHAR=NALOW+NTWO                                                  LIAR 097
B     CHAR=(CHAR*000000000007)                                          LIAR 098
    3 FAKE=LRSF(6,NCHAR)                                                LIAR 099
      NUMBR=XARSF(6,NUMBR)                                              LIAR 100
  101 CONTINUE                                                          LIAR 101
      N=0                                                               LIAR 102
      IANSWR=XLLSF(30,N)                                                LIAR 103
      RETURN                                                            LIAR 104
      SUBROUTINE BCDPLS(IANSWR,NDIGIT)                                  LIAR 105
SNONE OCT   1                                                           LIAR 106
SNTWO OCT   2                                                           LIAR 107
SN21  OCT   21                                                          LIAR 108
SNELV OCT   11                                                          LIAR 109
      EQUIVALENCE(ANUMBR,NUMBR),(CHAR,NCHAR)                            LIAR 110
      NUMBR=IANSWR+NDIGIT                                               LIAR 111
      NCARRY=0                                                          LIAR 112
  100 DO 101 J=1,5                                                      LIAR 113
B     CHAR=(ANUMBR *000000000077)                                       LIAR 114
      IF(NCHAR-NELV )2,2,1                                              LIAR 115
    1 IF(NCHAR-N21  ) 3,3,4                                             LIAR 116
    3 SENSE LIGHT 3                                                     LIAR 117
      GO TO 4                                                           LIAR 118
    2 FAKE=LRSF(6,NCHAR)                                                LIAR 119
      NUMBR=XARSF(6,NUMBR)+NCARRY                                       LIAR 120
      NCARRY=0                                                          LIAR 121
      GO TO 101                                                         LIAR 122
    4 NCHAR=NCHAR+NCARRY                                                LIAR 123
      NCHAR=NCHAR-NTWO                                                  LIAR 124
      NCARRY=NONE                                                       LIAR 125
B     CHAR=(CHAR*000000000007)                                          LIAR 126
      IF(SENSE LIGHT 3) 2,7                                             LIAR 127
B   7 CHAR=(CHAR+000000000010)                                          LIAR 128
      GO TO 2                                                           LIAR 129
  101 CONTINUE                                                          LIAR 130
      N=0                                                               LIAR 131
      IANSWR=XLLSF(30,N)                                                LIAR 132
      RETURN                                                            LIAR 133
      SUBROUTINE PLACEL(ALABEL,AILOC)                                   LIAR 134
      DIMENSION  ALATBL(1500)                                           LIAR 135
      COMMON ZYX                                                        LIAR 136
      EQUIVALENCE (ALATBL,ZYX(1)),( L,ZYX(2001))                        LIAR 137
      EQUIVALENCE (NCARD,ZYX(2016))  ,(MY,ZYX(2017))                    LIAR 138
      L=L                                                               LIAR 139
      DO 1 K=1,L,2                                                      LIAR 140
      IF(ALATBL(K)-ALABEL) 1,2,1                                        LIAR 141
   10 FORMAT(13H0THE LABEL   A6,15H   IN CARD NO. I5,81H   IS A DUPLICATLIAR 142
     1E                                                                )LIAR 143
    2 WRITE OUTPUT TAPE 4,10,ALABEL,NCARD                               LIAR 144
      MY = MY+1                                                         LIAR 145
    1 CONTINUE                                                          LIAR 146
B     ALATBL(L)=ALABEL                                                  LIAR 147
B     ALATBL(L+1)=AILOC                                                 LIAR 148
      L=L+2                                                             LIAR 149
      RETURN                                                            LIAR 150
      SUBROUTINE ADJUST (AADD)                                          LIAR 151
SNBK5 OCT   000000600000                                                LIAR 152
SNBK4 OCT   000060000000                                                LIAR 153
SNBK3 OCT   006000000000                                                LIAR 154
      EQUIVALENCE (TEST,NTEST)                                          LIAR 155
      MOVE1=0                                                           LIAR 156
B  26 TEST=AADD*000000770000                                            LIAR 157
      IF(NTEST-NBK5) 8000,8001,8000                                     LIAR 158
 8001 MOVE1=6                                                           LIAR 159
B     TEST=AADD*000077000000                                            LIAR 160
      IF(NTEST-NBK4)  8000,8002,8000                                    LIAR 161
 8002 MOVE1=12                                                          LIAR 162
B      TEST=AADD*007700000000                                           LIAR 163
      IF(NTEST-NBK3) 8000,8003,8000                                     LIAR 164
 8003 MOVE1=18                                                          LIAR 165
 8000 MOVE1=MOVE1+12                                                    LIAR 166
      AADD=ARSF(MOVE1,AADD)                                             LIAR 167
      RETURN                                                            LIAR 168
      SUBROUTINE READ                                                   LIAR 169
      COMMON ZYX                                                        LIAR 170
      DIMENSION ALPHA(1)                                                LIAR 171
      EQUIVALENCE (ALPHA(1),AADJ,ZYX(2005)),(ALPHA(2),ATAG,ZYX(2006)),  LIAR 172
     1 (ALPHA(3),BADD,ZYX(2007)),(ALPHA(4),BSIGN,ZYX(2008)),            LIAR 173
     2 (ALPHA(5),BADJ,ZYX(2009)),(ALPHA(6),BTAG,ZYX(2010)),             LIAR 174
     3  (ALPHA(7),D,ZYX(2011)),(ALPHA(8),CMNTS(1),ZYX(2012)),           LIAR 175
     4 (ALPHA(9),CMNTS(2),ZYX(2013)),(ALPHA(10),CMNTS(3),ZYX(2014))     LIAR 176
      EQUIVALENCE (ALABEL,LABEL,ZYX(2020)) ,(OP,IOP,ZYX(2021))          LIAR 177
      EQUIVALENCE(AADD,NAADD,ZYX(2022)),(ASIGN,NASIGN,ZYX(2023))        LIAR 178
      EQUIVALENCE (ICNT,AICNT,ZYX(2024))                                LIAR 179
 5000 READ INPUT TAPE 7,1,ICNT,ALABEL,OP,AADD,ASIGN,AADJ,ATAG,BADD,     LIAR 180
     1BSIGN,BADJ,BTAG,D,CMNTS (1),CMNTS(2),CMNTS(3)                     LIAR 181
    1 FORMAT(5X,A2,A6,A3,A6,A1,A3,A1,A6,A1,A3,A1,A1,A6,A6,A4)           LIAR 182
      RETURN                                                            LIAR 183
