*      'SMASHT' CONTROL RECORD SUBROUTINE                               RLMN0163
       SPACE   2                                                        RLMN0164
*              THIS ROUTINE PRESETS SMASHT.  IT IS ENTERED VARIOUSLY    RLMN0165
*         FROM CRS, VFS, AND $MCRS.  SUBROUTINES K$REWND, K$NPUT,       RLMN0166
*         O$PPU, $SYS, DOC, E$PCR AND E$OCI REQUIRED.                   RLMN0167
       SPACE   2                                                        RLMN0168
*              THE CONTROL RECORD PROCESSED IS OF THE FORM              RLMN0169
       SPACE   2                                                        RLMN0170
*              SMASHT  A,B,C,D,E,F,G,H,J,K,L,M,N,P,Q,R                  RLMN0171
       SPACE   2                                                        RLMN0172
*              WHERE   A IS A FOR MODIFICATIONS ON AUXILIARY INPUT UNIT RLMN0173
*                      A IS N FOR MODIFICATIONS ON NORMAL INPUT UNIT    RLMN0174
*                      B IS GO TO EXECUTE IF NO DEFINITE ERRORS         RLMN0175
*                      B IS GOIF TO EXECUTE IF NO TRIVIAL ERRORS        RLMN0176
*                      B IS GOGOGO TO EXECUTE IN ANY EVENT              RLMN0177
*                      B IS NOGO TO SUPPRESS EXECUTION                  RLMN0178
*                      C IS PHASE NUMBER FOR EXECUTION                  RLMN0179
*                      D IS R FOR ROW BINARY INPUT                      RLMN0180
*                      D IS C FOR COLUMN BINARY INPUT                   RLMN0181
*                      E IS SMA TO PUNCH NEW SMASHT DECK                RLMN0182
*                      E IS NOSMA TO SUPPRESS PUNCHING NEW SMASHT DECK  RLMN0183
*                      F IS ABS TO PUNCH AN ABSOLUTE DECK               RLMN0184
*                      F IS NOABS TO SUPPRESS ABSOLUTE DECK PUNCHING    RLMN0185
*                      G IS REL TO PUNCH A RELOCATABLE DECK             RLMN0186
*                      G IS NOREL TO SUPPRESS RELOCATABLE DECK PUNCHING RLMN0187
*                      H IS R TO OUTPUT ROW BINARY                      RLMN0188
*                      H IS C TO OUTPUT COLUMN BINARY                   RLMN0189
*                      J IS LIST TO PRINT LISTING (SYMBOLIC ONLY)       RLMN0190
*                      J IS LIST8 TO PRINT LISTING (SYMBOLIC AND OCTAL) RLMN0191
*                      J IS NOLIST TO SUPPRESS LISTING                  RLMN0192
*                      K IS DICT TO PRINT DICTIONARY WITH LISTING       RLMN0193
*                      K IS NODICT TO SUPPRESS DICTIONARY IN OUTPUT     RLMN0194
*                      L IS DEBUG TO EXECUTE WITH DEBUGGING             RLMN0195
*                      L IS NOBUG TO EXECUTE WITHOUT DEBUGGING          RLMN0196
*                      M IS SS TO USE SYSTEM SYMBOLS                    RLMN0197
*                      M IS NS TO SUPPRESS USE OF SYSTEM SYMBOLS        RLMN0198
*                      N IS DEFERR TO LIST ONLY DEFINITE ERRORS         RLMN0199
*                      N IS ALLERR TO LIST ALL ERRORS                   RLMN0200
*                      P IS IN TO EXECUTE WITH INTRAN                   RLMN0201
*                      P IS NOIN TO EXECUTE WITHOUT INTRAN              RLMN0202
*                      Q IS OUT TO EXECUTE WITH OUTRAN                  RLMN0203
*                      Q IS NOOUT TO EXECUTE WITHOUT OUTRAN             RLMN0204
*                      R IS TRMAC TO EXECUTE WITH TRANSMISSION MACROS   RLMN0205
*                      R IS NOMAC TO EXECUTE WITHOUT TRANSMISSION MACROSRLMN0206
       SPACE   2                                                        RLMN0207
*              THE NORMAL CASE IS AS FOLLOWS.                           RLMN0208
       SPACE   2                                                        RLMN0209
*      SMASHT  N,GO,2,C,NOSMA,NOABS,NOREL,C,NOLIST,DICT,DEBUG,SS,       RLMN0210
*              ALLERR,NOIN,NOOUT,NOMAC                                  RLMN0211
       EJECT                                                            RLMN0212
*              ENTRY FROM VFS                                           RLMN0213
       SPACE   2                                                        RLMN0214
SMA1   SIR     400000              MODIFICATIONS ON AUXILIARY UNIT      RLMN0215
SMA2   NOP                         MODIFICATIONS ON NORMAL UNIT         RLMN0216
SMA3   OSI     SMA90               GO IF NO DEFINITE ERRORS             RLMN0217
SMA4   OSI     SMA91               GO IF NO ERRORS                      RLMN0218
SMA5   OSI     SMA92               GO IN ANY EVENT                      RLMN0219
SMA6   SYN     SMA2                DON'T GO                             RLMN0220
SMA7   SYN     SMA2                EXECUTE IN PHASE 1                   RLMN0221
SMA8   SIL     20                  EXECUTE IN PHASE 2                   RLMN0222
SMA9   SIL     40                  EXECUTE IN PHASE 3                   RLMN0223
SMA10  SYN     SMA2                INPUT IS ROW BINARY                  RLMN0224
SMA11  SIR     100000              INPUT IS COLUMN BINARY               RLMN0225
SMA12  SIR     2                   PUNCH NEW SMASHT DECK                RLMN0226
SMA13  SYN     SMA2                DON'T PUNCH NEW SMASHT DECK          RLMN0227
SMA14  SIR     40                  PUNCH ABSOLUTE DECK                  RLMN0228
SMA15  SYN     SMA2                DON'T PUNCH ABSOLUTE DECK            RLMN0229
SMA16  SIR     10                  PUNCH RELOCATABLE DECK               RLMN0230
SMA17  SYN     SMA2                DON'T PUNCH RELOCATABLE DECK         RLMN0231
SMA18  SYN     SMA2                OUTPUT IS ROW BINARY                 RLMN0232
SMA19  SIR     200000              OUTPUT IS COLUMN BINARY              RLMN0233
SMA20  SIR     100                 PRINT SYMBOLIC LISTING               RLMN0234
SMA21  SIR     10100               PRINT SYMBOLIC/OCTAL LISTING         RLMN0235
SMA22  SYN     SMA2                SUPPRESS PRINTING                    RLMN0236
SMA23  SIR     4000                PRINT DICTIONARY WITH LISTING        RLMN0237
SMA24  SYN     SMA2                DON'T PRINT DICTIONARY               RLMN0238
SMA25  SYN     SMA2                EXECUTE WITH DEBUGGING               RLMN0239
SMA26  SIL     1                   EXECUTE WITHOUT DEBUGGING            RLMN0240
SMA27  SIL     10                  EMPLOY SYSTEM SYMBOLS                RLMN0241
SMA28  SYN     SMA2                DON'T EMPLOY SYSTEM SYMBOLS          RLMN0242
SMA29  SYN     SMA2                LIST ONLY DEFINITE ERRORS            RLMN0243
SMA30  SIR     10                  LIST ALL ERRORS                      RLMN0244
SMA31  SIL     4000                EXECUTE WITH INTRAN                  RLMN0245
SMA32  SYN     SMA2                EXECUTE WITHOUT INTRAN               RLMN0246
SMA33  SIL     2000                EXECUTE WITH OUTRAN                  RLMN0247
SMA34  SYN     SMA2                EXECUTE WITHOUT OUTRAN               RLMN0248
SMA35  SIR     1000                EXECUTE WITH TRANSMISSION MACROS     RLMN0249
SMA36  SYN     SMA2                EXECUTE WITHOUT TRANSMISSION MACROS  RLMN0250
       EJECT                                                            RLMN0251
