C                                                                       IPM30779
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IPM30780
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IPM30781
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IPM30782
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IPM30783
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IPM30784
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IPM30785
     1(A1,IA1)                                                          IPM30786
C                                                                       IPM30787
      IOCT = IOCT + 1                                                   IPM30788
      GO TO (1,3),NSW2                                                  IPM30789
    1 WRITE OUTPUT TAPE NDR,2,K,I1                                      IPM30790
 2    FORMAT(10H0OFLOW, L=I4,5H, LT=I4,1H.)                             IPM30791
 3    RETURN                                                            IPM30792
      END                                                               IPM30793
