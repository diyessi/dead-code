*     LIST8                                                             IPM30001
*     LABEL                                                             IPM30002
CIPM3  INTEGER PROGRAMMING CODE 3, 7090 FMS, MAIN PROGRAM               IPM30003
C     R. E. LEVITAN -- INTEGER PROGRAMMING                              IPM30004
C                                                                       IPM30005
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IPM30006
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IPM30007
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IPM30008
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IPM30009
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IPM30010
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IPM30011
     1(A1,IA1)                                                          IPM30012
C                                                                       IPM30013
      IDR=5                                                             IPM30014
      NDR=6                                                             IPM30015
      READ INPUT TAPE IDR,4,NSW1,NSW2,NSW4,NSW5,NSWS                    IPM30016
    4 FORMAT (5I6)                                                      IPM30017
      ASSIGN 1 TO JUMP                                                  IPM30018
      IPRC = 0                                                          IPM30019
 1    CALL SET 1                                                        IPM30020
      IPRC = IPRC + 1                                                   IPM30021
      WRITE OUTPUT TAPE NDR,2,IPRC,ALPHA                                IPM30022
 2    FORMAT(14H1START PROBLEMI4,3H.  3A6)                              IPM30023
      PRINT 50,IPRC,ALPHA                                               IPM30024
   50 FORMAT (14H0START PROBLEMI4,3H.  3A6)                             IPM30025
      SENSE LIGHT 1                                                     IPM30026
      IPCT = 0                                                          IPM30027
      IVCT = 0                                                          IPM30028
      IOCT = 0                                                          IPM30029
      MS = 1                                                            IPM30030
      CH = .5                                                           IPM30031
      H = .5                                                            IPM30032
      CALL SET2                                                         IPM30033
      N3 = N                                                            IPM30034
      CALL MOUT                                                         IPM30035
      N3 = N + 1                                                        IPM30036
      IF (SET3(V)) 1, 32, 1                                             IPM30037
   32 GO TO (23,3),NSW1                                                 IPM30038
 23   CALL MOUT                                                         IPM30039
 3    IF (ROWS(KL,I1)) 24, 17, 17                                       IPM30040
 24   IF (M2-I1) 7, 7, 8                                                IPM30041
 7    MS = MSI                                                          IPM30042
 8    IF (COLS(I1,J1)) 11, 9, 9                                         IPM30043
    9 WRITE OUTPUT TAPE NDR,10                                          IPM30044
      PRINT 10                                                          IPM30045
 10   FORMAT(21H0PROBLEM HAS NO SOLN.)                                  IPM30046
      GO TO 30                                                          IPM30047
 11   CALL RCT (I1,J1)                                                  IPM30048
      IF (PIV(I1,J1)) 12, 14, 14                                        IPM30049
 12   CALL TWR (I1,J1)                                                  IPM30050
      CALL RGEN                                                         IPM30051
      IF (SENSE SWITCH 1)44,41                                          IPM30052
   44 GO TO (40,41),NSWS                                                IPM30053
   40 ASSIGN 22 TO JUMP                                                 IPM30054
      CALL BRK(1)                                                       IPM30055
   41 IF (IPCT-LIM)27,5,27                                              IPM30056
   27 IF (SENSE SWITCH 5)13,3                                           IPM30057
   13 GO TO (5,3),NSW5                                                  IPM30058
    5 CALL BRK(2)                                                       IPM30059
      GO TO JUMP,(1, 22)                                                IPM30060
 14   IF (RPIV(I1,J1)) 12, 15, 9                                        IPM30061
   15 WRITE OUTPUT TAPE NDR,16                                          IPM30062
      PRINT 16                                                          IPM30063
 16   FORMAT(21H0UNCORRECTABLE OFLOW.)                                  IPM30064
   30 GO TO (31,28),NSW1                                                IPM30065
 28   CALL MOUT                                                         IPM30066
   31 WRITE OUTPUT TAPE NDR,29,IPCT,IPRC,ALPHA                          IPM30067
      PRINT 29,IPCT,IPRC,ALPHA                                          IPM30068
 29   FORMAT(28H0DISCONTINUED CALCULATION ONI6,16HTH PIVOT PROBLEMI4,3H.IPM30069
     1  3A6)                                                            IPM30070
      GO TO 21                                                          IPM30071
   17 GO TO (19,18),NSW1                                                IPM30072
 18   CALL MOUT                                                         IPM30073
   19 WRITE OUTPUT TAPE NDR,20,IPCT,IPRC,ALPHA,IVCT,IOCT                IPM30074
      PRINT 20,IPCT, IPRC, ALPHA,IVCT,IOCT                              IPM30075
   20 FORMAT(17H0SOLN. REACHED ONI6,19HTH PIVOT.   PROBLEMI4,3H.  3A6/I6IPM30076
     1,15H NEW VARBLS ANDI6,8H OFLOWS.)                                 IPM30077
 21   GO TO JUMP,(1, 22)                                                IPM30078
   22 CALL EXIT                                                         IPM30079
      END                                                               IPM30080
*     LIST8                                                             IPM30081
      SUBROUTINE BRK(LOC)                                               IPM30082
C     7090 SHARE                                                        IPM30083
C                                                                       IPM30084
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IPM30085
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IPM30086
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IPM30087
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IPM30088
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IPM30089
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IPM30090
     1(A1,IA1)                                                          IPM30091
C                                                                       IPM30092
      GO TO (2,4),NSW1                                                  IPM30093
    4 CALL MOUT                                                         IPM30094
    2 WRITE OUTPUT TAPE NDR,3,IPRC,ALPHA,IPCT,IVCT,IOCT                 IPM30095
      PRINT 3,IPRC,ALPHA,IPCT,IVCT,IOCT                                 IPM30096
    3 FORMAT(15H BRKPT, PROBLEMI4,2H  3A6,4H -- I4,8H PIVOTS,I4,12H NEW IPM30097
     1VARBLS,I4,8H OFLOWS.)                                             IPM30098
      GO TO (1,5),LOC                                                   IPM30099
    1 CALL SAVE                                                         IPM30100
      WRITE OUTPUT TAPE NDR,7,IPRC,ALPHA,IPCT,IVCT,IOCT                 IPM30101
      PRINT 7,IPRC,ALPHA,IPCT,IVCT,IOCT                                 IPM30102
    7 FORMAT (16H1RESTART PROBLEMI4,2X,3A6,4H -- I4,8H PIVOTS,I4,12H NEWIPM30103
     1VARBLS,I4,8H OFLOWS.)                                             IPM30104
    5 RETURN                                                            IPM30105
      END                                                               IPM30106
*     LIST8                                                             IPM30107
*     LABEL                                                             IPM30108
      SUBROUTINE SET1                                                   IPM30109
C     READS MATRIX INTO STORAGE AND SETS UP UNIT MATRIX/7090 SHARE      IPM30110
C                                                                       IPM30111
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IPM30112
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IPM30113
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IPM30114
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IPM30115
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IPM30116
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IPM30117
     1(A1,IA1)                                                          IPM30118
C                                                                       IPM30119
      READ INPUT TAPE IDR,3,M,N,KR,MSI,LIM,UB,ALPHA                     IPM30120
      IF (M)998,999,16                                                  IPM30121
  999 WRITE OUTPUT TAPE NDR,7                                           IPM30122
      PRINT 7                                                           IPM30123
 7    FORMAT(33H0LAST PROBLEM HAS BEEN PROCESSED.//)                    IPM30124
      CALL EXIT                                                         IPM30125
 16   N1 = N                                                            IPM30126
      M1=M+N-1                                                          IPM30127
      DO 20 J = 1,N                                                     IPM30128
      DO 20 I=1,M1                                                      IPM30129
 20   A(I,J) = 0.                                                       IPM30130
      GO TO 9                                                           IPM30131
 11   A(I,J) = AA                                                       IPM30132
    9 READ INPUT TAPE IDR,5,I,J,AA                                      IPM30133
      IF (J) 998,6,11                                                   IPM30134
    6 D=1.0                                                             IPM30135
      IF (KR)998,12,13                                                  IPM30136
  998 WRITE OUTPUT TAPE NDR,997,M,N,KR,MSI,LIM,UB,ALPHA,I,J,AA          IPM30137
      CALL EXIT                                                         IPM30138
   12 KR=1                                                              IPM30139
   13 IF (MSI)998,14,15                                                 IPM30140
   14 MSI=1                                                             IPM30141
 15   RETURN                                                            IPM30142
 3    FORMAT(5I6,F6.0,3A6)                                              IPM30143
    5 FORMAT (2I5,F10.5)                                                IPM30144
  997 FORMAT (36H0DATA ERROR. LAST CONTROL CARD READS//5I6,F6.0,3A6/33H0IPM30145
     1LAST ELEMENT CARD, IF ANY, READS//2I5,F10.5)                      IPM30146
      END                                                               IPM30147
*     LABEL                                                             IPM30148
*     LIST8                                                             IPM30149
      SUBROUTINE SET2                                                   IPM30150
C     SETS UP UNIT MATRIX AND INDICES/7090 SHARE                        IPM30151
C                                                                       IPM30152
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IPM30153
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IPM30154
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IPM30155
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IPM30156
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IPM30157
     1(A1,IA1)                                                          IPM30158
C                                                                       IPM30159
 231  M1 = M + N   - 1                                                  IPM30160
      M2=M+1                                                            IPM30161
      DO8I=M2,M1                                                        IPM30162
      DO 7 J = 1,N                                                      IPM30163
 7    A(I,J) = 0                                                        IPM30164
 8    CONTINUE                                                          IPM30165
      DO 5 J = 2,N                                                      IPM30166
      I = M2 + J - 2                                                    IPM30167
      LT(J) = I                                                         IPM30168
 5    A(I,J) = -D                                                       IPM30169
      LT = 0                                                            IPM30170
      LT(N+1) = 0                                                       IPM30171
      DO9I=1,M1                                                         IPM30172
 9    L(I)=I                                                            IPM30173
      M3 = M1 + 1                                                       IPM30174
      KL = KR + 1                                                       IPM30175
      M2 = M1                                                           IPM30176
      RETURN                                                            IPM30177
      END                                                               IPM30178
*     LIST8                                                             IPM30179
*     LABEL                                                             IPM30180
      FUNCTION SET3 (X)                                                 IPM30181
C     GETS PROBLEM DUAL FEASIBLE IF NOT SO/7090 SHARE                   IPM30182
C                                                                       IPM30183
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IPM30184
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IPM30185
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IPM30186
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IPM30187
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IPM30188
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IPM30189
     1(A1,IA1)                                                          IPM30190
C                                                                       IPM30191
      V = X                                                             IPM30192
      NS = N1 + 1                                                       IPM30193
      IK = M1 + 1                                                       IPM30194
      J1 = 0                                                            IPM30195
      DO 10 J = 2,N                                                     IPM30196
      DO 2 I = 1,M1                                                     IPM30197
      IF (A(I,J)) 3, 2, 9                                               IPM30198
 2    CONTINUE                                                          IPM30199
      GO TO 9                                                           IPM30200
 3    IF (I-IK) 6, 4, 8                                                 IPM30201
 4    DO 5 I1 = IK,M1                                                   IPM30202
      IF (IA(I1,J1)-IA(I1,J)) 8, 5, 7                                   IPM30203
 5    CONTINUE                                                          IPM30204
 6    IK = I                                                            IPM30205
 7    J1 = J                                                            IPM30206
 8    IA(M1+1,J) = -1                                                   IPM30207
      GO TO 10                                                          IPM30208
 9    IA(M1+1,J) = 0                                                    IPM30209
 10   CONTINUE                                                          IPM30210
      IF (J1) 11, 16, 11                                                IPM30211
 11   IF (UB) 19, 19, 21                                                IPM30212
   19 WRITE OUTPUT TAPE NDR,20,IPRC,ALPHA                               IPM30213
 20   FORMAT(12H0PROBLEM NO.I3,3A6,19H  NEEDS UPPER BOUND)              IPM30214
      SET3 = -1.                                                        IPM30215
      GO TO 22                                                          IPM30216
 21   LT(J1) = -1                                                       IPM30217
      IVCT = 1                                                          IPM30218
      DO 12 I = IK,M1                                                   IPM30219
      A(I,J1) = -A(I,J1)                                                IPM30220
 12   A(I,1) = A(I,J1)*UB + A(I,1)                                      IPM30221
      IA(M1+1,J1) = 0                                                   IPM30222
      DO 15 J = 2,N                                                     IPM30223
      IF (IA(M1+1,J)) 13, 15, 13                                        IPM30224
 13   DO 14 I = IK,M1                                                   IPM30225
 14   A(I,J) = A(I,J) + A(I,J1)                                         IPM30226
 15   CONTINUE                                                          IPM30227
 16   DO 18 I = 1,M1                                                    IPM30228
      A(I,NS) = 1.                                                      IPM30229
      DO 17 J = 3,N1                                                    IPM30230
 17   A(I,NS) = A(I,NS) + A(I,J)                                        IPM30231
 18   CONTINUE                                                          IPM30232
      SET3 = 0.                                                         IPM30233
 22   RETURN                                                            IPM30234
      END                                                               IPM30235
*     LIST8                                                             IPM30236
*     LABEL                                                             IPM30237
      FUNCTION ROWS (KU,I1)                                             IPM30238
C     SELECTS PIVOT ROW BY RATIO TO SUM METHOD/7090 SHARE               IPM30239
C                                                                       IPM30240
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IPM30241
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IPM30242
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IPM30243
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IPM30244
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IPM30245
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IPM30246
     1(A1,IA1)                                                          IPM30247
C                                                                       IPM30248
      EQUIVALENCE (IRO,ROWS),(Q,IQ),(QP,IQP)                            IPM30249
      K2 = 1                                                            IPM30250
      DO 24 I = KU,M1                                                   IPM30251
 3    A1 = A(I,1)                                                       IPM30252
      IF (A1) 10, 24, 24                                                IPM30253
 10   SU = A(I,NS) - 1.                                                 IPM30254
      IF (SU) 11, 15, 19                                                IPM30255
 11   GO TO (13, 12, 24, 24), K2                                        IPM30256
 12   QP = SU/A1                                                        IPM30257
      GO TO 22                                                          IPM30258
 13   K2 = 2                                                            IPM30259
      Q = SU/A1                                                         IPM30260
      GO TO 23                                                          IPM30261
 15   GO TO (17, 17, 16, 24), K2                                        IPM30262
 16   QP = A1                                                           IPM30263
      GO TO 22                                                          IPM30264
 17   K2 = 3                                                            IPM30265
      Q = A1                                                            IPM30266
      GO TO 23                                                          IPM30267
 19   GO TO (21, 21, 21, 20), K2                                        IPM30268
 20   QP = SU*A1                                                        IPM30269
 22   IF (IQ - IQP) 24, 24, 28                                          IPM30270
 21   K2 = 4                                                            IPM30271
      Q = SU*A1                                                         IPM30272
      GO TO 23                                                          IPM30273
 28   Q = QP                                                            IPM30274
 23   I1 = I                                                            IPM30275
 24   CONTINUE                                                          IPM30276
      IRO = 1 - K2                                                      IPM30277
      RETURN                                                            IPM30278
      END                                                               IPM30279
*     LIST8                                                             IPM30280
*     LABEL                                                             IPM30281
      FUNCTION COLS (I1,J1)                                             IPM30282
C     SELECTS PIVOT ELEMENT/7090 SHARE                                  IPM30283
C                                                                       IPM30284
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IPM30285
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IPM30286
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IPM30287
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IPM30288
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IPM30289
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IPM30290
     1(A1,IA1)                                                          IPM30291
C                                                                       IPM30292
      EQUIVALENCE (IR,R),(RP,IRP)                                       IPM30293
      I3 = 0                                                            IPM30294
      J1 = 0                                                            IPM30295
      DO 15 J = 2,N                                                     IPM30296
      IF (A(I1,J)) 2, 15, 15                                            IPM30297
 2    DO 3 I2 = 1,I1                                                    IPM30298
      IF (A(I2,J)) 24, 3, 4                                             IPM30299
   24 WRITE OUTPUT TAPE NDR,998,J,I2,I1                                 IPM30300
      CALL MOUT                                                         IPM30301
      CALL EXIT                                                         IPM30302
 3    CONTINUE                                                          IPM30303
 4    IF (J1) 999, 14, 5                                                IPM30304
 5    IF (I2 - I3) 15, 6, 14                                            IPM30305
 6    R = INTF(A(I1,J)*D - .5)/INTF(A(I1,J1)*D - .5)                    IPM30306
      DO 13 I = I3,M1                                                   IPM30307
      IF (A(I,J1)) 9, 8, 10                                             IPM30308
 8    IF (A(I,J)) 14, 13, 15                                            IPM30309
 9    IF (A(I,J)) 11, 15, 15                                            IPM30310
 10   IF (A(I,J)) 14, 14, 12                                            IPM30311
 11   RP = INTF(A(I,J)*D - .5)/INTF(A(I,J1)*D - .5)                     IPM30312
      IF (IR - IRP) 14, 13, 15                                          IPM30313
 12   RP = INTF(A(I,J)*D + .5)/INTF(A(I,J1)*D + .5)                     IPM30314
      IF (IR - IRP) 15, 13, 14                                          IPM30315
 13   CONTINUE                                                          IPM30316
 14   J1 = J                                                            IPM30317
      I3 = I2                                                           IPM30318
 15   CONTINUE                                                          IPM30319
      IF (J1) 999, 999, 16                                              IPM30320
 16   COLS = -1.                                                        IPM30321
 18   RETURN                                                            IPM30322
 999  COLS = 0.                                                         IPM30323
      GO TO 18                                                          IPM30324
  998 FORMAT (35H0LEADING NON-ZERO ELEMENT IN COLUMNI4,8H, IN ROWI4,30H,IPM30325
     1 IS NEGATIVE. PIVOT ROW I1 ISI4)                                  IPM30326
      END                                                               IPM30327
*     LIST8                                                             IPM30328
*     LABEL                                                             IPM30329
      SUBROUTINE RGEN                                                   IPM30330
C     MAINTAINS APPENDIX OF FRACTIONAL ROWS/7090 SHARE                  IPM30331
C                                                                       IPM30332
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IPM30333
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IPM30334
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IPM30335
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IPM30336
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IPM30337
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IPM30338
     1(A1,IA1)                                                          IPM30339
C                                                                       IPM30340
      EQUIVALENCE (IRM,RM),(IP5,P5)                                     IPM30341
C                                                                       IPM30342
      P5 = .5                                                           IPM30343
      IC=0                                                              IPM30344
      K=0                                                               IPM30345
      IF (M1-M3)9,8,8                                                   IPM30346
    8 DO 7 I=M3,M1                                                      IPM30347
      A1=A(I,1)                                                         IPM30348
      IF (A1) 4, 6, 6                                                   IPM30349
    4 IF (IA1+ICH)7,7,5                                                 IPM30350
    5 RM=INTF(.5-A1*D)                                                  IPM30351
      IF (IC)73,73,71                                                   IPM30352
   71 DO 72 J=1,IC                                                      IPM30353
      IF (IRMV(J)-IRM)72,7,72                                           IPM30354
   72 CONTINUE                                                          IPM30355
   73 IC=IC+1                                                           IPM30356
      IRMV(IC)=IRM                                                      IPM30357
      GO TO 7                                                           IPM30358
    6 K=K+1                                                             IPM30359
      IT(K)=I                                                           IPM30360
    7 CONTINUE                                                          IPM30361
    9 NO=MS+M2-M1+K                                                     IPM30362
      IF (NO-K)10,10,11                                                 IPM30363
 10   IF (NO) 50, 50, 2                                                 IPM30364
   11 K3=M1-K                                                           IPM30365
      K=K+1                                                             IPM30366
      DO 12 J=K,NO                                                      IPM30367
   12 IT(J)=K3+J                                                        IPM30368
 2    K5 = 0                                                            IPM30369
      ICP = IC                                                          IPM30370
      ICPP = IC + 1                                                     IPM30371
      DO 32 I = 1,M2                                                    IPM30372
      A1 = A(I,1)                                                       IPM30373
      IF (A1) 23, 32, 23                                                IPM30374
   23 RM=A1-INTF(A1)                                                    IPM30375
      IF (RM) 15, 32, 16                                                IPM30376
   15 RM=RM+1.                                                          IPM30377
 16   IF (IRM-IH) 32, 32, 17                                            IPM30378
 17   IF (ICH - IRM) 32, 32, 18                                         IPM30379
 18   IK = I                                                            IPM30380
      IF (IRM-IP5)19,20,20                                              IPM30381
   19 RM=1.-RM                                                          IPM30382
      IK = -I                                                           IPM30383
   20 RM=INTF(RM*D+.5)                                                  IPM30384
      IF (IC)30,30,21                                                   IPM30385
   21 DO 29 J=1,IC                                                      IPM30386
      IF (IRMV(J)-IRM)29,32,29                                          IPM30387
   29 CONTINUE                                                          IPM30388
 30   IF (K5) 43, 43, 35                                                IPM30389
 35   DO 36 J = ICPP,ICP                                                IPM30390
      IF (IRM-IRMV(J)) 36, 32, 37                                       IPM30391
 36   CONTINUE                                                          IPM30392
      IF (NO-K5) 32, 32, 43                                             IPM30393
 37   IF (NO-K5) 39, 39, 38                                             IPM30394
 38   K5 = K5 + 1                                                       IPM30395
      ICP = ICP + 1                                                     IPM30396
 39   J1 = ICP - J                                                      IPM30397
      IF (J1) 44, 44, 40                                                IPM30398
 40   K3 = ICP + 1                                                      IPM30399
      DO 42 J2 = 1,J1                                                   IPM30400
      J3 = K3 - J2                                                      IPM30401
      IRMV(J3) = IRMV(J3-1)                                             IPM30402
 42   IM(J3) = IM(J3-1)                                                 IPM30403
      GO TO 44                                                          IPM30404
 43   ICP = ICP+1                                                       IPM30405
      J=ICP                                                             IPM30406
      K5 = K5 + 1                                                       IPM30407
 44   IRMV(J) = IRM                                                     IPM30408
      IM(J) = IK                                                        IPM30409
 32   CONTINUE                                                          IPM30410
      IF (K5) 50, 50, 45                                                IPM30411
 45   K = 0                                                             IPM30412
      DO 49 J = ICPP,ICP                                                IPM30413
      IK = IM(J)                                                        IPM30414
      IF (IK) 46, 46, 47                                                IPM30415
 46   K3 = 2                                                            IPM30416
      IK = -IK                                                          IPM30417
      GO TO 48                                                          IPM30418
 47   K3 = 1                                                            IPM30419
 48   K = K + 1                                                         IPM30420
      I1 = IT(K)                                                        IPM30421
      CALL RMRO (I1,IK,K3)                                              IPM30422
 49   CALL NRM (IK,I1)                                                  IPM30423
      M1 = XMAX0F(M1,I1)                                                IPM30424
 50   RETURN                                                            IPM30425
      END                                                               IPM30426
*     LIST8                                                             IPM30427
*     LABEL                                                             IPM30428
      SUBROUTINE RMRO (I1,I2,I3)                                        IPM30429
C     GENERATES ROW OF REMAINDERS/7090 SHARE                            IPM30430
C                                                                       IPM30431
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IPM30432
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IPM30433
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IPM30434
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IPM30435
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IPM30436
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IPM30437
     1(A1,IA1)                                                          IPM30438
C                                                                       IPM30439
      DO 12 J = 1,N1                                                    IPM30440
      GO TO (4,5),I3                                                    IPM30441
 4    A1 = A(I2,J)                                                      IPM30442
      GO TO 6                                                           IPM30443
 5    A1 = -A(I2,J)                                                     IPM30444
 6    IF(A1) 10,7, 8                                                    IPM30445
 8    A(I1,J) = INTF(A1) - A1                                           IPM30446
    9 IF (IA(I1,J) + ICH) 7,7,14                                        IPM30447
   14 IF (IA(I1,J) + IH) 12,7,7                                         IPM30448
 10   A(I1,J) = INTF(A1) - A1 - 1.                                      IPM30449
      GO TO 9                                                           IPM30450
 7    A(I1,J) = 0.                                                      IPM30451
 12   CONTINUE                                                          IPM30452
      A(I1,NS) = 1.                                                     IPM30453
      DO 13 J = 2,N                                                     IPM30454
      IF (IA(I1,J)) 11,13,13                                            IPM30455
 11   A(I1,NS) = A(I1,NS) + A(I1,J)                                     IPM30456
 13   CONTINUE                                                          IPM30457
      RETURN                                                            IPM30458
      END                                                               IPM30459
*     LABEL                                                             IPM30460
*     LIST8                                                             IPM30461
      SUBROUTINE RCT (I1,J1)                                            IPM30462
C     7090 SHARE                                                        IPM30463
C                                                                       IPM30464
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IPM30465
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IPM30466
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IPM30467
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IPM30468
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IPM30469
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IPM30470
     1(A1,IA1)                                                          IPM30471
C                                                                       IPM30472
      A1=A(I1,NS)-1.                                                    IPM30473
      IF (A1)1,6,6                                                      IPM30474
    1 I2=I1                                                             IPM30475
      J2=J1                                                             IPM30476
      IF (INRO (I2,J2)) 2,6,2                                           IPM30477
 2    IF (A1/A(I1,1) - (A(I2,NS)-1.)/A(I2,1)) 6, 5, 5                   IPM30478
    5 I1=I2                                                             IPM30479
      J1=J2                                                             IPM30480
    6 RETURN                                                            IPM30481
      END                                                               IPM30482
*     LIST8                                                             IPM30483
*     LABEL                                                             IPM30484
      FUNCTION INRO (I1,J1)                                             IPM30485
C     7090 SHARE                                                        IPM30486
C                                                                       IPM30487
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IPM30488
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IPM30489
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IPM30490
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IPM30491
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IPM30492
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IPM30493
     1(A1,IA1)                                                          IPM30494
C                                                                       IPM30495
      EQUIVALENCE (UN,IUN)                                              IPM30496
      IF (A(I1,J1)+1.+H)2,2,1                                           IPM30497
    1 INRO=0                                                            IPM30498
      GO TO 13                                                          IPM30499
 2    AN = INTF(.5 - A(I1,J1)*D)                                        IPM30500
      UN=1.                                                             IPM30501
      S=1.                                                              IPM30502
      DO 12 J=1,N1                                                      IPM30503
      IF (A(I1,J)) 9, 6, 7                                              IPM30504
    6 A(M1+1,J)=0.                                                      IPM30505
      GO TO 12                                                          IPM30506
 7    A(M1+1,J) = INTF(A(I1,J)*D+.5)/AN                                 IPM30507
      IF (IA(M1+1,J)-IUN) 6, 11, 8                                      IPM30508
 8    A(M1+1,J) = INTF(A(M1+1,J))                                       IPM30509
      GO TO 11                                                          IPM30510
    9 A1=INTF(A(I1,J)*D-.5)/AN                                          IPM30511
      A(M1+1,J)=INTF(A1)                                                IPM30512
      IF (IA(M1+1,J)-IA1)11,11,10                                       IPM30513
   10 A(M1+1,J)=A(M1+1,J)-1.                                            IPM30514
   11 S=S+A(M1+1,J)                                                     IPM30515
   12 CONTINUE                                                          IPM30516
      A(M1+1,NS) = S - A(M1+1,1)                                        IPM30517
      INRO=-1                                                           IPM30518
      I2=M1+1                                                           IPM30519
      CALL NRM(I1,I2)                                                   IPM30520
      CALL COLS(I2,J1)                                                  IPM30521
      I1=I2                                                             IPM30522
   13 RETURN                                                            IPM30523
      END                                                               IPM30524
*     LIST8                                                             IPM30525
*     LABEL                                                             IPM30526
      FUNCTION RPIV (I1,J1)                                             IPM30527
C     ATTEMPTS NEXT PIVOT IN CASE OF OFLOW/7090 SHARE                   IPM30528
C                                                                       IPM30529
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IPM30530
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IPM30531
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IPM30532
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IPM30533
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IPM30534
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IPM30535
     1(A1,IA1)                                                          IPM30536
C                                                                       IPM30537
      EQUIVALENCE (AN,IAN)                                              IPM30538
 3    CALL OFLO (I1,J1)                                                 IPM30539
      IF (INRO (I1,J1)) 4, 15, 15                                       IPM30540
 4    IF (PIV(I1,J1)) 45, 3, 3                                          IPM30541
 15   IF (M1 - M3) 20, 12, 12                                           IPM30542
 12   IF (I2-M3) 13, 20, 20                                             IPM30543
 13   IF (I2-M1) 5, 5, 20                                               IPM30544
 5    IF (ROWS(M3,I1)) 17, 20, 20                                       IPM30545
 17   IF (COLS(I1,J1)) 18, 47, 47                                       IPM30546
 18   IF (PIV(I1,J1)) 45, 19,45                                         IPM30547
 19   CALL OFLO (I1,J1)                                                 IPM30548
 20   K1 = 1                                                            IPM30549
      I1 = M1 + 1                                                       IPM30550
      DO 22 I2 = 1,M2                                                   IPM30551
      IF (A(I2,1)) 21, 22, 21                                           IPM30552
 21   A1 = ABSF(A(I2,1)) - INTF(ABSF(A(I2,1)))                          IPM30553
      IF (IA1 - IH) 22, 22, 23                                          IPM30554
 23   IF (IA1 - ICH) 30, 22, 22                                         IPM30555
 22   CONTINUE                                                          IPM30556
      K1 = 2                                                            IPM30557
      DO 29 I2 = 1,M2                                                   IPM30558
      IF (A(I2,1)) 25, 26, 25                                           IPM30559
 25   A1 = ABSF(A(I2,1)) - INTF(ABSF(A(I2,1)))                          IPM30560
      IF (IA1 - IH) 26, 26, 14                                          IPM30561
 14   IF (IA1 - ICH) 29, 26, 26                                         IPM30562
 26   DO 28 J = 3,N1                                                    IPM30563
      IF(A(I2,J))    27, 28, 27                                         IPM30564
 27   A1 = ABSF(A(I2,J)) - INTF(ABSF(A(I2,J)))                          IPM30565
      IF (IA1 - IH) 28, 28, 24                                          IPM30566
 24   IF (IA1 - ICH) 30, 28, 28                                         IPM30567
 28   CONTINUE                                                          IPM30568
 29   CONTINUE                                                          IPM30569
      GO TO 44                                                          IPM30570
 30   K2 = 1                                                            IPM30571
 31   CALL RMRO (I1, I2, K2)                                            IPM30572
      CALL NRM (I2, I1)                                                 IPM30573
      IF (COLS(I1,J1)) 40, 47, 40                                       IPM30574
 40   IF (PIV(I1,J1)) 45, 41, 45                                        IPM30575
 41   CALL OFLO (I1,J1)                                                 IPM30576
      GO TO (42, 43),K2                                                 IPM30577
 42   K2 = 2                                                            IPM30578
      GO TO 31                                                          IPM30579
 43   GO TO (22, 29),K1                                                 IPM30580
   44 RPIV = 0.                                                         IPM30581
      GO TO 46                                                          IPM30582
   47 RPIV = 1.                                                         IPM30583
      GO TO 46                                                          IPM30584
   45 RPIV = -1.                                                        IPM30585
 46   RETURN                                                            IPM30586
      END                                                               IPM30587
*     LABEL                                                             IPM30588
*     LIST8                                                             IPM30589
      SUBROUTINE TWR(I1,KN)                                             IPM30590
C     7090 SHARE                                                        IPM30591
C                                                                       IPM30592
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IPM30593
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IPM30594
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IPM30595
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IPM30596
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IPM30597
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IPM30598
     1(A1,IA1)                                                          IPM30599
C                                                                       IPM30600
      EQUIVALENCE (B1,IB1),(B2,IB2),(B3,IB3),(FMT,IMT),(AML,IAML)       IPM30601
      DIMENSION FMT(15),IMT(15)                                         IPM30602
      IF(IPCT)  20, 20, 2                                               IPM30603
 20   IF (KR-8) 5, 5, 4                                                 IPM30604
 4    IML = 8                                                           IPM30605
      GO TO 2                                                           IPM30606
 5    IML = KR                                                          IPM30607
 2    IPCT = IPCT + 1                                                   IPM30608
      GO TO (14,12),NSW2                                                IPM30609
   14 WRITE OUTPUT TAPE NDR,8,IPCT,KN,I1,D,(A(I,1),I=1,IML)             IPM30610
 8    FORMAT(I5,11HTH PIV. L =I4,6H, LT =I4,5H, D =F10.0,5H, Z =8(F9.2))IPM30611
   12 GO TO (21,22),NSW1                                                IPM30612
   21 CALL MOUT                                                         IPM30613
   22 RETURN                                                            IPM30614
      END                                                               IPM30615
*     LABEL                                                             IPM30616
*     LIST8                                                             IPM30617
      SUBROUTINE MOUT                                                   IPM30618
C     EDITS AND WRITES MATRIX/7090 SHARE                                IPM30619
C                                                                       IPM30620
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IPM30621
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IPM30622
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IPM30623
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IPM30624
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IPM30625
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IPM30626
     1(A1,IA1)                                                          IPM30627
C                                                                       IPM30628
      IF (M1-43) 3, 3, 16                                               IPM30629
 3    IF (N3-10) 1, 1, 16                                               IPM30630
   16 WRITE OUTPUT TAPE NDR,11                                          IPM30631
 1    LB = 0                                                            IPM30632
      LO = -9                                                           IPM30633
      MX = 0                                                            IPM30634
 2    K = 0                                                             IPM30635
      LB = LB + 1                                                       IPM30636
      LO = LO + 10                                                      IPM30637
      MX = MX + 10                                                      IPM30638
      IF (N3 - MX) 10, 4, 4                                             IPM30639
 10   MX = N3                                                           IPM30640
 4    LL = - 49                                                         IPM30641
      LU = 0                                                            IPM30642
 5    K = K + 1                                                         IPM30643
      LL = LL + 50                                                      IPM30644
      LU = LU + 50                                                      IPM30645
      IF (M1 - LU) 12, 6, 6                                             IPM30646
 12   LU = M1                                                           IPM30647
    6 WRITE OUTPUT TAPE NDR,7,K,LB,M1,N3,D,KR,IPRC,ALPHA                IPM30648
    7 FORMAT(8H0SBMTRX(I2,1H,I2,4H) OFI4,1HXI3,11H MTRX.  D =F8.0,1H,I3,IPM30649
     15H C.V.5X,10HPROBLEM NOI4,3X,3A6)                                 IPM30650
      CALL MMT1                                                         IPM30651
      WRITE OUTPUT TAPE NDR,8                                           IPM30652
 8    FORMAT(1H )                                                       IPM30653
      DO 9 I = LL,LU                                                    IPM30654
 9    CALL MMT2(I)                                                      IPM30655
      WRITE OUTPUT TAPE NDR,11                                          IPM30656
 11   FORMAT(1H1)                                                       IPM30657
      IF(M1-LU) 13, 13, 5                                               IPM30658
 13   IF (N3 - MX) 15, 15, 2                                            IPM30659
 15   RETURN                                                            IPM30660
      END                                                               IPM30661
*     LABEL                                                             IPM30662
*     LIST8                                                             IPM30663
      SUBROUTINE MMT1                                                   IPM30664
C     7090 SHARE                                                        IPM30665
C                                                                       IPM30666
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IPM30667
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IPM30668
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IPM30669
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IPM30670
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IPM30671
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IPM30672
     1(A1,IA1)                                                          IPM30673
C                                                                       IPM30674
      DIMENSION FMT(13)                                                 IPM30675
      EQUIVALENCE (IG,BBIG)                                             IPM30676
B     FMT(1)=741167606060                                               IPM30677
      K=0                                                               IPM30678
      IV = LO                                                           IPM30679
      IF (LO-1) 3, 3, 4                                                 IPM30680
B   3 FMT(2)=606073010130                                               IPM30681
B     FMT(3)=602346456263                                               IPM30682
B     FMT(4)=214563606060                                               IPM30683
      K = 3                                                             IPM30684
      IV = 2                                                            IPM30685
 4    IF(N1-MX) 6, 5, 5                                                 IPM30686
 5    IUP = MX                                                          IPM30687
      ASSIGN 12 TO JUMP                                                 IPM30688
      GO TO 7                                                           IPM30689
 6    ASSIGN 11 TO JUMP                                                 IPM30690
      IUP = N1                                                          IPM30691
 7    IG = IUP - IV + 1                                                 IPM30692
      IF (IG) 14, 11, 14                                                IPM30693
 14   IF (IG-10) 8, 9, 9                                                IPM30694
B   8 FMT(K+2)=730000743107+(000017000000*BBIG)                         IPM30695
      GO TO 10                                                          IPM30696
B   9 FMT(K+2)=730100743107                                             IPM30697
B  10 FMT(K+3)=730467346060                                             IPM30698
      K = K + 2                                                         IPM30699
      GO TO JUMP,(11,12)                                                IPM30700
B  11 FMT(K+2)=606073010130                                             IPM30701
B     FMT(K+3)=602346252660                                             IPM30702
B     FMT(K+4)=626444606060                                             IPM30703
      K = K + 3                                                         IPM30704
B  12 FMT(K+2)=346060606060                                             IPM30705
      WRITE OUTPUT TAPE NDR,FMT,(LT(J),J=IV,IUP)                        IPM30706
      RETURN                                                            IPM30707
      END                                                               IPM30708
*     LIST8                                                             IPM30709
*     LABEL                                                             IPM30710
      SUBROUTINE MMT2(I1)                                               IPM30711
C     7090 SHARE                                                        IPM30712
C                                                                       IPM30713
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IPM30714
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IPM30715
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IPM30716
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IPM30717
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IPM30718
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IPM30719
     1(A1,IA1)                                                          IPM30720
C                                                                       IPM30721
      DIMENSION FMT(22),OUT(10)                                         IPM30722
B     FMT(1)=743111606060                                               IPM30723
      K1=1                                                              IPM30724
      K2=0                                                              IPM30725
      DO 10 J=LO,MX                                                     IPM30726
      A1=ABSF(A(I1,J))                                                  IPM30727
      IF (A1)4,5,4                                                      IPM30728
    4 A1=A1-INTF(A1)                                                    IPM30729
      IF (IA1-IH) 7, 7, 3                                               IPM30730
 3    IF (ICH-IA1) 7, 7, 6                                              IPM30731
B   5 FMT(K1+1)=730101676060                                            IPM30732
      GO TO 9                                                           IPM30733
B   6 FMT(K1+1)=732601013303                                            IPM30734
      GO TO 8                                                           IPM30735
    7 K1=K1+1                                                           IPM30736
B     FMT(K1)=732610330073                                              IPM30737
B     FMT(K1+1)=036760606060                                            IPM30738
    8 K2=K2+1                                                           IPM30739
      OUT (K2)=A(I1,J)                                                  IPM30740
    9 K1=K1+1                                                           IPM30741
   10 CONTINUE                                                          IPM30742
B     FMT(K1+1)=346060606060                                            IPM30743
      IF (K2) 11, 11, 13                                                IPM30744
   11 WRITE OUTPUT TAPE NDR,12,I1                                       IPM30745
 12   FORMAT(I9)                                                        IPM30746
      GO TO 14                                                          IPM30747
   13 WRITE OUTPUT TAPE NDR,FMT,I1,(OUT(J),J=1,K2)                      IPM30748
 14   RETURN                                                            IPM30749
      END                                                               IPM30750
*     LABEL                                                             IPM30751
*     LIST8                                                             IPM30752
      SUBROUTINE NRM (I1,I2)                                            IPM30753
C     DESCRIBES NEW ROW I2 FROM ROW I1/7090 SHARE                       IPM30754
C                                                                       IPM30755
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IPM30756
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IPM30757
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IPM30758
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IPM30759
     1IM(25),BIM(25),I-MV(25),RMV(25),ALPHA(3)                          IPM30760
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IPM30761
     1(A1,IA1)                                                          IPM30762
C                                                                       IPM30763
      IVCT = IVCT + 1                                                   IPM30764
      L(I2) =-IVCT                                                      IPM30765
      GO TO (1,6),NSW4                                                  IPM30766
    1 WRITE OUTPUT TAPE NDR,2,I2,I1,IVCT                                IPM30767
 2    FORMAT(8H0NEW ROWI4,13H GEND FRM ROWI4,1H,I4,12HTH ART VRBL.)     IPM30768
    3 WRITE OUTPUT TAPE NDR,4,(LT(J),J=1,NS)                            IPM30769
 4    FORMAT(9H COLUMN  10I11/(9H         10I11))                       IPM30770
      WRITE OUTPUT TAPE NDR,5,(A(I2,J),J=1,NS)                          IPM30771
 5    FORMAT(9H0ELEMNTS 10F11.3/(9H         10F11.3))                   IPM30772
 6    RETURN                                                            IPM30773
      END                                                               IPM30774
