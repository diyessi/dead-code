CWHVISVREM 0015 02131                                                   VISV0001
C     VISCOSITY OF STEAM     NOT NOW ON LIBRARY                         VISV0002
      FUNCTION VISV(P,TEMP)                                             VISV0003
      T = TEMP                                                          VISV0004
      CALL HSV(P,TV,S,V)                                                VISV0005
      IF(T-TV) 5,7,7                                                    VISV0006
5     CALL ERROR(17HT BELOW SAT. TEMP)                                  VISV0007
      VISV = 0.                                                         VISV0008
      GO TO 8                                                           VISV0009
7     CALL HSS(P,T,S,V)                                                 VISV0010
      VISV =(.5344101E-5+T*(.15306041E-7+T*(-.56724902E-11+T*(.57559264EVISV0011
     1-14-T*.17050693E-17))))+2.84017559E-9*EXPF(-LOGF(.06242770496*V)*1VISV0012
     2.46255)                                                           VISV0013
8     RETURN                                                            VISV0014
      END(0,1,0,0,0)                                                    VISV0015
