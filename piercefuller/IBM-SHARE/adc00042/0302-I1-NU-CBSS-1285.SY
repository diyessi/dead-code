       REM     THE FOLLOWING THREE INSTRUCTIONS ARE READ INTO 0,1,2     CBSS 005
       FUL                                                              CBSS 006
       ORG     32440                                                    CBSS 007
       IOCD    TSTART,0,-TSTART   BOOTSTRAP                             CBSS 008
       TCOA    1                                                        CBSS 009
       TTR     TSTART                                                   CBSS 010
*                                                                       CBSS 011
TSTART AXT     TSTART,1           ZERO GARBBAGE                         CBSS 012
       STZ     TSTART+3,1         LEFT BY LAST PROGRAM.                 CBSS 013
       TXL     LSTART,1,4                                               CBSS 014
       TXI     *-2,1,-1                                                 CBSS 015
LSTART CLA     2                  PUT TTR IN MANUAL RESTART LOC.        CBSS 016
       STO     95                                                       CBSS 017
       LTM                        INITIALIZE THE MACHINE.               CBSS 018
       SLF                                                              CBSS 019
       LAXM                                                             CBSS 020
