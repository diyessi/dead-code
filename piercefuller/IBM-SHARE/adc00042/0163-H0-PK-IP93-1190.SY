CIP93  INTEGER PROGRAMMING CODE 3, 7090 NON-MONITOR, MAIN PROGRAM       IP930001
C     R. E. LEVITAN -- INTEGER PROGRAMMING                              IP930002
C                                                                       IP930003
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP930004
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP930005
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IP930006
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP930007
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP930008
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP930009
     1(A1,IA1)                                                          IP930010
C                                                                       IP930011
      IDR=5                                                             IP930012
      NDR=6                                                             IP930013
      REWIND IDR                                                        IP930014
      REWIND NDR                                                        IP930015
      IF (SENSE SWITCH 3) 42,43                                         IP930016
   42 READ 4,NSW1,NSW2,NSW4,NSW5,NSWS                                   IP930017
      GO TO 45                                                          IP930018
   43 READ INPUT TAPE IDR,4,NSW1,NSW2,NSW4,NSW5,NSWS                    IP930019
    4 FORMAT (5I6)                                                      IP930020
   45 ASSIGN 1 TO JUMP                                                  IP930021
      IPRC = 0                                                          IP930022
 1    CALL SET 1                                                        IP930023
      IPRC = IPRC + 1                                                   IP930024
      WRITE OUTPUT TAPE NDR,2,IPRC,ALPHA                                IP930025
 2    FORMAT(14H1START PROBLEMI4,3H.  3A6)                              IP930026
      PRINT 50,IPRC,ALPHA                                               IP930027
   50 FORMAT (14H0START PROBLEMI4,3H.  3A6)                             IP930028
      SENSE LIGHT 1                                                     IP930029
      IPCT = 0                                                          IP930030
      IVCT = 0                                                          IP930031
      IOCT = 0                                                          IP930032
      MS = 1                                                            IP930033
      CH = .5                                                           IP930034
      H = .5                                                            IP930035
      CALL SET2                                                         IP930036
      N3 = N                                                            IP930037
      CALL MOUT                                                         IP930038
      N3 = N + 1                                                        IP930039
      IF (SET3(V)) 1, 32, 1                                             IP930040
   32 GO TO (23,3),NSW1                                                 IP930041
 23   CALL MOUT                                                         IP930042
 3    IF (ROWS(KL,I1)) 24, 17, 17                                       IP930043
 24   IF (M2-I1) 7, 7, 8                                                IP930044
 7    MS = MSI                                                          IP930045
 8    IF (COLS(I1,J1)) 11, 9, 9                                         IP930046
    9 WRITE OUTPUT TAPE NDR,10                                          IP930047
      PRINT 10                                                          IP930048
 10   FORMAT(21H0PROBLEM HAS NO SOLN.)                                  IP930049
      GO TO 30                                                          IP930050
 11   CALL RCT (I1,J1)                                                  IP930051
      IF (PIV(I1,J1)) 12, 14, 14                                        IP930052
 12   CALL TWR (I1,J1)                                                  IP930053
      CALL RGEN                                                         IP930054
      IF (SENSE SWITCH 1)44,41                                          IP930055
   44 GO TO (40,41),NSWS                                                IP930056
   40 ASSIGN 22 TO JUMP                                                 IP930057
      CALL BRK(1)                                                       IP930058
   41 IF (IPCT-LIM)27,5,27                                              IP930059
   27 IF (SENSE SWITCH 5)13,3                                           IP930060
   13 GO TO (5,3),NSW5                                                  IP930061
    5 CALL BRK(2)                                                       IP930062
      GO TO JUMP,(1, 22)                                                IP930063
 14   IF (RPIV(I1,J1)) 12, 15, 9                                        IP930064
   15 WRITE OUTPUT TAPE NDR,16                                          IP930065
      PRINT 16                                                          IP930066
 16   FORMAT(21H0UNCORRECTABLE OFLOW.)                                  IP930067
   30 GO TO (31,28),NSW1                                                IP930068
 28   CALL MOUT                                                         IP930069
   31 WRITE OUTPUT TAPE NDR,29,IPCT,IPRC,ALPHA                          IP930070
      PRINT 29,IPCT,IPRC,ALPHA                                          IP930071
 29   FORMAT(28H0DISCONTINUED CALCULATION ONI6,16HTH PIVOT PROBLEMI4,3H.IP930072
     1  3A6)                                                            IP930073
      GO TO 21                                                          IP930074
   17 GO TO (19,18),NSW1                                                IP930075
 18   CALL MOUT                                                         IP930076
   19 WRITE OUTPUT TAPE NDR,20,IPCT,IPRC,ALPHA,IVCT,IOCT                IP930077
      PRINT 20,IPCT, IPRC, ALPHA,IVCT,IOCT                              IP930078
   20 FORMAT(17H0SOLN. REACHED ONI6,19HTH PIVOT.   PROBLEMI4,3H.  3A6/I6IP930079
     1,15H NEW VARBLS ANDI6,8H OFLOWS.)                                 IP930080
 21   GO TO JUMP,(1, 22)                                                IP930081
   22 CALL EXIT                                                         IP930082
      END (0,1,0,0,0)                                                   IP930083
      SUBROUTINE BRK(LOC)                                               IP930084
C     7090 SHARE                                                        IP930085
C                                                                       IP930086
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP930087
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP930088
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IP930089
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP930090
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP930091
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP930092
     1(A1,IA1)                                                          IP930093
C                                                                       IP930094
      GO TO (2,4),NSW1                                                  IP930095
    4 CALL MOUT                                                         IP930096
    2 WRITE OUTPUT TAPE NDR,3,IPRC,ALPHA,IPCT,IVCT,IOCT                 IP930097
      PRINT 3,IPRC,ALPHA,IPCT,IVCT,IOCT                                 IP930098
    3 FORMAT(15H BRKPT, PROBLEMI4,2H  3A6,4H -- I4,8H PIVOTS,I4,12H NEW IP930099
     1VARBLS,I4,8H OFLOWS.)                                             IP930100
      GO TO (1,5),LOC                                                   IP930101
    1 CALL SAVE                                                         IP930102
      REWIND NDR                                                        IP930103
      WRITE OUTPUT TAPE NDR,7,IPRC,ALPHA,IPCT,IVCT,IOCT                 IP930104
      PRINT 7,IPRC,ALPHA,IPCT,IVCT,IOCT                                 IP930105
    7 FORMAT (16H1RESTART PROBLEMI4,2X,3A6,4H -- I4,8H PIVOTS,I4,12H NEWIP930106
     1VARBLS,I4,8H OFLOWS.)                                             IP930107
    5 RETURN                                                            IP930108
      END (0,1,0,0,0)                                                   IP930109
      SUBROUTINE SET1                                                   IP930110
C     READS MATRIX INTO STORAGE AND SETS UP UNIT MATRIX/7090 SHARE      IP930111
C                                                                       IP930112
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP930113
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP930114
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IP930115
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP930116
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP930117
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP930118
     1(A1,IA1)                                                          IP930119
C                                                                       IP930120
      IF (SENSE SWITCH 3)1,2                                            IP930121
 1    READ 3, M, N, KR, MSI, LIM, UB, ALPHA                             IP930122
      IF (M)998,999,16                                                  IP930123
  999 WRITE OUTPUT TAPE NDR,7                                           IP930124
      PRINT 7                                                           IP930125
 7    FORMAT(33H0LAST PROBLEM HAS BEEN PROCESSED.//)                    IP930126
      CALL EXIT                                                         IP930127
 16   N1 = N                                                            IP930128
      M1=M+N-1                                                          IP930129
      DO 20 J = 1,N                                                     IP930130
      DO 20 I=1,M1                                                      IP930131
 20   A(I,J) = 0.                                                       IP930132
      IF (SENSE SWITCH 3)4,9                                            IP930133
    8 A(I,J)  =AA                                                       IP930134
    4 READ 5,I,J,AA                                                     IP930135
      IF (J) 998,6,8                                                    IP930136
    2 READ INPUT TAPE IDR,3,M,N,KR,MSI,LIM,UB,ALPHA                     IP930137
      IF (M)998,999,16                                                  IP930138
 11   A(I,J) = AA                                                       IP930139
    9 READ INPUT TAPE IDR,5,I,J,AA                                      IP930140
      IF (J) 998,6,11                                                   IP930141
    6 D=1.0                                                             IP930142
      IF (KR)998,12,13                                                  IP930143
  998 WRITE OUTPUT TAPE NDR,997,M,N,KR,MSI,LIM,UB,ALPHA,I,J,AA          IP930144
      CALL EXIT                                                         IP930145
   12 KR=1                                                              IP930146
   13 IF (MSI)998,14,15                                                 IP930147
   14 MSI=1                                                             IP930148
 15   RETURN                                                            IP930149
 3    FORMAT(5I6,F6.0,3A6)                                              IP930150
    5 FORMAT (2I5,F10.5)                                                IP930151
  997 FORMAT (36H0DATA ERROR. LAST CONTROL CARD READS//5I6,F6.0,3A6/33H0IP930152
     1LAST ELEMENT CARD, IF ANY, READS//2I5,F10.5)                      IP930153
      END (0,1,0,0,0)                                                   IP930154
      SUBROUTINE SET2                                                   IP930155
C     SETS UP UNIT MATRIX AND INDICES/7090 SHARE                        IP930156
C                                                                       IP930157
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP930158
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP930159
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP930160
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP930161
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP930162
     1(A1,IA1)                                                          IP930163
C                                                                       IP930164
 231  M1 = M + N   - 1                                                  IP930165
      M2=M+1                                                            IP930166
      DO8I=M2,M1                                                        IP930167
      DO 7 J = 1,N                                                      IP930168
 7    A(I,J) = 0                                                        IP930169
 8    CONTINUE                                                          IP930170
      DO 5 J = 2,N                                                      IP930171
      I = M2 + J - 2                                                    IP930172
      LT(J) = I                                                         IP930173
 5    A(I,J) = -D                                                       IP930174
      LT = 0                                                            IP930175
      LT(N+1) = 0                                                       IP930176
      DO9I=1,M1                                                         IP930177
 9    L(I)=I                                                            IP930178
      M3 = M1 + 1                                                       IP930179
      KL = KR + 1                                                       IP930180
      M2 = M1                                                           IP930181
      RETURN                                                            IP930182
      END (0,1,0,0,0)                                                   IP930183
      FUNCTION SET3 (X)                                                 IP930184
C     GETS PROBLEM DUAL FEASIBLE IF NOT SO/7090 SHARE                   IP930185
C                                                                       IP930186
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP930187
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP930188
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IP930189
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP930190
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP930191
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP930192
     1(A1,IA1)                                                          IP930193
C                                                                       IP930194
      V = X                                                             IP930195
      NS = N1 + 1                                                       IP930196
      IK = M1 + 1                                                       IP930197
      J1 = 0                                                            IP930198
      DO 10 J = 2,N                                                     IP930199
      DO 2 I = 1,M1                                                     IP930200
      IF (A(I,J)) 3, 2, 9                                               IP930201
 2    CONTINUE                                                          IP930202
      GO TO 9                                                           IP930203
 3    IF (I-IK) 6, 4, 8                                                 IP930204
 4    DO 5 I1 = IK,M1                                                   IP930205
      IF (IA(I1,J1)-IA(I1,J)) 8, 5, 7                                   IP930206
 5    CONTINUE                                                          IP930207
 6    IK = I                                                            IP930208
 7    J1 = J                                                            IP930209
 8    IA(M1+1,J) = -1                                                   IP930210
      GO TO 10                                                          IP930211
 9    IA(M1+1,J) = 0                                                    IP930212
 10   CONTINUE                                                          IP930213
      IF (J1) 11, 16, 11                                                IP930214
 11   IF (UB) 19, 19, 21                                                IP930215
   19 WRITE OUTPUT TAPE NDR,20,IPRC,ALPHA                               IP930216
 20   FORMAT(12H0PROBLEM NO.I3,3A6,19H  NEEDS UPPER BOUND)              IP930217
      SET3 = -1.                                                        IP930218
      GO TO 22                                                          IP930219
 21   LT(J1) = -1                                                       IP930220
      IVCT = 1                                                          IP930221
      DO 12 I = IK,M1                                                   IP930222
      A(I,J1) = -A(I,J1)                                                IP930223
 12   A(I,1) = A(I,J1)*UB + A(I,1)                                      IP930224
      IA(M1+1,J1) = 0                                                   IP930225
      DO 15 J = 2,N                                                     IP930226
      IF (IA(M1+1,J)) 13, 15, 13                                        IP930227
 13   DO 14 I = IK,M1                                                   IP930228
 14   A(I,J) = A(I,J) + A(I,J1)                                         IP930229
 15   CONTINUE                                                          IP930230
 16   DO 18 I = 1,M1                                                    IP930231
      A(I,NS) = 1.                                                      IP930232
      DO 17 J = 3,N1                                                    IP930233
 17   A(I,NS) = A(I,NS) + A(I,J)                                        IP930234
 18   CONTINUE                                                          IP930235
      SET3 = 0.                                                         IP930236
 22   RETURN                                                            IP930237
      END (0,1,0,0,0)                                                   IP930238
      FUNCTION ROWS (KU,I1)                                             IP930239
C     SELECTS PIVOT ROW BY RATIO TO SUM METHOD/7090 SHARE               IP930240
C                                                                       IP930241
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP930242
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP930243
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IP930244
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP930245
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP930246
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP930247
     1(A1,IA1)                                                          IP930248
C                                                                       IP930249
      EQUIVALENCE (IRO,ROWS),(Q,IQ),(QP,IQP)                            IP930250
      K2 = 1                                                            IP930251
      DO 24 I = KU,M1                                                   IP930252
 3    A1 = A(I,1)                                                       IP930253
      IF (A1) 10, 24, 24                                                IP930254
 10   SU = A(I,NS) - 1.                                                 IP930255
      IF (SU) 11, 15, 19                                                IP930256
 11   GO TO (13, 12, 24, 24), K2                                        IP930257
 12   QP = SU/A1                                                        IP930258
      GO TO 22                                                          IP930259
 13   K2 = 2                                                            IP930260
      Q = SU/A1                                                         IP930261
      GO TO 23                                                          IP930262
 15   GO TO (17, 17, 16, 24), K2                                        IP930263
 16   QP = A1                                                           IP930264
      GO TO 22                                                          IP930265
 17   K2 = 3                                                            IP930266
      Q = A1                                                            IP930267
      GO TO 23                                                          IP930268
 19   GO TO (21, 21, 21, 20), K2                                        IP930269
 20   QP = SU*A1                                                        IP930270
 22   IF (IQ - IQP) 24, 24, 28                                          IP930271
 21   K2 = 4                                                            IP930272
      Q = SU*A1                                                         IP930273
      GO TO 23                                                          IP930274
 28   Q = QP                                                            IP930275
 23   I1 = I                                                            IP930276
 24   CONTINUE                                                          IP930277
      IRO = 1 - K2                                                      IP930278
      RETURN                                                            IP930279
      END (0,1,0,0,0)                                                   IP930280
      FUNCTION COLS (I1,J1)                                             IP930281
C     SELECTS PIVOT ELEMENT/7090 SHARE                                  IP930282
C                                                                       IP930283
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP930284
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP930285
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IP930286
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP930287
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP930288
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP930289
     1(A1,IA1)                                                          IP930290
C                                                                       IP930291
      EQUIVALENCE (IR,R),(RP,IRP)                                       IP930292
      I3 = 0                                                            IP930293
      J1 = 0                                                            IP930294
      DO 15 J = 2,N                                                     IP930295
      IF (A(I1,J)) 2, 15, 15                                            IP930296
 2    DO 3 I2 = 1,I1                                                    IP930297
      IF (A(I2,J)) 24, 3, 4                                             IP930298
   24 WRITE OUTPUT TAPE NDR,998,J,I2,I1                                 IP930299
      CALL MOUT                                                         IP930300
      CALL EXIT                                                         IP930301
 3    CONTINUE                                                          IP930302
 4    IF (J1) 999, 14, 5                                                IP930303
 5    IF (I2 - I3) 15, 6, 14                                            IP930304
 6    R = INTF(A(I1,J)*D - .5)/INTF(A(I1,J1)*D - .5)                    IP930305
      DO 13 I = I3,M1                                                   IP930306
      IF (A(I,J1)) 9, 8, 10                                             IP930307
 8    IF (A(I,J)) 14, 13, 15                                            IP930308
 9    IF (A(I,J)) 11, 15, 15                                            IP930309
 10   IF (A(I,J)) 14, 14, 12                                            IP930310
 11   RP = INTF(A(I,J)*D - .5)/INTF(A(I,J1)*D - .5)                     IP930311
      IF (IR - IRP) 14, 13, 15                                          IP930312
 12   RP = INTF(A(I,J)*D + .5)/INTF(A(I,J1)*D + .5)                     IP930313
      IF (IR - IRP) 15, 13, 14                                          IP930314
 13   CONTINUE                                                          IP930315
 14   J1 = J                                                            IP930316
      I3 = I2                                                           IP930317
 15   CONTINUE                                                          IP930318
      IF (J1) 999, 999, 16                                              IP930319
 16   COLS = -1.                                                        IP930320
 18   RETURN                                                            IP930321
 999  COLS = 0.                                                         IP930322
      GO TO 18                                                          IP930323
  998 FORMAT (35H0LEADING NON-ZERO ELEMENT IN COLUMNI4,8H, IN ROWI4,30H,IP930324
     1 IS NEGATIVE. PIVOT ROW I1 ISI4)                                  IP930325
      END (0,1,0,0,0)                                                   IP930326
      SUBROUTINE RGEN                                                   IP930327
C     MAINTAINS APPENDIX OF FRACTIONAL ROWS/7090 SHARE                  IP930328
C                                                                       IP930329
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP930330
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP930331
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IP930332
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP930333
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP930334
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP930335
     1(A1,IA1)                                                          IP930336
C                                                                       IP930337
      EQUIVALENCE (IRM,RM),(IP5,P5)                                     IP930338
C                                                                       IP930339
      P5 = .5                                                           IP930340
      IC=0                                                              IP930341
      K=0                                                               IP930342
      IF (M1-M3)9,8,8                                                   IP930343
    8 DO 7 I=M3,M1                                                      IP930344
      A1=A(I,1)                                                         IP930345
      IF (A1) 4, 6, 6                                                   IP930346
    4 IF (IA1+ICH)7,7,5                                                 IP930347
    5 RM=INTF(.5-A1*D)                                                  IP930348
      IF (IC)73,73,71                                                   IP930349
   71 DO 72 J=1,IC                                                      IP930350
      IF (IRMV(J)-IRM)72,7,72                                           IP930351
   72 CONTINUE                                                          IP930352
   73 IC=IC+1                                                           IP930353
      IRMV(IC)=IRM                                                      IP930354
      GO TO 7                                                           IP930355
    6 K=K+1                                                             IP930356
      IT(K)=I                                                           IP930357
    7 CONTINUE                                                          IP930358
    9 NO=MS+M2-M1+K                                                     IP930359
      IF (NO-K)10,10,11                                                 IP930360
 10   IF (NO) 50, 50, 2                                                 IP930361
   11 K3=M1-K                                                           IP930362
      K=K+1                                                             IP930363
      DO 12 J=K,NO                                                      IP930364
   12 IT(J)=K3+J                                                        IP930365
 2    K5 = 0                                                            IP930366
      ICP = IC                                                          IP930367
      ICPP = IC + 1                                                     IP930368
      DO 32 I = 1,M2                                                    IP930369
      A1 = A(I,1)                                                       IP930370
      IF (A1) 23, 32, 23                                                IP930371
   23 RM=A1-INTF(A1)                                                    IP930372
      IF (RM) 15, 32, 16                                                IP930373
   15 RM=RM+1.                                                          IP930374
 16   IF (IRM-IH) 32, 32, 17                                            IP930375
 17   IF (ICH - IRM) 32, 32, 18                                         IP930376
 18   IK = I                                                            IP930377
      IF (IRM-IP5)19,20,20                                              IP930378
   19 RM=1.-RM                                                          IP930379
      IK = -I                                                           IP930380
   20 RM=INTF(RM*D+.5)                                                  IP930381
      IF (IC)30,30,21                                                   IP930382
   21 DO 29 J=1,IC                                                      IP930383
      IF (IRMV(J)-IRM)29,32,29                                          IP930384
   29 CONTINUE                                                          IP930385
 30   IF (K5) 43, 43, 35                                                IP930386
 35   DO 36 J = ICPP,ICP                                                IP930387
      IF (IRM-IRMV(J)) 36, 32, 37                                       IP930388
 36   CONTINUE                                                          IP930389
      IF (NO-K5) 32, 32, 43                                             IP930390
 37   IF (NO-K5) 39, 39, 38                                             IP930391
 38   K5 = K5 + 1                                                       IP930392
      ICP = ICP + 1                                                     IP930393
 39   J1 = ICP - J                                                      IP930394
      IF (J1) 44, 44, 40                                                IP930395
 40   K3 = ICP + 1                                                      IP930396
      DO 42 J2 = 1,J1                                                   IP930397
      J3 = K3 - J2                                                      IP930398
      IRMV(J3) = IRMV(J3-1)                                             IP930399
 42   IM(J3) = IM(J3-1)                                                 IP930400
      GO TO 44                                                          IP930401
 43   ICP = ICP+1                                                       IP930402
      J=ICP                                                             IP930403
      K5 = K5 + 1                                                       IP930404
 44   IRMV(J) = IRM                                                     IP930405
      IM(J) = IK                                                        IP930406
 32   CONTINUE                                                          IP930407
      IF (K5) 50, 50, 45                                                IP930408
 45   K = 0                                                             IP930409
      DO 49 J = ICPP,ICP                                                IP930410
      IK = IM(J)                                                        IP930411
      IF (IK) 46, 46, 47                                                IP930412
 46   K3 = 2                                                            IP930413
      IK = -IK                                                          IP930414
      GO TO 48                                                          IP930415
 47   K3 = 1                                                            IP930416
 48   K = K + 1                                                         IP930417
      I1 = IT(K)                                                        IP930418
      CALL RMRO (I1,IK,K3)                                              IP930419
 49   CALL NRM (IK,I1)                                                  IP930420
      M1 = XMAX0F(M1,I1)                                                IP930421
 50   RETURN                                                            IP930422
      END (0,1,0,0,0)                                                   IP930423
      SUBROUTINE RMRO (I1,I2,I3)                                        IP930424
C     GENERATES ROW OF REMAINDERS/7090 SHARE                            IP930425
C                                                                       IP930426
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP930427
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP930428
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IP930429
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP930430
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP930431
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP930432
     1(A1,IA1)                                                          IP930433
C                                                                       IP930434
      DO 12 J = 1,N1                                                    IP930435
      GO TO (4,5),I3                                                    IP930436
 4    A1 = A(I2,J)                                                      IP930437
      GO TO 6                                                           IP930438
 5    A1 = -A(I2,J)                                                     IP930439
 6    IF(A1) 10,7, 8                                                    IP930440
 8    A(I1,J) = INTF(A1) - A1                                           IP930441
    9 IF (IA(I1,J) + ICH) 7,7,14                                        IP930442
   14 IF (IA(I1,J) + IH) 12,7,7                                         IP930443
 10   A(I1,J) = INTF(A1) - A1 - 1.                                      IP930444
      GO TO 9                                                           IP930445
 7    A(I1,J) = 0.                                                      IP930446
 12   CONTINUE                                                          IP930447
      A(I1,NS) = 1.                                                     IP930448
      DO 13 J = 2,N                                                     IP930449
      IF (IA(I1,J)) 11,13,13                                            IP930450
 11   A(I1,NS) = A(I1,NS) + A(I1,J)                                     IP930451
 13   CONTINUE                                                          IP930452
      RETURN                                                            IP930453
      END (0,1,0,0,0)                                                   IP930454
      SUBROUTINE RCT (I1,J1)                                            IP930455
C     7090 SHARE                                                        IP930456
C                                                                       IP930457
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP930458
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP930459
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IP930460
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP930461
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP930462
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP930463
     1(A1,IA1)                                                          IP930464
C                                                                       IP930465
      A1=A(I1,NS)-1.                                                    IP930466
      IF (A1)1,6,6                                                      IP930467
    1 I2=I1                                                             IP930468
      J2=J1                                                             IP930469
      IF (INRO (I2,J2)) 2,6,2                                           IP930470
 2    IF (A1/A(I1,1) - (A(I2,NS)-1.)/A(I2,1)) 6, 5, 5                   IP930471
    5 I1=I2                                                             IP930472
      J1=J2                                                             IP930473
    6 RETURN                                                            IP930474
      END (0,1,0,0,0)                                                   IP930475
      FUNCTION INRO (I1,J1)                                             IP930476
C     7090 SHARE                                                        IP930477
C                                                                       IP930478
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP930479
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP930480
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IP930481
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP930482
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP930483
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP930484
     1(A1,IA1)                                                          IP930485
C                                                                       IP930486
      EQUIVALENCE (UN,IUN)                                              IP930487
      IF (A(I1,J1)+1.+H)2,2,1                                           IP930488
    1 INRO=0                                                            IP930489
      GO TO 13                                                          IP930490
 2    AN = INTF(.5 - A(I1,J1)*D)                                        IP930491
      UN=1.                                                             IP930492
      S=1.                                                              IP930493
      DO 12 J=1,N1                                                      IP930494
      IF (A(I1,J)) 9, 6, 7                                              IP930495
    6 A(M1+1,J)=0.                                                      IP930496
      GO TO 12                                                          IP930497
 7    A(M1+1,J) = INTF(A(I1,J)*D+.5)/AN                                 IP930498
      IF (IA(M1+1,J)-IUN) 6, 11, 8                                      IP930499
 8    A(M1+1,J) = INTF(A(M1+1,J))                                       IP930500
      GO TO 11                                                          IP930501
    9 A1=INTF(A(I1,J)*D-.5)/AN                                          IP930502
      A(M1+1,J)=INTF(A1)                                                IP930503
      IF (IA(M1+1,J)-IA1)11,11,10                                       IP930504
   10 A(M1+1,J)=A(M1+1,J)-1.                                            IP930505
   11 S=S+A(M1+1,J)                                                     IP930506
   12 CONTINUE                                                          IP930507
      A(M1+1,NS) = S - A(M1+1,1)                                        IP930508
      INRO=-1                                                           IP930509
      I2=M1+1                                                           IP930510
      CALL NRM(I1,I2)                                                   IP930511
      CALL COLS(I2,J1)                                                  IP930512
      I1=I2                                                             IP930513
   13 RETURN                                                            IP930514
      END (0,1,0,0,0)                                                   IP930515
      FUNCTION RPIV (I1,J1)                                             IP930516
C     ATTEMPTS NEXT PIVOT IN CASE OF OFLOW/7090 SHARE                   IP930517
C                                                                       IP930518
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP930519
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP930520
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IP930521
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP930522
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP930523
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP930524
     1(A1,IA1)                                                          IP930525
C                                                                       IP930526
      EQUIVALENCE (AN,IAN)                                              IP930527
 3    CALL OFLO (I1,J1)                                                 IP930528
      IF (INRO (I1,J1)) 4, 15, 15                                       IP930529
 4    IF (PIV(I1,J1)) 45, 3, 3                                          IP930530
 15   IF (M1 - M3) 20, 12, 12                                           IP930531
 12   IF (I2-M3) 13, 20, 20                                             IP930532
 13   IF (I2-M1) 5, 5, 20                                               IP930533
 5    IF (ROWS(M3,I1)) 17, 20, 20                                       IP930534
 17   IF (COLS(I1,J1)) 18, 47, 47                                       IP930535
 18   IF (PIV(I1,J1)) 45, 19,45                                         IP930536
 19   CALL OFLO (I1,J1)                                                 IP930537
 20   K1 = 1                                                            IP930538
      I1 = M1 + 1                                                       IP930539
      DO 22 I2 = 1,M2                                                   IP930540
      IF (A(I2,1)) 21, 22, 21                                           IP930541
 21   A1 = ABSF(A(I2,1)) - INTF(ABSF(A(I2,1)))                          IP930542
      IF (IA1 - IH) 22, 22, 23                                          IP930543
 23   IF (IA1 - ICH) 30, 22, 22                                         IP930544
 22   CONTINUE                                                          IP930545
      K1 = 2                                                            IP930546
      DO 29 I2 = 1,M2                                                   IP930547
      IF (A(I2,1)) 25, 26, 25                                           IP930548
 25   A1 = ABSF(A(I2,1)) - INTF(ABSF(A(I2,1)))                          IP930549
      IF (IA1 - IH) 26, 26, 14                                          IP930550
 14   IF (IA1 - ICH) 29, 26, 26                                         IP930551
 26   DO 28 J = 3,N1                                                    IP930552
      IF(A(I2,J))    27, 28, 27                                         IP930553
 27   A1 = ABSF(A(I2,J)) - INTF(ABSF(A(I2,J)))                          IP930554
      IF (IA1 - IH) 28, 28, 24                                          IP930555
 24   IF (IA1 - ICH) 30, 28, 28                                         IP930556
 28   CONTINUE                                                          IP930557
 29   CONTINUE                                                          IP930558
      GO TO 44                                                          IP930559
 30   K2 = 1                                                            IP930560
 31   CALL RMRO (I1, I2, K2)                                            IP930561
      CALL NRM (I2, I1)                                                 IP930562
      IF (COLS(I1,J1)) 40, 47, 40                                       IP930563
 40   IF (PIV(I1,J1)) 45, 41, 45                                        IP930564
 41   CALL OFLO (I1,J1)                                                 IP930565
      GO TO (42, 43),K2                                                 IP930566
 42   K2 = 2                                                            IP930567
      GO TO 31                                                          IP930568
 43   GO TO (22, 29),K1                                                 IP930569
   44 RPIV = 0.                                                         IP930570
      GO TO 46                                                          IP930571
   47 RPIV = 1.                                                         IP930572
      GO TO 46                                                          IP930573
   45 RPIV = -1.                                                        IP930574
 46   RETURN                                                            IP930575
      END (0,1,0,0,0)                                                   IP930576
      SUBROUTINE TWR(I1,KN)                                             IP930577
C     7090 SHARE                                                        IP930578
C                                                                       IP930579
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP930580
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP930581
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IP930582
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP930583
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP930584
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP930585
     1(A1,IA1)                                                          IP930586
C                                                                       IP930587
      EQUIVALENCE (B1,IB1),(B2,IB2),(B3,IB3),(FMT,IMT),(AML,IAML)       IP930588
      DIMENSION FMT(15),IMT(15)                                         IP930589
      IF(IPCT)  20, 20, 2                                               IP930590
 20   IF (KR-8) 5, 5, 4                                                 IP930591
 4    IML = 8                                                           IP930592
      GO TO 2                                                           IP930593
 5    IML = KR                                                          IP930594
 2    IPCT = IPCT + 1                                                   IP930595
      GO TO (14,12),NSW2                                                IP930596
   14 WRITE OUTPUT TAPE NDR,8,IPCT,KN,I1,D,(A(I,1),I=1,IML)             IP930597
 8    FORMAT(I5,11HTH PIV. L =I4,6H, LT =I4,5H, D =F10.0,5H, Z =8(F9.2))IP930598
   12 GO TO (21,22),NSW1                                                IP930599
   21 CALL MOUT                                                         IP930600
   22 RETURN                                                            IP930601
      END (0,1,0,0,0)                                                   IP930602
      SUBROUTINE MOUT                                                   IP930603
C     EDITS AND WRITES MATRIX/7090 SHARE                                IP930604
C                                                                       IP930605
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP930606
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP930607
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IP930608
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP930609
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP930610
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP930611
     1(A1,IA1)                                                          IP930612
C                                                                       IP930613
      IF (M1-43) 3, 3, 16                                               IP930614
 3    IF (N3-10) 1, 1, 16                                               IP930615
   16 WRITE OUTPUT TAPE NDR,11                                          IP930616
 1    LB = 0                                                            IP930617
      LO = -9                                                           IP930618
      MX = 0                                                            IP930619
 2    K = 0                                                             IP930620
      LB = LB + 1                                                       IP930621
      LO = LO + 10                                                      IP930622
      MX = MX + 10                                                      IP930623
      IF (N3 - MX) 10, 4, 4                                             IP930624
 10   MX = N3                                                           IP930625
 4    LL = - 49                                                         IP930626
      LU = 0                                                            IP930627
 5    K = K + 1                                                         IP930628
      LL = LL + 50                                                      IP930629
      LU = LU + 50                                                      IP930630
      IF (M1 - LU) 12, 6, 6                                             IP930631
 12   LU = M1                                                           IP930632
    6 WRITE OUTPUT TAPE NDR,7,K,LB,M1,N3,D,KR,IPRC,ALPHA                IP930633
    7 FORMAT(8H0SBMTRX(I2,1H,I2,4H) OFI4,1HXI3,11H MTRX.  D =F8.0,1H,I3,IP930634
     15H C.V.5X,10HPROBLEM NOI4,3X,3A6)                                 IP930635
      CALL MMT1                                                         IP930636
      WRITE OUTPUT TAPE NDR,8                                           IP930637
 8    FORMAT(1H )                                                       IP930638
      DO 9 I = LL,LU                                                    IP930639
 9    CALL MMT2(I)                                                      IP930640
      WRITE OUTPUT TAPE NDR,11                                          IP930641
 11   FORMAT(1H1)                                                       IP930642
      IF(M1-LU) 13, 13, 5                                               IP930643
 13   IF (N3 - MX) 15, 15, 2                                            IP930644
 15   RETURN                                                            IP930645
      END (0,1,0,0,0)                                                   IP930646
      SUBROUTINE MMT1                                                   IP930647
C     7090 SHARE                                                        IP930648
C                                                                       IP930649
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP930650
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP930651
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IP930652
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP930653
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP930654
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP930655
     1(A1,IA1)                                                          IP930656
C                                                                       IP930657
      DIMENSION FMT(13)                                                 IP930658
      EQUIVALENCE (IG,BBIG)                                             IP930659
B     FMT(1)=741167606060                                               IP930660
      K=0                                                               IP930661
      IV = LO                                                           IP930662
      IF (LO-1) 3, 3, 4                                                 IP930663
B   3 FMT(2)=606073010130                                               IP930664
B     FMT(3)=602346456263                                               IP930665
B     FMT(4)=214563606060                                               IP930666
      K = 3                                                             IP930667
      IV = 2                                                            IP930668
 4    IF(N1-MX) 6, 5, 5                                                 IP930669
 5    IUP = MX                                                          IP930670
      ASSIGN 12 TO JUMP                                                 IP930671
      GO TO 7                                                           IP930672
 6    ASSIGN 11 TO JUMP                                                 IP930673
      IUP = N1                                                          IP930674
 7    IG = IUP - IV + 1                                                 IP930675
      IF (IG) 14, 11, 14                                                IP930676
 14   IF (IG-10) 8, 9, 9                                                IP930677
B   8 FMT(K+2)=730000743107+(000017000000*BBIG)                         IP930678
      GO TO 10                                                          IP930679
B   9 FMT(K+2)=730100743107                                             IP930680
B  10 FMT(K+3)=730467346060                                             IP930681
      K = K + 2                                                         IP930682
      GO TO JUMP,(11,12)                                                IP930683
B  11 FMT(K+2)=606073010130                                             IP930684
B     FMT(K+3)=602346252660                                             IP930685
B     FMT(K+4)=626444606060                                             IP930686
      K = K + 3                                                         IP930687
B  12 FMT(K+2)=346060606060                                             IP930688
      WRITE OUTPUT TAPE NDR,FMT,(LT(J),J=IV,IUP)                        IP930689
      RETURN                                                            IP930690
      END (0,1,0,0,0)                                                   IP930691
      SUBROUTINE MMT2(I1)                                               IP930692
C     7090 SHARE                                                        IP930693
C                                                                       IP930694
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP930695
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP930696
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IP930697
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP930698
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP930699
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP930700
     1(A1,IA1)                                                          IP930701
C                                                                       IP930702
      DIMENSION FMT(22),OUT(10)                                         IP930703
B     FMT(1)=743111606060                                               IP930704
      K1=1                                                              IP930705
      K2=0                                                              IP930706
      DO 10 J=LO,MX                                                     IP930707
      A1=ABSF(A(I1,J))                                                  IP930708
      IF (A1)4,5,4                                                      IP930709
    4 A1=A1-INTF(A1)                                                    IP930710
      IF (IA1-IH) 7, 7, 3                                               IP930711
 3    IF (ICH-IA1) 7, 7, 6                                              IP930712
B   5 FMT(K1+1)=730101676060                                            IP930713
      GO TO 9                                                           IP930714
B   6 FMT(K1+1)=732601013303                                            IP930715
      GO TO 8                                                           IP930716
    7 K1=K1+1                                                           IP930717
B     FMT(K1)=732610330073                                              IP930718
B     FMT(K1+1)=036760606060                                            IP930719
    8 K2=K2+1                                                           IP930720
      OUT (K2)=A(I1,J)                                                  IP930721
    9 K1=K1+1                                                           IP930722
   10 CONTINUE                                                          IP930723
B     FMT(K1+1)=346060606060                                            IP930724
      IF (K2) 11, 11, 13                                                IP930725
   11 WRITE OUTPUT TAPE NDR,12,I1                                       IP930726
 12   FORMAT(I9)                                                        IP930727
      GO TO 14                                                          IP930728
   13 WRITE OUTPUT TAPE NDR,FMT,I1,(OUT(J),J=1,K2)                      IP930729
 14   RETURN                                                            IP930730
      END (0,1,0,0,0)                                                   IP930731
      SUBROUTINE NRM (I1,I2)                                            IP930732
C     DESCRIBES NEW ROW I2 FROM ROW I1/7090 SHARE                       IP930733
C                                                                       IP930734
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP930735
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP930736
      COMMON IDR,NDR,NSW1,NSW2,NSW3,NSW4,NSW5,NSWS                      IP930737
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP930738
     1IM(25),BIM(25),I-MV(25),RMV(25),ALPHA(3)                          IP930739
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP930740
     1(A1,IA1)                                                          IP930741
C                                                                       IP930742
      IVCT = IVCT + 1                                                   IP930743
      L(I2) =-IVCT                                                      IP930744
