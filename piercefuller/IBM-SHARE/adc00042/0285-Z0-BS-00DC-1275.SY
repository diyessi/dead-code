BS00DC REM 0661 09151                                                   00DC0001
       REM PR  00     CONTROL PROGRAM       F HOOD               9/15/6100DC0002
       REM CONTROL PROGRAM FOR D.C. TRAFFIC ASSIGNMENT SYSTEM           00DC0003
       REM REQUIREMENTS TAPE 1 MUST BE AT LOAD POINT.                   00DC0004
       REM SELF LOADING FROM TAPE 1 CHECK FOR DUMP.                     00DC0005
       REM              THIS IS PART OF FIRST CONTROL PROGRAM.          00DC0006
       REM              SECOND PROGRAM ON TAPE IS SELFLOAD DUMP PROGRAM.00DC0007
       REM              ALL INDEXES ARE SAVED.                          00DC0008
       REM              CONTENTS CELLS 0 THRU 7 ARE DESTROYED.          00DC0009
       REM              CONTENTS OF AC ARE DESTROYED.                   00DC0010
       ORG 0                                                            00DC0011
       CPY 2                      SELF-LOADING CHECK FOR DUMP         0000DC0012
       CPY 3                                                            00DC0013
       PXD 0,4     SAVE ORIGINAL CONTENTS XR4 IN AC.                    00DC0014
       TRA 0                                                            00DC0015
       LXA 1,4                                                          00DC0016
       CPY 7,4     COPY THREE MORE INSTRUCTIONS.                        00DC0017
       TIX 3,4,1                                                        00DC0018
       CPY 7       COPY STORAGE CELL.                                   00DC0019
       ARS 18      ORIGINAL CONTENTS XR4 INTO ADDR OF AC.               00DC0020
       TXI 3,4,6   GO BACK TO COPY 7 MORE INSTRUCTIONS.                 00DC0021
       PXD 0,1     SAVE ORIGINAL CONTENTS XR1 IN AC.                    00DC0022
       LXD 7,1     PUT SIX IN XR1.                                      00DC0023
       SXD 7,4     PUT SEVEN IN DECR STORAGE CELL.                      00DC0024
       CPY 7,4     COPY SEVEN MORE INSTRUCTIONS.                        00DC0025
       TIX 3,4,1                                                        00DC0026
       STA 7       SAVE ORIGINAL CONTENTS XR4 IN ADDR STORAGE CELL.     00DC0027
       TXI 0,4,6   LOAD INDEX 4 WITH SEVEN.                             00DC0028
       CPY 7,4          (0) CELL OF FINAL                               00DC0029
       TXI 2,4,1        (1)      TEST                                   00DC0030
       PZE 120,4,-1024  (2)      LOOP.      SIMULATES SWT 8,4           00DC0031
       CPY 7,4                                                          00DC0032
       TIX 3,4,1                                                        00DC0033
       CPY 4,4     COPY TWO MORE OF TEST LOOP.                          00DC0034
       TXI 5,4,-1                                                       00DC0035
       LXD 7,1          (3) CELL OF FINAL                               00DC0036
       TXL 0,4,6        (4)      TEST LOOP.                             00DC0037
       CPY 4,4                                                          00DC0038
       TXI 0,4,3   LOAD INDEX 4 WITH ONE.                               00DC0039
       TXI 5,1,-1       (6) CELL OF FINAL                               00DC0040
       CPY 6,1          (5)      TEST LOOP.                             00DC0041
       TXL 0,4,6        KILL TIME                                       00DC0042
       LXD 7,1          WITH                                            00DC0043
       PZE 120,4,-1024  THESE               SIMULATES SWT 8,4           00DC0044
       TXI 2,4,1        FOUR COPYS.                                     00DC0045
       RTB 1                                                            00DC0046
       PDX 0,1     RESTORE ORIGINAL XR1.                                00DC0047
       LXA 7,4     RESTORE ORIGINAL XR4.                                00DC0048
       CPY 0       SIX SWITCHES - LOAD DUMP PROGRAM.                    00DC0049
       CPY 1       ANY OTHER COMBINATION SWITCHES,                      00DC0050
       TRA 0       LOAD CONTROL PROGRAM.                                00DC0051
       TRA 0                                           END DUMP CHECK 4000DC0052
