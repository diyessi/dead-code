RSM1AS REM  565 03151                                                   M1AS0001
C    BOS         BOSS.  MAIN ROUTINE                                    M1AS0002
      COMMON M,MA,MB,MC,MD,ME,MF,N,KM,KP,Z,JH,KB,B,P,KL,KN,IK,A,T,X,Y,E M1AS0003
     1     ,DPSTR,JA,JB,JD,IA,IAA,IB                                    M1AS0004
      DIMENSION KM(30),KP(8,2),Z(20),JH(100),KB(300),B(100),P(100),KL(30M1AS0005
     1 0),KN(300),IK(2500),A(2500),T(10),X(100),Y(100),E(100,100)       M1AS0006
     1     ,DPSTR(9500),JA(300),JB(100)                                 M1AS0007
C                             INITIATE PROBLEM                          M1AS0008
   01 KM(4) = 1                                                         M1AS0009
      KM(5) = 2                                                         M1AS0010
      KM(6) = 2                                                         M1AS0011
      KM(8) = 100                                                       M1AS0012
      KM(9) = 1000                                                      M1AS0013
      MC = 2                                                            M1AS0014
      MD = 2                                                            M1AS0015
      MF = 3                                                            M1AS0016
      Z(1) = 0.00001                                                    M1AS0017
      Z(2) = 0.001                                                      M1AS0018
      Z(3) =-0.001                                                      M1AS0019
      KP(2,2) = 1                                                       M1AS0020
      KP(3,2) = 2                                                       M1AS0021
      KP(4,2) = 4                                                       M1AS0022
      KP(5,2) = 4                                                       M1AS0023
      DO 33 I=1,100                                                     M1AS0024
   33 JB(I) = 1                                                         M1AS0025
      ASSIGN 60 TO KCP                                                  M1AS0026
   02 CALL INP(L)                                                       M1AS0027
      IF (L) 01,01,03                                                   M1AS0028
C                             PERFORM ONE ITERATION                     M1AS0029
   03 GO TO KCP, (60,61)                                                M1AS0030
   60 CALL  CYC(K)                                                      M1AS0031
       IF (KM(19)+M-6500)  15,15,05                                     M1AS0032
   15  IF (ME+1-250)  04,04,05                                          M1AS0033
C                                                                       M1AS0034
   05 CALL VER                                                          M1AS0035
   04 CALL INPUT3                                                       M1AS0036
      GO TO (10,20,30,40,50)   ,K                                       M1AS0037
C                             NOTHING NEW                               M1AS0038
   10 KM(24) = KM(24) + 1                                               M1AS0039
       IF ( KM(24) - KM(8) ) 13,14,13                                   M1AS0040
   14 KM(24) = 0                                                        M1AS0041
      CALL VER                                                          M1AS0042
   13 KM(17) = KM(17)-1                                                 M1AS0043
        IF (KM(17)) 11,12,11                                            M1AS0044
   12 KM(17) = KM(7)                                                    M1AS0045
      CALL ERR                                                          M1AS0046
   11 IF ( KM(2) - KM(9) ) 16,02,16                                     M1AS0047
   16 IF (SENSE SWITCH 1) 02,03                                         M1AS0048
C                             END PHASE ONE                             M1AS0049
   20 CALL QOT(2)                                                       M1AS0050
      Z(4) = 0.                                                         M1AS0051
      MD = MD - 1                                                       M1AS0052
      KM(4) = KM(4) -1                                                  M1AS0053
   21 KM(5) = KM(5) -1                                                  M1AS0054
         IF(KM(5)) 62,62,23                                             M1AS0055
   62 ASSIGN 61 TO KCP                                                  M1AS0056
   61 CALL  PATRON(LW)                                                  M1AS0057
      IF (LW) 10,10,63                                                  M1AS0058
   63 PRINT 90, KM(2)                                                   M1AS0059
   22 CALL ERR                                                          M1AS0060
      GO TO 02                                                          M1AS0061
   23 MC = MC - 1                                                       M1AS0062
      Z(10) = - X(MC)                                                   M1AS0063
      GO TO 10                                                          M1AS0064
C           END PH. TWO (30), NO FEAS. SOL. (40), NO PIVOT (50)         M1AS0065
   30 CALL QOT(3)                                                       M1AS0066
      GO TO 21                                                          M1AS0067
   40 IF (Z(4)) 41,42,41                                                M1AS0068
   41 Z(4) = 0.                                                         M1AS0069
      CALL WOT(1,1,1)                                                   M1AS0070
      GO TO 03                                                          M1AS0071
   42 CALL QOT(4)                                                       M1AS0072
      GO TO 22                                                          M1AS0073
   50 IF (Z(4)) 41,52,41                                                M1AS0074
   52 CALL  QOT(5)                                                      M1AS0075
      GO TO 22                                                          M1AS0076
   90 FORMAT(10H0ITERATION I6,24H. ALL SOLUTIONS OBTAINED  )            M1AS0077
       END(0,1,2,0,0)                                                   M1AS0078
                                                                        M1AS0079
C PATRON         ROUTINE FOR FINDING ALL SOLUTIONS                      M1AS0080
      SUBROUTINE PATRON(K)                                              M1AS0081
      COMMON M,MA,MB,MC,MD,ME,MF,N,KM,KP,Z,JH,KB,B,P,KL,KN,IK,A,T,X,Y,E M1AS0082
     1     ,DPSTR,JA,JB,JD,IA,IAA,IB                                    M1AS0083
      DIMENSION KM(30),KP(8,2),Z(20),JH(100),KB(300),B(100),P(100),KL(30M1AS0084
     1 0),KN(300),IK(2500),A(2500),T(10),X(100),Y(100),E(100,100)       M1AS0085
     1     ,DPSTR(9500),JA(300),JB(100)                                 M1AS0086
      IF (KM(29)) 02,02,21                                              M1AS0087
C                                INITIATE PROCEDURE - SET PARAMETERS    M1AS0088
   02 IA = 1                                                            M1AS0089
      IAA = 0                                                           M1AS0090
      IB = 1                                                            M1AS0091
      KM(30)=1                                                          M1AS0092
      KM(29)=1                                                          M1AS0093
      KM(28)=1                                                          M1AS0094
      ID=0                                                              M1AS0095
      DO 01 J=1,N                                                       M1AS0096
      IF(KB(J))01,04,01                                                 M1AS0097
   04 CALL DEL(J,D)                                                     M1AS0098
      IF(ABSF(D)+Z(3)) 05,05,01                                         M1AS0099
   05 ID=ID+1                                                           M1AS0100
      JA(ID)=J                                                          M1AS0101
   01 CONTINUE                                                          M1AS0102
      ME=ID                                                             M1AS0103
C                                TEST FOR AT MOST ONE ALT SOLN - FIND ITM1AS0104
      IF(ME-1) 13,12,03                                                 M1AS0105
   12 JM = JA(1)                                                        M1AS0106
      CALL JMY(JM)                                                      M1AS0107
      CALL ROW(IR)                                                      M1AS0108
      IF (IR) 13,13,14                                                  M1AS0109
   14 Z(9) = Y(IR)                                                      M1AS0110
      CALL PIV(IR)                                                      M1AS0111
      CALL RESET(IR,JM)                                                 M1AS0112
      CALL VERTEX                                                       M1AS0113
   13 K = 1                                                             M1AS0114
      RETURN                                                            M1AS0115
   03 DO 07 J=1,N                                                       M1AS0116
      IF(KB(J)) 07,08,07                                                M1AS0117
   08 CALL DEL(J,D)                                                     M1AS0118
      IF(ABSF(D)+Z(3)) 07,07,09                                         M1AS0119
   09 ID=ID+1                                                           M1AS0120
      JA(ID)=J                                                          M1AS0121
   07 CONTINUE                                                          M1AS0122
      DO 19 I=MF,M                                                      M1AS0123
      JB(I)=1                                                           M1AS0124
   19 CONTINUE                                                          M1AS0125
C                                DIRECTION OF MAIN ROUTINE              M1AS0126
   21 IF(KM(30)-1) 22,23,24                                             M1AS0127
   22 CALL NACC                                                         M1AS0128
      GO TO 27                                                          M1AS0129
   23 CALL ACC                                                          M1AS0130
      GO TO 27                                                          M1AS0131
   24 IF(KM(30)-ME) 25,26,26                                            M1AS0132
   25 CALL OVER (KM(30))                                                M1AS0133
   27 K = 0                                                             M1AS0134
      RETURN                                                            M1AS0135
   26 K = 1                                                             M1AS0136
      RETURN                                                            M1AS0137
       END (0,1,2,0,0)                                                  M1AS0138
                                                                        M1AS0139
C NACC  NON-ACCEPTABLE TABLEAU.  PERFORMS ONE PIVOTAL STEP              M1AS0140
      SUBROUTINE NACC                                                   M1AS0141
      COMMON M,MA,MB,MC,MD,ME,MF,N,KM,KP,Z,JH,KB,B,P,KL,KN,IK,A,T,X,Y,E M1AS0142
     1     ,DPSTR,JA,JB,JD,IA,IAA,IB                                    M1AS0143
      DIMENSION KM(30),KP(8,2),Z(20),JH(100),KB(300),B(100),P(100),KL(30M1AS0144
     1 0),KN(300),IK(2500),A(2500),T(10),X(100),Y(100),E(100,100)       M1AS0145
     1     ,DPSTR(9500),JA(300),JB(100)                                 M1AS0146
C                                                                       M1AS0147
C                                PICK N-B COL AND B ROW                 M1AS0148
      JM = JA(2)                                                        M1AS0149
      CALL JMY(JM)                                                      M1AS0150
      CALL PICK 2 (IR)                                                  M1AS0151
C                                TEST PROPER ROW - PIVOT                M1AS0152
      IF (IR) 01,01,09                                                  M1AS0153
   09 IF (JB(IR)-1) 01,02,01                                            M1AS0154
   02 Z(9) = Y(IR)                                                      M1AS0155
      CALL PIV(IR)                                                      M1AS0156
      CALL RESET (IR,JM)                                                M1AS0157
      CALL IFACC                                                        M1AS0158
      IF (KM(30)) 03,03,04                                              M1AS0159
   03 IF (IB-1) 05,05,06                                                M1AS0160
C                                RELABEL SPECIAL ROWS AND COLS          M1AS0161
   05 JA(2) = JA(1)                                                     M1AS0162
      JA(1) = JD                                                        M1AS0163
      IB = IB+1                                                         M1AS0164
      RETURN                                                            M1AS0165
   06 JB(IR)=2                                                          M1AS0166
      GO TO 05                                                          M1AS0167
C                                HAVE BECOME ACCEPTABLE  KM(30)=1       M1AS0168
   04 CALL VERTEX                                                       M1AS0169
      JA(2) = JA(1)                                                     M1AS0170
      JA(1) = JD                                                        M1AS0171
      GO TO 11                                                          M1AS0172
C                                NO PROPER ROW                          M1AS0173
   01 IF (IB-1) 07,07,08                                                M1AS0174
   07 JC = JA(1)                                                        M1AS0175
      JA(1) = JA(2)                                                     M1AS0176
      JA(2) = JC                                                        M1AS0177
      IB = IB+1                                                         M1AS0178
      RETURN                                                            M1AS0179
C                                SET CONDITION END K=2                  M1AS0180
   08 KM(30)=2                                                          M1AS0181
   11 IB = 1                                                            M1AS0182
      RETURN                                                            M1AS0183
       END (0,1,2,0,0)                                                  M1AS0184
                                                                        M1AS0185
C ACC       ACCEPTABLE TABLEAU.  PERFORMS ONE PIVOTAL STEP.             M1AS0186
      SUBROUTINE ACC                                                    M1AS0187
      COMMON M,MA,MB,MC,MD,ME,MF,N,KM,KP,Z,JH,KB,B,P,KL,KN,IK,A,T,X,Y,E M1AS0188
     1     ,DPSTR,JA,JB,JD,IA,IAA,IB                                    M1AS0189
      DIMENSION KM(30),KP(8,2),Z(20),JH(100),KB(300),B(100),P(100),KL(30M1AS0190
     1 0),KN(300),IK(2500),A(2500),T(10),X(100),Y(100),E(100,100)       M1AS0191
     1     ,DPSTR(9500),JA(300),JB(100)                                 M1AS0192
C                                                                       M1AS0193
C                                PICK N-B COL AND B ROW                 M1AS0194
      JM = JA(2)                                                        M1AS0195
      CALL JMY(JM)                                                      M1AS0196
      CALL PICK 1 (IR)                                                  M1AS0197
C                                TEST PROPER ROW - PIVOT                M1AS0198
      IF (IR) 01,01,15                                                  M1AS0199
   15 IF (JB(IR)-1) 01,02,01                                            M1AS0200
   02 Z(9) = Y(IR)                                                      M1AS0201
      CALL PIV(IR)                                                      M1AS0202
      CALL RESET (IR,JM)                                                M1AS0203
      CALL VERTEX                                                       M1AS0204
      IF (IA-1) 03,03,04                                                M1AS0205
C                                RELABEL SPECIAL ROWS AND COLS          M1AS0206
   03 JC = IR                                                           M1AS0207
   05 JA(2) = JA(1)                                                     M1AS0208
   06 JA(1) = JD                                                        M1AS0209
      IA = IA+1                                                         M1AS0210
      IF (KM(30) - 1) 88,88,18                                          M1AS0211
C                                TEST END K=2 OR RELABEL ROW            M1AS0212
   04 IF (IR - JC) 07,19,07                                             M1AS0213
   19 KM(30) = 2                                                        M1AS0214
      GO TO 05                                                          M1AS0215
   07 JB(IR) = 2                                                        M1AS0216
      GO TO 05                                                          M1AS0217
C                                NO PROPER ROW                          M1AS0218
   01 IAA = IAA+1                                                       M1AS0219
      IF (IAA-1) 09,09,08                                               M1AS0220
   09 IF (IA-1) 11,11,12                                                M1AS0221
C                                PICK N-B COL AND B ROW  IA=1           M1AS0222
   11 JM = JA(1)                                                        M1AS0223
      CALL JMY(JM)                                                      M1AS0224
      CALL PICK 1 (IR)                                                  M1AS0225
      IF (IR) 08,08,16                                                  M1AS0226
   16 IF (JB(IR)-1) 08,14,08                                            M1AS0227
   14 Z(9) = Y(IR)                                                      M1AS0228
      CALL PIV(IR)                                                      M1AS0229
      CALL RESET (IR,JM)                                                M1AS0230
      CALL VERTEX                                                       M1AS0231
      GO TO 06                                                          M1AS0232
C                                PICK N-B COL AND B ROW - UNBOUNDED     M1AS0233
   12 IR = JC                                                           M1AS0234
      IF (ABSF(Y(IR)) - Z(1)) 08,13,13                                  M1AS0235
   13 Z(9) = Y(IR)                                                      M1AS0236
      CALL PIV(IR)                                                      M1AS0237
      CALL RESET (IR,JM)                                                M1AS0238
      GO TO 05                                                          M1AS0239
C                                SET CONDITION END K=2                  M1AS0240
   08 KM(30) = 2                                                        M1AS0241
   18 IAA = 0                                                           M1AS0242
      IA = 1                                                            M1AS0243
   88 RETURN                                                            M1AS0244
       END (0,1,2,0,0)                                                  M1AS0245
                                                                        M1AS0246
C OVER      END CURRENT STAGE K.                                        M1AS0247
      SUBROUTINE OVER (K)                                               M1AS0248
      COMMON M,MA,MB,MC,MD,ME,MF,N,KM,KP,Z,JH,KB,B,P,KL,KN,IK,A,T,X,Y,E M1AS0249
     1     ,DPSTR,JA,JB,JD,IA,IAA,IB                                    M1AS0250
      DIMENSION KM(30),KP(8,2),Z(20),JH(100),KB(300),B(100),P(100),KL(30M1AS0251
     1 0),KN(300),IK(2500),A(2500),T(10),X(100),Y(100),E(100,100)       M1AS0252
     1     ,DPSTR(9500),JA(300),JB(100)                                 M1AS0253
C                                                                       M1AS0254
      JM = JA(K+1)                                                      M1AS0255
      CALL JMY(JM)                                                      M1AS0256
      CALL PICK 3 (IR,K)                                                M1AS0257
      IF (IR) 03,03,04                                                  M1AS0258
   03 KM(30) = K+1                                                      M1AS0259
      RETURN                                                            M1AS0260
C                                                                       M1AS0261
   04 Z(9) = Y(IR)                                                      M1AS0262
      CALL PIV(IR)                                                      M1AS0263
      CALL RESET(IR,JM)                                                 M1AS0264
      CALL ALTER(IR,K)                                                  M1AS0265
      CALL IFACC                                                        M1AS0266
      IF (KM(30)) 05,05,06                                              M1AS0267
   06 CALL VERTEX                                                       M1AS0268
   05 RETURN                                                            M1AS0269
       END (0,1,2,0,0)                                                  M1AS0270
                                                                        M1AS0271
C PICK1     PICK ROW FOR PIVOTING WHEN ACCEPTABLE TABLEAU               M1AS0272
      SUBROUTINE PICK 1 (IR)                                            M1AS0273
      COMMON M,MA,MB,MC,MD,ME,MF,N,KM,KP,Z,JH,KB,B,P,KL,KN,IK,A,T,X,Y,E M1AS0274
     1     ,DPSTR,JA,JB,JD,IA,IAA,IB                                    M1AS0275
      DIMENSION KM(30),KP(8,2),Z(20),JH(100),KB(300),B(100),P(100),KL(30M1AS0276
     1 0),KN(300),IK(2500),A(2500),T(10),X(100),Y(100),E(100,100)       M1AS0277
     1     ,DPSTR(9500),JA(300),JB(100)                                 M1AS0278
C                                                                       M1AS0279
      IR=0                                                              M1AS0280
      Z(8)=1000000.                                                     M1AS0281
      DO 02 I=MF,M                                                      M1AS0282
      IF (JB(I)-2) 01,01,02                                             M1AS0283
   01 IF (Y(I)-Z(1))02,03,03                                            M1AS0284
   03 T(2) = X(I)/Y(I)                                                  M1AS0285
      IF (T(2)-Z(8)) 04,02,02                                           M1AS0286
   04 IR = I                                                            M1AS0287
      Z(8) = T(2)                                                       M1AS0288
   02 CONTINUE                                                          M1AS0289
      RETURN                                                            M1AS0290
       END (0,1,2,0,0)                                                  M1AS0291
                                                                        M1AS0292
C PICK2     PICK ROW FOR PIVOTING WHEN NON-ACCEPTABLE TABLEAU           M1AS0293
      SUBROUTINE PICK 2 (IR)                                            M1AS0294
      COMMON M,MA,MB,MC,MD,ME,MF,N,KM,KP,Z,JH,KB,B,P,KL,KN,IK,A,T,X,Y,E M1AS0295
     1     ,DPSTR,JA,JB,JD,IA,IAA,IB                                    M1AS0296
      DIMENSION KM(30),KP(8,2),Z(20),JH(100),KB(300),B(100),P(100),KL(30M1AS0297
     1 0),KN(300),IK(2500),A(2500),T(10),X(100),Y(100),E(100,100)       M1AS0298
     1     ,DPSTR(9500),JA(300),JB(100)                                 M1AS0299
C                                                                       M1AS0300
      IR=0                                                              M1AS0301
      Z(8)=1000000.                                                     M1AS0302
      DO 02 I=MF,M                                                      M1AS0303
      IF (JB(I)-2) 01,01,02                                             M1AS0304
   01 IF (ABSF(Y(I))-Z(1)) 02,04,04                                     M1AS0305
   04 T(2) = X(I)/Y(I)                                                  M1AS0306
      IF (T(2)) 02,05,05                                                M1AS0307
   05 IF (T(2)-Z(8)) 06,02,02                                           M1AS0308
   06 IR = I                                                            M1AS0309
      Z(8) = T(2)                                                       M1AS0310
   02 CONTINUE                                                          M1AS0311
      RETURN                                                            M1AS0312
       END (0,1,2,0,0)                                                  M1AS0313
                                                                        M1AS0314
C PICK3     PICK ROW FOR PIVOTING WHEN END CURRENT STAGE K              M1AS0315
      SUBROUTINE PICK 3 (IR,K)                                          M1AS0316
      COMMON M,MA,MB,MC,MD,ME,MF,N,KM,KP,Z,JH,KB,B,P,KL,KN,IK,A,T,X,Y,E M1AS0317
     1     ,DPSTR,JA,JB,JD,IA,IAA,IB                                    M1AS0318
      DIMENSION KM(30),KP(8,2),Z(20),JH(100),KB(300),B(100),P(100),KL(30M1AS0319
     1 0),KN(300),IK(2500),A(2500),T(10),X(100),Y(100),E(100,100)       M1AS0320
     1     ,DPSTR(9500),JA(300),JB(100)                                 M1AS0321
      LA  =0                                                            M1AS0322
      IR=0                                                              M1AS0323
      Z(8) = 1000000.                                                   M1AS0324
      T(4) = -Z(8)                                                      M1AS0325
      DO 02 I=MF,M                                                      M1AS0326
      IF (JB(I)-K) 01,01,02                                             M1AS0327
   01 IF (ABSF(Y(I))-Z(1)) 02,03,03                                     M1AS0328
   03 T(2) = X(I)/Y(I)                                                  M1AS0329
      IF (T(2)) 05,04,04                                                M1AS0330
   04 IF (T(2)-Z(8)) 06,02,02                                           M1AS0331
   06 IR = I                                                            M1AS0332
      Z(8) = T(2)                                                       M1AS0333
      GO TO 02                                                          M1AS0334
   05 IF (T(2)-T(4)) 02,07,07                                           M1AS0335
   07 LA   = I                                                          M1AS0336
      T(4) = T(2)                                                       M1AS0337
   02 CONTINUE                                                          M1AS0338
      IF (IR) 08,08,09                                                  M1AS0339
   08 IR = LA                                                           M1AS0340
      Z(8) = T(4)                                                       M1AS0341
   09 RETURN                                                            M1AS0342
       END (0,1,2,0,0)                                                  M1AS0343
                                                                        M1AS0344
C RESET     BOOK-KEEPING FOR ROW AND COL HEADINGS                       M1AS0345
      SUBROUTINE RESET (IR,JM)                                          M1AS0346
      COMMON M,MA,MB,MC,MD,ME,MF,N,KM,KP,Z,JH,KB,B,P,KL,KN,IK,A,T,X,Y,E M1AS0347
     1     ,DPSTR,JA,JB,JD,IA,IAA,IB                                    M1AS0348
      DIMENSION KM(30),KP(8,2),Z(20),JH(100),KB(300),B(100),P(100),KL(30M1AS0349
     1 0),KN(300),IK(2500),A(2500),T(10),X(100),Y(100),E(100,100)       M1AS0350
     1     ,DPSTR(9500),JA(300),JB(100)                                 M1AS0351
C                                                                       M1AS0352
      KM(2) = KM(2) + 1                                                 M1AS0353
      KM(29) = KM(29)+1                                                 M1AS0354
      KM(11) = IR                                                       M1AS0355
      KM(13) = KN(JM)                                                   M1AS0356
      JD = JH(IR)                                                       M1AS0357
      KM(10) = KN(JD)                                                   M1AS0358
      IF (JD) 01,01,02                                                  M1AS0359
   02 KB(JD) = 0                                                        M1AS0360
   01 KB(JM) = IR                                                       M1AS0361
      JH(IR) = JM                                                       M1AS0362
      CALL QOT(1)                                                       M1AS0363
      RETURN                                                            M1AS0364
       END (0,1,2,0,0)                                                  M1AS0365
                                                                        M1AS0366
C ALTER     BOOK-KEEPING END CURRENT STAGE K                            M1AS0367
      SUBROUTINE ALTER(IR,K)                                            M1AS0368
      COMMON M,MA,MB,MC,MD,ME,MF,N,KM,KP,Z,JH,KB,B,P,KL,KN,IK,A,T,X,Y,E M1AS0369
     1     ,DPSTR,JA,JB,JD,IA,IAA,IB                                    M1AS0370
      DIMENSION KM(30),KP(8,2),Z(20),JH(100),KB(300),B(100),P(100),KL(30M1AS0371
     1 0),KN(300),IK(2500),A(2500),T(10),X(100),Y(100),E(100,100)       M1AS0372
     1     ,DPSTR(9500),JA(300),JB(100)                                 M1AS0373
C                                                                       M1AS0374
      JA(K+1) = JD                                                      M1AS0375
      JB(IR) = K+1                                                      M1AS0376
      DO 02 I=MF,M                                                      M1AS0377
      IF (JB(I)-K) 01,01,02                                             M1AS0378
   01 JB(I) = 1                                                         M1AS0379
   02 CONTINUE                                                          M1AS0380
      RETURN                                                            M1AS0381
       END (0,1,2,0,0)                                                  M1AS0382
                                                                        M1AS0383
C IFACC     TEST FOR ACCEPTABLE TABLEAU.                                M1AS0384
      SUBROUTINE IFACC                                                  M1AS0385
      COMMON M,MA,MB,MC,MD,ME,MF,N,KM,KP,Z,JH,KB,B,P,KL,KN,IK,A,T,X,Y,E M1AS0386
     1     ,DPSTR,JA,JB,JD,IA,IAA,IB                                    M1AS0387
      DIMENSION KM(30),KP(8,2),Z(20),JH(100),KB(300),B(100),P(100),KL(30M1AS0388
     1 0),KN(300),IK(2500),A(2500),T(10),X(100),Y(100),E(100,100)       M1AS0389
     1     ,DPSTR(9500),JA(300),JB(100)                                 M1AS0390
C                                                                       M1AS0391
      DO 02 I=MF,M                                                      M1AS0392
      IF (JB(I)-2) 01,01,02                                             M1AS0393
   01 IF(X(I)+Z(2)) 03,02,02                                            M1AS0394
   02 CONTINUE                                                          M1AS0395
      KM(30) = 1                                                        M1AS0396
      RETURN                                                            M1AS0397
   03 KM(30) = 0                                                        M1AS0398
      RETURN                                                            M1AS0399
       END (0,1,2,0,0)                                                  M1AS0400
                                                                        M1AS0401
C VERTEX    TEST FOR VERTEX AND CALLS OUTPUT                            M1AS0402
      SUBROUTINE VERTEX                                                 M1AS0403
      COMMON M,MA,MB,MC,MD,ME,MF,N,KM,KP,Z,JH,KB,B,P,KL,KN,IK,A,T,X,Y,E M1AS0404
     1     ,DPSTR,JA,JB,JD,IA,IAA,IB                                    M1AS0405
      DIMENSION KM(30),KP(8,2),Z(20),JH(100),KB(300),B(100),P(100),KL(30M1AS0406
     1 0),KN(300),IK(2500),A(2500),T(10),X(100),Y(100),E(100,100)       M1AS0407
     1     ,DPSTR(9500),JA(300),JB(100)                                 M1AS0408
      DO 02 I=MF,M                                                      M1AS0409
      IF (X(I)+Z(2)) 01,02,02                                           M1AS0410
   02 CONTINUE                                                          M1AS0411
      KM(28)=KM(28)+1                                                   M1AS0412
      CALL QOT(3)                                                       M1AS0413
   01 RETURN                                                            M1AS0414
       END (0,1,2,0,0)                                                  M1AS0415
                                                                        M1AS0416
C    SOT 5       SHORT OUTPUT.  THREE-LINE PRINT                        M1AS0417
      SUBROUTINE  SOT(KA)                                               M1AS0418
      COMMON M,MA,MB,MC,MD,ME,MF,N,KM,KP,Z,JH,KB,B,P,KL,KN,IK,A,T,X,Y,E M1AS0419
     1     ,DPSTR,JA,JB,JD,IA,IAA,IB                                    M1AS0420
      DIMENSION KM(30),KP(8,2),Z(20),JH(100),KB(300),B(100),P(100),KL(30M1AS0421
     1 0),KN(300),IK(2500),A(2500),T(10),X(100),Y(100),E(100,100)       M1AS0422
     1     ,DPSTR(9500),JA(300),JB(100)                                 M1AS0423
C                                                                       M1AS0424
      GO TO (101,201), KA                                               M1AS0425
C                             OFFLINE                                   M1AS0426
  101 WRITE OUTPUT TAPE 10, 102, KM(1), KM(16), MC, KM(2), KM(13),KM(10)M1AS0427
     1 , KM(11), Z(10), Z(7), KM(12), Z(8), Z(9)                        M1AS0428
     1 ,KM(30),KM(29),KM(28)                                            M1AS0429
      GO TO 202                                                         M1AS0430
C                             ONLINE                                    M1AS0431
  201 PRINT                 102, KM(1), KM(16), MC, KM(2), KM(13),KM(10)M1AS0432
     1 , KM(11), Z(10), Z(7), KM(12), Z(8), Z(9)                        M1AS0433
     1 ,KM(30),KM(29),KM(28)                                            M1AS0434
  202 RETURN                                                            M1AS0435
C                                                                       M1AS0436
  102 FORMAT( 52H0 IDENT  COND  FORM  ITER    NEW J    OLD J    POSIT8X,M1AS0437
     19HOBJECTIVE / 1H A6,I5,I6,I7,3X, A6,3X,A6,3X,I6,F19.6 /56H0       M1AS0438
     2DELTA MIN   DELCT    THETA    DETERMINANT        /7X,E10.3,I7,2E12M1AS0439
     3.3/37H0       C. STAGE     POINT     VERTEX/1H I15,I10,I11/1H )   M1AS0440
       END (0,1,2,0,0)                                                  M1AS0441
                                                                        M1AS0442
C   VER 5    FORMS INVERSE, SINGLE PRECISION, ALL SOLUTIONS VERSION     M1AS0443
      SUBROUTINE  VER                                                   M1AS0444
      COMMON M,MA,MB,MC,MD,ME,MF,N,KM,KP,Z,JH,KB,B,P,KL,KN,IK,A,T,X,Y,E M1AS0445
     1     ,DPSTR,JA,JB,JD,IA,IAA,IB                                    M1AS0446
      DIMENSION KM(30),KP(8,2),Z(20),JH(100),KB(300),B(100),P(100),KL(30M1AS0447
     1 0),KN(300),IK(2500),A(2500),T(10),X(100),Y(100),E(100,100)       M1AS0448
     1     ,DPSTR(9500),JA(300),JB(100)                                 M1AS0449
C                 INITIATE                                              M1AS0450
      KQ = 0                                                            M1AS0451
      Z(9) = 1.                                                         M1AS0452
        DO 01  I = 1,M                                                  M1AS0453
      DO 13  K = 1,M                                                    M1AS0454
   13 E(K,I) = 0.                                                       M1AS0455
      X(I) = B(I)                                                       M1AS0456
   01 E(I,I) = 1.                                                       M1AS0457
        DO 10  I = MD,M                                                 M1AS0458
      IF (JH(I)) 11,12,11                                               M1AS0459
   11 JH(I) = 12345                                                     M1AS0460
      KQ = KQ + 1                                                       M1AS0461
      GO TO 10                                                          M1AS0462
   12 E(MF-1,I) = -1.                                                   M1AS0463
      X(MF-1) = X(MF-1) - X(I)                                          M1AS0464
   10 CONTINUE                                                          M1AS0465
      IF (KM(29)) 22,22,23                                              M1AS0466
   23    DO 20  J = 1,N                                                 M1AS0467
      IF (KB(J)) 21,20,21                                               M1AS0468
   21 I = KB(J)                                                         M1AS0469
      KB(J) = JB(I)                                                     M1AS0470
   20    CONTINUE                                                       M1AS0471
C                 FORM INVERSE                                          M1AS0472
   22     DO 02  J = 1,N                                                M1AS0473
      IF (KB(J)) 03,02,03                                               M1AS0474
   03 CALL  JMY(J)                                                      M1AS0475
C                       CHOOSE PIVOT                                    M1AS0476
      T(2) = 0.                                                         M1AS0477
        DO 04  I =MD,M                                                  M1AS0478
      IF (JH(I) - 12345) 04,05,04                                       M1AS0479
   05 IF (ABSF(Y(I)) - T(2)) 04,04,06                                   M1AS0480
   06 IR   = I                                                          M1AS0481
      T(2) = ABSF(Y(I))                                                 M1AS0482
   04   CONTINUE                                                        M1AS0483
      IF (T(2) - Z(1)) 07,08,08                                         M1AS0484
C                       PIVOT                                           M1AS0485
   08 JH(IR) = J                                                        M1AS0486
      Z(9)   = Z(9) * Y(IR)                                             M1AS0487
      CALL  PIV(IR)                                                     M1AS0488
      KQ = KQ - 1                                                       M1AS0489
   02     CONTINUE                                                      M1AS0490
         DO 30  I = MD,M                                                M1AS0491
      J = JH(I)                                                         M1AS0492
      JB(I) = KB(J)                                                     M1AS0493
   30 KB(J) = I                                                         M1AS0494
C                       TROUBLE CHECK                                   M1AS0495
      IF (KQ) 09,99,09                                                  M1AS0496
   09 J = 12345                                                         M1AS0497
   07 CALL WOT(6,IR,KN(J))                                              M1AS0498
      PAUSE 200                                                         M1AS0499
   99 RETURN                                                            M1AS0500
C                                                                       M1AS0501
       END(0,1,2,0,0)                                                   M1AS0502
                                                                        M1AS0503
C   VER 6    FORMS INVERSE, DOUBLE PRECISION, ALL SOLUTIONS VERSION     M1AS0504
      SUBROUTINE  VER                                                   M1AS0505
      COMMON M,MA,MB,MC,MD,ME,MF,N,KM,KP,Z,JH,KB,B,P,KL,KN,IK,A,T,X,Y,E M1AS0506
     1     ,DPSTR,JA,JB,JD,IA,IAA,IB                                    M1AS0507
      DIMENSION KM(30),KP(8,2),Z(20),JH(100),KB(300),B(100),P(100),KL(30M1AS0508
     1 0),KN(300),IK(2500),A(2500),T(10),X(100),Y(100),E(100,100)       M1AS0509
     1     ,DPSTR(9500),JA(300),JB(100)                                 M1AS0510
C                 INITIATE                                              M1AS0511
      CALL EXTD ( T(10), 0. )                                           M1AS0512
      CALL EXTD( T(1), 1. )                                             M1AS0513
      KQ = 0                                                            M1AS0514
      Z(9) = 1.                                                         M1AS0515
        DO 01  I = 1,M                                                  M1AS0516
      DO 13  K = 1,M                                                    M1AS0517
   13 CALL  SETD (E(K,I), T(10) )                                       M1AS0518
      CALL SETD( E(I,I), T(1) )                                         M1AS0519
   01 CALL EXTD( X(I), B(I) )                                           M1AS0520
         DO 10  I = MD,M                                                M1AS0521
      IF (JH(I)) 11,12,11                                               M1AS0522
   11 JH(I) = 12345                                                     M1AS0523
      KQ = KQ + 1                                                       M1AS0524
      GO TO 10                                                          M1AS0525
   12 CALL EXTD( E(MF-1,I), -1.)                                        M1AS0526
      CALL SUBD(     X(MF-1), X(MF-1), X(I) )                           M1AS0527
   10 CONTINUE                                                          M1AS0528
      IF (KM(29)) 22,22,23                                              M1AS0529
   23    DO 20  J = 1,N                                                 M1AS0530
      IF (KB(J)) 21,20,21                                               M1AS0531
   21 I = KB(J)                                                         M1AS0532
      KB(J) = JB(I)                                                     M1AS0533
   20    CONTINUE                                                       M1AS0534
C                 FORM INVERSE                                          M1AS0535
   22     DO 02  J = 1,N                                                M1AS0536
      IF (KB(J)) 03,02,03                                               M1AS0537
   03 CALL  JMY(J)                                                      M1AS0538
C                       CHOOSE PIVOT                                    M1AS0539
      T(2) = 0.                                                         M1AS0540
        DO 04  I =MD,M                                                  M1AS0541
      IF (JH(I) - 12345) 04,05,04                                       M1AS0542
   05 IF (ABSF(Y(I)) - T(2)) 04,04,06                                   M1AS0543
   06 IR   = I                                                          M1AS0544
      T(2) = ABSF(Y(I))                                                 M1AS0545
   04   CONTINUE                                                        M1AS0546
      IF (T(2) - Z(1)) 07,08,08                                         M1AS0547
C                       PIVOT                                           M1AS0548
   08 JH(IR) = J                                                        M1AS0549
      Z(9)   = Z(9) * Y(IR)                                             M1AS0550
      CALL  PIV(IR)                                                     M1AS0551
      KQ = KQ - 1                                                       M1AS0552
   02     CONTINUE                                                      M1AS0553
         DO 30  I = MD,M                                                M1AS0554
      J = JH(I)                                                         M1AS0555
      JB(I) = KB(J)                                                     M1AS0556
   30 KB(J) = I                                                         M1AS0557
C                       TROUBLE CHECK                                   M1AS0558
      IF (KQ) 09,99,09                                                  M1AS0559
   09 J = 12345                                                         M1AS0560
   07 CALL WOT(6,IR,KN(J))                                              M1AS0561
      PAUSE 200                                                         M1AS0562
   99 RETURN                                                            M1AS0563
C                                                                       M1AS0564
       END(0,1,2,0,0)                                                   M1AS0565
