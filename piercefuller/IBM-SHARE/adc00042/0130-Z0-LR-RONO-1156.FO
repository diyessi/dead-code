     COMPILE COMPLETE ROCKET NOZZLE PROGRAM FOR SHARE                           
* COMPILE, PRINT SAP, PUNCH OBJECT                              MAIN0000        
      COMMON A, ASTAR,PLN,GAM,ZMACH,YP,YPP, TEMP,P,PHI,DPHI, D2PHI,V,   RONO0002
     1TOM, ZMU, ALPHA,EPS, YT,DELY, ZMACH1,ZMACH2, PLGMX, CON1, CON2,   RONO0003
     2 CON3, CON4, CON5, CON6, MM, XF, C,STREM, K, J, MAXT,IMAX, IPCH,  RONO0004
     3 IS, MAX, KPCH, ISENSW, ID, X, Y, THETA, W,Z,T, PR                RONO0005
     4,U,VE , PA, XLENTH,TC1, TC2, TC3, TC4,S,TA,TB,SS,BX,BY,THV ,KNT   RONO0006
     5  ,PMIN                                                           RONO0007
      DIMENSION         CON1(7 ),CON2( 7),CON3( 7),CON4( 7),CON5( 7),   RONO0008
     1  CON6(7 ),PLGMX(7),C(3,9) , MM(3),XF(3), U (2,75), VE(2 ,75),    RONO0009
     2  X(2,75 ),Y(2,75  ), THETA(2,75 ), W(2, 75),Z(2,75 ) ,ID(2,75)   RONO0010
     4 , STREM(10), T(2,75) , PR(2,75)     ,ISENSW(36)                  RONO0011
     5   ,TA(10), TB(10),SS(10), BX(10), BY(10)                         RONO0012
      WALL1F(EX) = ((EX*C(1,4) +C(1,3))*EX + C(1,2))*EX + C(1,1)        RONO0013
     1 + C(1,5) * SINF(C(1,6)*EX + C(1,7)) + C(1,8)*EXPF(C(1,9)*EX)     RONO0014
      SLOP1F(EX) = (3.*C(1,4)*EX + 2.*C(1,3))*EX + C(1,2) + C(1,5)*     RONO0015
     1  C(1,6)*COSF(C(1,6)*EX + C(1,7)) + C(1,8)*C(1,9)*EXPF(C(1,9)*EX) RONO0016
      WALL2F(EX)  = C(1,1) - SQRTF((C(1,4)*EX + C(1,3))*EX+C(1,2))      RONO0017
      SLOP2F(EX) = (-C(1,3)/2. - C(1,4)*EX) / SQRTF((C(1,4)*EX + C(1,3))RONO0018
     1 *EX + C(1,2))                                                    RONO0019
  99  FORMAT(72H                                                        RONO0020
     1                   )                                              RONO0021
      READ INPUT TAPE 7,99                                              RONO0022
      READ INPUT TAPE 7,101,IMAX,MAXT,IS,IPCH,KPCH,    YT, DELY,        RONO0023
     1     ZMACH, ZMACH1,                                               RONO0024
     1  ZMACH2, PA, XLENTH , THV                                        RONO0025
      READ INPUT TAPE 7,107,     (STREM(I), I= 1,IS)                    RONO0026
      READ INPUT TAPE7,100,      (CON1(I),CON2(I),CON3(I),CON4(I),      RONO0027
     1    CON5(I),CON6(I),PLGMX(I), I=1,IMAX)  ,PMIN                    RONO0028
      DO 3 I=1,MAXT                                                     RONO0029
    3 READ INPUT TAPE7,102,  (C(I,J),J=1,9),XF(I),MM(I)                 RONO0030
C       END READING AND HEAD OUTPUT                                     RONO0031
      WRITE OUTPUT TAPE 6,99                                            RONO0032
      WRITE OUTPUT TAPE 6,115,YT, ZMACH2, PA, THV                       RONO0033
 115  FORMAT(18H0  THROAT RADIUS =,F7.4,14H, AREA RATIO =,F5.1,6H, PA =,RONO0034
     1F6.4,26H, ALLOWABLE THETA CHANGE =,F5.3,7HDEGREES//)              RONO0035
C                                                                       RONO0036
      THV= THV/57.29578                                                 RONO0037
      READ INPUT TAPE 7,102, TC1, TC2, TC3, TC4                         RONO0038
      READ INPUT TAPE 7,103,(ISENSW(I),I=1,36)                          RONO0039
      SENSE LIGHT 0                                                     RONO0040
 110  IF (ISENSW(2)) 108,108,112                                        RONO0041
  112 READ INPUT TAPE 7,302, IPCH,                                      RONO0042
     1                      K,J,MAX,S,EPS,ALPHA,(ID(1,L),X(1,L),Y(1,L), RONO0043
     1THETA(1,L),Z(1,L),W(1,L),PR(1,L),VE(1,L),T(1,L),U(1,L),L=1,MAX)   RONO0044
      WRITE OUTPUT TAPE6,113                                            RONO0045
       IF(ISENSW(23))  33,6,33                                          RONO0046
  33   CALL PONG(3)                                                     RONO0047
  108 WRITE OUTPUT TAPE 6,104                                           RONO0048
      CALL INITIL                                                       RONO0049
      WRITE OUTPUT TAPE 6,106                                           RONO0050
      CALL  NETPTS                                                      RONO0051
      MAX= MAX-    1                                                    RONO0052
   15 X(1,1) = X(2,1)                                                   RONO0053
      Y(1,1) = Y(2,1)                                                   RONO0054
      Z(1,1)= Z(2,1)                                                    RONO0055
      W(1,1) = W(2,1)                                                   RONO0056
      U(1,1) = U(2,1)                                                   RONO0057
      T(1,1) = T(2,1)                                                   RONO0058
      PR(1,1) = PR(2,1)                                                 RONO0059
      VE(1,1) = VE(2,1)                                                 RONO0060
      THETA(1,1) = THETA(2,1)                                           RONO0061
C                                                                       RONO0062
C     SPACE POINTS MORE EVENLY                                          RONO0063
C                                                                       RONO0064
      L=1                                                               RONO0065
      J=1                                                               RONO0066
      DO 29 I=2,MAX                                                     RONO0067
      GSP= DELY/2.*( 2.-Y(2,J)/YT)                                      RONO0068
      SP= DELY/2.* (1.-Y(2,J)/YT)                                       RONO0069
      ZZ= SQRTF((X(2,I)-X(2,J))**2 + (Y(2,I)-Y(2,J))**2)                RONO0070
      IF(ZZ-SP)  27,22,22                                               RONO0071
  22  IF(ZZ-GSP)  26,26,23                                              RONO0072
  27  IF(I-MAX)  28,26,26                                               RONO0073
  23  K=ZZ/(GSP+SP)*2. -1.                                              RONO0074
       IF(K) 20,20,24                                                   RONO0075
  20    K=1                                                             RONO0076
   24 DO25 M=1,K                                                        RONO0077
       A= FLOATF(M) / FLOATF(K+1)                                       RONO0078
      L=L+1                                                             RONO0079
      X(1,L) = A*(X(2,I)-X(2,J)) +X(2,J)                                RONO0080
      Y(1,L)= A*(Y(2,I)-Y(2,J)) + Y(2,J)                                RONO0081
      Z(1,L) = A*(Z(2,I)-Z(2,J)) +Z(2,J)                                RONO0082
      W(1,L) =A*(W(2,I)-W(2,J)) +W(2,J)                                 RONO0083
      U(1,L) = A*(U(2,I)-U(2,J))+U(2,J)                                 RONO0084
      T(1,L) = A*(T(2,I)-T(2,J))+T(2,J)                                 RONO0085
      PR(1,L) =A*(PR(2,I) - PR(2,J))+PR(2,J)                            RONO0086
      VE(1,L) = A*(VE(2,I)-VE(2,J)) +VE(2,J)                            RONO0087
  25  THETA(1,L) = A*(THETA(2,I)-THETA(2,J))+THETA(2,J)                 RONO0088
 26   L=L+1                                                             RONO0089
      X(1,L) = X(2,I)                                                   RONO0090
      Y(1,L) = Y(2,I)                                                   RONO0091
      Z(1,L) = Z(2,I)                                                   RONO0092
      W(1,L) = W(2,I)                                                   RONO0093
      U(1,L) = U(2,I)                                                   RONO0094
      T(1,L) = T(2,I)                                                   RONO0095
      PR(1,L) = PR(2,I)                                                 RONO0096
      VE(1,L) = VE(2,I)                                                 RONO0097
      THETA(1,L) = THETA(2,I)                                           RONO0098
      J=I                                                               RONO0099
 28   IF(L-74) 29,29,16                                                 RONO0100
  16  DELY= 3.* DELY/2.                                                 RONO0101
      GO TO 15                                                          RONO0102
  29  CONTINUE                                                          RONO0103
      MAX=L                                                             RONO0104
      DO 31 I=1,MAX                                                     RONO0105
  31  ID(1,I) = 100*(ID(2,1)/100) + MAX-I+1                             RONO0106
      MAX= MAX+1                                                        RONO0107
C                                                                       RONO0108
C           ESTIMATE THETA AT WALL FOR FIRST LINE                       RONO0109
C                                                                       RONO0110
      TAN = SINF(THETA(1,MAX-1)-U(1,MAX-1))/COSF(THETA(1,MAX-1) -       RONO0111
     1  U(1,MAX-1))                                                     RONO0112
      M=MM(1)                                                           RONO0113
      EX = X(1,MAX-1)                                                   RONO0114
      DO 203 N=1,2                                                      RONO0115
      GO TO (201,202),M                                                 RONO0116
  201 EY= WALL1F(EX)                                                    RONO0117
      YP= SLOP1F(EX)                                                    RONO0118
      GO TO 203                                                         RONO0119
  202 EY= WALL2F(EX)                                                    RONO0120
      YP= SLOP2F(EX)                                                    RONO0121
      IF(EY) 213,213,203                                                RONO0122
 213  YP=-YP                                                            RONO0123
      EY = 2.* C(1,1)-EY                                                RONO0124
 203  EX= (EY-Y(1,MAX-1) + X(1,MAX-1)*TAN-YP*EX)/ ( TAN-YP)             RONO0125
      GO TO (204,205),M                                                 RONO0126
  204 YP = SLOP1F(EX)                                                   RONO0127
      GO TO 206                                                         RONO0128
  205 YP= SLOP2F(EX)                                                    RONO0129
      IF(WALL2F(EX))  216,206,206                                       RONO0130
 216  YP= -YP                                                           RONO0131
  206 CONTINUE                                                          RONO0132
      THETA(1,MAX) = ATANF(YP)                                          RONO0133
       IF(ISENSW(11)) 8,9,8                                             RONO0134
  9   IF(SENSE SWITCH 6) 8,6                                            RONO0135
  8   ISENSW(21)=1                                                      RONO0136
      CALL RESTRT(1)                                                    RONO0137
   6  CALL PING                                                         RONO0138
  103 FORMAT(36I1)                                                      RONO0139
  302 FORMAT(2I3,2I4,1P3E14.7/(I14,4E14.7/5E14.7))                      RONO0140
  107 FORMAT (10F7.4)                                                   RONO0141
  101 FORMAT(3I2,2I4,8F7.5)                                             RONO0142
  106 FORMAT(13H0 NET POINTS )                                          RONO0143
  100 FORMAT (3E14.8/4E14.8)                                            RONO0144
  102 FORMAT(5E14.8/5E14.8,I2)                                          RONO0145
  104 FORMAT(100H       SAUERS LINE             MACH NO.        GAMMA   RONO0146
     1     SOUND VEL         T/M          PRESSURE  )                   RONO0147
  113  FORMAT(100H     ID            X              Y            THETA  RONO0148
     1       IMPULSE        WT FLOW        PRESSURE )                   RONO0149
C                                                                       RONO0150
* COMPILE, PRINT SAP, PUNCH OBJECT                              INIL0000        
      SUBROUTINE INITIL                                                 RONO0152
      COMMON A, ASTAR,PLN,GAM,ZMACH,YP,YPP, TEMP,P,PHI,DPHI, D2PHI,V,   RONO0153
     1TOM, ZMU, ALPHA,EPS, YT,DELY, ZMACH1,ZMACH2, PLGMX, CON1, CON2,   RONO0154
     2 CON3, CON4, CON5, CON6, MM, XF, C,STREM, K, J, MAXT,IMAX, IPCH,  RONO0155
     3 IS, MAX, KPCH, ISENSW, ID, X, Y, THETA, W,Z,T, PR                RONO0156
     4 ,VX, VY                                                          RONO0157
      DIMENSION         CON1(7 ),CON2( 7),CON3( 7),CON4( 7),CON5( 7),   RONO0158
     1  CON6(7 ),PLGMX(7),C(3,9) , MM(3),XF(3), VX(2,75), VY(2 ,75),    RONO0159
     2  X(2,75 ),Y(2,75  ), THETA(2,75 ), W(2, 75),Z(2,75 ) ,ID(2,75)   RONO0160
     4 , STREM(10), T(2,75) , PR(2,75)     ,ISENSW(36)                  RONO0161
                                                                        RONO0162
      PLN1=PLGMX(IMAX) -.69314718                                       RONO0163
      CALL GAMMA (PLN1)                                                 RONO0164
      IF (ABSF(PHI-ZMACH)-.000001) 20,20,10                             RONO0165
   10 PLN2= .5 * PLN1                                                   RONO0166
      ZM1 = PHI                                                         RONO0167
   13 CALL GAMMA (PLN2)                                                 RONO0168
      IF(ABSF(PHI-ZMACH)-.000001 ) 21,21,14                             RONO0169
   14 TEMP=(PHI-ZMACH)* ( PLN2 - PLN1 ) / ( PHI-ZM1 )                   RONO0170
      PLN1=PLN2                                                         RONO0171
      ZM1=PHI                                                           RONO0172
      PLN2=PLN2-TEMP                                                    RONO0173
      GO TO 13                                                          RONO0174
C                                                                       RONO0175
   20 ZMACH=PHI                                                         RONO0176
      PLN= PLN1                                                         RONO0177
      GO TO 23                                                          RONO0178
   21 ZMACH = PHI                                                       RONO0179
      PLN= PLN2                                                         RONO0180
  23  MI = MM(1)                                                        RONO0181
      GO TO (67,68),MI                                                  RONO0182
  67  YP= C(1,2)+C(1,5)*C(1,6)*COSF(C(1,7))+C(1,8)*C(1,9)               RONO0183
      YPP = 2.*C(1,3) -C(1,5)*C(1,6)*C(1,6)*SINF(C(1,7))+C(1,8)*C(1,9)  RONO0184
     1  *C(1,9)                                                         RONO0185
      GO TO 26                                                          RONO0186
   68 TEMP = SQRTF(C(1,2))                                              RONO0187
      YP = -C(1,3) / (TEMP*2.)                                          RONO0188
      YPP= C(1,3)/4. *C(1,3) /(TEMP**3)-C(1,4)/TEMP                     RONO0189
      IF(C(1,1)-TEMP) 70,70,26                                          RONO0190
   70 YP = -YP                                                          RONO0191
      YPP = -YPP                                                        RONO0192
 26    C1 = ABSF(YPP) / SQRTF(ABSF(1.+YP*YP)**3)                        RONO0193
      EPS =(YT/8.) * SQRTF(2.*(GAM+1.)*YT*C1)                           RONO0194
      ALPHA =SQRTF(2.*C1/(GAM+1. ) / YT )                               RONO0195
      ASTAR = A* SQRTF((( GAM-1.)*PHI *PHI  + 2.)/(GAM+1.))             RONO0196
C                                                                       RONO0197
      WRITE OUTPUT TAPE 6,103,  ZMACH, GAM, A, TOM, P                   RONO0198
      IF (ISENSW(36) ) 25,24,25                                         RONO0199
   25 WRITE OUTPUT TAPE 6, 103, C1, ALPHA, EPS, ASTAR                   RONO0200
   24 IPCHK=IPCH                                                        RONO0201
      WRITE OUTPUT TAPE 6,110                                           RONO0202
      L=1                                                               RONO0203
      JMAX= XINTF( YT/DELY)+1                                           RONO0204
      Y(1,1)=0                                                          RONO0205
      ZM = ZMACH*ZMACH*A*A/ (ASTAR*ASTAR)                               RONO0206
      G = GAM + 1.                                                      RONO0207
      DO 29  J=1,JMAX                                                   RONO0208
      AY = ALPHA*ALPHA*Y(1,J)*Y(1,J)                                    RONO0209
      TEMP= (2.+G/2. * AY+ G*G*G*AY*AY/16. )**2 - ( 4.+ G*G*AY)         RONO0210
     1  *(1.+ G*AY*( .5+ G*AY*( 1./16. + G*G*AY/256. ) ) -ZM)           RONO0211
      TEMP = (- (2.+G/2.*AY + G*G*G*AY*AY / 16. )  + SQRTF( TEMP ) )/   RONO0212
     1   ( ALPHA* (2. + G*G*AY/ 2. ))                                   RONO0213
      X(1,J) =  TEMP + EPS                                              RONO0214
      VX(1,J) = (1.+ ALPHA*TEMP +  G*AY/ 4.) * ASTAR                    RONO0215
      VY(1,J) = G/2.* ALPHA* Y(1,J)* ( ALPHA*TEMP + G*AY/8. )*ASTAR     RONO0216
      THETA(1,J) = ATANF(VY(1,J) / VX(1,J))                             RONO0217
      IF (J-1) 201,201,200                                              RONO0218
  200 W(1,J)=W(1,J-1)+2.03163644E-3*(P/TOM )*( (VX(1,J)*Y(1,J)+VX(1,J-1)RONO0219
     1 *Y(1,J-1))*                                                      RONO0220
     1  (       Y(1,J)-Y(1,J-1) )            + (VY(1,J)*Y(1,J)+VY(1,J-1)RONO0221
     2*Y(1,J-1))*( X(1,J)-X(1,J-1)))                                    RONO0222
      Z(1,J) =Z(1,J-1)*W(1,J-1)/W(1,J)+3.141592 *(P/W(1,J))*((Y(1,J)*   RONO0223
     1Y(1,J)-Y(1,J-1)*Y(1,J-1))+(((VX(1,J)*VX(1,J)+VX(1,J-1)*VX(1,J-1)) RONO0222
     2*(Y(1,J)*Y(1,J)-Y(1,J-1)*Y(1,J-1))/2.-((VY(1,J)*VX(1,J)*Y(1,J)+   RONO0222
     3 VX(1,J-1)*VY(1,J-1)*Y(1,J-1))*(X(1,J)-X(1,J-1))))*2.009977E-5    RONO0223
     4 /TOM))                                                           RONO0224
      GO TO 203                                                         RONO0225
  201 W(1,J) = 0.                                                       RONO0226
      Z(1,J) = 0.                                                       RONO0227
  203 ID(1,J)  =  100 * J + JMAX - J + 1                                RONO0228
      IF(K) 120,115,120                                                 RONO0229
  115 IF(Y(1,J))  120,120,116                                           RONO0230
 116  DY = -   (1.+ALPHA*TEMP+G*AY/4. * (1.+G*ALPHA*TEMP+ G**2*AY/8.))  RONO0231
     1  /(G*ALPHA*Y(1,J)/2. *(1.+ALPHA*TEMP+G/2.* (AY/2.+(ALPHA*TEMP)**2RONO0232
     1 +G*ALPHA*TEMP*AY/2.+3. *G*G*AY*AY/64.)))                         RONO0233
      IF(SINF(THETA(1,J)-ZMU)/COSF(THETA(1,J)-ZMU) - DY) 118,118,120    RONO0234
  118 K= ID(1,J)                                                        RONO0235
  120 PR(1,J) = P                                                       RONO0236
      IF (IS) 27,27,32                                                  RONO0237
   32 CALL STREAM(1,J,1,J-1)                                            RONO0238
   27 IF (IPCHK-1 )  30, 30, 28                                         RONO0239
   30 IPCHK=IPCH                                                        RONO0240
      THDEG=THETA(1,J)*57.29578                                         RONO0241
      WRITE OUTPUT TAPE 6,105,ID(1,J),X(1,J),Y(1,J),THDEG,Z(1,J),W(1,J) RONO0242
      IF(ISENSW( 36) ) 33, 29, 33                                       RONO0243
   33  WRITE OUTPUT TAPE 6, 105, ID(1,J), VX(1,J), VY(1,J)              RONO0244
      GO TO 29                                                          RONO0245
   28 IPCHK=IPCHK-1                                                     RONO0246
   29  Y(1,J+1) = Y(1,J)+DELY                                           RONO0247
      RETURN                                                            RONO0248
  103 FORMAT(F40.7,4F15.7)                                              RONO0249
  105 FORMAT(I10,6F15.7)                                                RONO0250
  110  FORMAT(100H0    ID            X              Y            THETA  RONO0251
     1       IMPULSE        WT FLOW        PRESSURE )                   RONO0252
C                                                                       RONO0253
* COMPILE, PRINT SAP, PUNCH OBJECT                              NETPT000        
      SUBROUTINE  NETPTS                                                RONO0255
      COMMON A, ASTAR,PLN,GAM,ZMACH,YP,YPP, TEMP,P,PHI,DPHI, D2PHI,V,   RONO0256
     1TOM, ZMU, ALPHA,EPS, YT,DELY, ZMACH1,ZMACH2, PLGMX, CON1, CON2,   RONO0257
     2 CON3, CON4, CON5, CON6, MM, XF, C,STREM, K, J, MAXT,IMAX, IPCH,  RONO0258
     3 IS, MAX, KPCH, ISENSW, ID, X, Y, THETA, W,Z,T, PR                RONO0259
     4,U,VE                                                             RONO0260
      DIMENSION         CON1(7 ),CON2( 7),CON3( 7),CON4( 7),CON5( 7),   RONO0261
     1  CON6(7 ),PLGMX(7),C(3,9) , MM(3),XF(3), U (2,75), VE(2 ,75),    RONO0262
     2  X(2,75 ),Y(2,75  ), THETA(2,75 ), W(2, 75),Z(2,75 ) ,ID(2,75)   RONO0263
     4 , STREM(10), T(2,75) , PR(2,75)     ,ISENSW(36)                  RONO0264
        SENSE LIGHT 1                                                   RONO0265
       JMAX = XINTF (YT /DELY) +1                                       RONO0266
       DO 100 I=1,JMAX                                                  RONO0267
       VE(1,I) = V                                                      RONO0268
       U (1,I) = ZMU                                                    RONO0269
  100  T (1,I) = TOM                                                    RONO0270
       DO 102   J = 1,JMAX                                              RONO0271
       X(2,2*J-1)  = X(1,J)                                             RONO0272
       Y(2,2*J-1)  = Y(1,J)                                             RONO0273
       Z(2,2*J-1)  = Z (1,J)                                            RONO0274
       W (2,2*J-1) = W(1,J)                                             RONO0275
      PR (2,2*J-1) = PR(1,J)                                            RONO0276
      THETA(2,2*J-1)=THETA(1,J)                                         RONO0277
      T  (2,2*J-1) = T (1,J)                                            RONO0278
      VE (2,2*J-1) = VE(1,J)                                            RONO0279
       U (2,2*J-1) = U (1,J)                                            RONO0280
  102  ID(2,2*J-1)  =ID(1,J)                                            RONO0281
       DO 121 J=2,JMAX                                                  RONO0282
       KOUT =1                                                          RONO0283
       IF(ID(1,J)-K) 103,130,103                                        RONO0284
 103  N=2*J- 2                                                          RONO0285
       DO 120     L=2,N                                                 RONO0286
      MA =2*J-L -1                                                      RONO0287
      MB =2*J-L +1                                                      RONO0288
      MC =2*J-L                                                         RONO0289
      CALL CPOINT ( 2,MA ,2,MB ,2,MC )                                  RONO0290
      IF (IS) 104,110, 105                                              RONO0291
  104 IS=-IS                                                            RONO0292
  105 CALL STREAM(2,MB,2,MC)                                            RONO0293
  110  IF (KOUT -KPCH)  117,111,111                                     RONO0294
  117  KOUT =KOUT+1                                                     RONO0295
       GO TO 120                                                        RONO0296
  111 KOUT =1                                                           RONO0297
      TH=THETA(2,MC) * 57.29578                                         RONO0298
      WRITE OUTPUT TAPE 6,301,ID(2,MC),X(2,MC), Y(2,MC), TH, Z(2,MC),   RONO0299
     1  W(2,MC), PR(2,MC)                                               RONO0300
      IF (ISENSW(35)) 124,120,124                                       RONO0301
  124 WRITE OUTPUT TAPE6,301,ID(2,MC),VE(2,MC),T(2,MC),U(2,MC) ,GAM     RONO0302
  120 CONTINUE                                                          RONO0303
      CALL CENTER                                                       RONO0304
      IF(KOUT -KPCH)  121,122,122                                       RONO0305
  122 TH =THETA(2,1) * 57.29578                                         RONO0306
      WRITE OUTPUT TAPE 6,301,ID(2,1),X(2,1),Y(2,1),TH, Z(2,1),W(2,1),  RONO0307
     1   PR (2,1)                                                       RONO0308
  121 CONTINUE                                                          RONO0309
      MAX= 2*J                                                          RONO0310
  125  GO TO 155                                                        RONO0311
C                                                                       RONO0312
  130   J= J+1                                                          RONO0313
       MAX  = 2*JMAX -2                                                 RONO0314
      LAST  = 2*JMAX -2*J +1                                            RONO0315
      DO 154 K= 1,LAST,2                                                RONO0316
        I = 2*JMAX -2 -K                                                RONO0317
       MAX = MAX-1                                                      RONO0318
      DO 150 N=I, MAX                                                   RONO0319
       MA = N+2                                                         RONO0320
      MC  = N+1                                                         RONO0321
      CALL CPOINT (2,MA,2,N,2,MC )                                      RONO0322
        IF (IS) 135,140,135                                             RONO0323
  135  CALL STREAM (2,MC ,2,N)                                          RONO0324
  140  IF(KOUT - KPCH)  147,141,141                                     RONO0325
  147 KOUT = KOUT + 1                                                   RONO0326
       GO TO 150                                                        RONO0327
  141  KOUT =1                                                          RONO0328
       TH = THETA (2,MC) * 57.29578                                     RONO0329
       WRITE OUTPUT TAPE 6,301,ID(2,MC),X(2,MC),Y(2,MC),TH,Z(2,MC),     RONO0330
     1     W(2,MC) ,PR(2,MC)                                            RONO0331
      IF (ISENSW(35)) 144,150,144                                       RONO0332
  144 WRITE OUTPUT TAPE6,301,ID(2,MC),VE(2,MC),T(2,MC),U(2,MC)  ,GAM    RONO0333
  150  CONTINUE                                                         RONO0334
 152  EX = X(2,MAX+1)                                                   RONO0335
      DO 40 IY= 1,MAXT                                                  RONO0336
      IF (EX-XF(IY)) 42,42,40                                           RONO0337
   40 CONTINUE                                                          RONO0338
   42 M=MM(IY)                                                          RONO0339
      GO TO (47,48),M                                                   RONO0340
  47  EY=((EX*C(IY,4)+C(IY,3))*EX+C(IY,2))*EX + C(IY,1) + C(IY,5)*      RONO0341
     1  SINF(C(IY,6)*EX + C(IY,7 )) + C(IY,8)* EXPF (C(IY,9) * EX)      RONO0342
      GO TO 51                                                          RONO0343
   48 TEMP = SQRTF((C(IY,4)*EX + C(IY,3))*EX + C(IY,2))                 RONO0344
      EY= C(IY,1)-TEMP                                                  RONO0345
      IF(EY) 50,50,51                                                   RONO0346
   50 EY = C(IY,1) + TEMP                                               RONO0347
  51  IF(Y(2,MAX+1)-EY) 154, 151,151                                    RONO0348
  151   MAX  =  MAX -1                                                  RONO0349
       GO TO 152                                                        RONO0350
  154 CONTINUE                                                          RONO0351
      DO 160 L=I,MAX                                                    RONO0352
      X(2,L-1)= X(2,L)                                                  RONO0353
      Y(2,L-1) = Y(2,L)                                                 RONO0354
      Z(2,L-1) = Z(2,L)                                                 RONO0355
      W(2,L-1) = W(2,L)                                                 RONO0356
      U(2,L-1) = U(2,L)                                                 RONO0357
      T(2,L-1) = T(2,L)                                                 RONO0358
      VE(2,L-1) = VE(2,L)                                               RONO0359
      PR(2,L-1) = PR(2,L)                                               RONO0360
      ID(2,L-1) = ID(2,L)                                               RONO0361
  160 THETA(2,L-1) = THETA(2,L)                                         RONO0362
      MAX= MAX +2                                                       RONO0363
  155 RETURN                                                            RONO0364
  301  FORMAT(I10,6F15.7)                                               RONO0365
C                                                                       RONO0366
* COMPILE, PRINT SAP, PUNCH OBJECT                              CPT10000        
C      THIS IS FOR FIRST CORE LOAD, CHOOSES LOWER PR AND HIGHER Y       RONO0368
C   HYPERBOLIC RELATION ASSUMED FOR WEIGHT FLOW                         RONO0369
      SUBROUTINE CPOINT (IA,LA,IB,LB,IC,LC)                             RONO0370
      COMMON A, ASTAR,PLN,GAM,ZMACH,YP,YPP, TEMP,P,PHI,DPHI, D2PHI,V,   RONO0371
     1TOM, ZMU, ALPHA,EPS, YT,DELY, ZMACH1,ZMACH2, PLGMX, CON1, CON2,   RONO0372
     2 CON3, CON4, CON5, CON6, MM, XF, C,STREM, K, J, MAXT,IMAX, IPCH,  RONO0373
     3 IS, MAX, KPCH, ISENSW, ID, X, Y, THETA, W,Z,T, PR                RONO0374
     4,U,VE , PA, XLENTH,TC1, TC2, TC3, TC4,S,TTA,TTB,SS,BX,BY,THV ,KNT RONO0375
      DIMENSION         CON1(7 ),CON2( 7),CON3( 7),CON4( 7),CON5( 7),   RONO0376
     1  CON6(7 ),PLGMX(7),C(3,9) , MM(3),XF(3), U (2,75), VE(2 ,75),    RONO0377
     2  X(2,75 ),Y(2,75  ), THETA(2,75 ), W(2, 75),Z(2,75 ) ,ID(2,75)   RONO0378
     4 , STREM(10), T(2,75) , PR(2,75)     ,ISENSW(36)                  RONO0379
     5  ,TTA(10),TTB(10),SS(10), BX(10), BY(10)                         RONO0380
      TANF(R) = SINF(R)/COSF(R)                                         RONO0381
      KNT = 0                                                           RONO0382
      P1 =  LOGF ((PR(IA,LA) +PR(IB,LB))/2.)                            RONO0383
      TH1 =  (THETA(IA,LA)+ THETA(IB,LB)) /2.                           RONO0384
       TB = TANF( THETA(IB,LB) -U(IB,LB))                               RONO0385
       TA = TANF( THETA(IA,LA) +U(IA,LA))                               RONO0386
      TNUA = TANF(U(IA,LA))                                             RONO0387
      TNUB = TANF(U(IB,LB))                                             RONO0388
       IF(Y(IA,LA)) 65,67,65                                            RONO0389
   65  AL =     TNUA      *SINF(U(IA,LA)) / Y(IA,LA)* SINF(THETA (IA,LA)RONO0390
     1   ) / COSF( THETA(IA,LA)+U(IA,LA))                               RONO0391
   67  BM=        TNUB   *SINF(U(IB,LB)) /Y(IB,LB)*SINF( THETA (IB,LB)) RONO0392
     1      / COSF ( THETA(IB,LB)- U(IB,LB))                            RONO0393
  70   CALL GAMMA (P1)                                                  RONO0394
      TNU = TANF(ZMU)                                                   RONO0395
       TANA =(TA + TANF(TH1 + ZMU))/2.                                  RONO0396
       TANB = (TB+ TANF(TH1 - ZMU))/2.                                  RONO0397
      ZVA = 2.* VE(IA,LA) / (VE(IA,LA) +  V)                            RONO0398
      ZVB = 2.* VE(IB,LB) / (VE(IB,LB) +  V)                            RONO0399
      TUB = (TNUB  + TNU ) / 2.                                         RONO0400
      TUA =  ( TNUA + TNU) / 2.                                         RONO0401
      ZA = (VE(IA,LA) +V)/ 2.                                           RONO0402
      ZB  = (VE(IB,LB) + V) /2.                                         RONO0403
   72  EX   =(Y(IA,LA)-Y(IB,LB) +TANB* X(IB,LB) - TANA*X(IA,LA)) /      RONO0404
     1    (TANB-TANA)                                                   RONO0405
       EY      = Y(IA,LA)+ ( E X     -X(IA,LA))* TANA                   RONO0406
      IF (Y(IA,LA)) 71,73,71                                            RONO0407
  73  ZL =2.*(4./ (3.*VE(IA,LA)+V) * (V-VE(IA,LA))/ (EX-X(IA,LA)) -     RONO0408
     1  (3.*     TNUA  +  TNU         )/4. * TH1/(EX-X(IA,LA)) +        RONO0409
     2     TNU   /2. * SINF(ZMU)/EY*SINF(TH1)/ COSF(TH1+ZMU))/3.        RONO0410
      GO TO 74                                                          RONO0411
  71   ZL  = ( AL  +      TNU   *SINF(ZMU) /  E Y    * SINF(TH1) /      RONO0412
     1      COSF(TH1+ ZMU) ) /2.                                        RONO0413
  74  ZMB = ( BM +      TNU *SINF(ZMU)  /   E Y   *SINF(TH1) /COSF(TH1  RONO0414
     1     - ZMU) ) / 2.                                                RONO0415
       EV       = ( (ZVA + ZL*( E X     -X(IA,LA)))/ TUA +  ( ZVB +     RONO0416
     1   ZMB* ( E X     -X(IB,LB))) / TUB +THETA(IB,LB)-THETA(IA,LA) )  RONO0417
     2   /(  1./(ZA *TUA) + 1./(ZB* TUB) )                              RONO0418
      ETH          = THETA(IA,LA)+ ( ( E V   -  VE(IA,LA))/ZA - ZL*     RONO0419
     1  (  E X     -X(IA,LA)))/ TUA                                     RONO0420
  76   IF ( ABSF(TH1-E TH    )    - 1.E-5) 75 ,75 ,77                   RONO0421
   75  IF ( ABSF(V - EV  )   -5.E-2    )  80 , 80, 77                   RONO0422
   77 P1 = P1 -  V/TOM *( E V      - V) /49719.22                       RONO0423
      TH1 = TH1 +       ( ETH  - TH1) /2.                               RONO0424
      GO TO 70                                                          RONO0425
  80  IF(P-PR(IA,LA))  87,87,85                                         RONO0426
  85  P = PR(IA,LA)                                                     RONO0427
       V = VE(IA,LA)                                                    RONO0428
       ZMU = U(IA,LA)                                                   RONO0429
       TOM = T(IA,LA )                                                  RONO0430
  87  IF(EY-Y(IA,LA))  89,90,90                                         RONO0431
  89  EY = Y(IA,LA)                                                     RONO0432
      EX = X(IA,LA)                                                     RONO0433
  90  X(IC,LC)= EX                                                      RONO0434
      Y(IC,LC) = EY                                                     RONO0435
      PR(IC,LC) = P                                                     RONO0436
      VE(IC,LC) =  V                                                    RONO0437
      THETA(IC,LC)= ETH                                                 RONO0438
       U(IC,LC) =ZMU                                                    RONO0439
       T(IC,LC) = TOM                                                   RONO0440
   83 ID(IC,LC) =(ID(IB,LB)/100) *100  + ID(IA,LA)- 100*(ID(IA,LA)/100) RONO0441
       W(IC,LC) = W(IA,LA) + .00101581816  *2.       *  (  E V*EY  *    RONO0442
     1   (COSF( ETH     )   -SINF(  E TH  )    /TANF(  E TH +  ZMU ) )  RONO0443
     2     *P/TOM +VE(IA,LA) * (COSF(THETA(IA,LA)) -SINF(THETA(IA,LA))  RONO0444
     5  /TA) * Y(IA,LA)                                                 RONO0445
     3     *PR(IA,LA)/T(IA,LA) )*(  E Y      -Y(IA,LA)    )             RONO0446
      Z(IC,LC)  = (Z(IA,LA) *W(IA,LA) +(W(IC,LC) -W(IA,LA))/64.348      RONO0447
     1  *(VE(IA,LA) * COSF(THETA(IA,LA)) +   EV     *COSF(  ETH       ))RONO0448
     2         + 3.14159265      *(PR(IA,LA) + P        ) /2.*          RONO0449
     3       (EY * E Y     -Y(IA,LA)*Y(IA,LA)) ) /W(IC,LC)              RONO0450
      RETURN                                                            RONO0451
