* COMPILE, PRINT SAP, PUNCH OBJECT                              MRCH0000        
      COMMON A, ASTAR,PLN,GAM,ZMACH,YP,YPP, TEMP,P,PHI,DPHI, D2PHI,V,   RONO0454
     1TOM, ZMU, ALPHA,EPS, YT,DELY, ZMACH1, YEXIT ,PLGMX, CON1, CON2,   RONO0455
     2 CON3, CON4, CON5, CON6, MM, XF, C,STREM, K, J, MAXT,IMAX, IPCH,  RONO0456
     3 IS, MAX, KPCH, ISENSW, ID, X, Y, THETA, W,Z,T, PR                RONO0457
     4,U,VE , PA, XLENTH,TC1, TC2, TC3, TC4,S,TA,TB,SS,BX,BY,THV        RONO0458
      DIMENSION         CON1(7 ),CON2( 7),CON3( 7),CON4( 7),CON5( 7),   RONO0459
     1  CON6(7 ),PLGMX(7),C(3,9) , MM(3),XF(3), U (2,75), VE(2 ,75),    RONO0460
     2  X(2,75 ),Y(2,75  ), THETA(2,75 ), W(2, 75),Z(2,75 ) ,ID(2,75)   RONO0461
     4 , STREM(10), T(2,75) , PR(2,75)     ,ISENSW(36)                  RONO0462
     5   ,TA(10), TB(10),SS(10), BX(10), BY(10)                         RONO0463
      MAX = MAX                                                         RONO0464
      YEXIT = YT*SQRTF(YEXIT  )                                         RONO0465
      IF ( ISENSW(22)) 36,20,36                                         RONO0466
  20  SENSE LIGHT 2                                                     RONO0467
      IPCH =0                                                           RONO0468
      SENSE LIGHT 1                                                     RONO0469
   36 CALL  WALL  ( MAX-1)                                              RONO0470
      SPHI = PHI                                                        RONO0471
  74  IF (SENSE SWITCH 6)  76,30                                        RONO0472
  30  IF(ZMACH1 - PHI)  69,69,45                                        RONO0473
  69   IF ( SENSE LIGHT 2) 70,45                                        RONO0474
  70  IF( ISENSW(12)) 76,74,76                                          RONO0475
  76  ISENSW(22) = 1                                                    RONO0476
      CALL RESTRT(1)                                                    RONO0477
  45  IF(THETA(2,MAX)-THETA(1,MAX)-1.1*THV)   46,46,47                  RONO0478
  47   IF ( MAX-73)  42, 46,46                                          RONO0479
  46  ASSIGN 77 TO M                                                    RONO0480
      J = MAX                                                           RONO0481
      I=1                                                               RONO0482
      GO TO 48                                                          RONO0483
  42   ASSIGN 51 TO M                                                   RONO0484
      I= (THETA(2,MAX  )- THETA(1,MAX))/THV                             RONO0485
  37   J = MAX +I                                                       RONO0486
      IF(J-74) 38,38,39                                                 RONO0487
  39  I=I-1                                                             RONO0488
      GO TO 37                                                          RONO0489
  38  X(2, J) = X(2,MAX)                                                RONO0490
      Y(2, J) = Y(2,MAX)                                                RONO0491
      Z(2, J) = Z(2,MAX)                                                RONO0492
      U(2, J) = U(2,MAX)                                                RONO0493
      T(2,J ) = T(2,MAX)                                                RONO0494
      W(2,J ) = W(2,MAX)                                                RONO0495
      PR(2,J ) = PR(2,MAX)                                              RONO0496
      VE(2,J ) = VE(2,MAX)                                              RONO0497
      ID(2,J ) = ID(2,MAX) +100 * I                                     RONO0498
      THETA(2,J ) = THETA(2,MAX)                                        RONO0499
      DO 40 LL=1,I                                                      RONO0500
      B= FLOATF(LL)/ FLOATF(I+1)                                        RONO0501
      L  = MAX + LL-1                                                   RONO0502
      X(2,L ) = B*(X(2,J ) -X(1,MAX-1)) + X(1,MAX-1)                    RONO0503
      Y(2,L ) =B*(Y(2,J ) -Y(1,MAX-1)) +Y(1,MAX-1)                      RONO0504
      W(2,L ) = B*(W(2,J ) -W(1,MAX-1)) +W(1,MAX-1)                     RONO0505
      Z(2,L ) = B*(Z(2,J )-Z(1,MAX-1)) + Z(1,MAX-1)                     RONO0506
      U(2,L ) = B*(U(2,J ) -U(1,MAX-1))+U(1,MAX-1)                      RONO0507
      T(2,L ) = B*(T(2,J )-T(1,MAX-1)) +T(1,MAX-1)                      RONO0508
      VE(2,L ) = B*(VE(2,J ) -VE(1,MAX-1))+VE(1,MAX-1)                  RONO0509
      PR(2,L ) = B*(PR(2,J ) -PR(1,MAX-1)) + PR(1,MAX-1)                RONO0510
      THETA(2,L ) = B*(THETA(2,J ) -THETA(1,MAX-1)) +THETA(1,MAX-1)     RONO0511
   40 ID(2,L ) = ID(2,J ) - 100* (I-LL+1)                               RONO0512
      MAX = MAX-1                                                       RONO0513
      I= I+1                                                            RONO0514
   48 DO 50 KK=1,I                                                      RONO0515
      SENSE LIGHT 3                                                     RONO0516
      ISENSW(17) =1                                                     RONO0517
      KOUT=1                                                            RONO0518
      GO TO M, (77,51)                                                  RONO0519
  51  MAX = MAX+1                                                       RONO0520
  77  IF(ZMACH1 -   SPHI      )   34,34, 49                             RONO0521
  34  ISENSW(8) =1                                                      RONO0522
      ISENSW(9) =1                                                      RONO0523
   49 DO  65   L =  3, MAX                                              RONO0524
       ISENSW(18) =0                                                    RONO0525
       LA = MAX -L +1                                                   RONO0526
      LB = LA+2                                                         RONO0527
      LC = LA+1                                                         RONO0528
       CALL  CPOINT( 1,LA,2,LB,2,LC)                                    RONO0529
       IF(ISENSW(18)) 152,151,152                                       RONO0530
  152  ISENSW(18) =0                                                    RONO0531
        GO TO 35                                                        RONO0532
 151    IF(X(2,LC)-X(2,LB))   153,153,154                               RONO0533
 153    MAX = MAX-1                                                     RONO0534
       DO 155  JM = LC,J                                                RONO0535
       X(2,JM-1) = X(2,JM)                                              RONO0536
      Y(2,JM-1) = Y(2,JM)                                               RONO0537
       THETA(2,JM-1) = THETA(2,JM)                                      RONO0538
       ID(2,JM-1) = ID(2,JM)                                            RONO0539
        Z(2,JM-1) = Z(2,JM)                                             RONO0540
         W(2,JM-1) = W(2,JM)                                            RONO0541
       PR(2,JM-1) = PR(2,JM)                                            RONO0542
         VE(2,JM-1) = VE(2,JM)                                          RONO0543
       U(2,JM-1) = U(2,JM)                                              RONO0544
 155   T(2,JM-1) = T(2,JM)                                              RONO0545
      J= J-1                                                            RONO0546
       GO TO 65                                                         RONO0547
 154   IF(IS)  52,54,52                                                 RONO0548
  52   CALL STREAM(2,LB,2,LC)                                           RONO0549
   54 IF  ( KOUT - KPCH)  60,62,62                                      RONO0550
   60 KOUT = KOUT + 1                                                   RONO0551
      GO TO  55                                                         RONO0552
   62 TH = THETA(2,LC)* 57.29578                                        RONO0553
      WRITE OUTPUT TAPE 6,301,ID(2,LC),X(2,LC) , Y(2,LC), TH, Z(2,LC),  RONO0554
     1   W(2,LC), PR(2,LC)                                              RONO0555
      KOUT=1                                                            RONO0556
   55  IF(ISENSW(8)) 64,64,53                                           RONO0557
   53 IF(MAD- ID(2,LC)) 58,58,64                                        RONO0558
   58 CALL RAO (LC)                                                     RONO0559
      IF(ISENSW(9)) 64,59,64                                            RONO0560
 59   IF(ISENSW(17))  57,64,57                                          RONO0561
   57 MAD = ID(2,LC) -5                                                 RONO0562
      ISENSW(17) =0                                                     RONO0563
   64  IF(X(2,LC)-1.5*XLENTH) 65,65,35                                  RONO0564
   65 CONTINUE                                                          RONO0565
      CALL CENTER                                                       RONO0566
       IF(ISENSW(18))  35,165,35                                        RONO0567
  165 IF ( KOUT - KPCH ) 67,66,66                                       RONO0568
   66 TH = THETA(2,1)* 57.29 578                                        RONO0569
      WRITE OUTPUT TAPE 6,301, ID(2,1), X(2,1), Y(2,1), TH, Z(2,1),     RONO0570
     1    W(2,1),  PR(2,1)                                              RONO0571
  67  IF(ISENSW(8)) 35,35,68                                            RONO0572
   68 CALL RAO(  1)                                                     RONO0573
  35   MAD = MAD + 100                                                  RONO0574
       DO 50 L=1,MAX                                                    RONO0575
       X(1,L) =  X(2,L)                                                 RONO0576
       Y(1,L) =  Y(2,L)                                                 RONO0577
       W(1,L) =  W(2,L)                                                 RONO0578
       Z(1,L) =  Z(2,L)                                                 RONO0579
