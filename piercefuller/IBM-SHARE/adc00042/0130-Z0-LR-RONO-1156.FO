* COMPILE, PRINT SAP, PUNCH OBJECT                              RAO 0000        
      SUBROUTINE  RAO (  M)                                             RONO0591
      COMMON A, ASTAR,PLN,GAM,ZMACH,YP,YPP, TEMP,P,PHI,DPHI, D2PHI,V,   RONO0592
     1TOM, ZMU, ALPHA,EPS, YT,DELY, ZMACH1, YEXIT ,PLGMX, CON1, CON2,   RONO0593
     2 CON3, CON4, CON5, CON6, MM, XF, C,STREM, K, J, MAXT,IMAX, IPCH,  RONO0594
     3 IS, MAX, KPCH, ISENSW, ID, X, Y, THETA, W,Z,T, PR                RONO0595
     4,U,VE , PA, XLENTH,TC1, TC2, TC3, TC4,S,TA,TB,SS,BX,BY,THV ,LR    RONO0596
      DIMENSION         CON1(7 ),CON2( 7),CON3( 7),CON4( 7),CON5( 7),   RONO0597
     1  CON6(7 ),PLGMX(7),C(3,9) , MM(3),XF(3), U (2,75), VE(2 ,75),    RONO0598
     2  X(2,75 ),Y(2,75  ), THETA(2,75 ), W(2, 75),Z(2,75 ) ,ID(2,75)   RONO0599
     4 , STREM(10), T(2,75) , PR(2,75)     ,ISENSW(36)                  RONO0600
     5   ,TA(10), TB(10),SS(10), BX(10), BY(10)                         RONO0601
      DIMENSION RX(2), RY(2),RTH(2), RW(2),RZ(2), RPR(2)                RONO0602
       ISENSW(1 8) = 0                                                  RONO0603
      TWOLAM =  - VE(2,M)*COSF(THETA(2,M)-U(2,M)) /COSF(U(2,M))         RONO0604
      TRELAM = -Y(2,M) *PR(2,M)/T(2,M)*.093123355 * VE(2,M)*VE(2,M)*    RONO0605
     1 (SINF(THETA(2,M))**2) *SINF(U(2,M))/COSF(U(2,M))                 RONO0606
      IF(Y(2,M))  4,4,3                                                 RONO0607
    4  THD=0                                                            RONO0608
      WD=W(2,J)                                                         RONO0609
      PRD = PR(2,M)                                                     RONO0610
      VD = VE(2,M)                                                      RONO0611
      UD= U(2,M)                                                        RONO0612
      TD= T(2,M)                                                        RONO0613
      YD= SQRTF( WD /  .29255565 / PRD*TD  /VD * 144.)                  RONO0614
      XD = X(2,M) + YD* COSF(UD) / SINF(UD)                             RONO0615
      ZD = VD/32.174+  3.14159265 *PRD*YD*YD/WD                         RONO0616
      GO TO 34                                                          RONO0617
    3 DELP= .05*PR(2,M)                                                 RONO0618
      IF(THETA(2,M) -U(2,M))  6,6,5                                     RONO0619
  5   TWOLAM = -   TWOLAM                                               RONO0620
      DELP = -DELP                                                      RONO0621
  6   ISENSW(10) = 0                                                    RONO0622
      PRO = PR(2,M)                                                     RONO0623
      XO =X(2,M)                                                        RONO0624
      YO =Y(2,M)                                                        RONO0625
      ZO =Z(2,M)                                                        RONO0626
      WO =W(2,M)                                                        RONO0627
      THO=THETA(2,M)                                                    RONO0628
      UO =U(2,M)                                                        RONO0629
      VO =VE(2,M)                                                       RONO0630
      TO =T(2,M)                                                        RONO0631
      IF(ISENSW(32)) 12,15,12                                           RONO0632
  12  WRITE OUTPUT TAPE6,306,TWOLAM,TRELAM                              RONO0633
   15 PRD = PRO -DELP                                                   RONO0634
      PLOG = LOGF(PRD)                                                  RONO0635
      CALL GAMMA( PLOG)                                                 RONO0636
       IF(ISENSW(18))  40,16,40                                         RONO0637
  16  R= V*V-(TWOLAM**2) * (COSF(ZMU)**2)                               RONO0638
      THD = ZMU + ATANF(SQRTF(ABSF(R))/(TWOLAM*COSF(ZMU)))              RONO0639
      YD = -TRELAM /(PRD/TOM*.093123355 *V*V* (SINF(THD)**2) *SINF(ZMU))RONO0640
     1  * COSF(ZMU)                                                     RONO0641
      IF (ISENSW(30))   2,10,2                                          RONO0642
  2   WRITE OUTPUT TAPE 6,306,YD,THD,PRD,DELP,R                         RONO0643
  10  IF (ISENSW(10))  211,210,211                                      RONO0644
 210  IF(ABSF(YD-YO) -.2*YO) 222,222,20                                 RONO0645
   20 DELP =  DELP/3.                                                   RONO0646
      GO TO 15                                                          RONO0647
 222  IF(R) 225,230,230                                                 RONO0648
  225  SENSE LIGHT 4                                                    RONO0649
      SAVE = DELP                                                       RONO0650
      DELP = -.8 * (PRD-PRO) * RN / (RN-R)                              RONO0651
      GO TO 15                                                          RONO0652
  211 DELP = -SAVE                                                      RONO0653
      ISENSW(10) =0                                                     RONO0654
  230       IF(YD-YO)  235,235,240                                      RONO0655
 235  WRITE OUTPUT TAPE 6,307, ID(2,M)                                  RONO0656
 307  FORMAT(26H  RAO S METHOD FAILS FROM ,I4)                          RONO0657
      GO TO 40                                                          RONO0658
 240  IF(SENSE LIGHT 4)  242,22                                         RONO0659
 242   ISENSW(10) =1                                                    RONO0660
      TWOLAM = -TWOLAM                                                  RONO0661
      DELP =0                                                           RONO0662
   22  IF(YD -1.05*YO)   23,23,24                                       RONO0663
   23 DELP = 2.*DELP                                                    RONO0664
   24  XD = XO +(YD-YO) *COSF(THO +UO) /SINF(THO+UO)                    RONO0665
      RN = R                                                            RONO0666
       WD = WO + .0020316364*(PRD*V/TOM*YD* (COSF(THD) -SINF(THD)/SINF(T-ONO0667
     1HD +ZMU)*COSF(THD+ZMU)) +PRO*VO/TO*YO*(COSF(THO)-SINF(THO)/SINF(THOONO0668
     2O  +UO)* COSF(THO+UO)) ) *(YD    -YO   )                          OONO0669
      ZD  = ZO*WO/WD + ( (WD-WO)*(VO*COSF(THO) +VD*COSF(THD))/64.348    OONO0670
     1  +1.5707963 *(PRO+PRD) * (YD*YD-YO*YO))/ WD                      OONO0671
      IF(WD - W(2,J  ))  26,28,28                                       OONO0672
   26 PRO=PRD                                                           OONO0673
      XO =XD                                                            OONO0674
      YO =YD                                                            OONO0675
      ZO =ZD                                                            OONO0676
      WO =WD                                                            OONO0677
      THO=THD                                                           OONO0678
      UO =ZMU                                                           OONO0679
      VO =V                                                             OONO0680
      TO =TOM                                                           OONO0681
      IF (ISENSW(32))  27,15,27                                         OONO0682
  27  WRITE OUTPUT TAPE 6,306, XO,YO,THO,ZO,WO,PRO,VO,TO,UO             OONO0683
      GO TO 15                                                          OONO0684
   28 TEMP = (WD -W(2,J  )) /(WD-WO)                                    OONO0685
      PRD= PRD-(PRD-PRO) *TEMP                                          OONO0686
      VD = V - (V-VO)*TEMP                                              OONO0687
      WD= W(2,J  )                                                      OONO0688
      TD =TOM -(TOM-TO)*TEMP                                            OONO0689
      UD = ZMU-(ZMU-UO)*TEMP                                            OONO0690
      THD=(THD-(THD-THO)*TEMP )                                         OONO0691
   30 XD = XD -(XD-XO ) *TEMP                                           OONO0692
      ZD = ZD -(ZD-ZO ) *TEMP                                           OONO0693
      YD = YD -(YD-YO ) *TEMP                                           OONO0694
  34  APA =PRD -PRD*2.0099769E-5/2.*VD/TD*VD *SINF(UD)/COSF(UD) *       OONO0695
     1  SINF(2.*THD)                                                    OONO0696
      IF (SENSE LIGHT 3)  36,35                                         OONO0697
  35  IF (ABSF(APA-WPA)-ABSF(PA-APA)-ABSF(WPA-PA) +1.E-5) 36,50,50      OONO0698
  36  WX=XD                                                             OONO0699
      WY= YD                                                            OONO0700
      WZ= ZD                                                            OONO0701
      WW= W(2,J  )                                                      OONO0702
      WPR= PRD                                                          OONO0703
      WTH= THD                                                          OONO0704
      WPA= APA                                                          OONO0705
      IF(ISENSW(31)) 7,38,7                                             OONO0706
 7    TH = WTH*57.29578                                                 OONO0707
      WRITE OUTPUT TAPE6,308, WX,WY,WTH,WZ,WW, WPR, WPA                 OONO0708
 308  FORMAT(10H POS. EXIT7F15.7)                                       OONO0709
  38   IF(XD-XLENTH*5.0) 40,40,42                                       OONO0710
 50    TEMP= (APA-PA)/ (APA-WPA)                                        OONO0711
      XO = XD-(XD-WX)*TEMP                                              OONO0712
      YO = YD-(YD-WY)*TEMP                                              OONO0713
      THO = THD-(THD-WTH)*TEMP                                          OONO0714
      WO = WD-(WD-WW)*TEMP                                              OONO0715
      ZO = ZD-(ZD-WZ)*TEMP                                              OONO0716
      PRO = PRD-(PRD-WPR)*TEMP                                          OONO0717
      IF(ISENSW(4))    53,52,53                                         OONO0718
 52   TH = THO*57.29578                                                 OONO0719
      WRITE OUTPUT TAPE 6,305,ID(2,M), XO, YO, TH,ZO, WO,PRO, PA        OONO0720
 53   IF(ISENSW(9))   55,55,60                                          OONO0721
55    SLOPE = PA-WPA                                                    OONO0722
      IF (SLOPE)   56,59,59                                             OONO0723
 56   L=2                                                               OONO0724
      ISENSW(8) =0                                                      OONO0725
      IF(ISENSW(16))  75,68,75                                          OONO0726
 59   ISENSW(15) =0                                                     OONO0727
      ISENSW(16) =0                                                     OONO0728
 60   L=1                                                               OONO0729
      ISENSW(9) =0                                                      OONO0730
      IF(ISENSW(15))  75,68,75                                          OONO0731
  68  ISENSW(L+14) =1                                                   OONO0732
      RX(L) = XO                                                        OONO0733
      RY(L) = YO                                                        OONO0734
      RTH(L) = THO                                                      OONO0735
      RW(L) = WO                                                        OONO0736
      RZ(L) = ZO                                                        OONO0737
      RPR(L) = PRO                                                      OONO0738
      GO TO 36                                                          OONO0739
 75   IF(1.0000001*ABSF(YO-RY(L)) - ABSF(RY(L) -YEXIT) - ABSF(YO-YEXIT) OONO0740
     1  ) 68,77,77                                                      OONO0741
 77   TEMP = (YO-YEXIT) /(YO-RY(L))                                     OONO0742
      Y(2,1) = YEXIT                                                    OONO0743
      X(2,1) = XO-(XO-RX(L))*TEMP                                       OONO0744
      THETA(2,1) = THO-(THO-RTH(L))*TEMP                                OONO0745
      W(2,1) = WO-(WO-RW(L))*TEMP                                       OONO0746
      Z(2,1) = ZO-(ZO-RZ(L))*TEMP                                       OONO0747
      PR(2,1) = PRO-(PRO-RPR(L))*TEMP                                   OONO0748
      PLOG = LOGF(PR(2,1))                                              OONO0749
      CALL GAMMA (PLOG)                                                 OONO0750
      T(2,1) = TOM                                                      OONO0751
      VE(2,1) = V                                                       RONO0752
      U(2,1) = ZMU                                                      RONO0753
      TH= THETA(2,1) * 57.29578                                         RONO0754
      WRITE OUTPUT TAPE6, 306,X(2,1), Y(2,1), TH, Z(2,1), W(2,1), PR(2,1RONO0755
     1  ), PA                                                           RONO0756
      K= M+1                                                            RONO0757
      IF(ISENSW(5))  41,42,41                                           RONO0758
40    RETURN                                                            RONO0759
 41   CALL PING                                                         RONO0760
   42 CONTINUE                                                          RONO0761
  305 FORMAT(5H  PA I5,7F15.7)                                          RONO0762
  306 FORMAT(10H   EXIT   7F15.7)                                       RONO0763
C                                                                       RONO0764
* COMPILE, PRINT SAP, PUNCH OBJECT                              WALL0000        
       SUBROUTINE  WALL (M)                                             RON10002
      COMMON A, ASTAR,PLN,GAM,ZMACH,YP,YPP, TEMP,P,PHI,DPHI, D2PHI,V,   RON10003
     1TOM, ZMU, ALPHA,EPS, YT,DELY, ZMACH1,ZMACH2, PLGMX, CON1, CON2,   RON10004
     2 CON3, CON4, CON5, CON6, MM, XF, C,STREM, K, J, MAXT,IMAX, IPCH,  RON10005
     3 IS, MAX, KPCH, ISENSW, ID, X, Y, THETA, W,Z,T, PR                RON10006
     4,U,VE   ,PA,XLENTH,TC1,TC2,TC3,TC4,S                              RON10007
      DIMENSION         CON1(7 ),CON2( 7),CON3( 7),CON4( 7),CON5( 7),   RON10008
     1  CON6(7 ),PLGMX(7),C(3,9) , MM(3),XF(3), U (2,75), VE(2 ,75),    RON10009
     2  X(2,75 ),Y(2,75  ), THETA(2,75 ), W(2, 75),Z(2,75 ) ,ID(2,75)   RON10010
     4 , STREM(10), T(2,75) , PR(2,75)     ,ISENSW(36)                  RON10011
       P1 = LOGF(PR(1,M))                                               RON10012
      UA =SINF(U( 1,M)) /COSF(U(1,M))                                   RON10013
      TA =  SINF(THETA(1,M) +U(1,M)) / COSF(THETA(1,M) + U(1,M))        RON10014
      TAN=TA                                                            RON10015
      AL =          UA               * SINF(U(1,M)) / Y(1,M) * SINF     RON10016
     1  (THETA(1,M)) /COSF(THETA(1,M) + U(1,M))                         RON10017
      AV=VE(1,M)                                                        RON10018
      ALL=AL                                                            RON10019
      TU =UA                                                            RON10020
      EX = X(1,M )                                                      RON10021
   23 DO 40 IY= 1,MAXT                                                  RON10022
      IF (EX-XF(IY)) 42,42,40                                           RON10023
   40 CONTINUE                                                          RON10024
   42 L=MM(IY)                                                          RON10025
  43  GO TO (47,48),L                                                   RON10026
   47 YP= (3.*C(IY,4)* EX +2.*C(IY,3)) *EX +C(IY,2)+ C(IY,5)*C(IY,6) *  RON10027
     1 COSF (C(IY,6) * EX +C(IY,7)) +C(IY,8)* C(IY,9)*EXPF(C(IY,9) *EX) RON10028
  147 Y(2,M+1)= ((EX*C(IY,4)+C(IY,3))*EX +C(IY,2))*EX + C(IY,1) + C(IY,5M;N10029
     1)*SINF(C(IY,6)*EX + C(IY,7 )) + C(IY,8)* EXPF (C(IY,9) * EX)      M;N10030
      GO TO 24                                                          M;N10031
   48 TEMP = SQRTF((C(IY,4)*EX + C(IY,3))*EX + C(IY,2))                 M;N10032
      YP =(-C(IY,3)/2.-C(IY,4) *EX)/ TEMP                               M;N10033
      Y(2,M+1)= C(IY,1)-TEMP                                            M;N10034
      IF (Y(2,M+1)) 50,50,24                                            M;N10035
   50 YP= -YP                                                           M;N10036
  150 Y(2,M+1)=C(IY,1)+TEMP                                             M;N10037
C                                                                       M;N10038
   24 YP = ATANF (YP)                                                   M;N10039
      CALL GAMMA ( P1)                                                  M;N10040
      TAN =(TA + SINF(YP +ZMU) /COSF(YP+ ZMU) )/2.                      M;N10041
      ALL = (AL +  SINF(ZMU)/COSF(ZMU) *SINF(ZMU)/Y(2,M+1) * SINF(YP) / M;N10042
     1   COSF(YP +ZMU) ) /2.                                            M;N10043
      AV =(VE(1,M) +V         ) / 2.                                    M;N10044
       TU =(UA + SINF(ZMU)/COSF(ZMU) ) /2.                              M;N10045
      X(2,M+1)= X(1,M) +  (Y(2,M+1) - Y(1,M)) /TAN                      M;N10046
      VE(2,M+1)=VE(1,M)+AV* (TU*(YP-THETA(1,M))+ALL*(X(2,M+1)-X(1,M)))  M;N10047
C                                                                       M;N10048
      IF ( ABSF(X(2,M+1)-EX)-1.E-5)   25,25, 26                         M;N10049
   25 IF ( ABSF(VE(2,M+1)-V)-1.E-2)   28,28, 26                         M;N10050
   26  P1 = P1 +   V/TOM*( V-VE(2,M+1))/99438.44                        M;N10051
       EX = EX+ (X(2,M+1) - EX ) / 2.                                   M;N10052
       GO TO 43                                                         M;N10053
   28  THETA(2,M+1) = YP                                                M;N10054
       U(2,M+1)   =ZMU                                                  M;N10055
       T(2,M+1)  = TOM                                                  M;N10056
       PR(2,M+1) = P                                                    M;N10057
       W(2,M+1) = W(1,M) +.0020316364*( P*V /TOM *(COSF(YP) - SINF(YP)/ M;N10058
     1  SINF(YP+ZMU) *COSF(YP+ ZMU))*Y(2,M+1 ) +PR(1,M)*VE(1,M)/T(1,M)* M;N10059
     2Y(1,M)*  (COSF(THETA(1,M))-  SINF(THETA(1,M)) / TA ) ) * (Y(2,M+1)M;N1!060
     3 - Y(1,M)   )                                                     M;N1!061
      Z(2,M+1) =   Z(1,M) * W(1,M)/W(2,M+1) +            ((W(2,M+1) -   M;N1!062
     1  W(1,M))* ( VE(1,M)* COSF(THETA(1,M)) + V *COSF(YP ))/ 64.348 +  M;N1!063
     3  1.5707963*                                                      M;N1!064
     2   (PR(1,M) +P ) * (Y(2,M+1)**2 - Y(1,M)**2 ) )  / W(2,M+1)       M;N1!065
       ID(2,M+1)=  ID(1,M) + 100                                        M;N1!066
      IF (X(2,M+1)) 32,33,33                                            M;N1!067
   33 IF(SENSE LIGHT 1 ) 34, 35                                         M;N1!068
   34  S  =  3.14159265*(YT + Y(2,M+1)) *SQRTF((Y(2,M+1) -YT)**2  +     M;N1!069
     1   X(2,M+1)**2 )                                                  M;N1!070
      GO TO 32                                                          M;N1!071
   35  S= S+3.14159265 *(ALPHA   + Y(2,M+1))*SQRTF( (Y(2,M+1)-ALPHA)    M;N1!072
     1 **2 + (X(2,M+1)-EPS) **2 )                                       M;N1!073
C                                                                       M;N1!074
  32  EPS= X(2,M+1)                                                     M;N1!075
      ALPHA =Y(2,M+1)                                                   M;N1!076
      IPCH = IPCH +1                                                    M;N1!077
      WRITE TAPE 3, ID(2,M+1), X(2,M+1),Y(2,M+1), THETA(2,M+1),         M;N1!078
     1  PR(2,M+1),VE(2,M+1), T(2,M+1), U(2,M+1)                         M;N1!079
      IF(ISENSW(1))   30,30,29                                          M;N1!080
   29 TH= YP * 57.29578                                                 M;N1!081
      WRITE OUTPUT TAPE 6,301, ID(2,M+1), X(2,M+1),Y(2,M+1), TH, Z(2,M+1M;N1!082
     1  ), W(2,M+1), P , S                                              M;N1!083
  301  FORMAT(5H0WALLI5,7F15.7,2H=S)                                    M;N1!084
   30  RETURN                                                           M;N1!085
C                                                                       RON1!086
* COMPILE, PRINT SAP, PUNCH OBJECT                              COR30000        
      COMMON A, ASTAR,PLN,GAM,ZMACH,YP,YPP, TEMP,P,PHI,DPHI, D2PHI,V,   M;N1!113
     1TOM, ZMU, ALPHA,EPS, YT,DELY, ZMACH1,ZMACH2, PLGMX, CON1, CON2,   M;N1!114
     2 CON3, CON4, CON5, CON6, MM, XF, C,STREM, K, J, MAXT,IMAX, IPCH,  M;N1!115
     3 IS, MAX, KPCH, ISENSW, ID, X, Y, THETA, W,Z,T, PR                M;N1!116
     4,U,VE , PA, XLENTH,TC1, TC2, TC3, TC4,S,TA,TB,SS,BX,BY,THV        M;N1!117
      DIMENSION         CON1(7 ),CON2( 7),CON3( 7),CON4( 7),CON5( 7),   M;N1!118
     1  CON6(7 ),PLGMX(7),C(3,9) , MM(3),XF(3), U (2,75), VE(2 ,75),    M;N1!119
     2  X(2,75 ),Y(2,75  ), THETA(2,75 ), W(2, 75),Z(2,75 ) ,ID(2,75)   M;N1!120
     4 , STREM(10), T(2,75) , PR(2,75)     ,ISENSW(36)                  M;N1!121
     5   ,TA(10), TB(10),SS(10), BX(10), BY(10)                         M;N1!122
C                                                                       M;N1!123
      WRITE OUT PUT TAPE6,110                                           M;N1!124
      IF(ISENSW(23)) 35,19,35                                           M;N1!125
  19  IF(J-MAX)  22,25,22                                               M;N1!126
 22   X(2,MAX) = X(2,J)                                                 M;N1!127
      Y(2,MAX) = Y(2,J)                                                 M;N1!128
      W(2,MAX) = W(2,J)                                                 M;N1!129
      Z(2,MAX) = Z(2,J)                                                 M;N1!130
      U(2,MAX) = U(2,J)                                                 M;N1!131
      T(2,MAX)= T(2,J)                                                  M;N1!132
       PR(2,MAX) = PR(2,J)                                              M;N1!133
      VE(2,MAX)= VE(2,J)                                                M;N1!134
      ID(2,MAX) = ID(2,J)                                               M;N1!135
      THETA(2,MAX) = THETA(2,J)                                         M;N1!136
  25  IF(ISENSW(13)) 27,26,27                                           M;N1!137
  26  IF(SENSE SWITCH6) 27,30                                           M;N1!138
  27  ISENSW(23) =1                                                     M;N1!139
      CALL RESTRT(2)                                                    M;N1!140
  30   DO 32 I=K,MAX                                                    M;N1!141
      X(1,I) = X(2,I)                                                   M;N1!142
      Y(1,I) = Y(2,I)                                                   M;N1!143
      Z(1,I) = Z(2,I)                                                   M;N1!144
      W(1,I) = W(2,I)                                                   M;N1!145
      U(1,I) = U(2,I)                                                   M;N1!146
      T(1,I) = T(2,I)                                                   M;N1!147
      VE(1,I) = VE(2,I)                                                 M;N1!148
      PR(1,I) = PR(2,I)                                                 M;N1!149
      ID(1,I) = ID(2,I)                                                 M;N1!150
  32  THETA(1,I) = THETA(2,I)                                           M;N1!151
      GO TO 37                                                          M;N1!152
  35  X(2,1) =X(1,1)                                                    M;N1!153
      Y(2,1) = Y(1,1)                                                   M;N1!154
      Z(2,1)=Z(1,1)                                                     M;N1!155
      W(2,1) = W(1,1)                                                   M;N1!156
      U(2,1) = U(1,1)                                                   M;N1!157
      T(2,1) = T(1,1)                                                   M;N1!158
      VE(2,1) = VE(1,1)                                                 M;N1!159
      PR(2,1) = PR(1,1)                                                 M;N1!160
      THETA(2,1) = THETA(1,1)                                           M;N1!161
  37  CALL RAO3                                                         M;N1!162
C                                                                       RON1!163
C                                                                       M;N1!164
      SENSE LIGHT 3                                                     M;N1!165
      IA=1                                                              M;N1!166
      LA=K                                                              M;N1!167
      DO  75  N=1,J                                                     M;N1!168
      LB=J-N+1                                                          M;N1!169
      LC=LB+1                                                           M;N1!170
      IB=2                                                              M;N1!171
      IC=2                                                              M;N1!172
      KOUT = 1                                                          M;N1!173
      DO 70  I=  K,MAX                                                  M;N1!174
      CALL CPOINT (IA,LA,IB,LB,IC,LC)                                   M;N1!175
      IF(W(IC,LC) -W(2,1)) 45,40,40                                     M;N1!176
   40 TEMP=(W(IC,LC) - W(2,1)) / (W(IC,LC) -W(IB,LB))                   M;N1!177
      W(IC,LC)= W(2,1)                                                  M;N1!178
      X(IC,LC)=  X(IC,LC) - (X(IC,LC) -X(IB,LB))* TEMP                  M;N1!179
      Y(IC,LC)  =Y(IC,LC)  -(Y(IC,LC)  -Y(IB,LB)) *TEMP                 M;N1!180
      Z(IC,LC)  =Z(IC,LC)  -(Z(IC,LC)  -Z(IB,LB)) *TEMP                 M;N1!181
      U(IC,LC)  =U(IC,LC)  -(U(IC,LC)  -U(IB,LB)) *TEMP                 M;N1!182
      T(IC,LC)  =T(IC,LC)  -(T(IC,LC)  -T(IB,LB)) *TEMP                 M;N1!183
      PR(IC,LC)=PR(IC,LC)  -(PR(IC,LC) -PR(IB,LB))*TEMP                 M;N1!184
      VE(IC,LC) =VE(IC,LC) -(VE(IC,LC) -VE(IB,LB))*TEMP                 M;N1!185
      THETA(IC,LC)=THETA(IC,LC)-(THETA(IC,LC)-THETA(IB,LB))* TEMP       M;N1!186
      TH= THETA(IC,LC) * 57.29578                                       M;N1!187
      S= S+3.14159265 * (Y(IC,LC) + ALPHA   )*SQRTF((Y(IC,LC)-ALPHA )   M;N1!188
     1 **2 + (X(IC,LC)-  EPS   )**2)                                    M;N1!189
      EPS = X(IC,LC)                                                    M;N1!190
      ALPHA = Y(IC,LC)                                                  M;N1!191
      IPCH = IPCH +1                                                    M;N1!192
C                                                                       RON1!193
C                                                                       RON1!194
      IF(ISENSW(1))  44,72,44                                           M;N1!195
  44  TH= THETA(IC,LC)  *57.29578                                       M;N1!196
      WRITE  OUTPUT TAPE 6, 302,ID(IC,LC) , X(IC,LC) , Y(IC,LC) ,       M;N1!197
     1  TH, Z(IC,LC) , W(IC,LC), PR(IC,LC), S                           M;N1!198
      GO TO 72                                                          M;N1!199
   45  IF (KOUT-KPCH) 51,50,50                                          M;N1!200
   51 KOUT= KOUT + 1                                                    M;N1!201
       GO TO 52                                                         M;N1!202
   50 KOUT =1                                                           M;N1!203
      TH= THETA(IC,LC) * 57.29578                                       M;N1!204
      WRITE OUTPUT TAPE 6,301, ID(IC,LC), X(IC,LC), Y(IC,LC), TH,       M;N1!205
     1   Z(IC,LC), W(IC,LC), PR(IC,LC)                                  M;N1!206
   52 IF (IS)  47,53,47                                                 M;N1!207
   47 CALL STREAM (IC,LC,IB,LB)                                         M;N1!208
   53  LA=LA +1                                                         M;N1!209
      LB=LB+1                                                           M;N1!210
       LC=LC+1                                                          M;N1!211
       IF(LA -75)  55,55,54                                             M;N1!212
   54 IA=1                                                              M;N1!213
      LA=1                                                              M;N1!214
      GO TO 70                                                          M;N1!215
   55 IF (LC -75) 57,57,56                                              M;N1!216
   56 IC = 1                                                            M;N1!217
      LC = 1                                                            M;N1!218
      GO TO 70                                                          M;N1!219
   57 IF (LB -75) 70,70,59                                              M;N1!220
   59 IB=1                                                              M;N1!221
      LB=1                                                              M;N1!222
   70 CONTINUE                                                          M;N1!223
   72  IA = 2                                                           M;N1!224
   75 LA  = J-N+2                                                       M;N1!225
      WRITE OUTPUT TAPE 6,305                                           M;N1!226
      PRINT  305                                                        M;N1!227
  305 FORMAT(62H0                                            NOZZLE  COMM;N1!228
     1PLETED)                                                           M;N1!229
  302 FORMAT(5H WALL,I5,7F15.7,2H=S)                                    M;N1!230
  301 FORMAT(I10,6F15.7)                                                M;N1!231
  110  FORMAT(100H     ID            X              Y            THETA  M;N1!232
     1       IMPULSE        WT FLOW        PRESSURE )                   M;N1!233
C                                                                       M;N1!234
* COMPILE, PRINT SAP, PUNCH OBJECT                              RAO30000        
      SUBROUTINE RAO 3                                                  M;N1!236
      COMMON A, ASTAR,PLN,GAM,ZMACH,YP,YPP, TEMP,P,PHI,DPHI, D2PHI,V,   M;N1!237
     1TOM, ZMU, ALPHA,EPS, YT,DELY, ZMACH1,ZMACH2, PLGMX, CON1, CON2,   M;N1!238
     2 CON3, CON4, CON5, CON6, MM, XF, C,STREM, K, J, MAXT,IMAX, IPCH,  M;N1!239
     3 IS, MAX, KPCH, ISENSW, ID, X, Y, THETA, W,Z,T, PR                M;N1!240
     4,U,VE , PA, XLENTH,TC1, TC2, TC3, TC4,S,TA,TB,SS,BX,BY,THV        M;N1!241
      DIMENSION         CON1(7 ),CON2( 7),CON3( 7),CON4( 7),CON5( 7),   M;N1!242
     1  CON6(7 ),PLGMX(7),C(3,9) , MM(3),XF(3), U (2,75), VE(2 ,75),    M;N1!243
     2  X(2,75 ),Y(2,75  ), THETA(2,75 ), W(2, 75),Z(2,75 ) ,ID(2,75)   M;N1!244
     4 , STREM(10), T(2,75) , PR(2,75)     ,ISENSW(36)                  M;N1!245
     5   ,TA(10), TB(10),SS(10), BX(10), BY(10)                         M;N1!246
      TWOLAM = -VE(2,1) *COSF(THETA(2,1) -U(2,1)) / COSF(U(2,1))        M;N1!247
      TRELAM =-Y(2,1) * (VE(2,1)**2) * PR(2,1)/T(2,1) *.093123355 *     M;N1!248
     1  (SINF(THETA(2,1))**2) *SINF(U(2,1)) /COSF(U(2,1))               M;N1!249
      I=1                                                               M;N1!250
      J=2                                                               M;N1!251
      DELP = .05*PR(1,K)                                                M;N1!252
C                                                                       M;N1!253
      ISENSW(10) =0                                                     M;N1!254
      IF(THETA(2,1)-U(2,1)) 15,15,12                                    M;N1!255
  12  TWOLAM = -TWOLAM                                                  M;N1!256
      DELP = -DELP                                                      M;N1!257
   15 PR(2,J)= PR(2,I) +DELP                                            M;N1!258
       PLN = LOGF(PR(2,J))                                              M;N1!259
      CALL GAMMA(PLN    )                                               M;N1!260
      R= V*V - (TWOLAM*COSF(ZMU))**2                                    M;N1!261
      THETA(2,J)= ZMU +ATANF( SQRTF(ABSF(R))                            M;N1!262
     1      /( TWOLAM *COSF(ZMU)) )                                     M;N1!263
      Y(2,J) = -TRELAM*COSF(ZMU) /SINF(ZMU) /(SINF(THETA(2,J))**2) /    M;N1!264
     1        V**2  * TOM/PR(2,J) /.093123355                           M;N1!265
       IF(ISENSW(28))    401,400,401                                    M;N1!266
 401    WRITE OUTPUT TAPE 6,420,I,J,K, Y(2,J), THETA(2,J),PR(2,J),      M;N1!267
     1  PLN, DELP, R, RN, X(2,I)                                        M;N1!268
 420   FORMAT(3I5,8F13.4)                                               M;N1!269
 400  IF(ISENSW(10)) 211,210,211                                        M;N1!270
 210  IF(ABSF(Y(2,J)-Y(2,I))-.1 *Y(2,J)) 222,222,23                     M;N1!271
  222 IF(R) 225,230,230                                                 M;N1!272
   23 DELP = DELP/3.                                                    M;N1!273
      GO TO 15                                                          M;N1!274
  225 SENSE LIGHT 4                                                     M;N1!275
      SAVE = DELP                                                       M;N1!276
      DELP =  .8*(PR(2,J)-PR(2,I)) *RN/(RN-R)                           M;N1!277
      GO TO 15                                                          M;N1!278
  211 DELP = -SAVE                                                      M;N1!279
      ISENSW(10) =0                                                     M;N1!280
 230  IF(Y(2,I) -Y(2,J)) 235,235,240                                    M;N1!281
 235  WRITE OUTPUT TAPE 6,307                                           M;N1!282
  307 FORMAT(36H  RAO S METHOD WILL NOT GO BACKWARDS)                   M;N1!283
      GO TO 43                                                          M;N1!284
  240 IF(SENSE LIGHT 4) 242,25                                          M;N1!285
  242 ISENSW(10) =1                                                     M;N1!286
      TWOLAM = -TWOLAM                                                  M;N1!287
      DELP =0                                                           M;N1!288
   25 IF ( Y(2,I) -1.025*Y(2,J))  27,27,28                              M;N1!289
   27 DELP =  2.* DELP                                                  M;N1!290
  28  IF (Y(2,J)-Y(1,K)*1.05)35,35,29                                   M;N1!291
   29 X(2,J) = X(2,I) +(Y(2,J)-Y(2,I))* COSF(THETA(2,J)+ZMU)/SINF(THETA M;N1!292
     1   (2,J)+ZMU)                                                     M;N1!293
      RN = R                                                            M;N1!294
      W(2,J)= W(2,I) - .00203163632* (PR(2,I)*VE(2,I)/T(2,I)*Y(2,I)*(   M;N1!295
     1COSF( THETA(2,I))- SINF(THETA(2,I)) / SINF(THETA(2,I)+U(2,I))*COSFM;N1!296
     2 (THETA(2,I)+U(2,I))) +PR(2,J)*V/TOM *(COSF(THETA(2,J))- SINF     M;N1!297
     3 (THETA(2,J)) /SINF(THETA(2,J)+ZMU)*COSF(THETA(2,J)+ZMU))*Y(2,J))*M;N1!298
     4 (Y(2,I)    - Y(2,J) )                                            M;N1!299
      Z(2,J) =( Z(2,I)*W(2,I) -(W(2,I)- W(2,J)) *(V*COSF(THETA(2,J))+   M;N1!300
     1  VE(2,I)*COSF(THETA(2,I)))/64.348  - 1.57079632 * (PR(2,J)       M;N1!301
     2  +PR(2,I)) *(Y(2,I)**2 -Y(2,J)**2) ) /W(2,J)                     M;N1!302
      T(2,J)=TOM                                                        M;N1!303
      VE(2,J)=V                                                         M;N1!304
      U(2,J) = ZMU                                                      M;N1!305
       IF(ISENSW(29)) 18,17,18                                          M;N1!306
  18    WRITE OUTPUT TAPE 6,320, X(2,J), Y(2,J), THETA(2,J), Z(2,J),    M;N1!307
     1  W(2,J), PR(2,J)                                                 M;N1!308
 320    FORMAT(F25.7,5F15.7)                                            M;N1!309
  17  J=J+1                                                             M;N1!310
      I=I+1                                                             M;N1!311
      IF(J-74) 15,35,35                                                 M;N1!312
   35 J= J-1                                                            M;N1!313
  36  IF(X(2,J) -1.05* X(1,K))  37,37,38                                M;N1!314
   37 K=K+1                                                             M;N1!315
      GO TO 36                                                          M;N1!316
   38 IF (Y(2,J) - Y(1,K))  34,34,39                                    M;N1!317
   34 J=J-1                                                             M;N1!318
      GO TO 36                                                          M;N1!319
   39 DO 42  I=1,J                                                      M;N1!320
   42 ID(2,I) = ID(1,K) + 100*(J-I+1)                                   M;N1!321
     1    -1                                                            M;N1!322
      RETURN                                                            M;N1!323
  43  CONTINUE                                                          M;N1!324
C                                                                       M;N1!325
* COMPILE, PRINT SAP, PUNCH OBJECT                              RSRT0000        
      SUBROUTINE RESTRT(I)                                              M;N1!327
      COMMON A, ASTAR,PLN,GAM,ZMACH,YP,YPP, TEMP,P,PHI,DPHI, D2PHI,V,   M;N1!328
     1TOM, ZMU, ALPHA,EPS, YT,DELY, ZMACH1,ZMACH2, PLGMX, CON1, CON2,   M;N1!329
     2 CON3, CON4, CON5, CON6, MM, XF, C,STREM, K, J, MAXT,IMAX, IPCH,  M;N1!330
     3 IS, MAX, KPCH, ISENSW, ID, X, Y, THETA, W,Z,T, PR                M;N1!331
     4,U,VE , PA, XLENTH,TC1, TC2, TC3, TC4,S                           M;N1!332
      DIMENSION         CON1(7 ),CON2( 7),CON3( 7),CON4( 7),CON5( 7),   M;N1!333
     1  CON6(7 ),PLGMX(7),C(3,9) , MM(3),XF(3), U (2,75), VE(2 ,75),    M;N1!334
     2  X(2,75 ),Y(2,75  ), THETA(2,75 ), W(2, 75),Z(2,75 ) ,ID(2,75)   M;N1!335
     4 , STREM(10), T(2,75) , PR(2,75)     ,ISENSW(36)                  M;N1!336
      ISENSW(2) =1                                                      M;N1!337
      PUNCH 103,( ISENSW(L), L=1,36)                                    M;N1!338
      PUNCH 302,IPCH, K, J,MAX,S, EPS, ALPHA, (ID(I,L),X(I,L), Y(I,L),  M;N1!339
     1THETA(I,L),Z(I,L), W(I,L), PR(I,L),VE(I,L),T(I,L), U(I,L),L=1,MAX)M;N1!340
      WRITE OUTPUT TAPE 6,306                                           M;N1!341
      PRINT 306                                                         M;N1!342
      IF(SENSE SWITCH 5)  7,6                                           M;N1!343
  6   RETURN                                                            M;N1!344
  7   CONTINUE                                                          M;N1!345
  306 FORMAT(22H RESTART CARDS PUNCHED)                                 M;N1!346
  103  FORMAT(36I1)                                                     M;N1!347
  302 FORMAT(2I3,2I4,1P3E14.7/(I14,4E14.7/5E14.7))                      M;N1!348
C                                                                       M;N1!349
* COMPILE, PRINT SAP, PUNCH OBJECT                              CNTR0000        
      SUBROUTINE CENTER                                                 M;N1!351
      COMMON A, ASTAR,PLN,GAM,ZMACH,YP,YPP, TEMP,P,PHI,DPHI, D2PHI,V,   M;N1!352
     1TOM, ZMU, ALPHA,EPS, YT,DELY, ZMACH1,ZMACH2, PLGMX, CON1, CON2,   M;N1!353
     2 CON3, CON4, CON5, CON6, MM, XF, C,STREM, K, J, MAXT,IMAX, IPCH,  M;N1!354
     3 IS, MAX, KPCH, ISENSW, ID, X, Y, THETA, W,Z,T, PR                M;N1!355
     4,U,VE                                                             M;N1!356
      DIMENSION         CON1(7 ),CON2( 7),CON3( 7),CON4( 7),CON5( 7),   M;N1!357
     1  CON6(7 ),PLGMX(7),C(3,9) , MM(3),XF(3), U (2,75), VE(2 ,75),    M;N1!358
     2  X(2,75 ),Y(2,75  ), THETA(2,75 ), W(2, 75),Z(2,75 ) ,ID(2,75)   M;N1!359
     4 , STREM(10), T(2,75) , PR(2,75)     ,ISENSW(36)                  M;N1!360
  62   P1 = LOGF(PR(2,2)) - .01                                         M;N1!361
      ZM = SINF(U(2,2))**2/ COSF(U(2,2))* SINF(THETA(2,2)) / COSF       M;N1!362
     1 (THETA(2,2)-U(2,2))*2.  /3.                                      M;N1!363
      Q = THETA(2,2) / COSF(U(2,2)) * SINF(U(2,2))/3.                   M;N1!364
      R = SINF(THETA(2,2) -U(2,2)) / COSF(THETA(2,2) - U(2,2))          M;N1!365
    7 CALL GAMMA (P1)                                                   M;N1!366
       IF(ISENSW(18))   90,8,90                                         M;N1!367
    8 TEMP = Q - ZM / (R- SINF(ZMU) /COSF(ZMU))                         M;N1!368
      VE(2,1) = (- 6.*VE(2,2)* (1.+TEMP) - VE(2,2)*SQRTF( 16.+ 120.*    M;N1!369
     1  TEMP+9.* TEMP**2))/ (9.*TEMP -  10.)                            M;N1!370
  109 IF(ABSF(VE(2,1)-V)-1.E-3)  10,10,12                               M;N1!371
  12  P1=P1+ V/TOM*(V-VE(2,1))/49719.22                                 M;N1!372
      GO TO  7                                                          M;N1!373
   10 W(2,1) = 0                                                        M;N1!374
       Z(2,1) = 0                                                       M;N1!375
       PR(2,1)= P                                                       M;N1!376
       T (2,1)= TOM                                                     M;N1!377
       Y(2,1) = 0                                                       M;N1!378
       THETA(2,1) = 0                                                   M;N1!379
       X(2,1) = X(2,2) -2.* Y(2,2)/( SINF(THETA(2,2)-U(2,2))/COSF(THETA M;N1!380
     1  (2,2) -U(2,2)) - SINF(ZMU)/COSF(ZMU) )                          M;N1!381
       U(2,1) = ZMU                                                     M;N1!382
       ID (2,1) = ID(2,2) + 1                                           M;N1!383
  90   RETURN                                                           M;N1!384
C                                                                       M;N1!385
* COMPILE, PRINT SAP, PUNCH OBJECT                              CPT20000        
C   HYPERBOLIC RELATION ASSUMED FOR WEIGHT FLOW                         M;N1!387
      SUBROUTINE CPOINT (IA,LA,IB,LB,IC,LC)                             M;N1!388
      COMMON A, ASTAR,PLN,GAM,ZMACH,YP,YPP, TEMP,P,PHI,DPHI, D2PHI,V,   M;N1!389
     1TOM, ZMU, ALPHA,EPS, YT,DELY, ZMACH1,ZMACH2, PLGMX, CON1, CON2,   M;N1!390
     2 CON3, CON4, CON5, CON6, MM, XF, C,STREM, K, J, MAXT,IMAX, IPCH,  M;N1!391
     3 IS, MAX, KPCH, ISENSW, ID, X, Y, THETA, W,Z,T, PR                M;N1!392
     4,U,VE , PA, XLENTH,TC1, TC2, TC3, TC4,S,TTA,TTB,SS,BX,BY,THV ,KNT M;N1!393
     5  ,PMIN                                                           M;N1!394
      DIMENSION         CON1(7 ),CON2( 7),CON3( 7),CON4( 7),CON5( 7),   M;N1!395
     1  CON6(7 ),PLGMX(7),C(3,9) , MM(3),XF(3), U (2,75), VE(2 ,75),    M;N1!396
     2  X(2,75 ),Y(2,75  ), THETA(2,75 ), W(2, 75),Z(2,75 ) ,ID(2,75)   M;N1!397
     4 , STREM(10), T(2,75) , PR(2,75)     ,ISENSW(36)                  M;N1!398
     5  ,TTA(10),TTB(10),SS(10), BX(10), BY(10)                         M;N1!399
      TANF(R) = SINF(R)/COSF(R)                                         M;N1!400
      L = 0                                                             M;N1!401
      KNT = 0                                                           M;N1!402
      P1 =  LOGF ((PR(IA,LA) +PR(IB,LB))/2.)                            M;N1!403
      TH1 =  (THETA(IA,LA)+ THETA(IB,LB)) /2.                           M;N1!404
       TB = TANF( THETA(IB,LB) -U(IB,LB))                               M;N1!405
       TA = TANF( THETA(IA,LA) +U(IA,LA))                               M;N1!406
      TNUA = TANF(U(IA,LA))                                             M;N1!407
      TNUB = TANF(U(IB,LB))                                             M;N1!408
       IF(Y(IA,LA)) 65,67,65                                            M;N1!409
   65  AL =     TNUA      *SINF(U(IA,LA)) / Y(IA,LA)* SINF(THETA (IA,LA)M;N1!410
     1   ) / COSF( THETA(IA,LA)+U(IA,LA))                               M;N1!411
   67  BM=        TNUB   *SINF(U(IB,LB)) /Y(IB,LB)*SINF( THETA (IB,LB)) M;N1!412
     1      / COSF ( THETA(IB,LB)- U(IB,LB))                            M;N1!413
  70   CALL GAMMA (P1)                                                  M;N1!414
       IF(ISENSW(18)) 99,171,99                                         M;N1!415
 171  TNU = TANF(ZMU)                                                   M;N1!416
       TANA =(TA + TANF(TH1 + ZMU))/2.                                  M;N1!417
       TANB = (TB+ TANF(TH1 - ZMU))/2.                                  M;N1!418
      ZVA = 2.* VE(IA,LA) / (VE(IA,LA) +  V)                            M;N1!419
      ZVB = 2.* VE(IB,LB) / (VE(IB,LB) +  V)                            M;N1!420
      TUB = (TNUB  + TNU ) / 2.                                         M;N1!421
      TUA =  ( TNUA + TNU) / 2.                                         M;N1!422
      ZA = (VE(IA,LA) +V)/ 2.                                           M;N1!423
      ZB  = (VE(IB,LB) + V) /2.                                         M;N1!424
   72  EX   =(Y(IA,LA)-Y(IB,LB) +TANB* X(IB,LB) - TANA*X(IA,LA)) /      M;N1!425
     1    (TANB-TANA)                                                   M;N1!426
       EY      = Y(IA,LA)+ ( E X     -X(IA,LA))* TANA                   M;N1!427
      IF (Y(IA,LA)) 71,73,71                                            M;N1!428
  73  ZL =2.*(4./ (3.*VE(IA,LA)+V) * (V-VE(IA,LA))/ (EX-X(IA,LA)) -     M;N1!429
     1  (3.*     TNUA  +  TNU         )/4. * TH1/(EX-X(IA,LA)) +        M;N1!430
     2     TNU   /2. * SINF(ZMU)/EY*SINF(TH1)/ COSF(TH1+ZMU))/3.        M;N1!431
      GO TO 74                                                          M;N1!432
  71   ZL  = ( AL  +      TNU   *SINF(ZMU) /  E Y    * SINF(TH1) /      M;N1!433
     1      COSF(TH1+ ZMU) ) /2.                                        M;N1!434
  74  ZMB = ( BM +      TNU *SINF(ZMU)  /   E Y   *SINF(TH1) /COSF(TH1  M;N1!435
     1     - ZMU) ) / 2.                                                M;N1!436
       EV       = ( (ZVA + ZL*( E X     -X(IA,LA)))/ TUA +  ( ZVB +     M;N1!437
     1   ZMB* ( E X     -X(IB,LB))) / TUB +THETA(IB,LB)-THETA(IA,LA) )  M;N1!438
     2   /(  1./(ZA *TUA) + 1./(ZB* TUB) )                              M;N1!439
      ETH          = THETA(IA,LA)+ ( ( E V   -  VE(IA,LA))/ZA - ZL*     M;N1!440
     1  (  E X     -X(IA,LA)))/ TUA                                     M;N1!441
      IF(ISENSW(27))    170,76,170                                      M;N1!442
170   WRITE OUTPUT TAPE 6,172, EX, EY, ETH, TH1,P1,P, EV, V, TOM        M;N1!443
172   FORMAT(5F13.7,4F13.4)                                             M;N1!444
  76   IF ( ABSF(TH1-E TH    )    - 1.E-5) 75 ,75 ,77                   M;N1!445
   75  IF ( ABSF(V - EV  )   -5.E-2    )  80 , 80, 77                   M;N1!446
   77 P1 = P1 -  V/TOM *( E V      - V) /49719.22                       M;N1!447
       IF(P1-PMIN)  278,280,280                                         M;N1!448
 278  IF(L-8)  279,279,280                                              M;N1!449
 279  P1 = PMIN                                                         M;N1!450
      L = L+1                                                           M;N1!451
 280  TH1 =  (TH1+ETH) / 2.                                             M;N1!452
      GO TO 70                                                          M;N1!453
   80 X(IC,LC)=EX                                                       M;N1!454
      PR(IC,LC) =P                                                      M;N1!455
      Y(IC,LC) =EY                                                      M;N1!456
      VE(IC,LC) =  V                                                    M;N1!457
      THETA(IC,LC)= ETH                                                 M;N1!458
       U(IC,LC) =ZMU                                                    M;N1!459
       T(IC,LC) = TOM                                                   M;N1!460
   83 ID(IC,LC) =(ID(IB,LB)/100) *100  + ID(IA,LA)- 100*(ID(IA,LA)/100) M;N1!461
       W(IC,LC) = W(IA,LA) + .00101581816  *2.       *  (  E V*EY  *    M;N1!462
     1   (COSF( ETH     )   -SINF(  E TH  )    /TANF(  E TH +  ZMU ) )  M;N1!463
     2     *P/TOM +VE(IA,LA) * (COSF(THETA(IA,LA)) -SINF(THETA(IA,LA))  M;N1!464
     5  /TA) * Y(IA,LA)                                                 M;N1!465
     3     *PR(IA,LA)/T(IA,LA) )*(  E Y      -Y(IA,LA)    )             M;N1!466
      Z(IC,LC)  = (Z(IA,LA) *W(IA,LA) +(W(IC,LC) -W(IA,LA))/64.348      M;N1!467
     1  *(VE(IA,LA) * COSF(THETA(IA,LA)) +   EV     *COSF(  ETH       ))M;N1!468
     2         + 3.14159265      *(PR(IA,LA) + P        ) /2.*          M;N1!469
     3       (EY * E Y     -Y(IA,LA)*Y(IA,LA)) ) /W(IC,LC)              M;N1!470
 99   RETURN                                                            M;N1!471
C                                                                       M;N1!472
* COMPILE, PRINT SAP, PUNCH OBJECT                              STRM0000        
      SUBROUTINE STREAM (I,LC,K,LA)                                     M;N1!474
      COMMON A, ASTAR,PLN,GAM,ZMACH,YP,YPP, TEMP,P,PHI,DPHI, D2PHI,V,   M;N1!475
     1TOM, ZMU, ALPHA,EPS, YT,DELY, ZMACH1,ZMACH2, PLGMX, CON1, CON2,   M;N1!476
     2 CON3, CON4, CON5, CON6, MM, XF, C,STREM, K, J, MAXT,IMAX, IPCH,  M;N1!477
     3 IS, MAX, KPCH, ISENSW, ID, X, Y, THETA, W,Z,T, PR                M;N1!478
     4,U,VE      ,PA,XLENTH,TC1,TC2,TC3,TC4,TC5,TA,TB,S,BX,BY           M;N1!479
      DIMENSION         CON1(7 ),CON2( 7),CON3( 7),CON4( 7),CON5( 7),   M;N1!480
     1  CON6(7 ),PLGMX(7),C(3,9) , MM(3),XF(3), U (2,75), VE(2 ,75),    M;N1!481
     2  X(2,75 ),Y(2,75  ), THETA(2,75 ), W(2, 75),Z(2,75 ) ,ID(2,75)   M;N1!482
     4 , STREM(10), T(2,75) , PR(2,75)     ,ISENSW(36)                  M;N1!483
     5   ,TA(10), TB(10), S(10), BX(10), BY(10)                         M;N1!484
      DO 7 M=1,IS                                                       M;N1!485
      IF(W(I,LC) - STREM(M)) 7,6,6                                      M;N1!486
  6   IF (W(K,LA) - STREM(M)) 8,8,7                                     M;N1!487
   8  TEMP = (STREM(M) - W(K,LA)) / (W(I,LC) - W(K,LA))                 M;N1!488
      EX = X(K,LA)+ (X(I,LC) - X(K,LA)) * TEMP                          M;N1!489
      EY = Y(K,LA) + (Y(I,LC) - Y(K,LA)) * TEMP                         M;N1!490
      TH =(THETA(K,LA)+(THETA(I,LC)-THETA(K,LA)) * TEMP)* 57.29578      M;N1!491
      EZ= Z(K,LA) + (Z(I,LC) - Z(K,LA)) * TEMP                          M;N1!492
      EP = PR(K,LA) + (PR(I,LC) - PR(K,LA)) * TEMP                      M;N1!493
      EV =  VE(K,LA)+(VE(I,LC)-VE(K,LA))* TEMP                          M;N1!494
        TE MP = SQRTF(( EX-BX(M))**2 + (EY-BY(M))**2)                   M;N1!495
       P1  = LOGF(EP)                                                   M;N1!496
        T1  = EXPF((( TC4*P1+ TC3)*P1 + TC2)*P1+TC1)                    M;N1!497
      IF (TA(M)) 17,9,17                                                M;N1!498
  9   DT=0.                                                             M;N1!499
      GO TO 11                                                          M;N1!500
 17    DT  =EV/TEMP * ((T1-TA(M))*(2. -S(M)/(S(M)+ TEMP))-              M;N1!501
     1(TEMP +S(M))/ S(M)        * (TB(M)-TA(M)) )  * 12.                M;N1!502
   11 WRITE OUTPUT TAPE 6,300,EX,EY, TH, EZ, STREM(M), EP, DT           M;N1!503
       IF  ( ISENSW(34)) 10,10,12                                       M;N1!504
 12    WRI TE OUTPUT TAPE 6,300,EV,T1,TB(M), TA(M), S(M), BX(M),BY(M)   M;N1!505
  10   TA( M) = TB(M)                                                   M;N1!506
       BX( M) = EX                                                      M;N1!507
       BY( M) = EY                                                      M;N1!508
       TB( M) = T1                                                      M;N1!509
   13  S(M ) =       TEMP                                               M;N1!510
   7  CONTINUE                                                          M;N1!511
   20  RETURN                                                           M;N1!512
  300 FORMAT(11H0STREAMLINEF14.7,5F15.7,1PE15.5,3H=DT//)                M;N1!513
C                                                                       M;N1!514
* COMPILE, PRINT SAP, PUNCH OBJECT                              GAMA0000        
      SUBROUTINE GAMMA  (PL  )                                          M;N1!516
      COMMON A, ASTAR,PLN,GAM,ZMACH,YP,YPP, TEMP,P,PHI,DPHI, D2PHI,V,   M;N1!517
     1TOM, ZMU, ALPHA,EPS, YT,DELY, ZMACH1,ZMACH2, PLGMX, CON1, CON2,   M;N1!518
     2 CON3, CON4, CON5, CON6, MM, XF, C,STREM, K, J, MAXT,IMAX, IPCH,  M;N1!519
     3 IS, MAX, KPCH, ISENSW, ID, X, Y, THETA, W,Z,T, PR                M;N1!520
     4,U,VE , PA, XLENTH,TC1, TC2, TC3, TC4,S,TA,TB,SS,BX,BY,THV ,KNT   M;N1!521
     5  ,PMIN                                                           M;N1!522
      DIMENSION         CON1(7 ),CON2( 7),CON3( 7),CON4( 7),CON5( 7),   M;N1!523
     1  CON6(7 ),PLGMX(7),C(3,9) , MM(3),XF(3), U (2,75), VE(2 ,75),    M;N1!524
     2  X(2,75 ),Y(2,75  ), THETA(2,75 ), W(2, 75),Z(2,75 ) ,ID(2,75)   M;N1!525
     4 , STREM(10), T(2,75) , PR(2,75)     ,ISENSW(36)                  M;N1!526
     5   ,TA(10), TB(10),SS(10), BX(10), BY(10)                         M;N1!527
      PLOG = PL                                                         M;N1!528
       IF (PLOG-PMIN)  25,34,34                                         M;N1!529
 25   ISENSW(18) = 1                                                    M;N1!530
  34  DO 35 L=1,IMAX                                                    M;N1!531
      IF(PLOG-PLGMX(L)) 37,37,35                                        M;N1!532
   35 CONTINUE                                                          M;N1!533
      WRITE OUTPUT TAPE 6,110, PLOG, PLGMX(IMAX)                        M;N1!534
      L = IMAX                                                          M;N1!535
      KNT = KNT +1                                                      M;N1!536
      IF(KNT-10) 37,50,50                                               M;N1!537
   37 PHI= ((((CON6(L)*PLOG +CON5(L))*PLOG +CON4(L))*PLOG +CON3(L))*    M;N1!538
     1   PLOG +CON2(L))*PLOG +CON1(L)                                   M;N1!539
      DPHI= (((5.* CON6(L)*PLOG+ 4.*CON5(L))*PLOG+ 3.*CON4(L))*PLOG+    M;N1!540
     1   2.*CON3(L))*PLOG+ CON2(L)                                      M;N1!541
      D2PHI = ((20.*CON6(L)*PLOG+12.*CON5(L))*PLOG+6.*CON4(L))*PLOG +   M;N1!542
     1   2.*CON3(L)                                                     M;N1!543
      GAM=DPHI /(DPHI-D2PHI)                                            M;N1!544
      TOM = DPHI* (-.90580622)                                          M;N1!545
      A= SQRTF(GAM*TOM ) * 223.05115                                    M;N1!546
      V= 300.11991 * SQRTF( PHI)                                        M;N1!547
       PHI = V/A                                                        M;N1!548
      ZMU = ATANF( 1./SQRTF( PHI *PHI -1.))                             M;N1!549
      P= EXPF(PLOG)                                                     M;N1!550
   45 RETURN                                                            M;N1!551
  50  CONTINUE                                                          M;N1!552
  110 FORMAT(5H LNP=F11.5,14H EXCEEDS TABLEF9.5)                        M;N1!553
C                                                                       M;N1!554
