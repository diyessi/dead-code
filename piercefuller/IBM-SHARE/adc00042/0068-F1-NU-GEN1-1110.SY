C  NU GEN1 GENERATE MATRICES FOR NU TPL1                                     001
C     ALSO FOR NU HLU, USE SENSE SWITCH 3 DOWN                          GEN1 002
C     THIS  DECK  HAS  245   CARDS                                      GEN1 003
      DIMENSIONAM(80,80),D(80,80),E(80,80),G(80) ,                      GEN1 004
     1AMB(40,40),AMC(40,40),AMA(40,40)           ,                      GEN1 005
     2DB(40,40),DC(40,40),DA(40,40)              ,                      GEN1 006
     3EB(40,40),EC(40,40),EA(40,40),GG(40)       ,                      GEN1 007
     4IPISUM(50),IPITOT(100),IPART(100)                                 GEN1 008
      COMMON AM,AMB,IPISUM,IPITOT,N,M,MMAX,IMQ,IPART                    GEN1 009
      EQUIVALENCE(AM,D,E,G),                                            GEN1 010
     1(AMB,AMC,AMA,DB,DC,DA,EB,EC,EA,GG)                                GEN1 011
      DO 410 I=1,100                                                    GEN1 012
 410  IPART(I)=0.0                                                      GEN1 013
      CALLINPUT                                                         GEN1 014
C     INPUT SHOULD CONTAIN IMQ (THE NO. OF M MATRICES IN Q)             GEN1 015
C     AND ANY OTHER VARIABLE DATA NECESSARY.                            GEN1 016
C     IF SS3 IS USED, IPART SHOULD BE READ IN AT INPUT TIME.            GEN1 017
      DO10N=1,IMQ                                                       GEN1 018
      KK=IT(N)                                                          GEN1 019
      MMAX=KK                                                           GEN1 020
      CALL IPISU                                                        GEN1 021
      IPITOT(N)=IPISUM(MMAX+1)                                          GEN1 022
      CALLFORMAM                                                        GEN1 023
      IMAX=IPITOT(N)                                                    GEN1 024
      JMAX=IMAX                                                         GEN1 025
 10   WRITE TAPE 2,((AM(I,J),I=1,IMAX),J=1,JMAX)                        GEN1 026
      END FILE2                                                         GEN1 027
      REWIND2                                                           GEN1 028
      IJK=1                                                             GEN1 029
      DO110N=2,IMQ                                                      GEN1 030
      IF(SENSE SWITCH 3)111,113                                         GEN1 031
 111  IF(N-IPART(IJK))110,112,110                                       GEN1 032
 112  IJK=IJK+1                                                         GEN1 033
 113  KK=IT(N)                                                          GEN1 034
      MMAX=KK                                                           GEN1 035
      CALL IPISU                                                        GEN1 036
      CALL FORM D                                                       GEN1 037
      IMAX=IPITOT(N)                                                    GEN1 038
      JMAX=IPITOT(N-1)                                                  GEN1 039
      WRITE TAPE 3,((D(I,J),I=1,IMAX),J=1,JMAX)                         GEN1 040
 110  CONTINUE                                                          GEN1 041
      ENDFILE3                                                          GEN1 042
      REWIND3                                                           GEN1 043
      IMQ2=IMQ-1                                                        GEN1 044
      DO210N=1,IMQ2                                                     GEN1 045
      KK=IT(N)                                                          GEN1 046
      MMAX=KK                                                           GEN1 047
      CALL IPISU                                                        GEN1 048
      CALLFORME                                                         GEN1 049
      IMAX=IPITOT(N)                                                    GEN1 050
      JMAX=IPITOT(N+1)                                                  GEN1 051
 210  WRITE TAPE 4,((E(I,J),I=1,IMAX),J=1,JMAX)                         GEN1 052
      ENDFILE4                                                          GEN1 053
      REWIND4                                                           GEN1 054
      DO310N=1,IMQ                                                      GEN1 055
      KK=IT(N)                                                          GEN1 056
      MMAX=KK                                                           GEN1 057
      CALL IPISU                                                        GEN1 058
      CALLFORMG                                                         GEN1 059
      IMAX=IPITOT(N)                                                    GEN1 060
 310  WRITETAPE5,(G(I),I=1,IMAX)                                        GEN1 061
      ENDFILE5                                                          GEN1 062
      REWIND5                                                           GEN1 063
      PUNCH6,IMQ                                                        GEN1 064
 6    FORMAT(I3)                                                        GEN1 065
      PUNCH7,(IPITOT(N),N=1,IMQ)                                        GEN1 066
 7    FORMAT(24I3)                                                      GEN1 067
      PRINT4                                                            GEN1 068
 4    FORMAT(34H ALL MATRICES HAVE BEEN GENERATED.//                    GEN1 069
     X16H M IS ON TAPE 2.//                                             GEN1 070
     X16H D IS ON TAPE 3.//                                             GEN1 071
     X16H E IS ON TAPE 4.//                                             GEN1 072
     X16H G IS ON TAPE 5.)                                              GEN1 073
      PRINT  5, IMQ,(N,IPITOT(N),N=1,IMQ)                               GEN1 074
 5    FORMAT(////23H NUMBER OF M MATRICES =I3//                         GEN1 075
     X(16H DIMENSION OF M I3,4H IS I3))                                 GEN1 076
      PAUSE12345                                                        GEN1 077
      END(2,2,2,2,2)                                                    GEN1 078
      SUBROUTINEFORMAM                                                  GEN1 079
      DIMENSIONAM(80,80),D(80,80),E(80,80),G(80) ,                      GEN1 080
     1AMB(40,40),AMC(40,40),AMA(40,40)           ,                      GEN1 081
     2DB(40,40),DC(40,40),DA(40,40)              ,                      GEN1 082
     3EB(40,40),EC(40,40),EA(40,40),GG(40)       ,                      GEN1 083
     4IPISUM(50),IPITOT(100),IPART(100)                                 GEN1 084
      COMMON AM,AMB,IPISUM,IPITOT,N,M,MMAX,IMQ,IPART                    GEN1 085
      EQUIVALENCE(AM,D,E,G),                                            GEN1 086
     1(AMB,AMC,AMA,DB,DC,DA,EB,EC,EA,GG)                                GEN1 087
      DO20M=1,MMAX                                                      GEN1 088
      IMAX=IPI(M,N)                                                     GEN1 089
      JMAX=IMAX                                                         GEN1 090
      II=IPISUM(M)                                                      GEN1 091
      JJ=II                                                             GEN1 092
      CALLAMBS                                                          GEN1 093
      DO20I=1,IMAX                                                      GEN1 094
      III=I+II                                                          GEN1 095
      DO20J=1,JMAX                                                      GEN1 096
      JJJ=J+JJ                                                          GEN1 097
 20   AM(III,JJJ)=AMB(I,J)                                              GEN1 098
      MMAX2=MMAX-1                                                      GEN1 099
      DO30M=1,MMAX2                                                     GEN1 100
      IMAX=IPI(M,N)                                                     GEN1 101
      JMAX=IPI(M+1,N)                                                   GEN1 102
      II=IPISUM(M)                                                      GEN1 103
      JJ=IPISUM(M+1)                                                    GEN1 104
      CALLAMCS                                                          GEN1 105
      DO30I=1,IMAX                                                      GEN1 106
      III=I+II                                                          GEN1 107
      DO30J=1,JMAX                                                      GEN1 108
      JJJ=J+JJ                                                          GEN1 109
 30   AM(III,JJJ)=AMC(I,J)                                              GEN1 110
      DO40M=2,MMAX                                                      GEN1 111
      IMAX=IPI(M,N)                                                     GEN1 112
      JMAX=IPI(M-1,N)                                                   GEN1 113
      II=IPISUM(M)                                                      GEN1 114
      JJ=IPISUM(M-1)                                                    GEN1 115
      CALLAMAS                                                          GEN1 116
      DO40I=1,IMAX                                                      GEN1 117
      III=I+II                                                          GEN1 118
      DO40J=1,JMAX                                                      GEN1 119
      JJJ=J+JJ                                                          GEN1 120
 40   AM(III,JJJ)=AMA(I,J)                                              GEN1 121
      RETURN                                                            GEN1 122
      END(2,2,2,2,2)                                                    GEN1 123
      SUBROUTINEFORMD                                                   GEN1 124
      DIMENSIONAM(80,80),D(80,80),E(80,80),G(80) ,                      GEN1 125
     1AMB(40,40),AMC(40,40),AMA(40,40)           ,                      GEN1 126
     2DB(40,40),DC(40,40),DA(40,40)              ,                      GEN1 127
     3EB(40,40),EC(40,40),EA(40,40),GG(40)       ,                      GEN1 128
     4IPISUM(50),IPITOT(100),IPART(100)                                 GEN1 129
      COMMON AM,AMB,IPISUM,IPITOT,N,M,MMAX,IMQ,IPART                    GEN1 130
      EQUIVALENCE(AM,D,E,G),                                            GEN1 131
     1(AMB,AMC,AMA,DB,DC,DA,EB,EC,EA,GG)                                GEN1 132
      DO120M=1,MMAX                                                     GEN1 133
      IMAX=IPI(M,N)                                                     GEN1 134
      JMAX=IPI(M,N-1)                                                   GEN1 135
      II=IPISUM(M)                                                      GEN1 136
      JJ=II                                                             GEN1 137
      CALLDBS                                                           GEN1 138
      DO120I=1,IMAX                                                     GEN1 139
      III=I+II                                                          GEN1 140
      DO120J=1,JMAX                                                     GEN1 141
      JJJ=J+JJ                                                          GEN1 142
 120  D(III,JJJ)=DB(I,J)                                                GEN1 143
      MMAX2=MMAX-1                                                      GEN1 144
      DO130M=1,MMAX2                                                    GEN1 145
      IMAX=IPI(M,N)                                                     GEN1 146
      JMAX=IPI(M+1,N-1)                                                 GEN1 147
      II=IPISUM(M)                                                      GEN1 148
      JJ=IPISUM(M+1)                                                    GEN1 149
      CALLDCS                                                           GEN1 150
      DO130I=1,IMAX                                                     GEN1 151
      III=I+II                                                          GEN1 152
      DO130J=1,JMAX                                                     GEN1 153
      JJJ=J+JJ                                                          GEN1 154
 130  D(III,JJJ)=DC(I,J)                                                GEN1 155
      DO140M=2,MMAX                                                     GEN1 156
      IMAX=IPI(M,N)                                                     GEN1 157
      JMAX=IPI(M-1,N-1)                                                 GEN1 158
      II=IPISUM(M)                                                      GEN1 159
      JJ=IPISUM(M-1)                                                    GEN1 160
      CALLDAS                                                           GEN1 161
      DO140I=1,IMAX                                                     GEN1 162
      III=I+II                                                          GEN1 163
      DO140J=1,JMAX                                                     GEN1 164
      JJJ=J+JJ                                                          GEN1 165
 140  D(III,JJJ)=DA(I,J)                                                GEN1 166
      RETURN                                                            GEN1 167
      END(2,2,2,2,2)                                                    GEN1 168
      SUBROUTINEFORME                                                   GEN1 169
      DIMENSIONAM(80,80),D(80,80),E(80,80),G(80) ,                      GEN1 170
     1AMB(40,40),AMC(40,40),AMA(40,40)           ,                      GEN1 171
     2DB(40,40),DC(40,40),DA(40,40)              ,                      GEN1 172
     3EB(40,40),EC(40,40),EA(40,40),GG(40)       ,                      GEN1 173
     4IPISUM(50),IPITOT(100),IPART(100)                                 GEN1 174
      COMMON AM,AMB,IPISUM,IPITOT,N,M,MMAX,IMQ,IPART                    GEN1 175
      EQUIVALENCE(AM,D,E,G),                                            GEN1 176
     1(AMB,AMC,AMA,DB,DC,DA,EB,EC,EA,GG)                                GEN1 177
      DO220M=1,MMAX                                                     GEN1 178
      IMAX=IPI(M,N)                                                     GEN1 179
      JMAX=IPI(M,N+1)                                                   GEN1 180
      II=IPISUM(M)                                                      GEN1 181
      JJ=II                                                             GEN1 182
      CALLEBS                                                           GEN1 183
      DO220I=1,IMAX                                                     GEN1 184
      III=I+II                                                          GEN1 185
      DO220J=1,JMAX                                                     GEN1 186
      JJJ=J+JJ                                                          GEN1 187
 220  E(III,JJJ)=EB(I,J)                                                GEN1 188
      MMAX2=MMAX-1                                                      GEN1 189
      DO230M=1,MMAX2                                                    GEN1 190
      IMAX=IPI(M,N)                                                     GEN1 191
      JMAX=IPI(M+1,N+1)                                                 GEN1 192
      II=IPISUM(M)                                                      GEN1 193
      JJ=IPISUM(M+1)                                                    GEN1 194
      CALLECS                                                           GEN1 195
      DO230I=1,IMAX                                                     GEN1 196
      III=I+II                                                          GEN1 197
      DO230J=1,JMAX                                                     GEN1 198
      JJJ=J+JJ                                                          GEN1 199
 230  E(III,JJJ)=EC(I,J)                                                GEN1 200
      DO240M=2,MMAX                                                     GEN1 201
      IMAX=IPI(M,N)                                                     GEN1 202
      JMAX=IPI(M-1,N+1)                                                 GEN1 203
      II=IPISUM(M)                                                      GEN1 204
      JJ=IPISUM(M-1)                                                    GEN1 205
      CALLEAS                                                           GEN1 206
      DO240I=1,IMAX                                                     GEN1 207
      III=I+II                                                          GEN1 208
      DO240J=1,JMAX                                                     GEN1 209
      JJJ=J+JJ                                                          GEN1 210
 240  E(III,JJJ)=EA(I,J)                                                GEN1 211
      RETURN                                                            GEN1 212
      END(2,2,2,2,2)                                                    GEN1 213
      SUBROUTINEFORMG                                                   GEN1 214
      DIMENSIONAM(80,80),D(80,80),E(80,80),G(80) ,                      GEN1 215
     1AMB(40,40),AMC(40,40),AMA(40,40)           ,                      GEN1 216
     2DB(40,40),DC(40,40),DA(40,40)              ,                      GEN1 217
     3EB(40,40),EC(40,40),EA(40,40),GG(40)       ,                      GEN1 218
     4IPISUM(50),IPITOT(100),IPART(100)                                 GEN1 219
      COMMON AM,AMB,IPISUM,IPITOT,N,M,MMAX,IMQ,IPART                    GEN1 220
      EQUIVALENCE(AM,D,E,G),                                            GEN1 221
     1(AMB,AMC,AMA,DB,DC,DA,EB,EC,EA,GG)                                GEN1 222
      DO320M=1,MMAX                                                     GEN1 223
      IMAX=IPI(M,N)                                                     GEN1 224
      II=IPISUM(M)                                                      GEN1 225
      CALL   GS                                                         GEN1 226
      DO320I=1,IMAX                                                     GEN1 227
      III=I+II                                                          GEN1 228
 320  G(III)=GG(I)                                                      GEN1 229
      RETURN                                                            GEN1 230
      END(2,2,2,2,2)                                                    GEN1 231
      SUBROUTINE   IPISU                                                GEN1 232
      DIMENSIONAM(80,80),D(80,80),E(80,80),G(80) ,                      GEN1 233
     1AMB(40,40),AMC(40,40),AMA(40,40)           ,                      GEN1 234
     2DB(40,40),DC(40,40),DA(40,40)              ,                      GEN1 235
     3EB(40,40),EC(40,40),EA(40,40),GG(40)       ,                      GEN1 236
     4IPISUM(50),IPITOT(100),IPART(100)                                 GEN1 237
      COMMON AM,AMB,IPISUM,IPITOT,N,M,MMAX,IMQ,IPART                    GEN1 238
      EQUIVALENCE(AM,D,E,G),                                            GEN1 239
     1(AMB,AMC,AMA,DB,DC,DA,EB,EC,EA,GG)                                GEN1 240
      IPISUM(1)=0                                                       GEN1 241
      DO11M=1,MMAX                                                      GEN1 242
 11   IPISUM(M+1)=IPISUM(M)+IPI(M,N)                                    GEN1 243
      RETURN                                                            GEN1 244
      END(2,2,2,2,2)                                                    GEN1 245
