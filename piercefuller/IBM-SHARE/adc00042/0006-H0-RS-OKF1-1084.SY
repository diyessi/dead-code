       PAX     0,2                                                      OKF10593
27L2   TXH     28L,2,**            16    IF(L2-L)28,17,17               OKF10594
17L    CLA     IJ+1,2              17    J=IJ(L)                        OKF10595
       PDX     0,4                                                      OKF10596
18L    ZET     NL+1,4                    IF(NL(J))27,19,27              OKF10597
       TXI     27L2,2,1                                                 OKF10598
19L    CLA     KC+1,2              19    IF(KC(L))20,20,21              OKF10599
19L1   TZE     20L                                                      OKF10600
       TPL     21L                                                      OKF10601
20L    CLA     KX+1,2              20    IF(KX(L)-KU(L))22,27,27        OKF10602
       SUB     KU+1,2                                                   OKF10603
20L1   TZE     27L                                                      OKF10604
