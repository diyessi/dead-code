49L    AXT     **,1                      RETURN                         OKF10672
       AXT     **,2                                                     OKF10673
       AXT     **,4                                                     OKF10674
       TRA     2,4                                                      OKF10675
KTRR   BSS     1                                                        OKF10676
I      BSS     1                                                        OKF10677
NU     BSS     1                         END                            OKF10678
       EJECT                                                            OKF10679
BREAKT SXA     47A,1               SUBROUTINE BREAKT                    OKF10680
       SXA     47A+1,2                                                  OKF10681
       SXA     47A+2,4                                                  OKF10682
5A     CLA     LC-4                 LC(5)=LC(5)+1                       OKF10683
       ADD     =1B35                                                    OKF10684
       STO     LC-4                                                     OKF10685
       LDQ     MINE                                                     OKF10686
7A     STZ     LER                 LER=0                                OKF10687
10A    CLA     KTER                KT=KTER                              OKF10688
       PDX     0,2                                                      OKF10689
11A    AXT     1,4                 DO 29 J=1,M                          OKF10690
       CLA     M                                                        OKF10691
       STD     29A2                                                     OKF10692
12A    CLA     NL+1,2              KP=NL(KT)                            OKF10693
       STO     KP                                                       OKF10694
