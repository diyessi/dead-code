16A    CLA     KC+1,1         16   IF(KC(KK))17,19,19                   OKF10700
       TZE     19A                                                      OKF10701
       TPL     19A                                                      OKF10702
17A    CLA     KX+1,1              MINE=XMIN0F(MINE,KX(KK)-KU(KK))      OKF10703
       SUB     KU+1,1                                                   OKF10704
       TLQ     *+2                                                      OKF10705
       XCA                                                              OKF10706
18A    TRA     21A                 GO TO 21                             OKF10707
19A    CLA     KX+1,1              MINE=XMIN0F(MINE,KX(KK))             OKF10708
       TLQ     *+2                                                      OKF10709
       XCA                                                              OKF10710
21A    PXA     0,1            21   CALL PLACE(32767-KK,IJ(J))           OKF10711
       COM                                                              OKF10712
       STA     IJ+1,4                                                   OKF10713
22A    TRA     29A                 GO TO 29                             OKF10714
23A    CLA     KC+1,1         23   IF(KC(KK))  24,24,26                 OKF10715
       TZE     24A                                                      OKF10716
       TPL     26A                                                      OKF10717
24A    CLA     KU+1,1         24   MINE=XMIN0F(MINE,KU(KK)-KX(KK))      OKF10718
       SUB     KX+1,1                                                   OKF10719
