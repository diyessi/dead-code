       TXI     27L2,2,1                                                 OKF10606
21L    CLA     KX+1,2              21    IF(KX(L))22,27,27              OKF10607
       TZE     27L                                                      OKF10608
       TPL     27L                                                      OKF10609
22L    SXA     I,2                 22    CALL PLACE(L,I)                OKF10610
23L    CLA     I                         NL(J)= I                       OKF10611
       STO     NL+1,4                                                   OKF10612
24L    PXA     0,4                       CALL PLACE(J,IJ(NUP))          OKF10613
       LXD     NUP,4                                                    OKF10614
       STA     IJ+1,4                                                   OKF10615
25L    TXI     25L2,4,1                  NUP=NUP+1                      OKF10616
25L2   SXD     NUP,4                                                    OKF10617
26L    SUB     KTRR                      IF(L-KTER)27,47,27             OKF10618
       TZE     47L                 27    L=L+1                          OKF10619
27L    TXI     27L2,2,1                  GO TO 16                       OKF10620
28L    CLA     JL,1                28    L2=LADDR(JL(I+1))-1            OKF10621
       PAX     0,2                                                      OKF10622
       TXI     28L2,2,-1                                                OKF10623
28L2   SXD     42L2,2                                                   OKF10624
29L    CLA     JL+1,1                    L=LADDR(JL(I))                 OKF10625
       PAX     0,2                                                      OKF10626
42L2   TXH     43L,2,**                  IF(L2-L)43,31,31               OKF10627
31L    CLA     JI+1,2              31    J=JI(L)                        OKF10628
       PDX     0,4                                                      OKF10629
