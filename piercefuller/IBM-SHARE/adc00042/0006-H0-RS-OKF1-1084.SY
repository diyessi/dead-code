C     RS OKF1, OUT OF KILTER FLOW ROUTINE ONE, 1 MARCH 1961             RSOKF101
*      CARDSCOLUMN                                                      OKF10002
*      LIST                                                             OKF10003
      COMMON JI,KC,KU,KX,NL,NN,NP,IJ,IL,JL                              OKF10004
      COMMON M,N,LER,KAT,KOR,KTER,MINE,LC,KA,IFIN,KI,KO,KQ,K            OKF10005
      DIMENSION JI(4500),KC(4500),KU(4500),KX(4500),NL(1500),NN(1500)   OKF10006
      DIMENSION NP(1500),IJ(1500),IL(1501),JL(1501),LC(9),KA(12,2),KQ(9)OKF10007
      DIMENSION KE(101)                                                 OKF10008
      FREQUENCY 6(1000),27(3,1,0),38(0,1),7(0,1,0),25(0,1,0),8(100,1,5) OKF10009
C    SYSTEM INPUT TAPE                                                  OKF10010
      KI=5                                                              OKF10011
C    SYSTEM OUTPUT TAPE                                                 OKF10012
      KO=6                                                              OKF10013
C    SCRATCH TAPE                                                       OKF10014
      KQ(1)=4                                                           OKF10015
C    RESERVED OUTPUT TAPE                                               OKF10016
      KQ(2)=10                                                          OKF10017
C    RESERVED INPUT TAPE                                                OKF10018
      KQ(3)=9                                                           OKF10019
C    MAXIMUM ARCS(DIMENSION OF JI, KC, KU, AND KX)                      OKF10020
      KQ(4)=4500                                                        OKF10021
C    MAXIMUM NODES(DIMENSION OF NL, NN, NP, AND IJ)                     OKF10022
      KQ(5)=1500                                                        OKF10023
      KQ(6)=0                                                           OKF10024
      KQ(9)=0                                                           OKF10025
      IFIN=131071                                                       OKF10026
  100 CALL PREDAT(KS)                                                   OKF10027
      IF (KS) 1,200,1                                                   OKF10028
  200 CALL  ARCASY(L)                                                   OKF10029
      CALL MAKEJL                                                       OKF10030
      IF(LER-KQ(4)) 2,88,88                                             OKF10031
    2 LER=LER*KQ(8)                                                     OKF10032
      IF (L) 3,1,3                                                      OKF10033
    3 CALL NODASY                                                       OKF10034
    1 CALL READER                                                       OKF10035
      CALL TRANSL                                                       OKF10036
      IF (LER) 88,4,88                                                  OKF10037
    4 I=0                                                               OKF10038
      KUP=1                                                             OKF10039
      KE(101)=0                                                         OKF10040
    6 DO 26 K=1,N                                                       OKF10041
   27 IF(K-KUP) 38,39,39                                                OKF10042
   39 I=I+1                                                             OKF10043
      KUP=LADDR(IL(I+1))                                                OKF10044
   38 IF(SENSE SWITCH 5) 16,17                                          OKF10045
   17 CALL KILTER (I)                                                   OKF10046
    7 IF (LER) 25,26,25                                                 OKF10047
   25 IF (LER-107) 24,28,24                                             OKF10048
   28 KE(101)=KE(101)+1                                                 OKF10049
      KF=KE(101)                                                        OKF10050
    8 IF(KE(101)-100) 31,31,26                                          OKF10051
   31 KE(KF)=K                                                          OKF10052
   26 CONTINUE                                                          OKF10053
COMPLETED CHECKING ALL ARCS                                             OKF10054
      LER=0                                                             OKF10055
   99 CALL OUTPUT (KE)                                                  OKF10056
CYCLE BACK FOR ANOTHER RUN                                              OKF10057
      GO TO 100                                                         OKF10058
   16 WRITE OUTPUT TAPE KO,53                                           OKF10059
      LER=5555                                                          OKF10060
      GO TO 5                                                           OKF10061
   24 WRITE OUTPUT TAPE KO,54                                           OKF10062
    5 LL=IJ(K)                                                          OKF10063
      WRITE OUTPUT TAPE KO,55,NN(I),NN(LL)                              OKF10064
      GO TO 99                                                          OKF10065
   88 READ INPUT TAPE KI,51,KA(1,1)                                     OKF10066
      IF (LISTNO(KA(1,1),12HREADY PAUSE )-2) 90,90,88                   OKF10067
   90 BACKSPACE KI                                                      OKF10068
      GO TO 100                                                         OKF10069
   51 FORMAT(A6)                                                        OKF10070
   53 FORMAT(38H0JOB PULLED BY DEPRESSING SENSE SWITCH)                 OKF10071
   54 FORMAT(24H0OVERFLOW IN NODE PRICES)                               OKF10072
   55 FORMAT(23H0RUN TERMINATED AT ARC ,A6,1X,A6)                       OKF10073
       END                                                              OKF10074
*      CARDSCOLUMN                                                      OKF10075
*      LIST                                                             OKF10076
C   PREDAT. HANDLES INITIAL CONTROLS                                    OKF10077
      SUBROUTINE PREDAT(KS)                                             OKF10078
      COMMON JI,KC,KU,KX,NL,NN,NP,IJ,IL,JL                              OKF10079
      COMMON M,N,LER,KAT,KOR,KTER,MINE,LC,KA,IFIN,KI,KO,KQ,K            OKF10080
      DIMENSION JI(4500),KC(4500),KU(4500),KX(4500),NL(1500),NN(1500)   OKF10081
      DIMENSION NP(1500),IJ(1500),IL(1501),JL(1501),LC(9),KA(12,2),KQ(9)OKF10082
      DO 200 I=1,9                                                      OKF10083
  200 LC(I)=0                                                           OKF10084
      KOR=KQ(3)                                                         OKF10085
      KQ(7)=0                                                           OKF10086
      IF (SENSE SWITCH 5)11,20                                          OKF10087
   11 WRITE OUTPUT TAPE KO,97                                           OKF10088
      PRINT 97                                                          OKF10089
C           END JOB                                                     OKF10090
  180 IF(KQ(6)) 181,182,181                                             OKF10091
  181 K2=KQ(2)                                                          OKF10092
      WRITE OUTPUT TAPE KO,98                                           OKF10093
      PRINT 98                                                          OKF10094
      END FILE K2                                                       OKF10095
      GO TO 183                                                         OKF10096
  182 WRITE OUTPUT TAPE KO,99                                           OKF10097
      PRINT 99                                                          OKF10098
  183 CALL EXIT                                                         OKF10099
   20 KS=0                                                              OKF10100
   21 READ INPUT TAPE KI,90,(KA(I,1),I=1,12)                            OKF10101
      WRITE OUTPUT TAPE KO,91,(KA(I,1),I=1,12)                          OKF10102
      PRINT 93,(KA(I,1),I=2,12)                                         OKF10103
      L=LISTNO(KA,17HPAUSE SAVE  READY)                                 OKF10104
      GO TO (180,50,100,21),L                                           OKF10105
C           SAVE                                                        OKF10106
   50 KS=1                                                              OKF10107
    8 RETURN                                                            OKF10108
C           READY                                                       OKF10109
  100 IE=4*KQ(4)+3*KQ(5)+XMAX0F(KQ(4),3*KQ(5)+2)+3                      OKF10110
      DO 101 I=1,IE                                                     OKF10111
  101 JI(I)=0                                                           OKF10112
      KQ(8)=1                                                           OKF10113
    3 READ INPUT TAPE KI,90, (KA(I,1), I = 1,12)                        OKF10114
      WRITE OUTPUT TAPE KO,91,(KA(I,1), I = 1,12)                       OKF10115
      L=LISTNO(KA,24HCARDS TAPE  SKIP  TRANSP)                          OKF10116
      GO TO (1,6, 6,14,3),L                                             OKF10117
   14 KQ(8)=0                                                           OKF10118
      GO TO 3                                                           OKF10119
    6 IF(KQ(9)) 7,2,7                                                   OKF10120
    2 KQ(9)=1                                                           OKF10121
      REWIND KOR                                                        OKF10122
    7  IF (L-2) 4,4,13                                                  OKF10123
    1 KOR=KI                                                            OKF10124
    4 READ INPUT TAPE KOR,90,(KA(I,1),I=1,12)                           OKF10125
      WRITE OUTPUT TAPE KO,91, (KA(I,1), I = 1,12)                      OKF10126
      IF( LISTNO(KA,4HARCS) -2) 8,9,9                                   OKF10127
C           TITLE                                                       OKF10128
    9 DO 10 I=1,12                                                      OKF10129
   10 KA(I,2)=KA(I,1)                                                   OKF10130
      GO TO 4                                                           OKF10131
   13 READ INPUT TAPE KOR,92,KA(1,1)                                    OKF10132
      IF( LISTNO(KA,3HEND) -2) 3,13,13                                  OKF10133
   89 FORMAT(1H112A6)                                                   OKF10134
   90 FORMAT(12A6)                                                      OKF10135
   91 FORMAT(1H012A6)                                                   OKF10136
   92 FORMAT(A6)                                                        OKF10137
   93 FORMAT(1H011A6)                                                   OKF10138
   97 FORMAT(11H0JOB PULLED)                                            OKF10139
   98 FORMAT(31H0RESERVED TAPE HAS BEEN WRITTEN///1H0)                  OKF10140
   99 FORMAT(34H0NO RESERVED TAPE HAS BEEN WRITTEN)                     OKF10141
       END                                                              OKF10142
*      CARDSCOLUMN                                                      OKF10143
*      LIST                                                             OKF10144
C   ARCASY. ARC ASSEMBLY. INPUTS ARC DATA, FORMS IJ,IL                  OKF10145
      SUBROUTINE ARCASY (LL)                                            OKF10146
      COMMON JI,KC,KU,KX,NL,NN,NP,IJ,IL,JL                              OKF10147
      COMMON M,N,LER,KAT,KOR,KTER,MINE,LC,KA,IFIN,KI,KO,KQ,K            OKF10148
      DIMENSION JI(4500),KC(4500),KU(4500),KX(4500),NL(1500),NN(1500)   OKF10149
      DIMENSION NP(1500),IJ(1500),IL(1501),JL(1501),LC(9),KA(12,2),KQ(9)OKF10150
      LER=0                                                             OKF10151
      KF = 0                                                            OKF10152
      M = 0                                                             OKF10153
      N = 1                                                             OKF10154
    6 READ INPUT TAPE KOR,90,KD,KE,IJ(N),(KA(I,1),I=1,8)                OKF10155
      K=LISTNO(KD,13HEND   NODES  )                                     OKF10156
      GO TO (01,02,03,04), K                                            OKF10157
C                 NO NODES TO DO                                        OKF10158
    1 LL=0                                                              OKF10159
      GO TO 05                                                          OKF10160
C                 NODES TO DO                                           OKF10161
    2 LL=2                                                              OKF10162
    5 N=N-1                                                             OKF10163
   99 IF(LER) 100,101,100                                               OKF10164
  100 KQ(8)=2                                                           OKF10165
  101 RETURN                                                            OKF10166
C                 ARC TO FILE                                           OKF10167
    3 IF( LISTNO(KE,6H      ) -2) 6,7,7                                 OKF10168
    7 KC(N)=LCVR(KA(1,1))                                               OKF10169
      KU(N)=LCVR(KA(3,1))                                               OKF10170
      JI(N)=LCVR(KA(5,1))                                               OKF10171
      KX(N)=LCVR(KA(7,1))                                               OKF10172
      IF(KE-KF) 08,09,08                                                OKF10173
    8 IF(NODENO(KE)-M-1) 10,11,10                                       OKF10174
   10 WRITE OUTPUT TAPE KO,91,KE,IJ(N)                                  OKF10175
      GO TO 12                                                          OKF10176
   11 KF = KE                                                           OKF10177
      IF(M-KQ(5)) 22,22,23                                              OKF10178
   22 M=M+1                                                             OKF10179
      NN(M) = KE                                                        OKF10180
      NL(M)=N                                                           OKF10181
    9 IF(N-KQ(4)) 21,21,20                                              OKF10182
   21 N=N+1                                                             OKF10183
      GO TO 06                                                          OKF10184
    4 WRITE OUTPUT TAPE KO,92,N                                         OKF10185
   12 WRITE OUTPUT TAPE KO,93,KD,KE,IJ(N),(KA(I,1),I=1,8)               OKF10186
      LER=LER+1                                                         OKF10187
      GO TO 6                                                           OKF10188
   20 WRITE OUTPUT TAPE KO,89                                           OKF10189
   25 LER=10000                                                         OKF10190
      GO TO 99                                                          OKF10191
   23 WRITE OUTPUT TAPE KO,88                                           OKF10192
      GO TO 25                                                          OKF10193
   88 FORMAT(27H0TOO MANY NODES IN THIS RUN)                            OKF10194
   89 FORMAT(26H0TOO MANY ARCS IN THIS RUN)                             OKF10195
   90 FORMAT(3A6,2X,4(A6,A4))                                           OKF10196
   91 FORMAT(36H0SOURCE NODES ARE NOT ADJACENT, ARC A6,1X,A6)           OKF10197
   92 FORMAT(36H0CARD PUNCHING ERROR IN ARC CARD NO.,I6)                OKF10198
   93 FORMAT(1H0,3A6,2X,4(A6,A4))                                       OKF10199
       END                                                              OKF10200
*      CARDSCOLUMN                                                      OKF10201
*      LIST                                                             OKF10202
C   MAKEJL. NUMBERS J-S AND FORMS JL                                    OKF10203
      SUBROUTINE  MAKEJL                                                OKF10204
      COMMON JI,KC,KU,KX,NL,NN,NP,IJ,IL,JL                              OKF10205
      COMMON M,N,LER,KAT,KOR,KTER,MINE,LC,KA,IFIN,KI,KO,KQ,K            OKF10206
      DIMENSION JI(4500),KC(4500),KU(4500),KX(4500),NL(1500),NN(1500)   OKF10207
      DIMENSION NP(1500),IJ(1500),IL(1501),JL(1501),LC(9),KA(12,2),KQ(9)OKF10208
C                 NUMBERS TO IJ LIST                                    OKF10209
      I=1                                                               OKF10210
      DO 1 L=1,N                                                        OKF10211
    3 K=NODENO(IJ(L))                                                   OKF10212
      IF (K-M) 6,6,7                                                    OKF10213
    7 IF(M-KQ(5))17,9,9                                                 OKF10214
   17 M=M+1                                                             OKF10215
      NN(M)=IJ(L)                                                       OKF10216
      IJ(L)=K                                                           OKF10217
      NL(M)=N+1                                                         OKF10218
      LER=LER+1                                                         OKF10219
   19 IF (NL(I+1)-L) 5,5,18                                             OKF10220
    5 I=I+1                                                             OKF10221
      IF (I-M) 19,18,18                                                 OKF10222
   18 WRITE OUTPUT TAPE KO,90,NN(I),NN(M)                               OKF10223
      GO TO 1                                                           OKF10224
    6 IJ(L)=K                                                           OKF10225
    1 CONTINUE                                                          OKF10226
C                 FIX IL LIST                                           OKF10227
      DO 8 I=1,M                                                        OKF10228
      CALL PLACE(NL(I),IL(I))                                           OKF10229
    8 NL(I)=0                                                           OKF10230
      CALL PLACE (N+1,IL(M+1))                                          OKF10231
C                 COUNT J-S                                             OKF10232
      DO 10 J=1,N                                                       OKF10233
      I=IJ(J)                                                           OKF10234
   10 NL(I)=NL(I)+1                                                     OKF10235
C                 FORM JL LIST                                          OKF10236
      KK=1                                                              OKF10237
      CALL PLACE (KK,JL(1))                                             OKF10238
      DO 20 I=1,M                                                       OKF10239
      IF (NL(I)) 23,22,23                                               OKF10240
   22 WRITE OUTPUT TAPE KO,91,NN(I)                                     OKF10241
      LER=1                                                             OKF10242
   23 KK=KK+NL(I)                                                       OKF10243
   20 CALL PLACE (KK,JL(I+1))                                           OKF10244
  100 RETURN                                                            OKF10245
    9 LER=10000                                                         OKF10246
      WRITE OUTPUT TAPE KO,92                                           OKF10247
      GO TO 100                                                         OKF10248
   90 FORMAT( 5H0ARC ,A6,1X,A6,18H IS A DEAD END ARC)                   OKF10249
   91 FORMAT(21H0NO ARC ENDS AT NODE ,A6)                               OKF10250
   92 FORMAT(27H0TOO MANY NODES IN THIS RUN)                            OKF10251
       END                                                              OKF10252
*      CARDSCOLUMN                                                      OKF10253
*      LIST                                                             OKF10254
C   NODASY.  INPUTS NODE PRICES                                         OKF10255
      SUBROUTINE  NODASY                                                OKF10256
      COMMON JI,KC,KU,KX,NL,NN,NP,IJ,IL,JL                              OKF10257
      COMMON M,N,LER,KAT,KOR,KTER,MINE,LC,KA,IFIN,KI,KO,KQ,K            OKF10258
      DIMENSION JI(4500),KC(4500),KU(4500),KX(4500),NL(1500),NN(1500)   OKF10259
      DIMENSION NP(1500),IJ(1500),IL(1501),JL(1501),LC(9),KA(12,2),KQ(9)OKF10260
      I = 0                                                             OKF10261
   03 I = I+1                                                           OKF10262
      READ INPUT TAPE KOR,90,KD,KE,KA(1,1),KA(2,1)                      OKF10263
      IF( LISTNO(KD,12HEND         ) -2) 99,1,2                         OKF10264
    1 IF( LISTNO(KE,6H      ) -2) 3,4,4                                 OKF10265
    4 K=NODENO(KE)                                                      OKF10266
      IF (K - M) 05,05,06                                               OKF10267
    5 NP(K)=LCVR(KA)                                                    OKF10268
      GO TO 03                                                          OKF10269
    6 WRITE OUTPUT TAPE KO,91,I,KE                                      OKF10270
   10 LER=LER+1                                                         OKF10271
      GO TO 03                                                          OKF10272
    2 WRITE OUTPUT TAPE KO,92,I,KD,KE,KA(1,1),KA(2,1)                   OKF10273
      GO TO 10                                                          OKF10274
   99 RETURN                                                            OKF10275
   90 FORMAT(2A6,8X,A6,A4)                                              OKF10276
   91 FORMAT(5H0CARD I6,6H NODE A6,12H NOT IN ARCS)                     OKF10277
   92 FORMAT(37H0CARD PUNCHING ERROR IN NODE CARD NO.I6/1H 2A6,8X,A6,A4)OKF10278
       END                                                              OKF10279
*      CARDSCOLUMN                                                      OKF10280
*      LIST                                                             OKF10281
C           READER CONTROL                                              OKF10282
      SUBROUTINE READER                                                 OKF10283
      COMMON JI,KC,KU,KX,NL,NN,NP,IJ,IL,JL                              OKF10284
      COMMON M,N,LER,KAT,KOR,KTER,MINE,LC,KA,IFIN,KI,KO,KQ,K            OKF10285
      DIMENSION JI(4500),KC(4500),KU(4500),KX(4500),NL(1500),NN(1500)   OKF10286
      DIMENSION NP(1500),IJ(1500),IL(1501),JL(1501),LC(9),KA(12,2),KQ(9)OKF10287
    5 READ INPUT TAPE KI,95,(KA(I,1),I=1,12)                            OKF10288
      L=LISTNO(KA,18HALTER OUTPUTCOMPUT)                                OKF10289
      GO TO (18,121,111,10),L                                           OKF10290
   10 WRITE OUTPUT TAPE  KO,96,(KA(I,1),I=1,12)                         OKF10291
      DO 15 I=1,12                                                      OKF10292
   15 KA(I,2)=KA(I,1)                                                   OKF10293
      GO TO 5                                                           OKF10294
   18 BACKSPACE KI                                                      OKF10295
   20 READ INPUT TAPE KI,90,(KA(I,1),I=1,12)                            OKF10296
      L=LISTNO(KA,18HALTER OUTPUTCOMPUT)                                OKF10297
      GO TO (140,121,111,200),L                                         OKF10298
C           COMPUTE                                                     OKF10299
  111 WRITE OUTPUT TAPE KO,93,N,M                                       OKF10300
  999 RETURN                                                            OKF10301
C           SET OUTPUT CONTROL                                          OKF10302
  121 WRITE OUTPUT TAPE KO,88,KA(1,1),KA(2,1),KA(3,1)                   OKF10303
  120 L=LISTNO(KA(2,1),30H TAPE  IF PU PUNCH NODES PRINT)               OKF10304
      IF (L-5) 81,86,200                                                OKF10305
   81 LC(L)=1                                                           OKF10306
      GO TO 20                                                          OKF10307
   86 KQ(7)=1                                                           OKF10308
      GO TO 20                                                          OKF10309
C                 ALTER                                                 OKF10310
  140 IF(KA(4,1)) 141,141,142                                           OKF10311
  141 KA(4,1)=1                                                         OKF10312
  142 WRITE OUTPUT TAPE KO,91,(KA(I,1),I=1,12)                          OKF10313
      N1=NODENO(KA(2,1))                                                OKF10314
      N2=NODENO(KA(3,1))                                                OKF10315
      IF (N1-M) 143,143,144                                             OKF10316
  143 IF (N2-M) 145,145,144                                             OKF10317
  144 WRITE OUTPUT TAPE KO,92                                           OKF10318
      LER=1                                                             OKF10319
      GO TO 20                                                          OKF10320
  145 L1=LADDR(IL(N1))                                                  OKF10321
      L2=LADDR(IL(N1+1))-1                                              OKF10322
      IF(L2-L1) 144,146,146                                             OKF10323
  146 DO 147 LL=L1,L2                                                   OKF10324
      IF(IJ(LL)/1-N2) 147,148,147                                       OKF10325
  148 KA(4,1)=KA(4,1)-1                                                 OKF10326
      IF (KA(4,1)) 147,149,147                                          OKF10327
  147 CONTINUE                                                          OKF10328
      GO TO 144                                                         OKF10329
  149 KC(LL)=LCVR(KA(5,1))                                              OKF10330
      KU(LL)=LCVR(KA(7,1))                                              OKF10331
      JI(LL)=LCVR(KA(9,1))                                              OKF10332
      KX(LL)=KX(LL)+LCVR(KA(11,1))                                      OKF10333
      GO TO 20                                                          OKF10334
CARD PUNCHING ERROR                                                     OKF10335
  200 LER=1                                                             OKF10336
      WRITE OUTPUT TAPE KO,87,KA(1,1),KA(2,1),KA(3,1)                   OKF10337
      GO TO 20                                                          OKF10338
   87 FORMAT(23H ILLEGAL CONTROL CARD (3A6,1H))                         OKF10339
   88 FORMAT(1H03A6)                                                    OKF10340
   90 FORMAT(3A6,I2,4(A6,A4))                                           OKF10341
   91 FORMAT(1H0,3A6,I2,4(A6,A4))                                       OKF10342
   92 FORMAT(47H0THE ARC ON THE ABOVE ALTER CARD IS NOT IN CORE)        OKF10343
   93 FORMAT(12H0NO OF ARCS=I5,  13H NO OF NODES=I5)                    OKF10344
   95 FORMAT(12A6)                                                      OKF10345
   96 FORMAT(1H012A6)                                                   OKF10346
       END                                                              OKF10347
*      CARDSCOLUMN                                                      OKF10348
*      LIST                                                             OKF10349
      SUBROUTINE  TRANSL                                                OKF10350
      COMMON JI,KC,KU,KX,NL,NN,NP,IJ,IL,JL                              OKF10351
      COMMON M,N,LER,KAT,KOR,KTER,MINE,LC,KA,IFIN,KI,KO,KQ,K            OKF10352
      DIMENSION JI(4500),KC(4500),KU(4500),KX(4500),NL(1500),NN(1500)   OKF10353
      DIMENSION NP(1500),IJ(1500),IL(1501),JL(1501),LC(9),KA(12,2),KQ(9)OKF10354
CLEAR NL STORAGE                                                        OKF10355
      DO 11 I=1,M                                                       OKF10356
   11 NL(I)=0                                                           OKF10357
CAST OUT LOWER BOUNDS                                                   OKF10358
      REWIND KQ                                                         OKF10359
      WRITE TAPE KQ,(JI(J),J=1,N)                                       OKF10360
      END FILE KQ                                                       OKF10361
      REWIND KQ                                                         OKF10362
CALCULATE CIRCULATION AND C-BAR                                         OKF10363
      I=0                                                               OKF10364
      LUP=1                                                             OKF10365
      DO 2 L=1,N                                                        OKF10366
    4 IF (L-LUP) 13,12,12                                               OKF10367
   12 I=I+1                                                             OKF10368
      LUP=LADDR(IL(I+1))                                                OKF10369
   13 LU=IJ(L)                                                          OKF10370
      NL(I)=NL(I)-KX(L)                                                 OKF10371
      NL(LU)=NL(LU)+KX(L)                                               OKF10372
    2 KC(L)=KC(L)+NP(I)-NP(LU)                                          OKF10373
CIRCULATION MESSAGE FOR NON-ZERO CIRCULATION AND MOVE JL LIST           OKF10374
      DO 5 I=1,M                                                        OKF10375
      IF (NL(I)) 6,5,6                                                  OKF10376
    6 CALL IBCD(NL(I),KA,12)                                            OKF10377
      WRITE OUTPUT TAPE KO,90,NN(I),KA(1,1),KA(2,1)                     OKF10378
    5 NL(I)=LADDR(JL(I))                                                OKF10379
COMPUTE EXCESS OF X AND UPPER BOUND OVER LOWER BOUND                    OKF10380
      DO 1 J=1,N                                                        OKF10381
      KU(J)=KU(J)-JI(J)                                                 OKF10382
      IF(KU(J)) 50,1,1                                                  OKF10383
   50 WRITE OUTPUT TAPE KO,51,J                                         OKF10384
      LER=LER+1                                                         OKF10385
    1 KX(J)=KX(J)-JI(J)                                                 OKF10386
COMPUTE JI LISTS                                                        OKF10387
      I=0                                                               OKF10388
      LUP=1                                                             OKF10389
      DO 22 L=1,N                                                       OKF10390
   27 IF (L-LUP) 25,26,26                                               OKF10391
   26 I=I+1                                                             OKF10392
      LUP=LADDR(IL(I+1))                                                OKF10393
   25 K=IJ(L)                                                           OKF10394
      J=NL(K)                                                           OKF10395
      JI(J)=I                                                           OKF10396
      CALL PLACE (L,JI(J))                                              OKF10397
   22 NL(K)=NL(K)+1                                                     OKF10398
CLEAR NL STORAGE                                                        OKF10399
      DO 60 I=1,M                                                       OKF10400
   60 NL(I)=0                                                           OKF10401
      RETURN                                                            OKF10402
   51 FORMAT(4H0ARC, I6  ,42H HAS LOWER BOUND GREATER THAN UPPER BOUND.)OKF10403
   90 FORMAT(6H0NODE A6,28H NON-CONSERVATIVE, NET FLOW=2A6)             OKF10404
       END                                                              OKF10405
*      CARDSCOLUMN                                                      OKF10406
*      LIST                                                             OKF10407
      SUBROUTINE KILTER (I)                                             OKF10408
      COMMON JI,KC,KU,KX,NL,NN,NP,IJ,IL,JL                              OKF10409
      COMMON M,N,LER,KAT,KOR,KTER,MINE,LC,KA,IFIN,KI,KO,KQ,K            OKF10410
      DIMENSION JI(4500),KC(4500),KU(4500),KX(4500),NL(1500),NN(1500)   OKF10411
      DIMENSION NP(1500),IJ(1500),IL(1501),JL(1501),LC(9),KA(12,2),KQ(9)OKF10412
      FREQUENCY 1(0,100,1),2(1000),5(0,1,2),10(2,1,0),25(8,1,0)         OKF10413
      FREQUENCY 66(0,2,1),39(0,100,1),20(1,2,3),30(1,2,3)               OKF10414
    1 IF(LADDR(IJ(1))) 71,70,71                                         OKF10415
   71 CALL PLACE (0,IJ(1))                                              OKF10416
    2 DO 69 J=1,M                                                       OKF10417
   69 NL(J)=0                                                           OKF10418
   70 LER=0                                                             OKF10419
    5 IF (KC(K)) 10,20,30                                               OKF10420
   10 IF(KX(K)-KU(K)) 13,40,14                                          OKF10421
   13 MINE=-KX(K)+KU(K)                                                 OKF10422
      GO TO 50                                                          OKF10423
   14 MINE=KX(K)-KU(K)                                                  OKF10424
      GO TO 60                                                          OKF10425
   20 IF(KX(K))13,25,25                                                 OKF10426
   25 IF(KX(K)-KU(K))40,40,35                                           OKF10427
   30 IF(KX(K))32,40,35                                                 OKF10428
   32 MINE=-KX(K)                                                       OKF10429
      GO TO 50                                                          OKF10430
   35 MINE=KX(K)                                                        OKF10431
      GO TO 60                                                          OKF10432
   50 KOR=IJ(K)                                                         OKF10433
      KAT=0                                                             OKF10434
      KTER=I                                                            OKF10435
      GO TO 65                                                          OKF10436
   60 KOR=I                                                             OKF10437
      KAT=10                                                            OKF10438
      KTER=IJ(K)                                                        OKF10439
   65 CALL LABELN(KBR)                                                  OKF10440
   66 IF (KBR) 67,68,67                                                 OKF10441
   67 CALL BREAKT                                                       OKF10442
      GO TO 5                                                           OKF10443
   68 CALL UPNOPR                                                       OKF10444
   39 IF (LER) 40,5,40                                                  OKF10445
   40 RETURN                                                            OKF10446
       END                                                              OKF10447
*      CARDSCOLUMN                                                      OKF10448
*      LIST                                                             OKF10449
      SUBROUTINE OUTPUT (KZ)                                            OKF10450
      COMMON JI,KC,KU,KX,NL,NN,NP,IJ,IL,JL                              OKF10451
      COMMON M,N,LER,KAT,KOR,KTER,MINE,LC,KA,IFIN,KI,KO,KQ,K            OKF10452
      DIMENSION JI(4500),KC(4500),KU(4500),KX(4500),NL(1500),NN(1500)   OKF10453
      DIMENSION NP(1500),IJ(1500),IL(1501),JL(1501),LC(9),KA(12,2),KQ(9)OKF10454
      DIMENSION KB(16),KZ(101)                                          OKF10455
      IF (KZ(101)) 10,11,10                                             OKF10456
   11 IF (LER) 30,20,30                                                 OKF10457
   20 MZ=-8192                                                          OKF10458
      GO TO 13                                                          OKF10459
   10 IF (LER) 18,19,18                                                 OKF10460
   19 WRITE OUTPUT TAPE KO,99,KZ(101)                                   OKF10461
   18 KZ(101)=XMIN0F(KZ(101),100)                                       OKF10462
   30 MZ=-65536                                                         OKF10463
   13 IF(LC(1)+LC(3)+KQ(7)) 100,101,100                                 OKF10464
  101 KQ(7)=1                                                           OKF10465
  100 IF (SENSE SWITCH 5) 2,1                                           OKF10466
    2 IF (LC(2)) 8,1,8                                                  OKF10467
    8 LC(1)=1                                                           OKF10468
    1 K2=KQ(2)                                                          OKF10469
      REWIND KQ                                                         OKF10470
      READ TAPE KQ,(JI(K),K=1,N)                                        OKF10471
      REWIND KQ                                                         OKF10472
   52 IF(LC(3))62,12,62                                                 OKF10473
   62 PUNCH 90,(KA(I,2),I=1,12)                                         OKF10474
      WRITE OUTPUT TAPE KO,89                                           OKF10475
   12 IF(LC(1))22,41,22                                                 OKF10476
   22 IF(KQ(6)) 24,23,24                                                OKF10477
   23 KQ(6) =1                                                          OKF10478
      REWIND K2                                                         OKF10479
   24 WRITE OUTPUT TAPE K2,90,(KA(I,2),I=1,12)                          OKF10480
      WRITE OUTPUT TAPE KO,88                                           OKF10481
   41 IF (KQ(7)) 42,7,42                                                OKF10482
   42 WRITE OUTPUT TAPE KO,91,(KA(I,2),I=1,12)                          OKF10483
    7 L=1                                                               OKF10484
      LL=1                                                              OKF10485
      DO 3 I=1,M                                                        OKF10486
      LUP=LADDR(IL(I+1))                                                OKF10487
  302 IF (L-LUP) 301,3,3                                                OKF10488
  301 LU=IJ(L)                                                          OKF10489
      LLC=KC(L)                                                         OKF10490
      KC(L)=KC(L)-NP(I)+NP(LU)                                          OKF10491
      KX(L)=KX(L)+JI(L)                                                 OKF10492
      KU(L)=KU(L)+JI(L)                                                 OKF10493
      LZ=LPROD(KC(L),KX(L))                                             OKF10494
      CALL IBCD(KC(L),KB(1),10)                                         OKF10495
      CALL IBCD(KU(L),KB(3),10)                                         OKF10496
      CALL IBCD(JI(L),KB(5),10)                                         OKF10497
      CALL IBCD(KX(L),KB(7),10)                                         OKF10498
      CALL IBCD(LZ,KB(9),12)                                            OKF10499
      MX=MZ                                                             OKF10500
      IF(KZ(101)) 16,16,14                                              OKF10501
   14 IF(KZ(LL)-L) 16,17,16                                             OKF10502
   17 KZ(101)=KZ(101)-1                                                 OKF10503
      LL=LL+1                                                           OKF10504
      MX=-20480                                                         OKF10505
   16 IF(LC(1))26,51,26                                                 OKF10506
   26 WRITE OUTPUT TAPE K2,93,NN(I),NN(LU),(KB(II),II=1,10),MX          OKF10507
   51 IF (KQ(7)) 46,56,46                                               OKF10508
   46 CALL IBCD(NP(I),KB(11),12)                                        OKF10509
      CALL IBCD(NP(LU),KB(13),12)                                       OKF10510
      CALL IBCD(LLC,KB(15),12)                                          OKF10511
      WRITE OUTPUT TAPE KO,94,NN(I),NN(LU),(KB(II),II=1,16),MX          OKF10512
   56 IF(LC(3)) 66,333,66                                               OKF10513
   66 PUNCH 93,NN(I),NN(LU),(KB(II),II=1,10)                            OKF10514
  333 L=L+1                                                             OKF10515
      GO TO 302                                                         OKF10516
    3 CONTINUE                                                          OKF10517
      IF (LC(4)) 555,15,555                                             OKF10518
  555 IF (LC(1)+LC(3)) 201,27,201                                       OKF10519
  201 IF (LC(1)) 202,203,202                                            OKF10520
  202 WRITE OUTPUT TAPE K2,96                                           OKF10521
  203 IF (LC(3)) 204,115,204                                            OKF10522
  204 PUNCH 96                                                          OKF10523
  115 DO 200 I=1,M                                                      OKF10524
      CALL IBCD(NP(I),KB,12)                                            OKF10525
      IF(LC(1))25,85,25                                                 OKF10526
   25 WRITE OUTPUT TAPE K2,95,NN(I),KB(1),KB(2)                         OKF10527
   85 IF(LC(3))65,200,65                                                OKF10528
   65 PUNCH 95,NN(I),KB(1),KB(2)                                        OKF10529
  200 CONTINUE                                                          OKF10530
   15 IF(LC(1))48,27,48                                                 OKF10531
   48 WRITE OUTPUT TAPE K2,97                                           OKF10532
   27 IF (KQ(7)) 47,57,47                                               OKF10533
   47 WRITE OUTPUT TAPE KO,98                                           OKF10534
   57 IF(LC(3))67,77,67                                                 OKF10535
   67 PUNCH 97                                                          OKF10536
   77 CALL IBCD(LC(5),KA,12)                                            OKF10537
      CALL IBCD(LC(6),KA(3,1),12)                                       OKF10538
      CALL IBCD(LC(7),KA(5,1),12)                                       OKF10539
      CALL IBCD(LC(8),KA(7,1),12)                                       OKF10540
      WRITE OUTPUT TAPE KO,92,(KA(II,1),II=1,8)                         OKF10541
      RETURN                                                            OKF10542
   88 FORMAT(24H0THIS RUN OUTPUT TO TAPE )                              OKF10543
   89 FORMAT(25H0THIS RUN OUTPUT TO PUNCH)                              OKF10544
   90 FORMAT(12A6/4HARCS22X,4HCOST5X,5HUPPER5X,5HLOWER9X,1HX8X,4HFLOW)  OKF10545
   91 FORMAT(1H112A6/5H ARCS16X,4HCOST6X,5HUPPER6X,5HLOWER10X,1HX8X,    OKF10546
     X 4HFLOW9X,3HPI19X,3HPI28X,4HCBAR/1X)                              OKF10547
   92 FORMAT(18H0NO OF BREAKTHRUS=2A6,22H, NO OF NONBREAKTHRUS=2A6,18H, OKF10548
     1NO OF X CHANGES=2A6,/42H NO OF NODES FROM WHICH LABELING WAS DONE=OKF10549
     22A6)                                                              OKF10550
   93 FORMAT(6X,2A6,2X,4(A6,A4),2A6,1X,A1)                              OKF10551
   94 FORMAT(2(1X,A6),4(1X,A6,A4),8A6,1X,A1)                            OKF10552
   95 FORMAT(6X,A6,6X,2A6)                                              OKF10553
   96 FORMAT (6HNODES )                                                 OKF10554
   97 FORMAT(3HEND)                                                     OKF10555
   98 FORMAT(4H0END)                                                    OKF10556
   99 FORMAT(1H0I5,23H ARCS ARE OUT OF KILTER)                          OKF10557
       END                                                              OKF10558
