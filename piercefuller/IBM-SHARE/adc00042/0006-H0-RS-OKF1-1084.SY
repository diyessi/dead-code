40L    TXI     40L2,4,1                  NUP=NUP+1                      OKF10651
40L2   SXD     NUP,4                     IF(KR-KTER)42,47,42            OKF10652
41L    SUB     KTRR                                                     OKF10653
       TZE     47L                 42    L=L+1                          OKF10654
42L    TXI     42L2,2,1                  GO TO 31                       OKF10655
43L    LXD     NU,4                43    NU=NU+1                        OKF10656
       CLA     IJ+1,4                                                   OKF10657
       TXI     NUP,4,1                                                  OKF10658
NUP    TXH     48L,4,**                  IF(NU-NUP)44,44,48             OKF10659
44L    PAX     0,1                 44    I=LADDR(IJ(NU-1))              OKF10660
       SXD     I,1                                                      OKF10661
       SXD     NU,4                                                     OKF10662
46L    TRA     14L                       GO TO 14                       OKF10663
47L    LXA     49L+2,4             47    KBR=1                          OKF10664
       CLA     =1B17                                                    OKF10665
       STO*    1,4                                                      OKF10666
48L    LXD     NU,4                48    LC(8)=LC(8)+NU-1               OKF10667
       TXI     48L2,4,-1                                                OKF10668
48L2   PXA     0,4                                                      OKF10669
       ADD     LC-7                                                     OKF10670
