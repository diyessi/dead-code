C     H.KASPAR 591-351 MATH.AND STAT.UNIT                               NRMC0010
C     **MULTIPLE CORRELATION WITH VARIOUS COMBINATIONS OF INPUT**       NRMC0020
      DIMENSIONA(40,40),C(40,40),CC(40,40),SPD(40,40),D(40,40),P(6,40),VNRMC0030
     XK(40,200),X(200),KB(40),KC(40),V(40),ZN(40),Z(40),AM(40),AM2(40),VNRMC0040
     XM(40),VM2(40),SSD(40),PCCR(40),CSUB(40),SIGB(40),AT(40),PRSB(40),JNRMC0050
     XTH(40),B(40),XB(40),AA(3,40,40),DUMMY(95)                         NRMC0060
      COMMON DF4,CHI,DEV,XBAR,DUMMY,AA                                  NRMC0070
      KA=1                                                              NRMC0080
      CALL LLNPRC(AA(1,40,40))                                          NRMC0090
 6001 READ INPUT TAPE5,6004,N,NO,NBIG,NT,NTT,LO                         NRMC0100
 6004 FORMAT(6I12)                                                      NRMC0110
      ASSIGN2 TO IY                                                     NRMC0120
      DO13 I=1,N                                                        NRMC0130
   13 JTH(I)=I                                                          NRMC0140
      READINPUTTAPE5,22,((P(I,K),I=1,6),K=1,NO)                         NRMC0150
   22 FORMAT(6E12.8)                                                    NRMC0160
      READ INPUT TAPE 5,12,(KB(I),KC(I),I=1,N)                          NRMC0170
   12 FORMAT(6(I10,I2))                                                 NRMC0180
      IF(NTT-1)10,20,20                                                 NRMC0190
   20 WRITE OUTPUT TAPE6,30                                             NRMC0200
   30 FORMAT(1H1)                                                       NRMC0210
      DO50 I=1,NTT                                                      NRMC0220
      READ INPUT TAPE5,40                                               NRMC0230
   40 FORMAT(72H                                                        NRMC0240
     X                )                                                 NRMC0250
   50 WRITE OUTPUT TAPE6,40                                             NRMC0260
   10 T=NBIG                                                            NRMC0270
      W=.95                                                             NRMC0280
      IF(LO-1)52,51,52                                                  NRMC0290
   51 READ INPUT TAPE5,22,(XB(I),I=1,N)                                 NRMC0300
   52 LLO=0                                                             NRMC0310
      LZ=N-1                                                            NRMC0320
      KIT=(N-1)*(N-2)/2                                                 NRMC0330
      DO4020 I=1,N                                                      NRMC0340
      AM(I)=0.00                                                        NRMC0350
      SSD(I)=0.00                                                       NRMC0360
      DO 4020 K=1,N                                                     NRMC0370
 4020 A(I,K)=0.00                                                       NRMC0380
      DO 4040 L=1,NBIG                                                  NRMC0390
      J=0                                                               NRMC0400
      READ INPUT TAPE 5,22,(Z(I),I=1,NO)                                NRMC0410
C     GETTING THE POWERS       WANTED                                   NRMC0420
      DO160K=1,NO                                                       NRMC0430
      DO155I=1,6                                                        NRMC0440
      IF(P(I,K))99,160,99                                               NRMC0450
   99 J=J+1                                                             NRMC0460
      IF(P(I,K)-6.)5100,5120,5130                                       NRMC0470
 5100 KTB=P(I,K)                                                        NRMC0480
      ZN(J)=Z(K)**KTB                                                   NRMC0490
      IF(INTF(P(I,K))-P(I,K))1110,155,1110                              NRMC0500
 1110 ZN(J)=Z(K)**P(I,K)                                                NRMC0510
      GOTO155                                                           NRMC0520
 5120 ZN(J)=EXPF(Z(K))                                                  NRMC0530
      GOTO155                                                           NRMC0540
 5130 IF(P(I,K)-7.)140,140,150                                          NRMC0550
  140 ZN(J)=EXPF(-Z(K))                                                 NRMC0560
      GOTO155                                                           NRMC0570
  150 ZN(J)=LOGEF(Z(K))                                                 NRMC0580
  155 CONTINUE                                                          NRMC0590
  160 CONTINUE                                                          NRMC0600
C     * * GETTING THE RIGHT COMBINATIONS * *                            NRMC0610
      DO 8900 I=1,N                                                     NRMC0620
      LK=KB(I)                                                          NRMC0630
      LJ=KC(I)                                                          NRMC0640
      V(I)=ZN(LJ)                                                       NRMC0650
      IF(LK) 66,8900,66                                                 NRMC0660
   66 V(I)=ZN(LK)*V(I)                                                  NRMC0670
 8900 CONTINUE                                                          NRMC0680
C      * * * MEAN,SUMOFX SQUARED * * *                                  NRMC0690
      DO 4041 I=1,N                                                     NRMC0700
      AM(I)=V(I)+AM(I)                                                  NRMC0710
      VM(I)=AM(I)                                                       NRMC0720
 4041 VK(I,L)=V(I)                                                      NRMC0730
 4040 CONTINUE                                                          NRMC0740
      DO 4042 I=1,N                                                     NRMC0750
 4042 AM(I)=AM(I)/T                                                     NRMC0760
      DO 4043 M=1,NBIG                                                  NRMC0770
      DO 4044 I=1,N                                                     NRMC0780
      VM2(I)=VK(I,M)-AM(I)                                              NRMC0790
      SD=VM2(I)*VM2(I)                                                  NRMC0800
 4044 SSD(I)=SSD(I)+SD                                                  NRMC0810
      DO 4045 I=1,LZ                                                    NRMC0820
      J=I+1                                                             NRMC0830
      DO4045 K=J,N                                                      NRMC0840
      SD1=VM2(I)*VM2(K)                                                 NRMC0850
 4045 A(I,K)=A(I,K)+SD1                                                 NRMC0860
 4043 CONTINUE                                                          NRMC0870
      DO 5054  I=1,LZ                                                   NRMC0880
      AM2(I)=SQRTF(SSD(I)/T)                                            NRMC0890
      J=I+1                                                             NRMC0900
      DO 5054  K=J,N                                                    NRMC0910
      SD7=SQRTF(SSD(I)*SSD(K))                                          NRMC0920
 5054 A(I,K)=A(I,K)/SD7                                                 NRMC0930
      AM2(N)=SQRTF(SSD(N)/T)                                            NRMC0940
  610 FORMAT(1H122X,  50HCORRELATION C0EFFICIENTS   PROB. OF R(I,J)  ANDNRMC0950
     X DF/)                                                             NRMC0960
 4052 WRITE OUTPUTTAPE 6,610                                            NRMC0970
      NHK=NBIG-2+LLO                                                    NRMC0980
      H=NHK                                                             NRMC0990
      DO4070 I=1,LZ                                                     NRMC1000
      J=I+1                                                             NRMC1010
      DO4070 K=J,N                                                      NRMC1020
      U=A(I,K)**2                                                       NRMC1030
      F=U*H/(1.-U)                                                      NRMC1040
      CALL FPROB(F,H,1.,PPR)                                            NRMC1050
 4070 WRITE OUTPUT TAPE6,4080,I,K,A(I,K),PPR,NHK                        NRMC1060
 4080 FORMAT(28X,  1HR 2I2,F11.6,F18.4,I11/)                            NRMC1070
      GO TO IY,(2,3)                                                    NRMC1080
    2 WRITE OUTPUT TAPE6,4074                                           NRMC1090
 4074 FORMAT(1H0///48X,4HMEAN14X,7HSTD DEV/)                            NRMC1100
      DO 4075 I=1,N                                                     NRMC1110
 4075 WRITE OUTPUT TAPE 6,4079,I,AM(I),AM2(I)                           NRMC1120
 4079 FORMAT(1H 32X,1HXI2,2E20.6)                                       NRMC1130
      IF(LO-1)4,5,4                                                     NRMC1140
    5 ASSIGN 3 TO IY                                                    NRMC1150
      LLO=1                                                             NRMC1160
      T=2.*T                                                            NRMC1170
      DO6 I=1,LZ                                                        NRMC1180
      AM(I)=VM(I)                                                       NRMC1190
      SSD(I)=0.                                                         NRMC1200
      J=I+1                                                             NRMC1210
      DO6 K=J,N                                                         NRMC1220
    6 A(I,K)=0.                                                         NRMC1230
      AM(N)=VM(N)                                                       NRMC1240
      SSD(N)=0.                                                         NRMC1250
      DO4046 M=1,NBIG                                                   NRMC1260
      DO 4047 I=1,N                                                     NRMC1270
      AD=2.*XB(I)-VK(I,M)                                               NRMC1280
      AM(I)=AD+AM(I)                                                    NRMC1290
      VM2(I)=VK(I,M)-XB(I)                                              NRMC1300
      Q1=VM2(I)*VM2(I)                                                  NRMC1310
 4047 SSD(I)=SSD(I)+Q1                                                  NRMC1320
      DO4050 I=1,LZ                                                     NRMC1330
      J=I+1                                                             NRMC1340
      DO4050 K=J,N                                                      NRMC1350
      Q2=VM2(I)*VM2(K)                                                  NRMC1360
 4050 A(I,K)=A(I,K)+Q2                                                  NRMC1370
 4046 CONTINUE                                                          NRMC1380
      DO 5051 I=1,LZ                                                    NRMC1390
      AM(I)=AM(I)/T                                                     NRMC1400
      SSD(I)=2.*SSD(I)                                                  NRMC1410
      AM2(I)=SQRTF(SSD(I)/T)                                            NRMC1420
      J=I+1                                                             NRMC1430
      DO 5051 K=J,N                                                     NRMC1440
      Q3=SQRTF(2.*SSD(I)*SSD(K))                                        NRMC1450
 5051 A(I,K)=2.*A(I,K)/Q3                                               NRMC1460
      AM(N)=AM(N)/T                                                     NRMC1470
      SSD(N)=2.*SSD(N)                                                  NRMC1480
      AM2(N)=SQRTF(SSD(N)/T)                                            NRMC1490
      GO TO 4052                                                        NRMC1500
    3 WRITE OUTPUT TAPE6,7                                              NRMC1510
    7 FORMAT(1H0///22X,49HTHE R(I,J) ARE BASED ON THE FIXED POINT GIVEN NRMC1520
     XBY,)                                                              NRMC1530
      DO 8 I=1,N                                                        NRMC1540
    8 WRITE OUTPUT TAPE6,9,I,XB(I)                                      NRMC1550
    9 FORMAT(1H 33X,1HXI2,F20.6)                                        NRMC1560
    4 MA=N-1                                                            NRMC1570
      DO200 I=2,MA                                                      NRMC1580
      IR=I+1                                                            NRMC1590
      DO200 K=IR,N                                                      NRMC1600
      SP1=SQRTF(SSD(I)*SSD(K))                                          NRMC1610
  200 SPD(I,K)=A(I,K)*SP1                                               NRMC1620
      KO=N-1                                                            NRMC1630
      A(N,N)=1.                                                         NRMC1640
      DO 5010 I=1,KO                                                    NRMC1650
      K=I+1                                                             NRMC1660
      DO5000  JOKE=K,N                                                  NRMC1670
 5000 A(JOKE,I)=A(I,JOKE)                                               NRMC1680
 5010 A(I,I)=1.                                                         NRMC1690
      MM=0                                                              NRMC1700
      DO 1902 J=1,N                                                     NRMC1710
      DO 1902 I=1,N                                                     NRMC1720
 1902 C(I,J)=A(I,J)                                                     NRMC1730
      IF(NT-1)629,629,1900                                              NRMC1740
 1900 DO 1972 J=1,N                                                     NRMC1750
      DO 1972 I=1,N                                                     NRMC1760
 1972 CC(I,J)=C(I,J)                                                    NRMC1770
  629 DO630 I=1,N                                                       NRMC1780
      DO630 J=1,N                                                       NRMC1790
  630 CALL SP2NP(A(I,J),AA(1,I,J))                                      NRMC1800
      CALL INVS(N,AA,INSI)                                              NRMC1810
      DO632 I=1,N                                                       NRMC1820
      DO632 J=1,N                                                       NRMC1830
  632 CALL NP2SP(AA(1,I,J),A(I,J))                                      NRMC1840
  634 ASSIGN 275 TO IW                                                  NRMC1850
      ASSIGN 1898 TO IZ                                                 NRMC1860
      B(1)=-1.                                                          NRMC1870
      C1=AM(1)                                                          NRMC1880
      DO 7170 I=2,N                                                     NRMC1890
 7170 B(I)=-AM2(1)/A(1,1)*A(1,I)/AM2(I)                                 NRMC1900
      DO 7180 I=2,N                                                     NRMC1910
 7180 C1=C1-B(I)*AM(I)                                                  NRMC1920
  800 WRITE OUTPUT TAPE6,802                                            NRMC1930
  802 FORMAT(1H121X,2HX125X,6HX1CALC22X,9HX1-X1CALC)                    NRMC1940
      DO 806 M=1,NBIG                                                   NRMC1950
      CALC=C1                                                           NRMC1960
      DO 804 I=2,N                                                      NRMC1970
      K=JTH(I)                                                          NRMC1980
  804 CALC=CALC+B(I)*VK(K,M)                                            NRMC1990
      DIFC=VK(1,M)-CALC                                                 NRMC2000
      X(M)=DIFC                                                         NRMC2010
  806 WRITE OUTPUT TAPE6,808,VK(1,M),CALC,DIFC                          NRMC2020
  808 FORMAT(1H 3F28.4)                                                 NRMC2030
      Q=1E18                                                            NRMC2040
      CALL NORMAL(NBIG,X)                                               NRMC2050
      CALL FPROB(CHI,Q,DF4,PR)                                          NRMC2060
      CHI=CHI*DF4                                                       NRMC2070
      WRITE OUTPUT TAPE6,810                                            NRMC2080
  810 FORMAT(1H130(H )29HCHI-SQUARE TEST FOR NORMALITY//)               NRMC2090
      WRITE OUTPUT TAPE6,812                                            NRMC2100
  812 FORMAT(1H015(H )4HMEAN15(H )5HSIGMA11(H )7HCHI-SQ.13(H )2HPR14(H )NRMC2110
     X2HDF//)                                                           NRMC2120
      NDF=DF4                                                           NRMC2130
      WRITE OUTPUT TAPE6,814,XBAR,DEV,CHI,PR,NDF                        NRMC2140
  814 FORMAT(5H     4F17.5,I14//)                                       NRMC2150
 5003 TUU=1./A(1,1)                                                     NRMC2160
      BIGR=SQRTF(1.-TUU)                                                NRMC2170
      S=AM2(1)*SQRTF(TUU)                                               NRMC2180
      WRITE OUTPUT TAPE 6,8004,S,BIGR                                   NRMC2190
 8004 FORMAT(1H0/32X,  26HMULTIPLE ERROR OF ESTIMATEF16.6//29(H )32HMULTNRMC2200
     XIPLE CORRELATION COEFFICIENTF16.6///)                             NRMC2210
      NFD=NBIG-N+LO                                                     NRMC2220
      H=NFD                                                             NRMC2230
      U=BIGR**2                                                         NRMC2240
      F=U*H/(1.-U)                                                      NRMC2250
      CALL FPROB(F,H,1.,RPR)                                            NRMC2260
      WRITE OUTPUT TAPE6,8005,RPR,NFD                                   NRMC2270
 8005 FORMAT(30X,  16HPROBABILITY OF R F16.6//27(H )18HDEGREES OF FREEDONRMC2280
     XM I15//)                                                          NRMC2290
      DO210 K=2,N                                                       NRMC2300
  210 PCCR(K)=A(1,K)/SQRTF(A(1,1)*A(K,K))                               NRMC2310
      WRITE OUTPUT TAPE 6,220                                           NRMC2320
  220 FORMAT(18X,  56HPARTIAL CORRELATION COEFFICIENTS  PROB. OF R1J.K..NRMC2330
     X.   DF//)                                                         NRMC2340
      NFF=NBIG-N+LO                                                     NRMC2350
      H=NFF                                                             NRMC2360
      DO221 I=2,N                                                       NRMC2370
      IF(B(I)) 295,221,295                                              NRMC2380
  295 PCCR(I)=ABSF(PCCR(I)/B(I))*B(I)                                   NRMC2390
      U=PCCR(I)**2                                                      NRMC2400
      F=U*H/(1.-U)                                                      NRMC2410
      CALL FPROB(F,H,1.,PRP)                                            NRMC2420
  221 WRITE OUTPUT TAPE6,225,JTH(I),PCCR(I),PRP,NFF                     NRMC2430
  225 FORMAT(19X,  4HPCCR 1I2,F21.6,F19.4,I9)                           NRMC2440
      GO TO IW,(275,1940)                                               NRMC2450
 1940 CALL RDCE(N+1,M,C,C)                                              NRMC2460
      CALL RDCE(N+1,M,CC,CC)                                            NRMC2470
      M=M-1                                                             NRMC2480
      ASSIGN 1941 TO IZ                                                 NRMC2490
      CALL RDCE(N,M,D,A)                                                NRMC2500
      N=N-1                                                             NRMC2510
      DO 640 I=1,N                                                      NRMC2520
      DO 640 J=1,N                                                      NRMC2530
  640 CALL SP2NP(A(I,J),AA(1,I,J))                                      NRMC2540
      CALL INVS(N,AA,INSI)                                              NRMC2550
      DO 642  I=1,N                                                     NRMC2560
      DO 642  J=1,N                                                     NRMC2570
  642 CALL NP2SP(AA(1,I,J),A(I,J))                                      NRMC2580
      GO TO 263                                                         NRMC2590
  275 MO=N                                                              NRMC2600
      KO=N-2                                                            NRMC2610
      N=N-1                                                             NRMC2620
      A(N,N)=SSD(MO)                                                    NRMC2630
      DO235 I=1,KO                                                      NRMC2640
      K=I+1                                                             NRMC2650
      DO230 JOKE=K,N                                                    NRMC2660
      A(I,JOKE)=SPD(I+1,JOKE+1)                                         NRMC2670
  230 A(JOKE,I)=A(I,JOKE)                                               NRMC2680
  235 A(I,I)=SSD(I+1)                                                   NRMC2690
      IF(NT-1)1899,1899,1905                                            NRMC2700
 1905 DO 1906 I=1,N                                                     NRMC2710
      DO 1906 J=1,N                                                     NRMC2720
 1906 D(I,J)=A(I,J)                                                     NRMC2730
 1899 DO 644 I=1,N                                                      NRMC2740
      DO 644 J=1,N                                                      NRMC2750
  644 CALL SP2NP(A(I,J),AA(1,I,J))                                      NRMC2760
      CALL INVS(N,AA,INSI)                                              NRMC2770
      DO 646 I=1,N                                                      NRMC2780
      DO 646 J=1,N                                                      NRMC2790
  646 CALL NP2SP(AA(1,I,J),A(I,J))                                      NRMC2800
  263 DO250 I=1,N                                                       NRMC2810
      CSUB(I+1)=A(I,I)                                                  NRMC2820
  250 SIGB(I+1)=SQRTF(CSUB(I+1))*S                                      NRMC2830
      VB=0.                                                             NRMC2840
      CB=0.                                                             NRMC2850
      DO1501 I=1,N                                                      NRMC2860
      VB=VB+(AM(I+1)*SIGB(I+1))**2                                      NRMC2870
      J=I+1                                                             NRMC2880
      IF(N-J)1502,1499,1499                                             NRMC2890
 1499 DO1501 K=J,N                                                      NRMC2900
 1501 CB=CB+AM(I+1)*AM(K+1)*A(I,K)                                      NRMC2910
 1502 SIGA=SQRTF(VB +S**2/T*(1.+2.*CB))                                 NRMC2920
      KDF=NBIG-N-1+LO                                                   NRMC2930
      DF=KDF                                                            NRMC2940
      A1=C1/SIGA                                                        NRMC2950
      A2=A1**2                                                          NRMC2960
      CALLFPROB(A2,DF,1.,PRSA)                                          NRMC2970
      LR=N+1                                                            NRMC2980
      DO609 I=2,LR                                                      NRMC2990
      AT(I)=B(I)/SIGB(I)                                                NRMC3000
      AT2=AT(I)**2                                                      NRMC3010
  609 CALLFPROB(AT2,DF,1.,PRSB(I))                                      NRMC3020
      WRITE OUTPUT TAPE6,255,C1,SIGA,A1,PRSA,KDF                        NRMC3030
  255 FORMAT(1H129X,47HT TEST FOR REGRESSION COEFFICIENTS AND CONSTANT//NRMC3040
     X/18X,9HREGR.C0EF11X,7HSTD.DEV20X,1HT12X,1HP9X,2HDF//10H  CONSTANT2NRMC3050
     XE19.6,F21.2,F13.5,I8)                                             NRMC3060
      WRITE OUTPUT TAPE6,270,(JTH(I),B(I),SIGB(I),AT(I),PRSB(I),KDF,I=2,NRMC3070
     XLR)                                                               NRMC3080
  270 FORMAT(4H  B1I2,4X,2E19.6,F21.2,F13.5,I8)                         NRMC3090
      GO TO IZ,(1898,1941)                                              NRMC3100
 1941 CALL RDCE(N+1,M,D,D)                                              NRMC3110
      IF(N-1)9000,9000,1911                                             NRMC3120
 1898 IF(NT-1)6001,6001,1910                                            NRMC3130
 1910 H=NBIG-2+LO                                                       NRMC3140
      KOT=0                                                             NRMC3150
 1911 BIGA=C(2,3)                                                       NRMC3160
      MK=N+1                                                            NRMC3170
      DO 25  I=2,N                                                      NRMC3180
      II=I+1                                                            NRMC3190
      DO 25 K=II,MK                                                     NRMC3200
      IF(ABSF(BIGA)-ABSF(CC(I,K)))24,25,25                              NRMC3210
   24 BIGA=CC(I,K)                                                      NRMC3220
   25 CONTINUE                                                          NRMC3230
      DO 1920 I=2,N                                                     NRMC3240
      JI=I+1                                                            NRMC3250
      DO  1920 K=JI,MK                                                  NRMC3260
      IF(ABSF(C(I,K))-ABSF(BIGA))1920,1912,1920                         NRMC3270
 1912 CC(I,K)=0.                                                        NRMC3280
      U=C(I,K)**2                                                       NRMC3290
      F=U*H/(1.-U)                                                      NRMC3300
      CALL FPROB(F,H,1.,PRR)                                            NRMC3310
      IF(PRR-.95)1921,1921,1930                                         NRMC3320
 1930 M=I                                                               NRMC3330
      IF(ABSF(PCCR(I))-ABSF(PCCR(K)))1933,1933,1932                     NRMC3340
 1932 M=K                                                               NRMC3350
 1933 CALL RDCE(N+1,M,C,A)                                              NRMC3360
      DO 648  I=1,N                                                     NRMC3370
      DO 648  J=1,N                                                     NRMC3380
  648 CALL SP2NP(A(I,J),AA(1,I,J))                                      NRMC3390
      CALL INVS(N,AA,INSI)                                              NRMC3400
      DO 650 I=1,N                                                      NRMC3410
      DO 650 J=1,N                                                      NRMC3420
  650 CALL NP2SP(AA(1,I,J),A(I,J))                                      NRMC3430
      NDF=NBIG-N-1+LO                                                   NRMC3440
      H1=NDF                                                            NRMC3450
      AS2=S*S                                                           NRMC3460
      AS3=AM2(1)**2/A(1,1)                                              NRMC3470
      SS=SQRTF(AS3)                                                     NRMC3480
      F2=(AS3-AS2)*H1/AS2                                               NRMC3490
      CALL FPROB(F2,H1,1.,PRR1)                                         NRMC3500
      IF(PRR1-W**(1./FLOATF(N)))1938,1938,1934                          NRMC3510
 1934 WRITEOUTPUTTAPE6,1935,JTH(M),SS,F2,PRR1,KA,NDF                    NRMC3520
 1935 FORMAT(1H039(H )1HXI2,15H IS SIGNIFICANT//39(H )9HSTD ERROR16(H )1NRMC3530
     XHF12(H )1HP8(H )2HDF//F48.6,F20.2,F13.4,2I5)                      NRMC3540
 1920 CONTINUE                                                          NRMC3550
 1921 KOT=KOT+1                                                         NRMC3560
      KIT=KIT-KOT                                                       NRMC3570
      IF(KIT)9000,9000,1911                                             NRMC3580
 9000 WRITE OUTPUT TAPE6,9010                                           NRMC3590
 9010 FORMAT(1H121X,2HX125X,6HX1CALC22X,9HX1-X1CALC)                    NRMC3600
      DO 9040  M=1,NBIG                                                 NRMC3610
      CALC=C1                                                           NRMC3620
      DO9030 I=2,LR                                                     NRMC3630
      K=JTH(I)                                                          NRMC3640
 9030 CALC=CALC+B(I)*VK(K,M)                                            NRMC3650
      DIFC=VK(1,M)-CALC                                                 NRMC3660
      X(M)=DIFC                                                         NRMC3670
 9040 WRITE OUTPUT TAPE 6,9050,VK(1,M),CALC,DIFC                        NRMC3680
      CALL NORMAL(NBIG,X)                                               NRMC3700
 9050 FORMAT(1H 3F29.4)                                                 NRMC3690
      CALL FPROB (CHI,Q,DF4,PR)                                         NRMC3710
      CHI=CHI*DF4                                                       NRMC3720
      WRITE OUTPUT TAPE6,850                                            NRMC3730
  850 FORMAT(1H130(H )29HCHI-SQUARE TEST FOR NORMALITY//)               NRMC3740
      WRITE OUTPUT TAPE6,852                                            NRMC3750
  852 FORMAT(1H015(H )4HMEAN15(H )5HSIGMA11(H )7HCHI-SQ.13(H )2HPR14(H )NRMC3760
     X2HDF//)                                                           NRMC3770
      NDF=DF4                                                           NRMC3780
      WRITE OUTPUT TAPE6,854,XBAR,DEV,CHI,PR,NDF                        NRMC3790
  854 FORMAT(5H     4F17.5,I14//)                                       NRMC3800
      GO TO 6001                                                        NRMC3810
 1938 WRITE OUTPUT TAPE6,1939,JTH(M)                                    NRMC3820
 1939 FORMAT(1H039(1H )1HXI2,11H IS DELETED//)                          NRMC3830
      IF(N-M)1946,17,17                                                 NRMC3840
   17 DO 1945 I=M,N                                                     NRMC3850
      JTH(I)=JTH(I+1)                                                   NRMC3860
      AM(I)=AM(I+1)                                                     NRMC3870
 1945 AM2(I)=AM2(I+1)                                                   NRMC3880
 1946 B(1)=-1.                                                          NRMC3890
      C1=AM(1)                                                          NRMC3900
      DO 9011 I=2,N                                                     NRMC3910
      B(I)=-AM2(1)/A(1,1)*A(1,I)/AM2(I)                                 NRMC3920
 9011 C1=C1-B(I)*AM(I)                                                  NRMC3930
      KOT=0                                                             NRMC3940
      KIT=(N-1)*(N-2)/2                                                 NRMC3950
      WRITE OUTPUT TAPE6,1943,SS,F2,PRR1,KA,NDF                         NRMC3960
 1943 FORMAT(39X,  9HSTD ERROR16X,  1HF12X,  2HPR8X,  2HDF//F48.6,F20.2,NRMC3970
     XF13.4,2I5)                                                        NRMC3980
      ASSIGN 1940 TO IW                                                 NRMC3990
      GO TO 5003                                                        NRMC4000
      END                                                               NRMC4010
      SUBROUTINE TCHEB (S,T,AREA,DELTA)                                 NRMC4020
      DIMENSION Y(9)                                                    NRMC4030
C     NO.5 PERFORMS THE TCHEBYCHEFF TRANSFORMATION TO LIMITS OF -1 TO 1.NRMC4040
    5 TRANSF(A,B,Y)=((B-A)*Y/2. + (B+A)/2.)                             NRMC4050
      Y(5)=0.0                                                          NRMC4060
      Y(6)=.16790618                                                    NRMC4070
      Y(7)=.52876178                                                    NRMC4080
      Y(8)=.60101866                                                    NRMC4090
      Y(9)=.91158931                                                    NRMC4100
      DO 10 I=1,4                                                       NRMC4110
   10 Y(I)=-Y(I+5)                                                      NRMC4120
C     NO.20 ASSURES THE INTEGRATION TO BE FROM THE LOWER LIMIT TO UPPER.NRMC4130
   20 IF(S-T)60,50,30                                                   NRMC4140
   30 ST=S                                                              NRMC4150
      S=T                                                               NRMC4160
      T=ST                                                              NRMC4170
      GO TO 60                                                          NRMC4180
   50 AREA=0                                                            NRMC4190
      RETURN                                                            NRMC4200
C     NO. 60 DETERMINES FROM SIGN IF THE DELTA IS PRECISION OR INCREMENTNRMC4210
C       OF INTEGRATION AND ROUTS THE PROGRAM THROUGH THE PROPER PATH.   NRMC4220
   60 IF(DELTA)90,80,130                                                NRMC4230
   80 DELTA=-.00005                                                     NRMC4240
C     NO. 90-110 IF THE DELTA IS IN PRECISION, THIS DIVIDES THE S TO T  NRMC4250
C     LIMITS IN TO 10 UNITS OF A TO B.                                  NRMC4260
   90 DE=LOG10F((T-S)/5.)                                               NRMC4270
      IF (DE)100,100,110                                                NRMC4280
  100 DEL=10.**(INTF(DE))                                               NRMC4290
      GO TO 120                                                         NRMC4300
  110 DEL=10.**(INTF(DE)+1.)                                            NRMC4310
  120 AREA2=0.0                                                         NRMC4320
      GO TO 140                                                         NRMC4330
  130 DEL=DELTA                                                         NRMC4340
  140 AREA1=0.0                                                         NRMC4350
      A=S                                                               NRMC4360
      B=S+DEL                                                           NRMC4370
      IF(B-T)160,160,220                                                NRMC4380
  160 ATOB = 0.0                                                        NRMC4390
C     NO 170 TO 220 SOLVES FOR AREAS OFATOB THEN SUMS THEM FOR AREA1.   NRMC4400
      DO 170 I=1,9                                                      NRMC4410
  170 ATOB = ATOB + TEGRAN(TRANSF(A,B,Y(I)))                            NRMC4420
      AREA1 = AREA1 + ATOB*(B-A)                                        NRMC4430
      B = B+DEL                                                         NRMC4440
      A = A+DEL                                                         NRMC4450
      IF(B-T)160,160,190                                                NRMC4460
  190 IF(DELTA)210,210,200                                              NRMC4470
  200 IF(A-T)220,260,260                                                NRMC4480
  210 IF(A-T)220,230,230                                                NRMC4490
  220 B = T                                                             NRMC4500
      GO TO 160                                                         NRMC4510
C     NO. 230 COMPARES SUCCESSIVE TOTAL AREAS THEN COMPARES THEM FOR THENRMC4520
C     DESIRED PRECISION.                                                NRMC4530
  230 IF(ABSF((AREA2-AREA1)/AREA1)+DELTA)250,240,240                    NRMC4540
  240 AREA2=AREA1                                                       NRMC4550
      DEL = DEL/10.                                                     NRMC4560
      GO TO 140                                                         NRMC4570
  250 DELTA = DEL*10.                                                   NRMC4580
  260 AREA = AREA1/9.                                                   NRMC4590
      RETURN                                                            NRMC4600
       END                                                              NRMC4610
C     THIS FUNCTION SOLVES THE GENERAL TYPE OF INTEGRAL DQUATION WITH   NRMC4620
C     THE RAPHSON-NEWTON ITERATION METHOD.                              NRMC4630
C     IT IS DESIRED TO FIND A VALUE OF X SUCH THAT THE INTEGRAL FROM    NRMC4640
C     (A+ OR -X) TO (B+ OR -X) OF TEGRAN(X) IS EQUAL TO AREA. THE RESULTNRMC4650
C     IS DESIRED TO A PRECISION PREC.                                   NRMC4660
C     IF A NEGATIVE OR POSITIVE SOLUTION IS DESIRED FOR X,A + OR - SIGN NRMC4670
C     WILL BE ATTRIBUTED TO X. A FIRST GUESS VALUE MAY BE OPTIONALLY    NRMC4680
C     ATTRIBUTED TO X. IF NO INFORMATION IS AVAILABLE THE VALUE OF X    NRMC4690
C     WILL BE FIXED TO + OR -0.                                         NRMC4700
      FUNCTION RAFSON (A1,B1,BOT1,TOP1,AREA,PREC1,G)                    NRMC4710
      X=G                                                               NRMC4720
      A=A1                                                              NRMC4730
      B=B1                                                              NRMC4740
      BOT=BOT1                                                          NRMC4750
      TOP=TOP1                                                          NRMC4760
      PREC=PREC1                                                        NRMC4770
      ICOUNT=0                                                          NRMC4780
      TRY=SIGNF(1.,X)                                                   NRMC4790
      ASSIGN 15 TO ITRY                                                 NRMC4800
      DELTA1=-PREC/10.                                                  NRMC4810
      DELTA2=DELTA1                                                     NRMC4820
      CALL TCHEB(A+BOT*X,B+TOP*X,REF,-PREC/10.)                         NRMC4830
      REF=REF-AREA                                                      NRMC4840
    4 XM=X                                                              NRMC4850
      REFM=REF                                                          NRMC4860
      DELTAM=1.E+30                                                     NRMC4870
    5 DIV=TOP*TEGRAN(B+TOP*X)-BOT*TEGRAN(A+BOT*X)                       NRMC4880
      IF(DIV) 6,22,6                                                    NRMC4890
    6 DELTAX=-REF/DIV                                                   NRMC4900
      IF(ABSF(DELTAX)-ABSF(DELTAM)) 7,80,80                             NRMC4910
    7 X1=X+DELTAX                                                       NRMC4920
      IF(ABSF(DELTAX/X1)-PREC) 20,10,10                                 NRMC4930
   10 CALL TCHEB(B+TOP*X,B+TOP*X1,AREAT,DELTA1)                         NRMC4940
      CALL TCHEB(A+BOT*X,A+BOT*X1,AREAB,DELTA2)                         NRMC4950
      GO TO ITRY,(15,40)                                                NRMC4960
   15 AREAT=SIGNF(AREAT,TOP*DELTAX)                                     NRMC4970
      AREAB=SIGNF(AREAB,BOT*DELTAX)                                     NRMC4980
      REF=REF+AREAT-AREAB                                               NRMC4990
      DELTAM=DELTAX                                                     NRMC5000
      X=X1                                                              NRMC5010
      GO TO 5                                                           NRMC5020
   20 RAFSON=X1                                                         NRMC5030
      RETURN                                                            NRMC5040
   22 IF(REF) 25,24,25                                                  NRMC5050
   24 RAFSON=X                                                          NRMC5060
      RETURN                                                            NRMC5070
   25 ASSIGN 40 TO ITRY                                                 NRMC5080
   26 X1=X+TRY                                                          NRMC5090
      ICOUNT=ICOUNT+1                                                   NRMC5100
      IF (ICOUNT-1000) 10,10,100                                        NRMC5110
   40 AREAT=SIGNF(AREAT,TOP*TRY)                                        NRMC5120
      AREAB=SIGNF(AREAB,BOT*TRY)                                        NRMC5130
      REFN=REF+AREAT-AREAB                                              NRMC5140
      IF (REF*REFN) 60,20,50                                            NRMC5150
   50 REF=REFN                                                          NRMC5160
      X=X1                                                              NRMC5170
      GO TO 26                                                          NRMC5180
   60 ASSIGN 15 TO ITRY                                                 NRMC5190
      TRY=TRY/10.                                                       NRMC5200
      GO TO 4                                                           NRMC5210
   80 X=XM                                                              NRMC5220
      REF=REFM                                                          NRMC5230
      GO TO 25                                                          NRMC5240
  100 PRINT 101                                                         NRMC5250
  101 FORMAT (28H THE HELL WITH IT. I GIVE UP)                          NRMC5260
      RETURN                                                            NRMC5270
       END                                                              NRMC5280
      FUNCTION TEGRAN(X)                                                NRMC5290
      COMMON DF4,CHI,DEV,XBAR                                           NRMC5300
      TEGRAN=.3989423/DEV*EXPF(-.5*((X-XBAR)/DEV)**2)                   NRMC5310
      RETURN                                                            NRMC5320
       END                                                              NRMC5330
      SUBROUTINE  FPROB(F,DN,UN,P)                                      NRMC5340
      PHIF(X)=((((.00328975*X-.00039446)*X+.02743349)*X+.08864027)*X+.14NRMC5350
     X11281)*X+1.                                                       NRMC5360
      U=((1.-(.22222222/DN))*F**.333333333-(1.-(.22222222/UN)))/SQRTF(2.NRMC5370
     X*((.22222222/DN)*F**.66666667+(.22222222/UN)))                    NRMC5380
      ROT=0.                                                            NRMC5390
      IF(U)2,12,12                                                      NRMC5400
    2 U=-U                                                              NRMC5410
      ROT=1.                                                            NRMC5420
   12 P=-.5/PHIF(U)**8+1.                                               NRMC5430
      P=(1.-2.*P)*ROT+P                                                 NRMC5440
      RETURN                                                            NRMC5450
       END                                                              NRMC5460
      SUBROUTINE RDCE(N,M,X,Y)                                          NRMC5470
      DIMENSION X(40,40),Y(40,40)                                       NRMC5480
      DO5 I=1,N                                                         NRMC5490
      DO5 J=1,N                                                         NRMC5500
    5 Y(I,J)=X(I,J)                                                     NRMC5510
      L=N-1                                                             NRMC5520
      IF(N-M)40,40,10                                                   NRMC5530
   10 DO20 I=M,L                                                        NRMC5540
      DO20 J=1,N                                                        NRMC5550
   20 Y(J,I)=Y(J,I+1)                                                   NRMC5560
      DO30  I=1,L                                                       NRMC5570
      DO30 J=M,L                                                        NRMC5580
   30 Y(J,I)=Y(J+1,I)                                                   NRMC5590
   40 RETURN                                                            NRMC5600
       END                                                              NRMC5610
C     TEST FOR NORMALITY ON DEVIATIONS                                  NRMC5620
      SUBROUTINE NORMAL(N,X)                                            NRMC5630
      DIMENSION X(200),Z(200),Y(15),FR(15),C(15)                        NRMC5640
      COMMON DF4,CHI,DEV,XBAR                                           NRMC5650
    6 DO3 I=1,N                                                         NRMC5660
    3 Z(I)=X(I)                                                         NRMC5670
      T=N                                                               NRMC5680
    7 S2=0.00                                                           NRMC5690
      XBAR=0.00                                                         NRMC5700
      DO 8 I=1,N                                                        NRMC5710
    8 XBAR=XBAR+X(I)                                                    NRMC5720
      XBAR=XBAR/T                                                       NRMC5730
      RABX=XBAR                                                         NRMC5740
      DO10 I=1,N                                                        NRMC5750
      W=X(I)-XBAR                                                       NRMC5760
   10 S2=S2+W**2                                                        NRMC5770
      DEV=SQRTF(S2/(T))                                                 NRMC5780
      AN=INTF(SQRTF(T)+.5)                                              NRMC5790
      IF(AN-4.)12,14,14                                                 NRMC5800
   12 AN=4.                                                             NRMC5810
   14 B=1./AN                                                           NRMC5820
      MB=AN                                                             NRMC5830
      XBAR=0.                                                           NRMC5840
      IF(MB/2*2-MB)16,20,16                                             NRMC5850
   16 B1=B/2.                                                           NRMC5860
      NO=(AN-1.)/2.-1.                                                  NRMC5870
      Y(NO+2)=RAFSON(XBAR,0.,0.,1.,B1,.005,XBAR)                        NRMC5880
      DO17 I=1,NO                                                       NRMC5890
      NNO=NO+2+I                                                        NRMC5900
   17 Y(NNO)=RAFSON(Y(NNO-1),0.,0.,1.,B,.005,Y(NNO-1))                  NRMC5910
      NMO=NO+1                                                          NRMC5920
      DO 18 I=1,NMO                                                     NRMC5930
      II=2*NO+3-I                                                       NRMC5940
   18 Y(I)=-Y(II)                                                       NRMC5950
      GO TO 22                                                          NRMC5960
   20 NP=AN/2.-1.                                                       NRMC5970
      Y(NP+1)=0.                                                        NRMC5980
      DO 21 I=1,NP                                                      NRMC5990
      MNO=NP+1+I                                                        NRMC6000
   21 Y(MNO)=RAFSON(Y(MNO-1),0.,0.,1.,B,.005,Y(MNO-1))                  NRMC6010
      DO 25 I=1,NP                                                      NRMC6020
      IJ=2*NP+2-I                                                       NRMC6030
   25 Y(I)=-Y(IJ)                                                       NRMC6040
   22 NO=AN                                                             NRMC6050
      NT=NO-1                                                           NRMC6060
      DO 26 I=1,NT                                                      NRMC6070
   26 Y(I)=Y(I)+RABX                                                    NRMC6080
      DO29 I=1,NT                                                       NRMC6090
      FR(I)=0.00                                                        NRMC6100
      DO29 J=1,N                                                        NRMC6110
      IF(Z(J)-Y(I))27,27,29                                             NRMC6120
   27 FR(I)=FR(I)+1.                                                    NRMC6130
   29 CONTINUE                                                          NRMC6140
      DO30 I=2,NT                                                       NRMC6150
   30 C(I)=FR(I)-FR(I-1)                                                NRMC6160
      C(1)=FR(1)                                                        NRMC6170
      C(NO)=T-FR(NT)                                                    NRMC6180
      XBAR=RABX                                                         NRMC6190
      TF=T*B                                                            NRMC6200
      CHI=0.00                                                          NRMC6210
      DO 35 I=1,NO                                                      NRMC6220
   35 CHI=CHI+(C(I)-TF)**2/TF                                           NRMC6230
      DF4=NO-3                                                          NRMC6240
      CHI=CHI/DF4                                                       NRMC6250
      RETURN                                                            NRMC6260
      END                                                               NRMC6270
      SUBROUTINE INVS(N,A,INSI)                                         NRMC6280
      DIMENSION A(3,40,40),L(40),M(40),BIGA(3),ATMP(3),HOLD(3),ONENP(3),NRMC6290
     XDUMMY(4),DETER(3)                                                 NRMC6300
      COMMON DUMMY,L,M,BIGA,ATMP,HOLD,ONENP,DETER                       NRMC6310
      CALL SP2NP(1.0,ONENP)                                             NRMC6320
      INSI=0                                                            NRMC6330
      DO 180 K=1,N                                                      NRMC6340
      CALL NPREC                                                        NRMC6350
      BIGA=A(1,K,K)                                                     NRMC6360
      CALL NPOUT                                                        NRMC6370
      DO 120 I=K,N                                                      NRMC6380
      DO 120 J=K,N                                                      NRMC6390
      CALL NPREC                                                        NRMC6400
      ATMP=ABSF(A(1,I,J))                                               NRMC6410
      IF(ABSF(BIGA)-ATMP)110,110,120                                    NRMC6420
  110 BIGA=A(1,I,J)                                                     NRMC6430
      CALL NPOUT                                                        NRMC6440
      L(K)=I                                                            NRMC6450
      M(K)=J                                                            NRMC6460
  120 CALL NPOUT                                                        NRMC6470
      JROW=L(K)                                                         NRMC6480
      IF(L(K)-K)135,135,125                                             NRMC6490
  125 DO 130 I=1,N                                                      NRMC6500
      CALL NPREC                                                        NRMC6510
      HOLD=-A(1,K,I)                                                    NRMC6520
      A(1,K,I)=A(1,JROW,I)                                              NRMC6530
      A(1,JROW,I)=HOLD                                                  NRMC6540
  130 CALL NPOUT                                                        NRMC6550
  135 ICOL=M(K)                                                         NRMC6560
      IF(M(K)-K)145,145,137                                             NRMC6570
  137 DO 140 J=1,N                                                      NRMC6580
      CALL NPREC                                                        NRMC6590
      HOLD=-A(1,J,K)                                                    NRMC6600
      A(1,J,K)=A(1,J,ICOL)                                              NRMC6610
      A(1,J,ICOL)=HOLD                                                  NRMC6620
  140 CALL NPOUT                                                        NRMC6630
  145 IF(A(2,K,K))147,146,147                                           NRMC6640
  146 INSI=1                                                            NRMC6650
      RETURN                                                            NRMC6660
  147 DO 155 IC=1,N                                                     NRMC6670
      IF(IC-K)150,155,150                                               NRMC6680
  150 CALL NPREC                                                        NRMC6690
      A(1,IC,K)=A(1,IC,K)/A(1,K,K)                                      NRMC6700
      A(1,IC,K)=-A(1,IC,K)                                              NRMC6710
  155 CALL NPOUT                                                        NRMC6720
      DO 165 I=1,N                                                      NRMC6730
      DO 165 J=1,N                                                      NRMC6740
  156 IF(I-K)157,165,157                                                NRMC6750
  157 IF(J-K)160,165,160                                                NRMC6760
  160 CALL NPREC                                                        NRMC6770
      A(1,I,J)=A(1,I,K)*A(1,K,J)+A(1,I,J)                               NRMC6780
  165 CALL NPOUT                                                        NRMC6790
      DO 175 JR=1,N                                                     NRMC6800
  168 IF(JR-K)170,175,170                                               NRMC6810
  170 CALL NPREC                                                        NRMC6820
      A(1,K,JR)=A(1,K,JR)/A(1,K,K)                                      NRMC6830
  175 CALL NPOUT                                                        NRMC6840
      CALL NPREC                                                        NRMC6850
      A(1,K,K)=ONENP/A(1,K,K)                                           NRMC6860
  180 CALL NPOUT                                                        NRMC6870
      K=N                                                               NRMC6880
  200 K=K-1                                                             NRMC6890
      IF(K)235,235,203                                                  NRMC6900
  203 I=L(K)                                                            NRMC6910
      IF(I-K)220,220,205                                                NRMC6920
  205 DO 210 J=1,N                                                      NRMC6930
      CALL NPREC                                                        NRMC6940
      HOLD=A(1,J,K)                                                     NRMC6950
      A(1,J,K)=-A(1,J,I)                                                NRMC6960
      A(1,J,I)=HOLD                                                     NRMC6970
  210 CALL NPOUT                                                        NRMC6980
  220 J=M(K)                                                            NRMC6990
      IF(J-K)200,200,225                                                NRMC7000
  225 DO 230 I=1,N                                                      NRMC7010
      CALL NPREC                                                        NRMC7020
      HOLD=A(1,K,I)                                                     NRMC7030
      A(1,K,I)=-A(1,J,I)                                                NRMC7040
      A(1,J,I)=HOLD                                                     NRMC7050
  230 CALL NPOUT                                                        NRMC7060
      GO TO 200                                                         NRMC7070
  235 RETURN                                                            NRMC7080
      END                                                               NRMC7090
