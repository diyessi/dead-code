*      SMITHSONIAN ASTROPHYSICAL OBSERVATORY**SUBROUTINE GLSP**              001
*     LIST 8                                                                0002
*     LABEL                                                                 0003
CSIGLSP    GENERAL LEAST SQUARES PROGRAM                                    0004
      SUBROUTINE GLSP(A,MM,NN,B,IPP,X,U,SUM,WT,INVRS,STDERR)                 005
      DIMENSION A(150,6),B(150,7),X(6,7),U(150,7),SUM(7),W(6,13),WT(150)     006
      DIMENSION STDERR ( 6)                                                  007
      M=MM                                                                   008
      N=NN                                                                   009
      IP=IPP                                                                 010
      INVRSE=INVRS                                                           011
C     AX=B,NORMAL EQUATIONS,A IS RECTANGULAR MATRIX,WITH M ROWS,N COLUMNS    012
C     WX=W1 ,NEW SET OF NORMAL EQUATIONS, W=TR(A)*A ,W1= TR(A)*B..           013
C     TO FORM MATRIX  W ,WITH N ROWS AND N COLUMNS. (TR= TRANSPOSE )         014
C  WT = -1. MEANS  NO WEIHGTS  IN PROG.   ASSIGN   WEIGHTS = 1.              015
C  INVRSE = 0. MEANS NO CALCULATIONS OF STD. ERRORS OF ( X )*********        018
C  INVRSE = 1. MEANS  STD. ERRORS ARE CALCULATED.                            017
C  STDERR  = STANDARD ERRORS OF  UNKNOWNS ( X ) .                            016
      KK=N+1                                                                 019
      IF(M-N) 80,83,81                                                       020
   81 DO 5 J=1,N                                                             021
      DO 5 JJ=1,N                                                            022
      W(J,JJ) = 0.                                                           023
      IF ( WT) 611,622,622                                                   024
C   NO WEIGHTS CASE                                                          025
 611  DO 51 I= 1,M                                                           026
 51   W(J,JJ) = W(J,JJ) + A(I,J) * A(I,JJ)                                   027
      GO TO 5                                                                028
C   WEIGHTS ARE PRESENT                                                      029
 622  DO 52 I=1,M                                                            030
 52   W(J,JJ) = W(J,JJ) + A(I,J) * A(I,JJ)  * WT(I)                          031
 5    CONTINUE                                                               032
C     TO FORM  MATRIX W1 , WHICH IS STORED IN N+1 TO N+P COLUMNS OF W.       033
C     W1 ,WITH N ROWS AND IP COLUMNS.                                        034
      IF ( INVRSE ) 201,203,201                                             0035
 203  KIP = IP                                                               036
      GO TO 200                                                              037
 201  KIP = 1                                                                038
 200  DO 8 K = 1, KIP                                                        039
      DO 7 J=1,N                                                             040
      W(J,KK) = 0.                                                           041
      IF ( WT) 612,623,623                                                   042
 612  DO 511 I=1,M                                                           043
 511  W(J,KK) = W(J,KK)+A(I,J)* B(I,K)                                       044
      GO TO 7                                                                045
 623  DO 522 I= 1,M                                                          046
 522  W(J,KK) = W(J,KK)+A(I,J)* B(I,K)  * WT(I)                              047
 7    CONTINUE                                                               048
   8  KK = KK + 1                                                            049
      GO TO 106                                                              050
   83 DO 12 I=1,N                                                            051
      IF ( WT) 613,624,624                                                   052
 613  DO 512 J=1,N                                                           053
 512  W(I,J) = A(I,J)                                                        054
      GO TO 12                                                               055
 624  DO 523 J=1,N                                                           056
 523  W(I,J) = A(I,J) * WT(I)                                                057
 12   CONTINUE                                                               058
      KKK = N+IP                                                             059
      J=1                                                                    060
      IF ( INVRSE ) 401,403,401                                              061
 403  KKK = KKK                                                              062
      GO TO 400                                                              063
 401  KKK = KK                                                               064
 400  DO 13 JJ= KK,KKK                                                       065
      IF ( WT ) 614,625,625                                                  066
 614  DO 513 I= 1,N                                                         0067
 513  W(I,JJ) = B(I,J)                                                       068
      GO TO 13                                                               069
 625  DO 524 I= 1,N                                                          070
 524  W(I,JJ) = B(I,J) * WT(I)                                               071
   13 J=J+1                                                                  072
 106  IF ( INVRSE ) 71,72,71                                                 073
 71   K2 = N + 2                                                             074
      KIP = N + IP                                                           075
      KK = N + 1                                                             076
      DO 75 I=1,N                                                            077
      DO 75 J = K2,KIP                                                       078
      IF ( J - I - KK ) 73,74,73                                             079
  74  W(I,J) = 1.                                                            080
      GO TO 75                                                               081
 73   W(I,J) = 0.                                                            082
 75   CONTINUE                                                               083
 72   CALL  TRIANG (W,N,IP, DET )                                            084
C     WHERE W IS THE MATRIX WITH N ROWS AND(N+IP)COLUMNS TO BE TRIANGULA     085
C     RIZED                                                                  086
C     TO TEST THE SINGULARITY OF MATRIX  W., W = TR(A)*A  , W*X = W1.        087
      IF ( DET ) 82,80,82                                                    088
   82 CONTINUE                                                               089
      GO TO 103                                                              090
   80 SUM = -1                                                               091
      GO TO 104                                                              092
  103 CALL  SOLVE  (W,N,IP,X)                                                093
C     WHERE W IS THE TRIANGULARIZED, X IS THE SOLUTION  MATRIX  WITH         094
C     N ROWS AND  IP  COLUMNS.                                               095
C     TO COMPUTE RESIDUAL MATRIX , U = A*X - B ,U IS RESIDUAL MATRX(M,P)     096
  105 DO 16 I=1,M                                                            097
      DO 16 K=1,IP                                                           098
      U(I,K) =0.                                                             099
      DO 15 J=1,N                                                            100
   15 U(I,K) = U(I,K) + A(I,J) * X(J,K )                                     101
 16   U(I,K) = B(I,K) - U(I,K)                                               102
      DO 18 K=1,IP                                                           103
      SUM(K) = 0.                                                            104
      DO 18 I=1,M                                                            105
   18 SUM(K) =SUM(K) +(U(I,K))**2                                            106
      IF ( INVRSE ) 722,104,722                                              107
 722  DO 723  I = 1,N                                                        108
      DO  723 J= 2,IP                                                        109
  723 X(I,J)=X(I,J)*(SUM(1)/FLOATF(M-N))                                     110
      DO 724 I = 1,N                                                         111
      STDERR(I) = 0.                                                         112
      II = I + 1                                                             113
 724  STDERR(I) = SQRTF( X(I,II))                                            114
  104 RETURN                                                                 115
      END                                                                    116
*     LIST 8                                                                 117
*     LABEL                                                                  118
CTRIANG  TO BE USED WITH SUBROUTINE GLSP                                     119
      SUBROUTINE TRIANG(A,M,N,DET )                                          120
C .              WHERE A IS THE MATRIX WITH M ROWS AND M+N COLUMNS TO        121
C                BE TRIANGULARIZED.                                          122
      DIMENSION A(6,13)                                                      123
      DET=1.                                                                 124
      MM1=M-1                                                                125
      MPN=M+N                                                                126
      DO 5 J=1,MM1                                                           127
      MAXX = J                                                               128
      VALUE = ABSF ( A(J,J))                                                 129
      JP1=J+1                                                                130
      DO 1 K=JP1,M                                                           131
      IF ( VALUE - ABSF(A(K,J)))  2,1,1                                      132
   2  VALUE = ABSF(A(K,J))                                                   133
      MAXX=K                                                                 134
   1  CONTINUE                                                               135
      DO 3 L=J,MPN                                                           136
      TEMP = A(MAXX,L)                                                       137
      A(MAXX,L) = A(J,L)                                                     138
   3  A(J,L) = TEMP                                                          139
      IF ( MAXX-J) 7,6,7                                                     140
   7  DET  = - DET                                                           141
   6  DET = DET*A(J,J)                                                       142
      ROW = A(J,J)                                                           143
      DO 4 L=J,MPN                                                           144
   4  A(J,L) = A(J,L)/ROW                                                    145
      DO 5 K=JP1,M                                                           146
      ROW = A(K,J)                                                           147
      DO 5 L=J,MPN                                                           148
   5  A(K,L) = A(K,L)-ROW*A(J,L)                                             149
      DET = DET*A(M,M)                                                       150
      ROW = A(M,M)                                                           151
      DO 9 L = M,MPN                                                         152
   9  A(M,L) = A(M,L)/ROW                                                    153
      RETURN                                                                 154
      END                                                                    155
*     LIST 8                                                                 156
*     LABEL                                                                  157
CSOLVE   TO BE USED WITH SUBROUTINE GLSP                                     158
      SUBROUTINE SOLVE(A,M,N,X)                                              159
C                WHERE A IS THE TRIANGULARIZED MATRIX WITH M ROWS AND        160
C                M+N COLUMNS.                                                161
C                      X IS THE SOLUTION MATRIX WITH M ROWS AND N            162
C                COLUMNS.                                                    163
      DIMENSION A(6,13),X(6,7)                                               164
      MM1=M-1                                                                165
      DO 2 L=1,N                                                             166
      MPL=M+L                                                                167
      DO 2 K=1,MM1                                                           168
      MMK=M-K                                                                169
      MMKP1=MMK+1                                                            170
      X(M,L)=A(M,MPL)/A(M,M)                                                 171
      SUM=0.                                                                 172
      DO 3 I=MMKP1,M                                                         173
 3    SUM=SUM+A(MMK,I)*X(I,L)                                                174
 2    X(MMK,L)=A(MMK,MPL)-SUM                                                175
      RETURN                                                                 176
      END                                                                    177
