*WHTSL REM 0038 02131                                                   TSL 0001
*      FAP                                                              TSL 0002
* TEMPERATURE OF SATURATED LIQUID (TSL) STEAM TABLE SUBROUTINE          TSL 0003
       COUNT  35                                                        TSL 0004
       ENTRY  TSL                                                       TSL 0005
 TSL   CAS    TSLD+1    P VS .2                                         TSL 0006
       CAS    TSLD+3    P VS 3206.2                                     TSL 0007
       TRA    TSLER     ERROR - P OUT OF RANGE                          TSL 0008
       TRA    TSLER     X                                               TSL 0009
       SXA    TSL1,4    SAVE                                            TSL 0010
       TSX    $LOG,4    CANNOT CAUSE ERROR                              TSL 0011
       AXT    10,4      ASSUME P GREATER THAN 450. 234 CYCLES .51012 MS TSL 0012
       LDQ    =6.10924755 LN(450.)                                      TSL 0013
       TLQ    *+3       XFER IF ASSUMPTION CORRECT                      TSL 0014
       FAD    =2.30258509 LN(10.)                                       TSL 0015
       AXT    15,4      T LESS THAN 450. 301 CYCLES .65618 MS           TSL 0016
       STO    E+1                                                       TSL 0017
       CLA    TSLD+15,4                                                 TSL 0018
       XCA                                                              TSL 0019
       FMP    E+1                                                       TSL 0020
       FAD    TSLD+17,4                                                 TSL 0021
       TIX    *-3,4,2                                                   TSL 0022
 TSL1  AXT    **,4                                                      TSL 0023
       TRA    1,4                                                       TSL 0024
 TSLD  DEC    .68401559E-5,.199999,-.24901784E-3,3206.201,.0038658282   TSL 0025
       DEC    -.78073813,-.031329585,26.690978,.15741642,-363.44271     TSL 0026
       DEC    -.3414474,2477.7661,2.1182069,-8386.0182,24.592588        TSL 0027
       DEC    11545.164,35.15789                                        TSL 0028
 TSLER SXD    TSL-2,4                                                   TSL 0029
       CALL   ERROR,BCD                                                 TSL 0030
       PXD    ,0        RETURN ZERO                                     TSL 0031
       LXD    TSL-2,4                                                   TSL 0032
       TRA    1,4                                                       TSL 0033
 BCD   BCD 4PRESSURE OUT OF RANGE                                       TSL 0034
       OCT    777777777777                                              TSL 0035
       COMMON -168                                                      TSL 0036
 E     COMMON -1             USES E+1                                   TSL 0037
       END                                                              TSL 0038
