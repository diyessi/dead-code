       TXI *+1,1,1                                                      IPM20919
 LOCB  TXL ST1,1,**       DECREMENT N                                   IPM20920
       LXD D2,4           BEGIN RANK PROCESS. XR2 INDEXES ROWS          IPM20921
 ST4   LXD NN,2           XR2 INDEXES COLS FOR EACH ROW                 IPM20922
 ST2   CLA INDEX+1,2                                                    IPM20923
       PDX ,1             XR1 INDEXES ACTUAL MATRIX ELEMENTS            IPM20924
 LOCC  CLA A,1            ADDRESS IS A TO BEGIN EACH ROW RANK           IPM20925
       TZE *+2                                                          IPM20926
       TMI ST3            RANK FOUND                                    IPM20927
       TIX ST2,2,1                                                      IPM20928
       STZ KR+1,4         ROW HAS RANK ZERO                             IPM20929
       TXI ST5,4,1                                                      IPM20930
 ST3   PXD ,2             STORE CORRECT RANK                            IPM20931
       STO KR+1,4                                                       IPM20932
       TXI ST5,4,1                                                      IPM20933
 ST5   CAL LOCC           UPDATE MATRIX ADDRESS BY ONE ROW              IPM20934
       SUB A1                                                           IPM20935
       STA LOCC                                                         IPM20936
 LOCA  TXL ST4,4,**       DECREMENT M1                                  IPM20937
 ST    AXT     0,1                                                      IPM20938
       AXT     0,2                                                      IPM20939
       AXT     0,4                                                      IPM20940
