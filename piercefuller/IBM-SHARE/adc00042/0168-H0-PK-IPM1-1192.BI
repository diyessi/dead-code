*SLCTN SELECT MOST NEGATIVE ROW                                         IPM10322
       COUNT   93                                                       IPM10323
       ENTRY   SLCTN                                                    IPM10324
 SLCTN SXA     ST3,1                                                    IPM10325
       SXA     ST3+1,2                                                  IPM10326
       SXA     ST3+2,4                                                  IPM10327
       CLA N                                                            IPM10328
       STD ST5                                                          IPM10329
       CLA M1                                                           IPM10330
       STD LOCB                                                         IPM10331
       STD LOCC                                                         IPM10332
       STZ AMIN                                                         IPM10333
       STZ K2                                                           IPM10334
       LXD D2,1                                                         IPM10335
 ST1   CLA A+1,1                                                        IPM10336
       TZE ST2                                                          IPM10337
       CAS AMIN                                                         IPM10338
       TRA ST2                                                          IPM10339
       TRA ST2                                                          IPM10340
       STO AMIN                                                         IPM10341
       SXD I1,1                                                         IPM10342
 ST2   TXI *+1,1,1                                                      IPM10343
 LOCB  TXL ST1,1,**       DECREMENT M1                                  IPM10344
       CLA AMIN                                                         IPM10345
       TZE ST3            RETURN. PROBLEM COMPLETE                      IPM10346
       STO B                                                            IPM10347
       CLS I1                                                           IPM10348
       ARS 18                                                           IPM10349
       SUB ADDA                                                         IPM10350
       STO ADDX                                                         IPM10351
       CLS D2                                                           IPM10352
       STO K2                                                           IPM10353
       STO JZ1                                                          IPM10354
       LXD I1,1                                                         IPM10355
       TXI *+1,1,MDIM                                                   IPM10356
       LXD D2,2                                                         IPM10357
 ST4   CLA A+1,1          COPY ROW INTO B                               IPM10358
       STO B+1,2                                                        IPM10359
       TZE ST8                                                          IPM10360
       TPL ST8                                                          IPM10361
       CLA JZ1                                                          IPM10362
       SUB JZEROS+1,2                                                   IPM10363
       TZE ST9            TIE WITH ZEROS                                IPM10364
       TPL ST8            NEW COLUMN IS GREATER. IGNORE                 IPM10365
 ST10  CLA JZEROS+1,2     NEW COLUMN SMALLER. RECORD AS                 IPM10366
       STO JZ1              CURRENT SMALLEST                            IPM10367
       PXD ,1                                                           IPM10368
       ARS 18                                                           IPM10369
       ADD ADDX                                                         IPM10370
       STA ST7                                                          IPM10371
       SXD J1,2                                                         IPM10372
       TXI ST12,1,MDIM                                                  IPM10373
 ST9   PXD ,1             PICK UP ADDRESS FOR PRESENT COLUMN            IPM10374
       ARS 18             BREAK TIE                                     IPM10375
       ADD ADDX                                                         IPM10376
       STA LOCA                                                         IPM10377
       LXD JZ1,4                                                        IPM10378
       TXI *+1,4,1                                                      IPM10379
 ST7   CLA **,4           ADDRESS, TOP OF CURRENT J1 COLUMN             IPM10380
 LOCA  SUB **,4           ADDRESS, TOP OF COLUMN BEING TESTED           IPM10381
       TZE ST11           TIE, CONTINUE TEST                            IPM10382
       TPL ST10           NEW COLUMN SMALLER. REPLACE J1                IPM10383
       TMI ST8            NEW COLUMN GREATER. IGNORE                    IPM10384
 ST11  TXI *+1,4,1                                                      IPM10385
 LOCC  TXL ST7,4,**       DECREMENT,M1                                  IPM10386
       SXD     LOCD,2               ERROR/TWO EQUAL COLUMNS             IPM10387
       CALL    OFF,RTN,CODE,J1,LOCD                                     IPM10388
 LOCD  PZE                                                              IPM10389
 ST8   TXI *+1,1,MDIM     DECREMENT, COLUMN LENGTH                      IPM10390
 ST12  TXI *+1,2,1                                                      IPM10391
 ST5   TXL ST4,2,**       DECREMENT,N                                   IPM10392
 ST3   AXT     0,1                                                      IPM10393
       AXT     0,2                                                      IPM10394
       AXT     0,4                                                      IPM10395
       TRA 1,4                                                          IPM10396
 CODE  PZE     ,,4                                                      IPM10397
 RTN   BCD 1SLCTN                                                       IPM10398
 ADDA  HTR A+1                                                          IPM10399
 D2    PZE ,,2                                                          IPM10400
 AMIN  PZE                                                              IPM10401
 JZ1   PZE                                                              IPM10402
 ADDX  PZE                                                              IPM10403
 MDIM  EQU 204                                                          IPM10404
 A     COMMON  21320                                                    IPM10405
 B     COMMON  312                                                      IPM10406
JZEROS COMMON  921                                                      IPM10407
