 ST16  TXI *+1,4,1                                                      IPM10531
 LOCC  TXL ST14,4,0       DECREMENT M1                                  IPM10532
       CALL    OFF,RTN,BCODE,J1,J3                                      IPM10533
 ERHLT CALL    OFF,RTN,ACODE,J1,J3                                      IPM10534
 RTN   BCD 1SLCTR                                                       IPM10535
 D1    PZE ,,1                                                          IPM10536
 D2    PZE ,,2                                                          IPM10537
 ADDA  HTR A+1                                                          IPM10538
 ACODE PZE     ,,5                                                      IPM10539
 BCODE PZE     ,,4                                                      IPM10540
 I3    PZE                CURRENT ROW BEING TESTED                      IPM10541
 J3    PZE                PIVOT COLUMN OF I3                            IPM10542
 JZ3   PZE                ZERO COUNT OF J3                              IPM10543
 JZ1   PZE                ZERO COUNT OF J1                              IPM10544
 MDIM  EQU 204                                                          IPM10545
