       TPL ST12                                                         IPM10434
       SXD I3,1           ROW I HAS NEGATIVE IN CONSTANT COL            IPM10435
       TXI *+1,1,MDIM     XR1 NOW INDEXES ACROSS ROW I3                 IPM10436
       LXD D2,2           XR 2 INDEXES COLS FOR TEST ROW I              IPM10437
       CLS D1             INITIALIZE JZ3 FOR EACH ROW                   IPM10438
       STO JZ3                                                          IPM10439
 ST5   CLA A+1,1                                                        IPM10440
       TZE ST1            SKIP COL IF TEST ROW CONTAINS +OR0            IPM10441
       TPL ST1                                                          IPM10442
       CLA JZEROS+1,2                                                   IPM10443
       CAS JZ1            COMPARE ZEROS WITH JZ1                        IPM10444
       TRA ST2            ROW WILL HAVE HIGHER RANK, SO SKIP            IPM10445
       NOP                                                              IPM10446
       CAS JZ3            COMPARE ZEROS WITH JZ3                        IPM10447
       TRA ST3            REPLACE J3 BY CURRENT COL                     IPM10448
       TRA ST4            ZEROS TIE BETWEEN J3 AND CURRENT COL          IPM10449
 ST1   TXI *+1,1,MDIM     CURRENT COL EXCEEDS J3. NO REPLACEMENT        IPM10450
 ST6   TXI *+1,2,1                                                      IPM10451
 LOCD  TXL ST5,2,0        DECREMENT M1                                  IPM10452
       CLA J1             TEST IF J1 EXISTS YET                         IPM10453
       TNZ ST18           TEST IF J3,J1 SAME                            IPM10454
       CLA JZ3                                                          IPM10455
       TRA ST19                                                         IPM10456
 ST18  SUB J3             TEST IF J3,J1 SAME                            IPM10457
       TZE ST13           IF SO, PICK MOST NEGATIVE OF I1,I3            IPM10458
       CLA JZ3                                                          IPM10459
       CAS JZ1                                                          IPM10460
       TRA     ERHLT                JZ3 EXCEEDS JZ1. PREVIOUS TEST FAIL IPM10461
       TRA ST10           ZEROS TIE,J1 AND J3                           IPM10462
 ST19  STO JZ1            J3 EXCEEDS J1. REPLACE J1 WITH J3             IPM10463
 ST17  CLA J3                                                           IPM10464
       STO J1                                                           IPM10465
       CAL ST8                                                          IPM10466
       STA ST14                                                         IPM10467
 ST15  CLA I3                                                           IPM10468
       STO I1                                                           IPM10469
 ST2   LXD I3,1           END OUTSIDE LOOP                              IPM10470
 ST12  TXI *+1,1,1                                                      IPM10471
 LOCF  TXL ST11,1,0       DECREMENT M1                                  IPM10472
       CLA J1             TEST IF PROBLEM DONE                          IPM10473
       TNZ ST20                                                         IPM10474
       STZ K2                                                           IPM10475
       TRA ST22                                                         IPM10476
 ST20  LXD D1,2           COPY ROW I1 INTO B                            IPM10477
       LXD I1,1                                                         IPM10478
 ST21  CLA A+1,1                                                        IPM10479
       STO B+1,2                                                        IPM10480
       TXI *+1,1,MDIM                                                   IPM10481
       TXI *+1,2,1                                                      IPM10482
 LOCG  TXL ST21,2,0       DECREMENT,N                                   IPM10483
 ST22  AXT     0,1                                                      IPM10484
       AXT     0,2                                                      IPM10485
       AXT     0,4                                                      IPM10486
       TRA 1,4                                                          IPM10487
 ST3   STO JZ3            REPLACE J3 BY CURRENT COL                     IPM10488
       SXD J3,2                                                         IPM10489
       PXD ,1                                                           IPM10490
       SUB I3                                                           IPM10491
       ARS 18                                                           IPM10492
       SUB ADDA                                                         IPM10493
       STA ST8                                                          IPM10494
       TXI ST6,1,MDIM                                                   IPM10495
 ST4   PXD ,1                                                           IPM10496
       SUB I3                                                           IPM10497
       ARS 18                                                           IPM10498
       SUB ADDA                                                         IPM10499
       STA LOCA                                                         IPM10500
       LXD JZ3,4                                                        IPM10501
       TXI *+1,4,1                                                      IPM10502
 ST8   CLA 0,4            ADDRESS IS TOP OF COL J3                      IPM10503
 LOCA  SUB 0,4            ADDRESS IS TOP OF CURRENT COL                 IPM10504
       TZE ST7                                                          IPM10505
       TMI ST1            CURRENT COL EXCEEDS J3. HENCE SKIP COL        IPM10506
       CAL LOCA           TEST COL SMALLER. HENCE REPLACE J3            IPM10507
       STA ST8                                                          IPM10508
       SXD J3,2                                                         IPM10509
       TXI ST6,1,MDIM                                                   IPM10510
 ST7   TXI *+1,4,1                                                      IPM10511
 LOCE  TXL ST8,4,0        DECREMENT M1                                  IPM10512
       SXD     LOCH,2               ERROR/TWO EQUAL COLUMNS             IPM10513
       CALL    OFF,RTN,BCODE,J3,LOCH                                    IPM10514
 LOCH  PZE                                                              IPM10515
 ST13  LXD I3,1                                                         IPM10516
       LXD I1,4                                                         IPM10517
       CLA A+1,1                                                        IPM10518
       SUB A+1,4                                                        IPM10519
       TZE ST2            DO NOT REPLACE                                IPM10520
       TPL ST2                                                          IPM10521
       TRA ST15           REPLACE                                       IPM10522
 ST10  LXD JZ1,4                                                        IPM10523
       CAL ST8                                                          IPM10524
       STA LOCB                                                         IPM10525
 ST14  CLA 0,4            ADDRESS IS TOP OF COL J1                      IPM10526
 LOCB  SUB 0,4            ADDRESS IS TOP OF COL J3                      IPM10527
       TZE ST16                                                         IPM10528
       TMI ST17           J3 EXCEEDS J1. HENCE REPLACE J1               IPM10529
