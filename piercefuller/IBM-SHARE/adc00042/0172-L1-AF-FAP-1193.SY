*CHAVY  MODIFICATIONS FORTRAN POUR ACCEPTER AFFAP , MODIFICATIONS AFFAP AFCOR000
*      FAP                                                              AFCOR001
*                                                                       AFCOR002
       COUNT   130                                                      AFCOR003
       REM                                                              AFCOR004
       REM                                                              AFCOR005
A35    BOOL    35                                                       AFCOR006
A54    BOOL    54                                                       AFCOR007
A57    BOOL    57                                                       AFCOR008
A154   BOOL    154                                                      AFCOR009
A165   BOOL    165                                                      AFCOR010
A201   BOOL    201                                                      AFCOR011
L(6)   BOOL    240                                                      AFCOR012
A244   BOOL    244                                                      AFCOR013
A255   BOOL    255                                                      AFCOR014
A267   BOOL    267                                                      AFCOR015
WINTDP BOOL    303                                                      AFCOR016
RECOR  BOOL    373                                                      AFCOR017
A416   BOOL    416                                                      AFCOR018
A15062 BOOL    15062                                                    AFCOR019
A15065 BOOL    15065                                                    AFCOR020
       REM                                                              AFCOR021
       REM                                                              AFCOR022
       REM                                                              AFCOR023
       REM                                                              AFCOR024
* CHAVY     MODIFICATIONS FORTRAN POUR ACCEPTER AFFAP      11 AOUT 1961 AFCOR025
*      REM                                                              AFCOR026
       REM                                                              AFCOR027
       REM                                                              AFCOR028
       REM                    CARTE F001C000                            AFCOR029
       FUL                                                              AFCOR030
       PON     ,,2            9L                                        AFCOR031
       PON     72+END3,,228   9R                                        AFCOR032
       PZE     72,,226        8L                                        AFCOR033
       PZE     END3           8R                                        AFCOR034
       ABS                                                              AFCOR035
       REM                                                              AFCOR036
       REM                    CARTE F001C001                            AFCOR037
       ORG     A416                                                     AFCOR038
       RTB     1                                                        AFCOR039
       CPY     RECOR                                                    AFCOR040
       TRA     *-2                                                      AFCOR041
       RTB     1              SKIP MON                                  AFCOR042
       RTB     1              SKIP FAP1                                 AFCOR043
       RTB     1              SKIP FAP2                                 AFCOR044
       TRA     4                                                        AFCOR045
END3   BSS     0                                                        AFCOR046
       REM                                                              AFCOR047
       REM                    CARTE F010C000                            AFCOR048
       FUL                                                              AFCOR049
       PON     ,,2            9L                                        AFCOR050
       PON     24+END1,,26    9R                                        AFCOR051
       PZE     24,,24         8L                                        AFCOR052
       PZE     END1           8R                                        AFCOR053
       ABS                                                              AFCOR054
       REM                                                              AFCOR055
       REM                    CARTE F010C002                            AFCOR056
       ORG     A54                                                      AFCOR057
       TRA     PATCH                                                    AFCOR058
       EJECT                                                            AFCOR059
       REM                    CARTE F010C003                            AFCOR060
       ORG     A57                                                      AFCOR061
PATCH  RTB     1              SKIP MON                                  AFCOR062
       RTB     1              SKIP FAP1                                 AFCOR063
       RTB     1              SKIP FAP2                                 AFCOR064
       RTB     1              SKIP BATCH MONITOR                        AFCOR065
       TRA     4                                                        AFCOR066
END1   BSS     0                                                        AFCOR067
       REM                                                              AFCOR068
       REM                    CARTE  F012C001                           AFCOR069
       ORG     A154                                                     AFCOR070
SPROER NOP                                                              AFCOR071
BSTRTN LXA     L(6),4                                                   AFCOR072
       BST     1                                                        AFCOR073
       TIX     *-1,4,1                                                  AFCOR074
       REM                                                              AFCOR075
       REM                    CARTE F012C002                            AFCOR076
       ORG     A165                                                     AFCOR077
       NOP                    NO REWIND ON TAPE 5.                      AFCOR078
       REM                                                              AFCOR079
       REM                    CARTE F013C000                            AFCOR080
       FUL                                                              AFCOR081
       PON     ,,2                                                      AFCOR082
       PON     24+END2,,26                                              AFCOR083
       PZE     24,,24                                                   AFCOR084
       PZE     END2                                                     AFCOR085
       ABS                                                              AFCOR086
       REM                                                              AFCOR087
       REM                    CARTE F013C001                            AFCOR088
       ORG     A35                                                      AFCOR089
       BST     1              BACKSPACE OVER FAP2                       AFCOR090
       BST     1              BACKSPACE OVER FAP1                       AFCOR091
       BST     1              BACKSPACE OVER MON                        AFCOR092
       TRA     4              T0 1-CS                                   AFCOR093
END2   BSS     0                                                        AFCOR094
       REM                                                              AFCOR095
       REM                    CARTE F020AC01                            AFCOR096
       ORG     A15062                                                   AFCOR097
       TXI     *+1,2,11       VALID ONLY FOR 32K DRUMLESS FORTRAN       AFCOR098
       REM                    FOR 8K VERSION DECREMENT MUST BE SET      AFCOR099
       REM                    EQUAL TO 10                               AFCOR100
       REM                                                              AFCOR101
       REM                    CARTE F020AC02                            AFCOR102
       ORG     A15065                                                   AFCOR103
       TXI     *+1,2,-6                                                 AFCOR104
       REM                                                              AFCOR105
       REM                    CARTE D0020C04                            AFCOR106
       ORG     A244                                                     AFCOR107
       LXA     A267,4                                                   AFCOR108
       REM                                                              AFCOR109
       REM                    CARTE D0020C05                            AFCOR110
       ORG     A255                                                     AFCOR111
       TIX     *-1,4,3        GO TO MACHINE ERROR RECORD                AFCOR112
       EJECT                                                            AFCOR113
       REM                                                              AFCOR114
       REM                                                              AFCOR115
* CHAVY     MODIFICATIONS EVENTUELLES DE AFFAP             11 AOUT 1961 AFCOR116
       REM                                                              AFCOR117
       REM                                                              AFCOR118
       REM                                                              AFCOR119
       REM PATCH TO FAP1 TO SUPPRESS THE SECOND INTERMEDIARY TAPE       AFCOR120
       REM                                                              AFCOR121
       REM                    CARTE FAP1C001                            AFCOR122
       ORG     A267                                                     AFCOR123
WINTIX TIX     WINTDP,4,0                                               AFCOR124
       REM                                                              AFCOR125
       REM                                                              AFCOR126
       REM PATCH TO FAP1 TO SUPPRESS STANDARD ERROR PROCEDURE           AFCOR127
       REM                                                              AFCOR128
       REM                    CARTE FAP1C002                            AFCOR129
       ORG     A201                                                     AFCOR130
SEPRO  PZE                                                              AFCOR131
       REM                                                              AFCOR132
       REM                                                              AFCOR133
       END                                                              AFCOR134
