*9974S 5 15 MOORE     ASSEMBLE SORT FOR SHARE                                   
*      N O    G O                                                               
*      P    A    U    S    E                                                    
*      FAP                                                              SORT0001
*SORTAC        SORTING ROUTINES FOR FORTRAN                             SORT0002
       COUNT   300                                                      SORT0003
       LBL     WDSORT,1                                                 SORT0004
       ENTRY   SORTA                                                    SORT0005
       ENTRY   SORTAC                                                   SORT0006
       ENTRY   SORTD                                                    SORT0007
       ENTRY   SORTDC                                                   SORT0008
SORTD  BES     0                                                        SORT0009
SORTDC STZ     ACFLG                                                    SORT0010
       TRA     SORT                                                     SORT0011
SORTA  BES     0                                                        SORT0012
SORTAC CLA     =1                                                       SORT0013
       STO     ACFLG                                                    SORT0014
SORT   SXA     XA,1                                                     SORT0015
       SXA     XB,2                                                     SORT0016
       SXA     XC,4                                                     SORT0017
       STI     SI                                                       SORT0018
*                                                                       SORT0019
       AXT     1,1           PRESET PARAMETERS IN CASE OF               SORT0020
       SXA     LENG,1        ...SHORT CALLING SEQUENCE                  SORT0021
       AXT     INFTY+1,1                                                SORT0022
       SXA     KEYS,1                                                   SORT0023
       AXT     MAXA,1        CLEAR A-TABLE                              SORT0024
       STZ     ENDA,1                                                   SORT0025
       TIX     *-1,1,1                                                  SORT0026
       AXT     LSBIT,1       CLEAR SIGN-BIT TABLE                       SORT0027
       STZ     ESBIT,1                                                  SORT0028
       TIX     *-1,1,1                                                  SORT0029
*              WHEN SETN IS FULLY CODED, REPLACE                        SORT0030
*              FOLLOWING INSTRUCTION WITH CODE TO                       SORT0031
*              PICK UP A FORTRAN INTEGER ONE                            SORT0032
       CLA     =1B17         FOR NOW, FAKE IT                           SORT0033
       ARS     18                                                       SORT0034
       STO     OLDFG         SET OLD-FORTRAN FLAG                       SORT0035
       TZE     SETN                                                     SORT0036
       TTL     INITIALIZATION FOR OLD FORTRAN                           SORT0037
SETO   LXA     XC,4                                                     SORT0038
       CAL     1,4                                                      SORT0039
       STA     WHERE                                                    SORT0040
       CAL*    2,4                                                      SORT0041
       ARS     18                                                       SORT0042
       STA     QUANT                                                    SORT0043
       ARS     17                                                       SORT0044
       SLW     LOGFG         SIGN BIT SAYS DO LOGICAL SORT              SORT0045
       TXI     *+1,4,-2                                                 SORT0046
       CAL     1,4           IS THIRD PARAMETER PRESENT                 SORT0047
       ERA     TSX                                                      SORT0048
       ARS     15                                                       SORT0049
       TNZ     SETOF         NO                                         SORT0050
       TXI     *+1,4,-1      YES, BUMP XR4 DOWN ONE MORE                SORT0051
       CAL*    0,4                                                      SORT0052
       ARS     18                                                       SORT0053
       STA     LENG                                                     SORT0054
       STT     LOGFG         SIGN BIT SAYS DO LOGICAL SORT              SORT0055
       CAL     1,4           IS FOURTH PARAMETER PRESENT                SORT0056
       ERA     TSX                                                      SORT0057
       ARS     15                                                       SORT0058
       TZE     SETOG                                                    SORT0059
       CLA     LENG          NO,IS LENGTH EXACTLY 1                     SORT0060
       SUB     =1                                                       SORT0061
       SXA     XC,4                                                     SORT0062
       TNZ     ERROR         NO                                         SORT0063
       TRA     SETOF         YES                                        SORT0064
SETOG  TXI     *+1,4,-1      FOURTH PARAMETER IS PRESENT                SORT0065
       CLA     0,4                                                      SORT0066
       ADD     =1                                                       SORT0067
       STA     KEYS                                                     SORT0068
SETOF  SXA     XC,4                                                     SORT0069
       LDQ     LENG                                                     SORT0070
       VLM     QUANT,,15                                                SORT0071
       LLS     15                                                       SORT0072
       STA     LNGQT         LENGTH TIMES QUANTITY                      SORT0073
       SUB     =1                                                       SORT0074
       SUB     WHERE                                                    SORT0075
       STA     WHERE         WHERE IS SMALLEST ADDRESS OF DATA          SORT0076
       LXA     LENG,1                                                   SORT0077
       SXD     LENGD,1                                                  SORT0078
       SXD     SETOE,1                                                  SORT0079
*                                                                       SORT0080
*              INITIALIZE A-TABLE KEY LOCATORS                          SORT0081
*                                                                       SORT0082
       AXT     MAXA,1                                                   SORT0083
SETOA  AXT     1,2           START ON NEXT ARRAY OF KEYS                SORT0084
SETOB  PXD     ,2            START ON NEXT WORD OF KEY                  SORT0085
       SUB     LENGD         (LENGTH)                                   SORT0086
       ARS     3                                                        SORT0087
       PAI                                                              SORT0088
       TSX     KEYS,4        GET NEXT WORD OF KEY BITS                  SORT0089
       AXT     36,4                                                     SORT0090
SETOC  TQP     SETOD         IS THIS A KEY BIT POSITION                 SORT0091
       PXD     ,4            YES, BUILD A-TABLE ENTRY                   SORT0092
       SUB     =37B17                                                   SORT0093
       ALS     12                                                       SORT0094
       STI     ENDA,1                                                   SORT0095
       ORS     ENDA,1                                                   SORT0096
       TNX     ERROR,1,1                                                SORT0097
*                                                                       SORT0098
SETOD  RQL     1                                                        SORT0099
       TIX     SETOC,4,1                                                SORT0100
       TXI     *+1,2,1                                                  SORT0101
SETOE  TXL     SETOB,2,*-*   (LENGTH)                                   SORT0102
*                                                                       SORT0103
       LXA     XC,4          LOOK FOR ANOTHER PARAMETER                 SORT0104
       CAL     1,4                                                      SORT0105
       ERA     TSX                                                      SORT0106
       ARS     15                                                       SORT0107
       TNZ     SETUP                                                    SORT0108
       TXI     *+1,4,-1      ...IN CALLING SEQUENCE                     SORT0109
       SXA     XC,4          THERE IS ONE, USE IT AS                    SORT0110
       CLA     0,4           ...NEW ARRAY OF KEYS                       SORT0111
       ADD     =1                                                       SORT0112
       STA     KEYS                                                     SORT0113
       TRA     SETOA                                                    SORT0114
       TTL     INITIALIZATION FOR NEW FORTRAN                           SORT0115
SETN   LAC     *-*+**,4                                                 SORT0116
       TXI     *+1,4,*-*+**                                             SORT0117
       CLA*    **,4                                                     SORT0118
       STA     WHERE         WHERE IS SMALLEST ADDRESS OF DATA          SORT0119
       CAL*    **+1,4                                                   SORT0120
       STA     QUANT                                                    SORT0121
       ARS     35                                                       SORT0122
       SLW     LOGFG                                                    SORT0123
       CLA*    **+2,4                                                   SORT0124
       STA     LENG                                                     SORT0125
       TPL     *+2                                                      SORT0126
       STL     LOGFG                                                    SORT0127
       CLA     **+3,4                                                   SORT0128
       ADD     LENG                                                     SORT0129
       STA     KEYS                                                     SORT0130
       SXA     RTURN,4       SET UP RETURN                              SORT0131
       CLA     **,4                                                     SORT0132
       PZE     **                                                       SORT0133
       STA     CSCNT         SET UP CALLING-SEQUENCE COUNT              SORT0134
       SXA     NXKYS,4                                                  SORT0135
       LDQ     LENG                                                     SORT0136
       VLM     QUANT,,15                                                SORT0137
       LLS     15                                                       SORT0138
       STA     LNGQT         LENGTH TIMES QUANTITY                      SORT0139
       LXA     LENG,1                                                   SORT0140
       SXD     LENGD,1                                                  SORT0141
*                                                                       SORT0142
*              INITIALIZE A-TABLE KEY LOCATORS                          SORT0143
*                                                                       SORT0144
       AXT     MAXA,1                                                   SORT0145
SETNA  LXA     LENG,2        START ON NEXT ARRAY OF KEYS                SORT0146
SETNB  PXD     ,2            START ON NEXT WORD OF KEY                  SORT0147
       ARS     3                                                        SORT0148
       PAI                                                              SORT0149
       TSX     KEYS,4        GET NEXT WORD OF KEY BITS                  SORT0150
       AXT     36,4                                                     SORT0151
SETNC  TQP     SETND         IS THIS A KEY BIT POSITION                 SORT0152
       PXD     ,4            YES, BUILD A-TABLE ENTRY                   SORT0153
       SUB     =37B17                                                   SORT0154
       ALS     12                                                       SORT0155
       STI     ENDA,1                                                   SORT0156
       ORS     ENDA,1                                                   SORT0157
       TNX     ERROR,1,1                                                SORT0158
*                                                                       SORT0159
SETND  RQL     1                                                        SORT0160
       TIX     SETNC,4,1                                                SORT0161
       TIX     SETNB,2,1                                                SORT0162
*                                                                       SORT0163
NXKYS  AXT     *-*,4                                                    SORT0164
       TXI     **,4,**                                                  SORT0165
       SXA     *-*,4                                                    SORT0166
       SXA     *+1,4                                                    SORT0167
       CLA     *-*                                                      SORT0168
       ADD     LENG                                                     SORT0169
       STA     KEYS                                                     SORT0170
CSCNT  AXT     *+1,4                                                    SORT0171
       TXI     *+1,4,-1                                                 SORT0172
       SXA     CSCNT,4                                                  SORT0173
       TRA     SETNA                                                    SORT0174
       TTL     SUBROUTINE TO GET NEXT WORD OF KEYS ARRAY                SORT0175
*      SUBROUTINE GETS WORD POINTED TO IN XR2 INTO MQ                   SORT0176
*      MAKES REPLACEMENT FOR CERTAIN CODED PATTERNS                     SORT0177
*      STORES INDICATION OF SIGN BIT FOR ALGEBRAIC SORT                 SORT0178
*      TRANSFERS TO ERROR IF ALGEBRAIC SORT,                            SORT0179
*              AND XR2 IS TOO BIG                                       SORT0180
*                                                                       SORT0181
KEYS   CLA     *-*,2         PICK UP WORD OF KEY BITS                   SORT0182
       LAS     =1.0          IGNORING SIGN,                             SORT0183
       TRA     KYST          ...REPLACE FLOATING-POINT ONE              SORT0184
       CLA     INFTY         ...BY FULL-WORD MASK                       SORT0185
       LAS     =1B17         ...REPLACE ONE IN DECREMENT                SORT0186
       TRA     KYST                                                     SORT0187
       CLA     KYUH          ...BY UPPER HALF WORD                      SORT0188
       LAS     =1            ...REPLACE ONE IN ADDRESS                  SORT0189
       TRA     KYST                                                     SORT0190
       CLA     KYLH          ...BY LOWER HALF WORD                      SORT0191
KYST   STO     TMP                                                      SORT0192
       TPL     KYLQ          IS SIGN BIT INCLUDED                       SORT0193
       ZET     LOGFG         YES, IS SORT ALGEBRAIC                     SORT0194
       TRA     KYLQ          NO                                         SORT0195
       PXA     ,2            YES, USE LENGTH MINUS XR2                  SORT0196
       SSM                   ...TO FIND BIT POSITION                    SORT0197
       ADD     LENG          ...AND LOCATION                            SORT0198
       LDQ     =0            ...IN SIGN-BIT TABLE                       SORT0199
       LRS     10                                                       SORT0200
       VDP     =36,,10                                                  SORT0201
       STA     KYSH                                                     SORT0202
       XCA                                                              SORT0203
       CAS     KYLM          IS LENGTH MINUS XR2 TOO BIG                SORT0204
       TRA     ERROR         YES                                        SORT0205
       TRA     ERROR         YES                                        SORT0206
       ADD     KYAC          NO                                         SORT0207
       STA     KYSB                                                     SORT0208
       CAL     =-0                                                      SORT0209
KYSH   ARS     *-*                                                      SORT0210
KYSB   ORS     *-*                                                      SORT0211
*                                                                       SORT0212
KYLQ   LDQ     TMP           PUT WORD OF KEYS INTO MQ                   SORT0213
       TRA     1,4           RETURN                                     SORT0214
*                                                                       SORT0215
INFTY  SVN     -1,-1,-1      FULL-WORD MASK                             SORT0216
KYUH   SVN     0,0,-1        UPPER-HALF-WORD MASK                       SORT0217
KYLH   MZE     -1,7,0        SIGN PLUS LOWER-HALF WORD MASK             SORT0218
KYLM   PZE     LSBIT         (LENGTH OF SBIT TABLE)                     SORT0219
KYAC   PZE     SBIT          BASE ADDRESS OF SIGN-BIT TABLE             SORT0220
       TTL     INITIALIZE INSTRUCTIONS IN MAIN ROUTINE                  SORT0221
SETUP  LXA     QUANT,4       IS QUANTITY GREATER THAN 1                 SORT0222
       TXL     ERROR,4,1     NO                                         SORT0223
       LXA     LENG,4        YES, IS LENGTH NON-ZERO                    SORT0224
       TXL     ERROR,4,0     NO                                         SORT0225
       SXD     ALGTX,4                                                  SORT0226
       SXD     PLGTX,4                                                  SORT0227
       SXD     TXTWA,4                                                  SORT0228
       SXD     TXTWB,4                                                  SORT0229
       SXD     TXTWC,4                                                  SORT0230
       SXA     AXTWA,4                                                  SORT0231
       SXD     TXFVA,4                                                  SORT0232
       LAC     LENG,4                                                   SORT0233
       SXD     TXONZ,4                                                  SORT0234
       SXD     TXTWZ,4                                                  SORT0235
       SXD     TXTHZ,4                                                  SORT0236
*                                                                       SORT0237
       CAL OLDFG             INITIALIZE DIRECTION OF SORT               SORT0238
       ERA     ACFLG         IF SET, REVERSE SENSE OF ASCENDING         SORT0239
       TZE     GODN                                                     SORT0240
GOUP   LDQ     TIF           SORT LARGER KEYS TO LARGER ADDRESSES       SORT0241
       SLQ     TIUP                                                     SORT0242
       LDQ     TIO                                                      SORT0243
       TRA     GODNA                                                    SORT0244
*                                                                       SORT0245
GODN   LDQ     TIO           SORT LARGER KEYS TO SMALLER ADDRESSES      SORT0246
       SLQ     TIUP                                                     SORT0247
       LDQ     TIF                                                      SORT0248
GODNA  SLQ     TIDN                                                     SORT0249
*                                                                       SORT0250
       CAL     WHERE                                                    SORT0251
       ADD     LNGQT                                                    SORT0252
       SUB     LENG          COMPLEMENT OF SMALLEST ADDRESS IN          SORT0253
       PAC     ,1            ...LAST ITEM IS INITIAL VALUE OF A         SORT0254
       SXA     A,1                                                      SORT0255
       LAC     WHERE,1       COMPLEMENT OF WHERE                        SORT0256
       SXA     B,1           ...IS INITIAL VALUE OF B                   SORT0257
       TTL     PRE-PROCESSOR FOR ALGEBRAIC SORT                         SORT0258
       ZET     LOGFG         IS THIS AN ALGEBRAIC SORT                  SORT0259
       TRA     ZERO          NO                                         SORT0260
       CLA     LNGQT         YES, INITIALIZE PREPROCESSOR               SORT0261
       ADD     WHERE         ...AND POSTPROCESSOR                       SORT0262
       STA     ALGGT                                                    SORT0263
       STA     PLGGT                                                    SORT0264
       STA     ALGST                                                    SORT0265
       STA     PLGST                                                    SORT0266
       AXT     LSBIT,1                                                  SORT0267
       AXT     0,2                                                      SORT0268
ALGSX  SXA     ALGAX,2       SAVE EACH MULTIPLE OF 36                   SORT0269
       LDQ     ESBIT,1       PICK UP NEXT WORD OF FLAGS                 SORT0270
ALGTQ  TQP     ALGNX         WAS SIGN BIT SORTED UPON                   SORT0271
       PXA     ,2            YES,LOCATE WORD WITHIN ITEM                SORT0272
       SUB     LNGQT         (LENGTH TIMES QUANTITY)                    SORT0273
       PAX     ,4                                                       SORT0274
ALGGT  CLA     *-*,4         (WHERE PLUS LNGGT)                         SORT0275
       TPL     *+2           PICK UP A WORD WITHIN AN ITEM              SORT0276
       COM                   COMPLEMENT THE NEGATIVES                   SORT0277
       CHS                   ...AND CHANGE ALL SIGNS                    SORT0278
ALGST  STO     *-*,4                                                    SORT0279
ALGTX  TIX     ALGGT,4,*-*   (LENGTH)                                   SORT0280
ALGNX  STQ     TMP                                                      SORT0281
       LGL     1                                                        SORT0282
       ZET     TMP           WAS MQ JUST PZE OR MZE                     SORT0283
       TXI     ALGTQ,2,1     NO, FIND THAT BIT                          SORT0284
ALGAX  AXT     *-*,2         YES, ON TO NEXT MULTIPLE OF 36             SORT0285
       TXI     *+1,2,36                                                 SORT0286
       TIX     ALGSX,1,1                                                SORT0287
       TTL      SORTING ROUTINE PROPER                                  SORT0288
ZERO   AXT     0,4           INITIALIZE A-TABLE INDEX                   SORT0289
*                                                                       SORT0290
*              INITIALIZE KEY-SEARCH AND EXCHANGE ROUTINE               SORT0291
*                                                                       SORT0292
ONE    SXA     AINDX,4       XR4 CONTAINS CURRENT A-TABLE INDEX         SORT0293
       CAL     A,4           PICK UP CURRENT A-TABLE ENTRY              SORT0294
       PAX     ,2                                                       SORT0295
       ARS     15                                                       SORT0296
       TZE     SIX           WHOOPS, NO MORE KEY BITS -- DUPLICATES     SORT0297
       STA     LDIH          SET UP KEY WORD PICKUPS                    SORT0298
       STA     LDIL                                                     SORT0299
       ALS     3                                                        SORT0300
       PDX     ,1                                                       SORT0301
       CAL     =1                                                       SORT0302
       ALS     36,1          POSITION KEY BIT IN AC                     SORT0303
       LXA     B,1                                                      SORT0304
TXONZ  TXI     THREE,2,*-*   (COMPLEMENT OF LENGTH)                     SORT0305
*                                                                       SORT0306
*              SEARCH UP FOR KEY BIT EQUAL TO ZERO                      SORT0307
*                                                                       SORT0308
TWO    BES     0                                                        SORT0309
TXTWZ  TXI     *+1,1,*-*     (COMPLEMENT OF LENGTH)                     SORT0310
TXTWA  TXI     *+1,2,*-*     (LENGTH)                                   SORT0311
       SXD     *+1,1         SET UP                                     SORT0312
       TXH     FIVE,2,*-*    TEST FOR COLLISION                         SORT0313
LDIH   LDI     *-*,2         PICK UP WORD CONTAINING KEY                SORT0314
TIUP   TIF     *+2           (MAY BE CHANGED TO TIO)                    SORT0315
TXTWB  TXI     *-3,2,*-*     (LENGTH)                                   SORT0316
*                                                                       SORT0317
*              EXCHANGE ENTRIES AT -LENGTH,1 AND 0,2                    SORT0318
*                                                                       SORT0319
       SXA     *+1,1                                                    SORT0320
       AXC     *-*,4                                                    SORT0321
       SXA     EXA,4                                                    SORT0322
       SXA     EXB,4                                                    SORT0323
       SXA     *+1,2                                                    SORT0324
       AXC     *-*,4                                                    SORT0325
TXTWC  TXI     *+1,4,*-*     (LENGTH)                                   SORT0326
       SXA     EXY,4                                                    SORT0327
       SXA     EXZ,4                                                    SORT0328
AXTWA  AXT     *-*,4         (LENGTH)                                   SORT0329
EXA    LDI     *-*,4                                                    SORT0330
EXY    LDQ     *-*,4                                                    SORT0331
EXB    STQ     *-*,4                                                    SORT0332
EXZ    STI     *-*,4                                                    SORT0333
       TIX     EXA,4,1                                                  SORT0334
*                                                                       SORT0335
*              SEARCH DOWN FOR KEY BIT EQUAL TO ONE                     SORT0336
*                                                                       SORT0337
THREE  SXD     *+1,2         SET UP                                     SORT0338
       TXL     FIVE,1,*-*    TEST FOR COLLISION                         SORT0339
LDIL   LDI     *-*,1         PICK UP WORD CONTAINING KEY                SORT0340
TIDN   TIO     TWO           (MAY BE CHANGED TO TIF)                    SORT0341
TXTHZ  TXI     *-3,1,*-*     (COMPLEMENT OF LENGTH)                     SORT0342
*                                                                       SORT0343
*              BLOCK JUST TREATED WAS ALL ONES, MOVE POINTER            SORT0344
*                                                                       SORT0345
FOUR   CAL     A,4                                                      SORT0346
       ANA     =O77777                                                  SORT0347
       TRA     FIVEA                                                    SORT0348
*                                                                       SORT0349
*              BLOCK HAS BEEN TREATED, DO HOUSEKEEPING                  SORT0350
*                                                                       SORT0351
FIVE   BSS     0                                                        SORT0352
TXFVA  TXI     *+1,2,*-*     (LENGTH)                                   SORT0353
       PXA     ,2                                                       SORT0354
AINDX  AXT     *-*,4         (CURRENT POSITION IN A-TABLE)              SORT0355
*                                                                       SORT0356
FIVEA  STA     A+1,4         SAVE BREAK LOCATION IN A-TABLE             SORT0357
       CAS     B             COMPARE WITH TOP OF BLOCK                  SORT0358
       TRA     FOUR          UPPER PART OF BLOCK IS EMPTY               SORT0359
       TRA     SEVEN         JUST ONE ITEM IN UPPER PART                SORT0360
       TXI     ONE,4,-1      MORE THAN ONE, TREAT UPPER PART            SORT0361
*                                                                       SORT0362
*              IDENTICAL KEYS IN TWO OR MORE ITEMS                      SORT0363
*                                                                       SORT0364
SIX    CAL     A,4                                                      SORT0365
       SUB     LENG          ADVANCE POINTER, WHICH IS A COMPLEMENT     SORT0366
       STA     B             SET IT AS NEW TOP                          SORT0367
       CAL     A-1,4         MOVE PREVIOUS POINTER DOWN IN TABLE        SORT0368
       STA     A,4                                                      SORT0369
       ANA     =O77777                                                  SORT0370
       CAS     B             COMPARE WITH TOP                           SORT0371
       STA     B             LOWER HALF WAS EMPTY                       SORT0372
       TXI     EIGHT,4,1     MOVE A-TABLE INDEX UP ONE                  SORT0373
*                                                                       SORT0374
       TRA     SIX           WHOOPS, ANOTHER SET OF DUPLICATES          SORT0375
*                                                                       SORT0376
*              FOUND BLOCK WITH EXACTLY ONE ITEM                        SORT0377
*                                                                       SORT0378
SEVEN  SUB     LENG          ADVANCE POINTER, WHICH IS A COMPLEMENT     SORT0379
       STA     B             THIS BECOMES NEW TOP, MAYBE                SORT0380
       CAL     A,4           COPY CURRENT POINTER                       SORT0381
       STA     A+1,4         ...AS NEXT POINTER IN A-TABLE              SORT0382
       ANA     =O77777                                                  SORT0383
       CAS     B                                                        SORT0384
       TXI     ONE,4,-1      (THIS INSTRUCTION NEVER EXECUTED)          SORT0385
       TRA     EIGHT         TIME TO BACK OUT                           SORT0386
       TXI     ONE,4,-1      PROCESS LOWER PART OF LAST BLOCK           SORT0387
*                                                                       SORT0388
*              BACK UP TO KEY BIT AFTER LAST BIT USED FOR NEXT BLOCK    SORT0389
*                                                                       SORT0390
EIGHT  TXL     OUT,4,0                                                  SORT0391
       CAL     A-1,4         MOVE PREVIOUS POINTER DOWN TO              SORT0392
       STA     A,4           ...CURRENT POSITION IN A-TABLE             SORT0393
       ANA     =O77777                                                  SORT0394
       XCA                                                              SORT0395
       CAL     B                                                        SORT0396
       TLQ     *+2           IS THERE NOW A BLOCK TO TREAT              SORT0397
       TXI     EIGHT,4,1     NO, BACK OUT SOME MORE                     SORT0398
       SUB     LENG          YES, MOVE TOP POINTER DOWN ONE             SORT0399
       STA     B                                                        SORT0400
       TLQ     ONE           BUT IS NEW BLOCK JUST ONE ITEM             SORT0401
       TXI     EIGHT,4,1     YES,BACK OUT SOME MORE                     SORT0402
       TTL      POST PROCESSOR FOR ALGEBRAIC SORT                       SORT0403
OUT    ZET     LOGFG         IS THIS AN ALGEBRAIC SORT                  SORT0404
       TRA     QUIT          NO                                         SORT0405
       AXT     LSBIT,1                                                  SORT0406
       AXT     0,2                                                      SORT0407
PLGSX  SXA     PLGAX,2                                                  SORT0408
       LDQ     ESBIT,1                                                  SORT0409
PLGTQ  TQP     PLGNX                                                    SORT0410
       PXA     ,2                                                       SORT0411
       SUB     LNGQT                                                    SORT0412
       PAX     ,4                                                       SORT0413
PLGGT  CLA     *-*,4         PICK UP A WORD WITHIN AN ITEM              SORT0414
       TMI     *+2                                                      SORT0415
       COM                   RECOMPLEMENT THE NEGATIVES                 SORT0416
       CHS                   ...AND CHANGE ALL SIGNS                    SORT0417
PLGST  STO     *-*,4                                                    SORT0418
PLGTX  TIX     PLGGT,4,*-*   (LENGTH)                                   SORT0419
PLGNX  STQ     TMP                                                      SORT0420
       LGL     1                                                        SORT0421
       ZET     TMP                                                      SORT0422
       TXI     PLGTQ,2,1                                                SORT0423
PLGAX  AXT     *-*,2                                                    SORT0424
       TXI     *+1,2,36                                                 SORT0425
       TIX     PLGSX,1,1                                                SORT0426
*                                                                       SORT0427
ERROR  BES     0                                                        SORT0428
QUIT   LDI     SI                                                       SORT0429
XA     AXT     *-*,1                                                    SORT0430
XB     AXT     *-*,2                                                    SORT0431
XC     AXT     *-*,4         (IF OLD FORTRAN, XR4 HAS BEEN BUMPED DOWN) SORT0432
       CAL     1,4                                                      SORT0433
       ERA     TSX                                                      SORT0434
       ARS     15                                                       SORT0435
       TNZ     1,4                                                      SORT0436
       TXI     *-4,4,1                                                  SORT0437
RTURN  BES     0                                                        SORT0438
       TRA     1,4                                                      SORT0439
       TTL     CONSTANTS AND STORAGE                                    SORT0440
B      PZE     *-*,0,0       HEAD OF CURRENT BLOCK (COMPLEMENT)         SORT0441
MAXA   EQU     108           LENGTH OF A-TABLE AREA                     SORT0442
A      BSS     MAXA          A-TABLE BITS                               SORT0443
*                               S, 1-5   SHIFT COUNT TO LOCATE KEY BIT  SORT0444
*                               6-20     INCREMENT TO LOCATE KEY WORD   SORT0445
*                               21-35    TAIL-OF-BLOCK (COMPLEMENT)     SORT0446
*                                                                       SORT0447
ENDA   PZE     0             FLAG -- END OF A-TABLE                     SORT0448
MAXS   EQU     359           MAXIMUM LENGTH OF AN ITEM IF ALGEBRAIC SORTSORT0449
LSBIT  EQU     MAXS/36+1     LENGTH OF SIGN-BIT FLAG TABLE              SORT0450
SBIT   BSS     LSBIT         SIGN-BIT TABLE                             SORT0451
ESBIT  BES     0             END OF SIGN-BIT TABLE                      SORT0452
WHERE  PZE     *-*,0,0       SMALLEST ADDRESS IN DATA ARRAY             SORT0453
QUANT  PZE     *-*,0,0       NUMBER OF ITEMS IN DATA ARRAY              SORT0454
LENG   PZE     *-*,0,0       LENGTH OF EACH ITEM OF DATA                SORT0455
LENGD  PZE     0,0,*-*       LENGTH                                     SORT0456
LNGQT  PZE     *-*,0,0       LENGTH TIMES QUANTITY                      SORT0457
OLDFG  PZE     0             ZERO FOR NEW FORTRAN, ONE FOR OLD          SORT0458
ACFLG  PZE     0             ZERO IF DESCENDING, ONE IF ASCENDING       SORT0459
LOGFG  PZE     0             ZERO IF ALGEBRAIC, NON-ZERO IF LOGICAL     SORT0460
SI     PZE     0             STORAGE FOR SENSE INDICATORS               SORT0461
TMP    PZE     0             ERASABLE LOCATION                          SORT0462
TIF    TIF     0             CONSTANT USED IN SET UP                    SORT0463
TIO    TIO     0             X                                          SORT0464
TSX    TSX     0,0           X                                          SORT0465
       END                                                              SORT0466
