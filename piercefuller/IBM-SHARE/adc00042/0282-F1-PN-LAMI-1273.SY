      SUBROUTINE INPUT                                                  INPUT000
D     DIMENSION R1(200),R3(200),R4(200),R5(200),RR(200,2),RW(200,2)     INPUT010
      DIMENSION RRID(2),RWID(2),FMT(10),CORR(20)                        INPUT020
      COMMON R1,R3,R4,R5,RR,RW,RRID,RWID,I,II,J,N,NM,M,K,IP,IX,IVAL,FMT,INPUT030
     1KK,IZ,K1,K3,IB                                                    INPUT040
      READ INPUT TAPE 5,1,N,M,IB,FMT                                    INPUT050
    1 FORMAT(3I4,10A6)                                                  INPUT060
      NM=N+M                                                            INPUT070
      WRITE OUTPUT TAPE 6,2,N,M,NM,IB,FMT                               INPUT080
    2 FORMAT(5H1  N=I3,5H   M=I2,6H   NM=I3,14H   INPUT TAPE I1,14H   WIINPUT090
     1TH FORMAT10A6)                                                    INPUT100
      CALL FIX                                                          INPUT110
      RETURN                                                            INPUT120
      END                                                               INPUT130
      SUBROUTINE START                                                  START000
D     DIMENSION R1(200),R3(200),R4(200),R5(200),RR(200,2),RW(200,2)     START010
      DIMENSION RRID(2),RWID(2),FMT(10),CORR(20)                        START020
      COMMON R1,R3,R4,R5,RR,RW,RRID,RWID,I,II,J,N,NM,M,K,IP,IX,IVAL,FMT,START030
     1KK,IZ,K1,K3,IB,R1ID,R3ID,R4ID,R5ID                                START040
      REWIND 2                                                          START050
      REWIND 4                                                          START060
      K=1                                                               START070
      I=1                                                               START080
      IVAL=1                                                            START090
      DO 1 L=1,NM                                                       START100
D   1 RW(L,K)=0.                                                        START110
      DO 2 J=1,N                                                        START120
      CALL WAITWR                                                       START130
      CALL DISABL                                                       START140
      READ INPUT TAPE IB,FMT,(RW(L,K),L=1,NM)                           START150
      RWID(K)=J                                                         START160
      CALL ENABLE                                                       START170
    2 CALL BINWR                                                        START180
      K=2                                                               START190
      IVAL=2                                                            START200
      RETURN                                                            START210
      END                                                               START220
      SUBROUTINE OUTPUT                                                 OUTPT000
D     DIMENSION R1(200),R3(200),R4(200),R5(200),RR(200,2),RW(200,2)     OUTPT010
      DIMENSION RRID(2),RWID(2),FMT(10),CORR(20)                        OUTPT020
      COMMON R1,R3,R4,R5,RR,RW,RRID,RWID,I,II,J,N,NM,M,K,IP,IX,IVAL,FMT,OUTPT030
     1KK,IZ,K1,K3,IB,R1ID,R3ID,R4ID,R5ID                                OUTPT040
      CALL TCO                                                          OUTPT050
      CALL DISABL                                                       OUTPT060
      WRITE OUTPUT TAPE 6,1                                             OUTPT070
    1 FORMAT(1H1)                                                       OUTPT080
      DO 2 J=1,N                                                        OUTPT090
      CALL ENABLE                                                       OUTPT100
      CALL BINRD                                                        OUTPT110
      DUMMY=-1.                                                         OUTPT120
      CALL WAITRD                                                       OUTPT130
      CALL DISABL                                                       OUTPT140
    2 WRITE OUTPUT TAPE 6,3,(DUMMY,J,L,RR(L,K),L=1,N)                   OUTPT150
    3 FORMAT(1H /(4(A1,4H  A(I3,1H,I3,2H)=E15.8)))                      OUTPT160
      IF(M)9,9,8                                                        OUTPT170
    8 WRITE OUTPUT TAPE 6,4                                             OUTPT180
    4 FORMAT(20H1   SULOTION VECTOR ///)                                OUTPT190
      L1=N+1                                                            OUTPT200
      DO 6 J=1,N                                                        OUTPT210
      CALL ENABLE                                                       OUTPT220
      CALL BINRD                                                        OUTPT230
      CALL WAITRD                                                       OUTPT240
      L2=1                                                              OUTPT250
      DO 5 L=L1,NM                                                      OUTPT260
      L2=L-N                                                            OUTPT270
    5 RR(L2,K)=RR(L,K)                                                  OUTPT280
      CALL DISABL                                                       OUTPT290
    6 WRITE OUTPUT TAPE 6,7,(DUMMY,J,L,RR(L,K),L=1,M)                   OUTPT300
    7 FORMAT(1H / 4(A1,4H  B(I3,1H,I3,2H)=E15.8))                       OUTPT310
    9 CALL ENABLE                                                       OUTPT320
      RETURN                                                            OUTPT330
      END                                                               OUTPT340
