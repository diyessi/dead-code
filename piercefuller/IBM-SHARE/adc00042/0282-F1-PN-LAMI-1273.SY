      SUBROUTINE LAMIS                                                  LAMI0000
D     DIMENSION R1(200),R3(200),R4(200),R5(200),RR(200,2),RW(200,2)     LAMI0010
      DIMENSION RRID(2),RWID(2),FMT(10),CORR(20)                        LAMI0020
      COMMON R1,R3,R4,R5,RR,RW,RRID,RWID,I,II,J,N,NM,M,K,IP,IX,IVAL,FMT,LAMI0030
     1KK,IZ,K1,K3,IB,R1ID,R3ID,R4ID,R5ID                                LAMI0040
      CALL FIX                                                          LAMI0050
      CALL SCAN                                                         LAMI0060
      DO 1 I=1,N                                                        LAMI0070
      II=I+1                                                            LAMI0080
    1 CALL REDUCE                                                       LAMI0090
      CALL SORT                                                         LAMI0100
      RETURN                                                            LAMI0110
      END                                                               LAMI0120
*      FAP                                                              LAMI0130
*REDUCE                                                                 LAMI0140
       COUNT   200                                                      LAMI0150
       LBL     REDUCE,N                                                 LAMI0160
       ENTRY   REDUCE                                                   LAMI0170
       BCI     1,REDUCE                                                 LAMI0180
REDUCE SXA     OUT,1                                                    LAMI0190
       SXA     OUT+1,2                                                  LAMI0200
       SXA     OUT+2,4                                                  LAMI0210
       CLA     ONE                                                      LAMI0220
       STO     J                                                        LAMI0230
       CALL    BINRD                                                    LAMI0240
       STZ     KK                                                       LAMI0250
       CLA     ONE                                                      LAMI0260
       STO     IZ                                                       LAMI0270
       CLA     THREE                                                    LAMI0280
       SUB     K                                                        LAMI0290
       STO     K                                                        LAMI0300
       CLA     N                                                        LAMI0310
       STD     TXL                                                      LAMI0320
LOOP1  CALL    WAITRD                                                   LAMI0330
       CLA     J                                                        LAMI0340
       CAS     N                                                        LAMI0350
       TRA     GO                                                       LAMI0360
       TRA     GO                                                       LAMI0370
       ADD     ONE                                                      LAMI0380
       STO     J                                                        LAMI0390
       CALL    BINRD                                                    LAMI0400
       CLA     J                                                        LAMI0410
       SUB     ONE                                                      LAMI0420
       STO     J                                                        LAMI0430
GO     CLA     THREE                                                    LAMI0440
       SUB     K                                                        LAMI0450
       STO     K                                                        LAMI0460
       CLA     ONE                                                      LAMI0470
       SUB     K                                                        LAMI0480
       TZE     *+2                                                      LAMI0490
       CLA     K200                                                     LAMI0500
       ADD     I                                                        LAMI0510
       PDX     0,1                                                      LAMI0520
       LXD     K,2                                                      LAMI0530
       CLA     J                                                        LAMI0540
       SUB     I                                                        LAMI0550
       TNZ     23A                                                      LAMI0560
       CLA     TWO                                                      LAMI0570
       SUB     K                                                        LAMI0580
       TNZ     *+2                                                      LAMI0590
       CLA     K201                                                     LAMI0600
       PDX     0,1                                                      LAMI0610
       AXT     1,4                                                      LAMI0620
       CLA     NM                                                       LAMI0630
       STD     TXLA                                                     LAMI0640
LOOP2  CLA     R1+1,4                                                   LAMI0650
       STO     RW+1,1                                                   LAMI0660
       CLA     R1-199,4 ADDRESS IS  R1-NMMAX+1                  VARIABLELAMI0670
       STO     RW-399,1 ADDRESS IS RW-2*NMMAX +1                VARIABLELAMI0680
       TXI     *+1,1,1                                                  LAMI0690
       TXI     *+1,4,1                                                  LAMI0700
TXLA   TXL     LOOP2,4,**                                               LAMI0710
       CLA     R1ID                                                     LAMI0720
       STO     RWID+1,2                                                 LAMI0730
       TRA     38A                                                      LAMI0740
23A    CLA     J                                                        LAMI0750
       SUB     IP                                                       LAMI0760
       TNZ     28A                                                      LAMI0770
       CLA     TWO                                                      LAMI0780
       SUB     K                                                        LAMI0790
       TNZ     *+2                                                      LAMI0800
       CLA     K201                                                     LAMI0810
       PDX     0,4                                                      LAMI0820
       AXT     1,1                                                      LAMI0830
       CLA     NM                                                       LAMI0840
       STD     TXLB                                                     LAMI0850
LOOP3  CLA     R4+1,1                                                   LAMI0860
       STO     RW+1,4                                                   LAMI0870
       CLA     R4-199,1 ADDRESS IS R4-NMMAX+1                   VARIABLELAMI0880
       STO     RW-399,4 ADDRESS IS RW-2*NMMAX+1                 VARIABLELAMI0890
       TXI     *+1,1,1                                                  LAMI0900
       TXI     *+1,4,1                                                  LAMI0910
TXLB   TXL     LOOP3,1,**                                               LAMI0920
       CLA     R4ID                                                     LAMI0930
       STO     RWID+1,2                                                 LAMI0940
       TRA     35A                                                      LAMI0950
28A    CLA     TWO                                                      LAMI0960
       SUB     K                                                        LAMI0970
       TNZ     *+2                                                      LAMI0980
       CLA     K201                                                     LAMI0990
       PDX     0,2                                                      LAMI1000
       AXT     1,4                                                      LAMI1010
       CLA     NM                                                       LAMI1020
       STD     TXLC                                                     LAMI1030
LOOP   PXD     I,4                                                      LAMI1040
       SUB     I                                                        LAMI1050
       TNZ     32A                                                      LAMI1060
       LDQ     R1+1,4                                                   LAMI1070
       FMP     RR+1,1                                                   LAMI1080
       STO     E1                                                       LAMI1090
       STQ     E2                                                       LAMI1100
       LDQ     R1+1,4                                                   LAMI1110
       FMP     RR-399,1 ADDRESS IS RR-2*NMMAX+1                 VARIABLELAMI1120
       UFA     E2                                                       LAMI1130
       STO     E2                                                       LAMI1140
       LDQ     RR+1,1                                                   LAMI1150
       FMP     R1-199,4 ADDRESS IS R1-NMMAX+1                   VARIABLELAMI1160
       UFA     E2                                                       LAMI1170
       FAD     E1                                                       LAMI1180
       CHS                                                              LAMI1190
       STO     RW+1,2                                                   LAMI1200
       LRS     0                                                        LAMI1210
       STQ     RW-399,2 ADDRESS IS RW-2*NMMAX+1                 VARIABLELAMI1220
       TRA     33A                                                      LAMI1230
32A    LDQ     R1+1,4                                                   LAMI1240
       FMP     RR+1,1                                                   LAMI1250
       STO     E1                                                       LAMI1260
       STQ     E2                                                       LAMI1270
       LDQ     R1+1,4                                                   LAMI1280
       FMP     RR-399,1 ADDRESS IS RR-2*NMMAX+1                 VARIABLELAMI1290
       UFA     E2                                                       LAMI1300
       STO     E2                                                       LAMI1310
       LDQ     RR+1,1                                                   LAMI1320
       FMP     R1-199,4 ADDRESS ISR1-NMMAX+1                    VARIABLELAMI1330
       UFA     E2                                                       LAMI1340
       FAD     E1                                                       LAMI1350
       CHS                                                              LAMI1360
       LRS     0                                                        LAMI1370
       STQ     E2                                                       LAMI1380
       FAD     RR+1,2                                                   LAMI1390
       STO     E1                                                       LAMI1400
       XCA                                                              LAMI1410
       UFA     E2                                                       LAMI1420
       UFA     RR-399,2 ADDRESS IS RR-2*NMMAX+1                 VARIABLELAMI1430
       FAD     E1                                                       LAMI1440
       STO     RW+1,2                                                   LAMI1450
       STQ     RW-399,2 ADDRESS IS RW-2*NMMAX+1                 VARIABLELAMI1460
33A    TXI     *+1,2,1                                                  LAMI1470
       TXI     *+1,4,1                                                  LAMI1480
TXLC   TXL     LOOP,4,**                                                LAMI1490
       LXD     K,4                                                      LAMI1500
       CLA     RRID+1,4                                                 LAMI1510
       STO     RWID+1,4                                                 LAMI1520
35A    CLA     I                                                        LAMI1530
       SUB     N                                                        LAMI1540
       TZE     38A                                                      LAMI1550
       TPL     38A                                                      LAMI1560
       CALL    TEST,KK,IZ,II                                            LAMI1570
38A    CALL    WAITWR                                                   LAMI1580
       CALL    BINWR                                                    LAMI1590
       LXD     J,4                                                      LAMI1600
       TXI     *+1,4,1                                                  LAMI1610
       SXD     J,4                                                      LAMI1620
TXL    TXL     LOOP1,4,**                                               LAMI1630
       CLA     I                                                        LAMI1640
       SUB     N                                                        LAMI1650
       TZE     45A                                                      LAMI1660
       TPL     45A                                                      LAMI1670
       ZET     KK                                                       LAMI1680
       TRA     43A                                                      LAMI1690
       CALL    SING                                                     LAMI1700
43A    CLA     KK                                                       LAMI1710
       STO     IP                                                       LAMI1720
       CALL    MOVE                                                     LAMI1730
45A    CLA     THREE                                                    LAMI1740
       SUB     IVAL                                                     LAMI1750
       STO     IVAL                                                     LAMI1760
OUT    AXT     **,1                                                     LAMI1770
       AXT     **,2                                                     LAMI1780
       AXT     **,4                                                     LAMI1790
       TRA     1,4                                                      LAMI1800
ONE    PZE     ,,1                                                      LAMI1810
TWO    PZE     ,,2                                                      LAMI1820
THREE  PZE     ,,3                                                      LAMI1830
K200   PZE     ,,200    DECREMENT IS NMMAX                      VARIABLELAMI1840
K201   PZE     ,,201    DECREMENT IS NMMAX+1                    VARIABLELAMI1850
E1     PZE                                                              LAMI1860
E2     PZE                                                              LAMI1870
K      BOOL    71247    COMMON STORAGE                          VARIABLELAMI1880
KK     BOOL    71231    COMMON STORAGE                          VARIABLELAMI1890
I      BOOL    71255    COMMON STORAGE                          VARIABLELAMI1900
II     BOOL    71254    COMMON STORAGE                          VARIABLELAMI1910
J      BOOL    71253    COMMON STORAGE                          VARIABLELAMI1920
N      BOOL    71252    COMMON STORAGE                          VARIABLELAMI1930
NM     BOOL    71251    COMMON STORAGE                          VARIABLELAMI1940
IP     BOOL    71246    COMMON STORAGE                          VARIABLELAMI1950
RR     BOOL    74361    COMMON STORAGE                          VARIABLELAMI1960
RW     BOOL    72721    COMMON STORAGE                          VARIABLELAMI1970
RRID   BOOL    71261    COMMON STORAGE                          VARIABLELAMI1980
RWID   BOOL    71257    COMMON STORAGE                          VARIABLELAMI1990
R1     BOOL    77461    COMMON STORAGE                          VARIABLELAMI2000
R1ID   BOOL    71224    COMMON STORAGE                          VARIABLELAMI2010
R4     BOOL    76021    COMMON STORAGE                          VARIABLELAMI2020
R4ID   BOOL    71222    COMMON STORAGE                          VARIABLELAMI2030
IZ     BOOL    71230    COMMON STORAGE                          VARIABLELAMI2040
IVAL   BOOL    71244    COMMON STORAGE                          VARIABLELAMI2050
       END                                                              LAMI2060
      SUBROUTINE TEST(IP,IX,II)                                         LAMI2070
D     DIMENSION R1(200),R3(200),R4(200),R5(200),RR(200,2),RW(200,2)     LAMI2080
      DIMENSION RRID(2),RWID(2),FMT(10),CORR(20)                        LAMI2090
      COMMON R1,R3,R4,R5,RR,RW,RRID,RWID,I,II,J,N,NM,M,K,IP,IX,IVAL,FMT,LAMI2100
     1KK,IZ,K1,K3,IB,R1ID,R3ID,R4ID,R5ID                                LAMI2110
      IF(J-II)10,1,6                                                    LAMI2120
    1 IF(RW(II,K))2,4,2                                                 LAMI2130
    2 DO 3 L=1,NM                                                       LAMI2140
D   3 R3(L)=RW(L,K)                                                     LAMI2150
      R3ID=RWID(K)                                                      LAMI2160
       IP=II                                                            LAMI2170
      IX=2                                                              LAMI2180
      GO TO 10                                                          LAMI2190
    4 SENSE LIGHT 1                                                     LAMI2200
      DO 5 L=1,NM                                                       LAMI2210
D   5 R5(L)=RW(L,K)                                                     LAMI2220
      R5ID=RWID(K)                                                      LAMI2230
      GO TO 10                                                          LAMI2240
    6 GO TO (7,10),IX                                                   LAMI2250
    7 IF(RW(II,K))8,10,8                                                LAMI2260
    8 DO 9 L=1,NM                                                       LAMI2270
D   9 R3(L)=RW(L,K )                                                    LAMI2280
      R3ID=RWID(K )                                                     LAMI2290
      IP=J                                                              LAMI2300
      IX=2                                                              LAMI2310
   10 RETURN                                                            LAMI2320
      END                                                               LAMI2330
      SUBROUTINE MOVE                                                   LAMI2340
D     DIMENSION R1(200),R3(200),R4(200),R5(200),RR(200,2),RW(200,2)     LAMI2350
      DIMENSION RRID(2),RWID(2),FMT(10),CORR(20)                        LAMI2360
      COMMON R1,R3,R4,R5,RR,RW,RRID,RWID,I,II,J,N,NM,M,K,IP,IX,IVAL,FMT,LAMI2370
     1KK,IZ,K1,K3,IB,R1ID,R3ID,R4ID,R5ID                                LAMI2380
D     R1(II)=1./R3(II)                                                  LAMI2390
      DO 2 L=1,NM                                                       LAMI2400
      IF(L-II)1,2,1                                                     LAMI2410
D   1 R1(L)=R3(L)/R3(II)                                                LAMI2420
D   2 R4(L)=R5(L)                                                       LAMI2430
      R1ID=R3ID                                                         LAMI2440
      R4ID=R5ID                                                         LAMI2450
      RETURN                                                            LAMI2460
      END                                                               LAMI2470
      SUBROUTINE SING                                                   LAMI2480
D     DIMENSION R1(200),R3(200),R4(200),R5(200),RR(200,2),RW(200,2)     LAMI2490
      DIMENSION RRID(2),RWID(2),FMT(10),CORR(20)                        LAMI2500
      COMMON R1,R3,R4,R5,RR,RW,RRID,RWID,I,II,J,N,NM,M,K,IP,IX,IVAL,FMT,LAMI2510
     1KK,IZ,K1,K3,IB,R1ID,R3ID,R4ID,R5ID                                LAMI2520
      CALL DISABL                                                       LAMI2530
      WRITE OUTPUT TAPE 6,1,I                                           LAMI2540
      PRINT 1,I                                                         LAMI2550
    1 FORMAT(///22H  SINGLUAR MATRIX.  I=I3///)                         LAMI2560
      CALL EXIT                                                         LAMI2570
      END                                                               LAMI2580
      SUBROUTINE SCAN                                                   LAMI2590
D     DIMENSION R1(200),R3(200),R4(200),R5(200),RR(200,2),RW(200,2)     LAMI2600
      DIMENSION RRID(2),RWID(2),FMT(10),CORR(20)                        LAMI2610
      COMMON R1,R3,R4,R5,RR,RW,RRID,RWID,I,II,J,N,NM,M,K,IP,IX,IVAL,FMT,LAMI2620
     1KK,IZ,K1,K3,IB,R1ID,R3ID,R4ID,R5ID                                LAMI2630
      J=1                                                               LAMI2640
      CALL BINRD                                                        LAMI2650
      IZ=1                                                              LAMI2660
      I=1                                                               LAMI2670
      II=1                                                              LAMI2680
      KK=0                                                              LAMI2690
      K=3-K                                                             LAMI2700
      DO 9 J=1,N                                                        LAMI2710
      CALL WAITRD                                                       LAMI2720
      IF(J-N)1,2,2                                                      LAMI2730
    1 J=J+1                                                             LAMI2740
      CALL BINRD                                                        LAMI2750
      J=J-1                                                             LAMI2760
    2 K=3-K                                                             LAMI2770
      DO 3 L=1,NM                                                       LAMI2780
D   3 RW(L,K)=RR(L,K)                                                   LAMI2790
      RWID(K)=RRID(K)                                                   LAMI2800
      CALL TEST(KK,IZ,1)                                                LAMI2810
      CALL WAITWR                                                       LAMI2820
    9 CALL BINWR                                                        LAMI2830
       IP=KK                                                            LAMI2840
      IF(IP)11,11,12                                                    LAMI2850
   11 CALLSING                                                          LAMI2860
   12 CALL MOVE                                                         LAMI2870
      IVAL=3-IVAL                                                       LAMI2880
      CALL TCO                                                          LAMI2890
      RETURN                                                            LAMI2900
      END                                                               LAMI2910
      SUBROUTINE SORT                                                   LAMI2920
D     DIMENSION R1(200),R3(200),R4(200),R5(200),RR(200,2),RW(200,2)     LAMI2930
      DIMENSION RRID(2),RWID(2),FMT(10),CORR(20)                        LAMI2940
      COMMON R1,R3,R4,R5,RR,RW,RRID,RWID,I,II,J,N,NM,M,K,IP,IX,IVAL,FMT,LAMI2950
     1KK,IZ,K1,K3,IB,R1ID,R3ID,R4ID,R5ID                                LAMI2960
      IF(SENSE LIGHT 1)2,26                                             LAMI2970
    2 DO 3 J=1,N                                                        LAMI2980
      J=J                                                               LAMI2990
      CALL BINRD                                                        LAMI3000
      CALL WAITRD                                                       LAMI3010
    3 R1(J)=RRID(K)                                                     LAMI3020
      J=1                                                               LAMI3030
      CALL BINRD                                                        LAMI3040
      K=3-K                                                             LAMI3050
      DO 9 J=1,N                                                        LAMI3060
      CALL WAITRD                                                       LAMI3070
      IF(J-N)4,5,5                                                      LAMI3080
    4 J=J+1                                                             LAMI3090
      CALL BINRD                                                        LAMI3100
      J=J-1                                                             LAMI3110
    5 K=3-K                                                             LAMI3120
      DO 8 L=1,NM                                                       LAMI3130
      IF(L-N)6,6,7                                                      LAMI3140
    6 LL=R1(L)                                                          LAMI3150
D     RW(LL,K)=RR(L,K)                                                  LAMI3160
      GO TO 8                                                           LAMI3170
D   7 RW(L,K)=RR(L,K)                                                   LAMI3180
    8 RWID(K)=J                                                         LAMI3190
      CALL WAITWR                                                       LAMI3200
    9 CALL BINWR                                                        LAMI3210
      IVAL=3-IVAL                                                       LAMI3220
      CALL TCO                                                          LAMI3230
   26 RETURN                                                            LAMI3240
      END                                                               LAMI3250
*      FAP                                                              LAMI3260
*WAITRD                                                                 LAMI3270
       COUNT   10                                                       LAMI3280
       LBL     WAITRD,N                                                 LAMI3290
       ENTRY   WAITRD                                                   LAMI3300
WAITRD CLA     IVAL                                                     LAMI3310
       ALS     5                                                        LAMI3320
       ANA     =O7700000000                                             LAMI3330
       ADD     CHAN                                                     LAMI3340
       STO     TCO                                                      LAMI3350
TCO    PZE                                                              LAMI3360
       TRA     1,4                                                      LAMI3370
CHAN   TCOA    TCO                                                      LAMI3380
IVAL   BOOL    71244    COMMON STORAGE                          VARIABLELAMI3390
       END                                                              LAMI3400
*      FAP                                                              LAMI3410
*WAITWR                                                                 LAMI3420
       COUNT   10                                                       LAMI3430
       LBL     WAITWR,N                                                 LAMI3440
       ENTRY   WAITWR                                                   LAMI3450
WAITWR CLA     =O3000000                                                LAMI3460
       SUB     IVAL                                                     LAMI3470
       ALS     5                                                        LAMI3480
       ANA     =O7700000000                                             LAMI3490
       ADD     CHAN                                                     LAMI3500
       STO     TCO                                                      LAMI3510
TCO    PZE                                                              LAMI3520
       TRA     1,4                                                      LAMI3530
CHAN   TCOA    TCO                                                      LAMI3540
IVAL   BOOL    71244    COMMON STORAGE                          VARIABLELAMI3550
       END                                                              LAMI3560
*      FAP                                                              LAMI3570
*TCO                                                                    LAMI3580
       COUNT   4                                                        LAMI3590
       LBL     TCO,N                                                    LAMI3600
       ENTRY   TCO                                                      LAMI3610
TCO    TCOA    *                                                        LAMI3620
       TCOB    *                                                        LAMI3630
       TRA     1,4                                                      LAMI3640
       END                                                              LAMI3650
*      FAP                                                              LAMI3660
*BINARY                                                                 LAMI3670
       COUNT   400                                                      LAMI3680
       LBL     BINARY,N                                                 LAMI3690
       ENTRY   BINRD                                                    LAMI3700
       ENTRY   BINWR                                                    LAMI3710
       ENTRY   ENABLE                                                   LAMI3720
       ENTRY   DISABL                                                   LAMI3730
       ENTRY   FIX                                                      LAMI3740
FIX    CLA     N                                                        LAMI3750
       ARS     1                                                        LAMI3760
       ADD     ONE                                                      LAMI3770
       STD     NHALF                                                    LAMI3780
       CLA     NM                                                       LAMI3790
       STD     COMR+1                                                   LAMI3800
       STD     COMW+1                                                   LAMI3810
       STD     COMR+2                                                   LAMI3820
       STD     COMW+2                                                   LAMI3830
       TRA     1,4                                                      LAMI3840
BINRD  SXA     OUTR+2,2                                                 LAMI3850
       SXA     OUTR,4                                                   LAMI3860
       SXA     OUTR+1,1                                                 LAMI3870
       AXT     1,2                                                      LAMI3880
       TRA     *+5                                                      LAMI3890
BINWR  SXA     OUTW+2,2                                                 LAMI3900
       SXA     OUTW,4                                                   LAMI3910
       SXA     OUTW+1,1                                                 LAMI3920
       AXT     2,2                                                      LAMI3930
       LXD     IVAL,1                                                   LAMI3940
       AXC     *+1,4                                                    LAMI3950
       XEC*    TCO+1,2                                                  LAMI3960
HOHO   LXD     K,4                                                      LAMI3970
       TXH     HI,2,1                                                   LAMI3980
HO     CLA     ADDRA+1,4                                                LAMI3990
       STA     COMR                                                     LAMI4000
       CLS     NM                                                       LAMI4010
       ADD     ONE                                                      LAMI4020
       ARS     18                                                       LAMI4030
       ADD     ADDRB+1,4                                                LAMI4040
       STA     COMR+1                                                   LAMI4050
       SUB     K400                                                     LAMI4060
       STA     COMR+2                                                   LAMI4070
       TRA     SAVE                                                     LAMI4080
HI     CLA     ADDRC+1,4                                                LAMI4090
       STA     COMW                                                     LAMI4100
       CLS     NM                                                       LAMI4110
       ADD     ONE                                                      LAMI4120
       ARS     18                                                       LAMI4130
       ADD     ADDRD+1,4                                                LAMI4140
       STA     COMW+1                                                   LAMI4150
       SUB     K400                                                     LAMI4160
       STA     COMW+2                                                   LAMI4170
SAVE   CLA     J                                                        LAMI4180
       SUB     ONE                                                      LAMI4190
       TZE     JSTART                                                   LAMI4200
       CLA     J                                                        LAMI4210
       SUB     NHALF                                                    LAMI4220
       TZE     JHALF                                                    LAMI4230
       TPL     *+3                                                      LAMI4240
       AXT     1,4                                                      LAMI4250
       TRA     RETURN                                                   LAMI4260
       AXT     2,4                                                      LAMI4270
RETURN TXH     NEXTW,2,1                                                LAMI4280
NEXTR  XEC*    RDS+1,1                                                  LAMI4290
       XEC*    RCHR+1,1                                                 LAMI4300
       LDQ*    RDS+1,1                                                  LAMI4310
       STQ*    RDST+1,1                                                 LAMI4320
