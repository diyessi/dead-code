      SUBROUTINE RECORD                                                 SMPL0673
      COMMON SYMBOL, STATMT, LOC, WORDS, KLOC, OP, ADDRS, CHAR          SMPL0674
      DIMENSION STATMT(660), WORDS(100), ADDRS(3)                       SMPL0675
      COMMON TRA,NTRA,IBOX,STOR,NSTOR,JBOX,REC,NREC,NRECR,KBOX,CON,LBOX SMPL0676
      DIMENSION TRA(200), NTRA(200), STOR(1750), NSTOR(1750),           SMPL0677
     *REC(50), NREC(50), NRECR(50), CON(650)                            SMPL0678
      COMMON NHOLD                                                      SMPL0679
      EQUIVALENCE (NADD,NADDS)                                          SMPL0680
      NADDS = NHOLD                                                     SMPL0681
      IF (SENSE LIGHT 4) 500,599                                        SMPL0682
500   IF (SYMBOL - 4HREAD) 501,510,501                                  SMPL0683
501   IF (SYMBOL - 5HPUNCH) 502,511,502                                 SMPL0684
502   IF (SYMBOL - 5HPRINT) 503,512,503                                 SMPL0685
503   IF(SYMBOL - 1H ) 516,519,516                                      SMPL0686
510   NADD = 000                                                        SMPL0687
      GO TO 520                                                         SMPL0688
511   NADD = 100                                                        SMPL0689
      GO TO 520                                                         SMPL0690
512   NADD = 200                                                        SMPL0691
      GO TO 520                                                         SMPL0692
519   NADD = NADD+1                                                     SMPL0693
      ERASE SYMB                                                        SMPL0694
      GO TO 52                                                          SMPL0695
516   NADD = ((NHOLD+100)/100)*100                                      SMPL0696
520   KBOX = KBOX+1                                                     SMPL0697
      REC(KBOX) = SYMBOL                                                SMPL0698
      NREC(KBOX) = NADD+1                                               SMPL0699
      SYMB = SYMBOL                                                     SMPL0700
      ERASE SYMBOL                                                      SMPL0701
52    DO 5300I=2,KLOC                                                   SMPL0702
      NBOX = NEXT(WORDS(I))                                             SMPL0703
      IF (NBOX) 505,504,506                                             SMPL0704
504   JBOX = JBOX+1                                                     SMPL0705
      STOR(JBOX) = WORDS(I)                                             SMPL0706
      GO TO 5300                                                        SMPL0707
505   NADD = NADD+XABSF(NBOX)                                           SMPL0708
      GO TO 5300                                                        SMPL0709
506   CALL CIT(4,1H,,CONV(NADD+1),0,0)                                  SMPL0710
      NADD = NADD+XABSF(NBOX)                                           SMPL0711
      NSTOR(JBOX) = NADD                                                SMPL0712
5300  CONTINUE                                                          SMPL0713
      NHOLD = XMAX0F(NADD,NHOLD)                                        SMPL0714
508   IF (SYMB  ) 518,528,518                                           SMPL0715
518   NRECR(KBOX) = NADD                                                SMPL0716
      Y = 3H001                                                         SMPL0717
      X = TRUNK(CONV(NADD+1))                                           SMPL0718
      GPMK = (+1H⯒)                                                     SMPL0719
      WRITE OUTPUT TAPE 4,6314,Y,X,GPMK                                 SMPL0720
6314  FORMAT (1HL2A3,4H1060A1,47X22HA004080M080004B001011 )             SMPL0721
528   RETURN                                                            SMPL0722
599   IF (WORDS(3) - 2HTO) 23,600,23                                    SMPL0723
 23   IF(WORDS(4)-2HTO)233,600,233                                      SMPL0724
233   PRINT 45, SYMBOL,(STATMT(I),I=1,LOC)                              SMPL0725
45    FORMAT (45H0INCORRECTLY WRITTEN =SET RECORD= STATEMENT. /6H0      SMPL0726
     $A6,108A1/(12X108A1))                                              SMPL0727
      SENSE LIGHT 1                                                     SMPL0728
      GO TO 5                                                           SMPL0729
600   I = LOOKUP(WORDS(2),REC,KBOX)                                     SMPL0730
      IF (I) 620,3230,620                                               SMPL0731
3230  CALL JOIN(WORDS(3),WORDS(2))                                      SMPL0732
      I=LOOKUP(WORDS(2),REC,KBOX)                                       SMPL0733
      IF(I)621,3231,621                                                 SMPL0734
3231  PRINT 1242,WORDS(2),SYMBOL,(STATMT(I),I=1,LOC)                    SMPL0735
1242  FORMAT (12H0THE SYMBOL A6,42HDOES NOT APPEAR IN THE RECORD NAME TASMPL0736
     $BLE. /6H0     A6,108A1/(12X108A1))                                SMPL0737
      SENSE LIGHT 1                                                     SMPL0738
      GO TO 5                                                           SMPL0739
621   DO 7 K=4,KLOC                                                     SMPL0740
 7    WORDS(K-1)=WORDS(K)                                               SMPL0741
620   CALL CIT(4,1H/,CONV(NRECR(I)),0,0)                                SMPL0742
      NDIFF = NRECR(I)/100 - NREC(I)/100                                SMPL0743
      IF (NDIFF)601,605,601                                             SMPL0744
601   DO 602 K=1,NDIFF                                                  SMPL0745
602   CALL CIT(1,1H/,0,0,0)                                             SMPL0746
605   NADDS= NREC(I)-1                                                  SMPL0747
      DO 608  I=4,KLOC                                                  SMPL0748
      NBOX = NEXT(WORDS(I))                                             SMPL0749
      IF (NBOX) 615,614,616                                             SMPL0750
614   JBOX = JBOX+1                                                     SMPL0751
      STOR(JBOX) = WORDS(I)                                             SMPL0752
      GO TO 608                                                         SMPL0753
615   NADDS = NADDS+XABSF(NBOX)                                         SMPL0754
      GO TO 608                                                         SMPL0755
616   CALL CIT(4,1H,,CONV(NADDS+1),0,0)                                 SMPL0756
      NADDS = NADDS+XABSF(NBOX)                                         SMPL0757
      NSTOR(JBOX) = NADDS                                               SMPL0758
608   CONTINUE                                                          SMPL0759
5     RETURN                                                            SMPL0760
      END (0,1,0,0,0)                                                   SMPL0761
