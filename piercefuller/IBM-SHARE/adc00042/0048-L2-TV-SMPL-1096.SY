*CIT               ***SUBROUTINE CIT(N,OP,A,B,D)***                     SMPL0613
      SUBROUTINE CIT(N,OP,A,B,D)                                        SMPL0614
      COMMON SYMBOL                                                     SMPL0615
      IF (SYMBOL - 1H ) 8,5,8                                           SMPL0616
5     ERASE SYMBOL                                                      SMPL0617
8     IF (SENSE LIGHT 3) 20,10                                          SMPL0618
10    IF (N-4) 20,11,20                                                 SMPL0619
11    IF (OP - 1HB) 20,12,20                                            SMPL0620
12    IF (SYMBOL) 20,14,20                                              SMPL0621
14    CALL DICT (X, OP 3 , 36H1     2     4     F     K     .     )     SMPL0622
      IF (X) 15,20,15                                                   SMPL0623
15    BACKSPACE 3                                                       SMPL0624
      N3 = N3+3                                                         SMPL0625
      A3 = A                                                            SMPL0626
      SENSE LIGHT 3                                                     SMPL0627
      GO TO 25                                                          SMPL0628
20    SYM3 = SYMBOL                                                     SMPL0629
      N3 = N                                                            SMPL0630
      OP3 = OP                                                          SMPL0631
      A3 = A                                                            SMPL0632
      B3 = B                                                            SMPL0633
      D3 = D                                                            SMPL0634
25    WRITE TAPE 3, SYM3,N3,OP3,A3,B3,D3                                SMPL0635
      ERASE SYMBOL                                                      SMPL0636
      RETURN                                                            SMPL0637
      END (0,1,0,0,0)                                                   SMPL0638
*MULT              ***SUBROUTINE MULTIPLY***                            SMPLM639
*MULT    SUBROUTINE MULT                                      917-040   SMPLM640
      SUBROUTINE MULT                                                   SMPLM641
      COMMON SYMBOL, STATMT, LOC, WORDS, KLOC, OP, ADDRS, CHAR          SMPLM642
      DIMENSION STATMT(660), WORDS(100), ADDRS(3)                       SMPLM643
S PZE OCT   326060606060                                                SMPLM644
S AT  OCT   146060606060                                                SMPLM645
      CALL CIT(4,1HS,3H371,0,0)                                         SMPLM646
      CALL CIT(7,PZE,ADDRS(2),3H360,0)                                  SMPLM647
      CALL CIT(7,PZE,ADDRS(1),3H381,0)                                  SMPLM648
      IF (SENSE SWITCH 4) 5,6                                           SMPLM649
 5    CALL CIT(7,AT,3H381,3H371,0)                                      SMPLM650
      CALL CIT(7,1HM,3H371,3H200,0)                                     SMPLM651
      CALL CIT(7,1HM,3H200,3H370,0)                                     SMPLM652
      GO TO 7                                                           SMPLM653
6     CALL CIT(4,1HB,5HMULT.,0,0)                                       SMPLM654
      OP = 5HMULT.                                                      SMPLM655
7     CALL CIT(7,PZE,3H370,ADDRS(3),0)                                  SMPLM656
      RETURN                                                            SMPLM657
      END (0,1,0,0,0)                                                   SMPLM658
*DIV               ***SUBROUTINE DIVIDE***                              SMPLD656
*DIV     SUBROUTINE DIV                                       917-040   SMPLD657
      SUBROUTINE DIV                                                    SMPLD658
      COMMON SYMBOL, STATMT, LOC, WORDS, KLOC, OP, ADDRS, CHAR          SMPLD659
      DIMENSION STATMT(660), WORDS(100), ADDRS(3)                       SMPLD660
S PZE OCT   326060606060                                                SMPLD661
      IF (SENSE SWITCH 4) 5,6                                           SMPLD662
6     CALL CIT(4,1HS,3H391,0,0)                                         SMPLD663
      CALL CIT(7,PZE,ADDRS(1),3H399,0)                                  SMPLD664
      CALL CIT(7,PZE,ADDRS(2),3H381,0)                                  SMPLD665
      CALL CIT(4,1HB,4HDIV.,0,0)                                        SMPLD666
      OP = 4HDIV.                                                       SMPLD667
7     CALL CIT(7,PZE,3H391,ADDRS(3),0)                                  SMPLD668
      GO TO 8                                                           SMPLD669
 5    CALL CIT (4,1H),3H392,0,0)                                        SMPLD670
      CALL CIT(7,PZE,ADDRS(1),3H399,0)                                  SMPLD671
      CALL CIT(7,PZE,ADDRS(2),3H381,0)                                  SMPLD672
      CALL CIT(4,1H,,3H373,0,0)                                         SMPLD673
      CALL CIT(7,1H(,3H381,3H392,0)                                     SMPLD674
      CALL CIT(4,1H),3H373,0,0)                                         SMPLD675
      CALL CIT(4,1H,,3H392,0,0)                                         SMPLD676
      CALL CIT(7,PZE,3H389,ADDRS(3),0)                                  SMPLD677
 8    RETURN                                                            SMPLD678
      END (0,1,0,0,0)                                                   SMPLD679
      EQUIVALENCE (NADD,NADDS)                                          SMPL0680
      NADDS = NHOLD                                                     SMPL0681
      IF (SENSE LIGHT 4) 500,599                                        SMPL0682
500   IF (SYMBOL - 4HREAD) 501,510,501                                  SMPL0683
501   IF (SYMBOL - 5HPUNCH) 502,511,502                                 SMPL0684
502   IF (SYMBOL - 5HPRINT) 503,512,503                                 SMPL0685
503   IF(SYMBOL - 1H ) 516,519,516                                      SMPL0686
510   NADD = 000                                                        SMPL0687
      GO TO 520                                                         SMPL0688
511   NADD = 100                                                        SMPL0689
      GO TO 520                                                         SMPL0690
512   NADD = 200                                                        SMPL0691
      GO TO 520                                                         SMPL0692
519   NADD = NADD+1                                                     SMPL0693
      ERASE SYMB                                                        SMPL0694
      GO TO 52                                                          SMPL0695
516   NADD = ((NHOLD+100)/100)*100                                      SMPL0696
520   KBOX = KBOX+1                                                     SMPL0697
      REC(KBOX) = SYMBOL                                                SMPL0698
      NREC(KBOX) = NADD+1                                               SMPL0699
      SYMB = SYMBOL                                                     SMPL0700
      ERASE SYMBOL                                                      SMPL0701
52    DO 5300I=2,KLOC                                                   SMPL0702
      NBOX = NEXT(WORDS(I))                                             SMPL0703
      IF (NBOX) 505,504,506                                             SMPL0704
504   JBOX = JBOX+1                                                     SMPL0705
      STOR(JBOX) = WORDS(I)                                             SMPL0706
      GO TO 5300                                                        SMPL0707
505   NADD = NADD+XABSF(NBOX)                                           SMPL0708
      GO TO 5300                                                        SMPL0709
506   CALL CIT(4,1H,,CONV(NADD+1),0,0)                                  SMPL0710
      NADD = NADD+XABSF(NBOX)                                           SMPL0711
      NSTOR(JBOX) = NADD                                                SMPL0712
5300  CONTINUE                                                          SMPL0713
      NHOLD = XMAX0F(NADD,NHOLD)                                        SMPL0714
508   IF (SYMB  ) 518,528,518                                           SMPL0715
518   NRECR(KBOX) = NADD                                                SMPL0716
      Y = 3H001                                                         SMPL0717
      X = TRUNK(CONV(NADD+1))                                           SMPL0718
      GPMK = (+1H⯒)                                                     SMPL0719
      WRITE OUTPUT TAPE 4,6314,Y,X,GPMK                                 SMPL0720
6314  FORMAT (1HL2A3,4H1060A1,47X22HA004080M080004B001011 )             SMPL0721
528   RETURN                                                            SMPL0722
599   IF (WORDS(3) - 2HTO) 23,600,23                                    SMPL0723
23    PRINT 45, SYMBOL,(STATMT(I),I=1,LOC)                              SMPL0724
45    FORMAT (45H0INCORRECTLY WRITTEN =SET RECORD= STATEMENT. /6H0      SMPL0725
     $A6,108A1/(12X108A1))                                              SMPL0726
      SENSE LIGHT 1                                                     SMPL0727
      GO TO 5                                                           SMPL0728
600   I = LOOKUP(WORDS(2),REC,KBOX)                                     SMPL0729
      IF (I) 620,3230,620                                               SMPL0730
3230  PRINT 1242,WORDS(2),SYMBOL,(STATMT(I),I=1,LOC)                    SMPL0731
1242  FORMAT (12H0THE SYMBOL A6,42HDOES NOT APPEAR IN THE RECORD NAME TASMPL0732
     $BLE. /6H0     A6,108A1/(12X108A1))                                SMPL0733
      SENSE LIGHT 1                                                     SMPL0734
      GO TO 5                                                           SMPL0735
620   CALL CIT(4,1H/,CONV(NRECR(I)),0,0)                                SMPL0736
      NDIFF = NRECR(I)/100 - NREC(I)/100                                SMPL0737
      IF (NDIFF)601,605,601                                             SMPL0738
601   DO 602 K=1,NDIFF                                                  SMPL0739
602   CALL CIT(1,1H/,0,0,0)                                             SMPL0740
605   NADDS= NREC(I)-1                                                  SMPL0741
      DO 608  I=4,KLOC                                                  SMPL0742
      NBOX = NEXT(WORDS(I))                                             SMPL0743
      IF (NBOX) 615,614,616                                             SMPL0744
614   JBOX = JBOX+1                                                     SMPL0745
      STOR(JBOX) = WORDS(I)                                             SMPL0746
      GO TO 608                                                         SMPL0747
615   NADDS = NADDS+XABSF(NBOX)                                         SMPL0748
      GO TO 608                                                         SMPL0749
616   CALL CIT(4,1H,,CONV(NADDS+1),0,0)                                 SMPL0750
      NADDS = NADDS+XABSF(NBOX)                                         SMPL0751
      NSTOR(JBOX) = NADDS                                               SMPL0752
608   CONTINUE                                                          SMPL0753
5     RETURN                                                            SMPL0754
      END (0,1,0,0,0)                                                   SMPL0755
*CONST             ***SUBROUTINE CONST***                               SMPL0756
      SUBROUTINE CONST                                                  SMPL0757
      COMMON SYMBOL, STATMT, LOC, WORDS, KLOC, OP, ADDRS, CHAR          SMPL0758
      DIMENSION STATMT(660), WORDS(100), ADDRS(3)                       SMPL0759
      COMMON TRA,NTRA,IBOX,STOR,NSTOR,JBOX,REC,NREC,NRECR,KBOX,CON,LBOX SMPL0760
      DIMENSION TRA(200), NTRA(200), STOR(1750), NSTOR(1750),           SMPL0761
     *REC(50), NREC(50), NRECR(50), CON(650)                            SMPL0762
      IF (SENSE LIGHT 4) 550,567                                        SMPL0763
550   LBOX = LBOX+1                                                     SMPL0764
      CON(LBOX) = SYMBOL                                                SMPL0765
      LBOX = LBOX+1                                                     SMPL0766
      CON(LBOX)= WORDS(2)                                               SMPL0767
      N = -NEXT(WORDS(2))                                               SMPL0768
      IF (N - 48) 555,555,2348                                          SMPL0769
2348  PRINT 48, SYMBOL,(STATMT(I),I=1,LOC)                              SMPL0770
48    FORMAT (46H0ALPHA STATEMENT FOR MORE THAN 48 CHARACTERS. /6H0     SMPL0771
     $A6,108A1/(12X108A1))                                              SMPL0772
      SENSE LIGHT 1                                                     SMPL0773
      GO TO 5                                                           SMPL0774
555   DO 530 I=8,LOC                                                    SMPL0775
      IF (STATMT(I) - 1H,) 530,533,530                                  SMPL0776
530   CONTINUE                                                          SMPL0777
      PRINT  8, SYMBOL,(STATMT(I),I=1,LOC)                              SMPL0778
8     FORMAT (47H0NO COMMA TO MARK BEGINNING OF ALPHA CONSTANT. /6H0    SMPL0779
     $ A6,108A1/(12X108A1))                                             SMPL0780
      SENSE LIGHT 1                                                     SMPL0781
      GO TO 5                                                           SMPL0782
533   INDEX = I+1                                                       SMPL0783
      N = N+I                                                           SMPL0784
      DO 540 I=INDEX,N                                                  SMPL0785
      LBOX = LBOX+1                                                     SMPL0786
540   CON(LBOX) = STATMT(I)                                             SMPL0787
      GO TO 5                                                           SMPL0788
567   LBOX = LBOX+1                                                     SMPL0789
      CON(LBOX)= SYMBOL                                                 SMPL0790
      LBOX = LBOX+1                                                     SMPL0791
      K = LBOX                                                          SMPL0792
      J = 0                                                             SMPL0793
      DO 568 I=8,LOC                                                    SMPL0794
      IF (NTYPE(STATMT(I)) - 3) 568,569,570                             SMPL0795
569   J = I                                                             SMPL0796
568   CONTINUE                                                          SMPL0797
      PRINT 538, SYMBOL,(STATMT(I),I=1,LOC)                             SMPL0798
538   FORMAT (38H0NO BLANKS FOUND IN NUMBER STATEMENT. /6H0     A6,108A1SMPL0799
     $/(12X108A1))                                                      SMPL0800
      SENSE LIGHT 1                                                     SMPL0801
      GO TO 5                                                           SMPL0802
570   INDEX = 0                                                         SMPL0803
      N = I-1                                                           SMPL0804
      DO 580 I=8,N                                                      SMPL0805
      IF (I-J) 575,580,575                                              SMPL0806
575   INDEX = INDEX+1                                                   SMPL0807
      LBOX = LBOX+1                                                     SMPL0808
      CON(LBOX) = STATMT(I)                                             SMPL0809
580   CONTINUE                                                          SMPL0810
B     CON(LBOX) = CON(LBOX)+CHAR                                        SMPL0811
      IF (INDEX - 48) 590,590,235                                       SMPL0812
235   PRINT 548, SYMBOL,(STATMT(I),I=1,LOC)                             SMPL0813
548   FORMAT (31H0NUMBER GREATER THAN 48 DIGTS. /6H0     A6,108A1/(12X10SMPL0814
     $8A1))                                                             SMPL0815
      SENSE LIGHT 1                                                     SMPL0816
      GO TO 5                                                           SMPL0817
590   CON(K) = CONV(INDEX)                                              SMPL0818
5     RETURN                                                            SMPL0819
      END (0,1,0,0,0)                                                   SMPL0820
*NEXT              ***FUNCTION NEXT(ARG)***                             SMPL0821
      FUNCTION NEXT(ARG)                                                SMPL0822
SO60  OCT 60000000                                                      SMPL0823
      IF (NTYPE(ARG) - 2) 1,2,1                                         SMPL0824
 1    ERASE NEXT                                                        SMPL0825
      GO TO 8                                                           SMPL0826
 2    IF (NEXT) 3,4,3                                                   SMPL0827
 3    N = -0                                                            SMPL0828
 4    N = +0                                                            SMPL0830
      GO TO 5                                                           SMPL0829
 5    ERASE NEXT                                                        SMPL0831
S     LDQ ARG                                                           SMPL0832
S6    PXD                                                               SMPL0833
S     LGL 6                                                             SMPL0834
S     ALS 18                                                            SMPL0835
S     STO TEMP                                                          SMPL0836
S     SUB O60                                                           SMPL0837
S     TZE *7                                                            SMPL0838
S     CLA NEXT                                                          SMPL0839
S     ALS 2                                                             SMPL0840
S     ADD NEXT                                                          SMPL0841
S     ALS 1                                                             SMPL0842
S     ADD TEMP                                                          SMPL0843
S     STO NEXT                                                          SMPL0844
      GO TO 6                                                           SMPL0845
 7    NEXT = XSIGNF(NEXT,N)                                             SMPL0846
 8    RETURN                                                            SMPL0847
      END (0,1,0,0,0)                                                   SMPL0848
*CONV              ***FUNCTION CONV(ARG)***                             SMPL0849
      FUNCTION CONV(ARG)                                                SMPL0850
      FREQUENCY 12(1,0),21(0,1),40(1,0),50(1,0)                         SMPL0851
STEN  OCT 12                                                            SMPL0852
SBLNK OCT 606060606060                                                  SMPL0853
S     PXD                                                               SMPL0854
S     STZ TEMP                                                          SMPL0855
S     LDQ ARG                                                           SMPL0856
S     LRS 18                                                            SMPL0857
S     LXA*10,(I)                                                        SMPL0858
S10   PXD 36                                                            SMPL0859
S     DVH TEN                                                           SMPL0860
S     ALS 36,(I)                                                        SMPL0861
S     ORS TEMP                                                          SMPL0862
S12   TIX*10,(I),6                                                      SMPL0863
S     DED,(I)                                                           SMPL0864
S     LDQ TEMP                                                          SMPL0865
S     LXA*6,(I)                                                         SMPL0866
S     LXA*6,(J)                                                         SMPL0867
S6    PXD 6                                                             SMPL0868
S20   LGL 6                                                             SMPL0869
S21   TNZ *30                                                           SMPL0870
S     TXI *20,(I),-1                                                    SMPL0871
S29   LGL 6                                                             SMPL0872
S30   TXI *40,(J),-1                                                    SMPL0873
S40   TIX*29,(I),1                                                      SMPL0874
S     DED ,(I)                                                          SMPL0875
S     LDQ BLNK                                                          SMPL0876
S39   LGL 6                                                             SMPL0877
S50   TIX*39,(J),1                                                      SMPL0878
S     DED,(J)                                                           SMPL0879
S     SLW CONV                                                          SMPL0880
      RETURN                                                            SMPL0881
      END (0,1,0,0,0)                                                   SMPL0882
*TRUNK             ***FUNCTION TRUNK(ARG)***                            SMPL0883
      FUNCTION TRUNK(ARG)                                               SMPL0884
SO60  OCT 60                                                            SMPL0885
STEN  OCT 12                                                            SMPL0886
SBLNK OCT 606060606060                                                  SMPL0887
S     STZ TEMP                                                          SMPL0888
S     LDQ ARG                                                           SMPL0889
S20   PXD 0,0                                                           SMPL0890
S     LGL 6                                                             SMPL0891
S     STO TRUNK                                                         SMPL0892
S     SUB O60                                                           SMPL0893
S     TZE *10                                                           SMPL0894
S     CAL TEMP                                                          SMPL0895
S     ALS 6                                                             SMPL0896
S     ORA TRUNK                                                         SMPL0897
S     SLW TEMP                                                          SMPL0898
S     TRA *20                                                           SMPL0899
S30   PXD 0,0                                                           SMPL0900
S     TRA *40                                                           SMPL0901
S10   LDQ TEMP                                                          SMPL0902
S     LGL 16                                                            SMPL0903
S     PXD 0,0                                                           SMPL0904
S     LGL 1                                                             SMPL0905
S     STO TEMP                                                          SMPL0906
S     PXD 0,0                                                           SMPL0907
S     LGL 1                                                             SMPL0908
S     STO TRUNK                                                         SMPL0909
S     ADD TEMP                                                          SMPL0910
S     LBT                                                               SMPL0911
S     TNZ *30                                                           SMPL0912
S40   ALS 1                                                             SMPL0913
S     ORA TRUNK                                                         SMPL0914
S     ALS 4                                                             SMPL0915
S     SLW TRUNK                                                         SMPL0916
S     PXD 0,0                                                           SMPL0917
S     LGL 6                                                             SMPL0918
S     TNZ *50                                                           SMPL0919
S     ORA TEN                                                           SMPL0920
S50   ORA TRUNK                                                         SMPL0921
S     LGL 12                                                            SMPL0922
S     LDQ BLNK                                                          SMPL0923
S     LGL 18                                                            SMPL0924
S     SLW TRUNK                                                         SMPL0925
      RETURN                                                            SMPL0926
      END (0,1,0,0,0)                                                   SMPL0927
*LOOKUP            ***FUNCTION LOOKUP(VAR,TABLE,LIMIT)***               SMPL0928
      FUNCTION LOOKUP(VAR,TABLE,LIMIT)                                  SMPL0929
      DIMENSION TABLE(1)                                                SMPL0930
      DO 6 LOOKUP=1,LIMIT                                               SMPL0931
5     IF(VAR-TABLE(LOOKUP))6,7,6                                        SMPL0932
 6    CONTINUE                                                          SMPL0933
      ERASE LOOKUP                                                      SMPL0934
  7   RETURN                                                            SMPL0935
      END (0,1,0,0,0)                                                   SMPL0936
*SCAN              ***SUBROUTINE SCAN***                                SMPL0937
      SUBROUTINE SCAN                                                   SMPL0938
      COMMON SYMBOL, STATMT, LOC, WORDS, KLOC, OP, ADDRS, CHAR          SMPL0939
      DIMENSION STATMT(660), WORDS(100), ADDRS(3)                       SMPL0940
      COMMON TRA,NTRA,IBOX,STOR,NSTOR,JBOX,REC,NREC,NRECR,KBOX,CON,LBOX SMPL0941
      DIMENSION TRA(200), NTRA(200), STOR(1750), NSTOR(1750),           SMPL0942
     *REC(50), NREC(50), NRECR(50), CON(650)                            SMPL0943
      COMMON NHOLD,NLOC                                                 SMPL0944
      NADD = NHOLD +1                                                   SMPL0945
      IF (LBOX) 699,799,699                                             SMPL0946
699   NLOC = NADD+1                                                     SMPL0947
      J = 1                                                             SMPL0948
700   NBOX = NEXT(CON(J))                                               SMPL0949
      IF (NBOX) 723,704,706                                             SMPL0950
723   PRINT 270, (CON(I),I=1,LBOX)                                      SMPL0951
270   FORMAT (27H0ERROR IN CONSTANTS TABLE. /(6H0     19A6))            SMPL0952
      SENSE LIGHT 1                                                     SMPL0953
      GO TO 799                                                         SMPL0954
704   JBOX = JBOX+1                                                     SMPL0955
      STOR(JBOX) = CON(J)                                               SMPL0956
      J = J+1                                                           SMPL0957
      GO TO 700                                                         SMPL0958
706   NADD = NADD+NBOX                                                  SMPL0959
      NSTOR(JBOX) =  NADD                                               SMPL0960
      INDEX = J+NBOX                                                    SMPL0961
      J = J+1                                                           SMPL0962
      B = (+1H )                                                        SMPL0963
      Y = TRUNK(CONV(NBOX))                                             SMPL0964
      X = TRUNK(CONV(NADD))                                             SMPL0965
      WRITE OUTPUT TAPE 4,3614,Y,X,(CON(I),I=J,INDEX),(B,I=NBOX,47)     SMPL0966
3614  FORMAT (1HL2A3,4H106048A1,22HA004080M080004B001011 )              SMPL0967
      J = INDEX+1                                                       SMPL0968
      IF (J - LBOX) 700,700,799                                         SMPL0969
799   NHOLD = NADD+1                                                    SMPL0970
      RETURN                                                            SMPL0971
      END (0,1,0,0,0)                                                   SMPL0972
*PASS 1            ***SUBROUTINE PASS 1 + STORAGE MAP***                SMPL0973
      SUBROUTINE PASS 1                                                 SMPL0974
      COMMON SYMBOL, STATMT, LOC, WORDS, KLOC, OP, ADDRS, CHAR          SMPL0975
      DIMENSION STATMT(660), WORDS(100), ADDRS(3)                       SMPL0976
      COMMON TRA,NTRA,IBOX,STOR,NSTOR,JBOX,REC,NREC,NRECR,KBOX,CON,LBOX SMPL0977
      DIMENSION TRA(200), NTRA(200), STOR(1750), NSTOR(1750),           SMPL0978
     *REC(50), NREC(50), NRECR(50), CON(650)                            SMPL0979
      COMMON NHOLD                                                      SMPL0980
      LOCN= NHOLD                                                       SMPL0981
33    READ TAPE 3,SYMBOL,N                                              SMPL0982
      IF (SYMBOL) 34,35,34                                              SMPL0983
34    IBOX = IBOX+1                                                     SMPL0984
      TRA(IBOX) = SYMBOL                                                SMPL0985
      NTRA(IBOX) = LOCN                                                 SMPL0986
35    LOCN = LOCN+XABSF(N)                                              SMPL0987
      IF (SYMBOL - 5H(END)) 33,330,33                                   SMPL0988
330   REWIND 3                                                          SMPL0989
      ERASE ADDRS,J                                                     SMPL0990
      N = 4000                                                          SMPL0991
      IF (SENSE LIGHT 2) 2,3                                            SMPL0992
2     IBOX = IBOX+1                                                     SMPL0993
      J = 1                                                             SMPL0994
      ADDRS(1) = 6HTPERR.                                               SMPL0995
      TRA(IBOX) = ADDRS(1)                                              SMPL0996
      N = 3786                                                          SMPL0997
      NTRA(IBOX) = N                                                    SMPL0998
      SENSE LIGHT 2                                                     SMPL0999
3     IF (SENSE LIGHT 3) 4,5                                            SMPL1000
4     IBOX = IBOX+1                                                     SMPL1001
      J = 1                                                             SMPL1002
      ADDRS(2) = 5HMULT.                                                SMPL1003
      TRA(IBOX) = ADDRS(2)                                              SMPL1004
      N = 3710                                                          SMPL1005
      NTRA(IBOX) = N                                                    SMPL1006
      SENSE LIGHT 3                                                     SMPL1007
5     IF (SENSE LIGHT 4) 6,7                                            SMPL1008
6     IBOX = IBOX+1                                                     SMPL1009
      J = 1                                                             SMPL1010
      ADDRS(3) = 4HDIV.                                                 SMPL1011
      TRA(IBOX) = ADDRS(3)                                              SMPL1012
      N = 3665                                                          SMPL1013
      NTRA(IBOX) = N                                                    SMPL1014
      SENSE LIGHT 4                                                     SMPL1015
7     LOCN = LOCN-1                                                     SMPL1016
      WRITE OUTPUT TAPE 2, 228,LOCN,NHOLD                               SMPL1017
228   FORMAT (23H1THIS PROGRAM OCCUPIES I4,60H LOCATIONS OF 1401 STORAGESMPL1018
     $.  INSTRUCTIONS BEGIN AT LOCATION I4,1H.)                         SMPL1019
      NBOX = IBOX-200                                                   SMPL1020
      IF (-NBOX) 5231,51,51                                             SMPL1021
5231  OP = 6HSTATMT                                                     SMPL1022
      GO TO 523                                                         SMPL1023
51    NBOX = JBOX-1750                                                  SMPL1024
      IF (-NBOX) 5232,52,52                                             SMPL1025
5232  OP = 5HFIELD                                                      SMPL1026
      GO TO 523                                                         SMPL1027
52    NBOX = KBOX-50                                                    SMPL1028
      IF (-NBOX) 5233,53,53                                             SMPL1029
5233  OP = 6HRECORD                                                     SMPL1030
      GO TO 523                                                         SMPL1031
53    NBOX = LBOX-650                                                   SMPL1032
      IF (-NBOX) 5234,54,54                                             SMPL1033
5234  OP = 6HCONST.                                                     SMPL1034
      GO TO 523                                                         SMPL1035
54    IF (KBOX) 61,62,61                                                SMPL1036
61    WRITE OUTPUT TAPE 2,221,KBOX                                      SMPL1037
221   FORMAT (44H0    RECORD NAME      LOCATION          END I8 )       SMPL1038
      WRITE OUTPUT TAPE 2,222,(REC(I),NREC(I),NRECR(I),I=1,KBOX)        SMPL1039
222   FORMAT (10XA6,6H  FROMI8,5H   TOI8)                               SMPL1040
62    IF (JBOX) 63,64,63                                                SMPL1041
63    WRITE OUTPUT TAPE 2,223,JBOX                                      SMPL1042
223   FORMAT(102H0     FIELD NAME      LOCATION            FIELD NAME   SMPL1043
     '   LOCATION            FIELD NAME      LOCATION I8 )              SMPL1044
      WRITE OUTPUT TAPE 2,224,(STOR(I),NSTOR(I),I=1,JBOX)               SMPL1045
224   FORMAT (10XA6,I14,16XA6,I14,16XA6,I14)                            SMPL1046
64    IF (IBOX) 65,66,65                                                SMPL1047
65    WRITE OUTPUT TAPE 2, 226,IBOX                                     SMPL1048
226   FORMAT(102H0 STATEMENT NAME      LOCATION        STATEMENT NAME   SMPL1049
     '   LOCATION        STATEMENT NAME      LOCATION I8 )              SMPL1050
      WRITE OUTPUT TAPE 2, 224,(TRA(I),NTRA(I),I=1,IBOX)                SMPL1051
66    IF (J) 70,80,70                                                   SMPL1052
70    WRITE OUTPUT TAPE 2, 75                                           SMPL1053
75    FORMAT (55H0THE FOLLOWING SUBROUTINES ARE UTILIZED BY THE PROGRAM.SMPL1054
     */)                                                                SMPL1055
      IF (ADDRS(1))71,72,71                                             SMPL1056
71    WRITE OUTPUT TAPE 2,710                                           SMPL1057
710   FORMAT (10X46HTPERR. - TAPE ERROR ROUTINE TO CORRECT TAPES. )     SMPL1058
72    IF (ADDRS(2))73,74,73                                             SMPL1059
73    WRITE OUTPUT TAPE 2,730                                           SMPL1060
730   FORMAT (10X44HMULT. -- PROGRAMMED MULTIPLICATION ROUTINE. )       SMPL1061
74    IF (ADDRS(3)) 77,80,77                                            SMPL1062
77    WRITE OUTPUT TAPE 2,770                                           SMPL1063
770   FORMAT (10X38HDIV. --- PROGRAMMED DIVISION ROUTINE. )             SMPL1064
80    LOCN = N-LOCN-1                                                   SMPL1065
      WRITE OUTPUT TAPE 2, 85, LOCN                                     SMPL1066
85    FORMAT (11H0THERE ARE I4,58H LOCATIONS OF AVAILABLE STORAGE AT THESMPL1067
     $ END OF THE PROGRAM.)                                             SMPL1068
      IF (LOCN) 90,99,99                                                SMPL1069
90    LOCN = -LOCN                                                      SMPL1070
      PRINT 95, LOCN                                                    SMPL1071
95    FORMAT (44H0PROGRAM AS WRITTEN OVERLAPS 1401 STORAGE BY I4,       SMPL1072
     $12H LOCATIONS. )                                                  SMPL1073
      GO TO 98                                                          SMPL1074
523   PRINT 5230, OP,NBOX                                               SMPL1075
5230  FORMAT (27H0SOURCE PROGRAM TOO LARGE. / 9H SIZE OF A6,23H NAME TABSMPL1076
     =LE EXCEEDED BY I4, 8H WORDS. )                                    SMPL1077
98    SENSE LIGHT 1                                                     SMPL1078
99    RETURN                                                            SMPL1079
      END (0,1,0,0,0)                                                   SMPL1080
*RESCAN            ***SUBROUTINE RESCAN***                              SMPL1081
      SUBROUTINE RESCAN                                                 SMPL1082
      COMMON SYMBOL, STATMT, LOC, WORDS, KLOC, OP, ADDRS, CHAR          SMPL1083
      DIMENSION STATMT(660), WORDS(100), ADDRS(3)                       SMPL1084
      COMMON TRA,NTRA,IBOX,STOR,NSTOR,JBOX,REC,NREC,NRECR,KBOX,CON,LBOX SMPL1085
      DIMENSION TRA(200), NTRA(200), STOR(1750), NSTOR(1750),           SMPL1086
     *REC(50), NREC(50), NRECR(50), CON(650)                            SMPL1087
      COMMON NHOLD,NLOC                                                 SMPL1088
      WRITE OUTPUT TAPE 2, 181                                          SMPL1089
181   FORMAT (1H1)                                                      SMPL1090
      IF (LBOX) 699,799,699                                             SMPL1091
699   J = 1                                                             SMPL1092
700   NBOX = NEXT(CON(J))                                               SMPL1093
      IF (NBOX) 704,704,706                                             SMPL1094
704   J = J+1                                                           SMPL1095
      GO TO 700                                                         SMPL1096
706   INDEX = J+NBOX                                                    SMPL1097
      J = J+1                                                           SMPL1098
      WRITE OUTPUT TAPE 2, 225, NLOC,(CON(I),I=J,INDEX)                 SMPL1099
225   FORMAT (10XI12,3X48A1)                                            SMPL1100
      NLOC = NLOC+NBOX                                                  SMPL1101
      J = INDEX+1                                                       SMPL1102
      IF (J - LBOX) 700,700,799                                         SMPL1103
799   RETURN                                                            SMPL1104
      END (0,1,0,0,0)                                                   SMPL1105
*PASS 2            ***SUBROUTINE PASS 2***                              SMPL1106
      SUBROUTINE PASS 2                                                 SMPL1107
      COMMON SYMBOL, STATMT, LOC, WORDS, KLOC, OP, ADDRS, CHAR          SMPL1108
      DIMENSION STATMT(660), WORDS(100), ADDRS(3)                       SMPL1109
      COMMON TRA,NTRA,IBOX,STOR,NSTOR,JBOX,REC,NREC,NRECR,KBOX,CON,LBOX SMPL1110
      DIMENSION TRA(200), NTRA(200), STOR(1750), NSTOR(1750),           SMPL1111
     *REC(50), NREC(50), NRECR(50), CON(650)                            SMPL1112
      COMMON NHOLD                                                      SMPL1113
      DIMENSION FO(3)                                                   SMPL1114
      LOCN= NHOLD                                                       SMPL1115
333   READ TAPE 3,SYMBOL,N,(ADDRS(I),I=0,3)                             SMPL1116
      CALL DICT (X,   OP, 66 HM     P     B     V     W     1     2     SMPL1117
     $4     F     K     .     )                                         SMPL1118
      IF (X) 3340,337,3340                                              SMPL1119
3340  IF (X - 1H2) 334,335,336                                          SMPL1120
334   CALL DICT(X,ADDRS(3),24HA     B     R     W     )                 SMPL1121
      IF (X) 3345,337,3345                                              SMPL1122
3345  I = 1                                                             SMPL1123
      IF (X - 1H2) 3341,3342,3341                                       SMPL1124
3341  I = I+1                                                           SMPL1125
3342  INDEX = LOOKUP(ADDRS(I),REC,KBOX)                                 SMPL1126
      IF(INDEX) 3343,3231,3343                                          SMPL1127
3343  IF (X - 1H3) 3344,3346,3346                                       SMPL1128
3344  ADDRS(I) = CONV(NRECR(INDEX))                                     SMPL1129
      GO TO 390                                                         SMPL1130
3346  ADDRS(I) = CONV(NREC (INDEX))                                     SMPL1131
      GO TO 390                                                         SMPL1132
335   DO 3350I=1,2                                                      SMPL1133
      INDEX = LOOKUP(ADDRS(I),REC,KBOX)                                 SMPL1134
      IF(INDEX) 3351,3231,3351                                          SMPL1135
3351  ADDRS(I) = CONV(NREC(INDEX))                                      SMPL1136
3350  CONTINUE                                                          SMPL1137
      GO TO 390                                                         SMPL1138
336   IF (ADDRS(1)) 3361,390,3361                                       SMPL1139
3361  IF (ADDRS - 3H*+2) 3363,3362,3363                                 SMPL1140
3362  ADDRS = CONV(LOCN+12)                                             SMPL1141
      GO TO 3369                                                        SMPL1142
3363  INDEX = LOOKUP(ADDRS(1),TRA,IBOX)                                 SMPL1143
      IF(INDEX) 3364,3233,3364                                          SMPL1144
3364  ADDRS(1) = CONV(NTRA(INDEX))                                      SMPL1145
3369  J = 2                                                             SMPL1146
      GO TO 3370                                                        SMPL1147
337   IF (OP - 1HU) 3375,390,3375                                       SMPL1148
3375  J = 1                                                             SMPL1149
3370  DO 380 I=J,2                                                      SMPL1150
      IF (ADDRS(I)) 338,390,338                                         SMPL1151
338   IF (NTYPE(ADDRS(I)) - 2) 3385,380,3385                            SMPL1152
3385  INDEX = LOOKUP(ADDRS(I),STOR,JBOX)                                SMPL1153
      IF(INDEX) 339,3232,339                                            SMPL1154
339   ADDRS(I) = CONV(NSTOR(INDEX))                                     SMPL1155
380   CONTINUE                                                          SMPL1156
      IF(OP-1HZ)390,990,390                                             SMPL1157
 990  ADDRS(2)=CONV(NSTOR(INDEX)-1)                                     SMPL1158
      GO TO 390                                                         SMPL1159
3231  PRINT 1242,ADDRS(I)                                               SMPL1160
1242  FORMAT (12H0THE SYMBOL A6,42HDOES NOT APPEAR IN THE RECORD NAME TASMPL1161
     $BLE. )                                                            SMPL1162
      GO TO 323                                                         SMPL1163
3233  PRINT 1243,ADDRS(1)                                               SMPL1164
1243  FORMAT (12H0THE SYMBOL A6,45HDOES NOT APPEAR IN THE STATEMENT NAMESMPL1165
     $ TABLE. )                                                         SMPL1166
      GO TO 323                                                         SMPL1167
3232  PRINT 1244,ADDRS(I)                                               SMPL1168
1244  FORMAT (12H0THE SYMBOL A6,41HDOES NOT APPEAR IN THE FIELD NAME TABSMPL1169
     $LE. )                                                             SMPL1170
323   PRINT 1245                                                        SMPL1171
1245  FORMAT (43H IT WAS NOT DEFINED BY THE SOURCE PROGRAM. )           SMPL1172
      GO TO 555                                                         SMPL1173
390   IF (SENSE LIGHT 1) 555,3900                                       SMPL1174
3900  J = 1                                                             SMPL1175
      DO 340 I=1,3                                                      SMPL1176
      IF (ADDRS(I)) 341,342,341                                         SMPL1177
341   IF (I-2) 3411,3411,3412                                           SMPL1178
3411  ADDRS(I) = TRUNK(ADDRS(I))                                        SMPL1179
3412  FO(J) = ADDRS(I)                                                  SMPL1180
      J = J+1                                                           SMPL1181
      GO TO 340                                                         SMPL1182
342   ADDRS(I) = (+1H )                                                 SMPL1183
340   CONTINUE                                                          SMPL1184
      WRITE OUTPUT TAPE 2,225,LOCN,(ADDRS(I),I=0,3)                     SMPL1185
225   FORMAT (10XI12,3XA1,XA3,XA3,XA1)                                  SMPL1186
      IF (J-4) 344,350,350                                              SMPL1187
344   DO 345 I=J,3                                                      SMPL1188
345   FO(I) = (+1H )                                                    SMPL1189
350   X = TRUNK(CONV(LOCN))                                             SMPL1190
      WRITE OUTPUT TAPE 4,227,X,OP,(FO(I),I=1,3)                        SMPL1191
227   FORMAT (4HL019A3,4H1060A1,2A3,A1,40X21HA007080M080007B001007)     SMPL1192
      LOCN = LOCN+XABSF(N)                                              SMPL1193
      GO TO 5050                                                        SMPL1194
555   SENSE LIGHT 1                                                     SMPL1195
5050  IF(SYMBOL- 5H(END)) 333,3030,333                                  SMPL1196
3030  REWIND 3                                                          SMPL1197
      IF (SENSE LIGHT 1) 8050,800                                       SMPL1198
800   CALL SUBR                                                         SMPL1199
      T = TRUNK(CONV(NHOLD))                                            SMPL1200
      WRITE OUTPUT TAPE 4, 229,T                                        SMPL1201
229   FORMAT (59X1H/A3,3H080)                                           SMPL1202
      GO TO 830                                                         SMPL1203
8050  SENSE LIGHT 1                                                     SMPL1204
830   RETURN                                                            SMPL1205
      END (0,1,0,0,0)                                                   SMPL1206
*SUBR              ***SUBROUTINE SUBR***                                SMPL1207
*SUBR    SUBROUTINE SUBR                                      917-040   SMPL1208
      SUBROUTINE SUBR                                                   SMPL1209
SPZE  OCT 326060606060                                                  SMPL1210
      IF (SENSE SWITCH 5) 31,32                                         SMPL1211
31    IF (SENSE LIGHT 2) 2,33                                           SMPL1212
2     WRITE OUTPUT TAPE 4, 2221                                         SMPL1213
