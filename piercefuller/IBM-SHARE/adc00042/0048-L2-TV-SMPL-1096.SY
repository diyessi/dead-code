*SIMPLE  TV SIMPLE-SYSTEM IMMEDIATELY MAKING PROGRAMMING LANGUAGE EASY  SMPL0001
C                  ***MAIN PROGRAM***                                           
*SIMPLE  SYSTEM IMMEDIATELY MAKING PROGRAMING LANGUAGE EASY.  917-040   SMPL0001
      COMMON SYMBOL, STATMT, LOC, WORDS, KLOC, OP, ADDRS, CHAR          SMPL0002
      DIMENSION CARD(66), STATMT(66,10), WORDS(100), ADDRS(3)           SMPL0003
      COMMON TRA,NTRA,IBOX,STOR,NSTOR,JBOX,REC,NREC,NRECR,KBOX,CON,LBOX SMPL0004
      DIMENSION TRA(200), NTRA(200), STOR(1750), NSTOR(1750),           SMPL0005
     *REC(50), NREC(50), NRECR(50), CON(650)                            SMPL0006
      COMMON NHOLD                                                      SMPL0007
      REWIND 2                                                          SMPL0008
      REWIND 3                                                          SMPL0009
      REWIND 4                                                          SMPL0010
      CALL NEXT(1H1)                                                    SMPL0011
572   NHOLD = 579                                                       SMPL0012
      SENSE LIGHT 0                                                     SMPL0013
      ERASE IBOX,JBOX,KBOX,LBOX                                         SMPL0014
      WRITE OUTPUT TAPE 2, 181                                          SMPL0015
181   FORMAT (1H1)                                                      SMPL0016
      SENSE LIGHT 3                                                     SMPL0017
      ERASE IND3, IND4                                                  SMPL0018
3     READ 1, SCARD,ICONT,(CARD(I),I=1,66)                              SMPL0019
1     FORMAT (A5,I1,66A1)                                               SMPL0020
      PRINT 80, SCARD,(CARD(I),I=1,66)                                  SMPL0021
80    FORMAT (6H1     A6,66A1)                                          SMPL0022
      IF (SENSE SWITCH 5) 54321,2                                       SMPL0023
54321 WRITE OUTPUT TAPE 4, 12345                                        SMPL0024
12345 FORMAT ( 60H,008013N0000,020027,031035,039,043,050,054,058074,0771SMPL0025
     1001    / 80HC038079B035/L073116,110106,105B101/I99,036A076038)036BSMPL0026
     2001/0991,001/001116I00099 /12H,0080121001  / 12H,0600671001  / 12HSMPL0027
     3,0740781060  / 12H,4011821060 47X18H,352372,382392B001 )          SMPL0028
2     IF (ICONT) 4,5,4                                                  SMPL0029
4     PRINT 39, SCARD,ICONT,(CARD(I),I=1,66)                            SMPL0030
39    FORMAT (39H0CONTINUATION CARD SEQUENCE INCORRECT. /1H0A5,I1,66A1) SMPL0031
45    SENSE LIGHT 1                                                     SMPL0032
5     SYMBOL = SCARD                                                    SMPL0033
      IF(SYMBOL-5H(FIN))90,900,90                                       SMPL0034
90    IF(SYMBOL-5H(END))11,50,11                                        SMPL0035
11    K = ICONT+1                                                       SMPL0036
      DO 6 I=1,66                                                       SMPL0037
6     STATMT(I,K) = CARD(I)                                             SMPL0038
8     READ 1, SCARD,ICONT,(CARD(I),I=1,66)                              SMPL0039
7     IF (ICONT) 9,10,9                                                 SMPL0040
9     IF (ICONT - K) 4,11,4                                             SMPL0041
10    LOC = K*66                                                        SMPL0042
      WRITE OUTPUT TAPE 2, 21, SYMBOL,(STATMT(I),I=1,LOC)               SMPL0043
21    FORMAT (6XA6,108A1/(12X108A1))                                    SMPL0044
      IF (SYMBOL - 1H*) 38,5,38                                         SMPL0045
38    ERASE CHAR                                                        SMPL0046
      CALL STRING                                                       SMPL0047
      IF(SENSE LIGHT 4) 45,111                                          SMPL0048
111   IF (WORDS - 6HFORMAT) 12,500,12                                   SMPL0049
12    IF (WORDS - 5HALPHA) 13,550,13                                    SMPL0050
13    IF (WORDS - 6HNUMBER) 14,567,14                                   SMPL0051
14    IF (WORDS - 3HSET) 15,599,15                                      SMPL0052
15    SNUM = (+1H )                                                     SMPL0053
      ERASE J, ADDRS                                                    SMPL0054
      DO 20 I=1,KLOC                                                    SMPL0055
      CALLDICT(X,WORDS(I),318HBRANCHMOVE  TO    IF    READ  PUNCH WRITE SMPL0056
     1TAPE  PRINT LAST  CARD  EOF   COMPAREQUAL LOW   HIGH  UNEQUAMINUS SMPL0057
     2FOR   EDIT  PRINTIRESET ADD   SUBTRARECORDFROM  BINARYREWINDIS    SMPL0058
     3SKIP  CHANNESTOP  SENSE SWITCHZERO  BACKSPLOAD  INTO  UNLOADSTART SMPL0059
     4SPACE AFTER STACK DOUBLEOVERFLCOLUMNMULTIP      BY    DIVIDECHANGESMPL0060
     5SIGN  OF    )                                                     SMPL0061
      IF(X)18,16,18                                                     SMPL0062
 16   J=J+1                                                             SMPL0063
      IF(J-3)17,17,237                                                  SMPL0064
 17   ADDRS(J)=WORDS(I)                                                 SMPL0065
      GO TO 20                                                          SMPL0066
 18   CALL JOIN(X,SNUM)                                                 SMPL0067
 20   CONTINUE                                                          SMPL0068
      N=IDENT(SNUM)                                                     SMPL0069
      IF (N) 22,23,22                                                   SMPL0070
22    CALL CHECK(N)                                                     SMPL0071
      IF(SENSE LIGHT 4)45,25                                            SMPL0072
25    CALL COMPIL(N)                                                    SMPL0073
      IF (OP - 5HMULT.) 35,30,35                                        SMPL0074
30    IND3 = 1                                                          SMPL0075
35    IF (OP - 4HDIV.) 456,40,456                                       SMPL0076
40    IND4 = 1                                                          SMPL0077
456   ERASE OP                                                          SMPL0078
      GO TO 5                                                           SMPL0079
237   PRINT 48, SYMBOL,(STATMT(I),I=1, LOC)                             SMPL0080
48    FORMAT (48H0THIS STATEMENT CONTAINS TOO MANY NAME SYMBOLS. /6H0   SMPL0081
     $  A6,108A1/(12X108A1))                                            SMPL0082
      SENSE LIGHT 1                                                     SMPL0083
      GO TO 5                                                           SMPL0084
23    PRINT 61, SYMBOL,(STATMT(I),I=1,LOC)                              SMPL0085
61    FORMAT (61H0INCORRECTLY WRITTEN STATEMENT NOT RECOGNIZED BY DICTIOSMPL0086
     $NARY. /6H0     A6,108A1/(12X108A1))                               SMPL0087
      SENSE LIGHT 1                                                     SMPL0088
      GO TO 5                                                           SMPL0089
500   SENSE LIGHT 4                                                     SMPL0090
      CALL RECORD                                                       SMPL0091
      GO TO 5                                                           SMPL0092
550   SENSE LIGHT 4                                                     SMPL0093
      CALL CONST                                                        SMPL0094
      GO TO 5                                                           SMPL0095
567   CALL CONST                                                        SMPL0096
      GO TO 5                                                           SMPL0097
599   CALL RECORD                                                       SMPL0098
      GO TO 5                                                           SMPL0099
50    WRITE OUTPUT TAPE 2, 21, SYMBOL                                   SMPL0100
      CALL CIT(4,1H.,5H(END),0,0)                                       SMPL0101
      END FILE 3                                                        SMPL0102
      REWIND 3                                                          SMPL0103
      IF (SENSE LIGHT 1) 51,53                                          SMPL0104
53    IF (IND3) 73,70,73                                                SMPL0105
73    SENSE LIGHT 3                                                     SMPL0106
70    IF (IND4) 74,79,74                                                SMPL0107
74    SENSE LIGHT 4                                                     SMPL0108
79    CALL SCAN                                                         SMPL0109
      CALL PASS 1                                                       SMPL0110
      IF (SENSE LIGHT 1) 51,57                                          SMPL0111
57    CALL RESCAN                                                       SMPL0112
      CALL PASS 2                                                       SMPL0113
      IF (SENSE LIGHT 1) 51,52                                          SMPL0114
51    PRINT 66                                                          SMPL0115
66    FORMAT (66H0COMPILING CANNOT CONTINUE, CORRECT SOURCE PROGRAM AND SMPL0116
     $RECOMPILE. )                                                      SMPL0117
      GO TO 54                                                          SMPL0118
52    PRINT 56                                                          SMPL0119
56    FORMAT (35H0COMPILING SUCCESSFULLY COMPLETED. )                   SMPL0120
54    END FILE 4                                                        SMPL0121
      IF (SENSE SWITCH 6) 572,909                                       SMPL0122
900   WRITE OUTPUT TAPE 2,990,SYMBOL                                    SMPL0123
990   FORMAT (6XA6)                                                     SMPL0124
909   WRITE OUTPUT TAPE 2, 181                                          SMPL0125
      END FILE 2                                                        SMPL0126
      REWIND 2                                                          SMPL0127
      REWIND 4                                                          SMPL0128
      PRINT 942                                                         SMPL0129
942   FORMAT (42H0END OF COMPILING RUN, ALL TAPES REWOUND. //////)      SMPL0130
      STOP  77777                                                       SMPL0131
      END (0,1,0,0,0)                                                   SMPL0132
*STRING            ***SUBROUTINE STRING***                              SMPL0133
      SUBROUTINE STRING                                                 SMPL0134
      COMMON SYMBOL, STATMT, LOC, WORDS, KLOC, OP, ADDRS, CHAR          SMPL0135
      DIMENSION STATMT(660), WORDS(100), ADDRS(3)                       SMPL0136
100   ITYPE = NTYPE(STATMT)                                             SMPL0137
      IF (ITYPE - 4) 1,2,1                                              SMPL0138
2     PRINT 54, SYMBOL,(STATMT(I),I=1,LOC)                              SMPL0139
54    FORMAT (54H0STATEMENT BEGINS WITH A BLANK CHARACTER IN COLUMN 7. /SMPL0140
     $6H0     A6,108A1/(12X108A1))                                      SMPL0141
      SENSE LIGHT 4                                                     SMPL0142
      GO TO 50                                                          SMPL0143
1     IF (ITYPE-1) 3,4,3                                                SMPL0144
3     PRINT 63, SYMBOL,(STATMT(I),I=1,LOC)                              SMPL0145
63    FORMAT (63H0STATEMENT BEGINS WITH A NON-ALPHABETIC CHARACTER IN COSMPL0146
     $LUMN 7. /6H0     A6,108A1/(12X108A1))                             SMPL0147
      SENSE LIGHT 4                                                     SMPL0148
      GO TO 50                                                          SMPL0149
4     WORDS = STATMT                                                    SMPL0150
      KTYPE = ITYPE                                                     SMPL0151
      KLOC = 1                                                          SMPL0152
      DO 10 I=2,LOC                                                     SMPL0153
      ITYPE = NTYPE(STATMT(I))                                          SMPL0154
      IF (ITYPE-KTYPE) 5,6,5                                            SMPL0155
5     IF (ITYPE-3) 7,8,9                                                SMPL0156
7     KLOC = KLOC+1                                                     SMPL0157
      WORDS(KLOC) = STATMT(I)                                           SMPL0158
      KTYPE = ITYPE                                                     SMPL0159
      GO TO 10                                                          SMPL0160
8     CHAR = STATMT(I)                                                  SMPL0161
9     KTYPE = 0                                                         SMPL0162
      GO TO 10                                                          SMPL0163
6     CALL JOIN(STATMT(I), WORDS(KLOC))                                 SMPL0164
10    CONTINUE                                                          SMPL0165
50    RETURN                                                            SMPL0166
      END (0,1,0,0,0)                                                   SMPL0167
*TYPE              ***FUNCTION NTYPE(SYMBOL)***                         SMPL0168
      FUNCTION NTYPE(SYMBOL)                                            SMPL0169
C     1 = ALPHABETIC, 2 = NUMERIC, 3 = PUNCTUATION, 4 = BLANK.          SMPL0170
      S = SYMBOL                                                        SMPL0171
      IF (S - 1H ) 50,4,50                                              SMPL0172
4     NTYPE = 4                                                         SMPL0173
      GO TO 12                                                          SMPL0174
50    IF (S) 8,3,5                                                      SMPL0175
5     IF (S - 1H9) 2,2,6                                                SMPL0176
2     NTYPE = 2                                                         SMPL0177
      GO TO 12                                                          SMPL0178
6     IF (S - 1HA) 3,1,7                                                SMPL0179
7     IF (S - 1HI) 1,1,3                                                SMPL0180
3     NTYPE = 3                                                         SMPL0181
      GO TO 12                                                          SMPL0182
8     IF (1HJ - S) 3,1,9                                                SMPL0183
9     IF (1HR - S) 1,1,10                                               SMPL0184
10    IF (1HS - S) 3,1,11                                               SMPL0185
11    IF (1HZ - S) 1,1,3                                                SMPL0186
1     NTYPE = 1                                                         SMPL0187
12    RETURN                                                            SMPL0188
      END (0,1,0,0,0)                                                   SMPL0189
*JOIN              ***SUBROUTINE JOIN(ONE,STRING)***                    SMPL0190
      SUBROUTINE JOIN(ONE,STRING)                                       SMPL0191
      FREQUENCY 31(1,0,1), 11(1,0), 51(1,0)                             SMPL0192
SO60  OCT 60                                                            SMPL0193
S     LDQ STRING                                                        SMPL0194
S6    PXD 6                                                             SMPL0195
S     LXA *6,(I)                                                        SMPL0196
S30   ALS 6                                                             SMPL0197
S     SLW TEMP                                                          SMPL0198
S     PXD                                                               SMPL0199
S     LGL 6                                                             SMPL0200
S31   CAS O60                                                           SMPL0201
S     TRA *10                                                           SMPL0202
S     TRA *20                                                           SMPL0203
S10   ORA TEMP                                                          SMPL0204
S11   TIX *30,(I),1                                                     SMPL0205
S     DED ,(I)                                                          SMPL0206
S     TRA *40                                                           SMPL0207
S20   LDQ ONE                                                           SMPL0208
S     CAL TEMP                                                          SMPL0209
S     ARS 6                                                             SMPL0210
S50   LGL 6                                                             SMPL0211
S51   TIX *50,(I),1                                                     SMPL0212
S     DED ,(I)                                                          SMPL0213
S40   SLW STRING                                                        SMPL0214
      RETURN                                                            SMPL0215
      END (0,1,0,0,0)                                                   SMPL0216
*DICT              ***SUBROUTINE DICT(X,WORDS,TABLES)***                SMPL0217
      SUBROUTINE DICT(X,WORDS,TABLE)                                    SMPL0218
      FREQUENCY 6(1,0,1),15(0,1)                                        SMPL0219
SLOFV OCT 1717171717                                                    SMPL0220
S     LXD *7,(I)                                                        SMPL0221
S5    CLA TABLE,(I)                                                     SMPL0222
S6    CAS WORDS                                                         SMPL0223
S7    TXI*10,0,0                                                        SMPL0224
S     TXI*20,(I),-2                                                     SMPL0225
S10   COM                                                               SMPL0226
S     ALS2                                                              SMPL0227
S15   TZE *30                                                           SMPL0228
S     TXI *5,(I),-1                                                     SMPL0229
S20   PXD 0,(I)                                                         SMPL0230
S     DED ,(I)                                                          SMPL0231
S     ALS 12                                                            SMPL0232
S     ORA LOFV                                                          SMPL0233
S     COM                                                               SMPL0234
S30   SLW X                                                             SMPL0235
      RETURN                                                            SMPL0236
      END (0,1,0,0,0)                                                   SMPL0237
