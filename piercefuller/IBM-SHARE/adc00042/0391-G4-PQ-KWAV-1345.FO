C     PQ        KWAV          N.F. LAUBSCHER     CSIR   PRETORIA        KWAV 000
C     KRUSKAL-WALLIS AND WILCOXON-MANN-WHITNEY TESTS                    KWAV 001
C     **********************************************                    KWAV 002
C                                                                       KWAV 003
C     PREPARATION OF DATA                                               KWAV 004
C     *******************                                               KWAV 005
C      (1) X(I,J)--- I-TH OBSERVATION OF J-TH SAMPLE                    KWAV 006
C      (2) NOT MORE THAN K=20 SAMPLES                                   KWAV 007
C      (3) NOT MORE THAN N(J)=50 OBSERVATIONS, J=1,K                    KWAV 008
C      (4) FIRST TWO COLUMNS OF DATA-CARD ONE CONTAIN  K.               KWAV 009
C          DIRECTLY AFTER THIS FOLLOWS N(1),N(2),... .ALL               KWAV 010
C          THESE RECORDED IN THE FORM **                                KWAV 011
C      (5) ON CARD TWO X(I,J) IS RECORDED. EACH X(I,J) IS               KWAV 012
C          WRITTEN IN TEN COLUMNS, LEFT JUSTIFIED,FOLLOWED              KWAV 013
C          BY BLANKS TO FILL UP THE TEN COLUMNS.SEVEN OB-               KWAV 014
C          SERVATIONS PER CARD.                                         KWAV 015
C      (6) DECIMAL POINT TO BE INCLUDED                                 KWAV 016
C      (7) EACH X(1,J) BEGINS ON A NEW CARD                             KWAV 017
      DIMENSION N(20),X(50,20),R(50,20),T(1000),RNK(20),SPT(1000)       KWAV 018
      DIMENSION ASU(20),SKOK(1000)                                      KWAV 019
   98 READ 1,K,(N(I),I=1,K)                                             KWAV 020
    1 FORMAT(21I2 )                                                     KWAV 021
      NUM=0                                                             KWAV 022
      DO 2 J=1,K                                                        KWAV 023
      L=N(J)                                                            KWAV 024
      NUM=NUM+N(J)                                                      KWAV 025
    2 READ 3,(X(I,J),I=1,L)                                             KWAV 026
    3 FORMAT(7F10.8)                                                    KWAV 027
      NI=0                                                              KWAV 028
      DO 4 J=1,K                                                        KWAV 029
      RNK(J)=0                                                          KWAV 030
      L=N(J)                                                            KWAV 031
      DO 4 I=1,L                                                        KWAV 032
      LCNT=0                                                            KWAV 033
      MCNT=0                                                            KWAV 034
      DO 5 JNEW=1,K                                                     KWAV 035
      LNEW=N(JNEW)                                                      KWAV 036
      DO 5 INEW=1,LNEW                                                  KWAV 037
      IF(X(I,J)-X(INEW,JNEW))5,7,6                                      KWAV 038
    6 LCNT=LCNT+1                                                       KWAV 039
      GO TO 5                                                           KWAV 040
    7 MCNT=MCNT+1                                                       KWAV 041
    5 CONTINUE                                                          KWAV 042
      SLCNT=LCNT                                                        KWAV 043
      SMCNT=MCNT                                                        KWAV 044
      IF(MCNT-1) 9,10,8                                                 KWAV 045
    8 NI=NI+1                                                           KWAV 046
      T(NI)=MCNT                                                        KWAV 047
      SPT(NI)=MCNT                                                      KWAV 048
   10 R(I,J)=SLCNT+(SMCNT+1.)/2.                                        KWAV 049
    4 RNK(J)=RNK(J)+ R(I,J)                                             KWAV 050
C     NOW WE DETERMINE THE CONTRIBUTION OF TIES.                        KWAV 051
      IF(SENSE SWITCH 1)73,72                                           KWAV 052
   73 PRINT 74                                                          KWAV 053
   74 FORMAT(2X,5HRANKS)                                                KWAV 054
      DO 75 J=1,K                                                       KWAV 055
      L=N(J)                                                            KWAV 056
   75 PRINT 76,(R(I,J),I=1,L)                                           KWAV 057
   76 FORMAT(2X,F7.1)                                                   KWAV 058
      PRINT 77                                                          KWAV 059
   77 FORMAT(2X,12HSUM OF RANKS)                                        KWAV 060
      DO 78 J=1,K                                                       KWAV 061
   78 PRINT 79,RNK(J)                                                   KWAV 062
   79 FORMAT(2X,F7.1)                                                   KWAV 063
      PAUSE                                                             KWAV 064
   72 CONTINUE                                                          KWAV 065
      IF(NI)9,177,178                                                   KWAV 066
  177 SGMAT=0                                                           KWAV 067
      GO TO 187                                                         KWAV 068
  178 SGMAT=0                                                           KWAV 069
      DO 27 L=1,NI                                                      KWAV 070
      KOK=0                                                             KWAV 071
      IF(T(L))9,28,29                                                   KWAV 072
   28 SKOK(L)=0                                                         KWAV 073
      GO TO 27                                                          KWAV 074
   29 DO 26 J=1,NI                                                      KWAV 075
      IF(T(L)-SPT(J)) 26,30,26                                          KWAV 076
   30 IF(L-J)31,32,31                                                   KWAV 077
   31 KOK=KOK+1                                                         KWAV 078
      SKOK(L)=KOK                                                       KWAV 079
      T(J)=0                                                            KWAV 080
      GO TO 26                                                          KWAV 081
   32 KOK=KOK+1                                                         KWAV 082
      SKOK(L)=KOK                                                       KWAV 083
   26 CONTINUE                                                          KWAV 084
   27 SGMAT=SGMAT+SKOK(L)*(SPT(L)**2.-1.)                               KWAV 085
C     THERE ARE S(L) TIES OF LENGTH SPT(L),WHERE S(L)=SKOK(L)/SPT(L)    KWAV 086
C     CONTRIBUTION OF EACH GROUP OF TIES OF LENGTH SPT(L) IS            KWAV 087
C     SPT(L)**3-SPT(L).                                                 KWAV 088
  187 IF(SENSE SWITCH 1)83,80                                           KWAV 089
   83 PRINT 82,SGMAT                                                    KWAV 090
   82 FORMAT(2X,23HCONTRIBUTION OF TIES = F8.2)                         KWAV 091
      IF(SGMAT)183,80,183                                               KWAV 092
  183 PRINT 285                                                         KWAV 093
  285 FORMAT(2X,27HTIES PRESENT,SENSE SWITCH 2)                         KWAV 094
      PAUSE                                                             KWAV 095
      IF(SENSE SWITCH 2)186,80                                          KWAV 096
  186 PRINT 288,NI,(SPT(L),L=1,NI)                                      KWAV 097
  288 FORMAT(2X,5HNI = I2//5HT(L) /25F4.1)                              KWAV 098
  189 PRINT 190,(SKOK(L),L=1,NI)                                        KWAV 099
  190 FORMAT(2X,7HSKOK(L)/25F4.1)                                       KWAV 100
      PAUSE                                                             KWAV 101
   80 CONTINUE                                                          KWAV 102
      IF(K-2)11,12,13                                                   KWAV 103
   11 PRINT 14                                                          KWAV 104
   14 FORMAT(1H1,48X,22HONLY ONE SAMPLE,ERROR.)                         KWAV 105
   12 PRINT 15                                                          KWAV 106
   15 FORMAT(1H1,34X,50H***WILCOXON-MANN-WHITNEY DISTRIBUTION FREE TEST*KWAV 107
     1**)                                                               KWAV 108
      A=N(1)                                                            KWAV 109
      B=N(2)                                                            KWAV 110
      IF(A-B)16,16,17                                                   KWAV 111
   16 UU=A*B+A*(A+1.)/2.-RNK(1)                                         KWAV 112
      ULE=A*B+B*(B+1.)/2.-RNK(2)                                        KWAV 113
      GO TO 18                                                          KWAV 114
   17 UU=A*B+B*(B+1.)/2.-RNK(2)                                         KWAV 115
      ULE=A*B+A*(A+1.)/2.-RNK(1)                                        KWAV 116
   18 IF(UU-ULE)19,19,20                                                KWAV 117
   19 SWW=UU                                                            KWAV 118
      GO TO145                                                          KWAV 119
   20 SWW=ULE                                                           KWAV 120
  145 IF(N(1)-N(2))21,21,22                                             KWAV 121
   22 NSWOP=N(2)                                                        KWAV 122
      N(2)=N(1)                                                         KWAV 123
      N(1)=NSWOP                                                        KWAV 124
   21 IF(N(2)-8)23,23,24                                                KWAV 125
   23 PRINT 25,SWW,N(1),N(2)                                            KWAV 126
   25 FORMAT(2X,91HENTER TABLE J OF S.SIEGEL (NONPARAMETRIC STATISTICS, KWAV 127
     1MCGRAW-HILL,NEW YORK.1956.PP.271-273).//2X,4HU = F6.2,10X,7HN(1) =KWAV 128
     2 I2,10X,7HN(2) = I2)                                              KWAV 129
      GO TO 98                                                          KWAV 130
   24 IF(N(2)-20)36,36,37                                               KWAV 131
   36 PRINT 38,SWW,N(1),N(2)                                            KWAV 132
   38 FORMAT(2X,90HENTER TABLE K OF S.SIEGEL(NONPARAMETRIC STATISTICS, MKWAV 133
     1CGRAW-HILL,NEW YORK.1956.PP.274-277).//2X,4HU = F6.2,10X,7HN(1) = KWAV 134
     2I2,10X,7HN(2) = I2,//2X,104HA VALUE OF U LESS THAN THE TABULATED VKWAV 135
     3ALUE SHOWS THAT THE NULL-HYPOTHESIS (EQUAL MEANS) MAY BE REJECTED.KWAV 136
     4)                                                                 KWAV 137
      GO TO 98                                                          KWAV 138
   37 CNCR =SQRTF(3.*(A+B)*(A+B-1.)/(A*B*((A+B)*((A+B)**2.-1.)-SGMAT))) KWAV 139
      ZOR= 2.*RNK(1)-A*(A+B+1.)                                         KWAV 140
      ZON =ZOR*CNCR                                                     KWAV 141
      IF(SENSE SWITCH 1) 148,149                                        KWAV 142
  148 PRINT 150,CNCR,ZOR, ZON                                           KWAV 143
  150 FORMAT(2X,7HCNCR = F9.4,6HZOR = F9.4,17HZON(NO CONTIN) = F9.4)    KWAV 144
      PAUSE                                                             KWAV 145
  149 CONTINUE                                                          KWAV 146
      IF(ABSF(ZON)-2.0537)42,45,45                                      KWAV 147
   42 IF(RNK(1)-A*(A+B+1.)/2.)44,45,46                                  KWAV 148
   44 ZON =ZON+CNCR                                                     KWAV 149
      GO TO 45                                                          KWAV 150
   46 ZON =ZON-CNCR                                                     KWAV 151
   45 PRINT 47, ZON                                                     KWAV 152
   47 FORMAT(2X,41HUNDER THE NULL-HYPOTHESIS Z(P) IS N(0,1)./2X,20HTHE CKWAV 153
     1URRENT VALUE IS/10X,6HZ(P) =F5.2,/2X,108HI HAVE MADE THE CONTINUITKWAV 154
     2Y CORRECTION (CF. K.A.BROWNLEE,STATISTICAL THEORY,JOHN WILEY.NEW YKWAV 155
     3ORK.1960. P.191).)                                                KWAV 156
      GO TO 98                                                          KWAV 157
   13 PRINT 61                                                          KWAV 158
   61 FORMAT(1H1,35X,49H***KRUSKAL-WALLIS ONE-WAY ANALYSIS OF VARIANCE**KWAV 159
     1*)                                                                KWAV 160
      ANUM=NUM                                                          KWAV 161
      SUMSQ=0                                                           KWAV 162
      DO 62 L=1,K                                                       KWAV 163
      ASU(L)=N(L)                                                       KWAV 164
   62 SUMSQ=SUMSQ +RNK(L)**2./ASU(L)                                    KWAV 165
      IF(SENSE SWITCH1)161,162                                          KWAV 166
  161 PRINT 163, SUMSQ                                                  KWAV 167
  163 FORMAT(2X,8HSUMSQ = F9.4)                                         KWAV 168
      PAUSE                                                             KWAV 169
  162 CONTINUE                                                          KWAV 170
      H=12.*SUMSQ/(ANUM*(ANUM+1.))-3.*(ANUM+1.)                         KWAV 171
      IF(SENSE SWITCH 1)184,185                                         KWAV 172
  184 PRINT 188,H                                                       KWAV 173
  188 FORMAT(2X,33HVALUE OF H (NO CORR. FOR TIES) = F9.4)               KWAV 174
  185 CONTINUE                                                          KWAV 175
      H=H/(1.-SGMAT/(ANUM**3.-ANUM))                                    KWAV 176
      NDF=K-1                                                           KWAV 177
      PRINT 63, NDF, H                                                  KWAV 179
   63 FORMAT(2X,64HTHE KRUSKAL-WALLIS STATISTIC IS DISTRIBUTED AS CHI-SQKWAV 180
     1UARE WITH  I2,2X,19HDEGREES OF FREEDOM./10X,4HH = F6.2)           KWAV 181
    9 PAUSE                                                             KWAV 182
      GO TO 98                                                          KWAV 183
      END(2,2,2,2,2)                                                    KWAV 184
