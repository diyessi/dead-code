C          ICE INTEGRATION SUBROUTINE                                   INT10001
C              I = 2    SECOND ORDER RUNGE-KUTTA                        INT10002
C              I = 3    THIRD ORDER RUNGE-KUTTA                         INT10003
C              I = 4    FOURTH ORDER RUNGE-KUTTA                        INT10004
C          STORAGE    F1 = E    = Z1                                    INT10005
C                     F2 = YHAF1        TEMPORARY STORAGE REQUIRED=     INT10006
C                     F3 = YFULL        DIMENSION OF F ARRAY =          INT10007
C                     F4 = YSAVE           N*(3+I)                      INT10008
C                     F5 = DYSAVE       WHERE N = NO OF DERIVATIVES     INT10009
C                     F6 = Z2           AND I = ORDER OF INTEGRATION    INT10010
C                     F7 = Z3                        PROCESS            INT10011
      SUBROUTINE INTEG (T,DT,   N,Y,DY,F,J,I)                           INT10012
      DIMENSION Y(1),DY(1),F(1)                                         INT10013
      DO 100 K = 1,N                                                    INT10014
      K1 = K                                                            INT10015
      K2 = K+5*N                                                        INT10016
      K3 = K2+N                                                         INT10017
      K4 = K + N                                                        INT10018
      GO TO (999,85,95,95),I                                            INT10019
 85   GO TO (86,2,999,999),J                                            INT10020
 86   F(K1) = DY(K)*DT                                                  INT10021
      Y(K) = F(K4) + F(K1)                                              INT10022
      GO TO 100                                                         INT10023
 95   GO TO (1,2,3,4),J                                                 INT10024
 1    F(K1) = DY(K)*DT                                                  INT10025
      Y(K) = F(K4)+.5*F(K1)                                             INT10026
      GO TO 100                                                         INT10027
 2    F(K2) = DY(K)*DT                                                  INT10028
      GO TO (999,22,23,24),I                                            INT10029
 3    F(K3) = DY(K)*DT                                                  INT10030
      GO TO (999,33,33,34),I                                            INT10031
 4    Y(K) = F(K4)+(F(K1)+2.*(F(K2)+F(K3))+DY(K)*DT)/6.                 INT10032
      GO TO 100                                                         INT10033
 22   Y(K) = .5*(F(K1)+F(K2))                                           INT10034
      GO TO 25                                                          INT10035
 23   Y(K) = 2.*F(K2)-F(K1)                                             INT10036
      GO TO 25                                                          INT10037
 24   Y(K) = .5*F(K2)                                                   INT10038
 25   Y(K) = Y(K)+F(K4)                                                 INT10039
      GO TO 100                                                         INT10040
 33   Y(K) = F(K4)+(F(K1)+4.*F(K2)+F(K3))/6.                            INT10041
      GO TO 100                                                         INT10042
 34   Y(K) = F(K4)+F(K3)                                                INT10043
 100  CONTINUE                                                          INT10044
      GO TO (110,120,130,140),J                                         INT10045
 110  GO TO (999,131,132,132),I                                         INT10046
 120  GO TO (999,140,132,140),I                                         INT10047
 130  GO TO (999,140,140,132),I                                         INT10048
 131  T = DT + T                                                        INT10049
      GO TO 140                                                         INT10050
 132  T = T + .5*DT                                                     INT10051
 140  RETURN                                                            INT10052
 999  PAUSE                                                             INT10053
      GO TO 140                                                         INT10054
      END(0,1,0,0,0)                                                    INT10055
