*WHHSV REM 0050 02131                                                   HSV 0001
*      FAP                                                              HSV 0002
*ENTHALPY AND ENTROPY OF SATURATED VAPOR (HSV) STEAM TABLE SUBROUTINE   HSV 0003
       COUNT  53                                                        HSV 0004
       ENTRY  HSV                                                       HSV 0005
       ENTRY  (HSV)                                                     HSV 0006
 HSV   SXD    *-2,4                                                     HSV 0007
       CLA*   1,4                                                       HSV 0008
       TSX    (HSV)+1,4                                                 HSV 0009
       LXD    HSV-2,4                                                   HSV 0010
       STO*   3,4                                                       HSV 0011
       STQ*   2,4                                                       HSV 0012
       CLA    E+26                                                      HSV 0013
       STO*   4,4                                                       HSV 0014
       CLA    E                                                         HSV 0015
       TRA    5,4                                                       HSV 0016
 (HSV) SXD    HSV-2,4                                                   HSV 0017
       SXA    HSV1-2,4                                                  HSV 0018
       STO    E                                                         HSV 0019
       CALL   TSL                                                       HSV 0020
       STO    COMMON+22                                                 HSV 0021
       TZE    HSV2                                                      HSV 0022
       CLA    E                                                         HSV 0023
       LDQ    =2200.                                                    HSV 0024
       TLQ    HSV1                                                      HSV 0025
       CLA    COMMON+22      P LESS OR EQUAL 2200. 1326 CYCLES, 2.89 MS HSV 0026
       CALL   (HSS)                                                     HSV 0027
       LDQ    E+2                                                       HSV 0028
       STQ    E                                                         HSV 0029
       LDQ    COMMON+22                                                 HSV 0030
       AXT    **,4                                                      HSV 0031
       TRA    1,4                                                       HSV 0032
 HSV1  TSX    $LDIR),4       P OVER 2200. 997 CYCLES, 2.173 MS          HSV 0033
       PTW    HSVTB,,11                                                 HSV 0034
       LDQ    COMMON+2                                                  HSV 0035
       STQ    E+26                                                      HSV 0036
       LDQ    COMMON+1                                                  HSV 0037
       TRA    HSV1-4                                                    HSV 0038
 HSV2  STZ    E                                                         HSV 0039
       PXD    ,0                                                        HSV 0040
       STZ    E+26                                                      HSV 0041
       TRA    HSV1-3                                                    HSV 0042
 HSVTB DEC    29E2,1E2,1119.2,1110.4,1101.1,1091.1,1080.2,1068.3,1054.8 HSV 0043
       DEC    1039.,1020.3,993.1,934.4,.1625,.1513,.1407,.1307,.1213    HSV 0044
       DEC    .1123,.1035,.0947,.0858,.0753,.058,1.2646,1.2541,1.2434   HSV 0045
       DEC    1.2322,1.2205,1.2082,1.1946,1.1792,1.1615,1.1368,1.0852   HSV 0046
       COMMON -168                                                      HSV 0047
 E     COMMON 50                                                        HSV 0048
COMMON COMMON 0                                                         HSV 0049
       END                                                              HSV 0050
