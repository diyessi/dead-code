       COUNT   100                                                      TYPE 000
*              SUBROUTINE  TYPE(BRAVS),    EXTINC(H,K,L,YESNO)          TYPE 001
*              SUBROUTINE TO BE USED WITH SCO ANGLE CALCULATOR          TYPE 002
*              ENTRYPOINTS AT     TYPE(BRAVS)                           TYPE 003
*                                 EXTINC(H,K,L,YESNO)                   TYPE 004
*              TYPE SETS UP THE FLOW FOR THE REQUESTED BRAVAIS LATTICE. TYPE 005
*              EXTINC SETS YESNO = 0 WHEN OBSERVED,                     TYPE 006
*                                = NOT ZERO WHEN EXTINCT.               TYPE 007
*                                                                       TYPE 008
*                                                                       TYPE 009
       ENTRY   TYPE                                                     TYPE 010
       ENTRY   EXTINC                                                   TYPE 011
*                                                                       TYPE 012
*                                                                       TYPE 013
TYPE   SXA     1BOX,1             SAVE INDEX 1                          TYPE 014
       CLA*    1,4                                                      TYPE 015
       AXT     0,1                                                      TYPE 016
       CAS     A                                                        TYPE 017
       TRA     *+2                                                      TYPE 018
       TXI     FOUND,1,1          A                                     TYPE 019
       CAS     B                                                        TYPE 020
       TRA     *+2                                                      TYPE 021
       TXI     FOUND,1,2          B                                     TYPE 022
       CAS     C                                                        TYPE 023
       TRA     *+2                                                      TYPE 024
       TXI     FOUND,2,3          C                                     TYPE 025
       CAS     F                                                        TYPE 026
       TRA     *+2                                                      TYPE 027
       TXI     FOUND,1,4          F                                     TYPE 028
       CAS     I                                                        TYPE 029
       TRA     *+2                                                      TYPE 030
       TXI     FOUND,1,5          I                                     TYPE 031
       CAS     R                                                        TYPE 032
       TRA     *+2                                                      TYPE 033
       TXI     FOUND,1,6          R                                     TYPE 034
       CAS     P                                                        TYPE 035
       TRA     *+2                NOT PUNCHED ON DATA CARD - SET = P    TYPE 036
       TXI     FOUND,1,0          P                                     TYPE 037
       CAL     P                                                        TYPE 038
       SLW*    1,4                SET BRAVS = P                         TYPE 039
FOUND  SXA     Q,1                SAVE TYPE INDEX                       TYPE 040
1BOX   AXT     **,1                                                     TYPE 041
       TRA     2,4                                                      TYPE 042
*                                                                       TYPE 043
P      BCI     1,P                                                      TYPE 044
A      BCI     1,A                                                      TYPE 045
B      BCI     1,B                                                      TYPE 046
C      BCI     1,C                                                      TYPE 047
F      BCI     1,F                                                      TYPE 048
I      BCI     1,I                                                      TYPE 049
R      BCI     1,R                                                      TYPE 050
*                                                                       TYPE 051
*                                                                       TYPE 052
*      EXTINC  SECOND ENTRY POINT OF ROUTINE.                           TYPE 053
*                                                                       TYPE 054
*                                                                       TYPE 055
EXTINC SXA     2BOX,2                                                   TYPE 056
Q      AXT     **,2                                                     TYPE 057
       TRA*    FORK,2                                                   TYPE 058
       TRA     RT                                                       TYPE 059
       TRA     IT                                                       TYPE 060
       TRA     FT                                                       TYPE 061
       TRA     CT                                                       TYPE 062
       TRA     BT                                                       TYPE 063
       TRA     AT                                                       TYPE 064
FORK   TRA     PT                                                       TYPE 065
PT     PXD                        CLEAR AC                              TYPE 066
EXIT   STO*    4,4                SET YESNO                             TYPE 067
2BOX   AXT     **,2                                                     TYPE 068
       TRA     5,4                                                      TYPE 069
AT     CLA*    2,4                                                      TYPE 070
       ADD*    3,4                K+L                                   TYPE 071
       ARS     18                                                       TYPE 072
       LBT                                                              TYPE 073
       PXD                        EVEN                                  TYPE 074
       TRA     EXIT               ODD                                   TYPE 075
BT     CLA*    1,4                                                      TYPE 076
       ADD*    3,4                H+L                                   TYPE 077
       ARS     18                                                       TYPE 078
       LBT                                                              TYPE 079
       PXD                                                              TYPE 080
       TRA     EXIT                                                     TYPE 081
CT     CLA*    1,4                                                      TYPE 082
       ADD*    2,4                                                      TYPE 083
       ARS     18                                                       TYPE 084
       LBT                                                              TYPE 085
       PXD                                                              TYPE 086
       TRA     EXIT                                                     TYPE 087
FT     CLA*    1,4                                                      TYPE 088
       ADD*    2,4                                                      TYPE 089
       ARS     18                                                       TYPE 090
       LBT                                                              TYPE 091
       TRA     AT                                                       TYPE 092
       TRA     EXIT                                                     TYPE 093
IT     CLA*    1,4                                                      TYPE 094
       ADD*    2,4                                                      TYPE 095
       ADD*    3,4                                                      TYPE 096
       ARS     18                                                       TYPE 097
       LBT                                                              TYPE 098
       PXD                                                              TYPE 099
       TRA     EXIT                                                     TYPE 100
RT     CLA*    1,4                                                      TYPE 101
       SUB*    2,4                                                      TYPE 102
       ADD*    3,4                                                      TYPE 103
       PDX     ,2                                                       TYPE 104
       TIX     *,2,3              MODULO 3                              TYPE 105
       TXL     *+2,2,2            1, 2, OR 0                            TYPE 106
       PXD                        3 = SET EQUAL TO ZERO                 TYPE 107
       TXH     EXIT,2,0           TEST FOR 0                            TYPE 108
       PXD                                                              TYPE 109
       TRA     EXIT                                                     TYPE 110
       END                                                              TYPE 111
