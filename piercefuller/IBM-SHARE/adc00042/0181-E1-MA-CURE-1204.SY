       SPACE   1                                                      MACURE 001
*      N DIMENSIONAL TABLE LOOK UP (MACURE)                             CURE 002
       SPACE   1                                                        CURE 003
*      MCDONNELL AUTOMATION CENTER                                      CURE 004
       SPACE   1                                                        CURE 005
*      GIVEN THE ARGUMENT Y(1),COMPUTE X(1)=F(Y(1),Y(2),......Y(N))     CURE 006
*      FROM A TABLE OF YS AND XS BY LINEAR INTERPOLATION                CURE 007
       SPACE   1                                                        CURE 008
*      CALLING SEQUENCE                                                 CURE 009
       SPACE   1                                                        CURE 010
*              LOC.  OP.     ADDR.        TAG    DECR.                  CURE 011
*              A     TSX     CURE       ,   4                           CURE 012
*              A+1   PZE     LOC(TABLE) ,   C,   N                      CURE 013
*              A+2   PZE     LOC(TABLE2)                                CURE 014
*              A+3   PZE     LOC(ARG(1)),   ,    LOC(NO OF VALUES)      CURE 015
*              A+4   PZE     LOC(ARG(2)),   ,    LOC(NO OF VALUES)      CURE 016
*              .     .       .              .    .                      CURE 017
*              .     .       .              .    .                      CURE 018
*              A+N+1 PZE     LOC(ARG(N)) ,  ,    LOC (NO OF VALUES)     CURE 019
*                            ERROR RETURN                               CURE 020
*                            NORMAL RETURN                              CURE 021
       SPACE   1                                                        CURE 022
*              WHERE                                                    CURE 023
*              LOC(TABLE) = FIRST LOCATION OF TABLE OF VARIABLES        CURE 024
*              C = 0 IF NO EXTRAPOLATION                                CURE 025
*              C=1 IF EXTRAPOLATION IS DESIRED, IT WILL                 CURE 026
*                  EXTRAPOLATE ON THE UPPER OR LOWER LIMIT              CURE 027
*              N = NO. OF DIMENSIONS                                    CURE 028
*              LOC(TABLE2)=FIRST LOCATION OF FUNCTION OF                CURE 029
*                            VARIABLES                                  CURE 030
*              LOC(ARG(1))=LOCATION OF ARGUMENT                         CURE 031
*              LOC(NO OF VALUES)=LOCATION OF NO. OF VALUES FOR          CURE 032
*                            THAT VARIABLE                              CURE 033
*              ETC.                                                     CURE 034
       SPACE   1                                                        CURE 035
*              ERROR RETURN WILL RESULT IN AN ERROR CODE                CURE 036
*              BEING PLACED IN THE DECREMENT PORTION OF                 CURE 037
*              THE TXL INSTRUCTION WHICH IS FIRST INSTRUCTION           CURE 038
*              OF THE PROGRAM                                           CURE 039
       SPACE   1                                                        CURE 040
*              ERROR CODE 1 INDICATES VALUE OF VARIABLE                 CURE 041
*              IS NOT IN ASCENDING ORDER                                CURE 042
       SPACE   1                                                        CURE 043
*              ERROR CODE 2 INDICATES THE ARGUMENT EXCEEDS              CURE 044
*              THE LIMIT OF THE TABLE AND C=0                           CURE 045
       SPACE   1                                                        CURE 046
*              ERROR CODE 3 THE NUMBER OF VALUES OF VARIABLE            CURE 047
*              IS NOT GREATER THAN 1                                    CURE 048
       SPACE   1                                                        CURE 049
*              ERROR CODE 4 POSSIBLE MACHINE ERROR                      CURE 050
*              RECOMMENDED PROCEDURE IS TO TAKE A MEMORY DUMP           CURE 051
       SPACE   1                                                        CURE 052
*              UPON ERROR RETURN THE ACCUMULATOR WILL CONTAIN           CURE 053
*              THE LOCATION OF THE TABLE OF OFFENDED                    CURE 054
*              VARIABLE                                                 CURE 055
       SPACE   1                                                        CURE 056
*              NORMAL RETURN WILL YIELD THE ANSWER IN                   CURE 057
*              THE ACCUMULATOR                                          CURE 058
       SPACE   1                                                        CURE 059
 CURE  TXL     *+5,,0        RESERVE DECREMENT FOR ERROR CODE           CURE 060
       AXT     **,4          RESTORE XRC                                CURE 061
       AXT     **,2          RESTORE XRB                                CURE 062
       AXT     **,1          RESTORE XRA                                CURE 063
       TRA     **,4          UNKNOWN DUE TO VARIABLE LENGTH LINKAGE     CURE 064
       SXA     CURE+1,4      SAVE XRC                                   CURE 065
       SXA     CURE+2,2      SAVE XRB                                   CURE 066
       SXA     CURE+3,1      SAVE XRA                                   CURE 067
       CLA     1,4           GET FIRST ENTRY                            CURE 068
       STT     EXTRA         SEE IF EXTRAPOLATION DESIRED               CURE 069
       STA     TAB1          STORE LOC OF BEGINNING OF VARIABLES        CURE 070
       ARS     18            SHIFT DIMENSION INTO ADDRESS               CURE 071
       STO     NOD           STORE NO. OF DIMENSIONS                    CURE 072
       ADD     CON           OBTAIN NORMAL RETURN                       CURE 073
       STA     CURE+4        SET UP THE TRA **                          CURE 074
       CLA     2,4           GET SECOND ENTRY                           CURE 075
       STA     TAB2          STORE BEGINNING OF TABLE OF FUNCTIONS      CURE 076
       DCT                   TURN OFF THE DIVIDE                        CURE 077
       NOP                   CHECK INDICATOR                            CURE 078
       CLA     NOD           PLACE THE NUMBER OF                        CURE 079
       SUB     CON+1         DIMENSIONS MINUS ONE                       CURE 080
       STO     NODM1                                                    CURE 081
       PAX     0,2           IN IRB                                     CURE 082
       AXT     0,1           XRA=0 (COUNT FOR PLACEMENT IN COMMON)      CURE 083
       TXI     A,4,-3        GET XRC READY FOR PROPER ENTRY             CURE 084
 LOOP1 LXA     ERASE,4       REGAIN LAST XRC                            CURE 085
       CLA     NEXT          GET READY TO PICK UP THE                   CURE 086
       STA     TAB1          NEXT ENTRY                                 CURE 087
 A     CLA     0,4           GET READY FOR ARGUMENT INFO                CURE 088
       ARS     18            GET INTO ADDRESS PORTION                   CURE 089
       STA     LXA1          SET UP INSTRUCTION TO GET AC INTO XRA      CURE 090
       STO     COMMON,1      SET IN ERASABLE STORAGE                    CURE 091
       CLA*    COMMON,1      GET READY FOR NEXT VARIABLE                CURE 092
       STO     COMMON,1      SET NOF OF VARIABLE S IN COMMON            CURE 093
       ADD     TAB1          SO IF THERE IS AN ERROR ONE CAN            CURE 094
       STA     NEXT          GET LOCATION INTO AC                       CURE 095
       SXD     ERASE+1,2     SAVE XRB                                   CURE 096
       SXD     ERASE+2,4     SAVE XRC                                   CURE 097
       XEC     LXA1          XRC CONTAINS NUMBER OF VALUES              CURE 098
       TXL     ERR3,4,1      BETTER BE GREATER THAN ONE                 CURE 099
       TXI     *+1,4,-1      CHECK TO SEE WHETHER                       CURE 100
       AXT     0,2           THE VALUES TABULATED                       CURE 101
 LOOP2 CLA*    TAB1          FOR EACH VARIABLE                          CURE 102
       TXI     *+1,2,-1      ARE INDEED IN THE                          CURE 103
       CAS*    TAB1          PROPER ASCENDING ORDER                     CURE 104
       TRA     ERR1          AC GREATER THAN C(Y)                       CURE 105
       TRA     ERR1          AC EQUAL TO C(Y)                           CURE 106
       TIX     LOOP2,4,1     AC LESS THAN C(Y)                          CURE 107
       LXD     ERASE+2,4     REGAIN INDEX REGISTER C                    CURE 108
       CLA*    0,4           GET ARGUMENT IN ACCUMULATOR                CURE 109
       TXI     *+1,4,-1      FOOL THAT CRAZY TSX INSTRUCTION            CURE 110
       SXA     ERASE,4       SAVE INDEX REGISTER C.                     CURE 111
 LXA1  LXA     **,4          GET NO. OF VALUES PER VARIABLE             CURE 112
       AXT     0,2           IRB=0                                      CURE 113
 COPAR CAS*    TAB1          COMPARE AGAINST VALUE OF VARIABLE          CURE 114
       TRA     GREAT         AC GREATER C(Y)                            CURE 115
       TRA     EQUAL-2       AC EQUALS C(Y)                             CURE 116
 LESS  TXH     EQUAL,2,0     AC LESS C(Y) IS IT BELOW LOWER LIMIT       CURE 117
       NZT     EXTRA         YES                                        CURE 118
       TRA     ERR2          BELOW LOWER LIMIT AND NO EXTRAPOLATE       CURE 119
       TXI     EQUAL,2,-1    GET I AND VALUES                           CURE 120
 GREAT TXI     *+1,2,-1      GO AFTER ANOTHER VALUE                     CURE 121
       TIX     COPAR,4,1     ARE ALL VALUES EXHAUSTED                   CURE 122
       NZT     EXTRA         DO WE EXTRAPOLATE                          CURE 123
       TRA     ERR2          NO                                         CURE 124
       TXI     EQUAL,2,1     YES                                        CURE 125
       TXH     EQUAL,2,0     SEE IF THE LOWER LIMIT                     CURE 126
       TXI     *+1,2,-1      IS THE EQUIVALENT OF ARGUMENT              CURE 127
 EQUAL STZ     COMMON+1,1    INITIALIZE STORAGE TO ZERO                 CURE 128
       STO     COMMON+2,1    STORE ARGUMENT                             CURE 129
       CLA*    TAB1                                                     CURE 130
       STO     COMMON+4,1    STORE VALUE OF VARIABLE AT (I)             CURE 131
       TXI     *+1,2,1                                                  CURE 132
       CLA*    TAB1                                                     CURE 133
       STO     COMMON+3,1    STORE VALUE OF VARIABLE AT(I-1)            CURE 134
       TXI     *+1,2,-2                                                 CURE 135
       SXA     *+1,2                                                    CURE 136
       AXC     **,2                                                     CURE 137
       PXA     0,2                                                      CURE 138
       STO     COMMON+1,1    STORE ACTUAL VALUE OF I                    CURE 139
       TXI     *+1,1,-5                                                 CURE 140
       LXD     ERASE+1,2                                                CURE 141
       TIX     LOOP1,2,1     ARE ALL ARGUMENTS EXHAUSTED                CURE 142
*      THE FOLLOWING INFORMATION PER VARIABLE SHOULD NOW                CURE 143
*      BE LOCATED IN COMMON, COMMON+1,.........,COMMON+5                CURE 144
*      NO OF VALUES FOR VARIABLE, VALUE OF I, ARGUMENT, VALUE           CURE 145
*      OF VARIABLE AT (I-1), AND VALUE OF VARIABLE AT (I)               CURE 146
*      NOW IT IS NECESSARY TO SET UP A TABLE OF LENGTH                  CURE 147
*      TWO RAISED TO THE NTH POWER                                      CURE 148
       LXA     NODM1,2       IRB=NO. OF DIMENSIONS MINUS ONE            CURE 149
       CLA     CON+2         GET TWO IN AC                              CURE 150
       TNX     *+3,2,1       SHOULD WE ONLY RAISE IT TO 1ST             CURE 151
       ALS     1             START SUCCESSIVE MULTIPLICATION BY 2       CURE 152
       TIX     *-1,2,1       IS EVERYTHING EXHAUSTED                    CURE 153
       STO     2NTH          STORE THE RESULT OF 2 TO THE NTH           CURE 154
       STZ     ERASE+2       INITIALIZE ERASABLE STORAGE                CURE 155
       SXA     ERASE+3,1     SAVE VALUE OF XRA                          CURE 156
       TXI     *+1,1,-COMMON GET VALUE OF COMMON INCORPORATED           CURE 157
       SXA     *+1,1                                                    CURE 158
       AXC     **,1                                                     CURE 159
       SXA     STORE+1,1                                                CURE 160
       SXA     STORE,1       SAVE VALUE                                 CURE 161
 RETUR STZ     ERASE         INITIALIZE FOR TOTAL                       CURE 162
       LXA     ERASE+3,1     RETRIEVE XRA                               CURE 163
       AXT     0,2           XRB=0                                      CURE 164
       CLA     CON+1         GET A FIXED ONE                            CURE 165
       STO     ERASE+1       ACCUMULATIVE MULTIPLICATION                CURE 166
 BACK  LDQ     ERASE+2       THE NO. OF TIMES THROUGH LOOP              CURE 167
       RQL     35,2          THIS IS WHERE DECISION IS                  CURE 168
       PXD                   MADE TO USE I OR TO                        CURE 169
       LGL     1             USE I-1 FOR A MULTIPLIER                   CURE 170
       SUB     CON+2         SUBTRACT FIX TWO                           CURE 171
       ADD     COMMON-4,1                                               CURE 172
       XCA                                                              CURE 173
       MPY     ERASE+1                                                  CURE 174
       XCA                                                              CURE 175
       ADD     ERASE                                                    CURE 176
       STO     ERASE                                                    CURE 177
       TXI     *+1,1,5       HAVE WE EXHAUSTED ALL                      CURE 178
       TXH     *+2,1,0       VALUES WHICH WERE STORED                   CURE 179
       TRA     AROND         YES                                        CURE 180
       LDQ     ERASE+1       NO                                         CURE 181
       MPY     COMMON,1      GET THE (I)TIMES R                         CURE 182
       STQ     ERASE+1                                                  CURE 183
       TXI     BACK,2,1      INCREMENT FOR SHIFT                        CURE 184
 AROND LAC     ERASE,4                                                  CURE 185
       CLA*    TAB2          GET THE VALUE OF FUNCTION                  CURE 186
       TXI     *+1,4,-1      FOR (I-1)                                  CURE 187
       LDQ*    TAB2          GET THE VALUE OF FUNCTION                  CURE 188
       LAC     ERASE+2,4     FOR (I)                                    CURE 189
       STO*    STORE         STORE THESE VALUES IN                      CURE 190
       TXI     *+1,4,-1      ERASABLE STORAGE                           CURE 191
       STQ*    STORE                                                    CURE 192
       CLA     ERASE+2       GET ERASE+2                                CURE 193
       ADD     CON+2         AND UP IT BY A FIXED 2                     CURE 194
       STO     ERASE+2                                                  CURE 195
       XCA                                                              CURE 196
       CLA     2NTH                                                     CURE 197
       TLQ     RETUR                                                    CURE 198
*      WE NOW HAVE LEGITIMATE VALUES IN ERASABLE STORAGE                CURE 199
*      LETS FLY TO COMPLETION                                           CURE 200
       CLA     CON+1         INITIALIZE LOADING OF                      CURE 201
       STA     LOOP3         INDEX REGISTER B                           CURE 202
       CLA     2NTH          INITIALIZE LOADING OF                      CURE 203
       STA     LOOP4         INDEX REGISTER A                           CURE 204
 LOOP4 AXT     **,1          SET THIS UP                                CURE 205
       AXT     0,4           IRC=0                                      CURE 206
 LOOP3 AXT     **,2          SET THIS UP                                CURE 207
       CLA*    STORE+1       X2                                         CURE 208
       TXI     *+1,2,1                                                  CURE 209
       FSB*    STORE+1       MINUS X1                                   CURE 210
       STO     ERASE         STORE RESULT                               CURE 211
       CLS*    STORE+1       -X1                                        CURE 212
       TXI     *+1,2,1                                                  CURE 213
       FAD*    STORE+1       +XX                                        CURE 214
       FDP     ERASE                                                    CURE 215
       DCT                   CHECK THE DIVIDE CHECK LITE                CURE 216
       TRA     ERR4          POSSIBLE MACHINE ERROR                     CURE 217
       STQ     ERASE         SAVE RESULT IN ERASABLE STORAGE            CURE 218
       TXI     *+1,4,-1                                                 CURE 219
       CLA*    STORE         Y2                                         CURE 220
       TXI     *+1,4,1                                                  CURE 221
       FSB*    STORE         MINUS Y1                                   CURE 222
       XCA                                                              CURE 223
       FMP     ERASE         TIMES (XX-X1/X2-X1)                        CURE 224
       FAD*    STORE         PLUS Y1                                    CURE 225
       SXA     *+5,4         SAVE XRC FOR LATER RETRIEVAL               CURE 226
 LOOP5 AXT     **,4          LOAD INDEX REGISTER C                      CURE 227
       STO*    STORE                                                    CURE 228
       TXI     *+1,4,-1                                                 CURE 229
       SXA     *-3,4         RESTORE THE XRC                            CURE 230
       AXT     **,4          PICK UP XRC                                CURE 231
       TXI     *+1,4,-2                                                 CURE 232
       TIX     LOOP3+12,1,2  HAVE WE EXHAUSTED                          CURE 233
       TXI     *+1,2,3                                                  CURE 234
       SXA     LOOP3,2       SET UP INDEX REGISTER B                    CURE 235
       PXD                   CLEAR THE ACCUMULATOR                      CURE 236
       STA     LOOP5                                                    CURE 237
       CLA     2NTH          DIVIDE NUMBER OF TIMES THROUGH             CURE 238
       ARS     1             BY TWO                                     CURE 239
       STO     2NTH          REDUCE BY TWO                              CURE 240
       SUB     CON+1         SUBTRACT ONE                               CURE 241
       TNZ     LOOP4-2       GO BACK TO SETUP                           CURE 242
       AXT     0,4                                                      CURE 243
       CLA*    STORE         EXIT WITH ANSWER IN AC                     CURE 244
       TRA     CURE+1        GO TO NORMAL RETURN                        CURE 245
*      CODING NECESSARY FOR VARIOUS ERROR CONDITIONS                    CURE 246
 ERR3  AXT     3,4           NO. OF VALUES NOT GREATER THAN 1           CURE 247
       SXD     CURE,4        SET ERROR IN DECR. OF TXL INSTRUCTION      CURE 248
       LXA     CURE+1,4      GET ORIGINAL VALUE OF XRC                  CURE 249
       CLA     TAB1          GET LOCATION OF TABLE IN AC                CURE 250
       TXI     CURE+2,4,1    GO TO RESTORE REGISTERS AND ERROR          CURE 251
 ERR2  AXT     2,4           C=0 AND ARG. EXCEEDS TABLE                 CURE 252
       TRA     ERR3+1                                                   CURE 253
 ERR1  AXT     1,4           ABS VALUE NOT IN ASCENDING ORDER           CURE 254
       TRA     ERR3+1                                                   CURE 255
 ERR4  AXT     4,4           POSSIBLE MACHINE ERROR                     CURE 256
       TRA     ERR3+1                                                   CURE 257
 EXTRA PZE     0             NON-ZERO(EXTRAPOLATION DESIRED)            CURE 258
 TAB1  PZE     **,2,0        BEGINNING OF TABLE OF VARIABLES            CURE 259
 TAB2  PZE     0,4           BEGINNING OF TABLE OF FUNCTIONS            CURE 260
 NOD   PZE     0             NO. OF DIMENSIONS                          CURE 261
 CON   DEC     3,1,2         CONSTANTS                                  CURE 262
 NEXT  PZE     0             CONTAINS WHAT TAB1 WILL NEXT               CURE 263
 ERASE BSS     4             ERASABLE STORAGE                           CURE 264
 NODM1 BSS     1             NO OF DIMENSIONS MINUS ONE                 CURE 265
 2NTH  BSS     1             VALUE OF 2 TO THE NTH                      CURE 266
 STORE PZE     **,4          USED FOR STORING VALUES FOR INTERPOLATION  CURE 267
       PZE     **,2                                                     CURE 268
