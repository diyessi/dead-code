      SUBROUTINE TSTROW(MROWZZ,LROWZZ)                                  1191    
C       JOB 188401400 DECOMPOSITION PROGRAM  ART FRIEDENHEIT            1192    
C                                                                       1193    
      COMMON                                                            1194    
     1 IDKMM, LPKMM, PMM, MPMM, FMM,                                    1195    
     2 IDKMS, LPKMS, PMS, MPMS,                                         1196    
     3 IDKSS, LPKSS, PSS, MPSS, FSS,                                    1197    
     4 IDKSM, LPKSM, PSM, MPSM,                                         1198    
     5 KUM, NZMMS, MTITLE, STITLE,                                      1199    
     6 SYSTLE, NINPTP                                                   1200    
      COMMON                                                            1201    
     1 NRDTP, NWRTP, NOUTTP, NINTP,                                     1202    
     2 MTRMMM, MTRMMS, MTRMSS, MTRMSM,                                  1203    
     3 MCOLMM, MCOLMS, MCOLSS, MCOLSM,                                  1204    
     4 MROWMM, MROWMS, MROWSS, MROWSM,                                  1205    
     5 JMATRI, JFIRST, JEOF, JMM, JMS, JSS, JSM, JRHS,                  1206    
     6 NTRMMM, NCOLMM, NROWMM,                                          1207    
     7 LTRMMM, LCOLMM, LROWMM,                                          1208    
     8 NSUBLP, NTRANP, NCARD, MSUMMM, NLP, NTP,                         1209    
     9 NAME, MROW, VALUE                                                1210    
      DIMENSION                                                         1211    
     1   IDKMM(500),   LPKMM(501),   PMM(3600),   MPMM(900),    FMM(90),1212    
     2   IDKMS(500),   LPKMS(501),   PMS(3600),   MPMS(900),            1213    
     3   IDKSS(500),   LPKSS(501),   PSS(3600),   MPSS(900),    FSS(90),1214    
     4   IDKSM(500),   LPKSM(501),   PSM(3600),   MPSM(900),            1215    
     5 KUM(90),  NZMMS(90),  MTITLE(12),  STITLE(12)                    1216    
     6 ,SYSTLE(12),  NINPTP(50)                                         1217    
C                                                                       1218    
      LROWZZ=XMAX0F(LROWZZ,MROW)                                        1219    
   20 IF(MROW-1)80,80,40                                                1220    
   40 IF(MROW-MSUMMM)60,80,60                                           1221    
   60 IF(MROW-MROWZZ)200,200,80                                         1222    
   80 WRITE OUTPUT TAPE NWRTP,900,MROW,NAME,NCARD,MROWZZ                1223    
  100 MROW=MROWZZ                                                       1224    
C                                                                       1225    
  200 RETURN                                                            1226    
  900 FORMAT(13H0ILLEGAL ROW I3,11H IN VECTOR A6,9H ON CARD I4,         1227    
     1 29H. ROW DESIGNATION CHANGED TO I3)                              1228    
       END                                                              1229    
