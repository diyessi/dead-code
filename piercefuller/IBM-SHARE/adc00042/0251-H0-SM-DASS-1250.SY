*     DATE XX/XX/XX                              VERY FIRST CARD, PLEASE0001    
*     DATASS SECTION OF LP DECOMPOSITION CODE  ART FRIEDENHEIT  SOCONY  0002    
*     XEQ                                                               0003    
*     LIST                                                              0004    
*     LABEL                                                             0005    
C       JOB 188401400 DECOMPOSITION PROGRAM  ART FRIEDENHEIT            0006    
C     DATA ASSEMBLY SECTION OF DECOMPOSITION LINEAR PROGRAMMING PROBLEM.0007    
C                                                                       0008    
C                                                                       0009    
      COMMON                                                            0010    
     1 IDKMM, LPKMM, PMM, MPMM, FMM,                                    0011    
     2 IDKMS, LPKMS, PMS, MPMS,                                         0012    
     3 IDKSS, LPKSS, PSS, MPSS, FSS,                                    0013    
     4 IDKSM, LPKSM, PSM, MPSM,                                         0014    
     5 KUM, NZMMS, MTITLE, STITLE,                                      0015    
     6 SYSTLE, NINPTP                                                   0016    
      COMMON                                                            0017    
     1 NRDTP, NWRTP, NOUTTP, NINTP,                                     0018    
     2 MTRMMM, MTRMMS, MTRMSS, MTRMSM,                                  0019    
     3 MCOLMM, MCOLMS, MCOLSS, MCOLSM,                                  0020    
     4 MROWMM, MROWMS, MROWSS, MROWSM,                                  0021    
     5 JMATRI, JFIRST, JEOF, JMM, JMS, JSS, JSM, JRHS,                  0022    
     6 NTRMMM, NCOLMM, NROWMM,                                          0023    
     7 LTRMMM, LCOLMM, LROWMM,                                          0024    
     8 NSUBLP, NTRANP, NCARD, MSUMMM, NLP, NTP,                         0025    
     9 NAME, MROW, VALUE                                                0026    
      DIMENSION                                                         0027    
     1   IDKMM(500),   LPKMM(501),   PMM(3600),   MPMM(900),    FMM(90),0028    
     2   IDKMS(500),   LPKMS(501),   PMS(3600),   MPMS(900),            0029    
     3   IDKSS(500),   LPKSS(501),   PSS(3600),   MPSS(900),    FSS(90),0030    
     4   IDKSM(500),   LPKSM(501),   PSM(3600),   MPSM(900),            0031    
     5 KUM(90),  NZMMS(90),  MTITLE(12),  STITLE(12)                    0032    
     6 ,SYSTLE(12),  NINPTP(50)                                         0033    
C                                                                       0034    
C                                                                       0035    
C     MM VECTORS ONLY IN THE MASTER L.P.                                0036    
C     MS VECTORS IN THE MASTER L.P. AND A SUB L.P.                      0037    
C     SS VECTORS ONLY IN A SUB L.P.                                     0038    
C     SM VECTORS IN A SUB L.P. AND THE MASTER L.P.                      0039    
C     THE MS-SM INTERACTION VECTORS ARE IDENTICAL IN NAME AND ORDER     0040    
C                                                                       0041    
C     A. PRELIMINARIES                                                  0042    
C                                                                       0043    
C     FORTRAN MONITOR SYSTEM INPUT ON A2                                0044    
C     FORTRAN MONITOR SYSTEM OUTPUT ON A3                               0045    
C     (COMPATIBLE WITH BELL MONITOR SYSTEM)                             0046    
      NRDTP=2                                                           0047    
      NWRTP=3                                                           0048    
C     SET DESIGNATION OF, AND REWIND, OUTPUT TAPE                       0049    
      NOUTTP=5                                                          0050    
      REWIND NOUTTP                                                     0051    
C                                                                       0052    
      PRINT9000                                                         0053    
      WRITE OUTPUT TAPE NWRTP,9000                                      0054    
      PRINT 9500                                                        0055    
      PAUSE 1                                                           0056    
C                                                                       0057    
C     SET MAXIMUM LIMITS CONSISTENT WITH DIMENSION STATEMENTS.          0058    
C                                                                       0059    
      MTRMMM=3600                                                       0060    
      MTRMMS=3600                                                       0061    
      MTRMSS=3600                                                       0062    
      MTRMSM=3600                                                       0063    
C                                                                       0064    
      MCOLMM=500                                                        0065    
      MCOLMS=500                                                        0066    
      MCOLSS=500                                                        0067    
      MCOLSM=500                                                        0068    
C                                                                       0069    
      MROWMM=90                                                         0070    
      MROWMS=90                                                         0071    
      MROWSS=90                                                         0072    
      MROWSM=90                                                         0073    
C                                                                       0074    
C     SET MISCELLANEOUS PARAMETERS                                      0075    
      CALL SETHOL(JMATRI,6HMATRIX)                                      0076    
      CALL SETHOL(JFIRST,6HFIRST )                                      0077    
      CALL SETHOL(JEOF,6HEOF   )                                        0078    
      CALL SETHOL(JMM,6HMM    )                                         0079    
      CALL SETHOL(JMS,6HMS    )                                         0080    
      CALL SETHOL(JSS,6HSS    )                                         0081    
      CALL SETHOL(JSM,6HSM    )                                         0082    
      CALL SETHOL(JRHS,6HR.H.S.)                                        0083    
C                                                                       0084    
C     SET INITIAL MM VALUES                                             0085    
      NTRMMM=0                                                          0086    
      NCOLMM=0                                                          0087    
      NROWMM=0                                                          0088    
C                                                                       0089    
      NCARD=0                                                           0090    
C     NUMBER N OF TERMS/COLS/ROWS USED NEVER EXCEEDS MAXIMUM M, ALTHO   0091    
C     A RECORD IS KEPT FOR ERROR PRINTOUT PURPOSES OF THE LARGEST L     0092    
      LTRMMM=0                                                          0093    
      LCOLMM=0                                                          0094    
      LROWMM=0                                                          0095    
C                                                                       0096    
C     B. SYSTEM CARDS                                                   0097    
C                                                                       0098    
C     READ AND PRINT SYSTEM TITLE CARD                                  0099    
      READ INPUT TAPE NRDTP,9010,SYSTLE                                 0100    
      PRINT 9025,SYSTLE                                                 0101    
      WRITE OUTPUT TAPE NWRTP,9025,SYSTLE                               0102    
C     READ AND PRINT SYSTEM PARAMETER CARD                              0103    
C     MLP INPUT DESIGNATION IN COLS.1,2.                                0104    
C     SUCCESSIVE SUBSYSTEM INPUT DESIGNATIONS IN COLS.3-4,5-6,...,49-50.0105    
C     TEMPORARILY PERMITS 25-1 = 24 SUBSYSTEMS.                         0106    
C     AT PRESENT SOLTNS SUBR. HANDLES UP TO 16 SLP SUBSYSTEMS.          0107    
      READ INPUT TAPE NRDTP,9400,(NINPTP(J),J=1,25),NSUBLP,NTRANP       0108    
      PRINT 9042,NSUBLP,NTRANP                                          0109    
      WRITE OUTPUT TAPE NWRTP,9042,NSUBLP,NTRANP                        0110    
      MROWMM=MROWMM-NSUBLP                                              0111    
      MROWMS=MROWMS-NSUBLP                                              0112    
      MCOLMM=MCOLMM-2*NSUBLP                                            0113    
      MTRMMM=MTRMMM-20*NSUBLP                                           0114    
C                                                                       0115    
C     PROCESS INPUT UNIT DESIGNATIONS                                   0116    
      NIN=1+NSUBLP+NTRANP                                               0117    
   20 DO30J=1,NIN                                                       0118    
      N=NINPTP(J)                                                       0119    
      IF(N)9999,22,24                                                   0120    
   22 NINPTP(J)=NRDTP                                                   0121    
   24 IF(N-NOUTTP)26,28,26                                              0122    
   26 IF(N-NWRTP)30,28,30                                               0123    
   28 PRINT 9410,J,N                                                    0124    
      CALL EXIT                                                         0125    
   30 CONTINUE                                                          0126    
      PRINT 9420,(NINPTP(J),J=1,NIN)                                    0127    
      WRITE OUTPUT TAPE NWRTP,9420,(NINPTP(J),J=1,NIN)                  0128    
C                                                                       0129    
C     C. READ IN MASTER L.P.                                            0130    
C                                                                       0131    
C     FETCH MLP INPUT UNIT DESIGNATION                                  0132    
      NINTP=NINPTP(1)                                                   0133    
C     READ AND PRINT MASTER L.P. TITLE CARD                             0134    
      READ INPUT TAPE NINTP,9010,MTITLE                                 0135    
      NCARD=NCARD+1                                                     0136    
      PRINT 9025,MTITLE                                                 0137    
      WRITE OUTPUT TAPE NWRTP,9025,MTITLE                               0138    
C                                                                       0139    
C     READ AND PRINT MASTER L.P. PARAMETER CARD                         0140    
C     CARD UTILIZES ONLY COLS. 16-20, 21-25, 26-30                      0141    
      READ INPUT TAPE NINTP,9030,MSUMMM,MFUNMM,NFUNMM                   0142    
      NCARD=NCARD+1                                                     0143    
      PRINT9040,MSUMMM,MFUNMM,NFUNMM                                    0144    
      WRITE OUTPUT TAPE NWRTP,9040,MSUMMM,MFUNMM,NFUNMM                 0145    
C                                                                       0146    
C     WRITE IDENTIFICATION RECORD ONTO TAPE (FIRST RECORD)              0147    
      WRITETAPENOUTTP,(SYSTLE(J),J=1,12),NSUBLP,NTRANP,MSUMMM,MFUNMM,   0148    
     1NFUNMM                                                            0149    
C                                                                       0150    
C     SEARCH FOR MATRIX CARD, SKIPPING OVER ANY INTERVENING             0151    
C     BASIS HEADING CARDS, ETCETERA (NO MORE THAN, SAY, 90)             0152    
      DO90J=1,90                                                        0153    
      READ INPUT TAPE NINTP, 9060, NAGNDM                               0154    
      NCARD=NCARD+1                                                     0155    
      IF(NAGNDM-JMATRI)90,100,90                                        0156    
   90 CONTINUE                                                          0157    
      PRINT 9430                                                        0158    
      CALL EXIT                                                         0159    
C                                                                       0160    
C     READ AN ENTRY                                                     0161    
  100 READ INPUT TAPE NINTP,9060,NAGNDM,NAME,MROW,VALUE                 0162    
      NCARD=NCARD+1                                                     0163    
C     TEST FOR NEW COLUMN NAME OR FIRST INDICATOR CARD                  0164    
      IF(NAGNDM-JFIRST)110,250,110                                      0165    
  110 IF(NAME-JKLAST)115,200,115                                        0166    
C                                                                       0167    
C     ENTER NEW COLUMN                                                  0168    
C     TEST FOR DUPLICATE VECTORS AMONG MM                               0169    
  115 JKLAST=NAME                                                       0170    
  120 IF(NCOLMM)9999,170,130                                            0171    
  130 DO150K=1,NCOLMM                                                   0172    
      IF(NAME-IDKMM(K))150,140,150                                      0173    
  140 WRITE OUTPUT TAPE NWRTP,9110,NAME,JMM                             0174    
  150 CONTINUE                                                          0175    
  170 CALL STEP(NCOLMM,MCOLMM,LCOLMM,6HMMCOLS)                          0176    
      IDKMM(NCOLMM)=NAME                                                0177    
      LPKMM(NCOLMM)=NTRMMM+1                                            0178    
C                                                                       0179    
C     ENTER TERM                                                        0180    
  200 CALL STEP(NTRMMM,MTRMMM,LTRMMM,6HMMTRMS)                          0181    
      CALL TSTROW(MROWMM,LROWMM)                                        0182    
      CALL TSTVAL                                                       0183    
      PMM(NTRMMM)=VALUE                                                 0184    
      CALL STOREM(MPMM(1),NTRMMM,MROW)                                  0185    
      NROWMM=XMAX0F(NROWMM,MROW)                                        0186    
C     GO TO READ ANOTHER ENTRY                                          0187    
      GOTO100                                                           0188    
C                                                                       0189    
  250 LPKMM(NCOLMM+1)=NTRMMM+1                                          0190    
      DO280M=1,MROWMM                                                   0191    
  280 FMM(M)=0.0                                                        0192    
      NROWP1=NROWMM+1                                                   0193    
C     READ IN RIGHT-HAND SIDE TERMS (NO MORE THAN MROWMM)               0194    
      DO350J=1,NROWP1                                                   0195    
      READ INPUT TAPE NINTP,9060,NAGNDM,NAME,MROW,VALUE                 0196    
      NCARD=NCARD+1                                                     0197    
C     TEST FOR EOF INDICATOR CARD                                       0198    
      IF(NAGNDM-JEOF)310,400,310                                        0199    
  310 NAME=JRHS                                                         0200    
      CALL TSTROW(NROWMM,LROWMM)                                        0201    
  320 FMM(MROW)=VALUE                                                   0202    
  350 CONTINUE                                                          0203    
      PRINT 9440                                                        0204    
      CALL EXIT                                                         0205    
C                                                                       0206    
C     PRINT MISC. MM TOTALS                                             0207    
  400 PRINT9080,NTRMMM,NCOLMM,NROWMM,NCARD                              0208    
      WRITE OUTPUT TAPE NWRTP,9080,NTRMMM,NCOLMM,NROWMM,NCARD           0209    
C                                                                       0210    
C     D. READ IN, PROCESS, WRITE-OUT SUB L.P.J, J=1,2,...,NSUBLP        0211    
C                                                                       0212    
      NLP=0                                                             0213    
      IF(NSUBLP)9999,3000,410                                           0214    
C     LOOP FOR EACH SLP GOES THRU STATEMENT 2000                        0215    
  410 NLP=NLP+1                                                         0216    
C     FETCH SLP INPUT UNIT DESIGNATION                                  0217    
      NINTP=NINPTP(NLP+1)                                               0218    
C     ASCERTAIN SLP NORMALIZING ROW                                     0219    
      MSIGMA=NROWMM+NLP                                                 0220    
C                                                                       0221    
C     SET INITIAL MS VALUES                                             0222    
      NTRMMS=0                                                          0223    
      NCOLMS=0                                                          0224    
      NROWMS=0                                                          0225    
      LTRMMS=0                                                          0226    
      LCOLMS=0                                                          0227    
      LROWMS=0                                                          0228    
C     SET INITIAL SS VALUES                                             0229    
      NTRMSS=0                                                          0230    
      NCOLSS=0                                                          0231    
      NROWSS=0                                                          0232    
      LTRMSS=0                                                          0233    
      LCOLSS=0                                                          0234    
      LROWSS=0                                                          0235    
C     SET INITIAL SM VALUES                                             0236    
      NTRMSM=0                                                          0237    
      NCOLSM=0                                                          0238    
      NROWSM=0                                                          0239    
      LTRMSM=0                                                          0240    
      LCOLSM=0                                                          0241    
      LROWSM=0                                                          0242    
C                                                                       0243    
      NCARD=0                                                           0244    
      JKLAST=0                                                          0245    
      DO420M=1,MROWMS                                                   0246    
  420 NZMMS(M)=0                                                        0247    
C                                                                       0248    
C     READ AND PRINT SUB L.P. TITLE CARD                                0249    
      READ INPUT TAPE NINTP,9010,STITLE                                 0250    
      NCARD=NCARD+1                                                     0251    
      PRINT 9020,STITLE                                                 0252    
      WRITE OUTPUT TAPE NWRTP,9020,STITLE                               0253    
C     READ AND PRINT SUB L.P. PARAMETER CARD                            0254    
      READ INPUT TAPE NINTP,9030,MSUMSS,MFUNSS,NFUNSS                   0255    
      NCARD=NCARD+1                                                     0256    
      PRINT9040,MSUMSS,MFUNSS,NFUNSS                                    0257    
      WRITE OUTPUT TAPE NWRTP,9040,MSUMSS,MFUNSS,NFUNSS                 0258    
      IF(MSUMMM-MSUMSS)470,450,470                                      0259    
  450 IF(MFUNMM-MFUNSS)470,460,470                                      0260    
  460 IF(NFUNMM-NFUNSS)470,480,470                                      0261    
  470 PRINT9090                                                         0262    
      WRITE OUTPUT TAPE NWRTP,9090                                      0263    
  480 CONTINUE                                                          0264    
C                                                                       0265    
C     SEARCH FOR MATRIX CARD                                            0266    
      DO490J=1,90                                                       0267    
      READ INPUT TAPE NINTP, 9060, NAGNDM                               0268    
      NCARD=NCARD+1                                                     0269    
      IF(NAGNDM-JMATRI)490,500,490                                      0270    
  490 CONTINUE                                                          0271    
      PRINT 9430                                                        0272    
      CALL EXIT                                                         0273    
C                                                                       0274    
C     READ AN ENTRY                                                     0275    
  500 READ INPUT TAPE NINTP,9060,NAGNDM,NAME,MROW,VALUE                 0276    
      NCARD=NCARD+1                                                     0277    
C     TEST FOR NEW COLUMN NAME OR FIRST INDICATOR CARD                  0278    
      IF(NAGNDM-JFIRST)505,1000,505                                     0279    
  505 IF(NAME-JKLAST)515,510,515                                        0280    
  510 GOTO(750,950),JSSSM                                               0281    
C     NEW COLUMN                                                        0282    
C     TEST FOR DUPLICATE VECTORS AMONG THE SS                           0283    
  515 JKLAST=NAME                                                       0284    
  520 IF(NCOLSS)9999,560,530                                            0285    
  530 DO550K=1,NCOLSS                                                   0286    
      IF(NAME-IDKSS(K))550,540,550                                      0287    
  540 PRINT9110,NAME,JSS                                                0288    
      WRITE OUTPUT TAPE NWRTP,9110,NAME,JSS                             0289    
  550 CONTINUE                                                          0290    
C     TEST FOR DUPLICATE VECTORS AMONG THE SM                           0291    
  560 IF(NCOLSM)9999,600,570                                            0292    
  570 DO590K=1,NCOLSM                                                   0293    
      IF(NAME-IDKSM(K))590,580,590                                      0294    
  580 PRINT9110,NAME,JSM                                                0295    
      WRITE OUTPUT TAPE NWRTP,9110,NAME,JSM                             0296    
  590 CONTINUE                                                          0297    
C                                                                       0298    
C     SEARCH FOR A CORRESPONDING VECTOR AMONG THE MM                    0299    
  600 DO640KMM=1,NCOLMM                                                 0300    
      IF(NAME-IDKMM(KMM))640,610,640                                    0301    
  610 IF(LPKMM(KMM))620,9999,800                                        0302    
  620 PRINT9110,NAME,JMS                                                0303    
      WRITE OUTPUT TAPE NWRTP,9110,NAME,JMS                             0304    
      GOTO800                                                           0305    
  640 CONTINUE                                                          0306    
C                                                                       0307    
C     NEW VECTOR IS NON-INTERACTING, I.E., SS                           0308    
C     NEW SS VECTOR- ASSIGN SS TERM FLAG                                0309    
  700 JSSSM=1                                                           0310    
      CALL STEP(NCOLSS,MCOLSS,LCOLSS,6HSSCOLS)                          0311    
      IDKSS(NCOLSS)=NAME                                                0312    
      CALL STEP(NTRMSS,MTRMSS,LTRMSS,6HSSTRMS)                          0313    
      LPKSS(NCOLSS)=NTRMSS                                              0314    
C     ADD ANOTHER TERM FOR COST ROW                                     0315    
C     INSERT DUMMY ENTRY ON ROW 1 AS FIRST TERM                         0316    
      PSS(NTRMSS)=0.0                                                   0317    
      CALL STOREM(MPSS(1),NTRMSS,1)                                     0318    
C                                                                       0319    
C     ENTER SS TERM                                                     0320    
  750 CALL STEP(NTRMSS,MTRMSS,LTRMSS,6HSSTRMS)                          0321    
      CALL TSTROW(MROWSS,LROWSS)                                        0322    
      CALL TSTVAL                                                       0323    
      PSS(NTRMSS)=VALUE                                                 0324    
      CALL STOREM(MPSS(1),NTRMSS,MROW)                                  0325    
      NROWSS=XMAX0F(NROWSS,MROW)                                        0326    
C     GO TO READ ANOTHER ENTRY                                          0327    
      GOTO500                                                           0328    
C                                                                       0329    
C     NEW VECTOR IS INTERACTING, I.E., SM                               0330    
C     EXTRACT MS VECTOR FROM MM                                         0331    
  800 CALL STEP(NCOLMS,MCOLMS,LCOLMS,6HMSCOLS)                          0332    
      IDKMS(NCOLMS)=IDKMM(KMM)                                          0333    
      LPKMS(NCOLMS)=NTRMMS+1                                            0334    
      MMLOW =XABSF(LPKMM(KMM))                                          0335    
      MMHIGH=XABSF(LPKMM(KMM+1))-1                                      0336    
      DO820J=MMLOW,MMHIGH                                               0337    
      CALL STEP(NTRMMS,MTRMMS,LTRMMS,6HMSTRMS)                          0338    
      PMS(NTRMMS)=PMM(J)                                                0339    
      CALL FETCHM(MPMM(1),J,MMS)                                        0340    
      CALL STOREM(MPMS(1),NTRMMS,MMS)                                   0341    
      NROWMS=XMAX0F(NROWMS,MMS)                                         0342    
C     KEEP TRACK OF ROWS WITH NON-ZERO ENTRIES, FOR NSQUOZ COUNT        0343    
  820 NZMMS(MMS)=NZMMS(MMS)+1                                           0344    
C     FLAG MM VECTOR TO INDICATE IT HAS ALSO BEEN AN MS VECTOR          0345    
      LPKMM(KMM)=-XABSF(LPKMM(KMM))                                     0346    
C                                                                       0347    
C     NEW  SM VECTOR- ASSIGN SM TERM FLAG                               0348    
  900 JSSSM=2                                                           0349    
      CALL STEP(NCOLSM,MCOLSM,LCOLSM,6HSMCOLS)                          0350    
      IDKSM(NCOLSM)=NAME                                                0351    
      CALL STEP(NTRMSM,MTRMSM,LTRMSM,6HSMTRMS)                          0352    
      LPKSM(NCOLSM)=NTRMSM                                              0353    
C     ADD ANOTHER TERM FOR COST ROW                                     0354    
C     INSERT DUMMY ENTRY ON ROW 1 AS FIRST TERM                         0355    
      PSM(NTRMSM)=0.0                                                   0356    
      CALL STOREM(MPSM(1),NTRMSM,1)                                     0357    
C                                                                       0358    
C     ENTER SM TERM                                                     0359    
  950 CALL STEP(NTRMSM,MTRMSM,LTRMSM,6HSMTRMS)                          0360    
      CALL TSTROW(MROWSM,LROWSM)                                        0361    
      CALL TSTVAL                                                       0362    
      PSM(NTRMSM)=VALUE                                                 0363    
      CALL STOREM(MPSM(1),NTRMSM,MROW)                                  0364    
      NROWSM=XMAX0F(NROWSM,MROW)                                        0365    
C     GO TO READ ANOTHER ENTRY                                          0366    
      GOTO500                                                           0367    
C                                                                       0368    
C                                                                       0369    
 1000 LPKMS(NCOLMS+1)=NTRMMS+1                                          0370    
      LPKSS(NCOLSS+1)=NTRMSS+1                                          0371    
      LPKSM(NCOLSM+1)=NTRMSM+1                                          0372    
      NROWSS=XMAX0F(NROWSS,NROWSM)                                      0373    
      DO1010M=1,MROWSS                                                  0374    
 1010 FSS(M)=0.0                                                        0375    
C                                                                       0376    
C     READ IN RIGHT-HAND SIDE TERMS (NO MORE THAN NROWSS)               0377    
      DO1050J=1,NROWSS                                                  0378    
      READ INPUT TAPE NINTP,9060,NAGNDM,NAME,MROW,VALUE                 0379    
      NCARD=NCARD+1                                                     0380    
C     TEST FOR EOF INDICATOR CARD                                       0381    
      IF(NAGNDM-JEOF)1030,1090,1030                                     0382    
 1030 NAME=JRHS                                                         0383    
      CALL TSTROW(NROWSS,LROWSS)                                        0384    
      FSS(MROW)=VALUE                                                   0385    
 1050 CONTINUE                                                          0386    
      PRINT 9440                                                        0387    
      CALL EXIT                                                         0388    
C                                                                       0389    
C     FINISHED READING IN SLP AND SEPERATING INTERACTION VECTORS.       0390    
C     NOW ADD SM TO SS, I.E., PLACE INTERACTION VECTORS LAST            0391    
 1090 IF(NCOLSM)9999,1160,1100                                          0392    
 1100 DO1110KSM=1,NCOLSM                                                0393    
      CALL STEP(NCOLSS,MCOLSS,LCOLSS,6HSLPCOL)                          0394    
      IDKSS(NCOLSS)=IDKSM(KSM)                                          0395    
 1110 LPKSS(NCOLSS)=LPKSM(KSM)+NTRMSS                                   0396    
      DO1120NSM=1,NTRMSM                                                0397    
      CALL STEP(NTRMSS,MTRMSS,LTRMSS,6HSLPTRM)                          0398    
      PSS(NTRMSS)=PSM(NSM)                                              0399    
      CALL FETCHM(MPSM(1),NSM,MSM)                                      0400    
 1120 CALL STOREM(MPSS(1),NTRMSS,MSM)                                   0401    
C                                                                       0402    
      LPKSS(NCOLSS+1)=NTRMSS+1                                          0403    
C                                                                       0404    
C     COMPUTE NUMBER OF PACKED SQUOZED ENTRIES IN SOLUTION VECTOR       0405    
C     (NUMBER OF DIFFERENT MS VECTOR ROWS WITH ENTRIES, PLUS 1)         0406    
C     MAKE CERTAIN ALL FUNCTIONAL ROWS CAN BE REPRESENTED               0407    
      DO1130J=2,MFUNMM                                                  0408    
      IF(NZMMS(J))9999,1125,1130                                        0409    
 1125 NZMMS(J)=999                                                      0410    
 1130 CONTINUE                                                          0411    
      NSQUOZ=1                                                          0412    
      DO1150J=1,NROWMS                                                  0413    
      IF(NZMMS(J))9999,1150,1140                                        0414    
 1140 NSQUOZ=NSQUOZ+1                                                   0415    
 1150 CONTINUE                                                          0416    
C                                                                       0417    
 1160 JESUS=2                                                           0418    
C                                                                       0419    
 1180 DO1190M=1,NROW                                                    0420    
 1190 KUM(M)=0                                                          0421    
C                                                                       0422    
C     ASCERTAIN NUMBER OF UNIT VECTORS WHICH MIGHT BE USED IN INIT BASIS0423    
 1200 NUK=0                                                             0424    
      DO1250KSS=1,NCOLSS                                                0425    
C     IS THERE ONLY ONE ENTRY (BESIDES THE ZERO IN COST ROW)            0426    
      IF(LPKSS(KSS)+JESUS-LPKSS(KSS+1))1250,1210,9999                   0427    
C     IS THIS ENTRY A +1                                                0428    
 1210 LONEP=LPKSS(KSS)+JESUS-1                                          0429    
      IF(PSS( LONEP)-1.0)1250,1220,1250                                 0430    
C     IS THERE A VECTOR ALREADY IN THE BASIS ON THE ROW OF THE +1       0431    
 1220 CALL FETCHM(MPSS(1),LONEP,MONEP)                                  0432    
      IF(KUM(MONEP))9999,1230,1250                                      0433    
C     ENTER VECTOR INTO BASIS, SET FLAG                                 0434    
 1230 KUM(MONEP)=KSS                                                    0435    
C     LPKSS(KSS)=-XABSF(LPKSS(KSS))                                     0436    
      NUK=NUK+1                                                         0437    
 1250 CONTINUE                                                          0438    
C                                                                       0439    
      GOTO(5400,1400),JESUS                                             0440    
C                                                                       0441    
C     PRINT SLP PARAMETERS, MATRICES                                    0442    
 1400 PRINT9300                                                         0443    
      WRITE OUTPUT TAPE NWRTP,9300                                      0444    
      PRINT9310,NLP,NTP,NTRMSS,NCOLSS,NROWSS,NSQUOZ,NUK,                0445    
     1NTRMMS,NCOLMS,NROWMS,NCARD,MSIGMA                                 0446    
      WRITE OUTPUT TAPE NWRTP,9310,NLP,NTP,NTRMSS,NCOLSS,NROWSS,NSQUOZ,N0447    
     1UK,NTRMMS,NCOLMS,NROWMS,NCARD,MSIGMA                              0448    
      WRITE OUTPUT TAPE NWRTP,9330                                      0449    
      CALL PRINTK(NCOLSS,IDKSS,LPKSS)                                   0450    
      CALL PRINTN(NTRMSS,PSS,MPSS)                                      0451    
      CALL PRINTM(NROWSS,FSS,KUM)                                       0452    
C                                                                       0453    
      IF(NCOLMS)9999,1500,1450                                          0454    
 1450 WRITE OUTPUT TAPE NWRTP,9320                                      0455    
      CALL PRINTK(NCOLMS,IDKMS,LPKMS)                                   0456    
      CALL PRINTN(NTRMMS,PMS,MPMS)                                      0457    
      WRITE OUTPUT TAPE NWRTP,9200                                      0458    
      WRITE OUTPUT TAPE NWRTP,9210,(J,NZMMS(J),J=1,NROWMS)              0459    
C                                                                       0460    
 1500 NRWDMS=(NTRMMS+3)/4                                               0461    
      NRWDSS=(NTRMSS+3)/4                                               0462    
C                                                                       0463    
C     WRITE TAPE RECORDS 1+4*J +K, K=1,2,3,4                            0464    
C     RECORD 1. IDENTIFICATION AND PARAMETERS                           0465    
C     RECORD 2. TRANSFORMATION MATRIX OF MLP INTERACTION VECTORS        0466    
C     RECORD 3. SLP ARRAYS                                              0467    
C     RECORD 4. TRANSFORMATION MATRIX OF MLP INTERACTION VECTORS        0468    
C     (REPEATED), PLUS SQUOZE ARRAY                                     0469    
C                                                                       0470    
      WRITETAPE NOUTTP,(STITLE(J),J=1,12),NLP,NTP,NTRMSS,NCOLSS,NROWSS, 0471    
     1NSQUOZ,NUK,NTRMMS,NCOLMS,NROWMS,MSIGMA,NRWDSS,NRWDMS              0472    
C                                                                       0473    
C     TRANSFORMATION MATRIX OF MLP INTERACTION VECTORS                  0474    
      NKMSP1=NCOLMS+1                                                   0475    
      WRITETAPE NOUTTP,(LPKMS(K),K=1,NKMSP1),(PMS(J),J=1,NTRMMS),(MPMS(J0476    
     1),J=1,NRWDMS)                                                     0477    
C                                                                       0478    
C     SLP MATRICES, ETC.                                                0479    
      NKSSP1=NCOLSS+1                                                   0480    
      WRITETAPE NOUTTP,(IDKSS(K),K=1,NCOLSS),(LPKSS(K),K=1,NKSSP1),(PSS(0481    
     1J),J=1,NTRMSS),(MPSS(J),J=1,NRWDSS),(FSS(M),M=1,NROWSS)           0482    
C                                                                       0483    
C     TRANSFORMATION MATRIX AGAIN                                       0484    
      WRITETAPE NOUTTP,(LPKMS(K),K=1,NKMSP1),(PMS(J),J=1,NTRMMS),(MPMS(J0485    
     1),J=1,NRWDMS),(NZMMS(M),M=1,NROWMS)                               0486    
C                                                                       0487    
 2000 IF(NLP-NSUBLP)410,3000,9999                                       0488    
C                                                                       0489    
C     E. PROCESS TRANSPORTATION MATRICES, IF ANY                        0490    
C                                                                       0491    
 3000 NTP=0                                                             0492    
      IF(NTRANP)9999,5000,3010                                          0493    
C                                                                       0494    
C                                                                       0495    
C     LOOP FOR EACH TLP GOES THRU STATEMENT 4000                        0496    
 3010 NTP=NTP+1                                                         0497    
      NLP=NSUBLP+NTP                                                    0498    
      CALL DTRANS                                                       0499    
C                                                                       0500    
 4000 IF(NTP-NTRANP)3010,5000,9999                                      0501    
C                                                                       0502    
C                                                                       0503    
C     F. PROCESS FURTHER, AND THEN WRITE OUT, THE MASTER L.P.           0504    
C                                                                       0505    
C     SQUEEZE DOWN MM (USE SS STORAGE)                                  0506    
 5000 NTRMSS=0                                                          0507    
      NCOLSS=0                                                          0508    
      NROWSS=NROWMM                                                     0509    
      NLP=NSUBLP+NTRANP+1                                               0510    
      DO5080KMM=1,NCOLMM                                                0511    
      IF(LPKMM(KMM))5080,9999,5020                                      0512    
 5020 NCOLSS=NCOLSS+1                                                   0513    
      IDKSS(NCOLSS)=IDKMM(KMM)                                          0514    
      LPKSS(NCOLSS)=NTRMSS+1                                            0515    
      MMLOW=XABSF(LPKMM(KMM))                                           0516    
      MMHIGH=XABSF(LPKMM(KMM+1))-1                                      0517    
      DO5050J=MMLOW,MMHIGH                                              0518    
      NTRMSS=NTRMSS+1                                                   0519    
      PSS(NTRMSS)=PMM(J)                                                0520    
      CALL FETCHM(MPMM(1),J,MMM)                                        0521    
      CALL STOREM(MPSS(1),NTRMSS,MMM)                                   0522    
 5050 CONTINUE                                                          0523    
 5080 CONTINUE                                                          0524    
      LPKSS(NCOLSS+1)=NTRMSS+1                                          0525    
C                                                                       0526    
C     ASCERTAIN NUMBER OF UNIT VECTORS WHICH MIGHT BE USED IN INIT BASIS0527    
      JESUS=1                                                           0528    
      GOTO1180                                                          0529    
C                                                                       0530    
C     PRINT MLP PARAMETERS, MATRICES                                    0531    
 5400 PRINT 9020,MTITLE                                                 0532    
      WRITE OUTPUT TAPE NWRTP,9020,MTITLE                               0533    
      PRINT9340,NTRMSS,NCOLSS,NROWSS,NUK                                0534    
      WRITE OUTPUT TAPE NWRTP,9340,NTRMSS,NCOLSS,NROWSS,NUK             0535    
      CALL PRINTK(NCOLSS,IDKSS,LPKSS)                                   0536    
      CALL PRINTN(NTRMSS,PSS,MPSS)                                      0537    
      CALL PRINTM(NROWSS,FMM,KUM)                                       0538    
C                                                                       0539    
      NRWDMM=(NTRMSS+3)/4                                               0540    
C                                                                       0541    
C     WRITE TAPE RECORDS 1+4*NSUBLP +K, K=1,2                           0542    
C     RECORD 1. IDENTIFICATION AND PARAMETERS                           0543    
C     RECORD 2. MLP ARRAYS                                              0544    
C                                                                       0545    
      WRITETAPE NOUTTP,(MTITLE(J),J=1,12),NLP,NTP,NTRMSS,NCOLSS,NROWSS  0546    
     1 ,NRWDMM                                                          0547    
C                                                                       0548    
      NKSSP1=NCOLSS+1                                                   0549    
      WRITETAPE NOUTTP,(IDKSS(K),K=1,NCOLSS),(LPKSS(K),K=1,NKSSP1),(PSS(0550    
     1J),J=1,NTRMSS),(MPSS(J),J=1,NRWDMM),(FMM(M),M=1,NROWSS)           0551    
C     G. CLEANUP                                                        0552    
C     ENDFILE AND REWIND THE OUTPUT TAPE                                0553    
C                                                                       0554    
      ENDFILE NOUTTP                                                    0555    
      REWIND NOUTTP                                                     0556    
      CALL EXIT                                                         0557    
C                                                                       0558    
 9000 FORMAT(120H1DATA ASSEMBLY SECTION OF DECOMPOSITION L.P. PROBLEM. J0559    
     1OB 188401400 ART FRIEDENHEIT                                     )0560    
 9010 FORMAT(12A6)                                                      0561    
 9020 FORMAT(1H112A6)                                                   0562    
 9025 FORMAT(1H012A6)                                                   0563    
 9030 FORMAT(15H               5I5)                                     0564    
 9040 FORMAT(30H0 L.P. PARAMETERS   SUM ROW IS I3,21H   FUNCTIONAL ROW I0565    
     1S I3,28H   NUMBER OF FUNCTIONALS IS I3)                           0566    
 9042 FORMAT(24H0NUMBER OF SUB L.P.S IS I5,31H     NUMBER OF TRANS. L.P.0567    
     1S IS I5)                                                          0568    
 9060 FORMAT(A6,A6,3X,I3,F12.7)                                         0569    
 9080 FORMAT(30H0MASTER L.P. READ IN.    NTRM=I4,10H     NCOL=I3,       0570    
     110H     NROW=I3,10H    NCARD=I4)                                  0571    
 9090 FORMAT(40H0DISCREPANCY BETWEEN PARAMETER CARDS       )            0572    
 9110 FORMAT(8H0VECTOR A6,17H IS A DUPLICATED A6 )                      0573    
 9200 FORMAT(50H0ROW / NUMBER OF ENTRIES ON THIS ROW IN MS MATRIX      )0574    
 9210 FORMAT(15(2H  I2,1H/I3))                                          0575    
 9300 FORMAT(120H0    NLP    NTP   NTRM   NCOL   NROW  NSQUOZ   NUK NTRM0576    
     1MS NCOLMS NROWMS  NCARD MSIGMA                                   )0577    
 9310 FORMAT(1H 12I7)                                                   0578    
 9320 FORMAT(40H0INTERACTION MATRIX MS FROM MASTER L.P.  )              0579    
 9330 FORMAT(40H0SUB L.P. WITH INTERACTION VECTORS LAST   )             0580    
 9340 FORMAT(19H0MASTER L.P.  NTRM=I4,7H  NCOL=I4,7H  NROW=I3,6H  NUK=I30581    
     1,50H    INTERACTION VECTORS NOT INCLUDED                         )0582    
 9400 FORMAT(25I2,2I2)                                                  0583    
 9410 FORMAT(45H0THE INPUT TAPE UNIT SPECIFIED FOR SUBSYSTEM  I3,13H IS 0584    
     1GIVEN AS I2)                                                      0585    
 9420 FORMAT(22H0INPUT TAPE UNITS ARE  50I3)                            0586    
 9430 FORMAT(22H0MATRIX CARD MISSING   )                                0587    
 9440 FORMAT(19H0EOF CARD MISSING   )                                   0588    
 9500 FORMAT(55HLOAD TAPE UNITS WHERE NECESSARY. START TO CONTINUE.    )0589    
 9990 FORMAT(14H0MACHINE ERROR)                                         0590    
C                                                                       0591    
 9999 PRINT9990                                                         0592    
      WRITE OUTPUT TAPE NWRTP,9990                                      0593    
      CALL EXIT                                                         0594    
      STOP                                                              0595    
C                                                                       0596    
       END                                                              0597    
*     LIST                                                              0598    
*     LABEL                                                             0599    
      SUBROUTINE DTRANS                                                 0600    
C       JOB 188401400 DECOMPOSITION PROGRAM  ART FRIEDENHEIT            0601    
C                                                                       0602    
C                                                                       0603    
      COMMON                                                            0604    
     1 IDKMM, LPKMM, PMM, MPMM, FMM,                                    0605    
     2 IDKMS, LPKMS, PMS, MPMS,                                         0606    
     3 IDKSS, LPKSS, PSS, MPSS, FSS,                                    0607    
     4 IDKSM, LPKSM, PSM, MPSM,                                         0608    
     5 KUM, NZMMS, MTITLE, STITLE,                                      0609    
     6 SYSTLE, NINPTP                                                   0610    
      COMMON                                                            0611    
     1 NRDTP, NWRTP, NOUTTP, NINTP,                                     0612    
     2 MTRMMM, MTRMMS, MTRMSS, MTRMSM,                                  0613    
     3 MCOLMM, MCOLMS, MCOLSS, MCOLSM,                                  0614    
     4 MROWMM, MROWMS, MROWSS, MROWSM,                                  0615    
     5 JMATRI, JFIRST, JEOF, JMM, JMS, JSS, JSM, JRHS,                  0616    
     6 NTRMMM, NCOLMM, NROWMM,                                          0617    
     7 LTRMMM, LCOLMM, LROWMM,                                          0618    
     8 NSUBLP, NTRANP, NCARD, MSUMMM, NLP, NTP,                         0619    
     9 NAME, MROW, VALUE                                                0620    
      DIMENSION                                                         0621    
     1   IDKMM(500),   LPKMM(501),   PMM(3600),   MPMM(900),    FMM(90),0622    
     2   IDKMS(500),   LPKMS(501),   PMS(3600),   MPMS(900),            0623    
     3   IDKSS(500),   LPKSS(501),   PSS(3600),   MPSS(900),    FSS(90),0624    
     4   IDKSM(500),   LPKSM(501),   PSM(3600),   MPSM(900),            0625    
     5 KUM(90),  NZMMS(90),  MTITLE(12),  STITLE(12)                    0626    
     6 ,SYSTLE(12),  NINPTP(50)                                         0627    
C                                                                       0628    
C      THE FOLLOWING ARE FOR SUBR. DTRANS ONLY                          0629    
      DIMENSION                                                         0630    
     1 IDKSUP(166),LPKSUP(166),SUPPLY(166),LOFSUP(166),NZTSUP(166),     0631    
     2 DEMAND(4500), TRCIJ(11092)                     ,NCSSUP(166)      0632    
      EQUIVALENCE                                                       0633    
     1 (IDKMM,EQV1), (LPKMM,EQV2), (PMM,EQV3), (MPMM,EQV4), (FMM,EQV5), 0634    
     2 (IDKMS,IDKSUP), (IDKMS(167),SUPPLY), (IDKMS(333),NZTSUP),        0635    
     3 (LPKMS,LPKSUP), (LPKMS(167),LOFSUP), (LPKMS(333),NCSSUP),        0636    
     4 (PMS,DEMAND), (MPMS,DEMAND(3601)),                               0637    
     5 (IDKSS,TRCIJ(1)), (LPKSS,TRCIJ(501)), (PSS,TRCIJ(1002)),         0638    
     6 (MPSS,TRCIJ(4602)), (FSS,TRCIJ(5502)), (IDKSM,TRCIJ(5592)),      0639    
     7 (LPKSM,TRCIJ(6092)), (PSM,TRCIJ(6593)), (MPSM,TRCIJ(10193))      0640    
C                                                                       0641    
C     SET UP MISCELLANEOUS PARAMETERS                                   0642    
      MSIGMA=NROWMM+NSUBLP+NTP                                          0643    
      CALL SETHOL(JBLANK,6H      )                                      0644    
      CALL SETHOL(JENDTR,6H*     )                                      0645    
      CALL SETHOL(JDUMMY,6H*DUMMY)                                      0646    
      SUMDEM=0.0                                                        0647    
      SUMSUP=0.0                                                        0648    
      COST=0.0                                                          0649    
      MXTSUP=165                                                        0650    
      MXTDES=4500                                                       0651    
      MXTCIJ=11092                                                      0652    
C     FETCH TLP INPUT UNIT DESIGNATION                                  0653    
      N=1+NSUBLP+NTP                                                    0654    
      NINTP=NINPTP(N)                                                   0655    
C     READ AND PRINT TRANP. L.P. TITLE CARD                             0656    
      READ INPUT TAPE NINTP,9010,STITLE                                 0657    
      PRINT 9020,STITLE                                                 0658    
      WRITE OUTPUT TAPE NWRTP,9020,STITLE                               0659    
C     READ AND PRINT TRANP. L.P. PARAMETER CARD                         0660    
      READ INPUT TAPE NINTP,9030                                        0661    
      PRINT 9040                                                        0662    
      WRITE OUTPUT TAPE NWRTP,9040                                      0663    
C                                                                       0664    
C     READ IN BCD NAMES OF SOURCE (SUPPLY) VECTORS, ONE PER CARD.       0665    
C     COLS. 16-20 MUST CONTAIN INDEX (SUPPLY NUMBER) OF NAME,           0666    
C      AND IS SEQUENCE-CHECKED.                                         0667    
C     COLS. 25-30 CONTAIN SIX-CHARACTER NAME.                           0668    
C     THERE MUST BE AN EXTRA CARD (TERMINATION CARD),                   0669    
C     WITH AN * IN COL. 10, AT THE END.                                 0670    
C                                                                       0671    
      MAX=MXTSUP+1                                                      0672    
      DO100JA=1,MAX                                                     0673    
      READ INPUT TAPE NINTP,9300,JCOL10,INDEX,NAME                      0674    
      IF(JENDTR-JCOL10)60,110,60                                        0675    
   60 IF(JA-INDEX)64,70,64                                              0676    
   64 CALL TRINER(2)                                                    0677    
C     CHECK WHETHER ANY NAME IS BLANK OR A DUPLICATE                    0678    
   70 IF(JBLANK-NAME)80,74,80                                           0679    
   74 CALL TRINER(3)                                                    0680    
   80 IF(JA-1)9999,100,84                                               0681    
   84 DO90JB=2,JA                                                       0682    
      IF(IDKSUP(JB-1)-NAME)90,86,90                                     0683    
   86 CALL TRINER(4)                                                    0684    
   90 CONTINUE                                                          0685    
  100 IDKSUP(JA)=NAME                                                   0686    
      CALL TRINER(5)                                                    0687    
  110 NTRSUP=JA-1                                                       0688    
      NTSUP1=JA                                                         0689    
C     READ IN DEMAND DATA, ONE PER CARD.                                0690    
C     COLS. 16-20 MUST CONTAIN INDEX (DEMAND NUMBER),                   0691    
C      AND IS SEQUENCE-CHECKED.                                         0692    
C     COLS. 25-30 CONTAIN DEMAND VALUE,                                 0693    
C      A POSITIVE INTEGER LESS THAN 2 EXP 17.                           0694    
C     THERE MUST BE AN EXTRA CARD (TERMINATION CARD),                   0695    
C     WITH AN * IN COL. 10, AT THE END.                                 0696    
C                                                                       0697    
      MAX=MXTDES+1                                                      0698    
      DO200JC=1,MAX                                                     0699    
      READ INPUT TAPE NINTP,9320,JCOL10,INDEX,JDEMND                    0700    
      IF(JENDTR-JCOL10)160,210,160                                      0701    
  160 IF(JC-INDEX)164,170,164                                           0702    
  164 CALLTRINER(6)                                                     0703    
C     CHECK WHETHER ANY DEMAND IS NEGATIVE OR ZERO.                     0704    
  170 IF(JDEMND)174,174,180                                             0705    
  174 CALLTRINER(7)                                                     0706    
  180 CALL PACKTR(DEMAND(JC),JDEMND,0)                                  0707    
      SUMDEM=SUMDEM+FLOATF(JDEMND)                                      0708    
  200 CONTINUE                                                          0709    
      CALL TRINER(8)                                                    0710    
  210 NTRDES=JC-1                                                       0711    
C     READ IN COST DATA, ONE PER CARD.                                  0712    
C     COLS. 11-15 CONTAIN INDEX (SUPPLY NUMBER) OF SOURCE.              0713    
C     COLS. 16-20 CONTAIN INDEX (DEMAND NUMBER) OF DESTINATION.         0714    
C     COLS. 25-30 CONTAIN COST VALUE, A POSITIVE INTEGER                0715    
C     LESS THAN 2 EXP 17.                                               0716    
C     INDEXES ARE SEQUENCE-CHECKED.                                     0717    
C     THERE MUST BE AN EXTRA CARD (TERMINATION CARD),                   0718    
C     WITH AN * IN COL. 10, AT THE END.                                 0719    
C                                                                       0720    
C      TRCIJ   LEFT HALF   COST VALUE                                   0721    
C              RIGHT HALF  SUBSCRIPT OF CORRESPONDING DEMAND            0722    
C      DEMAND  LEFT HALF   DEMAND VALUE                                 0723    
C              RIGHT HALF  SUBSCRIPT OF CORRESPONDING ZERO TERM         0724    
C                          (DURING DATASS DTRANS MIN. DEMAND TERM TEMP.)0725    
C                                                                       0726    
      NLASTS=0                                                          0727    
      NLASTD=0                                                          0728    
      MAX=MXTCIJ+1                                                      0729    
      DO400JE=1,MAX                                                     0730    
      READ INPUT TAPE NINTP,9340,JCOL10,NUMSUP,NUMDEM,IJTERM            0731    
      IF(JCOL10-JENDTR)260,410,260                                      0732    
  260 IF(NUMSUP-NLASTS)270,330,280                                      0733    
  270 CALLTRINER(9)                                                     0734    
C     NEW SOURCE- INDEX SHOULD BE LAST SOURCE INDEX PLUS ONE            0735    
  280 IF(NUMSUP-NLASTS-1)290,300,290                                    0736    
  290 CALLTRINER(10)                                                    0737    
  300 IF(NUMSUP-NTRSUP)320,320,310                                      0738    
  310 CALLTRINER(11)                                                    0739    
C                                                                       0740    
  320 LPKSUP(NUMSUP)=JE                                                 0741    
      GOTO350                                                           0742    
  330 IF(NUMDEM-NLASTD)340,340,350                                      0743    
  340 CALLTRINER(12)                                                    0744    
  350 IF(NUMDEM-NTRDES)370,370,360                                      0745    
  360 CALLTRINER(13)                                                    0746    
  370 CALL PACKTR(TRCIJ(JE),IJTERM,NUMDEM)                              0747    
      NLASTS=NUMSUP                                                     0748    
      NLASTD=NUMDEM                                                     0749    
C     STORE MINIMUM COST TERM FOR THIS DEMAND IN RIGHT HALF OF WORD.    0750    
      CALLUNPKTR(DEMAND(NUMDEM),JDEMND,MINDIJ)                          0751    
      IF(MINDIJ)9999,390,380                                            0752    
  380 IF(IJTERM-MINDIJ)390,400,400                                      0753    
  390 CALLPACKTR(DEMAND(NUMDEM),JDEMND,IJTERM)                          0754    
  400 CONTINUE                                                          0755    
      CALL TRINER(14)                                                   0756    
  410 NTRCIJ=JE-1                                                       0757    
      LPKSUP(NTSUP1)=JE                                                 0758    
C                                                                       0759    
C                                                                       0760    
      DO440K=1,NTRSUP                                                   0761    
      LOFSUP(K)=LPKSUP(K)                                               0762    
      SUPPLY(K)=0.0                                                     0763    
      NCSSUP(K)=0                                                       0764    
  440 NZTSUP(K)=0                                                       0765    
      LOFSUP(K)=LPKSUP(K)                                               0766    
      NZCIJ=0                                                           0767    
      NNZCIJ=0                                                          0768    
C                                                                       0769    
C     MAKE FIRST PASS THRU ALL COST TERMS, ONE DESTINATION AT A TIME    0770    
C     (SUPPLY VECTOR ORDER WITHIN DESTINATION ROW ORDER),               0771    
C     SUBTRACTING THE MINIMUM COST TERM FOR EACH DESTINATION            0772    
C     FROM ALL COST TERMS FOR THE SAME DESTINATION                      0773    
C                                                                       0774    
      DO800M=1,NTRDES                                                   0775    
      NDXCIJ=0                                                          0776    
      NMINS=0                                                           0777    
      CALL UNPKTR(DEMAND(M),JDVAL,MINDIJ)                               0778    
C                                                                       0779    
  500 DO700K=1,NTRSUP                                                   0780    
      L=LOFSUP(K)                                                       0781    
      IF(L-LPKSUP(K+1))540,700,520                                      0782    
  520 CALL TRINER(16)                                                   0783    
  540 CALL UNPKTR(TRCIJ(L),JCVAL,JDSUB)                                 0784    
      IF(JDSUB-M)560,580,700                                            0785    
  560 CALL TRINER(17)                                                   0786    
C     COST MATRIX ELEMENT ENCOUNTERED FROM SOURCE K                     0787    
C     FOR DESTINATION M.                                                0788    
  580 LOFSUP(K)=L+1                                                     0789    
      NDXCIJ=NDXCIJ+1                                                   0790    
      JCNEW=JCVAL-MINDIJ                                                0791    
      IF(JCNEW)600,640,620                                              0792    
  600 CALL TRINER(18)                                                   0793    
  620 CALL PACKTR(TRCIJ(L),JCNEW,JDSUB)                                 0794    
      NNZCIJ=NNZCIJ+1                                                   0795    
      NCSSUP(K)=NCSSUP(K)+1                                             0796    
      GOTO700                                                           0797    
C                                                                       0798    
  640 IF(NMINS)600,660,620                                              0799    
C     CLEAR WHOLE WORD CORRESPONDING TO ZERO DEMAND TERM                0800    
  660 NMINS=1                                                           0801    
      TRCIJ(L)=0                                                        0802    
      MINCOL=K                                                          0803    
      NZCIJ=NZCIJ+1                                                     0804    
      NZTSUP(K)=NZTSUP(K)+1                                             0805    
      COST=COST+FLOATF(JDVAL*JCVAL)                                     0806    
  700 CONTINUE                                                          0807    
C                                                                       0808    
C     ZERO TERM. PACK SUBSCRIPT OF ZERO TERM SOURCE                     0809    
C     IN LOWER HALF OF CORRESPONDING DEMAND WORD.                       0810    
      IF(NMINS)720,720,740                                              0811    
  720 CALL TRINER(19)                                                   0812    
  740 CALL PACKTR(DEMAND(M),JDVAL,MINCOL)                               0813    
C     ELIMINATE DESTINATION (IF NDXCIJ=1)                               0814    
C     SUPPLY(MINCOL)=SUPPLY(MINCOL)+FLOATF(JDVAL)                       0815    
C     SUMSUP=SUMSUP+FLOATF(JDVAL)                                       0816    
C     REPACK, ETCETERA                                                  0817    
C                                                                       0818    
  800 CONTINUE                                                          0819    
C                                                                       0820    
C     MAKE SECOND PASS THRU ALL COST TERMS                              0821    
C     CLOSE UP TRCIJ ARRAY, ELIMINATING ZERO TERMS                      0822    
      NSMDEL=0                                                          0823    
      DO1000K=1,NTRSUP                                                  0824    
      KL=LPKSUP(K)                                                      0825    
      KH=LPKSUP(K+1)-1                                                  0826    
      NDELTA=0                                                          0827    
C     PROCESS SOURCE BY SOURCE                                          0828    
      DO900J=KL,KH                                                      0829    
      IF(TRCIJ(J))820,840,880                                           0830    
  820 CALL TRINER(20)                                                   0831    
  840 NDELTA=NDELTA+1                                                   0832    
      GOTO900                                                           0833    
C     REGULAR TERM- RELOCATE.                                           0834    
  880 N=J-NSMDEL-NDELTA                                                 0835    
      TRCIJ(N)=TRCIJ(J)                                                 0836    
  900 CONTINUE                                                          0837    
C                                                                       0838    
C     CHECK. IF O.K., ADJUST LPKSUP ARRAY.                              0839    
      IF(NDELTA-NZTSUP(K))920,940,920                                   0840    
  920 CALL TRINER(21)                                                   0841    
  940 LPKSUP(K)=LPKSUP(K)-NSMDEL                                        0842    
      NSMDEL=NSMDEL+NDELTA                                              0843    
 1000 CONTINUE                                                          0844    
C                                                                       0845    
C     CHECK. IF O.K., ADJUST EXTRA LPKSUP TERM.                         0846    
      IF(NZCIJ-NSMDEL)1020,1040,1020                                    0847    
 1020 CALL TRINER(22)                                                   0848    
 1040 LPKSUP(NTSUP1)=LPKSUP(NTSUP1)-NSMDEL                              0849    
C     NZCIJ=NSMDEL=NTRDES                                               0850    
      NTROUT=NTRCIJ-NSMDEL                                              0851    
C                                                                       0852    
C     PRINT TLP PARAMETERS, ARRAYS                                      0853    
 1100 WRITE OUTPUT TAPE NWRTP,9400,NTP,NTRSUP,NTRDES,NTRCIJ,COST,NTROUT,0854    
     1SUMDEM                                                            0855    
      PRINT                   9400,NTP,NTRSUP,NTRDES,NTRCIJ,COST,NTROUT,0856    
     1SUMDEM                                                            0857    
      WRITE OUTPUT TAPE NWRTP,9420                                      0858    
      WRITE OUTPUT TAPE NWRTP,9430,((K,IDKSUP(K),LPKSUP(K),SUPPLY(K),   0859    
     1 NZTSUP(K),NCSSUP(K)),K=1,NTRSUP)                                 0860    
      WRITE OUTPUT TAPE NWRTP,9430,NTSUP1,JDUMMY,LPKSUP(NTSUP1),        0861    
     1 SUMSUP,NZCIJ,NNZCIJ                                              0862    
C                                                                       0863    
      WRITE OUTPUT TAPE NWRTP,9440                                      0864    
      CALL PRTRPK(DEMAND,NTRDES,NWRTP)                                  0865    
C                                                                       0866    
      WRITE OUTPUT TAPE NWRTP,9460                                      0867    
      CALL PRTRPK(TRCIJ,NTROUT,NWRTP)                                   0868    
C                                                                       0869    
C     WRITE FIRST TWO OF THREE TAPE RECORDS FOR TLP                     0870    
C     RECORD 1. IDENTIFICATION AND PARAMETERS                           0871    
C     RECORD 2. TLP ARRAYS                                              0872    
C     RECORD 3. TRANSFORMATION MATRIX OF MLP INTERACTION VECTORS        0873    
C                                                                       0874    
 1200 WRITE TAPE NOUTTP,(STITLE(J),J=1,12),NLP,NTP,NTRSUP,NTRDES,NTROUT,0875    
     1COST,MSIGMA                                                       0876    
C                                                                       0877    
      WRITE TAPE NOUTTP,(IDKSUP(K),K=1,NTRSUP),(LPKSUP(K),K=1,NTSUP1),(S0878    
     1UPPLY(K),K=1,NTRSUP),(DEMAND(J),J=1,NTRDES),(TRCIJ(J),J=1,NTROUT) 0879    
C                                                                       0880    
C     SET INITIAL MS VALUES                                             0881    
      NTRMMS=0                                                          0882    
      NCOLMS=0                                                          0883    
      NROWMS=0                                                          0884    
      LTRMMS=0                                                          0885    
      LCOLMS=0                                                          0886    
      LROWMS=0                                                          0887    
C                                                                       0888    
      DO1300M=1,MROWMS                                                  0889    
 1300 NZMMS(M)=0                                                        0890    
C     SEARCH FOR THE INTERACTION VECTORS AMONG THE MM                   0891    
      DO1500KTR=1,NTRSUP                                                0892    
      NAME=IDKSUP(KTR)                                                  0893    
      DO1360KMM=1,NCOLMM                                                0894    
      IF(NAME-IDKMM(KMM))1360,1320,1360                                 0895    
 1320 IF(LPKMM(KMM))1340,9999,1400                                      0896    
 1340 PRINT9500,NAME,JSM                                                0897    
      WRITE OUTPUT TAPE NWRTP,9500,NAME,JMS                             0898    
      GOTO1400                                                          0899    
 1360 CONTINUE                                                          0900    
      PRINT9510,NAME                                                    0901    
      WRITE OUTPUT TAPE NWRTP,9510,NAME                                 0902    
      GOTO1500                                                          0903    
C                                                                       0904    
C     EXTRACT MS VECTOR FROM MM                                         0905    
 1400 CALL STEP(NCOLMS,MCOLMS,LCOLMS,6HMSCOLS)                          0906    
      IDKMS(NCOLMS)=IDKMM(KMM)                                          0907    
      LPKMS(NCOLMS)=NTRMMS+1                                            0908    
      MMLOW=XABSF(LPKMM(KMM))                                           0909    
      MMHIGH=XABSF(LPKMM(KMM+1))-1                                      0910    
      DO1420J=MMLOW,MMHIGH                                              0911    
      CALL STEP(NTRMMS,MTRMMS,LTRMMS,6HMSTRMS)                          0912    
      PMS(NTRMMS)=PMM(J)                                                0913    
      CALL FETCHM(MPMM(1),J,MMS)                                        0914    
      CALL STOREM(MPMS(1),NTRMMS,MMS)                                   0915    
      NROWMS=XMAX0F(NROWMS,MMS)                                         0916    
C     KEEP TRACK OF ROWS WITH NON-ZERO ENTRIES, FOR NSQUOZ COUNT.       0917    
 1420 NZMMS(MMS)=NZMMS(MMS)+1                                           0918    
C     FLAG MM VECTOR TO INDICATE IT HAS ALSO BEEN AN MS VECTOR          0919    
      LPKMM(KMM)=-XABSF(LPKMM(KMM))                                     0920    
 1500 CONTINUE                                                          0921    
      LPKMS(NCOLMS+1)=NTRMMS+1                                          0922    
C                                                                       0923    
C     COMPUTE NUMBER OF PACKED SQUOZED ENTRIES IN SOLUTION VECTOR       0924    
C     (NUMBER OF DIFFERENT MS VECTOR ROWS WITH ENTRIES PLUS 1)          0925    
C     MAKE CERTAIN ALL FUNCTIONAL ROWS CAN BE REPRESENTED               0926    
C     PUT MFUNMM IN COMMON LATER                                        0927    
      MFUNMM=MSUMMM-1                                                   0928    
      DO1540J=2,MFUNMM                                                  0929    
      IF(NZMMS(J))9999,1520,1540                                        0930    
 1520 NZMMS(J)=999                                                      0931    
 1540 CONTINUE                                                          0932    
      NSQUOZ=1                                                          0933    
      DO1580J=1,NROWMS                                                  0934    
      IF(NZMMS(J))9999,1580,1560                                        0935    
 1560 NSQUOZ=NSQUOZ+1                                                   0936    
 1580 CONTINUE                                                          0937    
C                                                                       0938    
C                                                                       0939    
 1600 IF(NCOLMS)9999,1700,1650                                          0940    
 1650 WRITE OUTPUT TAPE NWRTP,9520                                      0941    
      CALL PRINTK(NCOLMS,IDKMS,LPKMS)                                   0942    
      CALL PRINTN(NTRMMS,PMS,MPMS)                                      0943    
      WRITE OUTPUT TAPE NWRTP,9530                                      0944    
      WRITE OUTPUT TAPE NWRTP,9540,(J,NZMMS(J),J=1,NROWMS)              0945    
C                                                                       0946    
C     WRITE THIRD OF THREE TAPE RECORDS FOR TLP                         0947    
 1700 NRWDMS=(NTRMMS+3)/4                                               0948    
      WRITE TAPE NOUTTP, NTRMMS,NCOLMS,NROWMS,NRWDMS,NSQUOZ,            0949    
     1 (LPKMS(K),K=1,NTSUP1), (PMS(J),J=1,NTRMMS),                      0950    
     2 (MPMS(J),J=1,NRWDMS), (NZMMS(M),M=1,NROWMS)                      0951    
C                                                                       0952    
      WRITE OUTPUT TAPE NWRTP,9560,NTRMMS,NCOLMS,NROWMS,NRWDMS,NSQUOZ   0953    
     1 ,MSIGMA                                                          0954    
      PRINT 9560, NTRMMS,NCOLMS,NROWMS,NRWDMS,NSQUOZ,MSIGMA             0955    
C                                                                       0956    
      RETURN                                                            0957    
C                                                                       0958    
C                                                                       0959    
 9010 FORMAT(12A6)                                                      0960    
 9020 FORMAT(1H112A6)                                                   0961    
 9030 FORMAT(1H )                                                       0962    
 9040 FORMAT(1H )                                                       0963    
 9300 FORMAT(9X,A1,5X,I5,4X,A6)                                         0964    
 9320 FORMAT(9X,A1,5X,I5,4X,I6)                                         0965    
 9340 FORMAT(9X,A1,I5,I5,4X,I6)                                         0966    
 9400 FORMAT(5H0NTP=I2,10H   NTRSUP=I3,10H   NTRDES=I4,10H   NTRCIJ=I5,80967    
     1H   COST=F14.1,10H   NTROUT=I4,10H   SUMDEM=F14.1)                0968    
 9420 FORMAT(120H0 K  IDKSUP  LPKSUP  SUPPLY  NZTSUP  NNZCIJ            0969    
     1                                                                 )0970    
 9430 FORMAT(1H I2,2X,A6,2X,I6,2X,F6.0,2X,I6,2X,I6)                     0971    
 9440 FORMAT(120H0    K  DEMAND(K+0)  DEMAND(K+1)  DEMAND(K+2)  DEMAND(K0972    
     1+3)  DEMAND(K+4)  DEMAND(K+5)  DEMAND(K+6)  DEMAND(K+7)          )0973    
 9460 FORMAT(120H0    K   TRCIJ(K+0)   TRCIJ(K+1)   TRCIJ(K+2)   TRCIJ(K0974    
     1+3)   TRCIJ(K+4)   TRCIJ(K+5)   TRCIJ(K+6)   TRCIJ(K+7)          )0975    
 9500 FORMAT(8H0VECTOR A6,17H IS A DUPLICATED A6)                       0976    
 9510 FORMAT(8H0SOURCE A6,39H DOES NOT APPEAR IN THE MASTER PROGRAM   ) 0977    
 9520 FORMAT(40H0INTERACTION MATRIX MS FROM MASTER L.P.   )             0978    
 9530 FORMAT(51H0ROW / NUMBER OF ENTRIES ON THIS ROW IN MS MATRIX   )   0979    
 9540 FORMAT(15(2H  I2,1H/I3))                                          0980    
 9560 FORMAT(   10H0  NTRMMS=I4,10H   NCOLMS=I3,10H   NROWMS=I2,        0981    
     1 10H   NRWDMS=I4,10H   NSQUOZ=I2,10H   MSIGMA=I2)                 0982    
C                                                                       0983    
 9999 CALL TRINER(99)                                                   0984    
      STOP                                                              0985    
C                                                                       0986    
       END                                                              0987    
*     LIST                                                              0988    
*     LABEL                                                             0989    
      SUBROUTINE PRINTK(NCOLPR,IDKPR,LPKPR)                             0990    
C       JOB 188401400 DECOMPOSITION PROGRAM  ART FRIEDENHEIT            0991    
      DIMENSION IDKPR(500),LPKPR(501)                                   0992    
C                                                                       0993    
      COMMON                                                            0994    
     1 IDKMM, LPKMM, PMM, MPMM, FMM,                                    0995    
     2 IDKMS, LPKMS, PMS, MPMS,                                         0996    
     3 IDKSS, LPKSS, PSS, MPSS, FSS,                                    0997    
     4 IDKSM, LPKSM, PSM, MPSM,                                         0998    
     5 KUM, NZMMS, MTITLE, STITLE,                                      0999    
     6 SYSTLE, NINPTP                                                   1000    
      COMMON                                                            1001    
     1 NRDTP, NWRTP, NOUTTP, NINTP,                                     1002    
     2 MTRMMM, MTRMMS, MTRMSS, MTRMSM,                                  1003    
     3 MCOLMM, MCOLMS, MCOLSS, MCOLSM,                                  1004    
     4 MROWMM, MROWMS, MROWSS, MROWSM,                                  1005    
     5 JMATRI, JFIRST, JEOF, JMM, JMS, JSS, JSM, JRHS,                  1006    
     6 NTRMMM, NCOLMM, NROWMM,                                          1007    
     7 LTRMMM, LCOLMM, LROWMM,                                          1008    
     8 NSUBLP, NTRANP, NCARD, MSUMMM, NLP, NTP,                         1009    
     9 NAME, MROW, VALUE                                                1010    
      DIMENSION                                                         1011    
     1   IDKMM(500),   LPKMM(501),   PMM(3600),   MPMM(900),    FMM(90),1012    
     2   IDKMS(500),   LPKMS(501),   PMS(3600),   MPMS(900),            1013    
     3   IDKSS(500),   LPKSS(501),   PSS(3600),   MPSS(900),    FSS(90),1014    
     4   IDKSM(500),   LPKSM(501),   PSM(3600),   MPSM(900),            1015    
     5 KUM(90),  NZMMS(90),  MTITLE(12),  STITLE(12)                    1016    
     6 ,SYSTLE(12),  NINPTP(50)                                         1017    
C                                                                       1018    
      IF(NCOLPR)200,200,50                                              1019    
   50 WRITE OUTPUT TAPE NWRTP,900                                       1020    
C                                                                       1021    
      DO100KPR=1,NCOLPR                                                 1022    
  100 WRITE OUTPUT TAPE NWRTP,920,KPR,IDKPR(KPR),LPKPR(KPR)             1023    
C                                                                       1024    
      CALL SETHOL(IDKUM,6H*DUMMY)                                       1025    
      WRITE OUTPUT TAPE NWRTP,920,KPR,IDKUM,LPKPR(NCOLPR+1)             1026    
C                                                                       1027    
  200 RETURN                                                            1028    
  900 FORMAT(22H0   COL   NAME   LPK   )                                1029    
  920 FORMAT(4H    I3,1H A6,1H I5)                                      1030    
       END                                                              1031    
*     LIST                                                              1032    
*     LABEL                                                             1033    
      SUBROUTINE PRINTM(NROWPR,FPR,KUMPR)                               1034    
C       JOB 188401400 DECOMPOSITION PROGRAM  ART FRIEDENHEIT            1035    
      DIMENSION FPR(90),KUMPR(90)                                       1036    
C                                                                       1037    
      COMMON                                                            1038    
     1 IDKMM, LPKMM, PMM, MPMM, FMM,                                    1039    
     2 IDKMS, LPKMS, PMS, MPMS,                                         1040    
     3 IDKSS, LPKSS, PSS, MPSS, FSS,                                    1041    
     4 IDKSM, LPKSM, PSM, MPSM,                                         1042    
     5 KUM, NZMMS, MTITLE, STITLE,                                      1043    
     6 SYSTLE, NINPTP                                                   1044    
      COMMON                                                            1045    
     1 NRDTP, NWRTP, NOUTTP, NINTP,                                     1046    
     2 MTRMMM, MTRMMS, MTRMSS, MTRMSM,                                  1047    
     3 MCOLMM, MCOLMS, MCOLSS, MCOLSM,                                  1048    
     4 MROWMM, MROWMS, MROWSS, MROWSM,                                  1049    
     5 JMATRI, JFIRST, JEOF, JMM, JMS, JSS, JSM, JRHS,                  1050    
     6 NTRMMM, NCOLMM, NROWMM,                                          1051    
     7 LTRMMM, LCOLMM, LROWMM,                                          1052    
     8 NSUBLP, NTRANP, NCARD, MSUMMM, NLP, NTP,                         1053    
     9 NAME, MROW, VALUE                                                1054    
      DIMENSION                                                         1055    
     1   IDKMM(500),   LPKMM(501),   PMM(3600),   MPMM(900),    FMM(90),1056    
     2   IDKMS(500),   LPKMS(501),   PMS(3600),   MPMS(900),            1057    
     3   IDKSS(500),   LPKSS(501),   PSS(3600),   MPSS(900),    FSS(90),1058    
     4   IDKSM(500),   LPKSM(501),   PSM(3600),   MPSM(900),            1059    
     5 KUM(90),  NZMMS(90),  MTITLE(12),  STITLE(12)                    1060    
     6 ,SYSTLE(12),  NINPTP(50)                                         1061    
C                                                                       1062    
      IF(NROWPR)200,200,50                                              1063    
   50 WRITE OUTPUT TAPE NWRTP,900                                       1064    
      WRITE OUTPUT TAPE NWRTP,920,((J,FPR(J),KUMPR(J)),J=1,NROWPR)      1065    
C                                                                       1066    
  200 RETURN                                                            1067    
  900 FORMAT(25H0ROW      R.H.S. KUM      )                             1068    
  920 FORMAT(1H I3,1H F12.5,1H I3)                                      1069    
       END                                                              1070    
*     LIST                                                              1071    
*     LABEL                                                             1072    
      SUBROUTINE PRINTN(NTRMPR,PPR,MPPR)                                1073    
C       JOB 188401400 DECOMPOSITION PROGRAM  ART FRIEDENHEIT            1074    
      DIMENSION PPR(3600),MPPR(900),MPROW(8)                            1075    
C                                                                       1076    
      COMMON                                                            1077    
     1 IDKMM, LPKMM, PMM, MPMM, FMM,                                    1078    
     2 IDKMS, LPKMS, PMS, MPMS,                                         1079    
     3 IDKSS, LPKSS, PSS, MPSS, FSS,                                    1080    
     4 IDKSM, LPKSM, PSM, MPSM,                                         1081    
     5 KUM, NZMMS, MTITLE, STITLE,                                      1082    
     6 SYSTLE, NINPTP                                                   1083    
      COMMON                                                            1084    
     1 NRDTP, NWRTP, NOUTTP, NINTP,                                     1085    
     2 MTRMMM, MTRMMS, MTRMSS, MTRMSM,                                  1086    
     3 MCOLMM, MCOLMS, MCOLSS, MCOLSM,                                  1087    
     4 MROWMM, MROWMS, MROWSS, MROWSM,                                  1088    
     5 JMATRI, JFIRST, JEOF, JMM, JMS, JSS, JSM, JRHS,                  1089    
     6 NTRMMM, NCOLMM, NROWMM,                                          1090    
     7 LTRMMM, LCOLMM, LROWMM,                                          1091    
     8 NSUBLP, NTRANP, NCARD, MSUMMM, NLP, NTP,                         1092    
     9 NAME, MROW, VALUE                                                1093    
      DIMENSION                                                         1094    
     1   IDKMM(500),   LPKMM(501),   PMM(3600),   MPMM(900),    FMM(90),1095    
     2   IDKMS(500),   LPKMS(501),   PMS(3600),   MPMS(900),            1096    
     3   IDKSS(500),   LPKSS(501),   PSS(3600),   MPSS(900),    FSS(90),1097    
     4   IDKSM(500),   LPKSM(501),   PSM(3600),   MPSM(900),            1098    
     5 KUM(90),  NZMMS(90),  MTITLE(12),  STITLE(12)                    1099    
     6 ,SYSTLE(12),  NINPTP(50)                                         1100    
C                                                                       1101    
C                                                                       1102    
C     PRINTS THE N TERMS OF ARRAY P, TOGETHER WITH THEIR ROW INDICES    1103    
C     PACKED IN MP FOUR TO A WORD                                       1104    
C                                                                       1105    
      IF(NTRMPR)200,200,50                                              1106    
   50 WRITE OUTPUT TAPE NWRTP,900                                       1107    
      DO100N=1,NTRMPR,8                                                 1108    
      NHIGH=N+7                                                         1109    
      DO80NR=1,8                                                        1110    
      J=N-1+NR                                                          1111    
      IF(J-NTRMPR)70,70,60                                              1112    
   60 MPROW(NR)=0                                                       1113    
      NHIGH=NTRMPR                                                      1114    
      GOTO80                                                            1115    
   70 CALL FETCHM(MPPR(1),J,MPROW(NR))                                  1116    
   80 CONTINUE                                                          1117    
  100 WRITE OUTPUT TAPE NWRTP,920,N,(MPROW(L),L=1,8),(PPR(K),K=N,NHIGH) 1118    
C                                                                       1119    
  200 RETURN                                                            1120    
  900 FORMAT(120H0   L   0  1  2  3   4  5  6  7         L+0        L+1 1121    
     1       L+2        L+3        L+4        L+5        L+6        L+7)1122    
  920 FORMAT(1H I4,1H 4I3,1H 4I3,1H 8F11.4)                             1123    
       END                                                              1124    
*     LIST                                                              1125    
*     LABEL                                                             1126    
      SUBROUTINE PRTRPK (A,N,NWRTP)                                     1127    
C       JOB 188401400 DECOMPOSITION PROGRAM  ART FRIEDENHEIT            1128    
      DIMENSION A(11092),AL(8),AR(8)                                    1129    
C     USED BY DTRANS                                                    1130    
C                                                                       1131    
      DO100J=1,N,8                                                      1132    
      K=XMIN0F(J+7,N)                                                   1133    
      DO50L=J,K                                                         1134    
      M=L-J+1                                                           1135    
   50 CALL UNPKTR(A(L),AL(M),AR(M))                                     1136    
  100 WRITE OUTPUT TAPE NWRTP,9450,J,((AL(I),AR(I)),I=1,M)              1137    
C                                                                       1138    
      RETURN                                                            1139    
 9450 FORMAT(1H I5,8(1X,I6,I6))                                         1140    
       END                                                              1141    
*     LIST                                                              1142    
*     LABEL                                                             1143    
      SUBROUTINE STEP(N,M,L,JTYPE)                                      1144    
C       JOB 188401400 DECOMPOSITION PROGRAM  ART FRIEDENHEIT            1145    
C                                                                       1146    
      COMMON                                                            1147    
     1 IDKMM, LPKMM, PMM, MPMM, FMM,                                    1148    
     2 IDKMS, LPKMS, PMS, MPMS,                                         1149    
     3 IDKSS, LPKSS, PSS, MPSS, FSS,                                    1150    
     4 IDKSM, LPKSM, PSM, MPSM,                                         1151    
     5 KUM, NZMMS, MTITLE, STITLE,                                      1152    
     6 SYSTLE, NINPTP                                                   1153    
      COMMON                                                            1154    
     1 NRDTP, NWRTP, NOUTTP, NINTP,                                     1155    
     2 MTRMMM, MTRMMS, MTRMSS, MTRMSM,                                  1156    
     3 MCOLMM, MCOLMS, MCOLSS, MCOLSM,                                  1157    
     4 MROWMM, MROWMS, MROWSS, MROWSM,                                  1158    
     5 JMATRI, JFIRST, JEOF, JMM, JMS, JSS, JSM, JRHS,                  1159    
     6 NTRMMM, NCOLMM, NROWMM,                                          1160    
     7 LTRMMM, LCOLMM, LROWMM,                                          1161    
     8 NSUBLP, NTRANP, NCARD, MSUMMM, NLP, NTP,                         1162    
     9 NAME, MROW, VALUE                                                1163    
      DIMENSION                                                         1164    
     1   IDKMM(500),   LPKMM(501),   PMM(3600),   MPMM(900),    FMM(90),1165    
     2   IDKMS(500),   LPKMS(501),   PMS(3600),   MPMS(900),            1166    
     3   IDKSS(500),   LPKSS(501),   PSS(3600),   MPSS(900),    FSS(90),1167    
     4   IDKSM(500),   LPKSM(501),   PSM(3600),   MPSM(900),            1168    
     5 KUM(90),  NZMMS(90),  MTITLE(12),  STITLE(12)                    1169    
     6 ,SYSTLE(12),  NINPTP(50)                                         1170    
C                                                                       1171    
      L=L+1                                                             1172    
      N=N+1                                                             1173    
      IF(N-M)200,200,100                                                1174    
  100 N=M                                                               1175    
      WRITE OUTPUT TAPE NWRTP,900,L,JTYPE,NAME,MROW,VALUE,NCARD         1176    
C                                                                       1177    
  200 RETURN                                                            1178    
  900 FORMAT(1H0I4,1H A6,17H EXCEED LIMITS.   A6,I3,F12.5,I4)           1179    
       END                                                              1180    
*     LIST                                                              1181    
*     LABEL                                                             1182    
      SUBROUTINE TRINER(J)                                              1183    
      PRINT 100,J                                                       1184    
      WRITE OUTPUT TAPE 3,100,J                                         1185    
      CALL DUMP                                                         1186    
