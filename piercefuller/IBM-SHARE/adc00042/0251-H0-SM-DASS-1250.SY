*     FAP                                                               1266    
*                                  SAPSUB SUBROUTINES                   1267    
       ENTRY   CMPLAS                                                   1268    
       ENTRY   CMPHOL                                                   1269    
       ENTRY   INTHOL                                                   1270    
       ENTRY   SETHOL                                                   1271    
       ENTRY   PUTHOL                                                   1272    
       ENTRY   REPHOL                                                   1273    
       ENTRY   STOREM                                                   1274    
       ENTRY   FETCHM                                                   1275    
       ENTRY   PACKTR                                                   1276    
       ENTRY   UNPKTR                                                   1277    
*                                  CALL CMPLAS(A,B,NTRA)                1278    
CMPLAS CAL*    1,4                                                      1279    
       LAS*    2,4                                                      1280    
       TRA     GR                                                       1281    
       TRA     EQ                                                       1282    
    LE CLA     ONE                                                      1283    
       TRA     END                                                      1284    
    EQ CLA     TWO                                                      1285    
       TRA     END                                                      1286    
    GR CLA     THREE                                                    1287    
   END STO*    3,4                                                      1288    
       TRA     4,4                                                      1289    
   ONE PZE     ,,1                                                      1290    
   TWO PZE     ,,2                                                      1291    
 THREE PZE     ,,3                                                      1292    
*                                   CALL CMPHOL (A,B,N,M)               1293    
CMPHOL SXA     CMIR2,2                                                  1294    
       CAL*    3,4                  (N)                                 1295    
       PDX     ,2                                                       1296    
       CAL*    1,4                  (A)                                 1297    
       ANA XTRCT,2                                                      1298    
       SLW AFLDN             N FIELD OF A                               1299    
       CAL*    2,4                  (B)                                 1300    
       ANA XTRCT,2                                                      1301    
       SLW BFLDN             N FIELD OF B                               1302    
       CLA BFLDN                                                        1303    
       LDQ MEQ1                                                         1304    
       CAS AFLDN             COMPARE N FIELD OF A WITH N FIELD OF B     1305    
       LDQ MEQ2              LESS                                       1306    
       TRA *+2               EQUAL                                      1307    
       LDQ MEQ2              GREATER                                    1308    
       STQ*    4,4                  (M)                                 1309    
 CMIR2 AXT     **,2                 RESTORE IR2                         1310    
       TRA 5,4               RETURN                                     1311    
 AFLDN                                                                  1312    
 BFLDN                                                                  1313    
 MEQ1  PZE ,,1                                                          1314    
 MEQ2  PZE ,,2                                                          1315    
       OCT                   N OF 9    FOR CMPHOL                       1316    
       OCT 777700000000      N OF 8                                     1317    
       OCT 770000000000      N OF 7                                     1318    
       OCT 77                N OF 6                                     1319    
       OCT 7700              N OF 5                                     1320    
       OCT 770000            N OF 4                                     1321    
       OCT 77000000          N OF 3                                     1322    
       OCT 7700000000        N OF 2                                     1323    
       OCT 770000000000      N OF 1                                     1324    
 XTRCT OCT 777777777777      N OF 0                                     1325    
*                                   CALL INTHOL (A,N,J)                 1326    
INTHOL CLA*    3,4                  (J)                                 1327    
       ARS 18                                                           1328    
       STA SHLFT                                                        1329    
       CLA*    2,4                  (N) AT 18                           1330    
       LRS 53                72 DIVIDEND                                1331    
       DVP TEN               36 DIVISOR                                 1332    
       STO REM               36 REMAINDER, UNITS                        1333    
       CLM                   CLEAR AC                                   1334    
       DVP TEN               36 DIVISOR                                 1335    
       ALS 6                                                            1336    
       ORS REM               30 REMAINDER, TENS                         1337    
       CLM                   CLEAR AC                                   1338    
       DVP TEN               36 DIVISOR                                 1339    
       ALS 12                                                           1340    
       ADD REM               24 REMAINDER, HUNDREDS                     1341    
 SHLFT ALS *-*                                                          1342    
       STO*    1,4                  (A)                                 1343    
       TRA 4,4               RETURN                                     1344    
 TEN   OCT 000000000012      TEN IN BINARY                              1345    
   REM                       TEMPORARY STORAGE                          1346    
*                                   CALL SETHOL (A,6HXXXXXX)            1347    
*                                   CALL PUTHOL (A,B)                   1348    
SETHOL CAL*    2,4                  XXXXXX OR (B)                       1349    
       SLW*    1,4                  (A)                                 1350    
       TRA 3,4               RETURN                                     1351    
PUTHOL EQU     SETHOL                                                   1352    
*                                   CALL REPHOL (A,B,N)                 1353    
REPHOL SXA     REIR2,2                                                  1354    
       CAL*    3,4                  (N)                                 1355    
       PDX     ,2                                                       1356    
       CAL*    1,4                  (A)                                 1357    
       ANA RHOLXT,2                                                     1358    
       SLW AFLDN             SET NTH CHARACTER OF A TO BLANK            1359    
       TXH *+2,2,1           CHANGE N OF 1 TO N OF 7                    1360    
       TXI *+1,2,6                                                      1361    
       CAL*    2,4                  (B)                                 1362    
       ANA XTRCT,2           EXTRACT NTH CHARACTER OF B                 1363    
       ORA AFLDN             COMBINE                                    1364    
       SLW*    1,4                  (A)                                 1365    
 REIR2 AXT     **,2                 RESTORE IR2                         1366    
       TRA 4,4               RETURN                                     1367    
       OCT 777777777700      N OF 6    FOR REPHOL                       1368    
       OCT 777777770077      N OF 5                                     1369    
       OCT 777777007777      N OF 4                                     1370    
       OCT 777700777777      N OF 3                                     1371    
       OCT 770077777777      N OF 2                                     1372    
       OCT 007777777777      N OF 1                                     1373    
RHOLXT OCT                   N OF 0                                     1374    
*                            CALL STOREM (MPOF1,NTRM,MROW)              1375    
*                            THE SUBSCRIPT OF MP CORRESPONDS TO THE Q   1376    
*                            BITS 1-9 CORRESPOND TO AN R OF 0,ETC....   1377    
*                            BITS 28-36 CORRESPOND TO AN R OF 3         1378    
STOREM SXA     STIR1,1                                                  1379    
       SXA     STIR2,2                                                  1380    
       CLA 1,4                                                          1381    
       STA MPOFST            L(MPOF1)                                   1382    
       STA ORSST                                                        1383    
       CLA*    2,4                  NTRM                                1384    
       SUB MEQ1              NTRM-1                                     1385    
       LRS 18+2              (NTRM-1)/4                                 1386    
       PAX ,1                QUOTIENT IN IR1, IS 0,1,...                1387    
       CLM                   REMAINDER IS 0,1,2,OR 3                    1388    
       LLS 2                                                            1389    
       PAX ,2                IR2                                        1390    
       CAL XTRTSE,2                                                     1391    
MPOFST ANS *-*,1             CLEAR R FIELD OF Q WORD                    1392    
       CAL*    3,4                  MROW, IN DECREMENT FIELD            1393    
       TXH *+2,2,0                                                      1394    
       ALS 9                 IR2=0                                      1395    
       TNX ORSST,2,1         IR2=0,1                                    1396    
       ARS 9                 IR2=1,2(WERE 2,3)                          1397    
       TIX *-1,2,1                                                      1398    
 ORSST ORS *-*,1             STORE MROW IN R FIELD OF Q WORD            1399    
 STIR1 AXT     **,1                 RESTORE IR1                         1400    
 STIR2 AXT     **,2                 RESTORE IR2                         1401    
       TRA 4,4               RETURN                                     1402    
       OCT 777777777000                                                 1403    
       OCT 777777000777                                                 1404    
       OCT 777000777777                                                 1405    
XTRTSE OCT 000777777777                                                 1406    
*                            CALL FETCHM (MPOF1,NTRM,MROW)              1407    
FETCHM SXA     FEIR1,1                                                  1408    
       SXA     FEIR2,2                                                  1409    
       CLA 1,4                                                          1410    
       STA MPOFFE            L(MPOF1)                                   1411    
       CLA*    2,4                  NTRM                                1412    
       SUB MEQ1              NTRM-1                                     1413    
       LRS 18+2              (NTRM-1)/4                                 1414    
       PAX ,1                QUOTIENT IN IR1, IS 0,1,...                1415    
       CLM                   REMAINDER IS 0,1,2,OR 3                    1416    
       LLS 2                                                            1417    
       PAX ,2                0,1,2,OR 3                                 1418    
       CAL XTRTFE,2                                                     1419    
MPOFFE ANA *-*,1             EXTRACT FROM (MP(1+Q))                     1420    
       TRA     SHIFT,2                                                  1421    
       ALS     9                    3                                   1422    
       ALS     9                    2                                   1423    
       ALS     9                    1                                   1424    
 SHIFT LRS     9                    0                                   1425    
       SLW*    3,4                                                      1426    
 FEIR1 AXT     **,1                 RESTORE IR1                         1427    
 FEIR2 AXT     **,2                 RESTORE IR2                         1428    
       TRA 4,4               RETURN                                     1429    
       OCT 000000000777                                                 1430    
       OCT 000000777000                                                 1431    
       OCT 000777000000                                                 1432    
XTRTFE OCT 777000000000                                                 1433    
*                                                                       1434    
*              CALL PACKTR(L,NDECR,NADDR)                               1435    
*              STORE BITS S,1,...,17 OF NDECR INTO BITS S,1,..,17 OF L  1436    
*              STORE BITS S,1,...,17 OF NADDR INTO BITS 18,19,..,35 OF L1437    
*              ASSUMES BITS 18,19,...,35 OF NDECR AND NADDR ARE ZERO.   1438    
PACKTR CAL*    3,4           NADDR                                      1439    
       ARS     18                                                       1440    
       SLW*    1,4                                                      1441    
       LDQ*    2,4           NDECR                                      1442    
       SLQ*    1,4                                                      1443    
       TRA     4,4                                                      1444    
*                                                                       1445    
*              CALL UNPKTR(L,NDECR,NADDR)                               1446    
UNPKTR LDQ*    1,4           L                                          1447    
       SLQ*    2,4           NDECR                                      1448    
       RQL     18                                                       1449    
       SLQ*    3,4           NADDR                                      1450    
       TRA     4,4                                                      1451    
       END                                                              1452    
