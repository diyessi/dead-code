*     LIST                                                              EOGAMA01
      SUBROUTINE GAMMA(A1,A2,F1,F2)                                     EOGAMA02
      DIMENSION S(4)                                                    EOGAMA03
      F1=1.                                                             EOGAMA04
      F2=0.                                                             EOGAMA05
      IF(A)1,2,1                                                        EOGAMA06
    2 S(1)=1./12.                                                       EOGAMA07
      S(2)=1./288.                                                      EOGAMA08
      S(3)=-139./51840.                                                 EOGAMA09
      S(4)=-571./2488320.                                               EOGAMA10
      A=SQRTF(2.*3.14159265)                                            EOGAMA11
    1 IF(A1-10.)3,4,4                                                   EOGAMA12
    3 C1=A1**2+A2**2                                                    EOGAMA13
      IF(C1)6,7,6                                                       EOGAMA14
    6 C2=(F1*A1+F2*A2)/C1                                               EOGAMA15
      F2=(F2*A1-F1*A2)/C1                                               EOGAMA16
      F1=C2                                                             EOGAMA17
      A1=A1+1.                                                          EOGAMA18
      GO TO 1                                                           EOGAMA19
    4 C1=A1**2+A2**2                                                    EOGAMA20
      B1=A1/C1                                                          EOGAMA21
      B2=-A2/C1                                                         EOGAMA22
      C1=1.                                                             EOGAMA23
      C2=0.                                                             EOGAMA24
      C3=B1                                                             EOGAMA25
      C4=B2                                                             EOGAMA26
      DO 5I=1,4                                                         EOGAMA27
      C1=C1+S(I)*C3                                                     EOGAMA28
      C2=C2+S(I)*C4                                                     EOGAMA29
      C5=C3*B1-C4*B2                                                    EOGAMA30
      C4=C3*B2+C4*B1                                                    EOGAMA31
    5 C3=C5                                                             EOGAMA32
      C3=F1*C1-F2*C2                                                    EOGAMA33
      F2=F1*C2+F2*C1                                                    EOGAMA34
      F1=C3                                                             EOGAMA35
      C1=EXPF(-A1)                                                      EOGAMA36
      C2=COSF(-A2)*C1                                                   EOGAMA37
      C3=SINF(-A2)*C1                                                   EOGAMA38
      C4=0.5*LOGF(A1**2+A2**2)                                          EOGAMA39
      C5=ATANF(A2/A1)                                                   EOGAMA40
      C6=(A1-0.5)*C4-A2*C5                                              EOGAMA41
      C7=(A1-0.5)*C5+A2*C4                                              EOGAMA42
      C1=EXPF(C6)                                                       EOGAMA43
      C4=COSF(C7)*C1*A                                                  EOGAMA44
      C5=SINF(C7)*C1*A                                                  EOGAMA45
      C1=F1*C4-F2*C5                                                    EOGAMA46
      F2=F1*C5+F2*C4                                                    EOGAMA47
      F1=C1*C2-F2*C3                                                    EOGAMA48
      F2=C1*C3+F2*C2                                                    EOGAMA49
      GO TO 8                                                           EOGAMA50
    7 WRITE OUTPUT TAPE 3,9                                             EOGAMA51
    9 FORMAT(///39H GAMMA FUNCTION OF NEG. INTEGER OR ZERO///)          EOGAMA52
      CALL EXIT                                                         EOGAMA53
    8 RETURN                                                            EOGAMA54
      END                                                               EOGAMA55
