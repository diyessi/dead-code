   13 FORMAT (22H0PIVOT ELEMENT, COLUMNI4,20H TAKES ILLEGAL VALUEF16.4) IP910307
   50 FORMAT (11H0INPUT ROWS11X,1HMI7/11H TOTAL ROWS10X,2HM1I7/8H COLUMNIP910308
     1S14X,1HNI7/10H VARIABLES11X,2HNNI7/7H PIVOTS13X,3HNUMI7/10H PIVOT IP910309
     2ROW11X,2HI1I7/13H PIVOT COLUMN8X,2HJ1I7/23H FEASIBILITY BOUND  BNDIP910310
     3I7/23H COMPLETION SIGNAL   K2I7/23H SOLUTION SIGNAL    KC1I7)     IP910311
   51 FORMAT (I8,5I16,2F16.3)                                           IP910312
   52 FORMAT (1H0/7X,1HK8X,8HROW RANK5X,11HCOLUMN RANK4X,12HCOLUMN ORDERIP910313
     16X,10HZERO COUNT6X,10HINDEX LIST7X,9HPIVOT ROW4X,12HPIVOT COLUMN/1IP910314
     27X,7H(KR(K))9X,7H(KC(K))5X,11H(JORDER(K))5X,11H(JZEROS(K))6X,10H(IIP910315
     3NDEX(K))10X,6H(B(K))10X,6H(U(K))/1H06X,1H1,32X,I16,16X,I16,2F16.3)IP910316
   53 FORMAT (I8,I16,48X,I16,16X,F16.3)                                 IP910317
   70 FORMAT (13H1ERROR STOP, A5,8H ROUTINE73X,3A6)                     IP910318
      END (0,1,0,0,0)                                                   IP910319
      SUBROUTINE EXIT                                                   IP910320
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP910321
     1,KC1,BND,ALPHA,N7,N8,NSW3                                         IP910322
      DIMENSION A(204,104),LT(104),B(104),KC(104),JORDER(104),JZEROS(104IP910323
     1),KR(204),U(204),D(204),INDEX(204),ALPHA(3)                       IP910324
      END FILE N8                                                       IP910325
      REWIND N8                                                         IP910326
      STOP                                                              IP910327
      END (0,1,0,0,0)                                                   IP910328
*     FAP                                                               IP910329
*SLCTN SELECT MOST NEGATIVE ROW                                         IP910330
       COUNT   93                                                       IP910331
       ENTRY   SLCTN                                                    IP910332
 SLCTN SXA     ST3,1                                                    IP910333
       SXA     ST3+1,2                                                  IP910334
       SXA     ST3+2,4                                                  IP910335
       CLA N                                                            IP910336
       STD ST5                                                          IP910337
       CLA M1                                                           IP910338
       STD LOCB                                                         IP910339
       STD LOCC                                                         IP910340
       STZ AMIN                                                         IP910341
       STZ K2                                                           IP910342
       LXD D2,1                                                         IP910343
 ST1   CLA A+1,1                                                        IP910344
       TZE ST2                                                          IP910345
       CAS AMIN                                                         IP910346
       TRA ST2                                                          IP910347
       TRA ST2                                                          IP910348
       STO AMIN                                                         IP910349
       SXD I1,1                                                         IP910350
 ST2   TXI *+1,1,1                                                      IP910351
 LOCB  TXL ST1,1,**       DECREMENT M1                                  IP910352
       CLA AMIN                                                         IP910353
       TZE ST3            RETURN. PROBLEM COMPLETE                      IP910354
       STO B                                                            IP910355
       CLS I1                                                           IP910356
       ARS 18                                                           IP910357
       SUB ADDA                                                         IP910358
       STO ADDX                                                         IP910359
       CLS D2                                                           IP910360
       STO K2                                                           IP910361
       STO JZ1                                                          IP910362
       LXD I1,1                                                         IP910363
       TXI *+1,1,MDIM                                                   IP910364
       LXD D2,2                                                         IP910365
 ST4   CLA A+1,1          COPY ROW INTO B                               IP910366
       STO B+1,2                                                        IP910367
       TZE ST8                                                          IP910368
       TPL ST8                                                          IP910369
       CLA JZ1                                                          IP910370
       SUB JZEROS+1,2                                                   IP910371
       TZE ST9            TIE WITH ZEROS                                IP910372
