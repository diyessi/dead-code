       TXH     OLEV,1,NISB        TESTS                                 TSSB0947
       TXH     *+2,1,NIS          FOR                                   TSSB0948
OFTST  TXH     *+1,1,MINT         NEW TYPE, AND                         TSSB0949
       TXI     *-15,4,1           ADJUSTS X4.                           TSSB0950
       PXD     0,0                                                      TSSB0951
