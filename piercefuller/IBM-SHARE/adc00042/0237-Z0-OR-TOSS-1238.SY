       STQ     IB+1,2             OTHERWISE, STO ENTRY COUNT            TSSB0152
       STO     I                  FOR PREV. NODE, STO NEW NODE,         TSSB0153
       PDX     0,6                AND SET                               TSSB0154
       TXI     *+1,6,-NB          XS FOR                                TSSB0155
       SXA     TX2,2              NEXT                                  TSSB0156
       AXT     0,1                TABLE.                                TSSB0157
TRDC   TSX     TRDER,2            IF 1ST TEMP IS BLANK                  TSSB0158
       TRA     TLEV               LEAVE.                                TSSB0159
       TSX     TRDER,2            IF SECOND OR                          TSSB0160
       STR                        THIRD TEMPERATURES                    TSSB0161
