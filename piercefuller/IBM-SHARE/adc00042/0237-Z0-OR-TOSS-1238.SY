*TSCK          CLOCK CALLING ROUTINES FOR  TOSS  --LIMTO AND LIMIT--    TSCK0001
       COUNT   42                                                       TSCK0002
ORTSCK REM 0042 08011                                                   TSCK0003
       ENTRY   LIMTO                                                    TSCK0004
       ENTRY   LIMIT                                                    TSCK0005
*LIMTO     INITIALIZE CLOCK INTERRUPT                                   TSCK0006
*LIMIT     TEST CLOCK FOR INTERRUPT                                     TSCK0007
LIMTO  SXA     *+5,4                                                    TSCK0008
       ZET*    1,4                IF LIM NONZERO                        TSCK0009
       TSX     $CLOCK,4           READ CLOCK.                           TSCK0010
       CLA     =-1                BAD TIME OR LIM=0, TYM=-1.            TSCK0011
       STO     INTIM              SAVE INITIAL TIME.                    TSCK0012
       AXT     **,4               RESTORE X4.                           TSCK0013
       TPL     *+2                IF NO TEST                            TSCK0014
       STZ*    1,4                SET LIM=0.                            TSCK0015
       LDQ     =O6000000          LIM IN DECONDS                        TSCK0016
       MPY*    1,4                IS LIM*6                              TSCK0017
       ALS     17                 IN DECREMENT.                         TSCK0018
       STO*    1,4                SAVE CONVERTED LIM                    TSCK0019
       STO     LIMT               INTERNALLY AND EXTERNALLY             TSCK0020
       CLA     INTIM              INITIAL TIME IN AC                    TSCK0021
       TRA     2,4                AND EXIT.                             TSCK0022
LIMIT  SXA     *+11,4                                                   TSCK0023
       ZET     LIMT               IF LIM NONZERO                        TSCK0024
       TSX     $CLOCK,4           READ CLOCK.                           TSCK0025
       TRA     *+11               LIM=0 OR BAD TIME, NO TEST.           TSCK0026
       SUB     INTIM              TSTYM-INTYN INTO AC.                  TSCK0027
       TPL     *+2                + IMPLIES BEFORE MIDNIGHT             TSCK0028
       ADD     DAY                - PAST MIDNIGHT.  AND 24 HR.          TSCK0029
       SSM                        AC=INTYM-TSTYN(-DAY)                  TSCK0030
       ADD     LIMT               +LIM=REMTYM.                          TSCK0031
       TNZ     *+2                IF REMTYM=0,                          TSCK0032
       CLA     =-1                SET =-1.                              TSCK0033
       AXT     **,4               RELOAD X4.                            TSCK0034
       STO*    1,4                SAVE LEFT AND                         TSCK0035
       TRA     2,4                EXIT.                                 TSCK0036
       CLA     =0                                                       TSCK0037
       TRA     *-4                                                      TSCK0038
LIMT                                                                    TSCK0039
INTIM                                                                   TSCK0040
DAY            ,,360*24           1 DAY IN TENS-OF-SECONDS              TSCK0041
       END                                                              TSCK0042
