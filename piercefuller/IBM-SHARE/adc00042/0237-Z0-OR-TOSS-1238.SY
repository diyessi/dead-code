       TXI     *+1,1,1            AND ENTRY COUNT.                      TSSB0175
       TRA     2,2                                                      TSSB0176
TERR   TXI     *-6,1,-1           IF OVERFLOW, USE LAST ENTRY.          TSSB0177
TERAS  PDX     0,4                                                      TSSB0178
       STZ     IB+NB+1,4          ERASE NODE.                           TSSB0179
       AXT     6,4                                                      TSSB0180
