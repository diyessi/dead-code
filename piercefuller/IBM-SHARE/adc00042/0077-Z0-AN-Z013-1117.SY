  500 CALL MATMPY(N,N,H,G,X)                                            Z0130265
  501 M=1                                                               Z0130266
  502 CALL MATMPY(M,N,X,G,TO)                                           Z0130267
  503 TP1=SL-GSS**2/TO-E                                                Z0130268
  504 IF(TP1)524,505,505                                                Z0130269
  505 DO 507 I=1,N                                                      Z0130270
  506 DO 507 J=1,N                                                      Z0130271
  507 H(I,J)=H(I,J)-X(I)*X(J)/TO                                        Z0130272
  508 DELTA=DELTA*(EL*GSS/TO)                                           Z0130273
  509 TO=EL/GSS                                                         Z0130274
  510 DO 512 I=1,N                                                      Z0130275
  511 DO 512 J=1,N                                                      Z0130276
  512 H(I,J)=H(I,J)+TO*S(I)*S(J)                                        Z0130277
  519 F=FB                                                              Z0130278
  520 DO 522 I=1,N                                                      Z0130279
  521 G(I)=GB(I)                                                        Z0130280
  522 X(I)=T(I)                                                         Z0130281
  529 IF ACCUMULATOR OVERFLOW 531,530                                   Z0130282
  530 IF QUOTIENT OVERFLOW 531,513                                      Z0130283
  513 WRITE OUTPUT TAPE 1,1,IT,MS,F,GS                                  Z0130284
