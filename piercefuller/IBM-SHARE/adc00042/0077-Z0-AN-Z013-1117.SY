C     READY                                                             Z0130116
      SUBROUTINE READY                                                  Z0130117
      DIMENSION H(40,40),X(40),G(40),S(40),XP(40),GP(40),               Z0130118
     XT(40),GB(40)                                                      Z0130119
      COMMON H,X,G,S,XP,GP,T,GB,M,N,L,LS,M1,MS,NS,IT,GS,                Z0130120
     XGSP,GTP,GSS,GTT,GSB,F,FP,FB,FO,E,K,P,TO,RS,SL,Z,Q,A,              Z0130121
     XEL,DELTA                                                          Z0130122
      L=L                                                               Z0130123
      GO TO(200,201),L                                                  Z0130124
  200 IT=1                                                              Z0130125
  201 CALL MATMPY(N,N,H,G,S)                                            Z0130126
  202 DO 203 I=1,N                                                      Z0130127
  203 S(I)=-S(I)                                                        Z0130128
  204 M=1                                                               Z0130129
  205 CALL MATMPY(M,N,S,G,GS)                                           Z0130130
  206 IF(GS+E)207,227,227                                               Z0130131
  207 TP1=-2.0*(F/GS)                                                   Z0130132
  208 EL=MIN1F(2.0,TP1)                                                 Z0130133
  209 SL=-GS                                                            Z0130134
  210 DO 211 I=1,N                                                      Z0130135
  211 XP(I)=X(I)+EL*S(I)                                                Z0130136
  212 M1=2                                                              Z0130137
  213 CALL FCN(N,GP,FP,XP,M1)                                           Z0130138
  214 M=1                                                               Z0130139
  215 CALL MATMPY(M,N,S,GP,GSP)                                         Z0130140
  216 IF(GSP)217,229,229                                                Z0130141
  217 IF(FP-F)218,229,229                                               Z0130142
  218 WRITE OUTPUT TAPE 1,1                                             Z0130143
  231 FB=FP                                                             Z0130144
  232 DO 234 I=1,N                                                      Z0130145
  233 GB(I)=GP(I)                                                       Z0130146
  234 T(I)=XP(I)                                                        Z0130147
  220 IF(EL-2.0)221,223,223                                             Z0130148
  221 L=3                                                               Z0130149
  222 RETURN                                                            Z0130150
  223 DELTA=2.0*DELTA                                                   Z0130151
  224 TO=1.0/SL                                                         Z0130152
  225 L=2                                                               Z0130153
  226 GO TO 222                                                         Z0130154
  227 L=1                                                               Z0130155
  228 GO TO 222                                                         Z0130156
  229 L=4                                                               Z0130157
  230 GO TO 222                                                         Z0130158
    1 FORMAT(10H0UNDERSHOT)                                             Z0130159
