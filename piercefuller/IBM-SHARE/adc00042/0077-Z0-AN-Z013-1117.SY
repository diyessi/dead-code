C     AIM                                                               Z0130161
      SUBROUTINE AIM                                                    Z0130162
      DIMENSION H(40,40),X(40),G(40),S(40),XP(40),GP(40),               Z0130163
     XT(40),GB(40)                                                      Z0130164
      COMMON H,X,G,S,XP,GP,T,GB,M,N,L,LS,M1,MS,NS,IT,GS,                Z0130165
     XGSP,GTP,GSS,GTT,GSB,F,FP,FB,FO,E,K,P,TO,RS,SL,Z,Q,A,              Z0130166
     XEL,DELTA                                                          Z0130167
  300 Z=GS+GSP+3.0*(F-FP)/EL                                            Z0130168
  301 TO=GS/Z                                                           Z0130169
      TI=GSP/Z                                                          Z0130170
  302 Q=SQRTF(1.0-TO*TI)                                                Z0130171
      Q = ABSF(Q*Z)                                                     Z0130172
      A=(GSP+Q-Z)/(GSP-GS+2.0*Q)                                        Z0130173
  303 TO=(EL*(GSP+Z+2.0*Q)*A**2)/3.0                                    Z0130174
  304 FO=FP-TO                                                          Z0130175
  305 CALL MATMPY(N,N,H,GP,T)                                           Z0130176
  306 TP1=GSP/SL                                                        Z0130177
  307 DO 308 I=1,N                                                      Z0130178
  308 T(I)=-T(I)+TP1*S(I)                                               Z0130179
  309 M=1                                                               Z0130180
  310 CALL MATMPY(M,N,T,GP,GTP)                                         Z0130181
  311 IF(2.0*TO+GTP)317,312,312                                         Z0130182
  312 TP1=1.0-A                                                         Z0130183
  313 DO 314 I=1,N                                                      Z0130184
  314 T(I)=A*X(I)+TP1*XP(I)                                             Z0130185
  315 L=1                                                               Z0130186
  316 RETURN                                                            Z0130187
  317 IF(F+GTP/2.0)312,318,318                                          Z0130188
  318 DO 319 I=1,N                                                      Z0130189
  319 T(I)=T(I)+XP(I)                                                   Z0130190
  320 M1=2                                                              Z0130191
  321 CALL FCN(N,GB,FB,T,M1)                                            Z0130192
  322 IF(FB-FO)323,312,312                                              Z0130193
  323 WRITE OUTPUT TAPE 1,1                                             Z0130194
  324 DO 325 I=1,N                                                      Z0130195
  325 S(I)=T(I)-XP(I)                                                   Z0130196
  326 M=1                                                               Z0130197
  327 CALL MATMPY(M,N,S,GB,GTT)                                         Z0130198
  328 GTT=GTT-GTP                                                       Z0130199
  329 IF(GTT)335,330,330                                                Z0130200
  330 GSS=GTT                                                           Z0130201
  331 SL=-GTP                                                           Z0130202
  332 EL=1.0                                                            Z0130203
  333 L=2                                                               Z0130204
  334 GO TO 316                                                         Z0130205
  335 L=3                                                               Z0130206
  336 GO TO 316                                                         Z0130207
    1 FORMAT(9H0RICOCHET)                                               Z0130208
          END(0,1,0,0,0)                                                Z0130209
C     FIRE                                                              Z0130210
      SUBROUTINE FIRE                                                   Z0130211
      DIMENSION H(40,40),X(40),G(40),S(40),XP(40),GP(40),               Z0130212
     XT(40),GB(40)                                                      Z0130213
      COMMON H,X,G,S,XP,GP,T,GB,M,N,L,LS,M1,MS,NS,IT,GS,                Z0130214
     XGSP,GTP,GSS,GTT,GSB,F,FP,FB,FO,E,K,P,TO,RS,SL,Z,Q,A,              Z0130215
     XEL,DELTA                                                          Z0130216
  400 M1=2                                                              Z0130217
  401 CALL FCN(N,GB,FB,T,M1)                                            Z0130218
  402 M=1                                                               Z0130219
  403 CALL MATMPY(M,N,S,GB,GSB)                                         Z0130220
  404 TP1=MIN1F(F,FP)                                                   Z0130221
  405 IF(TP1-FB+E)418,406,406                                           Z0130222
  406 TP1=A/(1.0-A)                                                     Z0130223
  407 TP2=(1.0-A)/A                                                     Z0130224
  408 TO=GSB*(TP1-TP2)                                                  Z0130225
  409 IF(ABSF(TO)-Q)413,410,410                                         Z0130226
  410 GSS=2.0*Q                                                         Z0130227
  411 L=1                                                               Z0130228
  412 RETURN                                                            Z0130229
  413 GSS=TO+2.0*Q                                                      Z0130230
  414 DO 415 I=1,N                                                      Z0130231
  415 G(I)=(GB(I)-G(I))*TP1+(GP(I)-GB(I))*TP2                           Z0130232
  416 L=2                                                               Z0130233
  417 GO TO 412                                                         Z0130234
  418 IF(F-FP)419,428,428                                               Z0130235
  419 WRITE OUTPUT TAPE 1,1                                             Z0130236
  420 EL=(1.0-A)*EL                                                     Z0130237
  421 FP=FB                                                             Z0130238
  422 GSP=GSB                                                           Z0130239
  423 DO 425 I=1,N                                                      Z0130240
  424 XP(I)=T(I)                                                        Z0130241
  425 GP(I)=GB(I)                                                       Z0130242
  426 L=3                                                               Z0130243
  427 GO TO 412                                                         Z0130244
  428 WRITE OUTPUT TAPE 1,2                                             Z0130245
  429 EL=EL*A                                                           Z0130246
  430 F=FB                                                              Z0130247
  431 GS=GSB                                                            Z0130248
  432 DO 434 I=1,N                                                      Z0130249
  433 X(I)=T(I)                                                         Z0130250
  434 G(I)=GB(I)                                                        Z0130251
  435 GO TO 426                                                         Z0130252
    1 FORMAT(10H0MOVE LEFT)                                             Z0130253
    2 FORMAT(11H0MOVE RIGHT)                                            Z0130254
          END(0,1,0,0,0)                                                Z0130255
C     DRESS                                                             Z0130256
      SUBROUTINE DRESS                                                  Z0130257
      DIMENSION H(40,40),X(40),G(40),S(40),XP(40),GP(40),               Z0130258
     XT(40),GB(40)                                                      Z0130259
