  518 IT=IT+1                                                           Z0130289
 5185 L=1                                                               Z0130290
  523 RETURN                                                            Z0130291
  524 WRITE OUTPUT TAPE 1,5                                             Z0130292
  525 TP1=EL*SL/GSS                                                     Z0130293
  526 DELTA=DELTA*TP1                                                   Z0130294
  527 TO=(TP1-1.0)/SL                                                   Z0130295
  528 GO TO 510                                                         Z0130296
  531 WRITE OUTPUT TAPE 1,6                                             Z0130297
  532 WRITE OUTPUT TAPE 1,7                                             Z0130298
  533 DO 534 I=1,N                                                      Z0130299
  534 WRITE OUTPUT TAPE 1,8,(H(I,J),J=1,N)                              Z0130300
  535 WRITE OUTPUT TAPE 1,9,F                                           Z0130301
  536 WRITE OUTPUT TAPE 1,2,(X(I),I=1,N)                                Z0130302
  537 WRITE OUTPUT TAPE 1,10,(G(I),I=1,N)                               Z0130303
  538 IF(SENSE SWITCH 2)539,543                                         Z0130304
  539 PUNCH 11,(X(I),I=1,N)                                             Z0130305
  540 DO 541 I=1,N                                                      Z0130306
  541 PUNCH 11,(H(I,J),J=I,N)                                           Z0130307
  542 PUNCH 11,DELTA,E,P                                                Z0130308
  543 L=2                                                               Z0130309
  544 GO TO 523                                                         Z0130310
    1 FORMAT(4H0IT I4,7H  STEP I4,4H  F=1PE14.5,5H  GS=E14.5)           Z0130311
    2 FORMAT(3H0X=1P8E14.5/(3H0  8E14.5))                               Z0130312
