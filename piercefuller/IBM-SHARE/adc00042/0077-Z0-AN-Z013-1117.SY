C     STUFF                                                             Z0130323
      SUBROUTINE STUFF                                                  Z0130324
      DIMENSION H(40,40),X(40),G(40),S(40),XP(40),GP(40),               Z0130325
     XT(40),GB(40)                                                      Z0130326
      COMMON H,X,G,S,XP,GP,T,GB,M,N,L,LS,M1,MS,NS,IT,GS,                Z0130327
     XGSP,GTP,GSS,GTT,GSB,F,FP,FB,FO,E,K,P,TO,RS,SL,Z,Q,A,              Z0130328
     XEL,DELTA                                                          Z0130329
  600 K=K-1                                                             Z0130330
  601 IF(K)617,602,602                                                  Z0130331
  602 MS=MS+1                                                           Z0130332
  620 WRITE OUTPUT TAPE 1,1,MS,GS                                       Z0130333
  603 DO 604 I=1,N                                                      Z0130334
  604 T(I)=RANDOMF(DUMMY)-0.5                                           Z0130335
  605 CALL MATMPY(N,N,H,T,S)                                            Z0130336
  606 M=1                                                               Z0130337
  607 CALL MATMPY(M,N,S,T,TP1)                                          Z0130338
  608 TP1=SQRTF(TP1)                                                    Z0130339
  609 EL=P/TP1                                                          Z0130340
  610 DO 611 I=1,N                                                      Z0130341
  611 X(I)=X(I)+EL*S(I)                                                 Z0130342
  612 M1=2                                                              Z0130343
  614 L=1                                                               Z0130344
  616 RETURN                                                            Z0130345
  617 L=2                                                               Z0130346
  618 MS=0                                                              Z0130347
  619 GO TO 616                                                         Z0130348
    1 FORMAT(13H0RANDOM STEP I4,5H  GS=1PE14.5)                         Z0130349
          END(0,1,0,0,0)                                                Z0130350
C     MATRIX MULTIPLICATION                                             Z0130351
      SUBROUTINE MATMPY(M,N,H,G,S)                                      Z0130352
      DIMENSION H(40,40),G(40),S(40)                                    Z0130353
  702 DO 703 I=1,M                                                      Z0130354
  700 S(I)=0.0                                                          Z0130355
      DO 703 J=1,N                                                      Z0130356
  703 S(I)=H(J,I)*G(J)+S(I)                                             Z0130357
  704 RETURN                                                            Z0130358
          END(0,1,0,0,0)                                                Z0130359
