*     LIST8                                                             INDI 118
CRIND   CALLS INPUT CARD TO ALTER SENSE INDICATORS   VAN NORTON         INDI 119
      SUBROUTINE R IND(A)                                               INDI 120
      READ INPUT TAPE 5,1,A(1),A(2),A(3)                                INDI 121
      RETURN                                                            INDI 122
 1    FORMAT(3O12)                                                      INDI 123
