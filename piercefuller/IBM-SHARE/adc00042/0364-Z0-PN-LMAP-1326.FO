*     LIST8                                                             LMAPA000
*     LABEL                                                             LMAPA010
CLMAP1                                                                  LMAPA020
       DIMENSION BUF(24),DICT(25000),HEAD(12),NUMBER(24999),IBU (24)    LMAPA030
       COMMON DICT,BUF,MAX,ISIZE,ITRCNT,IEOF,J,IDICT,LINCNT             LMAPA040
       EQUIVALENCE (NUMBER,DICT(2)),(BUF,IBU )                          LMAPA050
       CALL EJECT1                                                      LMAPA060
      ITRCNT=0                                                          LMAPA070
      ISIZE=0                                                           LMAPA080
      IDICT=-1                                                          LMAPA090
      ASSIGN 1000 TO IEOF                                               LMAPA100
      READ INPUT TAPE 5,10,HEAD                                         LMAPA110
10    FORMAT (12A6)                                                     LMAPA120
      WRITE OUTPUT TAP E 6,20,HEAD                                      LMAPA130
       LINCNT=2                                                         LMAPA140
25    DO 200 I=1,32767                                                  LMAPA150
30    CALL READ                                                         LMAPA160
      IF (BUF(1)) 40,9999,30                                            LMAPA170
40     CALL EJECT(0)                                                    LMAPA180
       IF (BUF(5)) 80,60,80                                             LMAPA190
60    WRITE OUTPUT TAPE 6,70,I,ISIZE                                    LMAPA200
       LINCNT=LINCNT+4                                                  LMAPA210
      GO TO 100                                                         LMAPA220
80    WRITE OUTPUT TAPE 6,90,I,BUF(5),ISIZE,(BUF(J),J=5,MAX,2)          LMAPA230
90    FORMAT (1H0/1H0I5,13H. SUBROUTINE A6,1H.I6,11H LOCATIONS./13H0ENTRLMAPA240
     1Y POINTS4X8A7/(17X8A7))                                           LMAPA250
       LINCNT=LINCNT+MAX/21+6                                           LMAPA260
      DO 95 J=5,MAX,2                                                   LMAPA270
      IDICT=IDICT+2                                                     LMAPA280
      DICT(IDICT)=BUF(J)                                                LMAPA290
95    NUMBER(IDICT)=XSIGNF(I,IBU(J+1))                                  LMAPA300
100   CALL READ                                                         LMAPA310
      IF (BUF(1)) 110,9999,130                                          LMAPA320
110   WRITE OUTPUT TAPE 6,120,(BUF(J),J=3,MAX,2)                        LMAPA330
       LINCNT=LINCNT+MAX/21+1                                           LMAPA340
      DO 125 J=3,MAX,2                                                  LMAPA350
      IDICT=IDICT+2                                                     LMAPA360
      DICT(IDICT)=BUF(J)                                                LMAPA370
125   NUMBER(IDICT)=XSIGNF(I,IBU(J+1))                                  LMAPA380
      GO TO 100                                                         LMAPA390
130   IF (ITRCNT) 9999,140,160                                          LMAPA400
140   WRITE OUTPUT TAPE 6,150                                           LMAPA410
150   FORMAT (20H0NO TRANSFER VECTOR.)                                  LMAPA420
       LINCNT=LINCNT+2                                                  LMAPA430
      GO TO 200                                                         LMAPA440
160   N=XMIN0F(ITRCNT+4,MAX)                                            LMAPA450
      WRITE OUTPUT TAPE 6,170,(BUF(J),J=5,N)                            LMAPA460
       LINCNT=LINCNT+(N-5)/8+2                                          LMAPA470
175   ITRCNT=ITRCNT-N+4                                                 LMAPA480
      IF (ITRCNT) 9999,200,180                                          LMAPA490
180   CALL READ                                                         LMAPA500
      N=XMIN0F(ITRCNT+4,MAX)                                            LMAPA510
       WRITE OUTPUT TAPE 6,120,(BUF(J),J=5,N)                           LMAPA520
       LINCNT=LINCNT+(N-5)/8+1                                          LMAPA530
      GO TO 175                                                         LMAPA540
200   CONTINUE                                                          LMAPA550
      IF (1) 9999,1000,25                                               LMAPA560
1000   CALL EJECT(99)                                                   LMAPA570
       WRITE OUTPUT TAPE 6,1010                                         LMAPA580
1010  FORMAT (53H0TABLE OF ENTRIES WITH CORRESPONDING PROGRAM NUMBERS./1LMAPA590
     1H019X13HENTRY  PR.NO./1H )                                        LMAPA600
       CALL EJECT(3)                                                    LMAPA610
      DO 1020 I=1,IDICT,2                                               LMAPA620
      CALL MIN                                                          LMAPA630
      J=J                                                               LMAPA640
       WRITE OUTPUT TAPE 6,1030,DICT(J),NUMBER(J)                       LMAPA650
       CALL EJECT(1)                                                    LMAPA660
B      DICT(J)=777777777777                                             LMAPA670
1020   CONTINUE                                                         LMAPA680
       WRITE OUTPUT TAPE 6,1040                                         LMAPA690
1040   FORMAT (68H0A MINUS SIGN BEFORE THE PROGRAM NUMBER INDICATES A SELMAPA700
     1CONDARY ENTRY./70H A SECONDARY ENTRY IS IGNORED UNLESS AT LEAST ONLMAPA710
     2E PRIMARY ENTRY IN THE/71H SAME PROGRAM IS REFERRED TO. WITH THIS LMAPA720
     3RESTRICTION, IF AN ENTRY OCCURS/67H IN MORE THAN ONE PROGRAM, THE LMAPA730
     4ONE THAT IS ENCOUNTERED FIRST DURING/26H LIBRARY SEARCH IS LOADED.LMAPA740
     5)                                                                 LMAPA750
      CALL EXIT                                                         LMAPA760
9999  WRITE OUTPUT TAPE 6,10000                                         LMAPA770
10000 FORMAT (20H0UNIDENTIFIED ERROR.)                                  LMAPA780
      N=XLOCF(BUF)+1                                                    LMAPA790
       CALL DUMP(BUF(N),BUF(N+1),3)                                     LMAPA800
20     FORMAT (1H012A6)                                                 LMAPA810
70     FORMAT (1H0/1H0I5,15H. MAIN PROGRAM.I6,11H LOCATIONS. )          LMAPA820
120    FORMAT (17X8A7)                                                  LMAPA830
170    FORMAT (17H0TRANSFER VECTOR 8A7/(17X8A7))                        LMAPA840
1030   FORMAT (20XA6,I7)                                                LMAPA850
      END                                                               LMAPA860
