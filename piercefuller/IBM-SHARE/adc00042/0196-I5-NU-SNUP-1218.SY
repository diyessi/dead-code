* SNUP      133 11061    7090 INPUT/OUTPUT PACKAGE                      SNUP0001
*      FAP                                                              SNUP0002
       COUNT   335                                                      SNUP0003
*NUSNUP  NEW YORK UNIV. 7090 UTILITY PACKAGE. A FAP-CODED SUBROUTINE    SNUP0004
*            WHICH MAKES FORTRAN I/O SUBRTS. AVAILABLE TO FAP PROGS.    SNUP0005
*             MAY BE USED ONLY WITH RELOCATABLE FAP PROG. USING THE CALLSNUP0006
*             STATEMENTS AS FOLLOWS                                     SNUP0007
*       1. CALL NUWAT,T,F,W1,S1,W2,S2,....,WN,SN                        SNUP0008
*       2. CALL NURAT,T,F,R1,S1,R2,S2,.....,WN,SN                       SNUP0009
*             USED TO WRITE OUTPUT TAPE AND READ INPUT  TAPE            SNUP0010
*         WHRE  T IS THE TAPE NUMBER , SUCH AS 2,8,4                    SNUP0011
*               F IS THE LOC. OF THE FORMAT (STORED FOWARDS IN MEMORY)  SNUP0012
*               W  ARE LOC. OF FIRST OF S ITEMS TO WRITE                SNUP0013
*               R  ARE LOC. OF FIRST OF S ITEMS TO BE READ              SNUP0014
*               S  ARE NUMBERS OF SUCCESSIVE  MEM. LOC. TO BE AFFECTED  SNUP0015
*       3. CALL NUWABT,T,W1,S1,W2,S2,.....,WN,SN                        SNUP0016
*       4. CALL NURABT,T,R1,S1,R2,S2,.....,RN,SN                        SNUP0017
*             USED TO WRITE A BINARY TAPE AND READ A BINARY TAPE        SNUP0018
*         WHERE T,W,R, AND S ARE AS DEFINED ABOBE FOR 1. AND 2.         SNUP0019
*       5. CALL NUPAC,F,W1,S1,W2,S2,.....,WN,SN                         SNUP0020
*       6. CALL NURAC, F,R1,S1,R2,S2,.....,RN,SN                        SNUP0021
*       7. CALL NUPAL, F,W1,S1,W2,S2,.....,WN,SN                        SNUP0022
*             USED TO PUNCH A CARD,READ A CARD, PRINT A LINE            SNUP0023
*         WHERE F,W,R, AND S ARE AS DEFINED FOR 1. AND 2. ABOVE.        SNUP0024
*       8. CALL NUBACK,T1,NLR1,T2,NLR2,.....,TN,NLRN                    SNUP0025
*       9. CALL NUREW,T1,T2,T3,T4,.....TN                               SNUP0026
*      10. CALL NUWEOF,T1,T2,TO,T4,....,TN                              SNUP0027
*             USED TO BACKSPACE TAPE, REWIND TAPE,WRITE AN END OF FILE  SNUP0028
*         WHRE  T ARE TAPE NUMBERS AND NLR ARE NUMBERS OF LOG. RECORDS  SNUP0029
*                                                                       SNUP0030
       ENTRY   NUWAT          WRITE A DECIMAL TAPE                      SNUP0031
       ENTRY   NURAT          READ A DECIMAL TAPE                       SNUP0032
       ENTRY   NUWABT         WRITE A BINARY TAPE                       SNUP0033
       ENTRY   NURABT         READ A BINARY TAPE                        SNUP0034
       ENTRY   NUPAC          PUNCH A CARD                              SNUP0035
       ENTRY   NURAC          READ A CARD                               SNUP0036
       ENTRY   NUPAL          PRINT A LINE                              SNUP0037
       ENTRY   NUREW             REWIND A TAPE                        NUSNUP0038
       ENTRY   NUBACK            BACKSPACE A TAPE                     NUSNUP0039
       ENTRY   NUWEOF            WRITE AN END OF FILE                 NUSNUP0040
*                                                                       SNUP0041
*      ***    IF STANDARD ERROR PROCEDURE NOT IN SYSTEM MAKE THIS A PZE SNUP0042
*      ***   AND MAKE THIS  A    BCI  1,NUSNUP                          SNUP0043
PUTTSH CAL     TTSH               TSX$(TSH),4                           SNUP0044
       TRA     5B                                                       SNUP0045
*                                                                       SNUP0046
PUTSTH CAL     TSTH               TSX  $(STH),4                         SNUP0047
       TRA     5A                                                       SNUP0048
*                                                                       SNUP0049
PUTTSB CAL     TTSB               TSX  $(TSB),4                         SNUP0050
       TRA     5C                                                       SNUP0051
*                                                                       SNUP0052
PUTSTB CAL     TSTB               TSX  $(STB),4                         SNUP0053
       TRA     5D                                                       SNUP0054
*                                                                       SNUP0055
PUTSCH CAL     TSCH                                                     SNUP0056
       TRA     5A                                                       SNUP0057
*                                                                       SNUP0058
PUTCSH CAL     TCSH               TSX  $(CSH),4                         SNUP0059
       TRA     5B                                                       SNUP0060
*                                                                       SNUP0061
PUTSPH CAL     TSPH               TSX  $(SPH),4                         SNUP0062
       TRA     5A                                                       SNUP0063
*                                                                       SNUP0064
5A     SLW     TOCALL                                                   SNUP0065
       CAL     TSLO                                                     SNUP0066
       SLW     TOSLR              A TSX  $(SLO),4                       SNUP0067
       CAL     TFIL                                                     SNUP0068
       SLW     RESTOR+1                                                 SNUP0069
       TRA     SAVER                                                    SNUP0070
*                                                                       SNUP0071
5B     SLW     TOCALL                                                   SNUP0072
       CAL     TSLI                                                     SNUP0073
       SLW     TOSLR              A TSX $(SLI),4                        SNUP0074
       CAL     TRTN               A TSX $(RTN),4                        SNUP0075
       TRA     5A+4                                                     SNUP0076
*                                                                       SNUP0077
5C     SLW     TOCALL                                                   SNUP0078
       CAL     TSLI               A TSX $(SLI),4                        SNUP0079
       SLW     TOSLR                                                    SNUP0080
       CAL     TRLR               S TSX $(RLR),4                        SNUP0081
       TRA     5A+4                                                     SNUP0082
*                                                                       SNUP0083
5D     SLW     TOCALL                                                   SNUP0084
       CAL     TSLO               A $(SLO),4                            SNUP0085
       SLW     TOSLR                                                    SNUP0086
       CAL     TWLR               TSX $(WLR),4                          SNUP0087
       TRA     5A+4                                                     SNUP0088
1A     CAL     ACLA1              CLA  1,2                              SNUP0089
       SLW     NOTAP                                                    SNUP0090
OUT1A  TRA     **                                                       SNUP0091
*                                                                       SNUP0092
1B     CAL     ATXIA              TXI  STLOC,2,1                        SNUP0093
       SLW     NOTAP                                                    SNUP0094
2A     CAL     ACLA2              CLA  2,2                              SNUP0095
       SLW     STLOC                                                    SNUP0096
OUT2A  TRA     **                                                       SNUP0097
*                                                                       SNUP0098
2B     CAL     ATXIB              TXI  TNARG,2,1                        SNUP0099
       SLW     STLOC                                                    SNUP0100
3A     CAL     CALT               CAL  TAPNU                            SNUP0101
       SLW     STRSZ+1                                                  SNUP0102
OUT3A  TRA     **                                                       SNUP0103
*                                                                       SNUP0104
3B     CAL     ANOP                                                     SNUP0105
       SLW     STRSZ+1                                                  SNUP0106
 OUT3B TRA     **                                                       SNUP0107
*                                                                       SNUP0108
4B     CAL     ANOP               NOP                                   SNUP0109
       SLW     LCFOR                                                    SNUP0110
OUT4B  TRA     **                                                       SNUP0111
*                                                                       SNUP0112
*                                                                       SNUP0113
 NURAT CAL     TPUTSH                                                   SNUP0114
       SLW     OUT3A                                                    SNUP0115
       CAL     TRA2A              TRA  2A                               SNUP0116
       SLW     OUT1A                                                    SNUP0117
       CAL     TRA3A                                                    SNUP0118
       SLW     OUT2A                                                    SNUP0119
       TRA     1A                                                       SNUP0120
*                                                                       SNUP0121
 NUWAT CAL     TPUSTH             A TRA PUTSTH                          SNUP0122
       TRA     NURAT+1                                                  SNUP0123
*                                                                       SNUP0124
 NUPAC CAL     TPUSCH             A TRA PUTSCH                          SNUP0125
       SLW     OUT3B                                                    SNUP0126
       CAL     TRA3B                                                    SNUP0127
       SLW     OUT2A                                                    SNUP0128
       TRA     1B                                                       SNUP0129
*                                                                       SNUP0130
 NURAC CAL     TPUCSH             A TRA PUTCSH                          SNUP0131
       TRA     NUPAC+1                                                  SNUP0132
*                                                                       SNUP0133
 NUPAL CAL     TPUSPH             A TRA PUTSPH                          SNUP0134
       TRA     NUPAC+1                                                  SNUP0135
*                                                                       SNUP0136
NURABT CAL     TPUTSB             A TRA PUTTSB                          SNUP0137
       SLW     OUT4B                                                    SNUP0138
       CAL     TRA2B              TRA    2B                             SNUP0139
       SLW     OUT1A                                                    SNUP0140
       CAL     TRA4B              TRA   4B                              SNUP0141
       SLW     OUT3A                                                    SNUP0142
       TRA     1A                                                       SNUP0143
*                                                                       SNUP0144
NUWABT CAL     TPUSTB             A TRA PUTSTB                          SNUP0145
       TRA     NURABT+1                                                 SNUP0146
*                                                                       SNUP0147
SAVER  SXA     SAV2,2                                                   SNUP0148
       SXA     SAV1,1                                                   SNUP0149
       AXT     SAVER,1                                                  SNUP0150
       SXD     PUTTSH-2,4         IN CASE STANDARD ERROR PROC. USED     SNUP0151
       CLA     ANOP         FOR INITIAL ENTRY CONDITIONS                SNUP0152
       STO     TOCALL-1                                                 SNUP0153
       LXD     PUTTSH-2,2      THE FOLLOWING INSTRUCTION,NOTAP WILL     SNUP0154
*                              BE A CLA  1,2 FOR RTNS. TSB,TSH,STH,STB. SNUP0155
*                              AND FOR RTNS. SCH,CSH,SPH IT WILL BE     SNUP0156
*                              A  TXI  STLOC,2,1 SINCE THEY USE NO TAPESSNUP0157
*                                                                       SNUP0158
NOTAP  NOP     0        WILL CONTAIN A CLA 1,2 FOR TAPE NUMBER IN ARGU. SNUP0159
       ALS     18                 PUT INTO DECREMENT OF TAPNU           SNUP0160
       STO     TAPNU                                                    SNUP0161
*                                                                       SNUP0162
*                     THE FOLLOWING INSTRUCTION (STLOC) WILL BE A CLA2,2SNUP0163
*                     FOR TSH,STH,SCH,CSH,SPH SINCE THEY USE FORMAT STATSNUP0164
*                     AND FOR THE BINARY STB,TSB  IT IS A TXI  TNARG,2,1SNUP0165
*                                                                       SNUP0166
STLOC  HTR     0                  LOC. OF FORMAT IN MAIN PROGRAM (2,2)  SNUP0167
*                                 TOOK OUT  STA ONEDC                   SNUP0168
*                                 TOOK OUT CLA  ONEDC                   SNUP0169
       STO     LCFOR                                                    SNUP0170
*                                                                       SNUP0171
TNARG  CAL     3,2                LOC. OF ARRAY IN MAIN PROGRAM         SNUP0172
       ARS     15                                                       SNUP0173
       LAS     ATSXZ              IS NEXT WORDS A TSX WITH TAG OF ZERO  SNUP0174
 TREST TRA     RESTOR                                                   SNUP0175
       TRA     *+2                YES                                   SNUP0176
       TRA     RESTOR             NO                                    SNUP0177
       CLA     3,2                                                      SNUP0178
       ADD     AONE               LOC. +1 FOR FORTRAN ROUTINES          SNUP0179
       STA     LCARY                                                    SNUP0180
AGAIN  CAL     4,2                SIZE OF ARRAY IN PROGRAM              SNUP0181
       ARS     15                                                       SNUP0182
       LAS     ATSXZ                                                    SNUP0183
       TRA     RESTOW   IF LAST ARGUMENT NOT GIVEN - SUPPLY A ONE       SNUP0184
       TRA     *+2                                                      SNUP0185
       TRA     RESTOW                                                   SNUP0186
       CLA     4,2                                                      SNUP0187
STRSZ  STA     LCSZE                                                    SNUP0188
*                 THE FOLLOW. INST. FOR STH,TSH,STB,TSB=CAL TAPNU       SNUP0189
*                 AND FOR SCH,CSH,SPH IT IS A NOP (THEY USE NO TAPES)   SNUP0190
       HTR     0                  CAL TAPNU  OR NOP                     SNUP0191
       NOP      INITIALLY=NOP, THEREAFTER A TRA TOSLR                   SNUP0192
TOCALL TSX     **,4               TO FORTRAN ROUTINE TO BE USED         SNUP0193
*                  NEXT INST. = NOP FOR TSB,STB. AND FOR ALL OTHERS     SNUP0194
*                  IT IS A TSX **,0,0  **=WHERE FORMAT IS STORED(FOWAR) SNUP0195
 LCFOR TSX     0,0,0  WILL GIVE ADDRESS OF FORMAT (STORED FOWARDS)      SNUP0196
TOSLR  TSX     **,4               TO SLO OR SLI                         SNUP0197
LCARY  PZE     **                 LOC. +1 PF ARRAY                      SNUP0198
LCSZE  PZE     **                 SIZE OF THE ARRAY                     SNUP0199
       CLA     TTOSLR           A TRA TOSLR                             SNUP0200
       STO     TOCALL-1      IF MORE ARGUMENTS SKIP THE TSX TO CALL.PROGSNUP0201
       TXI     TNARG,2,-2                                               SNUP0202
*                                                                       SNUP0203
RESTOW TXI     *+1,2,1            IF LAST ARG. NOT GIVEN SUPPLY A ONE   SNUP0204
       CLA     AONE               AND ADJUST INDEX 2 FOR PROPER RETURN  SNUP0205
       TRA     STRSZ                                                    SNUP0206
*                                                                       SNUP0207
RESTOR TXL     NOLIST,1,SAVER                                           SNUP0208
       TSX     **,4     TO FIL,RTN,RLR, OR WLR                          SNUP0209
       STZ     LCARY                                                    SNUP0210
 SAV1  AXT     **,1                                                     SNUP0211
       PXA     0,2                                                      SNUP0212
SAV2   AXT     **,2                                                     SNUP0213
       PAX     0,4                                                      SNUP0214
       TRA     3,4                RETURN TO CALLING PROGRAM             SNUP0215
*                                                                       SNUP0216
NOLIST TXI     *+1,1,1                                                  SNUP0217
       CAL     RESTOR+1                                                 SNUP0218
       SLW     TOSLR                                                    SNUP0219
       CAL     ATREST                                                   SNUP0220
       SLW     LCARY                                                    SNUP0221
       TRA     STRSZ+1                                                  SNUP0222
*                       FOLLOWING ENTRIES FOR BACK,REW,WEOF.          NUSNUP0223
*                       THESE REQUIRE SPECIAL HANDLING.               NUSNUP0224
NUBACK CAL     ATBST          TSX BST,4                                 SNUP0225
       SLW     GOTOFR                                                   SNUP0226
       CAL     ANOP                                                     SNUP0227
       SLW     ANEW                                                     SNUP0228
       CAL     ATXI2                                                    SNUP0229
       SLW     NDLOOP                                                   SNUP0230
       TRA     SAVER2                                                   SNUP0231
NUWEOF CAL     ATEFT          TSX  EFT,4                                SNUP0232
       SLW     GOTOFR                                                   SNUP0233
       TRA     *+3                                                      SNUP0234
NUREW  CAL     ATRWT          TSX  RWT,4                                SNUP0235
       SLW     GOTOFR                                                   SNUP0236
       CAL     ATXI1                                                    SNUP0237
       SLW     NDLOOP                                                   SNUP0238
       CAL     ATRA                                                     SNUP0239
       SLW     ANEW           A  TRA START                              SNUP0240
SAVER2 SXA     SAVX2,2                                                  SNUP0241
       SXA     SAVX1,1                                                  SNUP0242
       AXT     0,1                                                      SNUP0243
       SXD     PUTTSH-2,4     IN CASE STANDARD ERROR PROC. USED         SNUP0244
       LXD     PUTTSH-2,2                                               SNUP0245
TNARG2 CAL     1,2            TAPE NUMBER                               SNUP0246
       ARS     15             ISOLATE OPERATION AND TAG                 SNUP0247
       LAS     ATSXZ          COMPARE WITH A TSX  ZERO                  SNUP0248
       TRA     RESTT          NOT ANOTHER ARGUMENT                      SNUP0249
       TRA     *+2            YES                                       SNUP0250
       TRA     RESTT          NO                                        SNUP0251
 ANEW  NOP              FOR NUBACK A NOP. FOR NUEOF,NUREW A TRA START.  SNUP0252
       CAL     2,2            FOR BACK 2,2 IS NO. OF RECORDS TO BKSPCE  SNUP0253
       ARS     15                                                       SNUP0254
       LAS     ATSXZ        IS EVEN  ARGUMENT A TSX ZERO                SNUP0255
       TRA     RESTW          NO. GO TO SUPPLY A ONE.                   SNUP0256
       TRA     *+2                                                      SNUP0257
       TRA     RESTW                                                    SNUP0258
       CAL     2,2                                                      SNUP0259
       PAX     0,1            NUMBER OF RECORDS TO BACKSPACE TO INDEX 1 SNUP0260
START  CLA     1,2          TAPE NUMBER                                 SNUP0261
       ALS     18                                                       SNUP0262
       STO     TAPNU                                                    SNUP0263
LOKTNU CAL     TAPNU                                                    SNUP0264
GOTOFR TSX     **,4           TO FORTRAN SUBROUTINE INVOLVED            SNUP0265
       TIX     LOKTNU,1,1     X1=0 FOR WEOF AND REW                     SNUP0266
NDLOOP TXI     0,0,0  FOR BACK=TXI TNARG2,2,-2. OTHERS= TXI TNARG2,2,-1 SNUP0267
*                                                                       SNUP0268
 RESTW CLA     1,2                   TAPE NUMBER                       SSNUP0269
       TXI     *+1,2,1     FIX INDEX TWO FOR PROPER RETURN TO MAIN      SNUP0270
       AXT     0,1          MAKE LAST ARG. =1 FOR NUBACK                SNUP0271
       TRA     START+1                                                  SNUP0272
*                                                                       SNUP0273
 RESTT PXA     0,2                                                      SNUP0274
 SAVX2 AXT     **,2                                                     SNUP0275
 SAVX1 AXT     **,1                                                     SNUP0276
       PAX     0,4            C(X2) INTO X4                             SNUP0277
       TRA     1,4            RETURN TO CALLING PROGRAM                 SNUP0278
*                                                                       SNUP0279
TPUSTH TRA     PUTSTH                                                   SNUP0280
TPUTSH TRA     PUTTSH                                                   SNUP0281
TPUSCH TRA     PUTSCH                                                   SNUP0282
TPUCSH TRA     PUTCSH                                                   SNUP0283
TPUSPH TRA     PUTSPH                                                   SNUP0284
TPUTSB TRA     PUTTSB                                                   SNUP0285
TPUSTB TRA     PUTSTB                                                   SNUP0286
*                                                                       SNUP0287
TRA2A  TRA     2A                                                       SNUP0288
TRA2B  TRA     2B                                                       SNUP0289
TRA3A  TRA     3A                                                       SNUP0290
TRA3B  TRA     3B                                                       SNUP0291
TRA4B  TRA     4B                                                       SNUP0292
*                                                                       SNUP0293
TTSH   TSX     $(TSH),4                                                 SNUP0294
TSTH   TSX     $(STH),4                                                 SNUP0295
TTSB   TSX     $(TSB),4                                                 SNUP0296
TSTB   TSX     $(STB),4                                                 SNUP0297
TSCH   TSX     $(SCH),4                                                 SNUP0298
TCSH   TSX     $(CSH),4                                                 SNUP0299
TSPH   TSX     $(SPH),4                                                 SNUP0300
TSLO   TSX     $(SLO),4                                                 SNUP0301
TSLI   TSX     $(SLI),4                                                 SNUP0302
TFIL   TSX     $(FIL),4                                                 SNUP0303
TRTN   TSX     $(RTN),4                                                 SNUP0304
TRLR   TSX     $(RLR),4                                                 SNUP0305
TWLR   TSX     $(WLR),4                                                 SNUP0306
ATBST  TSX     $(BST),4                                                 SNUP0307
ATEFT  TSX     $(EFT),4                                                 SNUP0308
ATRWT  TSX     $(RWT),4                                                 SNUP0309
*                                                                       SNUP0310
APZE   PZE                                                              SNUP0311
AONE   PZE     1,0,0                                                    SNUP0312
*                                 TOOK OUT SYMBOLIC LOC. ONEDC          SNUP0313
ATSXZ  OCT     0074000                                                  SNUP0314
CALT   CAL     TAPNU                                                    SNUP0315
ATREST TRA     RESTOR+2                                                 SNUP0316
 ATRA  TRA     START                                                    SNUP0317
TTOSLR TRA     TOSLR                                                    SNUP0318
ANOP   NOP                                                              SNUP0319
ACLA1  CLA     1,2                                                      SNUP0320
ACLA2  CLA     2,2                                                      SNUP0321
ATXIA  TXI     STLOC,2,1                                                SNUP0322
ATXIB  TXI     TNARG,2,1                                                SNUP0323
ATXI1  TXI     TNARG2,2,-1                                              SNUP0324
ATXI2  TXI     TNARG2,2,-2                                              SNUP0325
TAPNU  PZE                                                              SNUP0326
       END                                                              SNUP0327
*THE FOLLOWING TWO CARDS SHOULD BE SUBSTITUTED IN THE DECK IF ASSEMBLY  SNUP0328
* IS MADE WITH A SYSTEM WHICH DOES NOT CONTAIN THE STANDARD ERROR PRO-  SNUP0329
*CEDURE.  THE PROGRAM STORES INDEX 4 IN THE PLACE OCCUPIED BY THE PZE.  SNUP0330
       PZE       TO BE USED IF STANDARD ERROR NOT IN SYSTEM. SNUP00042  SNUP0331
       BCI     1,NUSNUP  USE IF STANDARD ERROR NOT IN SYSTEM SNUP0043   SNUP0332
***************     LAST CARD NUSNUP                                    SNUP0333
