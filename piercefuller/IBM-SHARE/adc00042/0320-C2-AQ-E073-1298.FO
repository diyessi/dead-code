*      LIST8                                                            E73 0001
*     LIBE                                                              E73 0002
*      LABEL                                                            E73 0003
C E73                                                                   E73 0004
  100 FORMAT(I3)                                                        E73 0005
  110 FORMAT(5E14.8)                                                    E73 0006
  120 FORMAT(11H1  N EQUALSI9)                                          E73 0007
  130 FORMAT(6E20.8)                                                    E73 0008
  140 FORMAT(22H0 LIST OF COEFFICIENTS)                                 E73 0009
  150 FORMAT(119H0      ROOTR               ROOTI               ROOTR   E73 0010
     *            ROOTI               ROOTR               ROOTI        )E73 0011
      DIMENSION COE(3,51),ROOTR(3,50),ROOTI(3,50)                       E73 0012
      COMMON COE,N1,ROOTR,ROOTI                                         E73 0013
   10 READ INPUT TAPE 7,100,N1                                          E73 0014
      N3 = N1                                                           E73 0015
      N2 = N1+1                                                         E73 0016
      READ INPUT TAPE 7,110,(COE(1,I),I=1,N2)                           E73 0017
      WRITE OUTPUT TAPE 6,120,N1                                        E73 0018
      WRITE OUTPUT TAPE 6,140                                           E73 0019
      WRITE OUTPUT TAPE 6,130,(COE(1,I),I=1,N2)                         E73 0020
      CALL MULLER                                                       E73 0021
      WRITE OUTPUT TAPE 6,150                                           E73 0022
      WRITE OUTPUT TAPE 6,130,(ROOTR(1,I),ROOTI(1,I),I=1,N3)            E73 0023
      GOTO 10                                                           E73 0024
      END                                                               E73 0025
*     LIST8                                                             E73 0026
*     LIBE                                                              E73 0027
      SUBROUTINE MULLER                                                 E73 0028
      CON1 = 0.                                                         E73 0029
      CON2 = 0.8                                                        E73 0030
      CON3 = 0.85                                                       E73 0031
      CON4 = 0.9                                                        E73 0032
      CON5 = 1.0                                                        E73 0033
      CON6 = 2.0                                                        E73 0034
      CON7 = 4.0                                                        E73 0035
      CON8 = 0.5                                                        E73 0036
      CON9 = 1.E-20                                                     E73 0037
      CON10 =1.E-7                                                      E73 0038
      CON11 =1.E-5                                                      E73 0039
      DIMENSION COE(3,51),ROOTR(3,50),ROOTI(3,50)                       E73 0040
      DIMENSION AXR(3),AXI(3),ALP1R(3),ALP1I(3),BET1R(3),TEMR(3),BET1I  E73 0041
     *(3),TEMI(3),ALP2R(3),ALP2I(3),BET2R(3),BET2I(3),ALP3R(3),ALP3I(3),E73 0042
     *BET3R(3),BET3I(3),TE1(3),TE2(3),TE5(3),TE6(3),TEM(3),TE3(3),TE4(3)E73 0043
     *,TE7(3),TE9(3),TE10(3),DE15(3),DE16(3),TE11(3),TE12(3),TE13(3),   E73 0044
     *TE14(3),TE15(3),TE16(3),TE8(3),ALP4R(3),ALP4I(3),HELL(3),BELL(3), E73 0045
     *TEM1(3),TEM2(3)                                                   E73 0046
      DIMENSION XCON1(3),XCON2(3),XCON3(3),XCON4(3),XCON5(3),XCON6(3),  E73 0047
     *XCON7(3),XCON8(3),XCON9(3),XCON10(3),XCON11(3)                    E73 0048
      DIMENSION Z1(3),Z2(3),Z4(3),Z5(3),Z6(3),Z3(3)                     E73 0049
      COMMON COE,N1,                                                    E73 0050
     *           ROOTR,ROOTI,AXR,AXI,ALP1R,ALP1I,BET1R,TEMR,BET1I,TEMI, E73 0051
     *ALP2R,ALP2I,BET2R,BET2I,ALP3R,ALP3I,BET3R,BET3I,TE1,TE2,TE5,TE6,  E73 0052
     *TEM,TE3,TE4,TE7,TE9,TE10,DE15,DE16,TE11,TE12,TE13,TE14,TE15,TE16, E73 0053
     *TE8,ALP4R,ALP4I,HELL,BELL,TEM1,TEM2                               E73 0054
      COMMON CON1,CON2,CON3,CON4,CON5,CON6,CON7,CON8,CON9,CON10,CON11   E73 0055
      COMMON Z1,Z2,Z3,Z4,Z5,Z6                                          E73 0056
      COMMON XCON1,XCON2,XCON3,XCON4,XCON5,XCON6,XCON7,XCON8,XCON9,     E73 0057
     *XCON10,XCON11                                                     E73 0058
      CALL LLNPRC (XCON11)                                              E73 0059
      CALL SP2NP(CON1,XCON1,CON2,XCON2,CON3,XCON3,CON4,XCON4,CON5,XCON5)E73 0060
      CALL SP2NP(CON6,XCON6,CON7,XCON7,CON8,XCON8,CON9,XCON9)           E73 0061
      CALL SP2NP(CON10,XCON10,CON11,XCON11)                             E73 0062
      N111=N1+1                                                         E73 0063
      DO 2 I=1,N111                                                     E73 0064
 2    CALL SP2NP(COE(1,I),COE(1,I))                                     E73 0065
      N2=N1+1                                                           E73 0066
      N4=0                                                              E73 0067
      I=N1+1                                                            E73 0068
   19 CALL NPREC                                                        E73 0069
      IF(COE(1,I))9,7,9                                                 E73 0070
    7 CALL NPOUT                                                        E73 0071
      N4=N4+1                                                           E73 0072
      CALL NPREC                                                        E73 0073
      ROOTR(1,N4) = XCON1                                               E73 0074
      ROOTI(1,N4) = XCON1                                               E73 0075
      CALL NPOUT                                                        E73 0076
      I=I-1                                                             E73 0077
      IF(N4-N1)19,37,19                                                 E73 0078
    9 CONTINUE                                                          E73 0079
  10  AXR=XCON2                                                         E73 0080
      AXI = XCON1                                                       E73 0081
      CALL NPOUT                                                        E73 0082
      L=1                                                               E73 0083
      N3=1                                                              E73 0084
      M=1                                                               E73 0085
      CALL NPREC                                                        E73 0086
      ALP1R=AXR                                                         E73 0087
      ALP1I=AXI                                                         E73 0088
      GOTO99                                                            E73 0089
   11 BET1R=TEMR                                                        E73 0090
      BET1I=TEMI                                                        E73 0091
      AXR = XCON3                                                       E73 0092
      ALP2R=AXR                                                         E73 0093
      ALP2I=AXI                                                         E73 0094
      CALL NPOUT                                                        E73 0095
      M=2                                                               E73 0096
      CALL NPREC                                                        E73 0097
      GOTO99                                                            E73 0098
   12 BET2R=TEMR                                                        E73 0099
      BET2I=TEMI                                                        E73 0100
      AXR =XCON4                                                        E73 0101
      ALP3R=AXR                                                         E73 0102
      ALP3I=AXI                                                         E73 0103
      CALL NPOUT                                                        E73 0104
      M=3                                                               E73 0105
      CALL NPREC                                                        E73 0106
      GOTO99                                                            E73 0107
   13 BET3R=TEMR                                                        E73 0108
      BET3I=TEMI                                                        E73 0109
   14 TE1=ALP1R-ALP3R                                                   E73 0110
      TE2=ALP1I-ALP3I                                                   E73 0111
      TE5=ALP3R-ALP2R                                                   E73 0112
      TE6=ALP3I-ALP2I                                                   E73 0113
      Z1=TE5*TE5                                                        E73 0114
      Z2=TE6*TE6                                                        E73 0115
      TEM=Z1+Z2                                                         E73 0116
      Z1=TE1*TE5                                                        E73 0117
      Z2=TE2*TE6                                                        E73 0118
      Z3=Z1+Z2                                                          E73 0119
      TE3=Z3/TEM                                                        E73 0120
      Z1=TE2*TE5                                                        E73 0121
      Z2=TE1*TE6                                                        E73 0122
      Z3=Z1-Z2                                                          E73 0123
      TE4=Z3/TEM                                                        E73 0124
      TE7 = TE3+ XCON5                                                  E73 0125
      Z1=TE3*TE3                                                        E73 0126
      Z2=TE4*TE4                                                        E73 0127
      TE9=Z1-Z2                                                         E73 0128
      Z1=XCON6*TE3                                                      E73 0129
      TE10=Z1*TE4                                                       E73 0130
      Z1=TE7*BET3R                                                      E73 0131
      Z2=TE4*BET3I                                                      E73 0132
      DE15=Z1-Z2                                                        E73 0133
      Z1=TE7*BET3I                                                      E73 0134
      Z2=TE4*BET3R                                                      E73 0135
      DE16=Z1+Z2                                                        E73 0136
      Z1=TE3*BET2R                                                      E73 0137
      Z2=TE4*BET2I                                                      E73 0138
      TE11=Z1-Z2+BET1R-DE15                                             E73 0139
      Z1=TE3*BET2I                                                      E73 0140
      Z2=TE4*BET2R                                                      E73 0141
      TE12=Z1+Z2+BET1I-DE16                                             E73 0142
      TE7 = TE9 - XCON5                                                 E73 0143
      Z1=TE9*BET2R                                                      E73 0144
      Z2=TE10*BET2I                                                     E73 0145
      TE1=Z1-Z2                                                         E73 0146
      Z1=TE9*BET2I                                                      E73 0147
      Z2=TE10*BET2R                                                     E73 0148
      TE2=Z1+Z2                                                         E73 0149
      Z1=TE7*BET3R                                                      E73 0150
      Z2=TE10*BET3I                                                     E73 0151
      TE13=TE1-BET1R-Z1+Z2                                              E73 0152
      Z1=TE7*BET3I                                                      E73 0153
      Z2=TE10*BET3R                                                     E73 0154
      TE14=TE2-BET1I-Z1-Z2                                              E73 0155
      Z1=DE15*TE3                                                       E73 0156
      Z2=DE16*TE4                                                       E73 0157
      TE15=Z1-Z2                                                        E73 0158
      Z1=DE15*TE4                                                       E73 0159
      Z2=DE16*TE3                                                       E73 0160
      TE16=Z1+Z2                                                        E73 0161
      Z1=TE13*TE13                                                      E73 0162
      Z2=TE14*TE14                                                      E73 0163
      Z3=TE11*TE15                                                      E73 0164
      Z4=TE12*TE16                                                      E73 0165
      Z5=Z3-Z4                                                          E73 0166
      Z6=XCON7*Z5                                                       E73 0167
      TE1=Z1-Z2-Z6                                                      E73 0168
      Z1=XCON6*TE13                                                     E73 0169
      Z2=Z1*TE14                                                        E73 0170
      Z3=TE12*TE15                                                      E73 0171
      Z4=TE11*TE16                                                      E73 0172
      Z5=Z3+Z4                                                          E73 0173
      Z6=XCON7*Z5                                                       E73 0174
      TE2=Z2-Z6                                                         E73 0175
      Z1=TE1*TE1                                                        E73 0176
      Z2=TE2*TE2                                                        E73 0177
      Z3=Z1+Z2                                                          E73 0178
      TEM=DPSQT(Z3)                                                     E73 0179
      IF(TE1)113,113,112                                                E73 0180
  113 Z1=TEM-TE1                                                        E73 0181
      Z2=XCON8*Z1                                                       E73 0182
      TE4=DPSQT(Z2)                                                     E73 0183
      Z1=TE2/TE4                                                        E73 0184
      TE3=XCON8*Z1                                                      E73 0185
      GO TO 111                                                         E73 0186
  112 Z1=TEM+TE1                                                        E73 0187
      Z2=XCON8*Z1                                                       E73 0188
      TE3=DPSQT(Z2)                                                     E73 0189
      IF(TE2)110,200,200                                                E73 0190
  110 TE3=-TE3                                                          E73 0191
  200 Z1=TE2/TE3                                                        E73 0192
      TE4=XCON8*Z1                                                      E73 0193
  111 TE7=TE13+TE3                                                      E73 0194
      TE8=TE14+TE4                                                      E73 0195
      TE9=TE13-TE3                                                      E73 0196
      TE10=TE14-TE4                                                     E73 0197
      TE1= XCON6 * TE15                                                 E73 0198
      TE2= XCON6 * TE16                                                 E73 0199
      Z1=TE7*TE7                                                        E73 0200
      Z2=TE8*TE8                                                        E73 0201
      Z3=TE9*TE9                                                        E73 0202
      Z4=TE10*TE10                                                      E73 0203
      IF(Z1+Z2-Z3-Z4)204,204,205                                        E73 0204
  204 TE7=TE9                                                           E73 0205
      TE8=TE10                                                          E73 0206
  205 Z1=TE7*TE7                                                        E73 0207
      Z2=TE8*TE8                                                        E73 0208
      TEM=Z1+Z2                                                         E73 0209
      Z1=TE1*TE7                                                        E73 0210
      Z2=TE2*TE8                                                        E73 0211
      Z3=Z1+Z2                                                          E73 0212
      TE3=Z3/TEM                                                        E73 0213
      Z1=TE2*TE7                                                        E73 0214
      Z2=TE1*TE8                                                        E73 0215
      Z3=Z1-Z2                                                          E73 0216
      TE4=Z3/TEM                                                        E73 0217
      Z1=TE3*TE5                                                        E73 0218
      Z2=TE4*TE6                                                        E73 0219
      AXR=ALP3R+Z1-Z2                                                   E73 0220
      Z1=TE3*TE6                                                        E73 0221
      Z2=TE4*TE5                                                        E73 0222
      AXI=ALP3I+Z1+Z2                                                   E73 0223
      ALP4R=AXR                                                         E73 0224
      ALP4I=AXI                                                         E73 0225
      CALL NPOUT                                                        E73 0226
      M=4                                                               E73 0227
      CALL NPREC                                                        E73 0228
      GO TO 99                                                          E73 0229
   15 CALL NPOUT                                                        E73 0230
      N6=1                                                              E73 0231
   38 CALL NPREC                                                        E73 0232
      IF(ABSF(HELL)+ABSF(BELL)- XCON9)18,18,16                          E73 0233
   16 TE7=ABSF(ALP3R-AXR)+ABSF(ALP3I-AXI)                               E73 0234
      Z1=ABSF(AXR)+ABSF(AXI)-XCON10                                     E73 0235
      IF(TE7/Z1)18,18,17                                                E73 0236
   17 CALL NPOUT                                                        E73 0237
      N3 = N3+1                                                         E73 0238
      CALL NPREC                                                        E73 0239
      ALP1R=ALP2R                                                       E73 0240
      ALP1I=ALP2I                                                       E73 0241
      ALP2R=ALP3R                                                       E73 0242
      ALP2I=ALP3I                                                       E73 0243
      ALP3R=ALP4R                                                       E73 0244
      ALP3I=ALP4I                                                       E73 0245
      BET1I=BET2I                                                       E73 0246
      BET2R=BET3R                                                       E73 0247
      BET2I=BET3I                                                       E73 0248
      BET3R=TEMR                                                        E73 0249
      BET3I=TEMI                                                        E73 0250
      BET1R=BET2R                                                       E73 0251
      CALL NPOUT                                                        E73 0252
      IF(N3-100)1040,18,18                                              E73 0253
   18 CALL NPOUT                                                        E73 0254
      N4=N4+1                                                           E73 0255
      CALL NPREC                                                        E73 0256
      ROOTR(1,N4) = ALP4R                                               E73 0257
      ROOTI(1,N4) = ALP4I                                               E73 0258
      CALL NPOUT                                                        E73 0259
      N3=0                                                              E73 0260
   41 IF(N4-N1)30,37,37                                                 E73 0261
 37   DO 3 I=1,N111                                                     E73 0262
 3    CALL NP2SP(ROOTR(1,I),ROOTR(1,I),ROOTI(1,I),ROOTI(1,I))           E73 0263
      RETURN                                                            E73 0264
   30 CALL NPREC                                                        E73 0265
      IF(ABSF(ROOTI(1,N4))-XCON11)10,10,31                              E73 0266
   31 GO TO(32,10),L                                                    E73 0267
   32 AXR=ALP1R                                                         E73 0268
      AXI=-ALP1I                                                        E73 0269
      ALP1I=-ALP1I                                                      E73 0270
      CALL NPOUT                                                        E73 0271
      M=5                                                               E73 0272
      CALL NPREC                                                        E73 0273
      GO TO 99                                                          E73 0274
   33 BET1R=TEMR                                                        E73 0275
      BET1I=TEMI                                                        E73 0276
      AXR=ALP2R                                                         E73 0277
      AXI=-ALP2I                                                        E73 0278
      ALP2I=-ALP2I                                                      E73 0279
      CALL NPOUT                                                        E73 0280
      M=6                                                               E73 0281
      CALL NPREC                                                        E73 0282
      GO TO 99                                                          E73 0283
   34 BET2R=TEMR                                                        E73 0284
      BET2I=TEMI                                                        E73 0285
      AXR=ALP3R                                                         E73 0286
      AXI=-ALP3I                                                        E73 0287
      ALP3I=-ALP3I                                                      E73 0288
      CALL NPOUT                                                        E73 0289
      L=2                                                               E73 0290
      M=3                                                               E73 0291
      CALL NPREC                                                        E73 0292
   99 TEMR = COE(1,1)                                                   E73 0293
      TEMI = XCON1                                                      E73 0294
      CALL NPOUT                                                        E73 0295
      DO100I=1,N1                                                       E73 0296
      CALL NPREC                                                        E73 0297
      Z1=TEMR*AXR                                                       E73 0298
      Z2=TEMI*AXI                                                       E73 0299
      TE1=Z1-Z2                                                         E73 0300
      Z1=TEMI*AXR                                                       E73 0301
      Z2=TEMR*AXI                                                       E73 0302
      TEMI=Z1+Z2                                                        E73 0303
  100 TEMR = TE1 + COE(1,I+1)                                           E73 0304
      HELL=TEMR                                                         E73 0305
      BELL=TEMI                                                         E73 0306
   42 IF(N4)102,103,102                                                 E73 0307
  102 CALL NPOUT                                                        E73 0308
      DO101 I = 1,N4                                                    E73 0309
      CALL NPREC                                                        E73 0310
      TEM1 = AXR - ROOTR(1,I)                                           E73 0311
      TEM2 = AXI - ROOTI(1,I)                                           E73 0312
      Z1=TEM1*TEM1                                                      E73 0313
      Z2=TEM2*TEM2                                                      E73 0314
      TE1=Z1+Z2                                                         E73 0315
      Z1=TEMR*TEM1                                                      E73 0316
      Z2=TEMI*TEM2                                                      E73 0317
      Z3=Z1+Z2                                                          E73 0318
      TE2=Z3/TE1                                                        E73 0319
      Z1=TEMI*TEM1                                                      E73 0320
      Z2=TEMR*TEM2                                                      E73 0321
      Z3=Z1-Z2                                                          E73 0322
      TEMI=Z3/TE1                                                       E73 0323
  101 TEMR=TE2                                                          E73 0324
  103 GO TO(11,12,13,15,33,34),M                                        E73 0325
 1040 CALL NPREC                                                        E73 0326
      GOTO 14                                                           E73 0327
      END                                                               E73 0328
