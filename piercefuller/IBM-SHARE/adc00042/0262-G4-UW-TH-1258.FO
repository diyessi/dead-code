      DIMENSION N(10),S(20,20), D( 40,40) , XK(20, 100), YK(100,20),    UWTH 001
     1AK(40,80) ,AKI(40,40), GK(20,20),BK(20,20),TEMP(20,20),BS(20,20), UWTH 002
     2BE(40, 40 ), STOR(40,40) , Z(40,40), VL(40,40) ,TES(20,20),       UWTH 003
     3BB(40, 40 )                                                       UWTH 004
      COMMON AK                                                         UWTH 005
    1 FORMAT(I5,I5,I5)                                                  UWTH 006
    2 FORMAT(12(I5))                                                    UWTH 007
    3 FORMAT(5(E14.7))                                                  UWTH 008
    4 FORMAT (I5)                                                       UWTH 009
    5 FORMAT(1H155(1H )3HX (I2,1H))                                     UWTH 010
    6 FORMAT(1H025(1H )5HROW (I5,1H))                                   UWTH 011
    7 FORMAT (12F5.0)                                                   UWTH 012
    8 FORMAT(    7(E17.7))                                              UWTH 013
   10 FORMAT(1H155(1H )3HY (I2,1H))                                     UWTH 014
   11 FORMAT (   23F5.0)                                                UWTH 015
   12 FORMAT(1H145(1H )3HA (I2, 9H) INVERSE)                            UWTH 016
   14 FORMAT(1H155(1H )3HB (I2,1H))                                     UWTH 017
   15 FORMAT(1H155(1H )10HMATRIX L( I5,1H))                             UWTH 018
   16 FORMAT(21H1DETERMINANT OF S IS E15.7)                             UWTH 019
   17 FORMAT(23H0DETERMINANT OF S+T IS E15.7)                           UWTH 020
   18 FORMAT(3H0U=E15.7,9(1H )5HM(1)=E15.7,9(1H )5HM(2)=E15.7,9(1H )11H-UWTH 021
     1M(1)LN(U)=E15.7 )                                                 UWTH 022
      READ INPUT TAPE 5,6012,NTUFE,NBUFE                                UWTH 023
 6012 FORMAT(2I5)                                                       UWTH 024
      READ INPUT TAPE 5,1,NC,NQ,NP                                      UWTH 025
      READ INPUT TAPE 5,2, (N(I),I=1,NC)                                UWTH 026
      DO  80 I=1, NP                                                    UWTH 027
      DO  80 J=1, NP                                                    UWTH 028
   80 S(I,J)=0.                                                         UWTH 029
      NCQ= NC*NQ                                                        UWTH 030
      DO 81 I=1,NCQ                                                     UWTH 031
      DO 81 J=1,NCQ                                                     UWTH 032
   81 D(I,J)=0.                                                         UWTH 033
      DO 104 K=1, NC                                                    UWTH 034
      NK=N(K)                                                           UWTH 035
      IF (NTUFE)  6013,6014,6013                                        UWTH 036
 6014 READ INPUT TAPE  5,3, (XK(1,J), J=1,NK)                           UWTH 037
      GO TO  6015                                                       UWTH 038
 6013 DO 6917  J=1,NK                                                   UWTH 039
 6917 XK(1,J)=1.                                                        UWTH 040
 6015 IF (NQ-1) 6016, 7010, 6016                                        UWTH 041
 6016 READ INPUT TAPE 5,3, (XK(2,J), J=1,NK)                            UWTH 042
      IF (NQ-2) 6017,7010,6017                                          UWTH 043
 6017 IF (NBUFE) 6018, 6019, 6018                                       UWTH 044
 6018 DO 6020 J=1,NK                                                    UWTH 045
 6020 XK (3,J) = XK(2,J)*XK(2,J)                                        UWTH 046
      GO TO 6021                                                        UWTH 047
 6019 READ INPUT TAPE 5,3, (XK(3,J),J=1,NK)                             UWTH 048
 6021 IF (NQ-3) 6022, 7010, 6022                                        UWTH 049
 6022 DO 6023 I=4,NQ                                                    UWTH 050
 6023 READ INPUT TAPE 5,3, (XK(I,J), J=1,NK)                            UWTH 051
 7010 CONTINUE                                                          UWTH 052
   85 WRITE OUTPUT TAPE 6, 5, K                                         UWTH 053
      DO 87 I=1,NQ                                                      UWTH 054
      WRITE OUTPUT TAPE 6, 6, I                                         UWTH 055
   87 WRITE OUTPUT TAPE 6, 8, (XK(I,J), J=1, NK)                        UWTH 056
      WRITE OUTPUT TAPE 6, 10,K                                         UWTH 057
      DO  88 I=1, NK                                                    UWTH 058
      READ INPUT TAPE 5, 3, (YK(I,J), J=1,NP )                          UWTH 059
      WRITE OUTPUT TAPE 6,6,I                                           UWTH 060
   88 WRITE OUTPUT TAPE 6,8, (YK(I,J),J=1,NP)                           UWTH 061
      DO 115  I=1,NQ                                                    UWTH 062
      DO 114  J=1,NQ                                                    UWTH 063
      AK(I,J)=0.                                                        UWTH 064
      DO 105  KK=1,NK                                                   UWTH 065
  105 AK(I,J)= AK(I,J)+ XK(I,KK)*XK(J,KK)                               UWTH 066
      L=NQ +J                                                           UWTH 067
  114 AK(I,L)=0.                                                        UWTH 068
      M=NQ+I                                                            UWTH 069
  115 AK(I,M)=1.                                                        UWTH 070
 1011 CALL MATS (     AKI, NQ ,NQ )                                     UWTH 071
      DO 2039 I=1,NQ                                                    UWTH 072
 2039 STOR(I,K) =AKI(I,I)                                               UWTH 073
 1010 WRITE OUTPUT TAPE 6, 12,  K                                       UWTH 074
      DO 116 I=1, NQ                                                    UWTH 075
      WRITE OUTPUT TAPE 6,6, I                                          UWTH 076
  116 WRITE OUTPUT TAPE 6,8, ( AKI(I,J),J=1, NQ)                        UWTH 077
      DO 106 I=1,NQ                                                     UWTH 078
      DO 106 J=1,NP                                                     UWTH 079
      GK(I,J)=0.                                                        UWTH 080
      DO 106 KK=1,NK                                                    UWTH 081
  106 GK(I,J)=  XK(I,KK)* YK(KK,J)+ GK(I,J)                             UWTH 082
      DO 107 I=1,NQ                                                     UWTH 083
      DO 107 J=1,NP                                                     UWTH 084
      BK(I,J)=0.                                                        UWTH 085
      DO 107 KK=1,NQ                                                    UWTH 086
  107 BK(I,J)=BK(I,J)+ AKI(I,KK)*GK(KK,J)                               UWTH 087
      DO 109 I=1,NP                                                     UWTH 088
      DO 109 J=1,NP                                                     UWTH 089
      TEMP(I,J)=0.                                                      UWTH 090
      DO 108KK=1,NK                                                     UWTH 091
  108 TEMP(I,J)=TEMP(I,J)+YK(KK,I)*YK(KK,J)                             UWTH 092
      BS(I,J)=0.                                                        UWTH 093
      DO 110 KK=1,NQ                                                    UWTH 094
  110 BS(I,J)=BS(I,J)+ BK(KK,I)* GK(KK,J)                               UWTH 095
      S(I,J)= S(I,J)+TEMP(I,J)-BS(I,J)                                  UWTH 096
  109 TES(I,J)=S(I,J)                                                   UWTH 097
      WRITE OUTPUT TAPE 6,14, K                                         UWTH 098
      DO  202  I=1, NQ                                                  UWTH 099
      WRITE OUTPUT TAPE 6, 6, I                                         UWTH 100
      WRITE OUTPUT TAPE 6, 8, ( BK(I,J),J=1, NP)                        UWTH 101
      L=(K-1)*NQ+I                                                      UWTH 102
      DO 203  J=1,NQ                                                    UWTH 103
      M=(K-1)* NQ+J                                                     UWTH 104
  203 D(L,M)= AKI(I,J)                                                  UWTH 105
      DO 202  J=1,NP                                                    UWTH 106
  202 BB(L,J)= BK(I,J)                                                  UWTH 107
  104 CONTINUE                                                          UWTH 108
      CALL DET (TES,      NP,DS)                                        UWTH 109
      NSUM=0                                                            UWTH 110
      DO705 I=1,NC                                                      UWTH 111
  705 NSUM= NSUM+N(I)                                                   UWTH 112
      VSUM1= NSUM-NCQ                                                   UWTH 113
      LZ=NP+1                                                           UWTH 114
      WRITE OUTPUT TAPE 6,4049                                          UWTH 115
 4049 FORMAT(58H1SAMPLE COVARIANCE MATRIX FOR THE DEPENDENT RAMDOM VECTOUWTH 116
     1R.)                                                               UWTH 117
      DO  4059 I=1,NP                                                   UWTH 118
      DO  4039 J=1,NP                                                   UWTH 119
 4039 VL(I,J)= S(I,J)/ VSUM1                                            UWTH 120
      WRITE OUTPUT TAPE 6, 6, I                                         UWTH 121
 4059 WRITE OUTPUT TAPE 6, 8,(VL(I,J), J=1,NP)                          UWTH 122
      WRITE OUTPUT TAPE 6, 5039                                         UWTH 123
 5039 FORMAT (70H1R MATRIX.  SAMPLE CORRELATION MATRIX FOR THE DEPENDENTUWTH 124
     1 RANDOM VECTOR.)                                                  UWTH 125
      DO 5059 J=1,NP                                                    UWTH 126
      DO 5049 K=1,NP                                                    UWTH 127
 5049 VL(J,K)= S(J,K)/(SQRTF(S(J,J)*S(K,K)))                            UWTH 128
      WRITE OUTPUT TAPE 6,6,J                                           UWTH 129
 5059 WRITE OUTPUT TAPE 6,8,(VL(J,K), K=1,NP)                           UWTH 130
      DO 2049 K=1,NC                                                    UWTH 131
      WRITE OUTPUT    TAPE 6,2029, K                                    UWTH 132
 2029 FORMAT (75H1MATRIX OF SAMPLE STANDARD DEVIATIONS FOR THE REGRESSIOUWTH 133
     1N COEFFICIENTS IN B(I3,1H))                                       UWTH 134
      DO 2049  I=1, NQ                                                  UWTH 135
      DO 2048  J=1, NP                                                  UWTH 136
 2048 Z (I,J)=SQRTF((STOR(I,K)* S(J,J))/ VSUM1)                         UWTH 137
C     WE HAVE FORMED THE MATRIX OF SAMPLE STANDARD DEVIATIONS FOR THE   UWTH 138
C      REGRESSION COEFFS. IN B(K)   AND STORED IN Z.                    UWTH 139
      WRITE OUTPUT TAPE 6, 6,I                                          UWTH 140
 2049 WRITE OUTPUT TAPE 6, 8, (Z(I,J),J=1,NP)                           UWTH 141
      READ INPUT TAPE 5,4, NGAM                                         UWTH 142
      DO  801 IJK=1, NGAM                                               UWTH 143
      WRITE OUTPUT TAPE 6,15, IJK                                       UWTH 144
      READ INPUT TAPE 5, 4, NARE                                        UWTH 145
      DO  701 I=1,NARE                                                  UWTH 146
      READ INPUT TAPE 5, 7, (VL(I,J) , J=1, NCQ )                       UWTH 147
      WRITE OUTPUT TAPE 6, 6, I                                         UWTH 148
      WRITE OUTPUT TAPE 6,11, (VL(I,J), J=1, NCQ)                       UWTH 149
 701  CONTINUE                                                          UWTH 150
      CALL MAMULT (VL, NARE,NCQ ,BB ,NP, Z )                            UWTH 151
C     LB IS IN  Z .  LB OF  DIM R BY P                                  UWTH 152
      DO 703 I=1, NCQ                                                   UWTH 153
      DO 703 J=1, NARE                                                  UWTH 154
  703 STOR(I,J)= VL(J,I)                                                UWTH 155
C     L TRANSPOSE IN  STOR  L TRANSPOSE OF DIM CQ BY R.                 UWTH 156
      CALL MAMULT(D,NCQ,NCQ, STOR, NARE,BE)                             UWTH 157
C     D*(L TRANSPOSE) IN BE. DIM IS CQ BY R.                            UWTH 158
      CALL MAMULT(VL,NARE,NCQ,BE,NARE, STOR)                            UWTH 159
C     U=L*(D* (L TRANSPOSE)) IS IN STOR.  DIM IS R BY R.                UWTH 160
      DO  761 I=1, NARE                                                 UWTH 161
      DO  760 J=1, NARE                                                 UWTH 162
      AK(I,J)= STOR(I,J)                                                UWTH 163
      L=J+NARE                                                          UWTH 164
  760 AK(I,L)= 0.                                                       UWTH 165
      M=I+NARE                                                          UWTH 166
  761 AK(I,M)=1.                                                        UWTH 167
      CALL MATS (    STOR, NARE, NARE)                                  UWTH 168
C     U INVERSE IN STOR                                                 UWTH 169
      CALL MAMULT(STOR,NARE,NARE,Z,NP, BE)                              UWTH 170
C     (U INVERSE)(LB)  IN BE .  DIM  IS R  BY P                         UWTH 171
      DO 762 I=1,NP                                                     UWTH 172
      DO 762 J=1,NARE                                                   UWTH 173
  762 STOR(I,J)=Z(J,I)                                                  UWTH 174
      CALL MAMULT(STOR,NP, NARE,BE, NP, Z)                              UWTH 175
C     WE NOW HAVE T IN Z.                                               UWTH 176
      DO 704  I=1,NP                                                    UWTH 177
      DO 704  J=1,NP                                                    UWTH 178
  704 GK (I,J)= S(I,J)+ Z(I,J)                                          UWTH 179
      CALL DET(GK,      NP,DFE)                                         UWTH 180
      U= DS/DFE                                                         UWTH 181
      ZL = LZ- NARE                                                     UWTH 182
      VM1 = VSUM1- .5*ZL                                                UWTH 183
      W=(NP* NARE)*( NP*NP + NARE*NARE -5)                              UWTH 184
      VM2 = W/(48.* VM1*VM1)                                            UWTH 185
      FINISH=-(VM1)* LOGF(U)                                            UWTH 186
      WRITE OUTPUT TAPE 6,16,DS                                         UWTH 187
      WRITE OUTPUT TAPE 6,17,DFE                                        UWTH 188
      WRITE OUTPUT TAPE 6,18,U, VM1,VM2 , FINISH                        UWTH 189
      GOOP= 2*NARE*NP-1                                                 UWTH 190
      GOOP= SQRTF(GOOP)-SQRTF(2.*FINISH)                                UWTH 191
      WRITE OUTPUT TAPE 6 ,9606, GOOP                                   UWTH 192
 9606 FORMAT(29H0THE NORMALIZED STATISTIC IS E15.7)                     UWTH 193
  801 CONTINUE                                                          UWTH 194
      CALL EXIT                                                         UWTH 195
       END                                                              UWTH 196
      SUBROUTINE DET(A,      N,CET)                                     UWTH 197
      DIMENSION A(20,20)                                                UWTH 198
      CET=1.                                                            UWTH 199
      IF(N-1)  16, 16, 6                                                UWTH 200
 6    DO 15 I=2,N                                                       UWTH 201
 70   II=I-1                                                            UWTH 202
 7    DO 15 J=1,II                                                      UWTH 203
 8    IF (A(I,J))9,15,9                                                 UWTH 204
 9    IF(ABSF(A(J,J))-ABSF(A(I,I)))11,10,10                             UWTH 205
 10   R=A(I,J)/A(J,J)                                                   UWTH 206
      GO TO 130                                                         UWTH 207
 11   R=A(J,J)/A(I,J)                                                   UWTH 208
      DO 12 K=1,N                                                       UWTH 209
      B=A(J,K)                                                          UWTH 210
      A(J,K)=A(I,K)                                                     UWTH 211
 12   A(I,K)=B                                                          UWTH 212
      CET=-CET                                                          UWTH 213
 130  JJ=J+1                                                            UWTH 214
 13   DO 14L=JJ,N                                                       UWTH 215
 14   A(I,L)=A(I,L)-R*A(J,L)                                            UWTH 216
 15   CONTINUE                                                          UWTH 217
 16   DO 20 I=1,N                                                       UWTH 218
   20 CET=CET*A(I,I)                                                    UWTH 219
      RETURN                                                            UWTH 220
      END                                                               UWTH 221
      SUBROUTINE MATS   (  X,N,M)                                       UWTH 222
      DIMENSION A(40,80) , X(40,40)                                     UWTH 223
      COMMON A                                                          UWTH 224
      IF (N-1) 200, 200, 201                                            UWTH 225
  200 X(1,1)=1./A(1,1)                                                  UWTH 226
      IF (A(1,1))203, 16, 203                                           UWTH 227
  201 MM=N+M                                                            UWTH 228
      DO 15 I=2,N                                                       UWTH 229
 70   II=I-1                                                            UWTH 230
 7    DO 15 J=1,II                                                      UWTH 231
 8    IF (A(I,J))9,15,9                                                 UWTH 232
 9    IF (ABSF(A(J,J))-ABSF(A(I,J)))11,10,10                            UWTH 233
 10   R=A(I,J)/A(J,J)                                                   UWTH 234
      GO TO 130                                                         UWTH 235
 11   R=A(J,J)/A(I,J)                                                   UWTH 236
      DO 12 K=1,MM                                                      UWTH 237
      B=A(J,K)                                                          UWTH 238
      A(J,K)=A(I,K)                                                     UWTH 239
 12   A(I,K)=B                                                          UWTH 240
 130  JJ=J+1                                                            UWTH 241
 13   DO 14 K=JJ,MM                                                     UWTH 242
 14   A(I,K)=A(I,K)-R*A(J,K)                                            UWTH 243
 15   CONTINUE                                                          UWTH 244
      IF (ABSF(A(N,N))) 16,16,17                                        UWTH 245
 16   PAUSE 77777                                                       UWTH 246
 17   DO28J=1,M                                                         UWTH 247
      KK=N+J                                                            UWTH 248
      X(N,J)=A(N,KK)/A(N,N)                                             UWTH 249
      DO28I=2,N                                                         UWTH 250
      JJ=N-I+1                                                          UWTH 251
      B=0.                                                              UWTH 252
      II=N-I+2                                                          UWTH 253
      DO 25 K=II,N                                                      UWTH 254
 25   B=B+A(JJ,K)*X(K,J)                                                UWTH 255
      IF (ABSF(A(JJ,JJ))) 16,16,28                                      UWTH 256
 28   X(JJ,J)=(A(JJ,KK)-B)/A(JJ,JJ)                                     UWTH 257
  203 RETURN                                                            UWTH 258
      END                                                               UWTH 259
      SUBROUTINE MAMULT (A,N,M,B,L,C)                                   UWTH 260
      DIMENSION  A(40 ,40), B(40, 40),C(40, 40)                         UWTH 261
      DO 1 I=1,N                                                        UWTH 262
      DO 1 J=1,L                                                        UWTH 263
      C(I,J)=0.                                                         UWTH 264
      DO 1  K=1,M                                                       UWTH 265
    1 C(I,J)= C(I,J)+ A(I,K)*B(K,J)                                     UWTH 266
      RETURN                                                            UWTH 267
      END                                                               UWTH 268
