*     LIST                                                              EOLEGN01
      SUBROUTINE LEGNDR(A1,A2,Z,F1,F2)                                  EOLEGN02
      IF(Z+1.)1,2,4                                                     EOLEGN03
 2    X1=EXPF(-A2*3.14159265)                                           EOLEGN04
      X2=A1*3.14159265                                                  EOLEGN05
      F1=COSF(X2)*X1                                                    EOLEGN06
      F2=SINF(X2)*X1                                                    EOLEGN07
      GO TO 6                                                           EOLEGN08
 4    IF(Z-1.7)5,5,1                                                    EOLEGN09
 5    CALL HYPFN(-A1,-A2,A1+1.,A2,1.,0.,(1.-Z)/2.,.000001,F1,F2)        EOLEGN10
      GO TO 6                                                           EOLEGN11
 1    IF(A2)3,8,3                                                       EOLEGN12
 8    IF(ABSF(ABSF(INTF(A1)-A1)-0.5)-0.00001)9,9,3                      EOLEGN13
 9    WRITE OUTPUT TAPE 3,7                                             EOLEGN14
 7    FORMAT(///50H ORDER OF LEGENDRE FUNCTION IS HALF AN ODD INTEGER///EOLEGN15
     1)                                                                 EOLEGN16
      CALL EXIT                                                         EOLEGN17
 3    CALL LEGPT1(A1,A2,Z,F3,F4)                                        EOLEGN18
      CALL LEGPT2(A1,A2,Z,F5,F6)                                        EOLEGN19
      F1=F3+F5                                                          EOLEGN20
      F2=F4+F6                                                          EOLEGN21
 6    RETURN                                                            EOLEGN22
      END                                                               EOLEGN23
*     LIST                                                              EOLEGN24
      SUBROUTINE LEGPT1(A1,A2,Z,F1,F2)                                  EOLEGN25
      IF(ABSF(Z)-1.)1,1,10                                              EOLEGN26
 10   IF((ABSF(Z))**(2.*A1+1.)-1000000.)2,11,11                         EOLEGN27
 11   F1=0.                                                             EOLEGN28
      F2=0.                                                             EOLEGN29
      GO TO 3                                                           EOLEGN30
 2    CALL HYPFN(A1/2.+1.,A2/2.,A1/2.+0.5,A2/2.,A1+1.5,A2,1./Z**2,.00000EOLEGN31
     11,F1,F2)                                                          EOLEGN32
      CALL GAMMA(A1+1.,A2,F3,F4)                                        EOLEGN33
      CALL GAMMA(A1+1.5,A2,F5,F6)                                       EOLEGN34
      CALL COMTAN(3.14159265*A1,3.14159265*A2,F7,F8)                    EOLEGN35
      X1=LOGF(2.*ABSF(Z))                                               EOLEGN36
      X2=EXPF(-(A1+1.)*X1)*0.5641895                                    EOLEGN37
      X3=COSF(A2*X1)*X2                                                 EOLEGN38
      X4=-SINF(A2*X1)*X2                                                EOLEGN39
      X5=F1*F3-F2*F4                                                    EOLEGN40
      X6=F1*F4+F2*F3                                                    EOLEGN41
      F3=X5*X3-X6*X4                                                    EOLEGN42
      F4=X5*X4+X6*X3                                                    EOLEGN43
      X5=F3*F7-F4*F8                                                    EOLEGN44
      X6=F3*F8+F4*F7                                                    EOLEGN45
      A=F5**2+F6**2                                                     EOLEGN46
      F1=(X5*F5+X6*F6)/A                                                EOLEGN47
      F2=(-X5*F6+X6*F5)/A                                               EOLEGN48
      IF(Z)5,5,3                                                        EOLEGN49
 5    X1=EXPF(A2*3.14159265)                                            EOLEGN50
      X2=-(A1+1.)*3.14159265                                            EOLEGN51
      X3=COSF(X2)*X1                                                    EOLEGN52
      X4=SINF(X2)*X1                                                    EOLEGN53
      X5=X3*F1-X4*F2                                                    EOLEGN54
      F2=X3*F2+X4*F1                                                    EOLEGN55
      F1=X5                                                             EOLEGN56
      GO TO 3                                                           EOLEGN57
 1    WRITE OUTPUT TAPE 3,4                                             EOLEGN58
 4    FORMAT(///64H MODULUS OF ARGUMENT OF SUB. LEGPT1 IS LESS THAN OR EEOLEGN59
     1QUAL TO ONE///)                                                   EOLEGN60
      CALL EXIT                                                         EOLEGN61
 3    RETURN                                                            EOLEGN62
      END                                                               EOLEGN63
*     LIST                                                              EOLEGN64
      SUBROUTINE LEGPT2(A1,A2,Z,F1,F2)                                  EOLEGN65
      IF(ABSF(Z)-1.)1,1,2                                               EOLEGN66
 2    CALL HYPFN(0.5-A1/2.,-A2/2.,-A1/2.,-A2/2.,0.5-A1,-A2,1./Z**2,.0000EOLEGN67
     101,F1,F2)                                                         EOLEGN68
      CALL GAMMA(A1+0.5,A2,F3,F4)                                       EOLEGN69
      CALL GAMMA(A1+1.,A2,F5,F6)                                        EOLEGN70
      X1=LOGF(2.*ABSF(Z))                                               EOLEGN71
      X2=EXPF(A1*X1)*0.5641895                                          EOLEGN72
      X3=COSF(A2*X1)*X2                                                 EOLEGN73
      X4=SINF(A2*X1)*X2                                                 EOLEGN74
      X5=F1*F3-F2*F4                                                    EOLEGN75
      X6=F1*F4+F2*F3                                                    EOLEGN76
      F3=X5*X3-X6*X4                                                    EOLEGN77
      F4=X5*X4+X6*X3                                                    EOLEGN78
      A=F5**2+F6**2                                                     EOLEGN79
      F1=(F3*F5+F4*F6)/A                                                EOLEGN80
      F2=(-F3*F6+F4*F5)/A                                               EOLEGN81
      IF(Z)5,5,3                                                        EOLEGN82
 5    X1=EXPF(-A2*3.14159265)                                           EOLEGN83
      X2=A1*3.14159265                                                  EOLEGN84
      X3=COSF(X2)*X1                                                    EOLEGN85
      X4=SINF(X2)*X1                                                    EOLEGN86
      X5=X3*F1-X4*F2                                                    EOLEGN87
      F2=X3*F2+X4*F1                                                    EOLEGN88
      F1=X5                                                             EOLEGN89
      GO TO 3                                                           EOLEGN90
 1    WRITE OUTPUT TAPE 3,4                                             EOLEGN91
 4    FORMAT(///64H MODULUS OF ARGUMENT OF SUB. LEGPT2 IS LESS THAN OR EEOLEGN92
     1QUAL TO ONE///)                                                   EOLEGN93
      CALL EXIT                                                         EOLEGN94
 3    RETURN                                                            EOLEGN95
      END                                                               EOLEGN96
*     LIST                                                              EOLEGN97
      SUBROUTINE HYPFN(A1,A2,B1,B2,C1,C2,Z,EP,F1,F2)                    EOLEGN98
      IF(ABSF(Z)-1.)1,2,2                                               EOLEGN99
 2    WRITE OUTPUT TAPE 3,3                                             EOLEG100
 3    FORMAT(///47H ARGUMENT OF HYPFN GREATER THAN OR EQUAL TO ONE///)  EOLEG101
      CALL EXIT                                                         EOLEG102
 1    I=0                                                               EOLEG103
      F1=1.                                                             EOLEG104
      F2=0.                                                             EOLEG105
      A3=A1                                                             EOLEG106
      B3=B1                                                             EOLEG107
      C3=C1                                                             EOLEG108
      S1=1.                                                             EOLEG109
      S2=0.                                                             EOLEG110
      A=1.                                                              EOLEG111
 4    S3=S1*A3-S2*A2                                                    EOLEG112
      S4=S1*A2+S2*A3                                                    EOLEG113
      S1=S3*B3-S4*B2                                                    EOLEG114
      S2=S3*B2+S4*B3                                                    EOLEG115
      X1=C3**2+C2**2                                                    EOLEG116
      S3=(S1*C3+S2*C2)/X1                                               EOLEG117
      S4=(-S1*C2+S2*C3)/X1                                              EOLEG118
      S1=S3*Z/A                                                         EOLEG119
      S2=S4*Z/A                                                         EOLEG120
      F1=F1+S1                                                          EOLEG121
      F2=F2+S2                                                          EOLEG122
      EP1=SQRTF((S1**2+S2**2)/(F1**2+F2**2))                            EOLEG123
      IF(EP1-EP)5,6,6                                                   EOLEG124
 6    I=I+1                                                             EOLEG125
      A3=A3+1.                                                          EOLEG126
      B3=B3+1.                                                          EOLEG127
      C3=C3+1.                                                          EOLEG128
      A=A+1.                                                            EOLEG129
      IF(I-30)4,9,9                                                     EOLEG130
 9    IF(EP1-0.01)5,7,7                                                 EOLEG131
 7    EP2=SQRTF(S1**2+S2**2)                                            EOLEG132
      WRITE OUTPUT TAPE 3,8,Z,EP1,EP2                                   EOLEG133
 8    FORMAT(///44H ERROR IN HYPFN ROUTINE FOR ARGUMENT EQUALS E10.4/23HEOLEG134
     1 RELATIVE ERROR EQUALS E15.7/23H ABSOLUTE ERROR EQUALS E15.7///)  EOLEG135
 5    RETURN                                                            EOLEG136
      END                                                               EOLEG137
*     LIST                                                              EOLEG138
      SUBROUTINE GAMMA(A1,A2,F1,F2)                                     EOLEG139
      DIMENSION S(4)                                                    EOLEG140
      F1=1.                                                             EOLEG141
      F2=0.                                                             EOLEG142
      IF(A)1,2,1                                                        EOLEG143
    2 S(1)=1./12.                                                       EOLEG144
      S(2)=1./288.                                                      EOLEG145
      S(3)=-139./51840.                                                 EOLEG146
      S(4)=-571./2488320.                                               EOLEG147
      A=SQRTF(2.*3.14159265)                                            EOLEG148
    1 IF(A1-10.)3,4,4                                                   EOLEG149
    3 C1=A1**2+A2**2                                                    EOLEG150
      IF(C1)6,7,6                                                       EOLEG151
    6 C2=(F1*A1+F2*A2)/C1                                               EOLEG152
      F2=(F2*A1-F1*A2)/C1                                               EOLEG153
      F1=C2                                                             EOLEG154
      A1=A1+1.                                                          EOLEG155
      GO TO 1                                                           EOLEG156
    4 C1=A1**2+A2**2                                                    EOLEG157
      B1=A1/C1                                                          EOLEG158
      B2=-A2/C1                                                         EOLEG159
      C1=1.                                                             EOLEG160
      C2=0.                                                             EOLEG161
      C3=B1                                                             EOLEG162
      C4=B2                                                             EOLEG163
      DO 5I=1,4                                                         EOLEG164
      C1=C1+S(I)*C3                                                     EOLEG165
      C2=C2+S(I)*C4                                                     EOLEG166
      C5=C3*B1-C4*B2                                                    EOLEG167
      C4=C3*B2+C4*B1                                                    EOLEG168
    5 C3=C5                                                             EOLEG169
      C3=F1*C1-F2*C2                                                    EOLEG170
      F2=F1*C2+F2*C1                                                    EOLEG171
      F1=C3                                                             EOLEG172
      C1=EXPF(-A1)                                                      EOLEG173
      C2=COSF(-A2)*C1                                                   EOLEG174
      C3=SINF(-A2)*C1                                                   EOLEG175
      C4=0.5*LOGF(A1**2+A2**2)                                          EOLEG176
      C5=ATANF(A2/A1)                                                   EOLEG177
      C6=(A1-0.5)*C4-A2*C5                                              EOLEG178
      C7=(A1-0.5)*C5+A2*C4                                              EOLEG179
      C1=EXPF(C6)                                                       EOLEG180
      C4=COSF(C7)*C1*A                                                  EOLEG181
      C5=SINF(C7)*C1*A                                                  EOLEG182
      C1=F1*C4-F2*C5                                                    EOLEG183
      F2=F1*C5+F2*C4                                                    EOLEG184
      F1=C1*C2-F2*C3                                                    EOLEG185
      F2=C1*C3+F2*C2                                                    EOLEG186
      GO TO 8                                                           EOLEG187
    7 WRITE OUTPUT TAPE 3,9                                             EOLEG188
    9 FORMAT(///39H GAMMA FUNCTION OF NEG. INTEGER OR ZERO///)          EOLEG189
      CALL EXIT                                                         EOLEG190
    8 RETURN                                                            EOLEG191
      END                                                               EOLEG192
*     LIST                                                              EOLEG193
      SUBROUTINE COMTAN(A1,A2,F1,F2)                                    EOLEG194
      A1P=A1/3.14159265                                                 EOLEG195
      IF(ABSF(ABSF(INTF(A1P)-A1P)-0.5)-0.00001)1,1,2                    EOLEG196
 1    IF(A2)3,4,3                                                       EOLEG197
 4    WRITE OUTPUT TAPE 3,5                                             EOLEG198
 5    FORMAT(///43H ARGUMENT OF TAN HALF AN ODD MULTIPLE OF PI///)      EOLEG199
      CALL EXIT                                                         EOLEG200
 3    F1=0.                                                             EOLEG201
      X1=EXPF(2.*A2)                                                    EOLEG202
      F2=(X1+1.)/(X1-1.)                                                EOLEG203
      GO TO 6                                                           EOLEG204
 2    A=EXPF(2.*A2)                                                     EOLEG205
      B=A+1.                                                            EOLEG206
      C=A-1.                                                            EOLEG207
      D1=SINF(A1)/COSF(A1)                                              EOLEG208
      D2=D1*B                                                           EOLEG209
      D3=D1*C                                                           EOLEG210
      D4=B**2+D3**2                                                     EOLEG211
      F1=(D2*B-C*D3)/D4                                                 EOLEG212
      F2=(D2*D3+C*B)/D4                                                 EOLEG213
 6    RETURN                                                            EOLEG214
      END                                                               EOLEG215
