ECRKOP REM 229  05261                                                   RKOP0001
       REM RUNGE KUTTA FLOATING POINT SUBROUTINE FOR SOLVING            RKOP0002
       REM LINEAR FIRST ORDER DIFFERENTIAL EQUATIONS                    RKOP0003
       REM FEATURING AN OPTIMIZATION ROUTINE FOR                        RKOP0004
       REM DETERMINING THE INTEGRATION INTERVAL - FLOATING POINT        RKOP0005
       REM CALLING SEQUENCE,                                            RKOP0006
       REM TSX RKOP,4                                                   RKOP0007
       REM DEC H              INTEGRATION INTERVAL (FL.PT)              RKOP0008
       REM DEC EC             ERROR CONTROL 1 THRU 8 (FIX. PT.)         RKOP0009
       REM ERROR RETURN                                                 RKOP0010
       REM NORMAL RETURN                                                RKOP0011
 RKOP  CAL 1,4                H TO ACC                                  RKOP0012
       SLW RKOP+206           SAVE H                                    RKOP0013
       ANA RKOP+214           MASK OFF CHARACTERISTIC                   RKOP0014
       TZE 3,4                ERROR RETURN - H ZERO OR FIXED            RKOP0015
       SXD RKOP+207,1         SAVE IR1                                  RKOP0016
       SXD RKOP+208,2         SAVE IR2                                  RKOP0017
       SXD RKOP+209,4         SAVE IR4                                  RKOP0018
       CLA 2,4                EC TO ACC                                 RKOP0019
       STO RKOP+210           SAVE EC                                   RKOP0020
       TZE RKOP+33            NO OPTIMIZATION                           RKOP0021
       TMI 3,4                ERROR RETURN EC LESS THAN 0               RKOP0022
       LDQ RKOP+215           MASK FOR EC LARGER THAN 8                 RKOP0023
       TLQ 3,4                ERROR RETURN EC LARGER THAN 8             RKOP0024
       SLT 1                                                            RKOP0025
       PXD                                                              RKOP0026
       STO RKOP+211           SAVE SL1 INDICATOR                        RKOP0027
       LXA RKOP+210,4         CHANGE EC TO A DECIMAL                    RKOP0028
       LDQ RKOP+216           .1                                        RKOP0029
       TXL *+4,4,1                                                      RKOP0030
       FMP RKOP+216           .1                                        RKOP0031
       LRS 35                                                           RKOP0032
       TIX *-3,4,1                                                      RKOP0033
       STQ RKOP+213           EC AS A DECIMAL                           RKOP0034
       LXA RKOP+217,4         SAVE INITIAL CONDITIONS                   RKOP0035
       CLA XRKOP,4                                                      RKOP0036
       STO SARKX,4                                                      RKOP0037
       CLA YRKOP,4                                                      RKOP0038
       STO SARKY,4                                                      RKOP0039
       CLA QRKOP,4                                                      RKOP0040
       STO SARKQ,4                                                      RKOP0041
       TIX *-6,4,1                                                      RKOP0042
       LXD RKOP+56,2                                                    RKOP0043
       SXD RKOP+212,2         ZERO TO IR2 AND SAVED                     RKOP0044
       LXD RKOP+198,2         SET IR2=4                                 RKOP0045
       CLA RKOP+202,2         SET SWITCH                                RKOP0046
       STA RKOP+43                                                      RKOP0047
       LXA RKOP+217,1         SET IR1=N                                 RKOP0048
       TSX WRKOP,4            COMPUTE F(I)                              RKOP0049
       LDQ VRKOP,1            F(I)                                      RKOP0050
       FMP RKOP+206           FORM K(IJ)= HF (I)                        RKOP0051
       TZE *+2                IF ZERO, DO NOT ROUND                     RKOP0052
       ORA RKOP+188           ROUND                                     RKOP0053
       LRS 35                 K(IJ) TO MQ                               RKOP0054
       TRA **                 SWITCH (TO EVAL. EACH. EQUAT.)            RKOP0055
       CLA QRKOP,1            EPS(I) TERM                               RKOP0056
       LDQ RKOP+189           CLEAR MQ                                  RKOP0057
       TSX RKOP+155,4         TO DP FL. PT. ADD.                        RKOP0058
       FAD YRKOP,1            + Y(I)                                    RKOP0059
       STO XRKOP,1            FOR NEXT EQUATION                         RKOP0060
       TXL RKOP+117,2,1       TO PREPARE FOR NEXT STEP                  RKOP0061
       TIX RKOP+38,1,1        LOOP, DONE AFTER N PASSES                 RKOP0062
       TIX RKOP+34,2,1        LOOP, DONE AFTER 4 PASSES                 RKOP0063
       CLA RKOP+210           CHECK EC                                  RKOP0064
       TZE RKOP+87            NO OPTIMIZATION- ALL DONE                 RKOP0065
       LXD RKOP+212,2         OPTIMIZE                                  RKOP0066
       TIX *+2,2,1                                                      RKOP0067
       TXL *+7                                                          RKOP0068
       SXD RKOP+212,2         SAVE IR2                                  RKOP0069
       LXA RKOP+217,4         SET IR4 = N                               RKOP0070
       CLA XRKOP,4            SAVE ANSWERS Y(H/2)                       RKOP0071
       STO SAVX1,4                                                      RKOP0072
       TIX *-2,4,1                                                      RKOP0073
       TXL RKOP+33            RETURN TO MAIN ROUTINE                    RKOP0074
       SLT 1                                                            RKOP0075
       TRA RKOP+93            SL1 OFF - FIRST TIME ONLY                 RKOP0076
       LXA RKOP+217,4         SET IR4=N                                 RKOP0077
       CLA SAVX2,4            PERFORM ACCURACY TESTS                    RKOP0078
       FSB XRKOP,4                                                      RKOP0079
       TZE RKOP+80                                                      RKOP0080
       STO RKOP+202                                                     RKOP0081
       SSP                                                              RKOP0082
       FSB RKOP+213           FIRST TEST = ABS (Y(H)-Y(H/2)) DEC PL     RKOP0083
       TMI RKOP+80            LESS THAN ERROR CONTROL                   RKOP0084
       CLA RKOP+202                                                     RKOP0085
       FDP SAVX2,4                                                      RKOP0086
       STQ RKOP+202                                                     RKOP0087
       CLA RKOP+202                                                     RKOP0088
       SSP                                                              RKOP0089
       FSB RKOP+213                                                     RKOP0090
       TPL RKOP+98            SECOND TEST SIG FIG                       RKOP0091
       TIX RKOP+66,4,1                                                  RKOP0092
       CLA RKOP+206           ALL THRU                                  RKOP0093
       FAD RKOP+206           LAST H                                    RKOP0094
       STO RKOP+206           FORM LAST H TIMES 2                       RKOP0095
       CLA RKOP+211           RESTORE SL 1 CONDITION                    RKOP0096
       TZE *+2                                                          RKOP0097
       SLN 1                                                            RKOP0098
       LXD RKOP+207,1         RESTORE IR1                               RKOP0099
       LXD RKOP+208,2         RESTORE IR2                               RKOP0100
       LXD RKOP+209,4         RESTORE IR4                               RKOP0101
       CLA RKOP+206           STORE LAST INTERVAL                       RKOP0102
       STO 1,4                                                          RKOP0103
       TRA 4,4                OUT - NORMAL RETURN                       RKOP0104
       LXA RKOP+217,4         SAVE ANSWERS Y(H)                         RKOP0105
       CLA XRKOP,4            FIRST TIME THROUGH ONLY                   RKOP0106
       STO SAVX2,4                                                      RKOP0107
       TIX *-2,4,1                                                      RKOP0108
       TXL *+5                                                          RKOP0109
       LXA RKOP+217,4         SHIFT ANSW Y(H/2) TO                      RKOP0110
       CLA SAVX1,4            ANSWER BLOCK Y(H)                         RKOP0111
       STO SAVX2,4                                                      RKOP0112
       TIX *-2,4,1                                                      RKOP0113
       LDQ RKOP+206           HALVE LAST H                              RKOP0114
       FMP RKOP+190                                                     RKOP0115
       STO RKOP+206                                                     RKOP0116
       LXA RKOP+217,4         RESTORE INITIAL CONDITIONS                RKOP0117
       CLA SARKX,4                                                      RKOP0118
       STO XRKOP,4                                                      RKOP0119
       CLA SARKY,4                                                      RKOP0120
       STO YRKOP,4                                                      RKOP0121
       CLA SARKQ,4                                                      RKOP0122
       STO QRKOP,4                                                      RKOP0123
       TIX *-6,4,1                                                      RKOP0124
       SLN 1                                                            RKOP0125
       LXD *+2,2              SET IR2=2 AND SAVE IT                     RKOP0126
       SXD RKOP+212,2         SAVE IR2                                  RKOP0127
       TXL RKOP+33,,2         RETURN TO MAIN ROUTINE                    RKOP0128
       STO YRKOP,1            Y(I)                                      RKOP0129
       STQ QRKOP,1            SAVE EPS (I) TERM FOR NEXT STEP           RKOP0130
       TXL RKOP+50                                                      RKOP0131
       STQ RRKOP,1            K(I0)                                     RKOP0132
       FMP RKOP+190           1/2 K(I0)                                 RKOP0133
       STO RKOP+202           STORE FOR DP FL. PT. ADD.                 RKOP0134
       STQ RKOP+203                                                     RKOP0135
       TXL RKOP+44            TO MAIN ROUTINE                           RKOP0136
       STQ SRKOP,1            K(I1)                                     RKOP0137
       FMP RKOP+191           (1-SQ.RT. 1/2) K(I1)                      RKOP0138
       STO RKOP+202           STORE FOR DP FL. PT. ADD.                 RKOP0139
       STQ RKOP+203                                                     RKOP0140
       LDQ RRKOP,1            K(I0)                                     RKOP0141
       FMP RKOP+192           (-1/2 + SQ.RT.1/2)K(I0)                   RKOP0142
       TSX RKOP+155,4         TO DP FL. PT. ADD.                        RKOP0143
       TXL RKOP+44            TO MAIN                                   RKOP0144
       STQ URKOP,1            K(I2)                                     RKOP0145
       FMP RKOP+193           (1+SQ.RT.1/2)K(I2)                        RKOP0146
       STO RKOP+202           STORE FOR DP FL. PT. ADD.                 RKOP0147
       STQ RKOP+203                                                     RKOP0148
       LDQ SRKOP,1            K(I1)                                     RKOP0149
       FMP RKOP+194           (-SQ.RT. 1/2)K(I1)                        RKOP0150
       TSX RKOP+155,4         TO DP FL. PT. ADD.                        RKOP0151
       TXL RKOP+44            TO MAIN                                   RKOP0152
       STQ VRKOP,1            K(I3)                                     RKOP0153
       FMP RKOP+195           (1/6)K(I3)                                RKOP0154
       STO RKOP+202           STORE FOR DP FL. PT. ADD.                 RKOP0155
       STQ RKOP+203                                                     RKOP0156
       LDQ URKOP,1            K(I2)                                     RKOP0157
       FMP RKOP+196           1/3 (1+SQ.RT.1/2)K(I2)                    RKOP0158
       TSX RKOP+155,4         TO DP FL. PT. ADD.                        RKOP0159
       LDQ SRKOP,1            K(I1)                                     RKOP0160
       FMP RKOP+197           1/3(1-SQ.RT.1/2) K (I1)                   RKOP0161
       TSX RKOP+155,4         TO DP FL. PT. ADD.                        RKOP0162
       LDQ RRKOP,1            K(I0)                                     RKOP0163
       FMP RKOP+195           (1/6)K(I0)                                RKOP0164
       TSX RKOP+155,4         TO DP FL. PT. ADD.                        RKOP0165
       TXL RKOP+44            TO MAIN                                   RKOP0166
       STQ RKOP+204           DP FL. PT. ADD. STORE A(2)                RKOP0167
       FAD RKOP+202           A(1)+B(1)                                 RKOP0168
       STO RKOP+205           STORE MSP                                 RKOP0169
       PXD                    CLEAR ACC                                 RKOP0170
       LLS 35                 LSP TO AC                                 RKOP0171
       FAD RKOP+204           +A(2)                                     RKOP0172
       FAD RKOP+203           +B(2)                                     RKOP0173
       FAD RKOP+205           +MSP OF A(1)+B(1)                         RKOP0174
       STO RKOP+202           STORE MSP OF SUM                          RKOP0175
       TQP RKOP+181                                                     RKOP0176
       TMI RKOP+178           HERE IF MQ-, OUT IF AC-                   RKOP0177
       SUB RKOP+188           HERE IF MQ-, AC+,-1 IN 35TH               RKOP0178
       STO RKOP+205                                                     RKOP0179
       CLM                    CLEAR MAGN. ACC.                          RKOP0180
       RQL 9                  SEPARATE CHARACTERISTIC                   RKOP0181
       LGL 27                 FROM FRACTION OF LSP                      RKOP0182
       TZE RKOP+184                                                     RKOP0183
       SSM                    -FRACTION OF LSP                          RKOP0184
       ADD RKOP+187           1-FRACTION                                RKOP0185
       STQ RKOP+203                                                     RKOP0186
       ORS RKOP+203           COMBINE CHAR. AND FRACTION                RKOP0187
       CLS RKOP+203           -LSP                                      RKOP0188
       FAD RKOP+205           +MSP                                      RKOP0189
       STO RKOP+202           MSP                                       RKOP0190
       STQ RKOP+203           LSP                                       RKOP0191
       TRA 1,4                OUT                                       RKOP0192
       TPL RKOP+178           HERE IF MQ+, OUT IF AC+                   RKOP0193
       ADD RKOP+188           HERE IF MQ+, AC-, +1 IN 35TH              RKOP0194
       TRA RKOP+167                                                     RKOP0195
       CLA RKOP+202           HERE IF LSP=0, REPLACE MSP                RKOP0196
       LRS                    SIGN OF MSP REPLACES SIGN OF LSP          RKOP0197
       TXL RKOP+178                                                     RKOP0198
       OCT 001000000000       1 IN 8TH BIT                              RKOP0199
       HTR 1                  1 IN 35TH BIT                             RKOP0200
       HTR                    ZERO                                      RKOP0201
       OCT 200400000000       1/2                                       RKOP0202
       OCT 177453730315       1-SQ.RT.(1/2)                             RKOP0203
       OCT 176650117146       -1/2 + SQ.RT.(1/2)                        RKOP0204
       OCT 201665011715       1+ SQ.RT.(1/2)                            RKOP0205
       OCT 600552023632       -SQ.RT. (1/2)                             RKOP0206
       OCT 176525252525       1/6                                       RKOP0207
       OCT 200443261211       1/3 (1+SQ.RT. 1/2)                        RKOP0208
       OCT 175617713146       1/3 (1-SQ.RT. 1/2)                        RKOP0209
       HTR RKOP+120,,4        SWITCH CONSTANTS                          RKOP0210
       HTR RKOP+125                                                     RKOP0211
       HTR RKOP+133                                                     RKOP0212
       HTR RKOP+141                                                     RKOP0213
       HTR                    TEMPORARY STORAGE FOLLOWS=                RKOP0214
       HTR                    12 CELLS                                  RKOP0215
       HTR                                                              RKOP0216
       HTR                                                              RKOP0217
       HTR                    H SAVED                                   RKOP0218
       HTR                    IR1 SAVED                                 RKOP0219
       HTR                    IR2                                       RKOP0220
       HTR                    IR4                                       RKOP0221
       HTR                    EC                                        RKOP0222
       HTR                    SL1 CONDITION SAVED                       RKOP0223
       HTR                    TEMP. STORAGE FOR IR2                     RKOP0224
       HTR                    EC CHANGED TO A DECIMAL                   RKOP0225
       OCT 377000000000       MASK FOR CHECKING H                       RKOP0226
       OCT 000000000010       MASK FOR EC LARGER THAN 8                 RKOP0227
       OCT 175631463146       .1                                        RKOP0228
       HTR NRKOP              NUMBER OF EQUATIONS                       RKOP0229
