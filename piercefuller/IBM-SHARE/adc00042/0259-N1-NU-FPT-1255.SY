* FPT        65 12271    FLOATING POINT TRAP SUBROUTINE                 FPT 0001
*     FAP                                                               NUFPT002
*NUFPT  MODIFIED VERSION OF IB(FPT) . WITH ALTERNATE ENTRIES 11/3/60    NUFPT003
       COUNT   60                                                       NUFPT004
       LBL     NUFPT,9                                                  NUFPT005
       ENTRY   FPTEST                                                   NUFPT006
       ENTRY   FPOLD                                                    NUFPT007
       ENTRY   (FPT)                                                    NUFPT008
FPTEST CLA     8                                                        NUFPT009
       STO     NEW+1                   SAVE L(8)                        NUFPT010
       STZ     OVFLOW                  CLEAR 77462                      NUFPT011
       CLA     1,4                                                      NUFPT012
       STA     NEW+2                   L(CONTENTS OF L(0))              NUFPT013
       CLA     NEW                     L(TTR,(FPT))                     NUFPT014
       STO     8                       MUST USE THIS (FPT)              NUFPT015
       CLA     NEW+2                   L(STI,**)                        NUFPT016
       STO     ERROR+1                 MODIFY(FPT) SO EXEM              NUFPT017
       CLA     NEW+3                   DOES NOT ACT                     NUFPT018
       STO     ERROR+2                                                  NUFPT019
       TRA     2,4                                                      NUFPT020
 (FPT) STI     IND           SAVE INDICATORS.                           NUFPT021
       LDI     0             EXAMINE BITS 14-17 OF LOC ZERO             NUFPT022
       LFT     4             SKIP IF NON'OVERFLOW (BIT 15)              NUFPT023
       TRA     ERROR         (IN FPT + 3) OVERFLOW AC OR MQ             NUFPT024
       LFT     2             SKIP IF ACC NOT INVOLVED                   NUFPT025
       CLM                                                              NUFPT026
       LNT     6             SKIP AND COMPLEMENT                        NUFPT027
       COM                   ONCE ON ACC UNDRFLOW                       NUFPT028
       COM                                                              NUFPT029
       XCA                   GET MQ                                     NUFPT030
       LFT     1             SKIP IF N= MQ NOT INVOLVED                 NUFPT031
       CLM                                                              NUFPT032
       LNT     5             COMPLEMEMT ONCE ON                         NUFPT033
       COM                   MQ UNDERFLOW                               NUFPT034
       COM                                                              NUFPT035
       XCA                   RESTORE MQ AND ACC                         NUFPT036
       LDI     IND           RESTORE INDICATORS.                        NUFPT037
 EXIT  TRA*    0                                                        NUFPT038
 ERROR STI     OVFLOW        77462                                      NUFPT039
       LDI     *+2                                                      NUFPT040
       TRA     $(EXE)                                                   NUFPT041
       PZE     2,4,*+1                                                  NUFPT042
       LDI     OVFLOW        RETURN FROM EXE IF NOT IN MONITOR MODE     NUFPT043
       TRA     (FPT)+4                                                  NUFPT044
 NEW   TTR     (FPT)                   CONSTANT                         NUFPT045
       PZE     0                       SAVE ORIGINAL L(8) HERE          NUFPT046
       STI     **                      CONSTANT-STA OF VARIABLE HERE    NUFPT047
       TRA     ERROR+4                 CONST                            NUFPT048
       LDI     ERROR+3                 CONST                            NUFPT049
       TRA     $(EXE)                                                   NUFPT050
       CLA     NEW                                                      NUFPT051
       TRA     SET                                                      NUFPT052
 FPOLD CLA     NEW+4                   RESTORE EXEM AFFECT              NUFPT053
       STO     ERROR+1                                                  NUFPT054
       CLA     NEW+5                                                    NUFPT055
       STO     ERROR+2                                                  NUFPT056
       CLA     NEW+1                   RESTORE L(8)                     NUFPT057
       TZE     NEW+6                                                    NUFPT058
 SET   STO     8                                                        NUFPT059
       STZ     OVFLOW                  CLEAR 77462                      NUFPT060
       TRA     1,4                                                      NUFPT061
       COMMON  -2                                                       NUFPT062
 IND   COMMON  1                       77463                            NUFPT063
OVFLOW COMMON  1                                                        NUFPT064
       END                                                              NUFPT065
