       TXH EOR,1,24                                                      PT5 017
       STZ 0,2                                                           PT5 018
       TXI *+1,1,1                                                       PT5 019
       TXI *-3,2,-1                                                      PT5 020
 EOR   RTT                                                               PT5 021
