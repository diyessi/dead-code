 OUT   PXD 0,2                                                           PT5 024
       COM                                                               PT5 025
       PDX 0,4                                                           PT5 026
       SXD TOP,4                                                         PT5 027
SELECT WPU                                                               PT5 028
       TSX RC1,4                                                         PT5 029
 CALL  PZE **,0,UMRBCF                                                   PT5 030
       CLA CALL                                                          PT5 031
       ADD TWNY4                                                         PT5 032
 TWNY4 PAX 24,2                                                          PT5 033
       STA CALL                                                          PT5 034
 TOP   TXL SELECT,2,**                                                   PT5 035
       TRA ENTRY                                                         PT5 036
       TRA *-1                                                           PT5 037
 M1    PZE -1                                                            PT5 038
COMENT BCD 5  REDUNDANCY CHECKS ON TAPE 5                                PT5 039
CHANGE TXI *+1,4,1                                                       PT5 040
       BST 5                                                             PT5 041
       TXL LOOP+1,4,4                                                    PT5 042
       TSX LR,4                                                          PT5 043
       PZE COMENT,,5                                                     PT5 044
       RTD 5                                                             PT5 045
       LXA M1,1                                                          PT5 046
       CPY 9,1                                                           PT5 047
       TXI *-1,1,-1                                                      PT5 048
