*COMPILE,PRINT SAP,PUNCH OBJECT                                 INPUT000CP0067  
      SUBROUTINE INPUT(IBIT,ITD,IA1,IA2,A4,A8,A9,IE1,IE4,N,L,IERR,B)    CP0068  
      DIMENSION IA1(100),IA2(100),A4(100),A8(100),A9(100),IE1(100),IE4(1CP0069  
     100),Z1(23),Z2(200),Z3(5)                                          CP007!  
      REWIND IBIT                                                       CP0070  
  105 READ INPUT TAPEITD,106,(Z1(I1),I1 = 1,23)                         CP0071  
  106 FORMAT(2A6/6A6/12A6/3A6)                                          CP0072  
      WRITE TAPE IBIT, (Z1(I1), I1 = 1,23)                              CP0073  
      IERR = 0                                                          CP0074  
      L = 1                                                             CP0075  
      B = 0                                                             CP0076  
  125 READ INPUT TAPEITD,127,((IA1(L) , IA2(L)), (Z3(I1),I1 = 1,5), XA1,CP0077  
     * XA2, XA3, XA4, XA5)                                              CP0078  
  127 FORMAT(2I5,1X,4A6,A5,F5.0,F10.0,F5.0,F10.0,F2.0)                  CP0079  
      XA2=100.*XA2                                                      CP0080  
      XA4=100.*XA4                                                      CP0081  
C      ABOVE SCALES COST TO TOTAL OF 10.**3                             CP0082  
      IF (IA2 (L)) 173,131,131                                          CP0083  
  131 IF (IA1 (L) - IA2 (L)) 132,134,134                                CP0084  
  132 IF (XA1 - XA3) 134,148,133                                        CP0085  
  133 IF (XA4 - XA2) 134,141,155                                        CP0086  
  134 IERR = 3                                                          CP0087  
      WRITE OUTPUT TAPE 6,137,L,(IA1(L),IA2(L)),(Z3(I1),I1=1,5),XA1,XA2,CP0088  
     *XA3,XA4,XA5                                                       CP0089  
  137 FORMAT(1H1,13HACTIVITY CARD,I5,12H IS IN ERROR,9X,I5,2X,I5,2X,5A6,CP0090  
     *2X,F5.1,2X,F10.1,   F5.1,   F10.1,   F2.0)                        CP0091  
  139 Z=Z/1000.                                                         CP0092  
      WRITE TAPE IBIT, ((IA1 (L), IA2(L)), (Z3(I1), I1 =1,5), XA1, XA2, CP0093  
     * XA3,XA4, XA5, Z)                                                 CP0094  
      L = L + 1                                                         CP0095  
      GOTO 125                                                          CP0096  
  141 IF (XA5) 142,145,142                                              CP0097  
  142 A4(L) = -0.0                                                      CP0098  
      Z = XA2                                                           CP0099  
      GOTO 161                                                          CP0100  
  145 A4(L) = +0.0                                                      CP0101  
      Z = XA2                                                           CP0102  
      GOTO 161                                                          CP0103  
  148 IF (XA4 - XA2) 134, 145, 149                                      CP0104  
  149 IERR = 4                                                          CP0105  
      WRITE OUTPUT TAPE 6,152,L,(IA1(L),IA2(L)), (Z3(I1),I1 =1,5),XA1,  CP0106  
     * XA2,XA3,XA4,XA5                                                  CP0107  
  152 FORMAT(1H1,22HERROR IN ACTIVITY CARD,I5,12X,I5,2X,I5,2X,5A6,2X,F5.CP0108  
     *1,2X,F10.1,   F5.1,   F10.1,   F2.0)                              CP0109  
      GOTO 139                                                          CP0110  
  155 IF (XA5) 156,159,156                                              CP0111  
  156 A4(L) = - (XA4 - XA2) / (XA1 - XA3)                               CP0112  
      Z = XA4 - A4(L) * XA3                                             CP0113  
      GOTO 161                                                          CP0114  
  159 A4(L) = (XA4 - XA2) / (XA1 - XA3)                                 CP0115  
      Z = XA4 + A4(L) * XA3                                             CP0116  
  161 B = B + Z                                                         CP0117  
      A8(L) = XA3                                                       CP0118  
      A9(L) = XA1                                                       CP0119  
      IF (L - 1) 139,139,165                                            CP012!  
  165 IF (IA1 (L) - IA1(L-1)) 167,166,139                               CP0120  
  166 IF (IA2 (L) - IA2(L-1)) 167,167,139                               CP0121  
  167 IERR = 5                                                          CP0122  
      WRITE OUTPUT TAPE 6,170,L,(IA1(L),IA2(L)),(Z3(I1),I1=1,5),XA1,XA2,CP0123  
     *XA3,XA4,XA5                                                       CP0124  
  170 FORMAT(1H1,13HACTIVITY CARD,I5,15H IS OUT OF SORT,6X,I5,2X,I5,2X, CP0125  
     *5A6,2X,F5.1,2X,F10.1,   F5.1,   F10.1,   F2.0)                    CP0126  
      GOTO 139                                                          CP0127  
  173 L = L - 1                                                         CP0128  
      N = 1                                                             CP0129  
  110 READ INPUTTAPEITD,111,((IE1(N)), (Z2(I1), I1 = 1,10))             CP0130  
  111 FORMAT(5X,I5,1X,10A6)                                             CP0131  
      IF (IE1(N))122,113,113                                            CP0132  
  113 WRITE TAPE IBIT,((IE1(N)), (Z2(I1), I1 = 1,10))                   CP0133  
      IF (N - 1) 117,115,117                                            CP0134  
  115 N = N + 1                                                         CP0135  
      GOTO 110                                                          CP0136  
  117 IF (IE1(N) - IE1(N-1)) 118,118,115                                CP0137  
  118 IERR = 2                                                          CP0138  
      WRITE OUTPUT TAPE 6,120,N,(IE1(N)), (Z2(I1), I1 = 1,10)           CP0139  
  120 FORMAT(1H1,10HEVENT CARD,I5,16H IS OUT OF ORDER,15X,I5,2X,10A6)   CP0140  
      GOTO 115                                                          CP0141  
  122 N = N - 1                                                         CP0142  
      DO 183  I2 = 1,N                                                  CP0143  
      DO 178  I3 = 1,L                                                  CP0144  
      IF (IE1 (I2) - IA1(I3)) 177,183,177                               CP0145  
  177 IF (IE1 (I2) - IA2(I3)) 178,183,178                               CP0146  
  178 CONTINUE                                                          CP0147  
      IERR = 6                                                          CP0148  
      WRITE OUTPUT TAPE 6,181, IE1(I2)                                  CP0149  
  181 FORMAT(1H1,57HINCONSISTENCIES EXIST BETWEEN EVENTS AND ACTIVITIES,CP0150  
     *EVENT,I5,38H IS NOT INCLUDED IN LIST OF ACTIVITIES)               CP0151  
  183 CONTINUE                                                          CP0152  
      DO 192 I2 = 1,L                                                   CP0153  
      DO 187 I3 = 1,N                                                   CP0154  
      IF (IA1(I2) - IE1(I3)) 187,192,187                                CP0155  
  187 CONTINUE                                                          CP0156  
      IERR = 6                                                          CP0157  
      WRITE OUTPUT TAPE 6,190, IA1(I2)                                  CP0158  
  190 FORMAT(1H1,68HINCONSISTENCIES EXIST BETWEEN EVENTS AND ACTIVITIES,CP0159  
     *PRECEEDING EVENT,I5,34H IS NOT INCLUDED IN LIST OF EVENTS)        CP0160  
  192 CONTINUE                                                          CP0161  
      DO 201 I2 = 1,L                                                   CP0162  
      DO 196 I3 = 1,N                                                   CP0163  
      IF (IA2(I2) - IE1(I3)) 196,201,196                                CP0164  
  196 CONTINUE                                                          CP0165  
      IERR = 6                                                          CP0166  
      WRITE OUTPUT TAPE 6,199, IA2(I2)                                  CP0167  
  199 FORMAT(1H1,68HINCONSISTENCIES EXIST BETWEEN EVENTS AND ACTIVITIES,CP0168  
     *SUCCEEDING EVENT,I5,34H IS NOT INCLUDED IN LIST OF EVENTS)        CP0169  
  201 CONTINUE                                                          CP0170  
      IF (IERR) 235,203,235                                             CP0171  
  203 I2 = 1                                                            CP0172  
      IE4(1) = 1                                                        CP0173  
      DO 210 I3=1,L                                                     CP0174  
  206 IF (IA1(I3) - IE1(I2)) 207,210,207                                CP0175  
  207 I2 = I2 + 1                                                       CP0176  
      IE4(I2)=I3                                                        CP0177  
      GOTO 206                                                          CP0178  
  210 IA1(I3) = I2                                                      CP0179  
      NM1 = N - 1                                                       CP0180  
      DO 211  I1 = 2,NM1                                                CP0181  
      IF (IE4 (I1) - IE4 (I1-1)) 212,212,211                            CP0182  
  211 CONTINUE                                                          CP0183  
      GOTO 216                                                          CP0184  
  212 IERR = 7                                                          CP0185  
      WRITE OUTPUT TAPE 6,214                                           CP0186  
  214 FORMAT(1H1,92HINCONSISTENCIES EXIST BETWEEN NUMBER OF PRECEEDING ECP0187  
     *VENTS AND NUMBER OF TOTAL EVENTS                         )        CP0188  
  216 I3 = 1                                                            CP0189  
  217 DO 222 I2 = 1,N                                                   CP019!  
  218 IF (IA2(I3) - IE1(I2)) 217,219,222                                CP0190  
  219 IA2(I3) = I2                                                      CP0191  
      I3 = I3 + 1                                                       CP0192  
      IF (I3 - L) 218,218,223                                           CP0193  
  222 CONTINUE                                                          CP0194  
  223 DO 224  I2 = 1,N                                                  CP0195  
  224 IE1(I2) = I2                                                      CP0196  
      IE4(N) = L + 1                                                    CP0197  
      Z=1.                                                              CP0198  
      DO 232 J=1,L                                                      CP0199  
      IF(A4(J)-1.) 225,225,231                                          CP0200  
  225 V=SIGNF(Z,A4(J))                                                  CP0201  
      IF(V) 226,228,228                                                 CP0202  
  226 IF(A4(J)+1.) 232,227,227                                          CP0203  
  227 A4(J)=-1.                                                         CP0204  
      GO TO 232                                                         CP0205  
  228 IF(A8(J)-A9(J)) 230,229,230                                       CP0206  
  229 A4(J)=0.                                                          CP0207  
      GO TO 232                                                         CP0208  
  230 A4(J)=1.                                                          CP0209  
      GO TO 232                                                         CP0210  
  231 W1=INTF(A4(J))                                                    CP0211  
      W2=INTF(A4(J)+.5)                                                 CP0212  
      A4(J)=MAX1F(W1,W2)                                                CP0213  
  232 CONTINUE                                                          CP0214  
      WRITE TAPE IBIT, (IE4(I1), I1 = 1,N)                              CP0215  
      WRITE TAPE IBIT, (IA2(I1), I1 = 1,L)                              CP0216  
      WRITE TAPE IBIT, (A4(I1), I1 = 1,L)                               CP0217  
  235 RETURN                                                            CP0218  
*BREAK                                                                  CP0219  
*COMPILE,PRINT SAP,PUNCH OBJECT                                 CRF20000CP0220  
C      FINAL CORE 2                                                     CP0221  
      DIMENSIONIA2(720),A3(720),IA5(720),A6(720),A7(720),A8(720),A9(720)CP0222  
      DIMENSION IE4(600),E5(600)                                        CP0223  
      COMMON FIN,FIN1,I9SW,ICP,ITC,IB1T,IT1,IT2,ITD,IB1,IB2,IDEC,IERR   CP0224  
      COMMON ITC1,ITC2,ITC3,IU,IK,MIK,B,N,LL,ICC,LLIM,NLIM              CP0225  
      EQUIVALENCE (A3,A6)                                               CP0226  
 1400 I9SW=I9SW                                                         CP0227  
      GO TO(1401,1401,1401,1750,1401),I9SW                              CP0228  
 1401 READ TAPE IT2,N,LL                                                CP0229  
      IF(N-NLIM) 1404,1404,1406                                         CP0230  
 1404 IF(LL-LLIM) 1410,1410,1406                                        CP0231  
 1406 IERR=8                                                            CP0232  
      Y=SELPGMF(4)                                                      CP0233  
 1410 CONTINUE                                                          CP0234  
      READ TAPE IT2,(IE4(J),J=1,N)                                      CP0235  
      READ TAPE IT2,(IA2(L),L=1,LL)                                     CP0236  
      READ TAPE IT2                                                     CP0237  
C      ABOVE READ SPACES OVER A4(L)                                     CP0238  
      READ TAPE IT2,(A8(L),L=1,LL)                                      CP0239  
      READ TAPE IT2,(A9(L),L=1,LL)                                      CP0240  
      REWIND IT2                                                        CP0241  
      FN=N                                                              CP0242  
      FLL=LL                                                            CP0243  
      ITC1=(2300.-.0925*FN-.0975*FLL-.125)/(.005*FN+.015*FLL+0.5)       CP0244  
      ITC2=(2300.)/(.005*FN+.015*FLL+0.5)                               CP0245  
      ITC3=ITC1                                                         CP0246  
      IU=1                                                              CP0247  
 1500 GO TO(1505,1735,1735,1505,1505),I9SW                              CP0248  
 1505 DO 1510 I=1,N                                                     CP0249  
 1510 E5(I)=0.                                                          CP0250  
      N0=N-1                                                            CP0251  
      DO 1570 I=1,N0                                                    CP0252  
      K1=IE4(I)                                                         CP0253  
      K2=IE4(I+1)-1                                                     CP0254  
      DO 1560 K=K1,K2                                                   CP0255  
      J=IA2(K)                                                          CP0256  
      X=A9(K)+E5(I)                                                     CP0257  
      E5(J)=MAX1F(E5(J),X)                                              CP0258  
C      PT. ALPHA 3 BELOW                                                CP0259  
 1560 CONTINUE                                                          CP0260  
C      PT. ALPHA 2 BELOW                                                CP0261  
 1570 CONTINUE                                                          CP0262  
      REWIND IT1                                                        CP0263  
      IK=0                                                              CP0264  
      WRITE TAPE IT1,(IK,N,LL,B)                                        CP0265  
 1590 DO 1595 L=1,LL                                                    CP0266  
 1595 A3(L)=0.                                                          CP0267  
      WRITE TAPE IT1,(A3(L),L=1,LL)                                     CP0268  
      DO 1690 I=1,N0                                                    CP0269  
      K1=IE4(I)                                                         CP0270  
      K2=IE4(I+1)-1                                                     CP0271  
      DO 1680 L=K1,K2                                                   CP0272  
      J=IA2(L)                                                          CP0273  
      A6(L)=A9(L)+E5(I)-E5(J)                                           CP0274  
      A7(L)=A8(L)+E5(I)-E5(J)                                           CP0275  
      IF(A7(L)) 1650,1675,1650                                          CP0276  
 1650 IF(A6(L)) 1655,1665,1655                                          CP0277  
 1655 IA5(L)=1                                                          CP0278  
      GO TO 1680                                                        CP0279  
 1665 IA5(L)=2                                                          CP0280  
      GO TO 1680                                                        CP0281  
 1675 IA5(L)=3                                                          CP0282  
C      PT. ALPHA 6 BELOW                                                CP0283  
 1680 CONTINUE                                                          CP0284  
C      PT. ALPHA 5 BELOW                                                CP0285  
 1690 CONTINUE                                                          CP0286  
      WRITE TAPE IT1,(IA5(L),L=1,LL)                                    CP0287  
      WRITE TAPE IT1,(A6(L),L=1,LL)                                     CP0288  
      WRITE TAPE IT1,(A7(L),L=1,LL)                                     CP0289  
      WRITE TAPE IT1,(A9(L),L=1,LL)                                     CP0290  
      WRITE TAPE IT1,(A8(L),L=1,LL)                                     CP0291  
      END FILE IT1                                                      CP0292  
      REWIND IT1                                                        CP0293  
C      HAVE SET UP BINARY TAPE IT1                                      CP0294  
C      CALL IN CORE 3                                                   CP0295  
 1735 Y=SELPGMF(3)                                                      CP0296  
C      RESTART BEGINS HERE                                              CP0297  
 1750 WRITE OUTPUT TAPE 6,1751,I9SW,IT1,IT2                             CP0298  
 1751 FORMAT(1H1,33H REACHED RESTART IN CORE 2. I9SW=,I2,6H. IT1=,I2,7H.CP0299  
     1  IT2=,I2)                                                        CP0300  
      REWIND IB1T                                                       CP0301  
      REWIND IT1                                                        CP0302  
      REWIND IT2                                                        CP0303  
      CONTINUE                                                          CP0304  
*BREAK                                                                  CP0305  
*COMPILE,PRINT SAP,PUNCH OBJECT                                 CRF30000CP0306  
C      FINAL CORE 3                                                     CP0307  
      DIMENSION IA2(592),A3(592),A4(592),IA5(592),A6(592),A7(592)       CP0308  
      DIMENSION A8(592),A9(592),A10(592)                                CP0309  
      DIMENSION IE1(520),IE2(527),E3(527),IE4(527),E5(527),E6(527)      CP0310  
      COMMON FIN,FIN1,I9SW,ICP,ITC,IB1T,IT1,IT2,ITD,IB1,IB2,IDEC,IERR   CP0311  
      COMMON ITC1,ITC2,ITC3,IU,IK,MIK,B,N,LL,ICC,LLIM,NLIM              CP0312  
      EQUIVALENCE (A6,A3,A10),(A9,IA5),(A8,A7,E5,IE2),(E6,E3)           CP0313  
 1950 I9SW=I9SW                                                         CP0314  
      GO TO(1952,1952,1952,8000,1952),I9SW                              CP0315  
 1952 READ TAPE IT2,N,LL                                                CP0316  
      READ TAPE IT2,(IE4(J),J=1,N)                                      CP0317  
      READ TAPE IT2,(IA2(L),L=1,LL)                                     CP0318  
      READ TAPE IT2,(A4(L),L=1,LL)                                      CP0319  
      READ TAPE IT2,(A8(L),L=1,LL)                                      CP0320  
      READ TAPE IT2,(A9(L),L=1,LL)                                      CP0321  
      READ TAPE IT2,(A10(L),L=1,LL)                                     CP0322  
      REWIND  IT2                                                       CP0323  
      REWIND  IT1                                                       CP0324  
      IK=0                                                              CP0325  
C                                                                       CP0326  
C     BINARY EDIT ROUTINE , CPP                                         CP0327  
 2000  TC=0.                                                            CP0328  
      DO 2011 J=1,LL                                                    CP0329  
      IF(A4(J)) 2002,2007,2007                                          CP0330  
 2002 V=-1.                                                             CP0331  
 2003 IF(A10(J)-A9(J)) 2006,2004,2004                                   CP0332  
 2004 IF(A4(J)+1.) 2010,2005,2005                                       CP0333  
 2005 A9(J)=0.                                                          CP0334  
      GO TO 2011                                                        CP0335  
 2006 A10(J)=A8(J)                                                      CP0336  
      GO TO 2004                                                        CP0337  
 2007 V=1.                                                              CP0338  
 2008 IF(A4(J)-1.) 2009,2009,2010                                       CP0339  
 2009 A9(J)=0.                                                          CP0340  
      GO TO 2011                                                        CP0341  
 2010 A9(J)=A10(J)*V*A4(J)                                              CP0342  
      TC=TC+A9(J)                                                       CP0343  
 2011 CONTINUE                                                          CP0344  
      TC= -TC+B                                                         CP0345  
 2040 DO2050 I=1,N                                                      CP0346  
      E5(I)=0.                                                          CP0347  
      E6(I)=FIN1                                                        CP0348  
 2050 CONTINUE                                                          CP0349  
 2060 N0 =N-1                                                           CP0350  
      DO2100 I=1,N0                                                     CP0351  
      K1=IE4(I)                                                         CP0352  
      K2=IE4(I+1)-1                                                     CP0353  
 2070 DO2090 K=K1,K2                                                    CP0354  
      J=IA2(K)                                                          CP0355  
      X=A10(K)+E5(I)                                                    CP0356  
      E5(J)= MAX1F(E5(J),X)                                             CP0357  
 2090 CONTINUE                                                          CP0358  
 2100 CONTINUE                                                          CP0359  
      E6(N)= E5(N)                                                      CP0360  
 2110 DO2140I=1,N0                                                      CP0361  
      I0=N-I                                                            CP0362  
      K1=IE4(I0)                                                        CP0363  
      K2=IE4(I0+1)-1                                                    CP0364  
      DO 2130 K=K1,K2                                                   CP0365  
      J=IA2(K)                                                          CP0366  
      X=E6(J)-A10(K)                                                    CP0367  
      E6(I0)=MIN1F(E6(I0),X)                                            CP0368  
 2130 CONTINUE                                                          CP0369  
 2140 CONTINUE                                                          CP0370  
