C       FINAL  CORE-1                                                   CP0013  
      COMMON FIN,FIN1,I9SW,ICP,ITC,IB1T,IT1,IT2,ITD,IB1,IB2,IDEC,IERR   CP0014  
      COMMON ITC1,ITC2,ITC3,IU,IK,MIK,B,N,LL,ICC,LLIM,NLIM              CP0015  
      DIMENSION IA1(716),IA2(716),A4(716),A8(716),A9(716)               CP0016  
      DIMENSION IE1(597),IE4(597)                                       CP0017  
      FIN=.9E37                                                         CP0018  
      FIN1=.95E37                                                       CP0019  
      IERR=0                                                            CP0020  
      ICC=5                                                             CP0021  
      LLIM=592                                                          CP0022  
      NLIM=527                                                          CP0023  
      IB2=8                                                             CP0024  
      ITC=9                                                             CP0025  
      ICP=10                                                            CP0026  
      ITD=7                                                             CP0027  
      IT1=4                                                             CP0028  
      IT2=8                                                             CP0029  
      IB1T=3                                                            CP0030  
      IDEC=6                                                            CP0031  
      IB1=4                                                             CP0032  
