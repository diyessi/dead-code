   16 FORMAT(10I5)                                                      CP0034  
      I9SW=I9SW                                                         CP0035  
      GO TO (25,25,25,20,42),I9SW                                       CP0036  
   20 READ INPUT TAPE 7,16,IT1,IT2                                      CP0037  
      WRITE OUTPUT TAPE 6,22,IT1,IT2                                    CP0038  
   22 FORMAT(1H1,41HAM IN CORE 1, PREPARING TO RESTART.  IT1=,I2,6H. IT1CP0039  
     1=,I2)                                                             CP0040  
      PAUSE 102                                                         CP0041  
      REWIND IB1T                                                       CP0042  
      REWIND IT1                                                        CP0043  
      REWIND IT2                                                        CP0044  
      GO TO 41                                                          CP0045  
   25 PAUSE 101                                                         CP0046  
      REWIND IB1T                                                       CP0047  
      REWIND IT1                                                        CP0048  
