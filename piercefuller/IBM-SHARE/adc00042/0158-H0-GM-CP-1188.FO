      WRITE TAPE IT2,(A4(L),L=1,LL)                                     CP0056  
      WRITE TAPE IT2,(A8(L),L=1,LL)                                     CP0057  
      WRITE TAPE IT2,(A9(L),L=1,LL)                                     CP0058  
      WRITE TAPE IT2,(A9(L),L=1,LL)                                     CP0059  
C      LAST RECORD SERVES AS A10(L) IN CORE O.                          CP0060  
      END FILE IT2                                                      CP0061  
      REWIND IT2                                                        CP0062  
   41 Y=SELPGMF(2)                                                      CP0063  
   42 PAUSE 104                                                         CP0064  
