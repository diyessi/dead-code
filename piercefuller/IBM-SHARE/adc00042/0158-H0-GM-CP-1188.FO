      CALL INPUT(IB1T,ITD,IA1,IA2,A4,A8,A9,IE1,IE4,N,LL,IERR,B)         CP0050  
      IF(IERR) 31,32,31                                                 CP0051  
   31 Y=SELPGMF(4)                                                      CP0052  
   32 WRITE TAPE IT2,N,LL                                               CP0053  
      WRITE TAPE IT2,(IE4(J),J=1,N)                                     CP0054  
