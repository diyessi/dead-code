*BIOPAK       BUFFERED I/O PACKAGE FOR FORTRAN                          BIOP0000
*                                                                       BIOP0001
       COUNT   200                                                      BIOP0002
       ENTRY   BSETUP                                                   BIOP0003
       ENTRY   BRESET                                                   BIOP0004
       ENTRY   ULDBFR                                                   BIOP0005
       ENTRY   LDBFR                                                    BIOP0006
       ENTRY   BINWT                                                    BIOP0007
       ENTRY   BINRD                                                    BIOP0008
       ENTRY   BCDRD                                                    BIOP0009
       ENTRY   BCDWT                                                    BIOP0010
       ENTRY   ENDTRM                                                   BIOP0011
       EXTERN  IBIN                                                     BIOP0012
       EXTERN  OBIN                                                     BIOP0013
       EXTERN  IDEC                                                     BIOP0014
       EXTERN  ODEC                                                     BIOP0015
       EXTERN  IOEND                                                    BIOP0016
       EXTERN  IORPT                                                    BIOP0017
       EXTERN  IORDY                                                    BIOP0018
*                                                                       BIOP0019
* BSETUP(TAPENO,BUFFER,LENGTH)                                          BIOP0020
*                                                                       BIOP0021
BSETUP SXA     IR11,1                                                   BIOP0022
       SXA     IR41,4                                                   BIOP0023
       CLA*    1,4            TAPE NUMBER TO IR1                        BIOP0024
       PDX     0,1                                                      BIOP0025
       SXA     SST,1                                                    BIOP0026
       CLS*    3,4            LENGTH OF BUFFER                          BIOP0027
       LGR     19                                                       BIOP0028
       SLW     BPACK,1        MAX RECD SIZE TO ADR OF BPACK             BIOP0029
       LGL     1                                                        BIOP0030
       ADD     2,4                                                      BIOP0031
       ADD     =1                                                       BIOP0032
       STA     BFR,1          WORKING BUFFER IN ADR OF BFR              BIOP0033
       ALS     18             FWA OF BUFFER IN DECR OF BFR              BIOP0034
       STD     BFR,1                                                    BIOP0035
       TSX     $IORDY,4                                                 BIOP0036
 SST   PZE                                                              BIOP0037
 IR41  AXT     ,4                                                       BIOP0038
 IR11  AXT     **,1                                                     BIOP0039
       TRA     4,4                                                      BIOP0040
*                                                                       BIOP0041
* BRESET(TAPENO,COUNT)                                                  BIOP0042
*                                                                       BIOP0043
BRESET SXA     IR12,1                                                   BIOP0044
       CLA*    1,4                                                      BIOP0045
       PDX     0,1                                                      BIOP0046
       CLA*    2,4                                                      BIOP0047
       TZE     *+2                                                      BIOP0048
       ADD     BPACK,1                                                  BIOP0049
       STO     BPACK,1                                                  BIOP0050
 IR12  AXT     **,1                                                     BIOP0051
       TRA     3,4                                                      BIOP0052
*                                                                       BIOP0053
* BINWT(TAPENO,NUMWDS,IVAR)                                             BIOP0054
* BINRD(TAPENO,NUMWDS,IVAR)                                             BIOP0055
* BCDWT(TAPENO,NUMWDS,IVAR)                                             BIOP0056
* BCDRD(TAPENO,NUMWDS,IVAR)                                             BIOP0057
*                                                                       BIOP0058
 BCDRD CLA     BCDR                                                     BIOP0059
       STO     CALL                                                     BIOP0060
       TRA     BINRD+2                                                  BIOP0061
 BCDWT CLA     BCDW                                                     BIOP0062
       STO     CALL                                                     BIOP0063
       TRA     BINWT+2                                                  BIOP0064
 BINWT CLA     WRITE          SET SUBR CALL FOR WRITE                   BIOP0065
       STO     CALL                                                     BIOP0066
       CLA     CHNG                                                     BIOP0067
       STD     TWCH           SET ARG5 FOR WRITE                        BIOP0068
       CLA     CHNG+1                                                   BIOP0069
       STD     TWCH2                                                    BIOP0070
       TRA     ENTRY                                                    BIOP0071
 BINRD CLA     READ           SET CALL FOR READ                         BIOP0072
       STO     CALL                                                     BIOP0073
       CLA     NOP                                                      BIOP0074
       STD     TWCH           BYPASS ARG5 IN CALL                       BIOP0075
       STD     TWCH2                                                    BIOP0076
       STZ     ARG5                                                     BIOP0077
 ENTRY SXA     IR13,1                                                   BIOP0078
       SXA     IR23,2                                                   BIOP0079
       SXA     IR43,4                                                   BIOP0080
       CLA*    1,4                                                      BIOP0081
       PDX     0,1                                                      BIOP0082
 STRT  SXA     ARG1,1         TAPE NUMBER TO ARG 1                      BIOP0083
       CLA     BFR,1          GET FWA OF BUFFER                         BIOP0084
       PDX     ,2                                                       BIOP0085
       SXA     ARG2,2          FWA OF BUFFER                            BIOP0086
       CLA     BPACK,1                                                  BIOP0087
       TMI     REPT           WAS LAST OUTPUT OK                        BIOP0088
       STA     ARG3           LENGTH OF 1/2 BUFFER                      BIOP0089
 TWCH  PZE     18             NOP-READ/ARS-WRITE                        BIOP0090
       STA     ARG4           NUMBER OF WDS                             BIOP0091
 TWCH2 PZE     ARG5           NOP-READ/STA-WRITE                        BIOP0092
 CALL  TSX     **,4           CALL FOR INOUT                            BIOP0093
 ARG1  PZE                                                              BIOP0094
 ARG2  PZE                                                              BIOP0095
 ARG3  PZE                                                              BIOP0096
 ARG4  PZE                                                              BIOP0097
 ARG5  PZE                                                              BIOP0098
       STD     SUB            NUMWDS TRANS.                             BIOP0099
 IR43  AXT     **,4                                                     BIOP0100
       STD*    2,4                                                      BIOP0101
       PAX     0,2                                                      BIOP0102
 SUB   TNX     *+1,2,**       OBTAIN BSS BFR ADDRESS                    BIOP0103
       TMI     ERROR                                                    BIOP0104
 RETN  STZ*    3,4            ZERO INDICATOR FOR NORMAL RETURN          BIOP0105
       PXA     ,2             WORKING BFR ADR TO AC                     BIOP0106
       STP     BPACK,1        BPACK POS FOR OK TRANS.                   BIOP0107
       STD     BPACK,1        ZERO PACK WORD COUNTER                    BIOP0108
       STA     BFR,1          WORKING BUFFER                            BIOP0109
 IR13  AXT     ,1             RETURN                                    BIOP0110
 IR23  AXT     ,2                                                       BIOP0111
       TRA     4,4                                                      BIOP0112
 ERROR ALS     2                                                        BIOP0113
       PBT                                                              BIOP0114
       TRA     EOF                                                      BIOP0115
       ZET     ARG5           WAS ERROR ON READ                         BIOP0116
       STP     BPACK,1        WRITE ERR MAKES PACK WORD NEG             BIOP0117
       CLA     LD(2)                                                    BIOP0118
       STO*    3,4            INDICATE ERROR TO USER                    BIOP0119
       PXA     ,2             WORKING BFR ADR TO AC                     BIOP0120
       TRA     RETN+3                                                   BIOP0121
 EOF   CLA     LD(1)          EOF OR TAPE                               BIOP0122
       STO*    3,4                                                      BIOP0123
       TRA     RETN+1                                                   BIOP0124
*                                                                       BIOP0125
*   REPEAT FOR WRITE ERROR                                              BIOP0126
*                                                                       BIOP0127
 REPT  SXA     R1,1           TAPE NUMBER TO ARG                        BIOP0128
       TSX     $IORPT,4       REPEAT LAST OUTPUT TRANSMISSION           BIOP0129
 R1    PZE                                                              BIOP0130
       TRA     ARG5+1                                                   BIOP0131
*                                                                       BIOP0132
*                                                                       BIOP0133
ENDTRM SXA     IR13,1                                                   BIOP0134
       SXA     IR23,2                                                   BIOP0135
       SXA     IR43,4                                                   BIOP0136
       CLA*    1,4                                                      BIOP0137
       PDX     ,1                                                       BIOP0138
       SXA     *+2,1                                                    BIOP0139
       TSX     $IOEND,4                                                 BIOP0140
       PZE                                                              BIOP0141
       TRA     ARG5+1                                                   BIOP0142
*                                                                       BIOP0143
* ULDBFR(TAPENO,A1,N1,A2,N2,...,AM,NM)                                  BIOP0144
*  LDBFR(TAPENO,A1,N1,A2,N2,...,AM,NM)                                  BIOP0145
*                                                                       BIOP0146
LDBFR  CLA     ADR1                                                     BIOP0147
       STA     A2                                                       BIOP0148
       STT     TO1                                                      BIOP0149
       CLA     ADR2                                                     BIOP0150
       STA     A1                                                       BIOP0151
       STT     FROM1                                                    BIOP0152
       TRA     ENTER                                                    BIOP0153
ULDBFR CLA     ADR1                                                     BIOP0154
       STA     A1                                                       BIOP0155
       STT     FROM1                                                    BIOP0156
       CLA     ADR2                                                     BIOP0157
       STA     A2                                                       BIOP0158
       STT     TO1                                                      BIOP0159
 ENTER SXA     IR14,1                                                   BIOP0160
       SXA     IR24,2                                                   BIOP0161
       CLA*    1,4                                                      BIOP0162
       PDX     0,1                                                      BIOP0163
       SXA     OUT1,1                                                   BIOP0164
       CLA     BFR,1          OBTAIN CURRENT WORK ADDRESS               BIOP0165
 A1    STA     **             LD-SOURCE,ULD-OBJECT ARRAY                BIOP0166
       CLA     BPACK,1        OBTAIN CURRENT WDS UNPACKED               BIOP0167
       PDC     ,2                                                       BIOP0168
       TXI     *+1,4,-1                                                 BIOP0169
 STLP  CLA     1,4            BEGIN UNLOAD LOOP THIS CALL               BIOP0170
       PAI                                                              BIOP0171
       IIS     2,4                                                      BIOP0172
       LFT     777777         IS THERE ANOTHER ARG SET                  BIOP0173
       TRA     OUT1                                                     BIOP0174
 A2    STA     **             ADDRESS OF OBJECT ARRAY                   BIOP0175
       CLA*    2,4            NUMWDS TO OBJECT ARRAY                    BIOP0176
       TZE     NEWST                                                    BIOP0177
       TMI     NEWST                                                    BIOP0178
       SUB     LD(1)                                                    BIOP0179
       STD     SWCH2          BEGIN UNPACK LOOP                         BIOP0180
       AXT     0,1                                                      BIOP0181
 FROM1 CLA     **,2                                                     BIOP0182
 TO1   STO     **,1                                                     BIOP0183
       TXI     *+1,2,-1                                                 BIOP0184
       TXI     *+1,1,1                                                  BIOP0185
 SWCH2 TXL     FROM1,1,**                                               BIOP0186
 NEWST TXI     STLP,4,-2      TRY ANOTHER ARG SET                       BIOP0187
 OUT1  AXT     **,1                                                     BIOP0188
       SXA     *+1,2                                                    BIOP0189
       AXC     **,2                                                     BIOP0190
       PXD     ,2                                                       BIOP0191
       STD     BPACK,1                                                  BIOP0192
 IR14  AXT     ,1                                                       BIOP0193
 IR24  AXT     ,2                                                       BIOP0194
       TRA     1,4                                                      BIOP0195
*                                                                       BIOP0196
* CONSTANTS AND STORAGE ARRAYS                                          BIOP0197
*                                                                       BIOP0198
 ADR1  PZE     FROM1,2                                                  BIOP0199
 ADR2  PZE     TO1,1                                                    BIOP0200
 WRITE TSX     $OBIN,4                                                  BIOP0201
 READ  TSX     $IBIN,4                                                  BIOP0202
 BCDR  TSX     $IDEC,4                                                  BIOP0203
 BCDW  TSX     $ODEC,4                                                  BIOP0204
 NOP   NOP                                                              BIOP0205
 CHNG  ARS     0                                                        BIOP0206
       STA     **                                                       BIOP0207
 LD(1) PZE     ,,1                                                      BIOP0208
 LD(2) PZE     ,,2                                                      BIOP0209
 BFR   BES     15                                                       BIOP0210
 BPACK BES     15                                                       BIOP0211
       END                                                              BIOP0212
