C INVERSE NORMAL PROBABILITY FUNCTION                                   NA861001
C DECK NUMBER 4B-103                                                    NA861002
                                                                        NA861003
C PROGRAMMER - M SINGLETON - 056/072 - LA                               NA861004
                                                                        NA861005
C DESCRIPTION -                                                         NA861006
C       THIS SUBROUTINE IS A COMPANION SUBROUTINE TO 4B-102 (NORMAL     NA861007
C       PROBABILITY FUNCTIONS -- ORDINATE AND AREA SUBROUTINE) IN THAT  NA861008
C       4B-102 IS USED WHEN THE ABSCISSA IS GIVEN AND THE AREA AND/OR   NA861009
C       ORDINATE IS TO BE DETERMINED WHILE THIS SUBROUTINE IS USED IN   NA861010
C       THE OPPOSITE CASE-- THAT IS, WHEN THE AREA OR ORDINATE IS GIVEN NA861011
C       AND THE ABSCISSA IS TO BE DETERMINED.                           NA861012
                                                                        NA861013
C       BY USING SUBROUTINE 4B-102, THE AREAL SEGMENT UNDER THE NORMAL  NA861014
C       CURVE MAY BE COMPUTED IN ANY ONE OF FIVE DIFFERENT FORMS OR THE NA861015
C       ORDINATE ONLY MAY BE COMPUTED.  IN A SIMILAR BUT OPPOSITE CASE, NA861016
C       BY USING THIS SUBROUTINE, THE THE ARGUMENT (ABSCISSA XARG) MAY  NA861017
C       BE DETERMINED WHEN GIVEN ANY ONE OF THE FIVE AREAL SEGMENTS OR  NA861018
C       ONLY THE ORDINATE OF EITHER OF THE TWO CLOSELY RELATED FUNCTIONSNA861019
C       DESCRIBED IN 4B-102.                                            NA861020
                                                                        NA861021
C USE - LINKAGE - CALL INPOA(AORG,ITYPE,XARG,ERR)                       NA861022
                                                                        NA861023
C     - LIST OF SYMBOLS                                                 NA861024
                                                                        NA861025
C                AORG  - AREAL SEGMENT UNDER NORMAL CURVE OR ORDINATE   NA861026
C                        FOR NORMAL CURVE.  FOR LIMITS ON AORG, SEE     NA861027
C                        SPECIFICATIONS UNDER ITYPE BELOW.              NA861028
C                ITYPE - SIGNED FIXED POINT VARIABLE TO SPECIFY THE     NA861029
C                        FUNCTION TYPE AND FORM OF AORG ABOVE.          NA861030
                                                                        NA861031
C                         ITYPE               AORG               ITYPE  NA861032
C                         TYPE A          AREAL SEGMENT          TYPE B NA861033
C                        FUNCTION                               FUNCTIONNA861034
                                                                        NA861035
C                          +1     CENTRAL AREA FROM -X TO +X       -1   NA861036
C                                 AORG GREATER THAN OR EQUAL            NA861037
C                                 TO 0.0 AND LESS THAN 1.0              NA861038
C                          +2   SEMICENTRAL AREA FROM 0 TO +X      -2   NA861039
C                               AORG GREATER THAN OR EQUAL TO           NA861040
C                               0.0 AND LESS THAN 0.5                   NA861041
C                          +3   TWO-TAIL AREA BEYOND -X AND +X     -3   NA861042
C                               AORG GREATER THAN 0.0 AND LESS          NA861043
C                               THAN OR EQUAL TO 1.0                    NA861044
C                          +4     SINGLE-TAIL AREA BEYOND +X       -4   NA861045
C                                 AORG GREATER THAN 0.0 AND             NA861046
C                                 LESS THAN OR EQUAL TO 0.5             NA861047
C                          +5   AREA FROM MINUS INFINITY TO +X     -5   NA861048
C                               AORG GREATER THAN OR EQUAL TO           NA861049
C                               0.5 AND LESS THAN 1.0                   NA861050
C                          +6          ORDINATE VALUE              -6   NA861051
C                                 AORG FOR ITYPE EQUALS +6 MUST BE      NA861052
C                                 GREATER THAN 0.0 AND LESS THAN        NA861053
C                                 OR EQUAL TO 0.39894228                NA861054
C                                 AORG FOR ITYPE EQUALS -6 MUST BE      NA861055
C                                 GREATER THAN 0.0 AND LESS THAN        NA861056
C                                 OR EQUAL TO 1.12837916                NA861057
                                                                        NA861058
C                XARG  - ANSWER ABSCISSA ARGUMENT WHICH WILL RESULT IN  NA861059
C                        THE AREAL SEGMENT OR ORDINATE , AORG, IN THE   NA861060
C                        SPECIFIED FUNCTION TYPE.                       NA861061
C                ERR   - ERROR INDICATOR TO DENOTE SUCCESSFUL OR UNSUC- NA861062
C                        CESSFUL RETURN FROM THE SUBROUTINE.            NA861063
                                                                        NA861064
C                           SUCCESSFUL RETURN                 ERR = 0.0 NA861065
C                           UNSUCCESSFUL RETURN                         NA861066
C                              INADMISSIBLE VALUE FOR ITYPE   ERR = 1.0 NA861067
C                              AORG LIMITS FOR ASSOCIATED               NA861068
C                              VALUE OF ITYPE ARE EXCEEDED    ERR =-1.0 NA861069
                                                                        NA861070
C     - NOTE                                                            NA861071
C                IF AORG IS NEGATIVE, XARG IS COMPUTED FOR ABSOLUTE AORGNA861072
C                PROVIDED THAT ABSOLUTE AORG IS WITHIN PRESCRIBED LIMITSNA861073
                                                                        NA861074
C     *         **         **         **         **         **         *NA861075
                                                                        NA861076
      SUBROUTINE INPOA (AORG,ITYPE,XARG,ERR)                            NA861077
C                *          *          *                                NA861078
C     NO FREQUENCY, DIMENSION, OR EQUIVALENCE STATEMENT  REQUIRED       NA861079
C                *          *          *                                NA861080
                                                                        NA861081
                                                                        NA861082
C     TEST IF ITYPE ADMISSIBLE                                          NA861083
      IF (ITYPE) 1,21,1                                                 NA861084
    1 IF (XABSF(ITYPE)-6) 2,2,21                                        NA861085
    2 ERR = ABSF(AORG)                                                  NA861086
                                                                        NA861087
C     NORMALIZE AORG TO PROPER ARGUMENT FOR APPROXIMATION TRANSFORMATIONNA861088
      GO TO (11,12,13,14,15,16),ITYPE                                   NA861089
                                                                        NA861090
C     CENTRAL AREA AORG                                                 NA861091
   11 ERR = (1.0 - ERR)/2.0                                             NA861092
      GO TO 14                                                          NA861093
                                                                        NA861094
C     SEMICENTRAL AREA AORG                                             NA861095
   12 ERR = 0.5 - ERR                                                   NA861096
      GO TO 14                                                          NA861097
                                                                        NA861098
C     TWO-TAIL AREA AORG                                                NA861099
   13 ERR = ERR/2.0                                                     NA861100
      GO TO 14                                                          NA861101
                                                                        NA861102
C     CUMULATIVE AREA FROM MINUS INFINITIVE TO +AORG                    NA861103
   15 ERR = 1.0 - ERR                                                   NA861104
                                                                        NA861105
C     SINGLE-TAIL AREA AORG.                                            NA861106
C     TEST IF ERR GREATER THAN 0.0 AND LESS THAN OR EQUAL TO 0.5        NA861107
   14 IF (ERR) 3,22,3                                                   NA861108
    3 IF (ERR - 0.5) 4,4,22                                             NA861109
                                                                        NA861110
C     TRANSFORM ERR (AORG) FOR APPROXIMATION FORMULA                    NA861111
    4 ERR = SQRTF(LOGEF(1.0/ERR**2))                                    NA861112
                                                                        NA861113
C     APPROXIMATION                                                     NA861114
      XARG = ERR -  ((0.010328*ERR + 0.802853)*ERR + 2.515517)/(((      NA861115
     10.001308*ERR + 0.189269)*ERR + 1.432788)*ERR + 1.0 )              NA861116
                                                                        NA861117
C     TEST IF TYPE A OR TYPE B                                          NA861118
      IF (ITYPE)  5,21,20                                               NA861119
    5 XARG = 0.707106781 * XARG                                         NA861120
      GO TO 20                                                          NA861121
                                                                        NA861122
C     ORDINATE-INPUT-AORG  -  TEST IF TYPE A OR TYPE B                  NA861123
   16 IF (ITYPE) 6,21,7                                                 NA861124
    6 ERR  = 0.886226925* ERR                                           NA861125
      GO TO 8                                                           NA861126
    7 ERR  = 2.506628274* ERR                                           NA861127
                                                                        NA861128
C     TEST IF AORG WITHIN LIMITS                                        NA861129
    8 IF (ERR) 9,22,9                                                   NA861130
    9 IF (ERR - 1.0) 10,18,22                                           NA861131
   10 XARG = SQRTF( -LOGEF(ERR))                                        NA861132
                                                                        NA861133
C     TEST TYPE A OR TYPE B                                             NA861134
      IF (ITYPE) 20,21,17                                               NA861135
   17 XARG = 1.41421356 * XARG                                          NA861136
      GO TO 20                                                          NA861137
                                                                        NA861138
C     UNSUCCESSFUL RETURN - AORG LIMITS FOR ASSOCIATED ITYPE EXCEEDED   NA861139
   22 ERR = -1.0                                                        NA861140
      GO TO 23                                                          NA861141
                                                                        NA861142
C     UNSUCCESSFUL RETURN - INADMISSIBLE VALUE FOR ITYPE                NA861143
   21 ERR = 1.0                                                         NA861144
      GO TO 23                                                          NA861145
                                                                        NA861146
   18 XARG = 0.0                                                        NA861147
                                                                        NA861148
C     SUCCESSFUL  RETURN                                                NA861149
   20 ERR = 0.0                                                         NA861150
   23 RETURN                                                            NA861151
      END                                                               NA861152
