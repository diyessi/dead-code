 CRSET SYN B$CRSET                                                      MIMS3782
 TXL   SYN B$TXL                                                        MIMS3783
       SKP 1                                                            MIMS3784
       REM MDEF--MACRO DEFINITION TABLE, HOLDS MACRO DEFINITIONS        MIMS3785
       REM      AND INSTRUCTIONS FOR REMOTE ASSEMBLY.                   MIMS3786
       REM                                                              MIMS3787
       REM TO ADD SYSTEM MACROS, LOAD OR DEFINE MACROS IN ORDER OF      MIMS3788
       REM      DECREASING FREQUENCY OF EXPECTED USE, RETURN CONTROL    MIMS3789
       REM      TO BE SYSTEM BY PLB 1, OBTAIN ROW BINARY DECK           MIMS3790
       REM      OF MACRO DEFINITIONS BY SYSTEM CONTROL CARD             MIMS3791
       REM                   DMP 11,LOW,57777                           MIMS3792
       REM      WHERE LOW = TWO$ COMPLEMENT OF CONTENTS OF 57777 DECR.  MIMS3793
       REM      THEN EDIT TO REPLACE RECORD 15 BY THE RESULTING DECK.   MIMS3794
       REM                                                              MIMS3795
       REM MDEF TABLE STARTS JUST BELOW OCTAL 60000, RUNS DOWN          MIMS3796
       REM      IN STORAGE. THE NEXT AVAILABLE LOCATION IS              MIMS3797
       REM      KEPT IN S.L. MEND, IN 2S COMPLEMENT FORM.               MIMS3798
       REM      MEND IS USED BY MOP, MAC, STUFF                         MIMS3799
       REM                                                              MIMS3800
       REM MDEF STRUCTURE                                               MIMS3801
       REM                                                              MIMS3802
       REM      EACH MACRO DEFINITION HAS A 3-WORD HEAD. THE FIRST      MIMS3803
       REM           WORD ADDRESS POINTS TO THE END OF THE DEFINITION,  MIMS3804
       REM           GIVING LENGTH FOR OUTPUT OF THE DEFINITION. EXAMPLEMIMS3805
       REM           HEAD PZE -(WORD BELOW DEF. EXAMPLE),,-(NEXT HEAD)  MIMS3806
       REM                BCD 1 NAME                                    MIMS3807
       REM                PZE ,,(ARGUMENT COUNT)                        MIMS3808
       REM                    (BEGIN DEFINING EXAMPLE)                  MIMS3809
       REM      NAME IS BCD PACKED TO RIGHT, LEADING ZEROS              MIMS3810
       REM                                                              MIMS3811
       REM      EACH BLOCK OF REMOTE INSTRUCTIONS HAS A 1-WORD HEAD     MIMS3812
       REM           HEAD PZE ,,-(NEXT HEAD)                            MIMS3813
       REM                                                              MIMS3814
       REM CODE USED IN MDEF -- FUNCTION ----------------- WRITTEN AS   MIMS3815
       REM   (OCTAL) 77        BOUND VARIABLE MARKER     PARAGRAPH SIGN MIMS3816
       REM           01        OPERATION MARKER          COLON          MIMS3817
       REM           00        END OF RECORD             SEMICOLON      MIMS3818
       REM         0000        END MARK, AT END OF       PAIR OF        MIMS3819
       REM                          EACH MACRO DEF.       SEMICOLONS    MIMS3820
       REM                                                              MIMS3821
       ABS                                                              MIMS3822
       ORG -512-10                                                      MIMS3823
   MDL EQU 8192              LENGTH OF MACRO TABLE                      MIMS3824
 MDEF                        START OF MOP AND RMT DEFINITION TABLE      MIMS3825
 RMTEN     ,,-1STRM          POINTER TO MOST RECENTLY DEFINED RMT SEQ.  MIMS3826
 1STRM                       POINTER TO FIRST REMOTE SEQUENCE           MIMS3827
 NAMEN     ,,-1STNM                                                     MIMS3828
 1STNM                                                                  MIMS3829
 LISEN     ,,-1STLS                                                     MIMS3830
 1STLS                                                                  MIMS3831
 MOMEN     ,,-1STMC          POINTER TO MOST RECENTLY DEFINED MACRO     MIMS3832
 1STMC                       POINTER TO FIRST DEFINED MACRO             MIMS3833
 MEND      ,,-MDEF           POINTER TO NEXT AVAILABLE WORD IN MDEF     MIMS3834
B      HED                                                              MIMS3835
 STL   SYN A$STL                                                        MIMS3836
A      HED                                                              MIMS3837
       END WRITE       GO TO SYSTEM EDIT,REPLACE BY END A$SRCHA TO RUN  MIMS3838
