C     R. E. LEVITAN -- INTEGER PROGRAMMING                              IP030001
C     SHARE VERSION                                                     IP030002
C     MAIN PROGRAM      SHARE VERSION                                   IP030003
C                                                                       IP030004
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP030005
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP030006
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP030007
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP030008
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP030009
     1(A1,IA1)                                                          IP030010
C                                                                       IP030011
      ASSIGN 1 TO JUMP                                                  IP030012
      IPRC = 0                                                          IP030013
      REWIND 10                                                         IP030014
 1    CALL SET 1                                                        IP030015
      IPRC = IPRC + 1                                                   IP030016
      WRITE OUTPUT TAPE 10,2,IPRC,ALPHA                                 IP030017
      PRINT 2,IPRC,ALPHA                                                IP030018
 2    FORMAT(14H1START PROBLEMI4,3H.  3A6)                              IP030019
      SENSE LIGHT 1                                                     IP030020
      IPCT = 0                                                          IP030021
      IVCT = 0                                                          IP030022
      IOCT = 0                                                          IP030023
      MS = 1                                                            IP030024
      CH = .5                                                           IP030025
      H = .5                                                            IP030026
      CALL SET2                                                         IP030027
      N3 = N                                                            IP030028
      CALL MOUT                                                         IP030029
      N3 = N + 1                                                        IP030030
      IF (SET3(V)) 1, 32, 1                                             IP030031
 32   IF (SENSE SWITCH 1) 23, 3                                         IP030032
 23   CALL MOUT                                                         IP030033
 3    IF (ROWS(KL,I1)) 24, 17, 17                                       IP030034
 24   IF (M2-I1) 7, 7, 8                                                IP030035
 7    MS = MSI                                                          IP030036
 8    IF (COLS(I1,J1)) 11, 9, 9                                         IP030037
 9    WRITE OUTPUT TAPE 10, 10                                          IP030038
      PRINT 10                                                          IP030039
 10   FORMAT(21H0PROBLEM HAS NO SOLN.)                                  IP030040
      GO TO 30                                                          IP030041
 11   CALL RCT (I1,J1)                                                  IP030042
      IF (PIV(I1,J1)) 12, 14, 14                                        IP030043
 12   CALL TWR (I1,J1)                                                  IP030044
      CALL RGEN                                                         IP030045
      IF (SENSE SWITCH 5)  13, 27                                       IP030046
 27   IF (IPCT-LIM) 3, 13, 3                                            IP030047
 13   IF (BRK(0)) 25, 1 ,1                                              IP030048
 25   ASSIGN 22 TO JUMP                                                 IP030049
      GO TO 3                                                           IP030050
 14   IF (RPIV(I1,J1)) 12, 15, 9                                        IP030051
 15   WRITE OUTPUT TAPE 10, 16                                          IP030052
      PRINT 16                                                          IP030053
 16   FORMAT(21H0UNCORRECTABLE OFLOW.)                                  IP030054
 30   IF (SENSE SWITCH 1) 31,28                                         IP030055
 28   CALL MOUT                                                         IP030056
   31 WRITE OUTPUT TAPE 10, 29,IPCT,IPRC,ALPHA                          IP030057
      PRINT 29,IPCT,IPRC,ALPHA                                          IP030058
 29   FORMAT(28H0DISCONTINUED CALCULATION ONI6,16HTH PIVOT PROBLEMI4,3H.IP030059
     1  3A6)                                                            IP030060
      GO TO 21                                                          IP030061
 17   IF (SENSE SWITCH 1) 19, 18                                        IP030062
 18   CALL MOUT                                                         IP030063
 19   WRITE OUTPUT TAPE 10, 20, IPCT, IPRC, ALPHA,IVCT,IOCT             IP030064
      PRINT 20,IPCT, IPRC, ALPHA,IVCT,IOCT                              IP030065
   20 FORMAT(17H0SOLN. REACHED ONI6,19HTH PIVOT.   PROBLEMI4,3H.  3A6/I6IP030066
     1,15H NEW VARBLS ANDI6,8H OFLOWS.)                                 IP030067
 21   GO TO JUMP,(1, 22)                                                IP030068
 22   END FILE 10                                                       IP030069
      REWIND 10                                                         IP030070
      STOP 1                                                            IP030071
      END(0,1,0,0,0)                                                    IP030072
      SUBROUTINE SET1                                                   IP030073
C     READS MATRIX INTO STORAGE AND SETS UP UNIT MATRIX                 IP030074
C                                                                       IP030075
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP030076
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP030077
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP030078
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP030079
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP030080
     1(A1,IA1)                                                          IP030081
C                                                                       IP030082
      IF (SENSE SWITCH 3)1,2                                            IP030083
 1    READ 3, M, N, KR, MSI, LIM, UB, ALPHA                             IP030084
      IF (M)998,999,16                                                  IP030085
 999  WRITE OUTPUT TAPE 10, 7                                           IP030086
      PRINT 7                                                           IP030087
 7    FORMAT(33H0LAST PROBLEM HAS BEEN PROCESSED.//)                    IP030088
      END FILE 10                                                       IP030089
      REWIND 10                                                         IP030090
      STOP 1                                                            IP030091
 16   N1 = N                                                            IP030092
      M1=M+N-1                                                          IP030093
      DO 20 J = 1,N                                                     IP030094
      DO 20 I=1,M1                                                      IP030095
 20   A(I,J) = 0.                                                       IP030096
      IF (SENSE SWITCH 3)4,9                                            IP030097
    8 A(I,J)  =AA                                                       IP030098
    4 READ 5,I,J,AA                                                     IP030099
      IF (J) 998,6,8                                                    IP030100
 2    READ INPUT TAPE 7, 3, M, N, KR, MSI, LIM, UB, ALPHA               IP030101
      IF (M)998,999,16                                                  IP030102
 11   A(I,J) = AA                                                       IP030103
    9 READ INPUT TAPE 7,5,I,J,AA                                        IP030104
      IF (J) 998,6,11                                                   IP030105
    6 D=1.0                                                             IP030106
      IF (KR)998,12,13                                                  IP030107
  998 STOP 2                                                            IP030108
   12 KR=1                                                              IP030109
   13 IF (MSI)998,14,15                                                 IP030110
   14 MSI=1                                                             IP030111
 15   RETURN                                                            IP030112
 3    FORMAT(5I6,F6.0,3A6)                                              IP030113
    5 FORMAT (2I5,F10.5)                                                IP030114
      END (0,1,0,0,0)                                                   IP030115
      SUBROUTINE SET2                                                   IP030116
C     SETS UP UNIT MATRIX AND INDICES                                   IP030117
C                                                                       IP030118
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP030119
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP030120
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP030121
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP030122
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP030123
     1(A1,IA1)                                                          IP030124
C                                                                       IP030125
 231  M1 = M + N   - 1                                                  IP030126
      M2=M+1                                                            IP030127
      DO8I=M2,M1                                                        IP030128
      DO 7 J = 1,N                                                      IP030129
 7    A(I,J) = 0                                                        IP030130
 8    CONTINUE                                                          IP030131
      DO 5 J = 2,N                                                      IP030132
      I = M2 + J - 2                                                    IP030133
      LT(J) = I                                                         IP030134
 5    A(I,J) = -D                                                       IP030135
      LT = 0                                                            IP030136
      LT(N+1) = 0                                                       IP030137
      DO9I=1,M1                                                         IP030138
 9    L(I)=I                                                            IP030139
      M3 = M1 + 1                                                       IP030140
      KL = KR + 1                                                       IP030141
      M2 = M1                                                           IP030142
      RETURN                                                            IP030143
      END (0,1,0,0,0)                                                   IP030144
      FUNCTION SET3 (X)                                                 IP030145
C     GETS PROBLEM DUAL FEASIBLE IF NOT SO                              IP030146
C                                                                       IP030147
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP030148
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP030149
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP030150
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP030151
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP030152
     1(A1,IA1)                                                          IP030153
C                                                                       IP030154
      V = X                                                             IP030155
      NS = N1 + 1                                                       IP030156
      IK = M1 + 1                                                       IP030157
      J1 = 0                                                            IP030158
      DO 10 J = 2,N                                                     IP030159
      DO 2 I = 1,M1                                                     IP030160
      IF (A(I,J)) 3, 2, 9                                               IP030161
 2    CONTINUE                                                          IP030162
      GO TO 9                                                           IP030163
 3    IF (I-IK) 6, 4, 8                                                 IP030164
 4    DO 5 I1 = IK,M1                                                   IP030165
      IF (IA(I1,J1)-IA(I1,J)) 8, 5, 7                                   IP030166
 5    CONTINUE                                                          IP030167
 6    IK = I                                                            IP030168
 7    J1 = J                                                            IP030169
 8    IA(M1+1,J) = -1                                                   IP030170
      GO TO 10                                                          IP030171
 9    IA(M1+1,J) = 0                                                    IP030172
 10   CONTINUE                                                          IP030173
      IF (J1) 11, 16, 11                                                IP030174
 11   IF (UB) 19, 19, 21                                                IP030175
 19   WRITE OUTPUT TAPE 10, 20, IPRC, ALPHA                             IP030176
 20   FORMAT(12H0PROBLEM NO.I3,3A6,19H  NEEDS UPPER BOUND)              IP030177
      SET3 = -1.                                                        IP030178
      GO TO 22                                                          IP030179
 21   LT(J1) = -1                                                       IP030180
      IVCT = 1                                                          IP030181
      DO 12 I = IK,M1                                                   IP030182
      A(I,J1) = -A(I,J1)                                                IP030183
 12   A(I,1) = A(I,J1)*UB + A(I,1)                                      IP030184
      IA(M1+1,J1) = 0                                                   IP030185
      DO 15 J = 2,N                                                     IP030186
      IF (IA(M1+1,J)) 13, 15, 13                                        IP030187
 13   DO 14 I = IK,M1                                                   IP030188
 14   A(I,J) = A(I,J) + A(I,J1)                                         IP030189
 15   CONTINUE                                                          IP030190
 16   DO 18 I = 1,M1                                                    IP030191
      A(I,NS) = 1.                                                      IP030192
      DO 17 J = 3,N1                                                    IP030193
 17   A(I,NS) = A(I,NS) + A(I,J)                                        IP030194
 18   CONTINUE                                                          IP030195
      SET3 = 0.                                                         IP030196
 22   RETURN                                                            IP030197
      END(0,1,0,0,0)                                                    IP030198
      FUNCTION ROWS (KU,I1)                                             IP030199
C     SELECTS PIVOT ROW BY RATIO TO SUM METHOD                          IP030200
C                                                                       IP030201
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP030202
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP030203
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP030204
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP030205
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP030206
     1(A1,IA1)                                                          IP030207
C                                                                       IP030208
      EQUIVALENCE (IRO,ROWS),(Q,IQ),(QP,IQP)                            IP030209
      K2 = 1                                                            IP030210
      DO 24 I = KU,M1                                                   IP030211
 3    A1 = A(I,1)                                                       IP030212
      IF (A1) 10, 24, 24                                                IP030213
 10   SU = A(I,NS) - 1.                                                 IP030214
      IF (SU) 11, 15, 19                                                IP030215
 11   GO TO (13, 12, 24, 24), K2                                        IP030216
 12   QP = SU/A1                                                        IP030217
      GO TO 22                                                          IP030218
 13   K2 = 2                                                            IP030219
      Q = SU/A1                                                         IP030220
      GO TO 23                                                          IP030221
 15   GO TO (17, 17, 16, 24), K2                                        IP030222
 16   QP = A1                                                           IP030223
      GO TO 22                                                          IP030224
 17   K2 = 3                                                            IP030225
      Q = A1                                                            IP030226
      GO TO 23                                                          IP030227
 19   GO TO (21, 21, 21, 20), K2                                        IP030228
 20   QP = SU*A1                                                        IP030229
 22   IF (IQ - IQP) 24, 24, 28                                          IP030230
 21   K2 = 4                                                            IP030231
      Q = SU*A1                                                         IP030232
      GO TO 23                                                          IP030233
 28   Q = QP                                                            IP030234
 23   I1 = I                                                            IP030235
 24   CONTINUE                                                          IP030236
      IRO = 1 - K2                                                      IP030237
      RETURN                                                            IP030238
      END(0,1,0,0,0)                                                    IP030239
      FUNCTION COLS (I1,J1)                                             IP030240
C     SELECTS PIVOT ELEMENT                                             IP030241
C                                                                       IP030242
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP030243
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP030244
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP030245
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP030246
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP030247
     1(A1,IA1)                                                          IP030248
C                                                                       IP030249
      EQUIVALENCE (IR,R),(RP,IRP)                                       IP030250
      I3 = 0                                                            IP030251
      J1 = 0                                                            IP030252
      DO 15 J = 2,N                                                     IP030253
      IF (A(I1,J)) 2, 15, 15                                            IP030254
 2    DO 3 I2 = 1,I1                                                    IP030255
      IF (A(I2,J)) 24, 3, 4                                             IP030256
 24   STOP 5                                                            IP030257
 3    CONTINUE                                                          IP030258
 4    IF (J1) 999, 14, 5                                                IP030259
 5    IF (I2 - I3) 15, 6, 14                                            IP030260
 6    R = INTF(A(I1,J)*D - .5)/INTF(A(I1,J1)*D - .5)                    IP030261
      DO 13 I = I3,M1                                                   IP030262
      IF (A(I,J1)) 9, 8, 10                                             IP030263
 8    IF (A(I,J)) 14, 13, 15                                            IP030264
 9    IF (A(I,J)) 11, 15, 15                                            IP030265
 10   IF (A(I,J)) 14, 14, 12                                            IP030266
 11   RP = INTF(A(I,J)*D - .5)/INTF(A(I,J1)*D - .5)                     IP030267
      IF (IR - IRP) 14, 13, 15                                          IP030268
 12   RP = INTF(A(I,J)*D + .5)/INTF(A(I,J1)*D + .5)                     IP030269
      IF (IR - IRP) 15, 13, 14                                          IP030270
 13   CONTINUE                                                          IP030271
 14   J1 = J                                                            IP030272
      I3 = I2                                                           IP030273
 15   CONTINUE                                                          IP030274
      IF (J1) 999, 999, 16                                              IP030275
 16   COLS = -1.                                                        IP030276
 18   RETURN                                                            IP030277
 999  COLS = 0.                                                         IP030278
      GO TO 18                                                          IP030279
      END(0,1,0,0,0)                                                    IP030280
      SUBROUTINE RGEN                                                   IP030281
C     MAINTAINS APPENDIX OF FRACTIONAL ROWS                             IP030282
C                                                                       IP030283
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP030284
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP030285
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP030286
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP030287
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP030288
     1(A1,IA1)                                                          IP030289
C                                                                       IP030290
      EQUIVALENCE (IRM,RM),(IP5,P5)                                     IP030291
C                                                                       IP030292
      P5 = .5                                                           IP030293
      IC=0                                                              IP030294
      K=0                                                               IP030295
      IF (M1-M3)9,8,8                                                   IP030296
    8 DO 7 I=M3,M1                                                      IP030297
      A1=A(I,1)                                                         IP030298
      IF (A1) 4, 6, 6                                                   IP030299
    4 IF (IA1+ICH)7,7,5                                                 IP030300
    5 RM=INTF(.5-A1*D)                                                  IP030301
      IF (IC)73,73,71                                                   IP030302
   71 DO 72 J=1,IC                                                      IP030303
      IF (IRMV(J)-IRM)72,7,72                                           IP030304
   72 CONTINUE                                                          IP030305
   73 IC=IC+1                                                           IP030306
      IRMV(IC)=IRM                                                      IP030307
      GO TO 7                                                           IP030308
    6 K=K+1                                                             IP030309
      IT(K)=I                                                           IP030310
    7 CONTINUE                                                          IP030311
    9 NO=MS+M2-M1+K                                                     IP030312
      IF (NO-K)10,10,11                                                 IP030313
 10   IF (NO) 50, 50, 2                                                 IP030314
   11 K3=M1-K                                                           IP030315
      K=K+1                                                             IP030316
      DO 12 J=K,NO                                                      IP030317
   12 IT(J)=K3+J                                                        IP030318
 2    K5 = 0                                                            IP030319
      ICP = IC                                                          IP030320
      ICPP = IC + 1                                                     IP030321
      DO 32 I = 1,M2                                                    IP030322
      A1 = A(I,1)                                                       IP030323
      IF (A1) 23, 32, 23                                                IP030324
   23 RM=A1-INTF(A1)                                                    IP030325
      IF (RM) 15, 32, 16                                                IP030326
   15 RM=RM+1.                                                          IP030327
 16   IF (IRM-IH) 32, 32, 17                                            IP030328
 17   IF (ICH - IRM) 32, 32, 18                                         IP030329
 18   IK = I                                                            IP030330
      IF (IRM-IP5)19,20,20                                              IP030331
   19 RM=1.-RM                                                          IP030332
      IK = -I                                                           IP030333
   20 RM=INTF(RM*D+.5)                                                  IP030334
      IF (IC)30,30,21                                                   IP030335
   21 DO 29 J=1,IC                                                      IP030336
      IF (IRMV(J)-IRM)29,32,29                                          IP030337
   29 CONTINUE                                                          IP030338
 30   IF (K5) 43, 43, 35                                                IP030339
 35   DO 36 J = ICPP,ICP                                                IP030340
      IF (IRM-IRMV(J)) 36, 32, 37                                       IP030341
 36   CONTINUE                                                          IP030342
      IF (NO-K5) 32, 32, 43                                             IP030343
 37   IF (NO-K5) 39, 39, 38                                             IP030344
 38   K5 = K5 + 1                                                       IP030345
      ICP = ICP + 1                                                     IP030346
 39   J1 = ICP - J                                                      IP030347
      IF (J1) 44, 44, 40                                                IP030348
 40   K3 = ICP + 1                                                      IP030349
      DO 42 J2 = 1,J1                                                   IP030350
      J3 = K3 - J2                                                      IP030351
      IRMV(J3) = IRMV(J3-1)                                             IP030352
 42   IM(J3) = IM(J3-1)                                                 IP030353
      GO TO 44                                                          IP030354
 43   ICP = ICP+1                                                       IP030355
      J=ICP                                                             IP030356
      K5 = K5 + 1                                                       IP030357
 44   IRMV(J) = IRM                                                     IP030358
      IM(J) = IK                                                        IP030359
 32   CONTINUE                                                          IP030360
      IF (K5) 50, 50, 45                                                IP030361
 45   K = 0                                                             IP030362
      DO 49 J = ICPP,ICP                                                IP030363
      IK = IM(J)                                                        IP030364
      IF (IK) 46, 46, 47                                                IP030365
 46   K3 = 2                                                            IP030366
      IK = -IK                                                          IP030367
      GO TO 48                                                          IP030368
 47   K3 = 1                                                            IP030369
 48   K = K + 1                                                         IP030370
      I1 = IT(K)                                                        IP030371
      CALL RMRO (I1,IK,K3)                                              IP030372
 49   CALL NRM (IK,I1)                                                  IP030373
      M1 = XMAX0F(M1,I1)                                                IP030374
 50   RETURN                                                            IP030375
      END(0,1,0,0,0)                                                    IP030376
      SUBROUTINE RMRO (I1,I2,I3)                                        IP030377
C     GENERATES ROW OF REMAINDERS                                       IP030378
C                                                                       IP030379
C                                                                       IP030380
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP030381
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP030382
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP030383
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP030384
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP030385
     1(A1,IA1)                                                          IP030386
C                                                                       IP030387
      DO 12 J = 1,N1                                                    IP030388
      GO TO (4,5),I3                                                    IP030389
 4    A1 = A(I2,J)                                                      IP030390
      GO TO 6                                                           IP030391
 5    A1 = -A(I2,J)                                                     IP030392
 6    IF(A1) 10,7, 8                                                    IP030393
 8    A(I1,J) = INTF(A1) - A1                                           IP030394
    9 IF (IA(I1,J) + ICH) 7,7,14                                        IP030395
   14 IF (IA(I1,J) + IH) 12,7,7                                         IP030396
 10   A(I1,J) = INTF(A1) - A1 - 1.                                      IP030397
      GO TO 9                                                           IP030398
 7    A(I1,J) = 0.                                                      IP030399
 12   CONTINUE                                                          IP030400
      A(I1,NS) = 1.                                                     IP030401
      DO 13 J = 2,N                                                     IP030402
      IF (IA(I1,J)) 11,13,13                                            IP030403
 11   A(I1,NS) = A(I1,NS) + A(I1,J)                                     IP030404
 13   CONTINUE                                                          IP030405
      RETURN                                                            IP030406
      END(0,1,0,0,0)                                                    IP030407
      SUBROUTINE RCT (I1,J1)                                            IP030408
C                                                                       IP030409
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP030410
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP030411
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP030412
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP030413
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP030414
     1(A1,IA1)                                                          IP030415
C                                                                       IP030416
      A1=A(I1,NS)-1.                                                    IP030417
      IF (A1)1,6,6                                                      IP030418
    1 I2=I1                                                             IP030419
      J2=J1                                                             IP030420
      IF (INRO (I2,J2)) 2,6,2                                           IP030421
 2    IF (A1/A(I1,1) - (A(I2,NS)-1.)/A(I2,1)) 6, 5, 5                   IP030422
    5 I1=I2                                                             IP030423
      J1=J2                                                             IP030424
    6 RETURN                                                            IP030425
      END(0,1,0,0,0)                                                    IP030426
      FUNCTION INRO (I1,J1)                                             IP030427
C                                                                       IP030428
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP030429
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP030430
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP030431
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP030432
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP030433
     1(A1,IA1)                                                          IP030434
C                                                                       IP030435
      EQUIVALENCE (UN,IUN)                                              IP030436
      IF (A(I1,J1)+1.+H)2,2,1                                           IP030437
    1 INRO=0                                                            IP030438
      GO TO 13                                                          IP030439
 2    AN = INTF(.5 - A(I1,J1)*D)                                        IP030440
      UN=1.                                                             IP030441
      S=1.                                                              IP030442
      DO 12 J=1,N1                                                      IP030443
      IF (A(I1,J)) 9, 6, 7                                              IP030444
    6 A(M1+1,J)=0.                                                      IP030445
      GO TO 12                                                          IP030446
 7    A(M1+1,J) = INTF(A(I1,J)*D+.5)/AN                                 IP030447
      IF (IA(M1+1,J)-IUN) 6, 11, 8                                      IP030448
 8    A(M1+1,J) = INTF(A(M1+1,J))                                       IP030449
      GO TO 11                                                          IP030450
    9 A1=INTF(A(I1,J)*D-.5)/AN                                          IP030451
      A(M1+1,J)=INTF(A1)                                                IP030452
      IF (IA(M1+1,J)-IA1)11,11,10                                       IP030453
   10 A(M1+1,J)=A(M1+1,J)-1.                                            IP030454
   11 S=S+A(M1+1,J)                                                     IP030455
   12 CONTINUE                                                          IP030456
      A(M1+1,NS) = S - A(M1+1,1)                                        IP030457
      INRO=-1                                                           IP030458
      I2=M1+1                                                           IP030459
      CALL NRM(I1,I2)                                                   IP030460
      CALL COLS(I2,J1)                                                  IP030461
      I1=I2                                                             IP030462
   13 RETURN                                                            IP030463
      END(0,1,0,0,0)                                                    IP030464
      FUNCTION RPIV (I1,J1)                                             IP030465
C     ATTEMPTS NEXT PIVOT IN CASE OF OFLOW                              IP030466
C                                                                       IP030467
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP030468
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP030469
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP030470
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP030471
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP030472
     1(A1,IA1)                                                          IP030473
C                                                                       IP030474
      EQUIVALENCE (AN,IAN)                                              IP030475
 3    CALL OFLO (I1,J1)                                                 IP030476
      IF (INRO (I1,J1)) 4, 15, 15                                       IP030477
 4    IF (PIV(I1,J1)) 45, 3, 3                                          IP030478
 15   IF (M1 - M3) 20, 12, 12                                           IP030479
 12   IF (I2-M3) 13, 20, 20                                             IP030480
 13   IF (I2-M1) 5, 5, 20                                               IP030481
 5    IF (ROWS(M3,I1)) 17, 20, 20                                       IP030482
 17   IF (COLS(I1,J1)) 18, 47, 47                                       IP030483
 18   IF (PIV(I1,J1)) 45, 19,45                                         IP030484
 19   CALL OFLO (I1,J1)                                                 IP030485
 20   K1 = 1                                                            IP030486
      I1 = M1 + 1                                                       IP030487
      DO 22 I2 = 1,M2                                                   IP030488
      IF (A(I2,1)) 21, 22, 21                                           IP030489
 21   A1 = ABSF(A(I2,1)) - INTF(ABSF(A(I2,1)))                          IP030490
      IF (IA1 - IH) 22, 22, 23                                          IP030491
 23   IF (IA1 - ICH) 30, 22, 22                                         IP030492
 22   CONTINUE                                                          IP030493
      K1 = 2                                                            IP030494
      DO 29 I2 = 1,M2                                                   IP030495
      IF (A(I2,1)) 25, 26, 25                                           IP030496
 25   A1 = ABSF(A(I2,1)) - INTF(ABSF(A(I2,1)))                          IP030497
      IF (IA1 - IH) 26, 26, 14                                          IP030498
 14   IF (IA1 - ICH) 29, 26, 26                                         IP030499
 26   DO 28 J = 3,N1                                                    IP030500
      IF(A(I2,J))    27, 28, 27                                         IP030501
 27   A1 = ABSF(A(I2,J)) - INTF(ABSF(A(I2,J)))                          IP030502
      IF (IA1 - IH) 28, 28, 24                                          IP030503
 24   IF (IA1 - ICH) 30, 28, 28                                         IP030504
 28   CONTINUE                                                          IP030505
 29   CONTINUE                                                          IP030506
      GO TO 44                                                          IP030507
 30   K2 = 1                                                            IP030508
 31   CALL RMRO (I1, I2, K2)                                            IP030509
      CALL NRM (I2, I1)                                                 IP030510
      IF (COLS(I1,J1)) 40, 47, 40                                       IP030511
 40   IF (PIV(I1,J1)) 45, 41, 45                                        IP030512
 41   CALL OFLO (I1,J1)                                                 IP030513
      GO TO (42, 43),K2                                                 IP030514
 42   K2 = 2                                                            IP030515
      GO TO 31                                                          IP030516
 43   GO TO (22, 29),K1                                                 IP030517
   44 RPIV = 0.                                                         IP030518
      GO TO 46                                                          IP030519
   47 RPIV = 1.                                                         IP030520
      GO TO 46                                                          IP030521
   45 RPIV = -1.                                                        IP030522
 46   RETURN                                                            IP030523
      END(0,1,0,0,0)                                                    IP030524
      FUNCTION BRK(X)                                                   IP030525
C                                                                       IP030526
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP030527
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP030528
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP030529
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP030530
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP030531
     1(A1,IA1)                                                          IP030532
C                                                                       IP030533
      V = X                                                             IP030534
      IF (SENSE SWITCH 1) 2,1                                           IP030535
 1    CALL MOUT                                                         IP030536
 2    WRITE OUTPUT TAPE 10, 3,IPRC,ALPHA,IPCT,IVCT,IOCT                 IP030537
    3 FORMAT(15H BRKPT, PROBLEMI4,2H  3A6,4H -- I4,8H PIVOTS,I4,12H NEW IP030538
     1VARBLS,I4,8H OFLOWS.)                                             IP030539
      IF (SENSE SWITCH 5) 4,6                                           IP030540
 4    PRINT 5                                                           IP030541
 5    FORMAT(23H PUT UP SENSE SWITCH 5.)                                IP030542
    6 PRINT 7,IPRC,ALPHA                                                IP030543
 7    FORMAT(36H0CALCULATION DISCONTINUED ON PROBLEMI4,2H  3A6,/48H SENSIP030544
     1E SWITCH 6 MUST BE DOWN FOR DUMP ON TAPE 1./44H DONT OVERWRITE PREIP030545
     2VIOUS DUMP.  PRESS START./1H )                                    IP030546
      PAUSE 3                                                           IP030547
      IF (SENSE SWITCH 6) 8, 10                                         IP030548
 8    CALL SAVCOR (1)                                                   IP030549
      IF (SENSE SWITCH 6) 10, 9                                         IP030550
 9    REWIND 10                                                         IP030551
      WRITE OUTPUT TAPE 10, 3,IPRC,ALPHA,IPCT,IVCT,IOCT                 IP030552
      PRINT 3,                IPRC,ALPHA,IPCT,IVCT,IOCT                 IP030553
      CALL MOUT                                                         IP030554
      BRK = -1.                                                         IP030555
      GO TO 11                                                          IP030556
 10   BRK = 0.                                                          IP030557
 11   RETURN                                                            IP030558
      END(0,1,0,0,0)                                                    IP030559
      SUBROUTINE TWR(I1,KN)                                             IP030560
C                                                                       IP030561
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP030562
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP030563
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP030564
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP030565
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP030566
     1(A1,IA1)                                                          IP030567
C                                                                       IP030568
      EQUIVALENCE (B1,IB1),(B2,IB2),(B3,IB3),(FMT,IMT),(AML,IAML)       IP030569
      DIMENSION FMT(15),IMT(15)                                         IP030570
      IF(IPCT)  20, 20, 2                                               IP030571
 20   IF (KR-8) 5, 5, 4                                                 IP030572
 4    IML = 8                                                           IP030573
      GO TO 2                                                           IP030574
 5    IML = KR                                                          IP030575
 2    IPCT = IPCT + 1                                                   IP030576
      IF (SENSE SWITCH 2) 14, 12                                        IP030577
 14   WRITE OUTPUT TAPE 10,8,IPCT,KN,I1,D,(A(I,1),I=1,IML)              IP030578
 8    FORMAT(I5,11HTH PIV. L =I4,6H, LT =I4,5H, D =F10.0,5H, Z =8(F9.2))IP030579
   12 IF (SENSE SWITCH 1) 21,22                                         IP030580
   21 CALL MOUT                                                         IP030581
   22 RETURN                                                            IP030582
      END (0,1,0,0,0)                                                   IP030583
      SUBROUTINE MOUT                                                   IP030584
C     EDITS AND WRITES MATRIX                                           IP030585
C                                                                       IP030586
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP030587
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP030588
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP030589
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP030590
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP030591
     1(A1,IA1)                                                          IP030592
C                                                                       IP030593
      IF (M1-43) 3, 3, 16                                               IP030594
 3    IF (N3-10) 1, 1, 16                                               IP030595
 16   WRITE OUTPUT TAPE 10, 11                                          IP030596
 1    LB = 0                                                            IP030597
      LO = -9                                                           IP030598
      MX = 0                                                            IP030599
 2    K = 0                                                             IP030600
      LB = LB + 1                                                       IP030601
      LO = LO + 10                                                      IP030602
      MX = MX + 10                                                      IP030603
      IF (N3 - MX) 10, 4, 4                                             IP030604
 10   MX = N3                                                           IP030605
 4    LL = - 49                                                         IP030606
      LU = 0                                                            IP030607
 5    K = K + 1                                                         IP030608
      LL = LL + 50                                                      IP030609
      LU = LU + 50                                                      IP030610
      IF (M1 - LU) 12, 6, 6                                             IP030611
 12   LU = M1                                                           IP030612
 6    WRITE OUTPUT TAPE 10,7,K,LB,M1,N3, D,KR,IPRC,ALPHA                IP030613
    7 FORMAT(8H0SBMTRX(I2,1H,I2,4H) OFI4,1HXI3,11H MTRX.  D =F8.0,1H,I3,IP030614
     15H C.V.5X,10HPROBLEM NOI4,3X,3A6)                                 IP030615
      CALL MMT1                                                         IP030616
      WRITE OUTPUT TAPE 10, 8                                           IP030617
 8    FORMAT(1H )                                                       IP030618
      DO 9 I = LL,LU                                                    IP030619
 9    CALL MMT2(I)                                                      IP030620
      WRITE OUTPUT TAPE 10, 11                                          IP030621
 11   FORMAT(1H1)                                                       IP030622
      IF(M1-LU) 13, 13, 5                                               IP030623
 13   IF (N3 - MX) 15, 15, 2                                            IP030624
 15   RETURN                                                            IP030625
      END(0,1,0,0,0)                                                    IP030626
      SUBROUTINE MMT1                                                   IP030627
C                                                                       IP030628
C                                                                       IP030629
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP030630
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP030631
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP030632
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP030633
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP030634
     1(A1,IA1)                                                          IP030635
C                                                                       IP030636
      DIMENSION FMT(13),IMT(13)                                         IP030637
      EQUIVALENCE(B1,IB1),(B2,IB2),(B3,IB3),(B4,IB4),(FMT,IMT),(IML,AML)IP030638
      IF (IPCT) 1, 13, 1                                                IP030639
   13 AML=6HZ00000                                                      IP030640
      FMT(1) =  6H39X                                                   IP030641
      IMT(1)=IML-IMT(1)                                                 IP030642
      B1=6H  211H                                                       IP030643
      B2=6H00Z000                                                       IP030644
      IB1=IB1-IB2                                                       IP030645
      B2=6HZ00Z00                                                       IP030646
      B3=6H2003I7                                                       IP030647
      IB3=IB2-IB3                                                       IP030648
      B4=6H2103I7                                                       IP030649
      IB4=IB2-IB4                                                       IP030650
      B2= 6H24X)                                                        IP030651
      IB2=IML-IB2                                                       IP030652
    1 K=0                                                               IP030653
      IV = LO                                                           IP030654
      IF (LO-1) 3, 3, 4                                                 IP030655
 3    FMT(2) = B1                                                       IP030656
      FMT(3) = 6H CONST                                                 IP030657
      FMT(4) =  6HANT                                                   IP030658
      K = 3                                                             IP030659
      IV = 2                                                            IP030660
 4    IF(N1-MX) 6, 5, 5                                                 IP030661
 5    IUP = MX                                                          IP030662
      ASSIGN 12 TO JUMP                                                 IP030663
      GO TO 7                                                           IP030664
 6    ASSIGN 11 TO JUMP                                                 IP030665
      IUP = N1                                                          IP030666
 7    IG = IUP - IV + 1                                                 IP030667
      IF (IG) 14, 11, 14                                                IP030668
 14   IF (IG-10) 8, 9, 9                                                IP030669
    8 AML=B3                                                            IP030670
      IML = IML - IG                                                    IP030671
      FMT(K+2) = AML                                                    IP030672
      GO TO 10                                                          IP030673
    9 FMT(K+2)=B4                                                       IP030674
   10 FMT(K+3)=B2                                                       IP030675
      K = K + 2                                                         IP030676
      GO TO JUMP,(11,12)                                                IP030677
 11   FMT(K+2)=B1                                                       IP030678
      FMT(K+3)= 6H COEF                                                 IP030679
      FMT(K+4)= 6HSUM                                                   IP030680
      K = K + 3                                                         IP030681
 12   FMT(K+2)= 6H)                                                     IP030682
      WRITE OUTPUT TAPE 10,FMT,(LT(J),J=IV,IUP)                         IP030683
      RETURN                                                            IP030684
      END(0,1,0,0,0)                                                    IP030685
      SUBROUTINE MMT2(I1)                                               IP030686
C                                                                       IP030687
C                                                                       IP030688
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP030689
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP030690
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP030691
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP030692
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP030693
     1(A1,IA1)                                                          IP030694
C                                                                       IP030695
      EQUIVALENCE (B1,IB1),(B2,IB2),(B3,IB3)                            IP030696
      DIMENSION FMT(22),OUT(10)                                         IP030697
      IF (IPCT)1,1,2                                                    IP030698
    1 A1=6HZ00000                                                       IP030699
      B2= 6H211X                                                        IP030700
      IB2=IA1-IB2                                                       IP030701
      B3=6H2F11.3                                                       IP030702
      IB3=IA1-IB3                                                       IP030703
      A1=6HZ0000Z                                                       IP030704
      B1=6H2F8.02                                                       IP030705
      IB1=IA1-IB1                                                       IP030706
      FMT(1) =  6H(I9                                                   IP030707
    2 K1=1                                                              IP030708
      K2=0                                                              IP030709
      DO 10 J=LO,MX                                                     IP030710
      A1=ABSF(A(I1,J))                                                  IP030711
      IF (A1)4,5,4                                                      IP030712
    4 A1=A1-INTF(A1)                                                    IP030713
      IF (IA1-IH) 7, 7, 3                                               IP030714
 3    IF (ICH-IA1) 7, 7, 6                                              IP030715
    5 FMT(K1+1)=B2                                                      IP030716
      GO TO 9                                                           IP030717
    6 FMT(K1+1)=B3                                                      IP030718
      GO TO 8                                                           IP030719
    7 K1=K1+1                                                           IP030720
      FMT(K1)=B1                                                        IP030721
      FMT(K1+1)=6H3X                                                    IP030722
    8 K2=K2+1                                                           IP030723
      OUT (K2)=A(I1,J)                                                  IP030724
    9 K1=K1+1                                                           IP030725
   10 CONTINUE                                                          IP030726
      FMT(K1+1)=6H)                                                     IP030727
      IF (K2) 11, 11, 13                                                IP030728
 11   WRITE OUTPUT TAPE 10, 12, I1                                      IP030729
 12   FORMAT(I9)                                                        IP030730
      GO TO 14                                                          IP030731
 13   WRITE OUTPUT TAPE 10, FMT,I1,(OUT(J),J=1,K2)                      IP030732
 14   RETURN                                                            IP030733
      END (0,1,0,0,0)                                                   IP030734
      SUBROUTINE NRM (I1,I2)                                            IP030735
C     DESCRIBES NEW ROW I2 FROM ROW I1                                  IP030736
C                                                                       IP030737
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP030738
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP030739
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP030740
     1IM(25),BIM(25),IRMV(25),RMV(25),ALPHA(3)                          IP030741
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP030742
     1(A1,IA1)                                                          IP030743
C                                                                       IP030744
      IVCT = IVCT + 1                                                   IP030745
      L(I2) =-IVCT                                                      IP030746
      IF (SENSE SWITCH 4) 1,6                                           IP030747
 1    WRITE OUTPUT TAPE 10, 2, I2, I1, IVCT                             IP030748
 2    FORMAT(8H0NEW ROWI4,13H GEND FRM ROWI4,1H,I4,12HTH ART VRBL.)     IP030749
 3    WRITE OUTPUT TAPE 10,4,(LT(J),J=1,NS)                             IP030750
 4    FORMAT(9H COLUMN  10I11/(9H         10I11))                       IP030751
      WRITE OUTPUT TAPE 10, 5, (A(I2,J),J=1,NS)                         IP030752
 5    FORMAT(9H0ELEMNTS 10F11.3/(9H         10F11.3))                   IP030753
 6    RETURN                                                            IP030754
      END(0,1,0,0,0)                                                    IP030755
      SUBROUTINE OFLO (I1,K)                                            IP030756
C     WRITES OFLO MESSAGE                                               IP030757
C                                                                       IP030758
      COMMON A,L,LT,IPCT,IVCT,IOCT,IPRC,ALPHA,M,M1,M2,M3,N,N1,N3,NS,MS, IP030759
     1MSI,UB,KL,KR,LO,MX,NO,H,V,W,D,IT,IM,RMV,LIM,ICH,A1,IA1            IP030760
      DIMENSION A(204,102),IA(204,102),L(204),LT(102),IT(25),BIT(25),   IP030761
     1IM(25),BIM(25),I-MV(25),RMV(25),ALPHA(3)                          IP030762
      EQUIVALENCE (A,IA),(IT,BIT),(IM,BIM),(IRMV,RMV),(H,IH),(CH,ICH),  IP030763
     1(A1,IA1)                                                          IP030764
C                                                                       IP030765
      IOCT = IOCT + 1                                                   IP030766
      IF (SENSE SWITCH 2) 1, 3                                          IP030767
 1    WRITE OUTPUT TAPE 10, 2, K, I1                                    IP030768
 2    FORMAT(10H0OFLOW, L=I4,5H, LT=I4,1H.)                             IP030769
 3    RETURN                                                            IP030770
      END(0,1,0,0,0)                                                    IP030771
       REM R.E. LEVITAN                                                 IP030772
       REM PIVOTING SUBROUTINE                                          IP030773
       REM CALLING SEQUENCE TSXPIU,4,TSXI1,TSXJ1,TSXK                   IP030774
       REM                                                              IP030775
       REM   PARAMETERS                                                 IP030776
 ML    EQU 204                                                          IP030777
 NL    EQU 102                                                          IP030778
 DIM   EQU 25                                                           IP030779
