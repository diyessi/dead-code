       STA *+1                                                          BSNL0026
       CLA *-*                                                          BSNL0027
 LO1   PAX 1,1                                                          BSNL0028
       TXH *+3,1,0                                                      BSNL0029
       ARS 18                                                           BSNL0030
       PAX 0,1                                                          BSNL0031
       SXD NTST,1                                                       BSNL0032
       ADD FLO                                                          BSNL0033
       LDQ COM+1                                                        BSNL0034
       TLQ *+2                                                          BSNL0035
       CLA COM+1                                                        BSNL0036
       PAX 0,1                                                          BSNL0037
       LXD *+2,2                                                        BSNL0038
       LBT                                                              BSNL0039
 L1    TXI *+1,2,1                                                      BSNL0040
       FSB FP1                                                          BSNL0041
       STO COM+1                                                        BSNL0042
       FDP COM                                                          BSNL0043
       FMP FLO+1                                                        BSNL0044
       STO YCOM,1                                                       BSNL0045
       STZ YCOM-1,1                                                     BSNL0046
       STZ COM+2                                                        BSNL0047
       CLA COM+1                                                        BSNL0048
       FAD FP1                                                          BSNL0049
 LOOP  STO COM+1                                                        BSNL0050
       FDP COM                                                          BSNL0051
       FMP YCOM,1                                                       BSNL0052
       ACL DUB                                                          BSNL0053
       PBT                                                              BSNL0054
 SVE1  TXL *+2                                                          BSNL0055
 SVE2  TXL ERR                                                          BSNL0056
       FSB YCOM-1,1                                                     BSNL0057
       STO YCOM+1,1                                                     BSNL0058
       TIX *+4,2,1                                                      BSNL0059
       TXI *+1,2,1                                                      BSNL0060
       FAD COM+2                                                        BSNL0061
       STO COM+2                                                        BSNL0062
       CLA COM+1                                                        BSNL0063
       FSB FP1                                                          BSNL0064
       TIX LOOP,1,1                                                     BSNL0065
       TQO *+1                                                          BSNL0066
       CLA COM+2                                                        BSNL0067
       ACL DUB                                                          BSNL0068
       FSB YCOM                                                         BSNL0069
       STO COM+1                                                        BSNL0070
       CLA FP1                                                          BSNL0071
       FDP COM+1                                                        BSNL0072
       STQ COM+1                                                        BSNL0073
       CLA COM                                                          BSNL0074
       TNZ NORM                                                         BSNL0075
       CLA FP1                                                          BSNL0076
       TXL NORM+3                                                       BSNL0077
 NORM  LDQ COM+1                                                        BSNL0078
       FMP YCOM+1,1                                                     BSNL0079
       TQO CL                                                           BSNL0080
       STO *-*,1                                                        BSNL0081
 NTST  TXH *+2,1,*-*                                                    BSNL0082
       TXI NORM,1,1                                                     BSNL0083
       LXD SVE1,1                                                       BSNL0084
       LXD SVE2,2                                                       BSNL0085
       TRA 4,4                                                          BSNL0086
 CL    STZ COM+1                                                        BSNL0087
       TXL NORM                                                         BSNL0088
 ERR   TSX NLERR,2                                                      BSNL0089
       BCD 2J0 T0 JN = 0                                                BSNL0090
       LXD L1,1                                                         BSNL0091
       TXL CL                                                           BSNL0092
 FLO   OCT 233000000013,001400000000                                    BSNL0093
 FP1   DEC 1.0,1.5                                                      BSNL0094
 DUB   OCT 001000000000                                                 BSNL0095
 YCOM  EQU 32660                                                        BSNL0096
       ORG -3                                                           BSNL0097
 COM   BSS 3                                                            BSNL0098
       END                                                              BSNL0099
