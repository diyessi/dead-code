NUFRED REM 0082 05270               FRACTION REDUCTION SUBROUTINE       FRED0001
       REM CALLING SEQUENCE - CALL FRED (NUM,IDEN)                              
       REM SUBROUTINE PROGRAM CARD                                      FRED  03
       MZE END                                                          FRED  04
       DEC 32562                                                        FRED  05
       BCD 1FRED                                                        FRED  06
       OCT 3                                                            FRED  07
       REM BEGINNING OF SUBROUTINE PROPER                               FRED  08
       ORG                                                              FRED  09
       REL                                                              FRED  10
 IRA   HTR                        STORAGE FOR I.R.1                     FRED  11
 IRB   HTR                        STORAGE FOR I.R.2                     FRED  12
       BCD 1FRED                                                        FRED  13
       SXD IRA,1                                                        FRED  14
       SXD IRB,2                                                        FRED  15
       CLA 1,4                                                          FRED  16
       STA ANUM1                                                        FRED  17
       STA OUT1                                                         FRED  18
       CLA 2,4                                                          FRED  19
       STA ADEN1                                                        FRED  20
       STA OUT2                                                         FRED  21
       REM (AC) OVERFLOW LIGHT USED AS INDICATOR FOR FRACTION REVERSAL  FRED  22
       ALS 31                                                           FRED  23
 ADEN1 LDQ                        DENOMUNATOR                           FRED  24
       STQ DEN                                                          FRED  25
 ANUM1 CLA                                  NUMERATOR                   FRED  26
       TZE OUT3                   IF NUM = 0, NO FACTORS                FRED  27
       SSP                                                              FRED  28
       SUB ONE                                                                  
       TZE OUT3                                                         FRED  30
       ADD ONE                                                          FRED  31
       CAS DEN                              DENOMINATOR                 FRED  32
       TRA REV                    IF NUM. GREATER THAN DENOM.           FRED  33
       TRA EQU                                                          FRED  34
       STO NUM                                                          FRED  35
       CLA DEN                                                          FRED  36
 RED   LXA ONE,2                  ZERO TO I.R. 2                        FRED  37
 RED1  LXD ONE,1                                                        FRED  38
 RED2  SUB NUM,2                                                        FRED  39
       CAS NUM,2                                                        FRED  40
       TXI RED2,1,1               (AC) GREATER THAN NUMERATOR           FRED  41
       TXI COMP,1,1                                                     FRED  42
       STO NUM-1,2                NEXT NUMERATOR TO STORAGE             FRED  43
       SUB ONE               REMAINDER IS IN (AC) - SUBTRACT ONE        FRED  44
       TZE OUT               REMAINDER = ONE.  NO FACTORS               FRED  45
       PXD 0,1               REMAINDER GREATER THAN ONE - DIVIDE AGAIN  FRED  46
       STO INTEG-1,2                                                    FRED  47
       CLA NUM,2                  NEXT DENOMINATOR IN (AC)              FRED  48
       TXI RED1,2,1                                                     FRED  49
 COMP  LDQ ONE                                                          FRED  50
       STQ DEN                                                          FRED  51
       PXD 0,1                                                          FRED  52
       STO NUM                                                          FRED  53
       TXL RETN,2,0                                                     FRED  54
 COMP1 LDQ NUM                                                          FRED  55
       MPY INTEG,2                                                      FRED  56
       ALS 17                                                           FRED  57
       ADD DEN                                                          FRED  58
       LDQ NUM                                                          FRED  59
       STQ DEN                                                          FRED  60
       STO NUM                                                          FRED  61
       TIX COMP1,2,1                                                    FRED  62
 RETN  TNO OUT1                                                         FRED  63
       LDQ NUM                                                          FRED  64
       CLA DEN                                                          FRED  65
 OUT1  STD                   NUMERATOR                                  FRED  66
 OUT2  STQ                   DENOMINATOR                                FRED  67
 OUT   LXD IRA,1                                                        FRED  68
       LXD IRB,2                                                        FRED  69
 OUT3  TRA 3,4                                                          FRED  70
 EQU   CLA ONE                                                          FRED  71
       LDQ ONE                                                          FRED  72
       TRA OUT1                                                         FRED  73
 REV   STQ NUM                                                          FRED  74
       TOV RED                                                          FRED  75
 ONE   OCT 000001000000                                                 FRED  76
 END   HTR                                                              FRED  77
       ORG 32566                                                        FRED  78
 DEN   HTR                                                              FRED  79
 NUM   BES 100                                                          FRED  80
 INTEG BES 100                                                          FRED  81
       END                                                              FRED  82
