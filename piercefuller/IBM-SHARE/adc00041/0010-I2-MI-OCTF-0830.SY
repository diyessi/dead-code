       REM FORTRAN II OCTAL LOADER SUBPROGRAM, WITH               (OCTF)MIOCF001
       REM OPTIONAL OFF'LINE LISTING OF OCTAL CORRECTION CARDS, AND     MIOCF002
       REM SPECIAL COMMENT CARDS                                        MIOCF003
       REM MAY 20, 1959                                                 MIOCF004
       REM                                                              MIOCF005
       ORG 0                            PROGRAM CARD                    MIOCF006
       ABS                                                              MIOCF007
       MZE TPNO+1                       8L   LENGTH                     MIOCF008
       PZE                              8R   NO COMMON                  MIOCF009
       BCD 1(OCTF)                                                      MIOCF010
       PZE ENTRY                        7R  PSEUDO ENTRY POINT          MIOCF011
       REM START OF PROGRAM PROPER                                      MIOCF012
       REL                                                              MIOCF013
       ORG 0                            INITIAL CONDITIONS 9L IN 0,     MIOCF014
       REM                              AC  - 9R IN 1, MQ.              MIOCF015
 TEST  CAS TNX                          COMPARE WITH -200-0             MIOCF016
       TRA PCTRA                        AC HI, SO F2TRA OR PROG. CARD   MIOCF017
       NOP                              AC = OR LO, SO OCTAL CARD       MIOCF018
       STO IMAGE                                                        MIOCF019
       STQ IMAGE+12                                                     MIOCF020
       STZ INDIC                        ZEROISE ERROR INDICATOR         MIOCF021
       CAL 0                            9L                              MIOCF022
       ANA MASK1                        EXTRACT 1ST 24 COLUMNS          MIOCF023
       SLW DPCHK                                                        MIOCF024
       ANA MASK2                        C.C.S 3 THRU 24                 MIOCF025
       TZE P1                           SHOULD BE BLANK                 MIOCF026
       SLW INDIC                                                        MIOCF027
 P1    CPY IMAGE+1                      READ 8L                         MIOCF028
       REM MODIFYING PROG. SUBSEQUENTLY COVERED BY NEXT CARD            MIOCF029
 FIX   CLA MOD1                         PATCH TMI                       MIOCF030
       STA UL1+2                        X                               MIOCF031
       CLA MOD2                         PATCH TZE                       MIOCF032
       STA UL1+3                        X                               MIOCF033
       TRA RDCRD                                                        MIOCF034
 MOD1  PZE TEST                                                         MIOCF035
 MOD2  PZE BLANK                                                        MIOCF036
       TCD FIX                                                          MIOCF037
       REM PROGRAM IN OPERATION CONTINUES HERE                          MIOCF038
       ORG 13                                                           MIOCF039
       REL                                                              MIOCF040
       LGL 24                           1ST 24 C.C.S SHOULD BE BLANK    MIOCF041
       TZE P2                           X                               MIOCF042
       SLW INDIC                                                        MIOCF043
 P2    CPY IMAGE+13                     READ 8R                         MIOCF044
       STZ 6                            ZEROISE STORES FOR ACCUMULATING MIOCF045
       STZ 7                            OCTAL CORRECTION                MIOCF046
       LXA P3,1                         10 TO IR1                       MIOCF047
 P3    PXD 10,0                                                         MIOCF048
       CAD IMAGE+12,1                   READ LEFT WORD                  MIOCF049
       ANA MASK1                        INSPECT 1ST 24 C.C.S            MIOCF050
       SLW 0                                                            MIOCF051
       ANA DPCHK                        CHECK FOR DOUBLE-PUNCHES        MIOCF052
       TZE P4                                                           MIOCF053
       SLW INDIC                                                        MIOCF054
 P4    CAL 0                                                            MIOCF055
       ORS DPCHK                                                        MIOCF056
       CPY IMAGE+24,1                   READ RIGHT WORD                 MIOCF057
       TXL P8,1,3                       SKIP PROCESSING FOR 0 THRU Y ROWMIOCF058
       LDQ IMAGE+12,1                   L WORD TO MQ                    MIOCF059
       LXD P8-1,2                       2 TO IR2                        MIOCF060
       TIX P5,1,3                       OBTAIN ROW DIGIT                MIOCF061
 P5    PXD 12,1                         X                               MIOCF062
       ALS 15                           THENCE TO PREFIX                MIOCF063
       LXA P5,4                         12 TO IR4                       MIOCF064
 P6    TQP P7                                                           MIOCF065
       ORS 8,2                          INSERT DIGIT, IF CARD PUNCHED   MIOCF066
 P7    RQL 1                                                            MIOCF067
       ARS 3                                                            MIOCF068
       TIX P6,4,1                                                       MIOCF069
       TIX P5,2,1                                                       MIOCF070
       TXI P3,1,2                       RETURN TO PROCESS UP TO 1 ROW   MIOCF071
 P8    TIX P3,1,1                                                       MIOCF072
       CAL INDIC                        CARD MIS-PUNCHED (Q)            MIOCF073
       TZE P9                                                           MIOCF074
       TSX ALPRT,2                      YES. PRINT UNCONDITIONALLY      MIOCF075
       TRA 32767                        THEN STOP                       MIOCF076
 P9    TSX PRNT,2                       O.K.  PRINT CONDITIONALLY       MIOCF077
       LDQ 6                            ADDRESS, AND REL. BITS          MIOCF078
       PXD 0,0                          CLEAR AC                        MIOCF079
       LGL 24                           LOC. TO AC                      MIOCF080
       RQL 8                                                            MIOCF081
       TQP P10                          JUMP IF RELOCATABLE             MIOCF082
       TXI P11,4,-1                     ABS. ZEROISE IR4                MIOCF083
 P10   SUB PGLNG                        SUBTRACT PROGRAM LENGTH         MIOCF084
       ADD INCMT                        ADD PROGRAM BREAK               MIOCF085
 P11   ADD L(1)                                                         MIOCF086
       STA P15                                                          MIOCF087
       TQP P12                          JUMP IF RELOCATABLE             MIOCF088
       TRA P14                          ABSOLUTE                        MIOCF089
 P12   RQL 31                                                           MIOCF090
       STA UL10                         SET UP BSS FOR RELOCATION       MIOCF091
       STA UL11                         X                               MIOCF092
       STA UL12                         X                               MIOCF093
       STA UL9                          X                               MIOCF094
       SUB INCMT                                                        MIOCF095
       TMI P14                          PROGRAM ENLARGED (Q)            MIOCF096
       ADD PGLNG                        YES. REVISE PROGRAM LENGTH      MIOCF097
       STA PGLNG                        X                               MIOCF098
       CLA P15                          REVISE PROGRAM BREAK            MIOCF099
       STA INCMT                        X                               MIOCF100
       CLA UL18                                                         MIOCF101
       STD P13                                                          MIOCF102
       LXA INCMT,2                                                      MIOCF103
 P13   TXH 3,2,**                       ALARM IF PROG. OVERLAPS S.T.    MIOCF104
       CLA LSTCM                                                        MIOCF105
       SUB INCMT                                                        MIOCF106
       TMI UL13-1                       ALARM IF PROG. OVERLAPS COMMON  MIOCF107
 P14   CLA 7                            ALL IN ORDER  INSERT WORD       MIOCF108
       STQ 7                            REL. BITS                       MIOCF109
 P15   STO **,1                         N.B.   C(IR1) = 1               MIOCF110
       TXI UL7,4,1                      BACK TO BSS FOR RELOC.          MIOCF111
PCTRA  TZE *+2                                                          MIOCF112
       TRA UL13                                                         MIOCF113
       LXD OUTWD,1                                                      MIOCF114
       TXL UL13,1,0                                                     MIOCF115
PA1    WTD 2                                                            MIOCF116
       CPY HSKP                                                         MIOCF117
PA2    WEF 2    WEF 2 UPON RECOGNITION OF TRA CARD IF ANY COMMENTS LOGGEMIOCF118
       IOD                                                              MIOCF119
       TRA UL13                                                         MIOCF120
 BLANK STO IMAGE                        NOTE 9L                         MIOCF121
       STQ IMAGE+12                                                     MIOCF122
       CAL 0                            PREPARE TO CHECK FOR ENTIRELY   MIOCF123
       ACL 1                            BLANK CARD                      MIOCF124
       LXD BK1,1                        11 TO IR1                       MIOCF125
       CAD IMAGE+12,1                                                   MIOCF126
       CAD IMAGE+24,1                                                   MIOCF127
       TIX BLANK+5,1,1                                                  MIOCF128
       TZE RDCRD                        OMIT PRINTING IF ALL BLANK      MIOCF129
       CAL IMAGE+7                      OR IF S PUNCHED IN C.C. 1       MIOCF130
       ANA IMAGE+9                      X                               MIOCF131
       PBT                              X                               MIOCF132
       TSX ALPRT,2                                                      MIOCF133
 BK1   TXI RDCRD,0,11                   RETURN TO READ FURTHER CARDS    MIOCF134
 PRNT  CAL IMAGE+7                                                      MIOCF135
       ANA IMAGE+9                                                      MIOCF136
       ANA MASK3                                                        MIOCF137
       TNZ A9                           JUMP IF S ON C.C. 25            MIOCF138
 ALPRT SXD INDX2,2                      UNCONDITIONAL PRINT ENTRY       MIOCF139
       SXD INDX4,4                                                      MIOCF140
       LXD A5,1                         2 TO IR1                        MIOCF141
 A1    SXD BOX1,1                       SAVE IR1                        MIOCF142
       LXA A6+4,2                       6 WORDS OUTPUT/HALF CARD        MIOCF143
       CAL MZE                                                          MIOCF144
       SLW BIT                                                          MIOCF145
 A2    LXA A6+4,4                       6 CHARACTERS/WORD               MIOCF146
       STZ WORD                                                         MIOCF147
       SXD BOX2,2                       SAVE IR2                        MIOCF148
       LXA A6,2                         ZEROISE 2 FOR COLLECTING DIGIT  MIOCF149
       LXD A7-1,1                       9 DIGIT ROWS TO SCAN            MIOCF150
 A3    CAL BIT                                                          MIOCF151
       ANA IMAGE+9,1                    SCAN 9 THRU 1 ROW               MIOCF152
       TZE A4                                                           MIOCF153
       SXD *+1,1                        PUNCH FOUND                     MIOCF154
       TXI *+1,2,**                                                     MIOCF155
 A4    TIX A3,1,1                                                       MIOCF156
       CAL BIT                          IR1=1 NOW                       MIOCF157
       ANA IMAGE+12,1                   SCAN Y,X,0 ROWS                 MIOCF158
       TNZ A5                           JUMP IF ZONE PUNCH              MIOCF159
       TXI *+1,1,1                                                      MIOCF160
       TXL A4+1,1,3                                                     MIOCF161
       TXH A6,2,0                       NO ZONES. JUMP IF SOME DIGITS   MIOCF162
       TXI A6,2,48                      NO ZONES, NO DIGITS. SET TO BLNKMIOCF163
 A5    TXL *+2,1,2                      SOME ZONE. JUMP IF X OR Y       MIOCF164
       TXL A6,2,0                       0 ROW. JUMP IF NO DIGITS, JUST 0MIOCF165
       TXI *+1,2,16                     BUILD UP ZONE VALUE             MIOCF166
       TIX *-1,1,1                      X                               MIOCF167
 A6    PXD 0,2                          COMPLETE BCD DIGIT TO AC        MIOCF168
       ALS 12                                                           MIOCF169
       ORS WORD                                                         MIOCF170
       LDQ WORD                                                         MIOCF171
       RQL 6                                                            MIOCF172
       STQ WORD                                                         MIOCF173
       CAL BIT                                                          MIOCF174
       ARS 1                                                            MIOCF175
       SLW BIT                                                          MIOCF176
       TIX A3-2,4,1                     BACK FOR 6 CHARACTERS           MIOCF177
       LXD BOX2,2                                                       MIOCF178
       STQ TBLOK+6,2                    STORE 1 WORD                    MIOCF179
       TIX A2,2,1                       BACK FOR 6 WORDS                MIOCF180
       LXD BOX1,1                                                       MIOCF181
       TNX A7,1,1                       BOTH HALF CARDS (Q)             MIOCF182
       LXA P5,2                         NO. 12 TO IR2                   MIOCF183
       CLA IMAGE+24,2                   RIGHT HALF OF IMAGE TO          MIOCF184
       STO IMAGE+12,2                   LEFT HALF,                      MIOCF185
       TXH *+3,2,6                                                      MIOCF186
       CLA TBLOK+6,2                    AND OUTPUT TO RIGHTHALF.        MIOCF187
       STO IMAGE+24,2                                                   MIOCF188
       TIX *-5,2,1                                                      MIOCF189
       TXI A1,0,9                       BACK FOR SECOND HALF            MIOCF190
 A7    LXD OUTWD,1                                                      MIOCF191
       TXH A8,1,0                       USED PREVIOUSLY (Q)             MIOCF192
       CAL WTD0                         NO                              MIOCF193
       ADD TPNO                                                         MIOCF194
       SLW *+1                                                          MIOCF195
       WTD 2                                                            MIOCF196
       SLW PA1                                                          MIOCF197
       SLW A8                                                           MIOCF198
       ADD WEFOP                                                        MIOCF199
       SLW PA2                                                          MIOCF200
       LXA P5,1                         12 TO IR1                       MIOCF201
       SXD OUTWD,1                                                      MIOCF202
       CPY SKPWD                                                        MIOCF203
 A8    WTD 2                                                            MIOCF204
       CPY BLNK                         WRITE ONE WORD OF BLANK CHARACTEMIOCF205
       CPY IMAGE+30,1                                                   MIOCF206
       TIX *-1,1,1                                                      MIOCF207
       IOD                                                              MIOCF208
       LXD INDX2,2                                                      MIOCF209
       LXD INDX4,4                                                      MIOCF210
 A9    TRA 1,2                          EXIT                            MIOCF211
 TNX   TNX                                                              MIOCF212
 MASK1 OCT 777777770000                                                 MIOCF213
 MASK2 OCT 177777770000                                                 MIOCF214
 L(1)  DEC 1                                                            MIOCF215
 MASK3 DEC 1B24                                                         MIOCF216
 OUTWD HTR 0                                                            MIOCF217
 ENTRY TRA 1,4                                                          MIOCF218
 MZE   MZE                                                              MIOCF219
 WTD0  WTD 0                                                            MIOCF220
 WEFOP OCT 000200000000                                                 MIOCF221
 HSKP  OCT 026060606060                                                 MIOCF222
 SKPWD OCT 016060606060                                                 MIOCF223
 BLNK  OCT 606060606060                                                 MIOCF224
 INDX2                                                                  MIOCF225
 INDX4                                                                  MIOCF226
 INDIC                                                                  MIOCF227
 DPCHK                                                                  MIOCF228
 BOX1                                                                   MIOCF229
 BOX2                                                                   MIOCF230
 BIT   SYN INDIC                                                        MIOCF231
 WORD  SYN DPCHK                                                        MIOCF232
 IMAGE BSS 24                                                           MIOCF233
 TBLOK BSS 6                                                            MIOCF234
 TPNO  DEC 2                                                            MIOCF235
 UL1   EQU 32575                                                        MIOCF236
 UL7   EQU 32622                                                        MIOCF237
 UL9   EQU 32629                                                        MIOCF238
 UL10  EQU 32633                                                        MIOCF239
 UL11  EQU 32638                                                        MIOCF240
 UL12  EQU 32640                                                        MIOCF241
 UL13  EQU 32662                                                        MIOCF242
 UL18  EQU 32695                                                        MIOCF243
 RDCRD EQU 15                                                           MIOCF244
 PGLNG EQU 32765                                                        MIOCF245
 INCMT EQU 23                                                           MIOCF246
 LSTCM EQU 32762                                                        MIOCF247
 F2TRA EQU 32756                                                        MIOCF248
