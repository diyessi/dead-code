MEFEND REM  80 05030                                                    FEND0001
       REM FORTRAN END CARD SEARCH.                                     FEND0002
C      REM CORNELLI,R.                                                  FEND0003
       SKP 0                                                            FEND0004
       ORG 0                                                            FEND0005
       FUL                                                              FEND0006
       TSX 1,1                                                          FEND0007
       CPY 2,1                                                          FEND0008
       TXI 1,1,-1                                                       FEND0009
       HTR ,,2                                                          FEND0010
       LXD *-1,4                                                        FEND0011
       RCD                                                              FEND0012
       CPY 2,1                                                          FEND0013
       TXI *-1,1,-1                                                     FEND0014
       NOP                                                              FEND0015
       TIX *-4,4,1                                                      FEND0016
       REW 1                                                            FEND0017
 START RTD 5                                                            FEND0018
       LXD CD12,3                                                       FEND0019
 A1    CPY IN,1                                                         FEND0020
       TRA *+3                                                          FEND0021
       HTR START                                                        FEND0022
       HTR START             EOR -- ERROR                               FEND0023
       TIX A1,1,1                                                       FEND0024
       IOD                                                              FEND0025
       LDQ IN,2                                                         FEND0026
       PXD 0,0                                                          FEND0027
       LGL 6                                                            FEND0028
       SUB CCOL1                                                        FEND0029
       TZE START             THIS IS A COMMENT CARD -- IGNORE           FEND0030
       LGL 24                                                           FEND0031
       PXD 0,0                                                          FEND0032
       LGL 6                                                            FEND0033
       CAS BLANK                                                        FEND0034
 CD12  TXL *+2,,12                                                      FEND0035
       TRA SRCH              X-FER IF NOT A CONTINUATION.               FEND0036
       TZE SRCH                                                         FEND0037
       CLA END                                                          FEND0038
       TNZ START                                                        FEND0039
       LXD I,1                                                          FEND0040
       TXI NWORD,2,-1                                                   FEND0041
 SRCH  STZ END                                                          FEND0042
       LXD CD4,1                                                        FEND0043
       TXI NWORD,2,-1                                                   FEND0044
       SKP 0                                                            FEND0045
       REM CHECK FOR KEY CHARACTERS,   END(                             FEND0046
       SKP 0                                                            FEND0047
 NWORD LDQ IN,2                                                         FEND0048
       LXA NCHAR,4                                                      FEND0049
 NCHAR PXD 6,0                                                          FEND0050
       LGL 6                                                            FEND0051
       CAS BLANK                                                        FEND0052
       TRA *+2                                                          FEND0053
       TRA NXCH                                                         FEND0054
       CAS BLANK,1                                                      FEND0055
 CD4   TXL *+2,,4                                                       FEND0056
       TRA FND                                                          FEND0057
       CLA CD4                                                          FEND0058
       STO END                                                          FEND0059
       TRA START                                                        FEND0060
 FND   TIX NXCH,1,1                                                     FEND0061
       HPR -1                                                           FEND0062
       SWT 6                                                            FEND0063
       TRA START                                                        FEND0064
       RTB 1                                                            FEND0065
       CPY 0                                                            FEND0066
       CPY 1                                                            FEND0067
       TRA 0                                                            FEND0068
 NXCH  TIX NCHAR,4,1                                                    FEND0069
       TIX NWORD,2,1                                                    FEND0070
       SXD I,1                                                          FEND0071
       STZ END                                                          FEND0072
       TRA START                                                        FEND0073
       BCD 400000E00000N00000D00000(                                    FEND0074
 BLANK BCD 100000                                                       FEND0075
 CCOL1 BCD 100000C                                                      FEND0076
 END                                                                    FEND0077
 I                                                                      FEND0078
 IN    BES 12                                                           FEND0079
       END 0                                                            FEND0080
