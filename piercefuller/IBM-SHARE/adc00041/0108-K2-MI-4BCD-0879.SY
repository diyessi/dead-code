       REM CARTER,M519. TO SHIFT BCD WORD RIGHT UNTIL R.H.CH.           MI4B0963
       REM  IS NON'BLANK. CALL SFTRT(A,B).                              MI4B0964
       REM                                                              MI4B0965
       REM PROGRAM CARD                                                 MI4B0966
       ORG 0                                                            MI4B0967
       FPC                                                              MI4B0968
       PZE LAST                                                         MI4B0969
       PZE                                                              MI4B0970
       BCD 1SFTRT                                                       MI4B0971
       HTR SFTRT                                                        MI4B0972
       REM PROGRAM                                                      MI4B0973
       ORG 0                                                            MI4B0974
       REL                                                              MI4B0975
 INDX1                                                                  MI4B0976
 SFTRT SXD INDX1,1                                                      MI4B0977
       LXA P1-3,1                       6 TO IR1                        MI4B0978
       CLA 1,4                         L(A)                             MI4B0979
       STA S1                                                           MI4B0980
       CLA 2,4                                                          MI4B0981
       STA S2                                                           MI4B0982
 S1    CAL **                          A                                MI4B0983
       SLW TEMP                                                         MI4B0984
       ANA MSK1CR                      PICK OUT RIGHT HAND CHARACTER.   MI4B0985
       SUB BK1R                        BLANK                            MI4B0986
       TNZ P1                                                           MI4B0987
       CAL TEMP                        YES.                             MI4B0988
       ARS 6                           SHIFT RIGHT 1 CH.                MI4B0989
       ORA BK1L                        INSERT BLANK AT LEFT             MI4B0990
       TIX S1+1,1,1                                                     MI4B0991
 P1    CAL TEMP                                                         MI4B0992
 S2    SLW **                          B                                MI4B0993
       LXD INDX1,1                                                      MI4B0994
       TRA 3,4                                                          MI4B0995
MSK1CR OCT 77                                                           MI4B0996
 BK1R  OCT 60                                                           MI4B0997
 BK1L  SIX                                                              MI4B0998
 TEMP                                                                   MI4B0999
 LAST  BSS                                                              MI4B1000
       END 0                                                            MI4B1001
       REM CARTER,M519. UNPACKING BCD WORDS INTO SINGLE'CH.S.           MI4B1002
       REM CALL UNPACK(NCHS,WORD1,ITHCH,STRING) ' I.E.UNPACK            MI4B1003
       REM N CHS.FROM ITH POSN.OF WORD 1 INTO STRING,ET SEQ.            MI4B1004
       REM                                                              MI4B1005
       REM PROGRAM CARD                                                 MI4B1006
       ORG 0                                                            MI4B1007
       FPC                                                              MI4B1008
       PZE LAST                                                         MI4B1009
       PZE                                                              MI4B1010
       BCD 1UNPACK                                                      MI4B1011
       HTR UNPACK                                                       MI4B1012
       REM PROGRAM                                                      MI4B1013
       ORG 0                                                            MI4B1014
       REL                                                              MI4B1015
 INDX1                                                                  MI4B1016
 INDX2                                                                  MI4B1017
 INDX4                                                                  MI4B1018
UNPACK SXD INDX1,1                                                      MI4B1019
       SXD INDX2,2                                                      MI4B1020
       SXD INDX4,4                                                      MI4B1021
       CLA 1,4                         L(NCHS)                          MI4B1022
       STA S3                                                           MI4B1023
       STA *+1                                                          MI4B1024
       CLA **                          NCHS                             MI4B1025
       TZE E1-1                         IF ZERO EXIT                    MI4B1026
       ARS 18                                                           MI4B1027
       SSP                                                              MI4B1028
       ADD 4,4                         STRING+NCHS                      MI4B1029
       STA S5                                                           MI4B1030
       CLA 2,4                                                          MI4B1031
       STA S2                                                           MI4B1032
       STA S4                                                           MI4B1033
       CLA 3,4                         L(ITGCG)                         MI4B1034
       STA S1                                                           MI4B1035
 S1    LXD **,1                        ITCHC TO INDEX 1                 MI4B1036
       SXD TEMP,1                                                       MI4B1037
       TXL E1,1,0                      CHECK FOR 1 THROUGH 6            MI4B1038
       TXH E1,1,6                                                       MI4B1039
       LXD *-2,2                        ZEROISE INDEX 2                 MI4B1040
 S2    LDQ **                          WORD 1 TO MQ                     MI4B1041
       TNX S3,1,1                                                       MI4B1042
       LGL 6                           POSITION FOR ITH CHARACTER.      MI4B1043
       TXI S2+1,2,-1                                                    MI4B1044
 S3    LXD **,1                        NCHS TO IR1                      MI4B1045
       LXD S2-3,4                       ZEROISE INDEX 4                 MI4B1046
       TXI P1,2,6                                                       MI4B1047
 S4    LDQ **,4                        WORD 1                           MI4B1048
       LXD *-2,2                        6 TO IR2                        MI4B1049
 P1    LGL 6                                                            MI4B1050
       ALS 30                                                           MI4B1051
       ORA BK5R                                                         MI4B1052
 S5    SLW **,1                        STRING+NCHS                      MI4B1053
       TNX P2,1,1                                                       MI4B1054
       TIX P1,2,1                                                       MI4B1055
       TXI S4,4,-1                                                      MI4B1056
 P2    LXD INDX1,1                                                      MI4B1057
       LXD INDX2,2                                                      MI4B1058
       LXD INDX4,4                                                      MI4B1059
       TOV *+1                                                          MI4B1060
       TRA 5,4                         EXIT                             MI4B1061
 E1    HTR *-5                                                          MI4B1062
 ZERO                                                                   MI4B1063
 BK5R  OCT 6060606060                                                   MI4B1064
 L(7)  DEC 7B17                                                         MI4B1065
 TEMP                                                                   MI4B1066
 LAST  BSS                                                              MI4B1067
       END 0                                                            MI4B1068
