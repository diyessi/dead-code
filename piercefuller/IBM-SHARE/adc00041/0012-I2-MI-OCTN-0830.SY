       REM FORTRAN II OCTAL LOADER SUBPROGRAM,                    (OCTN)MIOCN001
       REM WITH OPTIONAL ON'LINE LISTING OF OCTAL CORRECTION CARDS      MIOCN002
       REM AND SPECIAL COMMENT CARDS                                    MIOCN003
       REM MAY 20, 1959                                                 MIOCN004
       REM                                                              MIOCN005
       ORG 0                            PROGRAM CARD                    MIOCN006
       ABS                                                              MIOCN007
       MZE END-TEST                     8L PROGRAM LENGTH               MIOCN008
       PZE                              8R NO COMMON                    MIOCN009
       BCD 1(OCTN)                                                      MIOCN010
       PZE ENTRY                        7R PSEUDO ENTRY POINT           MIOCN011
       REM START OF PROGRAM PROPER                                      MIOCN012
       REL                                                              MIOCN013
       ORG 0                            INITIAL CONDITIONS 9L IN 0,     MIOCN014
       REM                              AC  - 9R IN 1, MQ.              MIOCN015
 TEST  CAS TNX                          COMPARE WITH -200-0             MIOCN016
       TRA PCTRA                        AC HI, SO F2TRA OR PROG. CARD   MIOCN017
       NOP                              AC = OR LO, SO OCTAL CARD       MIOCN018
       STO IMAGE                                                        MIOCN019
       STQ IMAGE+12                                                     MIOCN020
       STZ INDIC                        ZEROISE ERROR INDICATOR         MIOCN021
       CAL 0                            9L                              MIOCN022
       ANA MASK1                        EXTRACT 1ST 24 COLUMNS          MIOCN023
       SLW DPCHK                                                        MIOCN024
       ANA MASK2                        C.C.S 3 THRU 24                 MIOCN025
       TZE P1                           SHOULD BE BLANK                 MIOCN026
       SLW INDIC                                                        MIOCN027
 P1    CPY IMAGE+1                      READ 8L                         MIOCN028
       REM MODIFYING PROG. SUBSEQUENTLY COVERED BY NEXT CARD            MIOCN029
 FIX   CLA MOD1                         PATCH TMI                       MIOCN030
       STA UL1+2                        X                               MIOCN031
       CLA MOD2                         PATCH TZE                       MIOCN032
       STA UL1+3                        X                               MIOCN033
       TRA RDCRD                                                        MIOCN034
 MOD1  PZE TEST                                                         MIOCN035
 MOD2  PZE BLANK                                                        MIOCN036
       TCD FIX                                                          MIOCN037
       REM PROGRAM IN OPERATION CONTINUES HERE                          MIOCN038
       ORG 13                                                           MIOCN039
       REL                                                              MIOCN040
       LGL 24                           1ST 24 C.C.S SHOULD BE BLANK    MIOCN041
       TZE P2                           X                               MIOCN042
       SLW INDIC                                                        MIOCN043
 P2    CPY IMAGE+13                     READ 8R                         MIOCN044
       STZ 6                            ZEROISE STORES FOR ACCUMULATING MIOCN045
       STZ 7                            OCTAL CORRECTION                MIOCN046
       LXA P3,1                         10 TO IR1                       MIOCN047
 P3    PXD 10,0                                                         MIOCN048
       CAD IMAGE+12,1                   READ LEFT WORD                  MIOCN049
       ANA MASK1                        INSPECT 1ST 24 C.C.S            MIOCN050
       SLW 0                                                            MIOCN051
       ANA DPCHK                        CHECK FOR DOUBLE-PUNCHES        MIOCN052
       TZE P4                                                           MIOCN053
       SLW INDIC                                                        MIOCN054
 P4    CAL 0                                                            MIOCN055
       ORS DPCHK                                                        MIOCN056
       CPY IMAGE+24,1                   READ RIGHT WORD                 MIOCN057
       TXL P8,1,3                       SKIP PROCESSING FOR 0 THRU Y ROWMIOCN058
       LDQ IMAGE+12,1                   L WORD TO MQ                    MIOCN059
       LXD P8-1,2                       2 TO IR2                        MIOCN060
       TIX P5,1,3                       OBTAIN ROW DIGIT                MIOCN061
 P5    PXD 12,1                         X                               MIOCN062
       ALS 15                           THENCE TO PREFIX                MIOCN063
       LXA P5,4                         12 TO IR4                       MIOCN064
 P6    TQP P7                                                           MIOCN065
       ORS 8,2                          INSERT DIGIT, IF CARD PUNCHED   MIOCN066
 P7    RQL 1                                                            MIOCN067
       ARS 3                                                            MIOCN068
       TIX P6,4,1                                                       MIOCN069
       TIX P5,2,1                                                       MIOCN070
       TXI P3,1,2                       RETURN TO PROCESS UP TO 1 ROW   MIOCN071
 P8    TIX P3,1,1                                                       MIOCN072
       CAL INDIC                        CARD MIS-PUNCHED (Q)            MIOCN073
       TZE P9                                                           MIOCN074
       TSX ALPRT,2                      YES. PRINT UNCONDITIONALLY      MIOCN075
       TRA 32767                        THEN STOP                       MIOCN076
 P9    TSX PRNT,2                       O.K.  PRINT CONDITIONALLY       MIOCN077
       LDQ 6                            ADDRESS, AND REL. BITS          MIOCN078
       PXD 0,0                          CLEAR AC                        MIOCN079
       LGL 24                           LOC. TO AC                      MIOCN080
       RQL 8                                                            MIOCN081
       TQP P10                          JUMP IF RELOCATABLE             MIOCN082
       TXI P11,4,-1                     ABS. ZEROISE IR4                MIOCN083
 P10   SUB PGLNG                        SUBTRACT PROGRAM LENGTH         MIOCN084
       ADD INCMT                        ADD PROGRAM BREAK               MIOCN085
 P11   ADD L(1)                                                         MIOCN086
       STA P15                                                          MIOCN087
       TQP P12                          JUMP IF RELOCATABLE             MIOCN088
       TRA P14                          ABSOLUTE                        MIOCN089
 P12   RQL 31                                                           MIOCN090
       STA UL10                         SET UP BSS FOR RELOCATION       MIOCN091
       STA UL11                         X                               MIOCN092
       STA UL12                         X                               MIOCN093
       STA UL9                          X                               MIOCN094
       SUB INCMT                                                        MIOCN095
       TMI P14                          PROGRAM ENLARGED (Q)            MIOCN096
       ADD PGLNG                        YES. REVISE PROGRAM LENGTH      MIOCN097
       STA PGLNG                        X                               MIOCN098
       CLA P15                          REVISE PROGRAM BREAK            MIOCN099
       STA INCMT                        X                               MIOCN100
       CLA UL18                                                         MIOCN101
       STD P13                                                          MIOCN102
       LXA INCMT,2                                                      MIOCN103
 P13   TXH 3,2,**                       ALARM IF PROG. OVERLAPS S.T.    MIOCN104
       CLA LSTCM                                                        MIOCN105
       SUB INCMT                                                        MIOCN106
       TMI UL13-1                       ALARM IF PROG. OVERLAPS COMMON  MIOCN107
 P14   CLA 7                            ALL IN ORDER  INSERT WORD       MIOCN108
       STQ 7                            REL. BITS                       MIOCN109
 P15   STO **,1                         N.B.   C(IR1) = 1               MIOCN110
       TXI UL7,4,1                      BACK TO BSS FOR RELOC.          MIOCN111
PCTRA  TZE *+2                                                          MIOCN112
       TRA UL13                                                         MIOCN113
       LXD OUTWD,1                                                      MIOCN114
       TXL UL13,1,0                                                     MIOCN115
       WPR                                                              MIOCN116
       SPR 2                                                            MIOCN117
       TRA UL13                                                         MIOCN118
 BLANK STO IMAGE                        NOTE 9L                         MIOCN119
       STQ IMAGE+12                                                     MIOCN120
       CAL 0                            PREPARE TO CHECK FOR ENTIRELY   MIOCN121
       ACL 1                            BLANK CARD                      MIOCN122
       LXD BK1,1                        11 TO IR1                       MIOCN123
       CAD IMAGE+12,1                                                   MIOCN124
       CAD IMAGE+24,1                                                   MIOCN125
       TIX BLANK+5,1,1                                                  MIOCN126
       TZE RDCRD                        OMIT PRINTING IF ALL BLANK      MIOCN127
       CAL IMAGE+7                      OR IF S PUNCHED IN C.C. 1       MIOCN128
       ANA IMAGE+9                      X                               MIOCN129
       PBT                              X                               MIOCN130
       TSX ALPRT,2                                                      MIOCN131
 BK1   TXI RDCRD,0,11                   RETURN TO READ FURTHER CARDS    MIOCN132
 PRNT  CAL IMAGE+7                      CHECK FOR S IN C.C. 25          MIOCN133
       ANA IMAGE+9                                                      MIOCN134
       ANA MASK3                                                        MIOCN135
       TNZ ALPRT+10                                                     MIOCN136
 ALPRT WPR                                                              MIOCN137
       LXD OUTWD,1                                                      MIOCN138
       TXH ALPRT+7,1,0                                                  MIOCN139
       SPR 1                                                            MIOCN140
       LXA P5,1                                                         MIOCN141
       SXD OUTWD,1                                                      MIOCN142
       WPR                                                              MIOCN143
       CPY IMAGE+12,1                                                   MIOCN144
       CPY IMAGE+24,1                                                   MIOCN145
       TIX ALPRT+7,1,1                                                  MIOCN146
       TRA 1,2                                                          MIOCN147
 TNX   TNX                                                              MIOCN148
 MASK1 OCT 777777770000                                                 MIOCN149
 MASK2 OCT 177777770000                                                 MIOCN150
 L(1)  DEC 1                                                            MIOCN151
 MASK3 DEC 1B24                                                         MIOCN152
 OUTWD HTR 0                                                            MIOCN153
 ENTRY TRA 1,4                                                          MIOCN154
 INDIC                                                                  MIOCN155
 IMAGE BSS 24                                                           MIOCN156
 DPCHK                                                                  MIOCN157
 END   BSS 0                                                            MIOCN158
 UL1   EQU 32575                                                        MIOCN159
 UL7   EQU 32622                                                        MIOCN160
 UL9   EQU 32629                                                        MIOCN161
 UL10  EQU 32633                                                        MIOCN162
 UL11  EQU 32638                                                        MIOCN163
 UL12  EQU 32640                                                        MIOCN164
 UL13  EQU 32662                                                        MIOCN165
 UL18  EQU 32695                                                        MIOCN166
 RDCRD EQU 15                                                           MIOCN167
 PGLNG EQU 32765                                                        MIOCN168
 INCMT EQU 23                                                           MIOCN169
 LSTCM EQU 32762                                                        MIOCN170
 F2TRA EQU 32756                                                        MIOCN171
