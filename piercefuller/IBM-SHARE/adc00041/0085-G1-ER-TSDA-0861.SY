C     TIME SERIES DECOMPOSITION AND ADJUSTMENT                          ERTS0000
C     (ADAPTATION OF TV-TSDA TO 8K 704)                                 ERTS0001
C     PART I.  TABLES 1 TO 13, 29 TO 32                                 ERTS0002
C                                                                       ERTS0003
C     L. T. UNG            ESSO RESEARCH AND ENGINEERING CO.            ERTS0004
C                          FEBRUARY 2, 1959                             ERTS0005
C                                                                       ERTS0006
C                                                                       ERTS0007
C     ------------------------------------------------------------------ERTS0008
C                                                                       ERTS0009
C     DEFINITION OF INPUT SYMBOLS -                                     ERTS0010
C     KODE = INPUT OPTION INDEX                                         ERTS0011
C     KC = SERIES IDENTIFICATION NUMBER                                 ERTS0012
C     N = TOTAL NUMBER OF MONTHS (OR ELEMENTS) IN THE TIME SERIES       ERTS0013
C     X = ORIGINAL OBSERVATIONS                                         ERTS0014
C     K33 = FORECASTING OPTION                                          ERTS0015
C     LFSTYR = FIRST YEAR OF TIME SERIES                                ERTS0016
C     NFSTYR = FIRST YEAR OF DELIVERY DAY ADJUSTMENT FACTORS (IF        ERTS0017
C             REQUIRED)                                                 ERTS0018
C     NDDA  = NUMBER OF DELIVERY DAY ADJUSTMENT FACTORS                 ERTS0019
C     SIGMA = MULTIPLE OF STANDARD ERROR TO BE USED IN SETTING          ERTS0020
C             UPPER AND LOWER CONTROL LIMITS FOR DETERMINING EXTREME    ERTS0021
C             SEASONAL-IRREGULAR RATIOS                                 ERTS0022
C                                                                       ERTS0023
C     ------------------------------------------------------------------ERTS0024
C                                                                       ERTS0025
C                                                                       ERTS0026
      DIMENSION   LR(35), X(372), K(35), RA(372), A(372), OMA(372),     ERTS0027
     1            CMA(372), ROC(372), B(372), UCL(372), BCL(372),       ERTS0028
     2            ERC(372), PAF(372), PAS(372), WMA(372), BTM(384),     ERTS0029
     3            STA(372), STS(372), TOC(372), TGP(372), RESULT(400),  ERTS0030
     4            DDA(372)                                              ERTS0031
      EQUIVALENCE (X(1), TOC(1), BTM(1), TGP(1)),                       ERTS0032
     1            (CMA(1), UCL(1), ERC(1), PAS(1), STS(1)),             ERTS0033
     2            (RA(1), A(1), ROC(1)), (RESULT(1), DDA(1)),           ERTS0034
     3            (STA(1), OMA(1), B(1), BCL (1), PAF(1),WMA(1))        ERTS0035
C                                                                       ERTS0036
C                                                                       ERTS0037
C                                                                       ERTS0038
C     (THIS OPERATION IS BY-PASSED IF A PROGRAM TAPE IS TO BE           ERTS0039
C     PREPARED FROM THE TWO BINARY DECKS MAKING UP TSDA)                ERTS0040
C                                                                       ERTS0041
   10 REWIND 3                                                          ERTS0042
   11 REWIND 4                                                          ERTS0043
C                                                                       ERTS0044
C        PREPARATION OF TAPE 4, CONTAINING TITLE CARDS 1 TO 40          ERTS0045
   15 DO 20 I = 1,32                                                    ERTS0046
   16 IF(SENSE SWITCH 1)19, 17                                          ERTS0047
   17 READ 7160, NTABLE                                                 ERTS0048
   18 GO TO 20                                                          ERTS0049
   19 READ INPUT TAPE 6, 7160, NTABLE                                   ERTS0050
   20 WRITE OUTPUT TAPE 4, 7160, NTABLE                                 ERTS0051
   22 DO 27 I=1,8                                                       ERTS0052
   23 IF(SENSE SWITCH 1)26, 24                                          ERTS0053
   24 READ 7170                                                         ERTS0054
   25 GO TO 27                                                          ERTS0055
   26 READ INPUT TAPE 6, 7170                                           ERTS0056
   27 WRITE OUTPUT TAPE 4, 7170                                         ERTS0057
   28 REWIND 4                                                          ERTS0058
C                                                                       ERTS0059
C        CHECK OF INPUT DATA AND PREPARATION OF PRINTOUT                ERTS0060
   30 DO 35 I=1,4                                                       ERTS0061
   31 IF ( SENSE SWITCH 1)34, 32                                        ERTS0062
   32 READ 7033                                                         ERTS0063
   33 GO TO 35                                                          ERTS0064
   34 READ INPUT TAPE 6, 7033                                           ERTS0065
   35 WRITE OUTPUT TAPE 1, 7033                                         ERTS0066
   36 IF(SENSE SWITCH 1)39, 37                                          ERTS0067
   37 READ               7036, KC, KODE, LFSTYR,N,NFSTYR,NDDA,SIGMA,K33 ERTS0068
   38 GO TO 40                                                          ERTS0069
   39 READ INPUT TAPE 6, 7036, KC, KODE, LFSTYR,N,NFSTYR,NDDA,SIGMA,K33 ERTS0070
   40 LY = (N+11)/12                                                    ERTS0071
   41 LLSTYR = LFSTYR+LY-1                                              ERTS0072
   43 WRITE OUTPUT TAPE 1, 7043, KC, LFSTYR, LLSTYR, N, SIGMA           ERTS0073
   44 IF(84-N)45, 45, 6970                                              ERTS0074
   45 IF(N-360) 46, 46, 6970                                            ERTS0075
   46 IF(KODE)47, 47, 49                                                ERTS0076
   47 WRITE OUTPUT TAPE 1, 7045                                         ERTS0077
   48 GO TO 52                                                          ERTS0078
   49 WRITE OUTPUT TAPE 1, 7047                                         ERTS0079
   50 IF(84-NDDA) 51,51,6970                                            ERTS0080
   51 IF(NDDA-372) 52,52,6970                                           ERTS0081
   52 IF (K33) 53,55,55                                                 ERTS0082
   53 WRITE OUTPUT TAPE 1, 7053                                         ERTS0083
   54 GO TO 62                                                          ERTS0084
   55 IF (K33-4) 56,56,6985                                             ERTS0085
   56 WRITE OUTPUT TAPE 1, 7056                                         ERTS0086
   57 IF (K33-3) 58,58,60                                               ERTS0087
   58 WRITE OUTPUT TAPE 1, 7058, K33                                    ERTS0088
   59 GO TO 62                                                          ERTS0089
   60 WRITE OUTPUT TAPE 1, 7060                                         ERTS0090
   62 IF( SENSE SWITCH 1)65, 63                                         ERTS0091
   63 READ 7062, (K(J),J= 1,35)                                         ERTS0092
   64 GO TO 66                                                          ERTS0093
   65 READ INPUT TAPE 6,7062, (K(J),J = 1,35)                           ERTS0094
   66 JJ = 0                                                            ERTS0095
      DO 68 I = 1,32                                                    ERTS0096
      IF(K(I)-I)68, 67, 68                                              ERTS0097
   67 JJ = JJ+1                                                         ERTS0098
      LR(JJ) = K(I)                                                     ERTS0099
   68 CONTINUE                                                          ERTS0100
   70 WRITE OUTPUT TAPE 1, 7070                                         ERTS0101
   72 IF(JJ) 74,74,73                                                   ERTS0102
   73 WRITE OUTPUT TAPE 1, 7073, (LR(I), I = 1,JJ)                      ERTS0103
   74 K(33)=K33                                                         ERTS0104
   75 IF(SENSE SWITCH 1)78, 76                                          ERTS0105
   76 READ 7075, (X(I), I = 1,N)                                        ERTS0106
   77 GO TO 79                                                          ERTS0107
   78 READ INPUT TAPE 6, 7075, (X(I), I = 1,N)                          ERTS0108
   79 LR(1) = LFSTYR                                                    ERTS0109
      DO 80 I = 2,LY                                                    ERTS0110
   80 LR(I) = LR(I-1)+1                                                 ERTS0111
C                                                                       ERTS0112
   81 NP1=N+1                                                           ERTS0113
   82 NP7=N+7                                                           ERTS0114
   83 NP8=N+8                                                           ERTS0115
   84 NP12=N+12                                                         ERTS0116
   85 NP14=N+14                                                         ERTS0117
   86 N1=N-1                                                            ERTS0118
   87 N5=N-5                                                            ERTS0119
   88 N11=N-11                                                          ERTS0120
   89 N12=N-12                                                          ERTS0121
C                                                                       ERTS0122
C     TABLE 1 ORIGINAL OBSERVATIONS.                                    ERTS0123
   90 KK = 1                                                            ERTS0124
   91 IF(K(1)-1) 6500,92,6500                                           ERTS0125
   92 NOPTS = N                                                         ERTS0126
   93 NOBLK = 0                                                         ERTS0127
   94 DO 95  I=1,NOPTS                                                  ERTS0128
   95 RESULT(I) = X(I)                                                  ERTS0129
   96 GO TO 6000                                                        ERTS0130
C     OPTIONS-  KODE=0  NO DELIVERY-DAY ADJUSTMENT NEEDED               ERTS0131
C                    1  DDA FACTORS TO BE ENTERED AFTER DATA            ERTS0132
C                    2  DDA FACTORS ALREADY ENTERED                     ERTS0133
  100 IF(KODE) 180, 180, 102                                            ERTS0134
  102 IF(KODE-2) 104,110,5400                                           ERTS0135
  104 IF(SENSE SWITCH 1)107, 105                                        ERTS0136
  105 READ 7084, (DDA(I),I = 1,NDDA)                                    ERTS0137
  106 GO TO 108                                                         ERTS0138
  107 READ INPUT TAPE 6,7084, (DDA(I),I = 1,NDDA)                       ERTS0139
  108 WRITE TAPE3,NFSTYR,NDDA,(DDA(I),I = 1,372)                        ERTS0140
  109 GO TO 120                                                         ERTS0141
  110 READ TAPE 3, NFSTYR, NDDA, (DDA(I),I=1,372)                       ERTS0142
  120 IF(LR(1)-NFSTYR) 6950, 122, 122                                   ERTS0143
  122 MM1 = (LR(1)-NFSTYR)*12                                           ERTS0144
  124 MM2 = MM1+N                                                       ERTS0145
  126 IF(NDDA-MM2) 6950, 140, 140                                       ERTS0146
C                                                                       ERTS0147
C     TABLE 31 DELIVERY-DAY ADJUSTMENT FACTORS                          ERTS0148
  140 KK = 31                                                           ERTS0149
  142 IF(K(31)-31) 6500,144,6500                                        ERTS0150
  144 NOPTS = N                                                         ERTS0151
  145 NOBLK = 0                                                         ERTS0152
  146 DO 148 I = 1,NOPTS                                                ERTS0153
  147 II = I + MM1                                                      ERTS0154
  148 RESULT(I) = RESULT(II)                                            ERTS0155
  149 GO TO 6000                                                        ERTS0156
C                                                                       ERTS0157
C     TABLE 32 ADJUSTED OBSERVATIONS                                    ERTS0158
  154 DO 158 I=1,N                                                      ERTS0159
  158 X(I) = DDA(I)*X(I)/10000.0                                        ERTS0160
  161 KK = 32                                                           ERTS0161
  162 IF(K(32)-32) 6500,164,6500                                        ERTS0162
  164 NOPTS = N                                                         ERTS0163
  166 NOBLK = 0                                                         ERTS0164
  168 DO 170 I=1, NOPTS                                                 ERTS0165
  170 RESULT(I) = X(I)                                                  ERTS0166
  172 GO TO 6000                                                        ERTS0167
C                                                                       ERTS0168
  180 WRITE TAPE 3, NFSTYR, NDDA, (DDA(I),I=1,372)                      ERTS0169
  182 READ INPUT TAPE 4, 7160, NTABLE                                   ERTS0170
  184 READ INPUT TAPE 4, 7160, NTABLE                                   ERTS0171
  190 WRITE TAPE 3, KODE, LY, N, SIGMA, KC, (LR(L),L=1,30),(K(J),J=1,35)ERTS0172
  192 WRITE TAPE 3, (X(I), I=1,372)                                     ERTS0173
C                                                                       ERTS0174
C     TABLE 2 RATIOS OF EACH MONTH TO AVERAGE OF PRECEDING AND FOLLOWINGERTS0175
C             MONTHS, ALSO ARITHMETIC MEANS OF RATIOS FOR EACH MONTH.   ERTS0176
  200 DO 210 I=2,N1                                                     ERTS0177
  210 RA(I)=(2.*X(I))/(X(I-1)+X(I+1))*100.0                             ERTS0178
  225 KK = 2                                                            ERTS0179
  230 IF(K(2)-2) 6500,240,6500                                          ERTS0180
  240 NOPTS = N -2                                                      ERTS0181
  242 NOBLK = 1                                                         ERTS0182
  246 DO 248 I = 1, NOPTS                                               ERTS0183
  248 RESULT (I+1) = RA (I+1)                                           ERTS0184
  250 GO TO 6000                                                        ERTS0185
C                                                                       ERTS0186
  300 RA(1) = 0.0                                                       ERTS0187
  310 MY = 1                                                            ERTS0188
  380 SUM=0.                                                            ERTS0189
  390 DO 420 I=MY,N,12                                                  ERTS0190
  400 SUM=SUM+RA(I)                                                     ERTS0191
  410 IF(RA(I+12))430,430,420                                           ERTS0192
  420 CONTINUE                                                          ERTS0193
  430 DN=((I-MY)/12)+1                                                  ERTS0194
  432 IF(MY-1) 434, 434, 440                                            ERTS0195
  434 DN = DN - 1.                                                      ERTS0196
  440 STA(MY)=SUM/DN                                                    ERTS0197
  450 IF(MY-12)460,6400,6400                                            ERTS0198
  460 MY=MY+1                                                           ERTS0199
  470 GO TO 380                                                         ERTS0200
C                                                                       ERTS0201
C     TABLE 3 TWELVE-MONTH MOVING AVERAGE OF THE ORIGINAL SERIES        ERTS0202
  500 A(1)=0.0                                                          ERTS0203
  510 DO 520 I=1,12                                                     ERTS0204
  520 A(1)=A(1)+X(I)                                                    ERTS0205
  540 DO 550 I=2,N11                                                    ERTS0206
  550 A(I)=A(I-1)-X(I-1)+X(I+11)                                        ERTS0207
  552 WRITE TAPE 3,(A(I),I = 1,372)                                     ERTS0208
  555 DO 560 I=1,N11                                                    ERTS0209
  560 OMA(I)=A(I)/12.                                                   ERTS0210
  565 WRITE TAPE 3,(OMA(I),I = 1,372)                                   ERTS0211
  570 REWIND 3                                                          ERTS0212
  577 KK = 3                                                            ERTS0213
  580 IF(K(3)-3) 6500,582,6500                                          ERTS0214
  582 NOPTS = N - 11                                                    ERTS0215
  584 NOBLK = 5                                                         ERTS0216
  588 DO 590 I = 1, NOPTS                                               ERTS0217
  590 RESULT(I+5) = OMA(I)                                              ERTS0218
  592 GO TO 6000                                                        ERTS0219
C                                                                       ERTS0220
C     TABLE 4 CENTERED TWELVE-MONTH MOVING AVERAGE                      ERTS0221
  600 DO 610 I=1,N12                                                    ERTS0222
  610 CMA(I)=(OMA(I)+OMA(I+1))/2.                                       ERTS0223
  615 KK = 4                                                            ERTS0224
  620 IF(K(4)-4) 6500,630,6500                                          ERTS0225
  630 NOPTS = N - 12                                                    ERTS0226
  632 NOBLK = 6                                                         ERTS0227
  636 DO 638 I = 1, NOPTS                                               ERTS0228
  638 RESULT (I+6) = CMA(I)                                             ERTS0229
  640 GO TO 6000                                                        ERTS0230
C                                                                       ERTS0231
C     TABLE 5 RATIOS OF ORIGINAL OBSERVATIONS TO CENTERED TWELVE-MONTH  ERTS0232
C             MOVING AVERAGE                                            ERTS0233
  700 DO 710 I=1,N12                                                    ERTS0234
  710 ROC(I)=X(I+6)/CMA(I)*100.0                                        ERTS0235
  735 KK = 5                                                            ERTS0236
  740 IF(K(5)-5) 6500,750,6500                                          ERTS0237
  750 NOPTS = N - 12                                                    ERTS0238
  752 NOBLK = 6                                                         ERTS0239
  756 DO 758 I = 1, NOPTS                                               ERTS0240
  758 RESULT (I+6) = ROC(I)                                             ERTS0241
  760 GO TO 6000                                                        ERTS0242
C                                                                       ERTS0243
C     TABLE 6 PRELIMINARY SEASONAL ADJUSTMENT FACTORS                   ERTS0244
  800 ASSIGN 1015 TO M1                                                 ERTS0245
  803 ASSIGN 830 TO M4                                                  ERTS0246
  804 NX = N12                                                          ERTS0247
  805 DO 810 I=1,N                                                      ERTS0248
  810 ROC(I)=ROC(I)/100.                                                ERTS0249
  815 MY=1                                                              ERTS0250
  820 DO 825 I=1,N                                                      ERTS0251
  825 TOC(I)=ROC(I)                                                     ERTS0252
  826 GO TO M4,(827,830)                                                ERTS0253
  827 WRITE TAPE 3, (TOC(I),I=1,372)                                    ERTS0254
  828 REWIND 3                                                          ERTS0255
  830 DO 845 I=MY,N,12                                                  ERTS0256
  835 B(I+24)=(ROC(I)+ROC(I+12)+ROC(I+24)+ROC(I+36)+ROC(I+48))/5.       ERTS0257
  840 IF(NX-(I+60))850, 845, 845                                        ERTS0258
  845 CONTINUE                                                          ERTS0259
  850 B(MY)=.4*ROC(MY)+.4*ROC(MY+12)+.2*ROC(MY+24)                      ERTS0260
  855 B(MY+12)=.3*ROC(MY)+.3*ROC(MY+12)+.2*ROC(MY+24)+.2*               ERTS0261
     1ROC(MY+36)                                                        ERTS0262
  860 B(I+36)=.3*ROC(I+48)+.3*ROC(I+36)+.2*ROC(I+24)+.2*ROC(I+12)       ERTS0263
  865 B(I+48)=.4*ROC(I+48)+.4*ROC(I+36)+.2*ROC(I+24)                    ERTS0264
  870 TN=((I-MY)/12)+5                                                  ERTS0265
  875 LEND=I+48                                                         ERTS0266
  880 VAR=0.                                                            ERTS0267
  885 DO 890 L=MY,LEND,12                                               ERTS0268
  890 VAR=VAR+((ROC(L)-B(L))**2)/TN                                     ERTS0269
  895 S=SQRTF(VAR)                                                      ERTS0270
  900 DO 910 L=MY,LEND,12                                               ERTS0271
  905 UCL(L)=B(L)+SIGMA*S                                               ERTS0272
  910 BCL(L)=B(L)-SIGMA*S                                               ERTS0273
  915 IF(UCL(MY)-ROC(MY))  920,920,925                                  ERTS0274
  920 ROC(MY)=(TOC(MY)+TOC(MY+12)+TOC(MY+24))/3.                        ERTS0275
  925 IF(BCL(MY)-ROC(MY))   935,930,930                                 ERTS0276
  930 ROC(MY)=(TOC(MY)+TOC(MY+12)+TOC(MY+24))/3.                        ERTS0277
  935 IF(UCL(LEND)-ROC(LEND))   940,940,945                             ERTS0278
  940 ROC(LEND)=(TOC(LEND)+TOC(LEND-12)+TOC(LEND-24))/3.                ERTS0279
  945 IF(BCL(LEND)-ROC(LEND))   955,950,950                             ERTS0280
  950 ROC(LEND)=(TOC(LEND)+TOC(LEND-12)+TOC(LEND-24))/3.                ERTS0281
  955 LST=MY+12                                                         ERTS0282
  960 NST=LEND-12                                                       ERTS0283
  965 DO 990 L=LST,NST,12                                               ERTS0284
  970 IF(UCL(L)-ROC(L))    975,975,980                                  ERTS0285
  975 ROC(L)=(TOC(L-12)+TOC(L)+TOC(L+12))/3.                            ERTS0286
  980 IF(BCL(L)-ROC(L))    990,985,985                                  ERTS0287
  985 ROC(L)=(TOC(L-12)+TOC(L)+TOC(L+12))/3.                            ERTS0288
  990 CONTINUE                                                          ERTS0289
  995 IF(MY-12)    1000,1010,1010                                       ERTS0290
 1000 MY=MY+1                                                           ERTS0291
 1005 GO TO 830                                                         ERTS0292
 1010 GO TO M1,(1015,1745)                                              ERTS0293
 1015 ASSIGN 1270 TO M2                                                 ERTS0294
 1020 DO 1025 I=1,N12                                                   ERTS0295
 1025 ERC(I+6) = ROC(I)                                                 ERTS0296
 1030 DO 1035 I=1,6                                                     ERTS0297
 1035 ERC(I) = ERC(I+12)                                                ERTS0298
 1045 DO 1050 I=N5,N                                                    ERTS0299
 1050 ERC(I) = ERC(I-12)                                                ERTS0300
 1100 NCOMP = LY*12                                                     ERTS0301
 1110 DO 1115 I=NP1,NCOMP                                               ERTS0302
 1115 ERC(I) = (ERC(I-24)+ERC(I-12))/2.0                                ERTS0303
 1120 L = 1                                                             ERTS0304
 1125 J = 12                                                            ERTS0305
 1130 SUM = 0.0                                                         ERTS0306
 1135 DO 1140 I=L,J                                                     ERTS0307
 1140 SUM = SUM + ERC(I)                                                ERTS0308
 1145 XBAR = SUM/12.0                                                   ERTS0309
 1150 DO 1155 I=L,J                                                     ERTS0310
 1155 ERC(I) = ERC(I)/XBAR                                              ERTS0311
 1160 L = L+12                                                          ERTS0312
 1165 J = J+12                                                          ERTS0313
 1170 IF(J-NCOMP) 1130, 1130, 1265                                      ERTS0314
 1265 GO TO M2,(1270,1948)                                              ERTS0315
 1270 ASSIGN 1365 TO M3                                                 ERTS0316
 1275 MY=1                                                              ERTS0317
 1280 DO 1295 I=MY,N,12                                                 ERTS0318
 1285 PAF(I+24)=(ERC(I)+2.*ERC(I+12)+3.*ERC(I+24)+2.*ERC(I+36)          ERTS0319
     1+ERC(I+48))/9.                                                    ERTS0320
 1290 IF(N-(I+60))1300, 1295, 1295                                      ERTS0321
 1295 CONTINUE                                                          ERTS0322
 1300 PAF(MY)=(9.*ERC(MY)+7.*ERC(MY+12)+2.*ERC(MY+24))/18.              ERTS0323
 1305 PAF(MY+12)=(5.*ERC(MY)+7.*ERC(MY+12)+4.*ERC(MY+24)+2.*            ERTS0324
     1ERC(MY+36))/18.                                                   ERTS0325
 1310 PAF(I+36)=(5.*ERC(I+48)+7.*ERC(I+36)+4.*ERC(I+24)                 ERTS0326
     1+2.*ERC(I+12))/18.                                                ERTS0327
 1315 PAF(I+48)=(9.*ERC(I+48)+7.*ERC(I+36)+2.*ERC(I+24))/18.            ERTS0328
 1320 PAF(I+60)=(3.*PAF(I+48)-PAF(I+36))/2.                             ERTS0329
 1330 IF(MY-12)    1335,1345,1345                                       ERTS0330
 1335 MY=MY+1                                                           ERTS0331
 1340 GO TO 1280                                                        ERTS0332
 1345 CONTINUE                                                          ERTS0333
 1350 DO 1355 I=1,NP12                                                  ERTS0334
 1355 PAF(I)=PAF(I)*100.                                                ERTS0335
 1360 GO TO M3,(1365,2050)                                              ERTS0336
 1365 KK = 6                                                            ERTS0337
 1367 IF(K(6)-6) 6500,1370,6500                                         ERTS0338
 1370 NOPTS = N                                                         ERTS0339
 1372 NOBLK = 0                                                         ERTS0340
 1376 DO 1378 I = 1, NOPTS                                              ERTS0341
 1378 RESULT (I) = PAF (I)                                              ERTS0342
 1380 GO TO 6000                                                        ERTS0343
C                                                                       ERTS0344
C     TABLE 7 PRELIMINARY SEASONALLY ADJUSTED SERIES                    ERTS0345
 1400 READ TAPE 3                                                       ERTS0346
 1401 READ TAPE 3                                                       ERTS0347
 1402 READ TAPE 3,(X(I),I= 1,372)                                       ERTS0348
 1405 DO 1410 I=1,N                                                     ERTS0349
 1410 PAS(I)=X(I)/PAF(I)*100.0                                          ERTS0350
 1412 KK = 7                                                            ERTS0351
 1415 IF(K(7)-7)6500,1420,6500                                          ERTS0352
 1420 NOPTS = N                                                         ERTS0353
 1422 NOBLK = 0                                                         ERTS0354
 1426 DO 1428 I = 1, NOPTS                                              ERTS0355
 1428 RESULT (I) = PAS(I)                                               ERTS0356
 1430 GO TO 6000                                                        ERTS0357
C                                                                       ERTS0358
C     TWELVE MONTHS TO DATE OF ORIGINAL SERIES                          ERTS0359
 1500 READ TAPE3,(A(I),I= 1,372)                                        ERTS0360
 1502 BACKSPACE 3                                                       ERTS0361
 1503 BACKSPACE 3                                                       ERTS0362
 1505 KK = 29                                                           ERTS0363
 1510 IF(K(29)-29)6500,1520,6500                                        ERTS0364
 1520 NOPTS = N - 11                                                    ERTS0365
 1522 NOBLK = 11                                                        ERTS0366
 1524 DO 1526 I = 1, NOPTS                                              ERTS0367
 1526 RESULT (I+11) = A(I)                                              ERTS0368
 1528 GO TO 6000                                                        ERTS0369
C                                                                       ERTS0370
C     TABLE 8 WEIGHTED 15-MONTH MOVING AVERAGE (SPENCERS 15-TERM FORMULAERTS0371
C             ) OF PRELIMINARY SEASONALLY ADJUSTED SERIES               ERTS0372
 1550 DO 1555 I=1,7                                                     ERTS0373
 1555 BTM(I)=(PAS(1)+PAS(2)+PAS(3)+PAS(4))/4.                           ERTS0374
 1575 DO1580 I=NP8,NP14                                                 ERTS0375
 1580 BTM(I)=(PAS(N-3)+PAS(N-2)+PAS(N-1)+PAS(N))/4.                     ERTS0376
 1585 DO1588 I=8,NP7                                                    ERTS0377
 1588 BTM(I)=PAS(I-7)                                                   ERTS0378
 1590 DO1592 I=1,N                                                      ERTS0379
 1592 WMA(I)=(-3.*BTM(I)-6.*BTM(I+1)-5.*BTM(I+2)+3.*                    ERTS0380
     1BTM(I+3)+21.*BTM(I+4)+46.*BTM(I+5)+67.*BTM(I+6)+                  ERTS0381
     274.*BTM(I+7)+67.*BTM(I+8)+46.*BTM(I+9)+21.*                       ERTS0382
     3BTM(I+10)+3.*BTM(I+11)-5.*BTM(I+12)-6.*BTM(I+13)-                 ERTS0383
     43.*BTM(I+14))/320.                                                ERTS0384
