       SUB (1)                         I4                               JP INT16
       STO 9,4                                                          JP INT17
       TNZ JUMP2                                                        JP INT18
       STZ 7,4                                                          JP INT19
 JUMP2 CLA 5,4                                                          JP INT20
       FAD 6,4                                                          JP INT21
       STO 5,4                                                          JP INT22
       TRA 12,4                                                         JP INT23
 INTP1 CLA I4                                                           JP INT24
       STD 10,4                                                         JP INT25
   IN1 SXD I4,4                                                         JP INT26
       CLA 1,4                                                          JP INT27
       TSX SETUP,1           SET NEW ADDRESSES                          JP INT28
       LXA N,2                                                          JP INT29
  STZ1 STZ --,2              STZ V+2N,2                                 JP INT30
       TIX STZ1,2,1                                                     JP INT31
       CLA 2,4                                                          JP INT32
       STO 9,4               SET J                                      JP INT33
       ORA MAGNO                                                        JP INT34
       FAD MAGNO             FLOAT 2K                                   JP INT35
       STO COMMON                                                       JP INT36
       CLA 4,4                                                          JP INT37
       FSB 3,4               CALC AND STO DEL                           JP INT38
       FDP COMMON                                                       JP INT39
       STQ 6,4                                                          JP INT40
       STZ 7,4               SET INITIAL RHO                            JP INT41
       CLA 4RO                                                          JP INT42
       STO 8,4               SET INITIAL RHO1                           JP INT43
       CLA 3,4                                                          JP INT44
       STO 5,4               SET INITIAL X                              JP INT45
       TRA 12,4                                                         JP INT46
  INTO SXD INT,1                                                        JP INT47
       SXD INT+1,2                                                      JP INT48
       TRA IN1                                                          JP INT49
   BOT CLA 6,4                                                          JP INT50
       FDP 3.0                                                          JP INT51
       STQ COMMON                                                       JP INT52
       LXA N,2                                                          JP INT53
  TOPX LDQ --,2                                                         JP INT54
       FMP COMMON                                                       JP INT55
 VP2N3 STO --,2                                                         JP INT56
       TIX TOPX,2,1                                                     JP INT57
       CLA 10,4                                                         JP INT58
       TZE BOO                                                          JP INT59
       PDX 0,2               SET ADDRESSES ON LAST                      JP INT60
       CLA 1,2               CALL SEQ.                                  JP INT61
       TSX SETUP,1                                                      JP INT62
       SXD I4,2              SET I4                                     JP INT63
       TRA 11,4                                                         JP INT64
   BOO LXD INT,1             YES                                        JP INT65
       LXD INT+1,2           ALL DONE                                   JP INT66
       TRA 11,4                                                         JP INT67
 SETUP STO COMMON                                                       JP INT68
       LRS 18                                                           JP INT69
       TNZ BBB                                                          JP INT70
       CLA (1)                                                          JP INT71
   BBB STA N                                                            JP INT72
       ADD COMMON                                                       JP INT73
       STA TOPO                                                         JP INT74
       ADD N                                                            JP INT75
       STA VP2N1                                                        JP INT76
       STA VP2N2                                                        JP INT77
       STA VP2N3                                                        JP INT78
       STA TOPX                                                         JP INT79
       STA STZ1                                                         JP INT80
       TRA 1,1                                                          JP INT81
 ROSUM OCT 003000000000                                                 JP INT82
   4RO OCT 001000000000                                                 JP INT83
 MAGNO OCT 233000000000                                                 JP INT84
   3.0 DEC 3.0                                                          JP INT85
   (1) DEC 1                                                            JP INT86
    I4                                                                  JP INT87
     N                                                                  JP INT88
