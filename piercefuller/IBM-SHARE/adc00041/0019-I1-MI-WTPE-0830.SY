       REM SELF-LOADING TAPE WRITING SUBROUTINE FOR FORTRAN II          MIWTP001
       REM FEBRUARY 12, 1959                                            MIWTP002
       ABS                                                              MIWTP003
       REM PROGRAM CARD                                                 MIWTP004
       ORG 0                                                            MIWTP005
       MZE FINIS-START                                                  MIWTP006
       PZE                                                              MIWTP007
       BCD 1(WTPE)                                                      MIWTP008
       PZE ENTRY                                                        MIWTP009
       REM                                                              MIWTP010
       ORG 0                                                            MIWTP011
       REL                                                              MIWTP012
TAPE   EQU 4                                                            MIWTP013
START  CLA STLAP                                                        MIWTP014
       STO BOOTL+STLAP                                                  MIWTP015
       LXA KPAR,1                                                       MIWTP016
LOOP1  CLA BOOTF,1           REQUIRES ONE LARGER PROGRAM BREAK.         MIWTP017
KPAR   STO BOOTF-BOOTL,1                                                MIWTP018
       TIX LOOP1,1,1                                                    MIWTP019
       REW TAPE                                                         MIWTP020
       WTB TAPE                                                         MIWTP021
       CPY 0                                                            MIWTP022
       PXD                                                              MIWTP023
       LXD ENTRY,1                                                      MIWTP024
       CAD 0,1                                                          MIWTP025
       TIX *-1,1,1                                                      MIWTP026
       SLW 0                                                            MIWTP027
       CPY 0                                                            MIWTP028
       REW TAPE                                                         MIWTP029
       STZ 8                                                            MIWTP030
ENTRY  TXI RDCRD,,-1                                                    MIWTP031
       REM                                                              MIWTP032
       REM BOOTLACE PROGRAM TO BE AT ZERO ORIGIN AFTER LDTAPE           MIWTP033
 ORG   EQU *                                                            MIWTP034
BOOTL  LXA 0,1                                                          MIWTP035
NWSUM  EQU *                                                            MIWTP036
       CPY 2,1                                                          MIWTP037
       TXI 1,1,-1                                                       MIWTP038
       HTR                   EOF                                        MIWTP039
       REW TAPE                                                         MIWTP040
       LXD 2,1                                                          MIWTP041
       PXD                                                              MIWTP042
 ACL   EQU *                                                            MIWTP043
       ACL 0,1                                                          MIWTP044
       TIX ACL-ORG,1,1                                                  MIWTP045
       STZ 8                                                            MIWTP046
       SLW NWSUM-ORG                                                    MIWTP047
       CLA 0                                                            MIWTP048
       SUB NWSUM-ORG                                                    MIWTP049
       TZE RDCRD                                                        MIWTP050
       HTR RDCRD                                                        MIWTP051
BOOTF  BSS                                                              MIWTP052
       REM END OF BOOTLACE PROGRAM                                      MIWTP053
STLAP  EQU 3                                                            MIWTP054
RDCRD  EQU 15                                                           MIWTP055
FINIS  SYN *+1               TO RAISE PROGRAM BREAK FOR LOOP1 ADDRESS.  MIWTP056
       REM                                                              MIWTP057
       END START                                                        MIWTP058
