 *     REM EQUATOR - ECLIPTIC ROTATION                                  RWFOBL01
       ENTRY   FOBL                                                     FOBL0002
FOBL   CLA 3,4                                                          FOBL0003
       STA NEXT                                                         FOBL0004
NEXT   CLA *                                                            FOBL0005
       STO COMMON                                                       FOBL0006
       FSB JDC                CURRENT ARGUMENT OF MATRIX.               FOBL0007
       SSP                                                              FOBL0008
       LDQ EPS                TEST NEED TO RECOMPUTE MATRIX.            FOBL0009
       TLQ COMP               YES                                       FOBL0010
MULT   SXD IR4,4                                                        FOBL0011
       CAL 2,4                                                          FOBL0012
       SUB ONE                                                          FOBL0013
       STA EQ10               SET UP Y,Z ADDRESSES.                     FOBL0014
       STA EQ11                                                         FOBL0015
       STA EQ12                                                         FOBL0016
       SUB ONE                                                          FOBL0017
       STA EQ20                                                         FOBL0018
       STA EQ21                                                         FOBL0019
       STA EQ22                                                         FOBL0020
       CLA 1,4                                                          FOBL0021
       STA NEXT1                                                        FOBL0022
NEXT1  CLA *                                                            FOBL0023
       TMI NEXT2+1                                                      FOBL0024
NEXT2  LXA ONE,4                                                        FOBL0025
       LDQ COSE               MATRIX MULTIPLY.                          FOBL0026
EQ10   FMP *                                                            FOBL0027
       STO COMMON                                                       FOBL0028
       LDQ SINE                                                         FOBL0029
EQ20   FMP *                                                            FOBL0030
       TXL EQ2,4,1                                                      FOBL0031
       CHS                                                              FOBL0032
EQ2    FAD COMMON                                                       FOBL0033
       STO COMMON                                                       FOBL0034
       LDQ SINE                                                         FOBL0035
EQ11   FMP *                                                            FOBL0036
       TXL EQ4,4,1                                                      FOBL0037
       CHS                                                              FOBL0038
EQ4    STO COMMON+1                                                     FOBL0039
       LDQ COSE                                                         FOBL0040
EQ21   FMP *                                                            FOBL0041
       FSB COMMON+1                                                     FOBL0042
EQ22   STO *                                                            FOBL0043
       CLA COMMON                                                       FOBL0044
EQ12   STO *                                                            FOBL0045
       LXD IR4,4                                                        FOBL0046
       TRA 4,4                                                          FOBL0047
COMP   CLA COMMON             COMPUTE ROTATION MATRIX.                  FOBL0048
       STO JDC                CURRENT DATE.                             FOBL0049
       FSB JD0                1900, JAN. 0.5                            FOBL0050
       FDP 36525.                                                       FOBL0051
       STQ COMMON             T, IN JULIAN CENTURIES.                   FOBL0052
       LDQ P3                                                           FOBL0053
       FMP COMMON             COMPUTE P(T), CHANGE IN OBLIQUITY.        FOBL0054
       FAD P2                                                           FOBL0055
       STO COMMON+1                                                     FOBL0056
       LDQ COMMON+1                                                     FOBL0057
       FMP COMMON                                                       FOBL0058
       FAD P1                                                           FOBL0059
       STO COMMON+1                                                     FOBL0060
       LDQ COMMON+1                                                     FOBL0061
       FMP COMMON                                                       FOBL0062
       STO COMMON+1           P(T)                                      FOBL0063
       LDQ SIN1               COMPUTE SIN (OBL)                         FOBL0064
       FMP COMMON+1                                                     FOBL0065
       FAD COS                                                          FOBL0066
       STO COMMON                                                       FOBL0067
       LDQ COMMON                                                       FOBL0068
       FMP COMMON+1                                                     FOBL0069
       FAD SIN                                                          FOBL0070
       STO SINE                                                         FOBL0071
       LDQ COS1               COMPUTE COS(OBL)                          FOBL0072
       FMP COMMON+1                                                     FOBL0073
       FSB SIN                                                          FOBL0074
       STO COMMON                                                       FOBL0075
       LDQ COMMON                                                       FOBL0076
       FMP COMMON+1                                                     FOBL0077
       FAD COS                                                          FOBL0078
       STO COSE                                                         FOBL0079
IR4    TXI MULT                                                         FOBL0080
ONE    DEC 1                                                            FOBL0081
JDC    DEC 2415020.0                                                    FOBL0082
JD0    DEC 2415020.0                                                    FOBL0083
EPS    DEC 28.                                                          FOBL0084
COSE   OCT 200725550576       .91739176                                 FOBL0085
SINE   OCT 177627422750       .39798537                                 FOBL0086
36525. DEC 36525.                                                       FOBL0087
P1     DEC -.227111E-3                                                  FOBL0088
P2     DEC -.286E-7                                                     FOBL0089
P3     DEC +.878E-8                                                     FOBL0090
SIN    OCT 177627422750                                                 FOBL0091
SIN1   OCT 576627422750                                                 FOBL0092
COS    OCT 200725550576                                                 FOBL0093
COS1   OCT 577725550576                                                 FOBL0094
COMMON BSS 2                                                            FOBL0095
       END                                                              FOBL009F
