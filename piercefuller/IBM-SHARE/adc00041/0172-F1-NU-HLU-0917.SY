C     WRITE ANSWERS                                                     HLU  256
      SUBROUTINE WRANS                                                  HLU  257
      DIMENSION NN(201),H1(80,80),H2(80,80),QTM(80,80),E(80,80),W(80,1),HLU  258
     XG(80,1)                                                           HLU  259
      COMMON NN,H1,H2,QTM,E,W,G                                         HLU  260
      REWIND 5                                                          HLU  261
      K=2*NN(1)-1                                                       HLU  262
      DO 2 I=1,K,2                                                      HLU  263
      L=NN(I+1)                                                         HLU  264
      M=NN(I+2)                                                         HLU  265
      DO 2 J=1,L                                                        HLU  266
      BACKSPACE 7                                                       HLU  267
      READ TAPE 7,(G(I1,1),I1=1,M)                                      HLU  268
      BACKSPACE 7                                                       HLU  269
 2    WRITE TAPE 5,(G(I1,1),I1=1,M)                                     HLU  270
 6    END FILE 5                                                        HLU  271
      REWIND 5                                                          HLU  272
      RETURN                                                            HLU  273
      END(0,1,0,1,0)                                                    HLU  274
C                  END PROGRAM                                          HLU  275
