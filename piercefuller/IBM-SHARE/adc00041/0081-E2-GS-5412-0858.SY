C     PN 5412 CONTINUED FRACTION CURVE FITTING AND INTERPOLATION        5412 001
C     A. ORICK                                                          5412 002
C     OCT. 1959                                                         5412 003
      DIMENSION B(100),C(100),PYY(100),QYY(100),PVY(100),QVY(100),Y(100)5412 004
     X,VX(100),VY(100),YY(100),VYP(100),X(100),N(1),M(1),BARGE(1),XINPUT5412 005
     1(200),LIST(10),TABLE(30),                                         5412 006
     Y          A(100),F(100),G0(100),G1(100),H(100),ENUMER(100),DENOM(15412 007
     X00),TEMP(100)                                                     5412 008
      COMMON B,C,PYY,QYY,PVY,QVY,Y,VX,VY,YY,VYP,X,N,M,BARGE,XINPUT, LIST5412 009
     1,TABLE,A,F,G0,G1,H,ENUMER,DENOM,TEMP                              5412 010
   10 FORMAT( 73H                                                       5412 011
     1                  / 73H                                           5412 012
     2                              / 73H                               5412 013
     3                                            )                     5412 014
   13 FORMAT(1PE14.5,2I12)                                              5412 015
   15 FORMAT(1P2E14.5)                                                  5412 016
   17 FORMAT(1PE14.5)                                                   5412 017
  300 FORMAT(72H1CONTINUED FRACTIONS CURVE FITTING AND INTERPOLATION   P5412 018
     XN L05412        //)                                               5412 019
  305 FORMAT(23H INPUT DATA AS ENTERED //)                              5412 020
  310 FORMAT(66H                                       CONTINUED FRACTIO5412 021
     XNS RESULTS)                                                       5412 022
 3100 FORMAT(66H                                       DIVIDED DIFFERENC5412 023
     XES RESULTS)                                                       5412 024
  612 FORMAT(107H       B             C            PYY           QYY    5412 025
     X        YY           PVY           QVY            VY)             5412 026
  312 FORMAT(52H       B             VX            VY            VYP)   5412 027
  615 FORMAT(1P4E14.6)                                                  5412 028
  315 FORMAT(1P8E14.6)                                                  5412 029
      CALL INIT(TABLE)                                                  5412 030
    1 CALL INPUT(LIST,N,XINPUT,VX,BARGE,TABLE)                          5412 031
      IF ACCUMULATOR OVERFLOW 11,11                                     5412 032
   11 IF QUOTIENT OVERFLOW 12,12                                        5412 033
   12 IF DIVIDE CHECK 410,410                                           5412 034
  410 N=N                                                               5412 035
      K=1                                                               5412 036
      DO 20 J=1,N,1                                                     5412 037
      X(J)=XINPUT(K)                                                    5412 038
      Y(J)=XINPUT(K+1)                                                  5412 039
   20 K=K+2                                                             5412 040
  400 WRITE OUTPUT TAPE 3,300                                           5412 041
      WRITE OUTPUT TAPE 3,10                                            5412 042
      WRITE OUTPUT TAPE 3,305                                           5412 043
      WRITE OUTPUT TAPE 3,13,(BARGE,N,M)                                5412 044
      WRITE OUTPUT TAPE 3,15,(X(I),Y(I),I=1,N,1)                        5412 045
      WRITE OUTPUT TAPE 3,17,(VX(J),J=1,M,1)                            5412 046
      DO 21 MM=1,100                                                    5412 047
      B  (MM)=0.                                                        5412 048
      C  (MM)=0.                                                        5412 049
      PYY(MM)=0.                                                        5412 050
      QYY(MM)=0.                                                        5412 051
      YY (MM)=0.                                                        5412 052
      PVY(MM)=0.                                                        5412 053
      QVY(MM)=0.                                                        5412 054
      VY (MM)=0.                                                        5412 055
   21 VYP(MM)=0.                                                        5412 056
C     CALCULATION OF COEFFICIENTS FOR CONTINUED FRACTION                5412 057
      CALL EFM                                                          5412 058
  100 B(1)= Y(1)                                                        5412 059
      C(1)= 1.0                                                         5412 060
      DO 150 K=2,N,1                                                    5412 061
      PIP2= 1.0                                                         5412 062
      PIP1= Y(1)-Y(K)                                                   5412 063
      L=K-2                                                             5412 064
      IF (L) 112,113,112                                                5412 065
  112 DO 111 I=1,L,1                                                    5412 066
      P= B(I+1)*PIP1-(X(I)-X(K))*PIP2*C(I)*C(I+1)                       5412 067
      PIP2= PIP1                                                        5412 068
  111 PIP1= P                                                           5412 069
  113 J=K-1                                                             5412 070
      B(K)=(X(J)-X(K))*PIP2*C(J)                                        5412 071
      C(K)= PIP1/(ABSF(PIP1)+ABSF(B(K)))                                5412 072
  150 B(K)= B(K)/(ABSF(PIP1)+ABSF(B(K)))                                5412 073
      CALL PISA( 2)                                                     5412 074
      CALL EFM                                                          5412 075
C     CALCULATION OF YY(K) OF X(K) FROM CONTINUED FRACTION              5412 076
  160 DO 175 K=1,N,1                                                    5412 077
      PIP2=1.0                                                          5412 078
      PIP1=B(N)                                                         5412 079
      L= N-1                                                            5412 080
      DO 171 J=1,L,1                                                    5412 081
      I= N-J                                                            5412 082
      P= B(I)*PIP1+(X(K)-X(I))*C(I)*C(I+1)*PIP2                         5412 083
      PIP2= PIP1                                                        5412 084
  171 PIP1= P                                                           5412 085
      Q= C(1)*PIP2                                                      5412 086
      IF(Q) 172,170,172                                                 5412 087
  170 YY(K)=BARGE                                                       5412 088
      GO TO 174                                                         5412 089
  172 YY(K)= P/Q                                                        5412 090
  174 PYY(K)= P                                                         5412 091
  175 QYY(K)= Q                                                         5412 092
      CALL PISA( 3)                                                     5412 093
      CALL EFM                                                          5412 094
C     CALCULATION OF VY(VX) FROM CONTINUED FRACTION                     5412 095
  190 DO 215 K=1,M,1                                                    5412 096
       PIP2=1.0                                                         5412 097
       PIP1=B(N)                                                        5412 098
      L= N-1                                                            5412 099
      DO 211 J=1,L,1                                                    5412 100
      I= N-J                                                            5412 101
      P=B(I)*PIP1+(VX(K)-X(I))*C(I)*C(I+1)*PIP2                         5412 102
      PIP2= PIP1                                                        5412 103
  211 PIP1= P                                                           5412 104
      Q= C(1)*PIP2                                                      5412 105
      IF(Q) 212,213,212                                                 5412 106
  213 VY(K)= BARGE                                                      5412 107
      GO TO 214                                                         5412 108
  212 VY(K)= P/Q                                                        5412 109
  214 PVY(K)= P                                                         5412 110
  215 QVY(K)= Q                                                         5412 111
      CALL PISA( 4)                                                     5412 112
      CALL EFM                                                          5412 113
C     CONTINUED FRACTION OUTPUT                                         5412 114
      I= XMAX0F(N,M)                                                    5412 115
  620 WRITE OUTPUT TAPE 3,310                                           5412 116
      WRITE OUTPUT TAPE 3,612                                           5412 117
      WRITE OUTPUT TAPE 3,315,(B(J),C(J),PYY(J),QYY(J),YY(J),PVY(J),QVY(5412 118
     XJ),VY(J),J=1,I,1)                                                 5412 119
C     CONT. FRACT. COEFFICIENTS WRAPPED-UP LOGICALLY IN SUBR.           5412 120
      CALL DUMMY1                                                       5412 121
C     CALCULATION OF DIVIDED DIFFERENCE COEFFICIENTS                    5412 122
 1000 B(1)= Y(1)                                                        5412 123
      DO 1012K=2,N,1                                                    5412 124
      S= Y(K)                                                           5412 125
      L= K-1                                                            5412 126
      DO 1010 I=1,L,1                                                   5412 127
 1010 S= (S-B(I))/(X(K)-X(I))                                           5412 128
 1012 B(K)=S                                                            5412 129
      CALL PISA( 5)                                                     5412 130
      CALL EFM                                                          5412 131
C     CALCULATION OF VYP(VX) FROM DIVIDED DIFFERENCES                   5412 132
 1020 DO 1030 K=1,M,1                                                   5412 133
      T= B(N)                                                           5412 134
      L= N-1                                                            5412 135
      DO 1025 J=1,L,1                                                   5412 136
      I= N-J                                                            5412 137
 1025 T= B(I)+(VX(K)-X(I))*T                                            5412 138
 1030 VYP(K)= T                                                         5412 139
      CALL PISA( 6)                                                     5412 140
      CALL EFM                                                          5412 141
C     ANSWER OUTPUT                                                     5412 142
  500 I=XMAX0F(N,M)                                                     5412 143
  520 WRITE OUTPUT TAPE 3,3100                                          5412 144
      WRITE OUTPUT TAPE 3,312                                           5412 145
      WRITE OUTPUT TAPE 3,615,(B(J),VX(J),VY(J),VYP(J), J=1,I,1)        5412 146
      WRITE OUTPUT TAPE 3,5000                                          5412 147
      GO TO 1                                                           5412 148
 5000 FORMAT(4H0END)                                                    5412 149
      END(0,1,0,0,0)                                                    5412 150
C     PROGRAM L05412                                                    5412 151
C     A. ORICK                                                          5412 152
      SUBROUTINE DUMMY1                                                 5412 153
      DIMENSION B(100),C(100),PYY(100),QYY(100),PVY(100),QVY(100),Y(100)5412 154
     X,VX(100),VY(100),YY(100),VYP(100),X(100),N(1),M(1),BARGE(1),XINPUT5412 155
     1(200),LIST(10),TABLE(30),                                         5412 156
     Y          A(100),F(100),G0(100),G1(100),H(100),ENUMER(100),DENOM(15412 157
     X00),TEMP(100)                                                     5412 158
      COMMON B,C,PYY,QYY,PVY,QVY,Y,VX,VY,YY,VYP,X,N,M,BARGE,XINPUT, LIST5412 159
     1,TABLE,A,F,G0,G1,H,ENUMER,DENOM,TEMP                              5412 160
      NPTS=N                                                            5412 161
      LAST=NPTS                                                         5412 162
      CALL PISA( 1)                                                     5412 163
      CALL EFM                                                          5412 164
      DO 5 MM=1,100                                                     5412 165
      ENUMER(MM)=0.                                                     5412 166
      DENOM(MM)=0.                                                      5412 167
      F(MM)=0.                                                          5412 168
      G0(MM)=0.                                                         5412 169
      G1(MM)=0.                                                         5412 170
    5 H(MM)=0.                                                          5412 171
      DO 10 J=1,NPTS                                                    5412 172
      A(J)=B(LAST)/C(LAST)                                              5412 173
      TEMP(J)=X(LAST)                                                   5412 174
   10 LAST = LAST-1                                                     5412 175
      DO 20 J=1,NPTS                                                    5412 176
   20 X(J)=TEMP(J)                                                      5412 177
      I=1                                                               5412 178
      F(1)=A(I)                                                         5412 179
      G0(1)=1.                                                          5412 180
      G1(1)=A(I)                                                        5412 181
      H(1)=-X(I+1)                                                      5412 182
      DENOM(1)=1.                                                       5412 183
      ENUMER(1)=A(I)                                                    5412 184
      H(2)=1.                                                           5412 185
      I=I+1                                                             5412 186
      NPTSD2=NPTS/2                                                     5412 187
      NPTS2=NPTSD2+1                                                    5412 188
      DO 180 K=2,NPTS2                                                  5412 189
      CALL EFM                                                          5412 190
      NUMB=K                                                            5412 191
      DO 30 J=2,K                                                       5412 192
   30 F(J-1)=A(I)*G1(J-1)                                               5412 193
      F(K)=0.                                                           5412 194
      DO 40 J=1,K                                                       5412 195
      G0(J)=F(J)+H(J)                                                   5412 196
   40 DENOM(J)=G0(J)                                                    5412 197
      DO 42 J=2,2                                                       5412 198
   42 H(J-1)=-X(I+1)*G1(J-1)                                            5412 199
      IF(K-3)52,45,45                                                   5412 200
   45 DO 50 J=3,K                                                       5412 201
   50 H(J-1)=-X(I+1)*G1(J-1)+G1(J-2)                                    5412 202
   52 H(K)=G1(K-1)                                                      5412 203
      CALL PISA(10,F,  NUMB)                                            5412 204
      CALL PISA(10,G0, NUMB)                                            5412 205
      CALL PISA(10,G1, NUMB)                                            5412 206
      CALL PISA(10,H , NUMB)                                            5412 207
      CALL EFM                                                          5412 208
      I=I+1                                                             5412 209
      IF(I-(NPTS+1))60,200,60                                           5412 210
   60 DO 65 J=1,K                                                       5412 211
   65 F(J)=A(I)*G0(J)                                                   5412 212
      DO 70 J=1,K                                                       5412 213
      G1(J)=F(J)+H(J)                                                   5412 214
   70 ENUMER(J)=G1(J)                                                   5412 215
      NUMB=K+1                                                          5412 216
      DO 75 J=2,2                                                       5412 217
   75 H(J-1)=-X(I+1)*G0(J-1)                                            5412 218
   80 DO 85 J=3,NUMB                                                    5412 219
   85 H(J-1)=-X(I+1)*G0(J-1)+G0(J-2)                                    5412 220
  100 H(NUMB)=G0(NUMB-1)                                                5412 221
      CALL PISA(20,F,  NUMB)                                            5412 222
      CALL PISA(20,G0, NUMB)                                            5412 223
      CALL PISA(20,G1, NUMB)                                            5412 224
      CALL PISA(20,H , NUMB)                                            5412 225
  180 I=I+1                                                             5412 226
      NUMB=NUMB-1                                                       5412 227
      GO TO 230                                                         5412 228
  200 DO 220 J=1,K                                                      5412 229
      TEMP(J)=DENOM(J)                                                  5412 230
      DENOM(J)=ENUMER(J)                                                5412 231
  220 ENUMER(J)=TEMP(J)                                                 5412 232
  230 WRITE OUTPUT TAPE 3,4000                                          5412 233
      WRITE OUTPUT TAPE 3,3000,(ENUMER(J),DENOM(J),J=1,NUMB)            5412 234
      LAST=NPTS                                                         5412 235
      DO 250 M=1,NPTS                                                   5412 236
      TEMP(M)=X(LAST)                                                   5412 237
  250 LAST=LAST-1                                                       5412 238
      DO 260 M=1,NPTS                                                   5412 239
  260 X(M)=TEMP(M)                                                      5412 240
      RETURN                                                            5412 241
 3000 FORMAT(2E30.8)                                                    5412 242
 4000 FORMAT(60H0       NUMERATOR COEFFICIENTS      DENOMINATOR COEFFICI5412 243
     XENTS)                                                             5412 244
      END(0,1,0,0,0)                                                    5412 245
       REM  L05412    ORICK                                             5412 246
       REM   PISA     OCT. 1959                                         5412 247
       REM SUBROUTINE USED FOR LOGICAL TRACE, ARRAY PRINTOUT OR DCT IND.5412 248
       REM SUBROUTINE INCLUDES FLOATING TRAP FEATURE                    5412 249
       REM MUST BE USED WITH FORTRAN OUTPUT BDC2                        5412 250
       REM                                                              5412 251
       REM                                                              5412 252
       REM                                                              5412 253
       REM ASSEMBLE PROGRAM CARD FOR PISA                               5412 254
       REM PUNCH COL. 1 ROW 9 ON BINARY CARD                            5412 255
       REM CHECK SUM PROGRAM CARD                                       5412 256
       ORG 0                                                            5412 257
       PZE TOPW+6,0,5                                                   5412 258
       PZE 0                                                            5412 259
       BCD 1LFM                                                         5412 260
       OCT 312                                                          5412 261
       BCD 1TOPERR                                                      5412 262
       OCT 452                                                          5412 263
       BCD 1PISA                                                        5412 264
       OCT 31                                                           5412 265
       BCD 1EFM                                                         5412 266
       OCT 252                                                          5412 267
       BCD 1INIT                                                        5412 268
       OCT 5                                                            5412 269
       BCD 1TOP                                                         5412 270
       OCT 451                                                          5412 271
       REM                                                              5412 272
       REM                                                              5412 273
       REM                                                              5412 274
       REM MAIN PROGRAM BEGINS                                          5412 275
       REL                                                              5412 276
       ORG 0                                                            5412 277
       REM CALL INIT(TABLE)   INITIATES PISA WITH THE LOC OF TABLE      5412 278
(SPH)  BCD 1(SPH)                                                       5412 279
(FIL)  BCD 1(FIL)                                                       5412 280
(LEV)  BCD 1(LEV)                                                       5412 281
(BDC)  BCD 1(BDC)                                                       5412 282
(STH)  BCD 1(STH)                                                       5412 283
INIT   STO X1                 S AVE AC                                  5412 284
       STZ P19                I NITIALIZE TRACE COUNTER                 5412 285
       STZ 8                  I NITIALIZE TTR WITH ZERO                 5412 286
       CLA 1,4                I NITIALIZE PISA WITH L(TABLE)            5412 287
       STA P2-1                                                         5412 288
       STA P1+7                                                         5412 289
       STA PISA+9                                                       5412 290
       CLA INIT-2             ( BDC) OCT 2                              5412 291
       ADD INIT1              O CT 130                                  5412 292
       STA EFM14              B DC 132                                  5412 293
       STA EFM17                                                        5412 294
       STA LTM1                                                         5412 295
       ADD INIT2              O CT 27                                   5412 296
       STA EFM15              B DC 161                                  5412 297
       STA EFM16                                                        5412 298
       STA LTM2                                                         5412 299
       CLA X1                 R ESTORE AC                               5412 300
       TRA 2,4                E XIT                                     5412 301
INIT1  OCT 000000000130                                                 5412 302
INIT2  OCT 000000000027                                                 5412 303
       REM CALL PISA SUBROUTINE                                         5412 304
       REM 10 CALL PISA (10)        10 CALL PISA (10,ARRAY,25)          5412 305
       REM STATEMENTS INSERTED IN FORTRAN PROGRAM TO AID CHECKOUT       5412 306
       REM TABLE NEEDED TO CONTROL OUTPUT OF PISA                       5412 307
PISA   STO X1                 S AVE AC                                  5412 308
       STQ X2                 A ND MQ                                   5412 309
       SXD X11,1              A ND IR1                                  5412 310
       SXD X,2                A ND IR2                                  5412 311
       CLA 1,4                                                          5412 312
       STA P1                 L OC(STATEMENT NO.)                       5412 313
       STA P22                                                          5412 314
       LFM                                                              5412 315
       LXA EFM19,2                                                      5412 316
       CLA 0,2                S EARCH TABLE FOR STATEMENT NO.           5412 317
       TMI P10                A DD STATEMENT TO TRACE                   5412 318
       TZE P8                 E ND OF TABLE                             5412 319
       ANA P16                S TATEMENT NO. IN DEC.                    5412 320
P1     SUB 0                  S TATEMENT NO. (CRRRENT)                  5412 321
       TZE *+2                S TATEMENT IS IN TABLE                    5412 322
       TXI PISA+9,2,1         C ONTINUE SEARCH                          5412 323
       LXD P17,1              T EST INDICATORS                          5412 324
       DCT                                                              5412 325
       TXI *+1,1,1            D IVIDE CHECK ON                          5412 326
       SXD P15,1              I NDICATOR WORD                           5412 327
       CLA 0,2                E NTRY IN TABLE                           5412 328
       STD P18                S TATEMENT NO. (CURRENT)                  5412 329
       ANA P17                C OUNTER IN ADDRESS                       5412 330
       TZE P11                C OUNTER=0                                5412 331
       SUB P20                1  IN ADDRESS  REDUCE COUNTER             5412 332
       STA 0,2                                                          5412 333
P2     CAL *                  P RINT STATEMENT NUMBERS                  5412 334
       TTR (LEV)              A ND INDICATORS                           5412 335
       ETM                                                              5412 336
       CAL (BDC)                                                        5412 337
       SLW 1                                                            5412 338
       CAL (STH)                                                        5412 339
       TXI P12,0,3            F ORMAT                                   5412 340
       ETM                                                              5412 341
       TXI P18                S TATEMENT NO.                            5412 342
       TXI P15                I NDICATOR                                5412 343
       LTM                                                              5412 344
       CAL *                                                            5412 345
       TTR (FIL)                                                        5412 346
       CLA 2,4                T EST FOR ARRAY                           5412 347
       ANA EFM21                                                        5412 348
       TNZ P8                 N O ARRAY                                 5412 349
       CLA 2,4                                                          5412 350
       ADD PISA+4             1  IN ADD                                 5412 351
       STA P4                                                           5412 352
       STA P5                                                           5412 353
       CLA 3,4                                                          5412 354
       STA *+1                                                          5412 355
       CLA 0                                                            5412 356
       STD P7                 L ENGTH OF ARRAY                          5412 357
       CAL *                  P RINT ARRAY                              5412 358
       TTR (LEV)                                                        5412 359
       ETM                                                              5412 360
       CAL (BDC)                                                        5412 361
       SLW 1                                                            5412 362
       CAL (STH)                                                        5412 363
       TXI P13,0,3                                                      5412 364
       LXD P6,1               L (1)                                     5412 365
P3     ETM                                                              5412 366
P4     TXI 0,1                L (ARRAY+1) FL. PT. DECIMAL               5412 367
P5     TXI 0,1                L (ARRAY+1) FIX PT. INTEG.                5412 368
       LTM                                                              5412 369
P6     TXI *+1,1,1                                                      5412 370
P7     TXL P3,1,0             S IZE OF ARRAY IN DEC.                    5412 371
       LTM                                                              5412 372
       CAL *                                                            5412 373
       TTR (FIL)                                                        5412 374
P8     LXD P19,1              T EST FOR 20 TRACE ENTRIES                5412 375
       TXL P21,1,19                                                     5412 376
       CAL *                  P RINT TRACE LINE                         5412 377
       TTR (LEV)                                                        5412 378
       ETM                                                              5412 379
       CAL (BDC)                                                        5412 380
       SLW 1                                                            5412 381
       CAL (STH)                                                        5412 382
       TXI P14,0,3            F ORMAT                                   5412 383
       LXD P6,1               L (1)                                     5412 384
P9     ETM                                                              5412 385
       TXI P20,1              T RACE TABLE                              5412 386
       LTM                                                              5412 387
       TXI *+1,1,1                                                      5412 388
       TXL P9,1,20                                                      5412 389
       LTM                                                              5412 390
       CAL *                                                            5412 391
       TTR (FIL)                                                        5412 392
       STZ P19                S ET TRACE COUNTER=0                      5412 393
P21    CLA 8                  T EST FOR NEED TO RE-ENTER TRAPPING       5412 394
       TZE *+2                N OT IN FLOATING TRAP MODE                5412 395
       EFM                                                              5412 396
       LXD X11,1              R ESTORE IR1                              5412 397
       LXD X,2                A ND IR2                                  5412 398
       LDQ X2                 A ND MQ                                   5412 399
       CLA 2,4                T TEST FOR ARRAY                          5412 400
       ANA EFM21                                                        5412 401
       TNZ *+2                N O ARRAY                                 5412 402
       TXI *+1,4,-2           S ET EXIT 4,4                             5412 403
       CLA X1                 A ND AC                                   5412 404
       TRA 2,4                E XIT FROM PISA                           5412 405
P10    LXD P19,1              T RACE COUNTER                            5412 406
       TXI *+1,1,1                                                      5412 407
P22    CLA 0                  L (STATEMENT NO.)                         5412 408
       STD P20,1              T RACE TABLE                              5412 409
       SXD P19,1                                                        5412 410
       TXI PISA+9,2,1         S EARCH TABLE FOR STATEMENT NUMBER        5412 411
P11    TXL P8,1,0             D CT OFF   DONT PRINT                     5412 412
       TRA P2                 P RINT STATEMENT                          5412 413
P12    BCD 1(/18H             S TATEMENT NUMBER FORMAT                  5412 414
       BCD 1STATEM                                                      5412 415
       BCD 1ENT NU                                                      5412 416
       BCD 1MBER I                                                      5412 417
       BCD 17,I7)                                                       5412 418
       OCT -377777777777                                                5412 419
P13    BCD 1(/(4(E            A RRAY FORMAT                             5412 420
       BCD 122.9,I                                                      5412 421
       BCD 17)))                                                        5412 422
       OCT -377777777777                                                5412 423
P14    BCD 1(/20(I            T RACE FORMAT                             5412 424
       BCD 16))                                                         5412 425
       OCT -377777777777                                                5412 426
P15    ZER                    D CT  INDICATOR IN DEC                    5412 427
P16    OCT 077777000000       D EC MASK                                 5412 428
P17    OCT 000000077777       A DD MASK                                 5412 429
P18    ZER                    S TATEMENT NO                             5412 430
P19    ZER                    T RACE COUNTER                            5412 431
       REP 1,20                                                         5412 432
       ORG 169                                                          5412 433
P20    ZER 1,0,0                                                        5412 434
       REM  CALL EFM--INITIALIZE FLOATING TRAP MODE                     5412 435
       REM AN ARGUMENT OF TOP SET FTRAP EXIT TO TOP                     5412 436
       REM WILL ALTER BDC 2                                             5412 437
EFM    STO X1                 S AVE AC                                  5412 438
       SXD X,2                A ND IR 2                                 5412 439
       CLA EFM22                                                        5412 440
       STO 8                  I NITIALIZE WITH TTR                      5412 441
