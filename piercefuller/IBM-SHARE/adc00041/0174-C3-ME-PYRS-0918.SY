C   ME PYRS  18 04270       BINOMIAL COEFFICIENT SUBROUTINE SUBPROGRAM  PYRS0001
C     PETER W. BRANDT, DEPT.D-12, MITRE CORP., LEXINGTON, MASS.         PYRS0002
C     FORTRAN II SUBROUTINE SUBPROGRAM, COMPUTES BINOMIAL COEFFICIENTS  PYRS0003
    1 SUBROUTINE PYRAMD(N,BINOMC)                                       PYRS0004
    2 DIMENSION BINOMC(136)                                             PYRS0005
   20 COMMON L,M                                                        PYRS0006
    3 L=N                                                               PYRS0007
    4 M=L+1                                                             PYRS0008
   40 IF(-M)5,11,11                                                     PYRS0009
    5 DO 6 I=1,M                                                        PYRS0010
    6 BINOMC(I)=1.0                                                     PYRS0011
   60 IF(1-L)7,11,11                                                    PYRS0012
    7 DO 10 K=2,N                                                       PYRS0013
    8 L=L-1                                                             PYRS0014
    9 DO 10 I=1,L                                                       PYRS0015
   10 BINOMC(I+1)=BINOMC(I)+BINOMC(I+1)                                 PYRS0016
   11 RETURN                                                            PYRS0017
      END (0,1,0,0,1)                                                   PYRS0018
