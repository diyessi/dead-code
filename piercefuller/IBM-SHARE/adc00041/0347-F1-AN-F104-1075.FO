CANF104      31 01031                                                   F1040001
C     A GENERAL PROGRAM FOR COMPLEX MATRIX INVERSION                    F1040002
C                                                                       F1040003
      DIMENSION A(20,20), B(20,20), C(20,20), D(20,20)                  F1040004
C                                                                       F1040005
    5 IF (SENSE SWITCH 1) 7,10                                          F1040006
    7 CALL RITAP1(2)                                                    F1040007
   10 READ 1000, N, INPUT                                               F1040008
   20 DO 30 I=1,N                                                       F1040009
   30 READ 2000, (A(I,J),B(I,J), J=1,N)                                 F1040010
   40 CALL CMPINV (A,B,C,D,N,INDEX)                                     F1040011
   50 PRINT 3000                                                        F1040012
   60 IF (INPUT-1) 95, 70, 95                                           F1040013
   70 PRINT 4000                                                        F1040014
   80 DO 90 I=1,N                                                       F1040015
   90 PRINT 5000, (A(I,J),B(I,J), J=1,N)                                F1040016
   95 IF (INDEX-1) 110, 110, 100                                        F1040017
  100 PRINT 7000, INDEX                                                 F1040018
  105 GO TO 10                                                          F1040019
  110 PRINT 6000                                                        F1040020
  115 DO 120 I=1,N                                                      F1040021
  120 PRINT 5000, (C(I,J),D(I,J), J=1,N)                                F1040022
  130 GO TO 10                                                          F1040023
 1000 FORMAT (2I6)                                                      F1040024
 2000 FORMAT (6E12.0)                                                   F1040025
 3000 FORMAT (32H1ANF104 COMPLEX MATRIX INVERSION)                      F1040026
 4000 FORMAT (13H0INPUT MATRIX)                                         F1040027
 5000 FORMAT (1H01P3(E20.7,E16.7))                                      F1040028
 6000 FORMAT (15H0INVERSE MATRIX)                                       F1040029
 7000 FORMAT (38H0PROGRAM CANNOT COMPUTE INVERSE,INDEX=I2)              F1040030
10400 END (0,1,0,0,1)                                                   F1040031
