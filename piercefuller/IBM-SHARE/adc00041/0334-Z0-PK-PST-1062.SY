       REM SUBROUTINE FOR PI-STAR OPERATION,PK PST                    PKPST  001
       REM RUTH E. NORBY,DEPT. 471,IBM RESEARCH                         PST  002
       REM NOVEMBER 18,1960                                             PST  003
       REM                                                              PST  004
       ROB                                                              PST  005
       REL                                                              PST  006
       REM INITIALIZE                                                   PST  007
 PST   SXD PST33,1                                                      PST  008
       SXD PST19,2                                                      PST  009
       SXD PST17,4                                                      PST  010
       STZ TEMP+9                                                       PST  011
       CAL 3,4                                                          PST  012
       STA TEMP+9         ADD. OF FUNCTION INFORMATION LIST             PST  013
       REM TEST FOR NEGATED INPUTS IN THIS INJECTIVE WORD               PST  014
       ARS 18                                                           PST  015
       TNZ INIT1          NEGATED INPUTS                                PST  016
       REM  SET UP WITHOUT NEGATION                                     PST  017
       CLA TEST1                                                        PST  018
       SSM                                                              PST  019
       STO TEST1          SET TO TRA                                    PST  020
       CLA TEST3                                                        PST  021
       SSM                                                              PST  022
       STO TEST3          SET TO TRA                                    PST  023
       TRA INIT2                                                        PST  024
       REM SET UP WITH NEGATION                                         PST  025
 INIT1 CLA TEST1                                                        PST  026
       SSP                                                              PST  027
       STO TEST1          SET TO NOP                                    PST  028
 INIT2 CAL 2,4                                                          PST  029
       REM SET UP LIST TO INDICATE ORDER OF OUTPUTS                     PST  030
       STD INIT5                                                        PST  031
       PDX 0,1                                                          PST  032
       TXL INIT4,1,1                                                    PST  033
       LXD ONE,2                                                        PST  034
       STA *+2                                                          PST  035
       CAL ONE                                                          PST  036
 INIT3 SLW **,2           ADD. OF OUTPUT ORDER LIST                     PST  037
       TNX *+3,1,1                                                      PST  038
       ADD ONE                                                          PST  039
       TXI *-3,2,-1                                                     PST  040
       CAL 2,4                                                          PST  041
       ARS 18             NO. OF OUTPUTS                                PST  042
       ADD 2,4            ADD. OF OUTPUT ORDER LIST                     PST  043
 INIT4 LBT                                                              PST  044
       TRA *+2            IF EVEN                                       PST  045
       ADD ONE                                                          PST  046
       SLW TEMP+7         ADD. OF AVAIL. MEMORY,0,NO. OF FINAL OUTPUTS  PST  047
       STA PST11                                                        PST  048
       STA PST14                                                        PST  049
       STA PST41                                                        PST  050
       STA PST49                                                        PST  051
       ADD ONE                                                          PST  052
       STA PST42                                                        PST  053
       STA PST46                                                        PST  054
       STA PST48                                                        PST  055
       SUB TWO                                                          PST  056
       STA PST21                                                        PST  057
       STA PST28                                                        PST  058
       STA PST52                                                        PST  059
       STA PST55                                                        PST  060
       STA PST57                                                        PST  061
       SUB ONE                                                          PST  062
       STA PST22                                                        PST  063
       STA PST23                                                        PST  064
       STA PST24                                                        PST  065
       STA PST27                                                        PST  066
       STA PST51                                                        PST  067
       STA PST54                                                        PST  068
       STA PST56                                                        PST  069
       REM SET UP MEMORY OVERFLOW POINT                                 PST  070
       ADD TWO                                                          PST  071
       ALS 18                                                           PST  072
       STD PST29          OVERFLOW POINT                                PST  073
       STD PST58                                                        PST  074
       CAL 1,4                                                          PST  075
       STA OUTPT                                                        PST  076
       PDX 0,1            NO. OF INJ. OPERATORS                         PST  077
 INIT5 TIX *+2,1,**                                                     PST  078
       TRA ERR+3          NO. OF INJ. OPER. LESS THAN FINAL OUTPUTS     PST  079
       SXD PST13,1        NO OF INJ. OPER. LESS NO. OF OUTPUTS          PST  080
       CLA TEST2                                                        PST  081
       SSM                                                              PST  082
       STO TEST2          SET TO TRA                                    PST  083
       CLA TEST5                                                        PST  084
       SSP                                                              PST  085
       STO TEST5          SET TO NOP                                    PST  086
       LXD ONE,6                                                        PST  087
       LXD TEMP+7,1       NO. OF FINAL OUTPUTS                          PST  088
       STZ NOCOL,4        COLUMNS USED                                  PST  089
       TXI *+1,4,-1                                                     PST  090
       TIX *-2,1,1                                                      PST  091
       SXD PST37,4                                                      PST  092
       SXD PST31,4                                                      PST  093
       STZ ARRAY                                                        PST  094
       STZ TEMP+2         IR2 FOR ROWS OF PREVIOUS ARRAY                PST  095
       STZ TEMP+3         IR2 AT END OF PREVIOUS ARRAY                  PST  096
       STZ TEMP+4         1,0 WORD CARRY COLUMNS                        PST  097
       STZ TEMP+5         X WORD CARRY COLUMNS                          PST  098
       REM SET UP FINAL OUTPUT ARRAY                                    PST  099
 OUTPT CAL **             FINAL OUTPUT CODING                           PST  100
       SLW TEMP+1         0,1, OR X CODE FOR OUTPUT                     PST  101
       CAL OUTPT          ADD. OF INJ.WD. OUTPUT MASK                   PST  102
       REM PICK UP AN INJECTION OPERATOR                                PST  103
 PST1  ADD ONE                                                          PST  104
       STA PST2           ADD. OF INPUT COLS. MASK                      PST  105
       ADD ONE                                                          PST  106
       STA PST7           ADD. OF FUNCTION CODING                       PST  107
       ADD ONE                                                          PST  108
       LXD ONE,5                                                        PST  109
 TEST1 TXL NONEG          NOP IF NEGATION-TRA OTHERWISE                 PST  110
       REM TEST THIS INJECTION OPERATOR FOR NEGATED INPUTS              PST  111
       STA *+1                                                          PST  112
       CAL **             NEGATED INPUTS MASK                           PST  113
       TZE NEG2                                                         PST  114
       SLW CMASK                                                        PST  115
       REM SET UP NEGATION MASKS                                        PST  116
 NEG1  ACL SMASK                                                        PST  117
       COM                                                              PST  118
       ANA CMASK                                                        PST  119
       SLW NMASK,1                                                      PST  120
       TXI *+1,1,-1                                                     PST  121
       COM                                                              PST  122
       ANS CMASK                                                        PST  123
       CAL CMASK                                                        PST  124
       TNZ NEG1                                                         PST  125
       SXD PST26,1                                                      PST  126
       CLA TEST3                                                        PST  127
       SSP                                                              PST  128
       STO TEST3          SET TO NOP                                    PST  129
       TRA *+4                                                          PST  130
 NEG2  CLA TEST3                                                        PST  131
       SSM                                                              PST  132
       STO TEST3          SET TO TRA                                    PST  133
       CAL PST7                                                         PST  134
       ADD TWO                                                          PST  135
 NONEG STA PST38          ADD. OF NEXT OUTPUT COL. MASK                 PST  136
       CLA TEMP+7                                                       PST  137
       SSP                                                              PST  138
       STO TEMP+7         PLUS SIGN                                     PST  139
 PST2  CAL **              INPUT COLUMNS MASK                           PST  140
       SLW TEMP                                                         PST  141
       SLW TEMP+8         INPUT COLUMNS MASK                            PST  142
       REM GENERATE INPUT COLUMN MASKS                                  PST  143
 PST3  ACL SMASK                                                        PST  144
       COM                                                              PST  145
       ANA TEMP                                                         PST  146
       SLW CMASK,4                                                      PST  147
       TXI *+1,4,-1                                                     PST  148
       COM                                                              PST  149
       ANS TEMP                                                         PST  150
       CAL TEMP                                                         PST  151
       TNZ PST3                                                         PST  152
       SXD PST16,4                                                      PST  153
 PST4  LXD TEMP+9,1                                                     PST  154
 TEST2 TXL PST5           TRA-NOP                                       PST  155
       REM TEST FOR DUPLICATE COLUMNS                                   PST  156
       CAL TEMP+8         INPUT COLUMNS MASK                            PST  157
       ANA NOCOL,1                                                      PST  158
       TZE PST5           NO DUPLICATE COLUMNS                          PST  159
       REM SET UP FOR DUPLICATE COLUMNS                                 PST  160
       SLW DUPL                                                         PST  161
       COM                                                              PST  162
       SLW TEMP+6                                                       PST  163
       CLA TEST4                                                        PST  164
       SSM                                                              PST  165
       STO TEST4          SET TO TRA                                    PST  166
       CLA TEST6                                                        PST  167
       SSM                                                              PST  168
       STO TEST6          NOP TO TRA SUBSUMING                          PST  169
 PST5  CAL TEMP+8         INPUT COLUMNS MASK                            PST  170
       ORS NOCOL,1                                                      PST  171
       REM TEST FOR X,OFF OR ON OUTPUT                                  PST  172
 PST6  CLA ONE                                                          PST  173
       CAS TEMP+1                                                       PST  174
       TRA *+3            IS OFF                                        PST  175
       TRA PST47          IS AN X                                       PST  176
       PXD 0,0            IS ON                                         PST  177
 PST7  ADD **             FUNCTION CODING                               PST  178
       ADD TEMP+9         ADD. OF FUNCTION INFORMATION LIST             PST  179
       STA *+1                                                          PST  180
       CAL **             FUNCTION INFORMATION                          PST  181
       STA PST10          ADD. OF FUNCTION                              PST  182
       COM                                                              PST  183
       ADD DMASK                                                        PST  184
 PST8  STD PST30          2S COMP. OF NO. OF FUNCT. ROWS                PST  185
 PST9  STD PST59                                                        PST  186
       REM PICK UP FUNCTION ROWS                                        PST  187
       LXD ONE,1                                                        PST  188
 PST10 CAL **,1           ROW OF FUNCTION ARRAY                         PST  189
 PST11 STZ **,2           CLEAR MEMORY                                  PST  190
       TZE PST18                                                        PST  191
       LXD ONE,4                                                        PST  192
       REM PUT FUNCTION IN INPUT COLUMNS                                PST  193
 PST12 PBT                                                              PST  194
 PST13 TXI PST15          NO. OF INJ. OPER. IN DEC.                     PST  195
       SLW TEMP+1                                                       PST  196
       CAL CMASK,4                                                      PST  197
 PST14 ORS **,2                                                         PST  198
       CAL TEMP+1                                                       PST  199
 PST15 TXI *+1,4,-1                                                     PST  200
 PST16 TXL PST18,4,**                                                   PST  201
       ALS 1                                                            PST  202
       TZE PST18                                                        PST  203
 PST17 TXI PST12          ENTRY IR IN DECREMENT                         PST  204
 PST18 TXI *+1,1,-1                                                     PST  205
       TXI *+1,2,-1                                                     PST  206
       PXD 0,1                                                          PST  207
       ARS 18                                                           PST  208
       LBT                                                              PST  209
       TRA *+2            IF PREV. ROW WAS THE X WORD                   PST  210
 PST19 TXI PST10          ORIG. 1R2 IN DEC.                             PST  211
 TEST3 TXL TEST4          NOP IF NEGATION-TRA OTHERWISE                 PST  212
       LXD ONE,4                                                        PST  213
 PST20 CAL NMASK,4                                                      PST  214
 PST21 ANA **,2           X WORD                                        PST  215
       TNZ PST25          IS AN X- NO NEGATION NEEDED                   PST  216
       CAL NMASK,4                                                      PST  217
 PST22 ANA **,2           1,0 WORD                                      PST  218
       TZE *+4                                                          PST  219
       COM                                                              PST  220
 PST23 ANS **,2           1,0 WORD                                      PST  221
       TRA *+3                                                          PST  222
       CAL NMASK,4                                                      PST  223
 PST24 ORS **,2           1,0 WORD                                      PST  224
 PST25 TXI *+1,4,-1                                                     PST  225
 PST26 TXH PST20,4,**                                                   PST  226
 TEST4 TXH TEST7          NOP-TRA TO TEST FOR INTERSECTION OFDUPL COLS. PST  227
       CAL TEMP+4         1,0 WORD CARRY COLUMNS                        PST  228
 PST27 ORS **,2                                                         PST  229
       CAL TEMP+5         X WORD CARRY COLUMNS                          PST  230
 PST28 ORS **,2                                                         PST  231
       REM TEST IF END OF MEMORY                                        PST  232
 PST29 TXL SAVE1,2,**     OVERFLOW TEST                                 PST  233
       REM TEST IF MORE ROWS OF FUNCTION                                PST  234
 PST30 TXH PST10,1,**                                                   PST  235
 TEST5 TXH PST34          NOP-TRA                                       PST  236
       REM TEST IF MORE OUTPUTS                                         PST  237
       PXD 0,2                                                          PST  238
       LXD TEMP+9,1                                                     PST  239
       STD ARRAY,1        IR2 FOR END OF ARRAY                          PST  240
       TXI *+1,1,-1                                                     PST  241
 PST31 TXL PST32,1,**                                                   PST  242
       SXD TEMP+9,1                                                     PST  243
       ARS 18                                                           PST  244
       STA ARRAY,1                                                      PST  245
       CAL PST38                                                        PST  246
       STA OUTPT                                                        PST  247
       TRA OUTPT                                                        PST  248
 PST32 CLA TEST5                                                        PST  249
       SSM                                                              PST  250
       STO TEST5          SET TO TRA-NO MORE FINAL OUTPUTS              PST  251
       CLA TEST2                                                        PST  252
       SSP                                                              PST  253
       STO TEST2          SET TO NOP                                    PST  254
       STD TEMP+9                                                       PST  255
       STZ TEMP                                                         PST  256
 PST33 TXI PST38          ORIGINAL IR1 IN DECREMENT                     PST  257
       REM TEST IF END OF ARRAY                                         PST  258
 PST34 LDQ TEMP+3                                                       PST  259
       CLA TEMP+2                                                       PST  260
       TLQ PST50          NOT END OF ARRAY                              PST  261
 TEST6 TXH S1             NOP-TRA TO SUBSUME IF DUPL. COLUMNS           PST  262
 PST35 LXD TEMP+9,1                                                     PST  263
       PXD 0,2                                                          PST  264
       STD ARRAY,1                                                      PST  265
       STZ TEMP           PLUS SIGN                                     PST  266
       REM TEST IF THIS INJ. OPERATOR HAS BEEN CHECKED WITH ALL ARRAYS  PST  267
 PST36 TXI *+1,1,-1                                                     PST  268
 PST37 TXL *+2,1,**                                                     PST  269
       TRA PST39                                                        PST  270
       LXD ONE,1                                                        PST  271
       SXD TEMP+9,1                                                     PST  272
       REM TEST IF MORE INJECTION OPERATORS                             PST  273
       LXD PST13,4                                                      PST  274
       TIX *+2,4,1                                                      PST  275
       TRA PST60          NO MORE INJ. OPERATORS                        PST  276
       SXD PST13,4                                                      PST  277
       REM SET UP NEXT INJECTION OPERATOR                               PST  278
 PST38 CAL **             OUTPUT COL. MASK                              PST  279
       SLW RMASK                                                        PST  280
       CLS TEMP+7                                                       PST  281
       TMI *+2                                                          PST  282
       TRA ERR            ERROR-NO ARRAY WITH THIS OUTPUT               PST  283
       STO TEMP+7         MINUS SIGN                                    PST  284
       LXD TEMP+9,1                                                     PST  285
 PST39 CAL RMASK                                                        PST  286
       ANA NOCOL,1                                                      PST  287
       TNZ *+2                                                          PST  288
       TRA PST36                                                        PST  289
       COM                                                              PST  290
       ANS NOCOL,1        MASKS OUT OUTPUT                              PST  291
       SXD TEMP+9,1                                                     PST  292
       CAL ARRAY,1                                                      PST  293
       STD TEMP+3                                                       PST  294
       ALS 18                                                           PST  295
       STD TEMP+2                                                       PST  296
       PXD 0,2                                                          PST  297
       ARS 18                                                           PST  298
       STA ARRAY,1                                                      PST  299
 PST40 LXD TEMP+2,1                                                     PST  300
       REM TEST IF OFF OUTPUT                                           PST  301
 PST41 CAL **,1           1,0 WORD                                      PST  302
       SLW TEMP+4                                                       PST  303
       ANA RMASK                                                        PST  304
       TZE PST45          IS OFF                                        PST  305
       COM                                                              PST  306
       ANS TEMP+4         MASK OUT OUTPUT COL. BIT                      PST  307
       REM TEST IF ON OR X OUTPUT                                       PST  308
 PST42 CAL **,1           X WORD                                        PST  309
       SLW TEMP+5                                                       PST  310
       ANA RMASK                                                        PST  311
       TZE PST44          IS ON                                         PST  312
       COM                                                              PST  313
       ANS TEMP+5                                                       PST  314
       REM SET UP FOR X OUTPUT                                          PST  315
       CAL ONE                                                          PST  316
       SLW TEMP+1                                                       PST  317
 PST43 TXI *+1,1,-2                                                     PST  318
       SXD TEMP+2,1                                                     PST  319
       CLA TEMP                                                         PST  320
       TMI PST6           CONTINUE ARRAY                                PST  321
       CLA TEMP+7                                                       PST  322
       TPL PST4                                                         PST  323
       CAL PST38                                                        PST  324
       TRA PST1           NEW ARRAY                                     PST  325
       REM SET UP FOR ON OUTPUT                                         PST  326
 PST44 CAL TWO                                                          PST  327
       SLW TEMP+1                                                       PST  328
       TRA PST43                                                        PST  329
       REM SET UP FOR OFF OUTPUT                                        PST  330
 PST45 STZ TEMP+1         IS OFF                                        PST  331
 PST46 CAL **,1           XWORD                                         PST  332
       SLW TEMP+5                                                       PST  333
       TRA PST43                                                        PST  334
       REM PUT XS IN INPUT COLUMNS                                      PST  335
 PST47 CAL TEMP+8         INPUT COLUMN MASK                             PST  336
 PST48 SLW **,2           X WORD                                        PST  337
 PST49 SLW **,2           1,0 WORD                                      PST  338
       LXD ONE,1                                                        PST  339
       SXD PST30,1                                                      PST  340
       TXI TEST4,2,-2                                                   PST  341
       REM SET UP TO CONTINUE ARRAY                                     PST  342
 PST50 CAL SMASK                                                        PST  343
       SLW TEMP                                                         PST  344
       TRA PST40                                                        PST  345
       REM TEST FOR INTERSECTION OF DUPL. COLS.                         PST  346
 TEST7 TXH PST51          NOP-TRA                                       PST  347
       LXA TWO,4                                                        PST  348
       CAL TEMP+6,4                                                     PST  349
       ANA DUPL                                                         PST  350
       SLW LOW,4                                                        PST  351
       TIX *-3,4,1                                                      PST  352
       CLA TEST7                                                        PST  353
       SSM                                                              PST  354
       STO TEST7          SET TO TRA                                    PST  355
 PST51 CAL **,2           1,0 WORD                                      PST  356
       ANA DUPL                                                         PST  357
       SLW LOW                                                          PST  358
 PST52 CAL **,2           X WORD                                        PST  359
       ANA DUPL                                                         PST  360
       SLW LOX                                                          PST  361
       ORA UP                                                           PST  362
       SLW TEMP                                                         PST  363
       CAL UPX                                                          PST  364
       ORA LOW                                                          PST  365
       SLW TEMP+1                                                       PST  366
       CLA TEMP                                                         PST  367
       CAS TEMP+1                                                       PST  368
       TRA *+2                                                          PST  369
       TRA PST53          TO FORM INTERSECTION                          PST  370
       TXI PST59,2,2      THROW OUT NONSENSE ROWS                       PST  371
       REM FORM INTERSECTION                                            PST  372
 PST53 CAL TEMP+6                                                       PST  373
       ANS TEMP+4                                                       PST  374
       ANS TEMP+5                                                       PST  375
 PST54 ANS **,2                                                         PST  376
 PST55 ANS **,2                                                         PST  377
       CAL UP                                                           PST  378
       ANA LOW                                                          PST  379
       ORS TEMP+4         REPLACES WITH INTERSECTION                    PST  380
       CAL UPX                                                          PST  381
       ANA LOX                                                          PST  382
       ORS TEMP+5         REPLACES WITH INTERSECTION                    PST  383
       CAL TEMP+4         1,0 WORD CARRY COLUMNS                        PST  384
 PST56 ORS **,2                                                         PST  385
       CAL TEMP+5         X WORD CARRY COLUMNS                          PST  386
 PST57 ORS **,2                                                         PST  387
       REM TEST IF END OF MEMORY                                        PST  388
 PST58 TXL SAVE2,2,**     OVERFLOW TEST                                 PST  389
       REM TEST IF MORE ROWS OF FUNCTION                                PST  390
 PST59 TXH PST10,1,**                                                   PST  391
       CLA TEST7                                                        PST  392
       SSP                                                              PST  393
       STO TEST7          SET TO NOP                                    PST  394
       TRA PST34                                                        PST  395
       REM SORT AND COMPRESS ROUTINE                                    PST  396
       REM SET UP RETURN TO CORRECT LOCATION                            PST  397
 SAVE1 CAL PST8           ADD. OF PST30                                 PST  398
       TRA *+2                                                          PST  399
 SAVE2 CAL PST9           ADD. OF PST59                                 PST  400
 SAVE3 STA RETUR                                                        PST  401
       STZ TEMP                                                         PST  402
       STZ TEMP+1                                                       PST  403
       CAL PST37                                                        PST  404
       STA TEMP                                                         PST  405
       CAL SAVE3                                                        PST  406
       ADD ONE                                                          PST  407
       STA TEMP+1                                                       PST  408
       CLA TEMP                                                         PST  409
       SUB TEMP+1                                                       PST  410
       TNZ *+9                                                          PST  411
       CLA TEMP+2                                                       PST  412
       SUB TEMP+3                                                       PST  413
       TZE *+2             IS END OF ARRAY                              PST  414
       TRA ERR+2          ERROR-INSUFFICIENT CORE STORAGE               PST  415
       CAL TEMP+7                                                       PST  416
       STA *+1                                                          PST  417
       CAL **                                                           PST  418
       STA PST37                                                        PST  419
       SXD TEMP,1                                                       PST  420
       LXD TEMP+9,1                                                     PST  421
       PXD 0,2                                                          PST  422
       STD ARRAY,1        OVERFLOW PT.                                  PST  423
       CAL PST41                                                        PST  424
       STA WRAP7                                                        PST  425
       STA WRAP8                                                        PST  426
       CAL PST42                                                        PST  427
       STA WRAP9                                                        PST  428
       STA WRAP10                                                       PST  429
       CAL PST31                                                        PST  430
       STD WRAP12         2S COM. OF NO. OF ARRAYS                      PST  431
       CLA TEST8                                                        PST  432
       SSP                                                              PST  433
       STO TEST8          SET TO NOP                                    PST  434
       CLA TEMP+2                                                       PST  435
       SUB TEMP+3                                                       PST  436
       TZE SAVE4                                                        PST  437
       CAL TEMP+3                                                       PST  438
       SLW TEMP+1                                                       PST  439
       CAL TEMP+2                                                       PST  440
       ARS 18                                                           PST  441
       STA TEMP+1                                                       PST  442
 SAVE5 LXD INIT5,1                                                      PST  443
       TNX WRAP1,1,1      SINGLE OUTPUT                                 PST  444
       SXD LOX,1          NO OF GROUPS TO TEST                          PST  445
       CAL INIT3          ADD. OF OUTPUT LIST                           PST  446
       STA SORT4                                                        PST  447
       STA SORT5                                                        PST  448
       ADD ONE                                                          PST  449
       STA SORT3                                                        PST  450
       STA SORT6                                                        PST  451
 SORT1 LXD ONE,6                                                        PST  452
       LXD LOX,1                                                        PST  453
 SORT2 CLA ARRAY,2                                                      PST  454
       LDQ ARRAY+1,2                                                    PST  455
       TLQ SORT7          CONTINUE                                      PST  456
       STQ ARRAY,2        REORDER                                       PST  457
       STO ARRAY+1,2                                                    PST  458
       LDQ NOCOL+1,2                                                    PST  459
       CLA NOCOL,2                                                      PST  460
       STQ NOCOL,2                                                      PST  461
       STO NOCOL+1,2                                                    PST  462
 SORT3 LDQ **,2           OUTPUT LIST+1 ADDRESS                         PST  463
 SORT4 CLA **,2           OUTPUT LIST ADDRESS                           PST  464
 SORT5 STQ **,2           OUTPUT LIST ADDRESS                           PST  465
 SORT6 STO **,2           OUTPUT LIST+1 ADDRESS                         PST  466
       TXI *+1,4,1        REORDERING TOOK PLACE                         PST  467
 SORT7 TXI *+1,2,-1                                                     PST  468
       TIX SORT2,1,1                                                    PST  469
       TXH SORT1,4,0                                                    PST  470
 WRAP1 LXD ONE,3                                                        PST  471
       TXI *+1,2,-2                                                     PST  472
 WRAP2 LDQ TEMP+1                                                       PST  473
       CLA ARRAY,1                                                      PST  474
       TLQ WRAP6                                                        PST  475
 WRAP3 CLA TEST8                                                        PST  476
       SSM                                                              PST  477
       STO TEST8          SET TO TRA                                    PST  478
       CAL TEMP+1                                                       PST  479
       SXD TEMP+2,2                                                     PST  480
       PAX 0,4                                                          PST  481
       STD WRAP11                                                       PST  482
       TRA WRAP7                                                        PST  483
 WRAP4 SXD TEMP+3,2                                                     PST  484
       STZ TEMP+1                                                       PST  485
       CLA TEST8                                                        PST  486
       SSP                                                              PST  487
       STO TEST8          SET TO NOP                                    PST  488
 WRAP5 TXH WRAP12,1,0                                                   PST  489
       TRA WRAP2                                                        PST  490
