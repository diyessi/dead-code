*  SPELLMANN,S 7090 VERSION OF UA CSB 1                                 CSB10001
*     CARDS ROW                                                         CSB10002
*      FAP                                                              CSB10003
       COUNT 90                                                         CSB10004
       ABS                                                              CSB10005
*      REM SPECIAL ABSOLUTE ROW BINARY LOADER FOR REF. SIM., RAS CSB 1. CSB10006
       FUL                                                              CSB10007
       ORG     3                                                        CSB10008
       IOCD    6,0,END-6          CELL 0                                CSB10009
       TCOA    1                       1                                CSB10010
       TTR     A                       2                                CSB10011
 C1    IOCT    A,0,1                                                    CSB10012
       STZ     KKLOC         RESET THE KICKER.                          CSB10013
       TRA     BACK                                                     CSB10014
     D PZE 0                 IOCD FOR BINARY***CORRECTION CARD CONTENT. CSB10015
       PZE 0                 9L (FOR CKSUM AND TRANSFER).               CSB10016
       PZE     0             NEXT SEQUENTIAL ADDRESS.                   CSB10017
 KKLOC PZE     **,0,0        CARD KICKER                                CSB10018
 C2    OCT     37077777                                                 CSB10019
    C3 IOST    D,0,1                                                    CSB10020
 A     LTM                   WILL HOLD BINARY CARD CHECK SUM            CSB10021
 BACK  RCDA                                                             CSB10022
       RCHA    C1            IOCT A,0,1                                 CSB10023
       LCHA    C1                                                       CSB10024
       CAL     A             9 LEFT                                     CSB10025
       SLW     D+1           FOR CHECK SUMMING.                         CSB10026
       PAI                                                              CSB10027
       LFT     200000        IS THIS A RELOCATABLE CARD ''              CSB10028
       HTR     *             YES '' STOP DEAD *********                 CSB10029
       ANA     C2            000037077777                               CSB10030
       ADM     KKLOC                                                    CSB10031
 A1    STO     D             IOCD FOR CARD.                             CSB10032
       ARS     15            TEST WORD COUNT.                           CSB10033
       TZE     A3            CORRECTION/TRANSFER OUT.                   CSB10034
       LCHA    D                                                        CSB10035
       CAL     A                                                        CSB10036
       TZE     BACK          IF BLANK, THE CHECKSUM TO BE IGNORED.      CSB10037
       LFT     100000        TEST FOR BIT IN COLUMN 3.                  CSB10038
       TRA     BACK          CHECKSUM TO BE IGNORED.                    CSB10039
       LXD     D,1           DETERMINE CHECK SUM.                       CSB10040
       PXA     0,1                                                      CSB10041
       ADM     D                                                        CSB10042
       STA     A2                                                       CSB10043
 I1    PXD     1,0           CLEAR AC.                                  CSB10044
       ACL     D+1           9 LEFT                                     CSB10045
       TCOA    *                                                        CSB10046
 A2    ACL     **,1          + REST OF CARD (EXCEPT 9 R)                CSB10047
       TIX     *-1,1,1                                                  CSB10048
       LAS     A             COMPARE WITH CHECK SUM.                    CSB10049
       HPR     32767         STOP '' CHECK SUM FAILURE*********         CSB10050
       TRA     BACK          CHECK SUM OK.                              CSB10051
       TRA     *-2                                                      CSB10052
 A3    AXT     11,2                                                     CSB10053
   A3A LCHA    C3            IOST D,0,1                                 CSB10054
 A3B   LCHA    C3                                                       CSB10055
       CLA     D                                                        CSB10056
       TZE     A6A           NO CORRECTIONS THIS ROW ' GO TO NEXT ROW.  CSB10057
       SSP                                                              CSB10058
       PAI                                                              CSB10059
       RFT     100000        TEST WHETHER ADDRESS IS NEXT ONE.          CSB10060
       CAL     D+2           SEQUENTIAL ADDRESS.                        CSB10061
       RNT     100000        DON,T ADD KICKER AGAIN ON                  CSB10062
       ADM     KKLOC         SEQUENTIAL CORRECTION.                     CSB10063
 A4    STA     A5                                                       CSB10064
       ADM     I1                                                       CSB10065
       STA     D+2           NEXT SEQUENTIAL ADDRESS.                   CSB10066
       LCHA    C3                                                       CSB10067
       CLA     D                                                        CSB10068
       LFT     100000        TEST WHETHER TO IGNORE.                    CSB10069
       TRA     A6            IGNORE THIS CORRECTION.                    CSB10070
 A5    STO     **                                                       CSB10071
 A6    TIX     A3B,2,1       BACK FOR MORE CORRECTIONS.                 CSB10072
 A6A   TIX     A3A,2,1                                                  CSB10073
       LXA     D+1,2         EXIT.....                                  CSB10074
       TXL     BACK,2,0      NO TRANFER ADDRESS (MUST BE NON ZERO)      CSB10075
       TRA*    D+1                                                      CSB10076
 END   BES     0                                                        CSB10077
       END     0                                                        CSB10078
