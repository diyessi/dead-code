C     AVCO RESEARCH AND ADVANCED DEVELOPEMENT DIVISION                  PLN1  01
C     SUBROUTINE  AR PLN1                                               PLN1  02
      SUBROUTINE POLYN(ND,NP,NC,X,Y,NAPT,A,V,SUM)                       PLN1  03
C     COMPUTES COEFFICIENTS OF NTH DEGREE POLYNOMIAL BY LEAST SQUARES   PLN1  04
C    1METHOD---  MINIMIZING SUM OF SQUARES OF DEVIATIONS FROM AVERAGE.  PLN1  05
C    2  ND  =  DEGREE OF POLYNOMIAL I.E. HIGHEST EXPONENT OF INDEPENDENTPLN1  06
C    3         VARIABLE                                                 PLN1  07
C    4  NP  =  NUMBER OF POINTS TO BE FITTED                            PLN1  08
C    5  NC  =  NUMBER OF CURVES TO BE FITTED   (1 OR MORE)              PLN1  09
C    6  X   =  LOCATION OF SET OF X POINTS I.E.  X11                    PLN1  10
C    7  Y   =  LOCATION OF SET OF Y POINTS I.E.  Y1    (CURVE 1 ALSO)   PLN1  11
C    8  NAPT=  DISTANCE APART OF SETS OF OBSERVATIONS TO BE FITTED TO X PLN1  12
      DIMENSION  X(2),Y(2),A(2),V(2),SUM(2)                             PLN1  13
    1 LS=2*ND+1                                                         PLN1  14
      LB=ND+2                                                           PLN1  15
      LV=ND+1                                                           PLN1  16
    2 DO 4   J=2,LS                                                     PLN1  17
    4 SUM(J)=0.0                                                        PLN1  18
      SUM(1)=NP                                                         PLN1  19
    6 DO 12 K=1,NC                                                      PLN1  20
         MNO=(K-1)*LV                                                   PLN1  21
         DO 12  J=1,LV                                                  PLN1  22
         JJ=J+MNO                                                       PLN1  23
   12    V(JJ) = 0.0                                                    PLN1  24
   13 DO 30  I=1,NP                                                     PLN1  25
         P=1.0                                                          PLN1  26
         DO  14 K=1,NC                                                  PLN1  27
         MNO=(K-1)*LV+1                                                 PLN1  28
         MMNO=(K-1)*NAPT+I                                              PLN1  29
   14    V(MNO)=V(MNO)+Y(MMNO)                                          PLN1  30
              DO 20 J=2,LV                                              PLN1  31
              P=X(I)*P                                                  PLN1  32
              SUM(J)=SUM(J)+P                                           PLN1  33
                   DO 20 K=1,NC                                         PLN1  34
                   MNO=(K-1)*LV+J                                       PLN1  35
                   MMNO=(K-1)*NAPT+I                                    PLN1  36
   20              V(MNO)=V(MNO)+Y(MMNO)*P                              PLN1  37
   22    DO  30  J=LB,LS                                                PLN1  38
         P=X(I)*P                                                       PLN1  39
   30    SUM(J)=SUM(J)   + P                                            PLN1  40
   40 DO  48  NM=1,NC                                                   PLN1  41
   41    DO  45 K=1,LV                                                  PLN1  42
   42    DO  45 I=1,LV                                                  PLN1  43
   43    J=I+K                                                          PLN1  44
   44    MNO=(K-1)*LV+I                                                 PLN1  45
   45    A(MNO)=SUM(J-1)                                                PLN1  46
   46    MMNO=(NM-1)*LV+1                                               PLN1  47
   47    CALL ENXEN (A,V(MMNO),LV)                                      PLN1  48
   48 CONTINUE                                                          PLN1  49
   49 RETURN                                                            PLN1  50
      END (0,1,0,1,0)                                                   PLN1  51
