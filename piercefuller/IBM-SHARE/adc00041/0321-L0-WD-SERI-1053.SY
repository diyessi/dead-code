*SUBROUTINE TO GET TAPE NUMBER. ENTER WITH                              SERI0587
*FIRST DIGIT IN AC AND SECOND IN MQ                                     SERI0588
*                                                                       SERI0589
GETTAP CAS     =O60          TREAT BLANK AS ZERO                        SERI0590
       TRA     BADCC                                                    SERI0591
       CLM                                                              SERI0592
       CAS     =10                                                      SERI0593
       TRA     BADCC                                                    SERI0594
       TRA     BADCC                                                    SERI0595
       XCL                                                              SERI0596
       ARS     30            LOOK AT SECOND CHARACTER FIRST             SERI0597
       CAS     =O60                                                     SERI0598
       TRA     BADCC                                                    SERI0599
       TRA     GTAPLV                                                   SERI0600
       CAS     =10                                                      SERI0601
       TRA     BADCC                                                    SERI0602
       TRA     BADCC                                                    SERI0603
       STO     TEMP                                                     SERI0604
       VLM     =10,,4        FIRST TIMES 10 PLUS SECOND                 SERI0605
       LLS     4                                                        SERI0606
       ADD     TEMP                                                     SERI0607
       TRA     1,4                                                      SERI0608
GTAPLV XCA                                                              SERI0609
       TRA     1,4                                                      SERI0610
*                                                                       SERI0611
PUBNEW SXA     PUBNWX,4      PUBLISH CONTROL CARD                       SERI0612
       CLA     STMOUT                                                   SERI0613
       STA     *+2                                                      SERI0614
       CALL    WRITE,*-*,PRENEW,15                                      SERI0615
PUBNWX AXT     *-*,4                                                    SERI0616
       TRA     1,4                                                      SERI0617
*                                                                       SERI0618
PUBOLD SXA     PUBOLX,4      PUBLISH DELETED CARD                       SERI0619
       CLA     STMOUT        ...WITH COMMENT                            SERI0620
       STA     *+2                                                      SERI0621
       CALL    WRITE,*-*,PREOLD,17                                      SERI0622
PUBOLX AXT     *-*,4                                                    SERI0623
       TRA     1,4                                                      SERI0624
*                                                                       SERI0625
INFTY  VFD     36/-1         INFINITY--A CONSTANT                       SERI0626
OLDMT                        OLD-BUFFER-IS-EMPTY FLAG                   SERI0627
DELESW                       DELETE SWITCH                              SERI0628
DELTHS                       DELETE-THRU SWITCH                         SERI0629
FCDSW                        FIRST-CARD-OF-FILE SWITCH                  SERI0630
PRENEW BCI     1,0           DOUBLE-SPACE THE PRINTER                   SERI0631
NEW    BSS     14            'NEW' BUFFER                               SERI0632
POSTNW BCI     5,            SPACE FOR COMMENTS                         SERI0633
PREOLD BCI     1,            SINGLE-SPACE THE PRINTER                   SERI0634
OLD    BSS     14            'OLD' BUFFER                               SERI0635
POSTOL BCI     2,DELETED     COMMENT                                    SERI0636
PACKED BSS     12            'PACKED' BUFFER                            SERI0637
SERNEW BSS     2             CONVERTED 73-80 OF 'NEW'                   SERI0638
SEROLD BSS     2             CONVERTED 73-80 OF 'OLD'                   SERI0639
TEMP   BSS     1                                                        SERI0640
SERSW  COMMON  1             SERIALIZATION SWITCH                       SERI0641
       COMMON  1             NEW SERIAL NUMBER                          SERI0642
NEWSER COMMON  1             ...(TWO WORDS)                             SERI0643
       END                                                              SERI0644
