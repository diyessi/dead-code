       REM SUBROUTINE TO NORMALIZE TAPE NUMBERS.                        RRP20133
 NTN   TNZ A101                                                         RRP20134
 A102  ADD I10                                                          RRP20135
       TRA 1,4                                                          RRP20136
 A101  TMI 1,4                                                          RRP20137
       SUB I10                                                          RRP20138
       TZE A102                                                         RRP20139
       TMI A102                                                         RRP20140
       CLS I10                                                          RRP20141
       TRA 1,4                                                          RRP20142
       REM SUBROUTINE TO READ ONE CARD OR ONE TAPE RECORD.              RRP20143
 READ  CLA ITN               IF ITN IS NEGATIVE GO TO A201.             RRP20144
       TMI A201                                                         RRP20145
       ADD I128              READ 12 WORDS OF TAPE RECORD.              RRP20146
       STA A202                                                         RRP20147
 A202  WRS XXX                                                          RRP20148
       LXA I12,1                                                        RRP20149
 A206  CPY INP+12,1                                                     RRP20150
       TRA A203                                                         RRP20151
       TRA A23               .....END OF FILE.                          RRP20152
 A205  HTR A205              .....END OF RECORD.                        RRP20153
 A203  TIX A206,1,1                                                     RRP20154
       LXA I12,1             DELAY FOR 600 MICROSECONDS.                RRP20155
 A208  NOP                                                              RRP20156
       TIX A208,1,1                                                     RRP20157
       TRA 1,4               RETURN TO CALLING SEQUENCE.                RRP20158
 A201  SXD ER,4              SAVE REGISTER C.                           RRP20159
