       REM CONSTANTS                                                    RRP20216
 I1    PZE 1                                                            RRP20217
 I3    PZE 3                                                            RRP20218
 I6    PZE 6                                                            RRP20219
 I10   PZE 10                                                           RRP20220
 I12   PZE 12                                                           RRP20221
 I128  PZE 128                                                          RRP20222
 CH377 OCT 377000000000                                                 RRP20223
 K1    PZE B1-7                                                         RRP20224
 BLANK BCD 1                                                            RRP20225
 B1    BCD 7OVERFLOW IN NORMALIZING POLYNOMIAL                          RRP20226
