       TXL *+3,,47*5                                                    CLK10023
       ADD *+15,2                                                       CLK10024
       TIX *-7,1,16                                                     CLK10025
       TXI *+13,4,1          ERROR RETURN                               CLK10026
       TNX *+12,2,1                                                     CLK10027
       TRA *+5,2                                                        CLK10028
       TXI *-10,1,9*16                                                  CLK10029
       TXI *-11,1,5*16                                                  CLK10030
       TXI *-12,1,9*16                                                  CLK10031
       TXI *-13,1,5*16                                                  CLK10032
       BCD 600 000100000010000000100000010000001                        CLK10033
       LXD COMMON+1,1                                                   CLK10034
       LXD COMMON+2,2                                                   CLK10035
       TRA 2,4                                                          CLK10036
