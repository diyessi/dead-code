ORCLK1 REM 0036 12289                                                   CLK10001
       REM READ CHRONO-LOG CLOCK ROUTINE.  ERROR RETURN IF CLOCK FAILS  CLK10002
       REM BCD TIME (W/BLANK BETWEEN HRS-MIN) IN AC. FOR USE WITH CHRONOCLK10003
       REM -LOG CLOCK MODEL 2704-1 WIRED TO 716 PRINT ECHO ENTRIES.     CLK10004
       REM DO NOT USE CARD READER UNTIL PRINTER COMPLETES ITS CYCLE.    CLK10005
 CLOCK RPR                                                              CLK10006
       SPR 6                 SENSE THE CLOCK                            CLK10007
       STZ COMMON                                                       CLK10008
       SXD COMMON+2,2                                                   CLK10009
       SXD COMMON+1,1                                                   CLK10010
       LXD *+12,1                                                       CLK10011
