       REM FORTRAN II SUBPROGRAM FOR SYMBOL TABLE PRINT'OUT       (STPN)MISPN001
       REM JUNE 10, 1959                                                MISPN002
       REM SUBROUTINE (STPN)                                            MISPN003
       ORG 0                                                            MISPN004
       REM PROGRAM CARD                                                 MISPN005
       MZE LAST-FIRST+1,,1                                              MISPN006
       PZE                                                              MISPN007
       BCD 1(STPN)                                                      MISPN008
       PZE EXIT                                                         MISPN009
       REM                                                              MISPN010
       ORG 0                                                            MISPN011
       REL                                                              MISPN012
 WOT   BCD 1(WOT)                                                       MISPN013
FIRST  SYN WOT                                                          MISPN014
START  TXI *+1,2,-214        ENTERS WITH IR2 = 214+S.T. LENGTH          MISPN015
       SXD FULST,2                                                      MISPN016
       TSX WOT,4             WRITE HEADING                              MISPN017
           HEAD,,HEAD+9                                                 MISPN018
       TSX WOT,4                                                        MISPN019
           BLANKS,,BLANKS                                               MISPN020
       LXD TWO,2                                                        MISPN021
SRCH   CAL STBL+1,2          PICK UP NAME , T.V., ORT.V. INDICATOR.     MISPN022
       TNZ TSTTV                                                        MISPN023
       CAL MAIN              ZERO INDICATES MAIN PROGRAM                MISPN024
       REM TEMPORARY BLOCK TO SET UP CORRECT TRANSFER IN BSS2           MISPN025
BEGIN  CAL TRANS                                                        MISPN026
       SLW 1CARD                                                        MISPN027
       TRA RDCRD                                                        MISPN028
TRANS  TTR START                                                        MISPN029
1CARD  EQU 19                                                           MISPN030
RDCRD  EQU 15                                                           MISPN031
       TCD BEGIN                                                        MISPN032
       ORG BEGIN                                                        MISPN033
       SLW NAME                                                         MISPN034
TWO    TXI CADR,,2                                                      MISPN035
 TSTTV CLA STBL+1,2                                                     MISPN036
       SUB TXL                                                          MISPN037
       TZE ORG                                                          MISPN038
       CAL STBL+1,2                                                     MISPN039
       ANA TXL                                                          MISPN040
       TNZ SUBPR                                                        MISPN041
 ORG   LDQ STBL+2,2                                                     MISPN042
       TSX CNVRT,4                                                      MISPN043
       SLW NUM2                                                         MISPN044
       TRA FULST-1                                                      MISPN045
SUBPR  CAL STBL+1,2          ADDRESS NON-ZERO,THUS BCD NAME             MISPN046
       SLW NAME                                                         MISPN047
CADR   LDQ STBL+2,2          GET ENTRY POINT                            MISPN048
       TSX CNVRT,4           ENTRY POINT IN MQ FOR OCTAL CONVERSION     MISPN049
       SLW NUMBR                                                        MISPN050
       TSX WOT,4                                                        MISPN051
       PZE PHEAD,,FIN                                                   MISPN052
       TXI *+1,2,2                                                      MISPN053
FULST  TXL SRCH,2,**         DECR.= LENGTH OF S.T.                      MISPN054
       TXI *+1,2,212         IR2= 214+ S.T. LENGTH                      MISPN055
P      STZ 0,2                                                          MISPN056
       TIX *-1,2,1           CLEARS FROM END OF S.T. TO TOP OF CORE     MISPN057
OUT    TRA TOV                                                          MISPN058
TOV    EQU 21                                                           MISPN059
CNVRT  RQL 21                                                           MISPN060
FIVE   PXD 5,0                                                          MISPN061
       LXA FIVE,1                                                       MISPN062
MOVE   ALS 3                                                            MISPN063
       LGL 3                                                            MISPN064
       TIX MOVE,1,1                                                     MISPN065
       ORA BLANK                                                        MISPN066
EXIT   TRA 1,4                                                          MISPN067
       REM CONSTANTS AND PRINT'OUT                                      MISPN068
 TXL   TXL                                                              MISPN069
STBL   EQU 32554             TOP OF THE SYMBOL TABLE                    MISPN070
ADMSK      -1                                                           MISPN071
BLANKS BCD 1                                                            MISPN072
BLANK  BCD 1 00000                                                      MISPN073
 PHEAD BCD 7             PROGRAM BEGINS AT       OCTAL                  MISPN074
 PRNT  BCD 6,      ENTRY POINT IS AT       OCTAL                        MISPN075
 NAME  SYN PHEAD+1                                                      MISPN076
 NUMBR SYN PRNT+4                                                       MISPN077
 FIN   SYN PRNT+5                                                       MISPN078
NUM2   SYN PHEAD+5                                                      MISPN079
HEAD   BCD                      FORTRAN II PROGRAM SYMBOL TABLE         MISPN080
MAIN   BCD 1(MAIN)                                                      MISPN081
LAST   SYN MAIN                                                         MISPN082
