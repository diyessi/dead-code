C NORMAL PROBABILITY FUNCTIONS -- ORDINATE AND AREA SUBROUTINE   5+5+60 NA860001
C DECK NUMBER 4B-102                                                    NA860002
                                                                        NA860003
C PROGRAMMER - M SINGLETON  -056+072-  LA                               NA860004
                                                                        NA860005
C DESCRIPTION  -                                                        NA860006
C       A SUBROUTINE WHICH WHEN GIVEN AN ARGUMENT (ABSCISSA VALUE) COM- NA860007
C       PUTES THE ORDINATE AND AREA VALUES OF EITHER OF TWO CLOSELY RE- NA860008
C       LATED FUNCTIONS.  THE FORMER (HERE CALLED TYPE A) FUNCTION WHICHNA860009
C       IS OF THE FORM MOST COMMONLY ENCOUNTERED IN MATHEMATICAL STATIS-NA860010
C       TICS, HAS BEEN FORMALLY TABULATED BY THE NATIONAL BUREAU OF     NA860011
C       STANDARDS AS MATHEMATICAL TABLES 14, (1942) ENTITLED TABLES OF  NA860012
C       PROBABILITY FUNCTIONS, VOL II,  AND RE-ISSUED AS APPLIED MATHE- NA860013
C       MATICS SERIES 23 (1953) ENTITLED TABLES OF NORMAL PROBABILITY   NA860014
C       FUNCTIONS.   THE  LATTER (HERE  CALLED  TYPE B)  FUNCTION, FRE- NA860015
C       QUENTLY  REFFRRED  TO  AS  THE                                  NA860016
C       ERROR FUNCTION AND ITS DERIVATIVE AND OF FUNDAMENTAL IMPORTANCE NA860017
C       IN CLASSICAL AND MODERN PHYSICS, HAS ALSO BEEN TABULATED BY THE NA860018
C       SAME AGENCY AS MATHEMATICAL TABLES 8, (1941) ENTITLED TABLE  OF NA860019
C       PROBABILITY FUNCTIONS, VOL I, AND RE-ISSUED AS APPLIED MATHE-   NA860020
C       MATICS SERIES 41, (1954) AS THETABLES OF THE ERROR FUNCTION AND NA860021
C       ITS DERIVATIVES.                                                NA860022
                                                                        NA860023
C       THE AREA FOR EITHER TYPE A OR TYPE B  INTEGRAL MAY BE COMPUTED  NA860024
C       IN ANY ONE OF THE FIVE FORMS OFTHE INTEGRAL LISTED BELOW UNDER  NA860025
C       ITYPE IN THE LIST OF SYMBOLS.    IF ONLY THE ORDINATE (DERIVA-  NA860026
C       TIVE OF THE FUNCTION) IS DESIRED, THEN ONLY THAT VALUE IS COM-  NA860027
C       PUTED IN THE SUBROUTINE AND THEFORMER AREA VALUE ,IF APPLICABLE,NA860028
C       IS LEFT UNCHANGED.  HOWEVER, IFTHE AREA IS DESIRED, THE SUB-    NA860029
C       ROUTINE COMPUTES BOTH THE ORDINATE AND AREA VALUES.  THE ORDI-  NA860030
C       NATE VALUE IS COMPUTED BY USINGA RATIONAL APPROXIMATION METHOD  NA860031
C       BASED ON A PAPER BY KOGBETLIANTZ WHILE THE AREA IS COMPUTED BY  NA860032
C       A HASTINGS APPROXIMATION.                                       NA860033
                                                                        NA860034
C USE - LINKAGE- CALL NPOA(XARG,ITYPE,ORD,AREA,ERR)                     NA860035
                                                                        NA860036
C     - LIST OF SYMBOLS                                                 NA860037
                                                                        NA860038
C                XARG  - ARGUMENT ON ABSCISSA AXIS.  SEE NOTE BELOW FOR NA860039
C                        LIMIT ON XARG.                                 NA860040
C                ITYPE - SIGNED FIXED POINT VARIABLE TO SPECIFY THE     NA860041
C                        FUNCTION TYPE AND FORM OF THE ORDINATE AND/OR  NA860042
C                        AREA.                                          NA860043
                                                                        NA860044
C                           TYPE A             FORM              TYPE B NA860045
C                          INTEGRAL                             INTEGRALNA860046
                                                                        NA860047
C                             +1     CENTRAL AREA FROM -X TO +X    -1   NA860048
C                             +2     SEMICENTRAL  FROM 0 TO +X     -2   NA860049
C                             +3  TWO-TAIL AREA BEYOND -X AND +X   -3   NA860050
C                             +4    SINGLE-TAIL AREA BEYOND +X     -4   NA860051
C                             +5  AREA FROM MINUS INFINITY TO +X   -5   NA860052
C                             +6       ORDINATE VALUE ONLY         -6   NA860053
                                                                        NA860054
C                ORD   - ANSWER ORDINATE FOR ARGUMENT OF SPECIFIED      NA860055
C                        FUNCTION TYPE.                                 NA860056
C                AREA  - ANSWER AREA FOR ARGUMENT OF SPECIFIED FUNCTION NA860057
C                        TYPE AND FORM.                                 NA860058
C                ERR   - ERROR INDICATOR TO DENOTE SUCCESSFUL OR UNSUC- NA860059
C                        CESSFUL RETURNFROM SUBROUTINE.                 NA860060
C                             SUCCESSFUL RETURN   -  ERR = 0.0          NA860061
C                             UNSUCCESSFUL RETURN -  ERR = 1.0          NA860062
                                                                        NA860063
C     - NOTES                                                           NA860064
                                                                        NA860065
C                IF XARG IS NEGATIVE, THE ORDINATE AND/OR AREA ARE COM- NA860066
C                PUTED FOR ABSOLUTE XARG.                               NA860067
                                                                        NA860068
C                IF THE ABSOLUTE VALUE OF XARG IS GREATER THAN 13.268609NA860069
C                WHEN ITYPE IS POSITIVE OR 9.382323   WHEN ITYPE IS     NA860070
C                NEGATIVE, THE ORDINATE IS GIVEN AS 0.0 AND THE AREA IS NA860071
C                GIVEN AS 1.0, 0.5, 0.0, 0.0, 1.0 FOR ABSOLUTE ITYPE    NA860072
C                EQUALS 1,2,3,4,5 RESPECTIVELY.                         NA860073
                                                                        NA860074
C     *          *          *          *          *          *          NA860075
                                                                        NA860076
      SUBROUTINE NPOA(XARG,ITYPE,ORD,AREA,ERR)                          NA860077
C                *          *          *                                NA860078
C     NO FREQUENCY, DIMENSION, OR EQUIVALENCE STATEMENTS REQUIRED.      NA860079
C                *          *          *                                NA860080
                                                                        NA860081
C     TEST IF ITYPE GREATER THAN ABSOLUTE 6                             NA860082
                                                                        NA860083
      IF (XABSF(ITYPE)-6) 7,7,16                                        NA860084
    7 ERR = ABSF(XARG)                                                  NA860085
                                                                        NA860086
C     TEST IF ITYPE NOT 0                                               NA860087
                                                                        NA860088
      IF (ITYPE) 9,16,8                                                 NA860089
                                                                        NA860090
C     SCALE XARG BY 1.0/SQUARE ROOT OF 2.0                              NA860091
                                                                        NA860092
    8 ERR = 0.707106781*ERR                                             NA860093
                                                                        NA860094
C     TEST XARG LIMIT EXCEEDED                                          NA860095
                                                                        NA860096
    9 IF ((ERR**2)-88.028) 15,15,10                                     NA860097
   10 ORD = 0.0                                                         NA860098
      IF (XABSF(ITYPE)-6) 11,17,11                                      NA860099
   11 AREA = 1.0                                                        NA860100
      GO TO 19                                                          NA860101
   15 ORD = 1.12837917 * EXPF(-(ERR**2))                                NA860102
                                                                        NA860103
C     TEST IF ONLY ORDINATE IS DESIRED                                  NA860104
                                                                        NA860105
      IF (XABSF(ITYPE)-6) 12,6,12                                       NA860106
                                                                        NA860107
C     COMPUTE ARGUMENT TRANSFORMATION                                   NA860108
                                                                        NA860109
   12 AREA = 1.0/(1.0 + 0.3275911*ERR)                                  NA860110
                                                                        NA860111
C     COMPUTE AREA                                                      NA860112
                                                                        NA860113
      AREA = 1.0 - ((((0.94064607*AREA -1.287822453)*AREA + 1.25969513)*NA860114
     1AREA - 0.252128668)*AREA + 0.225836846)*AREA * ORD                NA860115
                                                                        NA860116
C     TEST FORM OF INTEGRAL                                             NA860117
                                                                        NA860118
   19 GO TO (6,2,3,4,5),ITYPE                                           NA860119
                                                                        NA860120
C     SEMICENTRAL AREA FROM 0 TO +X                                     NA860121
                                                                        NA860122
    2 AREA = AREA/2.0                                                   NA860123
      GO TO 6                                                           NA860124
                                                                        NA860125
C     TWO-TAIL AREA BEYOND -X AND +X                                    NA860126
                                                                        NA860127
    3 AREA = 1.0 - AREA                                                 NA860128
      GO TO 6                                                           NA860129
                                                                        NA860130
C     SINGLE-TAIL AREA BEYOND +X                                        NA860131
                                                                        NA860132
    4 AREA = (1.0-AREA)/2.0                                             NA860133
      GO TO 6                                                           NA860134
                                                                        NA860135
C     AREA FROM MINUS INFINITY TO +X                                    NA860136
                                                                        NA860137
    5 AREA = (1.0 + AREA)/2.0                                           NA860138
                                                                        NA860139
C     ORDINATE ONLY - TEST FOR TYPE                                     NA860140
                                                                        NA860141
    6 IF(ITYPE) 17,16,14                                                NA860142
   14 ORD = 0.3535533905 * ORD                                          NA860143
                                                                        NA860144
C     SET UP SUCCESSFUL RETURN                                          NA860145
                                                                        NA860146
   17 ERR =0.0                                                          NA860147
      GO TO 18                                                          NA860148
                                                                        NA860149
C     SET UP UNSUCCESSFUL RETURN                                        NA860150
                                                                        NA860151
   16 ERR =1.0                                                          NA860152
   18 RETURN                                                            NA860153
      END                                                               NA860154
