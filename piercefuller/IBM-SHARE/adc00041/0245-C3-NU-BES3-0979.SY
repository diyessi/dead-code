C BES3 REM 272 07080                FORTRAN COMPLEX BESSEL SUBROUTINE   BES3 001
      SUBROUTINE COMBES(X,Y,ALPHA,BETA,N,BJRE,BJIM,YRE,YIM)             BES3 002
      DIMENSION BJRE(100),BJIM(100),YRE(50),YIM(50)                     BES3 003
      CALL START(X,Y,N,K,R)                                             BES3 004
      CALL JRECUR(X,Y,ALPHA,BETA,K,R,BJRE,BJIM)                         BES3 005
      CALL JSUM(ALPHA,BETA,K,BJRE,BJIM,SUMRA,SUMIA)                     BES3 006
      CALL FACTOR(X,Y,ALPHA,BETA,Q,R)                                   BES3 007
      CALL JNORM(K,Q,R,SUMRA,SUMIA,BJRE,BJIM)                           BES3 008
 7    CALL YSUM (X,Y,ALPHA,BETA,K,BJRE,BJIM,ASUMR,ASUMI)                BES3 009
 8    CALL YGNU (X,Y,ALPHA,BETA,Q,R,ASUMR,ASUMI,BJRE,BJIM,YRE,YIM)      BES3 010
 9    CALL WRONSK (X,Y,BJRE,BJIM,YRE,YIM)                               BES3 011
      IF (N-1)10,12,11                                                  BES3 012
 10   IF (N)13,12,12                                                    BES3 013
 13   CALL NEGN (X,Y,ALPHA,BETA,N,BJRE,BJIM,YRE,YIM)                    BES3 014
      GO TO 12                                                          BES3 015
   11 CALL YRECUR(X,Y,N,BJRE,BJIM,YRE,YIM)                              BES3 016
 12   RETURN                                                            BES3 017
      END (0,1,0,1,0)                                                   BES3 018
      SUBROUTINE START(X,Y,N,K,R)                                       BES3 019
      SSQ=X**2+Y**2                                                     BES3 020
      XTEN=SQRTF(SSQ)+20.0                                              BES3 021
      NTEN=XABSF(N)+10                                                  BES3 022
      KTEN=XTEN                                                         BES3 023
      M=XMAX0F(KTEN,NTEN)                                               BES3 024
      M=M/2                                                             BES3 025
      K=2*M+1                                                           BES3 026
      R=2*M+2                                                           BES3 027
      RETURN                                                            BES3 028
      END(0,1,0,1,0)                                                    BES3 029
      SUBROUTINE JRECUR(X,Y,ALPHA,BETA,K,R,BJRE,BJIM)                   BES3 030
      DIMENSION BJRE(100),BJIM(100)                                     BES3 031
      RALPHA=R+ALPHA                                                    BES3 032
      SSQ=X**2+Y**2                                                     BES3 033
      BJRE(K+2)=0                                                       BES3 034
      BJIM(K+2)=0                                                       BES3 035
      BJRE(K+1)=1.0E-37                                                 BES3 036
      BJIM(K+1)=0.0                                                     BES3 037
      DO4I=1,K                                                          BES3 038
      L1=K+1-I                                                          BES3 039
      RALPHA=RALPHA-1.0                                                 BES3 040
      A=((2.0*X*RALPHA)+(2.0*BETA*Y))/SSQ                               BES3 041
      B=((-2.0*Y*RALPHA)+(2.0*BETA*X))/SSQ                              BES3 042
      BJRE(L1)=(A*BJRE(L1+1))-(B*BJIM(L1+1))-BJRE(L1+2)                 BES3 043
 4    BJIM(L1)=(B*BJRE(L1+1))+(A*BJIM(L1+1))-BJIM(L1+2)                 BES3 044
      RETURN                                                            BES3 045
      END(0,1,0,1,0)                                                    BES3 046
      SUBROUTINE JSUM(ALPHA,BETA,K,BJRE,BJIM,SUMRA,SUMIA)               BES3 047
      DIMENSION BJRE(100),BJIM(100)                                     BES3 048
 801  SUMRA=(BJRE(3)*(ALPHA+2.0))-(BJIM(3)*BETA)                        BES3 049
      SUMIA=(BETA*BJRE(3))+((ALPHA+2.0)*BJIM(3))                        BES3 050
      GRE=1.0                                                           BES3 051
      GIM=0                                                             BES3 052
      S=1.0                                                             BES3 053
      DO6I=5,K,2                                                        BES3 054
      S=S+1.0                                                           BES3 055
      GREN=((GRE*(ALPHA+S-1.0))-(BETA*GIM))/S                           BES3 056
      GIM=((GIM*(ALPHA+S-1.0))+(BETA*GRE))/S                            BES3 057
      GRE=GREN                                                          BES3 058
      ALPTS=ALPHA+2.0*S                                                 BES3 059
      GJR=GRE*BJRE(I)                                                   BES3 060
      GJI=GIM*BJIM(I)                                                   BES3 061
      GJRI=GRE*BJIM(I)                                                  BES3 062
      GJIR=GIM*BJRE(I)                                                  BES3 063
      SUMRB=ALPTS*(GJR-GJI)-BETA*(GJIR+GJRI)+SUMRA                      BES3 064
      SUMIB=ALPTS*(GJIR+GJRI)-BETA*(GJI-GJR)+SUMIA                      BES3 065
      IF(ABSF((SUMRB/SUMRA)-1.0)-.00000005)21,21,10                     BES3 066
 21   IF(SUMIA)20,11,20                                                 BES3 067
 20   IF(ABSF((SUMIB/SUMIA)-1.0)-.00000005)11,11,10                     BES3 068
 10   SUMRA=SUMRB                                                       BES3 069
 6    SUMIA=SUMIB                                                       BES3 070
   11 RETURN                                                            BES3 071
      END(0,1,0,1,0)                                                    BES3 072
      SUBROUTINE FACTOR(X,Y,ALPHA,BETA,Q,R)                             BES3 073
      U=LNGAMF(ALPHA+1.0,BETA,XLOCF(V))                                 BES3 074
      CALL COMLOG(X,Y,A1,B1)                                            BES3 075
      A2=ALPHA*A1-BETA*B1                                               BES3 076
      B2=BETA*A1+ALPHA*B1                                               BES3 077
      A2=-A2                                                            BES3 078
      B2=-B2                                                            BES3 079
      CALL COMEXP(A2,B2,A3,B3)                                          BES3 080
      A4=.6931471806*ALPHA                                              BES3 081
      B4=.6931471806*BETA                                               BES3 082
      CALL COMEXP(A4,B4,A5,B5)                                          BES3 083
      A6=A3*A5-B3*B5                                                    BES3 084
      B6=B3*A5+A3*B5                                                    BES3 085
      CALL COMEXP(U,V,A7,B7)                                            BES3 086
      Q=A6*A7-B6*B7                                                     BES3 087
      R=B6*A7+A6*B7                                                     BES3 088
      RETURN                                                            BES3 089
      END(0,1,0,1,0)                                                    BES3 090
      SUBROUTINE COMLOG(X,Y,A,B)                                        BES3 091
      A=.5*LOGF(X**2+Y**2)                                              BES3 092
      PI=3.141592654                                                    BES3 093
      IF(X)1,2,3                                                        BES3 094
 1    B=ATANF(Y/X)+PI                                                   BES3 095
      GO TO 9                                                           BES3 096
 2    IF(Y)4,5,6                                                        BES3 097
 4    B=1.5*PI                                                          BES3 098
      GO TO 9                                                           BES3 099
 5    PAUSE 43467                                                       BES3 100
 6    B=.5*PI                                                           BES3 101
      GO TO 9                                                           BES3 102
 3    IF(Y)7,8,8                                                        BES3 103
 7    B=ATANF(Y/X)+2.0*PI                                               BES3 104
      GO TO 9                                                           BES3 105
 8    B=ATANF(Y/X)                                                      BES3 106
 9    RETURN                                                            BES3 107
      END(0,1,0,1,0)                                                    BES3 108
      SUBROUTINE COMEXP(X,Y,A,B)                                        BES3 109
      C=EXPF(X)                                                         BES3 110
      A=C*COSF(Y)                                                       BES3 111
      B=C*SINF(Y)                                                       BES3 112
      RETURN                                                            BES3 113
      END(0,1,0,1,0)                                                    BES3 114
      SUBROUTINE JNORM(K,Q,R,SUMRA,SUMIA,BJRE,BJIM)                     BES3 115
      DIMENSION BJRE(100),BJIM(100)                                     BES3 116
      S=((SUMRA+BJRE(1))*Q)-((SUMIA+BJIM(1))*R)                         BES3 117
      T=((SUMIA+BJIM(1))*Q)+((SUMRA+BJRE(1))*R)                         BES3 118
      IF(ABSF(S)-ABSF(T))100,101,101                                    BES3 119
 101  TS=T/S                                                            BES3 120
      TSSQ=S*(1.0+(TS**2))                                              BES3 121
 12   DO13I=1,K                                                         BES3 122
      BJREN=(BJRE(I)+BJIM(I)*TS)/TSSQ                                   BES3 123
      BJIM(I)=(BJIM(I)-BJRE(I)*TS)/TSSQ                                 BES3 124
 13   BJRE(I)=BJREN                                                     BES3 125
      GO  TO  14                                                        BES3 126
 100  ST=S/T                                                            BES3 127
      STSQ=T*((ST**2)+1.0)                                              BES3 128
 102  DO103I=1,K                                                        BES3 129
      BJREN=(BJRE(I)*ST+BJIM(I))/STSQ                                   BES3 130
      BJIM(I)=(BJIM(I)*ST-BJRE(I))/STSQ                                 BES3 131
 103  BJRE(I)=BJREN                                                     BES3 132
   14 RETURN                                                            BES3 133
      END(0,1,0,1,0)                                                    BES3 134
      SUBROUTINE YSUM (X,Y,ALPHA,BETA,K,BJRE,BJIM,ASUMR,ASUMI)          BES3 135
      DIMENSION BJRE(100),BJIM(100)                                     BES3 136
      A1=ALPHA-1.0                                                      BES3 137
      A2=A1-1.0                                                         BES3 138
      A3=A1+ALPHA                                                       BES3 139
      A4=BETA**2                                                        BES3 140
      A5=2.0*A4                                                         BES3 141
      ABSQ=(-A1)**2+A4                                                  BES3 142
      GAMRE=((2.0+ALPHA)*(-A1)-A4)/ABSQ                                 BES3 143
      GAMIM=(BETA*3.0)/ABSQ                                             BES3 144
      ASUMR=GAMRE*BJRE(3)-GAMIM*BJIM(3)                                 BES3 145
      ASUMI=GAMIM*BJRE(3)+GAMRE*BJIM(3)                                 BES3 146
      T=1.0                                                             BES3 147
      DO 500 I=5,K,2                                                    BES3 148
      T=T+1.0                                                           BES3 149
      B1=2.0*T                                                          BES3 150
      F1=B1+ALPHA                                                       BES3 151
      F2=A3+T                                                           BES3 152
      F3=A1+T                                                           BES3 153
      F5=T-ALPHA                                                        BES3 154
      F6=A2+B1                                                          BES3 155
      G1=F1*F2-A5                                                       BES3 156
      G2=(F2+2.0*F1)*BETA                                               BES3 157
      H1=G1*F3-G2*BETA                                                  BES3 158
      H2=G2*F3+G1*BETA                                                  BES3 159
      P1=F5*F6+A4                                                       BES3 160
      P2=(F5-F6)*BETA                                                   BES3 161
      P3=P1**2+P2**2                                                    BES3 162
      CRE=((H1*P1+H2*P2)/P3)/T                                          BES3 163
      CIM=((H2*P1-H1*P2)/P3)/T                                          BES3 164
      TEMP=-(CRE*GAMRE-CIM*GAMIM)                                       BES3 165
      GAMIM=-(CIM*GAMRE+CRE*GAMIM)                                      BES3 166
      GAMRE=TEMP                                                        BES3 167
      BSUMR=GAMRE*BJRE(I)-GAMIM*BJIM(I)+ASUMR                           BES3 168
      BSUMI=GAMIM*BJRE(I)+GAMRE*BJIM(I)+ASUMI                           BES3 169
      IF(ABSF((BSUMR/ASUMR)-1.0)-.00000005)521,521,510                  BES3 170
 521  IF(ASUMI)520,511,520                                              BES3 171
 520  IF(ABSF((BSUMI/ASUMI)-1.0)-.00000005)511,511,510                  BES3 172
 510  ASUMR=BSUMR                                                       BES3 173
 500  ASUMI=BSUMI                                                       BES3 174
 511  RETURN                                                            BES3 175
      END(0,1,0,1,0)                                                    BES3 176
      SUBROUTINE YGNU(X,Y,ALPHA,BETA,Q,R,ASUMR,ASUMI,BJRE,BJIM,YRE,YIM) BES3 177
      DIMENSION BJRE(100),BJIM(100),YRE(50),YIM(50)                     BES3 178
      PI=3.141592654                                                    BES3 179
      TPI=2.0/PI                                                        BES3 180
      QRE=TPI*(Q**2-R**2)                                               BES3 181
      QIM=TPI*2.0*Q*R                                                   BES3 182
      DRE=QRE*ASUMR-QIM*ASUMI                                           BES3 183
      DIM=QIM*ASUMR+QRE*ASUMI                                           BES3 184
      IF(ALPHA)1,2,1                                                    BES3 185
 2    IF(BETA)1,3,1                                                     BES3 186
 3    CALL YZERO(X,Y,ALPRE,ALPIM)                                       BES3 187
      GO TO 720                                                         BES3 188
 1    PALPHA=PI*ALPHA                                                   BES3 189
      COX=COSF(PALPHA)                                                  BES3 190
      SIX=SINF(PALPHA)                                                  BES3 191
      EXY=EXPF(PI*BETA)                                                 BES3 192
      EXY1=1.0/EXY                                                      BES3 193
      COSH=.5*(EXY+EXY1)                                                BES3 194
      SINH=.5*(EXY-EXY1)                                                BES3 195
      DEN=(SIX*COSH)**2+(COX*SINH)**2                                   BES3 196
      ERE=(SIX*COX)/DEN                                                 BES3 197
      EIM=(-COSH*SINH)/DEN                                              BES3 198
      ABSQ3=2.0*(ALPHA**2+BETA**2)                                      BES3 199
      ALPRE=ERE-((QRE*ALPHA+BETA*QIM)/ABSQ3)                            BES3 200
      ALPIM=EIM-((QIM*ALPHA-BETA*QRE)/ABSQ3)                            BES3 201
 720  YRE(1)=ALPRE*BJRE(1)-ALPIM*BJIM(1)+DRE                            BES3 202
      YIM(1)=ALPIM*BJRE(1)+ALPRE*BJIM(1)+DIM                            BES3 203
      RETURN                                                            BES3 204
      END(0,1,0,1,0)                                                    BES3 205
      SUBROUTINE YZERO(X,Y,ALPRE,ALPIM)                                 BES3 206
      TPI=2.0/3.141592654                                               BES3 207
      CALL COMLOG(X,Y,A,B)                                              BES3 208
      ALPRE=TPI*(-.1159315157+A)                                        BES3 209
      ALPIM=TPI*B                                                       BES3 210
      RETURN                                                            BES3 211
      END(0,1,0,1,0)                                                    BES3 212
      SUBROUTINE WRONSK(X,Y,BJRE,BJIM,YRE,YIM)                          BES3 213
      DIMENSION BJRE(100),BJIM(100),YRE(50),YIM(50)                     BES3 214
      SSQ=X**2+Y**2                                                     BES3 215
      TPI=2.0/3.141592654                                               BES3 216
      AZRE=TPI*X/SSQ                                                    BES3 217
      AZIM=-TPI*Y/SSQ                                                   BES3 218
      ZRE=BJRE(2)*YRE(1)-BJIM(2)*YIM(1)                                 BES3 219
      ZIM=BJIM(2)*YRE(1)+BJRE(2)*YIM(1)                                 BES3 220
      BZRE=ZRE-AZRE                                                     BES3 221
      BZIM=ZIM-AZIM                                                     BES3 222
      BJSQ=BJRE(1)**2+BJIM(1)**2                                        BES3 223
      CZRE=BJRE(1)/BJSQ                                                 BES3 224
      CZIM=(-BJIM(1))/BJSQ                                              BES3 225
      YRE(2)=BZRE*CZRE-BZIM*CZIM                                        BES3 226
      YIM(2)=BZIM*CZRE+BZRE*CZIM                                        BES3 227
      RETURN                                                            BES3 228
      END(0,1,0,1,0)                                                    BES3 229
      SUBROUTINE NEGN(X,Y,ALPHA,BETA,N,BJRE,BJIM,YRE,YIM)               BES3 230
      DIMENSION BJRE(100),BJIM(100),YRE(50),YIM(50)                     BES3 231
      L=XABSF(N)+1                                                      BES3 232
      SSQ=X**2+Y**2                                                     BES3 233
      TX=2.0*X                                                          BES3 234
      TY=2.0*Y                                                          BES3 235
      RALPHA=ALPHA                                                      BES3 236
      A=(TX*RALPHA+TY*BETA)/SSQ                                         BES3 237
      B=(-TY*RALPHA+TX*BETA)/SSQ                                        BES3 238
      BJRE(2)=A*BJRE(1)-B*BJIM(1)-BJRE(2)                               BES3 239
      BJIM(2)=B*BJRE(1)+A*BJIM(1)-BJIM(2)                               BES3 240
      YRE(2)=A*YRE(1)-B*YIM(1)-YRE(2)                                   BES3 241
      YIM(2)=B*YRE(1)+A*YIM(1)-YIM(2)                                   BES3 242
      DO 1 I=3,L                                                        BES3 243
      RALPHA=RALPHA-1.0                                                 BES3 244
      A=(TX*RALPHA+TY*BETA)/SSQ                                         BES3 245
      B=(-TY*RALPHA+TX*BETA)/SSQ                                        BES3 246
      BJRE(I)=A*BJRE(I-1)-B*BJIM(I-1)-BJRE(I-2)                         BES3 247
      BJIM(I)=B*BJRE(I-1)+A*BJIM(I-1)-BJIM(I-2)                         BES3 248
      YRE(I)=A*YRE(I-1)-B*YIM(I-1)-YRE(I-2)                             BES3 249
 1    YIM(I)=B*YRE(I-1)+A*YIM(I-1)-YIM(I-2)                             BES3 250
      RETURN                                                            BES3 251
      END(0,1,0,1,0)                                                    BES3 252
      SUBROUTINE YRECUR(X,Y,N,BJRE,BJIM,YRE,YIM)                        BES3 253
      DIMENSION BJRE(100),BJIM(100),YRE(50),YIM(50)                     BES3 254
      SSQ=X**2+Y**2                                                     BES3 255
      TPI=2.0/3.141592654                                               BES3 256
      AZRE=TPI*X/SSQ                                                    BES3 257
      AZIM=-TPI*Y/SSQ                                                   BES3 258
      L=N+1                                                             BES3 259
      DO 1 I=3,L                                                        BES3 260
      ZRE=BJRE(I)*YRE(I-1)-BJIM(I)*YIM(I-1)                             BES3 261
      ZIM=BJIM(I)*YRE(I-1)+BJRE(I)*YIM(I-1)                             BES3 262
      BZRE=ZRE-AZRE                                                     BES3 263
      BZIM=ZIM-AZIM                                                     BES3 264
      BJSQ=BJRE(I-1)**2+BJIM(I-1)**2                                    BES3 265
      CZRE=BJRE(I-1)/BJSQ                                               BES3 266
      CZIM=(-BJIM(I-1))/BJSQ                                            BES3 267
      YRE(I)=BZRE*CZRE-BZIM*CZIM                                        BES3 268
    1 YIM(I)=BZIM*CZRE+BZRE*CZIM                                        BES3 269
      RETURN                                                            BES3 270
      END(0,1,0,1,0)                                                    BES3 271
C     THIS IS THE LAST CARD                                             BES3 272
