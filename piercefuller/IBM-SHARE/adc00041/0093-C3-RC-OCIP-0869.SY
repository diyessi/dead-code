C     OCIP THE CIRCLE PROBABILITY FUNCTION  HL CUBERT                   OCIP0001
      SUBROUTINE OCIP(A,V,PAV)                                          OCIP0002
      IF(V-A-5.0)1,1,2                                                  OCIP0003
 2    PAV=1.0                                                           OCIP0004
      RETURN                                                            OCIP0005
 1    IF(V-A+5.0)3,4,4                                                  OCIP0006
 3    PAV=0.0                                                           OCIP0007
      RETURN                                                            OCIP0008
 4    PI=3.14159265                                                     OCIP0009
      HALPI=PI*0.5                                                      OCIP0010
      TWPI=2.0*PI                                                       OCIP0011
      RTWPI=SQRTF(TWPI)                                                 OCIP0012
      RHAPI=SQRTF(HALPI)                                                OCIP0013
      IF(A-4.)5,6,6                                                     OCIP0014
C     A LESS THAN FOUR                                                  OCIP0015
 5    ASQ=A*A                                                           OCIP0016
      AFOUR=ASQ*ASQ                                                     OCIP0017
      ASIX=AFOUR*ASQ                                                    OCIP0018
      Z=-ASQ*0.25                                                       OCIP0019
      EXP=EXPF(Z)                                                       OCIP0020
      CALL IZERO(-Z,BESSZ)                                              OCIP0021
      CALL IONE(-Z,BESSO)                                               OCIP0022
      EM1P=RHAPI*EXP*(BESSZ+ASQ*(BESSZ+BESSO)*0.5)                      OCIP0023
      EM3P=RHAPI*EXP*((ASQ+3.0)*BESSZ+(AFOUR+4.0*ASQ)*(BESSZ+BESSO)*0.5)OCIP0024
      EM5P=RHAPI*EXP*((AFOUR+11.0*ASQ+15.0)*BESSZ+(ASIX+12.0*AFOUR+23.0*OCIP0025
     1ASQ)*(BESSZ+BESSO)*0.5)                                           OCIP0026
      EM2P=ASQ+2.0                                                      OCIP0027
      EM4P=AFOUR+8.0*ASQ+8.0                                            OCIP0028
      EM6P=ASIX+18.0*AFOUR+72.0*ASQ+48.0                                OCIP0029
      SIGSQ=EM2P-(EM1P**2)                                              OCIP0030
      SIGMA=SQRTF(SIGSQ)                                                OCIP0031
      EM1P2=EM1P**2                                                     OCIP0032
      EM1P3=EM1P*EM1P2                                                  OCIP0033
      EM1P4=EM1P2**2                                                    OCIP0034
      EM1P5=EM1P4*EM1P                                                  OCIP0035
      EM1P6=EM1P3**2                                                    OCIP0036
      EM3=EM3P-3.0*EM1P*EM2P+2.0*EM1P3                                  OCIP0037
      EM4=EM4P-4.0*EM1P*EM3P+6.0*EM1P2*EM2P-3.0*EM1P4                   OCIP0038
      EM5=EM5P-5.0*EM1P*EM4P+10.0*EM1P2*EM3P-10.0*EM1P3*EM2P+4.0*EM1P5  OCIP0039
      EM6=EM6P-6.0*EM1P*EM5P+15.0*EM1P2*EM4P-20.0*EM1P3*EM3P+15.0*EM1P4*OCIP0040
     1EM2P-5.0*EM1P6                                                    OCIP0041
      TERM1=EM3/(SIGMA*SIGSQ)                                           OCIP0042
      TERM2=EM4/(SIGSQ**2)-3.0                                          OCIP0043
      TERM3=EM5/(SIGSQ**2*SIGMA)-10.0*EM3/(SIGMA*SIGSQ)                 OCIP0044
      TERM4=EM6/(SIGSQ**3)-15.0*EM4/(SIGSQ**2)+30.0                     OCIP0045
      GO TO 7                                                           OCIP0046
 6    ASQ=A*A                                                           OCIP0047
      ACUBE=A*ASQ                                                       OCIP0048
      AFOUR=ASQ**2                                                      OCIP0049
      AFIVE=AFOUR*A                                                     OCIP0050
      ASIX=ACUBE**2                                                     OCIP0051
      ASVEN=ASIX*A                                                      OCIP0052
      EM1P=A+0.5/A+1.0/(8.0*ACUBE)+3.0/(16.0*AFIVE)+75.0/(128.0*ASVEN)  OCIP0053
      SIGMA=1.0-1.0/(4.0*ASQ)-9.0/(32.0*AFOUR)-97.0/(128.0*ASIX)        OCIP0054
      TERM1=1.0/ACUBE+3.0/AFIVE                                         OCIP0055
      TERM2=-3.0/AFOUR                                                  OCIP0056
      TERM3=0.0                                                         OCIP0057
      TERM4=0.0                                                         OCIP0058
 7    WHY=(V-EM1P)/SIGMA                                                OCIP0059
      WHY2=WHY**2                                                       OCIP0060
      WHY3=WHY*WHY2                                                     OCIP0061
      WHY4=WHY2**2                                                      OCIP0062
      WHY5=WHY*WHY4                                                     OCIP0063
      CALL PHI(WHY,W,ERF,CPHI)                                          OCIP0064
      PAV=CPHI-(EXPF(-WHY2*0.5)/RTWPI)*((WHY2-1.0)/6.0*TERM1+(WHY3-3.0* OCIP0065
     1WHY)/24.0*TERM2+(WHY4-6.0*WHY2+3.0)/120.0*TERM3+(WHY5-10.0*WHY3   OCIP0066
     2+15.0*WHY)/720.0*TERM4)                                           OCIP0067
      RETURN                                                            OCIP0068
      END(0,1,0,0,1)                                                    OCIP0069
      SUBROUTINE PHI (WHY,W,ERF,CPHI)                                   OCIP0070
      W=ABSF(WHY)/SQRTF(2.0)                                            OCIP0071
      CALL ERROR(W,ERF)                                                 OCIP0072
      IF(WHY-0.000001)600,601,600                                       OCIP0073
 600  CPHI=0.5*(1.0+(WHY/ABSF(WHY)*ERF))                                OCIP0074
      RETURN                                                            OCIP0075
 601  CPHI=0.5                                                          OCIP0076
      RETURN                                                            OCIP0077
      END(0,1,0,0,1)                                                    OCIP0078
      SUBROUTINE ERROR (W,ERF)                                          OCIP0079
      ERF=1.0-1.0/((1.0+0.14112821*W+0.08864027*W*W+0.02743349*W**3     OCIP0080
     1-0.00039446*(W*W)**2+0.00328975*W*(W*W)**2)**8)                   OCIP0081
      RETURN                                                            OCIP0082
      END(0,1,0,0,1)                                                    OCIP0083
      SUBROUTINE IZERO(EX,BESSZ)                                        OCIP0084
      BESSZ =1.0                                                        OCIP0085
      EXSQ=EX*EX                                                        OCIP0086
      DENOM=1.0                                                         OCIP0087
      XNUM=EXSQ/4.0                                                     OCIP0088
      FNUM=1.0                                                          OCIP0089
      DO 100 I=1,10                                                     OCIP0090
      D=I                                                               OCIP0091
      FNUM=FNUM*XNUM                                                    OCIP0092
      DENOM=DENOM*D                                                     OCIP0093
 100  BESSZ=BESSZ+(FNUM/(DENOM**2))                                     OCIP0094
      RETURN                                                            OCIP0095
      END(0,1,0,0,1)                                                    OCIP0096
      SUBROUTINE IONE(EX,BESSO)                                         OCIP0097
      BESSO =1.0                                                        OCIP0098
      EXSQ=EX*EX                                                        OCIP0099
      DEN1=1.0                                                          OCIP0100
      DEN2=1.0                                                          OCIP0101
      XNUM=EXSQ/4.0                                                     OCIP0102
      FNUM=1.0                                                          OCIP0103
      DO 101 I=1,10                                                     OCIP0104
      D=I                                                               OCIP0105
      FNUM =FNUM*XNUM                                                   OCIP0106
      DEN1=DEN1*D                                                       OCIP0107
      DEN2=DEN2*(D+1.0)                                                 OCIP0108
 101  BESSO=BESSO +FNUM/(DEN1*DEN2)                                     OCIP0109
      BESSO =BESSO*EX*0.5                                               OCIP0110
      RETURN                                                            OCIP0111
      END(0,1,0,0,1)                                                    OCIP0112
