       REM SIMPSONS RULE FLOATING-POINT INTEGRATION                     RWSI2F00
SI2F   STO     COMMON            SAVE FUNCTION VALUE F(X)               SI2F0001
       ZET     3,4               TEST FLAG                              SI2F0002
       TRA     SI2F3                                                    SI2F0003
       STL     3,4                                                      SI2F0004
       CLA     1,4               FIRST ENTRY                            SI2F0005
       ARS     18                GET ADDRESS OF B                       SI2F0006
       STA     SI2F1                                                    SI2F0007
SI2F1  CLA     ****              B                                      SI2F0008
       FSB*    1,4               A                                      SI2F0009
       TZE     5,4               B-1 = 0, INTEGRAL IS ZERO              SI2F0010
       STO     COMMON            B-A                                    SI2F0011
       DCT                       TURN OFF DV CK                         SI2F0012
SI2F2  TXH     0,0,0                                                    SI2F0013
       FDP*    2,4               DELTA X                                SI2F0014
       DCT                                                              SI2F0015
       TRA     4,4               DELTA X = 0                            SI2F0016
       XCA                                                              SI2F0017
       SSP                                                              SI2F0018
       UFA     SI2F0             UNFLOAT N                              SI2F0019
       LRS     1                 ROUND                                  SI2F0020
       LDQ     SI2F2             N                                      SI2F0021
       RND                       TO                                     SI2F0022
       ALS     1                 EVEN                                   SI2F0023
       FAD     SI2F0             REFLOAT N                              SI2F0024
       SLW     SI2FN             N                                      SI2F0025
       CLA     COMMON            B-A                                    SI2F0026
       FDP     SI2FN             N                                      SI2F0027
       STQ     SI2FH             H, EXACT INTERVAL                      SI2F0028
       STZ     SI2FI             I                                      SI2F0029
       STZ     SI2FS             SUM                                    SI2F0030
       STZ     SI2FS+1                                                  SI2F0031
SI2F6  LDQ     SI2FI             X = I*H + A                            SI2F0032
       FMP     SI2FH                                                    SI2F0033
       FAD*    1,4                                                      SI2F0034
       TRA     6,4               EXIT TO COMPUT F(X)                    SI2F0035
SI2F3  CLA     SI2FI             I                                      SI2F0036
       TZE     SI2F4             I'0                                    SI2F0037
       FSB     SI2FN             N                                      SI2F0038
       TZE     SI2F4             I=N                                    SI2F0039
       CLA     SI2FI             I                                      SI2F0040
       UFA     SI2F0                                                    SI2F0041
       LBT                       TEST FOR EVEN OR ODD                   SI2F0042
       TRA     *+3                                                      SI2F0043
       CLA     SI2FT             SIMPSON COEFFICIENT IS 4               SI2F0044
       TRA     *+2                                                      SI2F0045
       CLA     SI2FT+1           SIMPSON COEFFICIENT IS 2               SI2F0046
SI2F4  LDQ     COMMON            SET SIGN OF AC TO F(X)                 SI2F0047
       LLS     0                                                        SI2F0048
       ADD     COMMON            F(X) + EXPONENT INCREMENT              SI2F0049
       FAD     SI2FS+1                                                  SI2F0050
       FAD     SI2FS             SUM                                    SI2F0051
       STO     SI2FS             NEW SUM                                SI2F0052
       STQ     SI2FS+1                                                  SI2F0053
       CLA     SI2FI             I                                      SI2F0054
       FAD     SI2FE             1                                      SI2F0055
       STO     SI2FI             I+1                                    SI2F0056
       FSB     SI2FN             N                                      SI2F0057
       TZE     SI2F5             I=N                                    SI2F0058
       TMI     SI2F6             NOT FINISHED                           SI2F0059
       CLA     SI2FS             SUM                                    SI2F0060
       LDQ     SI2FS+1                                                  SI2F0061
       FRN                                                              SI2F0062
       FDP     SI2FR             3                                      SI2F0063
       FMP     SI2FH             H                                      SI2F0064
       FRN                                                              SI2F0065
       TRA     5,4               EXIT WITH INTEGRAL                     SI2F0066
SI2F5  CLA*    SI2F1             USE X=B                                SI2F0067
       TRA     6,4                                                      SI2F0068
SI2FN  DEC     0.                N                                      SI2F0069
SI2FH  DEC     0.                H                                      SI2F0070
SI2FI  DEC     0.                I                                      SI2F0071
SI2FS  DEC     0.,0.             SUM                                    SI2F0072
SI2F0  OCT     233000000000      FIXER AT B=35                          SI2F0073
SI2FT  DEC     2B8               COEFFICIENT 4                          SI2F0074
       DEC     1B8               COEFFICIENT 2                          SI2F0075
SI2FE  DEC     1.                                                       SI2F0076
SI2FR  DEC     3.                                                       SI2F0077
