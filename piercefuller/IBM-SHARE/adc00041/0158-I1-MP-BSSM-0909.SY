MPBSSM REM  244  6100                                                   BSSM0001
       REM SPECIAL BSS LOADER FOR FORTRAN MAP                           BSSM0002
       REM G.L. FOSTER DEPT. 510                                        BSSM0003
       REM                                                              BSSM0004
       FUL                                                              BSSM0005
  LIST SYN 32556                                                        BSSM0006
TOOMCH SYN LIST-20                                                      BSSM0007
 TABL  SYN LIST-21                                                      BSSM0008
       ORG 0                                                            BSSM0009
 VR    LXA 0,1                                                          BSSM0010
 SM    CPY 2,1                                                          BSSM0011
       TXI SM,1,-1                                                      BSSM0012
 TG    HTR 0,1                                                          BSSM0013
       LTM                                                              BSSM0014
 X     RCD                                                              BSSM0015
 RB    CPY LIST-21,1                                                    BSSM0016
 LB    TXI RB,1,-1                                                      BSSM0017
 R                                                                      BSSM0018
       TXH X,1,-220                                                     BSSM0019
       LXD M,1                                                          BSSM0020
       SXD M,1                                                          BSSM0021
 ZERO  TRA ZEMEM             TRANS. TO ZERO MEMORY                      BSSM0022
       STZ LIST-20                                                      BSSM0023
 READ  RCD                                                              BSSM0024
       CPY VR                9 LEFT                                     BSSM0025
       TRA TEST                                                         BSSM0026
       HTR READ                                                         BSSM0027
 END   STZ 0,2                                                          BSSM0028
       TIX END,2,1                                                      BSSM0029
       TOV PROG                                                         BSSM0030
 T                                                                      BSSM0031
 PROG  TRA                                                              BSSM0032
 ADDRS OCT 000000077777                                                 BSSM0033
       ORG LIST+1                                                       BSSM0034
 TEST  CLA VR                PLACES WORD COUNT IN DEC. OF ACC.          BSSM0035
       CPY SM                9 RIGHT CHECK SUM                          BSSM0036
       TMI PASS1        PREFIX IS 4 IF WORD IS A PROG CD OR TRANSFER CD BSSM0037
       TZE READ              ABS. BINARY CARD                           BSSM0038
       STZ PRTST                                                        BSSM0039
       LXD VR,1                                                         BSSM0040
       TXL REG,1,31                                                     BSSM0041
       TXH 0,1,32                                                       BSSM0042
       STA T                                                            BSSM0043
       ADD S                                                            BSSM0044
       STA S                                                            BSSM0045
       CLA SM                                                           BSSM0046
       STA U                                                            BSSM0047
       TRA READ                                                         BSSM0048
 REG   STA R                                                            BSSM0049
       ARS 15                                                           BSSM0050
 U     PDX 0,4               PLACES 9 LEFT PREFIX IN I.R. =4            BSSM0051
       TXL NR,4,1                                                       BSSM0052
       TSX LT,2                                                         BSSM0053
       STA R                                                            BSSM0054
 NR    CAL VR                                                           BSSM0055
       ARS 18                                                           BSSM0056
       ADD R                                                            BSSM0057
       STA TR                                                           BSSM0058
       LXD VR,2              PLACES WORD COUNT IN I.R.=2                BSSM0059
 TR    TXL 0,2                                                          BSSM0060
       STA TA                                                           BSSM0061
       STA SA                                                           BSSM0062
       STA SD                                                           BSSM0063
       STA TD                                                           BSSM0064
 B     STA CP                                                           BSSM0065
       CAL VR                                                           BSSM0066
       TXL CP,4,1                                                       BSSM0067
       CAD LB                8 LEFT                                     BSSM0068
       CAD RB                8 RIGHT                                    BSSM0069
 CP    CAD 0,2                                                          BSSM0070
       TIX CP,2,1                                                       BSSM0071
       TXL CT,4,0            ABS. BINARY CARD                           BSSM0072
       TXL READ,4,1          ABS. BINARY CARD WITH 9-3 PUNCHED          BSSM0073
       TXL CT,4,2            IF I.R.=4 CONTAINS 2,CHECK,CHECKSUM        BSSM0074
       TXL RL,4,3            IGNORE CHECK SUM I.R.=4-3                  BSSM0075
 CT    SLW VR                STORE CHECK SUM IN VR                      BSSM0076
       CLA SM                CLA CHECKSUM 9R                            BSSM0077
       TZE RT                FOR PROGRAM CARD CK. SUM CHANGED TO 0      BSSM0078
       SUB VR                                                           BSSM0079
       TZE RT                TRANSFER IF CHECK SUM IS CORRECT           BSSM0080
       HPR                   ERROR IN CHECK SUM                         BSSM0081
 RT    TXL READ,4,1          FOR ABS. BIN. CARD WITH 93 NOT PUNCHED     BSSM0082
       TXH SR,4,3            TRANSFER IF PROGRAM CARD                   BSSM0083
 RL    LDQ RB                                                           BSSM0084
 DB    CLA LB                                                           BSSM0085
       LGL 1                                                            BSSM0086
       SLW LB                                                           BSSM0087
       TPL AB                TEST RELOCATABLE BIT                       BSSM0088
 TD    CLA 0,1                                                          BSSM0089
       ARS 18                                                           BSSM0090
       TSX CB,2                                                         BSSM0091
       ALS 18                                                           BSSM0092
 SD    STD 0,1                                                          BSSM0093
 AB    CLA LB                                                           BSSM0094
       LGL 1                                                            BSSM0095
       SLW LB                                                           BSSM0096
       TPL TV                TEST NEXT RELOCATABLE BIT                  BSSM0097
 TA    CLA 0,1                                                          BSSM0098
       TSX CB,2                                                         BSSM0099
 SA    STA 0,1                                                          BSSM0100
 TV    TIX DB,1,1            LOOP BACK TO TEST RELOCATION OF NEXT WORD  BSSM0101
       TRA READ              READ IN NEW CARD                           BSSM0102
 CB    STA R                                                            BSSM0103
       CLA LB                                                           BSSM0104
       LGL 1                                                            BSSM0105
       SLW LB                                                           BSSM0106
       TMI LTA               WILL ADDRESS BE MISLEADING                 BSSM0107
 LT    SLN 1                 NO, CODE IS 10,TURN ON SENSE LIGHT         BSSM0108
 LTA   CLS R                 DOES THIS ADDRESS REFER TO PROGRAM OR DATA BSSM0109
       ADD T                                                            BSSM0110
       TPL ADDS                                                         BSSM0111
       SLT 1                 APPEARS TO BE DATA, BUT WHAT WAS CODE      BSSM0112
       TRA PROGRM ACUALLY PROGRAM, ADD CURRENT INCREMENT                BSSM0113
 DATA  CLA R                 IS DATA REFERENCE, DECREMENT               BSSM0114
       ADM U                                                            BSSM0115
       TRA 1,2                                                          BSSM0116
 ADDS  SLT 1                 APPEARS TO BE PROGRAM WHAT WAS CODE        BSSM0117
       TRA DATA              ACTUALLY IS DATA REFERENCE DECREMENT       BSSM0118
PROGRM SUB S                                                            BSSM0119
       TRA 1,2                                                          BSSM0120
 PASS1 PDX 0,2                                                          BSSM0121
 TRCD  TXL WDR,2,0           SATISFIED IF A TRANSFER CARD               BSSM0122
       ADD TAG               ADD LENGTH OF SYMBOL TABLE                 BSSM0123
       ADD DECTWO            TO ALLOW SPACE IN TABLE FOR LOC. + LENGTH  BSSM0124
       STD STOP              STORE NEW LENGTH IN INST. TO STOP RELOC.   BSSM0125
       SUB M                                                            BSSM0126
       STD OVLP              ADDR. TABLE+1 - WORD COUNT + LENGTH TABL   BSSM0127
       ACL VR                                                           BSSM0128
       SUB DECTWO                                                       BSSM0129
       ARS 18                                                           BSSM0130
DECTWO TIX TXB,2,2                                                      BSSM0131
 TXB   TSX B,4               FORCE I.R.4 FOR CHECK SUM, BUT NOT RELOCATEBSSM0132
 SR    LXD TAG,1             LOAD OLD TABLE LENGTH                      BSSM0133
       CLA PRTST             HAS ANOTHER PROGRAM CARD PRECEEDED         BSSM0134
       TZE ONLY1             THIS ONE                                   BSSM0135
       CLA LB                YES, LB HAS NAME, RB HAS ENTRY POINT       BSSM0136
       STO TABL-1,1                                                     BSSM0137
       CLA RB                                                           BSSM0138
       STO TABL,1                                                       BSSM0139
       TIX NCARDS,1,2        SKIP, COMPARISONS ALREADY DONE             BSSM0140
 ONLY1 CLA S                 STORE LOCATION OF TRA VECTOR IN            BSSM0141
       STZ TABL-1,1                                                     BSSM0142
       STO TABL,1            SYMBOL TABLE, S HAS ADDRESS ONLY           BSSM0143
       LXD LB,4                                                         BSSM0144
       TXH CLAS,4,0                                                     BSSM0145
       CLA BTMASK                                                       BSSM0146
       STO TABL-1,1                                                     BSSM0147
 CLAS  CLA LB                STORE LENGTH OF VECTOR IN                  BSSM0148
       STD TABL-1,1          SYMBOL TABLE                               BSSM0149
       STA T                 STORE LENGTH OF ROUTINE IN T               BSSM0150
       ADD S                 UPDATE S                                   BSSM0151
       STA S                                                            BSSM0152
       PAX 0,2               COMPARE S TO LOWEST ADDRESS OF             BSSM0153
 OVLP  TXH TG,2,0            TABLE TRA TG,TABLE + INSTR. OVERLAP        BSSM0154
       CLA U                 FIND LOWEST ADDRESS DATA WILL USE          BSSM0155
       SUB RB                                                           BSSM0156
       PAX 0,4                                                          BSSM0157
       PXD 0,4                                                          BSSM0158
       ARS 18                                                           BSSM0159
       TZE ACLA                                                         BSSM0160
       CAS ADDRS                                                        BSSM0161
 ACLA  CLA ADDRS                                                        BSSM0162
       NOP                                                              BSSM0163
       STO ADDRS                                                        BSSM0164
       SUB S                                                            BSSM0165
       TMI TOOMCH            DATA + INSTR. WILL OVERLAP                 BSSM0166
NCARDS SXD PRTST,2           SIGNAL TO SEQ. PROGRAM CARDS               BSSM0167
       STZ LB                MAY COMPLEMENT IF 1 IS FOUND               BSSM0168
       TXI LTT,1,2           TO GET PAST LOC. + LENGTH OF               BSSM0169
 LTT   CLA TABL,1                                                       BSSM0170
       TSX CB,2              RELOCATE ENTRY POINTS IN TABLE             BSSM0171
       STA TABL,1                                                       BSSM0172
       TXI STOP,1,2                                                     BSSM0173
 STOP  TXL LTT,1,0                                                      BSSM0174
       SXD TAG,1             SAVE LENGTH OF TABLE                       BSSM0175
 M     TNX READ,0,TABL                                                  BSSM0176
 VEC   CAL TABL+1,2                                                     BSSM0177
       TNZ G3                                                           BSSM0178
       CLA TABL+2,2                                                     BSSM0179
       STA PROG                                                         BSSM0180
       TRA PASS2                                                        BSSM0181
 G3    ANA BTMASK                                                       BSSM0182
       TNZ PASS2                                                        BSSM0183
       CLA TABL+1,2                                                     BSSM0184
 OLDU  PDX 0,4               LENGTH OF VECTOR                           BSSM0185
       ARS 18                                                           BSSM0186
       ADD TABL+2,2          PLUS LOCATION OF VECTOR                    BSSM0187
       STA A                                                            BSSM0188
       STA AA                                                           BSSM0189
       STA AAA                                                          BSSM0190
       STA ABB                                                          BSSM0191
 NXTVC LXD TAG,1             LENGTH OF SYMBOL TABLE                     BSSM0192
A      CAL 0,4                                                          BSSM0193
       ANA BTMASK                                                       BSSM0194
       TZE TIXVEC                                                       BSSM0195
 ABB   CLA 0,4               LOOK FOR FIRST NAME IN TRA VECTOR          BSSM0196
NXTNAM CAS TABL+1,1          IN SYMBOL TABLE                            BSSM0197
 TTR   TTR G4                                                           BSSM0198
       TRA FIX                                                          BSSM0199
 G4    TIX NXTNAM,1,2        LOOK AT NEXT NAME IN TABLE                 BSSM0200
SAVNAM STO RB                                                           BSSM0201
       LXD TWTY,1                                                       BSSM0202
 CMPR  CLA LIST,1                                                       BSSM0203
       TZE STONAM            STORE IN FIRST EMPTY CELL                  BSSM0204
       CAS RB                IF NEW NAME                                BSSM0205
 TWTY  TNX G2,0,20                                                      BSSM0206
       TRA TIXVEC            ALREADY IN TABLE IGNORE                    BSSM0207
 G2    TIX CMPR,1,1                                                     BSSM0208
       HTR PASS2             MORE THAN 20 ENTRIES TO BE                 BSSM0209
STONAM CLA RB                SEARCHED FOR                               BSSM0210
       STO LIST,1                                                       BSSM0211
       STZ LIST+1,1                                                     BSSM0212
       TRA TIXVEC                                                       BSSM0213
 FIX   CLA TTR                                                          BSSM0214
 AA    STO 0,4                                                          BSSM0215
       CLA TABL+2,1                                                     BSSM0216
 AAA   STA 0,4                                                          BSSM0217
TIXVEC TIX NXTVC,4,1         GET NEXT NAME IN VECTOR                    BSSM0218
 PASS2 TXI TAG,2,2           IR2 IS 0 AT BEGINNING                      BSSM0219
 TAG   TXL VEC,2,0                                                      BSSM0220
       CLA TABL+1            0 IF ALL NAMES WERE FOUND                  BSSM0221
       TNZ SEARCH                                                       BSSM0222
       SWT 6                                                            BSSM0223
  SSU  TXI TXIEN,0,LIST-23                                              BSSM0224
       RCD                                                              BSSM0225
       CPY 0                                                            BSSM0226
       CPY 1                                                            BSSM0227
       TXI 0,0,400                                                      BSSM0228
 TXIEN TXI END,2,227                                                    BSSM0229
 WDR   LXD *-2,2                                                        BSSM0230
       WDR 1                                                            BSSM0231
       CPY TABL+1,2                                                     BSSM0232
       TIX *-1,2,1                                                      BSSM0233
       LXD TRCD,2            TO SET I.R. =2 BACK TO 0                   BSSM0234
       TRA PASS2             TRANSFER TO ORIGINAL TRANS. CD. LOC.       BSSM0235
SEARCH HTR READ-1                                                       BSSM0236
BTMASK OCT 700000000000                                                 BSSM0237
PRTST                                                                   BSSM0238
 S         24                                                           BSSM0239
 ZEMEM LXD SSU,2                                                        BSSM0240
       STZ LIST+1,2                                                     BSSM0241
       TIX *-1,2,1                                                      BSSM0242
       TXI ZERO+1,0,0                                                   BSSM0243
       END                                                              BSSM0244
