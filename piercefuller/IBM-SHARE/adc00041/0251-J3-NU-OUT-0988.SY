CNUOUT REM  330 10110  THIS IS THE FIRST CARD OF NU OUT GEN. OUTPT.RTNE NUOUT001
      SUBROUTINE OUTARY(DATA,TOVER,KTOVER,TSUB,KTSUB,RNAME,KRNAME,CNAME,NUOUT002
     XKCNAME,TROW,KTROW,TCOL,KTCOL,NRTOT,NR,NRSP,NCTOT,NC,NCSP,TYPE,ISC,NUOUT003
     XIWIDE,IDEC,LEN,NRPPR,NCP  ,IPAGE)                                 NUOUT004
C                      -- G. LOGEMANN                                   NUOUT005
C                                                                       NUOUT006
      DIMENSION DATA(10000),TOVER(20),TSUB(12),RNAME(2),CNAME(2),TROW(10NUOUT007
     X0),TCOL(100),          KR(4),KN(4),FMTTC( 37),FMTR( 9),     NCPG(2NUOUT008
     X),DATAS(120)                                                      NUOUT009
      DIMENSION NBR(4)                                                  NUOUT010
      DIMENSION NBKS(2),KC(2)                                           NUOUT011
C                                                                       NUOUT012
C                                                                       NUOUT013
STE   ALF   E                                                           NUOUT014
STF   ALF   F                                                           NUOUT015
STO   ALF   O                                                           NUOUT016
STI   ALF   I                                                           NUOUT017
SBEG7 ALF   (7X,                                                        NUOUT018
SEX   ALF       X                                                       NUOUT019
SCXC  ALF   ,   X,                                                      NUOUT020
SCEX  ALF   ,   X                                                       NUOUT021
SRP   ALF       (                                                       NUOUT022
SEXC  ALF       X,                                                      NUOUT023
SA6   ALF    A6                                                         NUOUT024
SEND2 ALF       ))                                                      NUOUT025
SA    ALF       A                                                       NUOUT026
SP    ALF       P                                                       NUOUT027
SDOT  ALF   .                                                           NUOUT028
SBEG1 ALF   (1H                                                         NUOUT029
SBEG2 ALF   A6,                                                         NUOUT030
STOV1 ALF   A6,A5)                                                      NUOUT031
STOV  ALF   (1H 19                                                      NUOUT032
SBKS  ALF                                                               NUOUT033
SP4   ALF   4,1H.)                                                      NUOUT034
SP3   ALF   PAGE I                                                      NUOUT035
SP2   ALF       4H                                                      NUOUT036
SP1   ALF   110X,                                                       NUOUT037
SPAGE ALF     (1H1                                                      NUOUT038
STRC3 ALF   2A6)                                                        NUOUT039
STRC2 ALF   41X,                                                        NUOUT040
STRC1 ALF   2A6,                                                        NUOUT041
STRC  ALF     (1H                                                       NUOUT042
STSU2 ALF   12A6)                                                       NUOUT043
STSU1 ALF   24X,                                                        NUOUT044
STSU  ALF      (                                                        NUOUT045
SPA   ALF   (A6)                                                        NUOUT046
SONE  ALF   1                                                           NUOUT047
C                                                                       NUOUT048
      NCPPR=NCP                                                         NUOUT049
      P1=BCD3(NCPPR-10,EXC)                                             NUOUT050
      TRC2=BCD3(XMAX0F(NCPPR/2-19,0),EXC)                               NUOUT051
      TSU1=BCD3(XMAX0F(NCPPR/2-36,0),EXC)                               NUOUT052
      NOVER=NCPPR/6                                                     NUOUT053
      NSUB=XMIN0F(NOVER,12)                                             NUOUT054
C                                                                       NUOUT055
      LTOVER=XMODF(KTOVER,3)+1                                          NUOUT056
      LTSUB=XMODF(KTSUB,3)+1                                            NUOUT057
      LTCOL=XMODF(KTCOL,3)+1                                            NUOUT058
      LTROW=XMODF(KTROW,3)+1                                            NUOUT059
      LCNAME=XMODF(KCNAME,3)+1                                          NUOUT060
      LRNAME=XMODF(KRNAME,3)+1                                          NUOUT061
      LT=(LTSUB-1)*3+LTOVER                                             NUOUT062
      KT=(LRNAME-1)*3+LCNAME                                            NUOUT063
C                                                                       NUOUT064
      NCBLK=IWIDE*NC+NCSP                                               NUOUT065
      KC(1)=1                                                           NUOUT066
      KC(2)=1                                                           NUOUT067
      GO TO (20,30,40),LTROW                                            NUOUT068
 40   KC(2)=7                                                           NUOUT069
 30   KC(1)=7                                                           NUOUT070
 20   DO 60 N=1,2                                                       NUOUT071
      NBKS(N)=(NCPPR-KC(N))/NCBLK                                       NUOUT072
      IF(NBKS(N))9000,9000,60                                           NUOUT073
 60   NCPG(N)=NBKS(N)*NC                                                NUOUT074
C                                                                       NUOUT075
      KRF=1                                                             NUOUT076
      KRS=1                                                             NUOUT077
      GO TO (90,80,80),LTOVER                                           NUOUT078
 80   KRF=4                                                             NUOUT079
 90   GO TO (110,100,100),LTSUB                                         NUOUT080
 100  KRF=KRF+4                                                         NUOUT081
 110  GO TO (130,120,120),LTCOL                                         NUOUT082
 120  KRF=KRF+2                                                         NUOUT083
 130  GO TO (180,180,150,180,180,150,150,150,140),LT                    NUOUT084
 140  KRS=4                                                             NUOUT085
      GO TO 180                                                         NUOUT086
 150  KRS=3                                                             NUOUT087
 180  GO TO (200,200,190),LTCOL                                         NUOUT088
 190  KRS=KRS+2                                                         NUOUT089
 200  KR(1)=KRF                                                         NUOUT090
      KR(3)=KRF                                                         NUOUT091
      KR(2)=KRS                                                         NUOUT092
      KR(4)=KRS                                                         NUOUT093
      KN(1)=1                                                           NUOUT094
      KN(2)=1                                                           NUOUT095
      KN(3)=1                                                           NUOUT096
      KN(4)=1                                                           NUOUT097
      GO TO (220,210,290,240,230,290,290,290,290),KT                    NUOUT098
 210  KN(2)=0                                                           NUOUT099
      GO TO 250                                                         NUOUT100
 220  KN(1)=0                                                           NUOUT101
 230  KN(2)=0                                                           NUOUT102
 240  KN(3)=0                                                           NUOUT103
 250  KN(4)=0                                                           NUOUT104
 290  NRBLK=NR+NRSP                                                     NUOUT105
      DO 300 N=1,4                                                      NUOUT106
      NBR(N)=(NRPPR-KR(N)-KN(N))/NRBLK                                  NUOUT107
      IF(NBR(N))9000,9000,300                                           NUOUT108
 300  CONTINUE                                                          NUOUT109
C                                                                       NUOUT110
 310  N3=IWIDE-6                                                        NUOUT111
      IF(N3)360,360,320                                                 NUOUT112
 320  TIN=TYPE                                                          NUOUT113
      IF(TIN-TE)322,321,322                                             NUOUT114
 321  IFLD=IDEC+5+XMAX0F(ISC,1)                                         NUOUT115
      GO TO 340                                                         NUOUT116
 322  IF(TIN-TF)330,323,330                                             NUOUT117
 323  N2=IDEC-6                                                         NUOUT118
      IF(N2)334,334,341                                                 NUOUT119
 330  IF(TIN-TI)332,334,332                                             NUOUT120
 332  IF(TIN-TO)334,333,334                                             NUOUT121
 334  N1=N3                                                             NUOUT122
      N2=0                                                              NUOUT123
      GO TO 342                                                         NUOUT124
 333  IFLD=XMIN0F(IWIDE,12)                                             NUOUT125
 340  N2=(IFLD/2)-3                                                     NUOUT126
 341  N1=N3-N2                                                          NUOUT127
 342  CONTINUE                                                          NUOUT128
C                                                                       NUOUT129
      FMTTC(3)=BCD3(NCSP+N1,EXC)                                        NUOUT130
      FMTTC(4)=A6                                                       NUOUT131
      HOLD=BCD3(N3,CXC)                                                 NUOUT132
      I2=2*(NC-1)                                                       NUOUT133
      IF(I2)9000,351,349                                                NUOUT134
 349  DO 350 I=2,I2,2                                                   NUOUT135
      FMTTC(I+3)=HOLD                                                   NUOUT136
 350  FMTTC(I+4)=A6                                                     NUOUT137
 351  FMTTC(I2+5)=BCD3(N2,CEX)                                          NUOUT138
      FMTTC(I2+6)=END2                                                  NUOUT139
      GO TO 370                                                         NUOUT140
C                                                                       NUOUT141
 360  FMTTC(3)=BCD3(NCSP,EXC)                                           NUOUT142
      FMTTC(4)=BCD3(NC,A)                                               NUOUT143
      FMTTC(5)=BCD3(IWIDE,END2)                                         NUOUT144
C                                                                       NUOUT145
 370  FMTR(1)=BEG1                                                      NUOUT146
      FMTR(3)=BCD3(ISC,P)                                               NUOUT147
      FMTR(5)=BCD3(NCSP,EXC)                                            NUOUT148
      FMTR(6)=BCD3(NC,BKS)                                              NUOUT149
      FMTR(7)=BCD3(IWIDE,TYPE)                                          NUOUT150
      FMTR(8)=BCD3(IDEC,DOT)                                            NUOUT151
      FMTR(9)=END2                                                      NUOUT152
C                                                                       NUOUT153
C                         BEGIN MAIN LOOP                               NUOUT154
C                                                                       NUOUT155
      LC=1                                                              NUOUT156
      LR=1                                                              NUOUT157
      LB=1                                                              NUOUT158
      NCF=1                                                             NUOUT159
 613  GO TO (616,614,615),LTROW                                         NUOUT160
 614  GO TO (615,616),LC                                                NUOUT161
 615  FMTTC(1)=BEG7                                                     NUOUT162
      J1=1                                                              NUOUT163
      FMTR(2)=BEG2                                                      NUOUT164
      GO TO 617                                                         NUOUT165
 616  FMTTC(1)=BEG1                                                     NUOUT166
      J1=2                                                              NUOUT167
      FMTR(2)=BKS                                                       NUOUT168
 617  J2=3-J1                                                           NUOUT169
      HOLD=BCD3(NBKS(LC),RP)                                            NUOUT170
      FMTR(4)=HOLD                                                      NUOUT171
      FMTTC(2)=HOLD                                                     NUOUT172
C                                                                       NUOUT173
 430  NCL=NCF+NCPG(LC)-1                                                NUOUT174
      NPAGE=NCPG(LC)                                                    NUOUT175
      IF(NCL-NCTOT)450,450,440                                          NUOUT176
 440  NCL=NCTOT                                                         NUOUT177
      NPAGE=NCTOT-NCF+1                                                 NUOUT178
 450  NCCF=(NCF-1)*LEN+1                                                NUOUT179
      NCCL=(NCL-1)*LEN+1                                                NUOUT180
      IR=1                                                              NUOUT181
 453  NBRDO=NBR(LB)                                                     NUOUT182
C                                                                       NUOUT183
 455  IF(IPAGE)456,456,457                                              NUOUT184
 456  CALL EXOUT(PA,ONE,1)                                              NUOUT185
      GO TO 458                                                         NUOUT186
 457  CALL EXOUT(PAGE,IPAGE,1)                                          NUOUT187
      IPAGE=IPAGE+1                                                     NUOUT188
C                                                                       NUOUT189
 458  GO TO (500,460,470),LTOVER                                        NUOUT190
C                                                                       NUOUT191
 460  GO TO (470,500),LR                                                NUOUT192
 470  CALL EXOUT(TOV,TOVER,NOVER)                                       NUOUT193
      GO TO (490,480),LR                                                NUOUT194
 480  GO TO (540,540,520),LTSUB                                         NUOUT195
 490  CALL SPACE(2)                                                     NUOUT196
C                                                                       NUOUT197
 500  GO TO (550,510,520),LTSUB                                         NUOUT198
 510  GO TO (520,550),LR                                                NUOUT199
 520  CALL EXOUT(TSU,TSUB,NSUB)                                         NUOUT200
      GO TO (530,540),LR                                                NUOUT201
 530  CALL SPACE(3)                                                     NUOUT202
      GO TO 550                                                         NUOUT203
 540  CALL SPACE(2)                                                     NUOUT204
C                                                                       NUOUT205
 550  IF(KN(LB))9000,620,560                                            NUOUT206
 560  GO TO (580,570,570),LRNAME                                        NUOUT207
 570  DATAS(1)=RNAME(1)                                                 NUOUT208
      DATAS(2)=RNAME(2)                                                 NUOUT209
      GO TO (600,590,590),LCNAME                                        NUOUT210
 580  DATAS(1)=BKS                                                      NUOUT211
      DATAS(2)=BKS                                                      NUOUT212
 590  DATAS(3)=CNAME(1)                                                 NUOUT213
      DATAS(4)=CNAME(2)                                                 NUOUT214
      GO TO 610                                                         NUOUT215
 600  DATAS(3)=BKS                                                      NUOUT216
      DATAS(4)=BKS                                                      NUOUT217
 610  CALL EXOUT(TRC,DATAS,4)                                           NUOUT218
      CALL SPACE(1)                                                     NUOUT219
 620  GO TO(701,702,703),LTCOL                                          NUOUT220
 702  GO TO (703,701),LR                                                NUOUT221
 703  CALL EXOUT(FMTTC,TCOL(NCF),NPAGE)                                 NUOUT222
      CALL SPACE(1)                                                     NUOUT223
C                                                                       NUOUT224
 701  DO 630 NBRT=1,NBRDO                                               NUOUT225
      CALL SPACE(NRSP)                                                  NUOUT226
C                                                                       NUOUT227
      DO 630 NRT=1,NR                                                   NUOUT228
      IF=IR+NCCF-1                                                      NUOUT229
      IL=IR+NCCL-1                                                      NUOUT230
      GO TO (623,621,622),LTROW                                         NUOUT231
 621  GO TO (622,623),LC                                                NUOUT232
 622  DATAS(1)=TROW(IR)                                                 NUOUT233
 623  I1=J2                                                             NUOUT234
 624  DO 625 I=IF,IL,LEN                                                NUOUT235
      DATAS(I1)=DATA(I)                                                 NUOUT236
 625  I1=I1+1                                                           NUOUT237
      CALL EXOUT(FMTR,DATAS,NPAGE+2-J1)                                 NUOUT238
      IR=IR+1                                                           NUOUT239
      IF(IR-NRTOT)630,630,650                                           NUOUT240
 630  CONTINUE                                                          NUOUT241
C                                                                       NUOUT242
      GO TO (640,455),LR                                                NUOUT243
 640  LR=2                                                              NUOUT244
      LB=LB+1                                                           NUOUT245
      GO TO 453                                                         NUOUT246
C                                                                       NUOUT247
 650  IF(NCL-NCTOT)660,670,9000                                         NUOUT248
 660  NCF=NCL+1                                                         NUOUT249
      LR=1                                                              NUOUT250
      LB=3                                                              NUOUT251
      GO TO (665,430),LC                                                NUOUT252
 665  LC=2                                                              NUOUT253
      GO TO 613                                                         NUOUT254
C                                                                       NUOUT255
C               END OF MAIN LOOP                                        NUOUT256
C                                                                       NUOUT257
 670  RETURN                                                            NUOUT258
C                                                                       NUOUT259
 9000 PRINT 9001                                                        NUOUT260
      PAUSE 70707                                                       NUOUT261
      GO TO 670                                                         NUOUT262
 9001 FORMAT(40H1ERROR IN OUTARY. PRESS START TO RETURN     /1H1)       NUOUT263
C                                                                       NUOUT264
      END(0,1,0,0,0)                                                    NUOUT265
 BCD3  REM           SPECIAL BCD FUNCTION(NUM,6H   )                    NUOUT266
       ORG 0                                                            NUOUT267
       FUL                        PROGRAM CARD                          NUOUT268
       MZE 0,0,4                  9L                                    NUOUT269
       PZE 0                      9R                                    NUOUT270
       PZE WS+1                   8L                                    NUOUT271
       PZE 0                      8R                                    NUOUT272
       BCD 1BCD3                  7L                                    NUOUT273
       PZE AA                     7R                                    NUOUT274
       ORG 0                                                            NUOUT275
       REL                                                              NUOUT276
 AA    CLA 1,4                                                          NUOUT277
       STA AB                                                           NUOUT278
       CLA 2,4                                                          NUOUT279
       STA *+1                                                          NUOUT280
       CAL **                     6H                                    NUOUT281
       ANA MSK                                                          NUOUT282
       SLW WS                                                           NUOUT283
 AB    CLA **                     NUM                                   NUOUT284
       TZE ZZ                                                           NUOUT285
       LRS 53                                                           NUOUT286
       DVP AHD                                                          NUOUT287
       STQ NHD                                                          NUOUT288
       LRS 35                                                           NUOUT289
       DVP ATN                                                          NUOUT290
       STQ NTN                                                          NUOUT291
       STA NON                                                          NUOUT292
       CLA NHD                                                          NUOUT293
       TZE AC                                                           NUOUT294
       ALS 6                                                            NUOUT295
 AD    ORA NTN                                                          NUOUT296
       ALS 6                                                            NUOUT297
 AF    ORA NON                                                          NUOUT298
       ALS 12                                                           NUOUT299
       ORS WS                                                           NUOUT300
       CLA WS                                                           NUOUT301
       TRA 3,4                                                          NUOUT302
 AC    CLA NTN                                                          NUOUT303
       TZE AE                                                           NUOUT304
       ORA SP2                                                          NUOUT305
       TRA AD+1                                                         NUOUT306
 AE    CLA SP23                                                         NUOUT307
       TRA AF                                                           NUOUT308
 ZZ    CLA SP                                                           NUOUT309
       TRA 3,4                                                          NUOUT310
 SP    BCD 1                                                            NUOUT311
 SP2   OCT 000000006000                                                 NUOUT312
 SP23  OCT 000000606000                                                 NUOUT313
 AHD   PZE 100                                                          NUOUT314
 ATN   PZE 10                                                           NUOUT315
 MSK   OCT 770000007777                                                 NUOUT316
 NHD   PZE                                                              NUOUT317
 NTN   PZE                                                              NUOUT318
 NON   PZE                                                              NUOUT319
 WS    PZE                                                              NUOUT320
       END                                                              NUOUT321
      SUBROUTINE SPACE(N)                                               NUOUT322
C                    -- G. LOGEMANN                                     NUOUT323
SBKS  ALF                                                               NUOUT324
SFMT  ALF   (1A1)                                                       NUOUT325
      DO 10 I=1,N                                                       NUOUT326
 10   CALL EXOUT(FMT,BKS,1)                                             NUOUT327
      RETURN                                                            NUOUT328
      END(0,1,0,0,0)                                                    NUOUT329
CNUOUT THIS IS THE LAST CARD OF NU OUT  GENERALIZED OUTPUT ROUTINE (SYM)NUOUT330
