C     SUBROUTINE LAGRAN                                                 LAGR 001
C      LAGRANGE INTERPOLATION USING THREE POINTS PRECEEDING GIVEN VALUE LAGR 002
C    1    AND THREE POINTS FOLLOWING GIVEN VALUE                        LAGR 003
C     PROGRAM IS LIMITED TO 250 POINTS OR 500 VALUES                    LAGR 004
C         PAIR  =NAME OF ARRAY GIVING VALUES OF POINTS FOR A GIVEN      LAGR 005
C    1           CURVE Y=F(X)                                           LAGR 006
C              POINTS LISTED IN FOLLOWING ORDER--                       LAGR 007
C              X,Y,X1,Y1,X2,Y2,ETC                                      LAGR 008
C         NPAIR =NUMBER OF POINTS GIVEN IN ARRAY                        LAGR 009
C         X     =INDEPENDENT VARIABLE                                   LAGR 010
C         ANS   =ANSWER OR DEPENDENT VARIABLE                           LAGR 011
 0005 SUBROUTINE LAGRAN(PAIR,NPAIR,X,ANS)                               LAGR 012
      DIMENSION PAIR(500),PAIR1(12)                                     LAGR 013
      XX=1.0                                                            LAGR 014
      K=(NPAIR*2)-1                                                     LAGR 015
      K3=1                                                              LAGR 016
  100 IF (K3-K)110,110,95                                               LAGR 017
  110 IF (X-PAIR(K3))10,9,130                                           LAGR 018
    9 K1=K3+1                                                           LAGR 019
      ANS=PAIR(K1)                                                      LAGR 020
      GO TO 55                                                          LAGR 021
00010 IF(K3-1)200,200,203                                               LAGR 022
00200 PRINT 201                                                         LAGR 023
  201 FORMAT(26H  SUBROUTINE LAGRAN--ERROR)                             LAGR 024
      PRINT 202                                                         LAGR 025
00202 FORMAT(94H  VALUE DETERMINED IN PROBLEM FOR INDEPENDENT VARIABLE ILAGR 026
     1S LESS THAN FIRST VALUE GIVEN IN ARRAY)                           LAGR 027
      GO TO 98                                                          LAGR 028
00203 IF (K3-5)14,11,50                                                 LAGR 029
 0011 DO 12 J=1,10                                                      LAGR 030
      PAIR1(J)=PAIR(J)/XX                                               LAGR 031
 0012 CONTINUE                                                          LAGR 032
   71 A=((X-PAIR1(3))*(X-PAIR1(5))*(X-PAIR1(7))*(X-PAIR1(9)))/          LAGR 033
     1((PAIR1(1)-PAIR1(3))*(PAIR1(1)-PAIR1(5))*(PAIR1(1)-PAIR1(7))      LAGR 034
     2*(PAIR1(1)-PAIR1(9)))*PAIR1(2)                                    LAGR 035
      A1=((X-PAIR1(1))*(X-PAIR1(5))*(X-PAIR1(7))*(X-PAIR1(9)))/         LAGR 036
     1((PAIR1(3)-PAIR1(1))*(PAIR1(3)-PAIR1(5))*(PAIR1(3)-PAIR1(7))      LAGR 037
     2*(PAIR1(3)-PAIR1(9)))*PAIR1(4)                                    LAGR 038
      A2=((X-PAIR1(1))*(X-PAIR1(3))*(X-PAIR1(7))*(X-PAIR1(9)))/         LAGR 039
     1((PAIR1(5)-PAIR1(1))*(PAIR1(5)-PAIR1(3))*(PAIR1(5)-PAIR1(7))      LAGR 040
     2*(PAIR1(5)-PAIR1(9)))*PAIR1(6)                                    LAGR 041
      A3=((X-PAIR1(1))*(X-PAIR1(3))*(X-PAIR1(5))*(X-PAIR1(9)))/         LAGR 042
     1((PAIR1(7)-PAIR1(1))*(PAIR1(7)-PAIR1(3))*(PAIR1(7)-PAIR1(5))      LAGR 043
     2*(PAIR1(7)-PAIR1(9)))*PAIR1(8)                                    LAGR 044
      A4=((X-PAIR1(1))*(X-PAIR1(3))*(X-PAIR1(5))*(X-PAIR1(7)))/         LAGR 045
     1((PAIR1(9)-PAIR1(1))*(PAIR1(9)-PAIR1(3))*(PAIR1(9)-PAIR1(5))      LAGR 046
     2*(PAIR1(9)-PAIR1(7)))*PAIR1(10)                                   LAGR 047
      IF ACCUMULATOR OVERFLOW 62,61                                     LAGR 048
 0061 A6=A+A1+A2+A3+A4                                                  LAGR 049
      ANS=A6*XX                                                         LAGR 050
      GO TO 55                                                          LAGR 051
 0014 DO 15 J=1,8                                                       LAGR 052
      PAIR1(J)=PAIR(J)/XX                                               LAGR 053
 0015 CONTINUE                                                          LAGR 054
   72 A=((X-PAIR1(3))*(X-PAIR1(5))*(X-PAIR1(7)))/((PAIR1(1)-            LAGR 055
     1PAIR1(3))*(PAIR1(1)-PAIR1(5))*(PAIR1(1)-PAIR1(7)))*PAIR1(2)       LAGR 056
      A1=((X-PAIR1(1))*(X-PAIR1(5))*(X-PAIR1(7)))/((PAIR1(3)-           LAGR 057
     1PAIR1(1))*(PAIR1(3)-PAIR1(5))*(PAIR1(3)-PAIR1(7)))*PAIR1(4)       LAGR 058
      A2=((X-PAIR1(1))*(X-PAIR1(3))*(X-PAIR1(7)))/((PAIR1(5)-           LAGR 059
     1PAIR1(1))*(PAIR1(5)-PAIR1(3))*(PAIR1(5)-PAIR1(7)))*PAIR1(6)       LAGR 060
      A3=((X-PAIR1(1))*(X-PAIR1(3))*(X-PAIR1(5)))/((PAIR1(7)-           LAGR 061
     1PAIR1(1))*(PAIR1(7)-PAIR1(3))*(PAIR1(7)-PAIR1(5)))*PAIR1(8)       LAGR 062
      IF ACCUMULATOR OVERFLOW 62,63                                     LAGR 063
 0063 A6=A+A1+A2+A3                                                     LAGR 064
      ANS=A6*XX                                                         LAGR 065
      GO TO 55                                                          LAGR 066
   50 K2=K-2                                                            LAGR 067
      IF (K3-K2)16,51,53                                                LAGR 068
 0016 DO 17 J=1,12                                                      LAGR 069
      JJ=K3-7+J                                                         LAGR 070
      PAIR1(J)=PAIR(JJ)/XX                                              LAGR 071
 0017 CONTINUE                                                          LAGR 072
      A=((X-PAIR1(3))*(X-PAIR1(5))*(X-PAIR1(7))*(X-PAIR1(9))            LAGR 073
     1*(X-PAIR1(11)))/((PAIR1(1)-PAIR1(3))*(PAIR1(1)-PAIR1(5))          LAGR 074
     2*(PAIR1(1)-PAIR1(7))*(PAIR1(1)-PAIR1(9))*(PAIR1(1)-PAIR1(11)      LAGR 075
     3))*PAIR1(2)                                                       LAGR 076
      A1=((X-PAIR1(1))*(X-PAIR1(5))*(X-PAIR1(7))*(X-PAIR1(9))           LAGR 077
     1*(X-PAIR1(11)))/((PAIR1(3)-PAIR1(1))*(PAIR1(3)-PAIR1(5))          LAGR 078
     2*(PAIR1(3)-PAIR1(7))*(PAIR1(3)-PAIR1(9))*(PAIR1(3)-PAIR1(11)      LAGR 079
     3))*PAIR1(4)                                                       LAGR 080
      A2=((X-PAIR1(1))*(X-PAIR1(3))*(X-PAIR1(7))*(X-PAIR1(9))           LAGR 081
     1*(X-PAIR1(11)))/((PAIR1(5)-PAIR1(1))*(PAIR1(5)-PAIR1(3))          LAGR 082
     2*(PAIR1(5)-PAIR1(7))*(PAIR1(5)-PAIR1(9))*(PAIR1(5)-PAIR1(11)      LAGR 083
     3))*PAIR1(6)                                                       LAGR 084
      A3=((X-PAIR1(1))*(X-PAIR1(3))*(X-PAIR1(5))*(X-PAIR1(9))           LAGR 085
     1*(X-PAIR1(11)))/((PAIR1(7)-PAIR1(1))*(PAIR1(7)-PAIR1(3))          LAGR 086
     2*(PAIR1(7)-PAIR1(5))*(PAIR1(7)-PAIR1(9))*(PAIR1(7)-PAIR1(11)      LAGR 087
     3))*PAIR1(8)                                                       LAGR 088
      A4=((X-PAIR1(1))*(X-PAIR1(3))*(X-PAIR1(5))*(X-PAIR1(7))           LAGR 089
     1*(X-PAIR1(11)))/((PAIR1(9)-PAIR1(1))*(PAIR1(9)-PAIR1(3))          LAGR 090
     2*(PAIR1(9)-PAIR1(5))*(PAIR1(9)-PAIR1(7))*(PAIR1(9)-PAIR1(11)      LAGR 091
     3))*PAIR1(10)                                                      LAGR 092
      A5=((X-PAIR1(1))*(X-PAIR1(3))*(X-PAIR1(5))*(X-PAIR1(7))           LAGR 093
     1*(X-PAIR1(9)))/((PAIR1(11)-PAIR1(1))*(PAIR1(11)-PAIR1(3)          LAGR 094
     2)*(PAIR1(11)-PAIR1(5))*(PAIR1(11)-PAIR1(7))*(PAIR1(11)-           LAGR 095
     3PAIR1(9)))*PAIR1(12)                                              LAGR 096
      IF ACCUMULATOR OVERFLOW 62,64                                     LAGR 097
 0064 A6=A+A1+A2+A3+A4+A5                                               LAGR 098
      ANS=A6*XX                                                         LAGR 099
      GO TO 55                                                          LAGR 100
 0051 DO 52 J=1,10                                                      LAGR 101
      JJ=K3-7+J                                                         LAGR 102
      PAIR1(J)=PAIR(JJ)/XX                                              LAGR 103
 0052 CONTINUE                                                          LAGR 104
      GO TO 71                                                          LAGR 105
 0053 DO 54 J=1,8                                                       LAGR 106
      JJ=K3-7+J                                                         LAGR 107
      PAIR1(J)=PAIR(JJ)/XX                                              LAGR 108
 0054 CONTINUE                                                          LAGR 109
      GO TO 72                                                          LAGR 110
 0062 XX=XX*10.0                                                        LAGR 111
      GO TO 10                                                          LAGR 112
  130 K3=K3+2                                                           LAGR 113
      GO TO 100                                                         LAGR 114
   95 PRINT 96                                                          LAGR 115
   96 FORMAT(26H  SUBROUTINE LAGRAN--ERROR)                             LAGR 116
      PRINT 97                                                          LAGR 117
00097 FORMAT(96H  VALUE DETERMINED IN PROBLEM FOR INDEPENDENT VARIABLE ILAGR 118
     1S GREATER THAN LAST VALUE GIVEN IN ARRAY)                         LAGR 119
00098 PRINT 99                                                          LAGR 120
00099 FORMAT(56H  VALUE DETERMINED IN PROBLEM FOR INDEPENDENT VARIABLE =LAGR 121
     1F14.4)                                                            LAGR 122
      PRINT 300                                                         LAGR 123
 0300 FORMAT(27H  OPERATOR STOP PROBLEM RUN)                            LAGR 124
      STOP 66666                                                        LAGR 125
 0055 RETURN                                                            LAGR 126
      END (0,1,0,0,0)                                                   LAGR 127
