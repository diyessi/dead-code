METOUT REM   30 05030                                                   TOUT0001
       REM SELF LOADING TAPE WRITE PROGRAM                              TOUT0002
       REM CORNELLI,R.                                                  TOUT0003
       SKP 0                                                            TOUT0004
 X     EQU 0                                                            TOUT0005
 READ  EQU X                                                            TOUT0006
 XFR   EQU X+63                                                         TOUT0007
       ORG X+15                                                         TOUT0008
       NOP                   DO NOT SET TRANSFER ADDRESS.               TOUT0009
       ORG XFR                                                          TOUT0010
       TNZ TAPOUT            TRANSFER CARD, GO TO TAPOUT.               TOUT0011
       ORG X+119                                                        TOUT0012
TAPOUT CLA D1                SET TO EXECUTE NEW TRANSFER CARD.          TOUT0013
       STO X+15                                                         TOUT0014
       WTB 1                 WRITE MASTER TAPE                          TOUT0015
       LXD MD1,1                                                        TOUT0016
       CPY A-1,1                                                        TOUT0017
       TIX *-1,1,1                                                      TOUT0018
       CPY A-1                                                          TOUT0019
       WEF 1                                                            TOUT0020
       REW 1                                                            TOUT0021
       TRA READ              RETURN TO LOADER.                          TOUT0022
 A     CPY A+2               SELF LOADING ROUTINE FROM TAPE.            TOUT0023
       TSX A+2,4                                                        TOUT0024
       CPY A+2,4                                                        TOUT0025
 MD1   TXI A+2,4,-1                                                     TOUT0026
 D1    STA XFR                                                          TOUT0027
       REW 1                                                            TOUT0028
       TRA READ              RETURN TO LOADER.                          TOUT0029
       END                                                              TOUT0030
