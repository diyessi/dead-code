*                                  BSF  BINARY SEARCH, FORTRAN          BSF  001
*                                  B. R. FADEN   JUNE,1960              BSF  002
*                                  ACCEPTS CALLING SEQUENCE AS FOLLOWS  BSF  003
*                                                                       BSF  004
*      TSX     BSFL,4              OR TSX     BSFA,4                    BSF  005
*      PZE     ARGUMENT                                                 BSF  006
*      PZE     ORIGIN              LOGICALLY FIRST TABLE ENTRY          BSF  007
*      PZE     LENGTH                                                   BSF  008
*      PZE     INDEX               RESULTS OF                           BSF  009
*      PZE     NONMATCH FLAG       SEARCH                               BSF  010
*                                                                       BSF  011
       ENTRY   BSFL                                                     BSF  012
*                                                                       BSF  013
       ENTRY   BSFA                                                     BSF  014
*                                                                       BSF  015
 BSFL  CAL     LOGTK               SET                                  BSF  016
       SLW     BTAK                UP                                   BSF  017
       CAL     LOGCO               FOR                                  BSF  018
       SLW     BCOMP               LOGICAL                              BSF  019
       TRA     BSF1                TAKE                                 BSF  020
*                                  AND                                  BSF  021
 LOGTK CAL*    1,4                 LOGICAL                              BSF  022
 LOGCO LAS     **,1                COMPARE                              BSF  023
*                                                                       BSF  024
*                                                                       BSF  025
 BSFA  CAL     ALGTK               SET                                  BSF  026
       SLW     BTAK                UP                                   BSF  027
       CAL     ALGCO               FOR                                  BSF  028
       SLW     BCOMP               ALGEBRAIC                            BSF  029
       TRA     BSF1                TAKE                                 BSF  030
*                                  AND                                  BSF  031
 ALGTK CLA*    1,4                 ALGEBRAIC                            BSF  032
 ALGCO CAS     **,1                COMPARE                              BSF  033
*                                                                       BSF  034
*                                                                       BSF  035
*                                                                       BSF  036
 BSF1  SXA     BS2,1               SAVE                                 BSF  037
       SXA     BS3,2               INDICES                              BSF  038
*                                                                       BSF  039
       CAL*    3,4                 PLACE LENGTH                         BSF  040
       LGR     18                   IN                                  BSF  041
       PAX     0,1                  XR1                                 BSF  042
*                                                                       BSF  043
       ACL     CONK                PLACE BINARY                         BSF  044
       FAD     CONK                CHARACTERISTIC                       BSF  045
       LGL     9                   OF LENGTH                            BSF  046
       PAX     0,2                 IN XR2                               BSF  047
*                                                                       BSF  048
       CAL     2,4                 COMPUTE TERMINAL BOUNDARY            BSF  049
       ADD     CON1                OF TABLE AND                         BSF  050
       STA     BCOMP               STORE IN BCOMP ADDRESS FIELD         BSF  051
*                                                                       BSF  052
 BTAK  CLA*    1,4                 TAKE ARGUMENT CAL*1,4 OR CLA*1,4     BSF  053
*                                                                       BSF  054
       TXI     AUG,1,1             ADD 1 TO COUNT AND BEGIN SEARCH      BSF  055
*                                                                       BSF  056
*                                                                       BSF  057
*                                                                       BSF  058
 BIX   TXI     BCOMP,2,-1          REDUCE BINARY INDEX                  BSF  059
*                                                                       BSF  060
 BCOMP CAS     **,1                COMPARE ARG TO TABLE ENTRY (TERMINAL BSF  061
*                                  BOUNDARY TAGGED BY XR1), LAS OR CAS  BSF  062
*                                                                       BSF  063
*                                                                       BSF  064
       XEC     DIMT,2              ARGUMENT HIGH, ENTRY LOW             BSF  065
       TRA     NORMX               EQUAL                                BSF  066
 AUG   XEC     AUGT,2              ARGUMENT LOW, ENTRY HIGH             BSF  067
*                                                                       BSF  068
       TXI     *-1,2,-1            BEYOND TABLE, TIX FALLS THROUGH      BSF  069
*                                                                       BSF  070
*                                                                       BSF  071
*                                                                       BSF  072
       TXI     BIX,1,16384         TABLE                                BSF  073
       TXI     BIX,1,8192          FOR                                  BSF  074
       TXI     BIX,1,4096          DIMINISHING                          BSF  075
       TXI     BIX,1,2048          EFFECTIVE                            BSF  076
       TXI     BIX,1,1024          SEARCH                               BSF  077
       TXI     BIX,1,512           ADDRESS                              BSF  078
       TXI     BIX,1,256                                                BSF  079
       TXI     BIX,1,128                                                BSF  080
       TXI     BIX,1,64                                                 BSF  081
       TXI     BIX,1,32                                                 BSF  082
       TXI     BIX,1,16                                                 BSF  083
       TXI     BIX,1,8                                                  BSF  084
       TXI     BIX,1,4                                                  BSF  085
       TXI     BIX,1,2                                                  BSF  086
       TXI     BIX,1,1                                                  BSF  087
  DIMT TXI     MISX,1,1            END DIMINISH TABLE                   BSF  088
*                                                                       BSF  089
       TIX     BIX,1,16384         TABLE                                BSF  090
       TIX     BIX,1,8192          FOR                                  BSF  091
       TIX     BIX,1,4096          AUGMENTING                           BSF  092
       TIX     BIX,1,2048          EFFECTIVE                            BSF  093
       TIX     BIX,1,1024          SEARCH                               BSF  094
       TIX     BIX,1,512           ADDRESS                              BSF  095
       TIX     BIX,1,256                                                BSF  096
       TIX     BIX,1,128                                                BSF  097
       TIX     BIX,1,64                                                 BSF  098
       TIX     BIX,1,32                                                 BSF  099
       TIX     BIX,1,16                                                 BSF  100
       TIX     BIX,1,8                                                  BSF  101
       TIX     BIX,1,4                                                  BSF  102
       TIX     BIX,1,2                                                  BSF  103
       TIX     BIX,1,1                                                  BSF  104
  AUGT TRA     MISX                END AUGMENT TABLE                    BSF  105
*                                                                       BSF  106
 MISX  CAL     CFLAG               EXIT FOR                             BSF  107
       TRA     JCN                 MISSING ENTRY                        BSF  108
*                                                                       BSF  109
 NORMX PXA     0,0                 NORMAL EXIT                          BSF  110
 JCN   SLW*    5,4                 STORE FLAG                           BSF  111
*                                                                       BSF  112
       PXD     0,1                 STORE                                BSF  113
       STO*    4,4                 ENTRY INDEX                          BSF  114
*                                                                       BSF  115
 BS2   AXT     **,1                RESTORE                              BSF  116
 BS3   AXT     **,2                INDEX REGISTERS                      BSF  117
*                                                                       BSF  118
       TRA     6,4                 RETURN TO MAIN PROGRAM               BSF  119
*                                                                       BSF  120
 CON1  OCT     1                                                        BSF  121
 CONK  OCT     66000000000                                              BSF  122
 CFLAG PZE     0,0,1                                                    BSF  123
       END                                                              BSF  124
