      DIMENSIONSIGMA(100),ZIONE(100),ZITWO(100),ZONE(100),ZTWO(100),X(2)  MSD100
     1,DELONE(100),DELTWO(100),FREONE(100),FRETWO(100),FRETR(100),VSIGMA  MSD101
     2(100),VZIONE(100),RHO(100),COVAR(100)                               MSD102
      PHIF(X)=EXPF(-X**2/2.0)/2.506629                                    MSD103
      READ2,TRLOW,TRHIGH,PA,KA,IA,I,J,CARD                                MSD104
 2    FORMAT(1P2E14.7,0PF6.6,I2,3I1,C6)                                   MSD105
      IANC=0.0                                                            MSD106
      SUMA=0.0                                                            MSD107
      SUMSQ=0.0                                                           MSD108
      READ100                                                             MSD109
 100  FORMAT(0072H                                                        MSD110
     1                  )                                                 MSD111
      CALLVARFMT                                                          MSD112
 3    READ100,X(1),X(2)                                                   MSD113
      YA=X(I)                                                             MSD114
      XA=X(J)                                                             MSD115
      IF(YA)10,5,5                                                        MSD116
 5    SUMA=(XA-TRLOW)+SUMA                                                MSD117
      IANC=1+IANC                                                         MSD118
      SUMSQ=(XA-TRLOW)**2+SUMSQ                                           MSD119
      GOTO3                                                               MSD120
 10   R=TRHIGH-TRLOW                                                      MSD121
      PRINT502,CARD,TRLOW,TRHIGH,IANC                                     MSD122
 502  FORMAT(20H1IDENTIFICATION     C6/23H LOW TRUNCATION VALUE =E15.7,2  MSD123
     18H     HIGH TRUNCATION VALUE =E15.7,18H     SAMPLE SIZE =I5/111H0   MSD124
     2I          SIGMA                MEAN              LTP            H  MSD125
     3TP            DELTA SIGMA         DELTA LTP)                        MSD126
      ANC=IANC                                                            MSD127
      DNUONE=SUMA/ANC                                                     MSD128
      DNUTWO=SUMSQ/ANC                                                    MSD129
      IF(IA)201,201,202                                                   MSD130
 201  SIGMA(1)=SQRTF(DNUTWO-DNUONE**2)                                    MSD131
      ZIONE(1)=-DNUONE/SIGMA(1)                                           MSD132
      GOTO15                                                              MSD133
 202  READ203,SIGMA(1),ZIONE(1)                                           MSD134
 203  FORMAT(1P2E14.7)                                                    MSD135
 15   DO34I=1,KA                                                          MSD136
 16   ZITWO(I)=ZIONE(I)+R/SIGMA(I)                                        MSD137
      ADEN=1.0-(ERFCF(-ZIONE(I)/SQRTF(2.0))/2.0)-(ERFCF(ZITWO(I)/SQRTF(2  MSD138
     1.0))/2.0)                                                           MSD139
 17   ZONE(I)=PHIF(ZIONE(I))/ADEN                                         MSD140
 18   ZTWO(I)=PHIF(ZITWO(I))/ADEN                                         MSD141
 19   ZC=ZONE(I)-ZTWO(I)                                                  MSD142
 20   ZD=ZC-ZIONE(I)                                                      MSD143
 21   ACFDEA=-SIGMA(I)**2*(ZD+ZIONE(I)*(-ZIONE(I)*ZC+ZC**2+(R*ZTWO(I))/S  MSD144
     1IGMA(I)-1.0)+(R/SIGMA(I))*(-(ZIONE(I)+R/SIGMA(I))*ZTWO(I)+ZONE(I)*  MSD145
     2ZTWO(I)-ZTWO(I)**2))                                                MSD146
 22   ACFDEB=SIGMA(I)**2*((-ZIONE(I)*R*ZTWO(I))/(SIGMA(I)**2)*(ZD-R/SIGM  MSD147
     1A(I))-((R**2*ZTWO(I))/(SIGMA(I)**3)*(ZIONE(I)+R/SIGMA(I)+ZTWO(I)))  MSD148
     2+(R*ZTWO(I))/SIGMA(I)**2)+2.0*SIGMA(I)*(1.0-ZIONE(I)*ZD-(ZTWO(I)*R  MSD149
     3)/SIGMA(I))                                                         MSD150
 23   ACONST=-(SIGMA(I)**2)*(1.0-ZIONE(I)*ZD-ZTWO(I)*(R/SIGMA(I)))+DNUTW  MSD151
     1O                                                                   MSD152
 24   BCFDEA=-SIGMA(I)*(ZIONE(I)*ZC-ZC**2-(R*ZTWO(I))/SIGMA(I)+1.0)       MSD153
 25   BCFDEB=((R*ZTWO(I))/SIGMA(I))*(ZD-R/SIGMA(I))+ZD                    MSD154
 26   BCONST=-SIGMA(I)*ZD+DNUONE                                          MSD155
 27   DENOM=ACFDEA*BCFDEB-BCFDEA*ACFDEB                                   MSD156
 28   DELONE(I)=(ACONST*BCFDEB-BCONST*ACFDEB)/DENOM                       MSD157
 29   DELTWO(I)=(ACFDEA*BCONST-BCFDEA*ACONST)/DENOM                       MSD158
 30   ZIONE(I+1)=ZIONE(I)+DELONE(I)                                       MSD159
 31   SIGMA(I+1)=SIGMA(I)+DELTWO(I)                                       MSD160
      ZMEAN=TRLOW-ZIONE(I)*SIGMA(I)                                       MSD161
      PRINT500,I,SIGMA(I),ZMEAN,ZIONE(I),ZITWO(I),DELTWO(I),DELONE(I)     MSD162
 500  FORMAT(1H I2,1P2E20.7,0P2F15.6,1P2E20.7)                            MSD163
      IF(ABSF(DELONE(I))-PA)35,35,34                                      MSD164
 34   CONTINUE                                                            MSD165
 35   ZMEAN=TRLOW-ZIONE(I+1)*SIGMA(I+1)                                   MSD166
      ZITWO(I+1)=ZIONE(I+1)+R/SIGMA(I+1)                                  MSD167
      I=I+1                                                               MSD168
      ADEN=1.0-(ERFCF(-ZIONE(I)/SQRTF(2.0))/2.0)-(ERFCF(ZITWO(I)/SQRTF(2  MSD169
     1.0))/2.0)                                                           MSD170
      ZONE(I)=PHIF(ZIONE(I))/ADEN                                         MSD171
      ZTWO(I)=PHIF(ZITWO(I))/ADEN                                         MSD172
 300  FREONE(I)=-(1.0+ZIONE(I)*ZONE(I)-ZITWO(I)*ZTWO(I)-ZC**2)            MSD173
 301  FRETWO(I)=((R*ZTWO(I))/SIGMA(I))*(ZC-ZITWO(I))+ZD                   MSD174
 302  FRETR(I)=(R/SIGMA(I))**2*ZTWO(I)*(ZTWO(I)+ZITWO(I))-(2.0-ZIONE(I)*  MSD175
     1ZD-(ZTWO(I)*R)/SIGMA(I))                                            MSD176
 303  FC=FREONE(I)*FRETR(I)                                               MSD177
 304  VSIGMA(I)=(SIGMA(I)**2/ANC)*(-FREONE(I)/(FC-FRETWO(I)**2))          MSD178
 305  VZIONE(I)=(1.0/ANC)*(-FRETR(I)/(FC-FRETWO(I)**2))                   MSD179
 306  RHO(I)=FRETWO(I)/SQRTF(FC)                                          MSD180
      COVAR(I)=RHO(I)*SQRTF(VSIGMA(I)*VZIONE(I))                          MSD181
      PRINT500,I,SIGMA(I),ZMEAN,ZIONE(I),ZITWO(I)                         MSD182
      PRINT501,VSIGMA(I),VZIONE(I),COVAR(I),RHO(I)                        MSD183
 501  FORMAT(20H0VARIANCE OF SIGMA =1PE15.7,22H     VARIANCE OF LTP =E15  MSD184
     1.7/13H COVARIANCE =E15.7,10H     RHO =0PF10.8)                      MSD185
      CALL ENDJOB                                                         MSD186
      END                                                                 MSD187
