3             J N BROOKS                 648.02                         CSI1 001
      SUBROUTINE CSINT (XX,CI,SI)                                       CSI1 002
 5001 DIMENSION  A0(4),A2(4),A4(4),A6(4),QP(4)                          CSI1 003
      X = ABSF(XX)                                                      CSI1 004
    5 M=1                                                               CSI1 005
    6 MM=1                                                              CSI1 006
    7 IF (X-18.0)      400,4,4                                          CSI1 007
    4 POFX=0.0                                                          CSI1 008
      QOFX=0.0                                                          CSI1 009
      POLD=0.0                                                          CSI1 010
      QOLD=0.0                                                          CSI1 011
      SIGN = +1.0                                                       CSI1 012
      ERROR = 1.0 E -8                                                  CSI1 013
   20 DO 40   N=1,15                                                    CSI1 014
      NN=2*N-2                                                          CSI1 015
      NNN=NN+1                                                          CSI1 016
      BN=2*N                                                            CSI1 017
      CN=BN-1.0                                                         CSI1 018
   21 IF  (M)     30 ,22, 22                                            CSI1 019
   22 POFX = POLD + SIGN*TOR(NN)/X**CN                                  CSI1 020
   24 IF (ABSF(ABSF(POLD/POFX)-1.0)-ERROR)   25, 25,26                  CSI1 021
   25  M=-1                                                             CSI1 022
      GO TO 30                                                          CSI1 023
   26 POLD=POFX                                                         CSI1 024
   30 IF (MM)    35,31 ,31                                              CSI1 025
   31 QOFX = QOFX + SIGN*TOR(NNN)/X**BN                                 CSI1 026
   33 IF (ABSF(ABSF(QOLD/QOFX)-1.0)-ERROR)    34, 34, 36                CSI1 027
   34 MM = -1                                                           CSI1 028
   35 IF (M) 41,40,40                                                   CSI1 029
   36 QOLD = QOFX                                                       CSI1 030
   40 SIGN = -SIGN                                                      CSI1 031
   41 SI=1.5707963-POFX*COSF(X)-QOFX*SINF(X)                            CSI1 032
   42 CI=POFX*SINF(X)-QOFX*COSF(X)                                      CSI1 033
      GO TO 500                                                         CSI1 034
  400 IF (X)  401,402,409                                               CSI1 035
  401 STOP 401                                                          CSI1 036
  402 SI=0.0                                                            CSI1 037
  403 CI=-9.99E+30                                                      CSI1 038
  404 RETURN                                                            CSI1 039
  409 IF (X-1.0)  410,5002,5002                                         CSI1 040
  410 P = X                                                             CSI1 041
      PP = X**2                                                         CSI1 042
      PPP = PP**2                                                       CSI1 043
      SI = X*(1.0-PP/18.0)                                              CSI1 044
  411 Q = 0.5*PP                                                        CSI1 045
      CI = 0.57721567 + LOGF(X) + 0.25*PP*(-1.0+PP/24.0)                CSI1 046
   55 ERROR =  1.0 E  -15                                               CSI1 047
  420 DO 440 N =2,50                                                    CSI1 048
      AN = N                                                            CSI1 049
      BN = 2.0*AN                                                       CSI1 050
      CN = BN*2.0                                                       CSI1 051
  421 IF (M) 430,422,422                                                CSI1 052
  422 P = P*PPP/((CN-3.0)*(CN-4.0)*(CN-5.0)*(CN-6.0))                   CSI1 053
      TERM = P*(1.0/(CN-3.0)-PP/(((CN-1.0)**2)*(CN-2.0)))               CSI1 054
       IF (ABSF(TERM)-ERROR)   425,425,424                              CSI1 055
  424 SI = SI + TERM                                                    CSI1 056
      GO TO 430                                                         CSI1 057
  425 M=-1                                                              CSI1 058
  430 IF (MM)  435,431,431                                              CSI1 059
  431 Q = Q*PPP/((CN-2.0)*(CN-3.0)*(CN-4.0)*(CN-5.0))                   CSI1 060
      TERM = -Q*(1.0/(CN-2.0)-PP/((CN-1.0)*CN**2))                      CSI1 061
      IF (ABSF(TERM) - ERROR )  434,434,433                             CSI1 062
  433 CI = CI + TERM                                                    CSI1 063
      GO TO 435                                                         CSI1 064
  434 MM=-1                                                             CSI1 065
  435 IF (M)   500,440,440                                              CSI1 066
  440 CONTINUE                                                          CSI1 067
  500 IF(XX)  501,503,503                                               CSI1 068
  501 SI=-SI                                                            CSI1 069
  503 RETURN                                                            CSI1 070
 5002 A0(1)=38.102495                                                   CSI1 071
      A2(1)=335.67732                                                   CSI1 072
      A4(1)=265.18703                                                   CSI1 073
      A6(1)=38.027264                                                   CSI1 074
      A0(2)=157.10542                                                   CSI1 075
      A2(2)=570.23628                                                   CSI1 076
      A4(2)=322.62491                                                   CSI1 077
      A6(2)=40.021433                                                   CSI1 078
      A0(3)=21.821899                                                   CSI1 079
      A2(3)=352.01850                                                   CSI1 080
      A4(3)=302.75787                                                   CSI1 081
      A6(3)=42.242855                                                   CSI1 082
      A0(4)=449.69033                                                   CSI1 083
      A2(4)=1114.9789                                                   CSI1 084
      A4(4)=482.48598                                                   CSI1 085
      A6(4)=48.196927                                                   CSI1 086
 5005 XSQ=X**2                                                          CSI1 087
      REC=1.0/XSQ                                                       CSI1 088
 5006 DO 5007 I=1,4                                                     CSI1 089
 5007 QP(I)=REC*(REC*(REC*A0(I)+A2(I))+A4(I))+A6(I)+XSQ                 CSI1 090
 5008 P = QP(1)/(QP(2)*X)                                               CSI1 091
      Q = QP(3)*REC/QP(4)                                               CSI1 092
 5009 CC = COSF(X)                                                      CSI1 093
      SS = SINF(X)                                                      CSI1 094
 5010 SI = 1.5707963 -P*CC-Q*SS                                         CSI1 095
      CI = P*SS-Q*CC                                                    CSI1 096
 5011 GO TO 500                                                         CSI1 097
      END (0,1,0,1,0)                                                   CSI1 098
