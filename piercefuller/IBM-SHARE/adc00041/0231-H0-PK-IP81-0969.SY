 FINAL SYN *                                                            IP810435
       END SLCTN                                                        IP810436
      SUBROUTINE NURO                                                   IP810437
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP810438
     1,KC1,BND,ALPHA                                                    IP810439
      DIMENSION A(77,37),LT(37),B(37),KC(37),JORDER(37),JZEROS(37),KR(77IP810440
     1),U(77),D(77),INDEX(77),ALPHA(3)                                  IP810441
      BMAX=0.0                                                          IP810442
      UMAX=1.0                                                          IP810443
      DO 5 J=2,N                                                        IP810444
      IF (B(J))12,5,5                                                   IP810445
   12 IF (J-J1)3,4,3                                                    IP810446
    4 U(J)=1.0                                                          IP810447
      GO TO 7                                                           IP810448
    3 JZ1=JZEROS(J)+2                                                   IP810449
      IF (A(JZ1-1,J1))999,5,10                                          IP810450
  999 STOP 61                                                           IP810451
   10 UU=A(JZ1-1,J)/A(JZ1-1,J1)                                         IP810452
      U(J)=INTF(UU)                                                     IP810453
      IF (UU-U(J))997,6,7                                               IP810454
  997 STOP 63                                                           IP810455
    6 DO 8 II=JZ1,M1                                                    IP810456
      IF (A(II,J)-A(II,J1)*U(J))9,8,7                                   IP810457
    8 CONTINUE                                                          IP810458
      STOP 62                                                           IP810459
    9 U(J)=U(J)-1.0                                                     IP810460
    7 IF (BMAX*U(J)-UMAX*B(J))5,5,11                                    IP810461
   11 UMAX=U(J)                                                         IP810462
      BMAX=B(J)                                                         IP810463
    5 CONTINUE                                                          IP810464
      DO 20 J=1,N                                                       IP810465
      BB=-(B(J)*UMAX)/BMAX                                              IP810466
      B(J)=INTF(BB)                                                     IP810467
      IF (BB-B(J))24,20,20                                              IP810468
   24 B(J)=B(J)-1.0                                                     IP810469
   20 CONTINUE                                                          IP810470
      RETURN                                                            IP810471
      END (0,1,0,0,0)                                                   IP810472
       FUL                                                              IP810473
       MZE 0,0,324                                                      IP810474
       PZE                                                              IP810475
       PZE FINAL,,0                                                     IP810476
       PZE 29207                                                        IP810477
       BCD 1PIV                                                         IP810478
       PZE PIV                                                          IP810479
       ORG                                                              IP810480
       REL                                                              IP810481
 STX   HTR                                                              IP810482
       HTR                                                              IP810483
       HTR                                                              IP810484
