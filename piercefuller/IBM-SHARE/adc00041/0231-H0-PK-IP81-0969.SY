       TIX ST8,4,1                                                      IP810561
       TIX ST10,1,1                                                     IP810562
 ST2   LXD STX,1          RETURN                                        IP810563
       LXD STX+1,2        RESTORE XRS                                   IP810564
       LXD STX+2,4                                                      IP810565
       TRA 1,4                                                          IP810566
 D2    PZE ,,2                                                          IP810567
 A200  HTR MDIM                                                         IP810568
 ZERO  PZE                                                              IP810569
 F1    DEC 1.0                                                          IP810570
 NF1   DEC -1.0                                                         IP810571
       BSS 36                                                           IP810572
 XR    PZE                                                              IP810573
 K     PZE                                                              IP810574
 ADA   HTR A+1                                                          IP810575
 A     SYN 32562                                                        IP810576
 LT    SYN 29713                                                        IP810577
 B     SYN 29676                                                        IP810578
 INDEX SYN 29297                                                        IP810579
 N     SYN 29219                                                        IP810580
 J1    SYN 29218                                                        IP810581
 NUM   SYN 29216                                                        IP810582
 M1    SYN 29215                                                        IP810583
 MDIM  EQU 77                                                           IP810584
 FINAL SYN *                                                            IP810585
       END PIV                                                          IP810586
