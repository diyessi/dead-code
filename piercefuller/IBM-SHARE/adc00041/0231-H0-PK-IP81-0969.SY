       SXD STX+1,2                                                      IP810486
       SXD STX+2,4                                                      IP810487
       LXD NUM,1                                                        IP810488
       TXH ST9,1,1                                                      IP810489
       CLA N                                                            IP810490
       STD LOCM                                                         IP810491
       LXD D2,1           SET UP COL TOP INDICES                        IP810492
       PXD ,0                                                           IP810493
 ST1   ADD A200                                                         IP810494
       STO XR+1,1                                                       IP810495
       TXI *+1,1,1                                                      IP810496
 LOCM  TXL ST1,1,**       DECREMENT N                                   IP810497
 ST9   LXD ZERO,2                                                       IP810498
       LXD J1,1                                                         IP810499
       STZ B+1,1          SET B(J1)=0                                   IP810500
       CLS NUM                                                          IP810501
       STO LT+1,1         LT(J1)=-NUM                                   IP810502
       CLS XR+1,1                                                       IP810503
       ADD ADA                                                          IP810504
       STA LOCB                                                         IP810505
       STA LOCC                                                         IP810506
       STA LOCD                                                         IP810507
       STA LOCE                                                         IP810508
       LXD M1,1                                                         IP810509
 LOCE  CLA **,1           ADDRESS IS TOP OF PIVOT COL                   IP810510
       TZE ST11                                                         IP810511
       TXI *+1,2,1        XR2 COUNTS NON-ZERO PIVOT COL ENTRIES         IP810512
       PXD ,1                                                           IP810513
       STO INDEX+1,2                                                    IP810514
 ST11  TIX LOCE,1,1                                                     IP810515
       SXD K,2                                                          IP810516
       LXD N,1            XR1 COUNTS COLS J                             IP810517
 ST10  LXD K,4            XR4 INDEXES NON-ZERO ROWS IN PIVOT COL        IP810518
       CLA B+1,1                                                        IP810519
       TZE ST2-1          B(J)=0 HENCE SKIP COL                         IP810520
       CAS F1                                                           IP810521
       TRA ST3            B(J) NOT 0,+1,-1                              IP810522
       TRA ST4            B(J)=+1                                       IP810523
       CAS NF1                                                          IP810524
       HTR *,,81          B(J) TAKES ILLEGAL VALUE                      IP810525
       TRA ST5            B(J)=-1                                       IP810526
 ST3   CLS XR+1,1         B(J) NOT 0,+1,-1                              IP810527
       ADD ADA                                                          IP810528
       STA LOCF                                                         IP810529
       STA LOCG                                                         IP810530
 ST6   CLA INDEX+1,4                                                    IP810531
       PDX ,2             XR2 CONTAINS ROW I                            IP810532
 LOCB  LDQ **,2           ADDRESS IS TOP OF PIVOT COL                   IP810533
       FMP B+1,1                                                        IP810534
 LOCF  FAD **,2           ADDRESS IS TOP OF JTH COL                     IP810535
