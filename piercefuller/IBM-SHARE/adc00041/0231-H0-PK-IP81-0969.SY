C     LINEAR PROGRAMMING,INTEGER SOLUTIONS,S6-1 CODE                  PKIP810001
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP810002
     1,KC1,BND,ALPHA                                                    IP810003
      DIMENSION A(77,37),LT(37),B(37),KC(37),JORDER(37),JZEROS(37),KR(77IP810004
     1),U(77),D(77),INDEX(77),ALPHA(3)                                  IP810005
      LLL=1                                                             IP810006
   26 IF (LLL) 160,160,170                                              IP810007
  144 PRINT 154, ALPHA                                                  IP810008
      PAUSE 6                                                           IP810009
  170 IF (SENSE SWITCH 3) 1,2                                           IP810010
    1 READ 3,ALPHA,M,N,BND,LL2,LL3,LL6,LL7,LL8,LLB,LL4,LL5              IP810011
      GO TO 4                                                           IP810012
    2 READ INPUT TAPE 7,3,ALPHA,M,N,BND,LL2,LL3,LL6,LL7,LL8,LLB,LL4,LL5 IP810013
    4 IF (M)160,160,161                                                 IP810014
  160 END FILE 8                                                        IP810015
      PRINT 155                                                         IP810016
      STOP                                                              IP810017
  161 K2=-1                                                             IP810018
      PRINT 152,LLL,ALPHA                                               IP810019
      LLL=LLL+1                                                         IP810020
      NUM=0                                                             IP810021
      LI3=LL3                                                           IP810022
      LL3=LL3-1                                                         IP810023
      LI6=LL6                                                           IP810024
      LI7=LL7                                                           IP810025
      LI8=LL8                                                           IP810026
      NN=N-1                                                            IP810027
      WRITE OUTPUT TAPE 8,5,ALPHA                                       IP810028
      CALL SETUP                                                        IP810029
      IF (LL4)28,28,29                                                  IP810030
   28 CALL MOUT                                                         IP810031
   29 IF (BND)25,25,31                                                  IP810032
   31 CALL DUFS                                                         IP810033
      IF (LLB) 172,172,25                                               IP810034
  172 WRITE OUTPUT TAPE 8,132                                           IP810035
    6 CALL MOUT                                                         IP810036
   25 DO 100 J=2,N                                                      IP810037
      DO 101 I=1,M1                                                     IP810038
      IF (A(I,J))999,101,100                                            IP810039
  999 STOP 1                                                            IP810040
  101 CONTINUE                                                          IP810041
      STOP 2                                                            IP810042
  100 JZEROS(J)=I-1                                                     IP810043
      IF (LL3-NUM)9,8,9                                                 IP810044
    8 CALL SLCTN                                                        IP810045
      LL3=LL3+LI3                                                       IP810046
      GO TO 10                                                          IP810047
    9 CALL SLCTR                                                        IP810048
   10 IF (K2)11,12,998                                                  IP810049
  998 STOP 3                                                            IP810050
   11 NUM=NUM+1                                                         IP810051
      CALL NURO                                                         IP810052
      IF (LL7-NUM)13,14,13                                              IP810053
   14 LL7=LL7+LI7                                                       IP810054
      WRITE OUTPUT TAPE 8,15,NUM,I1,J1                                  IP810055
      WRITE OUTPUT TAPE 8,16,(B(J),J=1,N)                               IP810056
   13 CALL PIV                                                          IP810057
      IF (SENSE SWITCH 1)37,38                                          IP810058
   37 PRINT 19,NUM,A(1,1),A(2,1),A(3,1)                                 IP810059
   38 IF (LL8-NUM)18,17,18                                              IP810060
   17 LL8=LL8+LI8                                                       IP810061
      WRITE OUTPUT TAPE 8,19,NUM,A(1,1),A(2,1),A(3,1)                   IP810062
   18 IF (SENSE SWITCH 2) 171,30                                        IP810063
   30 IF (LL2-NUM)20,21,20                                              IP810064
   20 IF (LL6-NUM)25,22,25                                              IP810065
   22 LL6=LL6+LI6                                                       IP810066
      GO TO 6                                                           IP810067
  171 PRINT 153                                                         IP810068
      PAUSE 2                                                           IP810069
   21 WRITE OUTPUT TAPE 8,23,NUM                                        IP810070
   34 IF (LL5)32,32,33                                                  IP810071
   33 WRITE OUTPUT TAPE 8,35,ALPHA,A(1,1)                               IP810072
      WRITE OUTPUT TAPE 8,36,(I,A(I,1),I=2,M1)                          IP810073
   41 IF (K2)43,26,998                                                  IP810074
   43 IF (SENSE SWITCH 6) 40,26                                         IP810075
   40 CALL SAVCOR (1)                                                   IP810076
      IF (SENSE SWITCH 6) 144,142                                       IP810077
  142 LLL=0                                                             IP810078
      WRITE OUTPUT TAPE 8,156,ALPHA,NUM                                 IP810079
      GO TO 20                                                          IP810080
   32 CALL MOUT                                                         IP810081
      GO TO 41                                                          IP810082
   12 WRITE OUTPUT TAPE 8,27,NUM                                        IP810083
      GO TO 34                                                          IP810084
    3 FORMAT (3A6,2I3,F6.0,I6,7I3)                                      IP810085
    5 FORMAT (8H1START  3A6)                                            IP810086
   15 FORMAT (10H0PIVOT ROWI5,9H FROM ROWI5,14H, PIVOT COLUMNI5/1H )    IP810087
   16 FORMAT (1H06X,14F8.0)                                             IP810088
   19 FORMAT (6H0PIVOTI5,24H, CONSTANT COLUMN BEGINS3F8.0)              IP810089
   23 FORMAT (21H0SOLUTION INCOMPLETE,I5,7H PIVOTS)                     IP810090
   27 FORMAT (10H0SOLUTION,I5,7H PIVOTS)                                IP810091
   35 FORMAT (28H1CONSTANT COLUMN OF MATRIX, 3A6/8H0ROW   15X,F10.0)    IP810092
   36 FORMAT (1H I7,5X,F10.0)                                           IP810093
  132 FORMAT (78H0PROBLEM IS NOT DUAL FEASIBLE. MATRIX WILL BE REWRITTENIP810094
     1 IN FEASIBLE FORM BELOW)                                          IP810095
  152 FORMAT (14H0BEGIN PROBLEMI3,2H, 3A6)                              IP810096
  153 FORMAT (33H0PUT SENSE SWITCH 2 UP. HIT START)                     IP810097
  154 FORMAT (9H0PROBLEM 3A6,93H HAS BEEN DUMPED. IF MORE PROBLEMS ARE TIP810098
     1O BE PROCESSED, CHANGE TAPE 1 IF ANY IS TO BE DUMPED./32H OTHERWISIP810099
     2E PUT SENSE SWITCH 6 UP)                                          IP810100
  155 FORMAT (32H0LAST PROBLEM HAS BEEN PROCESSED)                      IP810101
  156 FORMAT (17H1RESTART PROBLEM 3A6,6H AFTERI5,7H PIVOTS)             IP810102
      END (0,1,0,0,1)                                                   IP810103
      SUBROUTINE SETUP                                                  IP810104
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP810105
     1,KC1,BND,ALPHA                                                    IP810106
      DIMENSION A(77,37),LT(37),B(37),KC(37),JORDER(37),JZEROS(37),KR(77IP810107
     1),U(77),D(77),INDEX(77),ALPHA(3)                                  IP810108
      M1=M+NN                                                           IP810109
      DO 5 J=1,N                                                        IP810110
      DO 5 I=1,M1                                                       IP810111
    5 A(I,J)=0.0                                                        IP810112
      IF (SENSE SWITCH 3)6,7                                            IP810113
    6 READ 3,I,J,AA                                                     IP810114
      IF (I)999,10,4                                                    IP810115
  999 STOP 1                                                            IP810116
    4 A(I,J)=AA                                                         IP810117
      GO TO 6                                                           IP810118
    7 READ INPUT TAPE 7,3,I,J,AA                                        IP810119
      IF (I)999,10,11                                                   IP810120
   11 A(I,J)=AA                                                         IP810121
      GO TO 7                                                           IP810122
   10 I=M+1                                                             IP810123
      DO 12 J=2,N                                                       IP810124
      A(I,J)=-1.0                                                       IP810125
      LT(J)=I                                                           IP810126
   12 I=I+1                                                             IP810127
      LT(1)=0                                                           IP810128
      RETURN                                                            IP810129
    3 FORMAT (2I5,F10.5)                                                IP810130
      END (0,1,0,0,0)                                                   IP810131
      SUBROUTINE MOUT                                                   IP810132
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP810133
     1,KC1,BND,ALPHA                                                    IP810134
      DIMENSION A(77,37),LT(37),B(37),KC(37),JORDER(37),JZEROS(37),KR(77IP810135
     1),U(77),D(77),INDEX(77),ALPHA(3)                                  IP810136
      LB=1                                                              IP810137
      LO=1                                                              IP810138
      MX=14                                                             IP810139
   11 K=1                                                               IP810140
      MX=XMIN0F(N,MX)                                                   IP810141
      LL=1                                                              IP810142
      LU=56                                                             IP810143
    8 LU=XMIN0F(M1,LU)                                                  IP810144
      WRITE OUTPUT TAPE 8,3,K,LB,M1,N,ALPHA,(LT(J),J=LO,MX)             IP810145
      WRITE OUTPUT TAPE 8,7                                             IP810146
      DO 12 I=LL,LU                                                     IP810147
   12 WRITE OUTPUT TAPE 8,4,I,(A(I,J),J=LO,MX)                          IP810148
      IF (M1-LU)999,5,6                                                 IP810149
  999 STOP 1                                                            IP810150
    6 LL=LU+1                                                           IP810151
      LU=LU+56                                                          IP810152
      K=K+1                                                             IP810153
      GO TO 8                                                           IP810154
    5 IF (N-MX)999,9,10                                                 IP810155
   10 LO=MX+1                                                           IP810156
      MX=MX+14                                                          IP810157
      LB=LB+1                                                           IP810158
      GO TO 11                                                          IP810159
    9 RETURN                                                            IP810160
    3 FORMAT (12H1SUBMATRIX (I1,1H,I1,4H) OFI3,2H XI3,7H MATRIX65X,3A6/1IP810161
     1H04X,6HCOLUMNI4,13I8)                                             IP810162
    7 FORMAT (4H ROW)                                                   IP810163
    4 FORMAT (1H I3,3X,14F8.0)                                          IP810164
      END (0,1,0,0,0)                                                   IP810165
      SUBROUTINE DUFS                                                   IP810166
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP810167
     1,KC1,BND,ALPHA                                                    IP810168
      DIMENSION A(77,37),LT(37),B(37),KC(37),JORDER(37),JZEROS(37),KR(77IP810169
     1),U(77),D(77),INDEX(77),ALPHA(3)                                  IP810170
      JMIN=2                                                            IP810171
      DO 3 J=3,N                                                        IP810172
      I=1                                                               IP810173
    5 IF (A(I,J)-A(I,JMIN))6,4,3                                        IP810174
    4 I=I+1                                                             IP810175
      IF (I-M1)5,5,999                                                  IP810176
  999 STOP 31                                                           IP810177
    6 JMIN=J                                                            IP810178
    3 CONTINUE                                                          IP810179
      DO 7 I=1,M1                                                       IP810180
      U(I)=-(A(I,JMIN))                                                 IP810181
    7 A(I,JMIN)=-(A(I,JMIN))                                            IP810182
      DO 8 J=2,N                                                        IP810183
      I=1                                                               IP810184
   11 IF (A(I,J))9,10,8                                                 IP810185
   10 I=I+1                                                             IP810186
      IF (I-M1)11,11,998                                                IP810187
  998 STOP 32                                                           IP810188
    9 DO 12  I=1,M1                                                     IP810189
   12 A(I,J)=A(I,J)+U(I)                                                IP810190
    8 CONTINUE                                                          IP810191
      DO 13 I=1,M1                                                      IP810192
   13 A(I,1)=A(I,1)+BND*U(I)                                            IP810193
      RETURN                                                            IP810194
      END (0,1,0,0,0)                                                   IP810195
