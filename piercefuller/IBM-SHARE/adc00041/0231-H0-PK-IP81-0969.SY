       TIX ST6,4,1                                                      IP810537
       TIX ST10,1,1                                                     IP810538
       TRA ST2                                                          IP810539
 ST4   CLS XR+1,1         B(J)=+1                                       IP810540
       ADD ADA                                                          IP810541
       STA LOCH                                                         IP810542
       STA LOCJ                                                         IP810543
 ST7   CLA INDEX+1,4                                                    IP810544
       PDX ,2                                                           IP810545
 LOCC  CLA **,2           ADDRESS IS TOP OF PIVOT COL                   IP810546
 LOCH  FAD **,2           ADDRESS IS TOP OF JTH COL                     IP810547
 LOCJ  STO **,2           SAME                                          IP810548
       TIX ST7,4,1                                                      IP810549
       TIX ST10,1,1                                                     IP810550
       TRA ST2                                                          IP810551
 ST5   CLS XR+1,1                                                       IP810552
       ADD ADA                                                          IP810553
