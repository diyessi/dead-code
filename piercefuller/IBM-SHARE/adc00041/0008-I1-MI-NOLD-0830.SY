       REM FORTRAN LOADER'DIAGNOSTIC ROUTINE                      (NOLD)MINLD001
       REM DECEMBER 22, 1959                                            MINLD002
       REM PROGRAM CARD                                                 MINLD003
       ORG 0                                                            MINLD004
       ABS                                                              MINLD005
A      HED                                                              MINLD006
       MZE END-BEGIN,,0                8L PROGRAM LENGTH                MINLD007
       PZE                   8R NO COMMON REQUIRED                      MINLD008
       BCD 1(NOLD)                     7L, NAME                         MINLD009
       PZE ENTRY             7R PSUEDO-ENTRY POINT                      MINLD010
       BCD 1(WOT)            6L ENTRY FOR OTHER DIAGNOSTIC PROGRAMS     MINLD011
       PZE B$WOT             6R                                         MINLD012
       REM END OF PROGRAM CARD                                          MINLD013
       REL                                                              MINLD014
       ORG 0                                                            MINLD015
 BEGIN SYN *                                                            MINLD016
B      HED                                                              MINLD017
       REM MODIFIED UASPH1 SO THAT NO TAPES AND SENSE SWITCH INDEPENDENTMINLD018
       REM OCCUPIES 97 LOCATIONS AND USES 33 COMMON                     MINLD019
 WOT   WPR                SELECT PRINTER                                MINLD020
       SXD X1,1                                                         MINLD021
       SXD X2,2                                                         MINLD022
       SXD X4,4                                                         MINLD023
       CAL 1,4                                                          MINLD024
       PAX 0,4                                                          MINLD025
       ARS 18                                                           MINLD026
       ADD X4                                                           MINLD027
       STA PR2                                                          MINLD028
       STA CI9                                                          MINLD029
       SXD *+2,4                                                        MINLD030
       LXA PR2,4                                                        MINLD031
       TNX WT2,4,**                                                     MINLD032
       SXD PR6,4                                                        MINLD033
       CLA BLNKS          FIND LAST NON-BLANK                           MINLD034
       LXD CI4,4          GROUP                                         MINLD035
 PR2   CAS 0,4            X                                             MINLD036
       TXI PR1,4,-1                                                     MINLD037
       TXI PR2,4,1        X                                             MINLD038
       TXI PR1,4,-1                                                     MINLD039
 PR1   SXD CI6,4          STORE END TEST                                MINLD040
       SXD CI8,4          X                                             MINLD041
       SXD PR8,4                                                        MINLD042
       SXD WP4,4                                                        MINLD043
       LXD PR6,4                                                        MINLD044
 PR8   TNX PR5,4                                                        MINLD045
       TXL PR3,4,12                                                     MINLD046
       SPR 8                                                            MINLD047
 PR3   LXD PR6,4          INITIALIZE GROUP COUNT                        MINLD048
 PR5   LXA PR7,2          INITIALIZE LEFT SETUP                         MINLD049
       LXD YZ1,1          CLEAR CARD IMAGE                              MINLD050
 PR7   PXD                                                              MINLD051
 PR4   SLW LT,1                                                         MINLD052
       SLW RT,1                                                         MINLD053
       TIX PR4,1,1        X                                             MINLD054
 CIR   CAL COL1           INITIALIZE COLUMN INDICATOR                   MINLD055
 CI2   SLW COL            X                                             MINLD056
 CI9   LDQ 0,4            OBTAIN GROUP                                  MINLD057
       SXD OZ2,4          STORE GROUP COUNT                             MINLD058
       LXA Q6,4           SET CHARACTER COUNT                           MINLD059
 CI1   PXD                                                              MINLD060
 Q6    LGL 6                                                            MINLD061
       PAX 0,1            X                                             MINLD062
       CAL COL            POSITION COLUMN INDICATOR                     MINLD063
       ARS 6,4            X                                             MINLD064
       TIX YZ1,1,16       TEST FOR DIGIT                                MINLD065
       TXH YZ2,1,15       TEST FOR Y-ZONE                               MINLD066
 CI5   ORS D,3            STORE DIGIT                                   MINLD067
 CI4   TIX CI1,4,1        COUNT CHARACTERS                              MINLD068
 CI3   ARS 1              SHIFT AND TEST COLUMN                         MINLD069
       LXD OZ2,4          RESTORE GROUP COUNT                           MINLD070
       TXI CI6,4,-1       COUNT GROUPS                                  MINLD071
 CI6   TXL CI7,4          TEST FOR LAST NON-BLANK GR.                   MINLD072
       TNZ CI2            TEST FOR END OF ROW                           MINLD073
 CI7   CAL 8.3,2          FORM TRUE 8,4                                 MINLD074
       ORS D-8,2          AND 3 ROWS AND                                MINLD075
       ORS D-3,2          MOVE8.4 AND 8.3                               MINLD076
       SLW 8.2,2          ROWS                                          MINLD077
       CAL 8.4,2          FORM TRUE8.4                                  MINLD078
       ORS D-8,2                                                        MINLD079
       ORS D-4,2                                                        MINLD080
       SLW 8.3,2          X                                             MINLD081
 CI8   TXL WP,4           TEST FOR END                                  MINLD082
       TXH WP,2,15        TEST FOR RIGHT HALF                           MINLD083
       TXI CIR,2,16       INITIALIZE RIGHT HALF                         MINLD084
 YZ1   TIX XZ1,1,16       TEST FOR 16/CH/32                             MINLD085
       TXH XZ2,1,15       TEST FOR X-ZONE                               MINLD086
       ORS D,3            STORE DIGIT                                   MINLD087
 YZ2   ORS Y,2            STORE Y-ZONE                                  MINLD088
       TIX CI1,4,1        COUNT CHARACTERS                              MINLD089
 X1    TXL CI3            OBTAIN NEXT GROUP                             MINLD090
 XZ1   TIX OZ1,1,16       TEST FOR 32/CH/48                             MINLD091
       TXH CI4,1,15       TEST FOR BLANK                                MINLD092
       ORS D,3            STORE DIGIT                                   MINLD093
 XZ2   ORS X,2            STORE X-ZONE                                  MINLD094
       TIX CI1,4,1        COUNT CHARACTERS                              MINLD095
 X2    TXL CI3            OBTAIN NEXT GROUP                             MINLD096
 OZ1   ORS Z,2            STORE 0-ZONE                                  MINLD097
       ORS D,3                                                          MINLD098
       TIX CI1,4,1        COUNT CHARACTERS                              MINLD099
       TXL CI3                                                          MINLD100
 WP    LXD WP2,1                                                        MINLD101
 WP3   CPY LT,1           COPY CARD IMAGE                               MINLD102
       CPY RT,1                                                         MINLD103
       TIX WP3,1,1                                                      MINLD104
 WP4   TXH WP5,4                                                        MINLD105
       LXD X1,1                                                         MINLD106
       LXD X2,2                                                         MINLD107
 WT2   LXD X4,4                                                         MINLD108
       TRA 2,4                                                          MINLD109
 WP5   WPR                SELECT PRINTER AGAIN                          MINLD110
       SPR 9                                                            MINLD111
 WP2   TXL PR5,0,12       REENTER BCD TO CARD IMAGE                     MINLD112
 BLNKS BCD 1                                                            MINLD113
 X4    HTR 1                                                            MINLD114
 PR6   PZE                                                              MINLD115
 OZ2   PZE                                                              MINLD116
 COL1  MZE                                                              MINLD117
COMMON SYN COL1+1                                                       MINLD118
COL    SYN COMMON                                                       MINLD119
RT     SYN COL+1+16                                                     MINLD120
8.5    SYN RT                                                           MINLD121
8.4    SYN 8.5+1                                                        MINLD122
8.3    SYN 8.4+1                                                        MINLD123
8.2    SYN 8.3+1                                                        MINLD124
D      SYN 8.2+1+9                                                      MINLD125
Z      SYN D                                                            MINLD126
X      SYN Z+1                                                          MINLD127
Y      SYN X+1                                                          MINLD128
LT     SYN Y+1                                                          MINLD129
A      HED                                                              MINLD130
       ORG B$LT                                                         MINLD131
 NOPRG TSX HEAD,4                                                       MINLD132
       TSX B$WOT,4                                                      MINLD133
           O,0,P-1                                                      MINLD134
       TSX EJECT,4                                                      MINLD135
       HTR *+1                         STOP IF NO MAIN PROGRAM          MINLD136
       TRA *-1                                                          MINLD137
 CNVRT STO WRD                                                          MINLD138
       LDQ WRD                                                          MINLD139
       LXD D6,3                                                         MINLD140
       ALS 3                                                            MINLD141
       LGL 3                                                            MINLD142
       TIX *-2,1,1                                                      MINLD143
       SLW WRD                                                          MINLD144
       ALS 3                                                            MINLD145
       LGL 3                                                            MINLD146
       TIX *-2,2,1                                                      MINLD147
       LDQ WRD                                                          MINLD148
       TRA 1,4                                                          MINLD149
 WRD   PZE                                                              MINLD150
 HEAD  SXD WRD,4                                                        MINLD151
       TSX B$WOT,4                                                      MINLD152
           C,0,D-1                                                      MINLD153
       TSX B$WOT,4                                                      MINLD154
           SPACE,,SPACE                                                 MINLD155
 RET   LXD WRD,4                                                        MINLD156
       TRA 1,4                                                          MINLD157
       REM                                                              MINLD158
 EJECT WPR                                                              MINLD159
       SPR 1                                                            MINLD160
 ENTRY TRA 1,4               REPLY TO CALL , IF ANY                     MINLD161
       REM                                                              MINLD162
 SPACE BCD 1                                                            MINLD163
CLIP   BCD 1 00000                                                      MINLD164
K1     PZE 1                                                            MINLD165
 KK1   SYN K1                                                           MINLD166
 PATCH TTR MISS                                                         MINLD167
       TTR STLAP                                                        MINLD168
       TTR EOF                                                          MINLD169
       TTR CKSUM                                                        MINLD170
       TTR CMLAP                                                        MINLD171
       TTR BADOC                                                        MINLD172
       TTR NOPRG                                                        MINLD173
       TTR STVZE                                                        MINLD174
 MISS  TSX HEAD,4            PRINT HEAD                                 MINLD175
       TSX B$WOT,4           PRINT TITLE                                MINLD176
           A,0,B-1                                                      MINLD177
       LXD DECR,1            (20)                                       MINLD178
 L2    CLA TABLE+TWNTY,1                                                MINLD179
       TNZ *+2                                                          MINLD180
       CLA SPACE                                                        MINLD181
       STO TBLE-3                                                       MINLD182
       CLA TABLE+TWNTY+1,1                                              MINLD183
       TNZ *+2                                                          MINLD184
       CLA SPACE                                                        MINLD185
       STO TBLE-1                                                       MINLD186
       CLA TABLE+TWNTY+2,1                                              MINLD187
       TNZ *+2                                                          MINLD188
       CLA SPACE                                                        MINLD189
       STO TBLE+1                                                       MINLD190
       CLA TABLE+TWNTY+3,1                                              MINLD191
       TNZ *+2                                                          MINLD192
       CLA SPACE                                                        MINLD193
       STO TBLE+3                                                       MINLD194
       LXD K8,4                                                         MINLD195
       CLA SPACE                                                        MINLD196
    L1 STO TBLE+4,4                                                     MINLD197
       TIX L1,4,2                                                       MINLD198
       TSX B$WOT,4                                                      MINLD199
           TBLE-4,0,TBLE+3                                              MINLD200
       TIX L2,1,4                                                       MINLD201
 JOIN1 TSX EJECT,4                                                      MINLD202
       TXI *+1,2,212         SET IR2 = 214+S.T. TO CLEAR CORE MEMORY    MINLD203
       HTR START             ENTER PROGRAM IF START IS PUSHED.          MINLD204
       BSS 4                                                            MINLD205
  TBLE PZE                                                              MINLD206
       BSS 3                                                            MINLD207
 STLAP CLA ST                                                           MINLD208
       STD DCR                                                          MINLD209
       PXD 0,2                                                          MINLD210
       SUB DCR                                                          MINLD211
       ARS 18                                                           MINLD212
       TSX CNVRT,4                                                      MINLD213
       ORA CLIP                                                         MINLD214
       SLW F-2                                                          MINLD215
       TSX HEAD,4                                                       MINLD216
       TSX B$WOT,4                                                      MINLD217
           E,0,F-1                                                      MINLD218
JOIN3  CLA PB                                                           MINLD219
       SUB K1                                                           MINLD220
       TSX CNVRT,4                                                      MINLD221
       ORA CLIP                                                         MINLD222
       SLW V-2                                                          MINLD223
       TSX B$WOT,4                                                      MINLD224
           U,0,V-1                                                      MINLD225
 JOIN2 TSX EJECT,4                                                      MINLD226
       HTR RDCRD             REENTER BSS2 TO READ CARDS IF START        MINLD227
 DCR   PZE                                                              MINLD228
 EOF   TSX HEAD,4                                                       MINLD229
       TSX B$WOT,4                                                      MINLD230
           G,0,H-1                                                      MINLD231
 K8    TXI JOIN2,0,8                                                    MINLD232
 CKSUM SXD NL10,4                                                       MINLD233
       TSX CNVRT,4                                                      MINLD234
       STQ J-3                                                          MINLD235
       SLW J-2                                                          MINLD236
       TSX HEAD,4                                                       MINLD237
       TSX B$WOT,4                                                      MINLD238
           I,0,J-1                                                      MINLD239
       CLA NL2                                                          MINLD240
       TSX DCNV,4                                                       MINLD241
       SLW NL8                                                          MINLD242
       CLA NL3                                                          MINLD243
       TSX DCNV,4                                                       MINLD244
       SLW NL9                                                          MINLD245
       TSX B$WOT,4                                                      MINLD246
           AA,0,BB-1                                                    MINLD247
       TSX B$WOT,4                                                      MINLD248
           CC,0,DD-1                                                    MINLD249
       TSX B$WOT,4                                                      MINLD250
           EE,0,FF-1                                                    MINLD251
       TSX EJECT,4                                                      MINLD252
       LXD NL10,4                                                       MINLD253
       HTR NLBS2                       NLBS2 IS LOCATION 32622          MINLD254
       REM PATCH FOR EVERY CARD                                         MINLD255
   NL1 CPY 1                                                            MINLD256
       LXD NL2,1                                                        MINLD257
       TXI *+1,1,1                                                      MINLD258
       SXD NL2,1                                                        MINLD259
       LXD NL3,1                                                        MINLD260
       TXI *+1,1,1                                                      MINLD261
       SXD NL3,1                                                        MINLD262
       TRA NLBS1                       NLBS1 IS 32577                   MINLD263
       REM PATCH FOR PROGRAM CARD                                       MINLD264
   NL4 CLA Q6                                                           MINLD265
       STD NL3                                                          MINLD266
       LXD PSTL,4                                                       MINLD267
       CAL STORG-1,4                                                    MINLD268
       TNZ *+2                                                          MINLD269
       CAL NL6                                                          MINLD270
       SLW NL7                                                          MINLD271
   NL5 TXI NLBS3,0,6            NLBS3 IS LOCATION 32683                 MINLD272
    D6 SYN NL5                                                          MINLD273
   NL2 PZE 0,0,19                                                       MINLD274
   NL3 PZE 0,0,19                                                       MINLD275
   NL6 BCD 1(MAIN)                                                      MINLD276
  NL10 PZE                                                              MINLD277
       REM NO PROGRAM NAME FOUND IN SYMBOL TABLE.                       MINLD278
       REM STORE ZERO IN THE TRANSFER VECTOR                            MINLD279
 STVZE LDQ STOTV                 STOTV HAS ADDRESS OF T.V.              MINLD280
       STQ ST1                                                          MINLD281
       LDQ STZ                                                          MINLD282
       SLQ ST1                                                          MINLD283
   ST1 PZE                    STZ IN T.V.                               MINLD284
       TTR ENTMN              GO TO ENTER MISSING N AME IN TABLE        MINLD285
   STZ STZ **                                                           MINLD286
 CMLAP SSP                                                              MINLD287
       TSX CNVRT,4                                                      MINLD288
       ORA CLIP                                                         MINLD289
       SLW L-2                                                          MINLD290
       TSX HEAD,4                                                       MINLD291
       TSX B$WOT,4                                                      MINLD292
           K,0,L-1                                                      MINLD293
       TRA JOIN3                                                        MINLD294
 BADOC TSX HEAD,4                                                       MINLD295
       TSX B$WOT,4                                                      MINLD296
           M,0,N-1                                                      MINLD297
       TRA JOIN2                                                        MINLD298
  DCNV LRS 18+35                                                        MINLD299
       SXD AX4,4                                                        MINLD300
       LXA Q6,4                                                         MINLD301
  GEN1 PXD 0,0                                                          MINLD302
       DVP Q10                                                          MINLD303
       SLW CHAR,4                                                       MINLD304
       TIX GEN1,4,1                                                     MINLD305
  GEN5 TXH GEN3,4,6                                                     MINLD306
       CAL CHAR,4                                                       MINLD307
       TNZ GEN4                                                         MINLD308
       TXI GEN5,4,1                                                     MINLD309
  GEN4 CAL SPACE                       BLANKS                           MINLD310
  GEN7 TXH GEN6,4,6                                                     MINLD311
       ALS 6                                                            MINLD312
       ACL CHAR,4                                                       MINLD313
       TXI GEN7,4,1                                                     MINLD314
  GEN3 CAL SPACE                                                        MINLD315
       ALS 6                                                            MINLD316
  GEN6 TOV *+1                                                          MINLD317
       LXD AX4,4                                                        MINLD318
       TRA 1,4                                                          MINLD319
    Q6 PZE 6                                                            MINLD320
   Q10 PZE 10                                                           MINLD321
   AX4 PZE                                                              MINLD322
  CHAR SYN B$RT                                                         MINLD323
       REM CHAR IN COMMON STORAGE                                       MINLD324
       REM TEMPORARY BLOCK                                              MINLD325
TMPR   CLA TRAPT             ( TRA PATCH)                               MINLD326
       STO WD1               REPLACE HTR OF 20 MISSING                  MINLD327
       STO WD2               REPLACE HTR OF 1 OR MORE MISSING           MINLD328
       ADD KK1                                                          MINLD329
       STO WD3               REPLACE HTR OF SYMBOL TABLE OVERLAP WITH PRMINLD330
       ADD KK1                                                          MINLD331
       STO WD4               REPLACE HTR OF EOF IN CARD READER          MINLD332
       ADD KK1                                                          MINLD333
       STO WD5               REPLACE HTR OF CKSUM                       MINLD334
       ADD KK1                                                          MINLD335
       STO WD6               REPLACES HTR OF PROGRAM OVERLAPS DATA      MINLD336
       ADD KK1                                                          MINLD337
       STO WD7               REPLACE HTR OF ILLEGAL OCTAL PUNCHES       MINLD338
       ADD KK1                                                          MINLD339
       STA STADR             SET DIAGNOSTIC STARTING ADDRESS            MINLD340
       ADD KK1                                                          MINLD341
       STA NONME                                                        MINLD342
       CAL AD1                                                          MINLD343
       STA TZE                                                          MINLD344
       CAL AD2                                                          MINLD345
       SLW CPY1                                                         MINLD346
       CLA LDCKS                                                        MINLD347
       TZE RDCRD             JUMP IF LOADER CKSUM OK.                   MINLD348
       TSX CNVRT,4                                                      MINLD349
       STQ S+5                                                          MINLD350
       SLW S+6                                                          MINLD351
       TSX HEAD,4                                                       MINLD352
       TSX B$WOT,4                                                      MINLD353
           S,0,T-1                                                      MINLD354
       TSX EJECT,4                                                      MINLD355
FINIS  HTR RDCRD             REENTER BSS2 TO READ CARDS.                MINLD356
S      BCD  LOADER CHECK SUM INCORRECT BY              OCTAL.  TRY LOADIMINLD357
       BCD 2NG AGAIN.                                                   MINLD358
 T     SYN S+12                                                         MINLD359
TRAPT  TRA PATCH                                                        MINLD360
   AD1 PZE NL4                                                          MINLD361
   AD2 TTR NL1                                                          MINLD362
       TCD TMPR              EXECUTE MODIFICATIONS TO BSS2.             MINLD363
       REM PERMANENT BLOCK                                              MINLD364
       ORG TMPR                                                         MINLD365
 A     BCD 4MISSING SUBPROGRAMS ARE                                     MINLD366
 B     SYN A+4                                                          MINLD367
C      BCD 7      FORTRAN II BSS2 LOADER DIAGNOSTIC                     MINLD368
D      SYN C+7                                                          MINLD369
 E     BCD 9LOADER SYMBOL TABLE OVERLAPS PROGRAM BY          OCTAL      MINLD370
F      SYN E+9                                                          MINLD371
G      BCD  END OF FILE CONDITION IN CARD READER.  NO TRANSFER CARD.    MINLD372
H      SYN G+10                                                         MINLD373
 I     BCD 7INCORRECT CHECK SUM BY               OCTAL                  MINLD374
J      SYN I+7                                                          MINLD375
 K     BCD  PROGRAM OVERLAPS COMMON DATA ASSIGNMENT BY             OCTALMINLD376
L      SYN K+10                                                         MINLD377
 M     BCD 9ILLEGAL 8 OR 9 ROW PUNCHES IN OCTAL CORRECTION CARD         MINLD378
N      SYN M+9                                                          MINLD379
 O     BCD 4MISSING MAIN PROGRAM                                        MINLD380
P      SYN O+4                                                          MINLD381
U      BCD  WHERE THE LAST LOCATION OF THE PROGRAM IS AT           OCTALMINLD382
V      SYN U+10                                                         MINLD383
    AA BCD 4ERROR IN READING CARD                                       MINLD384
   NL9 BCD 1                                                            MINLD385
       BCD 6, DECIMAL, AFTER PROGRAM CARD OF                            MINLD386
   NL7 BCD 2      ,                                                     MINLD387
    BB SYN AA+13                                                        MINLD388
    CC BCD 4   WHICH IS ALSO CARD                                       MINLD389
   NL8 BCD 1                                                            MINLD390
       BCD 8, DECIMAL, AFTER PROGRAM CARD OF    (NOLD).                 MINLD391
    DD SYN CC+13                                                        MINLD392
    EE BCD 9PRESS START TO ACCEPT THE CARD AND CONTINUE LOADING.        MINLD393
    FF SYN EE+9                                                         MINLD394
 PB    EQU 23                PROGRAM BREAK                              MINLD395
 PL    EQU 32765             PROGRAM LENGTH                             MINLD396
 WD1   EQU 32726             20 MISSING SUBPROGRAMS STOP                MINLD397
 WD2   EQU 32764             ONE OR MORE MISSING SUBPROGRAMS.STOP       MINLD398
 WD3   EQU 3                 SYMBOL TABLE OVERLAP STOP                  MINLD399
 WD4   EQU 18                CARD READER EOF STOP                       MINLD400
 WD5   EQU 32621             CHECK SUM STOP                             MINLD401
 WD6   EQU 32661             COMMON STORAGE OVERLAP STOP                MINLD402
 WD7   EQU 32767             ILLEGAL OCTAL PUNCH STOP                   MINLD403
 RDCRD EQU 15                REENTRY TO BSS2 TO READ CARDS              MINLD404
 DECR  EQU 32723             SIZE OF TABLE IN DECREMENT                 MINLD405
 TWNTY EQU 20                SIZE OF TABLE                              MINLD406
 ST    EQU 32695             SYMBOL TABLE ADDRESS                       MINLD407
 STADR EQU 22                STARTING ADDRESS PLANT POINT               MINLD408
 START EQU 19                ENTRY TO START PROGRAM BSS2                MINLD409
 TXHCR EQU 32582             ADDRESS OF WITH TXH                        MINLD410
 TABLE EQU 32555             MISSING SUBPROGRAM NAME TABLE ADDRESS      MINLD411
LDCKS  EQU 32766             LOADER CKSUM DIFFERENCE                    MINLD412
 NLBS1 EQU 32577                       OCTAL 77501                      MINLD413
 NLBS2 EQU 32622                                                        MINLD414
 NLBS3 EQU 32683                       OCTAL 77653                      MINLD415
 NONME EQU 32750                                                        MINLD416
  CPY1 EQU 32576                                                        MINLD417
   TZE EQU 32677                                                        MINLD418
  PSTL EQU 32715                                                        MINLD419
   STL EQU 32757                                                        MINLD420
 STORG EQU 32554                                                        MINLD421
 STOTV EQU 32752                                                        MINLD422
 ENTMN EQU 32718                                                        MINLD423
   END BSS 0                                                            MINLD424
