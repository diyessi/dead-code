      SUBROUTINE RWSL                                                   IP820769
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP820770
     1,KC1,BND,ALPHA                                                    IP820771
      DIMENSION A(77,37),LT(37),B(37),KC(37),JORDER(37),JZEROS(37),KR(77IP820772
     1),U(77),D(77),INDEX(77),ALPHA(3)                                  IP820773
      AMIN=0.0                                                          IP820774
      DO 6 I=2,M1                                                       IP820775
      IF (A(I,1)-AMIN)3,4,6                                             IP820776
    3 AMIN=A(I,1)                                                       IP820777
    4 I1=I                                                              IP820778
    6 CONTINUE                                                          IP820779
      IF (AMIN)5,7,999                                                  IP820780
  999 STOP 1                                                            IP820781
    7 K2=0                                                              IP820782
    5 RETURN                                                            IP820783
      END (0,1,0,0,0)                                                   IP820784
      SUBROUTINE PIV1                                                   IP82A785
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP82A786
     1,KC1,BND,ALPHA                                                    IP82A787
      DIMENSION A(77,37),LT(37),B(37),KC(37),JORDER(37),JZEROS(37),KR(77IP82A788
     1),U(77),D(77),INDEX(77),ALPHA(3)                                  IP82A789
      KC1=KR(I1)                                                        IP82A790
      DO 3 J=1,N                                                        IP82A791
    3 B(J)=A(I1,J)                                                      IP82A792
   23 DNM=1.0                                                           IP82A793
      KSIG=0                                                            IP82A794
      TOL=0.0                                                           IP82A795
      J1=JORDER(KC1)                                                    IP82A796
      IF (B(J1)+100000.0)31,30,30                                       IP82A797
   31 V=INTF(-B(J1)/100.0)                                              IP82A798
      DO 32 J=1,N                                                       IP82A799
      BB=B(J)/V                                                         IP82A800
      B(J)=INTF(BB)                                                     IP82A801
      IF (B(J)-BB)32,32,34                                              IP82A802
   34 B(J)=B(J)-1.0                                                     IP82A803
   32 CONTINUE                                                          IP82A804
   27 J1=JORDER(KC1)                                                    IP82A805
   30 IF (B(J1)+1.0)4,5,4                                               IP82A806
    4 KSIG=1                                                            IP82A807
      DIV=-(B(J1))                                                      IP82A808
      DNM=MAX1F(1.0,INTF(DNM*DIV+.5))                                   IP82A809
      IF (DNM-100000.0)8,8,18                                           IP82A810
    8 TOL=.5/DNM                                                        IP82A811
      DO 6 J=1,N                                                        IP82A812
    6 B(J)=B(J)/DIV                                                     IP82A813
    5 ASTR=0.0                                                          IP82A814
      DO 10 I=2,M1                                                      IP82A815
      IF (KR(I)-KC1)11,10,10                                            IP82A816
   11 AA=A(I,1)+A(I,J1)*B(1)                                            IP82A817
      IF (AA+TOL)25,10,10                                               IP82A818
   25 IF (ABSF(ASTR-AA)-TOL)15,15,16                                    IP82A819
   15 IF (KR(I)-KR(I1))17,10,10                                         IP82A820
   16 IF (ASTR-AA)10,999,17                                             IP82A821
  999 STOP 71                                                           IP82A822
   17 ASTR=AA                                                           IP82A823
      I1=I                                                              IP82A824
   10 CONTINUE                                                          IP82A825
      IF (ASTR)14,9,999                                                 IP82A826
   14 KC1=0                                                             IP82A827
      B(1)=ASTR                                                         IP82A828
      DO 13 J=2,N                                                       IP82A829
      B(J)=A(I1,J)+A(I1,J1)*B(J)                                        IP82A830
      IF (B(J)+TOL)20,13,13                                             IP82A831
   20 IF (KC(J)-KC1)13,997,21                                           IP82A832
  997 STOP 73                                                           IP82A833
   21 KC1=KC(J)                                                         IP82A834
   13 CONTINUE                                                          IP82A835
      IF (KC1)24,24,27                                                  IP82A836
    9 IF (KSIG)996,24,18                                                IP82A837
  996 STOP 74                                                           IP82A838
   18 DO 19 J=1,N                                                       IP82A839
      BB=B(J)+TOL                                                       IP82A840
      B(J)=INTF(BB)                                                     IP82A841
      IF (BB)22,19,19                                                   IP82A842
   22 B(J)=B(J)-1.0                                                     IP82A843
   19 CONTINUE                                                          IP82A844
      GO TO 23                                                          IP82A845
   24 RETURN                                                            IP82A846
      END(0,1,0,0,1)                                                    IP82A847
      SUBROUTINE NURO                                                   IP820843
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP820844
     1,KC1,BND,ALPHA                                                    IP820845
      DIMENSION A(77,37),LT(37),B(37),KC(37),JORDER(37),JZEROS(37),KR(77IP820846
     1),U(77),D(77),INDEX(77),ALPHA(3)                                  IP820847
      BMAX=0.0                                                          IP820848
      UMAX=1.0                                                          IP820849
      DO 5 J=2,N                                                        IP820850
      IF (B(J))12,5,5                                                   IP820851
   12 IF (J-J1)3,4,3                                                    IP820852
    4 U(J)=1.0                                                          IP820853
      GO TO 7                                                           IP820854
    3 JZ1=JZEROS(J)+2                                                   IP820855
      IF (A(JZ1-1,J1))999,5,10                                          IP820856
  999 STOP 61                                                           IP820857
   10 UU=A(JZ1-1,J)/A(JZ1-1,J1)                                         IP820858
      U(J)=INTF(UU)                                                     IP820859
      IF (UU-U(J))997,6,7                                               IP820860
  997 STOP 63                                                           IP820861
    6 DO 8 II=JZ1,M1                                                    IP820862
      IF (A(II,J)-A(II,J1)*U(J))9,8,7                                   IP820863
    8 CONTINUE                                                          IP820864
      STOP 62                                                           IP820865
    9 U(J)=U(J)-1.0                                                     IP820866
    7 IF (BMAX*U(J)-UMAX*B(J))5,5,11                                    IP820867
   11 UMAX=U(J)                                                         IP820868
      BMAX=B(J)                                                         IP820869
    5 CONTINUE                                                          IP820870
      DO 20 J=1,N                                                       IP820871
      BB=-(B(J)*UMAX)/BMAX                                              IP820872
      B(J)=INTF(BB)                                                     IP820873
      IF (BB-B(J))24,20,20                                              IP820874
   24 B(J)=B(J)-1.0                                                     IP820875
   20 CONTINUE                                                          IP820876
      RETURN                                                            IP820877
      END (0,1,0,0,0)                                                   IP820878
       FUL                                                              IP820879
