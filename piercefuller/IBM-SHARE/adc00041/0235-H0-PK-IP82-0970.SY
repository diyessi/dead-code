      SUBROUTINE SETUP                                                  IP820102
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP820103
     1,KC1,BND,ALPHA                                                    IP820104
      DIMENSION A(77,37),LT(37),B(37),KC(37),JORDER(37),JZEROS(37),KR(77IP820105
     1),U(77),D(77),INDEX(77),ALPHA(3)                                  IP820106
      M1=M+NN                                                           IP820107
      DO 5 J=1,N                                                        IP820108
      DO 5 I=1,M1                                                       IP820109
    5 A(I,J)=0.0                                                        IP820110
      IF (SENSE SWITCH 3)6,7                                            IP820111
    6 READ 3,I,J,AA                                                     IP820112
      IF (I)999,10,4                                                    IP820113
  999 STOP 1                                                            IP820114
    4 A(I,J)=AA                                                         IP820115
      GO TO 6                                                           IP820116
    7 READ INPUT TAPE 7,3,I,J,AA                                        IP820117
      IF (I)999,10,11                                                   IP820118
   11 A(I,J)=AA                                                         IP820119
      GO TO 7                                                           IP820120
   10 I=M+1                                                             IP820121
      DO 12 J=2,N                                                       IP820122
      A(I,J)=-1.0                                                       IP820123
      LT(J)=I                                                           IP820124
   12 I=I+1                                                             IP820125
      LT(1)=0                                                           IP820126
      RETURN                                                            IP820127
    3 FORMAT (2I5,F10.5)                                                IP820128
      END (0,1,0,0,0)                                                   IP820129
      SUBROUTINE MOUT                                                   IP820130
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP820131
     1,KC1,BND,ALPHA                                                    IP820132
      DIMENSION A(77,37),LT(37),B(37),KC(37),JORDER(37),JZEROS(37),KR(77IP820133
     1),U(77),D(77),INDEX(77),ALPHA(3)                                  IP820134
      LB=1                                                              IP820135
      LO=1                                                              IP820136
      MX=14                                                             IP820137
   11 K=1                                                               IP820138
      MX=XMIN0F(N,MX)                                                   IP820139
      LL=1                                                              IP820140
      LU=56                                                             IP820141
    8 LU=XMIN0F(M1,LU)                                                  IP820142
      WRITE OUTPUT TAPE 8,3,K,LB,M1,N,ALPHA,(LT(J),J=LO,MX)             IP820143
      WRITE OUTPUT TAPE 8,7                                             IP820144
      DO 12 I=LL,LU                                                     IP820145
   12 WRITE OUTPUT TAPE 8,4,I,(A(I,J),J=LO,MX)                          IP820146
      IF (M1-LU)999,5,6                                                 IP820147
  999 STOP 1                                                            IP820148
    6 LL=LU+1                                                           IP820149
      LU=LU+56                                                          IP820150
      K=K+1                                                             IP820151
      GO TO 8                                                           IP820152
    5 IF (N-MX)999,9,10                                                 IP820153
   10 LO=MX+1                                                           IP820154
      MX=MX+14                                                          IP820155
      LB=LB+1                                                           IP820156
      GO TO 11                                                          IP820157
    9 RETURN                                                            IP820158
    3 FORMAT (12H1SUBMATRIX (I1,1H,I1,4H) OFI3,2H XI3,7H MATRIX65X,3A6/1IP820159
     1H04X,6HCOLUMNI4,13I8)                                             IP820160
    7 FORMAT (4H ROW)                                                   IP820161
    4 FORMAT (1H I3,3X,14F8.0)                                          IP820162
      END (0,1,0,0,0)                                                   IP820163
      SUBROUTINE DUFS                                                   IP820164
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP820165
     1,KC1,BND,ALPHA                                                    IP820166
      DIMENSION A(77,37),LT(37),B(37),KC(37),JORDER(37),JZEROS(37),KR(77IP820167
     1),U(77),D(77),INDEX(77),ALPHA(3)                                  IP820168
      JMIN=2                                                            IP820169
      DO 3 J=3,N                                                        IP820170
      I=1                                                               IP820171
    5 IF (A(I,J)-A(I,JMIN))6,4,3                                        IP820172
    4 I=I+1                                                             IP820173
      IF (I-M1)5,5,999                                                  IP820174
  999 STOP 31                                                           IP820175
    6 JMIN=J                                                            IP820176
    3 CONTINUE                                                          IP820177
      DO 7 I=1,M1                                                       IP820178
      U(I)=-(A(I,JMIN))                                                 IP820179
    7 A(I,JMIN)=-(A(I,JMIN))                                            IP820180
      DO 8 J=2,N                                                        IP820181
      I=1                                                               IP820182
   11 IF (A(I,J))9,10,8                                                 IP820183
   10 I=I+1                                                             IP820184
      IF (I-M1)11,11,998                                                IP820185
  998 STOP 32                                                           IP820186
    9 DO 12  I=1,M1                                                     IP820187
   12 A(I,J)=A(I,J)+U(I)                                                IP820188
    8 CONTINUE                                                          IP820189
      DO 13 I=1,M1                                                      IP820190
   13 A(I,1)=A(I,1)+BND*U(I)                                            IP820191
      RETURN                                                            IP820192
      END (0,1,0,0,0)                                                   IP820193
