C   ME PYRF  24 04260         BINOMIAL COEFFICIENT FUNCTION SUBPROGRAM  PYRF0001
C     PETER W. BRANDT, DEPT.D-12, MITRE CORP., LEXINGTON, MASS.         PYRF0002
C     FORTRAN II FUNCTION SUBPROGRAM, COMPUTES BINOMIAL COEFFICIENTS    PYRF0003
    1 FUNCTION BINOMC(N,M)                                              PYRF0004
  100 FREQUENCY 4(65,1,0),5(64,1,0),7(66),9(64),11(65)                  PYRF0005
    2 DIMENSION ARITH(131)                                              PYRF0006
   20 COMMON J,L,ARITH,BINOMC                                           PYRF0007
    3 L=N                                                               PYRF0008
   30 BINOMC=0.0                                                        PYRF0009
    4 IF(-M)5,15,14                                                     PYRF0010
    5 IF(M-L)6,15,14                                                    PYRF0011
    6 J=L+1                                                             PYRF0012
    7 DO 8 I=1,J                                                        PYRF0013
    8 ARITH(I)=1.0                                                      PYRF0014
    9 DO 12 K=1,M                                                       PYRF0015
   10 L=L-1                                                             PYRF0016
   11 DO 12 I=1,L                                                       PYRF0017
   12 ARITH(I+1)=ARITH(I)+ARITH(I+1)                                    PYRF0018
   13 LRC=L                                                             PYRF0019
  130 BINOMC=ARITH(LRC+1)                                               PYRF0020
   14 RETURN                                                            PYRF0021
   15 BINOMC=1.0                                                        PYRF0022
   16 GO TO 14                                                          PYRF0023
      END (0,1,0,0,1)                                                   PYRF0024
