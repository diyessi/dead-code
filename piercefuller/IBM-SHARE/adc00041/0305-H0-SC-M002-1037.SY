       COUNT   51                                                       SCM21271
*              M2 SUBROUTINE RDCRD. USED TO READ A SINGLE               SCM21272
*              CARD INTO NAMES(22),NAMES(21),...,NAMES(1).              SCM21273
*              IT CHECKS CHECK SUM, SHIFTS NAMES LEFT 6,                SCM21274
*              AND ORS IN A TRAILING BLANK. IT IS CALLED BY-            SCM21275
*              CALL RDCRD(NAMES),WHERE NAMES HAS                        SCM21276
*              DIMENSION OF AT LEAST 22                                 SCM21277
       ENTRY   RDCRD                                                    SCM21278
RDCRD  SXA     OUT,1                                                    SCM21279
       CAL     1,4                                                      SCM21280
       ADD     A1                                                       SCM21281
       STA     R3                                                       SCM21282
       SUB     A22                                                      SCM21283
       STA     B                                                        SCM21284
    R1 RCDA                                                             SCM21285
       RCHA    A                                                        SCM21286
    R2 TCOA    R2                                                       SCM21287
       TEFA    R6                                                       SCM21288
       CAL     9R                                                       SCM21289
       TZE     R4                                                       SCM21290
       CAL     9L                                                       SCM21291
       ANA     PON                                                      SCM21292
       TNZ     R4                                                       SCM21293
       AXT     22,1                                                     SCM21294
       CAL     9L                                                       SCM21295
    R3 ACL     (),1          (NAMES+1)                                  SCM21296
       TIX     R3,1,1                                                   SCM21297
       SLW     9L                                                       SCM21298
       CLA     9L                                                       SCM21299
       SUB     9R                                                       SCM21300
       TZE     R4                                                       SCM21301
       HPR     10362                                                    SCM21302
    R4 AXT     22,1                                                     SCM21303
    R5 CAL*    R3                                                       SCM21304
       ALS     6                                                        SCM21305
       ORA     OCT60                                                    SCM21306
       SLW*    R3                                                       SCM21307
       TIX     R5,1,1                                                   SCM21308
   OUT AXT     (),1                                                     SCM21309
       TRA     2,4           EXIT                                       SCM21310
    R6 HTR     R1                                                       SCM21311
     A IOCP    9L,0,2                                                   SCM21312
     B IOCD    (),0,22       (NAMES-21)                                 SCM21313
    A1 PZE     1,0,0                                                    SCM21314
   A22 PZE     22,0,0                                                   SCM21315
   PON PON     0,0,0                                                    SCM21316
 OCT60 OCT     60                                                       SCM21317
    9L BSS     1                                                        SCM21318
    9R BSS     1                                                        SCM21319
    () EQU     0                                                        SCM21320
       END                                                              SCM21321
*     CARDS ROW                                                         SCM21322
*     FAP                                                               SCM21323
       COUNT   60                                                       SCM21324
*              M2 ROW NUMBER PACKING AND UNPACKING ROUTINES             SCM21325
*              TO PACK ROW NUMBER I OF ELEMENT K INTO JJ,               SCM21326
*              CALL IPAKR(JJ,K,I)WHERE JJ=IK OR IE                      SCM21327
*              TO UNPACK ROW NUMBER I OF ELEMENT K FROM JJ,             SCM21328
*              I=IUNPAK(JJ,K)WHERE JJ=IK OR IE                          SCM21329
       ENTRY   IPAKR                                                    SCM21330
       ENTRY   IUNPAK                                                   SCM21331
IPAKR  CAL     1,4           PICK UP ADDR. OF IK OR IE                  SCM21332
       STA     PAK1                                                     SCM21333
       SXA     PAK2,1        SAVE IRA                                   SCM21334
       SXA     PAK3,2        SAVE IRB                                   SCM21335
       CAL*    2,4           PICK UP K=4N+R                             SCM21336
       ARS     2                                                        SCM21337
       PDX     0,1           N IN IRA,N=0,1,...,D-1                     SCM21338
       ANA     MASK          KEEP R                                     SCM21339
       ALS     2                                                        SCM21340
       PDX     0,2           R IN IRB, R=1,2,3,0                        SCM21341
       CAL     ANER+3,2                                                 SCM21342
  PAK1 ANS     (),1          () IS IK OR IE                             SCM21343
       CAL*    3,4           PICK UP I                                  SCM21344
       XEC     PINST+3,2     POSITION IT                                SCM21345
       ORS*    PAK1          OR IT IN                                   SCM21346
  PAK2 AXT     (),1          RESTORE IRA                                SCM21347
  PAK3 AXT     (),2          RESTORE IRB                                SCM21348
       TRA     4,4           EXIT                                       SCM21349
IUNPAK CAL     1,4           PICK UP ADDR. OF IK OR IE                  SCM21350
       STA     UNP1                                                     SCM21351
       SXA     UNP2,1        SAVE IRA                                   SCM21352
       SXA     UNP3,2        SAVE IRB                                   SCM21353
       CAL*    2,4           PICK UP K=4N+R                             SCM21354
       ARS     2                                                        SCM21355
       PDX     0,1           N IN IRA,N=0,1,...,D-1                     SCM21356
       ANA     MASK          KEEP R                                     SCM21357
       ALS     2                                                        SCM21358
       PDX     0,2           R IN IRB,R=1,2,3,0                         SCM21359
  UNP1 CAL     (),1          () IS IK OR IE                             SCM21360
       ANA     MASK+3,2      MASK OFF I                                 SCM21361
       XEC     UINST+3,2     POSITION IT IN DEC.                        SCM21362
  UNP2 AXT     (),1          RESTORE IRA                                SCM21363
  UNP3 AXT     (),2          RESTORE IRB                                SCM21364
       TRA     3,4           EXIT                                       SCM21365
  MASK OCT     000000777000                                             SCM21366
       OCT     000777000000                                             SCM21367
       OCT     777000000000                                             SCM21368
       OCT     000000000777                                             SCM21369
  ANER OCT     777777000777                                             SCM21370
       OCT     777000777777                                             SCM21371
       OCT     000777777777                                             SCM21372
       OCT     777777777000                                             SCM21373
 PINST ARS     9                                                        SCM21374
       NOP                                                              SCM21375
       ALS     9                                                        SCM21376
       ARS     18                                                       SCM21377
 UINST ALS     9                                                        SCM21378
       NOP                                                              SCM21379
       ARS     9                                                        SCM21380
       ALS     18                                                       SCM21381
    () EQU     0                                                        SCM21382
       END                                                              SCM21383
