*              M2 SUBROUTINES LFM,EFM,AND ANALY.                        SCM21232
*              USED TO LEAVE FLOATING TRAP, ENTER                       SCM21233
*              FLOATING TRAP, AND ANALYZE ANY FLOATING SPILL            SCM21234
*              THEY ARE CALLED BY-                                      SCM21235
*              CALL LFM OR CALL EFM                                     SCM21236
       ENTRY   LFM                                                      SCM21237
       ENTRY   EFM                                                      SCM21238
LFM    LFTM                                                             SCM21239
       TTR     1,4                                                      SCM21240
EFM    EFTM                                                             SCM21241
       CLA     X                                                        SCM21242
       STO     8                                                        SCM21243
       TTR     1,4                                                      SCM21244
     X TTR     ANALY                                                    SCM21245
 ANALY SXA     OUT,1         SAVE IRA                                   SCM21246
       LXA     0,1           L+1                                        SCM21247
       SXA     EXIT,1                                                   SCM21248
       LXD     0,1                                                      SCM21249
       STZ     MQ                                                       SCM21250
    A1 TTR     A1+14,1       AC MQ                                      SCM21251
       TTR     A1+8          OK OV                                      SCM21252
       STQ     MQ                                                       SCM21253
       TTR     A1+11         UN UN                                      SCM21254
       TTR     A1+2          UN OK                                      SCM21255
       TTR     A1+13         OK UN                                      SCM21256
    MQ PZE     0,0,0                                                    SCM21257
       NOP                   OV OV                                      SCM21258
       CLA     0             OV OK                                      SCM21259
       HPR     32767                                                    SCM21260
       NOP                                                              SCM21261
       PXD     0,0           UN UN                                      SCM21262
       NOP                                                              SCM21263
       LDQ     MQ            OK UN                                      SCM21264
   OUT AXT     (),1                                                     SCM21265
  EXIT TTR     ()                                                       SCM21266
    () EQU     0                                                        SCM21267
       END                                                              SCM21268
