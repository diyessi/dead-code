      MSW2=2-MSWCH2                                                     DIAT3041
C                                                                       DIAT3042
      DO 1160 MSWCH3=1,3,2                                              DIAT3043
      MSW3=MSWCH3-2                                                     DIAT3044
C                                                                       DIAT3045
      DO 1160 MSWCH4=1,3,2                                              DIAT3046
      MSW4=2-MSWCH4                                                     DIAT3047
      ICALC=(4*MSW2+2*MSW3+MSW4+7)/2+1                                  DIAT3048
      IF(IPRINT(ICALC))1160,1160,1150                                   DIAT3049
 1150 SUMA=SUMAA(ICALC)*FMMM                                            DIAT3050
      SUMB=SUMBB(ICALC)*FMMM                                            DIAT3051
      DELJ=DELJJ(ICALC)*FMMM                                            DIAT3052
      CALL PRINT(IKIND,IC1,IC2,IC3,IC4,K1,XSIGNF(K2,MSW2),XSIGNF(K3,MSW3DIAT3053
     1),XSIGNF(K4,MSW4),SUMA,SUMB,DELJ)                                 DIAT3054
