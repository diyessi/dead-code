C     MI DIAT, FEB.  1, 1960, SYMBOLIC DECK 3366  CARDS                 MIDIAT  
C     INVENTORY OF SUBPROGRAMS FOR DIATOM                               DIAT0001
C                                                                       DIAT0002
C                                                                       DIAT0003
C     REQUIRED SUBROUTINES                                              DIAT0004
C                                                                       DIAT0005
C     DIATOM                                                            DIAT0006
C     MISLAM,BLKIN                                                      DIAT0007
C     READ                                                              DIAT0008
C     PRE                                                               DIAT0009
C     PRER                                                              DIAT0010
C     GENBEU                                                            DIAT0011
C     GENBEX                                                            DIAT0012
C     GENGMX                                                            DIAT0013
C     BETAFN                                                            DIAT0014
C     GENIN,GENKN                                                       DIAT0015
C     MID                                                               DIAT0016
C     RGEN                                                              DIAT0017
C     CALC1E                                                            DIAT0018
C     CALCCL                                                            DIAT0019
C     CALCHY                                                            DIAT0020
C     CALCEX                                                            DIAT0021
C     CALC2E                                                            DIAT0022
C     GETFUN                                                            DIAT0023
C     BADTPE                                                            DIAT0024
C     SINGLE                                                            DIAT0025
C     DOUBLE                                                            DIAT0026
C     INDEFI                                                            DIAT0027
C     PRINT                                                             DIAT0028
C     POST                                                              DIAT0029
C     EFM,LFM                                                           DIAT0030
C     ETT                                                               DIAT0031
C     (LEV),(RTN) (SPEC. VERSION FOR FLOATING TRAP AND BAD TAPE CONTROL)DIAT0032
C     SET                                                               DIAT0033
C     COPYN                                                             DIAT0034
C     MULT                                                              DIAT0035
C     PRIME                                                             DIAT0036
C     HCF                                                               DIAT0037
C     VALUE                                                             DIAT0038
C     ERROR                                                             DIAT0039
C                                                                       DIAT0040
C                                                                       DIAT0041
C     REQUIRED FUNCTIONS (FORTRAN II)                                   DIAT0042
C                                                                       DIAT0043
C     FNORM                                                             DIAT0044
C     DEFINT                                                            DIAT0045
C     FACTOR                                                            DIAT0046
C     DCOE                                                              DIAT0047
C     IPRIMT                                                            DIAT0048
C                                                                       DIAT0049
C                                                                       DIAT0050
C     REQUIRED FUNCTIONS (LIBRARY)                                      DIAT0051
C                                                                       DIAT0052
C     SQRT                                                              DIAT0053
C     EXP                                                               DIAT0054
C     LOG                                                               DIAT0055
C                                                                       DIAT0056
C                                                                       DIAT0057
C     REQUIRED FUNCTIONS (SYSTEM)                                       DIAT0058
C                                                                       DIAT0059
C     (BDC),(FIL)                                                       DIAT0060
C     (CSH)                                                             DIAT0061
C     (DBC)                                                             DIAT0062
C     EXP(1                                                             DIAT0063
C     EXP(2                                                             DIAT0064
C     (SPH)                                                             DIAT0065
C     (STH)                                                             DIAT0066
C                                                                       DIAT0067
C                                                                       DIAT0068
C                                                                       DIAT0069
C     UTILITY SUBPROGRAMS                                               DIAT0070
C                                                                       DIAT0071
C     10 CARD MI BSS2 LOADER REQUIRED FOR MI SLAM COMPATIBILITY         DIAT0072
C     (OCTF)                                                            DIAT0073
C     (NOLD), (WOT)                                                     DIAT0074
C     (STPF)                                                            DIAT0075
C     (WOTF)                                                            DIAT0076
C     GETTPE N, N=1,2,....,10                                           DIAT0077
C                                                                       DIAT0078
C                                                                       DIAT0079
C                                                                       DIAT0080
C     DICTIONARY OF VARIABLES                                           DIAT0081
C                                                                       DIAT0082
C                                                                       DIAT0083
C     OPERATION INDICATORS, (0=SKIP, 1=DO)                              DIAT0084
C     INDS=OVERLAP                                                      DIAT0085
C     INDRM1=SPLIT NUCLEAR ATTRACTION, (1/R)                            DIAT0086
C     INDKE=KINETIC ENERGY, (-(1/2)*LAPLACIAN)                          DIAT0087
C     INDNA=NUCLEAR ATTRACTION, (1/R)                                   DIAT0088
C     INDCOU=COULOMB AND ONE'CENTER TWO'ELECTRON                        DIAT0089
C     INDHYB=HYBRID                                                     DIAT0090
C     INDEXC=EXCHANGE                                                   DIAT0091
C     IHOMON=MOLECULE TYPE, (0=HETERO-,1=HOMO-,2=MONO-NUCLEAR)          DIAT0092
C                                                                       DIAT0093
C     TAPE ASSIGNMENTS(0=NONE, N=TAPE UNIT)                             DIAT0094
C     ITPEPR=PRINT OUTPUT TAPE, OFF-LINE                                DIAT0095
C     ITPEPU=PUNCH OUTPUT TAPE, OFF-LINE                                DIAT0096
C     ITPEBO=BINARY OUTPUT TAPE                                         DIAT0097
C     ITPEF1=TEMPORARY TAPE NUMBER 1 OF EXPANSION FUNCTIONS             DIAT0098
C     IFDUP=NUMBER OF CONSECUTIVE DUPLICATE FUNCTION TAPES, (2 OR MORE) DIAT0099
C     IGENSP=SUPPRESSOR OF GENERATION, (1=ASSUME TEMP TAPE 1 READY)     DIAT0100
C                                                                       DIAT0101
C     BATCH PARAMETERS                                                  DIAT0102
C     IBATCH=ARBITRARY CODE INTEGER FOR IDENTIFICATION                  DIAT0103
C     KMAXA=NUMBER OF ORBITALS ON CENTER A                              DIAT0104
C     KMAXB=NUMBER OF ORBITALS ON CENTER B                              DIAT0105
C     MESH=Q, WHERE IMAX=3*(2)**Q+1                                     DIAT0106
C     IMAX=NUMBER OF FUNCTION ENTRIES                                   DIAT0107
C     IHALF=NUMBER OF HALF-MESH FUNCTION ENTRIES=(IMAX+1)/2             DIAT0108
C     JMAX=INDEX OF LAST TERM IN EXCHANGE INTEGRAL SERIES               DIAT0109
C                                                                       DIAT0110
C     STORAGE ALLOCATION PARAMETERS                                     DIAT0111
C     IORBMX=MAXIMUM NUMBER OF ORBITALS PER CENTER                      DIAT0112
C     ILIM=MAXIMUM VALUE OF IMAX                                        DIAT0113
C     JLIM=MAXIMUM VALUE OF JMAX                                        DIAT0114
C     LLIM=MAXIMUM NUMBER OF FUNCTIONS IN LINKAGE TABLE W               DIAT0115
C     KOMLIM=MAXIMUM NUMBER OF COMPONENTS IN ANY ORBITAL                DIAT0116
C                                                                       DIAT0117
C     BATCH PARAMETERS                                                  DIAT0118
C     A=INTERNUCLEAR DISTANCE                                           DIAT0119
C     H=MESH INTERVAL                                                   DIAT0120
C     THRESM=THRESHHOLD FOR OUTPUT SUPRESSION OF INTEGRAL MESH VARIATIONDIAT0121
C     THRESS=THRESHHOLD FOR OUTPUT SUPRESSION OF EXCHANGE INTEGRAL      DIAT0122
C            SERIES VARIATION                                           DIAT0123
C     NMAX=MAXIMUM QUANTUM NUMBER N                                     DIAT0124
C     LMAX=MAXIMUM QUANTUM NUMBER L                                     DIAT0125
C                                                                       DIAT0126
C     ORBITAL PARAMETER TABLES                                          DIAT0127
C     L(I,K)=QUANTUM NUMBER L OF ORBITAL NUMBER K ON CENTER NUMBER I,   DIAT0128
C            (1=A,2=B)                                                  DIAT0129
C     M(I,K)=QUANTUM NUMBER M OF ORBITAL NUMBER K ON CENTER NUMBER I,   DIAT0130
C            (1=A,2=B)                                                  DIAT0131
C     N(I,K,J)=QUANTUM NUMBER OF ORBITAL K, COMPONENT J, ON CENTER I,   DIAT0132
C              (1=A,2=B)                                                DIAT0133
C     CAPPA(I,K,J)=SCREENING CONSTANT OF ORBITAL K, COMPONENT J,CENTER IDIAT0134
C     WEIGHT(I,K,J)=WEIGHT FACTOR OF ORBITAL K, COMPONENT J,CENTER I    DIAT0135
C     ICOMP(I,K)=IF POSITIVE,NUMBER OF COMPONENTS OF ORBITAL K, CENTER IDIAT0136
C               =IF NEGATIVE,DELK WHERE COMPONENTS OF ORBITAL I,K ARE   DIAT0137
C                SAME AS OF ORBITAL I,K+DELK                            DIAT0138
C                                                                       DIAT0139
C     DIRECTORY TABLES GIVING THE FUNCTION LOCATIONS ON THE FIRST-COPY  DIAT0140
C          TAPE,                                                        DIAT0141
C          (ENTRY=((TAPE NO.)-6)*6553+(RECORD NO.))                     DIAT0142
C     IDRBEU(J,I,K)=UNEXPANDED FUNCTION OF TYPE J,(1=S,2=RM1,3=KE),OF   DIAT0143
C                   ORBITAL K ON CENTER I                               DIAT0144
C     IDRBEX(I,K)=MINIMUM-INDEX EXPANDED BETA FUNCTION OF ORBITAL K ON  DIAT0145
C                 CENTER I                                              DIAT0146
C     IMXBEX(I,K)=MAXIMUM-INDEX EXPANDED BETA FUNCTION OF ORBITAL K ON  DIAT0147
C                 CENTER I                                              DIAT0148
C     IDRGMX(I,K1,K2)=MINIMUM-INDEX EXPANDED GAMMA FUNCTION OF ORBITALS DIAT0149
C                     K1 AND K2 ON CENTER I IF K1 GREATER THAN OR EQUAL DIAT0150
C                     TO K2                                             DIAT0151
C                    =SPECIAL ENTRY OF 512*(LENGTH1)+(LENGTH2) FOR EXPA'DIAT0152
C                     NDED GAMMA FUNCTION OF ORBITALS K2-1 AND K1 ON    DIAT0153
C                     CENTER I IF K1 LESS THAN K2.  LENGTH1 AND LENGTH2 DIAT0154
C                     ARE NUMBER OF GAMMA FUNCTIONS WITH M'MAGNITUDE    DIAT0155
C                     CORRESPONDING TO THE DIFFERENCE OR THE SUM OF THE DIAT0156
C                     M'MAGNITUDES RESPECTIVELY, OF ORBITALS K2-1 AND K1DIAT0157
C     IRECTH(I)=NUMBER OF LAST RECORD THAT HAS BEEN READ FROM TAPE I    DIAT0158
C                                                                       DIAT0159
C     AUXILIARY FUNCTIONS                                               DIAT0160
C     DRDT(I)=ENTRY I OF DR/DT WHERE T IS UNIFORM-MESH INTEGRATION      DIAT0161
C             VARIABLE                                                  DIAT0162
C     R(I,J)=ENTRY I OF R**(J-1),(J LESS THAN JMAX+3)                   DIAT0163
C     RR(I)=ENTRY I OF R TABLE AVAILABLE FOR GENERATION                 DIAT0164
C                                                                       DIAT0165
C     WORKING TABLES                                                    DIAT0166
C     F1(I),...,F8(I)=FF(I,J)=ENTRY I OF FUNCTION TABLES J=1 TO 8       DIAT0167
C     E1(I),...,E3(I)=EE(I,J)=ENTRY I OF HALF-MESH TABLES J=1 TO 3      DIAT0168
C     W(I,J)=LINKAGE TABLE FOR STORAGE ALLOCATION                       DIAT0169
C     TEMP1(I),...,TEMP3(I)=WORKING TABLES FOR GENERATION               DIAT0170
C     BETA(I,J)=FUNCTION GENERATION TABLES                              DIAT0171
C                                                                       DIAT0172
C                                                                       DIAT0173
C                                                                       DIAT0174
C                                                                       DIAT0175
C                                                                       DIAT0176
C                                                                       DIAT0177
C     * M458,  CORBATO, SWITENDICK                         MAIN PROGRAM DIAT0178
C     * MAR. 20, 1959                                                   DIAT0179
C                                                                       DIAT0180
C     MAIN PROGRAM                                                      DIAT0181
C                                                                       DIAT0182
 10   CALL DIATOM                                                       DIAT0183
      PAUSE 70707                                                       DIAT0184
      GO TO 10                                                          DIAT0185
C                                                                       DIAT0186
      END(0,1,0,0,0)                                                    DIAT0187
C     *M458 ,  CORBATO,  SWITENDICK                               DIATOMDIAT0188
C     *DECEMBER 30, 1959                                                DIAT0189
C                                                                       DIAT0190
      SUBROUTINE DIATOM                                                 DIAT0191
      CALL BLKIN(1)                                                     DIAT0192
      CALL READ                                                         DIAT0193
      CALL PRE                                                          DIAT0194
      CALL GENBEU                                                       DIAT0195
      CALL GENBEX                                                       DIAT0196
      CALL GENGMX                                                       DIAT0197
      CALL BLKIN(2)                                                     DIAT0198
      CALL MID                                                          DIAT0199
      CALL CALC1E                                                       DIAT0200
      CALL CALCCL                                                       DIAT0201
      CALL CALCHY                                                       DIAT0202
      CALL CALCEX                                                       DIAT0203
      CALL POST                                                         DIAT0204
      RETURN                                                            DIAT0205
C                                                                       DIAT0206
      END(0,1,0,0,0)                                                    DIAT0207
C     M458, CORBATO, SWITENDICK                                   FNORM DIAT0208
C     NOV.  3, 1958                                                     DIAT0209
C                                                                       DIAT0210
      FUNCTION FNORM(I,K,J)                                             DIAT0211
C     REQUIRED COMMON(N,CAPPA,WEIGHT)                                   DIAT0212
C                                                                       DIAT0213
C     (PACKAGE)                                                         DIAT0214
C     NOV.  3, 1958                                                     DIAT0215
C                                                                       DIAT0216
C                                                                       DIAT0217
      COMMON IND,INDS,INDRM1,INDKE,INDNA,INDCOU,INDHYB,INDEXC,IHOMON,   DIAT0218
     1 ITPEPR,ITPEPU,ITPEBO,ITPEF1,IFDUP,IGENSP,IBATCH,KMAXA,KMAXB,MESH,DIAT0219
     2 IMAX,IHALF,JMAX,IORBMX,ILIM,JLIM,LLIM,KOMLIM,A,H,THRESM,THRESS,  DIAT0220
     3 NMAX,LMAX,N,L,M,CAPPA,WEIGHT,ICOMP,IDRBEU,IDRBEX,IMXBEX,         DIAT0221
     4        IDRGMX,IRECTH,DRDT,R,FF,F1,F2,F3,F4,F5,F6,F7,F8,EE,E1,E2, DIAT0222
     5 E3,RR,TEMP1,TEMP2,TEMP3,BETA,W                                   DIAT0223
C                                                                       DIAT0224
      EQUIVALENCE(IND(1),INDS),(IND(2),INDRM1),(IND(3),INDKE),          DIAT0225
     1 (IND(4),INDNA),(IND(5),INDCOU),(IND(6),INDHYB),(IND(7),INDEXC),  DIAT0226
     2 (KMAX(1),KMAXA),(KMAX(2),KMAXB),                                 DIAT0227
     3 (FF(   1),F1),(FF( 386),F2),(FF( 771),F3),(FF(1156),F4),         DIAT0228
     4 (FF(1541),F5),(FF(1926),F6),(FF(2311),F7),(FF(2696),F8),         DIAT0229
     5 (EE(   1),E1),(EE( 386),E2),(EE( 771),E3),                       DIAT0230
     6 (W,DRDT),(W(386),R),(W(11166),FF),(W(14246),EE),(RR,W),          DIAT0231
     7 (TEMP1,W(386)),(TEMP2,W(771)),(TEMP3,W(1156)),(BETA,W(1541))     DIAT0232
C                                                                       DIAT0233
      DIMENSION IND(7),KMAX(2),N(2,20,16),L(2,20),M(2,20),              DIAT0234
     1 CAPPA(2,20,16),WEIGHT(2,20,16),ICOMP(2,20),IDRBEU(3,2,20),       DIAT0235
     2 IDRBEX(2,20),IMXBEX(2,20),                IDRGMX(2,20,21),       DIAT0236
     3 IRECTH(10),DRDT(385),R(385,27),FF(385,8),F1(385),F2(385),F3(385),DIAT0237
     4 F4(385),F5(385),F6(385),F7(385),F8(385),EE(385,3),E1(385),       DIAT0238
     5 E2(385),E3(385),RR(385),TEMP1(385),TEMP2(385),TEMP3(385),        DIAT0239
     6 BETA(385,39),W(385,43)                                           DIAT0240
C                                                                       DIAT0241
C                                                                       DIAT0242
      FNORM=2.**N(I,K,J)*SQRTF((CAPPA(I,K,J)/FLOATF(N(I,K,J)+N(I,K,J)+1)DIAT0243
     1                       )*FACTOR(N(I,K,J),N(I,K,J))) *WEIGHT(I,K,J)DIAT0244
      RETURN                                                            DIAT0245
C                                                                       DIAT0246
      END(0,1,0,0,0)                                                    DIAT0247
C     M458, CORBATO, SWITENDICK                                   FACTORDIAT0248
C     NOV.  3, 1958                                                     DIAT0249
C                                                                       DIAT0250
      FUNCTION FACTOR(L,M)                                              DIAT0251
C                                                                       DIAT0252
      FACTOR=FLOATF(L+L+1)                                              DIAT0253
      IF(M)10,30,10                                                     DIAT0254
 10   J=2*XABSF(M)                                                      DIAT0255
      F=1.                                                              DIAT0256
C                                                                       DIAT0257
      DO 20 I=1,J                                                       DIAT0258
 20   F=F*FLOATF(L-XABSF(M)+I)                                          DIAT0259
C                                                                       DIAT0260
      FACTOR=FACTOR/F                                                   DIAT0261
 30   RETURN                                                            DIAT0262
C                                                                       DIAT0263
      END(0,1,0,0,0)                                                    DIAT0264
C     M458, CORBATO, SWITENDICK                                   DCOE  DIAT0265
C     DECEMBER  1, 1959                                                 DIAT0266
C                                                                       DIAT0267
      FUNCTION DCOE(IJ,IL1,IL2,IM1,IM2)                                 DIAT0268
C                                                                       DIAT0269
      DIMENSION IT1(100),IT2(100)                                       DIAT0270
      DCOE=0.                                                           DIAT0271
C                                                                       DIAT0272
C     PARITY TEST                                                       DIAT0273
      I2G=IL1+IL2+IJ                                                    DIAT0274
      IF(XMODF(I2G,2))200,10,200                                        DIAT0275
 10   IG=I2G/2                                                          DIAT0276
C                                                                       DIAT0277
C     TRIANGLE TEST                                                     DIAT0278
      IF(IL1+IL2-IJ)200,20,20                                           DIAT0279
 20   IF(IJ-XABSF(IL1-IL2))200,30,30                                    DIAT0280
 30   CONTINUE                                                          DIAT0281
C                                                                       DIAT0282
C     ALLOWED INDICES TEST                                              DIAT0283
      IF(IL1)200,40,40                                                  DIAT0284
 40   IF(IL2)200,50,50                                                  DIAT0285
 50   IF(IJ)200,60,60                                                   DIAT0286
 60   IF(IL1-XABSF(IM1))200,70,70                                       DIAT0287
 70   IF(IL2-XABSF(IM2))200,80,80                                       DIAT0288
 80   IF(IJ-XABSF(IM1-IM2))200,90,90                                    DIAT0289
 90   CONTINUE                                                          DIAT0290
C                                                                       DIAT0291
C     CHOOSE DOUBLE PRIME INDICES                                       DIAT0292
      IM=XABSF(IM1)                                                     DIAT0293
      IMP=XABSF(IM2)                                                    DIAT0294
      IMPP=XABSF(IM1-IM2)                                               DIAT0295
      IL=IL1                                                            DIAT0296
      ILP=IL2                                                           DIAT0297
      ILPP=IJ                                                           DIAT0298
      IF(IMPP-IM)100,110,110                                            DIAT0299
 100  ITEMP=IM                                                          DIAT0300
      IM=IMPP                                                           DIAT0301
      IMPP=ITEMP                                                        DIAT0302
      ITEMP=IL                                                          DIAT0303
      IL=ILPP                                                           DIAT0304
      ILPP=ITEMP                                                        DIAT0305
 110  IF(IMPP-IMP)120,130,130                                           DIAT0306
 120  ITEMP=IMP                                                         DIAT0307
      IMP=IMPP                                                          DIAT0308
      IMPP=ITEMP                                                        DIAT0309
      ITEMP=ILP                                                         DIAT0310
      ILP=ILPP                                                          DIAT0311
      ILPP=ITEMP                                                        DIAT0312
 130  CONTINUE                                                          DIAT0313
C                                                                       DIAT0314
C     SET TERM LIMITS                                                   DIAT0315
      ISM=XMIN0F((IL+ILP-IMPP),(ILPP-IMPP))                             DIAT0316
      ISMAX=XMIN0F(ISM,(ILP-IMP))+1                                     DIAT0317
      ISMIN=XMAX0F(0,(ILP-IL-IMPP))+1                                   DIAT0318
      ISDIF=ISMAX-ISMIN                                                 DIAT0319
      IF(ISDIF)200,140,140                                              DIAT0320
 140  CONTINUE                                                          DIAT0321
C                                                                       DIAT0322
C     TEST IF LESS TERMS IF INTERCHANGE PRIME AND UNPRIMED INDICES      DIAT0323
      ISMAXP=XMIN0F(ISM,(IL-IM))+1                                      DIAT0324
      ISMINP=XMAX0F(0,(IL-ILP-IMPP))+1                                  DIAT0325
      ISDIFP=ISMAXP-ISMINP                                              DIAT0326
      IF(ISDIFP)200,145,145                                             DIAT0327
 145  IF(ISDIF-ISDIFP)148,148,147                                       DIAT0328
 147  ITEMP=IM                                                          DIAT0329
      IM=IMP                                                            DIAT0330
      IMP=ITEMP                                                         DIAT0331
      ITEMP=IL                                                          DIAT0332
      IL=ILP                                                            DIAT0333
      ILP=ITEMP                                                         DIAT0334
      ISMAX=ISMAXP                                                      DIAT0335
      ISMIN=ISMINP                                                      DIAT0336
 148  CONTINUE                                                          DIAT0337
C                                                                       DIAT0338
C     PRESET TABLES                                                     DIAT0339
      N=I2G+1                                                           DIAT0340
      CALL SET (N,IT2,32767)                                            DIAT0341
      CALL SET (N,IT1,0)                                                DIAT0342
      SUM=0.                                                            DIAT0343
      ASSIGN 150 TO IRET                                                DIAT0344
C                                                                       DIAT0345
      DO 160 IS=ISMIN,ISMAX                                             DIAT0346
      GO TO 190                                                         DIAT0347
 150  CONTINUE                                                          DIAT0348
 160  CALL HCF(N,IT1,IT2)                                               DIAT0349
C                                                                       DIAT0350
      ASSIGN 170 TO IRET                                                DIAT0351
C                                                                       DIAT0352
      DO 180 IS=ISMIN,ISMAX                                             DIAT0353
      CALL COPYN(N,IT1,IT2)                                             DIAT0354
      GO TO 190                                                         DIAT0355
 170  CONTINUE                                                          DIAT0356
      CALL VALUE(N,IT1,TERM,+1)                                         DIAT0357
 180  SUM=TERM-SUM                                                      DIAT0358
C                                                                       DIAT0359
      GO TO 195                                                         DIAT0360
C                                                                       DIAT0361
C     FORM TERM                                                         DIAT0362
 190  IT=IS-1                                                           DIAT0363
      CALL MULT(N,IT1,ILPP+IMPP+IT,ILPP-IMPP-IT)                        DIAT0364
      CALL MULT(N,IT1,IL+ILP-IMPP-IT,ILP-IMP-IT)                        DIAT0365
      CALL MULT(N,IT1,1,IL-ILP+IMPP+IT)                                 DIAT0366
      CALL MULT(N,IT1,1,IT)                                             DIAT0367
      CALL PRIME(N,IT1)                                                 DIAT0368
      GO TO IRET,(150,170)                                              DIAT0369
C                                                                       DIAT0370
C     NORMALIZE                                                         DIAT0371
 195  CALL MULT(N,IT2,IL+IM,IL-IM)                                      DIAT0372
      CALL MULT(N,IT2,I2G-ILP-ILP,I2G+1)                                DIAT0373
      CALL MULT(N,IT2,1,IG-ILPP)                                        DIAT0374
      CALL MULT(N,IT2,ILP+IMP,IG-ILP)                                   DIAT0375
      CALL MULT(N,IT2,IG,IG-IL)                                         DIAT0376
      CALL MULT(N,IT2,IJ-XABSF(IM1-IM2),IJ+XABSF(IM1-IM2))              DIAT0377
      CALL MULT(N,IT2,IJ+IJ+1,IJ+IJ)                                    DIAT0378
      CALL PRIME(N,IT2)                                                 DIAT0379
      CALL VALUE(N,IT2,XNUM,+1)                                         DIAT0380
      CALL VALUE(N,IT2,DENOM,-1)                                        DIAT0381
C                                                                       DIAT0382
      DCOE=((XNUM*SUM)/DENOM)*FLOATF(1-2*XMODF(IG+IL+IMP+ISMAX-1,2))    DIAT0383
 200  RETURN                                                            DIAT0384
C                                                                       DIAT0385
      END(0,1,0,0,0)                                                    DIAT0386
C     M458, CORBATO, SWITENDICK                                   SET   DIAT0387
C     MAY11,1959                                                        DIAT0388
C                                                                       DIAT0389
      SUBROUTINE SET(N,IT,IS)                                           DIAT0390
C                                                                       DIAT0391
      DIMENSION IT(100)                                                 DIAT0392
C                                                                       DIAT0393
      DO 10 I=1,N                                                       DIAT0394
 10   IT(I)=IS                                                          DIAT0395
C                                                                       DIAT0396
      RETURN                                                            DIAT0397
C                                                                       DIAT0398
      END(0,1,0,0,0)                                                    DIAT0399
C     M458, CORBATO, SWITENDICK                                   COPYN DIAT0400
C     MAY11,1959                                                        DIAT0401
C                                                                       DIAT0402
      SUBROUTINE COPYN(N,IT1,IT2)                                       DIAT0403
C                                                                       DIAT0404
      DIMENSION IT1(100),IT2(100)                                       DIAT0405
C                                                                       DIAT0406
      DO 10 I=1,N                                                       DIAT0407
 10   IT1(I)=-IT2(I)                                                    DIAT0408
C                                                                       DIAT0409
      RETURN                                                            DIAT0410
C                                                                       DIAT0411
      END(0,1,0,0,0)                                                    DIAT0412
C     M458, CORBATO, SWITENDICK                                   MULT  DIAT0413
C     JUNE 4,1959                                                       DIAT0414
C                                                                       DIAT0415
      SUBROUTINE MULT(N,IT,IA,IB)                                       DIAT0416
C                                                                       DIAT0417
      DIMENSION IT(100)                                                 DIAT0418
C                                                                       DIAT0419
      IAA=IA                                                            DIAT0420
      IBB=IB                                                            DIAT0421
      IF(IAA)5,10,20                                                    DIAT0422
 5    CONTINUE                                                          DIAT0423
      CALL ERROR(39H NUMERATOR FACTORIAL IS LESS THAN ZERO.)            DIAT0424
      STOP 11                                                           DIAT0425
 10   IAA=1                                                             DIAT0426
 20   IF(IBB)25,30,40                                                   DIAT0427
 25   CONTINUE                                                          DIAT0428
      CALL ERROR(41H DENOMINATOR FACTORIAL IS LESS THAN ZERO.)          DIAT0429
      STOP 12                                                           DIAT0430
 30   IBB=1                                                             DIAT0431
 40   IMAX=XMAX0F(IAA,IBB)                                              DIAT0432
      IMIN=XMIN0F(IAA,IBB)+1                                            DIAT0433
      INCR=XSIGNF(1,IAA-IBB)                                            DIAT0434
      IF(IMAX-IMIN)100,50,50                                            DIAT0435
 50   IF(N-IMAX)60,70,70                                                DIAT0436
 60   CONTINUE                                                          DIAT0437
      CALL ERROR(36H FACTORIAL ENTRY EXCEEDS TABLE SIZE.)               DIAT0438
      STOP 1                                                            DIAT0439
 70   CONTINUE                                                          DIAT0440
      IF ACCUMULATOR OVERFLOW 75,75                                     DIAT0441
 75   CONTINUE                                                          DIAT0442
C                                                                       DIAT0443
      DO 90 I=IMIN,IMAX                                                 DIAT0444
      IT(I)=IT(I)+INCR                                                  DIAT0445
 90   CONTINUE                                                          DIAT0446
C                                                                       DIAT0447
      IF ACCUMULATOR OVERFLOW 95,100                                    DIAT0448
 95   CONTINUE                                                          DIAT0449
      CALL ERROR(43H FACTORIAL ENTRY HAS CAUSED TABLE OVERFLOW.)        DIAT0450
      STOP 2                                                            DIAT0451
 100  RETURN                                                            DIAT0452
C                                                                       DIAT0453
      END(0,1,0,0,0)                                                    DIAT0454
C     M458, CORBATO, SWITENDICK                                   PRIME DIAT0455
C     JUNE 9,1959                                                       DIAT0456
C                                                                       DIAT0457
      SUBROUTINE PRIME(N,IT)                                            DIAT0458
C                                                                       DIAT0459
      DIMENSION IT(100)                                                 DIAT0460
C                                                                       DIAT0461
      IF ACCUMULATOR OVERFLOW 50,50                                     DIAT0462
 50   CONTINUE                                                          DIAT0463
C                                                                       DIAT0464
      DO 100 I=1,N                                                      DIAT0465
      J=N-I+1                                                           DIAT0466
      IF(IT(J))60,100,60                                                DIAT0467
 60   IX1=IPRIMT(J)                                                     DIAT0468
      IF(IX1)70,100,70                                                  DIAT0469
 70   IX2=J/IX1                                                         DIAT0470
      IT(IX1)=IT(IX1)+IT(J)                                             DIAT0471
      IT(IX2)=IT(IX2)+IT(J)                                             DIAT0472
      IT(J)=0                                                           DIAT0473
 100  CONTINUE                                                          DIAT0474
C                                                                       DIAT0475
      IF ACCUMULATOR OVERFLOW 110,120                                   DIAT0476
 110  CONTINUE                                                          DIAT0477
      CALL ERROR(46H TABLE ENTRY HAS OVERFLOWED WHEN TABLE PRIMED.)     DIAT0478
      STOP 8                                                            DIAT0479
 120  CONTINUE                                                          DIAT0480
      RETURN                                                            DIAT0481
C                                                                       DIAT0482
      END(0,1,0,0,0)                                                    DIAT0483
C     M458, CORBATO, SWITENDICK                                      HCFDIAT0484
C     JUNE 4,1959                                                       DIAT0485
C                                                                       DIAT0486
      SUBROUTINE HCF(N,IT1,IT2)                                         DIAT0487
C                                                                       DIAT0488
      DIMENSION IT1(100),IT2(100)                                       DIAT0489
C                                                                       DIAT0490
      DO 10 I=1,N                                                       DIAT0491
      IT2(I)=XMIN0F(IT1(I),IT2(I))                                      DIAT0492
 10   IT1(I)=0                                                          DIAT0493
C                                                                       DIAT0494
      RETURN                                                            DIAT0495
C                                                                       DIAT0496
      END(0,1,0,0,0)                                                    DIAT0497
C     M458, CORBATO, SWITENDICK                                   IPRIMTDIAT0498
C     JUNE 4,1959                                                       DIAT0499
C                                                                       DIAT0500
      FUNCTION IPRIMT(K)                                                DIAT0501
C                                                                       DIAT0502
      DIMENSION IPRIM(100)                                              DIAT0503
C                                                                       DIAT0504
      ICK=0                                                             DIAT0505
C     AFTER COMPILATION PATCH SO THAT ICK=0 AND NOT RESET ON EXECUTION  DIAT0506
C                                                                       DIAT0507
      IF(ICK)50,10,50                                                   DIAT0508
 10   IF(N-100)16,16,15                                                 DIAT0509
 15   CONTINUE                                                          DIAT0510
      CALL ERROR(39H TABLE SIZE IS LARGER THAN PRIME TABLE.)            DIAT0511
      STOP 13                                                           DIAT0512
C                                                                       DIAT0513
 16   CONTINUE                                                          DIAT0514
      IPRIM(1)=0                                                        DIAT0515
      IPRIM(2)=0                                                        DIAT0516
C                                                                       DIAT0517
      DO 40 I=3,100                                                     DIAT0518
      IPRIM(I)=0                                                        DIAT0519
      JLIM=I-1                                                          DIAT0520
C                                                                       DIAT0521
      DO 30 J=2,JLIM                                                    DIAT0522
      IF(XMODF(I,J))30,20,30                                            DIAT0523
 20   IPRIM(I)=I/J                                                      DIAT0524
      GO TO 40                                                          DIAT0525
 30   CONTINUE                                                          DIAT0526
C                                                                       DIAT0527
 40   CONTINUE                                                          DIAT0528
C                                                                       DIAT0529
      ICK=1                                                             DIAT0530
 50   CONTINUE                                                          DIAT0531
C                                                                       DIAT0532
      IPRIMT=IPRIM(K)                                                   DIAT0533
C                                                                       DIAT0534
      RETURN                                                            DIAT0535
C                                                                       DIAT0536
      END(0,1,0,0,0)                                                    DIAT0537
C     M458, CORBATO, SWITENDICK                                   VALUE DIAT0538
C     JUNE 4,1959                                                       DIAT0539
C                                                                       DIAT0540
      SUBROUTINE VALUE(N,IT,V,IR)                                       DIAT0541
C                                                                       DIAT0542
      DIMENSION IT(100)                                                 DIAT0543
C                                                                       DIAT0544
      V=1.                                                              DIAT0545
C                                                                       DIAT0546
      DO 60 I=1,N                                                       DIAT0547
      JLIM=XABSF(IT(I))                                                 DIAT0548
      IF(32767-JLIM)5,7,7                                               DIAT0549
 5    CONTINUE                                                          DIAT0550
      CALL ERROR(26H TABLE ENTRY IS TOO LARGE.)                         DIAT0551
      STOP 61                                                           DIAT0552
 7    CONTINUE                                                          DIAT0553
      IF(IT(I))10,60,20                                                 DIAT0554
 10   IF(IR)30,60,60                                                    DIAT0555
 20   IF(IR)60,60,30                                                    DIAT0556
 30   CONTINUE                                                          DIAT0557
C                                                                       DIAT0558
      DO 50 J=1,JLIM                                                    DIAT0559
      V=V*FLOATF(I)                                                     DIAT0560
      IF(1.25E8-V)40,50,50                                              DIAT0561
 40   CONTINUE                                                          DIAT0562
      CALL ERROR(53H VALUE OF TABLE EXCEEDS EXACT INTEGER REPRESENTATIONDIAT0563
     1.)                                                                DIAT0564
      STOP 6                                                            DIAT0565
 50   CONTINUE                                                          DIAT0566
C                                                                       DIAT0567
 60   CONTINUE                                                          DIAT0568
C                                                                       DIAT0569
      RETURN                                                            DIAT0570
C                                                                       DIAT0571
      END(0,1,0,0,0)                                                    DIAT0572
C     * M458, CORBATO, SWITENDICK                                 READ  DIAT0573
C     *APRIL 27, 1959                                                   DIAT0574
C                                                                       DIAT0575
      SUBROUTINE READ                                                   DIAT0576
C     REQUIRED COMMON(IBATCH,MESH,JMAX,KMAXA,KMAXB,A,THRESM,THRESS,INDS,DIAT0577
C                    INDRM1,INDKE,INDCOU,INDHYB,INDEXC,IHOMON,ITPEBO,ITPDIAT0578
C                    EPR,ITPEPU,ITPEF1,IFDUP,IGENSP,L,M,ICOMP,N,CAPPA,WEDIAT0579
C                    IGHT,KOMLIM,IORBMX)                                DIAT0580
C                                                                       DIAT0581
C     (PACKAGE)                                                         DIAT0582
C     NOV.  3, 1958                                                     DIAT0583
C                                                                       DIAT0584
C                                                                       DIAT0585
      COMMON IND,INDS,INDRM1,INDKE,INDNA,INDCOU,INDHYB,INDEXC,IHOMON,   DIAT0586
     1 ITPEPR,ITPEPU,ITPEBO,ITPEF1,IFDUP,IGENSP,IBATCH,KMAXA,KMAXB,MESH,DIAT0587
     2 IMAX,IHALF,JMAX,IORBMX,ILIM,JLIM,LLIM,KOMLIM,A,H,THRESM,THRESS,  DIAT0588
     3 NMAX,LMAX,N,L,M,CAPPA,WEIGHT,ICOMP,IDRBEU,IDRBEX,IMXBEX,         DIAT0589
     4        IDRGMX,IRECTH,DRDT,R,FF,F1,F2,F3,F4,F5,F6,F7,F8,EE,E1,E2, DIAT0590
     5 E3,RR,TEMP1,TEMP2,TEMP3,BETA,W                                   DIAT0591
C                                                                       DIAT0592
      EQUIVALENCE(IND(1),INDS),(IND(2),INDRM1),(IND(3),INDKE),          DIAT0593
     1 (IND(4),INDNA),(IND(5),INDCOU),(IND(6),INDHYB),(IND(7),INDEXC),  DIAT0594
     2 (KMAX(1),KMAXA),(KMAX(2),KMAXB),                                 DIAT0595
     3 (FF(   1),F1),(FF( 386),F2),(FF( 771),F3),(FF(1156),F4),         DIAT0596
     4 (FF(1541),F5),(FF(1926),F6),(FF(2311),F7),(FF(2696),F8),         DIAT0597
     5 (EE(   1),E1),(EE( 386),E2),(EE( 771),E3),                       DIAT0598
     6 (W,DRDT),(W(386),R),(W(11166),FF),(W(14246),EE),(RR,W),          DIAT0599
     7 (TEMP1,W(386)),(TEMP2,W(771)),(TEMP3,W(1156)),(BETA,W(1541))     DIAT0600
C                                                                       DIAT0601
      DIMENSION IND(7),KMAX(2),N(2,20,16),L(2,20),M(2,20),              DIAT0602
     1 CAPPA(2,20,16),WEIGHT(2,20,16),ICOMP(2,20),IDRBEU(3,2,20),       DIAT0603
     2 IDRBEX(2,20),IMXBEX(2,20),                IDRGMX(2,20,21),       DIAT0604
     3 IRECTH(10),DRDT(385),R(385,27),FF(385,8),F1(385),F2(385),F3(385),DIAT0605
     4 F4(385),F5(385),F6(385),F7(385),F8(385),EE(385,3),E1(385),       DIAT0606
     5 E2(385),E3(385),RR(385),TEMP1(385),TEMP2(385),TEMP3(385),        DIAT0607
     6 BETA(385,39),W(385,43)                                           DIAT0608
C                                                                       DIAT0609
C                                                                       DIAT0610
      IORBMX=20                                                         DIAT0611
      KOMLIM=16                                                         DIAT0612
      PRINT 5                                                           DIAT0613
 5    FORMAT(55H      DIATOMIC MOLECULE INTEGRAL PROGRAM, PROGRAMMED BY/DIAT0614
     162H              F. J. CORBATO AND A. C. SWITENDICK              /DIAT0615
     262H                         AT THE                               /DIAT0616
     360H                M. I. T. COMPUTATION CENTER                 //)DIAT0617
      READ10                                                            DIAT0618
      PRINT 10                                                          DIAT0619
 10   FORMAT(72H                                                        DIAT0620
     1                /72H                                              DIAT0621
     2                          )                                       DIAT0622
 15   READ 20,IBATCH,MESH,JMAX,KMAXA,KMAXB,A,THRESM,THRESS,INDS,INDRM1,IDIAT0623
     1NDKE,INDNA,INDCOU,INDHYB,INDEXC,IHOMON,ITPEBO,ITPEPR,ITPEPU,ITPEF1DIAT0624
     2,IFDUP,IGENSP                                                     DIAT0625
 20   FORMAT(I5,I1,3I2,3F10.9,8I1,4I2,2I1)                              DIAT0626
C                                                                       DIAT0627
      DO 38 I=1,2                                                       DIAT0628
      IF(IHOMON)24,24,22                                                DIAT0629
 22   IF(I-2)24,38,38                                                   DIAT0630
 24   CONTINUE                                                          DIAT0631
      KK=KMAX(I)                                                        DIAT0632
C                                                                       DIAT0633
      DO 36 K=1,KK                                                      DIAT0634
      READ 30,L(I,K),M(I,K),ICOMP(I,K),N(I,K,1),CAPPA(I,K,1),WEIGHT(I,K,DIAT0635
     11)                                                                DIAT0636
 30   FORMAT(1H I2,2I3,1H I2,F10.9,F20.9)                               DIAT0637
      JJ=ICOMP(I,K)                                                     DIAT0638
      IF(JJ-1)36,36,32                                                  DIAT0639
C                                                                       DIAT0640
 32   DO 35 J=2,JJ                                                      DIAT0641
      READ 34,N(I,K,J),CAPPA(I,K,J),WEIGHT(I,K,J)                       DIAT0642
 34   FORMAT(10H          I2,F10.9,F20.9)                               DIAT0643
 35   CONTINUE                                                          DIAT0644
C                                                                       DIAT0645
 36   CONTINUE                                                          DIAT0646
C                                                                       DIAT0647
 38   CONTINUE                                                          DIAT0648
C                                                                       DIAT0649
      IF(IORBMX-20)42,40,42                                             DIAT0650
 40   IF(KOMLIM-16)42,44,42                                             DIAT0651
 42   STOP 121                                                          DIAT0652
C     IMPROPER DIMENSION IN BINARY RECORD STATEMENT                     DIAT0653
C                                                                       DIAT0654
 44   CONTINUE                                                          DIAT0655
      IF(ITPEBO)50,50,48                                                DIAT0656
 48   REWIND ITPEBO                                                     DIAT0657
      WRITE TAPE ITPEBO,IBATCH,MESH,JMAX,KMAXA,KMAXB,A,THRESM,THRESS,INDDIAT0658
     1S,INDRM1,INDKE,INDNA,INDCOU,INDHYB,INDEXC,IHOMON,ITPEBO,ITPEPR,ITPDIAT0659
     2EPU,ITPEF1,IFDUP,IGENSP,((L(I,K),M(I,K),ICOMP(I,K),K=1,20),I=1    DIAT0660
     3,2),(((N(I,K,J),CAPPA(I,K,J),WEIGHT(I,K,J),J=1,16),K=1,20),I=1,2) DIAT0661
C                                                                       DIAT0662
 50   IF(ITPEPR)70,70,60                                                DIAT0663
 60   ITAPE=ITPEPR                                                      DIAT0664
      ASSIGN 70 TO IRET                                                 DIAT0665
      GO TO 100                                                         DIAT0666
C                                                                       DIAT0667
 70   IF(ITPEPU)90,90,80                                                DIAT0668
 80   ITAPE=ITPEPU                                                      DIAT0669
      ASSIGN90 TO IRET                                                  DIAT0670
      GO TO 100                                                         DIAT0671
C                                                                       DIAT0672
 90   RETURN                                                            DIAT0673
C                                                                       DIAT0674
C     WRITE OUTPUT TAPE SUBPROGRAM                                      DIAT0675
 100  END FILE ITAPE                                                    DIAT0676
      WRITE OUTPUT TAPE ITAPE, 5                                        DIAT0677
      WRITE OUTPUT TAPE ITAPE,10                                        DIAT0678
      WRITE OUTPUT TAPE ITAPE,800                                       DIAT0679
      WRITE OUTPUT TAPE ITAPE,200,IBATCH,MESH,JMAX,KMAXA,KMAXB,A,THRESM,DIAT0680
     1THRESS                                                            DIAT0681
      WRITE OUTPUT TAPE ITAPE,300,(IND(I),I=1,7),IHOMON                 DIAT0682
      WRITE OUTPUT TAPE ITAPE,400,ITPEBO,ITPEPR,ITPEPU,ITPEF1,IFDUP,IGENDIAT0683
     1SP                                                                DIAT0684
      WRITE OUTPUT TAPE ITAPE,800                                       DIAT0685
      WRITE OUTPUT TAPE ITAPE,500                                       DIAT0686
      IC=1                                                              DIAT0687
      ASSIGN102 TO IRET2                                                DIAT0688
      GO TO 150                                                         DIAT0689
 102  CONTINUE                                                          DIAT0690
C                                                                       DIAT0691
      IF(IHOMON)103,103,106                                             DIAT0692
 103  CONTINUE                                                          DIAT0693
C                                                                       DIAT0694
      WRITE OUTPUT TAPE ITAPE,800                                       DIAT0695
      WRITE OUTPUT TAPE ITAPE,600                                       DIAT0696
      IC=2                                                              DIAT0697
      ASSIGN 104 TO IRET2                                               DIAT0698
      GO TO 150                                                         DIAT0699
 104  CONTINUE                                                          DIAT0700
C                                                                       DIAT0701
 106  WRITE OUTPUT TAPE ITAPE,800                                       DIAT0702
 110  GO TO IRET,(70,90)                                                DIAT0703
C                                                                       DIAT0704
C     OUTPUT TAPE ORBITAL SUBPROGRAM                                    DIAT0705
 150  WRITE OUTPUT TAPE ITAPE,700                                       DIAT0706
      KK=KMAX(IC)                                                       DIAT0707
C                                                                       DIAT0708
      DO 156 K=1,KK                                                     DIAT0709
      I=IC*100+K                                                        DIAT0710
      JJ=ICOMP(IC,K)                                                    DIAT0711
      IF(JJ)155,155,151                                                 DIAT0712
 151  CONTINUE                                                          DIAT0713
      J=1                                                               DIAT0714
      WRITE OUTPUT TAPE ITAPE,158,I,L(IC,K),M(IC,K),J,N(IC,K,J),CAPPA(ICDIAT0715
     1,K,J),WEIGHT(IC,K,J)                                              DIAT0716
      IF(JJ-1)156,156,152                                               DIAT0717
C                                                                       DIAT0718
 152  DO 154 J=2,JJ                                                     DIAT0719
 154  WRITE OUTPUT TAPE ITAPE,160,J,N(IC,K,J),CAPPA(IC,K,J),WEIGHT(IC,K,DIAT0720
     1J)                                                                DIAT0721
C                                                                       DIAT0722
      GO TO 156                                                         DIAT0723
 155  WRITE OUTPUT TAPE ITAPE,158,I,L(IC,K),M(IC,K),JJ                  DIAT0724
 156  CONTINUE                                                          DIAT0725
C                                                                       DIAT0726
      WRITE OUTPUT TAPE ITAPE,800                                       DIAT0727
 157  GO TO IRET2,(102,104)                                             DIAT0728
C                                                                       DIAT0729
 158  FORMAT(1H 5I4,2F16.9)                                             DIAT0730
 160  FORMAT(13H             2I4,2F16.9)                                DIAT0731
 200  FORMAT(55H INPUT PARAMETERS                                      /DIAT0732
     11H I5,56H =BATCH IDENTIFICATION NUMBER                           /DIAT0733
     21H I5,56H =Q, MESH PARAMETER, (3*2**Q+1 FUNCTION ENTRIES)        /DIAT0734
     31H I5,56H =JMAX, INDEX OF LAST TERM INCLUDED IN EXCHANGE SERIES  /DIAT0735
     41H I5,56H =NUMBER OF ORBITALS ON CENTER A                        /DIAT0736
     51H I5,56H =NUMBER OF ORBITALS ON CENTER B                        /DIAT0737
     61H F12.9,53H =INTERNUCLEAR DISTANCE IN ATOMIC UNITS              /DIAT0738
     71H F12.9,53H =OUTPUT THRESHOLD FOR Q, Q-1 DIFFERENCE             /DIAT0739
     81H F12.9,51H =OUTPUT THRESHOLD FOR JMAX, JMAX-1 DIFFERENCE     //)DIAT0740
 300  FORMAT(55H OPERATION INDICATORS, (0=SKIP, 1=DO)                  /DIAT0741
     11H I2,56H =OVERLAP INTEGRALS                                     /DIAT0742
     21H I2,56H =SPLIT NUCLEAR ATTRACTION INTEGRALS                    /DIAT0743
     31H I2,56H =KINETIC ENERGY INTEGRALS                              /DIAT0744
     41H I2,56H =NUCLEAR ATTRACTION INTEGRALS                          /DIAT0745
     51H I2,56H =COULOMB AND 1-CENTER 2-ELECTRON INTEGRALS             /DIAT0746
     61H I2,56H =HYBRID INTEGRALS                                      /DIAT0747
     71H I2,56H =EXCHANGE INTEGRALS                                    /DIAT0748
     81H I2,54H =MOLECULE TYPE, (0=HETERO-, 1=HOMO-, 2=MONO-NUCLEAR) //)DIAT0749
 400  FORMAT(55H TAPE UNIT ASSIGNMENTS, (0=NONE)                       /DIAT0750
     11H I2,56H =BINARY OUTPUT TAPE                                    /DIAT0751
     21H I2,56H =OFF-LINE PRINT OUTPUT TAPE                            /DIAT0752
     31H I2,56H =OFF-LINE PUNCH OUTPUT TAPE                            /DIAT0753
     41H I2,56H =FIRST TEMPORARY TAPE FOR FUNCTION GENERATION          /DIAT0754
     51H I2,56H =NUMBER OF TEMPORARY TAPES, (2 OR MORE)                /DIAT0755
     61H I2,54H =GENERATION SUPPRESSOR, (0=NO, 1=USE TEMP TAPE 1)    //)DIAT0756
 500  FORMAT(54H SLATER ATOMIC ORBITALS ON CENTER A, (A=100)          /)DIAT0757
 600  FORMAT(54H SLATER ATOMIC ORBITALS ON CENTER B, (B=200)          /)DIAT0758
 700  FORMAT(53H  ORB.  L   M  CMP. N       KAPPA           WEIGHT   //)DIAT0759
 800  FORMAT(1H /)                                                      DIAT0760
C                                                                       DIAT0761
      END(0,1,0,0,0)                                                    DIAT0762
C     * M458, CORBATO, SWITENDICK                                 PRE   DIAT0763
C     *MAR. 20, 1959                                                    DIAT0764
C                                                                       DIAT0765
      SUBROUTINE PRE                                                    DIAT0766
C     REQUIRED COMMON(ILIM,JLIM,LLIM,IORBMX,KOMLIM,MESH,IMAX,IHALF,KMAX,DIAT0767
C                    ICOMP,H,NMAX,LMAX,INDS,INDRM1,INDKE,INDNA,INDCOU,INDIAT0768
C                    DHYB,INDEXC,L,M,N,JMAX,IFDUP,ITPEF1,ITPEPR,ITPEPU,IDIAT0769
C                    TPEBO,IDRBEU,IDRBEX,IMXBEX,IDRGMX,IHOMON)          DIAT0770
C                                                                       DIAT0771
C     (PACKAGE)                                                         DIAT0772
C     NOV.  3, 1958                                                     DIAT0773
C                                                                       DIAT0774
C                                                                       DIAT0775
      COMMON IND,INDS,INDRM1,INDKE,INDNA,INDCOU,INDHYB,INDEXC,IHOMON,   DIAT0776
     1 ITPEPR,ITPEPU,ITPEBO,ITPEF1,IFDUP,IGENSP,IBATCH,KMAXA,KMAXB,MESH,DIAT0777
     2 IMAX,IHALF,JMAX,IORBMX,ILIM,JLIM,LLIM,KOMLIM,A,H,THRESM,THRESS,  DIAT0778
     3 NMAX,LMAX,N,L,M,CAPPA,WEIGHT,ICOMP,IDRBEU,IDRBEX,IMXBEX,         DIAT0779
     4        IDRGMX,IRECTH,DRDT,R,FF,F1,F2,F3,F4,F5,F6,F7,F8,EE,E1,E2, DIAT0780
     5 E3,RR,TEMP1,TEMP2,TEMP3,BETA,W                                   DIAT0781
C                                                                       DIAT0782
      EQUIVALENCE(IND(1),INDS),(IND(2),INDRM1),(IND(3),INDKE),          DIAT0783
     1 (IND(4),INDNA),(IND(5),INDCOU),(IND(6),INDHYB),(IND(7),INDEXC),  DIAT0784
     2 (KMAX(1),KMAXA),(KMAX(2),KMAXB),                                 DIAT0785
     3 (FF(   1),F1),(FF( 386),F2),(FF( 771),F3),(FF(1156),F4),         DIAT0786
     4 (FF(1541),F5),(FF(1926),F6),(FF(2311),F7),(FF(2696),F8),         DIAT0787
     5 (EE(   1),E1),(EE( 386),E2),(EE( 771),E3),                       DIAT0788
     6 (W,DRDT),(W(386),R),(W(11166),FF),(W(14246),EE),(RR,W),          DIAT0789
     7 (TEMP1,W(386)),(TEMP2,W(771)),(TEMP3,W(1156)),(BETA,W(1541))     DIAT0790
C                                                                       DIAT0791
      DIMENSION IND(7),KMAX(2),N(2,20,16),L(2,20),M(2,20),              DIAT0792
     1 CAPPA(2,20,16),WEIGHT(2,20,16),ICOMP(2,20),IDRBEU(3,2,20),       DIAT0793
     2 IDRBEX(2,20),IMXBEX(2,20),                IDRGMX(2,20,21),       DIAT0794
     3 IRECTH(10),DRDT(385),R(385,27),FF(385,8),F1(385),F2(385),F3(385),DIAT0795
     4 F4(385),F5(385),F6(385),F7(385),F8(385),EE(385,3),E1(385),       DIAT0796
     5 E2(385),E3(385),RR(385),TEMP1(385),TEMP2(385),TEMP3(385),        DIAT0797
     6 BETA(385,39),W(385,43)                                           DIAT0798
C                                                                       DIAT0799
C                                                                       DIAT0800
      ILIM=385                                                          DIAT0801
      JLIM=27-2                                                         DIAT0802
      LLIM=43                                                           DIAT0803
C                                                                       DIAT0804
      IF(MESH-4)20,10,10                                                DIAT0805
 10   IMAX=3*2**MESH+1                                                  DIAT0806
      IHALF=(IMAX+1)/2                                                  DIAT0807
      IF(IMAX-ILIM)30,30,20                                             DIAT0808
 20   STOP101                                                           DIAT0809
C     INTEGRATION MESH EITHER TOO COARSE OR TOO FINE                    DIAT0810
C                                                                       DIAT0811
 30   CONTINUE                                                          DIAT0812
C                                                                       DIAT0813
      DO 90 I=1,2                                                       DIAT0814
      IF(KMAX(I)-IORBMX)70,70,60                                        DIAT0815
 60   STOP 103                                                          DIAT0816
C     TOO MANY ORBITALS ON A CENTER                                     DIAT0817
C                                                                       DIAT0818
 70   KK=KMAX(I)                                                        DIAT0819
C                                                                       DIAT0820
      DO 90 K=1,KK                                                      DIAT0821
      IF(ICOMP(I,K)-KOMLIM)90,90,80                                     DIAT0822
 80   STOP 104                                                          DIAT0823
C     TOO MANY COMPONENTS IN AN ORBITAL                                 DIAT0824
C                                                                       DIAT0825
 90   CONTINUE                                                          DIAT0826
C                                                                       DIAT0827
C     CLEAR FUNCTION DIRECTORIES                                        DIAT0828
C                                                                       DIAT0829
      DO 92 I=1,2                                                       DIAT0830
      DO 92 K1=1,IORBMX                                                 DIAT0831
C                                                                       DIAT0832
      DO 91 J=1,3                                                       DIAT0833
 91   IDRBEU(J,I,K1)=0                                                  DIAT0834
C                                                                       DIAT0835
      IDRBEX(I,K1)=0                                                    DIAT0836
      IMXBEX(I,K1)=0                                                    DIAT0837
C                                                                       DIAT0838
      DO 92 K2=1,K1                                                     DIAT0839
      IDRGMX(I,K1,K2)=0                                                 DIAT0840
      K3=K1+1                                                           DIAT0841
 92   IDRGMX(I,K2,K3)=0                                                 DIAT0842
C                                                                       DIAT0843
      IF(IHOMON)96,96,93                                                DIAT0844
C                                                                       DIAT0845
 93   DO 94 K=1,KMAXA                                                   DIAT0846
      L(2,K)=L(1,K)                                                     DIAT0847
 94   M(2,K)=M(1,K)                                                     DIAT0848
C                                                                       DIAT0849
 96   CONTINUE                                                          DIAT0850
C                                                                       DIAT0851
C     TEST FOR ADEQUATE TABLE SPACE FOR FUNCTION GENERATION             DIAT0852
      NMAX=0                                                            DIAT0853
      LMAX=0                                                            DIAT0854
C                                                                       DIAT0855
      DO 110 I=1,2                                                      DIAT0856
      KK=KMAX(I)                                                        DIAT0857
C                                                                       DIAT0858
      DO 110 K=1,KK                                                     DIAT0859
      LMAX=XMAX0F(L(I,K),LMAX)                                          DIAT0860
      KOM=ICOMP(I,K)                                                    DIAT0861
C                                                                       DIAT0862
      DO 110 J=1,KOM                                                    DIAT0863
 110  NMAX=XMAX0F(N(I,K,J),NMAX)                                        DIAT0864
C                                                                       DIAT0865
      IF(XMAX0F(1,JMAX,3*LMAX)-JLIM)114,114,112                         DIAT0866
 112  STOP102                                                           DIAT0867
C     TOO MANY POWERS OF R FOR THE AVAILABLE TABLE SPACE                DIAT0868
C                                                                       DIAT0869
 114  CONTINUE                                                          DIAT0870
C                                                                       DIAT0871
      IF(INDS+INDRM1+INDKE)140,140,120                                  DIAT0872
 120  IF(LMAX+1-LLIM)140,140,130                                        DIAT0873
 130  STOP105                                                           DIAT0874
C     NO ROOM FOR FUNCTIONS GENERATED FOR OVERLAP,R**-1,KINETIC ENERGY  DIAT0875
C                                                                       DIAT0876
 140  CONTINUE                                                          DIAT0877
C                                                                       DIAT0878
      IF(INDNA+INDCOU)170,170,150                                       DIAT0879
 150  IF(2*LMAX+1-LLIM)170,170,160                                      DIAT0880
 160  STOP 106                                                          DIAT0881
C     NO ROOM FOR FUNCTIONS GENERATED FOR NUCLEAR ATTRACTION AND COULOMBDIAT0882
C                                                                       DIAT0883
 170  CONTINUE                                                          DIAT0884
C                                                                       DIAT0885
      IF(INDHYB)200,200,180                                             DIAT0886
 180  IF(3*LMAX+1-LLIM)200,200,190                                      DIAT0887
 190  STOP107                                                           DIAT0888
C     NO ROOM FOR FUNCTIONS GENERATED FOR HYBRID                        DIAT0889
C                                                                       DIAT0890
 200  CONTINUE                                                          DIAT0891
C                                                                       DIAT0892
      IF(INDEXC)230,230,210                                             DIAT0893
 210  IF(JMAX+LMAX+1-LLIM)230,230,220                                   DIAT0894
 220  STOP110                                                           DIAT0895
C     NO ROOM FOR FUNCTIONS GENERATED FOR EXCHANGE                      DIAT0896
C                                                                       DIAT0897
 230  CONTINUE                                                          DIAT0898
C                                                                       DIAT0899
      IF(JMAX+LMAX+NMAX+1-ILIM)234,234,232                              DIAT0900
 232  STOP 115                                                          DIAT0901
C     NO ROOM FOR BETA GENERATION IN FUNCTION TABLES                    DIAT0902
C                                                                       DIAT0903
 234  CONTINUE                                                          DIAT0904
C                                                                       DIAT0905
C     TEST TAPE ASSIGNMENT COMPATABILITY                                DIAT0906
      IF(IFDUP-2)240,250,250                                            DIAT0907
 240  STOP120                                                           DIAT0908
C     NOT 2 OR MORE TEMPORARY TAPES                                     DIAT0909
C                                                                       DIAT0910
 250  CONTINUE                                                          DIAT0911
      IF(ITPEF1-9)260,260,270                                           DIAT0912
 260  IF(ITPEF1)270,270,280                                             DIAT0913
 270  STOP130                                                           DIAT0914
C     ILLEGAL FIRST TEMPORARY TAPE                                      DIAT0915
C                                                                       DIAT0916
 280  CONTINUE                                                          DIAT0917
      IF(XABSF(ITPEPR-5)-5)290,290,310                                  DIAT0918
 290  IF(XABSF(ITPEPU-5)-5)300,300,310                                  DIAT0919
 300  IF(XABSF(ITPEBO-5)-5)320,320,310                                  DIAT0920
 310  STOP140                                                           DIAT0921
C     ILLEGAL OUTPUT TAPE                                               DIAT0922
C                                                                       DIAT0923
 320  CONTINUE                                                          DIAT0924
      IF(ITPEPR+ITPEPU+ITPEBO)330,330,340                               DIAT0925
 330  STOP150                                                           DIAT0926
C     NO OUTPUT TAPE                                                    DIAT0927
C                                                                       DIAT0928
 340  CONTINUE                                                          DIAT0929
      IF(ITPEPR-ITPEPU)360,350,360                                      DIAT0930
 350  IF(ITPEPR)400,360,400                                             DIAT0931
 360  IF(ITPEPU-ITPEBO)380,370,380                                      DIAT0932
 370  IF(ITPEPU)400,380,400                                             DIAT0933
 380  IF(ITPEBO-ITPEPR)410,390,410                                      DIAT0934
 390  IF(ITPEBO)400,410,400                                             DIAT0935
 400  STOP160                                                           DIAT0936
C     TWO OUTPUT TAPES ARE ASSIGNED THE SAME NUMBER                     DIAT0937
C                                                                       DIAT0938
 410  CONTINUE                                                          DIAT0939
      ITMAX=XMIN0F(ITPEF1+IFDUP-1,10)                                   DIAT0940
C                                                                       DIAT0941
      DO 460 I=ITPEF1,ITMAX                                             DIAT0942
      IF(I-ITPEPR)420,440,420                                           DIAT0943
 420  IF(I-ITPEPU)430,440,430                                           DIAT0944
 430  IF(I-ITPEBO)450,440,450                                           DIAT0945
 440  STOP170                                                           DIAT0946
C     AN OUTPUT TAPE IS ASSIGNED ALSO AS A TEMPORARY TAPE               DIAT0947
C                                                                       DIAT0948
 450  IRECTH(I)=0                                                       DIAT0949
 460  REWIND I                                                          DIAT0950
      IF DIVIDE CHECK 470,470                                           DIAT0951
 470  IF QUOTIENT OVERFLOW 480,480                                      DIAT0952
 480  IF ACCUMULATOR OVERFLOW 490,490                                   DIAT0953
 490  CONTINUE                                                          DIAT0954
C                                                                       DIAT0955
      CALL EFM                                                          DIAT0956
      H=3./FLOATF(IMAX-1)                                               DIAT0957
      CALL PRER                                                         DIAT0958
      RETURN                                                            DIAT0959
C                                                                       DIAT0960
      END(0,1,1,0,0)                                                    DIAT0961
C     M458, CORBATO, SWITENDICK                                   PRER  DIAT0962
C     DECEMBER  1, 1958                                                 DIAT0963
C     MESH MAPPING NO. 1                                                DIAT0964
C                                                                       DIAT0965
      SUBROUTINE PRER                                                   DIAT0966
C     COMMON REQUIRED(RR,IMAX,H,A)                                      DIAT0967
C                                                                       DIAT0968
C     (PACKAGE)                                                         DIAT0969
C     NOV.  3, 1958                                                     DIAT0970
C                                                                       DIAT0971
C                                                                       DIAT0972
      COMMON IND,INDS,INDRM1,INDKE,INDNA,INDCOU,INDHYB,INDEXC,IHOMON,   DIAT0973
     1 ITPEPR,ITPEPU,ITPEBO,ITPEF1,IFDUP,IGENSP,IBATCH,KMAXA,KMAXB,MESH,DIAT0974
     2 IMAX,IHALF,JMAX,IORBMX,ILIM,JLIM,LLIM,KOMLIM,A,H,THRESM,THRESS,  DIAT0975
     3 NMAX,LMAX,N,L,M,CAPPA,WEIGHT,ICOMP,IDRBEU,IDRBEX,IMXBEX,         DIAT0976
     4        IDRGMX,IRECTH,DRDT,R,FF,F1,F2,F3,F4,F5,F6,F7,F8,EE,E1,E2, DIAT0977
     5 E3,RR,TEMP1,TEMP2,TEMP3,BETA,W                                   DIAT0978
C                                                                       DIAT0979
      EQUIVALENCE(IND(1),INDS),(IND(2),INDRM1),(IND(3),INDKE),          DIAT0980
     1 (IND(4),INDNA),(IND(5),INDCOU),(IND(6),INDHYB),(IND(7),INDEXC),  DIAT0981
     2 (KMAX(1),KMAXA),(KMAX(2),KMAXB),                                 DIAT0982
     3 (FF(   1),F1),(FF( 386),F2),(FF( 771),F3),(FF(1156),F4),         DIAT0983
     4 (FF(1541),F5),(FF(1926),F6),(FF(2311),F7),(FF(2696),F8),         DIAT0984
     5 (EE(   1),E1),(EE( 386),E2),(EE( 771),E3),                       DIAT0985
     6 (W,DRDT),(W(386),R),(W(11166),FF),(W(14246),EE),(RR,W),          DIAT0986
     7 (TEMP1,W(386)),(TEMP2,W(771)),(TEMP3,W(1156)),(BETA,W(1541))     DIAT0987
C                                                                       DIAT0988
      DIMENSION IND(7),KMAX(2),N(2,20,16),L(2,20),M(2,20),              DIAT0989
     1 CAPPA(2,20,16),WEIGHT(2,20,16),ICOMP(2,20),IDRBEU(3,2,20),       DIAT0990
     2 IDRBEX(2,20),IMXBEX(2,20),                IDRGMX(2,20,21),       DIAT0991
     3 IRECTH(10),DRDT(385),R(385,27),FF(385,8),F1(385),F2(385),F3(385),DIAT0992
     4 F4(385),F5(385),F6(385),F7(385),F8(385),EE(385,3),E1(385),       DIAT0993
     5 E2(385),E3(385),RR(385),TEMP1(385),TEMP2(385),TEMP3(385),        DIAT0994
     6 BETA(385,39),W(385,43)                                           DIAT0995
C                                                                       DIAT0996
C                                                                       DIAT0997
      T=0.                                                              DIAT0998
      RR(IMAX)=1.0E38                                                   DIAT0999
      IMAXM1=IMAX-1                                                     DIAT1000
      DO 10 I=1,IMAXM1                                                  DIAT1001
      RR(I)=(.5*A*T)/(3.-T)                                             DIAT1002
 10   T=T+H                                                             DIAT1003
C                                                                       DIAT1004
      RETURN                                                            DIAT1005
C                                                                       DIAT1006
      END(0,1,0,0,0)                                                    DIAT1007
C     M458'64 CORBATO SWITENDICK                                GENBEU  DIAT1008
C     FEBRUARY  3,1959                                                  DIAT1009
C                                                                       DIAT1010
      SUBROUTINE GENBEU                                                 DIAT1011
C     REQUIRED COMMON(INDS,INDRM1,INDKE,INDCOU,INDEXC,                  DIAT1012
C                         KMAX,ICOMP,IMAX,TEMP1,TEMP2,TEMP3,N,L,CAPPA,  DIAT1013
C                           IDRBEU,ITPEF1,IGENSP,IHOMON)                DIAT1014
C                                                                       DIAT1015
C                                                                       DIAT1016
C     (PACKAGE)                                                         DIAT1017
C     NOV.  3, 1958                                                     DIAT1018
C                                                                       DIAT1019
C                                                                       DIAT1020
      COMMON IND,INDS,INDRM1,INDKE,INDNA,INDCOU,INDHYB,INDEXC,IHOMON,   DIAT1021
     1 ITPEPR,ITPEPU,ITPEBO,ITPEF1,IFDUP,IGENSP,IBATCH,KMAXA,KMAXB,MESH,DIAT1022
     2 IMAX,IHALF,JMAX,IORBMX,ILIM,JLIM,LLIM,KOMLIM,A,H,THRESM,THRESS,  DIAT1023
     3 NMAX,LMAX,N,L,M,CAPPA,WEIGHT,ICOMP,IDRBEU,IDRBEX,IMXBEX,         DIAT1024
     4        IDRGMX,IRECTH,DRDT,R,FF,F1,F2,F3,F4,F5,F6,F7,F8,EE,E1,E2, DIAT1025
     5 E3,RR,TEMP1,TEMP2,TEMP3,BETA,W                                   DIAT1026
C                                                                       DIAT1027
      EQUIVALENCE(IND(1),INDS),(IND(2),INDRM1),(IND(3),INDKE),          DIAT1028
     1 (IND(4),INDNA),(IND(5),INDCOU),(IND(6),INDHYB),(IND(7),INDEXC),  DIAT1029
     2 (KMAX(1),KMAXA),(KMAX(2),KMAXB),                                 DIAT1030
     3 (FF(   1),F1),(FF( 386),F2),(FF( 771),F3),(FF(1156),F4),         DIAT1031
     4 (FF(1541),F5),(FF(1926),F6),(FF(2311),F7),(FF(2696),F8),         DIAT1032
     5 (EE(   1),E1),(EE( 386),E2),(EE( 771),E3),                       DIAT1033
     6 (W,DRDT),(W(386),R),(W(11166),FF),(W(14246),EE),(RR,W),          DIAT1034
     7 (TEMP1,W(386)),(TEMP2,W(771)),(TEMP3,W(1156)),(BETA,W(1541))     DIAT1035
C                                                                       DIAT1036
      DIMENSION IND(7),KMAX(2),N(2,20,16),L(2,20),M(2,20),              DIAT1037
     1 CAPPA(2,20,16),WEIGHT(2,20,16),ICOMP(2,20),IDRBEU(3,2,20),       DIAT1038
     2 IDRBEX(2,20),IMXBEX(2,20),                IDRGMX(2,20,21),       DIAT1039
     3 IRECTH(10),DRDT(385),R(385,27),FF(385,8),F1(385),F2(385),F3(385),DIAT1040
     4 F4(385),F5(385),F6(385),F7(385),F8(385),EE(385,3),E1(385),       DIAT1041
     5 E2(385),E3(385),RR(385),TEMP1(385),TEMP2(385),TEMP3(385),        DIAT1042
     6 BETA(385,39),W(385,43)                                           DIAT1043
C                                                                       DIAT1044
C                                                                       DIAT1045
      IF(IGENSP) 10,10,210                                              DIAT1046
 10   IF(INDS+INDRM1+INDKE+INDHYB+INDEXC+INDCOU) 210,210,20             DIAT1047
 20   IF(INDS+INDRM1+INDKE+INDHYB+INDCOU) 40,40,30                      DIAT1048
 30   ICENTM=2                                                          DIAT1049
      GO TO 45                                                          DIAT1050
 40   ICENTM=1                                                          DIAT1051
C                                                                       DIAT1052
 45   DO 200 ICENT=1,ICENTM                                             DIAT1053
      KK=KMAX(ICENT)                                                    DIAT1054
      IF(IHOMON) 50,50,48                                               DIAT1055
 48   KK=KMAX(1)                                                        DIAT1056
 50   CONTINUE                                                          DIAT1057
C                                                                       DIAT1058
      DO 200 K1=1,KK                                                    DIAT1059
      IF (IHOMON) 55,55,52                                              DIAT1060
 52   IF (ICENT-2) 55,53,53                                             DIAT1061
C                                                                       DIAT1062
 53   DO 54 MMM=1,3                                                     DIAT1063
 54   IDRBEU (MMM,2,K1)=IDRBEU(MMM,1,K1)                                DIAT1064
C                                                                       DIAT1065
      GO TO 200                                                         DIAT1066
 55   K=K1                                                              DIAT1067
      L1=L(ICENT,K1)                                                    DIAT1068
 59   JCOMP=ICOMP(ICENT,K)                                              DIAT1069
      IF(JCOMP) 63,70,70                                                DIAT1070
 63   CONTINUE                                                          DIAT1071
      KDATA=K+JCOMP                                                     DIAT1072
      IF(L1-L(ICENT,KDATA)) 67,64,67                                    DIAT1073
 64   CONTINUE                                                          DIAT1074
C                                                                       DIAT1075
      DO 65 MMM=1,3                                                     DIAT1076
 65   IDRBEU(MMM,ICENT,K1)=IDRBEU(MMM,ICENT,KDATA)                      DIAT1077
C                                                                       DIAT1078
      GO TO 200                                                         DIAT1079
 67   CONTINUE                                                          DIAT1080
      K=KDATA                                                           DIAT1081
      GO TO 59                                                          DIAT1082
 70   CONTINUE                                                          DIAT1083
C                                                                       DIAT1084
      DO 80 I=1,IMAX                                                    DIAT1085
      TEMP1(I)=0.                                                       DIAT1086
      TEMP2(I)=0.                                                       DIAT1087
 80   TEMP3(I)=0.                                                       DIAT1088
C                                                                       DIAT1089
      DO 140 J=1,JCOMP                                                  DIAT1090
      FN1=N(ICENT,K,J)-2                                                DIAT1091
      FN2=N(ICENT,K,J)+N(ICENT,K,J)                                     DIAT1092
      FN3=(N(ICENT,K,J)+L1)*(N(ICENT,K,J)-L1-1)                         DIAT1093
      FNORM1=FNORM(ICENT,K,J)                                           DIAT1094
      CAPPA2=CAPPA(ICENT,K,J)**2                                        DIAT1095
C                                                                       DIAT1096
      DO 140 I=1,IMAX                                                   DIAT1097
      IF(RR(I)-1.E35) 82,85,85                                          DIAT1098
 82   X=CAPPA(ICENT,K,J)*RR(I)                                          DIAT1099
      IF(X)  83,83,84                                                   DIAT1100
 83   C=FNORM1*(1.-MIN1F(1.,ABSF(FN1)))                                 DIAT1101
      GO TO 87                                                          DIAT1102
 84   X1=FN1*LOGF(X)-X                                                  DIAT1103
      IF (X1+87.3) 85,85,86                                             DIAT1104
 85   C=0.                                                              DIAT1105
      GO TO 87                                                          DIAT1106
 86   C=FNORM1*EXPF(X1)                                                 DIAT1107
 87   B=X*C                                                             DIAT1108
      D=X*B                                                             DIAT1109
      IF(INDKE) 100,100,90                                              DIAT1110
 90   TEMP3(I)=.5*CAPPA2*(D-FN2*B+FN3*C)+TEMP3(I)                       DIAT1111
 100  IF(INDRM1) 120,120,110                                            DIAT1112
 110  TEMP2(I)=CAPPA(ICENT,K,J)*B+TEMP2(I)                              DIAT1113
 120  CONTINUE                                                          DIAT1114
 130  TEMP1(I)=D+TEMP1(I)                                               DIAT1115
 140  CONTINUE                                                          DIAT1116
C                                                                       DIAT1117
 150  MM=1                                                              DIAT1118
      ASSIGN 151 TO IRET                                                DIAT1119
      GO TO 300                                                         DIAT1120
 151  WRITE TAPE IT,ICODE,(TEMP1(I), I=1,IMAX)                          DIAT1121
 160  IF(INDRM1) 180,180,170                                            DIAT1122
 170  MM=2                                                              DIAT1123
      ASSIGN 171 TO IRET                                                DIAT1124
      GO TO 300                                                         DIAT1125
 171  WRITE TAPE IT,ICODE,(TEMP2(I), I=1,IMAX)                          DIAT1126
 180  IF(INDKE) 200,200,190                                             DIAT1127
 190  MM=3                                                              DIAT1128
      ASSIGN 191 TO IRET                                                DIAT1129
      GO TO 300                                                         DIAT1130
 191  WRITE TAPE IT,ICODE,(TEMP3(I), I=1,IMAX)                          DIAT1131
C                                                                       DIAT1132
 200  CONTINUE                                                          DIAT1133
C                                                                       DIAT1134
      GO TO 210                                                         DIAT1135
C                                                                       DIAT1136
 300  IT=ITPEF1+1                                                       DIAT1137
      IRECTH(IT)=IRECTH(IT)+1                                           DIAT1138
      IDRBEU(MM,ICENT,K1)=6553*(ITPEF1-6)+IRECTH(IT)                    DIAT1139
      ICODE=IDRBEU(MM,ICENT,K1)                                         DIAT1140
      CALL ETT(IT)                                                      DIAT1141
      GO TO IRET, (151,171,191)                                         DIAT1142
 210  RETURN                                                            DIAT1143
C                                                                       DIAT1144
      END(0,1,0,0,0)                                                    DIAT1145
C     M458'64 SWITENDICK CORBATO                                 GENIN  DIAT1146
C     DEC.  1, 1958                                                     DIAT1147
      SUBROUTINE GENIN(X,N,XIN)                                         DIAT1148
      DIMENSION XIN(385)                                                DIAT1149
C                                                                       DIAT1150
C     I(N,X) STORED IN XIN(N+1)                                         DIAT1151
C                                                                       DIAT1152
      IF(ABSF(X)-FLOATF(4*N+2)) 10,10,70                                DIAT1153
 10   T=27.*.35*ABSF(X)                                                 DIAT1154
      AN=SQRTF(T)-.5                                                    DIAT1155
      P=MAX1F(FLOATF(N),AN)                                             DIAT1156
      M=3.7+T/(P+.5)+P                                                  DIAT1157
      R=0.                                                              DIAT1158
C                                                                       DIAT1159
      DO 50 J=1,M                                                       DIAT1160
      K=M-J+2                                                           DIAT1161
      R=X/(FLOATF(K+K-1)+X*R)                                           DIAT1162
      IF(N+1-K) 50,45,45                                                DIAT1163
 45   CONTINUE                                                          DIAT1164
      XIN(K)=R                                                          DIAT1165
 50   CONTINUE                                                          DIAT1166
C                                                                       DIAT1167
      XIN(1)=1./(1.+ABSF(X)+R*X)                                        DIAT1168
      NP1=N+1                                                           DIAT1169
      IF(N) 110,110,55                                                  DIAT1170
C                                                                       DIAT1171
 55   CONTINUE                                                          DIAT1172
      DO 60 J=2,NP1                                                     DIAT1173
 60   XIN(J)=XIN(J-1)*XIN(J)                                            DIAT1174
C                                                                       DIAT1175
      GO TO 110                                                         DIAT1176
 70   TX=2.*ABSF(X)                                                     DIAT1177
      IF(TX-87.3) 73,72,72                                              DIAT1178
 72   TE=0.                                                             DIAT1179
      GO TO 75                                                          DIAT1180
 73   CONTINUE                                                          DIAT1181
      TE=EXPF(-TX)                                                      DIAT1182
 75   CONTINUE                                                          DIAT1183
      XIN(1)=(1.-TE)/TX                                                 DIAT1184
      IF (N) 110,110,80                                                 DIAT1185
 80   XIN(2)=((1.+TE)/2.-XIN(1))/X                                      DIAT1186
      IF (N-1) 110,110,90                                               DIAT1187
 90   NP1=N+1                                                           DIAT1188
C                                                                       DIAT1189
      DO 100 J=3,NP1                                                    DIAT1190
 100  XIN(J)=XIN(J-2)- FLOATF(J+J -3 )*XIN(J-1)/X                       DIAT1191
C                                                                       DIAT1192
 110  RETURN                                                            DIAT1193
C                                                                       DIAT1194
      END(0,1,0,0,0)                                                    DIAT1195
C     M458'64 SWITENDICK CORBATO                                 GENKN  DIAT1196
C     DEC.  1, 1958                                                     DIAT1197
      SUBROUTINE GENKN(X,N,XKN)                                         DIAT1198
      DIMENSION XKN(385)                                                DIAT1199
C                                                                       DIAT1200
C     K(N) STORED IN XKN(N+1)                                           DIAT1201
C                                                                       DIAT1202
      XKN(1)=1./X                                                       DIAT1203
      IF(N) 50,50,30                                                    DIAT1204
 30   XKN(2)=XKN(1)*(1.+XKN(1))                                         DIAT1205
      IF (N-1) 50,50,40                                                 DIAT1206
C                                                                       DIAT1207
 40   DO 45 M=2,N                                                       DIAT1208
      MP1=M+1                                                           DIAT1209
      XKN(MP1)=XKN(M)*FLOATF(M+M-1)/X+XKN(M-1)                          DIAT1210
 45   CONTINUE                                                          DIAT1211
C                                                                       DIAT1212
 50   RETURN                                                            DIAT1213
C                                                                       DIAT1214
      END(0,1,0,0,0)                                                    DIAT1215
C     * M 458  CORBATO, SWITENDICK                                GENBEXDIAT1216
C     *APRIL 17, 1959                                                   DIAT1217
      SUBROUTINE GENBEX                                                 DIAT1218
C     REQUIRED COMMON(INDS,INDRM1,INDKE,INDHYB,INDEXC,LMAX,JMAX,KMAX,   DIAT1219
C                         IMAX,TEMP1,TEMP2,TEMP3,RR,A,IHOMON,IDRBEX,    DIAT1220
C                         IMXBEX,L,M,ICOMP,CAPPA,BETA,IRECTH,ITPEF1,BETADIAT1221
C                                                                       DIAT1222
C                                                                       DIAT1223
C     (PACKAGE)                                                         DIAT1224
C     NOV.  3, 1958                                                     DIAT1225
C                                                                       DIAT1226
C                                                                       DIAT1227
      COMMON IND,INDS,INDRM1,INDKE,INDNA,INDCOU,INDHYB,INDEXC,IHOMON,   DIAT1228
     1 ITPEPR,ITPEPU,ITPEBO,ITPEF1,IFDUP,IGENSP,IBATCH,KMAXA,KMAXB,MESH,DIAT1229
     2 IMAX,IHALF,JMAX,IORBMX,ILIM,JLIM,LLIM,KOMLIM,A,H,THRESM,THRESS,  DIAT1230
     3 NMAX,LMAX,N,L,M,CAPPA,WEIGHT,ICOMP,IDRBEU,IDRBEX,IMXBEX,         DIAT1231
     4        IDRGMX,IRECTH,DRDT,R,FF,F1,F2,F3,F4,F5,F6,F7,F8,EE,E1,E2, DIAT1232
     5 E3,RR,TEMP1,TEMP2,TEMP3,BETA,W                                   DIAT1233
C                                                                       DIAT1234
      EQUIVALENCE(IND(1),INDS),(IND(2),INDRM1),(IND(3),INDKE),          DIAT1235
     1 (IND(4),INDNA),(IND(5),INDCOU),(IND(6),INDHYB),(IND(7),INDEXC),  DIAT1236
     2 (KMAX(1),KMAXA),(KMAX(2),KMAXB),                                 DIAT1237
     3 (FF(   1),F1),(FF( 386),F2),(FF( 771),F3),(FF(1156),F4),         DIAT1238
     4 (FF(1541),F5),(FF(1926),F6),(FF(2311),F7),(FF(2696),F8),         DIAT1239
     5 (EE(   1),E1),(EE( 386),E2),(EE( 771),E3),                       DIAT1240
     6 (W,DRDT),(W(386),R),(W(11166),FF),(W(14246),EE),(RR,W),          DIAT1241
     7 (TEMP1,W(386)),(TEMP2,W(771)),(TEMP3,W(1156)),(BETA,W(1541))     DIAT1242
C                                                                       DIAT1243
      DIMENSION IND(7),KMAX(2),N(2,20,16),L(2,20),M(2,20),              DIAT1244
     1 CAPPA(2,20,16),WEIGHT(2,20,16),ICOMP(2,20),IDRBEU(3,2,20),       DIAT1245
     2 IDRBEX(2,20),IMXBEX(2,20),                IDRGMX(2,20,21),       DIAT1246
     3 IRECTH(10),DRDT(385),R(385,27),FF(385,8),F1(385),F2(385),F3(385),DIAT1247
     4 F4(385),F5(385),F6(385),F7(385),F8(385),EE(385,3),E1(385),       DIAT1248
     5 E2(385),E3(385),RR(385),TEMP1(385),TEMP2(385),TEMP3(385),        DIAT1249
     6 BETA(385,39),W(385,43)                                           DIAT1250
C                                                                       DIAT1251
C                                                                       DIAT1252
      IF(IGENSP) 250,5,250                                              DIAT1253
 5    IF(INDS+INDRM1+INDKE+INDHYB+INDEXC) 250,250,10                    DIAT1254
 10   JMAX1=0                                                           DIAT1255
      JMAX2=0                                                           DIAT1256
      LMAX1=LMAX                                                        DIAT1257
      LMAX2=LMAX                                                        DIAT1258
      IF(INDS+INDRM1+INDKE) 40,40,30                                    DIAT1259
 30   JMAX2=LMAX1                                                       DIAT1260
      JMAX1=LMAX2                                                       DIAT1261
 40   IF (INDHYB) 60,60,50                                              DIAT1262
 50   JMAX1=3*LMAX2                                                     DIAT1263
      JMAX2=3*LMAX1                                                     DIAT1264
 60   IF(INDEXC) 71,71,70                                               DIAT1265
 70   JMAX2=XMAX0F(JMAX2,JMAX+LMAX1)                                    DIAT1266
 71   IF(INDRM1+INDHYB) 74,74,72                                        DIAT1267
 72   ICENTM=2                                                          DIAT1268
      GO TO 75                                                          DIAT1269
 74   ICENTM=1                                                          DIAT1270
 75   CONTINUE                                                          DIAT1271
C                                                                       DIAT1272
      DO 190 ICENTX=1,ICENTM                                            DIAT1273
      ICENT=3-ICENTX                                                    DIAT1274
      IF(ICENT-1) 80,80,85                                              DIAT1275
 80   JMAXEX=JMAX1                                                      DIAT1276
      GO TO 90                                                          DIAT1277
 85   JMAXEX=JMAX2                                                      DIAT1278
 90   JMAXP1=JMAXEX+1                                                   DIAT1279
      IF(IHOMON-1) 94,92,190                                            DIAT1280
 92   IF(ICENTX-2) 93,190,190                                           DIAT1281
 93   ICENT=1                                                           DIAT1282
 94   KK=KMAX(ICENT)                                                    DIAT1283
C                                                                       DIAT1284
      DO 100 I=1,IMAX                                                   DIAT1285
 100  TEMP3(I)=-ABSF(RR(I)-A)                                           DIAT1286
C                                                                       DIAT1287
      DO 180 K1=1,KK                                                    DIAT1288
 107  JMINP1=XABSF(M(ICENT,K1))+1                                       DIAT1289
      IF(JMAXP1-JMINP1) 180,108,108                                     DIAT1290
 108  K=K1                                                              DIAT1291
 109  JCOMP=ICOMP(ICENT,K)                                              DIAT1292
      IF(JCOMP) 110,116,116                                             DIAT1293
 110  K=K+JCOMP                                                         DIAT1294
      GO TO 109                                                         DIAT1295
C                                                                       DIAT1296
 116  DO 119 I=1,IMAX                                                   DIAT1297
      DO 119 JIND=JMINP1,JMAXP1                                         DIAT1298
 119  BETA(I,JIND)=0.                                                   DIAT1299
C                                                                       DIAT1300
      DO 150 J=1,JCOMP                                                  DIAT1301
      FNORM1=FNORM(ICENT,K,J)                                           DIAT1302
C                                                                       DIAT1303
      DO 150 I=1,IMAX                                                   DIAT1304
      IF(TEMP3(I)+1.E35) 150,150,125                                    DIAT1305
 125  X1=CAPPA(ICENT,K,J)*TEMP3(I)                                      DIAT1306
      IF (X1+87.3) 150,150,130                                          DIAT1307
 130  TEMP1(I)=FNORM1*EXPF(X1)                                          DIAT1308
      IF(TEMP1(I))142,150,142                                           DIAT1309
 142  CALL BETAFN(N(ICENT,K,J),L(ICENT,K1),XABSF(M(ICENT,K1)),JMAXEX,CAPDIAT1310
     1PA(ICENT,K,J),A,RR(I),TEMP2)                                      DIAT1311
C                                                                       DIAT1312
      DO 145 JIND=JMINP1,JMAXP1                                         DIAT1313
      BETA(I,JIND)=TEMP1(I)*TEMP2(JIND)*FLOATF(JIND+JIND-1)+BETA(I,JIND)DIAT1314
 145  CONTINUE                                                          DIAT1315
C                                                                       DIAT1316
 150  CONTINUE                                                          DIAT1317
C                                                                       DIAT1318
      IT=ITPEF1+1                                                       DIAT1319
      IDRBEX(ICENT,K1)=6553*(ITPEF1-6)+IRECTH(IT)+1                     DIAT1320
      ICODE=IDRBEX(ICENT,K1)                                            DIAT1321
C                                                                       DIAT1322
      DO 170 JIND=JMINP1,JMAXP1                                         DIAT1323
      IRECTH(IT)=IRECTH(IT)+1                                           DIAT1324
      CALL ETT(IT)                                                      DIAT1325
 160  WRITE TAPE IT, ICODE,(BETA(I,JIND),   I=1,IMAX)                   DIAT1326
      ICODE=ICODE+1                                                     DIAT1327
 170  CONTINUE                                                          DIAT1328
C                                                                       DIAT1329
      IMXBEX(ICENT,K1)=ICODE-1                                          DIAT1330
      IF(IHOMON-1) 180,175,180                                          DIAT1331
 175  IDRBEX(2,K1)=IDRBEX(1,K1)                                         DIAT1332
      IMXBEX(2,K1)=IMXBEX(1,K1)                                         DIAT1333
 180  CONTINUE                                                          DIAT1334
C                                                                       DIAT1335
 190  CONTINUE                                                          DIAT1336
C                                                                       DIAT1337
 250  RETURN                                                            DIAT1338
C                                                                       DIAT1339
      END(0,1,0,0,0)                                                    DIAT1340
C     * M458  CORBATO, SWITENDICK                                 GENGMXDIAT1341
C     *APRIL  8, 1959                                                   DIAT1342
      SUBROUTINE GENGMX                                                 DIAT1343
C                                                                       DIAT1344
C     REQUIRED COMMON (IGENSP,INDNA,INDCOU,LMAX,RR,A,KMAX,IHOMON,IDRGMX,DIAT1345
C                      L,M,IMAX,ICOMP,CAPPA,TEMP1,TEMP2,BETA,ITPEF1,N   DIAT1346
C                      IRECTH                         )                 DIAT1347
C                                                                       DIAT1348
C                                                                       DIAT1349
C     (PACKAGE)                                                         DIAT1350
C     NOV.  3, 1958                                                     DIAT1351
C                                                                       DIAT1352
C                                                                       DIAT1353
      COMMON IND,INDS,INDRM1,INDKE,INDNA,INDCOU,INDHYB,INDEXC,IHOMON,   DIAT1354
     1 ITPEPR,ITPEPU,ITPEBO,ITPEF1,IFDUP,IGENSP,IBATCH,KMAXA,KMAXB,MESH,DIAT1355
     2 IMAX,IHALF,JMAX,IORBMX,ILIM,JLIM,LLIM,KOMLIM,A,H,THRESM,THRESS,  DIAT1356
     3 NMAX,LMAX,N,L,M,CAPPA,WEIGHT,ICOMP,IDRBEU,IDRBEX,IMXBEX,         DIAT1357
     4        IDRGMX,IRECTH,DRDT,R,FF,F1,F2,F3,F4,F5,F6,F7,F8,EE,E1,E2, DIAT1358
     5 E3,RR,TEMP1,TEMP2,TEMP3,BETA,W                                   DIAT1359
C                                                                       DIAT1360
      EQUIVALENCE(IND(1),INDS),(IND(2),INDRM1),(IND(3),INDKE),          DIAT1361
     1 (IND(4),INDNA),(IND(5),INDCOU),(IND(6),INDHYB),(IND(7),INDEXC),  DIAT1362
     2 (KMAX(1),KMAXA),(KMAX(2),KMAXB),                                 DIAT1363
     3 (FF(   1),F1),(FF( 386),F2),(FF( 771),F3),(FF(1156),F4),         DIAT1364
     4 (FF(1541),F5),(FF(1926),F6),(FF(2311),F7),(FF(2696),F8),         DIAT1365
     5 (EE(   1),E1),(EE( 386),E2),(EE( 771),E3),                       DIAT1366
     6 (W,DRDT),(W(386),R),(W(11166),FF),(W(14246),EE),(RR,W),          DIAT1367
     7 (TEMP1,W(386)),(TEMP2,W(771)),(TEMP3,W(1156)),(BETA,W(1541))     DIAT1368
C                                                                       DIAT1369
      DIMENSION IND(7),KMAX(2),N(2,20,16),L(2,20),M(2,20),              DIAT1370
     1 CAPPA(2,20,16),WEIGHT(2,20,16),ICOMP(2,20),IDRBEU(3,2,20),       DIAT1371
     2 IDRBEX(2,20),IMXBEX(2,20),                IDRGMX(2,20,21),       DIAT1372
     3 IRECTH(10),DRDT(385),R(385,27),FF(385,8),F1(385),F2(385),F3(385),DIAT1373
     4 F4(385),F5(385),F6(385),F7(385),F8(385),EE(385,3),E1(385),       DIAT1374
     5 E2(385),E3(385),RR(385),TEMP1(385),TEMP2(385),TEMP3(385),        DIAT1375
     6 BETA(385,39),W(385,43)                                           DIAT1376
C                                                                       DIAT1377
C                                                                       DIAT1378
      IF(IGENSP)    210,5,210                                           DIAT1379
 5    CONTINUE                                                          DIAT1380
      IF(INDNA+INDCOU) 210,210,10                                       DIAT1381
 10   CONTINUE                                                          DIAT1382
      ICENTM=1                                                          DIAT1383
      JGMAX=0                                                           DIAT1384
      IF(INDNA) 14,14,12                                                DIAT1385
 12   ICENTM=2                                                          DIAT1386
 14   CONTINUE                                                          DIAT1387
      IF(INDCOU) 18,18,16                                               DIAT1388
 16   LMAX1=LMAX                                                        DIAT1389
      LMAX2=LMAX                                                        DIAT1390
      JGMAX=XMIN0F(LMAX1+LMAX1,LMAX2+LMAX2)                             DIAT1391
 18   CONTINUE                                                          DIAT1392
      JGMXP1=JGMAX+1                                                    DIAT1393
C                                                                       DIAT1394
      DO 19 I=1,IMAX                                                    DIAT1395
 19   TEMP1(I)=-ABSF(RR(I)-A)                                           DIAT1396
C                                                                       DIAT1397
      DO 190 ICENTX=1,ICENTM                                            DIAT1398
      ICENT=3-ICENTX                                                    DIAT1399
      IF(IHOMON-1) 22,20,190                                            DIAT1400
 20   IF(ICENTX-2) 21,190,190                                           DIAT1401
 21   ICENT=1                                                           DIAT1402
 22   KK=KMAX(ICENT)                                                    DIAT1403
C                                                                       DIAT1404
      DO 180 K1=1,KK                                                    DIAT1405
      DO 170 K2=1,K1                                                    DIAT1406
      L1=L(ICENT,K1)                                                    DIAT1407
      L2=L(ICENT,K2)                                                    DIAT1408
 30   CONTINUE                                                          DIAT1409
C                                                                       DIAT1410
      DO 160 MSWITC=1,3,2                                               DIAT1411
      MSW=2-MSWITC                                                      DIAT1412
      M1=XABSF(M(ICENT,K1))                                             DIAT1413
      M2=XSIGNF(M(ICENT,K2),MSW)                                        DIAT1414
      IF(MSW) 23,23,25                                                  DIAT1415
 23   IF(M1) 24,160,24                                                  DIAT1416
 24   IF(M2) 25,160,25                                                  DIAT1417
 25   CONTINUE                                                          DIAT1418
      MDIFF=XABSF(M1-M2)                                                DIAT1419
      JGMNP1=MDIFF+1                                                    DIAT1420
      IF(JGMXP1-JGMNP1) 160,50,50                                       DIAT1421
 50   CONTINUE                                                          DIAT1422
C                                                                       DIAT1423
      J1COMP=ICOMP(ICENT,K1)                                            DIAT1424
      KDATA1=K1                                                         DIAT1425
 52   J2COMP=ICOMP(ICENT,K2)                                            DIAT1426
      KDATA2=K2                                                         DIAT1427
 56   IF(J1COMP) 57,67,67                                               DIAT1428
 57   KDATA1=KDATA1+J1COMP                                              DIAT1429
      J1COMP=ICOMP(ICENT,KDATA1)                                        DIAT1430
      GO TO 56                                                          DIAT1431
 67   IF(J2COMP) 68,69,69                                               DIAT1432
 68   KDATA2=KDATA2+J2COMP                                              DIAT1433
      J2COMP=ICOMP(ICENT,KDATA2)                                        DIAT1434
      GO TO 67                                                          DIAT1435
 69   CONTINUE                                                          DIAT1436
C                                                                       DIAT1437
C     COMPUTE EXPANSION FUNCTIONS                                       DIAT1438
      DO 72 I=1,IMAX                                                    DIAT1439
      DO 72 JIND=JGMNP1,JGMXP1                                          DIAT1440
 72   BETA(I,JIND)=0.                                                   DIAT1441
      LGMNP1=XMAX0F(XABSF(L1-L2),MDIFF)+1                               DIAT1442
      LGMXP1=L1+L2+1                                                    DIAT1443
      LGMNP1=LGMNP1+XABSF(XMODF(LGMXP1,2)-XMODF(LGMNP1,2))              DIAT1444
C                                                                       DIAT1445
      DO 120 LSUMP1=LGMNP1,LGMXP1 ,2                                    DIAT1446
      LSUM=LSUMP1-1                                                     DIAT1447
      X=DCOE(LSUM,L1,L2,M1,M2)                                          DIAT1448
      IF(X) 74,120,74                                                   DIAT1449
 74   CONTINUE                                                          DIAT1450
C                                                                       DIAT1451
      DO 110 J1=1,J1COMP                                                DIAT1452
      DO 110 J2=1,J2COMP                                                DIAT1453
      NSUM=N(ICENT,KDATA1,J1)+N(ICENT,KDATA2,J2)                        DIAT1454
      NSUMM1=NSUM-1                                                     DIAT1455
      CAPSUM=CAPPA(ICENT,KDATA1,J1)+CAPPA(ICENT,KDATA2,J2)              DIAT1456
      FNORM1=X*FNORM(ICENT,KDATA1,J1)*FNORM(ICENT,KDATA2,J2)*CAPPA(ICENTDIAT1457
     1,KDATA1,J1)**N(ICENT,KDATA1,J1)*CAPPA(ICENT,KDATA2,J2)**N(ICENT,KDDIAT1458
     2ATA2,J2)/CAPSUM**NSUMM1                                           DIAT1459
C                                                                       DIAT1460
      DO 100 I=1,IMAX                                                   DIAT1461
      IF(TEMP1(I)+1.E35) 100,100,75                                     DIAT1462
 75   X2=CAPSUM*TEMP1(I)                                                DIAT1463
      IF(X2+87.3)  100,100,80                                           DIAT1464
 80   X2=FNORM1*RR(I)*EXPF( X2)                                         DIAT1465
      CALL BETAFN(NSUMM1,LSUM,MDIFF,JGMAX,CAPSUM,A,RR(I),TEMP2)         DIAT1466
C                                                                       DIAT1467
      DO  90 JIND=JGMNP1,JGMXP1                                         DIAT1468
      BETA(I,JIND)=X2*TEMP2(JIND)*(FLOATF(JIND+JIND-1))+BETA(I,JIND)    DIAT1469
 90   CONTINUE                                                          DIAT1470
 100  CONTINUE                                                          DIAT1471
 110  CONTINUE                                                          DIAT1472
 120  CONTINUE                                                          DIAT1473
C                                                                       DIAT1474
      IT=ITPEF1+1                                                       DIAT1475
      IF(MSW) 128,125,125                                               DIAT1476
 125  CONTINUE                                                          DIAT1477
      IDRGMX(ICENT,K1,K2)=6553*(ITPEF1-6)+IRECTH(IT)+1                  DIAT1478
 128  CONTINUE                                                          DIAT1479
C                                                                       DIAT1480
      DO 150 JIND=JGMNP1,JGMXP1                                         DIAT1481
      IRECTH(IT)=IRECTH(IT)+1                                           DIAT1482
      ICODE=6553*(ITPEF1-6)+IRECTH(IT)                                  DIAT1483
      CALL ETT(IT)                                                      DIAT1484
      WRITE TAPE IT,ICODE,(BETA(I,JIND  ),I=1,IMAX)                     DIAT1485
 150  CONTINUE                                                          DIAT1486
C                                                                       DIAT1487
      IF(MSW) 154,154,152                                               DIAT1488
 152  IDRGMX(ICENT,K2  ,K1  +1)=(ICODE+1-IDRGMX(ICENT,K1  ,K2  ))*512   DIAT1489
      IMID=ICODE+1                                                      DIAT1490
      GO TO 156                                                         DIAT1491
 154  IDRGMX(ICENT,K2  ,K1  +1)=IDRGMX(ICENT,K2  ,K1  +1)+ICODE+1-IMID  DIAT1492
 156  CONTINUE                                                          DIAT1493
 160  CONTINUE                                                          DIAT1494
C                                                                       DIAT1495
      IF(IHOMON-1) 170,165,170                                          DIAT1496
 165  IDRGMX(2,K1,K2)=IDRGMX(1,K1,K2)                                   DIAT1497
      IDRGMX(2,K2,K1+1)=IDRGMX(1,K2,K1+1)                               DIAT1498
 170  CONTINUE                                                          DIAT1499
C                                                                       DIAT1500
 180  CONTINUE                                                          DIAT1501
C                                                                       DIAT1502
 190  CONTINUE                                                          DIAT1503
C                                                                       DIAT1504
C                                                                       DIAT1505
 210  RETURN                                                            DIAT1506
C                                                                       DIAT1507
      END(0,1,0,0,0)                                                    DIAT1508
C     * M458, CORBATO, SWITENDICK                                 BETAFNDIAT1509
C     AUGUST 10, 1959                                                   DIAT1510
C                                                                       DIAT1511
      SUBROUTINE BETAFN(N,L,M,JMAX,CAPPA,A,R,TEMP)                      DIAT1512
C     REQUIRED COMMON (TEMP2,ILIM)                                      DIAT1513
C                                                                       DIAT1514
C     (PACKAGE)                                                         DIAT1515
C     NOV.  3, 1958                                                     DIAT1516
C                                                                       DIAT1517
C                                                                       DIAT1518
      COMMON IND,INDS,INDRM1,INDKE,INDNA,INDCOU,INDHYB,INDEXC,IHOMON,   DIAT1519
     1 ITPEPR,ITPEPU,ITPEBO,ITPEF1,IFDUP,IGENSP,IBATCH,KMAXA,KMAXB,MESH,DIAT1520
     2 IMAX,IHALF,JMAX,IORBMX,ILIM,JLIM,LLIM,KOMLIM,A,H,THRESM,THRESS,  DIAT1521
     3 NMAX,LMAX,N,L,M,CAPPA,WEIGHT,ICOMP,IDRBEU,IDRBEX,IMXBEX,         DIAT1522
     4        IDRGMX,IRECTH,DRDT,R,FF,F1,F2,F3,F4,F5,F6,F7,F8,EE,E1,E2, DIAT1523
     5 E3,RR,TEMP1,TEMP2,TEMP3,BETA,W                                   DIAT1524
C                                                                       DIAT1525
      EQUIVALENCE(IND(1),INDS),(IND(2),INDRM1),(IND(3),INDKE),          DIAT1526
     1 (IND(4),INDNA),(IND(5),INDCOU),(IND(6),INDHYB),(IND(7),INDEXC),  DIAT1527
     2 (KMAX(1),KMAXA),(KMAX(2),KMAXB),                                 DIAT1528
     3 (FF(   1),F1),(FF( 386),F2),(FF( 771),F3),(FF(1156),F4),         DIAT1529
     4 (FF(1541),F5),(FF(1926),F6),(FF(2311),F7),(FF(2696),F8),         DIAT1530
     5 (EE(   1),E1),(EE( 386),E2),(EE( 771),E3),                       DIAT1531
     6 (W,DRDT),(W(386),R),(W(11166),FF),(W(14246),EE),(RR,W),          DIAT1532
     7 (TEMP1,W(386)),(TEMP2,W(771)),(TEMP3,W(1156)),(BETA,W(1541))     DIAT1533
C                                                                       DIAT1534
      DIMENSION IND(7),KMAX(2),N(2,20,16),L(2,20),M(2,20),              DIAT1535
     1 CAPPA(2,20,16),WEIGHT(2,20,16),ICOMP(2,20),IDRBEU(3,2,20),       DIAT1536
     2 IDRBEX(2,20),IMXBEX(2,20),                IDRGMX(2,20,21),       DIAT1537
     3 IRECTH(10),DRDT(385),R(385,27),FF(385,8),F1(385),F2(385),F3(385),DIAT1538
     4 F4(385),F5(385),F6(385),F7(385),F8(385),EE(385,3),E1(385),       DIAT1539
     5 E2(385),E3(385),RR(385),TEMP1(385),TEMP2(385),TEMP3(385),        DIAT1540
     6 BETA(385,39),W(385,43)                                           DIAT1541
C                                                                       DIAT1542
C                                                                       DIAT1543
      EQUIVALENCE (XKTBM1,XKTB(2)),(XITBM1,XITB(2)),(TTB1M1,TTB1(2)),(TTDIAT1544
     1B2M1,TTB2(2)),(TTB3M1,TTB3(2)),(XKTB,TEMP2(65)),(XITB,TEMP2(129)),DIAT1545
     2(TTB1,TEMP2(193)),(TTB2,TEMP2(257)),(TTB3,TEMP2(321))             DIAT1546
C                                                                       DIAT1547
      DIMENSION  XKTB(64),XITB(64),TTB1(64),TTB2(64),TTB3(64),XKTBM1(63)DIAT1548
     1,XITBM1(63),TTB1M1(63),TTB2M1(63),TTB3M1(63),TEMP(385)            DIAT1549
C                                                                       DIAT1550
C                                                                       DIAT1551
      IF(JMAX-38) 15,15,10                                              DIAT1552
 10   STOP 1                                                            DIAT1553
C     NOT ENOUGH ROOM IN BETA FUNCTION TABLES FOR GENERATED FUNCTIONS   DIAT1554
 15   CONTINUE                                                          DIAT1555
      IF(ILIM-1-6*64) 30,20,20                                          DIAT1556
 20   CONTINUE                                                          DIAT1557
      JEND=(N+L)/2+JMAX                                                 DIAT1558
      JENDP1=JEND+1                                                     DIAT1559
      IF(JEND-60) 40,40,30                                              DIAT1560
 30   STOP 2                                                            DIAT1561
C     NOT ENOUGH ROOM IN GENERATION TABLES FOR FUNCTIONS                DIAT1562
 40   CONTINUE                                                          DIAT1563
      CAPA=CAPPA*A                                                      DIAT1564
      CAPR=CAPPA*R                                                      DIAT1565
      IF(RHO-MAX1F(CAPA,CAPR)) 50,60,50                                 DIAT1566
 50   CONTINUE                                                          DIAT1567
      RHO=MAX1F(CAPA,CAPR)                                              DIAT1568
      CALL GENKN(RHO,JEND,XKTBM1)                                       DIAT1569
      XKTB(1)=XKTBM1(1)                                                 DIAT1570
 60   CONTINUE                                                          DIAT1571
      IF(SIGMA-MIN1F(CAPA,CAPR)) 70,80,70                               DIAT1572
 70   CONTINUE                                                          DIAT1573
      SIGMA=MIN1F(CAPA,CAPR)                                            DIAT1574
      CALL GENIN(SIGMA,JENDP1,XITBM1)                                   DIAT1575
 80   CONTINUE                                                          DIAT1576
      SIGXX2=SIGMA**2                                                   DIAT1577
      RHOXX2=RHO**2                                                     DIAT1578
      CAPAX2=2.*CAPA                                                    DIAT1579
      IF(XMODF(N-L,2)) 140,120,140                                      DIAT1580
 120  CONTINUE                                                          DIAT1581
C                                                                       DIAT1582
      DO 130 J=1,JENDP1                                                 DIAT1583
      TTB1M1(J)=CAPR*XITBM1(J)*XKTBM1(J)                                DIAT1584
 130  CONTINUE                                                          DIAT1585
C                                                                       DIAT1586
      GO TO 160                                                         DIAT1587
 140  CONTINUE                                                          DIAT1588
C                                                                       DIAT1589
      DO 150 J=1,JENDP1                                                 DIAT1590
      TTB1M1(J)=CAPR*(RHO*XITBM1(J)*XKTB(J)-SIGMA*XITBM1(J+1)*XKTBM1(J))DIAT1591
 150  CONTINUE                                                          DIAT1592
C                                                                       DIAT1593
 160  CONTINUE                                                          DIAT1594
      JJ=(N-L)/2                                                        DIAT1595
      TTB1(1)=0.                                                        DIAT1596
      IF (JJ) 170,210,170                                               DIAT1597
 170  CONTINUE                                                          DIAT1598
C                                                                       DIAT1599
      DO 200 JRECUR=1,JJ                                                DIAT1600
      JENDP1=JENDP1-1                                                   DIAT1601
C                                                                       DIAT1602
      DO 180 J=1,JENDP1                                                 DIAT1603
      TTB2M1(J)=(SIGXX2+RHOXX2)*TTB1M1(J)-CAPAX2*CAPR*(FLOATF(J-1)*TTB1(DIAT1604
     1J)+FLOATF(J)*TTB1M1(J+1))/FLOATF(J+J-1)                           DIAT1605
 180  CONTINUE                                                          DIAT1606
C                                                                       DIAT1607
C                                                                       DIAT1608
      DO 190 J=1,JENDP1                                                 DIAT1609
      TTB1M1(J)=TTB2M1(J)                                               DIAT1610
 190  CONTINUE                                                          DIAT1611
C                                                                       DIAT1612
 200  CONTINUE                                                          DIAT1613
C                                                                       DIAT1614
 210  CONTINUE                                                          DIAT1615
      MLUP=0                                                            DIAT1616
      MABS=XABSF(M)                                                     DIAT1617
      MABSP1=MABS+1                                                     DIAT1618
      IF(MABS) 220,260,220                                              DIAT1619
 220  CONTINUE                                                          DIAT1620
C                                                                       DIAT1621
      DO 250 JRECUR=1,MABS                                              DIAT1622
      JENDP1=JENDP1-1                                                   DIAT1623
      XMLUP2=FLOATF(MLUP+MLUP+1)                                        DIAT1624
      MLUPP2=MLUP+2                                                     DIAT1625
C                                                                       DIAT1626
      DO 225 J=MLUPP2,JENDP1                                            DIAT1627
      TTB2M1(J)=XMLUP2*CAPR*(TTB1(J)-TTB1M1(J+1))/FLOATF(J+J-1)         DIAT1628
 225  CONTINUE                                                          DIAT1629
C                                                                       DIAT1630
      MLUP=MLUP+1                                                       DIAT1631
C                                                                       DIAT1632
      DO 230 J=1,MLUP                                                   DIAT1633
      TTB1M1(J)=0.                                                      DIAT1634
 230  CONTINUE                                                          DIAT1635
C                                                                       DIAT1636
      DO 240 J=MLUPP2,JENDP1                                            DIAT1637
      TTB1M1(J)=TTB2M1(J)                                               DIAT1638
 240  CONTINUE                                                          DIAT1639
C                                                                       DIAT1640
 250  CONTINUE                                                          DIAT1641
C                                                                       DIAT1642
 260  CONTINUE                                                          DIAT1643
      LLUP=MLUP                                                         DIAT1644
      JJ=L-MABS                                                         DIAT1645
      IF(JJ) 265,320,270                                                DIAT1646
 265  STOP 3                                                            DIAT1647
C     IMPOSSIBLE CONDITION                                              DIAT1648
 270  CONTINUE                                                          DIAT1649
C                                                                       DIAT1650
      DO 320 JRECUR=1,JJ                                                DIAT1651
      JRCRM1=JRECUR-1                                                   DIAT1652
      JENDP1=JENDP1-1                                                   DIAT1653
      FR1=FLOATF(LLUP+LLUP+1)/FLOATF(LLUP-MLUP+1)                       DIAT1654
      FR2=FLOATF(LLUP+MLUP+1)/FLOATF(LLUP-MLUP+2)                       DIAT1655
C                                                                       DIAT1656
      DO 290 J=MABSP1,JENDP1                                            DIAT1657
      X=CAPR*(FLOATF(J-MABS-1)*TTB1(J)+FLOATF(J+MABS)*TTB1M1(J+1))/FLOATDIAT1658
     1F(J+J-1)                                                          DIAT1659
      Y=FR1*(+CAPA*TTB1M1(J)-X)                                         DIAT1660
      IF(JRCRM1) 274,276,275                                            DIAT1661
 274  STOP 4                                                            DIAT1662
C     IMPOSSIBLE CONDITION                                              DIAT1663
 275  CONTINUE                                                          DIAT1664
      TTB2M1(J)=Y-TTB3M1(J)                                             DIAT1665
      GO TO 278                                                         DIAT1666
 276  CONTINUE                                                          DIAT1667
      TTB2M1(J)=Y                                                       DIAT1668
 278  CONTINUE                                                          DIAT1669
      IF(JRECUR-JJ) 285,290,290                                         DIAT1670
 285  IF(JJ-1) 290,290,286                                              DIAT1671
 286  TTB3M1(J)=FR2*((SIGXX2+RHOXX2)*TTB1M1(J)-CAPAX2*X)                DIAT1672
 290  CONTINUE                                                          DIAT1673
      LLUP=LLUP+1                                                       DIAT1674
C                                                                       DIAT1675
      DO 310 J=MABSP1,JENDP1                                            DIAT1676
      TTB1M1(J)=TTB2M1(J)                                               DIAT1677
 310  CONTINUE                                                          DIAT1678
C                                                                       DIAT1679
 320  CONTINUE                                                          DIAT1680
C                                                                       DIAT1681
      JMAXP1=JMAX+1                                                     DIAT1682
C                                                                       DIAT1683
      DO 330 J=1,JMAXP1                                                 DIAT1684
      TEMP(J)=TTB1M1(J)                                                 DIAT1685
 330  CONTINUE                                                          DIAT1686
C                                                                       DIAT1687
      RETURN                                                            DIAT1688
C                                                                       DIAT1689
      END(0,1,0,0,0)                                                    DIAT1690
C     M458, CORBATO, SWITENDICK                                   MID   DIAT1691
C     AUGUST 10, 1959                                                   DIAT1692
C     DEC.  1, 1958                                                     DIAT1693
C                                                                       DIAT1694
      SUBROUTINE MID                                                    DIAT1695
C     REQUIRED COMMON(ITPEF1,IFDUP,IORBMX,IDRBEU,IDRBEX,IMXBEX,ID       DIAT1696
C                    RGMX,IRECTH,IMAX,LLIM,W,IGENSP)                    DIAT1697
C                                                                       DIAT1698
C     (PACKAGE)                                                         DIAT1699
C     NOV.  3, 1958                                                     DIAT1700
C                                                                       DIAT1701
C                                                                       DIAT1702
      COMMON IND,INDS,INDRM1,INDKE,INDNA,INDCOU,INDHYB,INDEXC,IHOMON,   DIAT1703
     1 ITPEPR,ITPEPU,ITPEBO,ITPEF1,IFDUP,IGENSP,IBATCH,KMAXA,KMAXB,MESH,DIAT1704
     2 IMAX,IHALF,JMAX,IORBMX,ILIM,JLIM,LLIM,KOMLIM,A,H,THRESM,THRESS,  DIAT1705
     3 NMAX,LMAX,N,L,M,CAPPA,WEIGHT,ICOMP,IDRBEU,IDRBEX,IMXBEX,         DIAT1706
     4        IDRGMX,IRECTH,DRDT,R,FF,F1,F2,F3,F4,F5,F6,F7,F8,EE,E1,E2, DIAT1707
     5 E3,RR,TEMP1,TEMP2,TEMP3,BETA,W                                   DIAT1708
C                                                                       DIAT1709
      EQUIVALENCE(IND(1),INDS),(IND(2),INDRM1),(IND(3),INDKE),          DIAT1710
     1 (IND(4),INDNA),(IND(5),INDCOU),(IND(6),INDHYB),(IND(7),INDEXC),  DIAT1711
     2 (KMAX(1),KMAXA),(KMAX(2),KMAXB),                                 DIAT1712
     3 (FF(   1),F1),(FF( 386),F2),(FF( 771),F3),(FF(1156),F4),         DIAT1713
     4 (FF(1541),F5),(FF(1926),F6),(FF(2311),F7),(FF(2696),F8),         DIAT1714
     5 (EE(   1),E1),(EE( 386),E2),(EE( 771),E3),                       DIAT1715
     6 (W,DRDT),(W(386),R),(W(11166),FF),(W(14246),EE),(RR,W),          DIAT1716
     7 (TEMP1,W(386)),(TEMP2,W(771)),(TEMP3,W(1156)),(BETA,W(1541))     DIAT1717
C                                                                       DIAT1718
      DIMENSION IND(7),KMAX(2),N(2,20,16),L(2,20),M(2,20),              DIAT1719
     1 CAPPA(2,20,16),WEIGHT(2,20,16),ICOMP(2,20),IDRBEU(3,2,20),       DIAT1720
     2 IDRBEX(2,20),IMXBEX(2,20),                IDRGMX(2,20,21),       DIAT1721
     3 IRECTH(10),DRDT(385),R(385,27),FF(385,8),F1(385),F2(385),F3(385),DIAT1722
     4 F4(385),F5(385),F6(385),F7(385),F8(385),EE(385,3),E1(385),       DIAT1723
     5 E2(385),E3(385),RR(385),TEMP1(385),TEMP2(385),TEMP3(385),        DIAT1724
     6 BETA(385,39),W(385,43)                                           DIAT1725
C                                                                       DIAT1726
C                                                                       DIAT1727
      CALL LFM                                                          DIAT1728
      ITMAX=XMIN0F(ITPEF1+IFDUP-1,10)                                   DIAT1729
C                                                                       DIAT1730
      DO 10 I=ITPEF1,ITMAX                                              DIAT1731
 10   REWIND I                                                          DIAT1732
C                                                                       DIAT1733
      IF(IORBMX-20)12,14,12                                             DIAT1734
 12   STOP 11111                                                        DIAT1735
C     INCORRECT DIMENSION IN BINARY RECORD OF DIRECTORIES               DIAT1736
C                                                                       DIAT1737
 14   CONTINUE                                                          DIAT1738
      IF(IGENSP)15,15,20                                                DIAT1739
C                                                                       DIAT1740
 15   ICODE=(ITPEF1-6)*6553                                             DIAT1741
      IREAD=ITPEF1+1                                                    DIAT1742
      IWRITE=ITPEF1                                                     DIAT1743
      WRITE TAPE IWRITE,                                                DIAT1744
     1ICODE,           (((IDRBEU(J,I,K),K=1,20),I=1,2),J=1,3),((IDRB    DIAT1745
     2EX(I,K),K=1,20),I=1,2),((IMXBEX(I,K),K=1,20),I=1,2),              DIAT1746
     3                                              (((IDRGMX(I,K1,K2),KDIAT1747
     42=1,21),K1=1,20),I=1,2),(IRECTH(I),I=1,10)                        DIAT1748
C                                                                       DIAT1749
      GO TO 25                                                          DIAT1750
C                                                                       DIAT1751
 20   CONTINUE                                                          DIAT1752
C                                                                       DIAT1753
      IREAD=ITPEF1                                                      DIAT1754
      IWRITE=ITPEF1+1                                                   DIAT1755
      READ TAPE IREAD,                                                  DIAT1756
     1ICODE,           (((IDRBEU(J,I,K),K=1,20),I=1,2),J=1,3),((IDRB    DIAT1757
     2EX(I,K),K=1,20),I=1,2),((IMXBEX(I,K),K=1,20),I=1,2),              DIAT1758
     3                                              (((IDRGMX(I,K1,K2),KDIAT1759
     42=1,21),K1=1,20),I=1,2),(IRECTH(I),I=1,10)                        DIAT1760
C                                                                       DIAT1761
 25   CONTINUE                                                          DIAT1762
C                                                                       DIAT1763
      ITMIN=ITPEF1+2                                                    DIAT1764
      IREC=0                                                            DIAT1765
 30   ILUMP=XMIN0F(IRECTH(ITPEF1+1)-IREC,LLIM)                          DIAT1766
C                                                                       DIAT1767
      DO 40 I=1,ILUMP                                                   DIAT1768
 40   READ TAPE IREAD,  ICODE,(W(J,I),J=1,IMAX)                         DIAT1769
C                                                                       DIAT1770
      ICHECK=ICODE-ILUMP                                                DIAT1771
C                                                                       DIAT1772
      DO 45 I=1,ILUMP                                                   DIAT1773
      ICHECK=ICHECK+1                                                   DIAT1774
 45   WRITE TAPE IWRITE,ICHECK,(W(J,I),J=1,IMAX)                        DIAT1775
C                                                                       DIAT1776
      IF(ITMIN-ITMAX)50,50,65                                           DIAT1777
C                                                                       DIAT1778
 50   DO 60 IT=ITMIN,ITMAX                                              DIAT1779
      ICHECK=ICODE-ILUMP                                                DIAT1780
C                                                                       DIAT1781
      DO 60 I=1,ILUMP                                                   DIAT1782
      ICHECK=ICHECK+1                                                   DIAT1783
 60   WRITE TAPE IT,    ICHECK,(W(J,I),J=1,IMAX)                        DIAT1784
C                                                                       DIAT1785
 65   CONTINUE                                                          DIAT1786
      IREC=IREC+ILUMP                                                   DIAT1787
      IF(IRECTH(ITPEF1+1)-IREC)70,70,30                                 DIAT1788
C                                                                       DIAT1789
 70   DO 80 I=ITPEF1,ITMAX                                              DIAT1790
      REWIND I                                                          DIAT1791
 80   IRECTH(I)=0                                                       DIAT1792
C                                                                       DIAT1793
      CALL EFM                                                          DIAT1795
      IRECTH(ITPEF1)=-1                                                 DIAT1794
      CALL RGEN                                                         DIAT1796
      RETURN                                                            DIAT1797
C                                                                       DIAT1798
      END(0,1,0,0,0)                                                    DIAT1799
C     M458, CORBATO, SWITENDICK                                   RGEN  DIAT1800
C     DECEMBER 30, 1959                                                 DIAT1801
C     MESH MAPPING NO. 1                                                DIAT1802
C                                                                       DIAT1803
      SUBROUTINE RGEN                                                   DIAT1804
C     REQUIRED COMMON(DRDT,R,A,H,IMAX,JMAX,LMAX)                        DIAT1805
C                                                                       DIAT1806
C     (PACKAGE)                                                         DIAT1807
C     NOV.  3, 1958                                                     DIAT1808
C                                                                       DIAT1809
C                                                                       DIAT1810
      COMMON IND,INDS,INDRM1,INDKE,INDNA,INDCOU,INDHYB,INDEXC,IHOMON,   DIAT1811
     1 ITPEPR,ITPEPU,ITPEBO,ITPEF1,IFDUP,IGENSP,IBATCH,KMAXA,KMAXB,MESH,DIAT1812
     2 IMAX,IHALF,JMAX,IORBMX,ILIM,JLIM,LLIM,KOMLIM,A,H,THRESM,THRESS,  DIAT1813
     3 NMAX,LMAX,N,L,M,CAPPA,WEIGHT,ICOMP,IDRBEU,IDRBEX,IMXBEX,         DIAT1814
     4        IDRGMX,IRECTH,DRDT,R,FF,F1,F2,F3,F4,F5,F6,F7,F8,EE,E1,E2, DIAT1815
     5 E3,RR,TEMP1,TEMP2,TEMP3,BETA,W                                   DIAT1816
C                                                                       DIAT1817
      EQUIVALENCE(IND(1),INDS),(IND(2),INDRM1),(IND(3),INDKE),          DIAT1818
     1 (IND(4),INDNA),(IND(5),INDCOU),(IND(6),INDHYB),(IND(7),INDEXC),  DIAT1819
     2 (KMAX(1),KMAXA),(KMAX(2),KMAXB),                                 DIAT1820
     3 (FF(   1),F1),(FF( 386),F2),(FF( 771),F3),(FF(1156),F4),         DIAT1821
     4 (FF(1541),F5),(FF(1926),F6),(FF(2311),F7),(FF(2696),F8),         DIAT1822
     5 (EE(   1),E1),(EE( 386),E2),(EE( 771),E3),                       DIAT1823
     6 (W,DRDT),(W(386),R),(W(11166),FF),(W(14246),EE),(RR,W),          DIAT1824
     7 (TEMP1,W(386)),(TEMP2,W(771)),(TEMP3,W(1156)),(BETA,W(1541))     DIAT1825
C                                                                       DIAT1826
      DIMENSION IND(7),KMAX(2),N(2,20,16),L(2,20),M(2,20),              DIAT1827
     1 CAPPA(2,20,16),WEIGHT(2,20,16),ICOMP(2,20),IDRBEU(3,2,20),       DIAT1828
     2 IDRBEX(2,20),IMXBEX(2,20),                IDRGMX(2,20,21),       DIAT1829
     3 IRECTH(10),DRDT(385),R(385,27),FF(385,8),F1(385),F2(385),F3(385),DIAT1830
     4 F4(385),F5(385),F6(385),F7(385),F8(385),EE(385,3),E1(385),       DIAT1831
     5 E2(385),E3(385),RR(385),TEMP1(385),TEMP2(385),TEMP3(385),        DIAT1832
     6 BETA(385,39),W(385,43)                                           DIAT1833
C                                                                       DIAT1834
C                                                                       DIAT1835
      DRDT(IMAX)=1.0E38                                                 DIAT1836
      R(IMAX,1)=1.                                                      DIAT1837
      JMAXP2=XMAX0F(1,JMAX,3*LMAX)+2                                    DIAT1838
C                                                                       DIAT1839
      DO 5 J=2,JMAXP2                                                   DIAT1840
 5    R(IMAX,J)=1.0E38                                                  DIAT1841
C                                                                       DIAT1842
      T=0.                                                              DIAT1843
      IMAXM1=IMAX-1                                                     DIAT1844
C                                                                       DIAT1845
      DO 32 I=1,IMAXM1                                                  DIAT1846
      DRDT(I)=(1.5*A)/(3.-T)**2                                         DIAT1847
      R(I,1)=1.                                                         DIAT1848
      R(I,2)=(.5*A*T)/(3.-T)                                            DIAT1849
      CALL LFM                                                          DIAT1850
      IF ACCUMULATOR OVERFLOW 10,10                                     DIAT1851
 10   CONTINUE                                                          DIAT1852
C                                                                       DIAT1853
      DO 30 J=3,JMAXP2                                                  DIAT1854
      R(I,J)=R(I,J-1)*R(I,2)                                            DIAT1855
      IF ACCUMULATOR OVERFLOW 20,30                                     DIAT1856
 20   IF(R(I,J-1)-1.)22,22,24                                           DIAT1857
 22   R(I,J)=0.                                                         DIAT1858
      GO TO 30                                                          DIAT1859
 24   R(I,J)=1.0E38                                                     DIAT1860
 30   CONTINUE                                                          DIAT1861
C                                                                       DIAT1862
      T=T+H                                                             DIAT1863
 32   CALL EFM                                                          DIAT1864
C                                                                       DIAT1865
      RETURN                                                            DIAT1866
C                                                                       DIAT1867
      END(0,1,0,0,0)                                                    DIAT1868
C     M458-3, CORBATO, SWITENDICK                                 CALCCLDIAT1869
C     DEC. 20, 1958                                                     DIAT1870
C                                                                       DIAT1871
      SUBROUTINE CALCCL                                                 DIAT1872
C     REQUIRED COMMON(IHOMON)                                           DIAT1873
C                                                                       DIAT1874
C     (PACKAGE)                                                         DIAT1875
C     NOV.  3, 1958                                                     DIAT1876
C                                                                       DIAT1877
C                                                                       DIAT1878
      COMMON IND,INDS,INDRM1,INDKE,INDNA,INDCOU,INDHYB,INDEXC,IHOMON,   DIAT1879
     1 ITPEPR,ITPEPU,ITPEBO,ITPEF1,IFDUP,IGENSP,IBATCH,KMAXA,KMAXB,MESH,DIAT1880
     2 IMAX,IHALF,JMAX,IORBMX,ILIM,JLIM,LLIM,KOMLIM,A,H,THRESM,THRESS,  DIAT1881
     3 NMAX,LMAX,N,L,M,CAPPA,WEIGHT,ICOMP,IDRBEU,IDRBEX,IMXBEX,         DIAT1882
     4        IDRGMX,IRECTH,DRDT,R,FF,F1,F2,F3,F4,F5,F6,F7,F8,EE,E1,E2, DIAT1883
     5 E3,RR,TEMP1,TEMP2,TEMP3,BETA,W                                   DIAT1884
C                                                                       DIAT1885
      EQUIVALENCE(IND(1),INDS),(IND(2),INDRM1),(IND(3),INDKE),          DIAT1886
     1 (IND(4),INDNA),(IND(5),INDCOU),(IND(6),INDHYB),(IND(7),INDEXC),  DIAT1887
     2 (KMAX(1),KMAXA),(KMAX(2),KMAXB),                                 DIAT1888
     3 (FF(   1),F1),(FF( 386),F2),(FF( 771),F3),(FF(1156),F4),         DIAT1889
     4 (FF(1541),F5),(FF(1926),F6),(FF(2311),F7),(FF(2696),F8),         DIAT1890
     5 (EE(   1),E1),(EE( 386),E2),(EE( 771),E3),                       DIAT1891
     6 (W,DRDT),(W(386),R),(W(11166),FF),(W(14246),EE),(RR,W),          DIAT1892
     7 (TEMP1,W(386)),(TEMP2,W(771)),(TEMP3,W(1156)),(BETA,W(1541))     DIAT1893
C                                                                       DIAT1894
      DIMENSION IND(7),KMAX(2),N(2,20,16),L(2,20),M(2,20),              DIAT1895
     1 CAPPA(2,20,16),WEIGHT(2,20,16),ICOMP(2,20),IDRBEU(3,2,20),       DIAT1896
     2 IDRBEX(2,20),IMXBEX(2,20),                IDRGMX(2,20,21),       DIAT1897
     3 IRECTH(10),DRDT(385),R(385,27),FF(385,8),F1(385),F2(385),F3(385),DIAT1898
     4 F4(385),F5(385),F6(385),F7(385),F8(385),EE(385,3),E1(385),       DIAT1899
     5 E2(385),E3(385),RR(385),TEMP1(385),TEMP2(385),TEMP3(385),        DIAT1900
     6 BETA(385,39),W(385,43)                                           DIAT1901
C                                                                       DIAT1902
C                                                                       DIAT1903
C     ONE-CENTER TWO-ELECTRON INTEGRALS                                 DIAT1904
C                                                                       DIAT1905
      DO 30 ICENT=1,2                                                   DIAT1906
      IF(IHOMON)20,20,10                                                DIAT1907
 10   IF(ICENT-2)20,30,30                                               DIAT1908
 20   CALL CALC2E(1,ICENT)                                              DIAT1909
 30   CONTINUE                                                          DIAT1910
C                                                                       DIAT1911
C     COULOMB INTEGRALS                                                 DIAT1912
C                                                                       DIAT1913
      IF(IHOMON-1)40,40,50                                              DIAT1914
 40   CALL CALC2E(2,1)                                                  DIAT1915
 50   CONTINUE                                                          DIAT1916
C                                                                       DIAT1917
      RETURN                                                            DIAT1918
C                                                                       DIAT1919
      END(0,1,0,1,0)                                                    DIAT1920
C     M458-3, CORBATO, SWITENDICK                                 CALCHYDIAT1921
C     DEC. 20, 1958                                                     DIAT1922
C                                                                       DIAT1923
      SUBROUTINE CALCHY                                                 DIAT1924
C     REQUIRED COMMON(IHOMON)                                           DIAT1925
C                                                                       DIAT1926
C     (PACKAGE)                                                         DIAT1927
C     NOV.  3, 1958                                                     DIAT1928
C                                                                       DIAT1929
C                                                                       DIAT1930
      COMMON IND,INDS,INDRM1,INDKE,INDNA,INDCOU,INDHYB,INDEXC,IHOMON,   DIAT1931
     1 ITPEPR,ITPEPU,ITPEBO,ITPEF1,IFDUP,IGENSP,IBATCH,KMAXA,KMAXB,MESH,DIAT1932
     2 IMAX,IHALF,JMAX,IORBMX,ILIM,JLIM,LLIM,KOMLIM,A,H,THRESM,THRESS,  DIAT1933
     3 NMAX,LMAX,N,L,M,CAPPA,WEIGHT,ICOMP,IDRBEU,IDRBEX,IMXBEX,         DIAT1934
     4        IDRGMX,IRECTH,DRDT,R,FF,F1,F2,F3,F4,F5,F6,F7,F8,EE,E1,E2, DIAT1935
     5 E3,RR,TEMP1,TEMP2,TEMP3,BETA,W                                   DIAT1936
C                                                                       DIAT1937
      EQUIVALENCE(IND(1),INDS),(IND(2),INDRM1),(IND(3),INDKE),          DIAT1938
     1 (IND(4),INDNA),(IND(5),INDCOU),(IND(6),INDHYB),(IND(7),INDEXC),  DIAT1939
     2 (KMAX(1),KMAXA),(KMAX(2),KMAXB),                                 DIAT1940
     3 (FF(   1),F1),(FF( 386),F2),(FF( 771),F3),(FF(1156),F4),         DIAT1941
     4 (FF(1541),F5),(FF(1926),F6),(FF(2311),F7),(FF(2696),F8),         DIAT1942
     5 (EE(   1),E1),(EE( 386),E2),(EE( 771),E3),                       DIAT1943
     6 (W,DRDT),(W(386),R),(W(11166),FF),(W(14246),EE),(RR,W),          DIAT1944
     7 (TEMP1,W(386)),(TEMP2,W(771)),(TEMP3,W(1156)),(BETA,W(1541))     DIAT1945
C                                                                       DIAT1946
      DIMENSION IND(7),KMAX(2),N(2,20,16),L(2,20),M(2,20),              DIAT1947
     1 CAPPA(2,20,16),WEIGHT(2,20,16),ICOMP(2,20),IDRBEU(3,2,20),       DIAT1948
     2 IDRBEX(2,20),IMXBEX(2,20),                IDRGMX(2,20,21),       DIAT1949
     3 IRECTH(10),DRDT(385),R(385,27),FF(385,8),F1(385),F2(385),F3(385),DIAT1950
     4 F4(385),F5(385),F6(385),F7(385),F8(385),EE(385,3),E1(385),       DIAT1951
     5 E2(385),E3(385),RR(385),TEMP1(385),TEMP2(385),TEMP3(385),        DIAT1952
     6 BETA(385,39),W(385,43)                                           DIAT1953
C                                                                       DIAT1954
C                                                                       DIAT1955
C     HYBRID INTEGRALS                                                  DIAT1956
C                                                                       DIAT1957
      DO 30 ICENT=1,2                                                   DIAT1958
      IF(IHOMON-1)20,10,30                                              DIAT1959
 10   IF(ICENT-2)20,30,30                                               DIAT1960
 20   CALL CALC2E(3,ICENT)                                              DIAT1961
 30   CONTINUE                                                          DIAT1962
C                                                                       DIAT1963
      RETURN                                                            DIAT1964
C                                                                       DIAT1965
      END(0,1,0,0,0)                                                    DIAT1966
C     M458-3, CORBATO, SWITENDICK                                 CALCEXDIAT1967
C     DEC. 20, 1958                                                     DIAT1968
C                                                                       DIAT1969
      SUBROUTINE CALCEX                                                 DIAT1970
C     REQUIRED COMMON(IHOMON)                                           DIAT1971
C                                                                       DIAT1972
C     (PACKAGE)                                                         DIAT1973
C     NOV.  3, 1958                                                     DIAT1974
C                                                                       DIAT1975
C                                                                       DIAT1976
      COMMON IND,INDS,INDRM1,INDKE,INDNA,INDCOU,INDHYB,INDEXC,IHOMON,   DIAT1977
     1 ITPEPR,ITPEPU,ITPEBO,ITPEF1,IFDUP,IGENSP,IBATCH,KMAXA,KMAXB,MESH,DIAT1978
     2 IMAX,IHALF,JMAX,IORBMX,ILIM,JLIM,LLIM,KOMLIM,A,H,THRESM,THRESS,  DIAT1979
     3 NMAX,LMAX,N,L,M,CAPPA,WEIGHT,ICOMP,IDRBEU,IDRBEX,IMXBEX,         DIAT1980
     4        IDRGMX,IRECTH,DRDT,R,FF,F1,F2,F3,F4,F5,F6,F7,F8,EE,E1,E2, DIAT1981
     5 E3,RR,TEMP1,TEMP2,TEMP3,BETA,W                                   DIAT1982
C                                                                       DIAT1983
      EQUIVALENCE(IND(1),INDS),(IND(2),INDRM1),(IND(3),INDKE),          DIAT1984
     1 (IND(4),INDNA),(IND(5),INDCOU),(IND(6),INDHYB),(IND(7),INDEXC),  DIAT1985
     2 (KMAX(1),KMAXA),(KMAX(2),KMAXB),                                 DIAT1986
     3 (FF(   1),F1),(FF( 386),F2),(FF( 771),F3),(FF(1156),F4),         DIAT1987
     4 (FF(1541),F5),(FF(1926),F6),(FF(2311),F7),(FF(2696),F8),         DIAT1988
     5 (EE(   1),E1),(EE( 386),E2),(EE( 771),E3),                       DIAT1989
     6 (W,DRDT),(W(386),R),(W(11166),FF),(W(14246),EE),(RR,W),          DIAT1990
     7 (TEMP1,W(386)),(TEMP2,W(771)),(TEMP3,W(1156)),(BETA,W(1541))     DIAT1991
C                                                                       DIAT1992
      DIMENSION IND(7),KMAX(2),N(2,20,16),L(2,20),M(2,20),              DIAT1993
     1 CAPPA(2,20,16),WEIGHT(2,20,16),ICOMP(2,20),IDRBEU(3,2,20),       DIAT1994
     2 IDRBEX(2,20),IMXBEX(2,20),                IDRGMX(2,20,21),       DIAT1995
     3 IRECTH(10),DRDT(385),R(385,27),FF(385,8),F1(385),F2(385),F3(385),DIAT1996
     4 F4(385),F5(385),F6(385),F7(385),F8(385),EE(385,3),E1(385),       DIAT1997
     5 E2(385),E3(385),RR(385),TEMP1(385),TEMP2(385),TEMP3(385),        DIAT1998
     6 BETA(385,39),W(385,43)                                           DIAT1999
C                                                                       DIAT2000
C                                                                       DIAT2001
C     EXCHANGE INTEGRALS                                                DIAT2002
C                                                                       DIAT2003
      IF(IHOMON-1)10,10,20                                              DIAT2004
 10   CALL CALC2E(4,1)                                                  DIAT2005
 20   CONTINUE                                                          DIAT2006
C                                                                       DIAT2007
      RETURN                                                            DIAT2008
C                                                                       DIAT2009
      END(0,1,0,0,0)                                                    DIAT2010
C     M458, CORBATO, SWITENDICK                                   GETFUNDIAT2011
C     *APRIL 24, 1959                                                   DIAT2012
C                                                                       DIAT2013
      SUBROUTINE GETFUN(F,ITYPE,IEXPAN,ICENT,K1,K2,JREL)                DIAT2014
      DIMENSION F(385)                                                  DIAT2015
C     REQUIRED COMMON(IDRBEU,IDRBEX,IMXBEX,IDRGMX,IRECTH,IMAX,IFDUP)    DIAT2016
C                                                                       DIAT2017
C     (PACKAGE)                                                         DIAT2018
C     NOV.  3, 1958                                                     DIAT2019
C                                                                       DIAT2020
C                                                                       DIAT2021
      COMMON IND,INDS,INDRM1,INDKE,INDNA,INDCOU,INDHYB,INDEXC,IHOMON,   DIAT2022
     1 ITPEPR,ITPEPU,ITPEBO,ITPEF1,IFDUP,IGENSP,IBATCH,KMAXA,KMAXB,MESH,DIAT2023
     2 IMAX,IHALF,JMAX,IORBMX,ILIM,JLIM,LLIM,KOMLIM,A,H,THRESM,THRESS,  DIAT2024
     3 NMAX,LMAX,N,L,M,CAPPA,WEIGHT,ICOMP,IDRBEU,IDRBEX,IMXBEX,         DIAT2025
     4        IDRGMX,IRECTH,DRDT,R,FF,F1,F2,F3,F4,F5,F6,F7,F8,EE,E1,E2, DIAT2026
     5 E3,RR,TEMP1,TEMP2,TEMP3,BETA,W                                   DIAT2027
C                                                                       DIAT2028
      EQUIVALENCE(IND(1),INDS),(IND(2),INDRM1),(IND(3),INDKE),          DIAT2029
     1 (IND(4),INDNA),(IND(5),INDCOU),(IND(6),INDHYB),(IND(7),INDEXC),  DIAT2030
     2 (KMAX(1),KMAXA),(KMAX(2),KMAXB),                                 DIAT2031
     3 (FF(   1),F1),(FF( 386),F2),(FF( 771),F3),(FF(1156),F4),         DIAT2032
     4 (FF(1541),F5),(FF(1926),F6),(FF(2311),F7),(FF(2696),F8),         DIAT2033
     5 (EE(   1),E1),(EE( 386),E2),(EE( 771),E3),                       DIAT2034
     6 (W,DRDT),(W(386),R),(W(11166),FF),(W(14246),EE),(RR,W),          DIAT2035
     7 (TEMP1,W(386)),(TEMP2,W(771)),(TEMP3,W(1156)),(BETA,W(1541))     DIAT2036
C                                                                       DIAT2037
      DIMENSION IND(7),KMAX(2),N(2,20,16),L(2,20),M(2,20),              DIAT2038
     1 CAPPA(2,20,16),WEIGHT(2,20,16),ICOMP(2,20),IDRBEU(3,2,20),       DIAT2039
     2 IDRBEX(2,20),IMXBEX(2,20),                IDRGMX(2,20,21),       DIAT2040
     3 IRECTH(10),DRDT(385),R(385,27),FF(385,8),F1(385),F2(385),F3(385),DIAT2041
     4 F4(385),F5(385),F6(385),F7(385),F8(385),EE(385,3),E1(385),       DIAT2042
     5 E2(385),E3(385),RR(385),TEMP1(385),TEMP2(385),TEMP3(385),        DIAT2043
     6 BETA(385,39),W(385,43)                                           DIAT2044
C                                                                       DIAT2045
C                                                                       DIAT2046
      CALL GORTN(1)                                                     DIAT2047
      CALL LFM                                                          DIAT2048
      IF(ITYPE-4)10,20,20                                               DIAT2049
 10   IF(IEXPAN-2)12,14,14                                              DIAT2050
 12   ITEMP=IDRBEU(ITYPE,ICENT,K1)                                      DIAT2051
      GO TO 35                                                          DIAT2052
 14   ITEMP=IDRBEX(ICENT,K1)+XABSF(JREL)                                DIAT2053
      IF(IMXBEX(ICENT,K1)-ITEMP)42,30,30                                DIAT2054
 20   ITEMP=IDRGMX(ICENT,K1,K2)                                         DIAT2055
      IMAXCK=ITEMP+IDRGMX(ICENT,K2,K1+1)/512-1                          DIAT2056
      JSIGN=XSIGNF(1,JREL)                                              DIAT2057
      IF(JSIGN) 22,24,24                                                DIAT2058
 22   ITEMP=IMAXCK+1                                                    DIAT2059
      IMAXCK=IMAXCK+XMODF(IDRGMX(ICENT,K2,K1+1),512)                    DIAT2060
 24   ITEMP=ITEMP+XABSF(JREL)                                           DIAT2061
      IF(IMAXCK-ITEMP) 42,30,30                                         DIAT2062
 30   IF(ITEMP-XABSF(JREL)) 46,40,46                                    DIAT2063
 35   IF(ITEMP)46,40,46                                                 DIAT2064
 40   STOP1                                                             DIAT2065
 42   STOP2                                                             DIAT2066
C     STOPS BECAUSE FUNCTION CALLED FOR WAS NOT GENERATED               DIAT2067
C                                                                       DIAT2068
 46   IREC=XMODF(XMODF(ITEMP,6553)+6553,6553)                           DIAT2069
      ITAPE=(ITEMP-IREC)/6553+6                                         DIAT2070
 50   JTAPE=XMIN0F(ITAPE+IFDUP-1,10)                                    DIAT2071
      IDIFFM=6553                                                       DIAT2072
C                                                                       DIAT2073
      DO 54 I=ITAPE,JTAPE                                               DIAT2074
      IF(IDIFFM-XABSF(IRECTH(I)-IREC+1))54,54,52                        DIAT2075
 52   IDIFFM=XABSF(IRECTH(I)-IREC+1)                                    DIAT2076
      ITAPEM=I                                                          DIAT2077
 54   CONTINUE                                                          DIAT2078
C                                                                       DIAT2079
      ITAPE=ITAPEM                                                      DIAT2080
      IDIFF=IREC-IRECTH(ITAPE)-1                                        DIAT2081
      IF(IDIFF)56,80,65                                                 DIAT2082
C                                                                       DIAT2083
 56   DO 60 I=1,IDIFFM                                                  DIAT2084
 60   BACKSPACE ITAPE                                                   DIAT2085
C                                                                       DIAT2086
      GO TO 80                                                          DIAT2087
C                                                                       DIAT2088
 65   DO 70 I=1,IDIFFM                                                  DIAT2089
 70   READ TAPE ITAPE                                                   DIAT2090
C                                                                       DIAT2091
 80   READ TAPE ITAPE,ITEST,(F(I),I=1,IMAX)                             DIAT2092
      IF(ITEST-ITEMP)90,100,90                                          DIAT2093
C                                                                       DIAT2094
C     WITHDRAW TAPE FROM ACTIVE TEMPORARY TAPES BECAUSE RECORD          DIAT2095
C       OUT-OF-PHASE WITH TAPE HISTORY                                  DIAT2096
 90   CALL BADTPE(ITAPE)                                                DIAT2097
      GO TO 46                                                          DIAT2098
C                                                                       DIAT2099
 100  IRECTH(ITAPE)=IREC                                                DIAT2100
      CALL EFM                                                          DIAT2101
      CALL STPRTN(1)                                                    DIAT2102
      RETURN                                                            DIAT2103
C                                                                       DIAT2104
      END(0,1,0,0,0)                                                    DIAT2105
C     M458, CORBATO, SWITENDICK                                   SINGLEDIAT2106
C     NOV.  3, 1958                                                     DIAT2107
C                                                                       DIAT2108
      SUBROUTINE SINGLE(A,B)                                            DIAT2109
C     REQUIRED COMMON(H,F1,F2,F3,E1,IMAX,IHALF,DRDT)                    DIAT2110
C                                                                       DIAT2111
C     (PACKAGE)                                                         DIAT2112
C     NOV.  3, 1958                                                     DIAT2113
C                                                                       DIAT2114
C                                                                       DIAT2115
      COMMON IND,INDS,INDRM1,INDKE,INDNA,INDCOU,INDHYB,INDEXC,IHOMON,   DIAT2116
     1 ITPEPR,ITPEPU,ITPEBO,ITPEF1,IFDUP,IGENSP,IBATCH,KMAXA,KMAXB,MESH,DIAT2117
     2 IMAX,IHALF,JMAX,IORBMX,ILIM,JLIM,LLIM,KOMLIM,A,H,THRESM,THRESS,  DIAT2118
     3 NMAX,LMAX,N,L,M,CAPPA,WEIGHT,ICOMP,IDRBEU,IDRBEX,IMXBEX,         DIAT2119
     4        IDRGMX,IRECTH,DRDT,R,FF,F1,F2,F3,F4,F5,F6,F7,F8,EE,E1,E2, DIAT2120
     5 E3,RR,TEMP1,TEMP2,TEMP3,BETA,W                                   DIAT2121
C                                                                       DIAT2122
      EQUIVALENCE(IND(1),INDS),(IND(2),INDRM1),(IND(3),INDKE),          DIAT2123
     1 (IND(4),INDNA),(IND(5),INDCOU),(IND(6),INDHYB),(IND(7),INDEXC),  DIAT2124
     2 (KMAX(1),KMAXA),(KMAX(2),KMAXB),                                 DIAT2125
     3 (FF(   1),F1),(FF( 386),F2),(FF( 771),F3),(FF(1156),F4),         DIAT2126
     4 (FF(1541),F5),(FF(1926),F6),(FF(2311),F7),(FF(2696),F8),         DIAT2127
     5 (EE(   1),E1),(EE( 386),E2),(EE( 771),E3),                       DIAT2128
     6 (W,DRDT),(W(386),R),(W(11166),FF),(W(14246),EE),(RR,W),          DIAT2129
     7 (TEMP1,W(386)),(TEMP2,W(771)),(TEMP3,W(1156)),(BETA,W(1541))     DIAT2130
C                                                                       DIAT2131
      DIMENSION IND(7),KMAX(2),N(2,20,16),L(2,20),M(2,20),              DIAT2132
     1 CAPPA(2,20,16),WEIGHT(2,20,16),ICOMP(2,20),IDRBEU(3,2,20),       DIAT2133
     2 IDRBEX(2,20),IMXBEX(2,20),                IDRGMX(2,20,21),       DIAT2134
     3 IRECTH(10),DRDT(385),R(385,27),FF(385,8),F1(385),F2(385),F3(385),DIAT2135
     4 F4(385),F5(385),F6(385),F7(385),F8(385),EE(385,3),E1(385),       DIAT2136
     5 E2(385),E3(385),RR(385),TEMP1(385),TEMP2(385),TEMP3(385),        DIAT2137
     6 BETA(385,39),W(385,43)                                           DIAT2138
C                                                                       DIAT2139
C                                                                       DIAT2140
      TWOH=2.*H                                                         DIAT2141
C                                                                       DIAT2142
      DO 10 I=1,IMAX                                                    DIAT2143
 10   F3(I)=F1(I)*F2(I)*DRDT(I)                                         DIAT2144
C                                                                       DIAT2145
      DO 20 I=1,IHALF                                                   DIAT2146
 20   E1(I)=F3(2*I-1)                                                   DIAT2147
C                                                                       DIAT2148
      A=DEFINT(F3,IMAX,H)                                               DIAT2149
      B=A-DEFINT(E1,IHALF,TWOH)                                         DIAT2150
      RETURN                                                            DIAT2151
C                                                                       DIAT2152
      END(0,1,0,0,0)                                                    DIAT2153
C     M458, CORBATO, SWITENDICK                                   DOUBLEDIAT2154
C     JULY 13, 1959                                                     DIAT2155
C                                                                       DIAT2156
      SUBROUTINE DOUBLE(J,A,B)                                          DIAT2157
C     REQUIRED COMMON(F1,F2,F3,F4,F5,F6,F7,F8,E1,E2,E3,R,DRDT,IMAX,     DIAT2158
C                     IHALF,H)                                          DIAT2159
C                                                                       DIAT2160
C     (PACKAGE)                                                         DIAT2161
C     NOV.  3, 1958                                                     DIAT2162
C                                                                       DIAT2163
C                                                                       DIAT2164
      COMMON IND,INDS,INDRM1,INDKE,INDNA,INDCOU,INDHYB,INDEXC,IHOMON,   DIAT2165
     1 ITPEPR,ITPEPU,ITPEBO,ITPEF1,IFDUP,IGENSP,IBATCH,KMAXA,KMAXB,MESH,DIAT2166
     2 IMAX,IHALF,JMAX,IORBMX,ILIM,JLIM,LLIM,KOMLIM,A,H,THRESM,THRESS,  DIAT2167
     3 NMAX,LMAX,N,L,M,CAPPA,WEIGHT,ICOMP,IDRBEU,IDRBEX,IMXBEX,         DIAT2168
     4        IDRGMX,IRECTH,DRDT,R,FF,F1,F2,F3,F4,F5,F6,F7,F8,EE,E1,E2, DIAT2169
     5 E3,RR,TEMP1,TEMP2,TEMP3,BETA,W                                   DIAT2170
C                                                                       DIAT2171
      EQUIVALENCE(IND(1),INDS),(IND(2),INDRM1),(IND(3),INDKE),          DIAT2172
     1 (IND(4),INDNA),(IND(5),INDCOU),(IND(6),INDHYB),(IND(7),INDEXC),  DIAT2173
     2 (KMAX(1),KMAXA),(KMAX(2),KMAXB),                                 DIAT2174
     3 (FF(   1),F1),(FF( 386),F2),(FF( 771),F3),(FF(1156),F4),         DIAT2175
     4 (FF(1541),F5),(FF(1926),F6),(FF(2311),F7),(FF(2696),F8),         DIAT2176
     5 (EE(   1),E1),(EE( 386),E2),(EE( 771),E3),                       DIAT2177
     6 (W,DRDT),(W(386),R),(W(11166),FF),(W(14246),EE),(RR,W),          DIAT2178
     7 (TEMP1,W(386)),(TEMP2,W(771)),(TEMP3,W(1156)),(BETA,W(1541))     DIAT2179
C                                                                       DIAT2180
     1 CAPPA(2,20,16),WEIGHT(2,20,16),ICOMP(2,20),IDRBEU(3,2,20),       DIAT2182
      DIMENSION IND(7),KMAX(2),N(2,20,16),L(2,20),M(2,20),              DIAT2181
     2 IDRBEX(2,20),IMXBEX(2,20),                IDRGMX(2,20,21),       DIAT2183
     3 IRECTH(10),DRDT(385),R(385,27),FF(385,8),F1(385),F2(385),F3(385),DIAT2184
     4 F4(385),F5(385),F6(385),F7(385),F8(385),EE(385,3),E1(385),       DIAT2185
     5 E2(385),E3(385),RR(385),TEMP1(385),TEMP2(385),TEMP3(385),        DIAT2186
     6 BETA(385,39),W(385,43)                                           DIAT2187
C                                                                       DIAT2188
C                                                                       DIAT2189
      TWOH=2.*H                                                         DIAT2190
      JJ=J+1                                                            DIAT2191
C                                                                       DIAT2192
      DO 10 I=1,IMAX                                                    DIAT2193
      F6(I)=F1(I)*F2(I)*DRDT(I)                                         DIAT2194
      F7(I)=F6(I)*R(I,JJ)                                               DIAT2195
 10   F8(I)=F3(I)*F4(I)*DRDT(I)                                         DIAT2196
C                                                                       DIAT2197
      DO 20 I=1,IHALF                                                   DIAT2198
 20   E1(I)=F7(2*I-1)                                                   DIAT2199
C                                                                       DIAT2200
      CALL INDEFI(F7,F5,IMAX,H)                                         DIAT2201
      CALL INDEFI(E1,E2,IHALF,TWOH)                                     DIAT2202
C                                                                       DIAT2203
      DO 30 I=1,IHALF                                                   DIAT2204
 30   E2(I)=E2(I)*F8(2*I-1)                                             DIAT2205
C                                                                       DIAT2206
      DO 40 I=1,IMAX                                                    DIAT2207
      F5(I)=F5(I)*F8(I)                                                 DIAT2208
 40   F8(I)=F8(I)*R(I,JJ)                                               DIAT2209
C                                                                       DIAT2210
      DO 50 I=1,IHALF                                                   DIAT2211
 50   E1(I)=F8(2*I-1)                                                   DIAT2212
C                                                                       DIAT2213
      CALL INDEFI(F8,F7,IMAX,H)                                         DIAT2214
      CALL INDEFI(E1,E3,IHALF,TWOH)                                     DIAT2215
      F5(1)=0.                                                          DIAT2216
C                                                                       DIAT2217
      DO 64 I=2,IMAX                                                    DIAT2218
      IF DIVIDE CHECK 60,60                                             DIAT2219
 60   F5(I)=(F5(I)+F6(I)*F7(I))/R(I,JJ+1)                               DIAT2220
      IF DIVIDE CHECK 62,64                                             DIAT2221
 62   F5(I)=0.                                                          DIAT2222
 64   CONTINUE                                                          DIAT2223
C                                                                       DIAT2224
      E1(1)=0.                                                          DIAT2225
C                                                                       DIAT2226
      DO 70 I=2,IHALF                                                   DIAT2227
      IF DIVIDE CHECK 66,66                                             DIAT2228
 66   E1(I)=(E2(I)+F6(2*I-1)*E3(I))/R(2*I-1,JJ+1)                       DIAT2229
      IF DIVIDE CHECK 68,70                                             DIAT2230
 68   E1(I)=0.                                                          DIAT2231
 70   CONTINUE                                                          DIAT2232
C                                                                       DIAT2233
      A=DEFINT(F5,IMAX,H)                                               DIAT2234
      B=A-DEFINT(E1,IHALF,TWOH)                                         DIAT2235
      RETURN                                                            DIAT2236
C                                                                       DIAT2237
      END(0,1,0,0,0)                                                    DIAT2238
C     M458, CORBATO, SWITENDICK                                   INDEFIDIAT2239
C     NOV.  3, 1958                                                     DIAT2240
C                                                                       DIAT2241
      SUBROUTINE INDEFI(F,G,N,H)                                        DIAT2242
      DIMENSION F(385),G(385)                                           DIAT2243
C                                                                       DIAT2244
C     3-POINT INDEFINITE INTEGRATION                                    DIAT2245
C                                                                       DIAT2246
      C=H/3.                                                            DIAT2247
      G(1)=0.                                                           DIAT2248
      G(2)=(H/12.)*(5.*F(1)+8.*F(2)-F(3))                               DIAT2249
C                                                                       DIAT2250
      DO 10 I=3,N                                                       DIAT2251
 10   G(I)=G(I-2)+C*(F(I)+F(I-2)+4.*F(I-1))                             DIAT2252
C                                                                       DIAT2253
      RETURN                                                            DIAT2254
C                                                                       DIAT2255
      END(0,1,0,0,0)                                                    DIAT2256
C     M458, CORBATO, SWITENDICK                                   DEFINTDIAT2257
C     NOV.  3, 1958                                                     DIAT2258
C                                                                       DIAT2259
      FUNCTION DEFINT(F,N,H)                                            DIAT2260
      DIMENSION F(385)                                                  DIAT2261
C                                                                       DIAT2262
C     9-POINT DEFINITE INTEGRATION                                      DIAT2263
C                                                                       DIAT2264
      Z1=(F(1)-F(N))/2.                                                 DIAT2265
      Z2=0.                                                             DIAT2266
      Z3=0.                                                             DIAT2267
      Z4=0.                                                             DIAT2268
      Z5=0.                                                             DIAT2269
C                                                                       DIAT2270
      DO 10 I=9,N,8                                                     DIAT2271
      Z1=Z1+F(I)                                                        DIAT2272
      Z2=Z2+F(I-1)+F(I-7)                                               DIAT2273
      Z3=Z3+F(I-2)+F(I-6)                                               DIAT2274
      Z4=Z4+F(I-3)+F(I-5)                                               DIAT2275
 10   Z5=Z5+F(I-4)                                                      DIAT2276
C                                                                       DIAT2277
      DEFINT=(4.*H/14175.)*(1978.*Z1+5888.*Z2-928.*Z3+10496.*Z4-4540.*Z5DIAT2278
     1)                                                                 DIAT2279
      RETURN                                                            DIAT2280
C                                                                       DIAT2281
      END(0,1,0,0,0)                                                    DIAT2282
C     M458, CORBATO, SWITENDICK                                   PRINT DIAT2283
C     DEC. 12, 1958                                                     DIAT2284
C                                                                       DIAT2285
      SUBROUTINE PRINT(IKIND,ICENT1,ICENT2,ICENT3,ICENT4,K1,K2,K3,K4,A,BDIAT2286
     1,C)                                                               DIAT2287
C     REQUIRED COMMON(THRESM,THRESS,ITPEPR,ITPEPU,ITPEBO)               DIAT2288
C                                                                       DIAT2289
C     (PACKAGE)                                                         DIAT2290
C     NOV.  3, 1958                                                     DIAT2291
C                                                                       DIAT2292
C                                                                       DIAT2293
      COMMON IND,INDS,INDRM1,INDKE,INDNA,INDCOU,INDHYB,INDEXC,IHOMON,   DIAT2294
     1 ITPEPR,ITPEPU,ITPEBO,ITPEF1,IFDUP,IGENSP,IBATCH,KMAXA,KMAXB,MESH,DIAT2295
     2 IMAX,IHALF,JMAX,IORBMX,ILIM,JLIM,LLIM,KOMLIM,A,H,THRESM,THRESS,  DIAT2296
     3 NMAX,LMAX,N,L,M,CAPPA,WEIGHT,ICOMP,IDRBEU,IDRBEX,IMXBEX,         DIAT2297
     4        IDRGMX,IRECTH,DRDT,R,FF,F1,F2,F3,F4,F5,F6,F7,F8,EE,E1,E2, DIAT2298
     5 E3,RR,TEMP1,TEMP2,TEMP3,BETA,W                                   DIAT2299
C                                                                       DIAT2300
      EQUIVALENCE(IND(1),INDS),(IND(2),INDRM1),(IND(3),INDKE),          DIAT2301
     1 (IND(4),INDNA),(IND(5),INDCOU),(IND(6),INDHYB),(IND(7),INDEXC),  DIAT2302
     2 (KMAX(1),KMAXA),(KMAX(2),KMAXB),                                 DIAT2303
     3 (FF(   1),F1),(FF( 386),F2),(FF( 771),F3),(FF(1156),F4),         DIAT2304
     4 (FF(1541),F5),(FF(1926),F6),(FF(2311),F7),(FF(2696),F8),         DIAT2305
     5 (EE(   1),E1),(EE( 386),E2),(EE( 771),E3),                       DIAT2306
     6 (W,DRDT),(W(386),R),(W(11166),FF),(W(14246),EE),(RR,W),          DIAT2307
     7 (TEMP1,W(386)),(TEMP2,W(771)),(TEMP3,W(1156)),(BETA,W(1541))     DIAT2308
C                                                                       DIAT2309
      DIMENSION IND(7),KMAX(2),N(2,20,16),L(2,20),M(2,20),              DIAT2310
     1 CAPPA(2,20,16),WEIGHT(2,20,16),ICOMP(2,20),IDRBEU(3,2,20),       DIAT2311
     2 IDRBEX(2,20),IMXBEX(2,20),                IDRGMX(2,20,21),       DIAT2312
     3 IRECTH(10),DRDT(385),R(385,27),FF(385,8),F1(385),F2(385),F3(385),DIAT2313
     4 F4(385),F5(385),F6(385),F7(385),F8(385),EE(385,3),E1(385),       DIAT2314
     5 E2(385),E3(385),RR(385),TEMP1(385),TEMP2(385),TEMP3(385),        DIAT2315
     6 BETA(385,39),W(385,43)                                           DIAT2316
C                                                                       DIAT2317
C                                                                       DIAT2318
      CALL LFM                                                          DIAT2319
      IF DIVIDE CHECK 1,2                                               DIAT2320
 1    STOP 701                                                          DIAT2321
 2    IF ACCUMULATOR OVERFLOW 3,4                                       DIAT2322
 3    STOP 702                                                          DIAT2323
 4    IF QUOTIENT OVERFLOW 5,6                                          DIAT2324
 5    STOP 703                                                          DIAT2325
 6    CONTINUE                                                          DIAT2326
      I1=XSIGNF(ICENT1*100+XABSF(K1),K1)                                DIAT2327
      I2=XSIGNF(ICENT2*100+XABSF(K2),K2)                                DIAT2328
      I3=XSIGNF(ICENT3*100+XABSF(K3),K3)                                DIAT2329
      I4=XSIGNF(ICENT4*100+XABSF(K4),K4)                                DIAT2330
      IF(ITPEBO)20,20,10                                                DIAT2331
 10   WRITE TAPE ITPEBO,IKIND,I1,I2,I3,I4,A,B,C                         DIAT2332
 20   IF(ITPEPR)40,40,30                                                DIAT2333
 30   ITAPE=ITPEPR                                                      DIAT2334
      ASSIGN 40 TO IRET                                                 DIAT2335
      GO TO 70                                                          DIAT2336
 40   IF(ITPEPU)60,60,50                                                DIAT2337
 50   ITAPE=ITPEPU                                                      DIAT2338
      ASSIGN 60 TO IRET                                                 DIAT2339
      GO TO 70                                                          DIAT2340
 60   CALL EFM                                                          DIAT2341
      RETURN                                                            DIAT2342
C                                                                       DIAT2343
C     OUTPUT TAPE SUBPROGRAM                                            DIAT2344
 70   IF(ABSF(B)-THRESM)100,100,80                                      DIAT2345
 80   IF(ABSF(C)-THRESS)120,120,85                                      DIAT2346
 85   WRITE OUTPUT TAPE ITAPE,90,IKIND,I1,I2,I3,I4,A,B,C                DIAT2347
 90   FORMAT(1H I2,1H 4I5,3F16.8)                                       DIAT2348
      GO TO 130                                                         DIAT2349
 100  IF(ABSF(C)-THRESS)125,125,105                                     DIAT2350
 105  WRITE OUTPUT TAPE ITAPE,110,IKIND,I1,I2,I3,I4,A,C                 DIAT2351
 110  FORMAT(1H I2,1H 4I5,F16.8,F32.8)                                  DIAT2352
      GO TO 130                                                         DIAT2353
 120  WRITE OUTPUT TAPE ITAPE,90,IKIND,I1,I2,I3,I4,A,B                  DIAT2354
      GO TO 130                                                         DIAT2355
 125  WRITE OUTPUT TAPE ITAPE,90,IKIND,I1,I2,I3,I4,A                    DIAT2356
 130  GO TO IRET,(40,60)                                                DIAT2357
C                                                                       DIAT2358
      END(0,1,0,0,0)                                                    DIAT2359
C     *M458, CORBATO, SWITENDICK                                  BADTPEDIAT2360
C     *MAR. 20, 1959                                                    DIAT2361
C                                                                       DIAT2362
      SUBROUTINE BADTPE(I)                                              DIAT2363
C                                                                       DIAT2364
C     (PACKAGE)                                                         DIAT2365
C     NOV.  3, 1958                                                     DIAT2366
C                                                                       DIAT2367
C                                                                       DIAT2368
      COMMON IND,INDS,INDRM1,INDKE,INDNA,INDCOU,INDHYB,INDEXC,IHOMON,   DIAT2369
     1 ITPEPR,ITPEPU,ITPEBO,ITPEF1,IFDUP,IGENSP,IBATCH,KMAXA,KMAXB,MESH,DIAT2370
     2 IMAX,IHALF,JMAX,IORBMX,ILIM,JLIM,LLIM,KOMLIM,A,H,THRESM,THRESS,  DIAT2371
     3 NMAX,LMAX,N,L,M,CAPPA,WEIGHT,ICOMP,IDRBEU,IDRBEX,IMXBEX,         DIAT2372
     4        IDRGMX,IRECTH,DRDT,R,FF,F1,F2,F3,F4,F5,F6,F7,F8,EE,E1,E2, DIAT2373
     5 E3,RR,TEMP1,TEMP2,TEMP3,BETA,W                                   DIAT2374
C                                                                       DIAT2375
      EQUIVALENCE(IND(1),INDS),(IND(2),INDRM1),(IND(3),INDKE),          DIAT2376
     1 (IND(4),INDNA),(IND(5),INDCOU),(IND(6),INDHYB),(IND(7),INDEXC),  DIAT2377
     2 (KMAX(1),KMAXA),(KMAX(2),KMAXB),                                 DIAT2378
     3 (FF(   1),F1),(FF( 386),F2),(FF( 771),F3),(FF(1156),F4),         DIAT2379
     4 (FF(1541),F5),(FF(1926),F6),(FF(2311),F7),(FF(2696),F8),         DIAT2380
     5 (EE(   1),E1),(EE( 386),E2),(EE( 771),E3),                       DIAT2381
     6 (W,DRDT),(W(386),R),(W(11166),FF),(W(14246),EE),(RR,W),          DIAT2382
     7 (TEMP1,W(386)),(TEMP2,W(771)),(TEMP3,W(1156)),(BETA,W(1541))     DIAT2383
C                                                                       DIAT2384
      DIMENSION IND(7),KMAX(2),N(2,20,16),L(2,20),M(2,20),              DIAT2385
     1 CAPPA(2,20,16),WEIGHT(2,20,16),ICOMP(2,20),IDRBEU(3,2,20),       DIAT2386
     2 IDRBEX(2,20),IMXBEX(2,20),                IDRGMX(2,20,21),       DIAT2387
     3 IRECTH(10),DRDT(385),R(385,27),FF(385,8),F1(385),F2(385),F3(385),DIAT2388
     4 F4(385),F5(385),F6(385),F7(385),F8(385),EE(385,3),E1(385),       DIAT2389
     5 E2(385),E3(385),RR(385),TEMP1(385),TEMP2(385),TEMP3(385),        DIAT2390
     6 BETA(385,39),W(385,43)                                           DIAT2391
C                                                                       DIAT2392
C                                                                       DIAT2393
      IABSF=XABSF(I)                                                    DIAT2394
      PRINT 10,IABSF                                                    DIAT2395
 10   FORMAT(1H /29H TAPE FAILURE.  LOGICAL TAPE I2,19H WITHDRAWN BECAUSDIAT2396
     1E /)                                                              DIAT2397
      IF(ITPEPR)13,13,11                                                DIAT2398
 11   WRITE OUTPUT TAPE ITPEPR,10,IABSF                                 DIAT2399
 13   IF(ITPEPU)17,17,15                                                DIAT2400
 15   WRITE OUTPUT TAPE ITPEPU,10,IABSF                                 DIAT2401
 17   CONTINUE                                                          DIAT2402
      IF(I)40,40,20                                                     DIAT2403
 20   PRINT 30                                                          DIAT2404
 30   FORMAT(72H READING A RECORD OUT-OF-PHASE WITH RECORD NUMBER IN TAPDIAT2405
     1E HISTORY TABLE./)                                                DIAT2406
      IF(ITPEPR)33,33,31                                                DIAT2407
 31   WRITE OUTPUT TAPE ITPEPR,30                                       DIAT2408
 33   IF(ITPEPU)37,37,35                                                DIAT2409
 35   WRITE OUTPUT TAPE ITPEPU,30                                       DIAT2410
 37   CONTINUE                                                          DIAT2411
      GO TO 60                                                          DIAT2412
 40   PRINT 50                                                          DIAT2413
 50   FORMAT(62H OF TWO-TIME REDUNDANCY TAPE-TEST FAILURE IN READING A RDIAT2414
     1ECORD./)                                                          DIAT2415
      IF(ITPEPR)53,53,51                                                DIAT2416
 51   WRITE OUTPUT TAPE ITPEPR,50                                       DIAT2417
 53   IF(ITPEPU)57,57,55                                                DIAT2418
 55   WRITE OUTPUT TAPE ITPEPU,50                                       DIAT2419
 57   CONTINUE                                                          DIAT2420
 60   CONTINUE                                                          DIAT2421
      REWIND IABSF                                                      DIAT2422
C                                                                       DIAT2423
C     SET IMPOSSIBLY HIGH HISTORY FOR BAD-READING TAPE                  DIAT2424
      IRECTH(IABSF)=10000                                               DIAT2425
      ITPMAX=ITPEF1+IFDUP-1                                             DIAT2426
      ICOUNT=0                                                          DIAT2427
C                                                                       DIAT2428
      DO 80 ITAPE=ITPEF1,ITPMAX                                         DIAT2429
      IF(IRECTH(ITAPE)-10000)70,80,80                                   DIAT2430
 70   ICOUNT=ICOUNT+1                                                   DIAT2431
 80   CONTINUE                                                          DIAT2432
C                                                                       DIAT2433
      IF(ICOUNT-1)130,110,90                                            DIAT2434
 90   PRINT 100,ICOUNT                                                  DIAT2435
 100  FORMAT(38H CALCULATION OF BATCH CONTINUING WITH I2,24H ACTIVE TEMPDIAT2436
     1ORARY TAPES./1H3/)                                                DIAT2437
      IF(ITPEPR)103,103,101                                             DIAT2438
 101  WRITE OUTPUT TAPE ITPEPR,100,ICOUNT                               DIAT2439
 103  IF(ITPEPU)107,107,105                                             DIAT2440
 105  WRITE OUTPUT TAPE ITPEPU,100,ICOUNT                               DIAT2441
 107  CONTINUE                                                          DIAT2442
      GO TO 150                                                         DIAT2443
 110  PRINT 120                                                         DIAT2444
 120  FORMAT(35H ONLY ONE GOOD TEMPORARY TAPE LEFT./66H PUSH START BUTTODIAT2445
     1N IF IT IS DESIRED TO CONTINUE BATCH AT A REDUCED/21H RATE OF COMPDIAT2446
     2UTATION./1H3/)                                                    DIAT2447
      IF(ITPEPR)123,123,121                                             DIAT2448
 121  WRITE OUTPUT TAPE ITPEPR,120                                      DIAT2449
 123  IF(ITPEPU)127,127,125                                             DIAT2450
 125  WRITE OUTPUT TAPE ITPEPU,120                                      DIAT2451
 127  CONTINUE                                                          DIAT2452
      PAUSE 7                                                           DIAT2453
      GO TO 150                                                         DIAT2454
 130  PRINT 140                                                         DIAT2455
 140  FORMAT(66H NO MORE GOOD TEMPORARY TAPES AVAILABLE FOR USE.  PROGRADIAT2456
     1M STOPPED./1H3/)                                                  DIAT2457
      IF(ITPEPR)143,143,141                                             DIAT2458
 141  WRITE OUTPUT TAPE ITPEPR,140                                      DIAT2459
 143  IF(ITPEPU)147,147,145                                             DIAT2460
 145  WRITE OUTPUT TAPE ITPEPU,140                                      DIAT2461
 147  CONTINUE                                                          DIAT2462
      STOP 77                                                           DIAT2463
C                                                                       DIAT2464
 150  CONTINUE                                                          DIAT2465
      RETURN                                                            DIAT2466
C                                                                       DIAT2467
      END(0,1,0,0,0)                                                    DIAT2468
C     M458, CORBATO, SWITENDICK                                   POST  DIAT2469
C     JANUARY 9, 1959                                                   DIAT2470
C                                                                       DIAT2471
      SUBROUTINE POST                                                   DIAT2472
C     REQUIRED COMMON(ITPEBO,ITPEPR,ITPEPU,IBATCH)                      DIAT2473
C                                                                       DIAT2474
C     (PACKAGE)                                                         DIAT2475
C     NOV.  3, 1958                                                     DIAT2476
C                                                                       DIAT2477
C                                                                       DIAT2478
      COMMON IND,INDS,INDRM1,INDKE,INDNA,INDCOU,INDHYB,INDEXC,IHOMON,   DIAT2479
     1 ITPEPR,ITPEPU,ITPEBO,ITPEF1,IFDUP,IGENSP,IBATCH,KMAXA,KMAXB,MESH,DIAT2480
     2 IMAX,IHALF,JMAX,IORBMX,ILIM,JLIM,LLIM,KOMLIM,A,H,THRESM,THRESS,  DIAT2481
     3 NMAX,LMAX,N,L,M,CAPPA,WEIGHT,ICOMP,IDRBEU,IDRBEX,IMXBEX,         DIAT2482
     4        IDRGMX,IRECTH,DRDT,R,FF,F1,F2,F3,F4,F5,F6,F7,F8,EE,E1,E2, DIAT2483
     5 E3,RR,TEMP1,TEMP2,TEMP3,BETA,W                                   DIAT2484
C                                                                       DIAT2485
      EQUIVALENCE(IND(1),INDS),(IND(2),INDRM1),(IND(3),INDKE),          DIAT2486
     1 (IND(4),INDNA),(IND(5),INDCOU),(IND(6),INDHYB),(IND(7),INDEXC),  DIAT2487
     2 (KMAX(1),KMAXA),(KMAX(2),KMAXB),                                 DIAT2488
     3 (FF(   1),F1),(FF( 386),F2),(FF( 771),F3),(FF(1156),F4),         DIAT2489
     4 (FF(1541),F5),(FF(1926),F6),(FF(2311),F7),(FF(2696),F8),         DIAT2490
     5 (EE(   1),E1),(EE( 386),E2),(EE( 771),E3),                       DIAT2491
     6 (W,DRDT),(W(386),R),(W(11166),FF),(W(14246),EE),(RR,W),          DIAT2492
     7 (TEMP1,W(386)),(TEMP2,W(771)),(TEMP3,W(1156)),(BETA,W(1541))     DIAT2493
C                                                                       DIAT2494
      DIMENSION IND(7),KMAX(2),N(2,20,16),L(2,20),M(2,20),              DIAT2495
     1 CAPPA(2,20,16),WEIGHT(2,20,16),ICOMP(2,20),IDRBEU(3,2,20),       DIAT2496
     2 IDRBEX(2,20),IMXBEX(2,20),                IDRGMX(2,20,21),       DIAT2497
     3 IRECTH(10),DRDT(385),R(385,27),FF(385,8),F1(385),F2(385),F3(385),DIAT2498
     4 F4(385),F5(385),F6(385),F7(385),F8(385),EE(385,3),E1(385),       DIAT2499
     5 E2(385),E3(385),RR(385),TEMP1(385),TEMP2(385),TEMP3(385),        DIAT2500
     6 BETA(385,39),W(385,43)                                           DIAT2501
C                                                                       DIAT2502
C                                                                       DIAT2503
      CALL LFM                                                          DIAT2504
      IF(ITPEBO)20,20,10                                                DIAT2505
 10   END FILE ITPEBO                                                   DIAT2506
      REWIND ITPEBO                                                     DIAT2507
C                                                                       DIAT2508
 20   IF(ITPEPR)40,40,30                                                DIAT2509
 30   ITAPE=ITPEPR                                                      DIAT2510
      ASSIGN 40 TO IRET                                                 DIAT2511
      GO TO 100                                                         DIAT2512
C                                                                       DIAT2513
 40   IF(ITPEPU)60,60,50                                                DIAT2514
 50   ITAPE=ITPEPU                                                      DIAT2515
      ASSIGN60 TO IRET                                                  DIAT2516
      GO TO 100                                                         DIAT2517
C                                                                       DIAT2518
 60   PRINT 110,IBATCH                                                  DIAT2519
      PRINT 70                                                          DIAT2520
 70   FORMAT(1H1/)                                                      DIAT2521
      CALL EFM                                                          DIAT2522
      RETURN                                                            DIAT2523
C                                                                       DIAT2524
 100  WRITE OUTPUT TAPE ITAPE,110,IBATCH                                DIAT2525
 110  FORMAT(1H /14H END OF BATCH I5/)                                  DIAT2526
      END FILE ITAPE                                                    DIAT2527
      GO TO IRET,(40,60)                                                DIAT2528
C                                                                       DIAT2529
      END(0,1,0,0,0)                                                    DIAT2530
C     * M458, CORBATO, SWITENDICK                                 CALC1EDIAT2531
C     *APRIL 24, 1959                                                   DIAT2532
C                                                                       DIAT2533
      SUBROUTINE CALC1E                                                 DIAT2534
C     REQUIRED COMMON(INDS,INDRM1,INDKE,INDNA,KMAX,F1,F2,R(I,2),L,M,    DIAT2535
C                     IMAX,IHOMON)                                      DIAT2536
C                                                                       DIAT2537
C     (PACKAGE)                                                         DIAT2538
C     NOV.  3, 1958                                                     DIAT2539
C                                                                       DIAT2540
C                                                                       DIAT2541
      COMMON IND,INDS,INDRM1,INDKE,INDNA,INDCOU,INDHYB,INDEXC,IHOMON,   DIAT2542
     1 ITPEPR,ITPEPU,ITPEBO,ITPEF1,IFDUP,IGENSP,IBATCH,KMAXA,KMAXB,MESH,DIAT2543
     2 IMAX,IHALF,JMAX,IORBMX,ILIM,JLIM,LLIM,KOMLIM,A,H,THRESM,THRESS,  DIAT2544
     3 NMAX,LMAX,N,L,M,CAPPA,WEIGHT,ICOMP,IDRBEU,IDRBEX,IMXBEX,         DIAT2545
     4        IDRGMX,IRECTH,DRDT,R,FF,F1,F2,F3,F4,F5,F6,F7,F8,EE,E1,E2, DIAT2546
     5 E3,RR,TEMP1,TEMP2,TEMP3,BETA,W                                   DIAT2547
C                                                                       DIAT2548
      EQUIVALENCE(IND(1),INDS),(IND(2),INDRM1),(IND(3),INDKE),          DIAT2549
     1 (IND(4),INDNA),(IND(5),INDCOU),(IND(6),INDHYB),(IND(7),INDEXC),  DIAT2550
     2 (KMAX(1),KMAXA),(KMAX(2),KMAXB),                                 DIAT2551
     3 (FF(   1),F1),(FF( 386),F2),(FF( 771),F3),(FF(1156),F4),         DIAT2552
     4 (FF(1541),F5),(FF(1926),F6),(FF(2311),F7),(FF(2696),F8),         DIAT2553
     5 (EE(   1),E1),(EE( 386),E2),(EE( 771),E3),                       DIAT2554
     6 (W,DRDT),(W(386),R),(W(11166),FF),(W(14246),EE),(RR,W),          DIAT2555
     7 (TEMP1,W(386)),(TEMP2,W(771)),(TEMP3,W(1156)),(BETA,W(1541))     DIAT2556
C                                                                       DIAT2557
      DIMENSION IND(7),KMAX(2),N(2,20,16),L(2,20),M(2,20),              DIAT2558
     1 CAPPA(2,20,16),WEIGHT(2,20,16),ICOMP(2,20),IDRBEU(3,2,20),       DIAT2559
     2 IDRBEX(2,20),IMXBEX(2,20),                IDRGMX(2,20,21),       DIAT2560
     3 IRECTH(10),DRDT(385),R(385,27),FF(385,8),F1(385),F2(385),F3(385),DIAT2561
     4 F4(385),F5(385),F6(385),F7(385),F8(385),EE(385,3),E1(385),       DIAT2562
     5 E2(385),E3(385),RR(385),TEMP1(385),TEMP2(385),TEMP3(385),        DIAT2563
     6 BETA(385,39),W(385,43)                                           DIAT2564
C                                                                       DIAT2565
C                                                                       DIAT2566
      DO 74 ITYPE=1,3                                                   DIAT2567
      IF(IND(ITYPE))10,74,10                                            DIAT2568
C                                                                       DIAT2569
C     ONE-CENTER ONE-ELECTRON INTEGRALS                                 DIAT2570
C                                                                       DIAT2571
 10   DO 72 ICENT=1,2                                                   DIAT2572
      IF(IHOMON)14,14,12                                                DIAT2573
 12   IF(ICENT-2)14,72,72                                               DIAT2574
 14   CONTINUE                                                          DIAT2575
      KK=KMAX(ICENT)                                                    DIAT2576
      ICOM=3-ICENT                                                      DIAT2577
      KKK=KMAX(ICOM)                                                    DIAT2578
C                                                                       DIAT2579
      DO 40 K1=1,KK                                                     DIAT2580
      IGOT1=0                                                           DIAT2581
C                                                                       DIAT2582
      DO 40 K2=1,K1                                                     DIAT2583
      IGOT2=0                                                           DIAT2584
      IF(L(ICENT,K1)-L(ICENT,K2))40,20,40                               DIAT2585
 20   CONTINUE                                                          DIAT2586
C                                                                       DIAT2587
      DO 39 MSWITC=1,3,2                                                DIAT2588
      MSW=2-MSWITC                                                      DIAT2589
      M1=XABSF(M(ICENT,K1))                                             DIAT2590
      M2=XSIGNF(M(ICENT,K2),MSW)                                        DIAT2591
      IF(M2) 31,30,31                                                   DIAT2592
 30   IF(MSW) 39,39,31                                                  DIAT2593
 31   IF(M1-M2) 39,32,39                                                DIAT2594
 32   CONTINUE                                                          DIAT2595
      IF(IGOT1) 34,34,35                                                DIAT2596
 34   CALL GETFUN(F1,ITYPE,1,ICENT,K1,0,0)                              DIAT2597
      IGOT1=1                                                           DIAT2598
 35   IF(IGOT2) 36,36,37                                                DIAT2599
 36   CALL GETFUN(F2,1,1,ICENT,K2,0,0)                                  DIAT2600
      IGOT2=1                                                           DIAT2601
 37   CONTINUE                                                          DIAT2602
      IC=ICENT                                                          DIAT2603
      FM=2.                                                             DIAT2604
      ASSIGN 39 TO IRET                                                 DIAT2605
      GO TO 200                                                         DIAT2606
 39   CONTINUE                                                          DIAT2607
 40   CONTINUE                                                          DIAT2608
C                                                                       DIAT2609
C     TWO-CENTER ONE-ELECTRON INTEGRALS                                 DIAT2610
C                                                                       DIAT2611
      IF(ITYPE-2) 42,41,42                                              DIAT2612
 41   IF(IHOMON-1) 44,42,72                                             DIAT2613
 42   IF(ICENT-2)44,72,44                                               DIAT2614
 44   CONTINUE                                                          DIAT2615
C                                                                       DIAT2616
      DO 70 K1=1,KK                                                     DIAT2617
      IGOT1=0                                                           DIAT2618
      IF(IHOMON-1)48,46,72                                              DIAT2619
 46   KKK=K1                                                            DIAT2620
      IF(ITYPE-2) 48,47,48                                              DIAT2621
 47   KKK=KMAX(1)                                                       DIAT2622
 48   CONTINUE                                                          DIAT2623
C                                                                       DIAT2624
      DO 70 K2=1,KKK                                                    DIAT2625
      IGOT2=0                                                           DIAT2626
C                                                                       DIAT2627
      DO 70 MSWITC=1,3,2                                                DIAT2628
      MSW=2-MSWITC                                                      DIAT2629
      M1=XABSF(M(ICENT,K1))                                             DIAT2630
      M2=XSIGNF(M(ICOM,K2),MSW)                                         DIAT2631
      IF(M2) 54,52,54                                                   DIAT2632
 52   IF(MSW) 70,70,54                                                  DIAT2633
 54   IF(M1-M2) 70,56,70                                                DIAT2634
 56   CONTINUE                                                          DIAT2635
      L1=L(ICENT,K1)                                                    DIAT2636
      L2=L(ICOM,K2)                                                     DIAT2637
      JREL=L1-M1                                                        DIAT2638
      IF(IGOT1) 58,58,60                                                DIAT2639
 58   CALL GETFUN(F1,ITYPE,1,ICENT,K1,0,0)                              DIAT2640
      IGOT1=1                                                           DIAT2641
 60   IF(IGOT2) 62,62,64                                                DIAT2642
 62   CALL GETFUN(F2,1,2,ICOM,K2,0,JREL)                                DIAT2643
      IGOT2=1                                                           DIAT2644
 64   CONTINUE                                                          DIAT2645
      IC=ICOM                                                           DIAT2646
      FM=2.*SQRTF(FACTOR(L2,M2)/FACTOR(L1,M1))                          DIAT2647
      ASSIGN 70 TO IRET                                                 DIAT2648
      GO TO 200                                                         DIAT2649
 70   CONTINUE                                                          DIAT2650
C                                                                       DIAT2651
 72   CONTINUE                                                          DIAT2652
C                                                                       DIAT2653
 74   CONTINUE                                                          DIAT2654
C                                                                       DIAT2655
C     NUCLEAR ATTRACTION INTEGRALS                                      DIAT2656
C                                                                       DIAT2657
      IF(INDNA)80,120,80                                                DIAT2658
 80   CONTINUE                                                          DIAT2659
      F2(1)=1.0E38                                                      DIAT2660
C                                                                       DIAT2661
      DO 90 I=2,IMAX                                                    DIAT2662
 90   F2(I)=1./R(I,2)                                                   DIAT2663
C                                                                       DIAT2664
      DO 112 ICENT=1,2                                                  DIAT2665
      IF(IHOMON-1)93,92,112                                             DIAT2666
 92   IF(ICENT-2)93,112,112                                             DIAT2667
 93   CONTINUE                                                          DIAT2668
      KK=KMAX(ICENT)                                                    DIAT2669
C                                                                       DIAT2670
      DO 110 K1=1,KK                                                    DIAT2671
      L1=L(ICENT,K1)                                                    DIAT2672
      M1=XABSF(M(ICENT,K1))                                             DIAT2673
C                                                                       DIAT2674
      DO 110 K2=1,K1                                                    DIAT2675
      L2=L(ICENT,K2)                                                    DIAT2676
      M2=XABSF(M(ICENT,K2))                                             DIAT2677
      MSW=1                                                             DIAT2678
      IF(M1-M2)110,100,110                                              DIAT2679
 100  CONTINUE                                                          DIAT2680
      CALL GETFUN(F1,4,2,ICENT,K1,K2,0)                                 DIAT2681
      ITYPE=4                                                           DIAT2682
      IC=ICENT                                                          DIAT2683
      FM=2.*SQRTF(FACTOR(L1,M1)*FACTOR(L2,M2))                          DIAT2684
      ASSIGN 110 TO IRET                                                DIAT2685
      GO TO 200                                                         DIAT2686
 110  CONTINUE                                                          DIAT2687
C                                                                       DIAT2688
 112  CONTINUE                                                          DIAT2689
C                                                                       DIAT2690
 120  RETURN                                                            DIAT2691
C                                                                       DIAT2692
C     INTEGRATE AND PRINT SUBPROGRAM                                    DIAT2693
 200  CALL SINGLE(AA,BB)                                                DIAT2694
      AA=FM*AA                                                          DIAT2695
      BB=FM*BB                                                          DIAT2696
      CALL PRINT(ITYPE,ICENT,IC,0,0,K1,XSIGNF(K2,MSW),0,0,AA,BB,0.)     DIAT2697
      GO TO IRET,(39,70,110)                                            DIAT2698
C                                                                       DIAT2699
      END(0,1,0,0,0)                                                    DIAT2700
C     M458-3, CORBATO, SWITENDICK                                 CALC2EDIAT2701
C     *APRIL 27, 1959                                                   DIAT2702
C                                                                       DIAT2703
      SUBROUTINE CALC2E(ISW,ICEN)                                       DIAT2704
C     REQUIRED COMMON(IND,KMAX,F1,F2,F3,F4,L,M,IMAX,JMAX,IHOMON,IORBMX) DIAT2705
C                                                                       DIAT2706
C     (PACKAGE)                                                         DIAT2707
C     NOV.  3, 1958                                                     DIAT2708
C                                                                       DIAT2709
C                                                                       DIAT2710
      COMMON IND,INDS,INDRM1,INDKE,INDNA,INDCOU,INDHYB,INDEXC,IHOMON,   DIAT2711
     1 ITPEPR,ITPEPU,ITPEBO,ITPEF1,IFDUP,IGENSP,IBATCH,KMAXA,KMAXB,MESH,DIAT2712
     2 IMAX,IHALF,JMAX,IORBMX,ILIM,JLIM,LLIM,KOMLIM,A,H,THRESM,THRESS,  DIAT2713
     3 NMAX,LMAX,N,L,M,CAPPA,WEIGHT,ICOMP,IDRBEU,IDRBEX,IMXBEX,         DIAT2714
     4        IDRGMX,IRECTH,DRDT,R,FF,F1,F2,F3,F4,F5,F6,F7,F8,EE,E1,E2, DIAT2715
     5 E3,RR,TEMP1,TEMP2,TEMP3,BETA,W                                   DIAT2716
C                                                                       DIAT2717
      EQUIVALENCE(IND(1),INDS),(IND(2),INDRM1),(IND(3),INDKE),          DIAT2718
     1 (IND(4),INDNA),(IND(5),INDCOU),(IND(6),INDHYB),(IND(7),INDEXC),  DIAT2719
     2 (KMAX(1),KMAXA),(KMAX(2),KMAXB),                                 DIAT2720
     3 (FF(   1),F1),(FF( 386),F2),(FF( 771),F3),(FF(1156),F4),         DIAT2721
     4 (FF(1541),F5),(FF(1926),F6),(FF(2311),F7),(FF(2696),F8),         DIAT2722
     5 (EE(   1),E1),(EE( 386),E2),(EE( 771),E3),                       DIAT2723
     6 (W,DRDT),(W(386),R),(W(11166),FF),(W(14246),EE),(RR,W),          DIAT2724
     7 (TEMP1,W(386)),(TEMP2,W(771)),(TEMP3,W(1156)),(BETA,W(1541))     DIAT2725
C                                                                       DIAT2726
      DIMENSION IND(7),KMAX(2),N(2,20,16),L(2,20),M(2,20),              DIAT2727
     1 CAPPA(2,20,16),WEIGHT(2,20,16),ICOMP(2,20),IDRBEU(3,2,20),       DIAT2728
     2 IDRBEX(2,20),IMXBEX(2,20),                IDRGMX(2,20,21),       DIAT2729
     3 IRECTH(10),DRDT(385),R(385,27),FF(385,8),F1(385),F2(385),F3(385),DIAT2730
     4 F4(385),F5(385),F6(385),F7(385),F8(385),EE(385,3),E1(385),       DIAT2731
     5 E2(385),E3(385),RR(385),TEMP1(385),TEMP2(385),TEMP3(385),        DIAT2732
     6 BETA(385,39),W(385,43)                                           DIAT2733
C                                                                       DIAT2734
C                                                                       DIAT2735
      DIMENSION IPRINT(8),SUMAA(8),SUMBB(8),DELJJ(8)                    DIAT2736
C                                                                       DIAT2737
      GO TO (10,10,20,30),ISW                                           DIAT2738
 10   IKIND=5                                                           DIAT2739
      GO TO 40                                                          DIAT2740
 20   IKIND=6                                                           DIAT2741
      GO TO 40                                                          DIAT2742
 30   IKIND=7                                                           DIAT2743
 40   IF(IND(IKIND))1210,1210,50                                        DIAT2744
 50   CONTINUE                                                          DIAT2745
C                                                                       DIAT2746
C     RETURN IF 2-CENTER INTEGRALS CALLED FOR AND MONONUCLEAR CASE      DIAT2747
      GO TO (70,60,60,60),ISW                                           DIAT2748
 60   IF(IHOMON-1)70,70,1210                                            DIAT2749
 70   CONTINUE                                                          DIAT2750
C                                                                       DIAT2751
C     PREPARE POSSIBLE COULOMB VALUES                                   DIAT2752
      COEF2=1.                                                          DIAT2753
      ICOE2=1                                                           DIAT2754
C                                                                       DIAT2755
      DO 80 I=1,IMAX                                                    DIAT2756
 80   F3(I)=1.                                                          DIAT2757
C                                                                       DIAT2758
      IGOT3=1                                                           DIAT2759
C                                                                       DIAT2760
      ICOM=3-ICEN                                                       DIAT2761
      IC1=ICEN                                                          DIAT2762
      IC2=ICEN                                                          DIAT2763
      GO TO (100,100,100,90),ISW                                        DIAT2764
 90   IC2=ICOM                                                          DIAT2765
 100  IC3=ICEN                                                          DIAT2766
      GO TO (120,110,120,120),ISW                                       DIAT2767
 110  IC3=ICOM                                                          DIAT2768
 120  IC4=ICEN                                                          DIAT2769
      GO TO (140,130,130,130),ISW                                       DIAT2770
 130  IC4=ICOM                                                          DIAT2771
 140  CONTINUE                                                          DIAT2772
C                                                                       DIAT2773
      KK1=KMAX(IC1)                                                     DIAT2774
      KK2=KMAX(IC2)                                                     DIAT2775
      KK3=KMAX(IC3)                                                     DIAT2776
      KK4=KMAX(IC4)                                                     DIAT2777
      IF(IHOMON)160,160,150                                             DIAT2778
 150  KK1=KMAX(1)                                                       DIAT2779
      KK2=KMAX(1)                                                       DIAT2780
      KK3=KMAX(1)                                                       DIAT2781
      KK4=KMAX(1)                                                       DIAT2782
 160  CONTINUE                                                          DIAT2783
C                                                                       DIAT2784
C                                                                       DIAT2785
C     HETERONUCLEAR RESTRICTIONS TO ORBITAL SUMMATIONS IN ADDITION TO   DIAT2786
C     THE DIMENSIONAL LIMITS                                            DIAT2787
C                                                                       DIAT2788
C     ONE-CENTER/ K2 LESS THAN OR = K1, K4 LESS THAN OR = K3,           DIAT2789
C                 K34 LESS THAN OR = K12.                               DIAT2790
C     COULOMB   / K2 LESS THAN OR = K1, K4 LESS THAN OR = K3.           DIAT2791
C     HYBRID    / K2 LESS THAN OR = K1.                                 DIAT2792
C     EXCHANGE  / K34 LESS THAN OR = K12.                               DIAT2793
C                                                                       DIAT2794
C                                                                       DIAT2795
C     HOMONUCLEAR RESTRICTIONS IN ADDITION TO HETERONUCLEAR RESTRICTIONSDIAT2796
C                                                                       DIAT2797
C     ONE-CENTER/ NONE                                                  DIAT2798
C     COULOMB   / K34 LESS THAN OR = K12.                               DIAT2799
C     HYBRID    / NONE                                                  DIAT2800
C     EXCHANGE  / K1234 GREATER THAN OR = MAXIMUM OF (K2143, K4321).    DIAT2801
C                                                                       DIAT2802
      DO 1200 K1=1,KK1                                                  DIAT2803
      GO TO (170,170,170,180),ISW                                       DIAT2804
 170  KK2=K1                                                            DIAT2805
 180  CONTINUE                                                          DIAT2806
      L1=L(IC1,K1)                                                      DIAT2807
      MAB1=XABSF(M(IC1,K1))                                             DIAT2808
      IGOT1=0                                                           DIAT2809
C                                                                       DIAT2810
      DO 1190 K2=1,KK2                                                  DIAT2811
      GO TO (200,190,210,200),ISW                                       DIAT2812
 190  IF(IHOMON)210,210,200                                             DIAT2813
 200  KK3=K1                                                            DIAT2814
 210  CONTINUE                                                          DIAT2815
      L2=L(IC2,K2)                                                      DIAT2816
      MAB2=XABSF(M(IC2,K2))                                             DIAT2817
      GO TO (230,230,230,240),ISW                                       DIAT2818
 230  IGOT2=0                                                           DIAT2819
 240  CONTINUE                                                          DIAT2820
C                                                                       DIAT2821
      DO 1180 K3=1,KK3                                                  DIAT2822
      GO TO (250,250,260,260),ISW                                       DIAT2823
 250  KK4=K3                                                            DIAT2824
 260  CONTINUE                                                          DIAT2825
      L3=L(IC3,K3)                                                      DIAT2826
      MAB3=XABSF(M(IC3,K3))                                             DIAT2827
      GO TO (270,280,270,270),ISW                                       DIAT2828
 270  IGOT3=0                                                           DIAT2829
 280  CONTINUE                                                          DIAT2830
C                                                                       DIAT2831
      DO 1170 K4=1,KK4                                                  DIAT2832
      K12=K1*IORBMX+K2                                                  DIAT2833
      K34=K3*IORBMX+K4                                                  DIAT2834
      GO TO (300,290,310,300),ISW                                       DIAT2835
 290  IF(IHOMON)310,310,300                                             DIAT2836
 300  IF(K34-K12)310,310,1170                                           DIAT2837
 310  GO TO (350,350,350,320),ISW                                       DIAT2838
 320  IF(IHOMON)350,350,330                                             DIAT2839
 330  K21=K2*IORBMX+K1                                                  DIAT2840
      K43=K4*IORBMX+K3                                                  DIAT2841
      KLIMSQ=IORBMX*IORBMX                                              DIAT2842
      K2143=K21*KLIMSQ+K43                                              DIAT2843
      K4321=K43*KLIMSQ+K21                                              DIAT2844
      K1234=K12*KLIMSQ+K34                                              DIAT2845
 340  IF(K1234-XMAX0F(K2143,K4321))1170,350,350                         DIAT2846
 350  CONTINUE                                                          DIAT2847
      L4=L(IC4,K4)                                                      DIAT2848
      MAB4=XABSF(M(IC4,K4))                                             DIAT2849
      GO TO (360,370,370,370),ISW                                       DIAT2850
 360  IGOT4=0                                                           DIAT2851
 370  CONTINUE                                                          DIAT2852
C                                                                       DIAT2853
      DO 380 ICALC=1,8                                                  DIAT2854
      IPRINT(ICALC)=0                                                   DIAT2855
      SUMAA(ICALC)=0.                                                   DIAT2856
      SUMBB(ICALC)=0.                                                   DIAT2857
 380  DELJJ(ICALC)=0.                                                   DIAT2858
C                                                                       DIAT2859
      GO TO (390,390,390,400),ISW                                       DIAT2860
 390  IPPMIN=L2+1                                                       DIAT2861
      IPPMAX=L2+1                                                       DIAT2862
      GO TO 410                                                         DIAT2863
 400  IPPMIN=MAB2+1                                                     DIAT2864
      IPPMAX=JMAX+L1+1                                                  DIAT2865
 410  IF(IPPMAX-IPPMIN)1170,420,420                                     DIAT2866
 420  CONTINUE                                                          DIAT2867
C                                                                       DIAT2868
      DO 1140 IPP=IPPMIN,IPPMAX                                         DIAT2869
      IP=IPP-1                                                          DIAT2870
      GO TO (440,440,440,430),ISW                                       DIAT2871
 430  IGOT2=0                                                           DIAT2872
 440  CONTINUE                                                          DIAT2873
      GO TO (450,450,460,470),ISW                                       DIAT2874
 450  IQQMAX=L4+1                                                       DIAT2875
      IQQMIN=L4+1                                                       DIAT2876
      GO TO 480                                                         DIAT2877
 460  IQQMAX=L1+L2+L3+1                                                 DIAT2878
      GO TO 475                                                         DIAT2879
 470  IQQMAX=JMAX+L3+1                                                  DIAT2880
 475  IQQMIN=MAB4+1                                                     DIAT2881
 480  IF(IQQMAX-IQQMIN)1140,490,490                                     DIAT2882
 490  CONTINUE                                                          DIAT2883
C                                                                       DIAT2884
      DO 1130 IQQ=IQQMIN,IQQMAX                                         DIAT2885
      IQ=IQQ-1                                                          DIAT2886
      GO TO (510,510,500,500),ISW                                       DIAT2887
 500  IGOT4=0                                                           DIAT2888
 510  CONTINUE                                                          DIAT2889
      GO TO (530,520,530,535),ISW                                       DIAT2890
 520  JJMIN=XMAX0F(XABSF(IP-L1),XABSF(MAB1-MAB2),XABSF(MAB3-MAB4))+1    DIAT2891
      JJMAX=IP+L1+1                                                     DIAT2892
      GO TO 540                                                         DIAT2893
 530  JJMIN=XMAX0F(XABSF(IP-L1),XABSF(MAB1-MAB2),XABSF(IQ-L3),XABSF(MAB3DIAT2894
     1-MAB4))+1                                                         DIAT2895
      JJMAX=XMIN0F(IP+L1,IQ+L3)+1                                       DIAT2896
      GO TO 540                                                         DIAT2897
 535  JJMIN=XMAX0F(XABSF(IP-L1),XABSF(MAB1-MAB2),XABSF(IQ-L3),XABSF(MAB3DIAT2898
     1-MAB4))+1                                                         DIAT2899
      JJMAX=XMIN0F(IP+L1,IQ+L3,JMAX)+1                                  DIAT2900
 540  JJMIN=JJMIN+XABSF(XMODF(JJMAX,2)-XMODF(JJMIN,2))                  DIAT2901
      IF(JJMAX-JJMIN)1130,550,550                                       DIAT2902
 550  CONTINUE                                                          DIAT2903
C                                                                       DIAT2904
      DO 1120 MCL34=1,3,2                                               DIAT2905
      GO TO (570,560,570,570),ISW                                       DIAT2906
 560  MCSW34=2-MCL34                                                    DIAT2907
      GO TO 580                                                         DIAT2908
 570  IF(MCL34-3)580,1120,1120                                          DIAT2909
 580  CONTINUE                                                          DIAT2910
C                                                                       DIAT2911
      DO 1110 JJ=JJMIN,JJMAX,2                                          DIAT2912
      J=JJ-1                                                            DIAT2913
      GO TO (600,590,600,600),ISW                                       DIAT2914
 590  IGOT4=0                                                           DIAT2915
 600  CONTINUE                                                          DIAT2916
      IDONE=0                                                           DIAT2917
C                                                                       DIAT2918
      DO 1100 MC34=1,3,2                                                DIAT2919
      GO TO (610,620,610,610),ISW                                       DIAT2920
 610  MCSW34=2-MC34                                                     DIAT2921
      ICOE2=0                                                           DIAT2922
      GO TO 630                                                         DIAT2923
 620  IF(MC34-3)630,1100,1100                                           DIAT2924
 630  CONTINUE                                                          DIAT2925
C                                                                       DIAT2926
      DO 1090 MC12=1,3,2                                                DIAT2927
      MCSW12=2-MC12                                                     DIAT2928
      ICOE1=0                                                           DIAT2929
      IFACTR=0                                                          DIAT2930
      MSW1=1                                                            DIAT2931
      M1=MAB1                                                           DIAT2932
C                                                                       DIAT2933
      DO 1080 MSWCH2=1,3,2                                              DIAT2934
      MSW2=2-MSWCH2                                                     DIAT2935
      M2=XSIGNF(MAB2,MSW2)                                              DIAT2936
      IF(M2)650,640,650                                                 DIAT2937
 640  IF(MSW2)1080,650,650                                              DIAT2938
 650  CONTINUE                                                          DIAT2939
C                                                                       DIAT2940
      DO 1070 MSWCH3=1,3,2                                              DIAT2941
      MSW3=MSWCH3-2                                                     DIAT2942
      M3=XSIGNF(MAB3,MSW3)                                              DIAT2943
      IF(M3)670,660,670                                                 DIAT2944
 660  IF(MSW3)1070,670,670                                              DIAT2945
 670  CONTINUE                                                          DIAT2946
      MLIM4=3                                                           DIAT2947
      GO TO (680,680,700,700),ISW                                       DIAT2948
 680  IF(K4-K3)700,690,700                                              DIAT2949
 690  MLIM4=MSWCH3                                                      DIAT2950
 700  GO TO (720,710,740,720),ISW                                       DIAT2951
 710  IF(IHOMON)740,740,720                                             DIAT2952
 720  IF(K34-K12)740,730,740                                            DIAT2953
 730  MLIM4=MSWCH2                                                      DIAT2954
 740  CONTINUE                                                          DIAT2955
C                                                                       DIAT2956
      DO 1060 MSWCH4=1,MLIM4,2                                          DIAT2957
      MSW4=2-MSWCH4                                                     DIAT2958
      M4=XSIGNF(MAB4,MSW4)                                              DIAT2959
      IF(M4)760,750,760                                                 DIAT2960
 750  IF(MSW4)1060,760,760                                              DIAT2961
 760  CONTINUE                                                          DIAT2962
      IF(M1-M2+M3-M4)1060,770,1060                                      DIAT2963
 770  CONTINUE                                                          DIAT2964
      IF(MCSW12*MSW1*MSW2)1060,1060,780                                 DIAT2965
 780  IF(MCSW34*MSW3*MSW4)1060,1060,790                                 DIAT2966
 790  CONTINUE                                                          DIAT2967
      IF(ICOE1)800,800,810                                              DIAT2968
 800  COEF1=DCOE(J,L1,IP,M1,M2)                                         DIAT2969
      ICOE1=1                                                           DIAT2970
 810  IF(COEF1)820,1060,820                                             DIAT2971
 820  CONTINUE                                                          DIAT2972
      IF(ICOE2)830,830,840                                              DIAT2973
 830  COEF2=DCOE(J,L3,IQ,M3,M4)                                         DIAT2974
      ICOE2=1                                                           DIAT2975
 840  IF(COEF2)850,1060,850                                             DIAT2976
 850  CONTINUE                                                          DIAT2977
      IF(IGOT1)860,860,870                                              DIAT2978
 860  CALL GETFUN(F1,1,1,IC1,K1,0,0)                                    DIAT2979
      IGOT1=1                                                           DIAT2980
 870  IF(IGOT2)880,880,920                                              DIAT2981
 880  GO TO (890,890,890,900),ISW                                       DIAT2982
 890  CALL GETFUN(F2,1,1,IC2,K2,0,0)                                    DIAT2983
      GO TO 910                                                         DIAT2984
 900  CALL GETFUN(F2,1,2,IC2,K2,0,IP-MAB2)                              DIAT2985
 910  IGOT2=1                                                           DIAT2986
 920  IF(IGOT3)930,930,940                                              DIAT2987
 930  CALL GETFUN(F3,1,1,IC3,K3,0,0)                                    DIAT2988
      IGOT3=1                                                           DIAT2989
 940  IF(IGOT4)950,950,1000                                             DIAT2990
 950  GO TO (960,980,970,970),ISW                                       DIAT2991
 960  CALL GETFUN(F4,1,1,IC4,K4,0,0)                                    DIAT2992
      GO TO 990                                                         DIAT2993
 970  CALL GETFUN(F4,1,2,IC4,K4,0,IQ-MAB4)                              DIAT2994
      GO TO 990                                                         DIAT2995
 980  JSIGN=MSW3*MSW4                                                   DIAT2996
      IF(MAB4) 982,984,982                                              DIAT2997
 982  IF(MAB3) 986,984,986                                              DIAT2998
 984  JSIGN=XABSF(JSIGN)                                                DIAT2999
 986  CALL GETFUN(F4,4,2,IC4,K3,K4,XSIGNF(J-XABSF(M3-M4),JSIGN))        DIAT3000
 990  IGOT4=1                                                           DIAT3001
 1000 CONTINUE                                                          DIAT3002
      IF(IDONE)1010,1010,1020                                           DIAT3003
 1010 CALL DOUBLE (J,AA,BB)                                             DIAT3004
      IDONE=1                                                           DIAT3005
 1020 CONTINUE                                                          DIAT3006
      IF(IFACTR)1022,1022,1024                                          DIAT3007
 1022 FM=(COEF2/FACTOR(J,M1-M2))*(COEF1/FLOATF(J+J+1))                  DIAT3008
      IFACTR=1                                                          DIAT3009
 1024 CONTINUE                                                          DIAT3010
      ICALC=(4*MSW2+2*MSW3+MSW4+7)/2+1                                  DIAT3011
      IPRINT(ICALC)=1                                                   DIAT3012
      SUMAA(ICALC)=SUMAA(ICALC)+FM*AA                                   DIAT3013
      SUMBB(ICALC)=SUMBB(ICALC)+FM*BB                                   DIAT3014
      GO TO (1050,1050,1050,1030),ISW                                   DIAT3015
 1030 IF(J-JMAX)1050,1040,1050                                          DIAT3016
 1040 DELJJ(ICALC)=DELJJ(ICALC)+FM*AA                                   DIAT3017
 1050 CONTINUE                                                          DIAT3018
 1060 CONTINUE                                                          DIAT3019
C                                                                       DIAT3020
 1070 CONTINUE                                                          DIAT3021
