C     EXPLICIT SOLUTION OF THE GENERAL CUBIC EQUATION                   00010001
      SUBROUTINE VIETA (A, Y, MTYPE )                                   00010002
      DIMENSION  A(4), B(3), Y(3)                                       00010003
      B(1) = A(2)/A(1)                                                  00010004
      B1OV3 = B(1)/3.0                                                  00010005
      B(2) = A(3)/A(1)                                                  00010006
      B(3) = A(4)/A(1)                                                  00010007
      ALF = B(2) - B(1)*B1OV3                                           00010008
      BET = 2.0*B1OV3**3  - B(2)*B1OV3 + B(3)                           00010009
      BETOV2 = BET/2.0                                                  00010010
      ALFOV3 = ALF/3.0                                                  00010011
      CUAOV3 = ALFOV3**3                                                00010012
      SQBOV2 = BETOV2**2                                                00010013
      DEL = SQBOV2 + CUAOV3                                             00010014
      IF (DEL) 40,20,30                                                 00010015
   20 MTYPE = 0                                                         00010016
      GAM = SQRTF(-ALFOV3)                                              00010017
      IF (BET) 22,22,21                                                 00010018
   21 Y(1) = -2.0*GAM -B1OV3                                            00010019
      Y(2) = GAM - B1OV3                                                00010020
      Y(3) = Y(2)                                                       00010021
      GO TO 50                                                          00010022
   22 Y(1) = 2.0*GAM -B1OV3                                             00010023
      Y(2) = -GAM -B1OV3                                                00010024
      Y(3) = Y(2)                                                       00010025
      GO TO 50                                                          00010026
   30 MTYPE = 1                                                         00010027
      EPS = SQRTF(DEL)                                                  00010028
      TAU = -BETOV2                                                     00010029
      R = CUBERTF(TAU + EPS)                                            00010030
      S = CUBERTF(TAU - EPS)                                            00010031
      Y(1) = R + S  - B1OV3                                             00010032
      Y(2) = -(R+S)/2.0 - B1OV3                                         00010033
      Y(3) = 0.86602540*(R-S)                                           00010034
      GO TO 50                                                          00010035
   40 MTYPE = -1                                                        00010036
      QUOT = SQBOV2/CUAOV3                                              00010037
      ROOT = SQRTF(-QUOT)                                               00010038
      IF(BET) 42,41,41                                                  00010039
   41 PHI = (1.5707963 + ASINF(ROOT))/3.0                               00010040
      GO TO 43                                                          00010041
   42 PHI = ACOSF(ROOT)/3.0                                             00010042
   43 FACT = 2.0*SQRTF(-ALFOV3)                                         00010043
      Y(1) = FACT*COSF(PHI) - B1OV3                                     00010044
      Y(2) = FACT*COSF(PHI + 2.0943951) - B1OV3                         00010045
      Y(3) = FACT*COSF(PHI + 4.1887902) - B1OV3                         00010046
   50 RETURN                                                            00010047
C     THIS IS THE LAST CARD OF VIETA SUBROUTINE                         00010048
