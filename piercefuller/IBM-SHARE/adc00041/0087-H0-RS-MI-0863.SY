C  VER 1          FORMS INVERSE FROM  KB                                RSM1V101
      SUBROUTINE  VER                                                   RSM1V102
      COMMON M,MA,MB,MC,MD,ME,MF,N,KM,KP,Z,JH,KB,B,P,KL,KN,IK,A,T,X,Y,E RSM1V103
      DIMENSION KM(30),KP(8,2),Z(20),JH(100),KB(300),B(100),P(100),KL(30RSM1V104
     1 0),KN(300),IK(2500),A(2500),T(10),X(100),Y(100),E(100,100)       RSM1V105
C                 INITIATE                                              RSM1V106
      KQ = 0                                                            RSM1V107
      KM(20) = 0                                                        RSM1V108
      Z(9) = 1.                                                         RSM1V109
        DO 01  I = 1,M                                                  RSM1V110
      DO 13  K = 1,M                                                    RSM1V111
   13 E(K,I) = 0.                                                       RSM1V112
      X(I) = B(I)                                                       RSM1V113
   01 E(I,I) = 1.                                                       RSM1V114
        DO 10  I = MF,M                                                 RSM1V115
      IF (JH(I)) 11,12,11                                               RSM1V116
   11 JH(I) = 12345                                                     RSM1V117
      KQ = KQ + 1                                                       RSM1V118
      GO TO 10                                                          RSM1V119
   12 E(MF-1,I) = -1.                                                   RSM1V120
      X(MF-1) = X(MF-1) - X(I)                                          RSM1V121
      KM(20) = KM(20) + 2                                               RSM1V122
   10 CONTINUE                                                          RSM1V123
C                 FORM INVERSE                                          RSM1V124
          DO 02  J = 1,N                                                RSM1V125
      IF (KB(J)) 03,02,03                                               RSM1V126
   03 CALL  JMY(J)                                                      RSM1V127
C                       CHOOSE PIVOT                                    RSM1V128
      T(2) = 0.                                                         RSM1V129
        DO 04  I =MF,M                                                  RSM1V130
      IF (JH(I) - 12345) 04,05,04                                       RSM1V131
   05 IF (ABSF(Y(I)) - T(2)) 04,04,06                                   RSM1V132
   06 IR   = I                                                          RSM1V133
      T(2) = ABSF(Y(I))                                                 RSM1V134
   04   CONTINUE                                                        RSM1V135
C                       TEST PIVOT                                      RSM1V136
      IF (T(2) - Z(1)) 07,08,08                                         RSM1V137
C                       PIVOT                                           RSM1V138
   08 JH(IR) = J                                                        RSM1V139
      KB(J)  = IR                                                       RSM1V140
      KM(20) = KM(20) + KL(J+1) - KL(J)                                 RSM1V141
      Z(9)   = Z(9) * Y(IR)                                             RSM1V142
      CALL  PIV(IR)                                                     RSM1V143
      KQ = KQ - 1                                                       RSM1V144
   02     CONTINUE                                                      RSM1V145
C                       TROUBLE CHECK                                   RSM1V146
      IF (KQ) 09,99,09                                                  RSM1V147
   09 J = 12345                                                         RSM1V148
   07 CALL WOT(6,IR,KN(J))                                              RSM1V149
      PAUSE 200                                                         RSM1V150
   99 RETURN                                                            RSM1V151
C                                                                       RSM1V152
      END (0,1,2,0,0)                                                   RSM1V15C
C   VER 2         FORMS INVERSE FROM JH, KB.  DOUBLE PRECISION EXPLICIT RSM1V201
      SUBROUTINE  VER                                                   RSM1V202
      COMMON M,MA,MB,MC,MD,ME,MF,N,KM,KP,Z,JH,KB,B,P,KL,KN,IK,A,T,X,Y,E RSM1V203
      DIMENSION KM(30),KP(8,2),Z(20),JH(100),KB(300),B(100),P(100),KL(30RSM1V204
     1 0),KN(300),IK(2500),A(2500),T(10),X(100),Y(100),E(100,100)       RSM1V205
C                 INITIATE                                              RSM1V206
      CALL EXTD ( T(10), 0. )                                           RSM1V207
      CALL EXTD( T(1), 1. )                                             RSM1V208
      KQ = 0                                                            RSM1V209
      KM(20) = 0                                                        RSM1V210
      Z(9) = 1.                                                         RSM1V211
        DO 01  I = 1,M                                                  RSM1V212
      DO 13  K = 1,M                                                    RSM1V213
   13 CALL  SETD (E(K,I), T(10) )                                       RSM1V214
      CALL SETD( E(I,I), T(1) )                                         RSM1V215
   01 CALL EXTD( X(I), B(I) )                                           RSM1V216
        DO 10  I = MF,M                                                 RSM1V217
      IF (JH(I)) 11,12,11                                               RSM1V218
   11 JH(I) = 12345                                                     RSM1V219
      KQ = KQ + 1                                                       RSM1V220
      GO TO 10                                                          RSM1V221
   12 CALL EXTD( E(MF-1,I), -1.)                                        RSM1V222
      CALL SUBD(     X(MF-1), X(MF-1), X(I) )                           RSM1V223
      KM(20) = KM(20) + 2                                               RSM1V224
   10 CONTINUE                                                          RSM1V225
C                 FORM INVERSE                                          RSM1V226
          DO 02  J = 1,N                                                RSM1V227
      IF (KB(J)) 03,02,03                                               RSM1V228
   03 CALL  JMY(J)                                                      RSM1V229
C                       CHOOSE PIVOT                                    RSM1V230
      T(2) = 0.                                                         RSM1V231
        DO 04  I =MF,M                                                  RSM1V232
      IF (JH(I) - 12345) 04,05,04                                       RSM1V233
   05 IF (ABSF(Y(I)) - T(2)) 04,04,06                                   RSM1V234
   06 IR   = I                                                          RSM1V235
      T(2) = ABSF(Y(I))                                                 RSM1V236
   04   CONTINUE                                                        RSM1V237
C                       TEST PIVOT                                      RSM1V238
      IF (T(2) - Z(1)) 07,08,08                                         RSM1V239
C                       PIVOT                                           RSM1V240
   08 JH(IR) = J                                                        RSM1V241
      KB(J)  = IR                                                       RSM1V242
      KM(20) = KM(20) + KL(J+1) - KL(J)                                 RSM1V243
      Z(9)   = Z(9) * Y(IR)                                             RSM1V244
      CALL  PIV(IR)                                                     RSM1V245
      KQ = KQ - 1                                                       RSM1V246
   02     CONTINUE                                                      RSM1V247
C                       TROUBLE CHECK                                   RSM1V248
      IF (KQ) 09,99,09                                                  RSM1V249
   09 J = 12345                                                         RSM1V250
   07 CALL WOT(6,IR,KN(J))                                              RSM1V251
      PAUSE 200                                                         RSM1V252
   99 RETURN                                                            RSM1V253
C                                                                       RSM1V254
      END (0,1,2,0,0)                                                   RSM1V25E
C   WOT           MESSAGE WRITER                                        RSM1W101
      SUBROUTINE  WOT (K,AC,AD)                                         RSM1W102
      COMMON M,MA,MB,MC,MD,ME,MF,N,KM,KP,Z,JH,KB,B,P,KL,KN,IK,A,T,X,Y,E RSM1W103
      DIMENSION KM(30),KP(8,2),Z(20),JH(100),KB(300),B(100),P(100),KL(30RSM1W104
     1 0),KN(300),IK(2500),A(2500),T(10),X(100),Y(100),E(100,100)       RSM1W105
C                                                                       RSM1W106
      CALL LFM                                                          RSM1W107
      AA = AC                                                           RSM1W108
      AB = AD                                                           RSM1W109
      GO TO (10,20,30,40,50,60,70,80,90    ) , K                        RSM1W110
   10 PRINT 901, KM(2)                                                  RSM1W111
      IF (KM(21)) 999,999, 11                                           RSM1W112
   11 WRITE OUTPUT TAPE 10, 901, KM(2)                                  RSM1W113
      GO TO 999                                                         RSM1W114
   20 PRINT 902, AA,AB,Z(12),Z(11)                                      RSM1W115
      IF (KM(21)) 999,999, 21                                           RSM1W116
   21 WRITE OUTPUT TAPE 10, 902, AA,AB,Z(12),Z(11)                      RSM1W117
      GO TO 999                                                         RSM1W118
   30 PRINT 903                                                         RSM1W119
      IF (KM(21)) 999,999, 31                                           RSM1W120
   31 WRITE OUTPUT TAPE 10, 903                                         RSM1W121
      GO TO 999                                                         RSM1W122
   40 GO TO 999                                                         RSM1W123
   50 PRINT 905, M, N, KM(18)                                           RSM1W124
      IF (KM(21)) 999,999, 51                                           RSM1W125
   51 WRITE OUTPUT TAPE 10, 905, M, N, KM(18)                           RSM1W126
      GO TO 999                                                         RSM1W127
   60 PRINT 906, AA,AB, T(2)                                            RSM1W128
      IF (KM(21)) 999,999, 61                                           RSM1W129
   61 WRITE OUTPUT TAPE 10, 906, AA, AB, T(2)                           RSM1W130
      GO TO 999                                                         RSM1W131
   70 PRINT 907, AA, AB                                                 RSM1W132
   80 CONTINUE                                                          RSM1W133
   90 CONTINUE                                                          RSM1W134
  999 RETURN                                                            RSM1W135
C                                                                       RSM1W136
  901 FORMAT(6H ITER.I5,13H. SET Z(4)=0. )                              RSM1W137
  902 FORMAT(14H0MAX ERROR ON A3,I4,1H,E12.5,6H. SUM, E12.5)            RSM1W138
  903 FORMAT(//8H0CLEARED/1H1)                                          RSM1W139
  905 FORMAT(4H0M =I4,5H, N =I4,16H. MATRIX ENTRIESI6)                  RSM1W140
  906 FORMAT(24H0INVERSION TROUBLE. IR =I4,8H, COL = A6,7H, PIV =E10.2 )RSM1W141
  907 FORMAT(3H0B(I3,3H) =F15.6,22H . NEW CONTROL WANTED. / 1H1  )      RSM1W142
      END (0,1,2,0,0)                                                   RSM1W14C
RSM1Y1 REM   43 03230                         Y PROGRAM CARD            RSM1Y101
       OCT 40                                                           RSM1Y102
       DEC 0                                                            RSM1Y103
       BCD 1EFM                                                         RSM1Y104
       DEC 2                                                            RSM1Y105
       BCD 1LFM                                                         RSM1Y106
       DEC 0                                                            RSM1Y107
       END                                                              RSM1Y108
       REM                             FLOATING TRAP PROGRAM            RSM1Y109
       ORG 0                                                            RSM1Y110
 LFM   LFM                                                              RSM1Y111
       TTR 1,4                                                          RSM1Y112
 EFM   EFM                                                              RSM1Y113
       CLA X                                                            RSM1Y114
       STO 8                                                            RSM1Y115
       TTR 1,4                                                          RSM1Y116
 X     TTR ANALY                                                        RSM1Y117
 ANALY SXD SAVEX,1                                                      RSM1Y118
       LXD 0,1                                                          RSM1Y119
       TTR *+14,1                                                       RSM1Y120
       TTR OVER                                                         RSM1Y121
 SAVEX PZE                                                              RSM1Y122
       TTR ACMQ                                                         RSM1Y123
       TTR AC                                                           RSM1Y124
       TTR MQ                                                           RSM1Y125
 ZERO  PZE                                                              RSM1Y126
       TTR OVER                                                         RSM1Y127
 OVER  TTR DSPLY                                                        RSM1Y128
 AC    CLA ZERO                                                         RSM1Y129
       TTR RETRN                                                        RSM1Y130
 ACMQ  CLA ZERO                                                         RSM1Y131
       TTR MQ                                                           RSM1Y132
 MQ    LDQ ZERO                                                         RSM1Y133
 RETRN LXD SAVEX,1                                                      RSM1Y134
       STO SAVEX                                                        RSM1Y135
       CLA 0                                                            RSM1Y136
       STA *+2                                                          RSM1Y137
       CLA SAVEX                                                        RSM1Y138
       TTR **                                                           RSM1Y139
 DSPLY CLA 0                                                            RSM1Y140
       HPR 32767                                                        RSM1Y141
       TRA 1,4                                                          RSM1Y142
     R END                                                              RSM1Y14C
