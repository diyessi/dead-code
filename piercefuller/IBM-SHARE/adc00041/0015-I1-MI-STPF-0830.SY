       REM FORTRAN II SUBPROGRAM FOR SYMBOL TABLE PRINT'OUT       (STPF)MISPF001
       REM JANUARY 8, 1959                                              MISPF002
       REM SUBROUTINE (STPF)                                            MISPF003
       ORG 0                                                            MISPF004
       REM PROGRAM CARD                                                 MISPF005
       PZE LAST-FIRST                                                   MISPF006
       PZE                                                              MISPF007
       BCD 1(STPF)                                                      MISPF008
       PZE EXIT                                                         MISPF009
       REM                                                              MISPF010
       ORG 0                                                            MISPF011
       REL                                                              MISPF012
OUTPUT EQU 2                                                            MISPF013
START  TXI *+1,2,-214        ENTERS WITH IR2 = 214+S.T. LENGTH          MISPF014
FIRST  SYN START                                                        MISPF015
       SXD FULST,2                                                      MISPF016
       TSX WOT,4             WRITE HEADING                              MISPF017
           HEAD,,HEAD+9                                                 MISPF018
       TSX WOT,4                                                        MISPF019
           BLANKS,,BLANKS                                               MISPF020
       LXD TWO,2                                                        MISPF021
SRCH   CAL STBL+1,2          PICK UP NAME , T.V., ORT.V. INDICATOR.     MISPF022
       TNZ TSTTV                                                        MISPF023
       CAL MAIN              ZERO INDICATES MAIN PROGRAM                MISPF024
       REM TEMPORARY BLOCK TO SET UP CORRECT TRANSFER IN BSS2           MISPF025
BEGIN  CAL TRANS                                                        MISPF026
       SLW 1CARD                                                        MISPF027
       TRA RDCRD                                                        MISPF028
TRANS  TTR START                                                        MISPF029
1CARD  EQU 19                                                           MISPF030
RDCRD  EQU 15                                                           MISPF031
       TCD BEGIN                                                        MISPF032
       ORG BEGIN                                                        MISPF033
       SLW NAME                                                         MISPF034
TWO    TXI CADR,,2                                                      MISPF035
 TSTTV CLA STBL+1,2                                                     MISPF036
       SUB TXL                                                          MISPF037
       TZE ORG                                                          MISPF038
       CAL STBL+1,2                                                     MISPF039
       ANA TXL                                                          MISPF040
       TNZ SUBPR                                                        MISPF041
 ORG   LDQ STBL+2,2                                                     MISPF042
       TSX CNVRT,4                                                      MISPF043
       SLW NUM2                                                         MISPF044
       TRA FULST-1                                                      MISPF045
SUBPR  CAL STBL+1,2          ADDRESS NON-ZERO,THUS BCD NAME             MISPF046
       SLW NAME                                                         MISPF047
CADR   LDQ STBL+2,2          GET ENTRY POINT                            MISPF048
       TSX CNVRT,4           ENTRY POINT IN MQ FOR OCTAL CONVERSION     MISPF049
       SLW NUMBR                                                        MISPF050
       TSX WOT,4                                                        MISPF051
       PZE PHEAD,,FIN                                                   MISPF052
       TXI *+1,2,2                                                      MISPF053
FULST  TXL SRCH,2,**         DECR.= LENGTH OF S.T.                      MISPF054
       TXI *+1,2,212         IR2= 214+ S.T. LENGTH                      MISPF055
P      STZ 0,2                                                          MISPF056
       TIX *-1,2,1           CLEARS FROM END OF S.T. TO TOP OF CORE     MISPF057
       WEF 2                                                            MISPF058
OUT    TRA TOV                                                          MISPF059
TOV    EQU 21                                                           MISPF060
CNVRT  RQL 21                                                           MISPF061
FIVE   PXD 5,0                                                          MISPF062
       LXA FIVE,1                                                       MISPF063
MOVE   ALS 3                                                            MISPF064
       LGL 3                                                            MISPF065
       TIX MOVE,1,1                                                     MISPF066
       ORA BLANK                                                        MISPF067
EXIT   TRA 1,4                                                          MISPF068
 WOT   WTD OUTPUT                                                       MISPF069
       CLA 1,4                                                          MISPF070
       SXD X1,1                                                         MISPF071
       STA A                                                            MISPF072
       ARS 18                                                           MISPF073
       ADD X1                                                           MISPF074
       STA CPYL                                                         MISPF075
       SUB A                                                            MISPF076
       PAX 0,1                                                          MISPF077
CPYL   CPY **,1                                                         MISPF078
       TIX *-1,1,1                                                      MISPF079
       IOD                                                              MISPF080
       LXD X1,1                                                         MISPF081
       TRA 2,4                                                          MISPF082
       REM CONSTANTS AND PRINT'OUT                                      MISPF083
X1     PZE 1                                                            MISPF084
A                                                                       MISPF085
 TXL   TXL                                                              MISPF086
STBL   EQU 32554             TOP OF THE SYMBOL TABLE                    MISPF087
ADMSK      -1                                                           MISPF088
BLANKS BCD 1                                                            MISPF089
BLANK  BCD 1 00000                                                      MISPF090
 PHEAD BCD 7             PROGRAM BEGINS AT       OCTAL                  MISPF091
 PRNT  BCD 6,      ENTRY POINT IS AT       OCTAL                        MISPF092
 NAME  SYN PHEAD+1                                                      MISPF093
 NUMBR SYN PRNT+4                                                       MISPF094
 FIN   SYN PRNT+5                                                       MISPF095
NUM2   SYN PHEAD+5                                                      MISPF096
HEAD   BCD                      FORTRAN II PROGRAM SYMBOL TABLE         MISPF097
MAIN   BCD 1(MAIN)                                                      MISPF098
 LAST  SYN *                                                            MISPF099
