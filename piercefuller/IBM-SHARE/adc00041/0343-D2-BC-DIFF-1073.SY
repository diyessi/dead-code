BCDIFF REM 288  12070                                                   DIFF 001
DIFF   IDC                                                              DIFF 002
       ORG 0                                                            DIFF 003
       MZE LAST                                                         DIFF 004
       PZE COMMON-2                                                     DIFF 005
       BCD 1DIFF1                                                       DIFF 006
       PZE DIFF1                                                        DIFF 007
       BCD 1DIFF2                                                       DIFF 008
       PZE DIFF2                                                        DIFF 009
       BCD 1DIFINT                                                      DIFF 010
       PZE DIFINT                                                       DIFF 011
       REL                                                              DIFF 012
       ORG 0                                                            DIFF 013
 DIFF1 SXD XR,4              SET ADDRESSES                              DIFF 014
       CLA 1,4               L(Y)                                       DIFF 015
       STA YA                                                           DIFF 016
       STA YH                                                           DIFF 017
       ADD A1                L(Y)+1                                     DIFF 018
     P STA YB                                                           DIFF 019
       STA YC                                                           DIFF 020
       STA YD                                                           DIFF 021
       STA YE                                                           DIFF 022
       STA YF                                                           DIFF 023
     Q STA YG                                                           DIFF 024
       STA YI                                                           DIFF 025
       CLA 2,4               L(Z)+1                                     DIFF 026
       ADD A1                                                           DIFF 027
       STA ZA                                                           DIFF 028
       STA ZB                                                           DIFF 029
     R STA ZC                                                           DIFF 030
       STA ZD                                                           DIFF 031
       STA ZE                                                           DIFF 032
       STA ZF                                                           DIFF 033
       STA ZG                                                           DIFF 034
       STA ZH                                                           DIFF 035
     S CLA 3,4               L(F0)+1                                    DIFF 036
       ADD A1                                                           DIFF 037
       STA F0A                                                          DIFF 038
       STA F0B                                                          DIFF 039
       CLA 4,4               L(F1)                                      DIFF 040
       STA F1A                                                          DIFF 041
     U STA F1C                                                          DIFF 042
       ADD A1                L(F1)+1                                    DIFF 043
       STA F1B                                                          DIFF 044
       STA F1D                                                          DIFF 045
       STA F1E                                                          DIFF 046
       CLA 5,4               L(F2)                                      DIFF 047
     V STA F2A                                                          DIFF 048
       STA F2F                                                          DIFF 049
       ADD A1                L(F2)+1                                    DIFF 050
       STA F2B                                                          DIFF 051
       STA F2C                                                          DIFF 052
     W STA F2D                                                          DIFF 053
       STA F2E                                                          DIFF 054
       STA F2G                                                          DIFF 055
       STA F2H                                                          DIFF 056
       CLA 6,4               L(Y1)                                      DIFF 057
       STA Y1B                                                          DIFF 058
     X STA Y1D                                                          DIFF 059
       ADD A1                L(Y1)+1                                    DIFF 060
       STA Y1A                                                          DIFF 061
       STA Y1C                                                          DIFF 062
       CLA 7,4               L(T)                                       DIFF 063
    AA STA TA                                                           DIFF 064
       STA TB                                                           DIFF 065
       STA TC                                                           DIFF 066
       STA TD                                                           DIFF 067
       STA TE                                                           DIFF 068
    BB STA TF                                                           DIFF 069
       STA TG                                                           DIFF 070
       STA TH                                                           DIFF 071
       CLA 8,4               L(H)                                       DIFF 072
       STA *+1                                                          DIFF 073
    CC CLA **                                                           DIFF 074
       STO H                                                            DIFF 075
       CLA 9,4               L(N)                                       DIFF 076
       STA *+1                                                          DIFF 077
       CLA **                                                           DIFF 078
    DD STO N                                                            DIFF 079
       CLA 10,4              L(KSTEP)                                   DIFF 080
       STA KA                                                           DIFF 081
       STA KB                                                           DIFF 082
       STA KC                                                           DIFF 083
    EE CLA 11,4              L(FOTY)                                    DIFF 084
       STA FA                                                           DIFF 085
       STA FB                                                           DIFF 086
       STA FC                                                           DIFF 087
       STA FD                                                           DIFF 088
       LDQ H                 CONSTANT MULTIPLIERS                       DIFF 089
       FMP H                                                            DIFF 090
       FDP F3                                                           DIFF 091
       STQ C1                H**2/3                                     DIFF 092
       FMP F4                                                           DIFF 093
    FF STO C2                4.*H**2/3.                                 DIFF 094
       FDP F8                                                           DIFF 095
       STQ C3                H**2/6                                     DIFF 096
       FMP F3                                                           DIFF 097
       STO C4                H**2/2                                     DIFF 098
       CLA TR12                                                         DIFF 099
       STO KC+2              SET EXIT TO TRA 12,4                       DIFF 100
    KA CLA **                KSTEP .GR. 0                               DIFF 101
       TNZ FSTEP             THEN SKIP BACK STEP                        DIFF 102
    FA TSX **,4              COMPUTE F(0)                               DIFF 103
    TA PZE **                                                           DIFF 104
    YA PZE **                                                           DIFF 105
   F2A PZE **                                                           DIFF 106
       PZE N                                                            DIFF 107
       LXD N,4               Y1(I)=C4*F2(I)+Y(I)-H*Z(I),I=1,N           DIFF 108
    L1 LDQ H                                                            DIFF 109
    ZA FMP **,4                                                         DIFF 110
       STO COMMON            Z(I)*H                                     DIFF 111
       LDQ C4                                                           DIFF 112
   F2B FMP **,4                                                         DIFF 113
    YB FAD **,4                                                         DIFF 114
       FSB COMMON                                                       DIFF 115
   Y1A STO **,4                                                         DIFF 116
       TIX L1,4,1                                                       DIFF 117
    TB CLA **                                                           DIFF 118
       FSB H                                                            DIFF 119
       STO TM                                                           DIFF 120
    FB TSX **,4              COMPUTE F(-1)                              DIFF 121
       PZE TM                                                           DIFF 122
   Y1B PZE **                                                           DIFF 123
   F1A PZE **                                                           DIFF 124
       PZE N                                                            DIFF 125
 FSTEP LXD N,4               Y1 LOOP, FIRST FORWARD STEP                DIFF 126
    L2 LDQ H                                                            DIFF 127
    ZB FMP **,4                                                         DIFF 128
       STO COMMON            H*Z(I)                                     DIFF 129
   F2C LDQ **,4                                                         DIFF 130
   F0A STQ **,4              F0(I)=F2(I)                                DIFF 131
       FMP C1                                                           DIFF 132
   F2D STO **,4              F2(I)=C1*F2(I)                             DIFF 133
       FAD COMMON                                                       DIFF 134
    ZC STO **,4              Z(I)=F2(I)+H*Z(I)                          DIFF 135
    YC FAD **,4                                                         DIFF 136
    YD STO **,4              Y(I)=Y(I)+Z(I)                             DIFF 137
       LDQ C3                                                           DIFF 138
   F1B FMP **,4                                                         DIFF 139
       CHS                                                              DIFF 140
   F2E FAD **,4                                                         DIFF 141
    YE FAD **,4                                                         DIFF 142
   Y1C STO **,4              Y1(I)=Y(I)-C3*F1(I)+F2(I)                  DIFF 143
       TIX L2,4,1                                                       DIFF 144
       CLA H                                                            DIFF 145
    TC FAD **                                                           DIFF 146
    TD STO **                T=T+H                                      DIFF 147
    FC TSX **,4              COMPUTE F(1)                               DIFF 148
    TE PZE **                                                           DIFF 149
   Y1D PZE **                                                           DIFF 150
   F1C PZE **                                                           DIFF 151
       PZE N                                                            DIFF 152
       LXD N,4               Y2 LOOP, SECOND STEP FORWARD               DIFF 153
    L3 LDQ C2                                                           DIFF 154
   F1D FMP **,4                                                         DIFF 155
    ZD FAD **,4                                                         DIFF 156
    ZE STO **,4              Z=Z+C2*F1(I)                               DIFF 157
    YF FAD **,4                                                         DIFF 158
    YG STO **,4              Y(I)=Y(I)+Z(I)                             DIFF 159
       TIX L3,4,1                                                       DIFF 160
       CLA H                                                            DIFF 161
    TF FAD **                                                           DIFF 162
    TG STO **                T=T+H                                      DIFF 163
    FD TSX **,4              COMPUTE F(2)                               DIFF 164
    TH PZE **                                                           DIFF 165
    YH PZE **                                                           DIFF 166
   F2F PZE **                                                           DIFF 167
       PZE N                                                            DIFF 168
       LXD N,4               Z2 LOOP                                    DIFF 169
    L4 LDQ C1                                                           DIFF 170
   F2G FMP **,4                                                         DIFF 171
    ZF FAD **,4                                                         DIFF 172
       FDP H                                                            DIFF 173
    ZG STQ **,4              Z(I)=(Z(I)+C1*F2(I))/H                     DIFF 174
       TIX L4,4,1                                                       DIFF 175
       PXD 0,4                                                          DIFF 176
    KB ADD **                                                           DIFF 177
    KC STO **                KSTEP=KSTEP+1                              DIFF 178
       LXD XR,4                                                         DIFF 179
       TRA 12,4                                                         DIFF 180
    A1 DEC 1                                                            DIFF 181
  DEC4 DEC 4B18                                                         DIFF 182
  DEC5 DEC 5B18                                                         DIFF 183
   FL2 DEC 2.0                                                          DIFF 184
    F3 DEC 3.0                                                          DIFF 185
    F4 DEC 4.0                                                          DIFF 186
    F8 DEC 8.0                                                          DIFF 187
     N PZE                                                              DIFF 188
    XR PZE                                                              DIFF 189
     H PZE                                                              DIFF 190
    C1 PZE                                                              DIFF 191
    C2 PZE                                                              DIFF 192
    C3 PZE                                                              DIFF 193
    C4 PZE                                                              DIFF 194
  TRA1 TRA 1,4               TRANSFER CONSTANTS                         DIFF 195
  TR12 TRA 12,4                                                         DIFF 196
 DIFF2 SXD XR,4                                                         DIFF 197
       CLA TRA1              SET EXIT TO TRA 1,4                        DIFF 198
       STO KC+2                                                         DIFF 199
       TRA FSTEP                                                        DIFF 200
       REM INTERPOLATION COEF ROUTINE  CALL DIFINT(V,W.                 DIFF 201
       REM V HAS DIMENSION 5 BY, AND W 4 BY, AT LEAST N                 DIFF 202
DIFINT SXD COMMON,4                                                     DIFF 203
       SXD COMMON-1,2                                                   DIFF 204
       SXD XR,1                                                         DIFF 205
       CLA 1,4               L(V(1,1))                                  DIFF 206
       ADD A1                                                           DIFF 207
       STA V5                +1                                         DIFF 208
       ADD A1                                                           DIFF 209
       STA V4                +2                                         DIFF 210
       ADD A1                                                           DIFF 211
       STA V3                +3                                         DIFF 212
       ADD A1                                                           DIFF 213
       STA V2                +4                                         DIFF 214
       ADD A1                                                           DIFF 215
       STA V1                +5                                         DIFF 216
       CLA 2,4               L(W(1,1))                                  DIFF 217
       ADD A1                                                           DIFF 218
       STA W4                +1                                         DIFF 219
       ADD A1                                                           DIFF 220
       STA W3                +2                                         DIFF 221
       ADD A1                                                           DIFF 222
       STA W2                +3                                         DIFF 223
       ADD A1                                                           DIFF 224
       STA W1                +4                                         DIFF 225
       LDQ N                                                            DIFF 226
       MPY DEC4                                                         DIFF 227
       PAX 0,1                                                          DIFF 228
       LXD N,4               C(XR4)=N                                   DIFF 229
       LDQ N                                                            DIFF 230
       MPY DEC5                                                         DIFF 231
       PAX 0,2               C(XR2)=5*N                                 DIFF 232
       CLS H                                                            DIFF 233
       FSB H                                                            DIFF 234
       STO COMMON+1          A=-2*H                                     DIFF 235
    YI CLA **,4                                                         DIFF 236
    V1 STO **,2              V1=Y2                                      DIFF 237
    ZH LDQ **,4                                                         DIFF 238
    W1 STQ **,1              W1=Z2                                      DIFF 239
       FMP COMMON+1                                                     DIFF 240
    V2 STO **,2              V2=-2*H*Z2                                 DIFF 241
   F2H LDQ **,4                                                         DIFF 242
       FMP COMMON+1                                                     DIFF 243
    W2 STO **,1              W2=-2*H*F2                                 DIFF 244
       CHS                                                              DIFF 245
       STO COMMON+2          B=2*H*F2                                   DIFF 246
       LDQ COMMON+2                                                     DIFF 247
       FMP H                                                            DIFF 248
    V3 STO **,2              V3=2*H**2*F2                               DIFF 249
   F1E LDQ **,4                                                         DIFF 250
       FMP COMMON+1                                                     DIFF 251
       STO COMMON+3          C=-2*H*F1                                  DIFF 252
   F0B LDQ **,4                                                         DIFF 253
       FMP H                                                            DIFF 254
       FAD COMMON+3                                                     DIFF 255
       STO COMMON+4          D=H*(F0-2*F1)                              DIFF 256
       LDQ COMMON+2                                                     DIFF 257
       FMP FL1P5             3*H*F2                                     DIFF 258
       FAD COMMON+3                                                     DIFF 259
       FAD COMMON+4                                                     DIFF 260
    W3 STO **,1              W3=H*(F0-4F1+3F2)                          DIFF 261
       FDP FL1P5                                                        DIFF 262
       FMP H                                                            DIFF 263
       CHS                                                              DIFF 264
    V4 STO **,2              V4=2/3*H**2(-F0+4F1-3F2)                   DIFF 265
       LDQ COMMON+4                                                     DIFF 266
       FMP FL2                                                          DIFF 267
       FAD COMMON+2                                                     DIFF 268
       CHS                                                              DIFF 269
       FDP FL1P5                                                        DIFF 270
    W4 STQ **,1              W4=4/3*H*(-F0+2*F1-F2)                     DIFF 271
       FMP H                                                            DIFF 272
       CHS                                                              DIFF 273
       FDP FL2                                                          DIFF 274
    V5 STQ **,2              V5=2/3*H**2*(F0-2*F1+F2)                   DIFF 275
       TXI *+1,2,-5          DECREMENT XR2 BY 5                         DIFF 276
       TXI *+1,1,-4          DECREMENT XR1 BY 4                         DIFF 277
       TIX LP5,4,1           END LOOP, DEC XR4 BY 1                     DIFF 278
       LXD COMMON,4                                                     DIFF 279
       LXD COMMON-1,2                                                   DIFF 280
       LXD XR,1                                                         DIFF 281
       TRA 3,4                                                          DIFF 282
 FL1P5 DEC 1.5                                                          DIFF 283
COMMON SYN =77770                                                       DIFF 284
    TM SYN COMMON+1                                                     DIFF 285
   LP5 SYN YI                                                           DIFF 286
  LAST SYN FL1P5+1                                                      DIFF 287
       END 0                                                            DIFF 288
