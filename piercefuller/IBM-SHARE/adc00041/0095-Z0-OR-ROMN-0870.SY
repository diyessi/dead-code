ORROMN REM  110 02010                                                   ROMN0001
       FUL                                                              ROMN0002
       MZE 0,0,4                  FORTRAN II PROGRAM CARD               ROMN0003
       PZE                                                              ROMN0004
       PZE TEMP+2                                                       ROMN0005
       PZE                                                              ROMN0006
       BCD 1ROMN                                                        ROMN0007
       PZE ROMN                                                         ROMN0008
       REL                                                              ROMN0010
       ORG 0                                                            ROMN0011
       HTR **                     XR STORAGE                            ROMN0012
       HTR **                                                           ROMN0013
       HTR **                                                           ROMN0014
 ROMN  SXD ROMN-1,1               ENTER, SAVE XR CONTENTS AND SET       ROMN0015
       SXD ROMN-2,2               ADDRESSES OF I=INTEGER TO             ROMN0016
       SXD ROMN-3,4               CONVERT AND OF FMT=ARRAY              ROMN0017
       CLA 1,4                    WHERE ROMAN NUMERAL IS TO BE          ROMN0018
       STA TEST                   STORED FOR OUTPUT.                    ROMN0019
       CLA 2,4                                                          ROMN0020
       STA FMT                                                          ROMN0021
 TEST  CLA **                     TEST FOR I LESS THAN 1 OR             ROMN0022
       TMI ERROR                  GREATER THAN 3999.  IF SO, GO TO      ROMN0023
       TZE ERROR                  ERROR ROUTINE.                        ROMN0024
       ARS 18                                                           ROMN0025
       STO TEMP                                                         ROMN0026
       SUB FIVE+2                                                       ROMN0027
       TPL ERROR                                                        ROMN0028
       STZ TEMP+1                                                       ROMN0029
       LXD STAR,1                                                       ROMN0030
 CONV  PXD ,0                     CONVERT I  FROM BINARY TO             ROMN0031
       TXH HOLL-2,1,4             BIQUINARY.                            ROMN0032
       LDQ TEMP                                                         ROMN0033
       DVH FIVE+1                                                       ROMN0034
       STQ TEMP                                                         ROMN0035
       LDQ TEMP+1                                                       ROMN0036
       LRS 3                                                            ROMN0037
       CLA TEMP                                                         ROMN0038
       LRS 1                                                            ROMN0039
       STO TEMP                                                         ROMN0040
       STQ TEMP+1                                                       ROMN0041
       TXI CONV,1,1                                                     ROMN0042
       PDX ,7                     CONTROL REACHES HERE WITH THE         ROMN0043
       SXD LDFV+1,4               BIQUINARY NUMBER IN MQ AND            ROMN0044
 HOLL  TXH OUT,2,3                ZERO IN AC.  THE ROMAN                ROMN0045
       RQL 1                      SYMBOLS ARE SELECTED, PACKED          ROMN0046
       TQP IV                     LEFT, AND STORED IN FMT.              ROMN0047
       RQL 1                                                            ROMN0048
       TQP V                                                            ROMN0049
       TSX LDON,4                 GO GET C, X, OR I FOLLOWED            ROMN0050
       TXI *+1,2,-1               BY M, C, OR X.                        ROMN0051
       TSX LDON,4                                                       ROMN0052
       RQL 2                                                            ROMN0053
       TXI HOLL,2,2                                                     ROMN0054
 IV    RQL 1                                                            ROMN0055
       TQP V+1                                                          ROMN0056
       TSX LDON,4                 GO GET C, X OR I FOLLOWED             ROMN0057
       TSX LDFV,4                 BY D, L, OR V.                        ROMN0058
       RQL 2                                                            ROMN0059
       TXI HOLL,2,1                                                     ROMN0060
 V     TSX LDFV,4                 GO GET D, L, OR V.                    ROMN0061
       RQL 1                                                            ROMN0062
       TQP I                                                            ROMN0063
       TSX LDON,4                 GO GET 0, 1, 2, OR 3 EACH             ROMN0064
       TSX LDON,4                 OF M, C, X, OR I.                     ROMN0065
 I     RQL 1                                                            ROMN0066
       TQP *+2                                                          ROMN0067
       TSX LDON,4                                                       ROMN0068
       TXI HOLL,2,1                                                     ROMN0069
 LDFV  ACL FIVE,2                                                       ROMN0070
       TXI *+2,0,0                DECREMENT USED TO STORE XR            ROMN0071
 LDON  ACL ONE,2                  CONTROLLING FMT STORAGE.              ROMN0072
       TXI *+1,1,1                                                      ROMN0073
       TXH *+3,1,5                                                      ROMN0074
       ALS 6                                                            ROMN0075
       TRA 1,4                                                          ROMN0076
       SXD TEMP,4                 CONTROL HERE WHEN AC IS FULL.         ROMN0077
       LXD LDFV+1,4                                                     ROMN0078
 FMT   SLW **,4                   STORE BCD ROMAN NUMERAL IN FMT.       ROMN0079
       TXI *+1,4,1                                                      ROMN0080
       SXD LDFV+1,4                                                     ROMN0081
       LXD TEMP,4                                                       ROMN0082
       PXD ,0                                                           ROMN0083
       PDX ,1                                                           ROMN0084
       TRA 1,4                                                          ROMN0085
 OUT   ACL FIVE                   FILL OUT FMT WITH BLANKS.             ROMN0086
       TSX LDON+1,4                                                     ROMN0087
       TNZ *-2                                                          ROMN0088
       LXD LDFV+1,4                                                     ROMN0089
       TXL OUT,4,2                                                      ROMN0090
       LXD ROMN-1,1               CONTROL HERE WHEN OUTPUT IS           ROMN0091
       LXD ROMN-2,2               COMPLETE.                             ROMN0092
       LXD ROMN-3,4                                                     ROMN0093
       TRA 3,4                                                          ROMN0094
 ERROR LXD ONE,4                  IF I IS OUT OF RANGE, OUTPUT          ROMN0095
       SXD LDFV+1,4               IS ALL BLANKS.                        ROMN0096
       TSX OUT-3,4                                                      ROMN0097
       TRA OUT                                                          ROMN0098
       BCD 100000I                                                      ROMN0099
       BCD 100000X                                                      ROMN0100
       BCD 100000C                                                      ROMN0101
 ONE   BCD 100000M                                                      ROMN0102
       BCD 100000V                                                      ROMN0103
       BCD 100000L                                                      ROMN0104
       BCD 100000D                                                      ROMN0105
 FIVE  BCD 100000                                                       ROMN0106
       DEC 5                                                            ROMN0107
       DEC 4000                                                         ROMN0108
 STAR  OCT 000001000000                                                 ROMN0109
 TEMP  BSS 2                                                            ROMN0110
