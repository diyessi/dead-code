       REM SUBROUTINE CALC. ELLIPTIC INTEGRAL K(K)                      ELFK0001
       REM REF HASTINGS APPX FOR DIG. COMPSOP.172                       ELFK0002
       REM TSX ELFK,4         KSQ  IN ACC. K=0 TO/NOT=1                 ELFK0003
       REM ERROR RETURN K EXCEEDS LIM                                   ELFK0004
       REM NORMAL RETURN K(K) IN ACC.                                   ELFK0005
       REM NEED NATURAL LOG ROUTINE                                     ELFK0006
 ELFK  SXD COMMON+3,4         SAVEC(INDX)4                              ELFK0007
       SXD COMMON+4,1         SAVEC(INDX)1                              ELFK0008
       CHS                                                              ELFK0009
       FAD ELFK+48            1-KSQ                                     ELFK0010
       STO COMMON+5           ETA=1-KSQ                                 ELFK0011
       CLA ELFK+48                                                      ELFK0012
       FDP COMMON+5           1/ETA                                     ELFK0013
       FMP ELFK+48                                                      ELFK0014
       TSX S820LN,4           LN(1/ETA)                                 ELFK0015
       TRA ELFK+53                                                      ELFK0016
       STO COMMON+6                                                     ELFK0017
       CLA ELFK+38                                                      ELFK0018
       STO ELFK+51            SUM1 1ST TERM                             ELFK0019
       CLA ELFK+43                                                      ELFK0020
       STO ELFK+52            SUM2 1ST TERM                             ELFK0021
       CLA ELFK+48                                                      ELFK0022
       STO COMMON+7           INITIALIZE                                ELFK0023
       LXD ELFK+49,1                                                    ELFK0024
       LDQ COMMON+7                                                     ELFK0025
       FMP COMMON+5           ETA TO POWER                              ELFK0026
       STO COMMON+7                                                     ELFK0027
       LDQ COMMON+7                                                     ELFK0028
       FMP ELFK+43,1          ETA*A COEFF                               ELFK0029
       FAD ELFK+51                                                      ELFK0030
       STO ELFK+51            SUM UP                                    ELFK0031
       LDQ COMMON+7                                                     ELFK0032
       FMP ELFK+48,1          ETA*B COEFF                               ELFK0033
       FAD ELFK+52                                                      ELFK0034
       STO ELFK+52            SUM UP                                    ELFK0035
       TIX ELFK+18,1,1                                                  ELFK0036
       LDQ ELFK+52                                                      ELFK0037
       FMP COMMON+6           BSUM*LN(1/ETA)                            ELFK0038
       FAD ELFK+51            + ASUM TO 10 CUBED                        ELFK0039
       FDP ELFK+50                                                      ELFK0040
       FMP ELFK+48            K(K) TO ACC.                              ELFK0041
       LXD COMMON+3,4                                                   ELFK0042
       LXD COMMON+4,1                                                   ELFK0043
       TRA 2,4                EXIT                                      ELFK0044
       REM ELLIPTIC INTEGRAL COEFFS                                     ELFK0045
       DEC 1386.29436112                                                ELFK0046
       DEC 96.66344259                                                  ELFK0047
       DEC 35.90092383                                                  ELFK0048
       DEC 37.42563713                                                  ELFK0049
       DEC 14.51196212                                                  ELFK0050
       DEC 500.                                                         ELFK0051
       DEC 124.98593597                                                 ELFK0052
       DEC 68.80248576                                                  ELFK0053
       DEC 33.28355346                                                  ELFK0054
       DEC 4.41787012                                                   ELFK0055
       DEC 1.                                                           ELFK0056
       PZE 4,0,4                                                        ELFK0057
       DEC 1000.                                                        ELFK0058
       PZE                                                              ELFK0059
       PZE                                                              ELFK0060
       LXD COMMON+3,4                                                   ELFK0061
       TRA 1,4                                                          ELFK0062
       REM END ELLIPTIC SUBRT                                           ELFK0063
