       CLA     PRBF+26,1    X                                           MMIP0604
       STO     PRBF+25,1    X                                           MMIP0605
       STZ     PRBF+26,1    X                                           MMIP0606
       TIX     *-3,1,2       X                                          MMIP0607
       CLS     CP11          THROW SWITCH                               MMIP0608
       STO     CP11          X                                          MMIP0609
 CP13  TIX     CP1,2,1       IS COMMENT DONE                            MMIP0610
       TCOA    *             WAIT AND WRITE                             MMIP0611
       WPDA                  X                                          MMIP0612
       RCHA    CP14          X                                          MMIP0613
 CP16  AXT     0,1          RESTORE XRS                                 MMIP0614
