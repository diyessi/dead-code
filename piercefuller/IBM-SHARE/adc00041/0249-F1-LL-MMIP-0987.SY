C     MASTER PROGRAM FOR LL MMIP                                        MMIP0001
C        MATRIX ABSTRACTION                                             MMIP0002
      DIMENSION AC(50,50),MQ(50,50)                                     MMIP0003
      DIMENSION V(50,50),W(50,50),X(50,50),Y(50,50),Z(50,50)            MMIP0004
      IF (SENSE SWITCH 2) 15, 10                                        MMIP0005
 10   END FILE 12                                                       MMIP0006
C     DETERMINE CODE                                                    MMIP0007
 15   CALL CARD (INDXA,INDXB)                                           MMIP0008
      GO TO (101,102,103,104,105,106,107,108,109,110,111,112,113,114,115MMIP0009
     1,116,117,118),INDXA                                               MMIP0010
C     AND EXECUTE THE CODE                                              MMIP0011
C     CLA, CLEAR AND ADD                                                MMIP0012
 101  GO TO (1011,1012,1013,1014,1015,1016,1017),INDXB                  MMIP0013
 1011 GO TO 15                                                          MMIP0014
 1012 CALL SHIFT(MQ,IMQ,JMQ,AC,IAC,JAC)                                 MMIP0015
      GO TO 15                                                          MMIP0016
 1013 CALL SHIFT(W,IW,JW,AC,IAC,JAC)                                    MMIP0017
      GO TO 15                                                          MMIP0018
 1014 CALL SHIFT(X,IX,JX,AC,IAC,JAC)                                    MMIP0019
      GO TO 15                                                          MMIP0020
 1015 CALL SHIFT(Y,IY,JY,AC,IAC,JAC)                                    MMIP0021
      GO TO 15                                                          MMIP0022
 1016 CALL SHIFT(Z,IZ,JZ,AC,IAC,JAC)                                    MMIP0023
      GO TO 15                                                          MMIP0024
 1017 GO TO 15                                                          MMIP0025
C     ADD, ADD TO ABSTRACT ACCUMULATOR                                  MMIP0026
 102  GO TO (1021,1022,1023,1024,1025,1026,1027),INDXB                  MMIP0027
 1021 CALL MAADD (AC,IAC,JAC,AC,IAC,JAC)                                MMIP0028
      GO TO 15                                                          MMIP0029
 1022 CALL MAADD (AC,IAC,JAC,MQ,IMQ,JMQ)                                MMIP0030
      GO TO 15                                                          MMIP0031
 1023 CALL MAADD (AC,IAC,JAC,W,IW,JW)                                   MMIP0032
      GO TO 15                                                          MMIP0033
 1024 CALL MAADD (AC,IAC,JAC,X,IX,JX)                                   MMIP0034
      GO TO 15                                                          MMIP0035
 1025 CALL MAADD (AC,IAC,JAC,Y,IY,JY)                                   MMIP0036
      GO TO 15                                                          MMIP0037
 1026 CALL MAADD (AC,IAC,JAC,Z,IZ,JZ)                                   MMIP0038
 1027 GO TO 15                                                          MMIP0039
C     SUB, SUBTRACT FROM AC                                             MMIP0040
 103  GO TO (1031,1032,1033,1034,1035,1036,1037),INDXB                  MMIP0041
 1031 CALL MASUB (AC,IAC,JAC,AC,IAC,JAC)                                MMIP0042
      GO TO 15                                                          MMIP0043
 1032 CALL MASUB (AC,IAC,JAC,MQ,IMQ,JMQ)                                MMIP0044
      GO TO 15                                                          MMIP0045
 1033 CALL MASUB (AC,IAC,JAC,W,IW,JW)                                   MMIP0046
      GO TO 15                                                          MMIP0047
 1034 CALL MASUB (AC,IAC,JAC,X,IX,JX)                                   MMIP0048
      GO TO 15                                                          MMIP0049
 1035 CALL MASUB (AC,IAC,JAC,Y,IY,JY)                                   MMIP0050
      GO TO 15                                                          MMIP0051
 1036 CALL MASUB (AC,IAC,JAC,Z,IZ,JZ)                                   MMIP0052
 1037 GO TO 15                                                          MMIP0053
C     LDQ, LOAD ABSTRACT MQ REGISTER                                    MMIP0054
 104  GO TO (1041,1042,1043,1044,1045,1046,1047),INDXB                  MMIP0055
 1041 CALL SHIFT(AC,IAC,JAC,MQ,IMQ,JMQ)                                 MMIP0056
      GO TO 15                                                          MMIP0057
 1042 GO TO 15                                                          MMIP0058
 1043 CALL SHIFT(W,IW,JW,MQ,IMQ,JMQ)                                    MMIP0059
      GO TO 15                                                          MMIP0060
 1044 CALL SHIFT(X,IX,JX,MQ,IMQ,JMQ)                                    MMIP0061
      GO TO 15                                                          MMIP0062
 1045 CALL SHIFT(Y,IY,JY,MQ,IMQ,JMQ)                                    MMIP0063
      GO TO 15                                                          MMIP0064
 1046 CALL SHIFT(Z,IZ,JZ,MQ,IMQ,JMQ)                                    MMIP0065
      GO TO 15                                                          MMIP0066
 1047 GO TO 15                                                          MMIP0067
C     MPY, MULTIPLY                                                     MMIP0068
 105  GO TO (1051,1052,1053,1054,1055,1056,1057),INDXB                  MMIP0069
 1051 CALL MAMULT (MQ,IMQ,JMQ,AC,IAC,JAC,AC,IAC,JAC)                    MMIP0070
      GO TO 15                                                          MMIP0071
 1052 CALL MAMULT (MQ,IMQ,JMQ,MQ,IMQ,JMQ,AC,IAC,JAC)                    MMIP0072
      GO TO 15                                                          MMIP0073
 1053 CALL MAMULT (MQ,IMQ,JMQ,W,IW,JW,AC,IAC,JAC)                       MMIP0074
      GO TO 15                                                          MMIP0075
 1054 CALL MAMULT (MQ,IMQ,JMQ,X,IX,JX,AC,IAC,JAC)                       MMIP0076
      GO TO 15                                                          MMIP0077
 1055 CALL MAMULT (MQ,IMQ,JMQ,Y,IY,JY,AC,IAC,JAC)                       MMIP0078
      GO TO 15                                                          MMIP0079
 1056 CALL MAMULT (MQ,IMQ,JMQ,Z,IZ,JZ,AC,IAC,JAC)                       MMIP0080
 1057 GO TO 15                                                          MMIP0081
C     STO, STORE AC IN MQ,W,X,Y,Z                                       MMIP0082
 106  GO TO (1061,1062,1063,1064,1065,1066,1067),INDXB                  MMIP0083
 1061 GO TO 15                                                          MMIP0084
 1062 CALL SHIFT(AC,IAC,JAC,MQ,IMQ,JMQ)                                 MMIP0085
      GO TO 15                                                          MMIP0086
 1063 CALL SHIFT(AC,IAC,JAC,W,IW,JW)                                    MMIP0087
      GO TO 15                                                          MMIP0088
 1064 CALL SHIFT(AC,IAC,JAC,X,IX,JX)                                    MMIP0089
      GO TO 15                                                          MMIP0090
 1065 CALL SHIFT(AC,IAC,JAC,Y,IY,JY)                                    MMIP0091
      GO TO 15                                                          MMIP0092
 1066 CALL SHIFT(AC,IAC,JAC,Z,IZ,JZ)                                    MMIP0093
      GO TO 15                                                          MMIP0094
 1067 GO TO 15                                                          MMIP0095
C     STQ, STORE MQ IN AC,W,X,Y,Z                                       MMIP0096
 107  GO TO (1071,1072,1073,1074,1075,1076,1077),INDXB                  MMIP0097
 1071 CALL SHIFT(MQ,IMQ,JMQ,AC,IAC,JAC)                                 MMIP0098
      GO TO 15                                                          MMIP0099
 1072 GO TO 15                                                          MMIP0100
 1073 CALL SHIFT(MQ,IMQ,JMQ,W,IW,JW)                                    MMIP0101
      GO TO 15                                                          MMIP0102
 1074 CALL SHIFT(MQ,IMQ,JMQ,X,IX,JX)                                    MMIP0103
      GO TO 15                                                          MMIP0104
 1075 CALL SHIFT(MQ,IMQ,JMQ,Y,IY,JY)                                    MMIP0105
      GO TO 15                                                          MMIP0106
 1076 CALL SHIFT(MQ,IMQ,JMQ,Z,IZ,JZ)                                    MMIP0107
      GO TO 15                                                          MMIP0108
 1077 GO TO 15                                                          MMIP0109
C     SCD, SCALAR DIVIDE, FROM AC TO MQ                                 MMIP0110
 108  IF(SENSE SWITCH 1) 1085,1086                                      MMIP0111
 1085 READ 1081,SCAL                                                    MMIP0112
 1082 CALL MASCAD(SCAL,AC,IAC,JAC,MQ)                                   MMIP0113
      IMQ=IAC                                                           MMIP0114
      JMQ=JAC                                                           MMIP0115
      GO TO 15                                                          MMIP0116
 1086 READ INPUT TAPE 3, 1081, SCAL                                     MMIP0117
      GO TO 1082                                                        MMIP0118
 1081 FORMAT (E14.5)                                                    MMIP0119
C     SCM, SCALAR MULTIPLY, FROM MQ TO AC                               MMIP0120
 109  IF(SENSE SWITCH 1)1095,1096                                       MMIP0121
 1095 READ 1091,SCAL                                                    MMIP0122
 1092 CALL MASCAM(SCAL,MQ,IMQ,JMQ,AC)                                   MMIP0123
      IAC=IMQ                                                           MMIP0124
      JAC=JMQ                                                           MMIP0125
      GO TO 15                                                          MMIP0126
 1096 READ INPUT TAPE 3, 1091, SCAL                                     MMIP0127
      GO TO 1092                                                        MMIP0128
 1091 FORMAT (E14.5)                                                    MMIP0129
C     INV, INVERT FROM AC TO MQ                                         MMIP0130
 110  CALL DETINV (MQ,AC,1,IAC,JAC)                                     MMIP0131
      IMQ=IAC                                                           MMIP0132
      JMQ=JAC                                                           MMIP0133
      GO TO 15                                                          MMIP0134
C     TPS, TRANSPOSE FROM MQ TO AC                                      MMIP0135
 111  CALL MATRAN (MQ,IMQ,JMQ,AC,IAC,JAC)                               MMIP0136
      GO TO 15                                                          MMIP0137
C     XCA, EXCHANGE AC AND MQ                                           MMIP0138
 112  CALL SHIFT (AC,IAC,JAC,V,IV,JV)                                   MMIP0139
      CALL SHIFT (MQ,IMQ,JMQ,AC,IAC,JAC)                                MMIP0140
      CALL SHIFT (V,IV,JV,MQ,IMQ,JMQ)                                   MMIP0141
      GO TO 15                                                          MMIP0142
C     READ, READ A MATRIX                                               MMIP0143
C     SWITCH 1 DOWN, CARDS, UP, TAPE                                    MMIP0144
 113  GO TO (1131,1132,1133,1134,1135,1136,1137),INDXB                  MMIP0145
 1131 CALL READ(AC,IAC,JAC)                                             MMIP0146
      GO TO 15                                                          MMIP0147
 1132 CALL READ(MQ,IMQ,JMQ)                                             MMIP0148
      GO TO 15                                                          MMIP0149
 1133 CALL READ(W,IW,JW)                                                MMIP0150
      GO TO 15                                                          MMIP0151
 1134 CALL READ(X,IX,JX)                                                MMIP0152
      GO TO 15                                                          MMIP0153
 1135 CALL READ(Y,IY,JY)                                                MMIP0154
      GO TO 15                                                          MMIP0155
 1136 CALL READ(Z,IZ,JZ)                                                MMIP0156
      GO TO 15                                                          MMIP0157
 1137 GO TO 15                                                          MMIP0158
C     PRINT, PR+NT A MATRIX                                             MMIP0159
 114  GO TO (1141,1142,1143,1144,1145,1146,1147),INDXB                  MMIP0160
 1141 CALL PRINT(AC,IAC,JAC)                                            MMIP0161
      GO TO 15                                                          MMIP0162
 1142 CALL PRINT(MQ,IMQ,JMQ)                                            MMIP0163
      GO TO 15                                                          MMIP0164
 1143 CALL PRINT(W,IW,JW)                                               MMIP0165
      GO TO 15                                                          MMIP0166
 1144 CALL PRINT(X,IX,JX)                                               MMIP0167
      GO TO 15                                                          MMIP0168
 1145 CALL PRINT (Y,IY,JY)                                              MMIP0169
      GO TO 15                                                          MMIP0170
 1146 CALL PRINT(Z,IZ,JZ)                                               MMIP0171
      GO TO 15                                                          MMIP0172
 1147 GO TO 15                                                          MMIP0173
C     HALT, HALT                                                        MMIP0174
 115  IF (SENSE SWITCH 2) 1153, 1152                                    MMIP0175
 1152 END FILE 12                                                       MMIP0176
 1153 PAUSE 77777                                                       MMIP0177
      GO TO 15                                                          MMIP0178
C DETERMINANT, FROM AC TO V(1,1)                                        MMIP0179
 116  CALL DETINV (V,AC,0,IAC,JAC)                                      MMIP0180
      IF(SENSE SWITCH 1) 1162,1161                                      MMIP0181
 1161 READ INPUT TAPE 3, 1169                                           MMIP0182
      GO TO 1163                                                        MMIP0183
 1162 READ 1169                                                         MMIP0184
 1163 IF(SENSE SWITCH 2)1164,1165                                       MMIP0185
 1165 WRITE OUTPUT TAPE 12,1169                                         MMIP0186
      WRITE OUTPUT TAPE 12,1168,V(1,1)                                  MMIP0187
      GO TO 15                                                          MMIP0188
 1164 PRINT 1169                                                        MMIP0189
      PRINT 1168, V(1,1)                                                MMIP0190
      GO TO 15                                                          MMIP0191
 1168 FORMAT (1H0E20.5)                                                 MMIP0192
 1169 FORMAT(55H                                                       )MMIP0193
C CLEAR, CLEAR A MATRIX TO ZEROS                                        MMIP0194
 117  GO TO (1171,1172,1173,1174,1175,1176,1177),INDXB                  MMIP0195
 1171 CALL CLEAR (AC)                                                   MMIP0196
      GO TO 15                                                          MMIP0197
 1172 CALL CLEAR (MQ)                                                   MMIP0198
      GO TO 15                                                          MMIP0199
 1173 CALL CLEAR (W)                                                    MMIP0200
      GO TO 15                                                          MMIP0201
 1174 CALL CLEAR (X)                                                    MMIP0202
      GO TO 15                                                          MMIP0203
 1175 CALL CLEAR (Y)                                                    MMIP0204
      GO TO 15                                                          MMIP0205
 1176 CALL CLEAR (Z)                                                    MMIP0206
 1177 GO TO 15                                                          MMIP0207
C IDENT, FORM AN IDENTITY MATRIX                                        MMIP0208
 118  GO TO (1181,1182,1183,1184,1185,1186,1187),INDXB                  MMIP0209
 1181 CALL CLEAR (AC)                                                   MMIP0210
      CALL IDENT (AC,IAC,JAC)                                           MMIP0211
      GO TO 15                                                          MMIP0212
 1182 CALL CLEAR (MQ)                                                   MMIP0213
      CALL IDENT (MQ,IMQ,JMQ)                                           MMIP0214
      GO TO 15                                                          MMIP0215
 1183 CALL CLEAR (W)                                                    MMIP0216
      CALL IDENT (W,IW,JW)                                              MMIP0217
      GO TO 15                                                          MMIP0218
 1184 CALL CLEAR (X)                                                    MMIP0219
      CALL IDENT (X,IX,JX)                                              MMIP0220
      GO TO 15                                                          MMIP0221
 1185 CALL CLEAR (Y)                                                    MMIP0222
      CALL IDENT (Y,IY,JY)                                              MMIP0223
      GO TO 15                                                          MMIP0224
 1186 CALL CLEAR (Z)                                                    MMIP0225
      CALL IDENT (Z,IZ,JZ)                                              MMIP0226
 1187 GO TO 15                                                          MMIP0227
      END                                                               MMIP0228
C        MATRIX ABSTRACTION        SHIFT                                MMIP0229
      SUBROUTINE SHIFT(A,IA,JA,B,IB,JB)                                 MMIP0230
C     MATRIX SHIFT LOCATION, A TO B                                     MMIP0231
      DIMENSION A(50,50),B(50,50)                                       MMIP0232
      IB=IA                                                             MMIP0233
      JB=JA                                                             MMIP0234
      DO 100 I=1,IA                                                     MMIP0235
      DO 100 J=1,JA                                                     MMIP0236
 100  B(I,J)=A(I,J)                                                     MMIP0237
      RETURN                                                            MMIP0238
      END                                                               MMIP0239
C        MATRIX ABSTRACTION        MAADD                                MMIP0240
      SUBROUTINE MAADD (A,IA,JA,B,IB,JB)                                MMIP0241
C MATRIX ADDITION                                                       MMIP0242
C A=A+B                                                                 MMIP0243
      DIMENSION A(50,50),B(50,50)                                       MMIP0244
 500  IF(IA-IB)520,501,520                                              MMIP0245
 501  IF(JA-JB)520,502,520                                              MMIP0246
 502  DO 510 I=1,IA                                                     MMIP0247
      DO 510 J=1,JA                                                     MMIP0248
 510  A(I,J)=A(I,J)+B(I,J)                                              MMIP0249
      RETURN                                                            MMIP0250
 520  CALL ERROR (1)                                                    MMIP0251
      END                                                               MMIP0252
C        MATRIX ABSTRACTION        MASUB                                MMIP0253
      SUBROUTINE MASUB (A,IA,JA,B,IB,JB)                                MMIP0254
C MATRIX SUBTRACTION                                                    MMIP0255
C A=A-B                                                                 MMIP0256
      DIMENSION A(50,50),B(50,50)                                       MMIP0257
 550  IF(IA-IB)570,551,570                                              MMIP0258
 551  IF(JA-JB)570,552,570                                              MMIP0259
 552  DO 561 I=1,IA                                                     MMIP0260
      DO 561 J=1,JA                                                     MMIP0261
 561  A(I,J)=A(I,J)-B(I,J)                                              MMIP0262
      RETURN                                                            MMIP0263
 570  CALL ERROR (2)                                                    MMIP0264
      END                                                               MMIP0265
C        MATRIX ABSTRACTION        MAMULT                               MMIP0266
      SUBROUTINE MAMULT (A,IA,JA,B,IB,JB,C,IC,JC)                       MMIP0267
C MATRIX MULTIPLICATION,C=A*B                                           MMIP0268
C A=IA X JA, B=IB X JB, C=IA X JB                                       MMIP0269
C JA=IB                                                                 MMIP0270
      DIMENSION A(50,50),B(50,50),C(50,50)                              MMIP0271
 700  IF (JA-IB)709,701,709                                             MMIP0272
 701  DO 702 I=1,IA                                                     MMIP0273
      DO 702 K=1,JB                                                     MMIP0274
      C(I,K)=0.0                                                        MMIP0275
      DO 702 J=1,JA                                                     MMIP0276
 702  C(I,K)=C(I,K)+A(I,J)*B(J,K)                                       MMIP0277
      IC=IA                                                             MMIP0278
      JC=JB                                                             MMIP0279
      RETURN                                                            MMIP0280
 709  CALL ERROR (3)                                                    MMIP0281
      END                                                               MMIP0282
C        MATRIX ABSTRACTION        MASCAD                               MMIP0283
      SUBROUTINE MASCAD(S,A,IA,JA,B)                                    MMIP0284
C     MATRIX SCALAR DIVISION                                            MMIP0285
C     A/S=B                                                             MMIP0286
      DIMENSION A(50,50),B(50,50)                                       MMIP0287
 580  DO 582 I=1,IA                                                     MMIP0288
      DO 582 J=1,JA                                                     MMIP0289
 582  B(I,J)=A(I,J)/S                                                   MMIP0290
      RETURN                                                            MMIP0291
      END                                                               MMIP0292
C        MATRIX ABSTRACTION        MASCAM                               MMIP0293
      SUBROUTINE MASCAM(S,A,IA,JA,B)                                    MMIP0294
C     MATRIX SCALAR MULTIPLICATION                                      MMIP0295
C     SA=B                                                              MMIP0296
      DIMENSION A(50,50),B(50,50)                                       MMIP0297
 575  DO 577 I=1,IA                                                     MMIP0298
      DO 577 J=1,JA                                                     MMIP0299
 577  B(I,J)=S*A(I,J)                                                   MMIP0300
      RETURN                                                            MMIP0301
      END                                                               MMIP0302
C        MATRIX ABSTRACTION        DETINV                               MMIP0303
      SUBROUTINE DETINV (A,B,IWX,IA,JA)                                 MMIP0304
C     MATRIX DETERMINANT AND INVERSE EVALUATION                         MMIP0305
      DIMENSION A(50,50),B(50,50)                                       MMIP0306
      DIMENSION WBA (50,100)                                            MMIP0307
 400  WE=0.00000001                                                     MMIP0308
      WEE=0.000001                                                      MMIP0309
C       TEST FOR SQUARE AND ONE ELEMENT MATRIX                          MMIP0310
      IF(IA-JA)480,405,480                                              MMIP0311
 405  IF(IA-1)480,470,410                                               MMIP0312
C       FORM SOLUTION ARRAY                                             MMIP0313
 410  DO 415 I=2,IA                                                     MMIP0314
      DO 415 J=1,JA                                                     MMIP0315
 415  WBA(I,J)=B(I,J)                                                   MMIP0316
      IW=IA+1                                                           MMIP0317
      JW=2*IA                                                           MMIP0318
      DO 420 I=1,IA                                                     MMIP0319
      DO 420 J=IW,JW                                                    MMIP0320
 420  WBA(I,J)=0.                                                       MMIP0321
      DO 425 I=2,IA                                                     MMIP0322
      J=I+IA                                                            MMIP0323
 425  WBA(I,J)=1.0                                                      MMIP0324
C       DO CROUT REDUCTION                                              MMIP0325
      IF(ABSF(B(1,1))-WE)485,485,430                                    MMIP0326
 430  DO 435 J=2,IA                                                     MMIP0327
 435  WBA(1,J)=B(1,J)/B(1,1)                                            MMIP0328
      WBA(1,IA+1)=1.0/B(1,1)                                            MMIP0329
      DO 440 K=2,IA                                                     MMIP0330
      KW=IA+K                                                           MMIP0331
      LW=K+1                                                            MMIP0332
      JW=K-1                                                            MMIP0333
      DO 445 I=K,IA                                                     MMIP0334
      DO 445 J=1,JW                                                     MMIP0335
 445  WBA(I,K)=WBA(I,K)-WBA(I,J)*WBA(J,K)                               MMIP0336
      DO 455 J=LW,KW                                                    MMIP0337
      DO 455 I=1,JW                                                     MMIP0338
 455  WBA(K,J)=WBA(K,J)-WBA(K,I)*WBA(I,J)                               MMIP0339
      IF(ABSF(WBA(K,K))-WE)485,485,450                                  MMIP0340
 450  DO 440 J=LW,KW                                                    MMIP0341
 440  WBA(K,J)=WBA(K,J)/WBA(K,K)                                        MMIP0342
C       FORM AND TEST DETERMINANT                                       MMIP0343
      WMX=B(1,1)                                                        MMIP0344
      DO 460 K=2,IA                                                     MMIP0345
 460  WMX=WMX*WBA(K,K)                                                  MMIP0346
 461  IF(ABSF(WMX)-WEE)490,490,462                                      MMIP0347
C       TEST FOR DIVISION ERROR                                         MMIP0348
 462  IF QUOTIENT OVERFLOW 495,463                                      MMIP0349
C         IF IWX=0,EVALUATION OF DETERMINANT ONLY                       MMIP0350
 463  IF(IWX)464,467,464                                                MMIP0351
 467  A(1,1) = WMX                                                      MMIP0352
      RETURN                                                            MMIP0353
C       FORM INVERSE MATRIX                                             MMIP0354
 464  KW=IA-1                                                           MMIP0355
      JW=2*IA                                                           MMIP0356
      DO 465 K=1,KW                                                     MMIP0357
      KK=IA-K                                                           MMIP0358
      DO 465 I=IW,JW                                                    MMIP0359
      DO 465 J=1,K                                                      MMIP0360
      JJ=IW-J                                                           MMIP0361
 465  WBA(KK,I)=WBA(KK,I)-WBA(KK,JJ)*WBA(JJ,I)                          MMIP0362
C       STORE INVERSE IN MATRIX A                                       MMIP0363
      DO 466 J=1,JA                                                     MMIP0364
      MIJA=J+IA                                                         MMIP0365
      DO 466 I=1,IA                                                     MMIP0366
 466  A(I,J)=WBA(I,MIJA)                                                MMIP0367
      RETURN                                                            MMIP0368
C       ONE ELEMENT MATRIX                                              MMIP0369
 470  IF(ABSF(B(1,1))-WE)485,485,475                                    MMIP0370
 475  A(1,1)=B(1,1)                                                     MMIP0371
      IF(IWX)476,478,476                                                MMIP0372
 478  RETURN                                                            MMIP0373
 476  A(1,1)=1.0/B(1,1)                                                 MMIP0374
      RETURN                                                            MMIP0375
C ERROR CONDITIONS                                                      MMIP0376
C NOT SQUARE                                                            MMIP0377
 480  CALL ERROR (4)                                                    MMIP0378
C SMALL DIAGONAL TERM                                                   MMIP0379
 485  CALL ERROR (5)                                                    MMIP0380
C SMALL DETERMINANT                                                     MMIP0381
 490  CALL ERROR (6)                                                    MMIP0382
C DIVISION ERROR                                                        MMIP0383
 495  CALL ERROR (7)                                                    MMIP0384
      END                                                               MMIP0385
C        MATRIX ABSTRACTION        MATRAN                               MMIP0386
      SUBROUTINE MATRAN (A,IA,JA,B,IB,JB)                               MMIP0387
C     MATRIX TRANSPOSE                                                  MMIP0388
C     AT=B                                                              MMIP0389
      DIMENSION A(50,50),B(50,50)                                       MMIP0390
 750  DO 751 I=1,IA                                                     MMIP0391
      DO 751 J=1,JA                                                     MMIP0392
 751  B(J,I)=A(I,J)                                                     MMIP0393
      IB=JA                                                             MMIP0394
      JB=IA                                                             MMIP0395
      RETURN                                                            MMIP0396
      END                                                               MMIP0397
C        MATRIX ABSTRACTION        READ                                 MMIP0398
      SUBROUTINE READ(A,IA,JA)                                          MMIP0399
C     SWITCH 1 DOWN, CARDS, UP, TAPE 3                                  MMIP0400
      DIMENSION A(50,50)                                                MMIP0401
      IF (SENSE SWITCH 1) 200, 100                                      MMIP0402
 100  READ INPUT TAPE 3, 300, IA, JA                                    MMIP0403
      READ INPUT TAPE 3, 400, ((A(I,J),J=1,JA),I=1,IA)                  MMIP0404
      GO TO 500                                                         MMIP0405
 200  READ 300,IA,JA                                                    MMIP0406
      READ 400, ((A(I,J), J=1,JA),I=1,IA)                               MMIP0407
 500  RETURN                                                            MMIP0408
 300  FORMAT(2I5)                                                       MMIP0409
 400  FORMAT(5E14.5)                                                    MMIP0410
      END                                                               MMIP0411
C        MATRIX ABSTRACTION        PRINT                                MMIP0412
      SUBROUTINE PRINT (A,I,J)                                          MMIP0413
      DIMENSION  A(50,50)                                               MMIP0414
      JF=1                                                              MMIP0415
      JP=J                                                              MMIP0416
 40   IF (SENSE SWITCH 1) 45,55                                         MMIP0417
 45   READ 503                                                          MMIP0418
      GO TO 90                                                          MMIP0419
 55   READ INPUT TAPE 3,503                                             MMIP0420
 90   IF (SENSE SWITCH 2) 95,97                                         MMIP0421
 95   PRINT 503                                                         MMIP0422
      GO TO 100                                                         MMIP0423
 97   WRITE OUTPUT TAPE 12, 503                                         MMIP0424
 100  IF (JP-7) 101,102,102                                             MMIP0425
 102  JL=JF+6                                                           MMIP0426
 103  IF (SENSE SWITCH 2) 202,201                                       MMIP0427
 201  WRITE OUTPUT TAPE 12, 500, (JCC,JCC=JF,JL)                        MMIP0428
      DO 291 IA=1,I                                                     MMIP0429
 291  WRITE OUTPUT TAPE 12, 502, IA, (A(IA,JA),JA=JF,JL)                MMIP0430
      GO TO 300                                                         MMIP0431
 202  PRINT 500, (JCC,JCC=JF,JL)                                        MMIP0432
      DO 292 IA=1,I                                                     MMIP0433
 292  PRINT 502, IA, (A(IA,JA),JA=JF,JL)                                MMIP0434
 300  JP=JP-7                                                           MMIP0435
      JF=JF+7                                                           MMIP0436
      GO TO 100                                                         MMIP0437
 101  IF (JP) 301, 499, 302                                             MMIP0438
 301  PAUSE 76543                                                       MMIP0439
 302  JL=JF+JP-1                                                        MMIP0440
      JP=7                                                              MMIP0441
      GO TO 103                                                         MMIP0442
 499  RETURN                                                            MMIP0443
 500  FORMAT(19H0              COL.I3,13H         COL.I3,13H         COLMMIP0444
     1.I3,13H         COL.I3,13H         COL.I3,13H         COL.I3,13H  MMIP0445
     2       COL.I3 )                                                   MMIP0446
 502  FORMAT(5H0 ROWI3,7E16.5)                                          MMIP0447
 503  FORMAT(55H                                                       )MMIP0448
      END                                                               MMIP0449
C        MATRIX ABSTRACTION        CLEAR                                MMIP0450
      SUBROUTINE CLEAR (A)                                              MMIP0451
C CLEAR A MATRIX TO ZEROS                                               MMIP0452
      DIMENSION A(50,50)                                                MMIP0453
 100  DO 110 I=1,50                                                     MMIP0454
      DO 110 J=1,50                                                     MMIP0455
 110  A(I,J)=0.0                                                        MMIP0456
      RETURN                                                            MMIP0457
      END                                                               MMIP0458
C        MATRIX ABSTRACTION          IDENT                              MMIP0459
      SUBROUTINE IDENT (A,IA,JA)                                        MMIP0460
C FORM AN IDENTITY MATRIX                                               MMIP0461
      DIMENSION A(50,50)                                                MMIP0462
 100  DO 101 I=1,50                                                     MMIP0463
 101  A(I,I)=1.0                                                        MMIP0464
      IF(SENSE SWITCH 1)  180,190                                       MMIP0465
 180  READ 200, IA, JA                                                  MMIP0466
      GO TO 170                                                         MMIP0467
 190  READ INPUT TAPE 3, 200, IA, JA                                    MMIP0468
 170  RETURN                                                            MMIP0469
 200  FORMAT (2I5)                                                      MMIP0470
      END                                                               MMIP0471
*        MATRIX ABSTRACTION        CARD, ERROR                          MMIP0472
* READS SYMBOLIC ABSTRACTION CARDS, TAPE A-3 OR READER                  MMIP0473
* SWITCH 1 UP, TAPE A-3                                                 MMIP0474
*          DOWN, CARDS                                                  MMIP0475
       ORG     0                                                        MMIP0476
       REL                                                              MMIP0477
       PLR                                                              MMIP0478
 CARD  SXA     XR1,1         SAVE THEM                                  MMIP0479
       SXA     XR4,4                                                    MMIP0480
       CLA     1,4                                                      MMIP0481
       STA     OUT           CODE ADDRESS                               MMIP0482
       CLA     2,4                                                      MMIP0483
       STA     OUT2          ADDRESS ADDRESS                            MMIP0484
 FIRST SWT     1                                                        MMIP0485
       RTDA    3                                                        MMIP0486
       TSX     K$RTX,4       READ A PROGRAM CARD                        MMIP0487
       PZE     IBUFF,,-1                                                MMIP0488
       TRA     REDER         ERROR READING                              MMIP0489
       CAL     IBUFF+1                                                  MMIP0490
       ARS     12            GET OPERATION CODE                         MMIP0491
       ANA     MASK                                                     MMIP0492
       AXT     18,1                                                     MMIP0493
 CAS   CAS     CODE1,1                                                  MMIP0494
       TRA     *+2                                                      MMIP0495
       TRA     OUT           THIS CODE                                  MMIP0496
       TIX     CAS,1,1                                                  MMIP0497
       TRA     CODER         BAD OP CODE                                MMIP0498
 OUT   SXD     **,1          SET OP CODE INDEX                          MMIP0499
       CAL     IBUFF+2                                                  MMIP0500
       ARS     12            GET ADDRESS CODE                           MMIP0501
       ANA     MASC                                                     MMIP0502
       AXT     7,1                                                      MMIP0503
 CAS2  CAS     ADDR,1        GET ADDRESS                                MMIP0504
       TRA     *+2                                                      MMIP0505
       TRA     OUT2          THIS ADDRESS                               MMIP0506
       TIX     CAS2,1,1                                                 MMIP0507
       TRA     ADRER         BAD ADDRESS                                MMIP0508
 OUT2  SXD     **,1          SET ADDRESS INDEX                          MMIP0509
 XR1   AXT     0,1                                                      MMIP0510
 XR4   AXT     0,4                                                      MMIP0511
       TRA     3,4           RETURN                                     MMIP0512
 REDER TSX     ERROR,4       READ ERROR                                 MMIP0513
       PZE     D8                                                       MMIP0514
 CODER TSX     ERROR,4       CODE ERROR                                 MMIP0515
       PZE     D9                                                       MMIP0516
 ADRER TSX     ERROR,4       ADDRESS ERROR                              MMIP0517
       PZE     D10                                                      MMIP0518
       BCI     7,00000 00000Z00000Y00000X00000W00000M00000A             MMIP0519
 ADDR  PZE     0                                                        MMIP0520
       BCI     9,000IDE000CLE000DET000HAL000PRI000REA000XCA000TPS000INV MMIP0521
       BCI     9,000SCM000SCD000STQ000STO000MPY000LDQ000SUB000ADD000CLA MMIP0522
 CODE1 PZE     0                                                        MMIP0523
 IBUFF BSS     22                                                       MMIP0524
 MASK  OCT     777777                                                   MMIP0525
 MASC  OCT     77                                                       MMIP0526
K      HED                                                              MMIP0527
LL9CHL LIB                                                              MMIP0528
       HED                                                              MMIP0529
 D8    DEC     8B17                                                     MMIP0530
 D9    DEC     9B17                                                     MMIP0531
 D10   DEC     10B17                                                    MMIP0532
 OCTAL OCT     777777777777                                             MMIP0533
* SUBROUTINE ERROR                                                      MMIP0534
* PRINTS AN ERROR MESSAGE ON LINE                                       MMIP0535
 ERROR CLA*    1,4           GET CODE                                   MMIP0536
       PDX     0,4                                                      MMIP0537
       CLA     LINE,4        GET ERROR MESSAGE REFERENCE                MMIP0538
       STA     *+2                                                      MMIP0539
       TSX     CAP,4         PRINT MESSAGE                              MMIP0540
       PZE     0,,9                                                     MMIP0541
       TSX     CAP,4         AND BAD CARD                               MMIP0542
       PZE     IBUFF,,12                                                MMIP0543
       CAL     OCTAL         LIGHT UP PANEL                             MMIP0544
       ALS     2                                                        MMIP0545
       ORA     OCTAL                                                    MMIP0546
       LDQ     OCTAL                                                    MMIP0547
       SLN     1                                                        MMIP0548
       SLN     2                                                        MMIP0549
       SLN     3                                                        MMIP0550
       SLN     4                                                        MMIP0551
       HPR     32767,4                                                  MMIP0552
       LXA     XR4,4                                                    MMIP0553
       TRA     CARD+2                                                   MMIP0554
* ARMERDING, CSCAP1, MODIFIED                                           MMIP0555
* COMMENT ATTACHED PRINTER                                              MMIP0556
*      TSX     CAP,4                                                    MMIP0557
*      PZE     ORG,,N                                                   MMIP0558
*WHERE ORG IS ORIGIN OF BCD COMMENT AND N (MODULO 12) IS THE            MMIP0559
*NUMBER OF BCD WORDS.                                                   MMIP0560
 CAP   SXA     CP16,1       PRINT NOTE TO OPERATOR                      MMIP0561
       SXA     CP17,2                                                   MMIP0562
       SXA     CP18,4                                                   MMIP0563
       CLA     1,4           X                                          MMIP0564
       PDX     0,2          SET COUNT MODULO 12                         MMIP0565
       TIX     *,2,12        X                                          MMIP0566
       ARS     18            SET ORIGIN PLUS COUNT                      MMIP0567
       ADD     1,4           X                                          MMIP0568
       STA     CP2           X                                          MMIP0569
       TXI     CP12,2,1      GO TO CLEAR RIGHT SIDE                     MMIP0570
 CP1   CAL     *             SET STROBE IN SIGN BIT.                    MMIP0571
       STP     PRBF+25      X                                           MMIP0572
 CP2   LDQ     **,2          PICKUP                                     MMIP0573
 CP3   PXD     0,0           PLACE TWICE ZONE IN X4 AND                 MMIP0574
       LGL     2             TWICE NUMERIC IN X1                        MMIP0575
       ALS     14            X                                          MMIP0576
       LGL     4             X                                          MMIP0577
       ALS     1             X                                          MMIP0578
 CP4   PDX     PRBF+24,4    X                                           MMIP0579
       PAX     0,1          X                                           MMIP0580
