       TXL     CP5,4,0       NO ZONE                                    MMIP0582
       TXL     CP6,1,0       NO NUMBER                                  MMIP0583
       ORS     PRBF+25,4    STORE ZONE BIT                              MMIP0584
 CP5   TXL     CP9,1,18      NINE OR LESS                               MMIP0585
       TXH     CP8,1,20      ELEVEN OR MORE                             MMIP0586
       TXH     CP8,4,4       ZONE 3, NUMBER 10                          MMIP0587
       ORS     PRBF+19      BIT IN ZERO ROW                             MMIP0588
       TRA     CP10                                                     MMIP0589
 CP6   TXH     CP10,4,4      BLANK                                      MMIP0590
 CP7   ORS     PRBF+25,4    STORE ZONE                                  MMIP0591
       TRA     CP10                                                     MMIP0592
 CP8   ORS     PRBF+3       STORE 8 BIT                                 MMIP0593
       TXI     *+1,1,-16     REMOVE EIGHT                               MMIP0594
 CP9   ORS     PRBF+19,1    STORE NUMBER BIT                            MMIP0595
 CP10  ARS     1             SHIFT AND STORE STROBE BIT                 MMIP0596
       SLW     PRBF+25      X                                           MMIP0597
       TZE     CP11          IS ONE SIDE DONE                           MMIP0598
       ANA     CP15          IS THIS WORD FINISHED                      MMIP0599
       TNZ     CP3           X                                          MMIP0600
       TIX     CP2,2,1       IS COMMENT DONE                            MMIP0601
