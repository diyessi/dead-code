GNPACB     0191 10240                                                   PACB0000
*          FORTRAN 2 SUBROUTINE PUNACB                                  PACB0001
*                                                                       PACB0002
*                                                                       PACB0003
*          PUNCH ABSOLUTE COLUMN BINARY CARDS                           PACB0004
*                                                                       PACB0005
*                                                                       PACB0006
*                                                                       PACB0007
*                                                                       PACB0008
*          CALLING SEQUENCE                                             PACB0009
*                                                                       PACB0010
*                                                                       PACB0011
*          CALL PUNACB (V,NNUM,NREL)                                    PACB0012
*                                                                       PACB0013
*                                                                       PACB0014
*          WHERE V IS THE VARIABLE TO BE PUNCHED                        PACB0015
*                                                                       PACB0016
*                NNUM IS THE NUMBER OF NUMBERS TO BE PUNCHED AND        PACB0017
*                                                                       PACB0018
*                NREL IS THE AMOUNT BY WHICH THE LOADING ADDRESSES      PACB0019
*                     ON THE CARDS ARE TO BE RELOCATED RELATIVE TO      PACB0020
*                     THEIR PRESENT MACHINE ADDRESS.                    PACB0021
*                                                                       PACB0022
*                                                                       PACB0023
*                                                                       PACB0024
*                                                                       PACB0025
*                                                                       PACB0026
*                                                                       PACB0027
*          PROGRAM CARD FOR FORTRAN 2 SUBROUTINE PUNACB                 PACB0028
*                                                                       PACB0029
       ORG                                                              PACB0030
       FUL                                                              PACB0031
       MZE ,,324                                                        PACB0032
       PZE                                                              PACB0033
       PZE 141                                                          PACB0034
       PZE                                                              PACB0035
       BCD 1PUNACB                                                      PACB0036
       PZE                                                              PACB0037
*                                                                       PACB0038
*                                                                       PACB0039
*                                                                       PACB0040
*                                                                       PACB0041
*          FORTRAN 2 SUBROUTINE PUNACB                                  PACB0042
*                                                                       PACB0043
*                                                                       PACB0044
*                                                                       PACB0045
*                                                                       PACB0046
       REL                                                              PACB0047
       ORG                                                              PACB0048
*                                                                       PACB0049
*                                                                       PACB0050
ENTRY  SXD IXA,1              SAVE INDEX REGISTERS                      PACB0051
       SXD IXB,2                                                        PACB0052
       SXD IXC,4                                                        PACB0053
       CLA 1,4                                                          PACB0054
       STA V                                                            PACB0055
       CLA 2,4                                                          PACB0056
       STA *+1                                                          PACB0057
       CLA                                                              PACB0058
C24    PDX 24,1               NUMBER OF WORDS INTO IXA                  PACB0059
       ARS 18                                                           PACB0060
       STA NNUM                                                         PACB0061
       CLA 3,4                                                          PACB0062
       STA *+1                                                          PACB0063
       CLA                                                              PACB0064
       ARS 18                                                           PACB0065
       STO NREL                                                         PACB0066
       CLA V                                                            PACB0067
       ADD C1                 FA + 1                                    PACB0068
       STA PUN+1                                                        PACB0069
       SUB NNUM               IA                                        PACB0070
       ADD NREL               IA + NREL                                 PACB0071
       STA 9L                 STORE CARD IA                             PACB0072
       LTM                                                              PACB0073
       LXA C24,2              CLEAR CARD IMAGE                          PACB0074
       STZ FREE+24,2                                                    PACB0075
       TIX *-1,2,1                                                      PACB0076
       STZ X                                                            PACB0077
C9     PXD 9                                                            PACB0078
       SLW 9R                                                           PACB0079
       STD 9L                                                           PACB0080
       LXA C9,2               SET WORD INDEX                            PACB0081
       CLA C2                                                           PACB0082
       STA SIDE               SET FOR LEFT SIDE OF CARD.                PACB0083
PUN    LXA SIDE,4                                                       PACB0084
       CAL --,1               BRING IN WORD FOR CARD IMAGE              PACB0085
       SLW FREE+24                                                      PACB0086
       ACL 9R                 ADD WORD TO CHECK SUM                     PACB0087
       SLW 9R                                                           PACB0088
       CAL 9L                 ADD ONE TO WORD COUNT                     PACB0089
       ADD 1X18                                                         PACB0090
       STD 9L                                                           PACB0091
       LDQ FREE+24                                                      PACB0092
RPT    PXD 3                                                            PACB0093
       LGL 1                  SHIFT OUT BIT N                           PACB0094
       RQL 11                                                           PACB0095
       LGL 1                  SHIFT OUT BIT N+12                        PACB0096
       RQL 11                                                           PACB0097
       LGL 1                  SHIFT OUT BIT N+24                        PACB0098
       RQL 12                 SET MQ FOR BIT N+1                        PACB0099
       ALS 36,2                                                         PACB0100
       ORS FREE+24,4          OR INTO IMAGE 3 BITS                      PACB0101
       TXH *+2,4,22           TEST FOR END OF WORD                      PACB0102
       TXI RPT,4,2            REPEAT FOR NEXT 3 BITS                    PACB0103
*                                                                       PACB0104
* END OF A WORD                                                         PACB0105
*                                                                       PACB0106
       CLA X                  TEST FOR SPECIAL EXIT TO PUNCH            PACB0107
       TNZ PUN2                                                         PACB0108
       TXL *+4,4,23           ARE WE ON THE RIGHT SIDE -(YES-OUT)       PACB0109
       TXH *+3,2,24           ARE WE PAST THE SIXTH WORD -(YES-OUT      PACB0110
       TXL *+2,2,23           ARE WE PRIOR TO THE SIXTH WORD -(YES      PACB0111
       WPU                    SELECT THE PUNCH                          PACB0112
       TXI *+1,2,3                                                      PACB0113
       TXH IXA+1,2,36                                                   PACB0114
BACK   TIX PUN,1,1            RETURN FOR NEXT WORD                      PACB0115
       LXA SIDE,4                                                       PACB0116
       TXL PUN1,4,1                                                     PACB0117
       TXH PUN1,2,24                                                    PACB0118
       WPU                                                              PACB0119
IXA    TXL PUN1,0,--                                                    PACB0120
*                                                                       PACB0121
* END OF LEFT OR RIGHT SIDE                                             PACB0122
*                                                                       PACB0123
       TXL PUN1,4,23          PUNCH REGION IF AT END OF CARD            PACB0124
       CLA C1                                                           PACB0125
       STA SIDE                                                         PACB0126
       TXI BACK,2,-36                                                   PACB0127
*                                                                       PACB0128
* END OF CARD ENTER IN 9 LEFT                                           PACB0129
*                                                                       PACB0130
PUN1   CLA C2                 SET SPECIAL EXIT CONTROL                  PACB0131
       STO X                                                            PACB0132
       LXD C3,2               SET WORD INDEX FOR FIRST WORD             PACB0133
       LXA C2,4               SET INDEX FOR LEFT SIDE                   PACB0134
       CAL 9L                                                           PACB0135
       ORA CTR                                                          PACB0136
       SLW 9L                                                           PACB0137
       ACL 9R                                                           PACB0138
       SLW 9R                 FINISH CHECK SUM                          PACB0139
       LDQ 9L                                                           PACB0140
IXB    TXL RPT,0,--                                                     PACB0141
*                                                                       PACB0142
* END OF CARD - ENTER IN 9 RIGHT                                        PACB0143
*                                                                       PACB0144
PUN2   CLA X                                                            PACB0145
       SUB C1                 MINUS ONE FROM EXIT CONTROL               PACB0146
       STO X                                                            PACB0147
       TZE PUN3               TEST FOR END OF 9 ROW                     PACB0148
       LDQ 9R                 ENTER 9 RIGHT                             PACB0149
       LXA C2,4                                                         PACB0150
       TXI RPT,2,3                                                      PACB0151
*                                                                       PACB0152
* PUNCH IMAGE AND CLEAR                                                 PACB0153
*                                                                       PACB0154
PUN3   LXA C24,4                                                        PACB0155
       CPY FREE+24,4          COPY CARD IMAGE                           PACB0156
       STZ FREE+24,4          AND CLEAR                                 PACB0157
       TIX *-2,4,1                                                      PACB0158
       CAL 9L                                                           PACB0159
       ADD C26                                                          PACB0160
       STA 9L                                                           PACB0161
       TIX C9,1,1             REDUCE INDEX CONTROL                      PACB0162
       LXD IXA,1              EXIT PROCEEDURE                           PACB0163
       LXD IXB,2                                                        PACB0164
       LXD IXC,4                                                        PACB0165
       SWT SWCH)6                                                       PACB0166
IXC    TXL *+2,0,--                                                     PACB0167
       ETM                                                              PACB0168
       TTR 4,4                                                          PACB0169
9L     PZE                                                              PACB0170
V      PZE                                                              PACB0171
NNUM   PZE                                                              PACB0172
NREL   PZE                                                              PACB0173
CTR    OCT 000500000000                                                 PACB0174
C26    OCT 26                                                           PACB0175
C1     PZE 1                                                            PACB0176
C2     PZE 2                                                            PACB0177
C3     PZE ,0,3                                                         PACB0178
1X18   PZE ,0,1                                                         PACB0179
FREE   PZE                                                              PACB0180
       REP 1,26                                                         PACB0181
       REM   INPUT ' OUTPUT   OPERATION CODES                           PACB0182
       REM   00181       00190       00237       00247                  PACB0183
       REM   ABSOLUTE ADDRESSES                                         PACB0184
       REM   00058       00098       00104       00106       00112      PACB0185
0      HED                                                              PACB0186
X      SYN FREE+25                                                      PACB0187
9R     SYN FREE+26                                                      PACB0188
SIDE   SYN C3                                                           PACB0189
SWCH)6 EQU 6                                                            PACB0190
       END                                                              PACB0191
