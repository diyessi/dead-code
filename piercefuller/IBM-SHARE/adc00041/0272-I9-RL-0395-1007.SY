*                      TSX   (GNC),4                                    03950055
*                      END CARD RETURN                                  03950056
*                      NORMAL RETURN, CHARACTER IS AT RIGHT IN ACCUM.   03950057
       SPACE   1                                                        03950058
*              THIS ROUTINE GETS CHARACTERS FROM THE 12 BCD WORDS       03950059
*              STARTING AT (CRD). COLUMNS ARE DESIGNATED BY             03950060
*              GIVING THE WORD NUMBER COUNTING FROM THE RIGHT           03950061
*              AND 6 TIMES THE CHARACTER NUMBER COUNTING FROM           03950062
*              THE RIGHT OF THE WORD. THESE ARE PUT IN THE ADDRESS      03950063
*              AND DECREMENT PART, RESPECTIVELY, OF (CNT). TO START     03950064
*              WITH A PARTICULAR COLUMN,PUT THE COUNTS FOR THE NEXT     03950065
*              COLUMN TO THE LEFT IN (CNT).                             03950066
       SPACE   1                                                        03950067
 (GNC) LXA     (CNT),1             WORD COUNT                           03950068
       LXD     (CNT),2             CHARACTER COUNT                      03950069
       TIX     (GN)2,2,6                                                03950070
       TXI     *+1,2,30                                                 03950071
       TIX     (GN)1,1,1                                                03950072
       TRA     1,4                 END-OF-CARD EXIT                     03950073
 (GN)1 SXA     (CNT),1                                                  03950074
 (GN)2 SXD     (CNT),2                                                  03950075
       LDQ     (CRD)+12,1                                               03950076
       LGL     36,2                                                     03950077
       PXD     0,0                                                      03950078
       LGL     6                                                        03950079
       TRA     2,4                                                      03950080
