*              MACRO DEFINITIONS                                        03950204
       SPACE   1                                                        03950205
*              READN   WRITEN READH  WRITEH                             03950206
       SPACE   1                                                        03950207
 READN MACRO   Y,N,E               READS N NUMBERS FROM ONE OR MORE     03950208
       STR     Y,,E                CARDS AND STORES THEM IN CELLS Y THRU03950209
       PZE     (RD),,N             Y+N-1.  IF END-OF-GROUP FOUND BEFORE 03950210
       END     2                   N NUMBERS, CONTROL TO E, OR          03950211
*                                  TERMINATION IF E=0.                  03950212
       SPACE   1                                                        03950213
WRITEN MACRO   Y,S,N,D1,D2,D3,D4,D5,D6                                  03950214
       STR     Y,N,S                                                    03950215
       VFD     3/D1,3/D2,3/D3,3/D4,3/D5,3/D6,18/(WR)                    03950216
       END     2                   WRITES ONE LINE OF N NUMBERS, FIXED  03950217
*                                  POINT.  ITH NUMBER ROUNDED TO        03950218
*                                  DI (4 OR LESS) DECIMAL PLACES.       03950219
       SPACE   1                                                        03950220
 READH MACRO   Y,N,E               N IS 1 OR 2.  READS N CARDS WITH BCD 03950221
       STR     Y,,E                INTO 20 WORDS STARTING AT Y. END-OF- 03950222
       PZE     (RH),,N             GROUP TREATED AS IN READN MACRO.     03950223
       END     2                                                        03950224
       SPACE   1                                                        03950225
WRITEH MACRO   Y,S                 WRITES ONE LINE OF BCDATA FROM 20    03950226
       STR     Y,,S                WORDS STARTING AT Y.                 03950227
       PZE     (WH)                                                     03950228
       END     1                                                        03950229
