ANF403       77 11220                                                   F4030001
C     MATRIX INVERSION AND LINEAR EQUATIONS                             F4030002
      DIMENSION A(20,20), B(20,5), A1(20,20), X(20,5),                  F4030003
     X          AINVA1(20,20), A1X(20,5), AINV(20,20)                   F4030004
      EQUIVALENCE (A,AINV), (B,X)                                       F4030005
    5 IF (SENSE SWITCH 1) 7, 10                                         F4030006
    7 CALL RITAP1(2)                                                    F4030007
   10 READ 1000, N, M, INPUT, ICHECK, ISHAPE, INVRSE                    F4030008
   20 DO 90 I=1,N                                                       F4030009
   30 IF (ISHAPE-1) 800, 40, 60                                         F4030010
   40 READ 2000, (A(I,J), J=1,N)                                        F4030011
   50 GO TO 90                                                          F4030012
   60 READ 2000, (A(I,J), J=I,N)                                        F4030013
   70 DO 80 K=I,N                                                       F4030014
   80 A(K,I)=A(I,K)                                                     F4030015
   90 CONTINUE                                                          F4030016
   95 IF (M) 120, 120, 100                                              F4030017
  100 DO 110 J=1,M                                                      F4030018
  110 READ 2000, (B(I,J), I=1,N)                                        F4030019
  120 IF (ICHECK-1) 800, 130, 160                                       F4030020
  130 DO 150 I=1,N                                                      F4030021
  140 DO 150 J=1,N                                                      F4030022
  150 A1(I,J)=A(I,J)                                                    F4030023
  160 PRINT 3000                                                        F4030024
  180 IF (INPUT-1) 800, 190, 260                                        F4030025
  190 PRINT 4000                                                        F4030026
  200 DO 210 I=1,N                                                      F4030027
  210 PRINT 4500,(A(I,J), J=1,N)                                        F4030028
  220 IF (M) 260, 260, 230                                              F4030029
  230 PRINT 5000                                                        F4030030
  240 DO 250 J=1,M                                                      F4030031
  250 PRINT 4500, (B(I,J), I=1,N)                                       F4030032
  260 CALL MATINV(A,N,B,M,DETERM)                                       F4030033
  270 IF (INVRSE-1) 800, 280, 310                                       F4030034
  280 PRINT 5500                                                        F4030035
  290 DO 300 I=1,N                                                      F4030036
  300 PRINT 4500, (AINV(I,J), J=1,N)                                    F4030037
  310 IF (M) 350, 350, 320                                              F4030038
  320 PRINT 6000                                                        F4030039
  330 DO 340 J=1,M                                                      F4030040
  340 PRINT 4500, (X(I,J), I=1,N)                                       F4030041
  350 PRINT 6500,DETERM                                                 F4030042
  360 IF (ICHECK-1) 800, 370, 10                                        F4030043
  370 DO 410 I=1,N                                                      F4030044
  380 DO 410 J=1,N                                                      F4030045
  390 AINVA1(I,J)=0.0                                                   F4030046
  400 DO 410 K=1,N                                                      F4030047
  410 AINVA1(I,J)=AINVA1(I,J)+AINV(I,K)*A1(K,J)                         F4030048
  420 IF (M) 480, 480, 430                                              F4030049
  430 DO 470 I=1,N                                                      F4030050
  440 DO 470 J=1,M                                                      F4030051
  450 A1X(I,J)=0.0                                                      F4030052
  460 DO 470 K=1,N                                                      F4030053
  470 A1X(I,J)=A1X(I,J)+A1(I,K)*X(K,J)                                  F4030054
  480 IF (INVRSE-1) 800, 490, 520                                       F4030055
  490 PRINT 7000                                                        F4030056
  500 DO 510 I=1,N                                                      F4030057
  510 PRINT 4500, (AINVA1(I,J), J=1,N)                                  F4030058
  520 IF (M) 10, 10, 530                                                F4030059
  530 PRINT 7500                                                        F4030060
  540 DO 550 J=1,M                                                      F4030061
  550 PRINT 4500, (A1X(I,J), I=1,N)                                     F4030062
  560 GO TO 10                                                          F4030063
  800 PAUSE 22222                                                       F4030064
  900 GO TO 10                                                          F4030065
 1000 FORMAT (6I6)                                                      F4030066
 2000 FORMAT (6E12.0)                                                   F4030067
 3000 FORMAT (31H1MATRIX INVERSION USING AN F402)                       F4030068
 4000 FORMAT (13H0INPUT MATRIX)                                         F4030069
 4500 FORMAT (1H01P7E17.7)                                              F4030070
 5000 FORMAT (19H0CONSTANT VECTOR(S))                                   F4030071
 5500 FORMAT (15H0INVERSE MATRIX)                                       F4030072
 6000 FORMAT (19H0SOLUTION VECTOR(S))                                   F4030073
 6500 FORMAT (13H0DETERMINANT=1PE16.7)                                  F4030074
 7000 FORMAT (30H0CHECK OF INVERSE TIMES MATRIX)                        F4030075
 7500 FORMAT (39H0FIT OF SOLUTIONS TO CONSTANT VECTOR(S))               F4030076
 8000 END(0,1,0,0,1)                                                    F4030077
