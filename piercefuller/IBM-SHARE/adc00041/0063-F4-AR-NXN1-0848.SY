C     M R BOLDUC SUBROUTINE TO SOLVE AN N X N SYSTEM OF SIMULTANEOUS    NXN10001
C     LINEAR EQUATIONS BY THE PROCESS OF DIAGONALIZATION                NXN10002
      SUBROUTINE ENXEN (A,B,M)                                          NXN10003
      DIMENSION A(900),B(30)                                            NXN10004
      L=M                                                               NXN10005
      N=M-1                                                             NXN10006
      IDIAG = 1                                                         NXN10007
      DO 39 I = 1,N                                                     NXN10008
      IF (A(IDIAG)) 10,45,10                                            NXN10009
   45 PRINT 46                                                          NXN10010
   46 FORMAT(55H0  DIAGONAL ELEMENT EQUAL TO ZERO                      )NXN10011
      STOP 77776                                                        NXN10012
   10 DO 30 J=I,N                                                       NXN10013
      IBIDIG = J*L + I                                                  NXN10014
   30 A(IBIDIG) = A(IBIDIG) /A(IDIAG)                                   NXN10015
      B(I) = B(I)/A(IDIAG)                                              NXN10016
      DO 38 K = 1,L                                                     NXN10017
      IF (K-I) 32,38,32                                                 NXN10018
   32 NEILS = K + (I-1) * L                                             NXN10019
      DO 35 J = I,N                                                     NXN10020
      ISUB = J*L + K                                                    NXN10021
      IJK = J * L + I                                                   NXN10022
   35 A(ISUB) = A(ISUB) - A(IJK) * A(NEILS)                             NXN10023
      B(K) = B(K) - B(I) * A(NEILS)                                     NXN10024
   38 CONTINUE                                                          NXN10025
   39 IDIAG = I + L*I + 1                                               NXN10026
      I = L*L                                                           NXN10027
      B(L) = B(L) / A(I)                                                NXN10028
      DO 40 I = 1,N                                                     NXN10029
      J = N*L + I                                                       NXN10030
   40 B(I) = B(I) - A(J) * B(L)                                         NXN10031
      RETURN                                                            NXN10032
      END(0,1,0,1,0)                                                    NXN10033
