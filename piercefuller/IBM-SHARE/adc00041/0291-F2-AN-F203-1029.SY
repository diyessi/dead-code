ANF203       77 11220                                                   F2030001
C     A GENERAL PROGRAM FOR CALCULATING EIGENVALUES AND                 F2030002
C     EIGENVECTORS OF REAL SYMMETRIC MATRICES USING ANF202              F2030003
      DIMENSION A(98,98),AA(98,98), VALU(98), DIAG(98),                 F2030004
     X          SUPERD(97), KEY(5), U(98)                               F2030005
      COMMON DIAG, SUPERD                                               F2030006
    5 IF (SENSE SWITCH 1) 7,10                                          F2030007
    7 CALL RITAP1(2)                                                    F2030008
   10 READ 1000, N, M, (KEY(I),I=1,5)                                   F2030009
   20 DO 60 I=1,N                                                       F2030010
   30 IF (KEY(1)-1) 700, 40, 50                                         F2030011
   40 READ 2000, (A(I,J),J=I,N)                                         F2030012
   43 DO 45 J=I,N                                                       F2030013
   45 A(J,I)=A(I,J)                                                     F2030014
   47 GO TO 60                                                          F2030015
   50 READ 2000, (A(I,J),J=1,N)                                         F2030016
   60 CONTINUE                                                          F2030017
   70 PRINT 3000                                                        F2030018
   80 IF (KEY(2)-1) 700, 90, 120                                        F2030019
   90 PRINT 4000                                                        F2030020
  100 DO 110 I=1,N                                                      F2030021
  110 PRINT 7500, (A(I,J), J=1,N)                                       F2030022
  120 IF (KEY(5)-1) 700, 130, 160                                       F2030023
  130 DO 150 I=1,N                                                      F2030024
  140 DO 150 J=1,N                                                      F2030025
  150 AA(I,J)=A(I,J)                                                    F2030026
  160 CALL EIGEN (A,VALU,N,M)                                           F2030027
  170 IF (M) 210, 180, 210                                              F2030028
  180 PRINT 5000                                                        F2030029
  190 PRINT 7500, (VALU(I),I=1,N)                                       F2030030
  200 GO TO 240                                                         F2030031
  210 PRINT 6000                                                        F2030032
  220 DO 230 J=1,N                                                      F2030033
  230 PRINT 6500, VALU(J), (A(I,J),I=1,N)                               F2030034
  240 IF (KEY(3)-1) 700, 250, 290                                       F2030035
  250 PRINT 7000                                                        F2030036
  260 PRINT 7500, (DIAG(I),I=1,N)                                       F2030037
  270 L=N-1                                                             F2030038
  280 PRINT 7500,(SUPERD(I),I=1,L)                                      F2030039
  290 IF (M) 300, 10, 300                                               F2030040
  300 IF (KEY(4)-1) 700, 310, 380                                       F2030041
  310 PRINT 8000                                                        F2030042
  320 DO 370 I=1,N                                                      F2030043
  330 DO 360 J=1,N                                                      F2030044
  340 U(J)=0.0                                                          F2030045
  350 DO 360 K=1,N                                                      F2030046
  360 U(J)=U(J)+A(K,I)*A(K,J)                                           F2030047
  370 PRINT 7500, (U(J),J=1,N)                                          F2030048
  380 IF (KEY(5)-1) 700, 390, 10                                        F2030049
  390 PRINT 9000                                                        F2030050
  400 DO 450 I=1,N                                                      F2030051
  410 DO 440 J=1,N                                                      F2030052
  420 U(J)=0.0                                                          F2030053
  430 DO 440 K=1,N                                                      F2030054
  440 U(J)=U(J)+AA(I,K)*A(K,J)                                          F2030055
  450 PRINT 7500, (U(J),J=1,N)                                          F2030056
  460 PRINT 9500                                                        F2030057
  470 DO 500 I=1,N                                                      F2030058
  480 DO 490 J=1,N                                                      F2030059
  490 U(J)=VALU(J)*A(I,J)                                               F2030060
  500 PRINT 7500, (U(J),J=1,N)                                          F2030061
  600 GO TO 10                                                          F2030062
  700 PAUSE 11111                                                       F2030063
  800 GO TO 10                                                          F2030064
 1000 FORMAT (12I6)                                                     F2030065
 2000 FORMAT (6E12.0)                                                   F2030066
 3000 FORMAT (46H1ANF203 EIGENVALUE EIGENVECTOR GENERAL PROGRAM)        F2030067
 4000 FORMAT (13H0INPUT MATRIX)                                         F2030068
 5000 FORMAT (12H0EIGENVALUES)                                          F2030069
 6000 FORMAT (40H0EIGENVALUES AND ASSOCIATED EIGENVECTORS)              F2030070
 7000 FORMAT (18H0TRI-DIAGONAL FORM)                                    F2030071
 8000 FORMAT (39H0CHECK ON ORTHOGONALITY OF EIGENVECTORS)               F2030072
 9000 FORMAT (26H0CHECK OF A*X VS. LAMBDA*X/4H0A*X)                     F2030073
 9500 FORMAT (9H0LAMBDA*X)                                              F2030074
 7500 FORMAT (1H01P7E17.7)                                              F2030075
 6500 FORMAT (1H01PE14.7/(1H00P7F15.8))                                 F2030076
 9999 END (0,1,0,0,1)                                                   F2030077
