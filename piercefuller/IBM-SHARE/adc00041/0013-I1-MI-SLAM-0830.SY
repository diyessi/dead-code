       TRA 2,4                                                          MISLM920
 WP5   WPR                SELECT PRINTER AGAIN                          MISLM921
       SPR 9                                                            MISLM922
WP2    TXL PR5,0,12       REENTER BCD TO CARD IMAGE                     MISLM923
 BLNKS BCD 1                                                            MISLM924
 X4    HTR 1                                                            MISLM925
 PR6                                                                    MISLM926
OZ2                                                                     MISLM927
 COL1  MZE                                                              MISLM928
 COL   SYN COL1+1                                                       MISLM929
 RT    SYN COL+1+16                                                     MISLM930
 8.5   SYN RT                                                           MISLM931
 8.4   SYN 8.5+1                                                        MISLM932
 8.3   SYN 8.4+1                                                        MISLM933
 8.2   SYN 8.3+1                                                        MISLM934
 D     SYN 8.2+1+9                                                      MISLM935
 Z     SYN D                                                            MISLM936
 X     SYN Z+1                                                          MISLM937
 Y     SYN X+1                                                          MISLM938
   LT  SYN Y+1                                                          MISLM939
 END   SYN LT+1                                                         MISLM940
       REM INSTRUCTIONS OF BINARY CARD 1, PASS 2 OF SAP 3-7.            MISLM941
       REM ORGOP, LOCOP SET IN SAP 6 SO THAT LOC1 AND LOC2 WILL STAY IN MISLM942
       REM      PHASE WITH THE NON-RELOCATABLE SYMBOL TABLE ENTRIES     MISLM943
       REM      FROM THE FIRST PASS OF SAP.                             MISLM944
       REM       LXA 0,4                                                MISLM945
       REM       CPY 2,4                                                MISLM946
       REM       TXI 1,4,-1                                             MISLM947
       REM       HTR                                                    MISLM948
       REM       CLA X                                                  MISLM949
       REM       STA ORGOP+2 ADDRESS IN SAP 6                           MISLM950
       REM       TRA READ1   ADDRESS IN SAP 6                           MISLM951
       REM X     PZE Q0      ADDRESS IN SAP4                            MISLM952
       REM INSTRUCTIONS OF BINARY CARD 2, PASS 2 OF SAP 3-7.            MISLM953
       REM ORGOP, LOCOP RESET IN SAP 6 TO NOW ALLOW THE RELOCATABLE     MISLM954
       REM      SYMBOLS FROM THE FIRST PASS TO STAY IN PHASE WITH LOC1  MISLM955
       REM      AND LOC2.                                               MISLM956
       REM       LXA 0,4                                                MISLM957
       REM       CPY 2,4                                                MISLM958
       REM       TXI 1,4,-1                                             MISLM959
       REM       HTR                                                    MISLM960
       REM       CLA X                                                  MISLM961
       REM       STA ORGOP+2 ADDRESS IN SAP 6                           MISLM962
       REM       TRA READ1   ADDRESS IN SAP 6                           MISLM963
       REM X     PZE RBIT    ADDRESS IN SAP4                            MISLM964
       REM FOUR SELF-LOADING CARDS TO BE PLACED AFTER                   MISLM965
       REM THE PLBS IN MISLAM.                                          MISLM966
       REM OCTOBER 27, 1959                                             MISLM967
       REM                                                              MISLM968
       REM REFERENCES TO UASAP 3-7, SHARE DISTRIBUTION NO. 347.         MISLM969
A      HED                                                              MISLM970
       REM REFERENCES TO SAP4 AND SAP5.                                 MISLM971
 RBIT  SYN 3*64+7             307 OCTAL. SAP 4                          MISLM972
 Q0    SYN 1*512+1*64+4      1104 OCTAL. SAP4                           MISLM973
 READ1 SYN 1*512+1*64+7*8+7  1177 OCTAL. SAP5                           MISLM974
 ORG1  SYN 2*512+1*8+4       2014 OCTAL. SAP5                           MISLM975
       REM                                                              MISLM976
B      HED                                                              MISLM977
       REM REFERENCES TO SAP6.                                          MISLM978
 READ1 SYN 1*512+2*64+7*8+1  1271 OCTAL. SAP6                           MISLM979
 ORGOP SYN 1*512+7*64+5*8+7  1757 OCTAL. SAP 6                          MISLM980
       REM                                                              MISLM981
       REM *************************************************************MISLM982
       REM                                                              MISLM983
       REM AFTER FIRST PLB IN PASS 1                                    MISLM984
       REM MAKE SYMBOLS NON-RELOCATABLE                                 MISLM985
A      HED                                                              MISLM986
       ORG 0                                                            MISLM987
       FUL                                                              MISLM988
       LXA 0,4                                                          MISLM989
       CPY 2,4                                                          MISLM990
       TXI 1,4,-1                                                       MISLM991
       HTR                   EOF                                        MISLM992
       CLA *+3                                                          MISLM993
       STA ORG1-1            ADDRESS IN SAP5                            MISLM994
       TRA READ1             ADDRESS IN SAP5                            MISLM995
       PZE Q0                                                           MISLM996
       REM                                                              MISLM997
       REM *************************************************************MISLM998
       REM                                                              MISLM999
       REM AFTER SECOND PLB, IN PASS 1 OF ASSEMBLER.                    MISLMA00
       REM RESET TO NORMAL SAP RELOCATABLE SYMBOLS.                     MISLMA01
       ORG 0                                                            MISLMA02
       FUL                                                              MISLMA03
       LXA 0,4                                                          MISLMA04
       CPY 2,4                                                          MISLMA05
       TXI 1,4,-1                                                       MISLMA06
       HTR                   EOF                                        MISLMA07
       CLA *+3                                                          MISLMA08
       STA ORG1-1            ADDRESS IN SAP5                            MISLMA09
       TRA READ1             ADDRESS IN SAP5                            MISLMA10
       PZE RBIT                                                         MISLMA11
       REM                                                              MISLMA12
       REM *************************************************************MISLMA13
       REM                                                              MISLMA14
       REM BINARY CARD FOR FIRST PLB IN SECOND PASS OF ASSEMBLER.       MISLMA15
       REM INTERPRET SYMBOLS AS NON-RELOCATABLE.                        MISLMA16
       REM                                                              MISLMA17
       ORG 0                                                            MISLMA18
       FUL                                                              MISLMA19
       LXA 0,4                                                          MISLMA20
       CPY 2,4                                                          MISLMA21
       TXI 1,4,-1                                                       MISLMA22
       HTR                   EOF                                        MISLMA23
       CLA *+3                                                          MISLMA24
       STA B$ORGOP+2         ADDRESS IN SAP6                            MISLMA25
       TRA B$READ1           ADDRESS IN SAP6                            MISLMA26
       PZE Q0                                                           MISLMA27
       REM                                                              MISLMA28
       REM *************************************************************MISLMA29
       REM                                                              MISLMA30
       REM BINARY CARD FOR SECOND PLB IN SECOND PASS OF ASSEMBLER.      MISLMA31
       REM RESET ASSEMBLER TO INTERPRET NORMALLY.                       MISLMA32
       REM                                                              MISLMA33
       ORG 0                                                            MISLMA34
       FUL                                                              MISLMA35
       LXA 0,4                                                          MISLMA36
       CPY 2,4                                                          MISLMA37
       TXI 1,4,-1                                                       MISLMA38
       HTR                   EOF                                        MISLMA39
       CLA *+3                                                          MISLMA40
       STA B$ORGOP+2         ADDRESS IN SAP6                            MISLMA41
       TRA B$READ1           ADDRESS IN SAP6                            MISLMA42
       PZE RBIT                                                         MISLMA43
       REM                                                              MISLMA44
       REM *************************************************************MISLMA45
