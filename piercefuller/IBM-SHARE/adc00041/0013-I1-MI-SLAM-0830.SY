       REM MISLAM, A FORTRAN II SUBPROGRAM, THAT ACTS AS AN OVERLOADER. MISLM001
       REM                                                              MISLM002
       REM DECEMBER 18, 1959                               SHARE VERSIONMISLM003
       REM                                                              MISLM004
       REM PROGRAM CARD                                                 MISLM005
A      HED                                                              MISLM006
       ORG 0                                                            MISLM007
       MZE END-BEGIN                                                    MISLM008
       PZE                                                              MISLM009
       BCD 1MISLAM                                                      MISLM010
       PZE                                                              MISLM011
       BCD 1BLKIN                                                       MISLM012
       PZE BLOCK                                                        MISLM013
       ORG 0                                                            MISLM014
       REL                                                              MISLM015
       REM                                                              MISLM016
       REM *************************************************************MISLM017
       REM BEGINNING OF MISLAM PROGRAM.                                 MISLM018
       REM ENTER FROM MISLAM RELOCATABLE TRANSFER CARD.                 MISLM019
 BEGIN REW N                 RECORD BOOTSTRAP RECORD ON FRONT OF TAPE   MISLM020
       LXD KK,1                                                         MISLM021
       WTB N                                                            MISLM022
       CPY BOOTF,1                                                      MISLM023
       TIX *-1,1,1                                                      MISLM024
       WTB N                                                            MISLM025
       CPY DUMM                                                         MISLM026
       WTB N                 WRITE END-RECORD                           MISLM027
       CPY ENDR                                                         MISLM028
       BST N                                                            MISLM029
       BST N                                                            MISLM030
       RTB N                                                            MISLM031
       REM MAKE PATCH IN BSS                                            MISLM032
       CAL TSTTR                                                        MISLM033
       STA TRCRD             CHANGE BSS AT 77627                        MISLM034
       CLA 2PPCH                                                        MISLM035
       STO 2PAS2                                                        MISLM036
 KK    TXI READ,0,BOOTF-BOOTI REENTER BSS TO READ CARDS                 MISLM037
 TSTTR PZE PATCH,,0                                                     MISLM038
 2PPCH TRA CK1                                                          MISLM039
 ENDR  PZE 0,,-1                                                        MISLM040
 DUMM  PZE 0,,-2                                                        MISLM041
       REM *************************************************************MISLM042
       REM BOOTSTRAP BLOCK                                              MISLM043
 BOOTI SYN *                                                            MISLM044
       ORG BOOTI                                                        MISLM045
       REM PLB CHANGES LOCOP AND ORGOP TO MAKE THE FOLLOWING SYMBOLS    MISLM046
       REM     NON-RELOCATABLE.                                         MISLM047
       PLB                                                              MISLM048
       REM ORGOP, LOCOP IN SAP 5 CHANGED SO THAT THE FOLLOWING          MISLM049
       REM      SYMBOLS ARE NON-RELOCATABLE.                            MISLM050
       REM INSTRUCTIONS OF BINARY CARD 1, PASS 1 OF SAP 3-7.            MISLM051
       REM       LXA 0,4                                                MISLM052
       REM       CPY 2,4                                                MISLM053
       REM       TXI 1,4,-1                                             MISLM054
       REM       HTR         EOF STOP                                   MISLM055
       REM       CLA X                                                  MISLM056
       REM       STA ORG1-1  ADDRESS IN SAP5                            MISLM057
       REM       TRA READ1   ADDRESS IN SAP5                            MISLM058
       REM X     PZE Q0      ADDRESS IN SAP4                            MISLM059
       REM                                                              MISLM060
       LOC 0                                                            MISLM061
 BOTM  LXA 0,1                                                          MISLM062
       CPY 2,1               COPIES BOOTSTRAP                           MISLM063
       TXI 1,1,-1                                                       MISLM064
       TRA ER0               FALSE EOF.  START OVER                     MISLM065
       LXA 0,1               SCAN TAPE FOR LAST SNAPSHOT                MISLM066
       RTT                                                              MISLM067
       TRA ER3                                                          MISLM068
 LOOP  RTB N                 READ NEXT RECORD                           MISLM069
       CPY 0                                                            MISLM070
       LXD 0,2                                                          MISLM071
 MINRC TXH SKIP,2,1000                                                  MISLM072
       SXD MINRC,2                                                      MISLM073
       SXD REC,1                                                        MISLM074
 SKIP  TXI TXL2,1,1                                                     MISLM075
 TXL2  TXL LOOP,2,-2         TEST IF END RECORD                         MISLM076
       ARS 255                                                          MISLM077
       ARS 255                                                          MISLM078
       RTT                                                              MISLM079
       TRA ER1               RTT IN SEARCHING FOR SNAPSHOT. START OVER. MISLM080
       SXD RECMX,1                                                      MISLM081
       LXD MINRC,1           TEST IF ANY SNAPSHOT FOUND                 MISLM082
       TXL GET,1,999                                                    MISLM083
       TRA ER2               NO SNAPSHOT ON INPUT TAPE. STOP.           MISLM084
 GET   CLA RECMX             REPOSITION TAPE FOR LAST SNAPSHOT READING  MISLM085
       SUB REC                                                          MISLM086
       PDX 0,1                                                          MISLM087
 BSTN  BST N                                                            MISLM088
       TIX BSTN,1,1                                                     MISLM089
       LXD PARWD,1           STORE UPPER LOADER                         MISLM090
 CLAU  CLA BOTM+LOCORE+UPCORE,1                                         MISLM091
       STO B$UP2,1                                                      MISLM092
       TIX CLAU,1,1                                                     MISLM093
       LXD MINRC,1                                                      MISLM094
 PARWD TXI B$UPPER,,UPCORE                                              MISLM095
 ER0   TSX C$WOT,4                                                      MISLM096
       PZE C$HEAD,,C$HEAD+4                                             MISLM097
       TSX C$WOT,4                                                      MISLM098
       PZE C$BLNKS,,C$BLNKS                                             MISLM099
       TSX C$WOT,4                                                      MISLM100
       PZE P0,,P01                                                      MISLM101
       TSX C$EJECT,4                                                    MISLM102
       HTR *                                                            MISLM103
 ER1   TSX C$WOT,4                                                      MISLM104
       PZE C$HEAD,,C$HEAD+4                                             MISLM105
       TSX C$WOT,4                                                      MISLM106
       PZE C$BLNKS,,C$BLNKS                                             MISLM107
       TSX C$WOT,4                                                      MISLM108
       PZE P1,,P11                                                      MISLM109
       TSX C$EJECT,4                                                    MISLM110
       HTR *                                                            MISLM111
 ER2   TSX C$WOT,4                                                      MISLM112
       PZE C$HEAD,,C$HEAD+4                                             MISLM113
       TSX C$WOT,4                                                      MISLM114
       PZE C$BLNKS,,C$BLNKS                                             MISLM115
       TSX C$WOT,4                                                      MISLM116
       PZE P2,,P21                                                      MISLM117
       TSX C$EJECT,4                                                    MISLM118
       HTR *                                                            MISLM119
 ER3   TSX C$WOT,4                                                      MISLM120
       PZE C$HEAD,,C$HEAD+4                                             MISLM121
       TSX C$WOT,4                                                      MISLM122
       PZE C$BLNKS,,C$BLNKS                                             MISLM123
       TSX C$WOT,4                                                      MISLM124
       PZE P3,,P31                                                      MISLM125
       TSX C$EJECT,4                                                    MISLM126
       HTR *                                                            MISLM127
 P0    BCD 6 FALSE END OF FILE.  START RUN OVER.                        MISLM128
 P01   EQU *-1                                                          MISLM129
 P1    BCD   REDUNDANCY TAPE TEST FAILURE IN SEARCHING FOR LAST SNAPSHOTMISLM130
       BCD 3  START RUN OVER.                                           MISLM131
 P11   EQU *-1                                                          MISLM132
 P2    BCD 7 NO SNAPSHOT ON INPUT TAPE.  STOP RUN.                      MISLM133
 P21   EQU *-1                                                          MISLM134
       ORG A$BOOTI+P21+1                                                MISLM135
       LOC P21+1                                                        MISLM136
 P3    BCD   POSSIBLE REDUNDANCY TAPE TEST FAILURE WHILE READING BOOTSTRMISLM137
       BCD 3AP IN. START OVER.                                          MISLM138
 P31   EQU *-1                                                          MISLM139
       REM *************************************************************MISLM140
       REM STORAGE FOR VARIABLES AND CONSTANT                           MISLM141
 REC   PZE                                                              MISLM142
 RECMX PZE                                                              MISLM143
C      HED                                                              MISLM144
 EJECT WPR                                                              MISLM145
       SPR 1                                                            MISLM146
       TRA 1,4                                                          MISLM147
 HEAD  BCD 5 FORTRAN II MISLAM DIAGNOSTIC                               MISLM148
       REM                                                              MISLM149
       ORG A$BOOTI+HEAD+5                                               MISLM150
       LOC HEAD+5                                                       MISLM151
 WOT   WPR                                                              MISLM152
       SXD X1,1                                                         MISLM153
       SXD X2,2                                                         MISLM154
       SXD X4,4                                                         MISLM155
       CAL 1,4                                                          MISLM156
       PAX 0,4                                                          MISLM157
       ARS 18                                                           MISLM158
       ADD X4                                                           MISLM159
       STA PR2                                                          MISLM160
       STA CI9                                                          MISLM161
       SXD *+2,4                                                        MISLM162
       LXA PR2,4                                                        MISLM163
       TNX WT2,4,**                                                     MISLM164
       SXD PR6,4                                                        MISLM165
       CLA BLNKS          FIND LAST NON-BLANK                           MISLM166
       LXD CI4,4          GROUP                                         MISLM167
 PR2   CAS 0,4            X                                             MISLM168
       TXI PR1,4,-1                                                     MISLM169
       TXI PR2,4,1        X                                             MISLM170
       TXI PR1,4,-1                                                     MISLM171
 PR1   SXD CI6,4          STORE END TEST                                MISLM172
       SXD CI8,4          X                                             MISLM173
       SXD PR8,4                                                        MISLM174
       SXD WP4,4                                                        MISLM175
       LXD PR6,4                                                        MISLM176
 PR8   TNX PR5,4                                                        MISLM177
       TXL PR3,4,12                                                     MISLM178
       SPR 8                                                            MISLM179
 PR3   LXD PR6,4          INITIALIZE GROUP COUNT                        MISLM180
 PR5   LXA PR7,2          INITIALIZE LEFT SETUP                         MISLM181
       LXD YZ1,1          CLEAR CARD IMAGE                              MISLM182
 PR7   PXD                                                              MISLM183
 PR4   SLW LT,1                                                         MISLM184
       SLW RT,1                                                         MISLM185
       TIX PR4,1,1        X                                             MISLM186
 CIR   CAL COL1           INITIALIZE COLUMN INDICATOR                   MISLM187
 CI2   SLW COL            X                                             MISLM188
 CI9   LDQ 0,4            OBTAIN GROUP                                  MISLM189
       SXD OZ2,4          STORE GROUP COUNT                             MISLM190
       LXA Q6,4           SET CHARACTER COUNT                           MISLM191
 CI1   PXD                                                              MISLM192
 Q6    LGL 6                                                            MISLM193
       PAX 0,1            X                                             MISLM194
       CAL COL            POSITION COLUMN INDICATOR                     MISLM195
       ARS 6,4            X                                             MISLM196
       TIX YZ1,1,16       TEST FOR DIGIT                                MISLM197
       TXH YZ2,1,15       TEST FOR Y-ZONE                               MISLM198
 CI5   ORS D,3            STORE DIGIT                                   MISLM199
 CI4   TIX CI1,4,1        COUNT CHARACTERS                              MISLM200
 CI3   ARS 1              SHIFT AND TEST COLUMN                         MISLM201
       LXD OZ2,4          RESTORE GROUP COUNT                           MISLM202
       TXI CI6,4,-1       COUNT GROUPS                                  MISLM203
 CI6   TXL CI7,4          TEST FOR LAST NON-BLANK GR.                   MISLM204
       TNZ CI2            TEST FOR END OF ROW                           MISLM205
 CI7   CAL 8.3,2          FORM TRUE 8,4                                 MISLM206
       ORS D-8,2          AND 3 ROWS AND                                MISLM207
       ORS D-3,2          MOVE8.4 AND 8.3                               MISLM208
       SLW 8.2,2          ROWS                                          MISLM209
       CAL 8.4,2          FORM TRUE8.4                                  MISLM210
       ORS D-8,2                                                        MISLM211
       ORS D-4,2                                                        MISLM212
       SLW 8.3,2          X                                             MISLM213
 CI8   TXL WP,4           TEST FOR END                                  MISLM214
       TXH WP,2,15        TEST FOR RIGHT HALF                           MISLM215
       TXI CIR,2,16       INITIALIZE RIGHT HALF                         MISLM216
 YZ1   TIX XZ1,1,16       TEST FOR 16/CH/32                             MISLM217
       TXH XZ2,1,15       TEST FOR X-ZONE                               MISLM218
       ORS D,3            STORE DIGIT                                   MISLM219
 YZ2   ORS Y,2            STORE Y-ZONE                                  MISLM220
       TIX CI1,4,1        COUNT CHARACTERS                              MISLM221
 X1    TXL CI3            OBTAIN NEXT GROUP                             MISLM222
 XZ1   TIX OZ1,1,16       TEST FOR 32/CH/48                             MISLM223
       TXH CI4,1,15       TEST FOR BLANK                                MISLM224
       ORS D,3            STORE DIGIT                                   MISLM225
 XZ2   ORS X,2            STORE X-ZONE                                  MISLM226
       TIX CI1,4,1        COUNT CHARACTERS                              MISLM227
 X2    TXL CI3            OBTAIN NEXT GROUP                             MISLM228
 OZ1   ORS Z,2            STORE 0-ZONE                                  MISLM229
       ORS D,3                                                          MISLM230
       TIX CI1,4,1        COUNT CHARACTERS                              MISLM231
       TXL CI3                                                          MISLM232
 WP    LXD WP2,1                                                        MISLM233
 WP3   CPY LT,1           COPY CARD IMAGE                               MISLM234
       CPY RT,1                                                         MISLM235
       TIX WP3,1,1                                                      MISLM236
 WP4   TXH WP5,4                                                        MISLM237
       LXD X1,1                                                         MISLM238
       LXD X2,2                                                         MISLM239
WT2    LXD X4,4                                                         MISLM240
       TRA 2,4                                                          MISLM241
 WP5   WPR                SELECT PRINTER AGAIN                          MISLM242
       SPR 9                                                            MISLM243
WP2    TXL PR5,0,12       REENTER BCD TO CARD IMAGE                     MISLM244
 BLNKS BCD 1                                                            MISLM245
 X4    HTR 1                                                            MISLM246
 PR6                                                                    MISLM247
OZ2                                                                     MISLM248
 COL1  MZE                                                              MISLM249
 COL   EQU COL1+1                                                       MISLM250
 RT    EQU COL+1+16                                                     MISLM251
 8.5   EQU RT                                                           MISLM252
 8.4   EQU 8.5+1                                                        MISLM253
 8.3   EQU 8.4+1                                                        MISLM254
 8.2   EQU 8.3+1                                                        MISLM255
 D     EQU 8.2+1+9                                                      MISLM256
 Z     EQU D                                                            MISLM257
 X     EQU Z+1                                                          MISLM258
 Y     EQU X+1                                                          MISLM259
 LT    EQU Y+1                                                          MISLM260
LOCORE EQU LT-A$BOTM                                                    MISLM261
       REM *************************************************************MISLM262
B      HED                                                              MISLM263
       ORG A$BOOTI+C$LT                                                 MISLM264
       LOC 32575                                                        MISLM265
       REM UPPER LOADER SEGMENT                                         MISLM266
 UPPER RTB A$N                                                          MISLM267
       CPY 0                                                            MISLM268
       CLA 0                                                            MISLM269
       SXD 0,1                                                          MISLM270
       SUB 0                                                            MISLM271
       TZE CPY1                                                         MISLM272
       TRA ER3               INPUT TAPE SLIPPED OUT-OF-PHASE. START OVERMISLM273
 CPY1  CPY 0                 W1                                         MISLM274
       LXD 0,3                                                          MISLM275
       PXD 0,1                                                          MISLM276
       ARS 18                                                           MISLM277
       STA CPY2                                                         MISLM278
 CPY2  CPY -,1               LOAD FROM 0 TO W1-1                        MISLM279
       TIX CPY2,1,1                                                     MISLM280
       SXD A$W1,2            STORE IN MISLAM SUBPROGRAM FIRST BROUGHT INMISLM281
       CPY 0                 W2                                         MISLM282
       LXD 0,1                                                          MISLM283
       TRA A$LOAD            TO MISLAM TO LOAD FROM -W2 TO -1           MISLM284
 ER3   TSX C$WOT,4                                                      MISLM285
       PZE C$HEAD,,C$HEAD+4                                             MISLM286
       TSX C$WOT,4                                                      MISLM287
       PZE C$BLNKS,,C$BLNKS                                             MISLM288
       TSX C$WOT,4                                                      MISLM289
       PZE P3,,P31                                                      MISLM290
       TSX C$EJECT,4                                                    MISLM291
       HTR *                                                            MISLM292
 P3    BCD 9 INPUT TAPE SLIPPED OUT-OF-PHASE.  START RUN OVER.          MISLM293
 P31   EQU *-1                                                          MISLM294
 UP2   EQU *                                                            MISLM295
UPCORE EQU UP2-UPPER                                                    MISLM296
       REM PLB NOW RESETS LOCOP AND ORGOP FOR RELOCATABLE SYMBOLS.      MISLM297
       PLB                                                              MISLM298
       REM INSTRUCTIONS OF BINARY CARD 2, PASS 1 OF SAP 3-7.            MISLM299
       REM  SAP 5 CHANGED BACK TO ITS ORIGINAL INSTRUCTIONS.            MISLM300
       REM RESETS ORGOP, LOCOP TO PRODUCE RELOCATABLE SYMBOLS.          MISLM301
       REM                                                              MISLM302
       REM       LXA 0,4                                                MISLM303
       REM       CPY 2,4                                                MISLM304
       REM       TXI 1,4,-1                                             MISLM305
       REM       HTR         EOF STOP                                   MISLM306
       REM       CLA X                                                  MISLM307
       REM       STA ORG1-1  ADDRESS IN SAP 5                           MISLM308
       REM       TRA READ1   ADDRESS IN SAP 5                           MISLM309
       REM X     PZE RBIT    ADDRESS IN SAP4                            MISLM310
       REM                                                              MISLM311
A      HED                                                              MISLM312
 BOOTF SYN BOOTI+LOCORE+UPCORE                                          MISLM313
       TCD BEGIN                                                        MISLM314
       ORG 0                                                            MISLM315
       REM *************************************************************MISLM316
       REM                                                              MISLM317
       REM FINAL BOOTSTRAP LOADER IN MISLAM                             MISLM318
       REM                                                              MISLM319
 LOAD  SXD W2,1                                                         MISLM320
       CPY 0,1                                                          MISLM321
       TIX *-1,1,1                                                      MISLM322
       ARS 255                                                          MISLM323
       ARS 255                                                          MISLM324
       RTT                                                              MISLM325
       TRA LSER8             RTT IN READING LAST SNAPSHOT. START OVER.  MISLM326
       REM CLEAR SECTION FROM W1 TO -W2-1                               MISLM327
       CLA W1                                                           MISLM328
       COM                                                              MISLM329
       STD TXH1                                                         MISLM330
       STO SSIND             SET SNAPSHOT INDICATOR TO NON'ZERO         MISLM331
       LXD W2,1                                                         MISLM332
       STZ -1,1                                                         MISLM333
       TXI *+1,1,1                                                      MISLM334
 TXH1  TXL *-2,1,-                                                      MISLM335
       TRA READ              REENTER BSS TO READ CARDS                  MISLM336
       REM                                                              MISLM337
       REM *************************************************************MISLM338
       REM                                                              MISLM339
       REM REFERENCES TO BSS LOADER                                     MISLM340
 TRCRD EQU 32663             OCTAL 77627                                MISLM341
 READ  EQU 15                OCTAL 17                                   MISLM342
 STL   EQU 32757             OCTAL 77765                                MISLM343
 PB    EQU 23                OCTAL 27                                   MISLM344
 TXI2  EQU 32756             OCTAL 77764                                MISLM345
 FINIS EQU 32758             OCTAL 77766                                MISLM346
 2PBSS EQU 32730             OCTAL 77732                                MISLM347
 2PAS1 EQU 32749             77755 OCTAL                                MISLM348
 2PAS2 EQU 32751             77757 OCTAL                                MISLM349
 2PAS3 EQU 32752             77760 OCTAL                                MISLM350
 STORG EQU 32554             77452 OCTAL                                MISLM351
       REM *************************************************************MISLM352
       REM VARIABLES, CONSTANTS AND STORAGE                             MISLM353
 ENDRC PZE 0,0,-1            1-WORD END-RECORD                          MISLM354
 DUM   PZE 0,,-2                                                        MISLM355
 RECNO PZE                   TAPE HISTORY                               MISLM356
 D1    PZE 0,0,1             CONSTANT                                   MISLM357
 BLOCS PZE                   NUMBER OF TAPE BLOCKS                      MISLM358
 BLOCI PZE                   ORIGIN OF TAPE BLOCK                       MISLM359
 TAPMX PZE                                                              MISLM360
 BLKMX PZE                   MAXIMUM EXCURSION OF TAPE BLOCK            MISLM361
 LNGTH PZE                   CURRENT TAPE BLOCK LENGTH                  MISLM362
 CODE  PZE                   CURRENT RECORD CODE                        MISLM363
 RECMN PZE 0,0,1000          CURRENT SNAPSHOT RECORD CODE               MISLM364
 W1    PZE                   WORD COUNT                                 MISLM365
 W2    PZE                   WORD COUNT                                 MISLM366
 AD0   PZE ST0               ADDRESS SWITCH FOR 2ND PASS                MISLM367
 AD1   PZE ST1               ADDRESS SWITCH FOR 2ND PASS                MISLM368
 AD2   PZE ST2               ADDRESS SWITCH FOR 2ND PASS                MISLM369
 SSIND PZE                   SNAPSHOT INDICATOR                         MISLM370
 N     EQU 4                 INPUT TAPE                                 MISLM371
 SIZE  EQU 20                TABLE SIZE                                 MISLM372
 TAB   BES SIZE                                                         MISLM373
 ST1T  BES SIZE                                                         MISLM374
       REM                                                              MISLM375
       REM *************************************************************MISLM376
       REM                                                              MISLM377
       REM PATCH INTO BSS FOR TRANSFER CARD                             MISLM378
 PATCH ALS 18                DISPATCH TO PROPER T/CARD ENTRY            MISLM379
       PDX 0,2                                                          MISLM380
       TXL T0,2,0                                                       MISLM381
       TXL T1,2,1                                                       MISLM382
       TXL T2,2,2                                                       MISLM383
       TXL T3,2,3                                                       MISLM384
       TXL T4,2,4                                                       MISLM385
       TRA T0                ASSUME T/0 CARD                            MISLM386
       REM *************************************************************MISLM387
       REM                                                              MISLM388
       REM ENTER FROM T/1 CARD BEGIN TAPE BLOCK                         MISLM389
       REM                                                              MISLM390
 T1    LXD D1,1                                                         MISLM391
 D2    TXI TCL1,,2                                                      MISLM392
       REM ENTER FROM T/2 CARD.  BEGIN SECOND CORE                      MISLM393
       REM MEMORY BLOCK                                                 MISLM394
 T2    LXD D2,1                                                         MISLM395
 D3    TXI JOIN,,3                                                      MISLM396
       REM ENTER FROM T/0 CARD. INITIATE SECOND PASS                    MISLM397
 T0    LXD D3,1                                                         MISLM398
 TCL1  CLA SSIND                                                        MISLM399
       TZE JOIN                                                         MISLM400
       STZ SSIND                                                        MISLM401
       WTB N                                                            MISLM402
       CPY DUM                                                          MISLM403
       WTB N                                                            MISLM404
       CPY ENDRC                                                        MISLM405
       BST N                                                            MISLM406
       BST N                                                            MISLM407
       RTB N                                                            MISLM408
 TCL2  SYN *                                                            MISLM409
 JOIN  CLA BLKMD             OLD                                        MISLM410
       SXD BLKMD,1           NEW                                        MISLM411
       PDX 0,1               1                                          MISLM412
 BLKMD TXL *+2,1,0           3                                          MISLM413
       TRA LSER1             PROPER SEQUENCE OF T/CARDS VIOLATED. STOP. MISLM414
       REM FINISH PREVIOUS BLOCK                                        MISLM415
       TXL LSTCM,1,0                                                    MISLM416
       TXL LSTTP,1,1                                                    MISLM417
       TRA NEXT                                                         MISLM418
 LSTCM LXD STL,1             LAST BLOCK CM0                             MISLM419
       SXD ST0,1                                                        MISLM420
 CMST  SXD STSE3,1                                                      MISLM421
       LXD D1,1                                                         MISLM422
       TRA STSET                                                        MISLM423
 LSTTP LXD BLOCS,1           LAST BLOCK TAPE BLOCK                      MISLM424
       TXI *+1,1,1           RAISE COUNT                                MISLM425
       SXD BLOCS,1                                                      MISLM426
       TXL *+2,1,SIZE                                                   MISLM427
       TRA LSER2             TOO MANY BLOCKS. STOP.                     MISLM428
       CLA PB                                                           MISLM429
       STA CPYLP                                                        MISLM430
       STA CLRLP                                                        MISLM431
       STO TAB,1                                                        MISLM432
       CAS BLKMX             REVISE TAPE BLOCK MAXIMUM                  MISLM433
       STO BLKMX                                                        MISLM434
       STO TAPMX                                                        MISLM435
       SUB BLOCI             SET BLOCK LENGTH                           MISLM436
       STO LNGTH                                                        MISLM437
       TXI *+1,1,1000        SET CODE WORD                              MISLM438
       SXD CODE,1                                                       MISLM439
       LXA LNGTH,1           WRITE UNPROCESSED BLOCK                    MISLM440
       WTB N                                                            MISLM441
       CPY CODE                                                         MISLM442
 CPYLP CPY -,1               (PB)                                       MISLM443
       TIX *-1,1,1                                                      MISLM444
       WTB N                                                            MISLM445
       CPY DUM                                                          MISLM446
       WTB N                 WRITE END-RECORD                           MISLM447
       CPY ENDRC                                                        MISLM448
       BST N                                                            MISLM449
       BST N                                                            MISLM450
       RTB N                                                            MISLM451
       LXA LNGTH,1           ERASE LAST TAPE BLOCK                      MISLM452
 CLRLP STZ -,1               (PB)                                       MISLM453
