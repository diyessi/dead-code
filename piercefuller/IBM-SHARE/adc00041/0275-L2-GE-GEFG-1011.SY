*9F10          GE FORMAT GENERATOR         D. S. CLARKE                 GEFG0001
       COUNT   1300                                                     GEFG0002
       ABS                                                              GEFG0003
       REM MASTER RECORD CARD 9F100000                                  GEFG0004
       FUL                                                              GEFG0005
       ORG     0                                                        GEFG0006
       PON     ,,2                                                      GEFG0007
       PON     PRQT+100,,526                                            GEFG0008
       PZE     100,,524                                                 GEFG0009
       PZE     PRQT                                                     GEFG0010
       ENDFUL                                                           GEFG0011
       REM MODIFICATIONS TO TEST FOR STATEMENT AND ,LATER, TO GEN. FOR. GEFG0012
B1147  BOOL    1147                                                     GEFG0013
       ORG     B1147                                                    GEFG0014
       TRA     AFMT                                                     GEFG0015
B3016  BOOL    3016                                                     GEFG0016
       ORG     B3016                                                    GEFG0017
       TRA FTEST                                                        GEFG0018
       REM GEFG GEN. ELECT. FORMAT GENERATOR FOR FORTRAN II    2/15/60  GEFG0019
       REM THIS ROUTINE, WHEN INCORPORATED INTO THE FORTRAN II COMPILER GEFG0020
       REM ENABLES PROGRAMMERS TO GENERATE FORMAT FOR I-O STATEMENTS    GEFG0021
       REM DURING THE EXECUTION OF SECTION 1.  THE GENERATOR IS         GEFG0022
       REM SIGNALLED BY A FORMAT STATEMENT CONTAINING NO SPECIFICATIONS,GEFG0023
       REM I.E., THE REMAINDER OF THE CARD IS BLANK.  THE DESCRIPTION   GEFG0024
       REM THEN FOLLOWS.  SPECIFICATIONS ARE GENERATED FROM SPACE,      GEFG0025
       REM RESTORE, REPEAT, AND PARAMETER FORMAT STATEMENTS.  AN END    GEFG0026
       REM OF FORMAT STATEMENT SIGNALS THE RETURN TO FORTRAN II         GEFG0027
       REM PROCESSING.                                                  GEFG0028
       REM FORMAT(GENERATOR) STATEMENT TEST                             GEFG0029
B4200  BOOL  4200              FORMAT GENERATOR                         GEFG0030
       ORG     B4200                                                    GEFG0031
 FTEST CLA FFLAG                                                        GEFG0032
       TNZ FMTG               TO GENERATE FORMAT                        GEFG0033
       LXD DCF,1                                                        GEFG0034
       TRA CA018                                                        GEFG0035
       REM                                                              GEFG0036
       REM     CHECK IF THIS IS FOR FORMAT GENERATOR                    GEFG0037
AFMT   SXA     RETRN,1                                                  GEFG0038
       SXA     RETRN+1,4                                                GEFG0039
       AXT     11,2                                                     GEFG0040
       AXT     6,1                                                      GEFG0041
FM1    AXT     6,4                                                      GEFG0042
       LDQ     FT+12,2                                                  GEFG0043
FM2    PXD     0,0                                                      GEFG0044
       LGL     6                                                        GEFG0045
       CAS     BLANK                                                    GEFG0046
       TRA     *+2                                                      GEFG0047
       TRA     FM3                 BLANK-IGNORE                         GEFG0048
       SUB     CHAR+6,1                                                 GEFG0049
       TNZ     RETRN               NO                                   GEFG0050
       TNX     FM4,1,1             YES                                  GEFG0051
FM3    TIX     FM2,4,1                                                  GEFG0052
       TIX     FM1,2,1                                                  GEFG0053
       TXL     RETRN,0,0                                                GEFG0054
       REM     FIRST 6 CHAR=FORMAT BUT IS REST BLANK                    GEFG0055
FM4    TNX     FM5,4,1             CHARACTERS TO FINISH WORD            GEFG0056
       PXD     0,0                                                      GEFG0057
       LGL     6                                                        GEFG0058
       SUB     BLANK                                                    GEFG0059
       TZE     FM4                 YES-BLANK                            GEFG0060
       TRA     RETRN               OTHER CHARACTER                      GEFG0061
FM5    TNX     FM6,2,1             EXAMINE FULL WORDS NOW               GEFG0062
       CLA     FT+12,2                                                  GEFG0063
       SUB     ALBLK                                                    GEFG0064
       TZE     FM5                                                      GEFG0065
       TRA     RETRN                                                    GEFG0066
FM6    SXA     FFLAG,4                                                  GEFG0067
RETRN  AXT     **,1                                                     GEFG0068
       AXT     **,4                                                     GEFG0069
       TRA     1,4                                                      GEFG0070
FFLAG  PZE                         FORMAT FLAG                          GEFG0071
       REM                                                              GEFG0072
       REM  FLAG TEST                                                   GEFG0073
       REM                                                              GEFG0074
 FMTG  STZ FFLAG                                                        GEFG0075
       TSX     SR6DC,1                                                  GEFG0076
       SLW     EFN                                                      GEFG0077
       LXD     EIFNO,1                                                  GEFG0078
       TXI     *+1,1,1                                                  GEFG0079
       SXD     EIFNO,1                                                  GEFG0080
       CAL     EFN                                                      GEFG0081
       TZE     ERR                                                      GEFG0082
       STA EIFNO              RETURN HERE WITH RESULTS IN ACC           GEFG0083
       TSX TET00,1            STORE RESULT IN EIFNO-GO TO PROGRAM       GEFG0084
       PZE 0                  TO ENTER EIFNO INTO TABLE TEIFNO          GEFG0085
       TSX TET00,1           ENTER EIFNO IN                             GEFG0086
       PZE 14                NON EXEC TABLE                             GEFG0087
       AXT     76,4                                                     GEFG0088
       SXD XTL,4                                                        GEFG0089
       STZ TLINE                                                        GEFG0090
       AXT     1000,4                                                   GEFG0091
       SXD XTF,4                                                        GEFG0092
       CAL EIFNO              MOVE EXTERNAL FORMULA NUMBER              GEFG0093
       STA SET                INTO ADDRESS OF SET                       GEFG0094
       CAL SET                AND MOVE SET                              GEFG0095
       SLW G                  INTO G                                    GEFG0096
       TSX TET00,1            MON EIFNO INTO FORMAT TABLE               GEFG0097
       PZE 10                                                           GEFG0098
       REM  MOVE FIRST RECORD INTO BUFFER F BUT PLACE IN FT FIRST       GEFG0099
       TSX CA100,4            FIRST RECORD INTO F                       GEFG0100
       REM  NOW MOVE INTO FT AND PROCEED                                GEFG0101
 NEXT  LXA D12,2                                                        GEFG0102
       CAL FT                                                           GEFG0103
       TZE CFT                TEST FOR EOF                              GEFG0104
       LXD DCF,1                                                        GEFG0105
       LDQ FT+12,2                                                      GEFG0106
       STQ 0,1                                                          GEFG0107
Q1     TIX Q1+1,1,1                                                     GEFG0108
       TIX Q1-2,2,1                                                     GEFG0109
       TSX CA100,4            GO READ NEXT NON-BLANK CARD               GEFG0110
       PXD 0,0                TEST IF FIRST CHAR IS X                   GEFG0111
       LDQ FT                 FOR CONTINUATION                          GEFG0112
       LGL 6                  TO 120 COLUMNS                            GEFG0113
       SUB L(X)               FIRST COL SHOULD ALWAYS BE                GEFG0114
Q2     TNZ Q2+9              BLANK OR-IF SO CONTINUE                    GEFG0115
       LXA D8,2               TO STORE NEXT 48 COLUMNS                  GEFG0116
       LGL 30                 MOVE INTO BUFFER                          GEFG0117
       LDQ FT+9,2             REGION BUT NOT MORE THAN                  GEFG0118
       LGL 6                  A TOTAL OF 20 WORDS                       GEFG0119
       SLW 0,1                MAY BE USED=120 COL                       GEFG0120
       TIX Q3,1,1                                                       GEFG0121
Q3     TIX Q3-5,2,1                                                     GEFG0122
       TSX CA100,4            READ NEXT RECORD INTO BUFFER              GEFG0123
       CLA ALBLK              FIND LAST NON-BLANK WORD                  GEFG0124
       CAS -1,1                                                         GEFG0125
Q4     TRA Q4+2                                                         GEFG0126
       TXI Q4-1,1,1                                                     GEFG0127
       LDQ ALL1S              PLACE END MARK OF ALL 1S                  GEFG0128
       STQ 0,1                FOLLOWING LAST NON BLANK WORD             GEFG0129
       REM  STATEMENT HAS BEEN PLACED IN BUFFER AND IS NOW              GEFG0130
       REM  READY TO BE EXAMINED TO SEE IF STATEMENT IS                 GEFG0131
       REM      SPACE N                                                 GEFG0132
       REM      REPEAT N,A                                              GEFG0133
       REM      RESTORE                                                 GEFG0134
       REM      END OF OUTPUT                                           GEFG0135
       REM  ANY VARIATION FROM THESE WILL INDICATE THE STATEMENT        GEFG0136
       REM  TO BE FORMAT AND INTERPRETED AS SUCH.                       GEFG0137
       LXD DCF,4                                                        GEFG0138
       CLA 0,4                AND IMAGE SET UP                          GEFG0139
       SXD FWA,4                                                        GEFG0140
       STO RESDU                                                        GEFG0141
       LXA D7,4               7 TO START CHARACTER COUNT                GEFG0142
       SXD CHCTR,4                                                      GEFG0143
       CLA BLANK              FIND FIRST 5 NON-BLANK                    GEFG0144
       ALS 6                  CHARACTERS AND TEST IF                    GEFG0145
Q5     TOV Q5+1                                                         GEFG0146
       TSX FINDC,4            SRT TO SEARCH FOR NON-BLANKS              GEFG0147
       LXA D8,2                                                         GEFG0148
       CLA TEMP               5 CHARACTERS RIGHT-POSITIONED             GEFG0149
       CAS DICT+8,2           PRECEEDED BY BLANK                        GEFG0150
Q6     TRA Q6+2                                                         GEFG0151
       TRA TDICT+8,2          FOUND ONE OF THEM                         GEFG0152
       TIX Q6-1,2,2                                                     GEFG0153
 PARAM TSX ADDLT,4            ADD A LINE TO THE TABLE                   GEFG0154
       REM  FORMAT MUST BE EXAMINED CHARACTER BY CHARACTER              GEFG0155
       LXD DCF,4              INITIALIZE IR FOR IMAGE                   GEFG0156
       SXD FWA,4                                                        GEFG0157
       LDQ 0,4                                                          GEFG0158
       STQ RESDU                                                        GEFG0159
       LXA D7,4               7 TO START CHARACTER COUNT                GEFG0160
       SXD CHCTR,4                                                      GEFG0161
       STZ BCTR               CLEAR BLANK COUNTER                       GEFG0162
       STZ HCTR               CLEAR HOLLERITH COUNTER                   GEFG0163
       STZ BCIND              BCI INDICATOR                             GEFG0164
 PARS  STZ SHOLT              TEMP FOR BCI STORAGE                      GEFG0165
       STZ BCIX               SHIFT COUNT FOR BCI CHARACTER             GEFG0166
       LXA D21,4                                                        GEFG0167
       SXD BCIX+1,4           BCI WORDS/LINE                            GEFG0168
       STZ PPCTR              CLEAR PRINT POSITION COUNTER              GEFG0169
       REM  EXAMINE CHARACTER                                           GEFG0170
 PAR1  TSX PICK,4             SELECT NEXT CHARACTER                     GEFG0171
       REM  TEST IF'(14), ENDMARK (77) OR BCD CHARACTER                 GEFG0172
       CAS ARROW                                                        GEFG0173
Q7     TRA Q7+2                                                         GEFG0174
       TRA PAR5               TO PARAMETER CONVERSION                   GEFG0175
       CAS O77                END MARK                                  GEFG0176
Q8     TRA Q8+2                                                         GEFG0177
       TRA EORP               END OF RECORD                             GEFG0178
       REM  BCD (HOLLERITH)                                             GEFG0179
       CAS BLANK              IF BLANK                                  GEFG0180
Q9     TRA Q9+2              NO                                         GEFG0181
       TRA PAR4               YES-GO COUNT BLANKS                       GEFG0182
       REM  NON-BLANK BCD CHARACTER                                     GEFG0183
       STO BCIND              TURN BCIND ON                             GEFG0184
       CLA HCTR               HOLLERITH COUNTER                         GEFG0185
       ADD BCTR               AND BLANKS IF ANY                         GEFG0186
       STZ BCTR               CLEAR BLANK COUNTER                       GEFG0187
       ADD D1                                                           GEFG0188
       STO HCTR               AND STORE                                 GEFG0189
       REM  IF CHARACTER IS 0, MUST STORE SOMETHING ELSE IN BCIND       GEFG0190
 PAR2  CLA BCIND                                                        GEFG0191
       TNZ PAR3                                                         GEFG0192
       CLA D1                                                           GEFG0193
       STO BCIND                                                        GEFG0194
       PXD 0,0                                                          GEFG0195
 PAR3  TSX SHOL,4             STORE THE CHARACTER IN THE                GEFG0196
       TRA PAR1               HOLLERITH IMAGE FOR FUTURE USE            GEFG0197
       REM  IF BLANK COUNT AND RETURN TO STORE IN TABLE                 GEFG0198
 PAR4  CLA BCTR               INCREASE BLANK COUNT                      GEFG0199
       ADD D1                                                           GEFG0200
       STO BCTR                                                         GEFG0201
       CLA BLANK                                                        GEFG0202
       TRA PAR3                                                         GEFG0203
       REM '(ARROW) FOR PARAMETER                                       GEFG0204
       REM  CHECK IF BCD TO BE STORED                                   GEFG0205
 PAR5  CLA BCIND                                                        GEFG0206
       TZE PAR51                                                        GEFG0207
       STZ BCIND              TURN BCIND OFF                            GEFG0208
       CLA HCTR                                                         GEFG0209
       TZE PAR51              NO BLANK HOLLERITH                        GEFG0210
       TSX SHOLP,4            STORE THE HOLLERITH IN FORMAT TABLE       GEFG0211
       STZ HCTR               CLEAR HCTR                                GEFG0212
 PAR51 CLA BCTR               SET PRINT POSITION                        GEFG0213
       STZ BCTR               COUNTER EQUAL                             GEFG0214
       STO PPCTR              BLANK COUNTER                             GEFG0215
 PAR6  CLA PPCTR                                                        GEFG0216
       ADD D1                 ADD 1 TO PRINT POSITION                   GEFG0217
       STO PPCTR              FOR ' CHARACTER                           GEFG0218
       REM  PREPARE TO CONVERT PARAMETER                                GEFG0219
       CLA TAG1                                                         GEFG0220
       STO TAG                                                          GEFG0221
       STZ TEMP               CONSTRUCTED ENTRY FOR PARAM TABLE         GEFG0222
       PXD 0,0                                                          GEFG0223
 PAR7  STO DIGT               DIGIT OF SCALE FACTOR                     GEFG0224
       CLA PPCTR              INCREASE PRINT POSITION                   GEFG0225
       ADD D1                 COUNTER FOR NEXT CHARACTER                GEFG0226
       STO PPCTR                                                        GEFG0227
       TSX PICK,4             NEXT CHARACTER                            GEFG0228
       CAS D10                                                          GEFG0229
       TRA PAR71                                                        GEFG0230
       NOP                                                              GEFG0231
       STO TEMP+1             MULTIPLY BY 10                            GEFG0232
       CLA DIGT               AND ADD INTEGER                           GEFG0233
       ALS 1                                                            GEFG0234
       STO DIG                                                          GEFG0235
       ALS 2                                                            GEFG0236
       ADD DIG                                                          GEFG0237
       ADD TEMP+1                                                       GEFG0238
       TRA PAR7                                                         GEFG0239
       REM  COMPLETED CONVERSION OF DIGIT, IF ANY. NOW HAVE NEXT CER    GEFG0240
 PAR8  CAS O47                P=SCALING FACTOR                          GEFG0241
       TRA PAR81                                                        GEFG0242
Q10    TRA Q10+2                                                        GEFG0243
       TRA PAR81                                                        GEFG0244
       LDQ DIGT                                                         GEFG0245
       MPY D100                                                         GEFG0246
       STQ TEMP               100 X SCALING FACTOR                      GEFG0247
       CLA TAG                P INDICATOR=SCALING FACTOR                GEFG0248
       ORS TEMP                                                         GEFG0249
       REM  MUST NOW LOOK AT NEXT CHARACTER - COULD BE E OR F OR I      GEFG0250
       CLA PPCTR                                                        GEFG0251
       ADD D1                                                           GEFG0252
       STO PPCTR                                                        GEFG0253
       TSX PICK,4             NEXT CHARACTER                            GEFG0254
PAR81  AXT     7,4                                                      GEFG0255
       CAS     IFE+7,4                                                  GEFG0256
Q11    TRA Q11+2                                                        GEFG0257
       TRA     PAR85+7,4                                                GEFG0258
Q12    TIX Q12-3,4,1                                                    GEFG0259
       TRA ERR                ERROR                                     GEFG0260
       REM                                                              GEFG0261
 PAR71 CAS PLUS                                                         GEFG0262
Q35    TRA Q35+2                                                        GEFG0263
       TRA PAR7+1                                                       GEFG0264
       CAS MINUS                                                        GEFG0265
       TRA PAR8                                                         GEFG0266
Q36    TRA Q36+2                                                        GEFG0267
       TRA PAR8                                                         GEFG0268
       CLA TAG5               NEGATIVE                                  GEFG0269
       STO TAG                                                          GEFG0270
       TRA PAR7+1                                                       GEFG0271
PAR85  TRA FPARA                                                        GEFG0272
       TRA EPARA                                                        GEFG0273
       TRA IPARA                                                        GEFG0274
       TRA APARA                                                        GEFG0275
       TRA OPARA                                                        GEFG0276
       TRA XPARA                                                        GEFG0277
       TRA     GPARA                                                    GEFG0278
       REM                                                              GEFG0279
APARA  CLA ARAPA              A CODE                                    GEFG0280
       TRA IPARA+1                                                      GEFG0281
OPARA  CLA ARAPO              O CODE                                    GEFG0282
       TRA IPARA+1                                                      GEFG0283
XPARA  CLA ARAPX              X CODE                                    GEFG0284
       TRA IPARA+1                                                      GEFG0285
GPARA  CLA     ARAPG             G CODE                                 GEFG0286
       TRA     PAR13                                                    GEFG0287
       REM  I=INTEGER - CONSTRUCT ENTRY FOR PARAMETER TABLE             GEFG0288
 IPARA CLA THR                PREFIX THR=I                              GEFG0289
       ORS TEMP                                                         GEFG0290
       REM  ENTRY HERE TO PRODUCE PP AND PLACE ENTRY IN TABLE           GEFG0291
 PAR9  CAL PPCTR              PLACE PRINT POSITION                      GEFG0292
       ALS 18                 IN DECREMENT FOR                          GEFG0293
       ACL TEMP               ENTRY TO PARAM TABLE                      GEFG0294
       TSX ADDFT,4                                                      GEFG0295
       TRA PARS                                                         GEFG0296
       REM  E=FLOATING POINT - CONSTRUCT ENTRY FOR PARAMETER TABLE      GEFG0297
 EPARA CLA TWO                PREFIX TWO=E                              GEFG0298
 PAR13 ORS TEMP                                                         GEFG0299
       REM  MUST LOOK FOR DIGIT NOW                                     GEFG0300
       STZ DIGT                                                         GEFG0301
 PAR10 TSX PICK,4             NEXT CHARACTER                            GEFG0302
       CAS D10                IS DIGIT                                  GEFG0303
       TRA PAR11              OTHER ALPHA CHARACTER                     GEFG0304
       NOP                                                              GEFG0305
       STO DIG                YES - DIGIT                               GEFG0306
       CLA DIGT               MULTIPLY BY 10                            GEFG0307
       ALS 1                                                            GEFG0308
       STO TEMP+1                                                       GEFG0309
       ALS 2                                                            GEFG0310
       ADD TEMP+1                                                       GEFG0311
       ADD DIG                                                          GEFG0312
       STO DIGT                                                         GEFG0313
       CLA PPCTR              INCREASE PRINT POSITION                   GEFG0314
       ADD D1                 COUNTER                                   GEFG0315
       STO PPCTR                                                        GEFG0316
       TRA PAR10                                                        GEFG0317
       REM  END OF DIGIT                                                GEFG0318
 PAR11 STO TEMP+1             NEXT CHARACTER                            GEFG0319
       CLA PPCTR              PRINT POSITION INTO                       GEFG0320
       ALS 18                 DECREMENT                                 GEFG0321
       ADD TEMP                                                         GEFG0322
       ACL DIGT               DP                                        GEFG0323
       TSX ADDFT,4            PLACE ENTRY IN TABLE                      GEFG0324
       STZ PPCTR                                                        GEFG0325
       STZ SHOLT                                                        GEFG0326
       STZ BCIX                                                         GEFG0327
       LXA D21,4                                                        GEFG0328
       SXD BCIX+1,4                                                     GEFG0329
       CLA TEMP+1             NEXT CHARACTER                            GEFG0330
       TRA PAR1+1             NEXT PARAMETER                            GEFG0331
       REM  F=FIXED POINT - CONSTRUCT ENTRY FOR PARAMETER TABLE         GEFG0332
 FPARA CLA ONE                PREFIX ONE=F                              GEFG0333
       TRA PAR13              GO TO EPARA FOR DP,ETC.                   GEFG0334
       REM  END OF RECORD                                               GEFG0335
       REM  CHECK BCIND AND STORE END OF LINE FORMAT                    GEFG0336
 EORP  CLA BCIND                                                        GEFG0337
       TZE PAR12              NO BCD                                    GEFG0338
       CLA HCTR               HOLLERITH                                 GEFG0339
       TZE PAR12              NO NON-BLANK HOLLERITH                    GEFG0340
       TSX SHOLP,4            STORE THE HOLLERITH IN TABLE              GEFG0341
 PAR12 CLA DBITS              CONSTRUCT END OF LINE                     GEFG0342
       TSX ADDFT,4            FORMAT                                    GEFG0343
       REM  GO GET NEXT RECORD TO EXAMINE                               GEFG0344
       TRA NEXT                                                         GEFG0345
       REM  SRT PICK - TO SELECT NEXT CHARACTER                         GEFG0346
 PICK  SXD PIC4,4                                                       GEFG0347
       SXD PIC5,2                                                       GEFG0348
       LXD FWA,4                                                        GEFG0349
       LXD CHCTR,2                                                      GEFG0350
       LDQ RESDU                                                        GEFG0351
       TIX PIC1,2,1                                                     GEFG0352
       LXA D6,2                                                         GEFG0353
       TNX ERR,4,1            ERROR                                     GEFG0354
       LDQ 0,4                                                          GEFG0355
       CLA 0,4                                                          GEFG0356
       SUB ALL1S                                                        GEFG0357
       TZE PIC3                                                         GEFG0358
 PIC1  PXD 0,0                                                          GEFG0359
       LGL 6                                                            GEFG0360
 PIC2  STQ RESDU                                                        GEFG0361
       SXD CHCTR,2                                                      GEFG0362
       SXD FWA,4                                                        GEFG0363
       LXD PIC4,4                                                       GEFG0364
       LXD PIC5,2                                                       GEFG0365
       TRA 1,4                                                          GEFG0366
       REM  ENDMARK - PUT ENDMARK CHARACTER IN ACCUMULATOR              GEFG0367
 PIC3  CLA O77                                                          GEFG0368
 PIC4  TXL PIC2,0,0                                                     GEFG0369
 PIC5  PZE                                                              GEFG0370
       REM  STORE HOLLERITH CHARACTERS IN TABLE - RIGHT POSITIONEDCTER IGEFG0371
       REM  ACCUMULATOR AT ENTER                                        GEFG0372
 SHOL  LXD BCIX,1                                                       GEFG0373
       ALS 30,1                                                         GEFG0374
       ACL SHOLT                                                        GEFG0375
       TXI SHOL1-1,1,6       SHIFT CHARACTER                            GEFG0376
       TXH SHOL2,1,30         TEST 6 CHARACTERS DONE                    GEFG0377
 SHOL1 SLW SHOLT              NO                                        GEFG0378
       SXD BCIX,1                                                       GEFG0379
       TRA 1,4                                                          GEFG0380
       REM  FULL WORD GENERATED                                         GEFG0381
 SHOL2 LXD BCIX+1,2                                                     GEFG0382
       SLW F+50,2                                                       GEFG0383
       TNX ERR,2,1            ERROR                                     GEFG0384
       PXD 0,0                                                          GEFG0385
       PDX 0,1                CLEAR XR1                                 GEFG0386
       SXD BCIX+1,2                                                     GEFG0387
       TRA SHOL1                                                        GEFG0388
 SHOLT PZE                                                              GEFG0389
       PZE                                                              GEFG0390
       REM  SHOLP - PLACE BCD FROM F TABLE TO FORMAT TABLE              GEFG0391
       REM  COMPUTE NUMBER OF CHARACTERS OF BCI AND STORE ACCORDIN      GEFG0392
       REM  NUMBER OF CHARACTERS IN FIRST LOCATION FOLLOWED BY BCD      GEFG0393
 SHOLP SXD SHP0,4                                                       GEFG0394
       CLA HCTR                                                         GEFG0395
       TSX ADDFT,4                                                      GEFG0396
       LXD BCIX+1,2                                                     GEFG0397
