       REM                   10 DIGIT SINE-COSINE ROUTINE FOR 709       SIN2 001
       REM                   CALLING SEQUENCE...TSX SIN,4               SIN2 002
       REM                   ... INPUT SCALE... HTR 0 OR 1              SIN2 003
       REM                   ...ERROR RETURN                            SIN2 004
       REM                   ... NORMAL RETURN                          SIN2 005
   SIN SXA SAVE,1            SAVE XR1                                   SIN2 006
       STO SIGN              SAVE XR 1                                  SIN2 007
       CLA 1,4               INPUT SCALE  B                             SIN2 008
       ADD THFVE             35 + B                                     SIN2 009
       TMI LOW               RETURN WITH ARGUMENT OR 1                  SIN2 010
       PAX 0,1                                                          SIN2 011
       CAL SIGN                                                         SIN2 012
       ALS 2                 AC POSITIVE                                SIN2 013
       LDQ THFVE             SET MQ (ALMOST TO ZERO)                    SIN2 014
       TXL SPEC,1,34         B SMALLER 0, ANGLE SMALLER THAN 1/2 RAD.   SIN2 015
       TXH LNGDV,1,39        B LARGER 4, ANGLE LARGER, EQUAL 16         SIN2 016
       LRS 42,1              B5                                         SIN2 017
 VARDV VDH PIHLF,0,4         PIHLF B1, BQ 35, B REM. 1                  SIN2 018
       REM                   FOR SIN OR COS ... ERROR RETURN            SIN2 019
       SUB PIQU              REDUCE TO FIRST QUADRANT                   SIN2 020
       TPL EQUA              COMPUTE EQUIVALENT ANGLE                   SIN2 021
       ADD PIHLF                                                        SIN2 022
  EQUA SUB PIQU              EQUIVALENT ANGLE, SIGN AC NEGATIVE         SIN2 023
       ALS 1                 B0                                         SIN2 024
       SLW COMMON                                                       SIN2 025
       ZET 2,4                                                          SIN2 026
       STZ SIGN              COS REQUESTED, SET SIGN POSITIVE           SIN2 027
       XCA                   SIN REQUESTED                              SIN2 028
       ACL 2,4               00... SIN, 01... COS, 10...-SIN, 11...-COS SIN2 029
       AXT 1,1               1 TO XR 1                                  SIN2 030
       TQP A                                                            SIN2 031
     B LBT                                                              SIN2 032
       TRA A+2               COS                                        SIN2 033
       TXI A+2,1,-1                                                     SIN2 034
     A LBT                                                              SIN2 035
       TXI A+2,1,-1          USE SIN FORMULA                            SIN2 036
       ARS 1                 TEST NEXT BIT                              SIN2 037
       LBT                   WHICH DETERMINES THE SIGN                  SIN2 038
       TRA COMCA             CALCULATE CONTINUED FRACTION               SIN2 039
       CLS SIGN              CHANGE THE SIGN                            SIN2 040
       STO SIGN                                                         SIN2 041
 COMCA LDQ COMMON            B0, XR...0 GIVES SINE, XR...1 GIVES COSINE SIN2 042
       MPR COMMON                                                       SIN2 043
       LRS 1                 B1 FOR SIN,  B1 FOR COS                    SIN2 044
       STO ZSQ                                                          SIN2 045
       ADD CONST+1,1         .8527B1,   .393 B1                         SIN2 046
       STO COMMON+1                                                     SIN2 047
       CLA CONST+3,1         2111.4B13,   4228.3B15                     SIN2 048
       DVH COMMON+1                                                     SIN2 049
       STQ COMMON+1          B12, B14                                   SIN2 050
       CLA ZSQ               B1,   B1                                   SIN2 051
       LRS 11                B12,   B12                                 SIN2 052
       TXL C,1,0                                                        SIN2 053
       LRS 2                 B12,   B14                                 SIN2 054
     C ADD CONST+5,1         70.85 B12, 105.94 B14                      SIN2 055
       ADD COMMON+1          B12, B14                                   SIN2 056
       STO COMMON+1                                                     SIN2 057
       LDQ VAR9F+1,1                                                    SIN2 058
       VLM ZSQ,0,14                                                     SIN2 059
       ADD CONST+7,1         -337.7B12, 6334.0 B15                      SIN2 060
       DVH COMMON+1          B0, B1                                     SIN2 061
       XCA                                                              SIN2 062
       SUB ZSQ+1,1           +.1483B0,   -ZSQ B1                        SIN2 063
       ADD CONST+9,1         .9999B0, .41656B1                          SIN2 064
       REM                   SINZ/Z OR COSZ READY IN AC, B0 OR B1       SIN2 065
 TSOUT TXL SOUT,1,0          COMPUTE SINE                               SIN2 066
       SUB ZSQ               SECOND ZSQ                                 SIN2 067
       LDQ SIGN              FIX SIGN                                   SIN2 068
       LLS 2,1               0 FOR SIN, 1 FOR COS                       SIN2 069
  SAVE AXT ..,1              RESTORE XR 1                               SIN2 070
  FINI TRA 4,4               RETURN                                     SIN2 071
  SOUT STO COMMON+1          COMPUTE SINE                               SIN2 072
       LDQ COMMON                                                       SIN2 073
       TQP SOUT+4            SCALE OF PRODUCT WILL BE B0                SIN2 074
       LDQ SIGN              SINE EVALUATED WITH GIVEN                  SIN2 075
       MPR COMMON+1          FRACTION FOR GREATER SIGNIFICANCE          SIN2 076
       TXI TSOUT+2,1,2       2 TO XR1                                   SIN2 077
 LNGDV TXH ERR,1,70          ERROR RETURN IF B LARGER THAN 35           SIN2 078
       LRS 73,1              B36                                        SIN2 079
       DVH PIHLF                                                        SIN2 080
       TRA VARDV+1                                                      SIN2 081
  SPEC LRS 37,1              B0                                         SIN2 082
       SSM                   INDICATE PASSAGE THROUGH SPECIAL           SIN2 083
       STO COMMON                                                       SIN2 084
       CLA 2,4               0... SIN, 1... COS                         SIN2 085
       PAX 0,1                                                          SIN2 086
       TXL COMCA,1,0                                                    SIN2 087
       STZ SIGN              SET SIGN POS. FOR COMCA                    SIN2 088
       TRA COMCA                                                        SIN2 089
   LOW CLA 2,4               SIN SET EQUAL TO ARGUMENT                  SIN2 090
       PAX 0,1               COS RETURN WITH ONE                        SIN2 091
       CLA SIGN,1            ARG. FOR SINE, 1-EPSILON FOR COS           SIN2 092
       TRA FINI-1                                                       SIN2 093
   ERR TXI FINI-1,4,1        ERROR - RETURN                             SIN2 094
 THFVE DEC 35                CONSTANTS                                  SIN2 095
 PIHLF DEC 1.5707963268B1                                               SIN2 096
  PIQU DEC .78539816340B1                                               SIN2 097
 CONST DEC .393311849248B1,.8527133685845B1,4228.3056424B15             SIN2 098
       DEC 2111.487369067B13,105.940682526B14,70.8525969147B12          SIN2 099
       DEC 6334.05984123B15,-377.73442096B12,.4165629210B1              SIN2 100
       OCT 377777777777                                                 SIN2 101
  SIGN PZE                                                              SIN2 102
   ZSQ OCT 0,445756247060    0,-.1483026609B0                           SIN2 103
 VAR9F OCT 000000000522                                                 SIN2 104
       OCT 000000000060                                                 SIN2 105
