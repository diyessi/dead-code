TAVILB REM 0071 05200                                                   VILB0001
       REM    *** INSERT LEADING BLANKS ***                             VILB0002
X..ILB LTM                          CALL                                VILB0003
       SXD XILB.8-1,4               TSX X..ILB,4                        VILB0004
       SXD XUSETA+1,1               PZE C                               VILB0005
       SXD XUSETA+2,2               TABLE                               VILB0006
       CLA 1,4                      PZE A1,I1,R1                        VILB0007
       COM                          PZE N1                              VILB0008
       PAX ,4           -1-C        PZE A2,I2,R2                        VILB0009
XILB.5 SXD XUSETA+3,4               PZE N2                              VILB0010
       CAL -1,4                                                         VILB0011
       ANA XILB12                                                       VILB0012
       ORA XILB13                                                       VILB0013
       SLW *+1                                                          VILB0014
       SXD 00                                                           VILB0015
       CLA -1,4                     ...                                 VILB0016
       COM                          PZE AQ,IQ,RQ                        VILB0017
       PAX ,2           C(IR2)=-1-A MZE NQ                              VILB0018
XILB14 TXI *+1,2,00     -1-A+(I)                                        VILB0019
       PDX ,1           R                                               VILB0020
       TXI *+1,1,8      C(IR2)=7-R                                      VILB0021
       CAL XILB10+6,1                                                   VILB0022
       SLW COMMON       R-1 LEAD BCD ZEROS                              VILB0023
       CLA XUSETA+6,1                                                   VILB0024
       STA XILB.1                                                       VILB0025
       LDQ -1,2                                                         VILB0026
XILB.1 RQL 00           POSITION 1ST CHAR                               VILB0027
       CLA 0,4                                                          VILB0028
       PAX ,4           C(IR4)=N                                        VILB0029
       PXD ,0                                                           VILB0030
XILB.4 LGL 6            BEGIN TEST LOOP                                 VILB0031
       TNZ XILB.2       NON-ZERO CHAR EXIT                              VILB0032
       TNX XILB.3,4,1   END OF FIELD EXIT                               VILB0033
       TIX XILB.4,1,1   END OF WORD TEST                                VILB0034
       CAL COMMON                                                       VILB0035
       ORS -1,2                                                         VILB0036
       LDQ XILB10                                                       VILB0037
       STQ COMMON                                                       VILB0038
       LDQ 0,2          LOAD NEXT WORD                                  VILB0039
       TXI *+1,1,5                                                      VILB0040
       TXI XILB.4-1,2,-1 STEP ADDRESS                                   VILB0041
XILB.3 TXI XILB.8,1,-1  ADJUST 7-R COUNT                                VILB0042
XILB.2 ANA XUMSK1       STRIP ZONE                                      VILB0043
       TZE XILB.4+2     ZERO IF BLANK,PLUS,MINUS                        VILB0044
       SUB XU..10                                                       VILB0045
       TNZ XILB.8       ZERO IF PL ZERO,MI ZERO                         VILB0046
       CAL XILB.9+6,1   SET CHAR=0                                      VILB0047
       ANS -1,2                                                         VILB0048
       TXI XILB.4+2,,00 IR4                                             VILB0049
XILB.8 CAL XILB.7+6,1                                                   VILB0050
       ANA COMMON                                                       VILB0051
       ORS -1,2         OR BLANKS TO LAST WORD                          VILB0052
       LXD XUSETA+3,4                                                   VILB0053
       CLA 0,4                                                          VILB0054
       LXD XUSETA+1,1                                                   VILB0055
       LXD XUSETA+2,2                                                   VILB0056
       TMI *+2          TEST FOR LAST COUPLET                           VILB0057
       TXI XILB.5,4,-2                                                  VILB0058
       LXD XILB.8-1,4                                                   VILB0059
       TIX X..HEJ,4,2   RETURN 2,4                                      VILB0060
XILB.7 OCT 000000000000,600000000000                                    VILB0061
       OCT 606000000000,606060000000                                    VILB0062
       OCT 606060600000,606060606000                                    VILB0063
XILB10 OCT 606060606060,006060606060                                    VILB0064
       OCT 000060606060,000000606060                                    VILB0065
       OCT 000000006060,000000000060                                    VILB0066
XILB.9 OCT 007777777777,770077777777                                    VILB0067
       OCT 777700777777,777777007777                                    VILB0068
       OCT 777777770077,777777777700                                    VILB0069
XILB12 PZE 0,7,0                                                        VILB0070
XILB13 SXD XILB14,0                                                     VILB0071
