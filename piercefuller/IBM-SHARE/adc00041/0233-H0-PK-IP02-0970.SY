C     LINEAR PROGRAMMING, INTEGER SOLUTIONS, S5-5 CODE                PKIP020001
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP020002
     1,KC1,BND,ALPHA                                                    IP020003
      DIMENSION A(204,104),LT(104),B(104),KC(104),JORDER(104),JZEROS(104IP020004
     1),KR(204),U(204),D(204),INDEX(204),ALPHA(3)                       IP020005
      LLL=1                                                             IP020006
   26 IF (LLL)160,160,170                                               IP020007
  144 PRINT 154, ALPHA                                                  IP020008
      PAUSE 6                                                           IP020009
  170 IF (SENSE SWITCH 3)1,2                                            IP020010
    1 READ 3,ALPHA,M,N,BND,LL2,LL6,LL7,LL8,LLB,LL4,LL5                  IP020011
      GO TO 4                                                           IP020012
    2 READ INPUT TAPE 7,3,ALPHA,M,N,BND,LL2,LL6,LL7,LL8,LLB,LL4,LL5     IP020013
    4 IF (M)160,160,161                                                 IP020014
  160 END FILE 8                                                        IP020015
      PRINT 155                                                         IP020016
      STOP                                                              IP020017
  161 K2=-1                                                             IP020018
  163 PRINT 152,LLL,ALPHA                                               IP020019
      LLL=LLL+1                                                         IP020020
      NUM=0                                                             IP020021
      LI6=LL6                                                           IP020022
      LI7=LL7                                                           IP020023
      LI8=LL8                                                           IP020024
      NN=N-1                                                            IP020025
      WRITE OUTPUT TAPE 8,5,ALPHA                                       IP020026
      CALL SETUP                                                        IP020027
      IF (LL4)28,28,29                                                  IP020028
   28 CALL MOUT                                                         IP020029
   29 IF (BND)125,125,31                                                IP020030
   31 CALL DUFS                                                         IP020031
      IF (LLB)126,126,125                                               IP020032
  126 WRITE OUTPUT TAPE 8,132                                           IP020033
      CALL MOUT                                                         IP020034
  125 CALL PRANK                                                        IP020035
  127 CALL RWRNK                                                        IP020036
      CALL RWSL                                                         IP020037
      IF (K2)11,12,999                                                  IP020038
  999 STOP 1                                                            IP020039
   11 NUM=NUM+1                                                         IP020040
      CALL PIV1                                                         IP020041
      IF (KC1) 162,162,164                                              IP020042
  162 WRITE OUTPUT TAPE 8,157,ALPHA                                     IP020043
      CALL MOUT                                                         IP020044
      GO TO 26                                                          IP020045
  164 CALL NURO                                                         IP020046
      IF (LL7-NUM)13,14,13                                              IP020047
   14 LL7=LL7+LI7                                                       IP020048
      WRITE OUTPUT TAPE 8,15,NUM,I1,J1                                  IP020049
      WRITE OUTPUT TAPE 8,16,(B(J),J=1,N)                               IP020050
   13 CALL PIV                                                          IP020051
      IF (SENSE SWITCH 1)130,131                                        IP020052
  130 PRINT 19,NUM,A(1,1),A(2,1),A(3,1)                                 IP020053
  131 IF (LL8-NUM)17,18,17                                              IP020054
   18 LL8=LL8+LI8                                                       IP020055
      WRITE OUTPUT TAPE 8,19,NUM,A(1,1),A(2,1),A(3,1)                   IP020056
   17 IF (SENSE SWITCH 2) 171,30                                        IP020057
   30 IF (LL2-NUM)20,21,20                                              IP020058
   20 IF (LL6-NUM)25,22,25                                              IP020059
   22 LL6=LL6+LI6                                                       IP020060
      CALL MOUT                                                         IP020061
   25 CALL RANK                                                         IP020062
      GO TO 127                                                         IP020063
  171 PRINT 153                                                         IP020064
      PAUSE 2                                                           IP020065
   21 WRITE OUTPUT TAPE 8,23,NUM                                        IP020066
   34 IF (LL5)32,32,33                                                  IP020067
   33 WRITE OUTPUT TAPE 8,35,ALPHA,A(1,1)                               IP020068
      WRITE OUTPUT TAPE 8,36,(I,A(I,1),I=2,M1)                          IP020069
  141 IF (K2) 129,26,999                                                IP020070
  129 IF (SENSE SWITCH 6) 140,26                                        IP020071
  140 CALL SAVCOR (1)                                                   IP020072
      IF (SENSE SWITCH 6) 144,142                                       IP020073
  142 LLL=0                                                             IP020074
      WRITE OUTPUT TAPE 8,156,ALPHA,NUM                                 IP020075
      GO TO 20                                                          IP020076
   32 CALL MOUT                                                         IP020077
      GO TO 141                                                         IP020078
   12 WRITE OUTPUT TAPE 8,27,NUM                                        IP020079
      GO TO 34                                                          IP020080
