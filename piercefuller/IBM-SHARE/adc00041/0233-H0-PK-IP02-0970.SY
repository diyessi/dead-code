      SUBROUTINE SETUP                                                  IP020102
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP020103
     1,KC1,BND,ALPHA                                                    IP020104
      DIMENSION A(204,104),LT(104),B(104),KC(104),JORDER(104),JZEROS(104IP020105
     1),KR(204),U(204),D(204),INDEX(204),ALPHA(3)                       IP020106
      M1=M+NN                                                           IP020107
      DO 5 J=1,N                                                        IP020108
      DO 5 I=1,M1                                                       IP020109
    5 A(I,J)=0.0                                                        IP020110
      IF (SENSE SWITCH 3)6,7                                            IP020111
    6 READ 3,I,J,AA                                                     IP020112
      IF (I)999,10,4                                                    IP020113
  999 STOP 1                                                            IP020114
    4 A(I,J)=AA                                                         IP020115
      GO TO 6                                                           IP020116
    7 READ INPUT TAPE 7,3,I,J,AA                                        IP020117
      IF (I)999,10,11                                                   IP020118
   11 A(I,J)=AA                                                         IP020119
      GO TO 7                                                           IP020120
   10 I=M+1                                                             IP020121
      DO 12 J=2,N                                                       IP020122
      A(I,J)=-1.0                                                       IP020123
      LT(J)=I                                                           IP020124
   12 I=I+1                                                             IP020125
      LT(1)=0                                                           IP020126
      RETURN                                                            IP020127
    3 FORMAT (2I5,F10.5)                                                IP020128
      END (0,1,0,0,0)                                                   IP020129
      SUBROUTINE MOUT                                                   IP020130
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP020131
     1,KC1,BND,ALPHA                                                    IP020132
      DIMENSION A(204,104),LT(104),B(104),KC(104),JORDER(104),JZEROS(104IP020133
     1),KR(204),U(204),D(204),INDEX(204),ALPHA(3)                       IP020134
      LB=1                                                              IP020135
      LO=1                                                              IP020136
      MX=14                                                             IP020137
   11 K=1                                                               IP020138
      MX=XMIN0F(N,MX)                                                   IP020139
      LL=1                                                              IP020140
      LU=56                                                             IP020141
    8 LU=XMIN0F(M1,LU)                                                  IP020142
      WRITE OUTPUT TAPE 8,3,K,LB,M1,N,ALPHA,(LT(J),J=LO,MX)             IP020143
      WRITE OUTPUT TAPE 8,7                                             IP020144
      DO 12 I=LL,LU                                                     IP020145
   12 WRITE OUTPUT TAPE 8,4,I,(A(I,J),J=LO,MX)                          IP020146
      IF (M1-LU)999,5,6                                                 IP020147
  999 STOP 1                                                            IP020148
    6 LL=LU+1                                                           IP020149
      LU=LU+56                                                          IP020150
      K=K+1                                                             IP020151
      GO TO 8                                                           IP020152
    5 IF (N-MX)999,9,10                                                 IP020153
   10 LO=MX+1                                                           IP020154
      MX=MX+14                                                          IP020155
      LB=LB+1                                                           IP020156
      GO TO 11                                                          IP020157
    9 RETURN                                                            IP020158
    3 FORMAT (12H1SUBMATRIX (I1,1H,I1,4H) OFI3,2H XI3,7H MATRIX65X,3A6/1IP020159
     1H04X,6HCOLUMNI4,13I8)                                             IP020160
    7 FORMAT (4H ROW)                                                   IP020161
    4 FORMAT (1H I3,3X,14F8.0)                                          IP020162
      END (0,1,0,0,0)                                                   IP020163
      SUBROUTINE DUFS                                                   IP020164
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP020165
     1,KC1,BND,ALPHA                                                    IP020166
      DIMENSION A(204,104),LT(104),B(104),KC(104),JORDER(104),JZEROS(104IP020167
     1),KR(204),U(204),D(204),INDEX(204),ALPHA(3)                       IP020168
      JMIN=2                                                            IP020169
      DO 3 J=3,N                                                        IP020170
      I=1                                                               IP020171
    5 IF (A(I,J)-A(I,JMIN))6,4,3                                        IP020172
    4 I=I+1                                                             IP020173
      IF (I-M1)5,5,999                                                  IP020174
  999 STOP 31                                                           IP020175
    6 JMIN=J                                                            IP020176
    3 CONTINUE                                                          IP020177
      DO 7 I=1,M1                                                       IP020178
      U(I)=-(A(I,JMIN))                                                 IP020179
    7 A(I,JMIN)=-(A(I,JMIN))                                            IP020180
      DO 8 J=2,N                                                        IP020181
      I=1                                                               IP020182
   11 IF (A(I,J))9,10,8                                                 IP020183
   10 I=I+1                                                             IP020184
      IF (I-M1)11,11,998                                                IP020185
  998 STOP 32                                                           IP020186
    9 DO 12  I=1,M1                                                     IP020187
   12 A(I,J)=A(I,J)+U(I)                                                IP020188
    8 CONTINUE                                                          IP020189
      DO 13 I=1,M1                                                      IP020190
   13 A(I,1)=A(I,1)+BND*U(I)                                            IP020191
      RETURN                                                            IP020192
      END (0,1,0,0,0)                                                   IP020193
