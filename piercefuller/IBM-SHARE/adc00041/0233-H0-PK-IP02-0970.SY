      SUBROUTINE RWSL                                                   IP020769
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP020770
     1,KC1,BND,ALPHA                                                    IP020771
      DIMENSION A(204,104),LT(104),B(104),KC(104),JORDER(104),JZEROS(104IP020772
     1),KR(204),U(204),D(204),INDEX(204),ALPHA(3)                       IP020773
      AMIN=0.0                                                          IP020774
      DO 6 I=2,M1                                                       IP020775
      IF (A(I,1)-AMIN)3,4,6                                             IP020776
    3 AMIN=A(I,1)                                                       IP020777
    4 I1=I                                                              IP020778
    6 CONTINUE                                                          IP020779
      IF (AMIN)5,7,999                                                  IP020780
  999 STOP 1                                                            IP020781
    7 K2=0                                                              IP020782
    5 RETURN                                                            IP020783
      END (0,1,0,0,0)                                                   IP020784
      SUBROUTINE PIV1                                                   IP02A785
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP02A786
     1,KC1,BND,ALPHA                                                    IP02A787
      DIMENSION A(204,104),LT(104),B(104),KC(104),JORDER(104),JZEROS(104IP02A788
     1),KR(204),U(204),D(204),INDEX(204),ALPHA(3)                       IP02A789
      KC1=KR(I1)                                                        IP02A790
      DO 3 J=1,N                                                        IP02A791
    3 B(J)=A(I1,J)                                                      IP02A792
   23 DNM=1.0                                                           IP02A793
      KSIG=0                                                            IP02A794
      TOL=0.0                                                           IP02A795
      J1=JORDER(KC1)                                                    IP02A796
      IF (B(J1)+100000.0)31,30,30                                       IP02A797
   31 V=INTF(-B(J1)/100.0)                                              IP02A798
      DO 32 J=1,N                                                       IP02A799
      BB=B(J)/V                                                         IP02A800
      B(J)=INTF(BB)                                                     IP02A801
      IF (B(J)-BB)32,32,34                                              IP02A802
   34 B(J)=B(J)-1.0                                                     IP02A803
   32 CONTINUE                                                          IP02A804
   27 J1=JORDER(KC1)                                                    IP02A805
   30 IF (B(J1)+1.0)4,5,4                                               IP02A806
    4 KSIG=1                                                            IP02A807
      DIV=-(B(J1))                                                      IP02A808
      DNM=MAX1F(1.0,INTF(DNM*DIV+.5))                                   IP02A809
      IF (DNM-100000.0)8,8,18                                           IP02A810
    8 TOL=.5/DNM                                                        IP02A811
      DO 6 J=1,N                                                        IP02A812
    6 B(J)=B(J)/DIV                                                     IP02A813
    5 ASTR=0.0                                                          IP02A814
      DO 10 I=2,M1                                                      IP02A815
      IF (KR(I)-KC1)11,10,10                                            IP02A816
   11 AA=A(I,1)+A(I,J1)*B(1)                                            IP02A817
      IF (AA+TOL)25,10,10                                               IP02A818
   25 IF (ABSF(ASTR-AA)-TOL)15,15,16                                    IP02A819
   15 IF (KR(I)-KR(I1))17,10,10                                         IP02A820
   16 IF (ASTR-AA)10,999,17                                             IP02A821
  999 STOP 71                                                           IP02A822
   17 ASTR=AA                                                           IP02A823
      I1=I                                                              IP02A824
   10 CONTINUE                                                          IP02A825
      IF (ASTR)14,9,999                                                 IP02A826
   14 KC1=0                                                             IP02A827
      B(1)=ASTR                                                         IP02A828
      DO 13 J=2,N                                                       IP02A829
      B(J)=A(I1,J)+A(I1,J1)*B(J)                                        IP02A830
      IF (B(J)+TOL)20,13,13                                             IP02A831
   20 IF (KC(J)-KC1)13,997,21                                           IP02A832
  997 STOP 73                                                           IP02A833
   21 KC1=KC(J)                                                         IP02A834
   13 CONTINUE                                                          IP02A835
      IF (KC1)24,24,27                                                  IP02A836
    9 IF (KSIG)996,24,18                                                IP02A837
  996 STOP 74                                                           IP02A838
   18 DO 19 J=1,N                                                       IP02A839
      BB=B(J)+TOL                                                       IP02A840
      B(J)=INTF(BB)                                                     IP02A841
      IF (BB)22,19,19                                                   IP02A842
   22 B(J)=B(J)-1.0                                                     IP02A843
   19 CONTINUE                                                          IP02A844
      GO TO 23                                                          IP02A845
   24 RETURN                                                            IP02A846
      END (0,1,0,0,1)                                                   IP02A847
      SUBROUTINE NURO                                                   IP020843
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP020844
     1,KC1,BND,ALPHA                                                    IP020845
      DIMENSION A(204,104),LT(104),B(104),KC(104),JORDER(104),JZEROS(104IP020846
     1),KR(204),U(204),D(204),INDEX(204),ALPHA(3)                       IP020847
      BMAX=0.0                                                          IP020848
      UMAX=1.0                                                          IP020849
      DO 5 J=2,N                                                        IP020850
      IF (B(J))12,5,5                                                   IP020851
   12 IF (J-J1)3,4,3                                                    IP020852
    4 U(J)=1.0                                                          IP020853
      GO TO 7                                                           IP020854
    3 JZ1=JZEROS(J)+2                                                   IP020855
      IF (A(JZ1-1,J1))999,5,10                                          IP020856
  999 STOP 61                                                           IP020857
   10 UU=A(JZ1-1,J)/A(JZ1-1,J1)                                         IP020858
      U(J)=INTF(UU)                                                     IP020859
      IF (UU-U(J))997,6,7                                               IP020860
  997 STOP 63                                                           IP020861
    6 DO 8 II=JZ1,M1                                                    IP020862
      IF (A(II,J)-A(II,J1)*U(J))9,8,7                                   IP020863
    8 CONTINUE                                                          IP020864
      STOP 62                                                           IP020865
    9 U(J)=U(J)-1.0                                                     IP020866
    7 IF (BMAX*U(J)-UMAX*B(J))5,5,11                                    IP020867
   11 UMAX=U(J)                                                         IP020868
      BMAX=B(J)                                                         IP020869
    5 CONTINUE                                                          IP020870
      DO 20 J=1,N                                                       IP020871
      BB=-(B(J)*UMAX)/BMAX                                              IP020872
      B(J)=INTF(BB)                                                     IP020873
      IF (BB-B(J))24,20,20                                              IP020874
   24 B(J)=B(J)-1.0                                                     IP020875
   20 CONTINUE                                                          IP020876
      RETURN                                                            IP020877
      END (0,1,0,0,0)                                                   IP020878
