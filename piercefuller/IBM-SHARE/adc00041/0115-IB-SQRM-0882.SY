IB SQRMREM   64                                                         SQR M000
*          709 FIXED POINT SQUARE ROOT SUBROUTINE                       SQR M001
       REM VERSION USING BEGIN AND RETURN MACROS                        SQR M002
   SQR TXL *+4                                                          SQR M003
       AXT 0,4                                                          SQR M004
       AXT 0,2                                                          SQR M005
       TRA 2,4                                                          SQR M006
       SXA *-2,2                                                        SQR M007
       SXA *-4,4                                                        SQR M008
       TMI ERR                                                          SQR M009
       ANA M1                REMOVE LAST BIT TO AVOID OVERFLOW          SQR M010
       TZE SQR+1                                                        SQR M011
       AXT 0,6                                                          SQR M012
       XCA                                                              SQR M013
       PXD                                                              SQR M014
    T1 TXI T2,4,-1                                                      SQR M015
 T2    LLS 2                 NORMALIZE                                  SQR M016
       TZE T1                                                           SQR M017
       LRS 1                                                            SQR M018
       TZE T4                TEST IF NUMBER OF LEADING ZEROES IS        SQR M019
       TXI T4,2,1            ODD OR EVEN                                SQR M020
 T4    LRS 1                                                            SQR M021
       STQ N                                                            SQR M022
       LDQ A,2               QUADRATIC APPROXIMATION                    SQR M023
       VLM N,0,4                                                        SQR M024
       LRS 26                                                           SQR M025
       ADD B,2                                                          SQR M026
       XCA                                                              SQR M027
       VLM N,0,10                                                       SQR M028
       ADD C,2                                                          SQR M029
       TXL S2,4,-14                                                     SQR M030
       STO T                                                            SQR M031
       CLA N                 APPLY NEWTONS METHOD TWICE                 SQR M032
       LRS 1                                                            SQR M033
       VDP T,0,18                                                       SQR M034
       LLS 16                                                           SQR M035
       XCA                                                              SQR M036
       ADD T                                                            SQR M037
       TXL S1,4,-10                                                     SQR M038
       ORA M2                LET APPROXIMATION BE LARGER THAN N         SQR M039
       STO T                                                            SQR M040
       CLA N                                                            SQR M041
       DVP T                                                            SQR M042
       XCA                                                              SQR M043
       ADD T                                                            SQR M044
       LRS 2                                                            SQR M045
 S2    LLS 1                                                            SQR M046
    S1 LRS -1,4              SCALE                                      SQR M047
       TRA SQR+1             RETURN                                     SQR M048
       DEC -.1875B31                                                    SQR M049
 A     DEC -.5625B31                                                    SQR M050
       DEC .8658B26                                                     SQR M051
 B     DEC 1.248B26                                                     SQR M052
       DEC .3217B1                                                      SQR M053
 C     DEC .2236B1                                                      SQR M054
 M1    OCT 377777777776                                                 SQR M055
 M2    OCT 377777                                                       SQR M056
   ERR AXT 16384,4           STANDARD ERROR RETURN                      SQR M057
       SXD SQR,4                                                        SQR M058
       LXA SQR+1,4                                                      SQR M059
       TXI SQR+3,4,1                                                    SQR M060
*                            ERASABLES                                  SQR M061
 N     EQU COMMON                                                       SQR M062
 T     EQU COMMON+1                                                     SQR M063
