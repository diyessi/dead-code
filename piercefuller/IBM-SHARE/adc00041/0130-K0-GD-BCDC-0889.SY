       REM     COPY BCD TAPE ROUTINE                                    BCDC0001
       FUL                                                              BCDC0002
       ORG     0                                                        BCDC0003
       IOCD    3,0,33                                                   BCDC0004
       TCOA    *                                                        BCDC0005
 START AXT     0,2                                                      BCDC0006
       SWT     1                                                        BCDC0007
       TRA     *+2                                                      BCDC0008
       TRA     *+4            COPY 1 FILE                               BCDC0009
       SWT     2                                                        BCDC0010
 OUT   HTR     START                                                    BCDC0011
       TRA     RECORD         COPY N RECORDS                            BCDC0012
 APE   RTDA    2              READ TAPE                                 BCDC0013
       RCHA    R1                                                       BCDC0014
       TCOA    *                                                        BCDC0015
       TEFA    *+10                                                     BCDC0016
       SCHA    TEMP                                                     BCDC0017
       LXA     TEMP,1                                                   BCDC0018
       TIX     *+1,1,50                                                 BCDC0019
       SXD     W1,1                                                     BCDC0020
       WTDB    1              WRITE TAPE                                BCDC0021
       RCHB    W1                                                       BCDC0022
       TCOB    *                                                        BCDC0023
       TXH     REC,2,0                                                  BCDC0024
       TRA     APE                                                      BCDC0025
       WEFB    1                                                        BCDC0026
       TRA     OUT                                                      BCDC0027
RECORD ENK                    ENTER KEYS                                BCDC0023
       XCL                                                              BCDC0029
       PAX     0,2                                                      BCDC0030
       TRA     APE                                                      BCDC0031
 REC   TIX     APE,2,1                                                  BCDC0032
       TRA     OUT                                                      BCDC0033
 W1    IOCD    50,0,0                                                   BCDC0034
 TEMP  PZE                                                              BCDC0035
 R1    IORT    50,0,32000                                               BCDC0036
       END                                                              BCDC0037
