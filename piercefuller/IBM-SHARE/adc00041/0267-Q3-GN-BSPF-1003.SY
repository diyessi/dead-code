GNBSPF     0090 10240                                                   BSPF0000
*          FORTRAN 2 SUBROUTINES BSF, FSFBT, FSFDT                      BSPF0001
*                                                                       BSPF0002
*          BSF   --- BACKSPACE FILE                                     BSPF0003
*          FSFBT --- FORWARD SPACE FILE BINARY TAPE                     BSPF0004
*          FSFDT --- FORWARD SPACE FILE DECIMAL TAPE                    BSPF0005
*                                                                       BSPF0006
*                                                                       BSPF0007
*          CALLING SEQUENCES                                            BSPF0008
*                                                                       BSPF0009
*          CALL BSF (NT,NF)                                             BSPF0010
*          CALL FSFBT (NT,NF)                                           BSPF0011
*          CALL FSFDT (NT,NF)                                           BSPF0012
*                                                                       BSPF0013
*          WHERE NT IS THE LOGICAL TAPE NUMBER AND                      BSPF0014
*                NF IS THE NUMBER OF FILES TO BE SPACED                 BSPF0015
*                                                                       BSPF0016
*                                                                       BSPF0017
*                                                                       BSPF0018
*                                                                       BSPF0019
*          PROGRAM CARD FOR FORTRAN 2 SUBROUTINES BSF, FSFBT, FSFD      BSPF0020
*                                                                       BSPF0021
       ORG                                                              BSPF0022
       FUL                                                              BSPF0023
       MZE ,,328                                                        BSPF0024
       PZE                                                              BSPF0025
       PZE 44                                                           BSPF0026
       PZE                                                              BSPF0027
       BCD 1BSF                                                         BSPF0028
       PZE                                                              BSPF0029
       BCD 1FSFBT                                                       BSPF0030
       PZE 2                                                            BSPF0031
       BCD 1FSFDT                                                       BSPF0032
       PZE 4                                                            BSPF0033
*                                                                       BSPF0034
*                                                                       BSPF0035
*                                                                       BSPF0036
*                                                                       BSPF0037
       REL                                                              BSPF0038
       ORG                                                              BSPF0039
BSF    CAL BACK                                                         BSPF0040
       TTR *+6                                                          BSPF0041
FSFBT  CAL RBT0                                                         BSPF0042
       TTR *+2                                                          BSPF0043
FSFDT  CAL RDT0                                                         BSPF0044
       SLW RDS                                                          BSPF0045
       CAL FORWD                                                        BSPF0046
       SLW TTR                                                          BSPF0047
       SXD IR1,1                                                        BSPF0048
       CLA 2,4                                                          BSPF0049
       STA *+1                                                          BSPF0050
       LXD ,1                                                           BSPF0051
       CLA 1,4                                                          BSPF0052
       STA *+1                                                          BSPF0053
       CLA                                                              BSPF0054
       ARS 18                                                           BSPF0055
TTR    TTR                                                              BSPF0056
BACK   TTR *+1                                                          BSPF0057
       ADD RDT0                                                         BSPF0058
       STA BSF1                                                         BSPF0059
       STA RDT                                                          BSPF0060
BSF1   BSF 0                                                            BSPF0061
       TTR RDT                                                          BSPF0062
       TIX BSF1,1,1                                                     BSPF0063
RDT    RTD                                                              BSPF0064
       CPY DUMMY                                                        BSPF0065
       HPR                                                              BSPF0066
       TTR EXIT                                                         BSPF0067
       HTR EXIT                                                         BSPF0068
FORWD  TTR *+1                                                          BSPF0069
       ADD RDS                                                          BSPF0070
       STA RDS                                                          BSPF0071
RDS    RDS                                                              BSPF0072
       CPY DUMMY                                                        BSPF0073
       TTR RDS                                                          BSPF0074
       TTR TIX                                                          BSPF0075
       TTR RDS                                                          BSPF0076
TIX    TIX RDS,1,1                                                      BSPF0077
EXIT   LXD IR1,1                                                        BSPF0078
       TTR 3,4                                                          BSPF0079
IR1    HTR                                                              BSPF0080
DUMMY  HTR                                                              BSPF0081
RBT0   RTB 0                                                            BSPF0082
RDT0   RTD 0                                                            BSPF0083
       REM   INPUT ' OUTPUT   OPERATION CODES                           BSPF0084
       REM   00138       00141       00142       00153       00154      BSPF0085
       REM   00174                                                      BSPF0086
       REM   ABSOLUTE ADDRESSES                                         BSPF0087
       REM   00052       00091       00113       00115       00116      BSPF0088
       REM   00164                                                      BSPF0089
       END                                                              BSPF0090
