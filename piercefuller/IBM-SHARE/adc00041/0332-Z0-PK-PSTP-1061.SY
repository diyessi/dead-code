       REM PI-STAR PROGRAM,PK PSTP                                    PKPSTP0001
       REM RUTH E. NORBY, DEPT.471, IBM RESEARCH                        PSTP0002
       REM NOVEMBER 18,1960                                             PSTP0003
       ORG 2                                                            PSTP0004
       ROB                                                              PSTP0005
       REM INPUT-OUTPUT PROGRAM FOR PI-STAR SUBROUTINE                  PSTP0006
 RD    CAL END                                                          PSTP0007
       STA CS+1           ADD. OF INJ. WORD LIST                        PSTP0008
       STA RD6                                                          PSTP0009
       ADD ONE                                                          PSTP0010
       STA RD7                                                          PSTP0011
       CAL FLADD          ADD. OF FUNCTION INFORMATION LIST             PSTP0012
       SLW CS+3           ADD. OF FUNCTION INFORMATION LIST             PSTP0013
       LXA THREE,1                                                      PSTP0014
       LXD ONE,4                                                        PSTP0015
       LXA ONE,2                                                        PSTP0016
       RCD                CHECK CONTROL CD. FOR NO. OF FINAL OUTPUTS    PSTP0017
       CPY TEMP+2         9 ROW LEFT-NO. OF FINAL OUTPUTS               PSTP0018
       CAL TEMP+2                                                       PSTP0019
       TZE RD1                                                          PSTP0020
       CPY TEMP+2         9 ROW RIGHT-NEGATION CODING                   PSTP0021
       PBT                                                              PSTP0022
       TRA *+4                                                          PSTP0023
       PXD 0,2                                                          PSTP0024
       SLW CS+2                                                         PSTP0025
       TXI RD3,1,1                                                      PSTP0026
       ALS 1                                                            PSTP0027
       TXI *-6,2,1                                                      PSTP0028
 RD1   PXD 0,2                                                          PSTP0029
       SLW CS+2           SINGLE OUTPUT                                 PSTP0030
       LXA TWO,1                                                        PSTP0031
 RD2   TXI *+1,4,-3                                                     PSTP0032
       SXD RD5,4                                                        PSTP0033
       LXD ONE,4                                                        PSTP0034
       CAL RD8                                                          PSTP0035
       SSM                                                              PSTP0036
       STO RD8            SET TO TRA                                    PSTP0037
       TNX RD5,1,2                                                      PSTP0038
       TRA RD4                                                          PSTP0039
 RD3   CAL TEMP+2         9 ROW RIGHT-NEGATION CODING                   PSTP0040
       TZE RD2            NO NEGATION                                   PSTP0041
       COM                SET UP FOR NEGATION                           PSTP0042
       STD CS+3                                                         PSTP0043
       TXI *+1,4,-4                                                     PSTP0044
       SXD RD5,4                                                        PSTP0045
       LXD ONE,4                                                        PSTP0046
       LXA THREE,1                                                      PSTP0047
       CAL RD8                                                          PSTP0048
       SSP                                                              PSTP0049
       STO RD8            SET TO NOP                                    PSTP0050
       CAL RD7                                                          PSTP0051
       ADD ONE                                                          PSTP0052
       STA RD9            ADDRESS OF NEGATED INPUTS MASKS               PSTP0053
       REM READ IN INJECTIVE WORD                                       PSTP0054
 RD4   RCD                                                              PSTP0055
       CPY TEMP+2         9 LEFT                                        PSTP0056
       TRA *+2                                                          PSTP0057
       TRA ERROR          FUNCTIONS MISSING                             PSTP0058
 RD5   TXI *+1,1,**                                                     PSTP0059
       LXA C16,2                                                        PSTP0060
       CPY END,1          BLANKS AND 1 ROW LEFT-OUTPUT COLUMN MASK      PSTP0061
       TIX *-1,2,1                                                      PSTP0062
       CPY TEMP+2                                                       PSTP0063
       CAL TEMP+2         1 ROW RIGHT                                   PSTP0064
       TZE RD11           BLANK CARD                                    PSTP0065
 RD6   SLW **,1           1 ROW RIGHT-INPUT COLUMNS MASK                PSTP0066
       LXA THREE,2                                                      PSTP0067
 RD7   CPY **,1           0 ROW AND X ROW LEFT-FUNCTION CODING          PSTP0068
       TIX *-1,2,1                                                      PSTP0069
 RD8   TXL RD10           TRA-NOP IF NEGATED INPUTS                     PSTP0070
 RD9   CPY **,1           X ROW RIGHT-NEGATED INPUTS MASK               PSTP0071
 RD10  TXI RD4,4,1        NO. OF CARDS READ                             PSTP0072
 RD11  PXD 0,4                                                          PSTP0073
       STD CS+1           NO. OF INJ. OPERATORS                         PSTP0074
       REM READ IN FUNCTIONS                                            PSTP0075
       LXD ONE,4                                                        PSTP0076
       PXD 0,1                                                          PSTP0077
       ARS 18                                                           PSTP0078
       COM                                                              PSTP0079
       ADD END                                                          PSTP0080
 RD12  STA RD16           1,0 WORD                                      PSTP0081
       STA FULST,4        FUNCTION ADDRESSES                            PSTP0082
       ADD ONE                                                          PSTP0083
       STA RD15           X WORD                                        PSTP0084
       LXD ONE,2                                                        PSTP0085
 RD13  RCD                                                              PSTP0086
       LXA C16,1                                                        PSTP0087
       CPY RMASK                                                        PSTP0088
       TRA *+2                                                          PSTP0089
       TRA RD18           NO MORE CARDS                                 PSTP0090
       TIX *-3,1,1                                                      PSTP0091
       LXA C6,1                                                         PSTP0092
       CPY CMASK+6,1                                                    PSTP0093
       TIX *-1,1,1                                                      PSTP0094
       REM TEST FOR BLANK CARD                                          PSTP0095
       LXA TWO,1                                                        PSTP0096
 RD14  CAL CMASK+2,1      1 ROW                                         PSTP0097
       ORA CMASK+4,1      0 ROW                                         PSTP0098
       ORA CMASK+6,1      X ROW                                         PSTP0099
       TZE RD17           BLANK CARD                                    PSTP0100
       CAL CMASK+6,1                                                    PSTP0101
 RD15  SLW **,2           X WORD                                        PSTP0102
       ORA CMASK+2,1                                                    PSTP0103
 RD16  SLW **,2           1,0 WORD                                      PSTP0104
       TXI *+1,2,-2                                                     PSTP0105
       TIX RD14,1,1                                                     PSTP0106
       TRA RD13                                                         PSTP0107
 RD17  PXD 0,2                                                          PSTP0108
       COM                                                              PSTP0109
       ADD DMASK                                                        PSTP0110
       STD FULST,4        NO. OF ROWS                                   PSTP0111
       TXI *+1,4,-1                                                     PSTP0112
       ARS 18                                                           PSTP0113
       ADD RD16                                                         PSTP0114
       TRA RD12                                                         PSTP0115
       REM CHECK IF FUNCTIONS WERE READ IN                              PSTP0116
 RD18  PXD 0,4                                                          PSTP0117
       TZE ERROR          FUNCTIONS MISSING                             PSTP0118
       CAL FULST,4                                                      PSTP0119
       STA CS+2           ADD. OF LOWER MEMORY                          PSTP0120
       REM CALLING SEQUENCE FOR PI-STAR SUBROUTINE                      PSTP0121
 CS    TSX PST,4                                                        PSTP0122
 CS+1  HTR 0              ADD. OF INJ. WD. LIST,0,NO. OF INJ. OPERATORS PSTP0123
 CS+2  HTR 0              ADD. OF AVAIL. MEMORY,0,NO. OF FINAL OUTPUTS  PSTP0124
 CS+3  HTR 0              ADD OF FUNCTION INFORM.LIST,0,NEGATION CODING PSTP0125
 CS+4  HTR *              ERROR STOP                                    PSTP0126
       REM PRINT OUTPUT ORDER LIST                                      PSTP0127
       STQ TEMP+6                                                       PSTP0128
       STD TEMP+1                                                       PSTP0129
       LXD TEMP+1,1                                                     PSTP0130
       TXL *+5,1,1        SINGLE OUTPUT                                 PSTP0131
       STA LIST           OUTPUT LIST ADDRESS                           PSTP0132
       ARS 18                                                           PSTP0133
       TSX TPC,4                                                        PSTP0134
 LIST  HTR 0              LOCATION OF FIRST WORD                        PSTP0135
       REM PRINT ANSWER ARRAYS                                          PSTP0136
       CAL TEMP+6                                                       PSTP0137
       STA A1                                                           PSTP0138
       ARS 18                                                           PSTP0139
       STA N1                                                           PSTP0140
       LXD ONE,1                                                        PSTP0141
 NEXT  SXD TEMP,1                                                       PSTP0142
 N1    CAL **,1           ADDRESS OF NOCOL BLOCK                        PSTP0143
       STD PRINT                                                        PSTP0144
 A1    CAL **,1           ADDRESS OF ARRAY BLOCK                        PSTP0145
       STA PRINT                                                        PSTP0146
       ARS 18                                                           PSTP0147
       TSX TP,4                                                         PSTP0148
 PRINT HTR 0                                                            PSTP0149
       LXD TEMP+1,2       NO. OF OUTPUTS LEFT                           PSTP0150
       TNX DONE,2,1                                                     PSTP0151
       SXD TEMP+1,2                                                     PSTP0152
       LXD TEMP,1                                                       PSTP0153
       TXI NEXT,1,-1                                                    PSTP0154
 DONE  HTR *                                                            PSTP0155
       REM TAPE PRINT ROUTINE BY ANN EWING                              PSTP0156
 TP    STA TP60           PRINTS 1,0,X DATA                             PSTP0157
       CAL TP45                                                         PSTP0158
       SLW TP41                                                         PSTP0159
       CAL TP46                                                         PSTP0160
       SLW TP82+1                                                       PSTP0161
       CAL TP90                                                         PSTP0162
       SLW TP91                                                         PSTP0163
       CAL NOOP                                                         PSTP0164
       ORS TP92                                                         PSTP0165
       CAL TP60                                                         PSTP0166
       TRA TP44                                                         PSTP0167
 TPC   STA TP60           PRINTS CANONICAL DATA                         PSTP0168
       CAL TP40                                                         PSTP0169
       SLW TP41                                                         PSTP0170
       CAL TP42                                                         PSTP0171
       SLW TP82+1                                                       PSTP0172
       CAL TR                                                           PSTP0173
       ANS TP92                                                         PSTP0174
       CAL NOOP                                                         PSTP0175
       SLW TP91                                                         PSTP0176
       CAL TP60                                                         PSTP0177
 TP44  PAX 0,1                                                          PSTP0178
       TXL TP27,1,0                                                     PSTP0179
       SLW TP18                                                         PSTP0180
       SXD TP12,4                                                       PSTP0181
       LXA TP30,2         SKIP LINES BEFORE PRINTING                    PSTP0182
       TXL TP20+3,2,0                                                   PSTP0183
 TP20  WTD TAPE                                                         PSTP0184
       CPY TP19                                                         PSTP0185
       TIX TP20,2,1                                                     PSTP0186
       CAL 1,4                                                          PSTP0187
       ANA TP700                                                        PSTP0188
       ADD TP18                                                         PSTP0189
       STA TP61                                                         PSTP0190
 TP91  ADD ONE                                                          PSTP0191
       STA TP25                                                         PSTP0192
       STD TP29                                                         PSTP0193
       ARS 18                                                           PSTP0194
       TNZ TP8                                                          PSTP0195
       LXA TP36,2                                                       PSTP0196
       SXD TP29,2                                                       PSTP0197
 TP8   LXA TP18,2                                                       PSTP0198
 TP25  CAL **,2           X WORD                                        PSTP0199
 TP92  TRA *+4                                                          PSTP0200
       SLW TP14                                                         PSTP0201
       COM                                                              PSTP0202
 TP61  ANA **,2           1,0 WORD                                      PSTP0203
       SLW TP2                                                          PSTP0204
       SXD TP18,2                                                       PSTP0205
       CAL TP26                                                         PSTP0206
       LXA TP12,1                                                       PSTP0207
 TP28  SLW TP4,1                                                        PSTP0208
       TIX TP28,1,1                                                     PSTP0209
       LXD TP29,2                                                       PSTP0210
       LXA TP12,4                                                       PSTP0211
 TP11  LXA TP36,1                                                       PSTP0212
 TP6   CAL TP2                                                          PSTP0213
       PBT                                                              PSTP0214
 TP41  TRA TP9                                                          PSTP0215
       CAL TP3            ONE BIT                                       PSTP0216
       ARS 36,1                                                         PSTP0217
 TP5   ORS TP4,4                                                        PSTP0218
       TRA TP17                                                         PSTP0219
 TP9   CAL TP14                                                         PSTP0220
       PBT                                                              PSTP0221
       TRA TP58           ZERO BIT                                      PSTP0222
       CAL TP7            X BIT                                         PSTP0223
       ARS 36,1                                                         PSTP0224
       ORS TP4,4                                                        PSTP0225
 TP17  CAL TP14                                                         PSTP0226
       ALS 1                                                            PSTP0227
       SLW TP14                                                         PSTP0228
 TP16  CAL TP2                                                          PSTP0229
       ALS 1                                                            PSTP0230
       SLW TP2                                                          PSTP0231
       TIX TP57,2,1                                                     PSTP0232
 TP54  TIX TP50,1,12                                                    PSTP0233
       TIX TP51-1,4,1                                                   PSTP0234
       TRA TP1D                                                         PSTP0235
       CAL TP19                                                         PSTP0236
 TP51  SLW TP4,4                                                        PSTP0237
       TIX TP51,4,1                                                     PSTP0238
       TRA TP1D                                                         PSTP0239
 TP50  CAL TP21                                                         PSTP0240
       ARS 36,1                                                         PSTP0241
       ORS TP4,4                                                        PSTP0242
       TIX TP50,1,12                                                    PSTP0243
       TIX TP51-1,4,1                                                   PSTP0244
       TRA TP1D                                                         PSTP0245
 TP57  TIX TP6+1,1,12                                                   PSTP0246
       LXA TP36,1                                                       PSTP0247
 TP10  TIX TP6+1,4,1                                                    PSTP0248
 TP1D  WTD TAPE                                                         PSTP0249
       LXA TP12,4                                                       PSTP0250
 TP13  CPY TP4,4                                                        PSTP0251
       TIX TP13,4,1                                                     PSTP0252
       ETT                                                              PSTP0253
       TRA TP80                                                         PSTP0254
 TP82  LXD TP18,2                                                       PSTP0255
       TIX TP25,2,2       TR TO PRINT NEXT WORD                         PSTP0256
       IOD                                                              PSTP0257
       LXD TP12,4                                                       PSTP0258
 TP27  TRA 2,4                                                          PSTP0259
 TP80  WEF TAPE                                                         PSTP0260
 TP81  HTR TP82           STOP TO CHANGE TAPE REEL                      PSTP0261
 TP58  CAL TP59                                                         PSTP0262
       ARS 36,1                                                         PSTP0263
       ORS TP4,4                                                        PSTP0264
       TRA TP17                                                         PSTP0265
       REM CONSTANTS FOR INPUT-OUTPUT PROGRAM                           PSTP0266
 THREE DEC 3                                                            PSTP0267
 C6    DEC 6                                                            PSTP0268
 C16   DEC 16                                                           PSTP0269
 FULST BSS 32                                                           PSTP0270
 FLADD HTR FULST          FUNCTION INFORMATION LIST ADD.                PSTP0271
 ERROR HTR *              FUNCTIONS MISSING                             PSTP0272
 TP60  HTR 0              SAVES NO. OF TERMS                            PSTP0273
 TP700 PZE -1,0,-1                                                      PSTP0274
 TP18  HTR 0              NO. OF WORDS TO PRINT                         PSTP0275
 TP2   HTR 0              STORAGE FOR 1,0 WORD                          PSTP0276
 TP14  HTR 0              STORAGE FOR X WORD                            PSTP0277
 TP29  HTR 0              NO. OF BITS                                   PSTP0278
 TP12  DEC 12                                                           PSTP0279
 TP36  DEC 36                                                           PSTP0280
 TP21  BCD 1 00000        BLANK                                         PSTP0281
 TP26  BCD 10 0 0         3 BLANKS                                      PSTP0282
 TP19  BCD 1                                                            PSTP0283
 TP40  TRA TP58                                                         PSTP0284
 TP42  TIX TP25,2,1                                                     PSTP0285
 TP45  TRA TP9                                                          PSTP0286
 TP46  TIX TP25,2,2                                                     PSTP0287
 TP90  ADD ONE                                                          PSTP0288
 NOOP  NOP                                                              PSTP0289
 TR    TRA -1                                                           PSTP0290
 TP30  DEC 1              STORAGE FOR SKIP                              PSTP0291
 TP3   BCD 1100000        ONE MASK                                      PSTP0292
 TP59  BCD 1000000        ZERO MASK                                     PSTP0293
 TP7   BCD 1X00000        X MASK                                        PSTP0294
 TP4   BES 12             COPY WORDS                                    PSTP0295
 TAPE  EQU 2                                                            PSTP0296
       REM SUBROUTINE FOR PI-STAR OPERATION                             PSTP0297
       REM INITIALIZE                                                   PSTP0298
 PST   SXD PST33,1                                                      PSTP0299
       SXD PST19,2                                                      PSTP0300
       SXD PST17,4                                                      PSTP0301
       STZ TEMP+9                                                       PSTP0302
       CAL 3,4                                                          PSTP0303
       STA TEMP+9         ADD. OF FUNCTION INFORMATION LIST             PSTP0304
       REM TEST FOR NEGATED INPUTS IN THIS INJECTIVE WORD               PSTP0305
       ARS 18                                                           PSTP0306
       TNZ INIT1          NEGATED INPUTS                                PSTP0307
       REM  SET UP WITHOUT NEGATION                                     PSTP0308
       CLA TEST1                                                        PSTP0309
       SSM                                                              PSTP0310
       STO TEST1          SET TO TRA                                    PSTP0311
       CLA TEST3                                                        PSTP0312
       SSM                                                              PSTP0313
       STO TEST3          SET TO TRA                                    PSTP0314
       TRA INIT2                                                        PSTP0315
       REM SET UP WITH NEGATION                                         PSTP0316
 INIT1 CLA TEST1                                                        PSTP0317
       SSP                                                              PSTP0318
       STO TEST1          SET TO NOP                                    PSTP0319
 INIT2 CAL 2,4                                                          PSTP0320
       REM SET UP LIST TO INDICATE ORDER OF OUTPUTS                     PSTP0321
       STD INIT5                                                        PSTP0322
       PDX 0,1                                                          PSTP0323
       TXL INIT4,1,1                                                    PSTP0324
       LXD ONE,2                                                        PSTP0325
       STA *+2                                                          PSTP0326
       CAL ONE                                                          PSTP0327
 INIT3 SLW **,2           ADD. OF OUTPUT ORDER LIST                     PSTP0328
       TNX *+3,1,1                                                      PSTP0329
       ADD ONE                                                          PSTP0330
       TXI *-3,2,-1                                                     PSTP0331
       CAL 2,4                                                          PSTP0332
       ARS 18             NO. OF OUTPUTS                                PSTP0333
       ADD 2,4            ADD. OF OUTPUT ORDER LIST                     PSTP0334
 INIT4 LBT                                                              PSTP0335
       TRA *+2            IF EVEN                                       PSTP0336
       ADD ONE                                                          PSTP0337
       SLW TEMP+7         ADD. OF AVAIL. MEMORY,0,NO. OF FINAL OUTPUTS  PSTP0338
       STA PST11                                                        PSTP0339
       STA PST14                                                        PSTP0340
       STA PST41                                                        PSTP0341
       STA PST49                                                        PSTP0342
       ADD ONE                                                          PSTP0343
       STA PST42                                                        PSTP0344
       STA PST46                                                        PSTP0345
       STA PST48                                                        PSTP0346
       SUB TWO                                                          PSTP0347
       STA PST21                                                        PSTP0348
       STA PST28                                                        PSTP0349
       STA PST52                                                        PSTP0350
       STA PST55                                                        PSTP0351
       STA PST57                                                        PSTP0352
       SUB ONE                                                          PSTP0353
       STA PST22                                                        PSTP0354
       STA PST23                                                        PSTP0355
       STA PST24                                                        PSTP0356
       STA PST27                                                        PSTP0357
       STA PST51                                                        PSTP0358
       STA PST54                                                        PSTP0359
       STA PST56                                                        PSTP0360
       REM SET UP MEMORY OVERFLOW POINT                                 PSTP0361
       ADD TWO                                                          PSTP0362
       ALS 18                                                           PSTP0363
       STD PST29          OVERFLOW POINT                                PSTP0364
       STD PST58                                                        PSTP0365
       CAL 1,4                                                          PSTP0366
       STA OUTPT                                                        PSTP0367
       PDX 0,1            NO. OF INJ. OPERATORS                         PSTP0368
 INIT5 TIX *+2,1,**                                                     PSTP0369
       TRA ERR+3          NO. OF INJ. OPER. LESS THAN FINAL OUTPUTS     PSTP0370
       SXD PST13,1        NO OF INJ. OPER. LESS NO. OF OUTPUTS          PSTP0371
       CLA TEST2                                                        PSTP0372
       SSM                                                              PSTP0373
       STO TEST2          SET TO TRA                                    PSTP0374
       CLA TEST5                                                        PSTP0375
       SSP                                                              PSTP0376
       STO TEST5          SET TO NOP                                    PSTP0377
       LXD ONE,6                                                        PSTP0378
       LXD TEMP+7,1       NO. OF FINAL OUTPUTS                          PSTP0379
       STZ NOCOL,4        COLUMNS USED                                  PSTP0380
       TXI *+1,4,-1                                                     PSTP0381
       TIX *-2,1,1                                                      PSTP0382
       SXD PST37,4                                                      PSTP0383
       SXD PST31,4                                                      PSTP0384
       STZ ARRAY                                                        PSTP0385
       STZ TEMP+2         IR2 FOR ROWS OF PREVIOUS ARRAY                PSTP0386
       STZ TEMP+3         IR2 AT END OF PREVIOUS ARRAY                  PSTP0387
       STZ TEMP+4         1,0 WORD CARRY COLUMNS                        PSTP0388
       STZ TEMP+5         X WORD CARRY COLUMNS                          PSTP0389
       REM SET UP FINAL OUTPUT ARRAY                                    PSTP0390
 OUTPT CAL **             FINAL OUTPUT CODING                           PSTP0391
       SLW TEMP+1         0,1, OR X CODE FOR OUTPUT                     PSTP0392
       CAL OUTPT          ADD. OF INJ.WD. OUTPUT MASK                   PSTP0393
       REM PICK UP AN INJECTION OPERATOR                                PSTP0394
 PST1  ADD ONE                                                          PSTP0395
       STA PST2           ADD. OF INPUT COLS. MASK                      PSTP0396
       ADD ONE                                                          PSTP0397
       STA PST7           ADD. OF FUNCTION CODING                       PSTP0398
       ADD ONE                                                          PSTP0399
       LXD ONE,5                                                        PSTP0400
 TEST1 TXL NONEG          NOP IF NEGATION-TRA OTHERWISE                 PSTP0401
       REM TEST THIS INJECTION OPERATOR FOR NEGATED INPUTS              PSTP0402
       STA *+1                                                          PSTP0403
       CAL **             NEGATED INPUTS MASK                           PSTP0404
       TZE NEG2                                                         PSTP0405
       SLW CMASK                                                        PSTP0406
       REM SET UP NEGATION MASKS                                        PSTP0407
 NEG1  ACL SMASK                                                        PSTP0408
       COM                                                              PSTP0409
       ANA CMASK                                                        PSTP0410
       SLW NMASK,1                                                      PSTP0411
       TXI *+1,1,-1                                                     PSTP0412
       COM                                                              PSTP0413
       ANS CMASK                                                        PSTP0414
       CAL CMASK                                                        PSTP0415
       TNZ NEG1                                                         PSTP0416
       SXD PST26,1                                                      PSTP0417
       CLA TEST3                                                        PSTP0418
       SSP                                                              PSTP0419
       STO TEST3          SET TO NOP                                    PSTP0420
       TRA *+4                                                          PSTP0421
 NEG2  CLA TEST3                                                        PSTP0422
       SSM                                                              PSTP0423
       STO TEST3          SET TO TRA                                    PSTP0424
       CAL PST7                                                         PSTP0425
       ADD TWO                                                          PSTP0426
 NONEG STA PST38          ADD. OF NEXT OUTPUT COL. MASK                 PSTP0427
       CLA TEMP+7                                                       PSTP0428
       SSP                                                              PSTP0429
       STO TEMP+7         PLUS SIGN                                     PSTP0430
 PST2  CAL **              INPUT COLUMNS MASK                           PSTP0431
       SLW TEMP                                                         PSTP0432
       SLW TEMP+8         INPUT COLUMNS MASK                            PSTP0433
       REM GENERATE INPUT COLUMN MASKS                                  PSTP0434
 PST3  ACL SMASK                                                        PSTP0435
       COM                                                              PSTP0436
       ANA TEMP                                                         PSTP0437
       SLW CMASK,4                                                      PSTP0438
       TXI *+1,4,-1                                                     PSTP0439
       COM                                                              PSTP0440
       ANS TEMP                                                         PSTP0441
       CAL TEMP                                                         PSTP0442
       TNZ PST3                                                         PSTP0443
       SXD PST16,4                                                      PSTP0444
 PST4  LXD TEMP+9,1                                                     PSTP0445
 TEST2 TXL PST5           TRA-NOP                                       PSTP0446
       REM TEST FOR DUPLICATE COLUMNS                                   PSTP0447
       CAL TEMP+8         INPUT COLUMNS MASK                            PSTP0448
       ANA NOCOL,1                                                      PSTP0449
       TZE PST5           NO DUPLICATE COLUMNS                          PSTP0450
       REM SET UP FOR DUPLICATE COLUMNS                                 PSTP0451
       SLW DUPL                                                         PSTP0452
       COM                                                              PSTP0453
       SLW TEMP+6                                                       PSTP0454
       CLA TEST4                                                        PSTP0455
       SSM                                                              PSTP0456
       STO TEST4          SET TO TRA                                    PSTP0457
       CLA TEST6                                                        PSTP0458
       SSM                                                              PSTP0459
       STO TEST6          NOP TO TRA SUBSUMING                          PSTP0460
 PST5  CAL TEMP+8         INPUT COLUMNS MASK                            PSTP0461
       ORS NOCOL,1                                                      PSTP0462
       REM TEST FOR X,OFF OR ON OUTPUT                                  PSTP0463
