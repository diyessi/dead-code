AND107     0046 11210                                                           
      FUNCTION RIEMAN (A1, A2, N, EPS, II)                              AND10701
      DIMENSION A(3), F(3)                                              D1070002
  100 DIVA=(A2 - A1)/FLOATF(N)                                          D1070003
  101 DO 103 I = 1,3                                                    D1070004
  102 A(I) = A1 + (FLOATF(2*I-1)/2.0)*DIVA                              D1070005
  103 F(I) = VALUE (A(I),II)                                            D1070006
  104 END = A1                                                          D1070007
  105 RIEMAN = 0.0                                                      D1070008
  199 DO 233 I = 1,N                                                    D1070009
 1991 RESULT = 0.0                                                      D1070010
  200 ERROR = (((F(3) - 2.0*F(2) + F(1))*DIVA)/24.0)*FLOATF(N)          D1070011
  201 ERR = ABSF(ERROR/EPS)                                             D1070012
  202 IF(ERR - 1.0) 218,218,203                                         D1070013
  203 K = SQRTF(ERR) + 1.0                                              D1070014
  204 L = K/2                                                           D1070015
  205 K = 2*L+1                                                         D1070016
  206 DIVR = DIVA/FLOATF(K)                                             D1070017
  207 DIVR2 = DIVR/2.0                                                  D1070018
  208 DO 211 J = 1,L                                                    D1070019
  209 ADD = VALUE (END + DIVR2, II)*DIVR                                D1070020
  210 RESULT = RESULT + ADD                                             D1070021
  211 END = END + DIVR                                                  D1070022
  212 END = END + DIVR                                                  D1070023
  213 DO 216 J = 1,L                                                    D1070024
  214 ADD = VALUE (END + DIVR2, II)*DIVR                                D1070025
  215 RESULT = RESULT + ADD                                             D1070026
  216 END = END + DIVR                                                  D1070027
  217 GO TO 220                                                         D1070028
  218 END = END + DIVA                                                  D1070029
  219 DIVR = DIVA                                                       D1070030
  220 IF(I-1) 222,222,221                                               D1070031
  221 IF (I - (N-1)) 224,229,229                                        D1070032
  222 RESULT = RESULT + F(1)*DIVR                                       D1070033
  223 GO TO 233                                                         D1070034
  224 RESULT = RESULT + F(2)*DIVR                                       D1070035
  225 F(1) = F(2)                                                       D1070036
  226 F(2) = F(3)                                                       D1070037
  227 F(3) = VALUE(END+(3./2.)*DIVA,II)                                 D1070038
  228 GO TO 233                                                         D1070039
  229 IF (I-N) 230,232,232                                              D1070040
  230 RESULT = RESULT + F(2)*DIVR                                       D1070041
  231 GO TO 233                                                         D1070042
  232 RESULT = RESULT + F(3)*DIVR                                       D1070043
  233 RIEMAN = RIEMAN + RESULT                                          D1070044
  234 RETURN                                                            D1070045
      END (0,1,0,0,1)                                                   D1070046
