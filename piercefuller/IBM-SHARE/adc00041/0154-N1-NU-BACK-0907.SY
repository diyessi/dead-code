NUBACK REM 0038 06060               BACKTRACE OF FLOW OF CONTROL        BACK  01
       REM              USAGE CALL  BACK(I,N,A,B)                       BACK 002
       REM              WHERE-  I=0 DO NOT TRACE THROUGH ALL LEVELS     BACK 003
       REM                      I=1 TRACE THROUGH ALL LEVELS            BACK 004
       REM                      N=0  PRINT ON-LINE                      BACK 005
       REM                      N= NOT ZERO  WRITE ON TAPE NO. N        BACK 006
       REM                      A  AND  B  ARE NUMBERS TO BE PRINTED    BACK 007
       PZE ONE+1,0,5                                                    BACK 008
       PZE                                                              BACK 009
       BCD 1BACK                                                        BACK 010
       PZE ERROR                                                        BACK 011
       REL                                                              BACK 012
       ORG 0                                                            BACK 013
 (LEV) BCD 1(LEV)                 TRA. VECTOR                           BACK 014
(IOH)O BCD 1(IOH)O                                                      BACK 015
 (SPH) BCD 1(SPH)                                                       BACK 016
 (FIL) BCD 1(FIL)                                                       BACK 017
 (STH) BCD 1(STH)                                                       BACK 018
       PZE                                                              BACK 019
       BCD 1BACK                                                        BACK 020
 ERROR SXD *-2,4                                                        BACK 021
       CAL 1,4                                                          BACK 022
       STA *+1                                                          BACK 023
       CLA -                                                            BACK 024
       STD I                                                            BACK 025
       CLA 2,4                                                          BACK 026
       STA *+1                                                          BACK 027
       CLA -                                                            BACK 028
       STD T1+1                   SET TAPE NO.                          BACK 029
       STD T2+1                                                         BACK 030
       ANA MASK+2                                                       BACK 031
       TNZ *+3                                                          BACK 032
       CLA L(SPH)                 SET FOR PRINT                         BACK 033
       TRA *+2                                                          BACK 034
       CLA L(STH)                                                       BACK 035
       STA T1                                                           BACK 036
       STA T2                                                           BACK 037
       CLA ERROR-1                                                      BACK 038
       STO NAME                                                         BACK 039
       STZ IFN                                                          BACK 040
       STZ EFN                                                          BACK 041
       TXI *+1,4,-2                                                     BACK 042
 1)    CAL *                                                            BACK 043
       TTR (LEV)                                                        BACK 044
       ETM                                                              BACK 045
       CAL (IOH)O                                                       BACK 046
       SLW 1                                                            BACK 047
 T1    CAL (SPH)                                                        BACK 048
       TXI F1,0,0                                                       BACK 049
       ETM                                                              BACK 050
       TXI EFN                                                          BACK 051
       TXI IFN                                                          BACK 052
       LTM                                                              BACK 053
       CAL *                                                            BACK 054
       TTR (FIL)                                                        BACK 055
       TXH *+3,4,0                GO TO START SEARCH OF CALL SEQ.       BACK 056
 OUT   LXD ERROR-2,4                                                    BACK 057
       TRA 5,4                                                          BACK 058
       SXD IR,4                   SAVE ADDR. OF CALLING SEQ.            BACK 059
 2)    CAL 1,4                                                          BACK 060
       ANA MASK                                                         BACK 061
       TNZ 3)                     IF NOT ZERO-END OF CALL SEQ.          BACK 062
       CLA 1,4                    IF ZERO-THIS IS ARG.                  BACK 063
       STA ARG                                                          BACK 064
       STA ARG+1                  PRINT ARG.                            BACK 065
       STA ARG+2                                                        BACK 066
       CAL *                                                            BACK 067
       TTR (LEV)                                                        BACK 068
       ETM                                                              BACK 069
       CAL (IOH)O                                                       BACK 070
       SLW 1                                                            BACK 071
 T2    CAL (SPH)                                                        BACK 072
       TXI F2,0,0                                                       BACK 073
       ETM                                                              BACK 074
 ARG   TXI -                                                            BACK 075
       TXI -                                                            BACK 076
       TXI -                                                            BACK 077
       LTM                                                              BACK 078
       CAL *                                                            BACK 079
       TTR (FIL)                                                        BACK 080
       TXI 2),4,-1                GO TO NEXT WORD OF CALL SEQ.          BACK 081
 3)    CLA I                                                            BACK 082
       TZE OUT                                                          BACK 083
       CLA 1,4                                                          BACK 084
       STD EFN                                                          BACK 085
       CLA 2,4                                                          BACK 086
       STD IFN                                                          BACK 087
       STA 4)+1                                                         BACK 088
       ANA MASK+1                                                       BACK 089
       TZE 5)                     TRA-C=0,MAIN PROG.                    BACK 090
       CAS MASK+1                                                       BACK 091
       TRA *+2                                                          BACK 092
       TRA 6)                     TRA-C=77777,FU.DEF.                   BACK 093
       ADD ONE                    OTHERWISE-SUBROUTINE                  BACK 094
       STA 4)                                                           BACK 095
 4)    CLA -                      BCD NAME                              BACK 096
       LXD -,4                    -LOC. OF NEXT CALL SEQ. TO IR4        BACK 097
       STO NAME                                                         BACK 098
       TRA 1)                                                           BACK 099
 5)    CLA MAIN                                                         BACK 100
       LXD ONE,4                  0 TO IR4                              BACK 101
       TRA 4)+2                                                         BACK 102
 6)    LXD IR,4                   RESTORE ADDR. OF CALL SEQ.            BACK 103
       CLA -1,4                                                         BACK 104
       STA 4)+1                                                         BACK 105
       CLA MAIN+1                                                       BACK 106
       TRA 4)+1                                                         BACK 107
 MAIN  BCD 1MAIN-                                                       BACK 108
       BCD 1FU-DEF                                                      BACK 109
       BCD 1.ARE-)                                                      BACK 110
       BCD 1   ARG                                                      BACK 111
       BCD 1I5,11H                                                      BACK 112
       BCD 1  IFN=                                                      BACK 113
       BCD 1I5,7H                                                       BACK 114
       BCD 1  EFN=                                                      BACK 115
 NAME  BCD 1                                                            BACK 116
 F1    BCD 1(14H0                                                       BACK 117
       BCD 15)                                                          BACK 118
       BCD 1INT  I                                                      BACK 119
       BCD 1H                                                           BACK 120
       BCD 14.7,10                                                      BACK 121
       BCD 1  1PE1                                                      BACK 122
       BCD 1   DEC                                                      BACK 123
       BCD 1,10H                                                        BACK 124
       BCD 1T  O12                                                      BACK 125
       BCD 1    OC                                                      BACK 126
 F2    BCD 1(11H0                                                       BACK 127
L(SPH) CAL (SPH)                                                        BACK 128
L(STH) CAL (STH)                                                        BACK 129
 MASK  OCT 700000000000                                                 BACK 130
       OCT 77777                                                        BACK 131
       OCT 077777000000                                                 BACK 132
 IR                                                                     BACK 133
 EFN                                                                    BACK 134
 IFN                                                                    BACK 135
 I                                                                      BACK 136
 ONE   PZE 1                                                            BACK 137
       END                                                              BACK 138
