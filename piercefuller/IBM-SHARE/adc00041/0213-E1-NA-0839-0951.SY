*NA 839   BINARY SEARCH ROUTINE.                                        NA839001
*OWEN R. MOCK, DECEMBER 18, 1959.                                       NA839002
*ACCEPTS CALLING SEQUENCE                                               NA839003
*      TSX     BS,4                                                     NA839004
*      PZE     ORIGIN,,27136       ORIGIN OF TABLE CHARACTERISTIC 53    NA839005
*      PZE     LENGTH,,            LENGTH                               NA839006
*      ENTRY NOT FOUND                                                  NA839007
*      ENTRY FOUND                                                      NA839008
*WITH VALUE TO BE LOOKED UP LOGICALLY IN ACCUMULATOR                    NA839009
*RETURN WILL BE WITH INDEX 1 SHOWING POSITION IN TABLE                  NA839010
*DESTROYS INDICATORS.                                                   NA839011
*SAVES INDEX                                                            NA839012
       ORG     8192                                                     NA839013
 BS    SXA     BS2,2               SAVE INDEX 2.                        NA839014
       SLW     BS7                                                      NA839015
       CAL     2,4                 LENGTH OF TABLE                      NA839016
       PAX     0,1                 IN INDEX 1.                          NA839017
       ACL     1,4                 TERMINUS OF TABLE                    NA839018
       STA     BS1                 INCOMPARE ADDRESS.                   NA839019
       FSB     1,4                 COMPUTE CHARACTERISTIC               NA839020
       LGL     9                   OF TABLE LENGTH IN                   NA839021
       PAX     0,2                 INDEX 2.                             NA839022
       CAL     BS7                                                      NA839023
       TXI     *+1,1,1             ADD ONE TO COUNT                     NA839024
 BS9   XEC     BS5,2               EXECUTE TIX                          NA839025
       TXI     *-1,2,-1            BEYOND END OF TABLE                  NA839026
 BS1   LAS     **,1                COMPARE                              NA839027
       TRA     BS9                 ARGUMENT HIGH                        NA839028
       TRA     BS2                 ARGUMENT EQUAL                       NA839029
       XEC     BS6,2               ARGUMENT LOWER                       NA839030
 BS4   TXI     BS1,2,-1            REDUCE POWER OF TWO                  NA839031
 BS2   AXT     **,2                RESTORE INDEX 2                      NA839032
       TRA     4,4                 ARGUMENT FOUND                       NA839033
       TIX     BS4,1,16384         HIGHER IN TABLE                      NA839034
       TIX     BS4,1,8192                                               NA839035
       TIX     BS4,1,4096                                               NA839036
       TIX     BS4,1,2048                                               NA839037
       TIX     BS4,1,1024                                               NA839038
       TIX     BS4,1,512                                                NA839039
       TIX     BS4,1,256                                                NA839040
       TIX     BS4,1,128                                                NA839041
       TIX     BS4,1,64                                                 NA839042
       TIX     BS4,1,32                                                 NA839043
       TIX     BS4,1,16                                                 NA839044
       TIX     BS4,1,8                                                  NA839045
       TIX     BS4,1,4                                                  NA839046
       TIX     BS4,1,2                                                  NA839047
       TIX     BS4,1,1                                                  NA839048
 BS5   TXI     BS6,1,-1                                                 NA839049
       TXI     BS4,1,16384         LOWER IN TABLE                       NA839050
       TXI     BS4,1,8192                                               NA839051
       TXI     BS4,1,4096                                               NA839052
       TXI     BS4,1,2048                                               NA839053
       TXI     BS4,1,1024                                               NA839054
       TXI     BS4,1,512                                                NA839055
       TXI     BS4,1,256                                                NA839056
       TXI     BS4,1,128                                                NA839057
       TXI     BS4,1,64                                                 NA839058
       TXI     BS4,1,32                                                 NA839059
       TXI     BS4,1,16                                                 NA839060
       TXI     BS4,1,8                                                  NA839061
       TXI     BS4,1,4                                                  NA839062
       TXI     BS4,1,2                                                  NA839063
       TXI     BS4,1,1                                                  NA839064
BS6    TXI BS2,4,1                                                      NA839065
 BS7   PZE     0                                                        NA839066
