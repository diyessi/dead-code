C     LINEAR PROGRAMMING,INTEGER SOLUTIONS,S6-1 CODE                  PKIP010001
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP010002
     1,KC1,BND,ALPHA                                                    IP010003
      DIMENSION A(204,104),LT(104),B(104),KC(104),JORDER(104),JZEROS(104IP010004
     1),KR(204),U(204),D(204),INDEX(204),ALPHA(3)                       IP010005
      LLL=1                                                             IP010006
   26 IF (LLL) 160,160,170                                              IP010007
  144 PRINT 154, ALPHA                                                  IP010008
      PAUSE 6                                                           IP010009
  170 IF (SENSE SWITCH 3) 1,2                                           IP010010
    1 READ 3,ALPHA,M,N,BND,LL2,LL3,LL6,LL7,LL8,LLB,LL4,LL5              IP010011
      GO TO 4                                                           IP010012
    2 READ INPUT TAPE 7,3,ALPHA,M,N,BND,LL2,LL3,LL6,LL7,LL8,LLB,LL4,LL5 IP010013
    4 IF (M)160,160,161                                                 IP010014
  160 END FILE 8                                                        IP010015
      PRINT 155                                                         IP010016
      STOP                                                              IP010017
  161 K2=-1                                                             IP010018
      PRINT 152,LLL,ALPHA                                               IP010019
      LLL=LLL+1                                                         IP010020
      NUM=0                                                             IP010021
      LI3=LL3                                                           IP010022
      LL3=LL3-1                                                         IP010023
      LI6=LL6                                                           IP010024
      LI7=LL7                                                           IP010025
      LI8=LL8                                                           IP010026
      NN=N-1                                                            IP010027
      WRITE OUTPUT TAPE 8,5,ALPHA                                       IP010028
      CALL SETUP                                                        IP010029
      IF (LL4)28,28,29                                                  IP010030
   28 CALL MOUT                                                         IP010031
   29 IF (BND)25,25,31                                                  IP010032
   31 CALL DUFS                                                         IP010033
      IF (LLB) 172,172,25                                               IP010034
  172 WRITE OUTPUT TAPE 8,132                                           IP010035
    6 CALL MOUT                                                         IP010036
   25 DO 100 J=2,N                                                      IP010037
      DO 101 I=1,M1                                                     IP010038
      IF (A(I,J))999,101,100                                            IP010039
  999 STOP 1                                                            IP010040
  101 CONTINUE                                                          IP010041
      STOP 2                                                            IP010042
  100 JZEROS(J)=I-1                                                     IP010043
      IF (LL3-NUM)9,8,9                                                 IP010044
    8 CALL SLCTN                                                        IP010045
      LL3=LL3+LI3                                                       IP010046
      GO TO 10                                                          IP010047
    9 CALL SLCTR                                                        IP010048
   10 IF (K2)11,12,998                                                  IP010049
  998 STOP 3                                                            IP010050
   11 NUM=NUM+1                                                         IP010051
      CALL NURO                                                         IP010052
      IF (LL7-NUM)13,14,13                                              IP010053
   14 LL7=LL7+LI7                                                       IP010054
      WRITE OUTPUT TAPE 8,15,NUM,I1,J1                                  IP010055
      WRITE OUTPUT TAPE 8,16,(B(J),J=1,N)                               IP010056
   13 CALL PIV                                                          IP010057
      IF (SENSE SWITCH 1)37,38                                          IP010058
   37 PRINT 19,NUM,A(1,1),A(2,1),A(3,1)                                 IP010059
   38 IF (LL8-NUM)18,17,18                                              IP010060
   17 LL8=LL8+LI8                                                       IP010061
      WRITE OUTPUT TAPE 8,19,NUM,A(1,1),A(2,1),A(3,1)                   IP010062
   18 IF (SENSE SWITCH 2) 171,30                                        IP010063
   30 IF (LL2-NUM)20,21,20                                              IP010064
   20 IF (LL6-NUM)25,22,25                                              IP010065
   22 LL6=LL6+LI6                                                       IP010066
      GO TO 6                                                           IP010067
  171 PRINT 153                                                         IP010068
      PAUSE 2                                                           IP010069
   21 WRITE OUTPUT TAPE 8,23,NUM                                        IP010070
   34 IF (LL5)32,32,33                                                  IP010071
   33 WRITE OUTPUT TAPE 8,35,ALPHA,A(1,1)                               IP010072
      WRITE OUTPUT TAPE 8,36,(I,A(I,1),I=2,M1)                          IP010073
   41 IF (K2)43,26,998                                                  IP010074
   43 IF (SENSE SWITCH 6) 40,26                                         IP010075
   40 CALL SAVCOR (1)                                                   IP010076
      IF (SENSE SWITCH 6) 144,142                                       IP010077
  142 LLL=0                                                             IP010078
      WRITE OUTPUT TAPE 8,156,ALPHA,NUM                                 IP010079
      GO TO 20                                                          IP010080
   32 CALL MOUT                                                         IP010081
      GO TO 41                                                          IP010082
   12 WRITE OUTPUT TAPE 8,27,NUM                                        IP010083
      GO TO 34                                                          IP010084
    3 FORMAT (3A6,2I3,F6.0,I6,7I3)                                      IP010085
    5 FORMAT (8H1START  3A6)                                            IP010086
   15 FORMAT (10H0PIVOT ROWI5,9H FROM ROWI5,14H, PIVOT COLUMNI5/1H )    IP010087
   16 FORMAT (1H06X,14F8.0)                                             IP010088
   19 FORMAT (6H0PIVOTI5,24H, CONSTANT COLUMN BEGINS3F8.0)              IP010089
   23 FORMAT (21H0SOLUTION INCOMPLETE,I5,7H PIVOTS)                     IP010090
   27 FORMAT (10H0SOLUTION,I5,7H PIVOTS)                                IP010091
   35 FORMAT (28H1CONSTANT COLUMN OF MATRIX, 3A6/8H0ROW   15X,F10.0)    IP010092
   36 FORMAT (1H I7,5X,F10.0)                                           IP010093
  132 FORMAT (78H0PROBLEM IS NOT DUAL FEASIBLE. MATRIX WILL BE REWRITTENIP010094
     1 IN FEASIBLE FORM BELOW)                                          IP010095
  152 FORMAT (14H0BEGIN PROBLEMI3,2H, 3A6)                              IP010096
  153 FORMAT (33H0PUT SENSE SWITCH 2 UP. HIT START)                     IP010097
  154 FORMAT (9H0PROBLEM 3A6,93H HAS BEEN DUMPED. IF MORE PROBLEMS ARE TIP010098
     1O BE PROCESSED, CHANGE TAPE 1 IF ANY IS TO BE DUMPED./32H OTHERWISIP010099
     2E PUT SENSE SWITCH 6 UP)                                          IP010100
  155 FORMAT (32H0LAST PROBLEM HAS BEEN PROCESSED)                      IP010101
  156 FORMAT (17H1RESTART PROBLEM 3A6,6H AFTERI5,7H PIVOTS)             IP010102
      END (0,1,0,0,1)                                                   IP010103
      SUBROUTINE SETUP                                                  IP010104
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP010105
     1,KC1,BND,ALPHA                                                    IP010106
      DIMENSION A(204,104),LT(104),B(104),KC(104),JORDER(104),JZEROS(104IP010107
     1),KR(204),U(204),D(204),INDEX(204),ALPHA(3)                       IP010108
      M1=M+NN                                                           IP010109
      DO 5 J=1,N                                                        IP010110
      DO 5 I=1,M1                                                       IP010111
    5 A(I,J)=0.0                                                        IP010112
      IF (SENSE SWITCH 3)6,7                                            IP010113
    6 READ 3,I,J,AA                                                     IP010114
      IF (I)999,10,4                                                    IP010115
  999 STOP 1                                                            IP010116
    4 A(I,J)=AA                                                         IP010117
      GO TO 6                                                           IP010118
    7 READ INPUT TAPE 7,3,I,J,AA                                        IP010119
      IF (I)999,10,11                                                   IP010120
   11 A(I,J)=AA                                                         IP010121
      GO TO 7                                                           IP010122
   10 I=M+1                                                             IP010123
      DO 12 J=2,N                                                       IP010124
      A(I,J)=-1.0                                                       IP010125
      LT(J)=I                                                           IP010126
   12 I=I+1                                                             IP010127
      LT(1)=0                                                           IP010128
      RETURN                                                            IP010129
    3 FORMAT (2I5,F10.5)                                                IP010130
      END (0,1,0,0,0)                                                   IP010131
      SUBROUTINE MOUT                                                   IP010132
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP010133
     1,KC1,BND,ALPHA                                                    IP010134
      DIMENSION A(204,104),LT(104),B(104),KC(104),JORDER(104),JZEROS(104IP010135
     1),KR(204),U(204),D(204),INDEX(204),ALPHA(3)                       IP010136
      LB=1                                                              IP010137
      LO=1                                                              IP010138
      MX=14                                                             IP010139
   11 K=1                                                               IP010140
      MX=XMIN0F(N,MX)                                                   IP010141
      LL=1                                                              IP010142
      LU=56                                                             IP010143
    8 LU=XMIN0F(M1,LU)                                                  IP010144
      WRITE OUTPUT TAPE 8,3,K,LB,M1,N,ALPHA,(LT(J),J=LO,MX)             IP010145
      WRITE OUTPUT TAPE 8,7                                             IP010146
      DO 12 I=LL,LU                                                     IP010147
   12 WRITE OUTPUT TAPE 8,4,I,(A(I,J),J=LO,MX)                          IP010148
      IF (M1-LU)999,5,6                                                 IP010149
  999 STOP 1                                                            IP010150
    6 LL=LU+1                                                           IP010151
      LU=LU+56                                                          IP010152
      K=K+1                                                             IP010153
      GO TO 8                                                           IP010154
    5 IF (N-MX)999,9,10                                                 IP010155
   10 LO=MX+1                                                           IP010156
      MX=MX+14                                                          IP010157
      LB=LB+1                                                           IP010158
      GO TO 11                                                          IP010159
    9 RETURN                                                            IP010160
    3 FORMAT (12H1SUBMATRIX (I1,1H,I1,4H) OFI3,2H XI3,7H MATRIX65X,3A6/1IP010161
     1H04X,6HCOLUMNI4,13I8)                                             IP010162
    7 FORMAT (4H ROW)                                                   IP010163
    4 FORMAT (1H I3,3X,14F8.0)                                          IP010164
      END (0,1,0,0,0)                                                   IP010165
      SUBROUTINE DUFS                                                   IP010166
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP010167
     1,KC1,BND,ALPHA                                                    IP010168
      DIMENSION A(204,104),LT(104),B(104),KC(104),JORDER(104),JZEROS(104IP010169
     1),KR(204),U(204),D(204),INDEX(204),ALPHA(3)                       IP010170
      JMIN=2                                                            IP010171
      DO 3 J=3,N                                                        IP010172
      I=1                                                               IP010173
    5 IF (A(I,J)-A(I,JMIN))6,4,3                                        IP010174
    4 I=I+1                                                             IP010175
      IF (I-M1)5,5,999                                                  IP010176
  999 STOP 31                                                           IP010177
    6 JMIN=J                                                            IP010178
    3 CONTINUE                                                          IP010179
      DO 7 I=1,M1                                                       IP010180
      U(I)=-(A(I,JMIN))                                                 IP010181
    7 A(I,JMIN)=-(A(I,JMIN))                                            IP010182
      DO 8 J=2,N                                                        IP010183
      I=1                                                               IP010184
   11 IF (A(I,J))9,10,8                                                 IP010185
   10 I=I+1                                                             IP010186
      IF (I-M1)11,11,998                                                IP010187
  998 STOP 32                                                           IP010188
    9 DO 12  I=1,M1                                                     IP010189
   12 A(I,J)=A(I,J)+U(I)                                                IP010190
    8 CONTINUE                                                          IP010191
      DO 13 I=1,M1                                                      IP010192
   13 A(I,1)=A(I,1)+BND*U(I)                                            IP010193
      RETURN                                                            IP010194
      END (0,1,0,0,0)                                                   IP010195
       FUL                                                              IP010196
       MZE 0,0,324                                                      IP010197
       PZE                                                              IP010198
       PZE FINAL,,0                                                     IP010199
       PZE 9996                                                         IP010200
       BCD 1SLCTN                                                       IP010201
       PZE SLCTN                                                        IP010202
       ORG 0                                                            IP010203
       REL                                                              IP010204
 ST    PZE                                                              IP010205
       PZE                                                              IP010206
       PZE                                                              IP010207
 SLCTN SXD ST,1           INITIALIZE                                    IP010208
       SXD ST+1,2                                                       IP010209
       SXD ST+2,4                                                       IP010210
       CLA N                                                            IP010211
       STD ST5                                                          IP010212
       CLA M1                                                           IP010213
       STD LOCB                                                         IP010214
       STD LOCC                                                         IP010215
       STZ AMIN                                                         IP010216
       STZ K2                                                           IP010217
       LXD D2,1                                                         IP010218
 ST1   CLA A+1,1                                                        IP010219
       TZE ST2                                                          IP010220
       CAS AMIN                                                         IP010221
       TRA ST2                                                          IP010222
       TRA ST2                                                          IP010223
       STO AMIN                                                         IP010224
       SXD I1,1                                                         IP010225
 ST2   TXI *+1,1,1                                                      IP010226
 LOCB  TXL ST1,1,**       DECREMENT M1                                  IP010227
       CLA AMIN                                                         IP010228
       TZE ST3            RETURN. PROBLEM COMPLETE                      IP010229
       STO B                                                            IP010230
       CLS I1                                                           IP010231
       ARS 18                                                           IP010232
       SUB ADDA                                                         IP010233
       STO ADDX                                                         IP010234
       CLS D2                                                           IP010235
       STO K2                                                           IP010236
       STO JZ1                                                          IP010237
       LXD I1,1                                                         IP010238
       TXI *+1,1,MDIM                                                   IP010239
       LXD D2,2                                                         IP010240
 ST4   CLA A+1,1          COPY ROW INTO B                               IP010241
       STO B+1,2                                                        IP010242
       TZE ST8                                                          IP010243
       TPL ST8                                                          IP010244
       CLA JZ1                                                          IP010245
       SUB JZEROS+1,2                                                   IP010246
       TZE ST9            TIE WITH ZEROS                                IP010247
       TPL ST8            NEW COLUMN IS GREATER. IGNORE                 IP010248
 ST10  CLA JZEROS+1,2     NEW COLUMN SMALLER. RECORD AS                 IP010249
       STO JZ1              CURRENT SMALLEST                            IP010250
       PXD ,1                                                           IP010251
       ARS 18                                                           IP010252
       ADD ADDX                                                         IP010253
       STA ST7                                                          IP010254
       SXD J1,2                                                         IP010255
       TXI ST12,1,MDIM                                                  IP010256
 ST9   PXD ,1             PICK UP ADDRESS FOR PRESENT COLUMN            IP010257
       ARS 18             BREAK TIE                                     IP010258
       ADD ADDX                                                         IP010259
       STA LOCA                                                         IP010260
       LXD JZ1,4                                                        IP010261
       TXI *+1,4,1                                                      IP010262
 ST7   CLA **,4           ADDRESS, TOP OF CURRENT J1 COLUMN             IP010263
 LOCA  SUB **,4           ADDRESS, TOP OF COLUMN BEING TESTED           IP010264
       TZE ST11           TIE, CONTINUE TEST                            IP010265
       TPL ST10           NEW COLUMN SMALLER. REPLACE J1                IP010266
       TMI ST8            NEW COLUMN GREATER. IGNORE                    IP010267
 ST11  TXI *+1,4,1                                                      IP010268
 LOCC  TXL ST7,4,**       DECREMENT,M1                                  IP010269
       HTR *              TWO EQUAL COLUMNS                             IP010270
 ST8   TXI *+1,1,MDIM     DECREMENT, COLUMN LENGTH                      IP010271
 ST12  TXI *+1,2,1                                                      IP010272
 ST5   TXL ST4,2,**       DECREMENT,N                                   IP010273
 ST3   LXD ST,1           RETURN                                        IP010274
       LXD ST+1,2                                                       IP010275
       LXD ST+2,4                                                       IP010276
       TRA 1,4                                                          IP010277
 ADDA  HTR A+1                                                          IP010278
 D2    PZE ,,2                                                          IP010279
 AMIN  PZE                                                              IP010280
 JZ1   PZE                                                              IP010281
 ADDX  PZE                                                              IP010282
 K2    SYN 10004                                                        IP010283
 M1    SYN 10005                                                        IP010284
 I1    SYN 10007                                                        IP010285
 J1    SYN 10008                                                        IP010286
 N     SYN 10009                                                        IP010287
JZEROS SYN 10930                                                        IP010288
 B     SYN 11242                                                        IP010289
 A     SYN 32562                                                        IP010290
 MDIM  EQU 204                                                          IP010291
 FINAL SYN *                                                            IP010292
       END SLCTN                                                        IP010293
       FUL                                                              IP010294
       MZE ,,324                                                        IP010295
       PZE                                                              IP010296
       PZE FINAL                                                        IP010297
       PZE 9996                                                         IP010298
       BCD 1SLCTR                                                       IP010299
       PZE SLCTR                                                        IP010300
       ORG 0                                                            IP010301
       REL                                                              IP010302
 ST    PZE                STORE INDEX REGISTERS                         IP010303
       PZE                                                              IP010304
       PZE                                                              IP010305
 SLCTR SXD ST,1           ENTRY POINT                                   IP010306
       SXD ST+1,2                                                       IP010307
       SXD ST+2,4                                                       IP010308
       CLA N                                                            IP010309
       STD LOCG                                                         IP010310
       CLA M1                                                           IP010311
       STD LOCD                                                         IP010312
       STD LOCE                                                         IP010313
       STD LOCF                                                         IP010314
       STD LOCC                                                         IP010315
       STO JZ1            INITIALIZE JZ1                                IP010316
       STZ J1             INITIALIZE J1                                 IP010317
       LXD D2,1           XR 1 INDEXES ROWS I                           IP010318
 ST11  CLA A+1,1                                                        IP010319
       TZE ST12           ROW I IS 0 OR +. SKIP ROW                     IP010320
       TPL ST12                                                         IP010321
       SXD I3,1           ROW I HAS NEGATIVE IN CONSTANT COL            IP010322
       TXI *+1,1,MDIM     XR1 NOW INDEXES ACROSS ROW I3                 IP010323
       LXD D2,2           XR 2 INDEXES COLS FOR TEST ROW I              IP010324
       CLS D1             INITIALIZE JZ3 FOR EACH ROW                   IP010325
       STO JZ3                                                          IP010326
 ST5   CLA A+1,1                                                        IP010327
       TZE ST1            SKIP COL IF TEST ROW CONTAINS +OR0            IP010328
       TPL ST1                                                          IP010329
       CLA JZEROS+1,2                                                   IP010330
       CAS JZ1            COMPARE ZEROS WITH JZ1                        IP010331
       TRA ST2            ROW WILL HAVE HIGHER RANK, SO SKIP            IP010332
       NOP                                                              IP010333
       CAS JZ3            COMPARE ZEROS WITH JZ3                        IP010334
       TRA ST3            REPLACE J3 BY CURRENT COL                     IP010335
       TRA ST4            ZEROS TIE BETWEEN J3 AND CURRENT COL          IP010336
 ST1   TXI *+1,1,MDIM     CURRENT COL EXCEEDS J3. NO REPLACEMENT        IP010337
 ST6   TXI *+1,2,1                                                      IP010338
 LOCD  TXL ST5,2,0        DECREMENT M1                                  IP010339
       CLA J1             TEST IF J1 EXISTS YET                         IP010340
       TNZ ST18           TEST IF J3,J1 SAME                            IP010341
       CLA JZ3                                                          IP010342
       TRA ST19                                                         IP010343
 ST18  SUB J3             TEST IF J3,J1 SAME                            IP010344
       TZE ST13           IF SO, PICK MOST NEGATIVE OF I1,I3            IP010345
       CLA JZ3                                                          IP010346
       CAS JZ1                                                          IP010347
       HTR *              JZ3 EXCEEDS JZ1. PREVIOUS TEST FAILED         IP010348
       TRA ST10           ZEROS TIE,J1 AND J3                           IP010349
 ST19  STO JZ1            J3 EXCEEDS J1. REPLACE J1 WITH J3             IP010350
 ST17  CLA J3                                                           IP010351
       STO J1                                                           IP010352
       CAL ST8                                                          IP010353
       STA ST14                                                         IP010354
 ST15  CLA I3                                                           IP010355
       STO I1                                                           IP010356
 ST2   LXD I3,1           END OUTSIDE LOOP                              IP010357
 ST12  TXI *+1,1,1                                                      IP010358
 LOCF  TXL ST11,1,0       DECREMENT M1                                  IP010359
       CLA J1             TEST IF PROBLEM DONE                          IP010360
       TNZ ST20                                                         IP010361
       STZ K2                                                           IP010362
       TRA ST22                                                         IP010363
 ST20  LXD D1,2           COPY ROW I1 INTO B                            IP010364
       LXD I1,1                                                         IP010365
 ST21  CLA A+1,1                                                        IP010366
       STO B+1,2                                                        IP010367
       TXI *+1,1,MDIM                                                   IP010368
       TXI *+1,2,1                                                      IP010369
 LOCG  TXL ST21,2,0       DECREMENT,N                                   IP010370
 ST22  LXD ST,1                                                         IP010371
       LXD ST+1,2                                                       IP010372
       LXD ST+2,4                                                       IP010373
       TRA 1,4                                                          IP010374
 ST3   STO JZ3            REPLACE J3 BY CURRENT COL                     IP010375
       SXD J3,2                                                         IP010376
       PXD ,1                                                           IP010377
       SUB I3                                                           IP010378
       ARS 18                                                           IP010379
       SUB ADDA                                                         IP010380
       STA ST8                                                          IP010381
       TXI ST6,1,MDIM                                                   IP010382
 ST4   PXD ,1                                                           IP010383
       SUB I3                                                           IP010384
       ARS 18                                                           IP010385
       SUB ADDA                                                         IP010386
       STA LOCA                                                         IP010387
       LXD JZ3,4                                                        IP010388
       TXI *+1,4,1                                                      IP010389
 ST8   CLA 0,4            ADDRESS IS TOP OF COL J3                      IP010390
 LOCA  SUB 0,4            ADDRESS IS TOP OF CURRENT COL                 IP010391
       TZE ST7                                                          IP010392
       TMI ST1            CURRENT COL EXCEEDS J3. HENCE SKIP COL        IP010393
       CAL LOCA           TEST COL SMALLER. HENCE REPLACE J3            IP010394
       STA ST8                                                          IP010395
       SXD J3,2                                                         IP010396
       TXI ST6,1,MDIM                                                   IP010397
 ST7   TXI *+1,4,1                                                      IP010398
 LOCE  TXL ST8,4,0        DECREMENT M1                                  IP010399
       HTR *              TWO EQUAL COLUMNS                             IP010400
 ST13  LXD I3,1                                                         IP010401
       LXD I1,4                                                         IP010402
       CLA A+1,1                                                        IP010403
       SUB A+1,4                                                        IP010404
       TZE ST2            DO NOT REPLACE                                IP010405
       TPL ST2                                                          IP010406
       TRA ST15           REPLACE                                       IP010407
 ST10  LXD JZ1,4                                                        IP010408
       CAL ST8                                                          IP010409
       STA LOCB                                                         IP010410
 ST14  CLA 0,4            ADDRESS IS TOP OF COL J1                      IP010411
 LOCB  SUB 0,4            ADDRESS IS TOP OF COL J3                      IP010412
       TZE ST16                                                         IP010413
       TMI ST17           J3 EXCEEDS J1. HENCE REPLACE J1               IP010414
       TPL ST2            J2 EXCEEDS J3. HENCE SKIP ROW                 IP010415
 ST16  TXI *+1,4,1                                                      IP010416
 LOCC  TXL ST14,4,0       DECREMENT M1                                  IP010417
       HTR *              TWO EQUAL COLUMNS                             IP010418
 D1    PZE ,,1                                                          IP010419
 D2    PZE ,,2                                                          IP010420
 ADDA  HTR A+1                                                          IP010421
 I3    PZE                CURRENT ROW BEING TESTED                      IP010422
 J3    PZE                PIVOT COLUMN OF I3                            IP010423
 JZ3   PZE                ZERO COUNT OF J3                              IP010424
 JZ1   PZE                ZERO COUNT OF J1                              IP010425
 I1    SYN 10007                                                        IP010426
 J1    SYN 10008                                                        IP010427
 M1    SYN 10005                                                        IP010428
 N     SYN 10009                                                        IP010429
 K2    SYN 10004                                                        IP010430
JZEROS SYN 10930                                                        IP010431
 A     SYN 32562                                                        IP010432
 B     SYN 11242                                                        IP010433
 MDIM  EQU 204                                                          IP010434
 FINAL SYN *                                                            IP010435
       END SLCTR                                                        IP010436
      SUBROUTINE NURO                                                   IP010437
      COMMON A,LT,B,KC,JORDER,JZEROS,KR,U,D,INDEX,M,N,J1,I1,NUM,M1,K2,NNIP010438
     1,KC1,BND,ALPHA                                                    IP010439
      DIMENSION A(204,104),LT(104),B(104),KC(104),JORDER(104),JZEROS(104IP010440
     1),KR(204),U(204),D(204),INDEX(204),ALPHA(3)                       IP010441
      BMAX=0.0                                                          IP010442
      UMAX=1.0                                                          IP010443
      DO 5 J=2,N                                                        IP010444
      IF (B(J))12,5,5                                                   IP010445
   12 IF (J-J1)3,4,3                                                    IP010446
    4 U(J)=1.0                                                          IP010447
      GO TO 7                                                           IP010448
    3 JZ1=JZEROS(J)+2                                                   IP010449
      IF (A(JZ1-1,J1))999,5,10                                          IP010450
  999 STOP 61                                                           IP010451
   10 UU=A(JZ1-1,J)/A(JZ1-1,J1)                                         IP010452
      U(J)=INTF(UU)                                                     IP010453
      IF (UU-U(J))997,6,7                                               IP010454
  997 STOP 63                                                           IP010455
    6 DO 8 II=JZ1,M1                                                    IP010456
      IF (A(II,J)-A(II,J1)*U(J))9,8,7                                   IP010457
