      STOP 62                                                           IP010459
    9 U(J)=U(J)-1.0                                                     IP010460
    7 IF (BMAX*U(J)-UMAX*B(J))5,5,11                                    IP010461
   11 UMAX=U(J)                                                         IP010462
      BMAX=B(J)                                                         IP010463
    5 CONTINUE                                                          IP010464
      DO 20 J=1,N                                                       IP010465
      BB=-(B(J)*UMAX)/BMAX                                              IP010466
      B(J)=INTF(BB)                                                     IP010467
      IF (BB-B(J))24,20,20                                              IP010468
   24 B(J)=B(J)-1.0                                                     IP010469
   20 CONTINUE                                                          IP010470
      RETURN                                                            IP010471
