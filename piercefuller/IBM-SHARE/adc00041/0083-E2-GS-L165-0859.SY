C                                                                       16500690
C     LEAST SQUARES RATIONAL FUNCTION CURVE FITTING  PROGRAM L16500     16500691
C     A. ORICK                                                          16500692
C     FORTRAN 2                                                         16500693
C     DECK DATE 1959                                                    16500694
C     HEAD(1)=MINIMUM NOAS,(2)=MINIMUM NOBS,(3)=SCALE FACTOR FOR X,(4)= 16500695
C     SCALE FACTOR FOR Y,(5)=0.0FOR CALCULATING COEFFICIENTS AND 1.0 FOR16500696
C     INPUT COEFFICIENTS,(6)=0.0FOR NOT CALCULATING ROOTS OF DENOMINATOR16500697
C     AND1.0 FOR CALCULATING ROOTS OF DENOMINATOR,(7)=0.0 FOR NO INPUT  16500698
C     INITIALIZATION AND 1.0 FOR INPUT INITIALIZATION.                  16500699
C     END OF INPUT HEAD ITEMS                                           16500700
C     HEAD(8)=SCALE FACTOR USED FOR X,(9)=SCALE FACTOR USED FOR Y,(10)= 16500701
C     AVER 1,(11)=AVER 2,(12)=STANDARD ERROR OF ESTIMATE.               16500702
      DIMENSION SUMXS(25),SUMYXS(25),SUMYYX(24),ARRAY(26,25),ASABS(2    16500703
     15),YCALC(100),DEV1(100),DEV2(100),DROOTS(12),LIST(10),X(100),Y(10016500704
     2),NOPTS(1),NOAS(1),NOBS(1),MAXDEV(1),DOLOG(1),TABLE(1),TEMP(12),HE16500705
     3AD(12),JJJ(1),NASBS1(1)                                           16500706
     4,DENOMY(100),APLUSB(24),SAVE(13),ZLAST(100),Z(24),XNOAS(1),XNOBS(116500707
     5),NHEAD1(1),NHEAD2(1),NOAAA(1),NOBBB(1)                           16500708
      COMMON SUMXS,SUMYXS,SUMYYX,ARRAY,ASABS,YCALC,DEV1,DEV2,DROOTS,LIST16500709
     1,X,Y,NOPTS,NOAS,NOBS,MAXDEV,DOLOG,TABLE,TEMP,HEAD,JJJ,NASBS1      16500710
     2,DENOMY,APLUSB,SAVE,ZLAST,Z,XNOAS,XNOBS,NHEAD1,NHEAD2,NOAAA,NOBBB 16500711
      EQUIVALENCE (DOLOG,NLOG),(MAXDEV,BIGDEV),(TABLE,NTABL)            16500712
      EQUIVALENCE (AVER1,HEAD(10)),(AVER2,HEAD(11))                     16500713
      CALL INITL                                                        16500714
  110 CALL INPUT(LIST,X,Y,XNOAS,XNOBS,HEAD,BIGDEV,DOLOG,TABLE,ASABS)    16500715
      IF(HEAD(7))220,330,220                                            16500716
C     INITIALIZE INPUT STORAGES IF NECESSARY                            16500717
  220 CALL INITL                                                        16500718
      CALL INPUT                                                        16500719
  330 NOAS=XFIXF(XNOAS)                                                 16500720
      NOBS=XFIXF(XNOBS)                                                 16500721
      NHEAD1=XFIXF(HEAD(1))                                             16500722
      NHEAD2=XFIXF(HEAD(2))                                             16500723
      NOAAA=NOAS                                                        16500724
      NOBBB=NOBS                                                        16500725
      NOPTS=0                                                           16500726
C     COUNT NUMBER OF POINTS,SEARCH FOR FIRST -0.0 COORDINATE           16500727
C     DUMMY STATEMENTS USED FOR COMPILATION WHICH IS CHANGED LATER      16500728
      DO 350 I=1,100                                                    16500729
      IF(X(I)) 339,340,341                                              16500730
  339 GO TO 340                                                         16500731
  340 IF(Y(I))341,351,350                                               16500732
  341 GO TO 351                                                         16500733
  350 NOPTS=NOPTS+1                                                     16500734
  351 WRITE OUTPUT TAPE 3,9320                                          16500735
      WRITE OUTPUT TAPE 3,8801                                          16500736
      CALL WRITE1                                                       16500737
      IF(NOAS-NHEAD1)370,380,380                                        16500738
  370 WRITE OUTPUT TAPE 3,9700,NOAS,NHEAD1                              16500739
      NOAS=NHEAD1                                                       16500740
      NOAAA=NHEAD1                                                      16500741
  380 IF(NOBS-NHEAD2)390,500,500                                        16500742
  390 WRITE OUTPUT TAPE 3,9700,NOBS,NHEAD2                              16500743
      NOBS=NHEAD2                                                       16500744
      NOBBB=NHEAD2                                                      16500745
C     CHECK TO SEE IF NOAS AND NOBS ARE NOT NEGATIVE OR ZERO OR OVER 12 16500746
C     CHECK FOR OTHER POSSIBLE ERRORS                                   16500747
  500 IF(NHEAD1)2350,534,534                                            16500748
  534 IF(NHEAD2)2350,738,738                                            16500749
  738 IF(NOAS)2350,827,945                                              16500750
  827 IF(NOBS)2350,2350,1150                                            16500751
  945 IF(NOBS)2350,1150,1150                                            16500752
 1150 IF(NOAS-12)1352,1352,2350                                         16500753
 1352 IF(NOBS-12)1554,1554,2350                                         16500754
 1554 IF(NOPTS)2342,2342,2141                                           16500755
 2141 IF(HEAD(5))2160,2242,2160                                         16500756
 2160 HEAD(8)=1.0                                                       16500757
      HEAD(9)=1.0                                                       16500758
      GO TO 6978                                                        16500759
C     COEFFICIENTS ARE INPUT--GO TO SECTION WHICH CALCS.YPOINTS ONLY    16500760
 2242 HEAD(8)=0.0                                                       16500761
      HEAD(9)=0.0                                                       16500762
      IF(NOPTS-NOAS-NOBS-1)2342,2444,2444                               16500763
 2342 WRITE OUTPUT TAPE 3,9530                                          16500764
      GO TO 8765                                                        16500765
 2350 WRITE OUTPUT TAPE 3,9650                                          16500766
      GO TO 8765                                                        16500767
 2444 IF(NTABL)2546,2648,2546                                           16500768
 2546 WRITE OUTPUT TAPE 3,9003                                          16500769
      WRITE OUTPUT TAPE 3,9104,(X(I),Y(I),I=1,NOPTS)                    16500770
 2648 IF (DOLOG) 2754,3859,2754                                         16500771
 2754 IF(DOLOG-1.0)3050,2855,3050                                       16500772
 2855 DO 2956 I=1,NOPTS                                                 16500773
 2956 X(I)=LOGF(X(I))                                                   16500774
 3050 IF(DOLOG-2.0)3360,3165,3360                                       16500775
 3165 DO 3266 I=1,NOPTS                                                 16500776
 3266 Y(I)=LOGF(Y(I))                                                   16500777
 3360 IF(DOLOG-3.0)3680,3485,3680                                       16500778
 3485 DO 3556 I=1,NOPTS                                                 16500779
      X(I)=LOGF(X(I))                                                   16500780
 3556 Y(I)=LOGF(Y(I))                                                   16500781
 3680 IF(TABLE)3757,3859,3757                                           16500782
 3757 WRITE OUTPUT TAPE 3,8902                                          16500783
      WRITE OUTPUT TAPE 3,9104,(X(I),Y(I),I=1,NOPTS)                    16500784
 3859 IF ACCUMULATOR OVERFLOW 3870,3870                                 16500785
 3870 IF QUOTIENT OVERFLOW 3880,3880                                    16500786
 3880 IF DIVIDE CHECK 3890,3890                                         16500787
C     SCALE THE COORDINATES IF NECESSARY                                16500788
 3890 IF(HEAD(3)-1.0)4160,3968,4160                                     16500789
 3968 IF(HEAD(4)-1.0)4160,4069,4160                                     16500790
 4069 HEAD(8)=1.0                                                       16500791
      HEAD(9)=1.0                                                       16500792
      GO TO 4261                                                        16500793
 4160 IF(TABLE)4165,4170,4165                                           16500794
 4165 WRITE OUTPUT TAPE 3,9660                                          16500795
 4170 CALL SCALE                                                        16500796
      CALL DIAGN(1)                                                     16500797
C     CALCULATE THE THREE TABLES OF SUMS OF XPOWERS,Y*X POWERS, AND     16500798
C     Y**2*X POWERS                                                     16500799
 4261 CALL SUMS                                                         16500800
      CALL DIAGN(2)                                                     16500801
      IF(HEAD(8)-1.0)4461,4663,4461                                     16500802
 4461 DO 4562 I=1,NOPTS                                                 16500803
 4562 X(I)=X(I)*HEAD(8)                                                 16500804
 4663 IF(HEAD(9 )-1.0)4764,4966,4764                                    16500805
 4764 DO 4865 I=1,NOPTS                                                 16500806
 4865 Y(I)=Y(I)*HEAD(9 )                                                16500807
C     CHECK TO SEE IF CALCULATION IS TO MAKE SEARCH FOR ALL POSSIBILIT. 16500808
 4966 CALL DIAGN(3)                                                     16500809
      IF(NHEAD2)5010,5000,5010                                          16500810
 5000 IF(NOAS)5010,5005,5010                                            16500811
 5005 NHEAD2=1                                                          16500812
 5010 IF(NOAS-NHEAD1)5162,5070,5162                                     16500813
 5070 IF(NOBS-NHEAD2)5162,5080,5162                                     16500814
 5080 SAVE(1)=0.0                                                       16500815
      GO TO 5600                                                        16500816
 5162 SAVE(1)=1.0                                                       16500817
      IF(NHEAD1 )5463,5261,5463                                         16500818
 5261 IF(NHEAD2 )5463,5361,5463                                         16500819
 5361 NOAS=1                                                            16500820
      GO TO 5565                                                        16500821
 5463 NOAS=NHEAD1                                                       16500822
 5565 NOBS=NHEAD2                                                       16500823
 5600 GO TO 5730                                                        16500824
 5663 NOAS=NOAS                                                         16500825
      NOBS=NOBS                                                         16500826
      WRITE OUTPUT TAPE 3,9320                                          16500827
      WRITE OUTPUT TAPE 3,8801                                          16500828
      CALL WRITE1                                                       16500829
C     STORE THE ELEMENTS IN THE TWO-DIMENSIONAL ARRAY                   16500830
 5730 CALL STORAY                                                       16500831
      NASBS1=NOAS+NOBS+1                                                16500832
      JJJ=NASBS1*(NASBS1+1)                                             16500833
      DO 5780 K=1,25                                                    16500834
 5780 ASABS(K)=0.0                                                      16500835
C     GO TO THE SIMULTANEOUS EQUATIONS SUBROUTINE(CAGE)                 16500836
      CALL SIMEQ(ARRAY(JJJ  ),ASABS(NASBS1),NASBS1)                     16500837
      CALL DIAGN(4)                                                     16500838
C     REORDER NUMBER OF ASABS STORAGES BACKWARDS FOR FORTRAN            16500839
      DO 5971 K=1,NASBS1                                                16500840
 5971 DEV2(K)=ASABS(K)                                                  16500841
      J=NASBS1                                                          16500842
      DO 6072 K=1,NASBS1                                                16500843
      ASABS(K)=DEV2(J)                                                  16500844
 6072 J=J-1                                                             16500845
      IF(HEAD(8)-1.0)6240,6177,6240                                     16500846
 6177 IF(HEAD(9)-1.0)6240,6978,6240                                     16500847
C     RESCALES THE COEFFICIENTS IF THE COORDINATES WERE SCALED          16500848
 6240 IF(HEAD(8))6341,6978,6341                                         16500849
 6341 NOAS1=NOAS+1                                                      16500850
      DO 6560 I=1,NOAS1                                                 16500851
 6560 ASABS(I)=ASABS(I)*HEAD(9)/(HEAD(8))**(I-1)                        16500852
      IF(NOBS)6770,6876,6770                                            16500853
 6770 J=NOAS+2                                                          16500854
      DO 6875 I=1,NOBS                                                  16500855
      ASABS(J)=ASABS(J)/(HEAD(8))**(I)                                  16500856
 6875 J=J+1                                                             16500857
 6876 CALL DIAGN(5)                                                     16500858
 6978 JJJ=1                                                             16500859
      DO 7090 K=1,12                                                    16500860
 7090 TEMP(K)=0.0                                                       16500861
      DO 7100 K=1,24                                                    16500862
      APLUSB(K)=0.0                                                     16500863
 7100 Z(K)=0.0                                                          16500864
      DO 7110 K=10,12                                                   16500865
 7110 HEAD(K)=0.0                                                       16500866
      DO 7115 K=1,2                                                     16500867
 7115 DROOTS(K)=0.0                                                     16500868
C     GO TO THE SUBROUTINE WHCIH CALCS. NEW Y,S AND ROOTS OF DENOMINATOR16500869
      CALL CALCYS                                                       16500870
      CALL DIAGN(6)                                                     16500871
C     CALC. THE DEVIATIONS AND STANDARD ERROR OF ESTIMATE               16500872
      SUM1=ABSF(DEV1(1))                                                16500873
      SUM2=ABSF(DEV2(1))                                                16500874
      SUM3=DENOMY(1)*DENOMY(1)                                          16500875
      DO 7790 I=2,NOPTS                                                 16500876
      SUM1=SUM1+ABSF(DEV1(I))                                           16500877
      SUM3=SUM3+DENOMY(I)*DENOMY(I)                                     16500878
 7790 SUM2=SUM2+ABSF(DEV2(I))                                           16500879
      FNOPTS=FLOATF(NOPTS)                                              16500880
      AVER1=SUM1/FNOPTS                                                 16500881
      AVER2=SUM2/FNOPTS                                                 16500882
      HEAD(12)=SUM3/FNOPTS                                              16500883
      HEAD(12)=SQRTF(HEAD(12))                                          16500884
      CALL DIAGN(7)                                                     16500885
      IF(TABLE-2.0)7850,7800,7850                                       16500886
 7800 WRITE OUTPUT TAPE 3,9200,(DOLOG(K),DOLOG(K+225),DOLOG(K+450),DOLOG16500887
     1(K+675),DOLOG(K+900),DOLOG(K+1125),DOLOG(K+1350),K=1,225)         16500888
C     WRITE THE REGULAR OUTPUT                                          16500889
 7850 CALL WRITE2                                                       16500890
      IF(HEAD(5))8765,7891,8765                                         16500891
C     TEST TO SEE IF CURVE FITS THE DEVIATION SPECIFIED BY INPUT        16500892
 7891 BIGDEV=ABSF(BIGDEV)                                               16500893
      IF(BIGDEV)7993,8180,7993                                          16500894
 7993 DO 8095 I=1,NOPTS                                                 16500895
      DEV2(I)=ABSF(DEV2(I))                                             16500896
      IF(BIGDEV-DEV2(I))8180,8095,8095                                  16500897
 8095 CONTINUE                                                          16500898
      WRITE OUTPUT TAPE 3,9625,BIGDEV                                   16500899
      GO TO 8765                                                        16500900
 8180 IF(SAVE(1))8390,8765,8390                                         16500901
 8390 IF(NOAAA-NOAS)8505,8400,8505                                      16500902
 8400 IF(NOBBB-NOBS)8615,8765,8615                                      16500903
 8505 NOAS=NOAS+1                                                       16500904
      GO TO 5663                                                        16500905
 8615 NOBS=NOBS+1                                                       16500906
      NOAS=NHEAD1                                                       16500907
C     GO BACK TO MAKE SEARCH FOR NEXT POSSIBLITY OF CURVE FIT           16500908
      GO TO 5663                                                        16500909
C     END OF CALCULATION                                                16500910
 8765 WRITE OUTPUT TAPE 3,9710                                          16500911
      GO TO 110                                                         16500912
 8801 FORMAT( 73H                                                       16500913
     1                  )                                               16500914
 8902 FORMAT(26H0LOGARITHMS OF COORDINATES)                             16500915
 9003 FORMAT(12H0COORDINATES)                                           16500916
 9104 FORMAT(E16.8,E31.8)                                               16500917
 9200 FORMAT(7E17.7)                                                    16500918
 9320 FORMAT(65H1LEAST SQUARES RATIONAL FUNCTION CURVE FITTING PROGRAM N16500919
     1O. L16500)                                                        16500920
 9530 FORMAT(55H0NO. OF POINTS INSUFFICIENT FOR PROBLEM, NO CALCULATION)16500921
 9625 FORMAT(44H0FUNCTION FITS CURVE TO SPECIFIED DEVIATION,E16.8)      16500922
 9650 FORMAT(40H0ERROR DETECTED IN INPUT, NO CALCULATION)               16500923
 9660 FORMAT(19H0SCALED COORDINATES)                                    16500924
 9700 FORMAT(49H0ERROR, MAXIMUM POWER SET EQUAL TO MINIMUM POWER,2I6)   16500925
 9710 FORMAT(4H0END)                                                    16500926
      END(0,1,0,0,0)                                                    16500927
      SUBROUTINE WRITE2                                                 16500928
C     WRITES THE OUTPUT LISTING                                         16500929
      DIMENSION SUMXS(25),SUMYXS(25),SUMYYX(24),ARRAY(26,25),ASABS(2    16500930
     15),YCALC(100),DEV1(100),DEV2(100),DROOTS(12),LIST(10),X(100),Y(10016500931
     2),NOPTS(1),NOAS(1),NOBS(1),MAXDEV(1),DOLOG(1),TABLE(1),TEMP(12),HE16500932
     3AD(12),JJJ(1),NASBS1(1)                                           16500933
     4,DENOMY(100),APLUSB(24),SAVE(13),ZLAST(100),Z(24),XNOAS(1),XNOBS(116500934
     5),NHEAD1(1),NHEAD2(1),NOAAA(1),NOBBB(1)                           16500935
      COMMON SUMXS,SUMYXS,SUMYYX,ARRAY,ASABS,YCALC,DEV1,DEV2,DROOTS,LIST16500936
     1,X,Y,NOPTS,NOAS,NOBS,MAXDEV,DOLOG,TABLE,TEMP,HEAD,JJJ,NASBS1      16500937
     2,DENOMY,APLUSB,SAVE,ZLAST,Z,XNOAS,XNOBS,NHEAD1,NHEAD2,NOAAA,NOBBB 16500938
      EQUIVALENCE (DOLOG,NLOG),(MAXDEV,BIGDEV),(TABLE,NTABL)            16500939
      EQUIVALENCE (AVER1,HEAD(10)),(AVER2,HEAD(11))                     16500940
      IF(HEAD(8)-1.0)30,40,30                                           16500941
   30 WRITE OUTPUT TAPE 3,155,HEAD(8)                                   16500942
   40 IF(HEAD(9)-1.0)45,48,45                                           16500943
   45 WRITE OUTPUT TAPE 3,156,HEAD(9)                                   16500944
   48 WRITE OUTPUT TAPE 3,159                                           16500945
      ONE=1.0                                                           16500946
      WRITE OUTPUT TAPE 3,139,ASABS(1),ONE                              16500947
      J=NOAS+2                                                          16500948
      I=2                                                               16500949
      LMINAB=XMIN0F(NOAS,NOBS)                                          16500950
      NOAS1=NOAS+1                                                      16500951
      NOBS2=NOBS+2                                                      16500952
      IF(NOAS)50,101,50                                                 16500953
   50 IF(NOBS)60,101,60                                                 16500954
   60 DO 100 K=1,LMINAB                                                 16500955
      WRITE OUTPUT TAPE 3,139,(ASABS(I),ASABS(J))                       16500956
      I=I+1                                                             16500957
  100 J=J+1                                                             16500958
  101 J=J                                                               16500959
      LMINAB=LMINAB+1                                                   16500960
      IF(NOAS-NOBS)110,120,115                                          16500961
  110 DO 112 K=LMINAB,NOBS                                              16500962
      WRITE OUTPUT TAPE 3,138,(ASABS(J))                                16500963
  112 J=J+1                                                             16500964
      GO TO 120                                                         16500965
  115 WRITE OUTPUT TAPE 3,141,(ASABS(I),I=NOBS2,NOAS1)                  16500966
  120 IF(NOBS-2)122,122,121                                             16500967
  121 IF(HEAD(6))122,130,122                                            16500968
  122 IF(NOBS)130,130,123                                               16500969
  123 WRITE OUTPUT TAPE 3,136                                           16500970
      IF(JJJ)126,125,126                                                16500971
  125 WRITE OUTPUT TAPE 3,131                                           16500972
      GO TO 130                                                         16500973
  126 IF(NOBS-3)127,129,129                                             16500974
  127 WRITE OUTPUT TAPE 3,138,(DROOTS(I),I=1,NOBS)                      16500975
      GO TO 130                                                         16500976
  129 WRITE OUTPUT TAPE 3,145                                           16500977
      NNOBS=2*NOBS                                                      16500978
      WRITE OUTPUT TAPE 3,139,(APLUSB(I),APLUSB(I+1),I=1,NNOBS,2)       16500979
  130 WRITE OUTPUT TAPE 3,132                                           16500980
      WRITE OUTPUT TAPE 3,133                                           16500981
      WRITE OUTPUT TAPE 3,134                                           16500982
      WRITE OUTPUT TAPE 3,160                                           16500983
      WRITE OUTPUT TAPE 3,137,(X(I),Y(I),YCALC(I),DENOMY(I),DEV1(I),DEV216500984
     1(I),I=1,NOPTS)                                                    16500985
      WRITE OUTPUT TAPE 3,135                                           16500986
      WRITE OUTPUT TAPE 3,140,HEAD(12),HEAD(10),HEAD(11)                16500987
      RETURN                                                            16500988
  131 FORMAT(51H                                ROOTS ARE COMPLEX  )    16500989
  132 FORMAT(18H0CHECK COORDINATES)                                     16500990
  133 FORMAT(102H        INPUT X,S        INPUT Y,S        CALC. Y,S   S16500991
     1TANDARD ERROR      ERROR RATIO            ERROR)                  16500992
  134 FORMAT(102H                                                      I16500993
     1N.Y*CALC.DEN.   (CALC.Y-INP.Y)     CALC.Y-INP.Y)                  16500994
  135 FORMAT(102H                                                       16500995
     1      AVERAGE          AVERAGE          AVERAGE)                  16500996
  136 FORMAT(52H0                               ROOTS OF DENOMINATOR)   16500997
  137 FORMAT(6E17.8)                                                    16500998
  138 FORMAT(E47.8)                                                     16500999
  139 FORMAT(E16.8,E31.8)                                               16500000
  140 FORMAT(E68.8,E17.8,E17.8)                                         16500001
  141 FORMAT(E16.8)                                                     16500002
  145 FORMAT(54H REAL TERM OF ROOT              IMAGINARY TERM OF ROOT) 16500003
  155 FORMAT(50H BEFORE CALCULATIONS X-COORDINATES WERE SCALED BY E16.8)16500004
  156 FORMAT(50H BEFORE CALCULATIONS Y-COORDINATES WERE SCALED BY E16.8)16500005
  159 FORMAT(56H0NUMERATOR COEFFICIENTS         DENOMINATOR COEFFICIENTS16500006
     1)                                                                 16500007
  160 FORMAT( 85H                                                       16500008
     1   -CALC.NUM.           /INP.Y)                                   16500009
      END(0,1,0,0,0)                                                    16500010
      SUBROUTINE ERROR                                                  16500011
C     PRINTS ERROR RETURN WHEN ROOTS SUBROUTINE DOES NOT CONVERGE       16500012
      WRITE OUTPUT TAPE 3,100                                           16500013
      RETURN                                                            16500014
  100 FORMAT(58H0EVERY ROOT OF THE DENOMINATOR POLYNOMIAL DID NOT CONVER16500015
     1GE)                                                               16500016
      END(0,1,0,0,0)                                                    16500017
      SUBROUTINE WRITE1                                                 16500018
C     WRITES INPUT LISTING                                              16500019
      DIMENSION SUMXS(25),SUMYXS(25),SUMYYX(24),ARRAY(26,25),ASABS(2    16500020
     15),YCALC(100),DEV1(100),DEV2(100),DROOTS(12),LIST(10),X(100),Y(10016500021
     2),NOPTS(1),NOAS(1),NOBS(1),MAXDEV(1),DOLOG(1),TABLE(1),TEMP(12),HE16500022
     3AD(12),JJJ(1),NASBS1(1)                                           16500023
     4,DENOMY(100),APLUSB(24),SAVE(13),ZLAST(100),Z(24),XNOAS(1),XNOBS(116500024
     5),NHEAD1(1),NHEAD2(1),NOAAA(1),NOBBB(1)                           16500025
      COMMON SUMXS,SUMYXS,SUMYYX,ARRAY,ASABS,YCALC,DEV1,DEV2,DROOTS,LIST16500026
     1,X,Y,NOPTS,NOAS,NOBS,MAXDEV,DOLOG,TABLE,TEMP,HEAD,JJJ,NASBS1      16500027
     2,DENOMY,APLUSB,SAVE,ZLAST,Z,XNOAS,XNOBS,NHEAD1,NHEAD2,NOAAA,NOBBB 16500028
      EQUIVALENCE (DOLOG,NLOG),(MAXDEV,BIGDEV),(TABLE,NTABL)            16500029
      EQUIVALENCE (AVER1,HEAD(10)),(AVER2,HEAD(11))                     16500030
      WRITE OUTPUT TAPE 3,121                                           16500031
      WRITE OUTPUT TAPE 3,122,NOPTS                                     16500032
      WRITE OUTPUT TAPE 3,123,NOAAA,NOBBB                               16500033
      WRITE OUTPUT TAPE 3,133,NHEAD1,NHEAD2                             16500034
      IF(NTABL)18,19,18                                                 16500035
   18 WRITE OUTPUT TAPE 3,125                                           16500036
   19 IF(NLOG)21,30,21                                                  16500037
   21 IF(DOLOG-1.0)24,22,24                                             16500038
   22 WRITE OUTPUT TAPE 3,130                                           16500039
   24 IF(DOLOG-2.0)26,25,26                                             16500040
   25 WRITE OUTPUT TAPE 3,132                                           16500041
   26 IF(DOLOG-3.0)30,28,30                                             16500042
   28 WRITE OUTPUT TAPE 3,124                                           16500043
   30 WRITE OUTPUT TAPE 3,126,BIGDEV                                    16500044
      IF(HEAD(5))32,34,32                                               16500045
   32 WRITE OUTPUT TAPE 3,140                                           16500046
   34 IF(HEAD(7))35,37,35                                               16500047
   35 WRITE OUTPUT TAPE 3,145                                           16500048
   37 IF(HEAD(6))38,39,38                                               16500049
   38 WRITE OUTPUT TAPE 3,149                                           16500050
   39 WRITE OUTPUT TAPE 3,128                                           16500051
   90 RETURN                                                            16500052
  121 FORMAT(22H0INPUT DATA AS ENTERED)                                 16500053
  122 FORMAT(15H NO. OF POINTS=I3)                                      16500054
  123 FORMAT(33H MAXIMUM POWER OF X IN NUMERATOR=I2,37H   MAXIMUM POWER 16500055
     1OF X IN DENOMINATOR=I2)                                           16500056
  124 FORMAT(41H LOGARITHMS OF COORDINATES ARE CALCULATED)              16500057
  125 FORMAT(32H INTERMEDIATE TABLES ARE PRINTED)                       16500058
  126 FORMAT(27H MAXIMUM DEVIATION ALLOWED=E16.8)                       16500059
  128 FORMAT(21H0OUTPUT AS CALCULATED)                                  16500060
  130 FORMAT(43H LOGARITHMS OF X-COORDINATES ARE CALCULATED)            16500061
  132 FORMAT(43H LOGARITHMS OF Y-COORDINATES ARE CALCULATED)            16500062
  133 FORMAT(33H MINIMUM POWER OF X IN NUMERATOR=I2,37H   MINIMUM POWER 16500063
     1OF X IN DENOMINATOR=I2)                                           16500064
  140 FORMAT(35H COEFFICIENTS OF FUNCTION ARE INPUT)                    16500065
  145 FORMAT(39H INPUT STORAGES WERE INITIALIZED TO -0.)                16500066
  149 FORMAT(47H ROOTS OF DENOMINATOR POLYNOMIAL ARE CALCULATED)        16500067
      END(0,1,0,0,0)                                                    16500068
      SUBROUTINE ROOT1                                                  16500069
C     PREPARES FOR THE NEXT SUBROUTINE TO FIND THE ROOTS OF THE         16500070
C     DENOMINATOR POLYNOMIAL--PLACES F(X),S OF DENOMINATOR IN           16500071
C     ZLAST(100) TO ZLAST(75) AND X,S IN ZLAST(70) TO ZLAST(45)         16500072
C     REAL PART FOLLOWED BY IMAGINARY PART =0                           16500073
      DIMENSION SUMXS(25),SUMYXS(25),SUMYYX(24),ARRAY(26,25),ASABS(2    16500074
     15),YCALC(100),DEV1(100),DEV2(100),DROOTS(12),LIST(10),X(100),Y(10016500075
     2),NOPTS(1),NOAS(1),NOBS(1),MAXDEV(1),DOLOG(1),TABLE(1),TEMP(12),HE16500076
     3AD(12),JJJ(1),NASBS1(1)                                           16500077
     4,DENOMY(100),APLUSB(24),SAVE(13),ZLAST(100),Z(24),XNOAS(1),XNOBS(116500078
     5),NHEAD1(1),NHEAD2(1)                                             16500079
      COMMON SUMXS,SUMYXS,SUMYYX,ARRAY,ASABS,YCALC,DEV1,DEV2,DROOTS,LIST16500080
     1,X,Y,NOPTS,NOAS,NOBS,MAXDEV,DOLOG,TABLE,TEMP,HEAD,JJJ,NASBS1      16500081
     2,DENOMY,APLUSB,SAVE,ZLAST,Z,XNOAS,XNOBS,NHEAD1,NHEAD2             16500082
      EQUIVALENCE (DOLOG,NLOG),(MAXDEV,BIGDEV),(TABLE,NTABL)            16500083
      EQUIVALENCE (AVER1,HEAD(10)),(AVER2,HEAD(11))                     16500084
      NOBS1=NOBS+1                                                      16500085
      J=NOBS1                                                           16500086
      N100=100                                                          16500087
      M70=70                                                            16500088
      DO 500 K=1,NOBS1                                                  16500089
      ZLAST(N100)=ZLAST(J)                                              16500090
      ZLAST(N100-1)=0                                                   16500091
      ZLAST(M70)=X(J)                                                   16500092
      ZLAST(M70-1)=0                                                    16500093
      N100=N100-2                                                       16500094
      M70=M70-2                                                         16500095
  500 J=J-1                                                             16500096
C     CHANGE BINARY CARD TO TRA 10,4 OCTAL                              16500097
      RETURN                                                            16500098
      END(0,1,0,0,0)                                                    16500099
      SUBROUTINE INITLS                                                 16500100
C     INITIALIZES ALL INPUT STORAGES TO 0.0, 0, OR -0.0                 16500101
      DIMENSION SUMXS(25),SUMYXS(25),SUMYYX(24),ARRAY(26,25),ASABS(2    16500102
     15),YCALC(100),DEV1(100),DEV2(100),DROOTS(12),LIST(10),X(100),Y(10016500103
     2),NOPTS(1),NOAS(1),NOBS(1),MAXDEV(1),DOLOG(1),TABLE(1),TEMP(12),HE16500104
     3AD(12),JJJ(1),NASBS1(1)                                           16500105
     4,DENOMY(100),APLUSB(24),SAVE(13),ZLAST(100),Z(24),XNOAS(1),XNOBS(116500106
     5),NHEAD1(1),NHEAD2(1)                                             16500107
      COMMON SUMXS,SUMYXS,SUMYYX,ARRAY,ASABS,YCALC,DEV1,DEV2,DROOTS,LIST16500108
     1,X,Y,NOPTS,NOAS,NOBS,MAXDEV,DOLOG,TABLE,TEMP,HEAD,JJJ,NASBS1      16500109
     2,DENOMY,APLUSB,SAVE,ZLAST,Z,XNOAS,XNOBS,NHEAD1,NHEAD2             16500110
      EQUIVALENCE (DOLOG,NLOG),(MAXDEV,BIGDEV),(TABLE,NTABL)            16500111
      EQUIVALENCE (AVER1,HEAD(10)),(AVER2,HEAD(11))                     16500112
      DO 22 I=1,100                                                     16500113
      X(I)=-0.0                                                         16500114
   22 Y(I)=-0.0                                                         16500115
      DO 24 I=1,12                                                      16500116
   24 HEAD(I)=0.0                                                       16500117
      DO 28 I=1,25                                                      16500118
   28 ASABS(I)=0.0                                                      16500119
      XNOAS=0.0                                                         16500120
      XNOBS=0.0                                                         16500121
      NTABL=0                                                           16500122
      NLOG=0                                                            16500123
      BIGDEV=0.0                                                        16500124
      RETURN                                                            16500125
      END(0,1,0,0,0)                                                    16500126
      SUBROUTINE STORAY                                                 16500127
C     STORES SUMS PACKED IN 2-DIMENSIONAL ARRAY                         16500128
C     ARRAY MUST BE STORED IN FORWARD HORIZONTAL ROWS FOR CAGE SIM.EQ.  16500129
      DIMENSION SUMXS(25),SUMYXS(25),SUMYYX(24),ARRAY(26,25),ASABS(2    16500130
     15),YCALC(100),DEV1(100),DEV2(100),DROOTS(12),LIST(10),X(100),Y(10016500131
     2),NOPTS(1),NOAS(1),NOBS(1),MAXDEV(1),DOLOG(1),TABLE(1),TEMP(12),HE16500132
     3AD(12),JJJ(1),NASBS1(1)                                           16500133
      COMMON SUMXS,SUMYXS,SUMYYX,ARRAY,ASABS,YCALC,DEV1,DEV2,DROOTS,LIST16500134
     1,X,Y,NOPTS,NOAS,NOBS,MAXDEV,DOLOG,TABLE,TEMP,HEAD,JJJ,NASBS1      16500135
      EQUIVALENCE (DOLOG,NLOG),(MAXDEV,BIGDEV),(TABLE,NTABL)            16500136
      EQUIVALENCE (AVER1,HEAD(10)),(AVER2,HEAD(11))                     16500137
      NOBS1=NOBS+1                                                      16500138
      NOBS2=NOBS+2                                                      16500139
      NNOAS=2*NOAS                                                      16500140
      NNOBS=2*NOBS                                                      16500141
      NOAS1=NOAS+1                                                      16500142
      NASBS2=NOBS2+NOAS                                                 16500143
      NASBS1=NOBS1+NOAS                                                 16500144
      IF(NOBS)120,131,120                                               16500145
C     SKIP SEVERAL SECTIONS IF TRYING TO FIT POLYNOMIAL ONLY(NO DENOM.) 16500146
C     REVERSE STORES COLUMN OF CONSTANT TERMS AT END OF EACH HORIZ. ROW 16500147
  120 DO 122 K=1,NOBS                                                   16500148
      J=NOBS1-K                                                         16500149
  122 ARRAY(1,K)=SUMYYX(J)                                              16500150
C     REVERSE STORES NEGATIVE SUMS (Y*Y*X**N) IN LOWER RIGHT 1/4 OFARRAY16500151
      DO 125 I=1,NOBS                                                   16500152
      DO 125 K=2,NOBS1                                                  16500153
      J=NNOBS+3-(K+I)                                                   16500154
  125 ARRAY(K,I)=-SUMYYX(J)                                             16500155
C     REVERSE STORES SUMS (YX**N) IN LOWER LEFT 1/4 OF ARRAY            16500156
      DO 128 I=1,NOBS                                                   16500157
      DO 128 K=NOBS2,NASBS2                                             16500158
      J=NOAS+NNOBS+4-(K+I)                                              16500159
  128 ARRAY(K,I)=SUMYXS(J)                                              16500160
C     REVERSE STORES NEGATIVE SUMS (YX**N) IN UPPER RIGHT 1/4 OF ARRAY  16500161
      DO 130 I=NOBS1,NASBS1                                             16500162
      DO 130 K=2,NOBS1                                                  16500163
      J=NOAS+NNOBS+4-(K+I)                                              16500164
  130 ARRAY(K,I)=-SUMYXS(J)                                             16500165
C     REVERSE STORES COLUMN OF CONSTANT TERMS AT END OF EACH HORIZ.ROW  16500166
  131 KK=1                                                              16500167
      DO 132 K=NOBS1,NASBS1                                             16500168
      J=NOAS+2-KK                                                       16500169
      KK=KK+1                                                           16500170
  132 ARRAY(1,K)=SUMYXS(J)                                              16500171
C     REVERSE STORES SUMS (X**N) IN UPPER LEFT 1/4 OF ARRAY             16500172
      DO 133 I=NOBS1,NASBS1                                             16500173
      DO 133 K=NOBS2,NASBS2                                             16500174
      J=NNOAS+NNOBS+4-(K+I)                                             16500175
  133 ARRAY(K,I)=SUMXS(J)                                               16500176
C     PACKS ARRAY SO NO BLANK SPACES LEFT IN ROWS OF 2-DIMENSIONAL ARRAY16500177
      J=NASBS2+1                                                        16500178
      DO 135 I=2,NASBS1                                                 16500179
      DO 135 K=1,NASBS2                                                 16500180
      ARRAY(J)=ARRAY(K,I)                                               16500181
  135 J=J+1                                                             16500182
      JJJ=J-1                                                           16500183
  140 IF (TABLE)141,143,141                                             16500184
  141 WRITE OUTPUT TAPE 3,142,(ARRAY(J),ARRAY(J+1),ARRAY(J+2),          16500185
     1ARRAY(J+3),ARRAY(J+4),ARRAY(J+5),ARRAY(J+6),J=1,JJJ,7)            16500186
  142 FORMAT(7E16.8)                                                    16500187
  143 RETURN                                                            16500188
      END(0,1,0,0,0)                                                    16500189
      SUBROUTINE DIAGN(NUMBER)                                          16500190
C     DIAGNOSES ERRORS AND PRINTS OUT ERROR COMMENTS                    16500191
      DIMENSION SUMXS(25),SUMYXS(25),SUMYYX(24),ARRAY(26,25),ASABS(2    16500192
     15),YCALC(100),DEV1(100),DEV2(100),DROOTS(12),LIST(10),X(100),Y(10016500193
     2),NOPTS(1),NOAS(1),NOBS(1),MAXDEV(1),DOLOG(1),TABLE(1),TEMP(12),HE16500194
     3AD(12),JJJ(1),NASBS1(1)                                           16500195
     4,DENOMY(100),APLUSB(24),SAVE(13),ZLAST(100),Z(24),XNOAS(1),XNOBS(116500196
     5),NHEAD1(1),NHEAD2(1)                                             16500197
      COMMON SUMXS,SUMYXS,SUMYYX,ARRAY,ASABS,YCALC,DEV1,DEV2,DROOTS,LIST16500198
     1,X,Y,NOPTS,NOAS,NOBS,MAXDEV,DOLOG,TABLE,TEMP,HEAD,JJJ,NASBS1      16500199
     2,DENOMY,APLUSB,SAVE,ZLAST,Z,XNOAS,XNOBS,NHEAD1,NHEAD2             16500200
      EQUIVALENCE (DOLOG,NLOG),(MAXDEV,BIGDEV),(TABLE,NTABL)            16500201
      EQUIVALENCE (AVER1,HEAD(10)),(AVER2,HEAD(11))                     16500202
      IF ACCUMULATOR OVERFLOW 60,65                                     16500203
   60 WRITE OUTPUT TAPE 3,142,NUMBER                                    16500204
   65 IF QUOTIENT OVERFLOW 70,75                                        16500205
   70 WRITE OUTPUT TAPE 3,143,NUMBER                                    16500206
   75 IF DIVIDE CHECK 80,85                                             16500207
   80 WRITE OUTPUT TAPE 3,144,NUMBER                                    16500208
   85 RETURN                                                            16500209
  142 FORMAT(38H0ACC. OVERFLOWED DURING CALCULATION   I2)               16500210
  143 FORMAT(37H0MQ. OVERFLOWED DURING CALCULATION   I2)                16500211
  144 FORMAT(48H0DIVIDE CHECK INDICATOR ON DURING CALCULATION   I2)     16500212
      END(0,1,0,0,0)                                                    16500213
      SUBROUTINE SCALE                                                  16500214
C     SCALES ALL COORDINATES IF NECESSARY                               16500215
      DIMENSION SUMXS(25),SUMYXS(25),SUMYYX(24),ARRAY(26,25),ASABS(2    16500216
     15),YCALC(100),DEV1(100),DEV2(100),DROOTS(12),LIST(10),X(100),Y(10016500217
     2),NOPTS(1),NOAS(1),NOBS(1),MAXDEV(1),DOLOG(1),TABLE(1),TEMP(12),HE16500218
     3AD(12),JJJ(1),NASBS1(1)                                           16500219
     4,DENOMY(100),APLUSB(24),SAVE(13),ZLAST(100),Z(24),XNOAS(1),XNOBS(116500220
     5),NHEAD1(1),NHEAD2(1)                                             16500221
      COMMON SUMXS,SUMYXS,SUMYYX,ARRAY,ASABS,YCALC,DEV1,DEV2,DROOTS,LIST16500222
     1,X,Y,NOPTS,NOAS,NOBS,MAXDEV,DOLOG,TABLE,TEMP,HEAD,JJJ,NASBS1      16500223
     2,DENOMY,APLUSB,SAVE,ZLAST,Z,XNOAS,XNOBS,NHEAD1,NHEAD2             16500224
      EQUIVALENCE (DOLOG,NLOG),(MAXDEV,BIGDEV),(TABLE,NTABL)            16500225
      EQUIVALENCE (AVER1,HEAD(10)),(AVER2,HEAD(11))                     16500226
  110 XMAX=ABSF(X(1))                                                   16500227
      XMIN=XMAX                                                         16500228
      YMAX=ABSF(Y(1))                                                   16500229
      YMIN=YMAX                                                         16500230
      DO 120 I=1,NOPTS                                                  16500231
      XABSOL=ABSF(X(I))                                                 16500232
      YABSOL=ABSF(Y(I))                                                 16500233
      IF(XABSOL)115,118,115                                             16500234
  115 XMIN=MIN1F(XMIN,XABSOL)                                           16500235
      XMAX=MAX1F(XMAX,XABSOL)                                           16500236
  118 IF(YABSOL)119,120,119                                             16500237
  119 YMIN=MIN1F(YMIN,YABSOL)                                           16500238
      YMAX=MAX1F(YMAX,YABSOL)                                           16500239
  120 CONTINUE                                                          16500240
      CONTINUE                                                          16500241
  121 IF(HEAD(3))124,122,124                                            16500242
  122 HEAD(3)=XMAX                                                      16500243
      GO TO 125                                                         16500244
  124 IF(1.0-HEAD(3))125,135,125                                        16500245
  125 SCALEX=HEAD(3)                                                    16500246
      DO 130 I=1,NOPTS                                                  16500247
  130 X(I)=X(I)/SCALEX                                                  16500248
      GO TO 136                                                         16500249
  135 SCALEX=1.0                                                        16500250
  136 CONTINUE                                                          16500251
  137 IF(HEAD(4))140,138,140                                            16500252
  138 HEAD(4)=YMAX                                                      16500253
      GO TO 141                                                         16500254
  140 IF(1.0-HEAD(4))141,147,141                                        16500255
  141 SCALEY=HEAD(4)                                                    16500256
      DO 142 I=1,NOPTS                                                  16500257
  142 Y(I)=Y(I)/SCALEY                                                  16500258
      GO TO 148                                                         16500259
  147 SCALEY=1.0                                                        16500260
  148 XMAX=XMAX/SCALEX                                                  16500261
      YMAX=YMAX/SCALEY                                                  16500262
      IF(XMAX-XMIN-10000.0)150,150,149                                  16500263
  149 WRITE OUTPUT TAPE 3,200,XMIN,XMAX                                 16500264
  150 IF(YMAX-YMIN-10000.0)160,160,155                                  16500265
  155 WRITE OUTPUT TAPE 3,200,YMIN,YMAX                                 16500266
  160 HEAD(8)=SCALEX                                                    16500267
      HEAD(9 )=SCALEY                                                   16500268
      IF(TABLE)162,175 ,162                                             16500269
  162 IF(HEAD(8)-1.0)170,165,170                                        16500270
  165 IF(HEAD(9)-1.0)170,175,170                                        16500271
  170 WRITE OUTPUT TAPE 3,205,(X(I),Y(I),I=1,NOPTS)                     16500272
  175 RETURN                                                            16500273
  200 FORMAT(73H0CAUTION, EXTENDED RANGE OF COORDINATES MAY CAUSE UNDERF16500274
     1LOW, MIN.COORD.=   E16.8,14H   MAX.COORD.=  E16.8)                16500275
  205 FORMAT(E16.8,E31.8)                                               16500276
      END(0,1,0,0,0)                                                    16500277
      SUBROUTINE CALCYS                                                 16500278
C     CALCULATES THE Y OF THE RATIONAL FUNCTION AS WELL AS THE ROOTS OF 16500279
C     THE DENOMINATOR POLYNOMIAL                                        16500280
C     CALCULATES THE DEVIATION OF THE YCALC FROM THE INPUT Y            16500281
      DIMENSION SUMXS(25),SUMYXS(25),SUMYYX(24),ARRAY(26,25),ASABS(2    16500282
     15),YCALC(100),DEV1(100),DEV2(100),DROOTS(12),LIST(10),X(100),Y(10016500283
     2),NOPTS(1),NOAS(1),NOBS(1),MAXDEV(1),DOLOG(1),TABLE(1),TEMP(12),HE16500284
     3AD(12),JJJ(1),NASBS1(1)                                           16500285
     4,DENOMY(100),APLUSB(24),SAVE(13),ZLAST(100),Z(24),XNOAS(1),XNOBS(116500286
     5),NHEAD1(1),NHEAD2(1),NOAAA(1),NOBBB(1)                           16500287
      COMMON SUMXS,SUMYXS,SUMYYX,ARRAY,ASABS,YCALC,DEV1,DEV2,DROOTS,LIST16500288
     1,X,Y,NOPTS,NOAS,NOBS,MAXDEV,DOLOG,TABLE,TEMP,HEAD,JJJ,NASBS1      16500289
     2,DENOMY,APLUSB,SAVE,ZLAST,Z,XNOAS,XNOBS,NHEAD1,NHEAD2,NOAAA,NOBBB 16500290
      EQUIVALENCE (DOLOG,NLOG),(MAXDEV,BIGDEV),(TABLE,NTABL)            16500291
      EQUIVALENCE (AVER1,HEAD(10)),(AVER2,HEAD(11))                     16500292
      NOASM1=NOAS-1                                                     16500293
      NOAS1=NOAS+1                                                      16500294
      NOAS2=NOAS+2                                                      16500295
      NOASP1=XMAX0F(NOAS  ,NOBS)                                        16500296
      NASBSP=NOAS+NOBS+2                                                16500297
      DO 225 I=1,NOPTS                                                  16500298
      TEMP(1)=X(I)                                                      16500299
      IF(NOASP1-2)200,190,190                                           16500300
  190 DO 195 J=2,NOASP1                                                 16500301
  195 TEMP(J)=TEMP(J-1)*X(I)                                            16500302
  200 ANUM=ASABS(1)                                                     16500303
      IF(NOAS)201,203,201                                               16500304
  201 DO 202 K=2,NOAS1                                                  16500305
      P1=ASABS(K)*TEMP(K-1)                                             16500306
  202 ANUM=ANUM+P1                                                      16500307
  203 DENOM=1.0                                                         16500308
      IF(NOBS)204,206,204                                               16500309
  204 J=NOAS2                                                           16500310
      DO 205 K=1,NOBS                                                   16500311
      P1=ASABS(J)*TEMP(K)                                               16500312
      J=J+1                                                             16500313
  205 DENOM=DENOM+P1                                                    16500314
  206 ZLAST(I)=DENOM                                                    16500315
      IF(DENOM)210,208,210                                              16500316
  208 YCALC(I)=10.0E+37                                                 16500317
      GO TO 212                                                         16500318
  210 YCALC(I)=ANUM/DENOM                                               16500319
  212 DEV2(I)=YCALC(I)-Y(I)                                             16500320
      DENOMY(I)=Y(I)*DENOM-ANUM                                         16500321
      IF(Y(I))224,215,224                                               16500322
  215 DEV1(I)=-0.0                                                      16500323
      GO TO 225                                                         16500324
  224 DEV1(I)=(YCALC(I)-Y(I))/Y(I)                                      16500325
  225 CONTINUE                                                          16500326
      IF(TABLE)231,233,231                                              16500327
  231 WRITE OUTPUT TAPE 3,281                                           16500328
      WRITE OUTPUT TAPE 3,280,(ZLAST(K),ZLAST(K+15),ZLAST(K+30),ZLAST(K+16500329
     145),ZLAST(K+60),ZLAST(K+75),ZLAST(K+90),K=1,15)                   16500330
C     CALCULATE THE ROOTS OF THE DENOMINATOR POLYNOMIAL IF POSSIBLE     16500331
  233 IF(NOBS)240,269,240                                               16500332
  240 IF(NOBS-1)251,243,251                                             16500333
  243 IF(ASABS(NOAS2))250,245,250                                       16500334
  245 DROOTS(1)=10.0E+37                                                16500335
      GO TO 269                                                         16500336
  250 DROOTS(1)=-1.0/ASABS(NOAS2)                                       16500337
      GO TO 269                                                         16500338
  251 IF(NOBS-2)259,252,259                                             16500339
  252 SQB4AC=       (ASABS(NOAS2))**2-4.0*ASABS(NOAS2+1)                16500340
      IF(ASABS(NOAS2+1))255,253,255                                     16500341
  253 IF(ASABS(NOAS2))254,258,254                                       16500342
  254 DROOTS(1)=-1.0/(ASABS(NOAS2))                                     16500343
      DROOTS(2)=DROOTS(1)                                               16500344
      GO TO 269                                                         16500345
  255 IF(SQB4AC)256,257,257                                             16500346
  256 JJJ=0                                                             16500347
      GO TO 269                                                         16500348
  257 SQB4AC=SQRTF (SQB4AC)                                             16500349
      DROOTS(1)=(-ASABS(NOAS2)+SQB4AC)/(2.0*ASABS(NOAS2+1))             16500350
      DROOTS(2)=(-ASABS(NOAS2)-SQB4AC)/(2.0*ASABS(NOAS2+1))             16500351
      GO TO 269                                                         16500352
  258 DROOTS(1)=10.0E+37                                                16500353
      DROOTS(2)=DROOTS(1)                                               16500354
      GO TO 269                                                         16500355
  259 IF(HEAD(6))260,269,260                                            16500356
  260 CALL ROOT1(0,0,0,0,0,0,0)                                         16500357
      GO TO 264                                                         16500358
  264 CALL ROOTS(0,0,0,0,0,0,0)                                         16500359
      NNOBS=2*NOBS                                                      16500360
      J=24                                                              16500361
      DO 267 K=1,NNOBS                                                  16500362
      APLUSB(K)=Z(J)                                                    16500363
  267 J=J-1                                                             16500364
  269 CONTINUE                                                          16500365
      RETURN                                                            16500366
  280 FORMAT(7E17.7)                                                    16500367
  281 FORMAT(25H0DENOMINATORS OF FUNCTION)                              16500368
      END(0,1,0,0,0)                                                    16500369
      SUBROUTINE SING                                                   16500370
      WRITE OUTPUT TAPE 3,40                                            16500371
   40 FORMAT(40H              ERROR RETURN  SINGULAR SET)               16500372
C     CHANGE BINARY CARD TO TRA 1453 OCTAL ABSOLUTE                     16500373
      CALL TOP                                                          16500374
      RETURN                                                            16500375
      END(0,1,0,1,0)                                                    16500376
      SUBROUTINE SUMS                                                   16500377
C     SUBROUTINE TO CALC. + STORE SUMS OF (X**N),(Y*X**N),(Y*Y*X**N)    16500378
      DIMENSION SUMXS(25),SUMYXS(25),SUMYYX(24),ARRAY(26,25),ASABS(2    16500379
     15),YCALC(100),DEV1(100),DEV2(100),DROOTS(12),LIST(10),X(100),Y(10016500380
     2),NOPTS(1),NOAS(1),NOBS(1),MAXDEV(1),DOLOG(1),TABLE(1),TEMP(12),HE16500381
     3AD(12),JJJ(1),NASBS1(1)                                           16500382
      COMMON SUMXS,SUMYXS,SUMYYX,ARRAY,ASABS,YCALC,DEV1,DEV2,DROOTS,LIST16500383
     1,X,Y,NOPTS,NOAS,NOBS,MAXDEV,DOLOG,TABLE,TEMP,HEAD,JJJ,NASBS1      16500384
      EQUIVALENCE (DOLOG,NLOG),(MAXDEV,BIGDEV),(TABLE,NTABL)            16500385
      EQUIVALENCE (AVER1,HEAD(10)),(AVER2,HEAD(11))                     16500386
      LS=2*NOAS+1                                                       16500387
      LB=NOAS+NOBS+1                                                    16500388
      LV=2*NOBS                                                         16500389
      DO 5 J=2,25                                                       16500390
    5 SUMXS(J)=0.0                                                      16500391
      SUMXS(1)=FLOATF(NOPTS)                                            16500392
      DO 6 J=1,25                                                       16500393
    6 SUMYXS(J)=0.0                                                     16500394
      DO 7 J=1,24                                                       16500395
    7 SUMYYX(J)=0.0                                                     16500396
      LMIN=XMIN0F(LS,LB,LV)                                             16500397
      LMAX=XMAX0F(LS,LB,LV)                                             16500398
      LMID=LS+LB+LV-LMIN-LMAX                                           16500399
      LMIN11=LMIN+1                                                     16500400
      LMID11=LMID+1                                                     16500401
      DO 35 I=1,NOPTS                                                   16500402
      P1=1.0                                                            16500403
      YSQR=Y(I)*Y(I)                                                    16500404
      SUMYXS(1)=SUMYXS(1)+Y(I)                                          16500405
      IF(LMIN)9,8,9                                                     16500406
    8 DO 81 J=2,LMID                                                    16500407
      P1=X(I)*P1                                                        16500408
      SUMXS(J)=SUMXS(J)+P1                                              16500409
   81 SUMYXS(J)=SUMYXS(J)+Y(I)*P1                                       16500410
      DO 82 J=LMID11,LMAX                                               16500411
      P1=X(I)*P1                                                        16500412
   82 SUMXS(J)=SUMXS(J)+P1                                              16500413
      GO TO 35                                                          16500414
    9 IF(NOAS)99,101,99                                                 16500415
   99 DO 10 J=2,LMIN                                                    16500416
      P1=X(I)*P1                                                        16500417
      SUMXS(J)=SUMXS(J)+P1                                              16500418
      SUMYXS(J)=SUMYXS(J)+Y(I)*P1                                       16500419
   10 SUMYYX(J-1)=SUMYYX(J-1)+YSQR*P1                                   16500420
  101 IF(LMID-LS)11,12,11                                               16500421
   11 IF(LMID-LB)13,14,13                                               16500422
   12 IF(LMAX-LB)25,16,25                                               16500423
   13 IF(LMAX-LB)22,31,22                                               16500424
   14 IF(LMAX-LS)28,19,28                                               16500425
C     LS IS LMID AND LB IS LMAX                                         16500426
   16 SUMYYX(LMIN)=SUMYYX(LMIN)+P1*X(I)*YSQR                            16500427
      IF(LMIN-LMID)161,162,161                                          16500428
  161 DO 17 J=LMIN11,LMID                                               16500429
      P1=X(I)*P1                                                        16500430
      SUMXS(J)=SUMXS(J)+P1                                              16500431
   17 SUMYXS(J)=SUMYXS(J)+Y(I)*P1                                       16500432
  162 IF(LMID-LMAX)171,172,171                                          16500433
  171 DO 18 J=LMID11,LMAX                                               16500434
      P1=X(I)*P1                                                        16500435
   18 SUMYXS(J)=SUMYXS(J)+Y(I)*P1                                       16500436
  172 GO TO 35                                                          16500437
C     LB IS LMID AND LS IS LMAX                                         16500438
   19 SUMYYX(LMIN)=SUMYYX(LMIN)+P1*X(I)*YSQR                            16500439
      IF(LMIN-LMID)191,192,191                                          16500440
  191 DO 20 J=LMIN11,LMID                                               16500441
      P1=X(I)*P1                                                        16500442
      SUMXS(J)=SUMXS(J)+P1                                              16500443
   20 SUMYXS(J)=SUMYXS(J)+Y(I)*P1                                       16500444
  192 IF(LMID-LMAX)201,202,201                                          16500445
  201 DO 21 J=LMID11,LMAX                                               16500446
      P1=X(I)*P1                                                        16500447
   21 SUMXS(J)=SUMXS(J)+P1                                              16500448
  202 GO TO 35                                                          16500449
C     LV IS LMID AND LS IS LMAX                                         16500450
   22 IF(LMIN-LMID)221,222,221                                          16500451
  221 DO 23 J=LMIN11,LMID                                               16500452
      P1=X(I)*P1                                                        16500453
      SUMXS(J)=SUMXS(J)+P1                                              16500454
   23 SUMYYX(J-1)=SUMYYX(J-1)+YSQR*P1                                   16500455
  222 SUMYYX(LMID)=SUMYYX(LMID)+P1*X(I)*YSQR                            16500456
      IF(LMID-LMAX)231,232,231                                          16500457
  231 DO 24 J=LMID11,LMAX                                               16500458
      P1=X(I)*P1                                                        16500459
   24 SUMXS(J)=SUMXS(J)+P1                                              16500460
  232 GO TO 35                                                          16500461
C     LS=LMID AND LV= LMAX                                              16500462
   25 IF(LMIN-LMID)251,252,251                                          16500463
  251 DO 26 J=LMIN11,LMID                                               16500464
      P1=X(I)*P1                                                        16500465
      SUMXS(J)=SUMXS(J)+P1                                              16500466
   26 SUMYYX(J-1)=SUMYYX(J-1)+YSQR*P1                                   16500467
  252 IF(LMID-LMAX)261,262,261                                          16500468
  261 DO 27 J=LMID11,LMAX                                               16500469
      P1=X(I)*P1                                                        16500470
   27 SUMYYX(J-1)=SUMYYX(J-1)+YSQR*P1                                   16500471
  262 SUMYYX(LMAX)=SUMYYX(LMAX)+P1*X(I)*YSQR                            16500472
      GO TO 35                                                          16500473
C     LB IS LMID AND LV IS LMAX                                         16500474
   28 IF(LMIN-LMID)281,282,281                                          16500475
  281 DO 29 J=LMIN11,LMID                                               16500476
      P1=X(I)*P1                                                        16500477
      SUMYXS(J)=SUMYXS(J)+Y(I)*P1                                       16500478
   29 SUMYYX(J-1)=SUMYYX(J-1)+YSQR*P1                                   16500479
  282 IF(LMID-LMAX)291,292,291                                          16500480
  291 DO 30 J=LMID11,LMAX                                               16500481
      P1=X(I)*P1                                                        16500482
   30 SUMYYX(J-1)=SUMYYX(J-1)+YSQR*P1                                   16500483
  292 SUMYYX(LMAX)=SUMYYX(LMAX)+P1*X(I)*YSQR                            16500484
      GO TO 35                                                          16500485
C     LV IS LMID AND LB IS LMAX                                         16500486
   31 IF (LMIN-LMID)311,312,311                                         16500487
  311 DO 32 J=LMIN11,LMID                                               16500488
      P1=X(I)*P1                                                        16500489
      SUMYXS(J)=SUMYXS(J)+Y(I)*P1                                       16500490
   32 SUMYYX(J-1)=SUMYYX(J-1)+YSQR*P1                                   16500491
  312 SUMYYX(LMID)=SUMYYX(LMID)+P1*X(I)*YSQR                            16500492
      IF(LMID-LMAX)321,322,321                                          16500493
  321 DO 33 J=LMID11,LMAX                                               16500494
      P1=X(I)*P1                                                        16500495
   33 SUMYXS(J)=SUMYXS(J)+Y(I)*P1                                       16500496
  322 GO TO 35                                                          16500497
   35 CONTINUE                                                          16500498
      IF(TABLE) 36,43,36                                                16500499
   36 WRITE OUTPUT TAPE 3,41                                            16500500
   37 WRITE OUTPUT TAPE 3,38,(SUMXS(I),SUMYXS(I),SUMYYX(I),I=1,LMAX)    16500501
      WRITE OUTPUT TAPE 3,42                                            16500502
   38 FORMAT (3E16.8)                                                   16500503
   41 FORMAT(48H0SUMXS=              SUMYXS=             SUMYYX=)       16500504
   42 FORMAT(1H )                                                       16500505
   43 RETURN                                                            16500506
      END(0,1,0,0,0)                                                    16500507
