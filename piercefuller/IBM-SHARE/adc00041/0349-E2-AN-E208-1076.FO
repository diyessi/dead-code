CANE208     142 09019                                                   E2080001
C     ARBITRARY FUNCTIONAL    FIT             E A CROSBIE               E2080002
C     TO FIT A SERIES OF POINTS FM(J),J=1,N WITH THE                    E2080003
C     FUNCTIONAL FORM FC(Z(J),B(1),B(2),''' ,B(M))                      E2080004
C     LIMITS N=1,100  M=1,20                                            E2080005
C                                                                       E2080006
      DIMENSIONFM(100),FC(100),DF(100),Z(100),ERR(100),B(20),           E2080007
     XNT(100),A(100,20),R(20,1),G(20,20),U(20,20)                       E2080008
   10 FORMAT(72H1 PROBLEM NAME DATE                                     E2080009
     X                )                                                 E2080010
   20 FORMAT(12I6)                                                      E2080011
   30 FORMAT(6E12.8)                                                    E2080012
   40 FORMAT(5H0ERQ=E13.6,5H  Q0=E13.6,5H  NI=I4)                       E2080013
   50 FORMAT(17H0 J  GUESSED B(J))                                      E2080014
   60 FORMAT(1H0I3,2E16.8)                                              E2080015
   65 FORMAT(1H0I3,E16.8)                                               E2080016
   70 FORMAT(1H08E14.7)                                                 E2080017
   75 FORMAT(4H0Q1=E16.8,18HNO. OF ITERATIONS=I4)                       E2080018
   80 FORMAT(28H0 J  FINAL B(J)        ERROR)                           E2080019
  100 FORMAT(26H0THE CORRELATION MATRIX IS)                             E2080020
  110 FORMAT(1H010E11.3)                                                E2080021
  120 FORMAT(59H0       Z             FM(Z)           FC(Z)           DFE2080022
     X(Z))                                                              E2080023
  130 FORMAT(1H04E16.8)                                                 E2080024
C     READ HEADING                                                      E2080025
  200 READ10                                                            E2080026
C     READ NO. OF POINTS,NO. OF COEFFICIENTS,MAX. NO. OF                E2080027
C     ITERATIONS,NO. OF TRIAL POINTS                                    E2080028
  210 READ20,N,M,NI,N1                                                  E2080029
C     READ THE N VALUES OF THE INDEPENDENT VARIABLE                     E2080030
  220 READ30,(Z(J),J=1,N)                                               E2080031
C     READ THE CORRESPONDING MEASURED VALUES FM(J)                      E2080032
  230 READ30,(FM(J),J=1,N)                                              E2080033
C     READ THE CORRESPONDING ASSIGNED ERRORS                            E2080034
  240 READ30,(ERR(J),J=1,N)                                             E2080035
C     READ THE GUESSED VALUES FOR B(J)                                  E2080036
  250 READ30,(B(J),J=1,M)                                               E2080037
C     READ THE ASSIGNED LIMIT TO THE Q DIFFERENCE                       E2080038
C          AND THE STARTING Q.                                          E2080039
  260 READ30,ERQ,Q0                                                     E2080040
C     READ THE SELECTED TEST POINTS                                     E2080041
  270 READ20,(NT(J),J=1,N1)                                             E2080042
C                                                                       E2080043
C     SWITCH FOR OPTIONAL TAPE1 OUTPUT                                  E2080044
C                                                                       E2080045
  280 IF(SENSESWITCH5)290,300                                           E2080046
  290 CALLRITAP1(1)                                                     E2080047
C                                                                       E2080048
C     PRINT HEADING                                                     E2080049
C                                                                       E2080050
  300 PRINT 10                                                          E2080051
C                                                                       E2080052
C     OPTIONAL PRINT OUT OF FUNCTIONAL FORM                             E2080053
  310 IF(SENSESWITCH1)320,330                                           E2080054
  320 CALLFUNPRT                                                        E2080055
C                                                                       E2080056
C     PRINT REMAINDER OF HEADING                                        E2080057
C                                                                       E2080058
  330 PRINT40,ERQ,Q0,NI                                                 E2080059
  340 PRINT50                                                           E2080060
  350 PRINT65,(J,B(J),J=1,M)                                            E2080061
C                                                                       E2080062
C     SET ITERATION COUNTER TO ZERO                                     E2080063
  360 LL=0                                                              E2080064
C                                                                       E2080065
C     CALCULATE FC(Z(J),B(1),   ,B(M)) AND A(J,K)=(D/DB(K))(FC)         E2080066
  370 CALLFUNC(Z,B,FC,A,N)                                              E2080067
C                                                                       E2080068
C     TESTING SWITCH                                                    E2080069
  380 IF(SENSESWITCH2)390,420                                           E2080070
  390 DO410J=1,N1                                                       E2080071
  400 L=NT(J)                                                           E2080072
  410 PRINT70,Z(L),FC(L)                                                E2080073
  420 DO430J=1,N                                                        E2080074
  430 DF(J)=FM(J)-FC(J)                                                 E2080075
C                                                                       E2080076
C     TESTING SWITCH                                                    E2080077
  450 IF(SENSESWITCH3)460,490                                           E2080078
  460 DO480J=1,N1                                                       E2080079
  470 L=NT(J)                                                           E2080080
  480 PRINT70,(A(L,K),K=1,M),DF(L)                                      E2080081
C                                                                       E2080082
C     CALCULATE                                                         E2080083
  490 DO520L=1,M                                                        E2080084
  500 R(L,1)=0.0                                                        E2080085
  510 DO520J=1,N                                                        E2080086
  520 R(L,1)=R(L,1)+(A(J,L)*DF(J))/(ERR(J))**2                          E2080087
  530 DO570L=1,M                                                        E2080088
  540 DO570K=1,M                                                        E2080089
  550 G(L,K)=0.0                                                        E2080090
  560 DO570J=1,N                                                        E2080091
  570 G(L,K)=G(L,K)+(A(J,L)*A(J,K))/(ERR(J))**2                         E2080092
C                                                                       E2080093
C     TEST SWITCH FOR R AND G                                           E2080094
  580 IF(SENSESWITCH4)590,600                                           E2080095
  590 PRINT70,((G(L,K),K=1,M),R(L,1),L=1,M)                             E2080096
C                                                                       E2080097
C     IF G Y =R THEN MATINV RETURNS WITH R REPLACED                     E2080098
C     BY Y AND G REPLACED BY G INVERSE                                  E2080099
  600 MM=1                                                              E2080100
  610 CALLMATINV(G,M,R,MM,DETERM)                                       E2080101
C                                                                       E2080102
C     CHECK THE FIT                                                     E2080103
  630 Q1=0.0                                                            E2080104
  640 DO650J=1,N                                                        E2080105
  650 Q1=Q1+(DF(J)/ERR(J))**2                                           E2080106
  660 Q=ABSF(Q0-Q1)                                                     E2080107
  670 Q0=Q1                                                             E2080108
  680 LL=LL+1                                                           E2080109
C                                                                       E2080110
C     IF FIT IS NOT GOOD ENOUGH REPEAT IF NO. OF.                       E2080111
C     ITERATIONS IS NOT TOO LARGE.B(J) CORRECTED                        E2080112
  690 IF(Q-ERQ)730,730,700                                              E2080113
  700 IF(LL-NI)705,730,730                                              E2080114
  705 DO710J=1,M                                                        E2080115
  710 B(J)=B(J)+R(J,1)                                                  E2080116
C                                                                       E2080117
C     TESTSWITCH FOR Y AMD G INVERSE                                    E2080118
  713 IF(SENSESWITCH4)715,720                                           E2080119
  715 PRINT70,((G(L,K),K=1,M),R(L,1),B(L),L=1,M),Q1                     E2080120
  720 GOTO370                                                           E2080121
C                                                                       E2080122
C     CALCULATE THE CORRELATION MATRIX                                  E2080123
  730 DO750J=1,M                                                        E2080124
  740 DO750K=1,M                                                        E2080125
  750 U(J,K)=G(J,K)/SQRTF(G(J,J)*G(K,K))                                E2080126
  760 DO770L=1,M                                                        E2080127
  770 U(L,L)=SQRTF(G(L,L)*Q1/FLOATF(N-M-1))                             E2080128
C                                                                       E2080129
C     PRINT FINAL RESULTS                                               E2080130
  775 PRINT75,Q1,LL                                                     E2080131
  780 PRINT80                                                           E2080132
  790 PRINT60,(J,B(J),U(J,J),J=1,M)                                     E2080133
  800 PRINT100                                                          E2080134
  810 DO820L=1,M                                                        E2080135
  820 PRINT110,(U(L,K),K=1,M)                                           E2080136
  830 PRINT120                                                          E2080137
  840 PRINT130,(Z(J),FM(J),FC(J),DF(J),J=1,N)                           E2080138
  850 IF(SENSESWITCH5)860,870                                           E2080139
  860 ENDFILE1                                                          E2080140
  870 STOP77777                                                         E2080141
  880 END(0,1,0,0,1)                                                    E2080142
