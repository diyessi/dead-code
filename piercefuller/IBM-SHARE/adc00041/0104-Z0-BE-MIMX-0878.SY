C     MAXIMIZATION-MINIMIZATION USING FIBONACCI NUMBERS                 BEMIMX01
      SUBROUTINEMIMAX(AA,BB,NF,NMIMAX,ACCUR,NFUNC,XMIMAX,YMIMAX)        BEMIMX02
      DIMENSIONE(40)                                                    BEMIMX03
      A=AA                                                              BEMIMX04
      B=BB                                                              BEMIMX05
      IF(NMIMAX)10,11,11                                                BEMIMX06
 10   JMIMAX=1                                                          BEMIMX07
      GOTO20                                                            BEMIMX08
 11   JMIMAX=2                                                          BEMIMX09
 20   IF(B-A)21,22,23                                                   BEMIMX10
 21   TEMP=A                                                            BEMIMX11
      A=B                                                               BEMIMX12
      B=TEMP                                                            BEMIMX13
      GOTO23                                                            BEMIMX14
 22   L=1                                                               BEMIMX15
 25   PRINT26,L                                                         BEMIMX16
 26   FORMAT(17H1  ERROR OF TYPE I2)                                    BEMIMX17
      GOTO170                                                           BEMIMX18
 23   R=B-A                                                             BEMIMX19
      IF(NFUNC)31,30,35                                                 BEMIMX20
 30   IF(ACCUR)31,31,40                                                 BEMIMX21
 31   L=2                                                               BEMIMX22
      GOTO25                                                            BEMIMX23
 35   NFUNC2=NFUNC+2                                                    BEMIMX24
      R1=(1.0+SQRTF(5.0))/2.0                                           BEMIMX25
      R2=(1.0-SQRTF(5.0))/2.0                                           BEMIMX26
      ROACC=(R1**NFUNC2-R2**NFUNC2)/(R1-R2)                             BEMIMX27
      GOTO45                                                            BEMIMX28
 40   ROACC=R/ACCUR                                                     BEMIMX29
 45   IF(ROACC-2.0)50,50,51                                             BEMIMX30
 50   XMIMAX=(A+B)/2.0                                                  BEMIMX31
      YMIMAX=FMIMAX(XMIMAX,NF)                                          BEMIMX32
      GOTO170                                                           BEMIMX33
 51   IF(ROACC-3.0)60,60,61                                             BEMIMX34
 60   XL=A+(B-A)/3.0                                                    BEMIMX35
      XR=A+2.0*(B-A)/3.0                                                BEMIMX36
      YL=FMIMAX(XL,NF)                                                  BEMIMX37
      YR=FMIMAX(XR,NF)                                                  BEMIMX38
      IF(YL-YR)70,70,71                                                 BEMIMX39
 70   XMIMAX=XR                                                         BEMIMX40
      YMIMAX=YR                                                         BEMIMX41
      GOTO170                                                           BEMIMX42
 71   XMIMAX=XL                                                         BEMIMX43
      YMIMAX=YL                                                         BEMIMX44
      GOTO170                                                           BEMIMX45
 61   K=3                                                               BEMIMX46
      E(1)=1.0                                                          BEMIMX47
      E(2)=1.0                                                          BEMIMX48
 74   E(K)=E(K-1)+E(K-2)                                                BEMIMX49
      IF(ROACC-E(K))80,80,75                                            BEMIMX50
 75   IF(K-40)77,76,76                                                  BEMIMX51
 76   L=3                                                               BEMIMX52
      GOTO25                                                            BEMIMX53
 77   K=K+1                                                             BEMIMX54
      GOTO74                                                            BEMIMX55
 80   N=K                                                               BEMIMX56
      XL=A+E(N-2)*R/E(N)                                                BEMIMX57
      XR=A+E(N-1)*R/E(N)                                                BEMIMX58
      YL=FMIMAX(XL,NF)                                                  BEMIMX59
      YR=FMIMAX(XR,NF)                                                  BEMIMX60
      J=1                                                               BEMIMX61
 90   NJ=N-J                                                            BEMIMX62
      NJONE=N-J-1                                                       BEMIMX63
      NJTWO=N-J-2                                                       BEMIMX64
      GOTO(100,101),JMIMAX                                              BEMIMX65
 100  IF(YR-YL)130,130,110                                              BEMIMX66
 101  IF(YR-YL)110,110,130                                              BEMIMX67
 110  IF(J-N+3)120,160,160                                              BEMIMX68
 120  B=XR                                                              BEMIMX69
      A=A                                                               BEMIMX70
      R=B-A                                                             BEMIMX71
      XR=XL                                                             BEMIMX72
      XL=A+E(NJTWO)*R/E(NJ)                                             BEMIMX73
      YR=YL                                                             BEMIMX74
      YL=FMIMAX(XL,NF)                                                  BEMIMX75
 125  J=J+1                                                             BEMIMX76
      GOTO90                                                            BEMIMX77
 130  IF(J-N+3)140,150,150                                              BEMIMX78
 140  B=B                                                               BEMIMX79
      A=XL                                                              BEMIMX80
      R=B-A                                                             BEMIMX81
      XL=XR                                                             BEMIMX82
      XR=A+E(NJONE)*R/E(NJ)                                             BEMIMX83
      YL=YR                                                             BEMIMX84
      YR=FMIMAX(XR,NF)                                                  BEMIMX85
      GOTO125                                                           BEMIMX86
 150  XMIMAX=XR                                                         BEMIMX87
      YMIMAX=YR                                                         BEMIMX88
      GOTO170                                                           BEMIMX89
 160  XMIMAX=XL                                                         BEMIMX90
      YMIMAX=YL                                                         BEMIMX91
 170  RETURN                                                            BEMIMX92
      END                                                               BEMIMX93
