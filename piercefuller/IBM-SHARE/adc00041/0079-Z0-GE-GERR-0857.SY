   GEFGERR ERROR PROCEDURE FOR FORTRANN II.     CORR                    GEGERR00
*GERR    STANDARD ERROR PROCEDURE FOR FORTRAN II - ERROR SRT            GERR0001
*      REM  GE ERROR PROCEDURE SUBROUTINE FOR FORTRAN II                GERR0002
*      REM  SRT TO TRACE FLOW OF PROGRAM FROM ERROR BACK TO MAIN PROGRAMGERR0003
*      REM                                                              GERR0004
*      REM  PROGRAM CARD                                                GERR0005
       COL                                                              GERR0006
       ORG                                                              GERR0007
       PZE MA+1                 NO. OF WORDS                            GERR0008
       PZE                                                              GERR0009
*      REM ERROR ENTRY WILL RETURN TO INITIAL ENTRY OF PROGRAM          GERR0010
       BCD 1ERROR                                                       GERR0011
       PZE ERROR                                                        GERR0012
*      REM ERRORA ENTRY WILL RETURN TO NEXT INSTRUCTION AFTER CALL      GERR0013
       BCD 1ERRORA                                                      GERR0014
       PZE ERRA                                                         GERR0015
*      REM  GIVEN                                                       GERR0016
*      REM      TSX NAME,4                                              GERR0017
*      REM      TSX ARG                                                 GERR0018
*      REM      TSX ARG                                                 GERR0019
*      REM      NTR *+2,0,A             A=EXTERNAL FORMULA NUMBER       GERR0020
*      REM      PZE C,0,B               B=INTERNAL FORMULA NUMBER       GERR0021
*      REM                              C=77777)8 IF FUNCT DEFINITION   GERR0022
*      REM                              C=L($+2) IF SRT OR FUNCT SRT    GERR0023
*      REM                              C=0 OTHERWISE (MAIN PROGRAM)    GERR0024
*      REM  AND THIS SUBROUTINE INCLUDES ANY INSTRUCTION TO             GERR0025
*      REM  CALL ERROR ROUTINE, THEN BY MEANS OF INFORMATION            GERR0026
*      REM  GIVEN IN CALLING SEQUENCES, THE PATH OF FLOW IS TRACED.     GERR0027
       REL                                                              GERR0028
       ORG                                                              GERR0029
E      HTR                      C(XR1)                                  GERR0030
       HTR                    C(XR2)                                    GERR0031
       HTR                    C(ACC)                                    GERR0032
       HTR                    C(MQ)                                     GERR0033
       HTR                    C(XR4)                                    GERR0034
       HTR                                                              GERR0035
ERRA   SXD E+5,4                                                        GERR0036
ERROR  SXD E,1                  STORE REGISTERS                         GERR0037
       SXD E+1,2                                                        GERR0038
       STO E+2                                                          GERR0039
       STQ E+3                                                          GERR0040
       CLA LC                 FA+1 OF FIRST COMMENT                     GERR0041
       TSX COMT,2             WRITE COMMENT                             GERR0042
E1     SXD E+4,4                XR4                                     GERR0043
       LXD CTR,2                                                        GERR0044
       TXI *+1,2,1                                                      GERR0045
       TXH E37,2,15                                                     GERR0046
       SXD CTR,2                                                        GERR0047
       TIX *+1,4,1            EXAMINE FOR NTR INSTRUCTION               GERR0048
       LDQ ,4                                                         * GERR0049
       LGL 2                                                            GERR0050
       TQP *-3                  NO-MUST BE ARGUMENT-GO BACK             GERR0051
       TSX CONV,2             NTR INSTRUCTION-PREPARE TO                GERR0052
       SLW C1+4                 CONVERT EXTERNAL FORMULA NO.            GERR0053
       LDQ 1,4                PZE INSTRUCTION TO GET INTERNAL         * GERR0054
       LGL 2                  FORMULA NUMBER                            GERR0055
       TSX CONV,2                                                       GERR0056
       SLW C1+9               STORE IN LINE IMAGE                       GERR0057
*      REM  NOW EXAMINE C TO SEE WHICH TYPE OF SRT THIS IS              GERR0058
       CLA 1,4                                                        * GERR0059
       ANA L77                                                          GERR0060
       TZE E4                 MAIN PROGRAM                              GERR0061
       CAS L77                L(77777)                                  GERR0062
       TRA *+2                                                          GERR0063
       TRA E3                 FUNCTION DEFINITION SRT                   GERR0064
*      REM  LOCATION WHOSE DECREMENT GIVES 2S COMPLEMENT OF             GERR0065
*      REM  LOCATION OF TSX OF CALLING SEQUENCE TO THIS PARTICULAR      GERR0066
*      REM  SUBPROGRAM                                                  GERR0067
       STA E2                                                           GERR0068
       ACL D1                                                           GERR0069
       STA *+1                                                          GERR0070
       CAL --                 BCD NAME OF SUB'PROGRAM                   GERR0071
       SLW C1+11              IN IMAGE                                  GERR0072
       CLA LC1                FA+1 OF IMAGE                             GERR0073
       TSX COMT,2                                                       GERR0074
E2     LXD ,4                                                         * GERR0075
       TRA E1                 BACK TO SEARCH CALLING SEQ FOR NTR        GERR0076
*      REM  FUNCTION DEFINITION SRT                                     GERR0077
E3     CAL ALBLK                                                        GERR0078
       SLW C1+11              FOR BCD TITLE                             GERR0079
       CAL LC1                FA+1 OF IMAGE                             GERR0080
       TSX COMT,2             WRITE COMMENT WITH NO TITLE               GERR0081
       LXD ERROR-3,1          WHERE X4 WAS STORED                       GERR0082
       CLA -1,1               SXD PRECEDING TSX                       * GERR0083
       STA *+1                                                          GERR0084
       LXD ,4                                                         * GERR0085
       CLA ,4                 CHECK TO BE SURE IF TSX                 * GERR0086
       ANA MASK1              KEEP DEC AND TAG                          GERR0087
       SUB MA                 SXJ 0,4                                   GERR0088
       TZE E1                 BACK TO SEARCH CALL SEQ FOR NTR           GERR0089
*      REM  WRITE COMMENT TO EFFECT SEARCH CANNOT BE CONTINUED          GERR0090
E37    CAL LC2                FA+1 OF COMMENT                           GERR0091
       TSX COMT,2                                                       GERR0092
*      REM  AND TERMINATE                                               GERR0093
       STZ CTR                                                          GERR0094
       WTD TAPE)3                                                     * GERR0095
       CPY RESTO                                                      * GERR0096
       SLN 1                                                            GERR0097
       CLA E+5                O WE RETURN TO                            GERR0098
       TZE 45                 BSOLUTE LOCATION IN LOAD                * GERR0099
*      REM ALTERNATE RETURN FOR ERROR                                   GERR0100
       PDX ,4                 O                                         GERR0101
       LXD E,1                                                          GERR0102
       LXD E+1,2                                                        GERR0103
       STZ E+5                                                          GERR0104
       CLA E+2                                                          GERR0105
       LDQ E+3                                                          GERR0106
       TRA 1,4                ETURN TO NEXT INSTRUCTION               * GERR0107
*      REM                                                              GERR0108
*      REM  MAIN PROGRAM                                                GERR0109
E4     CAL MAIN               BCD TITLE                                 GERR0110
       SLW C1+11                                                        GERR0111
       CLA LC1                FA+1 OF COMMENT                           GERR0112
       TSX COMT,2             WRITE COMMENT                             GERR0113
       TRA E37                COMMENT AND TERMINATE                     GERR0114
*      REM                                                              GERR0115
*      REM  WRITE COMMENT SRT                                           GERR0116
COMT   SXD CONVT,2                                                      GERR0117
       LXA D12,2                                                        GERR0118
       STA *+2                                                          GERR0119
       WTD TAPE)3                                                     * GERR0120
       CPY ,2                                                         * GERR0121
       TIX *-1,2,1                                                      GERR0122
       IOD                                                            * GERR0123
       LXD CONVT,2                                                      GERR0124
       TRA 1,2                                                        * GERR0125
*      REM                                                              GERR0126
CONV   PXD                                                              GERR0127
       LLS 15                                                           GERR0128
       STO INT                                                          GERR0129
       LXA D36,1                                                        GERR0130
       CAL ALBLK                                                        GERR0131
       SLW CONVT                                                        GERR0132
CONV1  CLA INT                                                          GERR0133
       TZE CONV2                                                        GERR0134
       LRS 35                                                           GERR0135
       DVP D10                                                          GERR0136
       STQ INT                                                          GERR0137
       STO INTR                                                         GERR0138
       LDQ MASK                                                         GERR0139
D36    RQL 36,1                                                         GERR0140
       LGL 36                                                           GERR0141
       ANS CONVT                                                        GERR0142
       CLA INTR                                                         GERR0143
       ALS 36,1                                                         GERR0144
       ORS CONVT                                                        GERR0145
       TIX CONV1,1,6                                                    GERR0146
CONV2  CAL CONVT                                                        GERR0147
       TRA 1,2                                                        * GERR0148
INT    PZE                                                              GERR0149
INTR   PZE                                                              GERR0150
CONVT  PZE                                                              GERR0151
*      REM                                                              GERR0152
*      REM  CONSTANTS                                                   GERR0153
CTR    PZE                                                              GERR0154
MASK   OCT -377777777700                                                GERR0155
D10    DEC 10                                                           GERR0156
D12    DEC 12                                                           GERR0157
L77    OCT 77777                                                        GERR0158
RESTO  BCD 11                                                           GERR0159
ALBLK  BCD 1                                                            GERR0160
BLANK  OCT 60                                                           GERR0161
MAIN   BCD 1MAIN                                                        GERR0162
*      REM                                                              GERR0163
C      BCD 61 AN ERROR HAS BEEN FOUND AT OR NEAR                        GERR0164
       BCD 6                                                            GERR0165
*      REM                                                              GERR0166
C1     BCD 60   EXTERNAL FORMULA NO.      ,  INT                        GERR0167
       BCD 6ERNAL FORMULA NO.       ,  OF                               GERR0168
*      REM                                                              GERR0169
C2     BCD 60                                THE                        GERR0170
       BCD 6 END                                                        GERR0171
LC     PZE C+12                                                         GERR0172
LC1    PZE C1+12                                                        GERR0173
LC2    PZE C2+12                                                        GERR0174
MASK1  OCT -377777700000                                                GERR0175
D1     PZE 1                                                            GERR0176
MA     TSX ,4                                                         * GERR0177
TAPE)3 EQU 3                                                            GERR0178
       END                                                              GERR0179
